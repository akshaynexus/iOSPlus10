+	struct negroni_dsi_set_result r;
+	int rc = negroni_dsi_dcs_set_ex(negroni_panel_on_command, sizeof(negroni_panel_on_command), fLP,
+	    NDSI_SET_GO_ON | (fWakeMode < 2 ? NDSI_SET_SKIP_LONG : 0), &r);
+	bool complete = r.packets == NEGRONI_PANEL_ON_PACKETS && (rc == 0 || r.longFailed != 0);
+	const char *pps = "PPS skipped (negronifb_wake=1)";
+	int prc = 0;
+	if (fWakeMode >= 2) {
+		if (complete && !negroni_dsi_dead) {
+			prc = negroni_dsi_long_packet(0x0a, negroni_panel_pps, sizeof(negroni_panel_pps), fLP);
+		}
+		pps = !complete ? "PPS not sent (set incomplete)" :
+		    r.longSent == 1 && prc == 0 ? "PPS ok" :
+		    r.longSent == 1 ? "PPS 9E ok, 0x0A failed" : "PPS failed";
+	}
+	bool rearmed = false;
+	if (paused) {
+		negroni_fb_autorefresh_resume(ar);
+	}
+	uint32_t te = 0, frames = 0, tear = 0;
+	bool sampled = negroni_fb_te_check(&te, &frames, &tear, &rearmed);
+	/* a set that broke off before its end: the next wake sends it again */
+	fPanelOn = complete || (r.sent != 0 && negroni_dsi_dead);
+	if (sampled) {
+		snprintf(info, size, "on-command %u packets%s, %s, TE %s: %u TE %u frames tear 0x%x in 50 ms%s, autorefresh 0x%08x%s",
+		    r.sent, r.skipped ? " (long ones skipped)" : "", pps, te != 0 ? "on" : "MISSING", te, frames, tear,
+		    rearmed ? " (re-armed)" : "", ar, paused ? " paused+resumed" : "");
+	} else {
+		snprintf(info, size, "on-command %u packets%s, %s, TE not sampled (no INTF_1 mapping)", r.sent,
+		    r.skipped ? " (long ones skipped)" : "", pps);
+	}
+	wake = complete ? (rc == 0 && prc == 0 ? "ok" : "ok except PPS") : "failed";
+	if (!complete) {
+		IOLog("NEGRONI BL: on-command stopped at packet %u of %u (rc %d)\n", r.packets, NEGRONI_PANEL_ON_PACKETS, rc);
+	}
+	return wake;
+}
+
+/*
+ * 0293: re-init after a failed ESD check (bsd/dev/negroni_dsi.c, DCS 0x0a not 0x9d/0x9f twice).
+ * Android: PANEL_DEAD -> dsi_display disable/enable (power off, reset, DSI_CMD_SET_ON). Here:
+ * the off-command (0x28, 21 ms, 0x10, 101 ms) and 0268's full wake (on-command + PPS), then
+ * the DBV again. Backlight work loop.
+ */
+void
+AppleARMBacklight::reinitPanel(void)
+{
+	char info[192];
+	uint8_t c = 0x28;
+
+	info[0] = 0;
+	(void)negroni_dsi_dcs_write(&c, 1, fLP);
+	IOSleep(NEGRONI_BL_OFF_WAIT_MS);
+	c = 0x10;
+	(void)negroni_dsi_dcs_write(&c, 1, fLP);
+	IOSleep(NEGRONI_BL_SLEEP_IN_WAIT_MS);
+	fPanelOn = false;
+	const char *wake = wakePanel(info, sizeof(info));
+	fKnown = false;                 /* the DBV goes out again */
+	uint32_t level = fLevel != 0 ? fLevel : fLastLit;
+	apply(level, true);
+	IOLog("NEGRONI BL: ESD re-init: %s (%s), panel DBV %u\n", wake, info, level);
+}
+
+void
+AppleARMBacklight::timerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	(void)sender;
+	((AppleARMBacklight *)owner)->step();
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (d == NULL) {
+		return kIOReturnBadArgument;
+	}
+	OSNumber *b = OSDynamicCast(OSNumber, d->getObject("brightness"));
+	OSNumber *f = OSDynamicCast(OSNumber, d->getObject("FadePeriod"));
+	OSNumber *nits = OSDynamicCast(OSNumber, d->getObject("brightness-nits"));
+	if (fLogged < 24) {
+		fLogged++;
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		OSNumber *l = OSDynamicCast(OSNumber, d->getObject("backlight-level"));
+		IOLog("NEGRONI BL: %s sets %u keys: brightness %d FadePeriod 0x%x backlight-level %d brightness-nits 0x%x\n",
+		    name, d->getCount(), b ? (int)b->unsigned32BitValue() : -1, f ? f->unsigned32BitValue() : 0,
+		    l ? (int)l->unsigned32BitValue() : -1, nits ? nits->unsigned32BitValue() : 0);
+	}
+	uint32_t to;
+	if (b != NULL) {
+		int32_t v = (int32_t)b->unsigned32BitValue();
+		to = v < 0 ? 0 : MIN((uint32_t)v, fMax);
+	} else if (nits != NULL) {
+		/* nits as 16.16 (CoreBrightness _SetBLDriverNitsValue) */
+		int64_t v = (int32_t)nits->unsigned32BitValue();
+		to = v <= 0 ? 0 : (uint32_t)MIN((uint64_t)v * fMax / ((uint64_t)fNits << 16), (uint64_t)fMax);
+		if (to == 0 && v > 0) {
+			to = 1;
+		}
+	} else {
+		return kIOReturnSuccess;
+	}
+	uint64_t ms = f != NULL ? ((uint64_t)f->unsigned32BitValue() * 1000) >> 16 : 0;
+	uint64_t period;
+	nanoseconds_to_absolutetime(MIN(ms, (uint64_t)NEGRONI_BL_FADE_MAX_MS) * NSEC_PER_MSEC, &period);
+	uint64_t now = mach_absolute_time();
+
+	IOInterruptState is = IOSimpleLockLockDisableInterrupt(fState);
+	/* Fade from where the current fade is now. */
+	uint32_t cur = fTarget;
+	if (fFadePeriod != 0 && now - fFadeStart < fFadePeriod) {
+		cur = (uint32_t)((int64_t)fFadeFrom + ((int64_t)fTarget - (int64_t)fFadeFrom) *
+		    (int64_t)(now - fFadeStart) / (int64_t)fFadePeriod);
+	}
+	fFadeFrom = cur;
+	fTarget = to;
+	fFadeStart = now;
+	fFadePeriod = period;
+	if (to != 0 && fDisplayOn) {
+		fLastLit = to;
+	}
+	fSetCount++;
+	IOSimpleLockUnlockEnableInterrupt(fState, is);
+	publish(to);
+	kick();
+	return kIOReturnSuccess;
+}
+
+/* NegroniFramebuffer.cpp, vsync tick, after the fade: does not block. */
+bool
+AppleARMBacklight::displayOff(uint32_t fadeMs)
+{
+	IOInterruptState is = IOSimpleLockLockDisableInterrupt(fState);
+	bool changed = fDisplayOn;
+	fDisplayOn = false;
+	fPowerEdge = changed;
+	fOffFadeMs = fadeMs;
+	IOSimpleLockUnlockEnableInterrupt(fState, is);
+	if (changed) {
+		kick();
+	}
+	return negroni_dsi != NULL && !negroni_dsi_dead;
+}
+
+/* NegroniFramebuffer.cpp RequestPowerChange(1): does not block. */
+bool
+AppleARMBacklight::displayOn(void)
+{
+	IOInterruptState is = IOSimpleLockLockDisableInterrupt(fState);
+	bool changed = !fDisplayOn;
+	fDisplayOn = true;
+	fPowerEdge = changed;
+	fOnAt = mach_absolute_time();
+	IOSimpleLockUnlockEnableInterrupt(fState, is);
+	if (changed) {
+		kick();
+	}
+	return negroni_dsi != NULL && !negroni_dsi_dead;
+}
+
+/* 0259: the display state iOS asked for (RequestPowerChange), any thread. */
+bool
+AppleARMBacklight::displayIsOn(void)
+{
+	IOInterruptState is = IOSimpleLockLockDisableInterrupt(fState);
+	bool on = fDisplayOn;
+	IOSimpleLockUnlockEnableInterrupt(fState, is);
+	return on;
+}
+
+/*
+ * 0258: panic (negroni_fb_panic, kPEPanicBegin): the panic text must be
+ * visible on a sleeping panel. Busy waits only; DCS without the lock.
+ */
+void
+AppleARMBacklight::panicWake(void)
+{
+	if (negroni_dsi == NULL || negroni_dsi_dead) {
+		return;
+	}
+	negroni_dsi_panic = true;
+	if (!fPanelOn) {
+		uint8_t c = 0x11;
+		if (negroni_dsi_dcs_write(&c, 1, fLP) == -2) {
+			/* DMA busy: the panic came during a work-loop DCS write; let it end, then once more */
+			for (uint32_t i = 0; i < 30 && (ndsi_rd(NDSI_STATUS) & NDSI_STATUS_DMA_BUSY); i++) {
+				IODelay(1000);
+			}
+			(void)negroni_dsi_dcs_write(&c, 1, fLP);
+		}
+		for (uint32_t i = 0; i < NEGRONI_BL_SLEEP_OUT_WAIT_MS; i++) {
+			IODelay(1000);
+		}
+		c = 0x29;
+		(void)negroni_dsi_dcs_write(&c, 1, fLP);
+		fPanelOn = true;
+	}
+	uint32_t level = fLastLit != 0 ? fLastLit : fMax * 45 / 100;
+	uint8_t cmd[3] = { 0x51, (uint8_t)(level >> 8), (uint8_t)level };
+	(void)negroni_dsi_dcs_write(cmd, 3, fLP);
+}
+
+/* ---------------------------------------------------------------------- */
+/* Hooks                                                                   */
+/* ---------------------------------------------------------------------- */
+
+/* 0293: 0268's set lock for bsd/dev/negroni_dsi.c reads (not in the panic path). */
+extern "C" void
+negroni_dsi_set_enter(void)
+{
+	if (negroni_dsi_set_lock != NULL && !negroni_dsi_panic) {
+		IOLockLock(negroni_dsi_set_lock);
+	}
+}
+
+extern "C" void
+negroni_dsi_set_leave(void)
+{
+	if (negroni_dsi_set_lock != NULL && !negroni_dsi_panic) {
+		IOLockUnlock(negroni_dsi_set_lock);
+	}
+}
+
+/* 0293: bsd/dev/negroni_dsi.c ESD check: ask the work loop for a panel re-init (0268 wake mode >= 1). */
+extern "C" void negroni_dsi_set_reinit(int (*fn)(void));
+extern "C" int
+negroni_backlight_reinit(void)
+{
+	if (negroni_bl == NULL || negroni_bl->fWakeMode == 0) {
+		return -1;              /* negronifb_wake=0: no on-command to re-init with */
+	}
+	negroni_bl->fReinit = true;
+	negroni_bl->kickPublic();
+	return 0;
+}
+
+/* NegroniFramebuffer.cpp AppleCLCD::start: publish the service under the framebuffer. */
+void
+negroni_backlight_attach(IOService *provider)
+{
+	int on = 1;
+	PE_parse_boot_argn("negronibl", &on, sizeof(on));
+	if (!on || negroni_bl != NULL) {
+		if (!on) {
+			IOLog("NEGRONI BL: off (negronibl=0)\n");
+		}
+		return;
+	}
+	if (!negroni_dsi_init()) {
+		return;
+	}
+	AppleARMBacklight *bl = OSTypeAlloc(AppleARMBacklight);
+	if (bl == NULL || !bl->init()) {
+		OSSafeReleaseNULL(bl);
+		return;
+	}
+	uint32_t max = NEGRONI_BL_DEFAULT_MAX, nits = 500, sleep = NEGRONI_BL_SLEEP_DEFAULT;
+	int curve = 0, hs = 0;
+	PE_parse_boot_argn("negronibl_max", &max, sizeof(max));
+	PE_parse_boot_argn("negronibl_nits", &nits, sizeof(nits));
+	PE_parse_boot_argn("negronibl_sleep", &sleep, sizeof(sleep));       /* old name (0250) */
+	PE_parse_boot_argn("negronifb_sleep", &sleep, sizeof(sleep));       /* 0258 */
+	PE_parse_boot_argn("negronibl_curve", &curve, sizeof(curve));
+	PE_parse_boot_argn("negronibl_hs", &hs, sizeof(hs));
+	uint32_t wakeMode = 2;
+	PE_parse_boot_argn("negronifb_wake", &wakeMode, sizeof(wakeMode));     /* 0268 */
+	bl->fMax = max < 16 ? 16 : MIN(max, (uint32_t)NEGRONI_BL_HW_MAX);
+	bl->fNits = nits == 0 ? 500 : nits;
+	bl->fSleepMode = MIN(sleep, 2u);
+	bl->fWakeMode = MIN(wakeMode, 2u);
+	bl->fCurve = curve != 0;
+	bl->fLP = hs == 0;      /* qcom,bl-dsc-cmd-state = "dsi_lp_mode" */
+	if (!bl->attach(provider)) {
+		IOLog("NEGRONI BL: setup failed\n");
+		bl->release();
+		return;
+	}
+	if (!bl->startBacklight()) {
+		IOLog("NEGRONI BL: setup failed\n");
+		bl->detach(provider);
+		bl->release();
+		return;
+	}
+	negroni_bl = bl;        /* keeps the reference */
+	negroni_dsi_set_reinit(negroni_backlight_reinit);       /* 0293: the ESD check's re-init */
+}
+
+/*
+ * NegroniFramebuffer.cpp (0258). Off: called from the vsync tick when the
+ * fade to black is done; on: from RequestPowerChange(1). Neither blocks
+ * (the framebuffer calls them under its fLock). False = no backlight
+ * service (negronibl=0 or no DSI0): the caller logs instead.
+ */
+extern "C" bool
+negroni_backlight_display_off(uint32_t fade_ms)
+{
+	if (negroni_bl == NULL) {
+		return false;
+	}
+	(void)negroni_bl->displayOff(fade_ms);  /* the work loop logs the result */
+	return true;
+}
+
+extern "C" bool
+negroni_backlight_display_on(void)
+{
+	if (negroni_bl == NULL) {
+		return false;
+	}
+	(void)negroni_bl->displayOn();
+	return true;
+}
+
+/* NegroniFramebuffer.cpp negroni_fb_panic (0258): wake the panel for the panic text. */
+extern "C" void
+negroni_backlight_panic(void)
+{
+	if (negroni_bl != NULL) {
+		negroni_bl->panicWake();
+	}
+}
+
+/*
+ * NegroniFramebuffer.cpp (0259, VRR): true while iOS has the display on and the
+ * DSI takes commands; *lp = the DCS transmission mode this service uses.
+ */
+extern "C" bool
+negroni_backlight_panel_ready(bool *lp)
+{
+	if (negroni_bl == NULL || negroni_dsi == NULL || negroni_dsi_dead) {
+		return false;
+	}
+	if (lp != NULL) {
+		*lp = negroni_bl->fLP;
+	}
+	return negroni_bl->displayIsOn();
+}
+
+#endif /* NEGRONI */
