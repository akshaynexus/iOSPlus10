+	NegroniSurface *fOldHold[NEGRONI_FB_LAYERS];
+	bool          fOldValid;
+	uint32_t      fOldFence, fOldFenceSurface, fOldFences[NEGRONI_FB_LAYERS];
+	uint32_t      fWaitFence;     /* the oldest fence the tick is waiting for (0: none) */
+	uint64_t      fWaitT0;        /* when the tick first saw it */
+	uint32_t      fWaitCloses;    /* NegroniGPUClientCloses() then */
+	uint64_t      fGiveUpAbs, fStuckAbs;      /* NEGRONI_FB_GPU_GIVEUP_MS, NEGRONI_FB_GPU_STUCK_MS */
+	uint32_t      fSeenCompleted; /* the GPU's completed fence at the last tick */
+	uint64_t      fMovedT0;       /* when it last moved (or a wait began) */
+	uint32_t      fGaveUpFence;   /* given up: it and every fence before it */
+	uint32_t      fGaveUpLogged[NEGRONI_FB_GIVEUP_LOGGED], fGaveUpLogN;
+	uint32_t      fStatSkips, fStatGaveUp;
+
+	/* 0259: TE-locked tick (negronifb_te) and idle refresh switching (negronifb_vrr); work loop unless noted */
+	vm_offset_t   fIntf;          /* INTF_1 registers (0: not mapped) */
+	uint32_t      fTeMode;        /* negronifb_te (0 off, 1 lock, 2 lock + vsync timestamps) */
+	uint32_t      fTeInit;        /* INTF_TEAR_VSYNC_INIT_VAL: the counter after a TE */
+	uint32_t      fTeLineNs;      /* one tearcheck line, ns (vsync_count / 19.2 MHz) */
+	int32_t       fTeTarget;      /* negronifb_te_off: wanted tick phase after the TE, us (< 0: before the next) */
+	bool          fTeSeen;
+	uint32_t      fTeLastFrame, fTeStopped, fTeFrames;
+	uint64_t      fTeFirstAbs;    /* period measurement window */
+	uint32_t      fTeFirstFrame, fTePeriodUs;
+	int32_t       fTePhaseUs, fTeErrUs, fTeAdjUs;
+	int64_t       fTeAdjAbs;      /* the next deadline moves by this (rearm) */
+	uint32_t      fTeLocked, fTeSamples, fTeNoSample;
+	int64_t       fTeErrSum;
+	int32_t       fTeErrMax;
+	uint64_t      fTeTs;          /* last INTF_VSYNC_TIMESTAMP (negronifb_te=2) */
+	uint64_t      fTickNominalAbs;    /* the tick period when the TE measurement is not used */
+	uint32_t      fVrrMode;       /* negronifb_vrr: 0 off, 1 min-fps + autorefresh divider, 2 60/90 Hz timing, 3 divider only */
+	uint32_t      fVrrFps, fVrrExt, fVrrDiv;      /* idle rate, BD[0x14] hold count, autorefresh frames */
+	bool          fVrrHS;         /* negronifb_vrr_hs: DCS in high-speed mode */
+	uint64_t      fVrrIdleAbs;    /* negronifb_vrr_ms without a swap */
+	uint32_t      fVrrState;      /* kNegroniVrr*, under fLock */
+	uint64_t      fLastSwapAbs;   /* under fLock */
+	thread_call_t fVrrCall;
+	uint64_t      fVrrIdleAt, fVrrIdleTotalAbs;
+	uint32_t      fVrrIdleCount, fVrrDcsErrors;
+	bool          fVrrApplied;    /* the panel is in the idle configuration (thread call only) */
+	bool          fVrrBusy;       /* thread call running (under fLock) */
+	bool          fVrrDisabled;   /* a switch failed: no more idle periods this boot (under fLock) */
+	uint32_t      fVrrOffWait;    /* display-off ticks spent waiting for a running VRR set */
+	vm_offset_t   fIntfWake;      /* 0268: INTF_1 for the wake check when neither fIntf nor fMdss is mapped */
+
+	void teInit(void);
+	void teTick(uint64_t now);
+	void teLog(void);
+	void vrrTick(uint64_t now);
+	void vrrWakeLocked(void);
+	void vrrWork(void);
+	void vrrSetRate(uint32_t fps);
+	void publishModes(void);        /* 0364 */
+	static void vrrCall(thread_call_param_t p0, thread_call_param_t p1);
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void statTick(uint64_t now);
+	void rearm(IOTimerEventSource *sender);
+	bool fenceGone(uint32_t fence);
+	bool fencePassed(uint32_t fence, uint32_t surface, bool *gaveUp);
+	void addClient(IOMobileFramebufferUserClient *client);
+	void removeClient(IOMobileFramebufferUserClient *client);
+	void swap(const uint8_t *rec);
+	uint32_t present(const uint8_t *rec, NegroniSurface *const *held, const uint32_t *fences);
+	void releaseBusy(bool all);
+	void keepBusy(NegroniSurface **held, uint32_t fence);
+	void zeroCopyInit(void);
+	NegroniSurface *zeroCopySurface(const uint8_t *rec);
+	bool zeroCopyLatched(void);
+	void zeroCopyRetire(bool tick);
+	void zeroCopyUnshow(NegroniSurface *s);
+	void zeroCopyShiftClock(NegroniSurface *s, uintptr_t k, bool gpu);
+	void shiftTick(void);
+	void presentFinish(void);
+	void notifyVsync(const uint64_t *values);
+	void zeroCopyRestore(void);
+	void zeroCopyStop(bool now);
+	void flip(NegroniSurface *s, uint32_t id);
+	void dbufInit(void);
+	bool dbufTarget(const uint8_t *rec);
+	void dbufQueued(uint32_t fence);
+	void dbufTick(bool tick);
+	void dbufFlip(int32_t i);
+	void dbufPark(void);
+	void dbufOff(const char *why);
+	bool dbufAnyPending(void);
+	IOReturn swapWait(uint32_t id);
+};
+
+static AppleCLCD *negroni_fb_zc;          /* for the panic hook (negroni_fb_panic) */
+static AppleCLCD *negroni_fb_main;        /* 0268: for the backlight's wake (negroni_fb_te_check) */
+
+OSDefineMetaClassAndStructors(AppleCLCD, IOMobileFramebuffer);
+
+class IOMobileFramebufferUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOMobileFramebufferUserClient);
+
+public:
+	AppleCLCD          *fFB;
+	task_t              fTask;
+	mach_port_t         fPort;
+	io_user_reference_t fFunc[NEGRONI_FB_NOTIFY_TYPES];
+	io_user_reference_t fRefcon[NEGRONI_FB_NOTIFY_TYPES];
+
+	bool initWithTask(task_t owningTask, void *securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn registerNotificationPort(mach_port_t port, UInt32 type,
+	    io_user_reference_t refCon) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+	void notify(uint32_t type, const uint64_t *values, uint32_t count);
+};
+
+OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
+
+bool
+AppleCLCD::start(IOService *provider)
+{
+	PE_Video video;
+
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	PE_current_console(&video);
+	fPhys = video.v_baseAddr;
+	fWidth = (uint32_t)video.v_width;
+	fHeight = (uint32_t)video.v_height;
+	fRowBytes = (uint32_t)video.v_rowBytes;
+	if (fPhys == 0 || fWidth == 0 || fHeight == 0 || fRowBytes < fWidth * 4) {
+		IOLog("NEGRONI FB: no boot framebuffer\n");
+		return false;
+	}
+	int native = 0;
+	PE_parse_boot_argn("negronifb_native", &native, sizeof(native));
+	fLogicalW = fWidth;
+	fLogicalH = fHeight;
+	if (!native && fWidth <= NEGRONI_FB_LOGICAL_W && fHeight <= NEGRONI_FB_LOGICAL_H) {
+		fLogicalW = NEGRONI_FB_LOGICAL_W;
+		fLogicalH = NEGRONI_FB_LOGICAL_H;
+	}
+	fOffX = (int32_t)(fLogicalW - fWidth) / 2;
+	fOffY = (int32_t)(fLogicalH - fHeight) / 2;
+	/* negronifb_shift=N: move the picture N panel pixels down, so the status bar (the clock in
+	 * the top-left ear) clears the punch-hole camera; the bottom rows are cut instead. */
+	int shift = 0;
+	PE_parse_boot_argn("negronifb_shift", &shift, sizeof(shift));
+	if (shift > 0 && shift < 300) {
+		fOffY -= shift;
+	}
+	fLock = IOLockAlloc();
+	fClients = OSArray::withCapacity(4);
+	fSurface = negroni_surface_create_physical(fPhys, fWidth, fHeight, fRowBytes, NEGRONI_FB_FORMAT_BGRA);
+	fPixels = fSurface != NULL ? fSurface->kernelAddress() : 0;
+	fWorkLoop = IOWorkLoop::workLoop();
+	if (fLock == NULL || fClients == NULL || fPixels == 0 || fWorkLoop == NULL) {
+		IOLog("NEGRONI FB: setup failed\n");
+		OSSafeReleaseNULL(fSurface);    /* stays published: also held by the table */
+		OSSafeReleaseNULL(fWorkLoop);
+		return false;
+	}
+	fVsync = IOTimerEventSource::timerEventSource(this, &AppleCLCD::vsyncFired);
+	if (fVsync == NULL || fWorkLoop->addEventSource(fVsync) != kIOReturnSuccess) {
+		IOLog("NEGRONI FB: no vsync timer\n");
+		return false;
+	}
+	uint32_t hz = 10;
+	PE_parse_boot_argn("negronifb_hz", &hz, sizeof(hz));
+	fFlushTicks = (hz == 0 || hz >= 1000000u / NEGRONI_FB_VSYNC_US) ? 1 : (1000000u / NEGRONI_FB_VSYNC_US) / hz;
+	/* GPU frames: every vsync tick (the panel rate) unless negronifb_gpuhz asks for fewer */
+	uint32_t gpuhz = 1000000u / NEGRONI_FB_VSYNC_US;
+	PE_parse_boot_argn("negronifb_gpuhz", &gpuhz, sizeof(gpuhz));
+	fGpuFlushTicks = (gpuhz == 0 || gpuhz >= 1000000u / NEGRONI_FB_VSYNC_US) ? 1 : (1000000u / NEGRONI_FB_VSYNC_US) / gpuhz;
+	uint32_t stats = 1;
+	PE_parse_boot_argn("negronifb_stats", &stats, sizeof(stats));
+	fStats = stats != 0;
+	PE_parse_boot_argn("negronifb_offtick_ms", &negroni_fb_offtick_ms, sizeof(negroni_fb_offtick_ms));
+	PE_parse_boot_argn("negronifb_offnotify", &negroni_fb_offnotify, sizeof(negroni_fb_offnotify));
+	PE_parse_boot_argn("negronifb_offstat_s", &negroni_fb_offstat_s, sizeof(negroni_fb_offstat_s));
+	PE_parse_boot_argn("negronifb_asleep", &negroni_fb_asleep_on, sizeof(negroni_fb_asleep_on));
+	if (negroni_fb_offtick_ms < 100) {
+		negroni_fb_offtick_ms = 100;
+	} else if (negroni_fb_offtick_ms > 2000) {
+		negroni_fb_offtick_ms = 2000;
+	}
+	IOLog("NEGRONI FB: 0382 dark: tick %u ms after %u ms, vsync notifications %s, idle lines every %u s, "
+	    "dark flag %s (negronifb_offtick_ms/_offnotify/_offstat_s/_asleep)\n", negroni_fb_offtick_ms, NEGRONI_FB_OFF_SLOW_MS,
+	    negroni_fb_offnotify ? "on" : "off", negroni_fb_offstat_s, negroni_fb_asleep_on ? "on" : "off");
+	nanoseconds_to_absolutetime((uint64_t)NEGRONI_FB_VSYNC_US * 500ull, &fStatLateAbs);
+	nanoseconds_to_absolutetime(1000000000ull, &fStatSecAbs);
+	nanoseconds_to_absolutetime((uint64_t)NEGRONI_FB_VSYNC_US * 1000ull, &fTickAbs);
+	nanoseconds_to_absolutetime((uint64_t)NEGRONI_FB_GPU_GIVEUP_MS * 1000000ull, &fGiveUpAbs);
+	nanoseconds_to_absolutetime((uint64_t)NEGRONI_FB_GPU_STUCK_MS * 1000000ull, &fStuckAbs);
+	uint32_t notifyLate = 1, clockCopy = 1;
+	PE_parse_boot_argn("negronifb_notifylate", &notifyLate, sizeof(notifyLate));
+	PE_parse_boot_argn("negronifb_clockcopy", &clockCopy, sizeof(clockCopy));
+	fNotifyLate = notifyLate != 0;
+	fClockCopy = clockCopy != 0;
+	IOLog("NEGRONI FB: 0267 vsync notification %s, clock shift %s\n",
+	    fNotifyLate ? "after the frame is queued (negronifb_notifylate=1)" : "before the copy (negronifb_notifylate=0)",
+	    fClockCopy ? "inside the copy (negronifb_clockcopy=1)" : "after the copy on the CPU (negronifb_clockcopy=0, 0256)");
+	fDeadline = mach_absolute_time() + fTickAbs;
+	fVsync->wakeAtTime(fDeadline);
+	fTickNominalAbs = fTickAbs;
+	zeroCopyInit();
+	dbufInit();
+	teInit();
+	if (fIntf == 0 && fMdss == 0) {
+		/* 0268: the wake check reads the TE counter (negroni_fb_te_check) */
+		fIntfWake = ml_io_map_unmappable(NEGRONI_INTF1_PA, NEGRONI_INTF1_LEN, NEGRONI_WIMG_IO);
+	}
+	negroni_fb_main = this;
+
+	setProperty(kIOUserClientClassKey, "IOMobileFramebufferUserClient");
+	setProperty("external", false);
+	setProperty("DisplayPipePlaneBaseAlignment", 64ULL, 32);
+	uint32_t carefresh = 1;
+	PE_parse_boot_argn("negronifb_carefresh", &carefresh, sizeof(carefresh));
+	if (carefresh != 0) {
+		uint64_t ticks;
+		nanoseconds_to_absolutetime((uint64_t)NEGRONI_FB_VSYNC_US * 1000ull, &ticks);
+		OSDictionary *refresh = OSDictionary::withCapacity(2);
+		OSNumber *step = OSNumber::withNumber(ticks, 64);
+		OSNumber *min = OSNumber::withNumber(1ULL, 32);
+		if (refresh != NULL && step != NULL && min != NULL) {
+			refresh->setObject("displayRefreshStepMachTime", step);
+			refresh->setObject("displayMinRefreshInterval", min);
+			setProperty("IOMFBDisplayRefresh", refresh);
+			fRefreshTicks = ticks;
+			IOLog("NEGRONI FB: IOMFBDisplayRefresh step %llu ticks (%u us)\n", ticks, NEGRONI_FB_VSYNC_US);
+		} else {
+			IOLog("NEGRONI FB: IOMFBDisplayRefresh not set (no memory)\n");
+		}
+		OSSafeReleaseNULL(refresh);
+		OSSafeReleaseNULL(step);
+		OSSafeReleaseNULL(min);
+	}
+	publishModes();                 /* 0364: TimingElements / ColorElements */
+	registerService();
+	negroni_backlight_attach(this);
+	negroni_dsi_esd_start();        /* 0293: negronifb_esd (bsd/dev/negroni_dsi.c) */
+	negroni_dpu_start(fMdss, fZCCtl);       /* 0295/0296: bsd/dev/negroni_dpu.c (TE interrupt, power) */
+	IOLog("NEGRONI FB: AppleCLCD %ux%u stride %u at 0x%llx, default surface %u, presented as %ux%u\n",
+	    fWidth, fHeight, fRowBytes, fPhys, fSurface->id, fLogicalW, fLogicalH);
+	return true;
+}
+
+void
+AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	AppleCLCD *fb = (AppleCLCD *)owner;
+	uint64_t now = mach_absolute_time();
+	uint64_t count = ++fb->fVsyncCount;
+
+	if (fb->fStats) {
+		fb->statTick(now);
+	}
+	if (fb->fTeMode != 0 && !fb->fPowerOff) {
+		fb->teTick(now);        /* 0259: where is the panel's TE relative to this tick */
+	}
+	/* 0295/0296 (bsd/dev/negroni_dpu.c): TE interrupt upkeep; negronifb_idle=2 kicks and idle entry */
+	negroni_dpu_tick(now, fb->fLastSwapAbs, fb->fPresentedID, NegroniGPUFenceDone(fb->fLastGPUFence), fb->fPowerOff);
+	fb->zeroCopyRetire(true);       /* the engine took the last flip: the frame before goes back */
+	fb->shiftTick();                /* 0256: a clock shift left over from a slow GPU copy */
+	fb->dbufTick(true);             /* 0269: a taken flip; the newest finished copy to the pipes */
+	uint64_t values[6] = {
+		(uint32_t)count, (uint32_t)(count >> 32),
+		(uint32_t)now, (uint32_t)(now >> 32),
+		(uint32_t)fb->fRefreshTicks, (uint32_t)(fb->fRefreshTicks >> 32),     /* 0253: interval (0: off) */
+	};
+
+	IOLockLock(fb->fLock);
+	/*
+	 * 0267: with the display on, the notification goes out after this tick's frame is queued and
+	 * its swap id published (end of this handler): CoreAnimation wakes on it and asks SwapWait for
+	 * that id at once; before, the id moved only after the copy and its 2.4 ms (max 8 ms) wait for
+	 * the clock shift, so CoreAnimation's 1 ms SwapWait retry ran out and it skipped the heartbeat.
+	 */
+	bool notifyLate = fb->fNotifyLate && !fb->fPowerOff;
+	/* 0382: negronifb_offnotify=0: no vsync notifications once dark (fade step 2 on) */
+	bool notifyOff = fb->fPowerOff && fb->fFadeStep >= 2 && negroni_fb_offnotify == 0;
+	for (unsigned int i = 0; !notifyLate && !notifyOff && i < fb->fClients->getCount(); i++) {
+		IOMobileFramebufferUserClient *client =
+		    (IOMobileFramebufferUserClient *)fb->fClients->getObject(i);
+		client->notify(NEGRONI_FB_NOTIFY_VSYNC, values, 6);
+	}
+	fb->vrrTick(now);               /* 0259: idle long enough: lower the panel refresh */
+	if (fb->fPowerOff) {
+		/*
+		 * 0275: off in two ticks. The panel memory is mapped write-combined
+		 * (NegroniSurface::kernelAddress, kIOMapWriteCombineCache): every read of it
+		 * is an uncached bus read, so the 0251 fade (7 ticks, each a read-modify-write
+		 * pass over 2.6 M pixels) took about 1 s per tick with the work loop blocked
+		 * ("fade 7055 ms", "late ticks 136" and "swaps/s 0" each second, backboardd
+		 * spinning in SwapWait, log of 2026-10-26). Now tick 0 lets the GPU's copy
+		 * land, releases the surfaces, stops the zero-copy flip and writes black
+		 * (stores only); tick 1 hands over to the backlight (DBV 0, DCS sleep, 0258).
+		 * The visible fade is the backlight's DBV step. A RequestPowerChange(1) in
+		 * between resets fFadeStep (fDirty: the next tick redraws the frame).
+		 */
+		uint32_t step = fb->fFadeStep;
+		if (step <= 1) {
+			fb->fFadeStep = step + 1;
+		}
+		IOLockUnlock(fb->fLock);
+		if (step == 0) {
+			/* a GPU copy still on its way would paint over the black */
+			NegroniGPUFenceWait(fb->fLastGPUFence, NEGRONI_FB_GPU_WAIT_MS);
+			fb->releaseBusy(false);
+		}
+		fb->zeroCopyStop(true);         /* the dark panel is the panel memory */
+		if (step == 0) {
+			uint64_t t0 = mach_absolute_time(), ns;
+			uint32_t words = fb->fWidth / 2;        /* 8-byte stores, even width (1080) */
+			for (uint32_t y = 0; y < fb->fHeight; y++) {
+				volatile uint64_t *row = (volatile uint64_t *)(fb->fPixels + (uint64_t)y * fb->fRowBytes);
+				for (uint32_t x = 0; x < words; x++) {
+					row[x] = 0;
+				}
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			IOLog("NEGRONI FB: display off: black in %u us\n", (uint32_t)(ns / NSEC_PER_USEC));
+		} else if (step == 1) {
+			/*
+			 * 0258: the panel is black; now DBV 0 and the DCS sleep (backlight work
+			 * loop). Under fLock: a RequestPowerChange(1) after the unlock above must
+			 * not be followed by a late "off" (it calls display_on under fLock too).
+			 */
+			uint64_t ns;
+			absolutetime_to_nanoseconds(mach_absolute_time() - fb->fOffAt, &ns);
+			uint32_t ms = (uint32_t)(ns / NSEC_PER_MSEC);
+			bool none = false, vrrRunning;
+			IOLockLock(fb->fLock);
+			/*
+			 * 0259: a VRR command set (thread call) still on its way: the 0258 sleep DCS
+			 * must not land inside it. Wait at most NEGRONI_VRR_OFF_WAIT_TICKS ticks.
+			 */
+			vrrRunning = fb->fVrrBusy;
+			if (vrrRunning && fb->fVrrOffWait < NEGRONI_VRR_OFF_WAIT_TICKS) {
+				fb->fVrrOffWait++;
+				fb->fFadeStep = 1;      /* this step again next tick */
+				IOLockUnlock(fb->fLock);
+				fb->rearm(sender);
+				return;
+			}
+			if (fb->fPowerOff) {
+				none = !negroni_backlight_display_off(ms);
+			}
+			IOLockUnlock(fb->fLock);
+			if (none) {
+				IOLog("NEGRONI FB: display off (fade %u ms, DCS sleep skipped: no backlight service)\n", ms);
+			}
+			if (vrrRunning) {
+				IOLog("NEGRONI FB: display off: VRR set still running after %u ticks\n", fb->fVrrOffWait);
+			}
+		} else {
+			/* 0258: dark and idle: a slow tick (NEGRONI_FB_OFF_TICKS periods, 100 ms) until the wake */
+			uint64_t ticks = NEGRONI_FB_OFF_TICKS, slowAbs;
+			nanoseconds_to_absolutetime((uint64_t)NEGRONI_FB_OFF_SLOW_MS * NSEC_PER_MSEC, &slowAbs);
+			/*
+			 * 0382: under fLock and only while still off. Review: a store after the unlock above could
+			 * land after a RequestPowerChange(1) cleared the flag and leave it at 1 with the display on.
+			 */
+			IOLockLock(fb->fLock);
+			if (fb->fPowerOff && negroni_fb_asleep_on) {
+				__atomic_store_n(&negroni_display_asleep, 1, __ATOMIC_RELEASE);
+			}
+			IOLockUnlock(fb->fLock);
+			if (now - fb->fOffAt >= slowAbs) {
+				/* 0382: dark for a while: the longer tick; RequestPowerChange(1) kicks the timer (wakeKick) */
+				ticks = (uint64_t)negroni_fb_offtick_ms * 1000ull / NEGRONI_FB_VSYNC_US;
+				if (ticks < NEGRONI_FB_OFF_TICKS) {
+					ticks = NEGRONI_FB_OFF_TICKS;
+				}
+			}
+			fb->fDeadline += (ticks - 1) * fb->fTickAbs;
+		}
+		fb->rearm(sender);
+		return;
+	}
+	bool flush = fb->fDirty && (fb->fPendZC || (count % (fb->fPendGPU ? fb->fGpuFlushTicks : fb->fFlushTicks)) == 0);
+	bool zc = flush && fb->fPendZC && fb->fZCReady;
+	bool gaveUp = false, older = false;
+	uint32_t completed = NegroniGPUFenceCompleted();
+	if (completed != fb->fSeenCompleted) {
+		fb->fSeenCompleted = completed;
+		fb->fMovedT0 = now;     /* 0254: the GPU went on */
+	}
+	if (zc && fb->fZCNextValid) {
+		flush = false;          /* the last flip is not taken yet: next tick */
+	} else if (flush && !fb->fencePassed(fb->fPendFence, fb->fPendFenceSurface, &gaveUp)) {
+		flush = false;          /* 0254: the GPU is not done with it: it stays pending, next tick */
+		zc = false;
+		older = fb->fOldValid && fb->fencePassed(fb->fOldFence, fb->fOldFenceSurface, &gaveUp);
+		if (!older) {
+			fb->fStatSkips++;
+			__atomic_fetch_add(&negroni_gpu_late_frames, 1, __ATOMIC_RELAXED);    /* 0384 */
+		}
+	}
+	if ((flush || older) && fb->fDbuf && !fb->dbufTarget(older ? fb->fOld : fb->fPending)) {
+		flush = older = false;          /* 0269: no panel buffer to write yet: the frame stays pending */
+	}
+	uint8_t *rec = NULL;
+	NegroniSurface *held[NEGRONI_FB_LAYERS] = {}, *gone[NEGRONI_FB_LAYERS] = {};
+	uint32_t fences[NEGRONI_FB_LAYERS] = {};
+	if (flush || older) {
+		rec = (uint8_t *)IOMallocData(NEGRONI_FB_SWAP_REC_SIZE);
+		if (rec != NULL && older) {
+			/* 0254: the older frame's fence passed first: shown now, the newer one stays pending */
+			memcpy(rec, fb->fOld, NEGRONI_FB_SWAP_REC_SIZE);
+			memcpy(held, fb->fOldHold, sizeof(held));
+			memcpy(fences, fb->fOldFences, sizeof(fences));
+			bzero(fb->fOldHold, sizeof(fb->fOldHold));
+			fb->fOldValid = false;
+			fb->fStatGaveUp += gaveUp;
+		} else if (rec != NULL) {
+			memcpy(rec, fb->fPending, NEGRONI_FB_SWAP_REC_SIZE);
+			memcpy(held, fb->fPendHold, sizeof(held));
+			memcpy(fences, fb->fPendFences, sizeof(fences));
+			bzero(fb->fPendHold, sizeof(fb->fPendHold));
+			fb->fDirty = false;
+			fb->fPendZC = false;
+			fb->fStatGaveUp += gaveUp;
+			if (fb->fOldValid) {
+				/* the older waiting frame is older than this one: never shown */
+				memcpy(gone, fb->fOldHold, sizeof(gone));
+				bzero(fb->fOldHold, sizeof(fb->fOldHold));
+				fb->fOldValid = false;
+			}
+		}
+	}
+	IOLockUnlock(fb->fLock);
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		if (gone[layer] != NULL) {
+			negroni_surface_hold(gone[layer], false);
+			gone[layer]->release();
+		}
+	}
+	fb->releaseBusy(false);
+	if (rec != NULL && zc) {
+		fb->flip(held[0], get32(rec, 0x50));    /* takes held[0]'s retain and hold */
+		IOFreeData(rec, NEGRONI_FB_SWAP_REC_SIZE);
+		fb->fStatZC++;
+	} else if (rec != NULL) {
+		uint64_t t0 = mach_absolute_time();
+		uint32_t fence = fb->present(rec, held, fences);
+		fb->dbufQueued(fence);          /* 0269: that buffer flips when the copy is done */
+		uint64_t dt = mach_absolute_time() - t0;
+		fb->fStatCopyAbs += dt;
+		if (dt > fb->fStatCopyMaxAbs) {
+			fb->fStatCopyMaxAbs = dt;
+		}
+		if (fence != 0) {
+			fb->fStatGPU++;
+		} else {
+			fb->fStatCPU++;
+		}
+		if (fb->fZCActive) {
+			/* the panel memory has this frame (the GPU's copy done) before the pipes go back to it */
+			NegroniGPUFenceWait(fence, NEGRONI_FB_GPU_COPY_WAIT_MS);
+			fb->zeroCopyStop(false);
+		}
+		fb->keepBusy(held, fence);      /* until the GPU has read them (fence 0: now) */
+		IOLockLock(fb->fLock);
+		if (fb->fZCNextValid && get32(rec, 0x50) > fb->fZCNextID) {
+			fb->fZCNextID = get32(rec, 0x50);       /* 0254: on screen when the engine takes the panel memory back */
+		} else if (get32(rec, 0x50) > fb->fPresentedID && !fb->fZCNextValid) {
+			fb->fPresentedID = get32(rec, 0x50);
+		}
+		IOLockUnlock(fb->fLock);
+		IOFreeData(rec, NEGRONI_FB_SWAP_REC_SIZE);
+	}
+	if (notifyLate) {
+		IOLockLock(fb->fLock);
+		fb->notifyVsync(values);
+		IOLockUnlock(fb->fLock);
+	}
+	if (fb->fFinishPending) {
+		/* 0267: the CPU's drawing over a GPU copy (0256 shift, badges), after CoreAnimation has its tick */
+		uint64_t t0 = mach_absolute_time();
+		fb->presentFinish();
+		uint64_t dt = mach_absolute_time() - t0;
+		fb->fStatCopyAbs += dt;
+		if (dt > fb->fStatCopyMaxAbs) {
+			fb->fStatCopyMaxAbs = dt;
+		}
+	}
+	fb->dbufTick(false);            /* 0269: a CPU copy (and its drawing) is done now: flip at once */
+	fb->rearm(sender);
+}
+
+/* 0382: RequestPowerChange(1) while the off tick is long: tick now (rearm() restarts the deadlines). */
+void
+AppleCLCD::wakeKick(void)
+{
+	__atomic_store_n(&fWakeKick, true, __ATOMIC_RELEASE);
+	if (fVsync != NULL) {
+		fVsync->wakeAtTime(mach_absolute_time());
+	}
+}
+
+/* The vsync notification to every client (fLock held). */
+void
+AppleCLCD::notifyVsync(const uint64_t *values)
+{
+	for (unsigned int i = 0; i < fClients->getCount(); i++) {
+		IOMobileFramebufferUserClient *client =
+		    (IOMobileFramebufferUserClient *)fClients->getObject(i);
+		client->notify(NEGRONI_FB_NOTIFY_VSYNC, values, 6);
+	}
+}
+
+/*
+ * 0254: the next tick at the next deadline, not one period after the end of this handler. A
+ * deadline already gone is skipped to the next one ahead, and each skipped one is a late tick.
+ */
+void
+AppleCLCD::rearm(IOTimerEventSource *sender)
+{
+	uint64_t now = mach_absolute_time();
+
+	if (__atomic_exchange_n(&fWakeKick, false, __ATOMIC_ACQ_REL)) {
+		fDeadline = now;        /* 0382: the display came on during a long off tick: full rate from now */
+		fTeAdjAbs = 0;
+	}
+
+	/* 0259: the TE lock moves the next deadline by at most a quarter period; the step after is a full one */
+	int64_t step = (int64_t)fTickAbs + fTeAdjAbs;
+	fTeAdjAbs = 0;
+	fDeadline += (uint64_t)step;
+	if (fDeadline <= now) {
+		uint64_t missed = (now - fDeadline) / fTickAbs + 1;
+		fDeadline += missed * fTickAbs;
+		fStatLate += (uint32_t)missed;
+	}
+	sender->wakeAtTime(fDeadline);
+}
+
+/*
+ * 0254: the fence is done, or the tick need not wait for it: the GPU has written no fence for
+ * NEGRONI_FB_GPU_STUCK_MS while the tick waited, or the fence is at or before a given-up one
+ * (one ring, fences done in order). Work loop only.
+ */
+bool
+AppleCLCD::fenceGone(uint32_t fence)
+{
+	if (NegroniGPUFenceDone(fence)) {
+		return true;
+	}
+	if (fGaveUpFence != 0 && NegroniGPUFenceDone(fGaveUpFence)) {
+		fGaveUpFence = 0;       /* the GPU went past it */
+	}
+	if (fWaitFence != 0 && !NegroniGPUFenceDone(fWaitFence) && mach_absolute_time() - fMovedT0 > fStuckAbs) {
+		return true;            /* hung (RedwoodGPU stops it only when someone waits 2 s) */
+	}
+	return fGaveUpFence != 0 && (int32_t)(fence - fGaveUpFence) <= 0;
+}
+
+/*
+ * 0254: the tick may go past this fence (of surface id surface): done, or given up. Never waits.
+ * A slow GPU is waited for: the oldest fence the tick waits for is given up only after
+ * NEGRONI_FB_GPU_GIVEUP_MS since the tick first saw it and a GPU client closed meanwhile, or
+ * when the GPU hangs (fenceGone). Logged once per surface id.
+ */
+bool
+AppleCLCD::fencePassed(uint32_t fence, uint32_t surface, bool *gaveUp)
+{
+	if (NegroniGPUFenceDone(fence)) {
+		return true;
+	}
+	if (!fenceGone(fence)) {
+		uint64_t now = mach_absolute_time();
+		if (fWaitFence == 0 || NegroniGPUFenceDone(fWaitFence)) {
+			fWaitFence = fence;
+			fWaitT0 = now;
+			fWaitCloses = NegroniGPUClientCloses();
+			fMovedT0 = now;         /* the hang clock starts with the wait */
+		} else if ((int32_t)(fence - fWaitFence) < 0) {
+			fWaitFence = fence;     /* older than it: pending since fWaitT0 at least */
+		}
+		if (now - fWaitT0 <= fGiveUpAbs || NegroniGPUClientCloses() == fWaitCloses) {
+			return false;
+		}
+		fGaveUpFence = fWaitFence;
+		fWaitFence = 0;
+		if (!fenceGone(fence)) {
+			return false;   /* a newer fence than the given-up one: the GPU still works on it */
+		}
+	}
+	if (gaveUp != NULL) {
+		*gaveUp = true;
+	}
+	for (uint32_t i = 0; i < NEGRONI_FB_GIVEUP_LOGGED; i++) {
+		if (fGaveUpLogged[i] == surface) {
+			return true;
+		}
+	}
+	fGaveUpLogged[fGaveUpLogN++ % NEGRONI_FB_GIVEUP_LOGGED] = surface;
+	IOLog("NEGRONI FB: gave up on fence %u of surface %u\n", fence, surface);
+	return true;
+}
+
+/*
+ * Per-second statistics (0252): from vsyncFired, work loop only. A late tick came more than
+ * 1.5 vsync periods after the one before. One line per second; all counters start again.
+ */
+static uint64_t
+negroni_fb_abs_us(uint64_t abs)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000;
+}
+
+void
+AppleCLCD::statTick(uint64_t now)
+{
+	if (now > fDeadline && now - fDeadline > fStatLateAbs) {
+		fStatLate++;            /* 0254: more than half a period after its deadline */
+	}
+	fStatLastTick = now;
+	if (fStatT0 == 0) {
+		fStatT0 = now;
+		return;
+	}
+	if (now - fStatT0 < fStatSecAbs) {
+		return;
+	}
+	uint32_t swaps = __atomic_exchange_n(&fStatSwaps, 0, __ATOMIC_RELAXED);
+	uint32_t waits = __atomic_exchange_n(&fStatWaits, 0, __ATOMIC_RELAXED);
+	uint32_t timeouts = __atomic_exchange_n(&fStatWaitTimeouts, 0, __ATOMIC_RELAXED);
+	uint64_t waitAbs = __atomic_exchange_n(&fStatWaitAbs, 0, __ATOMIC_RELAXED);
+	uint64_t waitMax = __atomic_exchange_n(&fStatWaitMaxAbs, 0, __ATOMIC_RELAXED);
+	uint32_t copies = fStatCPU + fStatGPU;
+	/* 0382: dark and nothing happened: no lines (the counters still restart), at most every negronifb_offstat_s */
+	fStatQuiet = __atomic_load_n(&negroni_display_asleep, __ATOMIC_ACQUIRE) && swaps == 0 && copies == 0 &&
+	    fStatZC == 0 && waits == 0 && timeouts == 0 && fStatGaveUp == 0 &&
+	    (negroni_fb_offstat_s == 0 || now - fStatPrintAt < (uint64_t)negroni_fb_offstat_s * fStatSecAbs);
+	if (!fStatQuiet) {
+		fStatPrintAt = now;
+		IOLog("NEGRONI FB STAT: swaps/s %u presents/s %u (cpu %u gpu %u zc %u) copy avg/max us %llu/%llu "
+	    "late ticks %u swapwait calls %u waited us avg/max %llu/%llu timeouts %u gpu-wait skips %u gave-up %u\n",
+	    swaps, copies + fStatZC, fStatCPU, fStatGPU, fStatZC,
+	    copies ? negroni_fb_abs_us(fStatCopyAbs) / copies : 0, negroni_fb_abs_us(fStatCopyMaxAbs),
+	    fStatLate, waits, waits ? negroni_fb_abs_us(waitAbs) / waits : 0, negroni_fb_abs_us(waitMax), timeouts,
+	    fStatSkips, fStatGaveUp);
+	}
+	fStatT0 = now;
+	fStatCPU = fStatGPU = fStatZC = fStatLate = fStatSkips = fStatGaveUp = 0;
+	fStatCopyAbs = fStatCopyMaxAbs = 0;
+	if (fDbuf && !fStatQuiet) {
+		IOLog("NEGRONI FB DBUF: flips/s %u waits %u in-place %u latch max us %llu (buffer %d shown, %d flipped, %llu flips)\n",
+		    fStatDbFlips, fStatDbWaits, fStatDbInPlace, negroni_fb_abs_us(fStatDbLatchMaxAbs), fDbShown, fDbFlipped,
+		    fDbFlipsTotal);
+		fStatDbFlips = fStatDbWaits = fStatDbInPlace = 0;
+		fStatDbLatchMaxAbs = 0;
+	}
+	if (fTeMode != 0 || fVrrMode != 0) {
+		teLog();
+	}
+}
+
+/* ---------------------------------------------------------------------- */
+/* 0259: TE-locked vsync and idle refresh switching                        */
+/* ---------------------------------------------------------------------- */
+
+static uint64_t
+negroni_fb_us_abs(uint64_t us)
+{
+	uint64_t abs;
+
+	nanoseconds_to_absolutetime(us * 1000ull, &abs);
+	return abs;
+}
+
+/*
+ * Boot-args: negronifb_te=1 phase-locks the vsync tick to the panel's TE as the display
+ * engine's tearcheck counter reports it (=2 also enables and logs INTF_VSYNC_TIMESTAMP);
+ * negronifb_te_off=N: the tick N us after the TE (negative: before the next TE; default
+ * NEGRONI_TE_TARGET_DEFAULT). negronifb_vrr=1: after negronifb_vrr_ms without a swap the panel
+ * holds each picture for 120/negronifb_vrr_fps TEs (DCS BD[0x14]) and the auto-refresh sends one
+ * frame per that many TEs; =2: the panel's 60 Hz (or 90 Hz, negronifb_vrr_fps=90) timing-switch
+ * command set, back to the 120 Hz set on the next swap; =3: the auto-refresh divider only (no
+ * DCS). negronifb_vrr_hs=1|0 forces the DCS transmission mode (default: high-speed for mode 2 as
+ * Android's dsi_hs_mode, low-power for mode 1 like the brightness). All default off.
+ */
+/*
+ * 0353: wait until the tearcheck frame counter (INTF_TEAR_INT_COUNT_VAL bits 31:16, one count per
+ * TE) advanced by frames. Returns the frames seen, -1 when the counter is not mapped (negronifb_te
+ * and negronifb_vrr both 0), -2 on timeout. Sleeps 1 ms per poll; any thread.
+ */
+extern "C" int
+negroni_fb_te_wait(uint32_t frames, uint32_t timeout_ms)
+{
+	vm_offset_t intf = negroni_fb_te_intf;
+	if (intf == 0) {
+		return -1;
+	}
+	uint32_t f0 = negroni_dpu_rd(intf + INTF_TEAR_INT_COUNT_VAL) >> 16;
+	for (uint32_t ms = 0; ms < timeout_ms; ms++) {
+		IOSleep(1);
+		uint32_t d = ((negroni_dpu_rd(intf + INTF_TEAR_INT_COUNT_VAL) >> 16) - f0) & 0xffffu;
+		if (d >= frames) {
+			return (int)d;
+		}
+	}
+	return -2;
+}
+
+void
+AppleCLCD::teInit(void)
+{
+	uint32_t te = 0, vrr = 0, fps = NEGRONI_VRR_FPS_DEFAULT, ms = NEGRONI_VRR_IDLE_MS_DEFAULT;
+	int32_t off = NEGRONI_TE_TARGET_DEFAULT, hs = -1;
+
+	PE_parse_boot_argn("negronifb_te", &te, sizeof(te));
+	PE_parse_boot_argn("negronifb_te_off", &off, sizeof(off));
+	PE_parse_boot_argn("negronifb_vrr", &vrr, sizeof(vrr));
+	PE_parse_boot_argn("negronifb_vrr_fps", &fps, sizeof(fps));
+	PE_parse_boot_argn("negronifb_vrr_ms", &ms, sizeof(ms));
+	PE_parse_boot_argn("negronifb_vrr_hs", &hs, sizeof(hs));
+	if (te == 0 && vrr == 0) {
+		return;
+	}
+	fIntf = fMdss != 0 ? fMdss + NEGRONI_INTF1_OFF :
+	    ml_io_map_unmappable(NEGRONI_INTF1_PA, NEGRONI_INTF1_LEN, NEGRONI_WIMG_IO);
+	if (fIntf == 0) {
+		IOLog("NEGRONI FB TE: no mapping of INTF_1 (0x%lx): negronifb_te/vrr off\n", NEGRONI_INTF1_PA);
+		return;
+	}
+	negroni_fb_te_intf = fIntf;     /* 0353 */
+	uint32_t cfg = negroni_dpu_rd(fIntf + INTF_TEAR_SYNC_CONFIG_VSYNC);
+	uint32_t count = negroni_dpu_rd(fIntf + INTF_TEAR_INT_COUNT_VAL);
+	uint32_t ar = negroni_dpu_rd(fIntf + INTF_TEAR_AUTOREFRESH_CONFIG);
+	uint32_t vsyncCount = cfg & 0x7ffffu;
+	fTeInit = negroni_dpu_rd(fIntf + INTF_TEAR_VSYNC_INIT_VAL) & 0xffffu;
+	fTeLineNs = vsyncCount != 0 ? (uint32_t)((uint64_t)vsyncCount * 1000000000ull / NEGRONI_TE_VSYNC_CLK_HZ) : 0;
+	IOLog("NEGRONI FB TE: INTF_1 tear_en %u sync_cfg 0x%08x (te pin %u, counter %u, vsync_count %u = %u ns/line) "
+	    "height %u init %u start %u thresh 0x%08x rd_ptr_irq %u wr_ptr_irq %u wrcount 0x%08x autorefresh 0x%08x "
+	    "count 0x%08x (frame %u line %u) tear_line %u vsync_sel %u intf_status 0x%x frame_count %u tear_irq 0x%08x\n",
+	    negroni_dpu_rd(fIntf + INTF_TEAR_TEAR_CHECK_EN), cfg, (cfg >> 20) & 1u, (cfg >> 19) & 1u, vsyncCount, fTeLineNs,
+	    negroni_dpu_rd(fIntf + INTF_TEAR_SYNC_CONFIG_HEIGHT) & 0xffffu, fTeInit,
+	    negroni_dpu_rd(fIntf + INTF_TEAR_START_POS) & 0xffffu, negroni_dpu_rd(fIntf + INTF_TEAR_SYNC_THRESH),
+	    negroni_dpu_rd(fIntf + INTF_TEAR_RD_PTR_IRQ) & 0xffffu, negroni_dpu_rd(fIntf + INTF_TEAR_WR_PTR_IRQ) & 0xffffu,
+	    negroni_dpu_rd(fIntf + INTF_TEAR_SYNC_WRCOUNT), ar, count, count >> 16, count & 0xffffu,
+	    negroni_dpu_rd(fIntf + INTF_TEAR_LINE_COUNT) & 0xffffu, negroni_dpu_rd(fIntf + INTF_TEAR_MDP_VSYNC_SEL),
+	    negroni_dpu_rd(fIntf + INTF_STATUS), negroni_dpu_rd(fIntf + INTF_FRAME_COUNT),
+	    negroni_dpu_rd(fIntf + INTF_TEAR_INTR_STATUS));
+	if (te != 0) {
+		if (fTeLineNs == 0) {
+			IOLog("NEGRONI FB TE: vsync_count 0: no line clock, negronifb_te off\n");
+		} else {
+			fTeMode = te;
+			fTeTarget = off;
+			if (te >= 2) {
+				negroni_dpu_wr(fIntf + INTF_VSYNC_TIMESTAMP_CTRL, 1);
+			}
+			IOLog("NEGRONI FB TE: lock on, target %d us %s the TE\n", off < 0 ? -off : off, off < 0 ? "before" : "after");
+		}
+	}
+	if (vrr != 0) {
+		if (vrr != 1 && vrr != 2 && vrr != 3) {
+			IOLog("NEGRONI FB VRR: negronifb_vrr=%u unknown: off\n", vrr);
+		} else if (vrr != 2 && ar != NEGRONI_VRR_AR_ON_1) {
+			IOLog("NEGRONI FB VRR: autorefresh 0x%08x is not on/1 as the UEFI leaves it: mode %u off\n", ar, vrr);
+		} else {
+			fVrrCall = thread_call_allocate(&AppleCLCD::vrrCall, this);
+			if (fVrrCall == NULL) {
+				IOLog("NEGRONI FB VRR: no thread call: off\n");
+				return;
+			}
+			fVrrMode = vrr;
+			/*
+			 * Android sends the timing-switch sets and the min-fps set in dsi_hs_mode (live.dts
+			 * 35650-35651, 35693-35699), the brightness in LP (0250 default). 0292: HS for mode 1 too.
+			 */
+			fVrrHS = hs < 0 ? true : hs != 0;
+			fVrrIdleAbs = negroni_fb_us_abs((uint64_t)(ms < 200 ? 200 : ms) * 1000ull);
+			if (vrr == 2) {
+				fVrrFps = fps == 90 ? 90 : 60;
+				fVrrExt = 0;
+				fVrrDiv = 1;
+			} else {
+				fps = fps == 0 ? 1 : (fps > 120 ? 120 : fps);
+				fVrrExt = 120 / fps - 1;        /* 10 Hz -> 0x0b, 1 Hz -> 0x77 */
+				fVrrExt = fVrrExt > 0x77 ? 0x77 : fVrrExt;
+				fVrrDiv = fVrrExt + 1;
+				fVrrFps = 120 / fVrrDiv;
+			}
+			fLastSwapAbs = mach_absolute_time();
+			IOLog("NEGRONI FB VRR: mode %u, idle %u Hz (hold 0x%02x, autorefresh 1/%u) after %u ms without a swap, DCS %s\n",
+			    vrr, fVrrFps, fVrrExt, fVrrDiv, ms, fVrrHS ? "HS" : "LP");
+		}
+	}
+}
+
+/*
+ * One tick: the tearcheck counter restarts at fTeInit on each TE and counts lines, so
+ * (line - init) * line time = the time since the TE. The phase is taken at this tick's
+ * deadline (a late handler start is not a phase error), compared with the target, and half
+ * the error moves the next deadline (bounded to a quarter period). The TE period itself is
+ * frames per second from the counter's frame field, and the tick period follows it when it
+ * is within 15 % of the nominal one.
+ */
+void
+AppleCLCD::teTick(uint64_t now)
+{
+	uint32_t v = negroni_dpu_rd(fIntf + INTF_TEAR_INT_COUNT_VAL);
+	uint32_t frame = v >> 16, line = v & 0xffffu;
+	uint64_t nominalNs;
+
+	absolutetime_to_nanoseconds(fTickNominalAbs, &nominalNs);
+	uint32_t nominalUs = (uint32_t)(nominalNs / 1000);
+	if (!fTeSeen) {
+		fTeSeen = true;
+		fTeLastFrame = fTeFirstFrame = frame;
+		fTeFirstAbs = now;
+		return;
+	}
+	uint32_t df = (frame - fTeLastFrame) & 0xffffu;
+	fTeLastFrame = frame;
+	fTeFrames += df;
+	if (df == 0) {
+		if (++fTeStopped == 120) {
+			IOLog("NEGRONI FB TE: no TE for 120 ticks (count 0x%08x)\n", v);
+		}
+	} else {
+		if (fTeStopped >= 120) {
+			IOLog("NEGRONI FB TE: TE back after %u ticks\n", fTeStopped);
+			fTeFirstFrame = frame;
+			fTeFirstAbs = now;
+		}
+		fTeStopped = 0;
+	}
+	uint64_t window = now - fTeFirstAbs;
+	uint32_t frames = (frame - fTeFirstFrame) & 0xffffu;
+	if (window >= fStatSecAbs && frames != 0) {
+		fTePeriodUs = (uint32_t)(negroni_fb_abs_us(window) / frames);
+		fTeFirstFrame = frame;
+		fTeFirstAbs = now;
+		/* the tick period follows the measured TE period (bounded; the nominal one when unsure) */
+		uint32_t lo = nominalUs - nominalUs * 15 / 100, hi = nominalUs + nominalUs * 15 / 100;
+		fTickAbs = (fTePeriodUs >= lo && fTePeriodUs <= hi) ? negroni_fb_us_abs(fTePeriodUs) : fTickNominalAbs;
+	}
+	uint32_t periodUs = fTePeriodUs != 0 ? fTePeriodUs : nominalUs;
+	if (fTeStopped != 0 && df == 0 && fTeStopped > 2) {
+		fTeNoSample++;
+		return;                 /* no TE for several ticks: no phase to lock on */
+	}
+	if (line < fTeInit) {
+		fTeNoSample++;
+		return;
+	}
+	uint64_t sinceTeNs = (uint64_t)(line - fTeInit) * fTeLineNs;
+	(void)negroni_dpu_te_since(now, &sinceTeNs);    /* 0295 negronifb_teirq=1: the rd_ptr interrupt's TE stamp */
+	if (sinceTeNs > 2ull * periodUs * 1000ull) {
+		fTeNoSample++;
+		return;                 /* the counter ran past a frame: no TE came */
+	}
+	int64_t lateNs = 0;
+	if (now > fDeadline) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(now - fDeadline, &ns);
+		lateNs = (int64_t)ns;
+	}
+	int32_t phase = (int32_t)(((int64_t)sinceTeNs - lateNs) / 1000);
+	while (phase < 0) {
+		phase += (int32_t)periodUs;
+	}
+	phase %= (int32_t)periodUs;
+	int32_t target = fTeTarget < 0 ? (int32_t)periodUs + fTeTarget : fTeTarget;
+	target = target < 0 ? 0 : (target >= (int32_t)periodUs ? (int32_t)periodUs - 1 : target);
+	int32_t err = phase - target;
+	if (err > (int32_t)periodUs / 2) {
+		err -= (int32_t)periodUs;
+	} else if (err < -(int32_t)periodUs / 2) {
+		err += (int32_t)periodUs;
+	}
+	/* err > 0: this tick came after the target: the next deadline comes sooner */
+	int32_t adj = -err / 2;
+	int32_t bound = (int32_t)periodUs / 4;
+	adj = adj > bound ? bound : (adj < -bound ? -bound : adj);
+	fTePhaseUs = phase;
+	fTeErrUs = err;
+	fTeAdjUs = adj;
+	fTeAdjAbs = adj >= 0 ? (int64_t)negroni_fb_us_abs((uint64_t)adj) : -(int64_t)negroni_fb_us_abs((uint64_t)(-adj));
+	fTeSamples++;
+	fTeErrSum += err < 0 ? -err : err;
+	if ((err < 0 ? -err : err) > fTeErrMax) {
+		fTeErrMax = err < 0 ? -err : err;
+	}
+	if ((err < 0 ? -err : err) <= NEGRONI_TE_LOCK_US) {
+		fTeLocked++;
+	}
+}
+
+/* One line per second after the STAT line (statTick). */
+void
+AppleCLCD::teLog(void)
+{
+	if (fTeMode != 0 && fIntf != 0) {
+		uint32_t frames = fTeFrames;
+		fTeFrames = 0;
+		char ts[48] = "";
+		if (fTeMode >= 2) {
+			uint64_t t = (uint64_t)negroni_dpu_rd(fIntf + INTF_VSYNC_TIMESTAMP1) << 32 |
+			    negroni_dpu_rd(fIntf + INTF_VSYNC_TIMESTAMP0);
+			snprintf(ts, sizeof(ts), " ts 0x%llx (+%llu)", t, t - fTeTs);
+			fTeTs = t;
+		}
+		if (!fStatQuiet) {      /* 0382 */
+		IOLog("NEGRONI FB TE: te/s %u period us %u tick us %llu phase us %d target %d err avg/max us %lld/%d "
+		    "adj us %d locked %u/%u ticks (no sample %u) count 0x%08x autorefresh 0x%08x%s\n",
+		    frames, fTePeriodUs, negroni_fb_abs_us(fTickAbs), fTePhaseUs,
+		    fTeTarget < 0 ? (int32_t)(fTePeriodUs != 0 ? fTePeriodUs : 8333) + fTeTarget : fTeTarget,
+		    fTeSamples != 0 ? fTeErrSum / fTeSamples : 0, fTeErrMax, fTeAdjUs, fTeLocked, fTeSamples, fTeNoSample,
+		    negroni_dpu_rd(fIntf + INTF_TEAR_INT_COUNT_VAL), negroni_dpu_rd(fIntf + INTF_TEAR_AUTOREFRESH_CONFIG), ts);
+		}
+		fTeLocked = fTeSamples = fTeNoSample = 0;
+		fTeErrSum = 0;
+		fTeErrMax = 0;
+	}
+	if (fVrrMode != 0 && !fStatQuiet) {     /* 0382 */
+		IOLockLock(fLock);
+		uint32_t state = fVrrState;
+		uint64_t idleAbs = fVrrIdleTotalAbs + (state == kNegroniVrrIdle ? mach_absolute_time() - fVrrIdleAt : 0);
+		IOLockUnlock(fLock);
+		static const char *const names[] = { "active", "going idle", "idle", "waking" };
+		IOLog("NEGRONI FB VRR: %s (idle %u Hz)%s, %u idle periods, idle %llu ms in all, DCS errors %u\n",
+		    names[state & 3], fVrrFps, fVrrDisabled ? " OFF after a failed switch" : "", fVrrIdleCount,
+		    negroni_fb_abs_us(idleAbs) / 1000, fVrrDcsErrors);
+	}
+}
+
+/* Work loop, fLock held: no swap for negronifb_vrr_ms while the display is on: go idle. */
+void
+AppleCLCD::vrrTick(uint64_t now)
+{
+	if (fVrrMode == 0 || fVrrDisabled || fPowerOff || fVrrState != kNegroniVrrActive || fLastSwapAbs == 0 ||
+	    now - fLastSwapAbs < fVrrIdleAbs) {
+		return;
+	}
+	fVrrState = kNegroniVrrGoingIdle;
+	if (!fVrrBusy) {
+		fVrrBusy = true;
+		thread_call_enter(fVrrCall);
+	}
+}
+
+/*
+ * fLock held, any thread (swap: backboardd; RequestPowerChange; the tick). Back to the full
+ * rate: the auto-refresh divider goes back at once (one register write, the engine sends the
+ * next frame on the next TE), the DCS follows on the thread call.
+ */
+void
+AppleCLCD::vrrWakeLocked(void)
+{
+	if (fVrrMode == 0 || fVrrState == kNegroniVrrActive || fVrrState == kNegroniVrrWaking) {
+		return;
+	}
+	if (fVrrMode != 2 && fIntf != 0) {
+		negroni_dpu_wr(fIntf + INTF_TEAR_AUTOREFRESH_CONFIG, NEGRONI_VRR_AR_ON_1);
+	}
+	fVrrState = kNegroniVrrWaking;
+	if (!fVrrBusy) {
+		fVrrBusy = true;
+		thread_call_enter(fVrrCall);
+	}
+}
+
+void
+AppleCLCD::vrrCall(thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	((AppleCLCD *)p0)->vrrWork();
+}
