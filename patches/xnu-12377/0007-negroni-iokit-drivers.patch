+
+/* Send a DT-format command set, each packet one DCS write in HS mode, the wait byte honoured. */
+static int
+negroni_fp_send_set(const uint8_t *set, uint32_t len, uint32_t *sent)
+{
+	uint32_t i = 0, n = 0;
+	int rc = 0;
+	while (i + 7 <= len && rc == 0) {
+		uint8_t type = set[i], wait = set[i + 4];
+		uint32_t plen = (uint32_t)set[i + 5] << 8 | set[i + 6];
+		if (plen == 0 || i + 7 + plen > len || (type != 0x05 && type != 0x15 && type != 0x39)) {
+			rc = -4;
+			break;
+		}
+		rc = negroni_dsi_dcs_write(set + i + 7, plen, false);
+		if (rc == 0) {
+			n++;
+			if (wait != 0) {
+				IOSleep(wait);
+			}
+		}
+		i += 7 + plen;
+	}
+	*sent = n;
+	return rc;
+}
+
+static int negroni_fp_hl_mode(void);
+
+/* Thread context (0250: the DSI write sleeps on its lock). 0354: mode 2 = disc without HBM: no DCS. */
+extern "C" int
+negroni_fp_hbm(bool on)
+{
+	uint32_t sent = 0;
+	if (negroni_fp_hl_mode() == 2) {
+		IOLog("NEGRONI FP HL: panel HBM %s skipped (negronifp_hl=2: disc only)\n", on ? "on" : "off");
+		return 0;
+	}
+	int rc = on ? negroni_fp_send_set(negroni_fp_hbm_on, sizeof(negroni_fp_hbm_on), &sent)
+	    : negroni_fp_send_set(negroni_fp_hbm_off, sizeof(negroni_fp_hbm_off), &sent);
+	if (rc == 0) {
+		negroni_fp_hbm_state = on;
+	}
+	IOLog("NEGRONI FP HL: panel HBM %s: %s (%u packets)\n", on ? "on" : "off", rc == 0 ? "ok" : "failed", sent);
+	return rc;
+}
+
+static int
+negroni_fp_hl_mode(void)
+{
+	int st = __atomic_load_n(&negroni_fp_init_state, __ATOMIC_ACQUIRE);
+	if (st == 2) {
+		return negroni_fp_hl;
+	}
+	if (st == 1 || !__atomic_compare_exchange_n(&negroni_fp_init_state, &st, 1, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		while (__atomic_load_n(&negroni_fp_init_state, __ATOMIC_ACQUIRE) != 2) {
+			delay(10);              /* another thread parses the boot-args and makes the lock */
+		}
+		return negroni_fp_hl;
+	}
+	{
+		negroni_fp_hl = 0;
+		PE_parse_boot_argn("negronifp_hl", &negroni_fp_hl, sizeof(negroni_fp_hl));
+		PE_parse_boot_argn("negronifp_hl_x", &negroni_fp_hl_x, sizeof(negroni_fp_hl_x));
+		PE_parse_boot_argn("negronifp_hl_y", &negroni_fp_hl_y, sizeof(negroni_fp_hl_y));
+		PE_parse_boot_argn("negronifp_hl_r", &negroni_fp_hl_r, sizeof(negroni_fp_hl_r));
+		if (negroni_fp_hl < 0 || negroni_fp_hl > 2 || negroni_fp_hl_r < 4 || negroni_fp_hl_r > 400) {
+			negroni_fp_hl = 0;
+		}
+		negroni_fp_lock = IOLockAlloc();
+		if (negroni_fp_lock == NULL) {
+			negroni_fp_hl = 0;
+		}
+		if (negroni_fp_hl) {
+			const size_t n = (size_t)(2 * negroni_fp_hl_r + 1) * (2 * negroni_fp_hl_r + 1) * 4;
+			negroni_fp_save = (uint32_t *)IOMalloc(n);      /* once: r is fixed from here on */
+		}
+		if (negroni_fp_hl) {
+			IOLog("NEGRONI FP HL: highlight allowed (mode %d): disc at %d,%d radius %d panel px; "
+			    "glyph while kern.negroni_fp_ui=1, disc while a capture has a finger%s\n", negroni_fp_hl,
+			    negroni_fp_hl_x, negroni_fp_hl_y, negroni_fp_hl_r, negroni_fp_hl == 1 ? ", panel HBM in the capture" : "");
+		}
+	}
+	__atomic_store_n(&negroni_fp_init_state, 2, __ATOMIC_RELEASE);
+	return negroni_fp_hl;
+}
+
+/* What the overlay shows now: 0 nothing, 1 glyph, 2 capture disc. */
+static int
+negroni_fp_hl_show(void)
+{
+	if (negroni_fp_hl_mode() == 0) {
+		return 0;
+	}
+	if (negroni_fp_cap_open) {
+		if (mach_absolute_time() > negroni_fp_cap_deadline) {
+			negroni_fp_cap_open = false;
+			IOLog("NEGRONI FP HL: capture window timed out (2 s)\n");
+		} else if (negroni_fp_fingers != 0) {
+			return 2;
+		}
+	}
+	return negroni_fp_ui == 1 ? 1 : 0;
+}
+
+/*
+ * what == 2: a filled white disc; what == 1: two thin rings (2 px) at r and at 0.55 r in the fixed dim grey.
+ * save != NULL: the pixels before the drawing go there ((2r+1)^2, row-major from cx-r, cy-r).
+ */
+static void
+negroni_fp_paint(uintptr_t pixels, uint32_t rowBytes, uint32_t width, uint32_t height, int what, uint32_t *save)
+{
+	const int cx = negroni_fp_hl_x, cy = negroni_fp_hl_y, r = negroni_fp_hl_r;
+	const int r2 = r * r, ri = (r - 2) * (r - 2);
+	const int rb = (r * 55) / 100, rb2 = rb * rb, rbi = (rb - 2) * (rb - 2);
+	for (int y = cy - r; y <= cy + r; y++) {
+		if (y < 0 || y >= (int)height) {
+			continue;
+		}
+		uint32_t *row = (uint32_t *)(pixels + (uint64_t)y * rowBytes);
+		const int dy = y - cy;
+		for (int x = cx - r; x <= cx + r; x++) {
+			if (x < 0 || x >= (int)width) {
+				continue;
+			}
+			const int dx = x - cx, d2 = dx * dx + dy * dy;
+			if (save != NULL) {
+				save[(y - (cy - r)) * (2 * r + 1) + (x - (cx - r))] = row[x];
+			}
+			if (what == 2) {
+				if (d2 <= r2) {
+					row[x] = 0xffffffffu;
+				}
+			} else if ((d2 <= r2 && d2 >= ri) || (d2 <= rb2 && d2 >= rbi)) {
+				row[x] = NEGRONI_FP_GLYPH_PX;
+			}
+		}
+	}
+}
+
+/* at each present, after the copy: the panel memory holds a fresh frame, nothing to save */
+static void
+negroni_fp_draw_highlight(uintptr_t pixels, uint32_t rowBytes, uint32_t width, uint32_t height)
+{
+	if (negroni_fp_hl_mode() == 0) {
+		return;
+	}
+	IOLockLock(negroni_fp_lock);
+	int what = negroni_fp_hl_show();
+	if (what == 0 || pixels == 0) {
+		negroni_fp_shown = 0;
+	} else {
+		negroni_fp_paint(pixels, rowBytes, width, height, what, NULL);
+		negroni_fp_shown = what;
+	}
+	IOLockUnlock(negroni_fp_lock);
+}
+
+/* present(): one count per frame on the panel memory path (the restore's "no present since" test) */
+static inline void
+negroni_fp_present_tick(void)
+{
+	negroni_fp_hl_frames++;
+}
+
+/*
+ * Direct drawing on a state change (any thread; the lock screen may present no frame). Not while
+ * the pipes fetch a framebuffer (zero-copy; that frame is not in the panel memory): the next copy
+ * draws it. The previous direct drawing is restored first when no present came after it.
+ */
+extern "C" void
+negroni_fp_overlay_update(void)
+{
+	AppleCLCD *fb = negroni_fb_main;
+	if (fb == NULL || fb->fPixels == 0 || negroni_fp_hl_mode() == 0) {
+		return;
+	}
+	IOLockLock(negroni_fp_lock);
+	int what = negroni_fp_hl_show();
+	if (what == negroni_fp_shown) {
+		IOLockUnlock(negroni_fp_lock);
+		return;
+	}
+	const int r = negroni_fp_hl_r;
+	if (fb->fZCActive) {
+		negroni_fp_shown = 0;           /* that picture is not ours to touch; the next copy draws */
+		IOLockUnlock(negroni_fp_lock);
+		return;
+	}
+	uintptr_t px = fb->fPixels;
+	uint32_t rb = fb->fRowBytes, w = fb->fWidth, h = fb->fHeight;
+	/* put the saved pixels back when they are still the picture under the drawing */
+	if (negroni_fp_shown != 0 && negroni_fp_save != NULL && negroni_fp_shown_frame == negroni_fp_hl_frames) {
+		const int cx = negroni_fp_hl_x, cy = negroni_fp_hl_y;
+		for (int y = cy - r; y <= cy + r; y++) {
+			if (y < 0 || y >= (int)h) {
+				continue;
+			}
+			uint32_t *row = (uint32_t *)(px + (uint64_t)y * rb);
+			for (int x = cx - r; x <= cx + r; x++) {
+				if (x >= 0 && x < (int)w) {
+					row[x] = negroni_fp_save[(y - (cy - r)) * (2 * r + 1) + (x - (cx - r))];
+				}
+			}
+		}
+		negroni_fp_restores++;
+	}
+	negroni_fp_shown = 0;
+	if (what != 0) {
+		negroni_fp_paint(px, rb, w, h, what, negroni_fp_save);
+		negroni_fp_shown = what;
+		negroni_fp_shown_frame = negroni_fp_hl_frames;
+		negroni_fp_direct++;
+	}
+	uint32_t fingers = negroni_fp_fingers, direct = negroni_fp_direct, restores = negroni_fp_restores;
+	bool open = negroni_fp_cap_open;
+	int ui = negroni_fp_ui;
+	IOLockUnlock(negroni_fp_lock);
+	IOLog("NEGRONI FP HL: overlay %s (ui %d, capture %s, fingers %#x; direct %u, restores %u, frames %llu)\n",
+	    what == 2 ? "capture disc" : what == 1 ? "lock-screen glyph" : "off", ui, open ? "open" : "closed",
+	    fingers, direct, restores, negroni_fp_hl_frames);
+}
+
+/* kern.negroni_fp_ui (negroni_fp.c sysctl; negroni-fpd writes it from the SpringBoard lock state) */
+extern "C" void
+negroni_fp_ui_set(int v)
+{
+	if (negroni_fp_hl_mode() == 0) {
+		return;
+	}
+	IOLockLock(negroni_fp_lock);
+	negroni_fp_ui = v ? 1 : 0;
+	IOLockUnlock(negroni_fp_lock);
+	negroni_fp_overlay_update();
+}
+
+/* 0353's capture: the window in which a finger on the sensor shows the disc */
+extern "C" void
+negroni_fp_capture_window(bool on)
+{
+	if (negroni_fp_hl_mode() == 0) {
+		return;
+	}
+	IOLockLock(negroni_fp_lock);
+	if (on) {
+		clock_interval_to_deadline(2000, kMillisecondScale, &negroni_fp_cap_deadline);
+	}
+	negroni_fp_cap_open = on;
+	IOLockUnlock(negroni_fp_lock);
+	negroni_fp_overlay_update();
+}
+
+/*
+ * negroni_touch.c: every finger report (down = 1 on down and move, 0 on up), panel pixels. The
+ * fingers are tracked in every mode (0353's capture needs the finger with negronifp_hl=0 too);
+ * only the drawing is gated by negronifp_hl.
+ */
+extern "C" void
+negroni_fp_touch(int finger, int down, int x, int y)
+{
+	if (finger < 0 || finger > 31) {
+		return;
+	}
+	(void)negroni_fp_hl_mode();     /* parses x, y, r and makes the lock */
+	const int dx = x - negroni_fp_hl_x, dy = y - negroni_fp_hl_y, r = negroni_fp_hl_r;
+	uint32_t bit = 1u << finger, now = (down && dx * dx + dy * dy <= r * r) ? bit : 0;
+	bool changed, open;
+	IOLockLock(negroni_fp_lock);
+	uint32_t before = negroni_fp_fingers;
+	negroni_fp_fingers = (before & ~bit) | now;
+	changed = negroni_fp_fingers != before;
+	open = negroni_fp_cap_open;
+	IOLockUnlock(negroni_fp_lock);
+	if (changed && open) {
+		negroni_fp_overlay_update();
+	}
+}
+
+extern "C" int
+negroni_fp_finger_down(void)
+{
+	return __atomic_load_n(&negroni_fp_fingers, __ATOMIC_ACQUIRE) != 0;
+}
+
+
+/*
+ * held: the frame's surfaces swap() holds for a GPU present (NULL entries: that layer, if any,
+ * goes the CPU way). fences: each layer's swap-time GPU fence (0254), done or given up when the
+ * tick calls this. Returns the newest GPU copy's fence, 0 if the CPU did everything.
+ */
+uint32_t
+AppleCLCD::present(const uint8_t *rec, NegroniSurface *const *held, const uint32_t *fences)
+{
+	uint32_t mask = get32(rec, 0x104);
+	bool topRedrawn = false;
+	uint32_t fence = 0;             /* the newest GPU copy of this frame */
+	bool gpuReady = NegroniGPUPresentReady(), cpuCopied = false;
+	const int32_t clockRows = (int32_t)negroni_clock_rows();
+	/*
+	 * 0267: the clock shift inside the copy. A frame of one layer that covers the status bar's
+	 * left half is written with that strip already shifted (GPU: four rectangles in one
+	 * submission; CPU: three memcpys per strip row): the CPU never reads the write-combined panel
+	 * memory (an uncached read, ~10 MB/s: the in-place memmove of 120 x 540 pixels took several
+	 * ms with the display engine scanning the half-shifted strip) and nothing changes the strip
+	 * after the copy. The n pixels the shift pushes out at the middle of the screen (the notch
+	 * area of the 1125-wide canvas: no status bar item there) fill the n pixels it opens at the
+	 * left edge (0256 filled them with the edge pixel of each row).
+	 */
+	const uint32_t shiftPx = fClockCopy ? negroni_clock_shift_px() : 0, half = fWidth / 2;
+	const bool oneLayer = __builtin_popcount(mask & ((1u << NEGRONI_FB_LAYERS) - 1)) == 1;
+	bool shiftedInCopy = false;
+
+
+	if (!fConsolePaused) {
+		int quiet = 0;
+		fConsolePaused = true;
+		if (PE_parse_boot_argn("negronifb_noconsole", &quiet, sizeof(quiet)) && quiet != 0) {
+			/* Not PE_initialize_console(kPEDisableScreen): its console switch
+			 * writes the read-only-late cons_ops_index and panics. */
+			negroni_console_muted = 1;
+		}
+	}
+
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		NegroniSurface *s = negroni_surface_copy(id);
+		if (negroni_fb_swaps_logged < 16) {
+			negroni_fb_swaps_logged++;
+			IOLog("NEGRONI FB: swap %u layer %u surface %u %ux%u fmt 0x%x bpr %u a %d,%d %ux%u b %d,%d %dx%d\n",
+			    get32(rec, 0x50), layer, id, s ? s->width : 0, s ? s->height : 0,
+			    s ? s->pixelFormat : 0, s ? s->bytesPerRow : 0, sx, sy, get32(a, 8),
+			    get32(a, 12), dx, dy, w, h);
+		}
+		if (s == NULL || s == fSurface) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		uintptr_t src = s->kernelAddress();
+		uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+		if (w <= 0 || h <= 0) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (dx < 0 || dy < 0) {
+			dx = dy = 0;
+		}
+		/* Logical (presented) display coordinates -> panel coordinates. */
+		dx -= fOffX;
+		dy -= fOffY;
+		if (dx < 0) {
+			sx -= dx;
+			w += dx;
+			dx = 0;
+		}
+		if (dy < 0) {
+			sy -= dy;
+			h += dy;
+			dy = 0;
+		}
+		if (w > (int32_t)s->width - sx) {
+			w = (int32_t)s->width - sx;
+		}
+		if (h > (int32_t)s->height - sy) {
+			h = (int32_t)s->height - sy;
+		}
+		if (w > (int32_t)fWidth - dx) {
+			w = (int32_t)fWidth - dx;
+		}
+		if (h > (int32_t)fHeight - dy) {
+			h = (int32_t)fHeight - dy;
+		}
+		uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+		    (uint64_t)(sx + w) * 4;
+		bool fits = !(w <= 0 || h <= 0 || s->elementWidth != 1 || s->elementHeight != 1 ||
+		    s->memory == NULL || last > s->memory->getLength());
+		if (!fits) {
+			src = 0;
+		}
+		uint32_t written = fences[layer];      /* 0254: the swap-time fence, not s->gpuFence */
+		/* 0254: not done now = given up. Newer work that lists s (s->gpuFence moved on): the ring is
+		 * in order, so a 2D copy would wait behind it; the CPU copies now instead. */
+		bool stale = written != 0 && !NegroniGPUFenceDone(written);
+		bool behind = s->gpuFence != written && !NegroniGPUFenceDone(s->gpuFence);
+		bool inCopy = shiftPx > 0 && shiftPx < half && oneLayer && dy == 0 && dx == 0 &&
+		    h >= clockRows && w >= (int32_t)half;
+		if (fits && bpe == 4 && written != 0 && !stale && !behind && gpuReady && held[layer] == s) {
+			if (dy == 0 && dx == 0 && h >= clockRows && w >= (int32_t)fWidth / 2) {
+				topRedrawn = true;
+			}
+			uint32_t f;
+			if (inCopy) {
+				/* rows below the strip as they are; the strip's left half n to the right, its
+				 * last n pixels to the left edge; the strip's right half as it is */
+				struct NegroniGPURect r[NEGRONI_GPU_PRESENT_RECTS];
+				uint32_t nr = 0, R = (uint32_t)clockRows, n = shiftPx;
+				if ((uint32_t)h > R) {
+					r[nr++] = { (uint32_t)sx, (uint32_t)sy + R, 0, R, (uint32_t)w, (uint32_t)h - R };
+				}
+				r[nr++] = { (uint32_t)sx, (uint32_t)sy, n, 0, half - n, R };
+				r[nr++] = { (uint32_t)sx + half - n, (uint32_t)sy, 0, 0, n, R };
+				if ((uint32_t)w > half) {
+					r[nr++] = { (uint32_t)sx + half, (uint32_t)sy, half, 0, (uint32_t)w - half, R };
+				}
+				f = NegroniGPUPresentRects(s, fDrawPhys, fRowBytes, fHeight, r, nr);
+				if (f != 0) {
+					shiftedInCopy = true;
+					fClockCopyFrames++;
+				}
+			} else {
+				f = NegroniGPUPresent(s, fDrawPhys, fRowBytes, fHeight, (uint32_t)sx, (uint32_t)sy,
+				    (uint32_t)dx, (uint32_t)dy, (uint32_t)w, (uint32_t)h);
+			}
+			if (f != 0) {
+				fence = f;
+				s->release();
+				continue;
+			}
+		}
+		if (src != 0 && bpe == 4 && fence != 0) {
+			/* this layer lies over a GPU copy of the same frame: after it */
+			NegroniGPUFenceWait(fence, NEGRONI_FB_GPU_COPY_WAIT_MS);
+		}
+		if (src != 0 && bpe == 4 && written != 0) {
+			/* the GPU wrote it: its swap-time fence passed (the tick checked it, no wait here), and
+			 * none of the CPU's old lines over it */
+			NegroniGPUSurfaceForCPU(s, (uint64_t)s->offset + (uint64_t)sy * s->bytesPerRow,
+			    (uint64_t)h * s->bytesPerRow);
+		}
+		if (src != 0 && bpe == 4) {
+			cpuCopied = true;
+			if (dy == 0 && dx == 0 && h >= clockRows && w >= (int32_t)fWidth / 2) {
+				topRedrawn = true;      /* this frame rewrote the status bar's left ear */
+			}
+			for (int32_t y = 0; y < h; y++) {
+				uint8_t *d = (uint8_t *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4);
+				const uint8_t *r = (const uint8_t *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow +
+				    (uint64_t)sx * 4);
+				if (inCopy && y < clockRows) {
+					/* 0267: the strip row shifted while it is copied (dx == 0, w >= half) */
+					memcpy(d + (uint64_t)shiftPx * 4, r, (size_t)(half - shiftPx) * 4);
+					memcpy(d, r + (uint64_t)(half - shiftPx) * 4, (size_t)shiftPx * 4);
+					memcpy(d + (uint64_t)half * 4, r + (uint64_t)half * 4, (size_t)(w - (int32_t)half) * 4);
+				} else {
+					memcpy(d, r, (size_t)w * 4);
+				}
+			}
+			if (inCopy) {
+				shiftedInCopy = true;
+				fClockCopyCPU++;
+			}
+		}
+		s->release();
+	}
+	if (fence != 0) {
+		fLastGPUFence = fence;
+		fGPUFrames++;
+	} else if (cpuCopied) {
+		fCPUFrames++;
+	}
+	if ((fGPUFrames + fCPUFrames) % 1000 == 999) {
+		IOLog("NEGRONI FB: %llu frames by the GPU, %llu by the CPU\n", fGPUFrames, fCPUFrames);
+	}
+	/*
+	 * 0267: the CPU's drawing over the copy (the 0256 shift when the copy did not shift, the
+	 * badges) is presentFinish(); with negronifb_notifylate it runs after the vsync notification
+	 * for a GPU copy (its fence wait no longer delays the swap id CoreAnimation waits for).
+	 */
+	bool cpuShift = topRedrawn && negroni_clock_shift_px() > 0 && !shiftedInCopy;
+	if (topRedrawn && !cpuShift) {
+		fShiftPending = false;          /* the copy rewrote the strip (shifted, or no shift) */
+	}
+	if (shiftedInCopy && fClockCopyLogged < 4) {
+		fClockCopyLogged++;
+		IOLog("NEGRONI FB: clock shift inside the copy (%s), %llu GPU + %llu CPU frames so far\n",
+		    fence != 0 ? "GPU, 4 rectangles" : "CPU", fClockCopyFrames, fClockCopyCPU);
+	}
+	fFinishTop = cpuShift;
+	fFinishFence = fence;
+	negroni_fp_present_tick();      /* 0354: a frame on the panel memory path */
+	fFinishPending = cpuShift || negroni_badges != 0 || negroni_fp_hl_show() > 0;   /* 0351/0354: only while shown */
+	if (fFinishPending && (!fNotifyLate || fence == 0 || fZCActive)) {
+		presentFinish();
+	}
+	return fence;
+}
+
+/*
+ * 0267: what present() leaves to draw with the CPU over the frame: the 0256 clock shift (after
+ * the GPU copy's fence; pending for shiftTick when it is not done in NEGRONI_FB_GPU_COPY_WAIT_MS)
+ * and the badges. Work loop.
+ */
+void
+AppleCLCD::presentFinish(void)
+{
+	uint32_t fence = fFinishFence;
+	bool topRedrawn = fFinishTop;
+
+	fFinishPending = false;
+	bool copied = true;             /* the GPU's copy of this frame is in the panel memory */
+	if (fence != 0 && (topRedrawn || negroni_badges > 0 || negroni_fp_hl_show() > 0)) {
+		/* the CPU draws over the GPU's picture: after it */
+		copied = NegroniGPUFenceWait(fence, NEGRONI_FB_GPU_COPY_WAIT_MS);
+	}
+	if (topRedrawn) {
+		if (fence != 0 && !copied) {
+			/* 0256: not yet in the panel memory: the shift waits for the fence (shiftTick); a
+			 * shift now would move the previous frame's rows again, under the engine's write */
+			fShiftFence = fence;
+			fShiftPending = true;
+			fShiftDeferred++;
+		} else {
+			fShiftPending = false;
+			negroni_shift_clock(fPixels, fRowBytes, fWidth, fHeight);
+		}
+	}
+	negroni_draw_badge(fPixels, fRowBytes, fWidth, fHeight);
+	negroni_fp_draw_highlight(fPixels, fRowBytes, fWidth, fHeight);   /* 0351/0354 */
+}
+
+/*
+ * 0256: the clock shift of a frame whose GPU copy was not done when present() ran. Work loop,
+ * every vsync tick: as soon as the fence is done the strip is shifted, once. A newer frame that
+ * rewrote the top (present() with topRedrawn) replaces or clears it before this runs.
+ */
+void
+AppleCLCD::shiftTick(void)
+{
+	if (!fShiftPending) {
+		return;
+	}
+	if (!NegroniGPUFenceDone(fShiftFence)) {
+		return;
+	}
+	fShiftPending = false;
+	fShiftLate++;
+	negroni_shift_clock(fPixels, fRowBytes, fWidth, fHeight);
+	if (fShiftLogged < 8) {
+		fShiftLogged++;
+		IOLog("NEGRONI FB: clock shift after fence %u (deferred %llu, done late %llu)\n", fShiftFence,
+		    fShiftDeferred, fShiftLate);
+	}
+}
+
+/* ---- zero-copy scanout (0234) ---- */
+
+/*
+ * Read what ABL left in the display engine (read only) and check it is the layout the flips
+ * assume: one pipe, or two side by side, fetching the panel memory from row 0 with its stride.
+ * Then, with negronifb_zerocopy=1, the rest of the splash region becomes display slots.
+ */
+void
+AppleCLCD::zeroCopyInit(void)
+{
+	int on = 0, probe = 1, quiet = 0, badge = 0;
+	uint32_t ctl = ~0u, width = 0;
+	const char *why = NULL;
+
+	PE_parse_boot_argn("negronifb_zerocopy", &on, sizeof(on));
+	PE_parse_boot_argn("negronifb_dpuprobe", &probe, sizeof(probe));
+	PE_parse_boot_argn("negronifb_noconsole", &quiet, sizeof(quiet));
+	PE_parse_boot_argn("negronibadge", &badge, sizeof(badge));
+	PE_parse_boot_argn("negronifb_ctl", &ctl, sizeof(ctl));
+	if (!probe && !on) {
+		return;
+	}
+	if (fPhys != NEGRONI_SPLASH_PA) {
+		IOLog("NEGRONI FB: zero-copy: the panel memory 0x%llx is not the splash region\n", fPhys);
+		return;
+	}
+	fMdss = ml_io_map_unmappable(NEGRONI_MDSS_PA, NEGRONI_MDSS_LEN, NEGRONI_WIMG_IO);
+	if (fMdss == 0) {
+		IOLog("NEGRONI FB: zero-copy: no mapping of the display engine\n");
+		return;
+	}
+	for (uint32_t p = 0; p < NEGRONI_SSPPS; p++) {
+		vm_offset_t b = fMdss + negroni_sspp_off[p];
+		uint32_t addr = negroni_dpu_rd(b + SSPP_SRC0_ADDR);
+		IOLog("NEGRONI FB: DPU %s addr 0x%x size 0x%x xy 0x%x out 0x%x at 0x%x stride 0x%x format 0x%x op 0x%x\n",
+		    negroni_sspp_name[p], addr, negroni_dpu_rd(b + SSPP_SRC_SIZE), negroni_dpu_rd(b + SSPP_SRC_XY),
+		    negroni_dpu_rd(b + SSPP_OUT_SIZE), negroni_dpu_rd(b + SSPP_OUT_XY), negroni_dpu_rd(b + SSPP_SRC_YSTRIDE0),
+		    negroni_dpu_rd(b + SSPP_SRC_FORMAT), negroni_dpu_rd(b + SSPP_SRC_OP_MODE));
+		if (addr == (uint32_t)fPhys && fZCPipes < 2) {
+			fZCPipe[fZCPipes++] = p;
+		} else if (addr == (uint32_t)fPhys) {
+			why = "more than two pipes fetch the panel memory";
+		}
+	}
+	for (uint32_t c = 0; c < NEGRONI_CTLS; c++) {
+		vm_offset_t b = fMdss + negroni_ctl_off[c];
+		uint32_t intf = negroni_dpu_rd(b + CTL_INTF_ACTIVE);
+		IOLog("NEGRONI FB: DPU CTL%u layer 0x%x 0x%x 0x%x 0x%x top 0x%x flush 0x%x intf 0x%x fetch 0x%x\n", c,
+		    negroni_dpu_rd(b + CTL_LAYER0), negroni_dpu_rd(b + CTL_LAYER0 + 4), negroni_dpu_rd(b + CTL_LAYER0 + 8),
+		    negroni_dpu_rd(b + CTL_LAYER0 + 12), negroni_dpu_rd(b + CTL_TOP), negroni_dpu_rd(b + CTL_FLUSH), intf,
+		    negroni_dpu_rd(b + CTL_FETCH_PIPE_ACTIVE));
+		if (ctl == ~0u && (intf & CTL_INTF_DSI0)) {
+			ctl = c;
+		}
+	}
+	if (ctl >= NEGRONI_CTLS) {
+		ctl = 0;
+	}
+	fZCCtl = negroni_ctl_off[ctl];
+	for (uint32_t i = 0; i < fZCPipes; i++) {
+		vm_offset_t b = fMdss + negroni_sspp_off[fZCPipe[i]];
+		uint32_t size = negroni_dpu_rd(b + SSPP_SRC_SIZE);
+		fZCAblAddr[i] = negroni_dpu_rd(b + SSPP_SRC0_ADDR);
+		fZCAblXY[i] = negroni_dpu_rd(b + SSPP_SRC_XY);
+		fZCAblStride[i] = negroni_dpu_rd(b + SSPP_SRC_YSTRIDE0);
+		if ((size >> 16) != fHeight || (fZCAblXY[i] >> 16) != 0 || (fZCAblXY[i] & 0xffff) != width ||
+		    (fZCAblStride[i] & 0xffff) != fRowBytes) {
+			why = "the pipes' layout differs (size, crop or stride)";
+		}
+		width += size & 0xffff;
+		fZCFlush |= 1u << negroni_sspp_flush[fZCPipe[i]];
+	}
+	fZCFlush |= CTL_FLUSH_CTL;
+	fZCLayoutOk = why == NULL && fZCPipes != 0 && width == fWidth;     /* 0269 needs only this part */
+	uint64_t base = fPhys + round_page((uint64_t)fRowBytes * fHeight);
+	uint64_t slotSize = trunc_page((NEGRONI_DB_END - base) / NEGRONI_ZC_SLOTS);    /* 0269: not into the 0268 DSI buffer */
+	if (why != NULL) {
+	} else if (fZCPipes == 0) {
+		why = "no pipe fetches the panel memory";
+	} else if (width != fWidth) {
+		why = "the pipes do not cover the panel's width";
+	} else if (fOffX < 0 || fOffY < 0 || (uint32_t)fOffX + fWidth > fLogicalW || (uint32_t)fOffY + fHeight > fLogicalH) {
+		why = "the canvas does not cover the panel (negronifb_shift)";
+	} else if (slotSize < round_page((uint64_t)fLogicalW * 4 * fLogicalH)) {
+		why = "no room for display slots in the splash region";
+	} else if (!on) {
+		why = "off (boot-arg negronifb_zerocopy=1 turns it on)";
+	} else if (!quiet) {
+		why = "off: the console draws over the GUI (negronifb_noconsole=0)";
+	} else if (badge) {
+		why = "off: negronibadge=1 draws into the panel memory";
+	}
+	IOLog("NEGRONI FB: zero-copy %s: %u pipe(s) %s%s%s at CTL%u, flush bits 0x%x, %u slots of %llu bytes at 0x%llx, crop %d,%d\n",
+	    why != NULL ? why : "ready", fZCPipes, fZCPipes ? negroni_sspp_name[fZCPipe[0]] : "-", fZCPipes > 1 ? "+" : "",
+	    fZCPipes > 1 ? negroni_sspp_name[fZCPipe[1]] : "", ctl, fZCFlush, NEGRONI_ZC_SLOTS, slotSize, base, fOffX, fOffY);
+	if (why == NULL) {
+		fZCReady = true;
+		negroni_fb_zc = this;
+		negroni_surface_set_display_slots(base, slotSize, NEGRONI_ZC_SLOTS, fLogicalW, fLogicalH, NEGRONI_FB_FORMAT_BGRA);
+	}
+}
+
+/* The display slot surface a swap shows alone in layer 0, full canvas (retained), or NULL. */
+NegroniSurface *
+AppleCLCD::zeroCopySurface(const uint8_t *rec)
+{
+	const uint8_t *a = rec + 0x64, *b = rec + 0xc4;
+
+	if (!fZCReady || (get32(rec, 0x104) & 0xf) != 1 || get32(a, 0) != 0 || get32(a, 4) != 0 ||
+	    get32(b, 0) != 0 || get32(b, 4) != 0 || get32(a, 8) != fLogicalW || get32(a, 12) != fLogicalH ||
+	    get32(b, 8) != fLogicalW || get32(b, 12) != fLogicalH) {
+		return NULL;
+	}
+	NegroniSurface *s = negroni_surface_copy(get32(rec, 0x54));
+	if (s != NULL && (s->slot < 0 || s->width != fLogicalW || s->height != fLogicalH || s->phys == 0 ||
+	    s->bytesPerRow > 0xffff || (s->bytesPerRow & 63) != 0 || s->phys + s->allocSize > NEGRONI_DB_END)) {
+		OSSafeReleaseNULL(s);
+	}
+	return s;
+}
+
+/* The engine took the last flush (it clears the bits at the frame start that applies them). */
+bool
+AppleCLCD::zeroCopyLatched(void)
+{
+	return fMdss == 0 || (negroni_dpu_rd(fMdss + fZCCtl + CTL_FLUSH) & fZCFlush) == 0;
+}
+
+/*
+ * A taken flush: the frame shown before goes back to CoreAnimation. tick (work loop): count the
+ * vsyncs a flush waits; too many and zero-copy is off for good.
+ */
+void
+AppleCLCD::zeroCopyRetire(bool tick)
+{
+	NegroniSurface *old = NULL;
+	bool stuck = false;
+
+	if (fMdss == 0) {
+		return;
+	}
+	IOLockLock(fLock);
+	if (fZCNextValid && zeroCopyLatched()) {
+		old = fZCShown;
+		fZCShown = fZCNext;
+		fZCNext = NULL;
+		fZCNextValid = false;
+		if (fZCNextID > fPresentedID) {
+			fPresentedID = fZCNextID;
+		}
+	} else if (fZCNextValid && tick && ++fZCNextTicks > NEGRONI_ZC_LATCH_TICKS) {
+		stuck = true;
+	}
+	IOLockUnlock(fLock);
+	if (old != NULL) {
+		zeroCopyUnshow(old);
+	}
+	if (stuck) {
+		IOLog("NEGRONI FB: zero-copy off: the display engine does not take flushes (CTL_FLUSH 0x%x)\n",
+		    negroni_dpu_rd(fMdss + fZCCtl + CTL_FLUSH));
+		fZCReady = false;
+		zeroCopyStop(true);
+	}
+}
+
+/* No longer shown: the clock shift undone, the hold and the reference given back. */
+void
+AppleCLCD::zeroCopyUnshow(NegroniSurface *s)
+{
+	if (s->saved && s->save != NULL) {
+		uintptr_t k = s->kernelAddress();
+		uint32_t half = fWidth / 2, bpr = s->bytesPerRow;
+		if (k != 0) {
+			uintptr_t top = k + (uint64_t)fOffY * bpr;
+			for (uint32_t y = 0; y < negroni_clock_rows(); y++) {
+				memcpy((uint32_t *)(top + (uint64_t)y * bpr) + fOffX, (uint32_t *)s->save + (uint64_t)y * half,
+				    (size_t)half * 4);
+			}
+			negroni_surface_cache(top, (uint64_t)negroni_clock_rows() * bpr, kNegroniCacheFlush);
+		}
+		s->saved = false;
+	}
+	negroni_surface_hold(s, false);
+	s->release();
+}
+
+/*
+ * negronifb_clockshift on a frame the engine shows itself: the left ear of the status bar
+ * shifted in the framebuffer (as negroni_shift_clock does in the panel memory), its pixels kept
+ * to put back when CoreAnimation gets the framebuffer again (zeroCopyUnshow).
+ */
+void
+AppleCLCD::zeroCopyShiftClock(NegroniSurface *s, uintptr_t k, bool gpu)
+{
+	uint32_t half = fWidth / 2, bpr = s->bytesPerRow, rows = negroni_clock_rows(), size = rows * half * 4;
+
+	if (negroni_clock_shift < 0) {
+		negroni_clock_shift = 0;
+		PE_parse_boot_argn("negronifb_clockshift", &negroni_clock_shift, sizeof(negroni_clock_shift));
+		if (negroni_clock_shift < 0 || negroni_clock_shift > 400) {
+			negroni_clock_shift = 0;
+		}
+	}
+	uint32_t n = (uint32_t)negroni_clock_shift;
+	if (n == 0 || n >= half || s->saved || (uint64_t)fOffY + rows > s->height ||
+	    (uint64_t)fOffX + half > s->width) {
+		return;
+	}
+	if (s->save == NULL) {
+		s->save = IOMallocData(size);
+		s->saveSize = s->save != NULL ? size : 0;
+		if (s->save == NULL) {
+			return;
+		}
+	}
+	uintptr_t top = k + (uint64_t)fOffY * bpr;
+	if (gpu) {
+		/* the GPU's pixels from memory, not lines the CPU caches may still hold from before */
+		negroni_surface_cache(top, (uint64_t)rows * bpr, kNegroniCacheFlush);
+	}
+	for (uint32_t y = 0; y < rows; y++) {
+		uint32_t *row = (uint32_t *)(top + (uint64_t)y * bpr) + fOffX;
+		uint32_t edge = row[0];
+		const uint32_t *saved = (const uint32_t *)s->save + (uint64_t)y * half;
+		memcpy((uint32_t *)s->save + (uint64_t)y * half, row, (size_t)half * 4);
+		memmove(row + n, row, (size_t)(half - n) * 4);
+		for (uint32_t x = 0; x < n; x++) {
+			/* 0267: the same fill as the copy paths (the pixels pushed out at the middle) */
+			row[x] = fClockCopy ? saved[half - n + x] : edge;
+		}
+	}
+	negroni_surface_cache(top, (uint64_t)rows * bpr, kNegroniCacheClean);
+	s->saved = true;
+}
+
+/* ABL's values back in the pipes: they fetch the panel memory from the next frame on. No lock (panic). */
+void
+AppleCLCD::zeroCopyRestore(void)
+{
+	if (fMdss == 0 || fZCPipes == 0) {
+		return;
+	}
+	for (uint32_t i = 0; i < fZCPipes; i++) {
+		vm_offset_t b = fMdss + negroni_sspp_off[fZCPipe[i]];
+		negroni_dpu_wr(b + SSPP_SRC_YSTRIDE0, fZCAblStride[i]);
+		negroni_dpu_wr(b + SSPP_SRC_XY, fZCAblXY[i]);
+		negroni_dpu_wr(b + SSPP_SRC0_ADDR, fZCAblAddr[i]);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	negroni_dpu_wr(fMdss + fZCCtl + CTL_FLUSH, fZCFlush);
+}
+
+/*
+ * The pipes back on the panel memory (it must hold the frame to show). now: everything held is
+ * given back at once (display off, a stuck engine); else when the engine takes the flush. Work loop.
+ */
+void
+AppleCLCD::zeroCopyStop(bool now)
+{
+	NegroniSurface *shown = NULL, *next = NULL;
+	bool active = fZCActive;
+
+	if (now) {
+		dbufPark();     /* 0269: display off (0275 black, 0258 sleep): drawn into the shown buffer */
+	}
+	if (!active && fZCShown == NULL && fZCNext == NULL && !fZCNextValid) {
+		return;
+	}
+	for (uint32_t i = 0; i < 80 && fZCNextValid && !zeroCopyLatched(); i++) {
+		delay_for_interval(500, kMicrosecondScale);
+	}
+	zeroCopyRetire(false);
+	if (active) {
+		zeroCopyRestore();
+	}
+	IOLockLock(fLock);
+	fZCActive = false;
+	if (now || fZCNextValid) {
+		shown = fZCShown;
+		next = fZCNext;
+		fZCShown = fZCNext = NULL;
+		fZCNextValid = false;
+		fPresentedID = fEndedID;
+	} else if (active) {
+		fZCNextValid = true;            /* back to the panel memory: the shown one goes when it is taken */
+		fZCNextID = fPresentedID;
+		fZCNextTicks = 0;
+	}
+	IOLockUnlock(fLock);
+	if (shown != NULL) {
+		zeroCopyUnshow(shown);
+	}
+	if (next != NULL) {
+		zeroCopyUnshow(next);
+	}
+	static uint32_t logged;
+	if (active && logged < 32) {
+		logged++;
+		IOLog("NEGRONI FB: zero-copy paused: the pipes fetch the panel memory again\n");
+	}
+}
+
+/* Show slot surface s (retained and held: taken over) from the next frame on. Work loop. */
+void
+AppleCLCD::flip(NegroniSurface *s, uint32_t id)
+{
+	static uint32_t logged;
+	uintptr_t k = s->kernelAddress();
+	uint32_t y0 = 0, y1 = 0, bpr = s->bytesPerRow;
+	bool gpu = s->gpuFence != 0;
+
+	if (!fConsolePaused) {
+		fConsolePaused = true;
+		negroni_console_muted = 1;      /* zero-copy needs negronifb_noconsole=1 */
+	}
+	if (k == 0) {
+		negroni_surface_hold(s, false);
+		s->release();
+		return;
+	}
+	if (negroni_surface_take_dirty(s, &y0, &y1) && !gpu) {
+		/* the rows CoreAnimation's CPU renderer wrote, out of the CPU caches for the engine */
+		y0 = y0 > (uint32_t)fOffY ? y0 : (uint32_t)fOffY;
+		y1 = y1 < (uint32_t)fOffY + fHeight ? y1 : (uint32_t)fOffY + fHeight;
+		if (y0 < y1) {
+			negroni_surface_cache(k + (uint64_t)y0 * bpr, (uint64_t)(y1 - y0) * bpr, kNegroniCacheClean);
+		}
+	}
+	zeroCopyShiftClock(s, k, gpu);
+	for (uint32_t i = 0; i < fZCPipes; i++) {
+		vm_offset_t b = fMdss + negroni_sspp_off[fZCPipe[i]];
+		uint32_t x = (fZCAblXY[i] & 0xffff) + (uint32_t)fOffX, y = (fZCAblXY[i] >> 16) + (uint32_t)fOffY;
+		negroni_dpu_wr(b + SSPP_SRC_YSTRIDE0, (fZCAblStride[i] & 0xffff0000u) | bpr);
+		negroni_dpu_wr(b + SSPP_SRC_XY, y << 16 | x);
+		negroni_dpu_wr(b + SSPP_SRC0_ADDR, (uint32_t)s->phys);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	negroni_dpu_wr(fMdss + fZCCtl + CTL_FLUSH, fZCFlush);
+	IOLockLock(fLock);
+	fZCActive = true;
+	fZCNext = s;
+	fZCNextValid = true;
+	fZCNextID = id;
+	fZCNextTicks = 0;
+	IOLockUnlock(fLock);
+	fZCFrames++;
+	if (logged < 4) {
+		/* bring-up: how long the engine takes to apply a flip (expected: up to one 8.3 ms frame) */
+		uint64_t t0 = mach_absolute_time(), ns;
+		uint32_t i;
+		logged++;
+		for (i = 0; i < 80 && !zeroCopyLatched(); i++) {
+			delay_for_interval(250, kMicrosecondScale);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		IOLog("NEGRONI FB: flip %u: slot %d at 0x%llx (%s, rows %u-%u cleaned), %s after %llu us\n", id, s->slot,
+		    s->phys, gpu ? "GPU" : "CPU", y0, y1, zeroCopyLatched() ? "taken" : "NOT taken", ns / 1000);
+	} else if (fZCFrames % 1000 == 0) {
+		IOLog("NEGRONI FB: %llu frames shown zero-copy\n", fZCFrames);
+	}
+}
+
+/* ---- panel double buffering (0269) ---- */
+
+/*
+ * negronifb_dbuf=1: present() writes a buffer the display engine does not fetch, and the pipes
+ * get that buffer's address once the copy is done, the way Android's commit does it
+ * (sde_hw_sspp_setup_sourceaddress sde_hw_sspp.c:925-948: SSPP_SRC0_ADDR; sde_hw_ctl_trigger_flush_v1
+ * sde_hw_ctl.c:685-711: CTL_FLUSH with the pipe's bit, sspp_tbl :78-79, and CTL bit 17; the engine
+ * takes the flushed registers at the next frame start). The UEFI's auto-refresh is the frame
+ * start here (no CTL_START: under auto-refresh Android does not kick either,
+ * sde_encoder_phys_cmd.c:2169-2175): a flip written before a TE is shown from that TE on, a whole
+ * frame, never half a copy. The buffers: the panel memory (ABL's, at the pipes' address) and
+ * negronifb_dbufn - 1 more (default 2: three in all) right after it in the splash region. Two
+ * buffers would let the GPU path reach 60 frames/s only: the copy into the back buffer ends some
+ * ms after the tick, the flip goes at the next tick, and the buffer that was shown is free only
+ * after that flip is taken, one tick later again. Pipes, CTL and flush bits come from 0234's probe
+ * (zeroCopyInit, read only). negronifb_dbuf=0 (default): one buffer, as before.
+ */
+void
+AppleCLCD::dbufInit(void)
+{
+	uint32_t on = 0, n = NEGRONI_DB_MAX;
+	const char *why = NULL;
+	uint64_t size = round_page((uint64_t)fRowBytes * fHeight);
+
+	fDrawPhys = fPhys;
+	fDbShown = 0;
+	fDbFlipped = fDbTarget = -1;
+	fDbDraw = 0;
+	fDb[0].phys = fPhys;
+	fDb[0].pixels = fPixels;
+	fDb[0].surface = fSurface;
+	fDb[0].state = kNegroniDbShown;
+	PE_parse_boot_argn("negronifb_dbuf", &on, sizeof(on));
+	PE_parse_boot_argn("negronifb_dbufn", &n, sizeof(n));
+	if (!on) {
+		IOLog("NEGRONI FB: 0269 double buffering off (negronifb_dbuf=0): one panel buffer\n");
+		return;
+	}
+	n = n < 2 ? 2 : (n > NEGRONI_DB_MAX ? NEGRONI_DB_MAX : n);
+	if (fMdss == 0 || !fZCLayoutOk) {
+		why = "the DPU probe found no pipe layout to flip (negronifb_dpuprobe=0, or see the NEGRONI FB: DPU lines)";
+	} else if (fZCReady) {
+		why = "zero-copy (negronifb_zerocopy=1) has the splash region";
+	} else if (fPhys + n * size > NEGRONI_DB_END) {
+		why = "no room in the splash region";
+	}
+	for (uint32_t i = 1; why == NULL && i < n; i++) {
+		fDb[i].phys = fPhys + i * size;
+		fDb[i].surface = negroni_surface_create_physical(fDb[i].phys, fWidth, fHeight, fRowBytes, NEGRONI_FB_FORMAT_BGRA);
+		fDb[i].pixels = fDb[i].surface != NULL ? fDb[i].surface->kernelAddress() : 0;
+		fDb[i].state = kNegroniDbFree;
+		if (fDb[i].pixels == 0) {
+			why = "a buffer cannot be mapped";
+		}
+	}
+	if (why != NULL) {
+		IOLog("NEGRONI FB: 0269 double buffering off: %s\n", why);
+		return;
+	}
+	fDbN = n;
+	fDbuf = true;
+	negroni_fb_zc = this;           /* the panic hook puts the pipes back on the panel memory */
+	IOLog("NEGRONI FB: 0269 double buffering on: %u panel buffers of 0x%llx at 0x%llx 0x%llx%s0x%llx, pipe(s) %s%s%s, "
+	    "CTL at +0x%x, flush bits 0x%x\n", n, size, fDb[0].phys, fDb[1].phys, n > 2 ? " " : "", n > 2 ? fDb[2].phys : 0ULL,
+	    negroni_sspp_name[fZCPipe[0]], fZCPipes > 1 ? "+" : "", fZCPipes > 1 ? negroni_sspp_name[fZCPipe[1]] : "",
+	    fZCCtl, fZCFlush);
+}
+
+bool
+AppleCLCD::dbufAnyPending(void)
+{
+	for (uint32_t i = 0; i < fDbN; i++) {
+		if (fDb[i].state == kNegroniDbPending) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * Which buffer this frame (rec) is written into; false: none yet, the frame stays pending (next
+ * tick). A frame of one layer that covers the whole panel goes into a free buffer; anything else
+ * (several layers, a part of the panel) is drawn over the picture on screen, so it waits until
+ * no copy and no flip is outstanding and then goes into the shown buffer (the old single-buffer
+ * way, rare: CoreAnimation sends full-canvas frames of one layer). A frame with the panel memory
+ * itself as a layer (GetLayerDefaultSurface) shows the panel memory. Work loop, fLock held.
+ */
+bool
+AppleCLCD::dbufTarget(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104), layers = 0;
+	int32_t last = -1;
+	bool panel = false, full = false;
+
+	fDbTarget = -1;
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		layers++;
+		last = (int32_t)layer;
+		panel = panel || (fSurface != NULL && id == fSurface->id);
+	}
+	if (!panel && layers == 1) {
+		/* present()'s mapping: logical -> panel coordinates, clipped at the left/top edge */
+		const uint8_t *a = rec + 0x64 + 16 * last, *b = rec + 0xc4 + 16 * last;
+		int32_t aw = (int32_t)get32(a, 8), ah = (int32_t)get32(a, 12);
+		int32_t dx = (int32_t)get32(b, 0) - fOffX, dy = (int32_t)get32(b, 4) - fOffY;
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+		int32_t cx = dx < 0 ? -dx : 0, cy = dy < 0 ? -dy : 0;
+		full = (int32_t)get32(b, 0) >= 0 && (int32_t)get32(b, 4) >= 0 && w > 0 && h > 0 && dx <= 0 && dy <= 0 &&
+		    w - cx >= (int32_t)fWidth && h - cy >= (int32_t)fHeight &&
+		    aw - cx >= (int32_t)fWidth && ah - cy >= (int32_t)fHeight;
+	}
+	int32_t t = -1;
+	if (panel) {
+		t = fDbFlipped < 0 && !dbufAnyPending() ? 0 : -1;
+	} else if (full) {
+		for (uint32_t i = 0; i < fDbN && t < 0; i++) {
+			if (fDb[i].state == kNegroniDbFree) {
+				t = (int32_t)i;
+			}
+		}
+	} else if (fDbFlipped < 0 && !dbufAnyPending()) {
+		t = fDbShown;
+		fStatDbInPlace++;
+	}
+	if (t >= 0 && fShiftPending && t != fDbDraw) {
+		t = -1;                 /* 0256: the last frame's clock shift is still to do in its buffer */
+	}
+	if (t < 0) {
+		fStatDbWaits++;
+		return false;
+	}
+	fDbTarget = t;
+	fDbDraw = t;
+	fPixels = fDb[t].pixels;
+	fDrawPhys = fDb[t].phys;
+	return true;
+}
+
+/* present() queued the frame into fDbTarget (fence: its newest GPU copy, 0: all done by the CPU). */
+void
+AppleCLCD::dbufQueued(uint32_t fence)
+{
+	int32_t t = fDbTarget;
+
+	fDbTarget = -1;
+	if (!fDbuf || t < 0 || t == fDbShown || t == fDbFlipped) {
+		return;                 /* drawn in place */
+	}
+	fDb[t].state = kNegroniDbPending;
+	fDb[t].fence = fence;
+	fDb[t].seq = ++fDbSeq;
+}
+
+/* The pipes fetch buffer i from the next frame start on. */
+void
+AppleCLCD::dbufFlip(int32_t i)
+{
+	/* the CPU's stores to the write-combined buffer (copy, badges) reach memory before the engine reads it */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t p = 0; p < fZCPipes; p++) {
+		negroni_dpu_wr(fMdss + negroni_sspp_off[fZCPipe[p]] + SSPP_SRC0_ADDR, (uint32_t)fDb[i].phys);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	negroni_dpu_wr(fMdss + fZCCtl + CTL_FLUSH, fZCFlush);
+	fDb[i].state = kNegroniDbFlipped;
+	fDbFlipped = i;
+	fDbFlipTicks = 0;
+	fDbFlipAt = mach_absolute_time();
+	fStatDbFlips++;
+	fDbFlipsTotal++;
+	if (fDbLogged < 4) {
+		/* bring-up: how long the engine takes to apply a flip (expected: up to one 8.3 ms frame) */
+		uint32_t k;
+		uint64_t ns;
+		fDbLogged++;
+		for (k = 0; k < 80 && !zeroCopyLatched(); k++) {
+			delay_for_interval(250, kMicrosecondScale);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - fDbFlipAt, &ns);
+		IOLog("NEGRONI FB: 0269 flip %llu: buffer %d at 0x%llx (fence %u), %s after %llu us, CTL_FLUSH 0x%x\n",
+		    fDbFlipsTotal, i, fDb[i].phys, fDb[i].fence, zeroCopyLatched() ? "taken" : "NOT taken", ns / 1000,
+		    negroni_dpu_rd(fMdss + fZCCtl + CTL_FLUSH));
+	}
+}
+
+/*
+ * Every vsync tick (tick) and after the frame's copy (not tick): a taken flip makes its buffer the
+ * shown one and frees the one before; the newest pending buffer whose copy is done (and whose
+ * CPU drawing, presentFinish / the 0256 shift, is done) is flipped. Work loop.
+ */
+void
+AppleCLCD::dbufTick(bool tick)
+{
+	if (!fDbuf) {
+		return;
+	}
+	if (fDbFlipped >= 0) {
+		if (zeroCopyLatched()) {
+			uint64_t dt = mach_absolute_time() - fDbFlipAt;
+			if (dt > fStatDbLatchMaxAbs) {
+				fStatDbLatchMaxAbs = dt;
+			}
+			if (fDbShown >= 0 && fDbShown != fDbFlipped) {
+				fDb[fDbShown].state = kNegroniDbFree;
+			}
+			fDbShown = fDbFlipped;
+			fDb[fDbShown].state = kNegroniDbShown;
+			fDbFlipped = -1;
+		} else if (tick && !fPowerOff && !fArPaused && ++fDbFlipTicks > NEGRONI_DB_LATCH_TICKS) {
+			dbufOff("the display engine does not take flips");
+			return;
+		}
+	}
+	/* pending buffers older than the one on screen: free once the GPU is done with them */
+	for (uint32_t i = 0; i < fDbN; i++) {
+		if (fDb[i].state == kNegroniDbPending && fDb[i].seq < fDb[fDbShown].seq &&
+		    (fDb[i].fence == 0 || fenceGone(fDb[i].fence))) {
+			fDb[i].state = kNegroniDbFree;
+		}
+	}
+	if (fDbFlipped >= 0) {
+		return;                 /* one flip at a time: the buffer it replaces is still fetched */
+	}
+	int32_t best = -1;
+	for (uint32_t i = 0; i < fDbN; i++) {
+		if (fDb[i].state == kNegroniDbPending && fDb[i].seq > fDb[fDbShown].seq &&
+		    (best < 0 || fDb[i].seq > fDb[best].seq)) {
+			best = (int32_t)i;
+		}
+	}
+	if (best < 0 || (fDb[best].fence != 0 && !fenceGone(fDb[best].fence))) {
+		return;
+	}
+	if (best == fDbDraw && (fFinishPending || fShiftPending)) {
+		return;                 /* the CPU still draws into it (presentFinish, shiftTick) */
+	}
+	dbufFlip(best);
+}
+
+/*
+ * Display off (zeroCopyStop(true), 0275 tick 0): the black and the dark panel go into the buffer
+ * on screen; no flip. The GPU copies into the other buffers are done (0275 waited for the last
+ * one), so they become free. Work loop.
+ */
+void
+AppleCLCD::dbufPark(void)
+{
+	if (!fDbuf) {
+		return;
+	}
+	for (uint32_t i = 0; i < 80 && fDbFlipped >= 0 && !zeroCopyLatched(); i++) {
+		delay_for_interval(250, kMicrosecondScale);
+	}
+	if (fDbFlipped >= 0) {
+		if (!zeroCopyLatched()) {
+			dbufOff("a flip was not taken before the display went off");
+			return;
+		}
+		if (fDbShown != fDbFlipped) {
+			fDb[fDbShown].state = kNegroniDbFree;
+		}
+		fDbShown = fDbFlipped;  /* taken: no new flip here, the black goes into this one */
+		fDb[fDbShown].state = kNegroniDbShown;
+		fDbFlipped = -1;
+	}
+	for (uint32_t i = 0; i < fDbN; i++) {
+		if ((int32_t)i != fDbShown) {
+			fDb[i].state = kNegroniDbFree;
+		}
+	}
+	fDbDraw = fDbShown;
+	fPixels = fDb[fDbShown].pixels;
+	fDrawPhys = fDb[fDbShown].phys;
+}
+
+/* Back to one buffer for good: the pipes on the panel memory (ABL's values). Work loop. */
+void
+AppleCLCD::dbufOff(const char *why)
+{
+	IOLog("NEGRONI FB: 0269 double buffering off: %s (CTL_FLUSH 0x%x, %llu flips)\n", why,
+	    negroni_dpu_rd(fMdss + fZCCtl + CTL_FLUSH), fDbFlipsTotal);
+	NegroniGPUFenceWait(fLastGPUFence, NEGRONI_FB_GPU_COPY_WAIT_MS);
+	fDbuf = false;
+	zeroCopyRestore();
+	for (uint32_t i = 0; i < fDbN; i++) {
+		fDb[i].state = i == 0 ? kNegroniDbShown : kNegroniDbFree;
+	}
+	fDbShown = fDbDraw = 0;
+	fDbFlipped = fDbTarget = -1;
+	fPixels = fDb[0].pixels;
+	fDrawPhys = fPhys;
+	IOLockLock(fLock);
+	fDirty = true;                  /* the latest frame again, into the panel memory */
+	IOLockUnlock(fLock);
+}
+
+/*
+ * SwapWait: 0 when swap id is on screen, else kIOReturnBusy at once (0254; before: a wait of at
+ * most NEGRONI_ZC_WAIT_MS in zero-copy mode only). CoreAnimation passes the swap that showed its
+ * other framebuffer before it draws into this one again (ios-s9 0096), so this keeps it out of
+ * the framebuffer the engine is fetching or the tick has not copied yet.
+ */
+IOReturn
+AppleCLCD::swapWait(uint32_t id)
+{
+	uint64_t t0 = mach_absolute_time();
+	bool done;
+
+	/*
+	 * 0254: one check, no wait, in every mode (QuartzCore 20H392 IOMFBDisplay::can_update_
+	 * 0x1882be944, swap_wait_timeout 0x18853c088: CA retries with usleep(100) for up to 1 ms or
+	 * tries again at its next heartbeat; a 0 return gives the surface back to CA's renderer).
+	 * On screen: the record with this id or a later one was copied into the panel memory or
+	 * flipped and taken by the engine.
+	 */
+	zeroCopyRetire(false);
+	IOLockLock(fLock);
+	done = id == 0 || fPowerOff || id > fEndedID || fPresentedID >= id;
+	IOLockUnlock(fLock);
+	if (fStats) {
+		uint64_t dt = mach_absolute_time() - t0;
+		__atomic_fetch_add(&fStatWaits, 1, __ATOMIC_RELAXED);
+		__atomic_fetch_add(&fStatWaitAbs, dt, __ATOMIC_RELAXED);
+		if (!done) {
+			__atomic_fetch_add(&fStatWaitTimeouts, 1, __ATOMIC_RELAXED);
+		}
+		uint64_t max = __atomic_load_n(&fStatWaitMaxAbs, __ATOMIC_RELAXED);
+		while (dt > max && !__atomic_compare_exchange_n(&fStatWaitMaxAbs, &max, dt, true,
+		    __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+		}
+	}
+	return done ? kIOReturnSuccess : kIOReturnBusy;
+}
+
+/* Panic (NegroniPlatformExpert.cpp kPEPanicBegin): the panic text is drawn into the panel memory. */
+extern "C" void
+negroni_fb_panic(void)
+{
+	AppleCLCD *fb = negroni_fb_zc;
+
+	if (fb != NULL && (fb->fZCReady || fb->fDbuf)) {
+		fb->zeroCopyRestore();  /* 0269: the panic text goes to the panel memory, ABL's buffer */
+	}
+	negroni_backlight_panic();      /* 0258: a sleeping or dark panel shows the panic text */
+}
+
+/*
+ * 0268: INTF_1 of the DSI display for the backlight's panel wake (NegroniBacklight.cpp
+ * wakePanel): pause the auto-refresh during the on-command, re-arm it after, and sample the
+ * TE and frame counters. Registers: sde_hw_intf.c:80-95 (INTF_TEAR_AUTOREFRESH_CONFIG 0x2B4,
+ * bit 31 enable, [15:0] frames per refresh; sde_hw_intf_setup_autorefresh_config :668-686),
+ * INTF_FRAME_COUNT 0xAC, the tear interrupt block +0x800 (sde_hw_interrupts.c:24-26).
+ */
+extern "C" bool negroni_fb_autorefresh_pause(uint32_t *saved);
+extern "C" void negroni_fb_autorefresh_resume(uint32_t saved);
+extern "C" bool negroni_fb_te_check(uint32_t *te, uint32_t *frames, uint32_t *tear, bool *rearmed);
+
+static vm_offset_t
+negroni_fb_intf(void)
+{
+	AppleCLCD *fb = negroni_fb_main;
+
+	if (fb == NULL) {
+		return 0;
+	}
+	return fb->fIntf != 0 ? fb->fIntf : fb->fMdss != 0 ? fb->fMdss + NEGRONI_INTF1_OFF : fb->fIntfWake;
+}
+
+extern "C" bool
+negroni_fb_autorefresh_pause(uint32_t *saved)
+{
+	vm_offset_t intf = negroni_fb_intf();
+
+	if (intf == 0) {
+		return false;
+	}
+	uint32_t ar = negroni_dpu_rd(intf + INTF_TEAR_AUTOREFRESH_CONFIG);
+	*saved = ar;
+	if (!(ar & (1u << 31))) {
+		return false;
+	}
+	negroni_dpu_wr(intf + INTF_TEAR_AUTOREFRESH_CONFIG, ar & ~(1u << 31));
+	__asm__ volatile ("dsb sy" ::: "memory");
+	negroni_fb_main->fArPaused = true;     /* 0269: no flip is taken meanwhile */
+	return true;
+}
+
+extern "C" void
+negroni_fb_autorefresh_resume(uint32_t saved)
+{
+	vm_offset_t intf = negroni_fb_intf();
+
+	if (intf == 0 || !(saved & (1u << 31))) {
+		return;
+	}
+	negroni_fb_main->fArPaused = false;
+	if (negroni_dpu_rd(intf + INTF_TEAR_AUTOREFRESH_CONFIG) & (1u << 31)) {
+		return;         /* 0259's VRR wake wrote it meanwhile */
+	}
+	negroni_dpu_wr(intf + INTF_TEAR_AUTOREFRESH_CONFIG, saved);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * 50 ms of TE pulses (INT_COUNT_VAL frame field), INTF frames and the latched tear interrupt
+ * bits. TE pulses but no frame sign (no INTF frame, no AUTOREFRESH_DONE/WR_PTR bit): the
+ * auto-refresh is switched off and on once (re-arm) and measured again. Thread context.
+ */
+extern "C" bool
+negroni_fb_te_check(uint32_t *te, uint32_t *frames, uint32_t *tear, bool *rearmed)
+{
+	vm_offset_t intf = negroni_fb_intf();
+
+	*rearmed = false;
+	if (intf == 0) {
+		return false;
+	}
+	for (uint32_t pass = 0; pass < 2; pass++) {
+		negroni_dpu_wr(intf + INTF_TEAR_INTR_CLEAR, 0x1f);
+		uint32_t c0 = negroni_dpu_rd(intf + INTF_TEAR_INT_COUNT_VAL) >> 16, f0 = negroni_dpu_rd(intf + INTF_FRAME_COUNT);
+		IOSleep(50);
+		uint32_t c1 = negroni_dpu_rd(intf + INTF_TEAR_INT_COUNT_VAL) >> 16, f1 = negroni_dpu_rd(intf + INTF_FRAME_COUNT);
+		*te = (c1 - c0) & 0xffffu;
+		*frames = f1 - f0;
+		*tear = negroni_dpu_rd(intf + INTF_TEAR_INTR_STATUS) & 0x1fu;
+		bool sent = *frames != 0 || (*tear & 0x3u) != 0;
+		uint32_t ar = negroni_dpu_rd(intf + INTF_TEAR_AUTOREFRESH_CONFIG);
+		if (pass == 1 || *te == 0 || sent || !(ar & (1u << 31))) {
+			break;
+		}
+		negroni_dpu_wr(intf + INTF_TEAR_AUTOREFRESH_CONFIG, ar & ~(1u << 31));
+		__asm__ volatile ("dsb sy" ::: "memory");
+		IODelay(100);
+		negroni_dpu_wr(intf + INTF_TEAR_AUTOREFRESH_CONFIG, ar);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		*rearmed = true;
+	}
+	return true;
+}
+
+bool
+IOMobileFramebufferUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	return true;
+}
+
+bool
+IOMobileFramebufferUserClient::start(IOService *provider)
+{
+	fFB = OSDynamicCast(AppleCLCD, provider);
+	if (fFB == NULL || !IOUserClient::start(provider)) {
+		return false;
+	}
+	fFB->addClient(this);
+	return true;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::clientClose(void)
+{
+	if (fFB != NULL) {
+		fFB->removeClient(this);
+		IOLockLock(fFB->fLock);
+		mach_port_t old = fPort;
+		fPort = MACH_PORT_NULL;
+		IOLockUnlock(fFB->fLock);
+		if (old != MACH_PORT_NULL) {
+			releaseNotificationPort(old);
+		}
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+IOMobileFramebufferUserClient::registerNotificationPort(mach_port_t port, __unused UInt32 type,
+    __unused io_user_reference_t refCon)
+{
+	mach_port_t old;
+	IOLockLock(fFB->fLock);
+	old = fPort;
+	fPort = port;
+	IOLockUnlock(fFB->fLock);
+	if (old != MACH_PORT_NULL) {
+		releaseNotificationPort(old);
+	}
+	return kIOReturnSuccess;
+}
+
+/* Called with the framebuffer lock held. */
+void
+IOMobileFramebufferUserClient::notify(uint32_t type, const uint64_t *values, uint32_t count)
+{
+	OSAsyncReference64 ref;
+
+	if (type >= NEGRONI_FB_NOTIFY_TYPES || fFunc[type] == 0 || fPort == MACH_PORT_NULL) {
+		return;
+	}
+	bzero(ref, sizeof(ref));
+	setAsyncReference64(ref, fPort, (mach_vm_address_t)fFunc[type], fRefcon[type], fTask);
+	sendAsyncResult64WithOptions(ref, kIOReturnSuccess, (io_user_reference_t *)values, count,
+	    kIOUserNotifyOptionCanDrop);
+}
+
+static uint64_t negroni_fb_logged;        /* selectors already logged (< 64) */
+
+IOReturn
+IOMobileFramebufferUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t out[2] = { 0, 0 };
+	uint32_t outCount = 0;
+	uint8_t block[12];              /* 0364: GetBlock answer, copied after the output is cleared */
+	uint32_t blockLen = 0;
+
+	switch (selector) {
+	case kNegroniFBGetBlock:
+		/* 0364: block 0x40 = the current mode: colour id at +4, timing id at +8; every other block reads zeros */
+		if (args->scalarInputCount >= 1) {
+			static uint64_t seen[4];        /* block ids < 256 already logged */
+			uint64_t id = args->scalarInput[0];
+			uint64_t off = args->scalarInputCount >= 2 ? args->scalarInput[1] : 0;
+			if (id == 0x40 && off == 0 && negroni_fb_modes_on && args->structureOutputDescriptor == NULL &&
+			    args->structureOutput != NULL && args->structureOutputSize >= sizeof(block)) {
+				uint32_t ids[2] = { NEGRONI_FB_COLOR_ID, NEGRONI_FB_TIMING_ID };
+				bzero(block, sizeof(block));
+				memcpy(block + 4, ids, sizeof(ids));
+				blockLen = sizeof(block);
+			}
+			if (id < 256 && !(seen[id / 64] & (1ULL << (id % 64)))) {
+				seen[id / 64] |= 1ULL << (id % 64);
+				char name[32];
+				proc_selfname(name, sizeof(name));
+				IOLog("NEGRONI FB: %s GetBlock 0x%llx (in %u scalars, out %u bytes): %s\n", name, id,
+				    args->scalarInputCount, args->structureOutputSize,
+				    blockLen ? "current mode (colour 1, timing 1)" : "zeros");
+			}
+		}
+		break;
+	case kNegroniFBGetLayerDefaultSurface:
+		out[0] = negroni_surface_port_in_task(fFB->fSurface, fTask);
+		outCount = 1;
+		break;
+	case kNegroniFBSwapBegin:
+		IOLockLock(fFB->fLock);
+		out[0] = ++fFB->fSwapID;
+		IOLockUnlock(fFB->fLock);
+		outCount = 1;
+		break;
+	case kNegroniFBSwapEnd: {
+		uint8_t rec[NEGRONI_FB_SWAP_REC_SIZE];
+		if (args->structureInputDescriptor != NULL ||
+		    args->structureInputSize < NEGRONI_FB_SWAP_REC_SIZE) {
+			ret = kIOReturnBadArgument;
+			break;
+		}
+		memcpy(rec, args->structureInput, sizeof(rec));
+		fFB->swap(rec);
+		break;
+	}
+	case kNegroniFBGetID:
+		out[0] = 0;
+		outCount = 1;
+		break;
+	case kNegroniFBGetDisplaySize:
+		out[0] = fFB->fLogicalW;
+		out[1] = fFB->fLogicalH;
+		outCount = 2;
+		break;
+	case kNegroniFBIsMainDisplay:
+		out[0] = 1;
+		outCount = 1;
+		break;
+	case kNegroniFBGetDotPitch:
+		out[0] = NEGRONI_FB_DOT_PITCH;
+		outCount = 1;
+		break;
+	case kNegroniFBNotifications:
+		if (args->scalarInputCount >= 3 && args->scalarInput[2] < NEGRONI_FB_NOTIFY_TYPES) {
+			uint32_t type = (uint32_t)args->scalarInput[2];
+			IOLockLock(fFB->fLock);
+			fFunc[type] = args->scalarInput[0];
+			fRefcon[type] = args->scalarInput[1];
+			IOLockUnlock(fFB->fLock);
+			char name[32];
+			proc_selfname(name, sizeof(name));
+			IOLog("NEGRONI FB: %s notifications type %u %s\n", name, type,
+			    args->scalarInput[0] ? "on" : "off");
+		}
+		break;
+	case kNegroniFBRequestPowerChange:
+		if (args->scalarInputCount >= 1) {
+			bool off = args->scalarInput[0] == 0;
+			/*
+			 * 0258: backboardd's request is the only path to the panel. Off:
+			 * the next tick writes black (0275), the one after has the backlight set
+			 * DBV 0 and puts the panel to sleep (negronifb_sleep). On: the
+			 * backlight wakes the panel at once and the next tick redraws.
+			 */
+			/* 0382: on, from the slow off tick: tick at once (read before the lock: at worst one extra tick) */
+			bool none = false, kick = !off && fFB->fPowerOff && fFB->fFadeStep >= 2;
+			IOLockLock(fFB->fLock);
+			if (off != fFB->fPowerOff) {
+				fFB->fPowerOff = off;
+				negroni_gpu_display(!off);      /* 0384: GPU lowest level and slumber while off; does not block */
+				fFB->fFadeStep = 0;
+				fFB->fVrrOffWait = 0;
+				fFB->fDirty = true;     /* on: redraw the latest frame */
+				fFB->fLastSwapAbs = mach_absolute_time();
+				fFB->vrrWakeLocked();   /* 0259: the panel sleeps and wakes in its full-rate state */
+				if (off) {
+					fFB->fOffAt = mach_absolute_time();
+				} else {
+					none = !negroni_backlight_display_on();   /* does not block */
+				}
+			}
+			IOLockUnlock(fFB->fLock);
+			if (!off) {
+				__atomic_store_n(&negroni_display_asleep, 0, __ATOMIC_RELEASE);        /* 0382 */
+			}
+			if (kick) {
+				fFB->wakeKick();        /* 0382: the next tick now, not at the end of a long off tick */
+			}
+			if (none) {
+				IOLog("NEGRONI FB: display on (sleep-out 0 ms, no backlight service)\n");
+			}
+		}
+		break;
+	case kNegroniFBSwapWait:
+		if (args->scalarInputCount >= 1) {
+			ret = fFB->swapWait((uint32_t)args->scalarInput[0]);
+		}
+		break;
+	default:
+		break;
+	}
+
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = i < outCount ? out[i] : 0;
+	}
+	if (args->structureOutputDescriptor == NULL && args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+		if (blockLen != 0) {
+			memcpy(args->structureOutput, block, blockLen);  /* 0364 */
+		}
+	}
+	if (selector >= 64 || !(negroni_fb_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			negroni_fb_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("NEGRONI FB: %s sel %u in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize, ret);
+	}
+	return ret;
+}
+#endif /* NEGRONI */
diff --git a/iokit/Kernel/arm/NegroniGPU.cpp b/iokit/Kernel/arm/NegroniGPU.cpp
new file mode 100644
index 0000000..a8ad66a
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniGPU.cpp
