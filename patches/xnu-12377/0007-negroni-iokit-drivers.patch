+}
+
+/* Lock held. */
+NegroniSurfaceRef *
+IOSurfaceRootUserClient::findRef(uint32_t id, unsigned int *index)
+{
+	for (unsigned int i = 0; i < fRefs->getCount(); i++) {
+		NegroniSurfaceRef *ref = (NegroniSurfaceRef *)fRefs->getObject(i);
+		if (ref->surface->id == id) {
+			if (index != NULL) {
+				*index = i;
+			}
+			return ref;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * Count one more create/lookup of s by this client, mapping it into the
+ * task the first time. Takes over the caller's user count on s.
+ *
+ * A lookup of a surface this client already has maps nothing and counts
+ * nothing (*existing): IOSurface.framework then gets base address -1 in the
+ * lock result and reuses its cached IOSurfaceClient. Counting it instead
+ * made the framework build a second client for the same id; releasing that
+ * one (traps 4 + 5) unmapped the memory under the first (backboardd
+ * snapshot crash in CGDataProviderCreateWithData).
+ */
+IOReturn
+IOSurfaceRootUserClient::addRef(NegroniSurface *s, NegroniSurfaceRef **refOut, bool *existing)
+{
+	*existing = false;
+	IOLockLock(fLock);
+	NegroniSurfaceRef *ref = findRef(s->id, NULL);
+	if (ref != NULL && ref->surface == s) {
+		IOLockUnlock(fLock);
+		negroni_surface_put(s);
+		*refOut = ref;
+		*existing = true;
+		return kIOReturnSuccess;
+	}
+	IOLockUnlock(fLock);
+
+	ref = OSTypeAlloc(NegroniSurfaceRef);
+	if (ref == NULL || !ref->init()) {
+		OSSafeReleaseNULL(ref);
+		negroni_surface_put(s);
+		return kIOReturnNoMemory;
+	}
+	s->retain();
+	ref->surface = s;
+	ref->count = 1;
+	ref->data = s->memory->createMappingInTask(fTask, 0, kIOMapAnywhere | s->mapCache);
+	ref->state = s->state->createMappingInTask(fTask, 0, kIOMapAnywhere | kIOMapReadOnly);
+	if (ref->data == NULL || ref->state == NULL) {
+		ref->release();
+		return kIOReturnVMError;
+	}
+	IOLockLock(fLock);
+	NegroniSurfaceRef *raced = findRef(s->id, NULL);
+	if (raced != NULL && raced->surface == s) {
+		/* Another thread mapped it meanwhile: count there, drop ours. */
+		raced->count++;
+		IOLockUnlock(fLock);
+		ref->release();
+		*refOut = raced;
+		return kIOReturnSuccess;
+	}
+	fRefs->setObject(ref);
+	IOLockUnlock(fLock);
+	ref->release();         /* fRefs holds it */
+	*refOut = ref;
+	return kIOReturnSuccess;
+}
+
+static void
+put32(uint8_t *p, uint32_t off, uint32_t v)
+{
+	memcpy(p + off, &v, 4);
+}
+
+static void
+put64(uint8_t *p, uint32_t off, uint64_t v)
+{
+	memcpy(p + off, &v, 8);
+}
+
+/* IOSurface.framework's lock result (copied to IOSurfaceClient + 0x68). */
+static void
+negroni_surface_fill_result(NegroniSurface *s, NegroniSurfaceRef *ref, uint8_t *out)
+{
+	bzero(out, NEGRONI_SURFACE_RESULT_SIZE);
+	put64(out, 0x00, ref->data->getAddress());
+	put64(out, 0x08, ref->state->getAddress());
+	put64(out, 0x10, ref->state->getAddress() + NEGRONI_SURFACE_TIMESTAMPS);
+	put32(out, 0x18, s->id);
+	put32(out, 0x1c, s->allocSize);
+	put32(out, 0x20, s->width);
+	put32(out, 0x24, s->height);
+	put32(out, 0x28, s->bytesPerRow);
+	put32(out, 0x2c, s->offset);
+	put32(out, 0x30, s->pixelFormat);
+	put32(out, 0x34, s->allocSize);
+	put32(out, 0x38, s->planeCount);
+	memcpy(out + 0x40, &s->bytesPerElement, 2);
+	out[0x42] = s->elementWidth;
+	out[0x43] = s->elementHeight;
+	put32(out, 0x44, s->cacheMode);
+	put32(out, 0x50, s->parentID);
+	put32(out, 0x54, 1);
+	for (uint32_t i = 0; i < s->planeCount; i++) {
+		uint8_t *p = out + 0x68 + i * 0x80;
+		const struct negroni_surface_plane *pl = &s->planes[i];
+		put32(p, 0x00, pl->width);
+		put32(p, 0x04, pl->height);
+		put32(p, 0x08, pl->bytesPerRow);
+		put32(p, 0x0c, pl->offset);
+		put32(p, 0x14, pl->size);
+		memcpy(p + 0x18, &pl->bytesPerElement, 2);
+		p[0x1a] = pl->elementWidth;
+		p[0x1b] = pl->elementHeight;
+	}
+}
+
+static IOReturn
+negroni_struct_out(IOExternalMethodArguments *args, const void *buf, uint32_t len)
+{
+	if (args->structureOutputDescriptor != NULL) {
+		if (len > args->structureOutputDescriptor->getLength()) {
+			return kIOReturnNoSpace;
+		}
+		args->structureOutputDescriptor->writeBytes(0, buf, len);
+		args->structureOutputDescriptorSize = len;
+		return kIOReturnSuccess;
+	}
+	if (args->structureOutput == NULL || len > args->structureOutputSize) {
+		return kIOReturnNoSpace;
+	}
+	memcpy(args->structureOutput, buf, len);
+	args->structureOutputSize = len;
+	return kIOReturnSuccess;
+}
+
+/* Map s for this client and answer with its lock result. Takes s's user count. */
+IOReturn
+IOSurfaceRootUserClient::returnSurface(NegroniSurface *s, IOExternalMethodArguments *args)
+{
+	NegroniSurfaceRef *ref = NULL;
+	bool existing = false;
+	IOReturn ret = addRef(s, &ref, &existing);
+	if (ret != kIOReturnSuccess) {
+		return ret;
+	}
+	uint8_t *out = (uint8_t *)IOMallocZeroData(NEGRONI_SURFACE_RESULT_SIZE);
+	if (out == NULL) {
+		ret = kIOReturnNoMemory;
+	} else {
+		negroni_surface_fill_result(s, ref, out);
+		if (existing) {
+			put64(out, 0x00, ~0ULL);        /* "already yours": use the cached client */
+		}
+		ret = negroni_struct_out(args, out, NEGRONI_SURFACE_RESULT_SIZE);
+		IOFreeData(out, NEGRONI_SURFACE_RESULT_SIZE);
+	}
+	if (ret != kIOReturnSuccess && !existing) {
+		/* The caller never learns the id: undo this create/lookup. */
+		trapRelease((void *)(uintptr_t)s->id, NULL, NULL, NULL, NULL, NULL);
+	}
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
+{
+	const char *buf = (const char *)args->structureInput;
+	uint32_t len = args->structureInputSize;
+	char *copy = NULL;
+	IOReturn ret;
+
+	if (args->structureInputDescriptor != NULL) {
+		len = (uint32_t)args->structureInputDescriptor->getLength();
+		if (len == 0 || len > NEGRONI_SURFACE_MAX_PROPS) {
+			return kIOReturnBadArgument;
+		}
+		copy = (char *)IOMallocData(len);
+		if (copy == NULL) {
+			return kIOReturnNoMemory;
+		}
+		args->structureInputDescriptor->readBytes(0, copy, len);
+		buf = copy;
+	}
+	OSObject *obj = (buf != NULL && len > 0) ? OSUnserializeXML(buf, len) : NULL;
+	if (copy != NULL) {
+		IOFreeData(copy, len);
+	}
+	OSDictionary *props = OSDynamicCast(OSDictionary, obj);
+	if (props == NULL) {
+		OSSafeReleaseNULL(obj);
+		IOLog("NEGRONI SURF: create: bad property dictionary (%u bytes)\n", len);
+		return kIOReturnBadArgument;
+	}
+
+	NegroniSurface *s = negroni_surface_alloc();
+	if (s == NULL) {
+		props->release();
+		return kIOReturnNoMemory;
+	}
+	s->parentID = args->scalarInputCount > 0 ? (uint32_t)args->scalarInput[0] : 0;
+	ret = negroni_surface_layout(s, props);
+	char who[32];
+	proc_selfname(who, sizeof(who));
+	int slot = -1;
+	if (ret == kIOReturnSuccess && strcmp(who, "backboardd") == 0) {
+		IOLockLock(negroni_surface_lock);
+		slot = negroni_surface_slot_take_locked(s);
+		IOLockUnlock(negroni_surface_lock);
+	}
+	if (ret == kIOReturnSuccess && slot >= 0) {
+		/*
+		 * Zero-copy: a framebuffer of backboardd's in a display slot (memory XNU does not
+		 * manage), cached for CoreAnimation's CPU renderer; NegroniFramebuffer.cpp cleans the
+		 * rows it wrote before the display engine fetches them.
+		 */
+		s->slot = slot;
+		s->phys = negroni_slot_phys + (uint64_t)slot * negroni_slot_size;
+		s->memory = IOMemoryDescriptor::withPhysicalAddress(s->phys, s->allocSize, kIODirectionInOut);
+		s->mapCache = kIOMapCopybackCache;
+		s->kernelMapCache = kIOMapCopybackCache;
+		uintptr_t k = s->memory != NULL ? s->kernelAddress() : 0;
+		if (k == 0) {
+			ret = kIOReturnNoMemory;
+		} else {
+			bzero((void *)k, s->allocSize);
+			negroni_surface_cache(k, s->allocSize, kNegroniCacheFlush);
+			s->dirtyY0 = 0;
+			s->dirtyY1 = s->height;
+			if (!negroni_surface_publish(s)) {
+				ret = kIOReturnNoResources;
+			}
+		}
+	} else if (ret == kIOReturnSuccess) {
+		IOBufferMemoryDescriptor *mem = NULL;
+		if ((uint64_t)OSAddAtomic64(s->allocSize, (volatile SInt64 *)&negroni_surface_wired) +
+		    s->allocSize <= NEGRONI_SURFACE_WIRED_MAX) {
+			mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+			    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+		}
+		if (mem == NULL) {
+			OSAddAtomic64(-(SInt64)s->allocSize, (volatile SInt64 *)&negroni_surface_wired);
+			ret = kIOReturnNoMemory;
+		} else {
+			bzero(mem->getBytesNoCopy(), s->allocSize);
+			s->memory = mem;
+			s->mapCache = kIOMapDefaultCache;
+			if (!negroni_surface_publish(s)) {
+				ret = kIOReturnNoResources;
+			}
+		}
+	}
+	if (ret != kIOReturnSuccess || negroni_surface_creates_logged < 64 || slot >= 0) {
+		negroni_surface_creates_logged++;
+		IOLog("NEGRONI SURF: %s create id %u %ux%u fmt 0x%x bpe %u bpr %u planes %u size %u keys %u slot %d -> 0x%x\n",
+		    who, s->id, s->width, s->height, s->pixelFormat, s->bytesPerElement,
+		    s->bytesPerRow, s->planeCount, s->allocSize, props->getCount(), slot, ret);
+	}
+	props->release();
+	if (ret != kIOReturnSuccess) {
+		s->release();
+		return ret;
+	}
+	ret = returnSurface(s, args);   /* takes the creator's user count */
+	s->release();
+	return ret;
+}
+
+/*
+ * Make s's pixels the memory task already has at address (size bytes, page-aligned): the
+ * range is prepared (wired) for as long as the surface lives, as the GPU host import (0232)
+ * does, and every task that looks the surface up maps those same pages. Writable if the pages
+ * are; a picture that is only shown may be read-only (a mapped file). Cached in the kernel
+ * and in user mappings: the CPU wrote the pixels, and NegroniFramebuffer / NegroniGPU clean
+ * cached surfaces (kernelMapCache) before the display engine or the GPU reads them.
+ */
+static IOReturn
+negroni_surface_wrap_task_memory(NegroniSurface *s, task_t task, uint64_t address, uint64_t size)
+{
+	uint64_t length = round_page_64(size);
+	IOMemoryDescriptor *md = NULL;
+	IOReturn held = kIOReturnNoMemory;
+	for (int attempt = 0; attempt < 2 && held != kIOReturnSuccess; attempt++) {
+		OSSafeReleaseNULL(md);
+		md = IOMemoryDescriptor::withAddressRange(address, length,
+		    attempt == 0 ? kIODirectionInOut : kIODirectionOut, task);
+		held = md != NULL ? md->prepare() : kIOReturnNoMemory;
+	}
+	if (held != kIOReturnSuccess) {
+		OSSafeReleaseNULL(md);
+		return kIOReturnVMError;
+	}
+	s->memory = md;
+	s->wrapped = true;
+	s->mapCache = kIOMapDefaultCache;
+	s->kernelMapCache = kIOMapCopybackCache;
+	return kIOReturnSuccess;
+}
+
+/*
+ * IOSurfaceClientWrapClientImage (sel 6; iOS 16.7 IOSurface.framework, out/gpu/re/IOSurface.s:
+ * struct in of 0x20 bytes: +0 address, +8 width, +0xc height, +0x10 pixel format, +0x14 bytes
+ * per element (the framework derives it from the format), +0x18 bytes per row, +0x1c one more
+ * u32 the framework passes through) and IOSurfaceClientWrapClientMemory (sel 7: scalars
+ * address, size): a surface made of the caller's own memory, answered like a created one
+ * (lock result: pixels, state page, id, seed). CoreAnimation's GL renderer wraps page-aligned
+ * CPU images so (CA::Render::Image::retain_iosurface). A zeroed success answer here gave the
+ * framework a client with id 0 and no state page: backboardd SIGSEGV far 0x30 in
+ * IOSurfaceClientGetBulkAttachments (docs/notes.md 15a). Input the driver cannot use is
+ * refused (not success): the framework then returns NULL and its callers take their other path.
+ */
+IOReturn
+IOSurfaceRootUserClient::wrapClient(uint32_t selector, IOExternalMethodArguments *args)
+{
+	static uint32_t failed_logged;          /* one line per failure kind */
+	static uint32_t done_logged;            /* one line per selector */
+	uint64_t address, size;
+	uint32_t width, height, format = 0, bpe, bpr;
+	const char *why = NULL;
+	uint32_t kind = 0;
+	IOReturn ret = kIOReturnUnsupported;
+
+	if (selector == kNegroniSurfaceWrapClientImage) {
+		const uint8_t *in = (const uint8_t *)args->structureInput;
+		if (in == NULL || args->structureInputSize < 0x1c) {
+			why = "bad input size";
+			kind = 1;
+			goto fail;
+		}
+		memcpy(&address, in, 8);
+		memcpy(&width, in + 0x08, 4);
+		memcpy(&height, in + 0x0c, 4);
+		memcpy(&format, in + 0x10, 4);
+		memcpy(&bpe, in + 0x14, 4);
+		memcpy(&bpr, in + 0x18, 4);
+		if (width == 0 || height == 0 || width > NEGRONI_SURFACE_MAX_DIM || height > NEGRONI_SURFACE_MAX_DIM ||
+		    bpe == 0 || bpe > 64 || (uint64_t)bpr < (uint64_t)width * bpe) {
+			why = "bad image geometry";
+			kind = 2;
+			goto fail;
+		}
+		size = (uint64_t)bpr * height;
+	} else {
+		if (args->scalarInputCount < 2) {
+			why = "bad scalar count";
+			kind = 1;
+			goto fail;
+		}
+		address = args->scalarInput[0];
+		size = args->scalarInput[1];
+		width = (uint32_t)size;
+		height = 1;
+		bpe = 1;
+		bpr = (uint32_t)size;
+	}
+	if (address == 0 || size == 0 || size > NEGRONI_SURFACE_MAX_ALLOC || size > UINT32_MAX) {
+		why = "bad address or size";
+		kind = 3;
+		goto fail;
+	}
+	if (address != trunc_page_64(address)) {
+		why = "address not page-aligned";
+		kind = 4;
+		goto fail;
+	}
+	{
+		NegroniSurface *s = negroni_surface_alloc();
+		if (s == NULL) {
+			why = "no memory";
+			kind = 5;
+			ret = kIOReturnNoMemory;
+			goto fail;
+		}
+		ret = negroni_surface_wrap_task_memory(s, fTask, address, size);
+		if (ret != kIOReturnSuccess) {
+			s->release();
+			why = "cannot wire the client range";
+			kind = 6;
+			goto fail;
+		}
+		s->width = width;
+		s->height = height;
+		s->pixelFormat = format;
+		s->bytesPerElement = (uint16_t)bpe;
+		s->elementWidth = 1;
+		s->elementHeight = 1;
+		s->bytesPerRow = bpr;
+		s->offset = 0;
+		s->allocSize = (uint32_t)round_page_64(size);
+		s->planeCount = 0;
+		if (!negroni_surface_publish(s)) {
+			s->release();
+			why = "no free surface id";
+			kind = 7;
+			ret = kIOReturnNoResources;
+			goto fail;
+		}
+		if (!(done_logged & (1u << (selector & 31)))) {
+			done_logged |= 1u << (selector & 31);
+			char who[32];
+			proc_selfname(who, sizeof(who));
+			IOLog("NEGRONI SURF: wrap client memory sel %u: %ux%u bpr %u fmt 0x%x -> id %u (%s, %u bytes)\n",
+			    selector, width, height, bpr, format, s->id, who, s->allocSize);
+		}
+		ret = returnSurface(s, args);    /* takes the creator's user count */
+		s->release();
+		return ret;
+	}
+fail:
+	if (!(failed_logged & (1u << kind))) {
+		failed_logged |= 1u << kind;
+		char who[32];
+		proc_selfname(who, sizeof(who));
+		IOLog("NEGRONI SURF: wrap client memory sel %u refused: %s (%s, in %u bytes, %u scalars) -> 0x%x\n",
+		    selector, why, who, args->structureInputSize, args->scalarInputCount, ret);
+	}
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	uint64_t arg0 = args->scalarInputCount > 0 ? args->scalarInput[0] : 0;
+
+	switch (selector) {
+	case kNegroniSurfaceLimits: {
+		uint8_t limits[0x18] = { 0 };
+		put32(limits, 0x0, NEGRONI_SURFACE_ROW_ALIGN - 1);
+		put32(limits, 0x4, NEGRONI_SURFACE_ROW_ALIGN - 1);
+		limits[0x16] = 1;
+		negroni_surf_log_once("sel", selector);
+		return negroni_struct_out(args, limits, sizeof(limits));
+	}
+	case kNegroniSurfaceCreate:
+		return create(args);
+	case kNegroniSurfaceWrapClientImage:
+	case kNegroniSurfaceWrapClientMemory:
+		negroni_surf_log_once("sel", selector);
+		return wrapClient(selector, args);
+	case kNegroniSurfaceLookup: {
+		NegroniSurface *s = negroni_surface_copy((uint32_t)arg0);
+		IOReturn ret = kIOReturnNotFound;
+		if (s != NULL) {
+			ret = negroni_surface_get(s) ? returnSurface(s, args) : kIOReturnNotFound;
+			s->release();
+		}
+		negroni_surf_log_once("sel", selector);
+		return ret;
+	}
+	case kNegroniSurfaceLookupFromPort: {
+		OSObject *obj = NULL;
+		IOReturn ret = IOUserClient::copyObjectForPortNameInTask(fTask, (mach_port_name_t)arg0, &obj);
+		NegroniSurface *s = OSDynamicCast(NegroniSurface, obj);
+		if (ret == kIOReturnSuccess) {
+			ret = (s != NULL && negroni_surface_get(s)) ? returnSurface(s, args) : kIOReturnBadArgument;
+		}
+		OSSafeReleaseNULL(obj);
+		negroni_surf_log_once("sel", selector);
+		return ret;
+	}
+	case kNegroniSurfaceCreatePort: {
+		NegroniSurface *s = negroni_surface_copy((uint32_t)arg0);
+		if (s == NULL || args->scalarOutputCount < 1) {
+			OSSafeReleaseNULL(s);
+			return kIOReturnNotFound;
+		}
+		args->scalarOutput[0] = negroni_surface_port_in_task(s, fTask);
+		args->scalarOutputCount = 1;
+		s->release();
+		negroni_surf_log_once("sel", selector);
+		return kIOReturnSuccess;
+	}
+	default:
+		/* Values, notifications, ownership, timestamps...: accept and ignore. */
+		for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+			args->scalarOutput[i] = 0;
+		}
+		if (args->structureOutput != NULL) {
+			bzero(args->structureOutput, args->structureOutputSize);
+		}
+		negroni_surf_log_once("sel", selector);
+		return kIOReturnSuccess;
+	}
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUseCount(__unused void *id, __unused void *category,
+    void *, void *, void *, void *)
+{
+	return kIOReturnSuccess;
+}
+
+static IOReturn
+negroni_surface_seed_out(NegroniSurface *s, void *seedOut, bool bump)
+{
+	uint32_t seed = bump ? OSIncrementAtomic((volatile SInt32 *)negroni_surface_seed(s)) + 1 :
+	    *negroni_surface_seed(s);
+	if (seedOut != NULL && copyout(&seed, (user_addr_t)seedOut, sizeof(seed)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	return kIOReturnSuccess;
+}
+
+/* Retained surface this client created or looked up, or NULL. */
+static NegroniSurface *
+negroni_surface_held(IOLock *lock, OSArray *refs, uint32_t id)
+{
+	NegroniSurface *s = NULL;
+	IOLockLock(lock);
+	for (unsigned int i = 0; i < refs->getCount(); i++) {
+		NegroniSurfaceRef *ref = (NegroniSurfaceRef *)refs->getObject(i);
+		if (ref->surface->id == id) {
+			s = ref->surface;
+			s->retain();
+			break;
+		}
+	}
+	IOLockUnlock(lock);
+	return s;
+}
+
+/*
+ * 0289: before the CPU reads (or writes) a surface the GPU wrote. The last submission that listed
+ * the surface is s->gpuFence (0230 import, also the fence 0254 records at swap time). Wait for it,
+ * bounded (NegroniGPUSurfaceWaitMS; NegroniGPUFenceWait gives up at once when the GPU is stopped),
+ * then drop the CPU's cached lines when the user mapping is cached (write-combined mappings, the
+ * created surfaces' default, have none). Once per fence value: the seed-bump locks of a Metal
+ * process after every completed command buffer cost one fence check, not a page walk each.
+ */
+static void
+negroni_surface_wait_gpu(NegroniSurface *s)
+{
+	uint32_t fence = s->gpuFence;
+	uint32_t ms = NegroniGPUSurfaceWaitMS();
+	static uint32_t gaveUp;
+
+	if (fence == 0 || ms == 0 || fence == s->cpuSeenFence) {
+		return;
+	}
+	if (!NegroniGPUFenceWait(fence, ms) && gaveUp++ < 8) {
+		IOLog("NEGRONI SURF: %s lock of surface %u: the GPU (fence %u) is not done after %u ms: answered anyway\n",
+		    proc_best_name(current_proc()), s->id, fence, ms);
+	}
+	if (s->mapCache != kIOMapWriteCombineCache) {
+		NegroniGPUSurfaceForCPU(s, 0, s->allocSize);
+	}
+	s->cpuSeenFence = fence;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapLock(void *id, __unused void *options, void *seedOut,
+    void *, void *, void *)
+{
+	NegroniSurface *s = negroni_surface_held(fLock, fRefs, (uint32_t)(uintptr_t)id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	negroni_surface_wait_gpu(s);
+	IOReturn ret = negroni_surface_seed_out(s, seedOut, false);
+	s->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapUnlock(void *id, void *options, void *seedOut,
+    void *, void *, void *)
+{
+	NegroniSurface *s = negroni_surface_held(fLock, fRefs, (uint32_t)(uintptr_t)id);
+	if (s == NULL) {
+		return kIOReturnNotFound;
+	}
+	IOReturn ret = negroni_surface_seed_out(s, seedOut,
+	    !((uintptr_t)options & kIOSurfaceLockReadOnly));
+	s->release();
+	return ret;
+}
+
+IOReturn
+IOSurfaceRootUserClient::trapRelease(void *id, void *, void *, void *, void *, void *)
+{
+	unsigned int index;
+	IOLockLock(fLock);
+	NegroniSurfaceRef *ref = findRef((uint32_t)(uintptr_t)id, &index);
+	if (ref != NULL && --ref->count == 0) {
+		fRefs->removeObject(index);     /* unmaps and drops the user count */
+	}
+	IOLockUnlock(fLock);
+	return ref != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+}
+
+static IOExternalTrap negroni_surface_traps[] = {
+	[kNegroniSurfaceTrapIncrementUse]  = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapUseCount },
+	[kNegroniSurfaceTrapDecrementUse]  = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapUseCount },
+	[kNegroniSurfaceTrapLock]          = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapLock },
+	[kNegroniSurfaceTrapUnlock]        = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapUnlock },
+	[kNegroniSurfaceTrapRelease]       = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapRelease },
+	[kNegroniSurfaceTrapReleaseFailed] = { NULL, (IOTrap) & IOSurfaceRootUserClient::trapRelease },
+};
+
+IOExternalTrap *
+IOSurfaceRootUserClient::getTargetAndTrapForIndex(IOService **targetP, UInt32 index)
+{
+	if (index >= sizeof(negroni_surface_traps) / sizeof(negroni_surface_traps[0])) {
+		negroni_surf_log_once("trap", index);
+		return NULL;
+	}
+	negroni_surf_log_once("trap", index);
+	*targetP = this;
+	return &negroni_surface_traps[index];
+}
+#endif /* NEGRONI */
diff --git a/iokit/Kernel/arm/NegroniSurface.h b/iokit/Kernel/arm/NegroniSurface.h
new file mode 100644
index 0000000..82e49c8
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniSurface.h
@@ -0,0 +1,126 @@
+/*
+ * Built-in IOSurface for NEGRONI (see NegroniSurface.cpp).
+ *
+ * Shared with NegroniFramebuffer.cpp: the framebuffer looks surfaces up by
+ * id when a swap names them and publishes the panel memory itself as the
+ * default framebuffer surface.
+ */
+#ifndef _NEGRONI_SURFACE_H
+#define _NEGRONI_SURFACE_H
+
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NEGRONI)
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <libkern/c++/OSObject.h>
+#include <mach/mach_types.h>
+
+#define NEGRONI_SURFACE_MAX_PLANES        20
+
+struct negroni_surface_plane {
+	uint32_t width, height, bytesPerRow, offset, size;
+	uint16_t bytesPerElement;
+	uint8_t  elementWidth, elementHeight;
+};
+
+class NegroniSurface : public OSObject {
+	OSDeclareDefaultStructors(NegroniSurface);
+
+public:
+	uint32_t id;
+	uint32_t width, height, bytesPerRow, offset, pixelFormat, allocSize;
+	uint16_t bytesPerElement;
+	uint8_t  elementWidth, elementHeight;
+	uint32_t cacheMode, planeCount, parentID;
+	struct negroni_surface_plane planes[NEGRONI_SURFACE_MAX_PLANES];
+
+	IOMemoryDescriptor       *memory;       /* pixels (buffer or physical) */
+	IOOptionBits              mapCache;     /* cache mode for user mappings */
+	IOBufferMemoryDescriptor *state;        /* shared state page, read-only for users */
+	IOMemoryMap              *kernelMap;    /* lazily created for kernel copies */
+	/*
+	 * The last RedwoodGPU submission that listed this surface as an imported buffer
+	 * (iokit/Kernel/arm/NegroniGPU.cpp), 0: the GPU never wrote it. The framebuffer
+	 * presents such surfaces with the GPU once that fence is done.
+	 */
+	volatile uint32_t         gpuFence;
+	/*
+	 * 0289: the gpuFence the CPU lock (trap 2) last waited for and dropped the cached lines of
+	 * (negroni_surface_wait_gpu): the next lock waits only when the GPU wrote the surface again.
+	 */
+	uint32_t                  cpuSeenFence;
+	/*
+	 * Zero-copy scanout (patch 0234, NegroniFramebuffer.cpp): backboardd's framebuffers can
+	 * live in display slots of ABL's splash region, which the display engine fetches directly.
+	 * slot: index or -1; phys: the slot's address; dirtyY0/Y1: rows the CPU may have written
+	 * since it was last shown (to clean before the next showing); kernelMapCache: the kernel
+	 * mapping's cache mode (0: write-combined); save: the pixels the clock shift moved while
+	 * shown (put back before CoreAnimation draws into it again).
+	 */
+	int32_t                   slot;
+	uint64_t                  phys;
+	uint32_t                  dirtyY0, dirtyY1;
+	IOOptionBits              kernelMapCache;
+	void                     *save;
+	uint32_t                  saveSize;
+	bool                      saved;
+	/*
+	 * Client memory (0257, IOSurfaceWrapClientImage / IOSurfaceWrapClientMemory): memory is a prepared
+	 * (wired) page-aligned range of the creator's task, completed by free(); never counted as wired
+	 * kernel memory. The CPU wrote the pixels, so the mappings are cached.
+	 */
+	bool                      wrapped;
+
+	bool init() APPLE_KEXT_OVERRIDE { wrapped = false; return OSObject::init(); }
+	void free() APPLE_KEXT_OVERRIDE;
+
+	/* Kernel address of the pixels (mapped on first use), or 0. */
+	uintptr_t kernelAddress();
+};
+
+/* Retained surface for an id, or NULL. */
+NegroniSurface *negroni_surface_copy(uint32_t id);
+
+/*
+ * Publish physical memory (the panel framebuffer) as a surface. Returns a
+ * retained surface that stays in the id table until released by the caller
+ * and every user.
+ */
+NegroniSurface *negroni_surface_create_physical(uint64_t phys, uint32_t width,
+    uint32_t height, uint32_t bytesPerRow, uint32_t pixelFormat);
+
+/*
+ * The in-use count IOSurfaceIsInUse() reads (u64 at +0x18 of the shared state
+ * page, iOS 16.7 IOSurface.framework; ios-topaz 0099 / bergamota 0097): held,
+ * CoreAnimation does not render into the surface.
+ */
+void negroni_surface_hold(NegroniSurface *surface, bool on);
+
+/*
+ * Zero-copy scanout (0234): count physically contiguous display slots of slotSize bytes at phys
+ * (memory XNU does not manage) for backboardd's width x height pixelFormat framebuffers.
+ */
+#define NEGRONI_SURFACE_MAX_SLOTS         4
+void negroni_surface_set_display_slots(uint64_t phys, uint64_t slotSize, uint32_t count,
+    uint32_t width, uint32_t height, uint32_t pixelFormat);
+
+/* A swap changed rows [y0, y1) of the display (y0 < 0: all of it): every slot surface must catch up. */
+void negroni_surface_slots_dirty(int32_t y0, int32_t y1);
+
+/* Rows of a slot surface written since it was last shown, then forgotten; false if none. */
+bool negroni_surface_take_dirty(NegroniSurface *surface, uint32_t *y0, uint32_t *y1);
+
+/*
+ * Cache maintenance by kernel address over [va, va + len) of a cached mapping: clean (the display
+ * engine or the GPU reads next) or clean + drop (flush: the GPU writes next or wrote). There is no
+ * drop-only: under the hypervisor (stage 2 on) DC IVAC at EL1 cleans too.
+ */
+enum { kNegroniCacheClean = 0, kNegroniCacheFlush = 1 };
+void negroni_surface_cache(uintptr_t va, uint64_t len, int op);
+
+/* Send right for the surface in task (IOSurfaceLookupFromMachPort). */
+mach_port_name_t negroni_surface_port_in_task(NegroniSurface *surface, task_t task);
+
+#endif /* NEGRONI */
+#endif /* _NEGRONI_SURFACE_H */
diff --git a/iokit/Kernel/arm/NegroniVibrator.cpp b/iokit/Kernel/arm/NegroniVibrator.cpp
new file mode 100644
index 0000000..4240dc4
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniVibrator.cpp
@@ -0,0 +1,257 @@
+/*
+ * NEGRONI: the legacy iOS "vibrator" IOService (patch 0301), routed into the PM8350B haptics
+ * direct play of patch 0300 (negroni_haptic_play, bsd/dev/negroni_haptic.c).
+ *
+ * iOS 16 20H392 userland (MediaExperience FigVibrator, docs/haptics-plan.md) [V shared cache]:
+ *   _FigVibratorInitialize 0x195a93b3c: when VibeSynthEngineHasHardwareSupport() is false,
+ *   IOServiceGetMatchingService(IOServiceNameMatching("vibrator")) (0x195a93d04), then
+ *   IORegistryEntrySetCFProperties(service, obj) (FVIOKit_*, 0x195a42410-0x195a43b34):
+ *     start:  { "hertz_millisecs" = ( {"intensity" = SInt32 16.16}, on_ms, false, off_ms ),
+ *               "repeat" = bool }                       FVIOKit_StartIOServiceVibration 0x195a42608
+ *     pattern: "hertz_millisecs" built from a VibePattern, "repeat" = false        0x195a427dc
+ *     stop:   a bare CFNumber 0                                   FVIOKit_StopVibrator 0x195a428b4
+ * No user client, no selectors. The entry must have the registry name "vibrator".
+ * [I] userland takes this path only when the closed-loop haptics MobileGestalt answer is false
+ * (D22 ADT /product/haptics closed-loop = 1 today): see docs/haptics-plan.md.
+ *
+ * Here: hertz_millisecs is read as pairs (state, ms): state = a dictionary with "intensity"
+ * (on, strength = intensity * 255 / 65536), true (on, full strength) or false (off). The steps run
+ * on our work loop with a timer; repeat loops them, for at most NV_REPEAT_MAX_MS.
+ * Boot-args: negronihap >= 1 (0300) and negronivib (default 1; 0 = do not publish).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOCommandGate.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSData.h>
+#include <IOKit/IORegistryEntry.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+#include <pexpert/pexpert.h>
+
+extern "C" int negroni_haptic_play(uint32_t ms, uint32_t strength);
+extern "C" bool negroni_haptic_ready(void);
+
+#define NV_MAX_STEPS        64u
+#define NV_MAX_STEP_MS      10000u
+#define NV_REPEAT_MAX_MS    (5u * 60u * 1000u)
+
+class NegroniVibrator : public IOService {
+	OSDeclareDefaultStructors(NegroniVibrator);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+private:
+	struct Step { uint32_t ms; uint32_t strength; };
+	IOWorkLoop *fLoop;
+	IOCommandGate *fGate;
+	IOTimerEventSource *fTimer;
+	Step fSteps[NV_MAX_STEPS];
+	uint32_t fCount, fNext, fElapsedMs, fCalls;
+	bool fRepeat, fRunning;
+	static IOReturn gatedSet(OSObject *owner, void *arg0, void *, void *, void *);
+	static void timerFired(OSObject *owner, IOTimerEventSource *sender);
+	IOReturn apply(OSObject *properties);
+	void runStep();
+	void stopAll();
+};
+
+OSDefineMetaClassAndStructors(NegroniVibrator, IOService);
+
+/*
+ * Patch 0302 (negronihap_ui=1): IODeviceTree:/product/haptics as in the D22 ADT
+ * (external/slop/research/ipsw-x/d22ap.adt: closed-loop = 1, supports-3rd-party-haptics = 1).
+ * libMobileGestalt [V 20H392]: DeviceSupportsClosedLoopHaptics (gqDnklGQnpv5ilgh5uHckw, handler
+ * 0x19c564a9c) = "IODeviceTree:/product/haptics" "closed-loop"; DeviceSupportsHaptics
+ * (cBy4BcYs5YWtFHbBpt4C6A, 0x19c576454) looks at "IODeviceTree:/product" for "haptics".
+ * With them UIKit's feedback level is 2 and CoreHaptics, UIFeedbackGenerator and the vibe engine
+ * play on VirtualAudioDevice_Actuator -> NegroniAudio "Actuator" -> /dev/negroni-haptic
+ * (bsd/dev/negroni_haptic_ui.c). Called before the "vibrator" checks: it does not need negronivib.
+ */
+static void
+negroni_publish_haptics_node(void)
+{
+	uint32_t hap = 0, ui = 0;
+	(void)PE_parse_boot_argn("negronihap", &hap, sizeof(hap));
+	(void)PE_parse_boot_argn("negronihap_ui", &ui, sizeof(ui));
+	if (hap == 0 || ui == 0) {
+		return;
+	}
+	IORegistryEntry *product = IORegistryEntry::fromPath("/product", gIODTPlane);
+	if (product == NULL) {
+		IOLog("NEGRONI HAPTIC UI: no IODeviceTree:/product: closed-loop not published\n");
+		return;
+	}
+	IORegistryEntry *old = product->childFromPath("haptics", gIODTPlane);
+	if (old != NULL) {
+		IOLog("NEGRONI HAPTIC UI: IODeviceTree:/product/haptics exists already (ADT): kept\n");
+		old->release();
+		product->release();
+		return;
+	}
+	static const uint32_t one = 1;
+	static const char name[] = "haptics";
+	IORegistryEntry *node = new IORegistryEntry;
+	OSData *n = OSData::withBytes(name, sizeof(name));
+	OSData *cl = OSData::withBytes(&one, sizeof(one));
+	OSData *third = OSData::withBytes(&one, sizeof(one));
+	bool ok = node && n && cl && third && node->init(NULL);
+	if (ok) {
+		node->setName(name);
+		ok = node->setProperty("name", n) && node->setProperty("closed-loop", cl) &&
+		    node->setProperty("supports-3rd-party-haptics", third) && node->attachToParent(product, gIODTPlane);
+	}
+	IOLog("NEGRONI HAPTIC UI: IODeviceTree:/product/haptics closed-loop = 1, supports-3rd-party-haptics = 1: %s\n",
+	    ok ? "published (UI haptics -> VirtualAudioDevice_Actuator -> /dev/negroni-haptic)" : "FAILED");
+	OSSafeReleaseNULL(n);
+	OSSafeReleaseNULL(cl);
+	OSSafeReleaseNULL(third);
+	OSSafeReleaseNULL(node);        /* the parent link keeps it */
+	product->release();
+}
+
+bool
+NegroniVibrator::start(IOService *provider)
+{
+	negroni_publish_haptics_node();         /* patch 0302: negronihap_ui=1 */
+	uint32_t hap = 0, vib = 1;
+	(void)PE_parse_boot_argn("negronihap", &hap, sizeof(hap));
+	(void)PE_parse_boot_argn("negronivib", &vib, sizeof(vib));
+	if (hap == 0 || vib == 0) {
+		return false;
+	}
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	fLoop = IOWorkLoop::workLoop();
+	fGate = fLoop ? IOCommandGate::commandGate(this, gatedSet) : NULL;
+	fTimer = fLoop ? IOTimerEventSource::timerEventSource(this, timerFired) : NULL;
+	if (!fGate || !fTimer || fLoop->addEventSource(fGate) != kIOReturnSuccess ||
+	    fLoop->addEventSource(fTimer) != kIOReturnSuccess) {
+		IOLog("NEGRONI VIBRATOR: no work loop\n");
+		return false;
+	}
+	setName("vibrator");
+	setProperty("NegroniHaptics", "PM8350B HV haptics direct play (patch 0300)");
+	registerService();
+	IOLog("NEGRONI VIBRATOR: published \"vibrator\" (haptics %s)\n", negroni_haptic_ready() ? "ready" : "not ready yet");
+	return true;
+}
+
+IOReturn
+NegroniVibrator::setProperties(OSObject *properties)
+{
+	if (!fGate) {
+		return kIOReturnNotReady;
+	}
+	return fGate->runAction(gatedSet, properties);
+}
+
+IOReturn
+NegroniVibrator::gatedSet(OSObject *owner, void *arg0, void *, void *, void *)
+{
+	return static_cast<NegroniVibrator *>(owner)->apply(static_cast<OSObject *>(arg0));
+}
+
+void
+NegroniVibrator::stopAll()
+{
+	fTimer->cancelTimeout();
+	fRunning = false;
+	(void)negroni_haptic_play(0, 0);
+}
+
+IOReturn
+NegroniVibrator::apply(OSObject *properties)
+{
+	bool log = fCalls++ < 16;
+	if (OSDynamicCast(OSNumber, properties)) {
+		if (log) {
+			IOLog("NEGRONI VIBRATOR: stop\n");
+		}
+		stopAll();
+		return kIOReturnSuccess;
+	}
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	OSArray *a = d ? OSDynamicCast(OSArray, d->getObject("hertz_millisecs")) : NULL;
+	if (!a) {
+		if (log) {
+			IOLog("NEGRONI VIBRATOR: unknown request (%s)\n", properties ? properties->getMetaClass()->getClassName() : "null");
+		}
+		return kIOReturnBadArgument;
+	}
+	stopAll();
+	fCount = 0;
+	for (unsigned i = 0; i + 1 < a->getCount() && fCount < NV_MAX_STEPS; i += 2) {
+		OSObject *state = a->getObject(i);
+		OSNumber *ms = OSDynamicCast(OSNumber, a->getObject(i + 1));
+		if (!ms) {
+			continue;
+		}
+		uint32_t strength = 0;
+		if (OSDictionary *sd = OSDynamicCast(OSDictionary, state)) {
+			OSNumber *in = OSDynamicCast(OSNumber, sd->getObject("intensity"));
+			int64_t v = in ? (int64_t)in->unsigned64BitValue() : 65536;
+			if (in && in->numberOfBits() <= 32) {
+				v = (int32_t)in->unsigned32BitValue();
+			}
+			strength = v <= 0 ? 0 : v >= 65536 ? 255 : (uint32_t)((v * 255) >> 16);
+			if (v > 0 && strength == 0) {
+				strength = 1;
+			}
+		} else if (state == kOSBooleanTrue) {
+			strength = 255;
+		}
+		uint64_t t = ms->unsigned64BitValue();
+		fSteps[fCount].ms = t == 0 ? 1 : t > NV_MAX_STEP_MS ? NV_MAX_STEP_MS : (uint32_t)t;
+		fSteps[fCount].strength = strength;
+		fCount++;
+	}
+	OSBoolean *rep = OSDynamicCast(OSBoolean, d->getObject("repeat"));
+	fRepeat = rep == kOSBooleanTrue;
+	if (log) {
+		IOLog("NEGRONI VIBRATOR: start: %u steps (first %u ms strength %u), repeat %d\n", fCount,
+		    fCount ? fSteps[0].ms : 0, fCount ? fSteps[0].strength : 0, fRepeat);
+	}
+	if (fCount == 0) {
+		return kIOReturnBadArgument;
+	}
+	fNext = 0;
+	fElapsedMs = 0;
+	fRunning = true;
+	runStep();
+	return kIOReturnSuccess;
+}
+
+void
+NegroniVibrator::runStep()
+{
+	if (!fRunning) {
+		return;
+	}
+	if (fNext >= fCount) {
+		if (!fRepeat || fElapsedMs >= NV_REPEAT_MAX_MS) {
+			stopAll();
+			return;
+		}
+		fNext = 0;
+	}
+	const Step &s = fSteps[fNext++];
+	/* an on step plays a little longer than the step, so back-to-back on steps do not gap */
+	(void)negroni_haptic_play(s.strength ? s.ms + 20u : 0u, s.strength);
+	fElapsedMs += s.ms;
+	fTimer->setTimeoutMS(s.ms);
+}
+
+void
+NegroniVibrator::timerFired(OSObject *owner, IOTimerEventSource *)
+{
+	static_cast<NegroniVibrator *>(owner)->runStep();
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/iokit/Kernel/arm/NegroniWLAN.cpp b/iokit/Kernel/arm/NegroniWLAN.cpp
new file mode 100644
index 0000000..8e3eef5
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniWLAN.cpp
@@ -0,0 +1,231 @@
+/*
+ * Copyright (c) 2026 iOSPlus10. Derived from HakiOS (oosexgang/hackios-xnu-kernel, xnu/files/iokit/Kernel/
+ * hakios.wlan.cpp, Apple Public Source License 2.0).
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_START@
+ *
+ * This file contains Original Code and/or Modifications of Original Code
+ * as defined in and that are subject to the Apple Public Source License
+ * Version 2.0 (the 'License'). You may not use this file except in
+ * compliance with the License. The rights granted to you under the License
+ * may not be used to create, or enable the creation or redistribution of,
+ * unlawful or unlicensed software or any other software. Please obtain a
+ * copy of the License at http://www.opensource.apple.com/apsl/ and read it
+ * before using this file.
+ *
+ * The Original Code and all software distributed under the License are
+ * distributed on an 'AS IS' basis, WITHOUT WARRANTY OF ANY KIND, EITHER
+ * EXPRESS OR IMPLIED, AND APPLE HEREBY DISCLAIMS ALL SUCH WARRANTIES,
+ * INCLUDING WITHOUT LIMITATION, ANY WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE, QUIET ENJOYMENT OR NON-INFRINGEMENT.
+ * Please see the License for the specific language governing rights and
+ * limitations under the License.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+/*
+ * NEGRONI Wi-Fi, iOS side (patch 0340): the registry entries iOS looks for.
+ *
+ * 1. IODeviceTree "wlan". The launchd job com.apple.wifid has _LimitLoadToDeviceTree ("wlan", "marconi-wifi");
+ *    launchd 20H392 asks io_device_tree_entry_exists_with_name (IOUserClient.cpp), which runs
+ *    IODTFindMatchingEntries(root, kIODTRecursive, name) over the IODeviceTree plane and compares entry names.
+ *    Our ADT has no such node, so wifid never ran and Settings had no Wi-Fi device (greyed switch). The entry is
+ *    made here at boot, before launchd reads its jobs, under /arm-io (or the root), with name/compatible data.
+ * 2. IO80211Controller + IONetworkInterface, property-only, as IO80211Family / IONetworkingFamily name theirs
+ *    (HakiOS hakios.wlan.cpp): IO80211.framework 20H392 matches IO80211Controller ("No Matches for
+ *    IO80211Controller, trying dk matching"), then the interface by IOPropertyMatch IO80211InterfaceRole =
+ *    "Infrastructure" and IOInterfaceName; SystemConfiguration lists IONetworkInterface objects and calls one Wi-Fi
+ *    when its parent is an IO80211Controller (IOMACAddress on the controller). No user client: the framework falls
+ *    back to the ioctl path (negroni_apple80211.c).
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+
+extern "C" {
+#include "../../../bsd/dev/negroni_wlan_ios.h"
+}
+
+class IO80211Controller : public IOService
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOService);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class NegroniWLANInterface : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(NegroniWLANInterface);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(NegroniWLANInterface, IONetworkInterface);
+
+/* none on purpose: IO80211.framework then uses the ioctls ("Falling back to IOCTL path") */
+IOReturn
+NegroniWLANInterface::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+    IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("NEGRONI WLAN iOS: user client type %u asked of en0's service: none (ioctl path)\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+static void
+set_data_string(IORegistryEntry * entry, const char * key, const char * value)
+{
+	OSData * data = OSData::withBytes(value, (unsigned) strlen(value) + 1);
+
+	if (data != NULL) {
+		entry->setProperty(key, data);
+		data->release();
+	}
+}
+
+/* IODeviceTree "wlan" when no entry has that name; true if one was made */
+extern "C" bool
+negroni_wlan_ios_dt_entry(void)
+{
+	OSCollectionIterator * found = IODTFindMatchingEntries(IORegistryEntry::getRegistryRoot(), kIODTRecursive, "wlan");
+	bool there = found != NULL && found->getNextObject() != NULL;
+	IORegistryEntry * parent;
+	IORegistryEntry * entry;
+
+	OSSafeReleaseNULL(found);
+	if (there) {
+		return false;
+	}
+	parent = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+	if (parent == NULL) {
+		parent = IORegistryEntry::fromPath("/", gIODTPlane);
+	}
+	entry = OSTypeAlloc(IORegistryEntry);
+	if (parent == NULL || entry == NULL || !entry->init()) {
+		OSSafeReleaseNULL(parent);
+		OSSafeReleaseNULL(entry);
+		IOLog("NEGRONI WLAN iOS: cannot make IODeviceTree \"wlan\"\n");
+		return false;
+	}
+	entry->setName("wlan", gIODTPlane);
+	entry->setName("wlan");
+	set_data_string(entry, "name", "wlan");
+	set_data_string(entry, "compatible", "wlan-pcie,negroni");
+	set_data_string(entry, "device_type", "wlan");
+	if (!entry->attachToParent(parent, gIODTPlane)) {
+		IOLog("NEGRONI WLAN iOS: cannot attach IODeviceTree \"wlan\"\n");
+		entry->release();
+		parent->release();
+		return false;
+	}
+	entry->release();
+	parent->release();
+	return true;
+}
+
+/* /chosen mac-address-wifi0 (config/negroni-ne2211.toml [adt.extra.chosen]) */
+extern "C" bool
+negroni_wlan_ios_adt_mac(uint8_t mac[6])
+{
+	IORegistryEntry * chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	OSData * data;
+	bool ok = false;
+
+	if (chosen != NULL) {
+		data = OSDynamicCast(OSData, chosen->getProperty("mac-address-wifi0"));
+		if (data != NULL && data->getLength() >= 6) {
+			memcpy(mac, data->getBytesNoCopy(), 6);
+			ok = true;
+		}
+		chosen->release();
+	}
+	return ok;
+}
+
+/* once, after en0 is attached */
+extern "C" void
+negroni_wlan_ios_publish(const char * ifname, const uint8_t mac[6])
+{
+	IOService * platform = IOService::getPlatform();
+	IO80211Controller * controller = OSTypeAlloc(IO80211Controller);
+	NegroniWLANInterface * wlan = OSTypeAlloc(NegroniWLANInterface);
+	OSData * address;
+	OSNumber * number;
+
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		IOLog("NEGRONI WLAN iOS: cannot create the IO80211 services\n");
+		return;
+	}
+	if ((address = OSData::withBytes(mac, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", address);
+		address->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	controller->setProperty("IOVendor", "Qualcomm");
+	controller->setProperty("IOModel", "QCA6490");
+	if ((controller = (IO80211Controller *) publish(controller, platform, "NegroniWLANController")) == NULL) {
+		wlan->release();
+		IOLog("NEGRONI WLAN iOS: the IO80211Controller did not start\n");
+		return;
+	}
+
+	wlan->setProperty("IOInterfaceName", ifname);
+	wlan->setProperty("BSD Name", ifname);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) (ifname[2] - '0'), 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (publish(wlan, controller, "NegroniWLAN") == NULL) {
+		IOLog("NEGRONI WLAN iOS: the en0 service did not start\n");
+	} else {
+		IOLog("NEGRONI WLAN iOS: IO80211Controller + IONetworkInterface (%s, IO80211InterfaceRole Infrastructure) registered\n",
+		    ifname);
+		wlan->release();
+	}
+	controller->release();
+}
diff --git a/iokit/Kernel/arm/NegroniWatchdog.cpp b/iokit/Kernel/arm/NegroniWatchdog.cpp
new file mode 100644
index 0000000..06ab154
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniWatchdog.cpp
@@ -0,0 +1,107 @@
+/*
+ * Built-in IOWatchdog for NEGRONI.
+ *
+ * watchdogd (launchd job with _PanicOnCrash) opens IOServiceMatching(
+ * "IOWatchdog") with type 1 and exits when it is missing, which panics the
+ * system. On Apple hardware the kext arms a SoC watchdog that resets the
+ * device unless watchdogd keeps checking in. NEGRONI has no reset path, so
+ * this service accepts every call (check-in 1, enable/disable userspace
+ * monitoring 3/4, 0/5, struct calls 2 and 9) and does nothing; each
+ * selector is logged the first time it is used.
+ *
+ * watchdogd also writes the device boot stage to the PMU: it looks up
+ * the IOService with IOPMUPrimary = 1 and crashes when there is none
+ * (customer builds ignore -wdt_no_pmu). NEGRONI has no Apple PMU, so this
+ * service carries IOPMUPrimary and accepts property writes.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NEGRONI)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <sys/proc.h>
+
+class IOWatchdog : public IOService {
+	OSDeclareDefaultStructors(IOWatchdog);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdog, IOService);
+
+IOReturn
+IOWatchdog::setProperties(__unused OSObject *properties)
+{
+	return kIOReturnSuccess;
+}
+
+bool
+IOWatchdog::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "IOWatchdogUserClient");
+	setProperty("IOPMUPrimary", 1ULL, 32);
+	registerService();
+	IOLog("NEGRONI WDT: IOWatchdog registered (accepts check-ins, never fires)\n");
+	return true;
+}
+
+class IOWatchdogUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOWatchdogUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOWatchdogUserClient, IOUserClient);
+
+IOReturn
+IOWatchdogUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t negroni_wdt_logged;       /* selectors already logged (< 64) */
+
+IOReturn
+IOWatchdogUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			static const uint64_t zero = 0;
+			args->structureOutputDescriptor->writeBytes(off, &zero, len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+
+	if (selector >= 64 || !(negroni_wdt_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			negroni_wdt_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("NEGRONI WDT: %s sel %u in %u/%u out %u/%u -> ok\n", name, selector,
+		    args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif /* NEGRONI */
