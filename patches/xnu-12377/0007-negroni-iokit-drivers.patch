+	IOLockUnlock(fLock);
+}
+
+static uint32_t
+get32(const uint8_t *p, uint32_t off)
+{
+	uint32_t v;
+	memcpy(&v, p + off, 4);
+	return v;
+}
+
+static uint32_t negroni_fb_swaps_logged;
+static uint64_t negroni_fb_swap_count;
+
+/* Copy each enabled layer's surface into the panel memory (no scaling). */
+/*
+ * A swap only records the frame: copying 10 MB into the panel on every
+ * swap (backboardd presents at up to 120 Hz) took the whole CPU. The vsync timer
+ * shows the latest frame every fFlushTicks ticks (boot-arg negronifb_hz,
+ * default 10 Hz).
+ */
+void
+AppleCLCD::swap(const uint8_t *rec)
+{
+	NegroniSurface *held[NEGRONI_FB_LAYERS] = {}, *dropped[NEGRONI_FB_LAYERS];
+	uint32_t mask = get32(rec, 0x104);
+	NegroniSurface *zc = zeroCopySurface(rec);       /* retained, or NULL */
+	bool gpu = zc == NULL && NegroniGPUPresentReady() && mask != 0;
+
+	if (fZCReady) {
+		/* every display slot must catch up with these rows before it is shown again (0234) */
+		bool part = rec[0x260] != 0;
+		int64_t y0 = (int32_t)get32(rec, 0x254), y1 = y0 + (int32_t)get32(rec, 0x25c);
+		y0 = y0 < 0 ? 0 : y0;
+		y1 = y1 > (int64_t)fLogicalH ? (int64_t)fLogicalH : y1;
+		negroni_surface_slots_dirty(part ? (int32_t)(y0 < y1 ? y0 : 0) : -1, part ? (int32_t)(y0 < y1 ? y1 : 0) : -1);
+	}
+	if (zc != NULL) {
+		held[0] = zc;           /* held in use from now until the engine shows another frame */
+		negroni_surface_hold(zc, true);
+	}
+	/* a frame of GPU-rendered layers only: each surface held until the GPU copied it */
+	for (uint32_t layer = 0; gpu && layer < NEGRONI_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		held[layer] = negroni_surface_copy(id);
+		gpu = held[layer] != NULL && held[layer] != fSurface && held[layer]->gpuFence != 0;
+	}
+	for (uint32_t layer = 0; zc == NULL && layer < NEGRONI_FB_LAYERS; layer++) {
+		if (held[layer] != NULL && !gpu) {
+			OSSafeReleaseNULL(held[layer]);
+		} else if (held[layer] != NULL) {
+			negroni_surface_hold(held[layer], true);
+		}
+	}
+	/* 0254: the newest GPU fence of the frame's surfaces; the tick shows the frame once it is done */
+	/*
+	 * Swap-time fences are the right ones: CoreAnimation renders into a surface again only after
+	 * SwapWait said its swap is on screen, so no later GPU write to it is for this frame. The
+	 * surface's gpuFence moves on with every submission that lists it (Turnip lists every buffer
+	 * of the device), so at copy time it names unrelated newer work.
+	 */
+	uint32_t pendFence = 0, pendSurface = 0, pendFences[NEGRONI_FB_LAYERS] = {};
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		NegroniSurface *s = held[layer] != NULL ? held[layer] : negroni_surface_copy(id);
+		if (s != NULL && s != fSurface) {
+			pendFences[layer] = s->gpuFence;
+		}
+		if (s != NULL && s != fSurface && s->gpuFence != 0 &&
+		    (pendFence == 0 || (int32_t)(s->gpuFence - pendFence) > 0)) {
+			pendFence = s->gpuFence;
+			pendSurface = s->id;
+		}
+		if (s != held[layer]) {
+			OSSafeReleaseNULL(s);
+		}
+	}
+	IOLockLock(fLock);
+	if (fDirty && !fOldValid && !fPendZC && zc == NULL && fPendFence != 0 && !NegroniGPUFenceDone(fPendFence)) {
+		/* 0254: the frame before waits for its fence: kept, shown if its fence passes first */
+		memcpy(fOld, fPending, NEGRONI_FB_SWAP_REC_SIZE);
+		memcpy(fOldHold, fPendHold, sizeof(fOldHold));
+		bzero(fPendHold, sizeof(fPendHold));
+		fOldFence = fPendFence;
+		fOldFenceSurface = fPendFenceSurface;
+		memcpy(fOldFences, fPendFences, sizeof(fOldFences));
+		fOldValid = true;
+	}
+	memcpy(fPending, rec, NEGRONI_FB_SWAP_REC_SIZE);
+	memcpy(dropped, fPendHold, sizeof(dropped));    /* a frame replaced before it was shown */
+	memcpy(fPendHold, held, sizeof(fPendHold));
+	fPendGPU = gpu;
+	fPendZC = zc != NULL;
+	fPendFence = pendFence;
+	fPendFenceSurface = pendSurface;
+	memcpy(fPendFences, pendFences, sizeof(fPendFences));
+	fEndedID = get32(rec, 0x50);
+	if (fPowerOff) {
+		fPresentedID = fEndedID;        /* nothing is shown while off: SwapWait must not wait */
+	}
+	fDirty = true;
+	fLastSwapAbs = mach_absolute_time();
+	vrrWakeLocked();                /* 0259: activity: back to the full rate */
+	IOLockUnlock(fLock);
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		if (dropped[layer] != NULL) {
+			negroni_surface_hold(dropped[layer], false);
+			dropped[layer]->release();
+		}
+	}
+	__atomic_fetch_add(&fStatSwaps, 1, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&negroni_gpu_ui_swaps, 1, __ATOMIC_RELAXED);     /* 0286 */
+	if ((++negroni_fb_swap_count % 1000) == 0) {
+		IOLog("NEGRONI FB: %llu swaps\n", negroni_fb_swap_count);
+	}
+}
