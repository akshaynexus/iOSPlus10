+                                        IOOptionBits            options)
+{
+    IOHIDEvent *            event   = new IOHIDEvent;
+    IOHIDButtonEventData *  data    = NULL;
+    
+    require(event, exit);
+    
+    require(event->initWithTypeTimeStamp(kIOHIDEventTypeButton, timeStamp, options | kIOHIDEventOptionIsAbsolute), exit);
