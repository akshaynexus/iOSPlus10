+#define GPU_PAGE                4096ull                 /* the SMMU's */
+#define GPU_BUFFERS_FIRST       256u                    /* handles per client: the table doubles */
+#define GPU_BUFFERS_MAX         16384u
+#define GPU_BUFFER_MAX          (256ull << 20)
+#define GPU_CLIENT_BYTES        (1024ull << 20)         /* own wired memory per client */
+#define GPU_CLIENT_HOST_BYTES   (1024ull << 20)         /* the client's own pages wired by host imports */
+#define GPU_SUBMIT_CMDS         512u
+#define GPU_SUBMIT_BOS          GPU_BUFFERS_MAX
+#define GPU_SUBMIT_BYTES        (1u << 20)
+#define GPU_WAIT_MAX_MS         60000u
+#define GPU_HUNG_MS             2000u
+#define GPU_ASK_AGAIN_US        200
+#define GPU_VA_WINDOW           (4ull << 30)            /* MSM_PARAM_VA_SIZE */
+#define GPU_POOL_BASE           0x980000000ull
+#define GPU_POOL_MAX_MIB        2048u
+
+enum { kBufferFree = 0, kBufferOwn, kBufferPool, kBufferImport, kBufferHost };
+
+static IOLock * gGPULock;                       /* around the GPU (negroni_gpu_...), the pool, the present */
+static bool gGPUStopped;                        /* a submission has not come back: nothing is waited for again */
+static uint32_t gGPUCloses;                     /* 0254: clients closed (NegroniGPUClientCloses) */
+static uint32_t gGPUFailedLogged;               /* 0287: client waits answered with a failed fence */
+
+/*
+ * Patch 0287, gGPULock held: a hang. Reset and restart the GPU (negroni_gpu_recover logs the fault
+ * and the reset); false: no recovery (off, failed, too often), so the GPU is stopped for good.
+ */
+static bool
+recoverLocked(const char * why)
+{
+	if (gGPUStopped) {
+		return false;
+	}
+	if (negroni_gpu_recover(why)) {
+		IOLog("RedwoodGPU: GPU reset after \"%s\": recovery %u, the work in flight failed\n", why, negroni_gpu_recoveries());
+		return true;
+	}
+	gGPUStopped = true;
+	return false;
+}
+
+static uint64_t
+msNow(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/*
+ * With gGPULock held, which is let go of while waiting. kIOReturnSuccess: done; kIOReturnTimeout:
+ * not within ms (0: only asked); kIOReturnBadArgument: a fence no submission has had yet;
+ * kIOReturnNotReady: the GPU is stopped (or stops now: the completed fence did not move for
+ * GPU_HUNG_MS with this one outstanding).
+ */
+static IOReturn
+gpuWait(uint32_t fence, uint64_t ms)
+{
+	if (fence == 0) {
+		return kIOReturnSuccess;        /* nothing was asked of the GPU */
+	}
+	if (!negroni_gpu_fence_valid(fence)) {
+		return kIOReturnBadArgument;
+	}
+	if (negroni_gpu_done(fence)) {
+		return kIOReturnSuccess;
+	}
+	if (gGPUStopped) {
+		return kIOReturnNotReady;
+	}
+	if (ms == 0) {
+		return kIOReturnTimeout;
+	}
+	uint64_t began = msNow(), moved = began;
+	uint32_t seen = negroni_gpu_completed();
+
+	for (;;) {
+		IOLockUnlock(gGPULock);
+		negroni_gpu_fence_sleep(fence, GPU_ASK_AGAIN_US);       /* 0384: woken by the fence interrupt, else polled */
+		IOLockLock(gGPULock);
+		if (negroni_gpu_done(fence)) {
+			return kIOReturnSuccess;
+		}
+		if (gGPUStopped) {
+			return kIOReturnNotReady;
+		}
+		uint64_t now = msNow();
+		uint32_t completed = negroni_gpu_completed();
+		if (completed != seen) {
+			seen = completed;
+			moved = now;
+		} else if (now - moved >= GPU_HUNG_MS) {
+			/* 0287: a recovery makes this fence read done (failed); clientWait tells the client */
+			return recoverLocked("no answer for 2 s") ? kIOReturnSuccess : kIOReturnNotReady;
+		}
+		if (now - began >= ms) {
+			return kIOReturnTimeout;
+		}
+	}
+}
+
+/*
+ * 0287: gpuWait for a client's own fence (msm WAIT_FENCE, scalar wait, CPU_PREP): a fence a GPU reset
+ * cut off answers kIOReturnError instead of success. gGPULock held.
+ */
+static IOReturn
+clientWait(uint32_t fence, uint64_t ms)
+{
+	IOReturn ret = gpuWait(fence, ms);
+
+	if (ret == kIOReturnSuccess && negroni_gpu_fence_failed(fence)) {
+		if (gGPUFailedLogged++ < 8) {
+			IOLog("RedwoodGPU: fence %u was cut off by GPU reset %u: the wait fails\n", fence, negroni_gpu_recoveries());
+		}
+		ret = kIOReturnError;
+	}
+	return ret;
+}
+
+/* How long from now an msm time is (CLOCK_MONOTONIC = mach_continuous_time on Darwin), in ms. */
+static uint64_t
+millisecondsUntil(const struct msm_timespec * when)
+{
+	uint64_t now;
+	int64_t left;
+
+	absolutetime_to_nanoseconds(mach_continuous_time(), &now);
+	if (when->seconds > (int64_t)(now / NSEC_PER_SEC) + GPU_WAIT_MAX_MS / 1000) {
+		return GPU_WAIT_MAX_MS;
+	}
+	left = when->seconds * (int64_t) NSEC_PER_SEC + when->nanoseconds - (int64_t) now;
+	if (left <= 0) {
+		return 0;
+	}
+	return (uint64_t) left / NSEC_PER_MSEC >= GPU_WAIT_MAX_MS ? GPU_WAIT_MAX_MS : (uint64_t) left / NSEC_PER_MSEC + 1;
+}
+
+/* A page the CPU may hold in its caches (XNU's memory) cleaned and dropped. Others: nothing. */
+static void
+cachePage(uint64_t pa)
+{
+	if (pmap_valid_page((ppnum_t)(pa >> PAGE_SHIFT))) {
+		flush_dcache64((addr64_t)pa, (unsigned)PAGE_SIZE, TRUE);
+	}
+}
+
+/*
+ * The CPU's writes to page pa since the last call out to memory: the pmap's modified bit is set
+ * by the first user write after pmap_clear_modify (ios-sailfish 0182g: flushing every page of
+ * every listed buffer took a quarter of backboardd's CPU). Kernel writes do not set it: buffers
+ * are flushed whole when made or imported.
+ */
+static void
+cacheIfWritten(uint64_t pa)
+{
+	ppnum_t pn = (ppnum_t)(pa >> PAGE_SHIFT);
+
+	if (pmap_valid_page(pn) && pmap_is_modified(pn)) {
+		pmap_clear_modify(pn);
+		flush_dcache64((addr64_t)pa, (unsigned)PAGE_SIZE, TRUE);
+	}
+}
+
+/* ---- RAM XNU does not manage, for write-combined buffers (boot-arg negronigpu_pool) ---- */
+
+static uint64_t gPoolBase;
+static uint32_t gPoolPages;                     /* PAGE_SIZE pages */
+static uint8_t * gPoolUsed;                     /* a byte per page */
+
+static void
+poolInit(void)
+{
+	uint32_t mib = 0;
+	uint64_t base = GPU_POOL_BASE;
+
+	PE_parse_boot_argn("negronigpu_pool", &mib, sizeof(mib));
+	PE_parse_boot_argn("negronigpu_poolbase", &base, sizeof(base));
+	if (mib == 0) {
+		return;
+	}
+	uint64_t size = (uint64_t)MIN(mib, GPU_POOL_MAX_MIB) << 20;
+	if ((base & PAGE_MASK) || pmap_valid_page((ppnum_t)(base >> PAGE_SHIFT)) ||
+	    pmap_valid_page((ppnum_t)((base + size - 1) >> PAGE_SHIFT))) {
+		IOLog("RedwoodGPU: pool 0x%llx + %u MiB refused: not page aligned or memory XNU manages\n", base, mib);
+		return;
+	}
+	gPoolUsed = (uint8_t *)IOMallocZeroData((vm_size_t)(size / PAGE_SIZE));
+	if (gPoolUsed != NULL) {
+		gPoolBase = base;
+		gPoolPages = (uint32_t)(size / PAGE_SIZE);
+		IOLog("RedwoodGPU: write-combined pool 0x%llx..0x%llx (%llu MiB)\n", base, base + size - 1, size >> 20);
+	}
+}
+
+/* With gGPULock held: first fit; 0 when there is no room. */
+static uint64_t
+poolAlloc(uint64_t size)
+{
+	uint32_t want = (uint32_t)(size / PAGE_SIZE), run = 0;
+
+	for (uint32_t i = 0; i < gPoolPages; i++) {
+		run = gPoolUsed[i] ? 0 : run + 1;
+		if (run == want) {
+			uint32_t first = i + 1 - want;
+			memset(gPoolUsed + first, 1, want);
+			return gPoolBase + (uint64_t)first * PAGE_SIZE;
+		}
+	}
+	return 0;
+}
+
+/* With gGPULock held. */
+static void
+poolFree(uint64_t pa, uint64_t size)
+{
+	memset(gPoolUsed + (pa - gPoolBase) / PAGE_SIZE, 0, (size_t)(size / PAGE_SIZE));
+}
