+/*
+ * 0351: under-display fingerprint highlight (negronifp_hl, default 0).
+ * The optical sensor needs a bright, known picture above it while it captures: on Android
+ * the HWC draws a "pressed icon" (a filled disc) at the sensor position and the panel goes to
+ * HBM (oplus_onscreenfingerprint.c: fp_type 0x88 = optical new solution, no local HBM, so the
+ * whole panel's HBM is used: DCS 0x53 = 0xE0, 0x51 = 0x0EFF inside the F0 5A5A / A5A5 unlock,
+ * live.dts 33140 qcom,mdss-dsi-hbm-on-command of timing@fhd_sdc_120). The HAL waits for the
+ * frame with the icon to be on the panel ("ui ready", oplus_ofp_hbm_on_period = 2 TEs) before
+ * it captures.
+ *   negronifp_hl=1  draw the disc after every copy into the panel memory and send the HBM-on
+ *                   set once (thread call: DSI writes sleep); =2 draw only; =0 off
+ *   negronifp_hl_x=N negronifp_hl_y=N negronifp_hl_r=N  centre and radius in panel pixels
+ *                   (defaults 540, 2080, 95 [I]: no stock value found in the DT or images;
+ *                   the stock location is the runtime property
+ *                   persist.vendor.fingerprint.optical.sensorlocation read by libgf_hal_G7.so)
+ * Frames the display engine shows itself (zero-copy, 0234) are not touched.
+ */
+extern "C" int negroni_dsi_dcs_write(const uint8_t *buf, uint32_t len, bool lp);  /* NegroniBacklight.cpp (0250) */
+extern "C" int negroni_fp_hbm(bool on);                                           /* for later stages */
+
+static int negroni_fp_hl = -1;
+static int negroni_fp_hl_x = 540, negroni_fp_hl_y = 2080, negroni_fp_hl_r = 95;
+static bool negroni_fp_hbm_state;
+static uint64_t negroni_fp_hl_frames;
+
+/*
+ * 0354: the highlight is no longer drawn from boot. What is shown (negroni_fp_hl_show):
+ *   0  nothing (default: the phone unlocked, or no negronifp_hl, or no capture)
+ *   1  the lock-screen glyph: two thin rings at the sensor position in a fixed dim grey (0x505050; a
+ *      fixed colour, not a blend, so a re-copy or a re-draw of the same frame changes nothing), no
+ *      fill, no HBM. Shown while kern.negroni_fp_ui = 1 (userland/fp/negroni-fpd sets it from the
+ *      SpringBoard lock state: locked and the screen on).
+ *   2  the capture disc: the filled white disc of 0351, only while 0353's capture window is open
+ *      (negroni_fp_capture_window(true) .. (false), 2 s safety timeout) AND a finger is down inside
+ *      the circle (negroni_touch.c reports every finger to negroni_fp_touch). The HBM DCS set goes
+ *      with the capture (negroni_fp.c), not with the drawing.
+ * The drawing happens at each present (after the GPU copy, as the badges) and at once when the state
+ * changes (negroni_fp_overlay_update: the lock screen is static, so a present may not come). The
+ * pixels under the direct drawing are saved and put back when the overlay goes away, unless a
+ * present came in between (then the next frame simply carries no overlay). All drawing and all
+ * state changes run under negroni_fp_lock (the sysctl, the touch thread, fp_thread and the work
+ * loop's presentFinish call in). No per-frame cost when nothing is shown: present() does not wait
+ * on the copy fence for the highlight.
+ * Known limits [I]: (a) the restore uses the present counter: a present that did not rewrite the
+ * area (a partial copy, a dbuf flip of an older frame) makes the restore put back a stale
+ * (2r+1)^2 patch for one frame; (b) a frame copied while a direct drawing holds the lock gets its
+ * overlay only at the next state change or present (one frame without the glyph); (c) no direct
+ * drawing on the frame the engine shows under zero-copy.
+ */
+static int negroni_fp_ui;                 /* kern.negroni_fp_ui: 0 hidden, 1 glyph */
+static bool negroni_fp_cap_open;          /* 0353 capture window */
+static uint64_t negroni_fp_cap_deadline;  /* mach time; the window closes itself after 2 s */
+static uint32_t negroni_fp_fingers;       /* touch ids inside the circle */
+static int negroni_fp_shown;              /* what the panel memory holds now (0/1/2) */
+static uint64_t negroni_fp_shown_frame;   /* negroni_fp_hl_frames when it was drawn directly */
+static uint32_t *negroni_fp_save;         /* pixels under a direct drawing, (2r+1)^2; allocated once with the lock */
+static IOLock *negroni_fp_lock;           /* one lock around every drawing and every state change */
+static int negroni_fp_init_state;         /* 0 not yet, 1 in progress, 2 done */
+static uint32_t negroni_fp_direct, negroni_fp_restores;
+#define NEGRONI_FP_GLYPH_PX 0xff505050u   /* the glyph colour: a fixed dim grey (idempotent over re-copies) */
+extern "C" void negroni_fp_overlay_update(void);
+extern "C" int negroni_fp_finger_down(void);
+extern "C" void negroni_fp_ui_set(int v);
+extern "C" void negroni_fp_capture_window(bool on);
+extern "C" void negroni_fp_touch(int finger, int down, int x, int y);
