+//==============================================================================
+// IOHIDEventServiceUserClient::setProperties
+//==============================================================================
+IOReturn IOHIDEventServiceUserClient::setProperties( OSObject * properties )
+{
+    return _owner ? _owner->setProperties(properties) : kIOReturnOffline;
+}
