+/*
+ * GPU status badge in the top-right corner (negroni_adreno.c sets text and
+ * colour): white 8x16 console glyphs at 3x on a coloured box, drawn last so
+ * every frame iOS presents carries it.
+ */
+static void
+negroni_draw_text_badge(uintptr_t pixels, uint32_t rowBytes, uint32_t width, uint32_t height,
+    const char *text, uint32_t color, int top)
+{
+	const int scale = 3, pad = 12;
+	size_t n = strnlen(text, 24);
+	int bw = (int)n * 8 * scale + 2 * pad, bh = 16 * scale + 2 * pad;
+	int x0 = (int)width - bw - 24;
+
+	if (n == 0 || x0 < 0 || top + bh > (int)height) {
+		return;
+	}
+	for (int y = 0; y < bh; y++) {
+		uint32_t *row = (uint32_t *)(pixels + (uint64_t)(top + y) * rowBytes) + x0;
+		for (int x = 0; x < bw; x++) {
+			uint32_t c = color;
+			int gx = x - pad, gy = y - pad;
+			if (gx >= 0 && gy >= 0 && gy < 16 * scale && gx < (int)n * 8 * scale) {
+				unsigned char ch = (unsigned char)text[gx / (8 * scale)];
+				unsigned char bits = iso_font[ch * 16 + gy / scale];
+				if (bits & (1u << ((gx / scale) % 8))) {
+					c = 0x00ffffff;
+				}
+			}
+			row[x] = c;
+		}
+	}
+}
+
+/*
+ * negronifb_clockshift=N: move the left ear of the status bar (rows 0..N_ROWS, the
+ * left half: only the clock is there) N pixels to the right, so the clock clears the
+ * punch-hole camera; the rest of the picture is untouched. Done after each copy.
+ */
+static int negroni_clock_shift = -1;
+static int negroni_clock_rows_arg = -1;
+
+/* 0256: the strip the shift moves, in panel rows: the status bar only (negronifb_clockrows). */
+static uint32_t
+negroni_clock_rows(void)
+{
+	if (negroni_clock_rows_arg < 0) {
+		negroni_clock_rows_arg = NEGRONI_FB_CLOCK_ROWS;
+		PE_parse_boot_argn("negronifb_clockrows", &negroni_clock_rows_arg, sizeof(negroni_clock_rows_arg));
+		if (negroni_clock_rows_arg < 1 || negroni_clock_rows_arg > 300) {
+			negroni_clock_rows_arg = NEGRONI_FB_CLOCK_ROWS;
+		}
+	}
+	return (uint32_t)negroni_clock_rows_arg;
+}
+
+/* The shift in panel pixels (0: off), parsed once (0256: also before the first shift). */
+static uint32_t
+negroni_clock_shift_px(void)
+{
+	if (negroni_clock_shift < 0) {
+		negroni_clock_shift = 0;
+		PE_parse_boot_argn("negronifb_clockshift", &negroni_clock_shift, sizeof(negroni_clock_shift));
+		if (negroni_clock_shift < 0 || negroni_clock_shift > 400) {
+			negroni_clock_shift = 0;
+		}
+	}
+	return (uint32_t)negroni_clock_shift;
+}
+
+static void
+negroni_shift_clock(uintptr_t pixels, uint32_t rowBytes, uint32_t width, uint32_t height)
+{
+	const uint32_t rows = negroni_clock_rows();
+	uint32_t n = negroni_clock_shift_px(), half = width / 2;
+	if (n == 0 || n >= half || rows > height) {
+		return;
+	}
+	for (uint32_t y = 0; y < rows; y++) {
+		uint32_t *row = (uint32_t *)(pixels + (uint64_t)y * rowBytes);
+		uint32_t edge = row[0];         /* the status bar's own colour at its left edge */
+		memmove(row + n, row, (size_t)(half - n) * 4);
+		for (uint32_t x = 0; x < n; x++) {
+			row[x] = edge;
+		}
+	}
+}
+
+static int negroni_badges = -1;
+
+/* The GPU / Wi-Fi status badges are drawn only with boot-arg negronibadge=1. */
+static void
+negroni_draw_badge(uintptr_t pixels, uint32_t rowBytes, uint32_t width, uint32_t height)
+{
+	if (negroni_badges < 0) {
+		negroni_badges = 0;
+		PE_parse_boot_argn("negronibadge", &negroni_badges, sizeof(negroni_badges));
+	}
+	if (!negroni_badges) {
+		return;
+	}
+	negroni_draw_text_badge(pixels, rowBytes, width, height, negroni_gpu_badge, negroni_gpu_badge_color, 96);
+	negroni_draw_text_badge(pixels, rowBytes, width, height, negroni_wifi_badge, negroni_wifi_badge_color, 96 + 84);
+}
