+extern "C" uint32_t negroni_dpu_te_rate(uintptr_t intf, uint32_t fps);    /* bsd/dev/negroni_dpu.c (0294) */
+
+/* Mode 2: the tick, CoreAnimation's interval and the refresh property follow the panel rate. */
+/* 0364: one number into a dictionary */
+static void
+negroni_fb_dict_num(OSDictionary *d, const char *key, uint64_t value)
+{
+	OSNumber *n = OSNumber::withNumber(value, 32);
+	if (n != NULL) {
+		d->setObject(key, n);
+		n->release();
+	}
+}
+
+static bool negroni_fb_modes_on;          /* 0364: TimingElements published (GetBlock 0x40 answers) */
+#define NEGRONI_FB_TIMING_ID              1
+#define NEGRONI_FB_COLOR_ID               1
+
+/*
+ * 0364: the display mode the way CoreAnimation reads it (header comment). Keys and layout as HakiOS
+ * MiniIOMobileFramebuffer.cpp:329-379 (APSL 2.0); the size is the presented one (GetDisplaySize).
+ */
+void
+AppleCLCD::publishModes(void)
+{
+	uint32_t on = 1;
+	/* default: the rate frames really reach the panel (negronifb_hz: one copy every fFlushTicks ticks) */
+	uint32_t hz = 1000000u / NEGRONI_FB_VSYNC_US / (fFlushTicks ? fFlushTicks : 1);
+	PE_parse_boot_argn("negronifb_modes", &on, sizeof(on));
+	PE_parse_boot_argn("negronifb_modehz", &hz, sizeof(hz));
+	if (on == 0) {
+		IOLog("NEGRONI FB: modes: off (negronifb_modes=0): no TimingElements, CoreAnimation uses the refresh interval\n");
+		return;
+	}
+	if (hz < 1 || hz > 1000000u / NEGRONI_FB_VSYNC_US) {
+		hz = 1000000u / NEGRONI_FB_VSYNC_US;
+	}
+	const uint64_t rate = (uint64_t)hz << 16;       /* 16.16 fixed point */
+	OSDictionary *timing = OSDictionary::withCapacity(8);
+	OSDictionary *horizontal = OSDictionary::withCapacity(4);
+	OSDictionary *vertical = OSDictionary::withCapacity(4);
+	OSDictionary *color = OSDictionary::withCapacity(8);
+	OSArray *timings = OSArray::withCapacity(1);
+	OSArray *colors = OSArray::withCapacity(1);
+	if (timing != NULL && horizontal != NULL && vertical != NULL && color != NULL && timings != NULL && colors != NULL) {
+		negroni_fb_dict_num(color, "ID", NEGRONI_FB_COLOR_ID);
+		negroni_fb_dict_num(color, "PixelEncoding", 0);         /* RGB 4:4:4 */
+		negroni_fb_dict_num(color, "Depth", 8);
+		negroni_fb_dict_num(color, "Colorimetry", 1);
+		negroni_fb_dict_num(color, "EOTF", 1);
+		negroni_fb_dict_num(color, "DynamicRange", 0);
+		negroni_fb_dict_num(color, "Score", 1);
+		color->setObject("IsVirtual", kOSBooleanFalse);
+		colors->setObject(color);
+		negroni_fb_dict_num(horizontal, "Active", fLogicalW);
+		negroni_fb_dict_num(horizontal, "Total", fLogicalW);
+		negroni_fb_dict_num(horizontal, "SyncRate", rate);
+		negroni_fb_dict_num(horizontal, "PreciseSyncRate", rate);
+		negroni_fb_dict_num(vertical, "Active", fLogicalH);
+		negroni_fb_dict_num(vertical, "Total", fLogicalH);
+		negroni_fb_dict_num(vertical, "SyncRate", rate);
+		negroni_fb_dict_num(vertical, "PreciseSyncRate", rate);
+		negroni_fb_dict_num(timing, "ID", NEGRONI_FB_TIMING_ID);
+		negroni_fb_dict_num(timing, "Score", 1);
+		timing->setObject("IsVirtual", kOSBooleanFalse);
+		timing->setObject("IsOverscanned", kOSBooleanFalse);
+		timing->setObject("HorizontalAttributes", horizontal);
+		timing->setObject("VerticalAttributes", vertical);
+		timing->setObject("ColorModes", colors);
+		timings->setObject(timing);
+		setProperty("TimingElements", timings);
+		setProperty("ColorElements", colors);
+		negroni_fb_modes_on = true;
+		IOLog("NEGRONI FB: modes: TimingElements %ux%u at %u Hz (SyncRate 0x%llx), ColorElements RGB 8-bit, current mode "
+		    "colour %u timing %u (negronifb_modes=1 negronifb_modehz=%u)\n", fLogicalW, fLogicalH, hz,
+		    (unsigned long long)rate, NEGRONI_FB_COLOR_ID, NEGRONI_FB_TIMING_ID, hz);
+	} else {
+		IOLog("NEGRONI FB: modes: not published (no memory)\n");
+	}
+	OSSafeReleaseNULL(timings);
+	OSSafeReleaseNULL(colors);
+	OSSafeReleaseNULL(timing);
+	OSSafeReleaseNULL(horizontal);
+	OSSafeReleaseNULL(vertical);
+	OSSafeReleaseNULL(color);
+}
+
+void
+AppleCLCD::vrrSetRate(uint32_t fps)
+{
+	uint64_t ticks = negroni_fb_us_abs(1000000ull / fps);
+
+	fTickNominalAbs = ticks;
+	fTickAbs = ticks;
+	fStatLateAbs = ticks / 2;
+	fTePeriodUs = 0;        /* measured again at the new rate */
+	/* 0294: the tearcheck vsync_count for the new rate, as Android re-runs tearcheck_config */
+	uint32_t lineNs = negroni_dpu_te_rate(fIntf, fps);
+	if (lineNs != 0) {
+		fTeLineNs = lineNs;
+	}
+	if (fRefreshTicks != 0) {
+		fRefreshTicks = ticks;
+		OSDictionary *refresh = OSDictionary::withCapacity(2);
+		OSNumber *step = OSNumber::withNumber(ticks, 64);
+		OSNumber *min = OSNumber::withNumber(1ULL, 32);
+		if (refresh != NULL && step != NULL && min != NULL) {
+			refresh->setObject("displayRefreshStepMachTime", step);
+			refresh->setObject("displayMinRefreshInterval", min);
+			setProperty("IOMFBDisplayRefresh", refresh);
+		}
+		OSSafeReleaseNULL(refresh);
+		OSSafeReleaseNULL(step);
+		OSSafeReleaseNULL(min);
+	}
+}
+
+/*
+ * Thread call: bring the panel to the wanted state until it is stable. The DCS writes sleep on
+ * the DSI lock and wait for the MDP stream (NegroniBacklight.cpp), so they never run on the
+ * vsync work loop or on backboardd's thread.
+ */
+void
+AppleCLCD::vrrWork(void)
+{
+	for (;;) {
+		IOLockLock(fLock);
+		bool wantIdle = fVrrState == kNegroniVrrGoingIdle || fVrrState == kNegroniVrrIdle;
+		if (wantIdle == fVrrApplied) {
+			fVrrState = wantIdle ? kNegroniVrrIdle : kNegroniVrrActive;
+			fVrrBusy = false;
+			IOLockUnlock(fLock);
+			return;
+		}
+		IOLockUnlock(fLock);
+
+		bool lp = true;
+		bool ready = negroni_backlight_panel_ready(&lp);
+		lp = !fVrrHS && lp;
+		uint64_t t0 = mach_absolute_time();
+		int rc = 0;
+		uint32_t sent = 0;
+		if (wantIdle && !ready) {
+			/* the display is off or there is no DSI: stay at the full rate */
+			IOLockLock(fLock);
+			if (fVrrState == kNegroniVrrGoingIdle) {
+				fVrrState = kNegroniVrrActive;
+				fLastSwapAbs = mach_absolute_time();
+			}
+			IOLockUnlock(fLock);
+			continue;
+		}
+		if (fVrrMode == 2) {
+			if (wantIdle) {
+				rc = fVrrFps == 90 ?
+				    negroni_dsi_dcs_set(negroni_vrr_switch_90, sizeof(negroni_vrr_switch_90), lp, &sent) :
+				    negroni_dsi_dcs_set(negroni_vrr_switch_60, sizeof(negroni_vrr_switch_60), lp, &sent);
+				if (rc == 0) {
+					vrrSetRate(fVrrFps);
+				}
+			} else {
+				if (ready) {
+					rc = negroni_dsi_dcs_set(negroni_vrr_switch_120, sizeof(negroni_vrr_switch_120), lp, &sent);
+				}
+				vrrSetRate(120);
+			}
+		} else {
+			if (wantIdle) {
+				if (fVrrMode == 1) {
+					uint8_t set[sizeof(negroni_vrr_minfps_set)];
+					memcpy(set, negroni_vrr_minfps_set, sizeof(set));
+					set[NEGRONI_VRR_MINFPS_EXT_OFF] = (uint8_t)fVrrExt;
+					rc = negroni_dsi_dcs_set(set, sizeof(set), lp, &sent);
+				}
+				if (rc == 0) {
+					negroni_dpu_wr(fIntf + INTF_TEAR_AUTOREFRESH_CONFIG, 1u << 31 | fVrrDiv);
+				}
+			} else {
+				negroni_dpu_wr(fIntf + INTF_TEAR_AUTOREFRESH_CONFIG, NEGRONI_VRR_AR_ON_1);
+				if (fVrrMode == 1 && ready) {
+					rc = negroni_dsi_dcs_set(negroni_vrr_minfps_set, sizeof(negroni_vrr_minfps_set), lp, &sent);
+				}
+			}
+		}
+		uint64_t ms = negroni_fb_abs_us(mach_absolute_time() - t0) / 1000;
+		IOLockLock(fLock);
+		if (rc != 0) {
+			fVrrDcsErrors++;
+		}
+		if (wantIdle && rc == 0) {
+			fVrrApplied = true;
+			fVrrIdleAt = mach_absolute_time();
+			fVrrIdleCount++;
+			IOLockUnlock(fLock);
+			IOLog("NEGRONI FB VRR: idle %u Hz (hold 0x%02x, autorefresh 1/%u, %u DCS packets, %llu ms)\n",
+			    fVrrFps, fVrrExt, fVrrDiv, sent, ms);
+		} else if (wantIdle) {
+			/*
+			 * The switch failed: VRR off for this boot (a retry every idle period would reach
+			 * 0250's three-failure DSI shutdown and take the brightness and the 0258 sleep DCS
+			 * with it). The auto-refresh divider was not written. Close the Samsung key in
+			 * case the set stopped inside it (best effort).
+			 */
+			fVrrState = kNegroniVrrActive;
+			fVrrDisabled = true;
+			fLastSwapAbs = mach_absolute_time();
+			IOLockUnlock(fLock);
+			if (rc != -1 && rc != -2) {
+				static const uint8_t keyLock[3] = { 0xf0, 0xa5, 0xa5 };
+				(void)negroni_dsi_dcs_write(keyLock, sizeof(keyLock), lp);
+			}
+			IOLog("NEGRONI FB VRR: idle switch failed (%d after %u packets): VRR off\n", rc, sent);
+		} else {
+			uint64_t idle = fVrrApplied ? mach_absolute_time() - fVrrIdleAt : 0;
+			fVrrApplied = false;
+			fVrrIdleTotalAbs += idle;
+			IOLockUnlock(fLock);
+			IOLog("NEGRONI FB VRR: active 120 Hz after %llu ms idle (%u DCS packets, %llu ms%s)\n",
+			    negroni_fb_abs_us(idle) / 1000, sent, ms, rc != 0 ? ", DCS failed" : "");
+		}
+	}
+}
+
+/*
+ * Held surfaces whose GPU copy is done (all: wait for each, at most NEGRONI_FB_GPU_WAIT_MS)
+ * are given back to CoreAnimation. Work loop only.
+ */
+void
+AppleCLCD::releaseBusy(bool all)
+{
+	for (uint32_t i = 0; i < NEGRONI_FB_GPU_BUSY; i++) {
+		NegroniSurface *s = fBusy[i].surface;
+		if (s == NULL) {
+			continue;
+		}
+		if (all) {
+			NegroniGPUFenceWait(fBusy[i].fence, NEGRONI_FB_GPU_WAIT_MS);
+		} else if (!fenceGone(fBusy[i].fence)) {
+			continue;
+		}
+		negroni_surface_hold(s, false);
+		s->release();
+		fBusy[i].surface = NULL;
+	}
+}
+
+/* The surfaces of a presented frame stay held until fence (0: released now). Work loop only. */
+void
+AppleCLCD::keepBusy(NegroniSurface **held, uint32_t fence)
+{
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		NegroniSurface *s = held[layer];
+		uint32_t slot = NEGRONI_FB_GPU_BUSY;
+		if (s == NULL) {
+			continue;
+		}
+		for (uint32_t i = 0; fence != 0 && i < NEGRONI_FB_GPU_BUSY && slot == NEGRONI_FB_GPU_BUSY; i++) {
+			if (fBusy[i].surface == NULL) {
+				slot = i;
+			}
+		}
+		if (slot == NEGRONI_FB_GPU_BUSY) {
+			if (fence != 0 && !fenceGone(fence)) {
+				NegroniGPUFenceWait(fence, NEGRONI_FB_GPU_COPY_WAIT_MS);
+			}
+			negroni_surface_hold(s, false);
+			s->release();
+			continue;
+		}
+		fBusy[slot].surface = s;
+		fBusy[slot].fence = fence;
+	}
+}
