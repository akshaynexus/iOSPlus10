+/* ---- the service ---- */
+
+class RedwoodGPU : public IOService
+{
+	OSDeclareDefaultStructors(RedwoodGPU);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RedwoodGPU, IOService);
+
+/*
+ * A personality of IOResources (iokit/KernelConfigTables.cpp) that waits for the resource
+ * "NegroniGPUKept": the GPU ladder runs after IOKit's first matching (at the root device), and
+ * publishes it when the 3D core stays on (NegroniGPUStart). Created and started by IOKit; the
+ * lock is made here, before registerService() lets anyone open it.
+ */
+bool
+RedwoodGPU::start(IOService * provider)
+{
+	if (!negroni_gpu_ready()) {
+		return false;
+	}
+	if (gGPULock == NULL) {
+		IOLock * lock = IOLockAlloc();
+		if (lock != NULL && !OSCompareAndSwapPtr(NULL, lock, &gGPULock)) {
+			IOLockFree(lock);
+		}
+		if (gGPULock == NULL) {
+			return false;
+		}
+		poolInit();
+	}
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "RedwoodGPUUserClient");
+	setProperty("NegroniGPUABI", negroni_gpu_per_client() ? "scalar 10-16, msm 0x09 0x40-0x4c 0x7e, userptr 0x49, va per-client" :
+	    "scalar 10-16, msm 0x09 0x40-0x4c 0x7e, userptr 0x49, va shared");
+	/* 0289: the IOSurface CPU lock waits for the surface's GPU fence (the ios-spes/HackiOS contract) */
+	setProperty("RedwoodWaitsForGPU", NegroniGPUSurfaceWaitMS() != 0 ? kOSBooleanTrue : kOSBooleanFalse);
+	registerService();
+	IOLog("RedwoodGPU: registered (the IOSurface lock waits up to %u ms for the GPU)\n", NegroniGPUSurfaceWaitMS());
+	return true;
+}
+
+void
+NegroniGPUStart(void)
+{
+	IOService::publishResource("NegroniGPUKept", kOSBooleanTrue);
+}
+
+/* ---- buffers ---- */
+
+struct gpu_buffer {
+	IOMemoryDescriptor *    memory;         /* the pages (retained) */
+	IOMemoryMap *           umap;           /* scalar BO_NEW's mapping in the client's task */
+	NegroniSurface *        surface;        /* imports: retained */
+	uint64_t *              pa;             /* every PAGE_SIZE page's physical address */
+	uint64_t                address;        /* the GPU's (0: none, after SET_IOVA 0) */
+	uint64_t                size;           /* a multiple of PAGE_SIZE */
+	uint32_t                npages;
+	uint32_t                flags;          /* MSM_BO_* as asked */
+	uint32_t                fence;          /* the last submission that names it (0: none has) */
+	uint8_t                 kind;           /* kBufferFree: this handle is free */
+	bool                    readOnly;       /* for the GPU */
+	bool                    userAddress;    /* address in the client's window (SET_IOVA) */
+	bool                    prepared;       /* memory->prepare() done (imports) */
+	uint64_t                guard;          /* 0298: bytes after the buffer mapped to the trash page (kernel addresses) */
+};
+
+/*
+ * Patch 0298: a guard after every buffer at a kernel-chosen GPU address (the audit's "zero page"; bergamota and
+ * gpu-status.md: the GPU writes whole tiles past a surface's end). One PAGE_SIZE page, writable, shared by every
+ * buffer and never read by the CPU, is mapped for PAGE_SIZE after the buffer, so such a write lands there instead
+ * of in the next buffer or in an SMMU fault. Client-chosen addresses (SET_IOVA, Turnip) get none: the client
+ * packs its own range. Boot-arg negronigpu_guard (default 1).
+ */
+static IOBufferMemoryDescriptor * gTrash;
+static uint64_t gTrashPA;
+static int gGuardOn = -1;
+
+static uint64_t
+guardBytes(void)
+{
+	if (gGuardOn < 0) {
+		int on = 1;
+		PE_parse_boot_argn("negronigpu_guard", &on, sizeof(on));
+		gGuardOn = on != 0;
+	}
+	if (!gGuardOn) {
+		return 0;
+	}
+	if (gTrash == NULL) {
+		IOBufferMemoryDescriptor * md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut,
+		    PAGE_SIZE, PAGE_SIZE);
+		if (md == NULL) {
+			return 0;
+		}
+		bzero(md->getBytesNoCopy(), PAGE_SIZE);
+		flush_dcache64((addr64_t)(uintptr_t)md->getBytesNoCopy(), PAGE_SIZE, FALSE);
+		uint64_t pa = md->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+		if (pa == 0 || !__sync_bool_compare_and_swap(&gTrash, (IOBufferMemoryDescriptor *)NULL, md)) {
+			md->release();          /* another client made it first (or no address) */
+		} else {
+			gTrashPA = pa;
+			IOLog("RedwoodGPU: guard page 0x%llx after every kernel-placed buffer (0298, negronigpu_guard=0 turns it off)\n", pa);
+		}
+	}
+	return gTrashPA != 0 ? PAGE_SIZE : 0;
+}
+
+class RedwoodGPUUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(RedwoodGPUUserClient);
+
+	task_t                  fTask;
+	IOLock *                fLock;                  /* the buffer table; taken before gGPULock */
+	struct gpu_buffer *     fBuffers;               /* handle n is fBuffers[n - 1] */
+	uint32_t                fCap;
+	uint64_t                fOwnBytes;
+	uint64_t                fHostBytes;             /* host imports (0x49) */
+	uint64_t                fWindow;                /* MSM_PARAM_VA_START (0: none asked for) */
+	uint64_t                fWindowSize;
+	struct negroni_gpu_vm * fVM;                    /* own tables (negronigpu_pt=1), else NULL: the shared ones */
+	bool                    fLeaked;                /* a buffer stayed the GPU's: the tables must stay too */
+	uint32_t                fNextQueue;
+	uint32_t                fSubmits;
+	uint32_t                fLastFence;             /* 0287: this client's newest submission */
+	uint32_t                fRecSeen;               /* 0287: recoveries already checked against fLastFence */
+	uint32_t                fFaults;                /* 0287: recoveries that cut off this client's work */
+	uint32_t                fCalls;
+	bool                    fClosed;
+	char                    fName[24];
+
+	struct gpu_buffer * buffer(uint32_t handle);
+	void countFaults(void);
+	struct gpu_buffer * newBuffer(uint32_t * handle);
+	bool takePages(struct gpu_buffer * b);
+	bool mapBuffer(struct gpu_buffer * b, uint64_t address);
+	bool mapAnywhere(struct gpu_buffer * b);
+	void unmapBuffer(struct gpu_buffer * b);
+	void dropBuffer(struct gpu_buffer * b);
+	void freeBuffer(struct gpu_buffer * b);
+	void freeAll(void);
+	IOReturn makeBuffer(uint64_t size, uint32_t flags, bool scalar, uint32_t * handle);
+	IOReturn importSurface(uint32_t id, uint32_t * handle);
+	IOReturn importHost(uint64_t pointer, uint64_t size, uint32_t flags, uint32_t * handle);
+	IOReturn setAddress(struct gpu_buffer * b, uint64_t address);
+	IOReturn submitIBs(const uint64_t * addresses, const uint32_t * words, uint32_t count,
+	    const uint32_t * handles, uint32_t nhandles, uint32_t * fence);
+	IOReturn cpuPrep(uint32_t handle, uint64_t ms);
+	IOReturn getParam(struct msm_param * p);
+	IOReturn gemInfo(struct msm_gem_info * request);
+	IOReturn msmSubmit(struct msm_gem_submit * request);
+	IOReturn surfaceRequest(struct redwood_drm_surface * request);
+	IOReturn scalarSubmit(IOExternalMethodArguments * args);
+	IOReturn scalarMethod(uint32_t selector, IOExternalMethodArguments * args);
+	IOReturn msmMethod(uint32_t selector, IOExternalMethodArguments * args);
+
+public:
+	virtual bool initWithTask(task_t owningTask, void * securityID, UInt32 type) APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(RedwoodGPUUserClient, IOUserClient);
+
+bool
+RedwoodGPUUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	fTask = owningTask;
+	proc_selfname(fName, sizeof(fName));
+	fLock = IOLockAlloc();
+	return fLock != NULL;
+}
+
+bool
+RedwoodGPUUserClient::start(IOService * provider)
+{
+	IOLog("RedwoodGPU: opened by %s (pid %d)\n", fName, proc_selfpid());
+	if (!negroni_gpu_ready() || gGPULock == NULL || OSDynamicCast(RedwoodGPU, provider) == NULL) {
+		return false;
+	}
+	if (negroni_gpu_per_client()) {
+		IOLockLock(gGPULock);
+		fVM = negroni_gpu_vm_create();
+		IOLockUnlock(gGPULock);
+		if (fVM == NULL) {
+			IOLog("RedwoodGPU: no GPU tables for %s\n", fName);
+			return false;
+		}
+	}
+	return IOUserClient::start(provider);
+}
+
+/* fLock held. */
+struct gpu_buffer *
+RedwoodGPUUserClient::buffer(uint32_t handle)
+{
+	if (handle == 0 || handle > fCap || fBuffers[handle - 1].kind == kBufferFree) {
+		return NULL;
+	}
+	return &fBuffers[handle - 1];
+}
+
+/*
+ * fLock held: a free slot (the table doubles up to GPU_BUFFERS_MAX), or NULL. Pointers into the
+ * table are good only until the next call.
+ */
+struct gpu_buffer *
+RedwoodGPUUserClient::newBuffer(uint32_t * handle)
+{
+	for (uint32_t i = 0; i < fCap; i++) {
+		if (fBuffers[i].kind == kBufferFree) {
+			*handle = i + 1;
+			return &fBuffers[i];
+		}
+	}
+	uint32_t cap = fCap ? fCap * 2 : GPU_BUFFERS_FIRST;
+	if (cap > GPU_BUFFERS_MAX) {
+		return NULL;
+	}
+	struct gpu_buffer * table = IONewZero(struct gpu_buffer, cap);
+	if (table == NULL) {
+		return NULL;
+	}
+	if (fBuffers != NULL) {
+		memcpy(table, fBuffers, fCap * sizeof(table[0]));
+		IODelete(fBuffers, struct gpu_buffer, fCap);
+	}
+	fBuffers = table;
+	*handle = fCap + 1;
+	fCap = cap;
+	return &fBuffers[*handle - 1];
+}
+
+/* b->memory and b->size set: its pages into b->pa (whole PAGE_SIZE pages, page aligned). */
+bool
+RedwoodGPUUserClient::takePages(struct gpu_buffer * b)
+{
+	b->npages = (uint32_t)(b->size / PAGE_SIZE);
+	b->pa = IONewZero(uint64_t, b->npages);
+	if (b->pa == NULL) {
+		b->npages = 0;
+		return false;
+	}
+	for (uint32_t p = 0; p < b->npages; p++) {
+		IOByteCount length = 0;
+		b->pa[p] = b->memory->getPhysicalSegment((IOByteCount)p * PAGE_SIZE, &length, kIOMemoryMapperNone);
+		if (b->pa[p] == 0 || (b->pa[p] & PAGE_MASK) || length < PAGE_SIZE) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* fLock held. The pages at a GPU address (then b->address = it). */
+bool
+RedwoodGPUUserClient::mapBuffer(struct gpu_buffer * b, uint64_t address)
+{
+	bool mapped = true;
+
+	IOLockLock(gGPULock);
+	for (uint32_t p = 0; p < b->npages && mapped; p++) {
+		for (uint64_t sub = 0; sub < PAGE_SIZE && mapped; sub += GPU_PAGE) {
+			mapped = negroni_gpu_vm_map(fVM, address + (uint64_t)p * PAGE_SIZE + sub, b->pa[p] + sub, b->readOnly);
+		}
+	}
+	for (uint64_t sub = 0; mapped && sub < b->guard; sub += GPU_PAGE) {
+		mapped = negroni_gpu_vm_map(fVM, address + b->size + sub, gTrashPA + (sub % PAGE_SIZE), false);
+	}
+	if (!mapped) {
+		negroni_gpu_vm_unmap(fVM, address, b->size + b->guard);
+	} else {
+		negroni_gpu_vm_mapped(fVM);
+		b->address = address;
+		b->userAddress = false;
+	}
+	IOLockUnlock(gGPULock);
+	return mapped;
+}
+
+/* fLock held. At a GPU address the kernel picks. */
+bool
+RedwoodGPUUserClient::mapAnywhere(struct gpu_buffer * b)
+{
+	uint64_t address;
+
+	b->guard = guardBytes();        /* 0298 */
+	IOLockLock(gGPULock);
+	address = negroni_gpu_vm_address(fVM, b->size + b->guard);
+	IOLockUnlock(gGPULock);
+	if (address != 0 && mapBuffer(b, address)) {
+		return true;
+	}
+	if (address != 0) {
+		IOLockLock(gGPULock);
+		negroni_gpu_vm_address_free(fVM, address, b->size + b->guard);
+		IOLockUnlock(gGPULock);
+	}
+	b->guard = 0;
+	IOLog("RedwoodGPU: a buffer of %llu bytes cannot be entered into the GPU's address space\n", b->size);
+	return false;
+}
+
+/* fLock held; the GPU is done with b. Its GPU address out (and back to the free list if the kernel's). */
+void
+RedwoodGPUUserClient::unmapBuffer(struct gpu_buffer * b)
+{
+	if (b->address == 0) {
+		return;
+	}
+	IOLockLock(gGPULock);
+	negroni_gpu_vm_unmap(fVM, b->address, b->size + b->guard);
+	if (!b->userAddress) {
+		negroni_gpu_vm_address_free(fVM, b->address, b->size + b->guard);
+	}
+	IOLockUnlock(gGPULock);
+	b->address = 0;
+	b->userAddress = false;
+	b->guard = 0;
+}
+
+/* fLock held; nothing of b is in the GPU (any more). Everything else given back, the slot free. */
+void
+RedwoodGPUUserClient::dropBuffer(struct gpu_buffer * b)
+{
+	OSSafeReleaseNULL(b->umap);
+	if (b->kind == kBufferPool && b->pa != NULL && b->pa[0] != 0) {
+		IOLockLock(gGPULock);
+		poolFree(b->pa[0], b->size);
+		IOLockUnlock(gGPULock);
+	}
+	if (b->memory != NULL) {
+		if (b->prepared) {
+			b->memory->complete();
+		}
+		b->memory->release();
+	}
+	OSSafeReleaseNULL(b->surface);
+	if (b->pa != NULL) {
+		IODelete(b->pa, uint64_t, b->npages);
+	}
+	bzero(b, sizeof(*b));
+}
+
+/*
+ * fLock held. A buffer the GPU may still be using is waited for (1 s); if the GPU does not
+ * finish, its memory and mapping stay the GPU's for good (it may yet be written).
+ */
+void
+RedwoodGPUUserClient::freeBuffer(struct gpu_buffer * b)
+{
+	IOReturn done = kIOReturnSuccess;
+
+	if (b->fence != 0) {
+		IOLockLock(gGPULock);
+		done = gpuWait(b->fence, 1000);
+		IOLockUnlock(gGPULock);
+	}
+	if (b->kind == kBufferOwn || b->kind == kBufferPool) {
+		fOwnBytes -= b->size;
+	} else if (b->kind == kBufferHost) {
+		fHostBytes -= b->size;
+	}
+	if (done != kIOReturnSuccess) {
+		IOLog("RedwoodGPU: the GPU is not done with a buffer of %llu bytes: it stays its own\n", b->size);
+		fLeaked = true;
+		OSSafeReleaseNULL(b->umap);     /* the program's view goes; the pages and the GPU's stay */
+		bzero(b, sizeof(*b));           /* memory, surface and page list leak on purpose */
+		return;
+	}
+	unmapBuffer(b);
+	dropBuffer(b);
+}
+
+void
+RedwoodGPUUserClient::freeAll(void)
+{
+	IOLockLock(fLock);
+	if (!fClosed) {
+		fClosed = true;
+		for (uint32_t i = 0; i < fCap; i++) {
+			if (fBuffers[i].kind != kBufferFree) {
+				freeBuffer(&fBuffers[i]);
+			}
+		}
+		if (fWindow != 0 && fVM == NULL) {
+			IOLockLock(gGPULock);
+			negroni_gpu_address_free(fWindow, GPU_VA_WINDOW);
+			IOLockUnlock(gGPULock);
+		}
+		fWindow = 0;
+		if (fVM != NULL) {
+			IOLockLock(gGPULock);
+			if (!fLeaked && !negroni_gpu_vm_current(fVM)) {
+				fLeaked = !negroni_gpu_vm_destroy(fVM);
+			} else if (!fLeaked) {
+				/* its tables are the 3D core's now: back to the kernel's once the GPU is idle */
+				if (gpuWait(negroni_gpu_last(), 1000) != kIOReturnSuccess || !negroni_gpu_vm_switch(NULL) ||
+				    !negroni_gpu_vm_destroy(fVM)) {
+					fLeaked = true;
+				}
+			}
+			IOLockUnlock(gGPULock);
+			if (fLeaked) {
+				IOLog("RedwoodGPU: %s: its GPU tables stay (the GPU may still use them)\n", fName);
+			}
+			fVM = NULL;
+		}
+	}
+	IOLockUnlock(fLock);
+}
+
+IOReturn
+RedwoodGPUUserClient::clientClose(void)
+{
+	IOLog("RedwoodGPU: %s closes\n", fName);
+	OSIncrementAtomic((volatile SInt32 *)&gGPUCloses);
+	freeAll();
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+void
+RedwoodGPUUserClient::free(void)
+{
+	if (fLock != NULL) {
+		if (gGPULock != NULL) {
+			freeAll();              /* clientClose did it, unless the client never got that far */
+		}
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	if (fBuffers != NULL) {
+		IODelete(fBuffers, struct gpu_buffer, fCap);
+		fBuffers = NULL;
+	}
+	IOUserClient::free();
+}
+
+/*
+ * fLock held. A buffer of our own: cached wired kernel memory, or (msm GEM_NEW with MSM_BO_WC or
+ * UNCACHED, pool on) pool memory. Zeroed, out of the CPU's caches, at a kernel-chosen GPU address.
+ */
+IOReturn
+RedwoodGPUUserClient::makeBuffer(uint64_t size, uint32_t flags, bool scalar, uint32_t * handle)
+{
+	struct gpu_buffer * b;
+	bool pool = !scalar && gPoolPages != 0 && (flags & (MSM_BO_WC | MSM_BO_UNCACHED)) != 0;
+
+	size = round_page_64(size);
+	if (size == 0 || size > GPU_BUFFER_MAX || (flags & MSM_BO_CACHED_COHERENT)) {
+		return kIOReturnBadArgument;    /* CACHED_COHERENT: no I/O-coherent path here (Turnip asks once) */
+	}
+	if (fOwnBytes + size > GPU_CLIENT_BYTES) {
+		return kIOReturnNoMemory;
+	}
+	b = newBuffer(handle);
+	if (b == NULL) {
+		IOLog("RedwoodGPU: %s has no handles left\n", fName);
+		return kIOReturnNoResources;
+	}
+	b->size = size;
+	b->flags = flags;
+	b->readOnly = (flags & MSM_BO_GPU_READONLY) != 0;
+	if (pool) {
+		uint64_t pa;
+		IOLockLock(gGPULock);
+		pa = poolAlloc(size);
+		IOLockUnlock(gGPULock);
+		if (pa != 0) {
+			b->memory = IOMemoryDescriptor::withPhysicalAddress(pa, size, kIODirectionInOut);
+			if (b->memory == NULL) {
+				IOLockLock(gGPULock);
+				poolFree(pa, size);
+				IOLockUnlock(gGPULock);
+			} else {
+				b->kind = kBufferPool;  /* from here dropBuffer gives the pages back */
+			}
+		}
+	}
+	if (b->memory == NULL) {
+		b->memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut |
+		    kIOMemoryKernelUserShared, (vm_size_t)size, PAGE_SIZE);
+		b->kind = kBufferOwn;
+	}
+	if (b->memory == NULL || !takePages(b)) {
+		goto fail;
+	}
+	if (b->kind == kBufferPool) {
+		IOMemoryMap * map = b->memory->map(kIOMapWriteCombineCache);
+		if (map == NULL) {
+			goto fail;
+		}
+		bzero((void *)map->getVirtualAddress(), (size_t)size);
+		__asm__ volatile ("dsb sy");
+		map->release();
+	} else {
+		bzero(((IOBufferMemoryDescriptor *)b->memory)->getBytesNoCopy(), (size_t)size);
+		for (uint32_t p = 0; p < b->npages; p++) {
+			cachePage(b->pa[p]);
+			pmap_clear_modify((ppnum_t)(b->pa[p] >> PAGE_SHIFT));
+		}
+	}
+	if (!mapAnywhere(b)) {
+		goto fail;
+	}
+	fOwnBytes += size;
+	if (scalar) {
+		/* the scalar ABI hands out the program's mapping (cached: see the top of this file) */
+		b->umap = b->memory->createMappingInTask(fTask, 0, kIOMapAnywhere);
+		if (b->umap == NULL) {
+			freeBuffer(b);
+			return kIOReturnNoMemory;
+		}
+	}
+	return kIOReturnSuccess;
+fail:
+	if (b->kind == kBufferFree) {
+		b->kind = kBufferOwn;           /* dropBuffer's bookkeeping */
+	}
+	dropBuffer(b);
+	return kIOReturnNoMemory;
+}
+
+/*
+ * fLock held. An IOSurface (NegroniSurface.cpp) as a buffer: the same pages, whole, from the
+ * first page of its memory (the surface's offset is within it). Its cached lines are cleaned
+ * and dropped now (the zero fill, CPU drawing before); later CPU writes are cleaned at each
+ * submission that lists it. The surface stays retained while the buffer lives.
+ */
+IOReturn
+RedwoodGPUUserClient::importSurface(uint32_t id, uint32_t * handle)
+{
+	NegroniSurface * s = negroni_surface_copy(id);
+	struct gpu_buffer * b;
+	uint64_t size;
+
+	if (s == NULL || s->memory == NULL) {
+		OSSafeReleaseNULL(s);
+		return kIOReturnNotFound;
+	}
+	size = s->memory->getLength();
+	if (size == 0 || (size & PAGE_MASK) || size > GPU_BUFFER_MAX) {
+		s->release();
+		return kIOReturnBadArgument;
+	}
+	b = newBuffer(handle);
+	if (b == NULL) {
+		s->release();
+		return kIOReturnNoResources;
+	}
+	b->kind = kBufferImport;
+	b->surface = s;                         /* the copy's reference */
+	b->memory = s->memory;
+	b->memory->retain();
+	b->size = size;
+	b->flags = MSM_BO_CACHED;
+	if (b->memory->prepare() != kIOReturnSuccess) {
+		dropBuffer(b);
+		return kIOReturnVMError;
+	}
+	b->prepared = true;
+	if (!takePages(b)) {
+		dropBuffer(b);
+		return kIOReturnVMError;
+	}
+	for (uint32_t p = 0; p < b->npages; p++) {
+		cachePage(b->pa[p]);
+		if (pmap_valid_page((ppnum_t)(b->pa[p] >> PAGE_SHIFT))) {
+			pmap_clear_modify((ppnum_t)(b->pa[p] >> PAGE_SHIFT));
+		}
+	}
+	if (s->slot >= 0 && s->kernelAddress() != 0) {
+		/* a display slot (0234): memory XNU does not manage, cached in the CPU: by kernel address */
+		negroni_surface_cache(s->kernelAddress(), size, kNegroniCacheFlush);
+	}
+	if (!mapAnywhere(b)) {
+		dropBuffer(b);
+		return kIOReturnNoMemory;
+	}
+	return kIOReturnSuccess;
+}
+
+/*
+ * fLock held. 0x49: the caller's pages [pointer, pointer + size) as a buffer (Turnip's
+ * VK_EXT_external_memory_host, Metal's newBufferWithBytesNoCopy:). The pages are wired
+ * (prepare) while the handle lives, so the GPU keeps the pages that were there at import even if
+ * the program unmaps or remaps the range. Read-only (kUserptrReadOnly): wired for reading only
+ * (read-only memory of the program can be imported) and mapped read-only for the GPU. Cache rules
+ * as for an IOSurface import: cleaned and dropped now, the CPU's later writes cleaned at each
+ * submission that lists it, CPU_PREP after GPU writes. Only the task that opened the connection.
+ */
+IOReturn
+RedwoodGPUUserClient::importHost(uint64_t pointer, uint64_t size, uint32_t flags, uint32_t * handle)
+{
+	bool readOnly = (flags & kUserptrReadOnly) != 0;
+	struct gpu_buffer * b;
+
+	if ((flags & ~kUserptrReadOnly) != 0 || pointer == 0 || size == 0 || (pointer & PAGE_MASK) ||
+	    (size & PAGE_MASK) || size > GPU_BUFFER_MAX || pointer + size < pointer) {
+		return kIOReturnBadArgument;
+	}
+	if (current_task() != fTask) {
+		return kIOReturnNotPermitted;
+	}
+	if (fHostBytes + size > GPU_CLIENT_HOST_BYTES) {
+		return kIOReturnNoMemory;
+	}
+	b = newBuffer(handle);
+	if (b == NULL) {
+		IOLog("RedwoodGPU: %s has no handles left\n", fName);
+		return kIOReturnNoResources;
+	}
+	b->kind = kBufferHost;
+	b->size = size;
+	b->readOnly = readOnly;
+	b->flags = MSM_BO_CACHED | (readOnly ? MSM_BO_GPU_READONLY : 0);
+	b->memory = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)pointer, (mach_vm_size_t)size,
+	    readOnly ? kIODirectionOut : kIODirectionInOut, fTask);
+	if (b->memory == NULL) {
+		dropBuffer(b);
+		return kIOReturnNoMemory;
+	}
+	if (b->memory->prepare() != kIOReturnSuccess) {
+		dropBuffer(b);
+		return kIOReturnVMError;        /* not mapped, or not writable without kUserptrReadOnly */
+	}
+	b->prepared = true;
+	if (!takePages(b)) {
+		dropBuffer(b);
+		return kIOReturnVMError;
+	}
+	for (uint32_t p = 0; p < b->npages; p++) {
+		cachePage(b->pa[p]);
+		if (pmap_valid_page((ppnum_t)(b->pa[p] >> PAGE_SHIFT))) {
+			pmap_clear_modify((ppnum_t)(b->pa[p] >> PAGE_SHIFT));
+		}
+	}
+	if (!mapAnywhere(b)) {
+		dropBuffer(b);
+		return kIOReturnNoMemory;
+	}
+	fHostBytes += size;
+	return kIOReturnSuccess;
+}
+
+/*
+ * fLock held. MSM_INFO_SET_IOVA: 0 takes the buffer's GPU address away (Turnip, before it
+ * reuses the range); otherwise the buffer moves to that address, which must be in this client's
+ * window (MSM_PARAM_VA_START/VA_SIZE), page aligned, and not overlap another of its buffers.
+ */
+IOReturn
+RedwoodGPUUserClient::setAddress(struct gpu_buffer * b, uint64_t address)
+{
+	if (b->fence != 0) {
+		IOLockLock(gGPULock);
+		IOReturn ret = gpuWait(b->fence, 1000);
+		IOLockUnlock(gGPULock);
+		if (ret != kIOReturnSuccess) {
+			return kIOReturnBusy;
+		}
+	}
+	if (address == 0) {
+		unmapBuffer(b);
+		return kIOReturnSuccess;
+	}
+	if (b->userAddress && b->address == address) {
+		return kIOReturnSuccess;
+	}
+	if (fWindow == 0 || (address & PAGE_MASK) || address < fWindow ||
+	    address + b->size > fWindow + fWindowSize || address + b->size < address) {
+		return kIOReturnBadArgument;
+	}
+	for (uint32_t i = 0; i < fCap; i++) {
+		struct gpu_buffer * o = &fBuffers[i];
+		if (o != b && o->kind != kBufferFree && o->userAddress &&
+		    address < o->address + o->size && o->address < address + b->size) {
+			return kIOReturnBadArgument;
+		}
+	}
+	unmapBuffer(b);                 /* b->guard is 0 from here: a client address has no guard (0298) */
+	if (!mapBuffer(b, address)) {
+		return kIOReturnNoMemory;
+	}
+	b->userAddress = true;
+	return kIOReturnSuccess;
+}
+
+/*
+ * fLock held. Command buffers (GPU address and size in words, each inside one of the listed
+ * buffers), the listed buffers' CPU writes out to memory, then the ring. Every listed buffer
+ * (and imported surface) remembers the fence.
+ */
+IOReturn
+RedwoodGPUUserClient::submitIBs(const uint64_t * addresses, const uint32_t * words, uint32_t count,
+    const uint32_t * handles, uint32_t nhandles, uint32_t * fence)
+{
+	struct gpu_buffer * last = NULL;
+
+	*fence = 0;
+	if (count == 0 || count > GPU_SUBMIT_CMDS || nhandles > GPU_SUBMIT_BOS) {
+		return kIOReturnBadArgument;
+	}
+	for (uint32_t i = 0; i < nhandles; i++) {
+		if (buffer(handles[i]) == NULL) {
+			return kIOReturnBadArgument;
+		}
+	}
+	for (uint32_t c = 0; c < count; c++) {
+		uint64_t end = addresses[c] + (uint64_t)words[c] * 4;
+		bool inside = last != NULL && addresses[c] >= last->address && end <= last->address + last->size;
+
+		for (uint32_t i = 0; !inside && i < nhandles; i++) {
+			struct gpu_buffer * b = buffer(handles[i]);
+			if (b->address != 0 && addresses[c] >= b->address && end <= b->address + b->size) {
+				inside = true;
+				last = b;
+			}
+		}
+		if (!inside || words[c] == 0 || (addresses[c] & 3) || words[c] > 0xfffffu) {
+			IOLog("RedwoodGPU: %s: command buffer %u at %#llx, %u words, is not in a listed buffer\n", fName,
+			    c, addresses[c], words[c]);
+			return kIOReturnBadArgument;
+		}
+	}
+	for (uint32_t i = 0; i < nhandles; i++) {
+		struct gpu_buffer * b = buffer(handles[i]);
+		if (b->kind != kBufferPool) {
+			for (uint32_t p = 0; p < b->npages; p++) {
+				cacheIfWritten(b->pa[p]);
+			}
+		}
+	}
+	IOLockLock(gGPULock);
+	/*
+	 * Own tables (negronigpu_pt=1): the 3D core switches to them only when it is idle, so the
+	 * work of the client before is waited for first (gpuWait lets go of the lock meanwhile; another
+	 * client may switch again: then wait again).
+	 */
+	for (uint32_t tries = 0; fVM != NULL && !gGPUStopped && !negroni_gpu_vm_current(fVM); tries++) {
+		IOReturn idle = tries < 16 ? gpuWait(negroni_gpu_last(), GPU_WAIT_MAX_MS) : kIOReturnTimeout;
+		if (idle != kIOReturnSuccess) {
+			IOLockUnlock(gGPULock);
+			IOLog("RedwoodGPU: %s: the GPU does not get idle for a table switch (0x%x)\n", fName, idle);
+			return idle == kIOReturnTimeout ? kIOReturnBusy : kIOReturnNotReady;
+		}
+		if (negroni_gpu_vm_current(fVM) || !negroni_gpu_done(negroni_gpu_last())) {
+			continue;               /* another submission came meanwhile: wait for it too */
+		}
+		if (!negroni_gpu_vm_switch(fVM)) {
+			/* idle, and still the context did not take the tables: nothing is safe to run any more */
+			negroni_gpu_report("table switch failed");
+			gGPUStopped = true;
+		}
+	}
+	if (gGPUStopped || !negroni_gpu_ready()) {
+		IOLockUnlock(gGPULock);
+		return kIOReturnNotReady;
+	}
+	countFaults();
+	negroni_gpu_to_memory(NULL, 0);
+	*fence = negroni_gpu_submit(addresses, words, count);
+	if (*fence == 0 && recoverLocked("the ring stays full or the WPTR write was lost")) {
+		countFaults();
+		*fence = negroni_gpu_submit(addresses, words, count);   /* 0287: once more on the new ring */
+		if (*fence == 0) {
+			negroni_gpu_report("the ring stays full after a GPU reset");
+			gGPUStopped = true;
+		}
+	}
+	if (*fence != 0) {
+		fLastFence = *fence;
+	}
+	IOLockUnlock(gGPULock);
+	if (*fence == 0) {
+		return kIOReturnNotReady;
+	}
+	for (uint32_t i = 0; i < nhandles; i++) {
+		struct gpu_buffer * b = buffer(handles[i]);
+		b->fence = *fence;
+		if (b->surface != NULL) {
+			b->surface->gpuFence = *fence;
+		}
+	}
+	if (fSubmits++ < 4) {
+		IOLog("RedwoodGPU: %s submission %u: %u command buffers, the first at %#llx, %u words, %u buffers\n",
+		    fName, *fence, count, addresses[0], words[0], nhandles);
+	}
+	return kIOReturnSuccess;
+}
+
+/* fLock held. Wait (ms: 0 = only ask) for the buffer's last submission, then drop the CPU's lines. */
+IOReturn
+RedwoodGPUUserClient::cpuPrep(uint32_t handle, uint64_t ms)
+{
+	struct gpu_buffer * b = buffer(handle);
+	IOReturn ret = kIOReturnSuccess;
+
+	if (b == NULL) {
+		return kIOReturnNotFound;
+	}
+	if (b->fence != 0) {
+		IOLockLock(gGPULock);
+		ret = clientWait(b->fence, ms);
+		IOLockUnlock(gGPULock);
+		if (ret == kIOReturnTimeout && ms == 0) {
+			ret = kIOReturnBusy;
+		}
+	}
+	if (ret == kIOReturnSuccess && b->kind != kBufferPool && b->fence != 0) {
+		for (uint32_t p = 0; p < b->npages; p++) {
+			cachePage(b->pa[p]);
+		}
+	}
+	return ret;
+}
+
+IOReturn
+RedwoodGPUUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory)
+{
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(fLock);
+	b = fClosed ? NULL : buffer(type);
+	if (b != NULL && b->kind == kBufferHost) {
+		ret = kIOReturnUnsupported;     /* the program has its own mapping of these pages */
+	} else if (b != NULL) {
+		b->memory->retain();
+		*memory = b->memory;
+		*options = b->kind == kBufferPool ? kIOMapWriteCombineCache : kIOMapDefaultCache;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(fLock);
+	return ret;
+}
+
+/* ---- the msm ABI ---- */
+
+/* fLock held. */
+IOReturn
+RedwoodGPUUserClient::getParam(struct msm_param * p)
+{
+	switch (p->param) {
+	case MSM_PARAM_FAULTS:                  /* 0287: + every recovery (msm's global fault count; Turnip: device lost) */
+		p->value = (gGPUStopped ? 1 : 0) + negroni_gpu_recoveries();
+		return kIOReturnSuccess;
+	case MSM_PARAM_SUSPENDS:
+		p->value = 0;
+		return kIOReturnSuccess;
+	case MSM_PARAM_VA_START:
+	case MSM_PARAM_VA_SIZE:
+		if (fWindow == 0 && fVM != NULL) {
+			fWindow = negroni_gpu_vm_window(&fWindowSize);  /* own tables: the same window in every client */
+		} else if (fWindow == 0) {
+			IOLockLock(gGPULock);
+			fWindow = negroni_gpu_address(GPU_VA_WINDOW);
+			IOLockUnlock(gGPULock);
+			if (fWindow == 0) {
+				return kIOReturnNoMemory;
+			}
+			fWindowSize = GPU_VA_WINDOW;
+		}
+		p->value = p->param == MSM_PARAM_VA_START ? fWindow : fWindowSize;
+		return kIOReturnSuccess;
+	default:
+		return negroni_gpu_parameter(p->param, &p->value) ? kIOReturnSuccess : kIOReturnBadArgument;
+	}
+}
+
+/* fLock held. */
+IOReturn
+RedwoodGPUUserClient::gemInfo(struct msm_gem_info * request)
+{
+	struct gpu_buffer * b = buffer(request->handle);
+
+	if (b == NULL) {
+		return kIOReturnBadArgument;
+	}
+	switch (request->info) {
+	case MSM_INFO_GET_OFFSET:
+		request->value = (uint64_t) request->handle << 32;
+		return kIOReturnSuccess;
+	case MSM_INFO_GET_IOVA:
+		if (b->address == 0 && !mapAnywhere(b)) {       /* taken away by SET_IOVA 0: a kernel one again */
+			return kIOReturnNoMemory;
+		}
+		request->value = b->address;
+		return kIOReturnSuccess;
+	case MSM_INFO_SET_IOVA:
+		return setAddress(b, request->value);
+	case MSM_INFO_GET_FLAGS:
+		request->value = b->flags;
+		return kIOReturnSuccess;
+	case MSM_INFO_SET_NAME:
+	case MSM_INFO_SET_METADATA:
+		return kIOReturnSuccess;        /* accepted, not kept */
+	default:
+		return kIOReturnUnsupported;    /* GET_NAME, GET_METADATA */
+	}
+}
+
+/* fLock held. Linux msm_ioctl_gem_submit for one ring and softpin buffers (no relocations). */
+IOReturn
+RedwoodGPUUserClient::msmSubmit(struct msm_gem_submit * request)
+{
+	struct msm_gem_submit_bo * bos = NULL;
+	struct msm_gem_submit_cmd * cmds = NULL;
+	uint64_t * addresses = NULL;
+	uint32_t * words = NULL, * handles = NULL, count = 0, fence = 0;
+	uint32_t nbos = request->nr_bos, ncmds = request->nr_cmds;
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (request->flags & (MSM_SUBMIT_FENCE_FD_IN | MSM_SUBMIT_SUDO | MSM_SUBMIT_FENCE_SN_IN)) {
+		return kIOReturnUnsupported;
+	}
+	if (ncmds == 0 || ncmds > GPU_SUBMIT_CMDS || nbos > GPU_SUBMIT_BOS) {
+		return kIOReturnBadArgument;
+	}
+	if (nbos != 0) {
+		bos = IONew(struct msm_gem_submit_bo, nbos);
+		handles = IONew(uint32_t, nbos);
+	}
+	cmds = IONew(struct msm_gem_submit_cmd, ncmds);
+	addresses = IONew(uint64_t, ncmds);
+	words = IONew(uint32_t, ncmds);
+	if ((nbos != 0 && (bos == NULL || handles == NULL)) || cmds == NULL || addresses == NULL || words == NULL) {
+		ret = kIOReturnNoMemory;
+		goto out;
+	}
+	if ((nbos != 0 && copyin((user_addr_t) request->bos, bos, nbos * sizeof(*bos)) != 0) ||
+	    copyin((user_addr_t) request->cmds, cmds, ncmds * sizeof(*cmds)) != 0) {
+		ret = kIOReturnVMError;
+		goto out;
+	}
+	for (uint32_t i = 0; i < nbos; i++) {
+		handles[i] = bos[i].handle;
+	}
+	for (uint32_t i = 0; i < ncmds; i++) {
+		struct gpu_buffer * b;
+
+		if (cmds[i].type == MSM_SUBMIT_CMD_IB_TARGET_BUF) {
+			continue;               /* reached from another IB */
+		}
+		b = cmds[i].submit_idx < nbos ? buffer(bos[cmds[i].submit_idx].handle) : NULL;
+		if ((cmds[i].type != MSM_SUBMIT_CMD_BUF && cmds[i].type != MSM_SUBMIT_CMD_CTX_RESTORE_BUF) || b == NULL ||
+		    b->address == 0 || cmds[i].nr_relocs != 0 || (cmds[i].size & 3) || (cmds[i].submit_offset & 3) ||
+		    (uint64_t) cmds[i].submit_offset + cmds[i].size > b->size) {
+			IOLog("RedwoodGPU: %s: command %u (type %u, buffer %u, offset %u, %u bytes, %u relocations) not taken\n",
+			    fName, i, cmds[i].type, cmds[i].submit_idx, cmds[i].submit_offset, cmds[i].size, cmds[i].nr_relocs);
+			goto out;
+		}
+		addresses[count] = b->address + cmds[i].submit_offset;
+		words[count++] = cmds[i].size / 4;
+	}
+	/*
+	 * SYNCOBJ_IN: one ring runs everything in order, so a fence an earlier submission got is
+	 * done before this one starts; SYNCOBJ_OUT: user space gives this fence to its syncobjs
+	 * (docs/gpu-abi.md "Sync objects"). FENCE_FD_OUT: no sync_file here (-1). queueid: one ring.
+	 */
+	ret = submitIBs(addresses, words, count, handles, nbos, &fence);
+	request->fence = fence;
+	if (request->flags & MSM_SUBMIT_FENCE_FD_OUT) {
+		request->fence_fd = -1;
+	}
+out:
+	if (bos != NULL) {
+		IODelete(bos, struct msm_gem_submit_bo, nbos);
+	}
+	if (handles != NULL) {
+		IODelete(handles, uint32_t, nbos);
+	}
+	if (cmds != NULL) {
+		IODelete(cmds, struct msm_gem_submit_cmd, ncmds);
+	}
+	if (addresses != NULL) {
+		IODelete(addresses, uint64_t, ncmds);
+	}
+	if (words != NULL) {
+		IODelete(words, uint32_t, ncmds);
+	}
+	return ret;
+}
+
+/* fLock held. 0x7e: what an IOSurface is as a buffer; with any handle but kSurfaceDescribe, import it. */
+IOReturn
+RedwoodGPUUserClient::surfaceRequest(struct redwood_drm_surface * request)
+{
+	NegroniSurface * s = negroni_surface_copy(request->surface);
+
+	if (s == NULL || s->memory == NULL) {
+		OSSafeReleaseNULL(s);
+		return kIOReturnNotFound;
+	}
+	request->size = s->memory->getLength();
+	request->offset = s->offset;
+	request->row_bytes = s->bytesPerRow;
+	request->width = s->width;
+	request->height = s->height;
+	request->pixel_format = s->pixelFormat;
+	request->planes = s->planeCount;
+	s->release();
+	if (request->handle == kSurfaceDescribe) {
+		return kIOReturnSuccess;
+	}
+	return importSurface(request->surface, &request->handle);
+}
+
+IOReturn
+RedwoodGPUUserClient::msmMethod(uint32_t selector, IOExternalMethodArguments * args)
+{
+	union {
+		struct msm_param param;
+		struct msm_gem_new gemNew;
+		struct msm_gem_info gemInfo;
+		struct msm_gem_cpu_prep cpuPrep;
+		struct msm_gem_cpu_fini cpuFini;
+		struct msm_gem_submit submit;
+		struct msm_wait_fence waitFence;
+		struct msm_gem_madvise madvise;
+		struct msm_submitqueue queue;
+		struct msm_submitqueue_query query;
+		struct drm_gem_close close;
+		struct redwood_drm_surface surface;
+		struct redwood_drm_userptr userptr;
+		uint32_t queueId;
+	} r;
+	size_t size = args->structureInputSize;
+	struct gpu_buffer * b;
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t faults;
+
+	if (args->structureInput == NULL || size == 0 || size > sizeof(r)) {
+		return kIOReturnBadArgument;
+	}
+	bzero(&r, sizeof(r));
+	memcpy(&r, args->structureInput, size);
+
+	if (selector == kMsmWaitFence) {        /* without fLock: other threads submit meanwhile */
+		IOLockLock(gGPULock);
+		ret = clientWait(r.waitFence.fence, millisecondsUntil(&r.waitFence.timeout));
+		IOLockUnlock(gGPULock);
+		return ret;
+	}
+	IOLockLock(fLock);
+	if (fClosed) {
+		IOLockUnlock(fLock);
+		return kIOReturnNotOpen;
+	}
+	switch (selector) {
+	case kMsmGetParam:
+		ret = getParam(&r.param);
+		break;
+	case kMsmSetParam:                      /* SYSPROF, COMM, CMDLINE: accepted, not kept */
+		ret = r.param.param == MSM_PARAM_SYSPROF || r.param.param == MSM_PARAM_COMM ||
+		    r.param.param == MSM_PARAM_CMDLINE ? kIOReturnSuccess : kIOReturnBadArgument;
+		break;
+	case kMsmGemNew:
+		ret = makeBuffer(r.gemNew.size, r.gemNew.flags, false, &r.gemNew.handle);
+		break;
+	case kMsmGemInfo:
+		ret = gemInfo(&r.gemInfo);
+		break;
+	case kMsmGemCpuPrep:
+		ret = cpuPrep(r.cpuPrep.handle, (r.cpuPrep.op & MSM_PREP_NOSYNC) ? 0 : millisecondsUntil(&r.cpuPrep.timeout));
+		break;
+	case kMsmGemCpuFini:                    /* the CPU's writes are cleaned at the next submission */
+		ret = buffer(r.cpuFini.handle) != NULL ? kIOReturnSuccess : kIOReturnBadArgument;
+		break;
+	case kMsmGemSubmit:
+		ret = msmSubmit(&r.submit);
+		break;
+	case kMsmGemMadvise:                    /* nothing is purged here */
+		ret = buffer(r.madvise.handle) != NULL ? kIOReturnSuccess : kIOReturnBadArgument;
+		r.madvise.retained = 1;
+		break;
+	case kMsmSubmitQueueNew:
+		ret = r.queue.prio == 0 ? kIOReturnSuccess : kIOReturnBadArgument;      /* PRIORITIES is 1 */
+		r.queue.id = ++fNextQueue;
+		break;
+	case kMsmSubmitQueueClose:
+		break;
+	case kMsmSubmitQueueQuery:
+		IOLockLock(gGPULock);
+		countFaults();
+		IOLockUnlock(gGPULock);
+		faults = (gGPUStopped ? 1 : 0) + fFaults;       /* 0287: recoveries that cut off this client's work */
+		if (r.query.param != MSM_SUBMITQUEUE_PARAM_FAULTS) {
+			ret = kIOReturnBadArgument;
+		} else if (r.query.data != 0 && r.query.len != 0 &&
+		    copyout(&faults, (user_addr_t) r.query.data, MIN(r.query.len, sizeof(faults))) != 0) {
+			ret = kIOReturnVMError;
+		}
+		r.query.len = sizeof(faults);
+		break;
+	case kDrmGemClose:
+		b = buffer(r.close.handle);
+		if (b == NULL) {
+			ret = kIOReturnBadArgument;
+		} else {
+			freeBuffer(b);
+		}
+		break;
+	case kRedwoodSurface:
+		ret = surfaceRequest(&r.surface);
+		break;
+	case kRedwoodUserptr:
+		ret = size == sizeof(r.userptr) ? importHost(r.userptr.pointer, r.userptr.size, r.userptr.flags,
+		    &r.userptr.handle) : kIOReturnBadArgument;
+		break;
+	default:
+		IOLog("RedwoodGPU: request %#x (%zu bytes) is not known here\n", selector, size);
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	IOLockUnlock(fLock);
+	if (ret == kIOReturnSuccess && args->structureOutput != NULL) {
+		if (args->structureOutputSize > size) {
+			args->structureOutputSize = (uint32_t) size;
+		}
+		memcpy(args->structureOutput, &r, args->structureOutputSize);
+	}
+	return ret;
+}
+
+/* ---- the scalar ABI (ios-sailfish SweetGPU 10-16) ---- */
+
+/* fLock held. Struct in: scalar_submit, scalar_ib[nr_ibs], uint32_t handles[nr_bos]. */
+IOReturn
+RedwoodGPUUserClient::scalarSubmit(IOExternalMethodArguments * args)
+{
+	const uint8_t * in = (const uint8_t *) args->structureInput;
+	size_t length = args->structureInputSize;
+	void * copy = NULL;
+	struct scalar_submit h = { 0, 0 };
+	uint64_t * addresses = NULL;
+	uint32_t * words = NULL, * handles = NULL, fence = 0;
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (args->scalarOutputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	if (args->structureInputDescriptor != NULL) {
+		IOMemoryDescriptor * d = args->structureInputDescriptor;
+		length = (size_t) d->getLength();
+		copy = length <= GPU_SUBMIT_BYTES ? IOMallocData(length) : NULL;
+		if (copy == NULL) {
+			return kIOReturnNoMemory;
+		}
+		if (d->prepare() != kIOReturnSuccess) {
+			IOFreeData(copy, length);
+			return kIOReturnVMError;
+		}
+		bool read = d->readBytes(0, copy, length) == length;
+		d->complete();
+		if (!read) {
+			IOFreeData(copy, length);
+			return kIOReturnVMError;
+		}
+		in = (const uint8_t *) copy;
+	}
+	if (in == NULL || length < sizeof(h)) {
+		goto out;
+	}
+	memcpy(&h, in, sizeof(h));
+	if (h.nr_ibs == 0 || h.nr_ibs > GPU_SUBMIT_CMDS || h.nr_bos > GPU_SUBMIT_BOS ||
+	    length != sizeof(h) + (size_t) h.nr_ibs * sizeof(struct scalar_ib) + (size_t) h.nr_bos * sizeof(uint32_t)) {
+		h.nr_ibs = h.nr_bos = 0;
+		goto out;
+	}
+	addresses = IONew(uint64_t, h.nr_ibs);
+	words = IONew(uint32_t, h.nr_ibs);
+	handles = h.nr_bos ? IONew(uint32_t, h.nr_bos) : NULL;
+	if (addresses == NULL || words == NULL || (h.nr_bos != 0 && handles == NULL)) {
+		ret = kIOReturnNoMemory;
+		goto out;
+	}
+	for (uint32_t i = 0; i < h.nr_ibs; i++) {
+		struct scalar_ib ib;
+		memcpy(&ib, in + sizeof(h) + i * sizeof(ib), sizeof(ib));
+		addresses[i] = ib.iova;
+		words[i] = ib.dwords;
+	}
+	if (h.nr_bos != 0) {
+		memcpy(handles, in + sizeof(h) + (size_t) h.nr_ibs * sizeof(struct scalar_ib), h.nr_bos * sizeof(uint32_t));
+	}
+	ret = submitIBs(addresses, words, h.nr_ibs, handles, h.nr_bos, &fence);
+	args->scalarOutput[0] = fence;
+	args->scalarOutputCount = 1;
+out:
+	if (addresses != NULL) {
+		IODelete(addresses, uint64_t, h.nr_ibs);
+	}
+	if (words != NULL) {
+		IODelete(words, uint32_t, h.nr_ibs);
+	}
+	if (handles != NULL) {
+		IODelete(handles, uint32_t, h.nr_bos);
+	}
+	if (copy != NULL) {
+		IOFreeData(copy, length);
+	}
+	return ret;
+}
+
+IOReturn
+RedwoodGPUUserClient::scalarMethod(uint32_t selector, IOExternalMethodArguments * args)
+{
+	IOReturn ret = kIOReturnBadArgument;
+	uint32_t handle = 0;
+
+	if (selector == kScalarWait) {          /* without fLock: other threads submit meanwhile */
+		if (args->scalarInputCount != 2 || args->scalarInput[0] > 0xffffffffull) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gGPULock);
+		ret = clientWait((uint32_t) args->scalarInput[0], MIN(args->scalarInput[1], (uint64_t) GPU_WAIT_MAX_MS));
+		IOLockUnlock(gGPULock);
+		return ret;
+	}
+	if (selector == kScalarInfo) {
+		if (args->scalarOutputCount < 5) {
+			return kIOReturnBadArgument;
+		}
+		negroni_gpu_parameter(MSM_PARAM_CHIP_ID, &args->scalarOutput[0]);
+		negroni_gpu_parameter(MSM_PARAM_GMEM_SIZE, &args->scalarOutput[1]);
+		negroni_gpu_parameter(MSM_PARAM_GMEM_BASE, &args->scalarOutput[2]);
+		negroni_gpu_parameter(MSM_PARAM_MAX_FREQ, &args->scalarOutput[3]);
+		args->scalarOutput[4] = 0;      /* no fence page in the caller: poll with 14 */
+		args->scalarOutputCount = 5;
+		return kIOReturnSuccess;
+	}
+	IOLockLock(fLock);
+	if (fClosed) {
+		IOLockUnlock(fLock);
+		return kIOReturnNotOpen;
+	}
+	switch (selector) {
+	case kScalarBoNew:
+		if (args->scalarInputCount >= 1 && args->scalarOutputCount >= 3) {
+			ret = makeBuffer(args->scalarInput[0], MSM_BO_CACHED, true, &handle);
+			if (ret == kIOReturnSuccess) {
+				struct gpu_buffer * b = buffer(handle);
+				args->scalarOutput[0] = handle;
+				args->scalarOutput[1] = b->address;
+				args->scalarOutput[2] = b->umap->getAddress();
+				args->scalarOutputCount = 3;
+			}
+		}
+		break;
+	case kScalarBoFree:
+		if (args->scalarInputCount == 1) {
+			struct gpu_buffer * b = args->scalarInput[0] <= 0xffffffffull ? buffer((uint32_t) args->scalarInput[0]) : NULL;
+			ret = b != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+			if (b != NULL) {
+				freeBuffer(b);
+			}
+		}
+		break;
+	case kScalarBoImport:
+		if (args->scalarInputCount == 1 && args->scalarOutputCount >= 3) {
+			ret = importSurface((uint32_t) args->scalarInput[0], &handle);
+			if (ret == kIOReturnSuccess) {
+				struct gpu_buffer * b = buffer(handle);
+				args->scalarOutput[0] = handle;
+				args->scalarOutput[1] = b->address;
+				args->scalarOutput[2] = b->size;
+				args->scalarOutputCount = 3;
+			}
+		}
+		break;
+	case kScalarSubmit:
+		ret = scalarSubmit(args);
+		break;
+	case kScalarBoCpuPrep:
+		if (args->scalarInputCount == 1 && args->scalarInput[0] <= 0xffffffffull) {
+			ret = cpuPrep((uint32_t) args->scalarInput[0], 0);
+		}
+		break;
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	IOLockUnlock(fLock);
+	return ret;
+}
+
+IOReturn
+RedwoodGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	if (fCalls < 64) {
+		fCalls++;
+		IOLog("RedwoodGPU: %s request %#x, %u bytes in, %u out, scalars %u\n", fName, selector,
+		    args->structureInputSize, args->structureOutputSize, args->scalarInputCount);
+	}
+	if (!negroni_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+	if (selector >= kScalarBoNew && selector <= kScalarBoCpuPrep) {
+		return scalarMethod(selector, args);
+	}
+	return msmMethod(selector, args);
+}
+
+/*
+ * ---- the panel present (NegroniFramebuffer.cpp, patch 0231) ----
+ *
+ * The framebuffer hands over a swapped surface the GPU rendered; the 2D engine copies the
+ * visible rectangle into the panel memory (ABL's continuous-splash buffer, which the display
+ * engine scans out by itself), queued behind the render on the same ring, so nobody waits.
+ * The stream is built by bsd/dev/negroni_gpu_blit.c into one of two kernel command buffers;
+ * up to four surfaces stay mapped (read-only for the GPU) and retained, the oldest whose copy
+ * is done makes room. The panel memory is mapped once. All of it under gGPULock.
+ */
+#include "NegroniGPU.h"
+#include "../../../bsd/dev/negroni_gpu_blit.h"
+
+#define PRESENT_SURFACES        4
+
+static struct {
+	NegroniSurface *        surface;        /* retained, its memory prepared */
+	uint64_t                address, size;
+	uint32_t                fence;          /* the last copy that read it */
+} gPresentMaps[PRESENT_SURFACES];
+static uint32_t gPresentNext;
+/* 0269: the panel buffers (panel memory + the double-buffer ones), each mapped once, never unmapped */
+#define NEGRONI_GPU_PANEL_MAPS 4
+static uint64_t gPanelPhys[NEGRONI_GPU_PANEL_MAPS], gPanelAddress[NEGRONI_GPU_PANEL_MAPS], gPanelBytes[NEGRONI_GPU_PANEL_MAPS];
+static IOBufferMemoryDescriptor * gPresentIB[2];
+static uint64_t gPresentIBAddress[2];
+static uint32_t gPresentIBFence[2], gPresentIBNext;
+static int gPresentOn = -1;
+static uint32_t gPresentLogged;
+
+/* gGPULock held. [phys, + size) or the pages of md, at a new GPU address; 0 on failure. */
+static uint64_t
+presentMap(IOMemoryDescriptor * md, uint64_t phys, uint64_t size, bool readOnly)
+{
+	uint64_t address = negroni_gpu_address(size);
+	bool mapped = address != 0;
+
+	for (uint64_t offset = 0; offset < size && mapped; offset += GPU_PAGE) {
+		uint64_t pa = phys + offset;
+		if (md != NULL) {
+			IOByteCount length = 0;
+			pa = md->getPhysicalSegment((IOByteCount)offset, &length, kIOMemoryMapperNone);
+			mapped = pa != 0 && (pa & (GPU_PAGE - 1)) == 0 && length >= GPU_PAGE;
+		}
+		mapped = mapped && negroni_gpu_map(address + offset, pa, readOnly);
+	}
+	if (!mapped) {
+		if (address != 0) {
+			negroni_gpu_unmap(address, size);
+			negroni_gpu_address_free(address, size);
+		}
+		return 0;
+	}
+	negroni_gpu_mapped();
+	return address;
+}
+
+/* gGPULock held. */
+static void
+presentUnmap(uint64_t address, uint64_t size)
+{
+	negroni_gpu_unmap(address, size);
+	negroni_gpu_address_free(address, size);
+}
+
+/* gGPULock held. The GPU address of s's memory (mapped now if it is not), or 0. */
+static uint64_t
+presentSurface(NegroniSurface * s, uint32_t * slot)
+{
+	uint32_t pick = PRESENT_SURFACES;
+	uint64_t size = s->memory->getLength();
+
+	for (uint32_t i = 0; i < PRESENT_SURFACES; i++) {
+		if (gPresentMaps[i].surface == s) {
+			*slot = i;
+			return gPresentMaps[i].address;
+		}
+	}
+	for (uint32_t n = 0; n < PRESENT_SURFACES && pick == PRESENT_SURFACES; n++) {
+		uint32_t i = (gPresentNext + n) % PRESENT_SURFACES;
+		if (gPresentMaps[i].surface == NULL || negroni_gpu_done(gPresentMaps[i].fence)) {
+			pick = i;
+		}
+	}
+	if (pick == PRESENT_SURFACES || size == 0 || (size & PAGE_MASK) || size > GPU_BUFFER_MAX) {
+		return 0;                       /* four copies in flight, or an odd surface */
+	}
+	if (gPresentMaps[pick].surface != NULL) {
+		presentUnmap(gPresentMaps[pick].address, gPresentMaps[pick].size);
+		gPresentMaps[pick].surface->memory->complete();
+		gPresentMaps[pick].surface->release();
+		gPresentMaps[pick].surface = NULL;
+	}
+	if (s->memory->prepare() != kIOReturnSuccess) {
+		return 0;
+	}
+	uint64_t address = presentMap(s->memory, 0, size, true);
+	if (address == 0) {
+		s->memory->complete();
+		return 0;
+	}
+	s->retain();
+	gPresentMaps[pick].surface = s;
+	gPresentMaps[pick].address = address;
+	gPresentMaps[pick].size = size;
+	gPresentMaps[pick].fence = 0;
+	gPresentNext = pick + 1;
+	*slot = pick;
+	return address;
+}
+
+bool
+NegroniGPUPresentReady(void)
+{
+	if (gPresentOn < 0) {
+		int on = 1;
+		PE_parse_boot_argn("negronifb_gpu", &on, sizeof(on));
+		gPresentOn = on != 0;
+	}
+	return gPresentOn > 0 && gGPULock != NULL && negroni_gpu_ready() && !gGPUStopped;
+}
+
+uint32_t
+NegroniGPUPresent(NegroniSurface * s, uint64_t panelPhys, uint32_t pitch, uint32_t rows,
+    uint32_t sx, uint32_t sy, uint32_t dx, uint32_t dy, uint32_t w, uint32_t h)
+{
+	struct NegroniGPURect r = { sx, sy, dx, dy, w, h };
+
+	return NegroniGPUPresentRects(s, panelPhys, pitch, rows, &r, 1);
+}
+
+/*
+ * 0267: n rectangles in one IB (each one the self-contained copy stream of negroni_gpu_copy_ib,
+ * at most NEGRONI_GPU_COPY_WORDS words; the IB page holds PAGE_SIZE / 4), one fence.
+ */
+uint32_t
+NegroniGPUPresentRects(NegroniSurface * s, uint64_t panelPhys, uint32_t pitch, uint32_t rows,
+    const struct NegroniGPURect * rects, uint32_t n)
+{
+	uint32_t count = 0, fence = 0, slot = 0, ib, pm;
+	uint64_t source, panelAddress = 0, panelBytes = ((uint64_t)pitch * rows + GPU_PAGE - 1) & ~(GPU_PAGE - 1);
+	const char * why = NULL;
+	uint32_t sx = n ? rects[0].sx : 0, sy = n ? rects[0].sy : 0, dx = n ? rects[0].dx : 0, dy = n ? rects[0].dy : 0;
+	uint32_t w = n ? rects[0].w : 0, h = n ? rects[0].h : 0;
+
+	if (!NegroniGPUPresentReady() || s == NULL || s->memory == NULL || s->bytesPerElement != 4 ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || (s->offset & 63) || (s->bytesPerRow & 63) ||
+	    (panelPhys & (GPU_PAGE - 1)) || n == 0 || n > NEGRONI_GPU_PRESENT_RECTS ||
+	    (uint64_t)n * NEGRONI_GPU_COPY_WORDS * 4 > PAGE_SIZE) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		if ((uint64_t)rects[i].dy + rects[i].h > rows || rects[i].w == 0 || rects[i].h == 0) {
+			return 0;
+		}
+	}
+	IOLockLock(gGPULock);
+	if (gGPUStopped) {
+		goto out;
+	}
+	/*
+	 * 0269: one mapping per panel buffer, kept: a copy into one buffer can still be queued while
+	 * the next frame goes to another (before, a change of panelPhys unmapped the old one).
+	 */
+	for (pm = 0; pm < NEGRONI_GPU_PANEL_MAPS && panelAddress == 0; pm++) {
+		if (gPanelAddress[pm] != 0 && gPanelPhys[pm] == panelPhys && gPanelBytes[pm] == panelBytes) {
+			panelAddress = gPanelAddress[pm];
+		}
+	}
+	for (pm = 0; pm < NEGRONI_GPU_PANEL_MAPS && panelAddress == 0; pm++) {
+		if (gPanelAddress[pm] == 0) {
+			panelAddress = presentMap(NULL, panelPhys, panelBytes, false);
+			IOLog("RedwoodGPU: panel memory 0x%llx (%llu bytes) at GPU address 0x%llx (map %u)\n", panelPhys, panelBytes,
+			    panelAddress, pm);
+			if (panelAddress == 0) {
+				why = "the panel memory cannot be mapped";
+				goto out;
+			}
+			gPanelAddress[pm] = panelAddress;
+			gPanelPhys[pm] = panelPhys;
+			gPanelBytes[pm] = panelBytes;
+		}
+	}
+	if (panelAddress == 0) {
+		why = "more panel buffers than GPU mappings";
+		goto out;
+	}
+	for (ib = 0; ib < 2; ib++) {
+		if (gPresentIB[ib] == NULL) {
+			IOBufferMemoryDescriptor * md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+			    kIODirectionInOut, PAGE_SIZE, PAGE_SIZE);
+			uint64_t address = md != NULL ? presentMap(md, 0, PAGE_SIZE, true) : 0;
+			if (address == 0) {
+				OSSafeReleaseNULL(md);
+				why = "no command buffer";
+				goto out;
+			}
+			gPresentIB[ib] = md;
+			gPresentIBAddress[ib] = address;
+		}
+	}
+	ib = gPresentIBNext;
+	if (!negroni_gpu_done(gPresentIBFence[ib])) {
+		goto out;                       /* two copies still queued: this frame goes the CPU way */
+	}
+	source = presentSurface(s, &slot);
+	if (source == 0) {
+		goto out;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		struct negroni_gpu_copy copy = {
+			.src = source + s->offset, .src_pitch = s->bytesPerRow,
+			.dst = panelAddress, .dst_pitch = pitch,
+			.sx = rects[i].sx, .sy = rects[i].sy, .dx = rects[i].dx, .dy = rects[i].dy,
+			.w = rects[i].w, .h = rects[i].h,
+		};
+		uint32_t part = negroni_gpu_copy_ib(&copy, (uint32_t *)gPresentIB[ib]->getBytesNoCopy() + count,
+		    NEGRONI_GPU_COPY_WORDS);
+		if (part == 0) {
+			count = 0;
+			break;
+		}
+		count += part;
+	}
+	if (count == 0) {
+		why = "the copy cannot be put to the 2D engine";
+		goto out;
+	}
+	flush_dcache64((addr64_t)(uintptr_t)gPresentIB[ib]->getBytesNoCopy(), count * 4, FALSE);
+	fence = negroni_gpu_submit(&gPresentIBAddress[ib], &count, 1);
+	if (fence == 0) {
+		(void)recoverLocked("the ring stays full (present)");   /* 0287: this frame goes the CPU way either way */
+		goto out;
+	}
+	gPresentIBFence[ib] = fence;
+	gPresentIBNext = ib ^ 1;
+	gPresentMaps[slot].fence = fence;
+	if (gPresentLogged < 4) {
+		gPresentLogged++;
+		IOLog("RedwoodGPU: present %u: surface %u (fence %u) %ux%u from %u,%u to %u,%u, %u rect(s), %u words\n", fence,
+		    s->id, s->gpuFence, w, h, sx, sy, dx, dy, n, count);
+	}
+out:
+	IOLockUnlock(gGPULock);
+	if (why != NULL && gPresentLogged < 8) {
+		gPresentLogged++;
+		IOLog("RedwoodGPU: present of surface %u: %s\n", s->id, why);
+	}
+	return fence;
+}
+
+/*
+ * 0287, gGPULock held: recoveries since the last check that cut off this client's work (its newest
+ * submission before the recovery was at or after the recovery's first failed fence).
+ */
+void
+RedwoodGPUUserClient::countFaults(void)
+{
+	uint32_t count = negroni_gpu_recoveries();
+
+	for (; fRecSeen < count; fRecSeen++) {
+		uint32_t lo = negroni_gpu_recovery_lo(fRecSeen);
+		if (fLastFence != 0 && (lo == 0 || (int32_t)(fLastFence - lo) >= 0)) {
+			fFaults++;
+		}
+	}
+}
+
+/*
+ * 0287: the GPU watch thread (negroni_adreno.c, without its own lock) saw a fault: recover, unless
+ * the GPU moved on meanwhile (a fence was written) or a wait already recovered it.
+ */
+void
+NegroniGPUWatchFault(const char * why, uint32_t completed)
+{
+	if (gGPULock == NULL) {
+		return;
+	}
+	IOLockLock(gGPULock);
+	if (!gGPUStopped && negroni_gpu_completed() == completed && negroni_gpu_last() != completed) {
+		(void)recoverLocked(why);
+	}
+	IOLockUnlock(gGPULock);
+}
+
+bool
+NegroniGPUFenceDone(uint32_t fence)
+{
+	bool done;
+
+	if (fence == 0 || gGPULock == NULL) {
+		return true;
+	}
+	IOLockLock(gGPULock);
+	done = negroni_gpu_done(fence) || gGPUStopped;  /* stopped: nothing more will come */
+	IOLockUnlock(gGPULock);
+	return done;
+}
+
+uint32_t
+NegroniGPUFenceCompleted(void)
+{
+	uint32_t completed;
+
+	if (gGPULock == NULL) {
+		return 0;
+	}
+	IOLockLock(gGPULock);
+	completed = negroni_gpu_completed();
+	IOLockUnlock(gGPULock);
+	return completed;
+}
+
+uint32_t
+NegroniGPUClientCloses(void)
+{
+	return __atomic_load_n(&gGPUCloses, __ATOMIC_RELAXED);
+}
+
+bool
+NegroniGPUFenceWait(uint32_t fence, uint32_t ms)
+{
+	IOReturn ret;
+
+	if (fence == 0 || gGPULock == NULL) {
+		return true;
+	}
+	IOLockLock(gGPULock);
+	ret = gpuWait(fence, ms);
+	IOLockUnlock(gGPULock);
+	return ret == kIOReturnSuccess;
+}
+
+uint32_t
+NegroniGPUSurfaceWaitMS(void)
+{
+	static uint32_t ms = ~0u;
+
+	if (ms == ~0u) {
+		uint32_t arg = NEGRONI_SURFACE_GPU_WAIT_MS;
+		PE_parse_boot_argn("negronisurf_gpuwait", &arg, sizeof(arg));
+		ms = MIN(arg, 2000u);
+	}
+	return ms;
+}
+
+void
+NegroniGPUSurfaceForCPU(NegroniSurface * s, uint64_t offset, uint64_t length)
+{
+	IOMemoryDescriptor * md = s != NULL ? s->memory : NULL;
+	uint64_t end;
+
+	if (md == NULL || length == 0) {
+		return;
+	}
+	if (s->slot >= 0) {
+		/* a display slot (0234): not XNU's memory, so not through the physical aperture */
+		uintptr_t k = s->kernelAddress();
+		if (k != 0 && offset < md->getLength()) {
+			negroni_surface_cache(k + offset, MIN(length, md->getLength() - offset), kNegroniCacheFlush);
+		}
+		return;
+	}
+	end = MIN(round_page_64(offset + length), (uint64_t)md->getLength());
+	for (uint64_t at = trunc_page_64(offset); at < end; at += PAGE_SIZE) {
+		IOByteCount segment = 0;
+		uint64_t pa = md->getPhysicalSegment((IOByteCount)at, &segment, kIOMemoryMapperNone);
+		if (pa != 0 && (pa & PAGE_MASK) == 0) {
+			cachePage(pa);
+		}
+	}
+}
+#endif /* NEGRONI */
