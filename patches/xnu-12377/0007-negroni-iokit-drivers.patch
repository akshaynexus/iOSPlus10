+unsigned negroni_spmi_ppids(uint16_t *ppids, uint8_t *owners, unsigned max);
+int negroni_spmi_bcl_monitor_on(void);                                  /* 0278 */
+/* bsd/dev/negroni_batt_store.c (0278) */
+int negroni_batt_store_load(int32_t *soc_centi, uint64_t *wall_s);
+void negroni_batt_store_save(int32_t soc_centi);
+/* bsd/dev/negroni_charge.c (0377): what the charge-only mode shows and watches */
+void negroni_charge_batt_update(int percent, int percent_known, int external, int charging, unsigned usb_mv,
+    int vbus_measured);
+void negroni_charge_batt_plug(int external, unsigned usb_mv, int vbus_measured);
+}
+#include <sys/errno.h>
+
+/*
+ * Patch 0276 (the percentage and the plug latency; README-battery.md section 10). CurrentCapacity comes
+ * from the best source in this order: the external gauge over I2C (not reachable: its bus belongs to
+ * the ADSP, no node in the HLOS DT), the charger PD's SoC over GLINK when patch 0274 is in the tree
+ * and fresh ("src=glink", shown as it is), else the OCV estimate ("src=ocv"): IR-compensated
+ * terminal voltage, one-conversion outliers rejected, filtered, then the table; the shown value moves
+ * at most 1 % per 30 s toward it, never down while the filtered current charges, never up while it
+ * discharges, both ways at rest. The first value is the first sample's table value (the boot load
+ * makes it read low by 1-3 %; it stays until the pack reaches that value or the phone rests
+ * (|I| < 50 mA); under a discharge current the value cannot rise). Nothing is kept across boots (a reboot
+ * restarts the estimate: the 12 % -> 9 % of 2026-10-26 was that). The timer now ticks every
+ * NB_FAST_MS (negronibatt_fast, default 1000 ms; 0 = off): a tick reads only the plug state (VBUS
+ * through the VADC in modes 4/5, else the BCL current direction) and on a change publishes
+ * ExternalConnected/IsCharging at once and runs the full read; the full read keeps its 20 s period.
+ */
+#if __has_include("../../../bsd/dev/negroni_chg_glink.h")
+#include "../../../bsd/dev/negroni_chg_glink.h"   /* 0274, when present */
+#define NB_HAVE_GLINK 1
+#else
+#define NB_HAVE_GLINK 0
+#endif
+
+#define NB_DESIGN_MAH      5000    /* DT qcom,batt_capacity_mah = 0x1388 (1S equivalent of the 2S pack) */
+#define NB_POLL_MS         20000
+#define NB_FAST_MS         1000    /* 0276: plug-state tick (negronibatt_fast) */
+#define NB_R_MOHM          80      /* IR compensation (estimate) */
+#define NB_IR_MAX_MV       150
+#define NB_EXT_MV          4000    /* VBUS above this: charger present */
+#define NB_POWER_OFF_MV    3300    /* DT qcom,vbatt_power_off */
+#define NB_TAPER_MV        4300    /* charge current below NB_FULL_MA above this: full */
+#define NB_FULL_MA         150
+#define NB_CUR_MA          50      /* |current| above this: charging / discharging */
+
+enum { NB_OFF = 0, NB_READONLY = 1, NB_RO_DIAG = 2, NB_STATIC = 3, NB_VADC = 4, NB_VADC_DIAG = 5 };
+enum { NB_SRC_STATIC = 0, NB_SRC_BCL = 1, NB_SRC_VADC = 2 };
+static const char *const kSrcName[] = { "static", "PM8350B BCL", "PMK8350 VADC" };
+/* 0276: where the percentage comes from */
+enum { NB_SOC_NONE = 0, NB_SOC_OCV = 1, NB_SOC_GLINK = 2, NB_SOC_GAUGE = 3 };
+static const char *const kSocSrcName[] = { "none", "ocv", "glink", "gauge" };
+#define NB_SOC_RATE_S      30      /* the shown value moves at most 1 % per this many seconds (OCV source) */
+#define NB_OCV_OUTLIER_MV  250     /* a conversion this far from the filtered voltage is one bad sample (seen: 2742 mV once) */
+#define NB_REST_MA         100     /* |current| below this: the sample is near the open-circuit voltage */
+#define NB_GLINK_FRESH_NS  180000000000ull /* the PD's SoC counts for 3 minutes after its last good read */
+#define NB_STORE_TRUST     1500    /* 0278: a saved value more than 15 % from the OCV estimate is not used */
+#define NB_STORE_TRIES     15      /* 0278: polls (20 s) to wait for the root file system */
+#define NB_STORE_MIN_NS    60000000000ull  /* 0278: at most one save a minute */
+#define NB_BATT_T_AGE_MS   60000   /* 0278: the PD's cell temperature counts for 60 s */
+
+/*
+ * Patch 0365: the charging state and speed the iOS battery UI reads (README-battery.md section 13).
+ * Readers in the 20H392 cache: "IsCharging"/"ExternalConnected"/"FullyCharged"/"AdapterDetails" in
+ * UIKitCore and SpringBoard (status bar bolt, UIDevice.batteryState, the chime on the plug edge),
+ * "Is Charging"/"AdapterDetails" in BatteryCenter (lock screen "Charging", widget, through powerd's
+ * IOPS dictionaries), "InstantAmperage"/"AppleRawCurrentCapacity" in Powerlog (Settings > Battery).
+ * IsCharging means "the charger feeds the battery path" (as on Apple's PMUs and the charger PD's
+ * POWER_SUPPLY_STATUS_CHARGING), not "the net current is positive": under a load larger than the input
+ * the bolt stays and the percentage falls (Amperage < 0).
+ *  (a) No charger PD (no ADSP): external = VBUS >= NB_EXT_MV (VADC); charging = external, not full, and
+ *      the charger input current (VADC iin) >= NB_IIN_MA or the filtered battery current > NB_CUR_MA;
+ *      without iin: the filtered current is not a clear discharge (> -NB_CUR_MA); without any current:
+ *      percent < 100. Speed: AdapterDetails AdapterVoltage = VBUS, Current = iin, Watts = VBUS x iin,
+ *      FamilyCode kIOPSFamilyCodeUSBUnknown (the type is the PD's to know).
+ *  (b) Charger PD up (0274, fresh): charging = PD BATT_STATUS 1, full = 4 (HakiOS hakios.battery.cpp
+ *      report()); AdapterDetails from USB_VOLT_NOW x USB_CURR_NOW and FamilyCode from USB_ADAP_TYPE
+ *      (the HakiOS table, family_code(), APSL 2.0; HVDCP as a dedicated charger); InstantAmperage from
+ *      the PD's BATT_CURR_NOW with its sign taken from BATT_STATUS (the convention is learnt once).
+ * Amperage = the filtered current (+ = into the battery), InstantAmperage = this poll's. AvgTimeToFull
+ * (minutes) = the missing charge / the filtered charge current while it is > NB_CUR_MA, AvgTimeToEmpty =
+ * the charge left / the filtered discharge current on battery; TimeRemaining is the one that applies;
+ * 0xffff = unknown (linear estimate, no CV taper modelled [I]).
+ */
+#define NB_IIN_MA          100     /* 0365: charger input current above this: the charger is active */
+#define NB_PLOG_POLLS      3       /* 0365: the "charge:" line at least every 3 full reads (60 s) while plugged */
+#define NB_TAPER_MA        100     /* 0365: at >= 99 % a net current between -NB_CUR_MA and this: full (charge taper) */
+#define NB_PD_VOTES        3       /* 0365: agreeing polls before the PD current sign is taken */
+
+/* PM8350B BCL (SID 3 0x4700), downstream bcl_pmic5.c */
+#define BCL_SID            3u
+#define BCL_BASE           0x4700u
+#define BCL_MONITOR_EN     0x46u
+#define BCL_VBAT_CONV_REQ  0x72u
+#define BCL_VBAT_READ      0x76u
+#define BCL_IBAT_READ      0x86u
+#define BCL_VBAT_UV        49827   /* BCL_VBAT_SCALING_UV */
+#define BCL_VBAT_NONE      0x7f    /* BCL_VBAT_NO_READING */
+#define BCL_IBAT_UA        78127   /* BCL_IBAT_SCALING_UA x range factor 10 / (1000 x 10) */
+#define BCL_READS          8
+
+/*
+ * PM8350B SMB5 charger (SID 3, blocks CHGR 0x1000 .. MISC 0x1600; patch 0272). Register layout of
+ * the SMB5 family (downstream smb5-reg.h, PM8150B/PM7250B; bergamota's SMB2 notes agree on these
+ * offsets). The PM8350B charger is owned by the ADSP charger PD on OxygenOS; without the ADSP its
+ * registers keep what XBL/ABL left. The step of the current registers is CHG_STEP_MA (50 mA on
+ * PM8150B; boot-arg negronichg_step changes it) [inference for PM8350B].
+ * 0273: ICL_STATUS, AICL_ICL_STATUS and POWER_PATH_STATUS are DCDC (0x1100) registers on SMB5
+ * (smb5-reg.h DCDC_BASE + 0x07/0x08/0x0b); 0272 had the SMB2 (PMI8998) MISC offsets 0x1607/0x1608/0x160b.
+ * The input limit uses the SMB5 HC mode of smblib_icl_override(SW_OVERRIDE_HC_MODE): USBIN_MODE_CHG = 1,
+ * CMD_ICL_OVERRIDE bit 0 = 0, ICL_OVERRIDE_AFTER_APSD = 1 (0272 set CMD_ICL_OVERRIDE = 1, the USB51 mode bit).
+ */
+#define CHG_SID            3u
+#define CHG_STATUS1        0x1006u  /* [2:0] 0 inhibit 1 trickle 2 pre 3 fast 4 taper 5 term 6 pause 7 disabled */
+#define CHG_STATUS2        0x1007u
+#define CHG_ENABLE_CMD     0x1042u  /* [0] charging enabled */
+#define CHG_FCC_CFG        0x1061u
+#define CHG_FV_CFG         0x1070u
+#define CHG_APSD_STATUS    0x1307u
+#define CHG_APSD_RESULT    0x1308u  /* [0] SDP [1] OCP [2] CDP [3] DCP [4] float [5] QC2 [6] QC3 */
+#define CHG_USBIN_RT_STS   0x1310u  /* [4] USBIN plugged in */
+#define CHG_USBIN_CMD_IL   0x1340u  /* [0] USBIN suspend */
+#define CHG_USBIN_CMD_ICL_OVERRIDE 0x1342u  /* [0] take USBIN_CURRENT_LIMIT_CFG now (SMB5) */
+#define CHG_USBIN_LOAD_CFG 0x1365u  /* [4] ICL override after APSD */
+#define CHG_USBIN_ICL_OPT  0x1366u  /* [0] USBIN_MODE_CHG: the CFG register sets the limit */
+#define CHG_USBIN_ICL_CFG  0x1370u  /* input current limit, CHG_STEP_MA per LSB */
+#define CHG_USBIN_AICL_OPT 0x1380u  /* [2] AICL enabled */
+#define CHG_TYPEC_SNK_STS  0x1506u  /* detected source Rp */
+#define CHG_TYPEC_MISC_STS 0x150bu  /* [0] CC attached */
+#define CHG_ICL_STATUS     0x1107u  /* DCDC ICL_STATUS: the limit in force, CHG_STEP_MA per LSB (0273) */
+#define CHG_AICL_ICL_STS   0x1108u  /* DCDC AICL_ICL_STATUS (0273) */
+#define CHG_POWER_PATH_STS 0x110bu  /* DCDC POWER_PATH_STATUS: [6] USBIN suspended [4] using USBIN (0273) */
+#define CHG_STEP_MA        50u
+#define CHG_DEFAULT_MA     500u     /* DT qcom,input_current_usb_ma = 500 (SDP) */
+#define CHG_TRIES          5
+static const char *const kChgState[] = { "inhibit", "trickle", "precharge", "fast", "taper", "terminated", "pause", "disabled" };
+
+/* One ADC7 channel: virtual channel = sid << 8 | channel (as in the DT). */
