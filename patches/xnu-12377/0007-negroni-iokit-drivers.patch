+void
+AppleARMBacklight::step(void)
+{
+	uint64_t now = mach_absolute_time();
+
+	IOInterruptState is = IOSimpleLockLockDisableInterrupt(fState);
+	bool on = fDisplayOn, edge = fPowerEdge;
+	fPowerEdge = false;
+	uint32_t fadeMs = fOffFadeMs;
+	uint64_t onAt = fOnAt;
+	uint32_t to = fTarget, from = fFadeFrom, lit = fLastLit;
+	uint64_t t = now - fFadeStart, period = fFadePeriod;
+	IOSimpleLockUnlockEnableInterrupt(fState, is);
+
+	if (fReinit) {
+		fReinit = false;
+		if (on && !edge) {
+			reinitPanel();          /* 0293: ESD: the panel answered a wrong power mode twice */
+		}
+	}
+	if (edge && !on) {
+		/* The framebuffer's fade is done: DBV 0, then the panel's off-command. */
+		apply(0, true);
+		const char *dcs = "skipped";
+		if (fSleepMode >= 1 && fPanelOn && negroni_dsi != NULL && !negroni_dsi_dead) {
+			uint8_t c = 0x28;               /* set_display_off (mdss-dsi-off-command: wait 0x15 = 21 ms) */
+			int rc = negroni_dsi_dcs_write(&c, 1, fLP);
+			IOSleep(NEGRONI_BL_OFF_WAIT_MS);
+			c = 0x10;                       /* enter_sleep_mode (wait 0x65 = 101 ms; the panel stops TE) */
+			int rc2 = negroni_dsi_dcs_write(&c, 1, fLP);
+			IOSleep(NEGRONI_BL_SLEEP_IN_WAIT_MS);
+			fPanelOn = false;               /* wake always sends 0x11 + 0x29 (harmless if awake) */
+			dcs = rc == 0 && rc2 == 0 ? "ok" : "failed";
+		}
+		IOLog("NEGRONI FB: display off (fade %u ms, DCS sleep %s)\n", fadeMs, dcs);
+	}
+	if (!on) {
+		return;
+	}
+	const char *wake = NULL;
+	char wakeInfo[192];
+	wakeInfo[0] = 0;
+	if (edge) {
+		wake = "skipped";
+		if (!fPanelOn) {
+			wake = wakePanel(wakeInfo, sizeof(wakeInfo));
+		}
+	}
+	uint32_t level = to;
+	bool more = false;
+	if (period != 0 && t < period) {
+		level = (uint32_t)((int64_t)from + ((int64_t)to - (int64_t)from) * (int64_t)t / (int64_t)period);
+		more = true;
+	}
+	if (edge) {
+		/* Wake: the level from before the display went off, until iOS sets a new one. */
+		level = to != 0 ? to : lit;
+		more = false;
+	}
+	if (level != 0 && fCurve) {
+		level = (uint32_t)((uint64_t)level * level / fMax);
+		if (level == 0) {
+			level = 1;
+		}
+	}
+	apply(level, !more);
+	if (wake != NULL) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time() - onAt, &ns);
+		IOLog("NEGRONI FB: display on (%s%ssleep-out %u ms, DCS %s, panel DBV %u)\n", wakeInfo,
+		    wakeInfo[0] != 0 ? "; " : "", (uint32_t)(ns / NSEC_PER_MSEC), wake, level);
+	}
+	if (more) {
+		fTimer->setTimeoutMS(NEGRONI_BL_STEP_MS);
+	}
+}
