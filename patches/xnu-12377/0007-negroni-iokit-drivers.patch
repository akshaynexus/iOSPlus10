+bool
+NegroniBattery::init(OSDictionary *dictionary)
+{
+	/* IOCatalogue calls init(dictionary). This XNU's IOPMPowerSource only
+	 * overrides init(void): explicitly run it to allocate its PS dictionary
+	 * and symbols, then copy the matching personality into the registry. */
+	if (!IOPMPowerSource::init()) {
+		return false;
+	}
+	fLoop = NULL;
+	fTimer = NULL;
+	fTimerAdded = fRunning = fReal = fVadc = fDiag = fHaveSoc = fCensusDone = false;
+	fExternal = fIbatSeen = fNoDataLogged = false;
+	fChgWrite = false;
+	fChgMa = CHG_DEFAULT_MA;
+	fChgStep = CHG_STEP_MA;
+	fChgTries = 0;
+	fChgKey = 0xffffffffu;
+	fPolls = 0;
+	fChgForce = 0;
+	fChgSt1 = fChgIclSts = fChgPowerPath = 0xff;
+	fMode = NB_READONLY;
+	fSoc = 0;
+	fOcvMv = fCurAvg = fSocTarget = 0;
+	fSocSrc = NB_SOC_NONE;
+	fOutliers = 0;
+	fSocLogKey = -1;
+	fFastMs = NB_FAST_MS;
+	(void)PE_parse_boot_argn("negronibatt_fast", &fFastMs, sizeof(fFastMs));
+	if (fFastMs && fFastMs < 250) {
+		fFastMs = 250;
+	}
+	if (fFastMs > NB_POLL_MS) {
+		fFastMs = NB_POLL_MS;
+	}
+	fTicks = 0;
+	fFastNs = 0;
+	fDarkMs = 5000;
+	(void)PE_parse_boot_argn("negronibatt_dark_ms", &fDarkMs, sizeof(fDarkMs));
+	if (fDarkMs > NB_POLL_MS) {
+		fDarkMs = NB_POLL_MS;
+	}
+	fStoreDone = false;
+	fStoreTries = 0;
+	fLastSavedSoc = -1;
+	fLastSaveNs = 0;
+	fLastNs = 0;
+	fLowPolls = fFailPolls = 0;
+	fLastPercent = -1;
+	fLastFlags = -1;
+	fGlinkIcl = -1;
+	fGlinkWarned = false;
+	fRtCount = 0;
+	fAvgMa = INT32_MIN;        /* 0365 */
+	fAdMv = fAdMa = fAdFamily = 0;
+	fAdSrc = "vadc";
+	fTtf = fTte = 0xffff;
+	fPdSign = 0;
+	fPdVote = 0;
+	fPdVotes = 0;
+	fCsExternal = false;
+	fPlugNs = 0;
+	fGlinkGen = 0;
+	fGlinkBst = -1;
+	fChgLogKey = -1;
+	fChgLogPolls = 0;
+	fWhy[0] = 0;
+	if (dictionary) {
+		OSCollectionIterator *it = OSCollectionIterator::withCollection(dictionary);
+		if (!it) {
+			return false;
+		}
+		OSObject *object;
+		bool ok = true;
+		while ((object = it->getNextObject())) {
+			const OSSymbol *key = OSDynamicCast(OSSymbol, object);
+			if (!key || !setProperty(key, dictionary->getObject(key))) {
+				ok = false;
+				break;
+			}
+		}
+		it->release();
+		if (!ok) {
+			return false;
+		}
+	}
+	return true;
+}
