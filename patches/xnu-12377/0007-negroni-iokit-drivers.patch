+#define IOHIDSYSTEM_CONFORMSTO	kIOHIDSystemClass
+
+enum {
+    kIOHIDEventNotification     = 0,
+};
+#define kIOHIDCurrentShmemVersion           4
+#define kIOHIDLastCompatibleShmemVersion    3
