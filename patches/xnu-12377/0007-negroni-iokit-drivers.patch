diff --git a/iokit/Kernel/arm/hid/IOGraphicsTypes.h b/iokit/Kernel/arm/hid/IOGraphicsTypes.h
new file mode 100644
index 0000000..fc8aa5d
--- /dev/null
+++ b/iokit/Kernel/arm/hid/IOGraphicsTypes.h
@@ -0,0 +1,22 @@
+/*
+ * NEGRONI: the two IOGraphics types the HID headers use (IOGraphicsFamily
+ * is not part of xnu). Layouts as in IOKit/graphics/IOGraphicsTypes.h.
+ */
+#ifndef _IOKIT_IOGRAPHICSTYPES_H
+#define _IOKIT_IOGRAPHICSTYPES_H
+
+#include <IOKit/IOTypes.h>
+
+typedef struct IOGPoint {
+	SInt16 x;
+	SInt16 y;
+} IOGPoint;
+
+typedef struct IOGBounds {
+	SInt16 minx;
+	SInt16 maxx;
+	SInt16 miny;
+	SInt16 maxy;
+} IOGBounds;
+
+#endif /* _IOKIT_IOGRAPHICSTYPES_H */
diff --git a/iokit/Kernel/arm/hid/IOHIDDebug.h b/iokit/Kernel/arm/hid/IOHIDDebug.h
new file mode 100644
index 0000000..add8bdb
--- /dev/null
+++ b/iokit/Kernel/arm/hid/IOHIDDebug.h
@@ -0,0 +1,31 @@
+//
+//  IOHIDDebug.h
+//  IOHIDFamily
+//
+//  Created by YG on 10/5/15.
+//
+//
+
+#ifndef IOHIDDebug_h
+#define IOHIDDebug_h
+
+#include <IOKit/IOLib.h>
+
+/*
+ * NEGRONI: HID logging goes to the kernel console (and so the persistent
+ * log) instead of os_log, so the HID path is visible in boot logs.
+ */
+#define HIDLog(fmt, ...)        IOLog("HID: " fmt "\n", ##__VA_ARGS__)
+#define HIDLogError(fmt, ...)   IOLog("HID error: " fmt "\n", ##__VA_ARGS__)
+#define HIDLogDebug(fmt, ...)   do { } while (0)
+#define HIDLogInfo(fmt, ...)    do { } while (0)
+#define HIDLogFault(fmt, ...)   IOLog("HID fault: " fmt "\n", ##__VA_ARGS__)
+
+#define HIDServiceLogFault(fmt, ...)   HIDLogFault("%s:0x%llx " fmt, getName(), getRegistryEntryID(), ##__VA_ARGS__)
+#define HIDServiceLogError(fmt, ...)   HIDLogError("%s:0x%llx " fmt, getName(), getRegistryEntryID(), ##__VA_ARGS__)
+#define HIDServiceLog(fmt, ...)        HIDLog("%s:0x%llx " fmt, getName(), getRegistryEntryID(), ##__VA_ARGS__)
+#define HIDServiceLogInfo(fmt, ...)    do { } while (0)
+#define HIDServiceLogDebug(fmt, ...)   do { } while (0)
+
+#endif /* IOHIDDebug_h */
+
