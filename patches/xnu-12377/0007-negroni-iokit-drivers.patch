+void
+NegroniBattery::putNumber(const char *key, UInt32 value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	OSNumber *number = OSNumber::withNumber(value, 32);
+	if (symbol && number) {
+		setPSProperty(symbol, number);
+	}
+	OSSafeReleaseNULL(number);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+NegroniBattery::putBool(const char *key, bool value)
+{
+	putObject(key, value ? kOSBooleanTrue : kOSBooleanFalse);
+}
+
+void
+NegroniBattery::putObject(const char *key, OSObject *value)
+{
+	const OSSymbol *symbol = OSSymbol::withCString(key);
+	if (symbol && value) {
+		setPSProperty(symbol, value);
+	}
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+NegroniBattery::putString(const char *key, const char *value)
+{
+	OSString *s = OSString::withCString(value);
+	putObject(key, s);
+	OSSafeReleaseNULL(s);
+}
+
+static OSDictionary *
+nb_numbers(const char *const *keys, const UInt32 *values, unsigned count)
+{
+	OSDictionary *d = OSDictionary::withCapacity(count + 1);
+	for (unsigned i = 0; d && i < count; ++i) {
+		OSNumber *n = OSNumber::withNumber(values[i], 32);
+		if (n) {
+			d->setObject(keys[i], n);
+			n->release();
+		}
+	}
+	return d;
+}
+
+void
+NegroniBattery::publish(unsigned percent, unsigned mv, int ma, int centiC, bool external,
+    bool charging, bool full, int source, unsigned usbMv, int iinMa)
+{
+	const unsigned mah = (NB_DESIGN_MAH * percent + 50u) / 100u;
+	const bool measured = source != NB_SRC_STATIC;
+	/*
+	 * 0377 (review F1/F2): the charge-only mode's snapshot. A measured read gives its external state, "measured"
+	 * only when it came from this read's VADC USBIN value; the PD path (static source with the PD's SoC) gives
+	 * the PD's usb_online as a guess (only "present" counts); the static placeholder (100 %, external) gives
+	 * neither a percent nor a plug state (-1).
+	 */
+	if (measured) {
+		negroni_charge_batt_update((int)percent, 1, external, charging, usbMv, fVbusMeasured ? 1 : 0);
+	} else if (fSocSrc == NB_SOC_GLINK) {
+		negroni_charge_batt_update((int)percent, 1, external, charging, usbMv, 0);
+	} else {
+		negroni_charge_batt_update(-1, 0, -1, charging, usbMv, 0);
+	}
+	setBatteryInstalled(true);
+	setCurrentCapacity(percent);
+	setMaxCapacity(100);
+	setExternalConnected(external);
+	setExternalChargeCapable(external);
+	setIsCharging(charging);
+	setAtWarnLevel(false);
+	/* An estimated SOC must not assert a critical shutdown. */
+	setAtCriticalLevel(false);
+	setVoltage(mv);
+	/* 0365: Amperage = the filtered current, InstantAmperage = this poll's (both + = charging) */
+	setAmperage(fAvgMa != INT32_MIN ? fAvgMa : ma);
+	/* 0365: minutes to full while charging, to empty on battery; 65535 = unknown; never zero minutes */
+	setTimeRemaining(charging ? fTtf : !external ? fTte : 0xffff);
+	setCycleCount(0);         /* unknown without the gauge */
+	putBool("FullyCharged", full);
+	putBool("built-in", true);
+	putBool("AppleRawExternalConnected", external);
+	putNumber("AppleRawCurrentCapacity", mah);
+	putNumber("AppleRawMaxCapacity", NB_DESIGN_MAH);
+	putNumber("AppleRawBatteryVoltage", mv);
+	putNumber("NominalChargeCapacity", NB_DESIGN_MAH);
+	putNumber("DesignCapacity", NB_DESIGN_MAH);
+	putNumber("DesignCycleCount9C", 500);
+	putNumber("InstantAmperage", (UInt32)ma);
+	putNumber("Temperature", (UInt32)centiC);  /* hundredths of a degree C */
+	putNumber("AvgTimeToEmpty", external ? 0xffff : fTte);     /* 0365 */
+	putNumber("AvgTimeToFull", charging ? fTtf : 0xffff);
+	{
+		unsigned ite = 0xffff;
+		if (!external && ma < -NB_CUR_MA) {
+			uint64_t m = (uint64_t)mah * 60u / (unsigned)(-ma);
+			ite = m < 1 ? 1 : m > 0xfffe ? 0xfffe : (unsigned)m;
+		}
+		putNumber("InstantTimeToEmpty", ite);
+	}
+	putNumber("PermanentFailureStatus", 0);
+	putNumber("BatteryCellDisconnectCount", 0);
+	putBool("CapacityEstimated", fSocSrc != NB_SOC_GLINK && fSocSrc != NB_SOC_GAUGE);
+	putBool("NegroniBatteryHardwareSampleValid", measured);
+	putBool("NegroniBatterySOCEstimated", fSocSrc != NB_SOC_GLINK && fSocSrc != NB_SOC_GAUGE);
+	putString("NegroniBatterySOCSource", kSocSrcName[fSocSrc]);
+	putNumber("NegroniBatteryOCVMillivolts", (UInt32)fOcvMv);
+	putNumber("NegroniBatterySOCTarget", (UInt32)fSocTarget);
+	putBool("NegroniBatteryFallback", !measured);
+	putString("NegroniBatterySource", kSrcName[source]);
+	putNumber("NegroniBatteryPercent", percent);
+	putNumber("NegroniBatteryUSBInMillivolts", usbMv);
+	{
+		/* thermalmonitord/powerd read "BatteryData" (bergamota: "batteryData NULL" otherwise) */
+		static const char *const k[] = {"CycleCount", "DesignCapacity", "StateOfCharge", "Voltage",
+			                        "MaxCapacity", "NominalChargeCapacity", "Flags", "ResScale"};
+		const UInt32 v[] = {0, NB_DESIGN_MAH, percent, mv, NB_DESIGN_MAH, NB_DESIGN_MAH, 0, 1};
+		OSDictionary *d = nb_numbers(k, v, 8);
+		putObject("BatteryData", d);
+		OSSafeReleaseNULL(d);
+	}
+	{
+		/* AdapterDetails: FamilyCode 0 = disconnected; 0xe0004007 = kIOPSFamilyCodeUSBUnknown */
+		OSDictionary *d;
+		if (external) {
+			/* 0365: the measured adapter (chargeState(): VADC VBUS x iin, or the charger PD's USB values) */
+			int cur = fAdMa > 0 ? (int)fAdMa : iinMa > 0 ? iinMa : 500;
+			unsigned volt = fAdMv ? fAdMv : usbMv ? usbMv : 5000;
+			UInt32 family = fAdFamily ? fAdFamily : 0xe0004007u;
+			static const char *const k[] = {kIOPMPSAdapterDetailsVoltage, kIOPMPSAdapterDetailsAmperageKey,
+				                        kIOPMPSAdapterDetailsWattsKey, kIOPMPSAdapterDetailsSourceIDKey,
+				                        kIOPMPSAdapterDetailsFamilyKey};
+			const UInt32 v[] = {volt, (UInt32)cur, (UInt32)(((uint64_t)volt * (unsigned)cur + 500000) / 1000000),
+				            0, family};
+			d = nb_numbers(k, v, 5);
+			if (d) {
+				d->setObject("IsWireless", kOSBooleanFalse);
+				OSString *s = OSString::withCString("usb");
+				if (s) {
+					d->setObject(kIOPMPSAdapterDetailsDescriptionKey, s);
+					s->release();
+				}
+			}
+		} else {
+			static const char *const k[] = {kIOPMPSAdapterDetailsFamilyKey};
+			const UInt32 v[] = {0};
+			d = nb_numbers(k, v, 1);
+		}
+		putObject(kIOPMPSAdapterDetailsKey, d);
+		OSSafeReleaseNULL(d);
+	}
+
+	/* IOPMCopyBatteryInfo's per-source compatibility dictionary. */
+	{
+		static const char *const k[] = {kIOBatteryCurrentChargeKey, kIOBatteryCapacityKey,
+			                        kIOBatteryVoltageKey, kIOBatteryAmperageKey, kIOBatteryCycleCountKey,
+			                        kIOBatteryFlagsKey};
+		const UInt32 v[] = {mah, NB_DESIGN_MAH, mv, (UInt32)ma, 0,
+			            (UInt32)(kIOBatteryInstalled | (external ? kIOBatteryChargerConnect : 0) |
+			            (charging ? kIOBatteryCharge : 0))};
+		OSDictionary *legacy = nb_numbers(k, v, 6);
+		if (legacy) {
+			setLegacyIOBatteryInfo(legacy);
+			legacy->release();
+		}
+	}
+	updateStatus(); /* Flush PS properties and send kIOPMMessageBatteryStatusHasChanged on change. */
+
+	int flags = (external ? 1 : 0) | (charging ? 2 : 0) | (full ? 4 : 0) | (source << 3) | ((fGlinkIcl >= 0) << 6);
+	if ((int)percent != fLastPercent || flags != fLastFlags) {
+		/* 0273: usbin is a VADC value (negronibatt=4/5); without the VADC it is not measured ("-") */
+		char usb[16];
+		if (fVadc) {
+			snprintf(usb, sizeof(usb), "%umV", usbMv);
+		} else {
+			snprintf(usb, sizeof(usb), "-");
+		}
+		IOLog("NEGRONI BATTERY: %u%% %umV %dmA %d.%02dC external=%d charging=%d full=%d source=%s usbin=%s "
+		    "chg=%s icl=%umA pp=%02x\n",
+		    percent, mv, ma, centiC / 100, (centiC < 0 ? -centiC : centiC) % 100,
+		    external, charging, full, kSrcName[source], usb,
+		    /* 0274: chg=glink icl=<the PD's USB_INPUT_CURR_LIMIT read back> once the PD answers */
+		    fGlinkIcl >= 0 ? "glink" : fChgSt1 == 0xff ? "?" : kChgState[fChgSt1 & 7],
+		    fGlinkIcl >= 0 ? (unsigned)fGlinkIcl : fChgIclSts == 0xff ? 0 : fChgIclSts * fChgStep, fChgPowerPath);
+		fLastPercent = (int)percent;
+		fLastFlags = flags;
+	}
+}
+
+/*
+ * 0365: iOS's name for the charger (IOPSKeysPrivate.h kIOPSFamilyCode*) from the PD's USB_ADAP_TYPE
+ * (Linux POWER_SUPPLY_USB_TYPE_*). The table of HakiOS hakios.battery.cpp family_code() (APSL 2.0);
+ * QTI HVDCP (0x80..0x82, oplus_battery_sm8450.h:302) and BrickID as a dedicated charger.
+ */
+static unsigned
+nb_family_code(int32_t usbType)
+{
+	switch (usbType) {
+	case 1: return 0xe0004000u;     /* SDP, a computer's port: kIOPSFamilyCodeUSBHost */
+	case 2: case 9: case 0x80: case 0x81: case 0x82:
+		return 0xe0004004u;     /* DCP (and BrickID, HVDCP): kIOPSFamilyCodeUSBChargingPortDedicated */
+	case 3: return 0xe0004005u;     /* CDP: kIOPSFamilyCodeUSBChargingPortDownstream */
+	case 5: return 0xe0004009u;     /* USB-C current: kIOPSFamilyCodeUSBCTypeC */
+	case 6: case 7: case 8: return 0xe000400au;     /* USB PD: kIOPSFamilyCodeUSBCPD */
+	default: return 0xe0004007u;    /* kIOPSFamilyCodeUSBUnknown */
+	}
+}
+
+/*
+ * 0365: IsCharging / FullyCharged, the adapter and the times (the comment at NB_IIN_MA). glinkBstatus is
+ * the fresh PD BATT_STATUS (1..4) or -1. instMa: InstantAmperage (+ = charging), in/out.
+ */
+void
+NegroniBattery::chargeState(const nb_sample &s, bool external, bool curKnown, int32_t cur, unsigned percent,
+    int32_t glinkBstatus, bool &charging, bool &full, int &instMa)
+{
+	(void)cur;                      /* instMa already holds it */
+	fAdMv = s.usbOk ? s.usbMv : 0;
+	fAdMa = s.iinOk && s.iinMa > 0 ? (unsigned)s.iinMa : 0;
+	fAdFamily = 0xe0004007u;
+	fAdSrc = "vadc";
+	fAvgMa = curKnown ? fCurAvg : INT32_MIN;
+	uint64_t nowAbs, nowNs;
+	clock_get_uptime(&nowAbs);
+	absolutetime_to_nanoseconds(nowAbs, &nowNs);
+	if (external != fCsExternal) {
+		fCsExternal = external;
+		fPlugNs = nowNs;        /* review C2: the PD status must be newer than this edge */
+	}
+	bool pd = glinkBstatus >= 1 && glinkBstatus <= 4;
+	bool pdStale = false;
+#if NB_HAVE_GLINK
+	negroni_chg_glink_status g;
+	if (pd && negroni_chg_glink_get(&g) && g.up && g.ready && g.soc_ns <= fPlugNs) {
+		pd = false;             /* read before the plug edge: the VADC rule until the next PD cycle */
+		pdStale = true;
+	}
+	if (pd && negroni_chg_glink_get(&g) && g.up && g.ready) {
+		if (g.usb_mv > 0) {
+			fAdMv = (unsigned)g.usb_mv;
+		}
+		if (g.usb_ma != INT32_MIN && g.usb_ma > 0) {
+			fAdMa = (unsigned)g.usb_ma;
+		}
+		fAdFamily = nb_family_code(g.usb_type);
+		fAdSrc = "pd";
+		if (g.ibat_ma != INT32_MIN && g.ibat_ma != 0) {
+			/*
+			 * Learn the PD's sign (review C1: "charging" can come with a net discharge under a load above the
+			 * input, so BATT_STATUS 1 does not name it). A vote: status 2 on battery (the current leaves the
+			 * pack), or the AP's own filtered current (BCL, + = charging) when both are above 50 mA; the sign
+			 * is taken after NB_PD_VOTES agreeing polls in a row.
+			 */
+			int vote = 0;
+			const bool big = g.ibat_ma > NB_CUR_MA || g.ibat_ma < -NB_CUR_MA;
+			if (big && glinkBstatus == 2 && !external) {
+				vote = g.ibat_ma > 0 ? -1 : 1;
+			} else if (big && curKnown && (fCurAvg > NB_CUR_MA || fCurAvg < -NB_CUR_MA)) {
+				vote = (g.ibat_ma > 0) == (fCurAvg > 0) ? 1 : -1;
+			}
+			if (fPdSign == 0 && vote != 0) {
+				fPdVotes = vote == fPdVote ? fPdVotes + 1 : 1;
+				fPdVote = vote;
+				if (fPdVotes >= NB_PD_VOTES) {
+					fPdSign = vote;
+					IOLog("NEGRONI BATTERY: charge: the charger PD's BATT_CURR_NOW is %s while charging (%u polls agree; "
+					    "last: status %d, PD %d mA, AP avg %d mA)\n", fPdSign > 0 ? "positive" : "negative", fPdVotes,
+					    glinkBstatus, g.ibat_ma, curKnown ? fCurAvg : 0);
+				}
+			}
+			if (fPdSign != 0) {
+				instMa = g.ibat_ma * fPdSign;
+			}
+		}
+	}
+#endif
+	if (pd) {
+		full = glinkBstatus == 4 || (fSoc >= 10000 && glinkBstatus != 1);
+		charging = external && glinkBstatus == 1 && !full;
+		snprintf(fWhy, sizeof(fWhy), "pd status %d", glinkBstatus);
+	} else {
+		full = external && fSoc >= 10000 && (!curKnown || fCurAvg < NB_FULL_MA);
+		/* review C5: at >= 99 % with the input on and the net current near zero the charge has tapered: full,
+		 * so the OCV estimate cannot show "charging" for ever; a clear discharge (a load) is not a taper */
+		if (external && !full && fSoc >= 9900 &&
+		    (!curKnown || (fCurAvg > -NB_CUR_MA && fCurAvg < NB_TAPER_MA))) {
+			full = true;
+		}
+		if (!external) {
+			charging = false;
+			snprintf(fWhy, sizeof(fWhy), "no VBUS");
+		} else if (full) {
+			charging = false;
+			snprintf(fWhy, sizeof(fWhy), "full");
+		} else if (s.iinOk) {
+			charging = s.iinMa >= NB_IIN_MA || (curKnown && fCurAvg > NB_CUR_MA);
+			snprintf(fWhy, sizeof(fWhy), "%siin %d mA avg %d mA", pdStale ? "pd stale, " : "", s.iinMa,
+			    curKnown ? fCurAvg : 0);
+		} else if (curKnown) {
+			charging = fCurAvg > -NB_CUR_MA;
+			snprintf(fWhy, sizeof(fWhy), "avg %d mA (no iin)", fCurAvg);
+		} else {
+			charging = percent < 100;
+			snprintf(fWhy, sizeof(fWhy), "no current reading");
+		}
+	}
+	/* times: linear in the filtered current [I] */
+	const int32_t avg = curKnown ? fCurAvg : 0;
+	const uint32_t haveMah = (uint32_t)((uint64_t)NB_DESIGN_MAH * (uint32_t)(fSoc < 0 ? 0 : fSoc) / 10000u);
+	const uint32_t missMah = NB_DESIGN_MAH > haveMah ? NB_DESIGN_MAH - haveMah : 0;
+	fTtf = fTte = 0xffff;
+	if (charging && avg > NB_CUR_MA) {
+		uint64_t m = (uint64_t)missMah * 60u / (uint32_t)avg;
+		fTtf = m < 1 ? 1 : m > 0xfffe ? 0xfffe : (unsigned)m;
+	}
+	if (!external && avg < -NB_CUR_MA) {
+		uint64_t m = (uint64_t)haveMah * 60u / (uint32_t)(-avg);
+		fTte = m < 1 ? 1 : m > 0xfffe ? 0xfffe : (unsigned)m;
+	}
+	const uint64_t mw = (uint64_t)fAdMv * fAdMa / 1000u;
+	putNumber("NegroniChargeInputMilliwatts", external ? (UInt32)mw : 0);
+	putNumber("NegroniChargeFamilyCode", external ? fAdFamily : 0);
+	putString("NegroniChargeSource", pd ? "pd" : "vadc");
+	putString("NegroniChargeReason", fWhy);
+	/* one line on a change, else every NB_PLOG_POLLS full reads while plugged */
+	int key = (external ? 1 : 0) | (charging ? 2 : 0) | (full ? 4 : 0) | (pd ? 8 : 0);
+	fChgLogPolls++;
+	if (key != fChgLogKey || (external && fChgLogPolls >= NB_PLOG_POLLS)) {
+		fChgLogKey = key;
+		fChgLogPolls = 0;
+		IOLog("NEGRONI BATTERY: charge: %u%% external=%d charging=%d full=%d (%s) | adapter %umV %umA %u.%02uW family 0x%x (%s) | "
+		    "battery inst %dmA avg %s%dmA | to full %u min to empty %u min\n",
+		    percent, external, charging, full, fWhy, external ? fAdMv : 0, external ? fAdMa : 0,
+		    external ? (unsigned)(mw / 1000) : 0, external ? (unsigned)(mw % 1000 / 10) : 0,
+		    external ? fAdFamily : 0, fAdSrc, instMa, curKnown ? "" : "?", avg, fTtf, fTte);
+	}
+}
+
+/* 0274: the charger PD state (bsd/dev/negroni_chg_glink.c) into fGlinkIcl and the registry. */
+void
+NegroniBattery::glinkStatus(void)
+{
+	negroni_chg_glink_status g;
+	if (!negroni_chg_glink_get(&g)) {
+		fGlinkIcl = -1;
+		if (!fGlinkWarned) {
+			unsigned want = 0;
+			(void)PE_parse_boot_argn("negronichg_glink", &want, sizeof(want));
+			if (want) {
+				IOLog("NEGRONI BATTERY: negronichg_glink=1 needs negroniadsp=1 (the ADSP runs the charger PD): off\n");
+			}
+			fGlinkWarned = true;
+		}
+		return;
+	}
+	bool ready = g.up && g.ready;
+	fGlinkIcl = (ready && g.icl_ma >= 0) ? g.icl_ma : -1;
+	putBool("NegroniChargerGlinkReady", ready);
+	putNumber("NegroniChargerGlinkIclMa", (UInt32)(g.icl_ma < 0 ? 0 : g.icl_ma));
+	putNumber("NegroniChargerGlinkSOC", (UInt32)(g.soc_centi < 0 ? 0xffffffffu : (UInt32)g.soc_centi));  /* 1/100 % */
+	putNumber("NegroniChargerGlinkStatus", (UInt32)g.bstatus);
+	putNumber("NegroniChargerGlinkVbusMv", (UInt32)(g.usb_mv < 0 ? 0 : g.usb_mv));
+	putBool("NegroniChargerGlinkChargeEnable", g.chg_en_set);
+}
+
+/* One ADC7 conversion, as Linux adc7_configure + adc7_do_conversion. 0 = ok. Needs the VADC unlock. */
+int
+NegroniBattery::adcCode(const nb_chan &c, uint16_t *code)
+{
+	uint8_t v, b[4], status = 0, lo, hi;
+	if (negroni_spmi_read(0, ADC_BASE + ADC_APP_SID, &v) ||
+	    negroni_spmi_write(0, ADC_BASE + ADC_APP_SID, (uint8_t)((v & ~0x0fu) | (c.sid & 0x0fu)))) {
+		return -1;
+	}
+	for (unsigned i = 0; i < 4; ++i) {
+		if (negroni_spmi_read(0, ADC_BASE + ADC_DIG_PARAM + i, &b[i])) {
+			return -1;
+		}
+	}
+	/* timer calibration (0), cal_sel ratiometric 1 / absolute 2, decimation 2 (ADC5_DECIMATION_DEFAULT) */
+	b[0] = (uint8_t)((b[0] & ~0x7cu) | ((c.ratiometric ? 1u : 2u) << 4) | (2u << 2));
+	b[1] = (uint8_t)(b[1] & ~0x07u);                  /* 1 sample */
+	b[2] = c.chan;
+	b[3] = (uint8_t)((b[3] & ~0x0fu) | (c.settle & 0x0fu));
+	for (unsigned i = 0; i < 4; ++i) {
+		if (negroni_spmi_write(0, ADC_BASE + ADC_DIG_PARAM + i, b[i])) {
+			return -1;
+		}
+	}
+	if (negroni_spmi_write(0, ADC_BASE + ADC_CONV_REQ, 0x80)) {
+		return -1;
+	}
+	/* Linux waits up to 10 ms for the end-of-conversion interrupt; poll EOC for up to 20 ms. */
+	IODelay(300);
+	for (unsigned i = 0; i < 200; ++i) {
+		if (negroni_spmi_read(0, ADC_BASE + ADC_STATUS1, &status)) {
+			return -1;
+		}
+		if ((status & 0x03u) == 0x01u) {
+			break;
+		}
+		IODelay(100);
+	}
+	if (status & 0x80u) {
+		return -2;                                        /* CONV_FAULT */
+	}
+	if ((status & 0x03u) != 0x01u) {
+		return -4;                                        /* no end of conversion */
+	}
+	if (negroni_spmi_read(0, ADC_BASE + ADC_DATA0, &lo) || negroni_spmi_read(0, ADC_BASE + ADC_DATA0 + 1, &hi)) {
+		return -1;
+	}
+	*code = (uint16_t)(lo | (hi << 8));
+	return *code == 0x8000 ? -3 : 0;                      /* ADC5_USR_DATA_CHECK */
+}
+
+/* Absolute channel: the pre-scaled quantity in micro-units (uV, or uA for the current channels). */
+bool
+NegroniBattery::adcMicro(const nb_chan &c, int64_t *value)
+{
+	uint16_t code;
+	if (adcCode(c, &code)) {
+		return false;
+	}
+	int64_t uv = code > 0x7fff ? 0 : (int64_t)code * 1875 * 1000 / ADC_FULL_SCALE;
+	*value = uv * c.den / c.num;
+	return true;
+}
+
+/* Ratiometric 100 k NTC channel -> hundredths of a degree C (Linux qcom_vadc7_scale_hw_calib_therm). */
+bool
+NegroniBattery::adcTemp(const nb_chan &c, int *centiC)
+{
+	uint16_t code;
+	if (adcCode(c, &code) || code == 0 || code >= ADC_RATIO_MAX) {
+		return false;
+	}
+	int64_t r = (int64_t)code * 100000 / (ADC_RATIO_MAX - code);
+	const unsigned n = sizeof(kNtc) / sizeof(kNtc[0]);
+	if (r >= kNtc[0].r || r <= kNtc[n - 1].r) {
+		return false;                                     /* outside -20..82 C: not trusted */
+	}
+	for (unsigned i = 1; i < n; ++i) {
+		if (r > kNtc[i].r) {
+			int64_t t = kNtc[i - 1].t + (kNtc[i].t - kNtc[i - 1].t) * (kNtc[i - 1].r - r) /
+			    (kNtc[i - 1].r - kNtc[i].r);
+			*centiC = (int)(t / 10);
+			return true;
+		}
+	}
+	return false;
+}
+
+int32_t
+NegroniBattery::socFromOcv(int32_t mv)
+{
+	const unsigned n = sizeof(kOcv) / sizeof(kOcv[0]);
+	if (mv <= kOcv[0].mv) {
+		return 0;
+	}
+	for (unsigned i = 1; i < n; ++i) {
+		if (mv < kOcv[i].mv) {
+			return kOcv[i - 1].soc + (mv - kOcv[i - 1].mv) * (kOcv[i].soc - kOcv[i - 1].soc) /
+			       (kOcv[i].mv - kOcv[i - 1].mv);
+		}
+	}
+	return 10000;
+}
+
+/*
+ * PM8350B BCL VBAT/IBAT: reads only, BCL_READS samples each, 1 ms apart (the work loop thread
+ * sleeps). The values are used only when the monitor is on (MONITOR_EN bit 7: Linux sets it at
+ * probe; 0278 sets it once at start when it reads off); with the monitor off they go to the raw log line only.
+ * IBAT 0 means "no new reading" (bcl_read_ibat keeps the last value), so it is averaged over the
+ * non-zero samples.
+ */
+void
+NegroniBattery::readBcl(nb_sample &s)
+{
+	if (negroni_spmi_read(BCL_SID, BCL_BASE + BCL_MONITOR_EN, &s.bclMon) ||
+	    negroni_spmi_read(BCL_SID, BCL_BASE + BCL_VBAT_CONV_REQ, &s.bclConv)) {
+		return;
+	}
+	s.bclRead = true;
+	s.bclOn = (s.bclMon & 0x80u) != 0;
+	int32_t vsum = 0, isum = 0;
+	unsigned vn = 0, in = 0, nonzero = 0;
+	for (unsigned i = 0; i < BCL_READS; ++i) {
+		uint8_t v;
+		if (s.bclConv && !negroni_spmi_read(BCL_SID, BCL_BASE + BCL_VBAT_READ, &v) && v != BCL_VBAT_NONE && v != 0) {
+			vsum += v;
+			vn++;
+		}
+		if (!negroni_spmi_read(BCL_SID, BCL_BASE + BCL_IBAT_READ, &v)) {
+			in++;
+			if (v != 0) {
+				isum += (int8_t)v;   /* two's complement (bcl_read_ibat sign_extend32(val, 7)) */
+				nonzero++;
+			}
+		}
+		IOSleep(1);
+	}
+	if (vn >= BCL_READS / 2) {
+		int32_t mv = (int32_t)((int64_t)vsum * BCL_VBAT_UV / ((int64_t)vn * 1000));
+		if (mv > 5000) {
+			mv /= 2;              /* the pack, not the 1S side: 2S (DT qcom,vbatt_num 2) [inference] */
+			s.bclPack = true;
+		}
+		s.bclVbatMv = mv;
+		s.bclVbatN = vn;
+		s.bclVbatOk = s.bclOn && mv >= 2500 && mv <= 4700;
+	}
+	if (in >= BCL_READS / 2) {
+		/* + = discharge in the BCL; IOPMPowerSource wants + = charging */
+		s.bclIbatMa = nonzero ? -(int32_t)((int64_t)isum * BCL_IBAT_UA / ((int64_t)nonzero * 1000)) : 0;
+		s.bclIbatNonzero = nonzero;
+		s.bclIbatOk = s.bclOn;
+	}
+}
+
+/* PMK8350 VADC conversions (negronibatt=4/5 only; the writes are unlocked in start). */
+void
+NegroniBattery::readVadc(nb_sample &s)
+{
+	int64_t sum = 0, v;
+	unsigned good = 0;
+	for (unsigned i = 0; i < 4; ++i) {
+		if (adcMicro(kVbat, &v)) {
+			sum += v;
+			good++;
+		}
+	}
+	if (good) {
+		s.adcVbatMv = (int32_t)(sum / good / 1000);
+		s.adcVbatN = good;
+		s.adcVbatOk = s.adcVbatMv >= 2500 && s.adcVbatMv <= 4700;
+	}
+	int64_t usbUv = 0, ichgUa = 0, iinUa = 0;
+	s.usbOk = adcMicro(kUsbIn, &usbUv);
+	s.ichgOk = adcMicro(kIchg, &ichgUa);
+	s.iinOk = adcMicro(kIin, &iinUa);
+	s.tempOk = adcTemp(kSkin, &s.centiC);
+	s.xoOk = adcTemp(kXo, &s.xoC);                          /* 0278 */
+	if (s.tempOk) {
+		negroni_pwr_temp_set(NEGRONI_PWR_T_SKIN, s.centiC);
+	}
+	if (s.xoOk) {
+		negroni_pwr_temp_set(NEGRONI_PWR_T_XO, s.xoC);
+	}
+	s.usbMv = s.usbOk ? (unsigned)(usbUv / 1000) : 0;
+	s.ichgMa = s.ichgOk ? (int32_t)(ichgUa / 1000) : 0;
+	s.iinMa = s.iinOk ? (int32_t)(iinUa / 1000) : 0;
+}
+
+/*
+ * negronibatt=2/5, once: every SID 3 (PM8350B) peripheral of the APID map. Only SID 3: no other
+ * kernel user reads a SID 3 APID (the keys read SID 1 GPIO 0x18d on their own thread).
+ */
+void
+NegroniBattery::census(void)
+{
+	static uint16_t ppids[1024];
+	static uint8_t owners[1024];
+	unsigned n = negroni_spmi_ppids(ppids, owners, 1024);
+	char line[200];
+	int m = 0;
+	unsigned shown = 0;
+	IOLog("NEGRONI BATTERY: census: %u APIDs on bus 0 (ppid type/subtype rt_sts owner)\n", n);
+	for (unsigned i = 0; i < n; ++i) {
+		unsigned sid = ppids[i] >> 8;
+		if (sid != 3) {
+			continue;
+		}
+		uint8_t type = 0xff, sub = 0xff, rt = 0xff;
+		unsigned base = (ppids[i] & 0xffu) << 8;
+		(void)negroni_spmi_read(sid, base + 0x04, &type);
+		(void)negroni_spmi_read(sid, base + 0x05, &sub);
+		(void)negroni_spmi_read(sid, base + 0x10, &rt);
+		if (sid == 3 && fRtCount < NB_RT_MAX) {
+			fRtPpid[fRtCount] = ppids[i];
+			fRtLast[fRtCount] = rt;
+			fRtCount++;
+		}
+		m += snprintf(line + m, sizeof(line) - (size_t)m, " %03x %02x/%02x %02x e%u", ppids[i], type, sub, rt, owners[i]);
+		if (++shown % 7 == 0 || m > (int)sizeof(line) - 28) {
+			IOLog("NEGRONI BATTERY: census%s\n", line);
+			m = 0;
+		}
+	}
+	if (m) {
+		IOLog("NEGRONI BATTERY: census%s\n", line);
+	}
+}
+
+/* negronibatt=2/5, each poll: a line for each PM8350B peripheral whose INT_RT_STS changed (plug a cable to find VBUS). */
+void
+NegroniBattery::rtChanges(void)
+{
+	for (unsigned i = 0; i < fRtCount; ++i) {
+		uint8_t rt;
+		unsigned base = (fRtPpid[i] & 0xffu) << 8;
+		if (negroni_spmi_read(3, base + 0x10, &rt) || rt == fRtLast[i]) {
+			continue;
+		}
+		IOLog("NEGRONI BATTERY: rt_sts %03x (0x%04x+0x10): 0x%02x -> 0x%02x\n", fRtPpid[i], base, fRtLast[i], rt);
+		fRtLast[i] = rt;
+	}
+}
+
+/* 0272: the SMB5 charger registers, read only. s.chgRead only when every register was read. */
+void
+NegroniBattery::readCharger(nb_sample &s)
+{
+	struct { unsigned addr; uint8_t *out; } regs[] = {
+		{ CHG_STATUS1, &s.st1 }, { CHG_STATUS2, &s.st2 }, { CHG_ENABLE_CMD, &s.chgEn }, { CHG_FCC_CFG, &s.fcc },
+		{ CHG_FV_CFG, &s.fv }, { CHG_APSD_STATUS, &s.apsdSt }, { CHG_APSD_RESULT, &s.apsdRes },
+		{ CHG_USBIN_RT_STS, &s.usbRt }, { CHG_USBIN_CMD_IL, &s.cmdIl }, { CHG_USBIN_LOAD_CFG, &s.loadCfg },
+		{ CHG_USBIN_ICL_OPT, &s.iclOpt }, { CHG_USBIN_ICL_CFG, &s.iclCfg }, { CHG_USBIN_AICL_OPT, &s.aiclOpt },
+		{ CHG_TYPEC_SNK_STS, &s.typecSnk }, { CHG_TYPEC_MISC_STS, &s.typecMisc }, { CHG_ICL_STATUS, &s.iclSts },
+		{ CHG_AICL_ICL_STS, &s.aiclSts }, { CHG_POWER_PATH_STS, &s.powerPath },
+		{ CHG_USBIN_CMD_ICL_OVERRIDE, &s.iclOverride },
+	};
+	unsigned ok = 0;
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); ++i) {
+		if (negroni_spmi_read(CHG_SID, regs[i].addr, regs[i].out) == 0) {
+			ok++;
+		}
+	}
+	s.chgRead = ok == sizeof(regs) / sizeof(regs[0]);
+	if (!s.chgRead) {
+		/* Diagnostics every poll while the charger does not read (the boot-time lines are not on the USB
+		 * console): the APID and owner of each SMB5 block, the result code of 8 reads, the SID 3 PPID map. */
+		static const char *const why[] = { "ok", "timeout", "arbiter-error", "not-allowed", "no-APID", "poisoned",
+			                           "debug-closed" };
+		char line[400];
+		size_t at = 0;
+		at += snprintf(line + at, sizeof(line) - at, "charger diag (%u of %u read, %s arbiter): APIDs", ok,
+		    (unsigned)(sizeof(regs) / sizeof(regs[0])), fChgRoute == 1 ? "debug" : "normal");
+		for (unsigned per = 0x10; per <= 0x16 && at < sizeof(line) - 24; per++) {
+			unsigned owner = 7;
+			int apid = negroni_spmi_apid(CHG_SID, per, &owner);
+			at += snprintf(line + at, sizeof(line) - at, " %02x:%d/EE%u", per, apid, owner);
+		}
+		at += snprintf(line + at, sizeof(line) - at, " | reads");
+		static const unsigned probe[] = { CHG_STATUS1, CHG_ENABLE_CMD, 0x1004, 0x1005, CHG_USBIN_RT_STS,
+			                          CHG_USBIN_CMD_IL, CHG_USBIN_ICL_CFG, CHG_ICL_STATUS };
+		for (unsigned i = 0; i < sizeof(probe) / sizeof(probe[0]) && at < sizeof(line) - 32; i++) {
+			uint8_t v = 0xff;
+			int rc = negroni_spmi_read_rc(CHG_SID, probe[i], &v);
+			if (rc == 0) {
+				at += snprintf(line + at, sizeof(line) - at, " %04x=%02x", probe[i], v);
+			} else {
+				at += snprintf(line + at, sizeof(line) - at, " %04x:%s", probe[i], rc >= 0 && rc <= 6 ? why[rc] : "?");
+			}
+		}
+		IOLog("NEGRONI BATTERY: %s\n", line);
+		if (fPolls % 3 == 1) {
+			uint16_t ppids[256];
+			uint8_t owners[256];
+			unsigned n = negroni_spmi_ppids(ppids, owners, 256);
+			at = 0;
+			at += snprintf(line + at, sizeof(line) - at, "SID 3 PPIDs in the APID map (%u total):", n);
+			for (unsigned i = 0; i < n && at < sizeof(line) - 12; i++) {
+				if ((ppids[i] >> 8) == CHG_SID) {
+					at += snprintf(line + at, sizeof(line) - at, " %02x/EE%u", ppids[i] & 0xff, owners[i]);
+				}
+			}
+			IOLog("NEGRONI BATTERY: %s\n", line);
+		}
+		return;
+	}
+	fChgSt1 = s.st1;
+	fChgIclSts = s.iclSts;
+	fChgPowerPath = s.powerPath;
+	uint32_t key = (uint32_t)s.st1 | (uint32_t)s.usbRt << 8 | (uint32_t)s.cmdIl << 16 | (uint32_t)s.iclSts << 24;
+	if (key != fChgKey || fDiag) {
+		fChgKey = key;
+		IOLog("NEGRONI BATTERY: charger %s%s%s (%s arbiter): st1 %02x st2 %02x en %02x fcc %02x fv %02x apsd %02x/%02x "
+		    "usb_rt %02x cmd_il %02x icl_ovr %02x load %02x icl_opt %02x icl_cfg %02x (%u mA) aicl %02x typec %02x/%02x | "
+		    "icl_sts %02x (%u mA) aicl_sts %02x (%u mA) power_path %02x\n",
+		    kChgState[s.st1 & 7], (s.usbRt & 0x10) ? ", USBIN plugged" : ", USBIN unplugged",
+		    ((s.cmdIl & 1) || (s.powerPath & 0x40)) ? ", USBIN SUSPENDED" : "", fChgRoute == 1 ? "debug" : "normal",
+		    s.st1, s.st2, s.chgEn, s.fcc, s.fv, s.apsdSt, s.apsdRes, s.usbRt, s.cmdIl, s.iclOverride, s.loadCfg, s.iclOpt,
+		    s.iclCfg, s.iclCfg * fChgStep, s.aiclOpt, s.typecSnk, s.typecMisc, s.iclSts, s.iclSts * fChgStep, s.aiclSts,
+		    s.aiclSts * fChgStep, s.powerPath);
+	}
+}
+
+int
+NegroniBattery::chgWrite(unsigned addr, uint8_t value, const char *what)
+{
+	int rc = negroni_spmi_write(CHG_SID, addr, value);
+	IOLog("NEGRONI BATTERY: charger write %s: %#x = 0x%02x %s\n", what, addr, value, rc ? "FAILED" : "ok");
+	return rc;
+}
+
+/*
+ * 0272: with a cable in, make the charger take USB input at negronichg_ma (default 500 mA; 0 = read only):
+ * the downstream smblib_set_icl_current() order (limit, USBIN_MODE_CHG, ICL override, un-suspend), then
+ * charging enabled. Only registers whose value differs are written; at most CHG_TRIES polls per plug.
+ */
+void
+NegroniBattery::driveCharger(nb_sample &s)
+{
+	if (!(s.usbRt & 0x10)) {
+		fChgTries = 0;          /* unplugged: nothing to do, the next plug gets new tries */
+		return;
+	}
+	unsigned wantRaw = fChgMa / fChgStep;
+	if (wantRaw > 255) {
+		wantRaw = 255;
+	}
+	bool suspended = (s.cmdIl & 1) || (s.powerPath & 0x40);
+	bool chgOff = !(s.chgEn & 1);
+	bool limitWrong = s.iclCfg != wantRaw || !(s.iclOpt & 1) || !(s.loadCfg & 0x10) || (s.iclOverride & 1);
+	if (!suspended && !chgOff && !limitWrong) {
+		return;
+	}
+	if (fChgTries >= CHG_TRIES) {
+		return;
+	}
+	fChgTries++;
+	IOLog("NEGRONI BATTERY: charger set (try %u): want %u mA (raw %u, %u mA/LSB)%s%s%s\n", fChgTries, fChgMa, wantRaw,
+	    fChgStep, suspended ? ", un-suspend" : "", chgOff ? ", enable charging" : "", limitWrong ? ", input limit" : "");
+	if (s.iclCfg != wantRaw) {
+		chgWrite(CHG_USBIN_ICL_CFG, (uint8_t)wantRaw, "USBIN_CURRENT_LIMIT_CFG");
+	}
+	if (!(s.iclOpt & 1)) {
+		chgWrite(CHG_USBIN_ICL_OPT, s.iclOpt | 1, "USBIN_ICL_OPTIONS mode_chg");
+	}
+	if (!(s.loadCfg & 0x10)) {
+		chgWrite(CHG_USBIN_LOAD_CFG, s.loadCfg | 0x10, "USBIN_LOAD_CFG icl_override_after_apsd");
+	}
+	if (s.iclOverride & 1) {
+		/* 0273: HC mode = CMD_ICL_OVERRIDE bit 0 clear (smblib_icl_override SW_OVERRIDE_HC_MODE) */
+		chgWrite(CHG_USBIN_CMD_ICL_OVERRIDE, s.iclOverride & ~1u, "USBIN_CMD_ICL_OVERRIDE clear (HC mode)");
+	}
+	if (s.cmdIl & 1) {
+		chgWrite(CHG_USBIN_CMD_IL, s.cmdIl & ~1u, "USBIN_CMD_IL un-suspend");
+	}
+	if (chgOff) {
+		chgWrite(CHG_ENABLE_CMD, s.chgEn | 1, "CHARGING_ENABLE_CMD");
+	}
+	IOSleep(50);
+	uint8_t a = 0xff, b = 0xff, c = 0xff, d = 0xff, e = 0xff, f = 0xff;
+	(void)negroni_spmi_read(CHG_SID, CHG_USBIN_ICL_CFG, &a);
+	(void)negroni_spmi_read(CHG_SID, CHG_USBIN_CMD_IL, &b);
+	(void)negroni_spmi_read(CHG_SID, CHG_ICL_STATUS, &c);
+	(void)negroni_spmi_read(CHG_SID, CHG_POWER_PATH_STS, &d);
+	(void)negroni_spmi_read(CHG_SID, CHG_AICL_ICL_STS, &e);
+	(void)negroni_spmi_read(CHG_SID, CHG_ENABLE_CMD, &f);
+	IOLog("NEGRONI BATTERY: charger after set: icl_cfg %02x cmd_il %02x en %02x icl_sts %02x (%u mA) aicl_sts %02x (%u mA) "
+	    "power_path %02x\n", a, b, f, c, c == 0xff ? 0 : c * fChgStep, e, e == 0xff ? 0 : e * fChgStep, d);
+	fChgKey = 0xffffffffu;     /* the next poll logs the new state */
+}
+
+void
+NegroniBattery::poll(void)
+{
+	if (!fReal) {
+		publish(100, 4200, 0, 2500, true, false, true, NB_SRC_STATIC, 5000, 0);
+		return;
+	}
+	if (fDiag) {
+		if (!fCensusDone) {
+			fCensusDone = true;
+			census();
+		} else {
+			rtChanges();
+		}
+	}
+	fPolls++;
+	if (fPolls <= 3 || fPolls % 15 == 0) {
+		/* the setup facts again: the USB console attaches after the first poll */
+		unsigned bclOwner = 7, vadcOwner = 7, chgrOwner = 7, usbinOwner = 7;
+		int bclApid = negroni_spmi_apid(BCL_SID, BCL_BASE >> 8, &bclOwner);
+		int vadcApid = negroni_spmi_apid(0, ADC_BASE >> 8, &vadcOwner);
+		int chgrApid = negroni_spmi_apid(CHG_SID, 0x10, &chgrOwner);
+		int usbinApid = negroni_spmi_apid(CHG_SID, 0x13, &usbinOwner);
+		IOLog("NEGRONI BATTERY: setup (poll %u): mode %d, BCL APID %d EE %u, VADC APID %d EE %u (%s), charger CHGR APID %d "
+		    "EE %u USBIN APID %d EE %u, path %s (negronichg_arb=%s, route poll %u), control %s (negronichg_ma=%u step %u "
+		    "force=%u)\n", fPolls, fMode, bclApid, bclOwner,
+		    vadcApid, vadcOwner, fVadc ? "unlocked" : "locked", chgrApid, chgrOwner, usbinApid, usbinOwner,
+		    fChgRoute == 1 ? "debug" : "normal", fChgArb == 0 ? "auto" : fChgArb == 1 ? "normal" : "debug", fChgRoutePoll,
+		    fChgWrite ? "on" : (fChgMa ? "OFF: registers locked" : "off"), fChgMa, fChgStep, fChgForce);
+	}
+	if (fChgArb != 1 && fPolls == fChgRoutePoll) {
+		/* 0273: pick the charger path once the USB console is up (the debug path's first access is logged) */
+		int before = fChgRoute;
+		fChgRoute = negroni_spmi_chg_route(fChgArb, fChgMa > 0, fChgDbgFuse != 0, fChgQdss != 0);
+		if (fChgRoute < 0) {
+			fChgRoute = 0;
+		}
+		if (fChgRoute != before) {
+			fChgWrite = false;      /* a new route locks the writes again; the 5 tries start again */
+		}
+		bool dbgClosed = fChgArb == 2 && fChgRoute != 1;
+		if (dbgClosed) {
+			/* negronichg_arb=debug means debug: no fallback to the normal arbiter for writes */
+			fChgWrite = false;
+			IOLog("NEGRONI BATTERY: charger: debug path closed: control OFF (negronichg_arb=debug)\n");
+		}
+		uint8_t t[4] = { 0xff, 0xff, 0xff, 0xff };
+		int rc[4];
+		static const unsigned tAddr[4] = { 0x1004, 0x1005, 0x1304, 0x1305 };
+		for (unsigned i = 0; i < 4; i++) {
+			rc[i] = negroni_spmi_read_rc(CHG_SID, tAddr[i], &t[i]);
+		}
+		IOLog("NEGRONI BATTERY: charger blocks through the %s arbiter: CHGR type/subtype %02x/%02x (rc %d/%d) USBIN "
+		    "type/subtype %02x/%02x (rc %d/%d)\n", fChgRoute == 1 ? "debug" : "normal", t[0], t[1], rc[0], rc[1], t[2], t[3],
+		    rc[2], rc[3]);
+		if (fChgMa > 0 && !fChgWrite && !dbgClosed) {
+			if (fChgRoute == 1 && fAdsp && !fChgForce) {
+				IOLog("NEGRONI BATTERY: charger control OFF: negroniadsp=%u (the ADSP charger PD may own the charger; "
+				    "negronichg_force=1 writes anyway)\n", fAdsp);
+			} else {
+				fChgWrite = negroni_spmi_chg_unlock(fChgForce != 0);
+				fChgTries = 0;
+			}
+		}
+		IOLog("NEGRONI BATTERY: charger path %s arbiter, control %s\n", fChgRoute == 1 ? "debug" : "normal",
+		    fChgWrite ? "on" : (fChgMa ? "OFF: registers locked" : "off"));
+	}
+	nb_sample s = {};
+	s.centiC = 2500;
+	readBcl(s);
+	if (fVadc) {
+		readVadc(s);
+	}
+	readCharger(s);
+	glinkStatus();
+	if (s.chgRead && fChgWrite) {
+		driveCharger(s);
+	}
+	fIbatSeen = fIbatSeen || (s.bclIbatOk && s.bclIbatNonzero);
+
+	/* Voltage: the VADC if it measured, else the BCL. */
+	int source = s.adcVbatOk ? NB_SRC_VADC : s.bclVbatOk ? NB_SRC_BCL : NB_SRC_STATIC;
+	int32_t vbat = s.adcVbatOk ? s.adcVbatMv : s.bclVbatMv;
+	/* Battery current, + = charging: the BCL IBAT once it gave a non-zero value, else the VADC charge current on VBUS. */
+	bool curKnown = false;
+	int32_t cur = 0;
+	if (s.bclIbatOk && fIbatSeen) {
+		curKnown = true;
+		cur = s.bclIbatMa;
+	} else if (s.usbOk && s.usbMv >= NB_EXT_MV && s.ichgOk) {
+		curKnown = true;
+		cur = s.ichgMa;
+	}
+	/* Charger: the USBIN plug status of the charger (0272); else VBUS when the VADC measures it; else the
+	 * current direction with hysteresis (full on a charger: ~0 mA keeps the state). */
+	/* 0276: VBUS first (the plug tick uses it too; a disagreement would re-run the full read every tick) */
+	fVbusMeasured = s.usbOk;        /* 0377 */
+	if (s.usbOk) {
+		fExternal = s.usbMv >= NB_EXT_MV;
+	} else if (s.chgRead) {
+		fExternal = (s.usbRt & 0x10) != 0;
+	} else if (curKnown) {
+		if (cur >= NB_CUR_MA) {
+			fExternal = true;
+		} else if (cur <= -NB_CUR_MA) {
+			fExternal = false;
+		}
+	} else {
+		fExternal = false;
+	}
+	const bool external = fExternal;
+
+	if (fDiag) {
+		int64_t vph = 0, mid = 0;
+		bool vphOk = fVadc && adcMicro(kVph, &vph), midOk = fVadc && adcMicro(kVbatMid, &mid);
+		IOLog("NEGRONI BATTERY: raw bcl mon %02x conv %02x vbat %s%dmV (%u/%d%s) ibat %s%dmA (%u nonzero) | "
+		    "vadc vbat %s%dmV (%u/4) vph %s%dmV mid2s %s%dmV usbin %s%umV ichg %s%dmA iin %s%dmA skin %s%d xo %s%d | "
+		    "cur %s%d ext %d soc %d\n",
+		    s.bclMon, s.bclConv, s.bclVbatOk ? "" : "?", s.bclVbatMv, s.bclVbatN, BCL_READS, s.bclPack ? " pack/2" : "",
+		    s.bclIbatOk ? "" : "?", s.bclIbatMa, s.bclIbatNonzero,
+		    s.adcVbatOk ? "" : "?", s.adcVbatMv, s.adcVbatN, vphOk ? "" : "?", (int)(vph / 1000), midOk ? "" : "?",
+		    (int)(mid / 1000), s.usbOk ? "" : "?", s.usbMv, s.ichgOk ? "" : "?", s.ichgMa, s.iinOk ? "" : "?", s.iinMa,
+		    s.tempOk ? "" : "?", s.centiC, s.xoOk ? "" : "?", s.xoC, curKnown ? "" : "?", cur, external, fSoc);
+	}
+	if (source == NB_SRC_STATIC) {
+		/* Keep the last estimate; with no estimate yet, the static fallback (the reason after 3 failed polls). */
+		++fFailPolls;
+		if (!fHaveSoc) {
+			if (fFailPolls >= 3 && !fNoDataLogged) {
+				fNoDataLogged = true;
+				IOLog("NEGRONI BATTERY: no battery voltage: BCL %s (MONITOR_EN 0x%02x VBAT_CONV_REQ 0x%02x), VADC %s; "
+				    "static 100%%%s\n", s.bclRead ? "read" : "unreadable", s.bclMon, s.bclConv,
+				    fVadc ? (s.adcVbatN ? "out of range" : "no conversion") : "off",
+				    fVadc ? "" : " (negronibatt=4 measures with the VADC)");
+			}
+#if NB_HAVE_GLINK
+			/* 0276: the charger PD's value serves even without an AP measurement */
+			negroni_chg_glink_status g;
+			if (negroni_chg_glink_get(&g) && g.up && g.ready && g.soc_centi >= 0 && g.soc_centi <= 10000) {
+				fSocSrc = NB_SOC_GLINK;
+				fSoc = g.soc_centi;
+				fHaveSoc = true;
+				int32_t mv = g.vbat_mv > 5000 ? g.vbat_mv / 2 : g.vbat_mv > 0 ? g.vbat_mv : 0;
+				IOLog("NEGRONI BATTERY: soc %d%% src=glink (no AP voltage; PD vbat %d mV status %d)\n",
+				    (fSoc + 50) / 100, g.vbat_mv, g.bstatus);
+				/* 0365 (review C3): the same charging state, adapter and times as the measured path */
+				const bool ext = g.usb_online > 0;
+				const unsigned pct = (unsigned)((fSoc + 50) / 100);
+				bool charging = false, full = false;
+				int instMa = 0;
+				chargeState(s, ext, false, 0, pct, (g.bstatus >= 1 && g.bstatus <= 4) ? g.bstatus : -1, charging, full,
+				    instMa);
+				publish(pct, (unsigned)mv, instMa, 2500, ext, charging, full, NB_SRC_STATIC, s.usbMv, s.iinMa);
+				return;
+			}
+#endif
+			publish(100, 4200, 0, 2500, true, false, true, NB_SRC_STATIC, s.usbMv, s.iinMa);
+		}
+		return;
+	}
+	fFailPolls = 0;
+
+	uint64_t now, ns;
+	clock_get_uptime(&now);
+	absolutetime_to_nanoseconds(now, &ns);
+	int64_t dtS = fLastNs ? (int64_t)((ns - fLastNs) / 1000000000ull) : 0;
+	fLastNs = ns;
+	if (dtS < 0 || dtS > 600) {
+		dtS = NB_POLL_MS / 1000;
+	}
+
+	/* 0276. Open-circuit voltage: the terminal voltage minus I x R (charging raises it, a load lowers it),
+	 * one bad conversion rejected, then filtered (a 50 mV BCL step is 5 % of the curve; the VADC jitters). */
+	int32_t ocvNow = vbat;
+	if (curKnown) {
+		int32_t drop = cur * NB_R_MOHM / 1000;
+		drop = drop > NB_IR_MAX_MV ? NB_IR_MAX_MV : drop < -NB_IR_MAX_MV ? -NB_IR_MAX_MV : drop;
+		ocvNow -= drop;
+	}
+	if (fOcvMv == 0) {
+		fOcvMv = ocvNow;
+	} else {
+		int32_t diff = ocvNow - fOcvMv;
+		if (diff > NB_OCV_OUTLIER_MV || diff < -NB_OCV_OUTLIER_MV) {
+			if (++fOutliers < 3) {
+				ocvNow = fOcvMv;          /* one or two bad samples: keep the filter */
+			} else {
+				fOcvMv = ocvNow;          /* three in a row: the battery really moved */
+				fOutliers = 0;
+			}
+		} else {
+			fOutliers = 0;
+		}
+		/* A sample near rest is trusted more than one under load (the IR constant is an estimate). */
+		const int32_t div = (curKnown && (cur > NB_REST_MA || cur < -NB_REST_MA)) ? 8 : 4;
+		fOcvMv += (ocvNow - fOcvMv) / div;
+	}
+	fCurAvg += ((curKnown ? cur : 0) - fCurAvg) / 4;
+	int32_t target = socFromOcv(fOcvMv);
+	fSocTarget = target;
+	/* The ADSP charger PD (patch 0274, when in the tree) reads the real gauge: its value is the truth. */
+	int32_t glinkSoc = -1, glinkBstatus = -1;
+#if NB_HAVE_GLINK
+	{
+		negroni_chg_glink_status g;
+		if (negroni_chg_glink_get(&g) && g.up && g.ready && g.soc_centi >= 0 && g.soc_centi <= 10000 &&
+		    ns >= g.soc_ns && ns - g.soc_ns < NB_GLINK_FRESH_NS) {
+			glinkSoc = g.soc_centi;
+			glinkBstatus = g.bstatus;
+		}
+	}
+#endif
+	bool full = false;
+	if (glinkSoc >= 0) {
+		if (fSocSrc != NB_SOC_GLINK) {
+			IOLog("NEGRONI BATTERY: soc source glink (the charger PD's gauge value %d.%02d%%; ocv estimate %d.%02d%%)\n",
+			    glinkSoc / 100, glinkSoc % 100, target / 100, target % 100);
+		}
+		fSocSrc = NB_SOC_GLINK;
+		fSoc = glinkSoc;
+		fHaveSoc = true;
+		fStoreDone = true;       /* 0278: the gauge is the truth: no restore */
+	} else if (!fHaveSoc || fSocSrc != NB_SOC_OCV) {
+		if (fSocSrc == NB_SOC_GLINK) {
+			IOLog("NEGRONI BATTERY: soc source ocv (the charger PD's value is stale; kept %d.%02d%%, estimate %d.%02d%%)\n",
+			    fSoc / 100, fSoc % 100, target / 100, target % 100);
+		} else {
+			fSoc = target;           /* first value: the first sample's table value */
+			(void)storeTry(target);  /* 0278: or the saved value, when it is near the estimate */
+		}
+		fSocSrc = NB_SOC_OCV;
+		fHaveSoc = true;
+	} else if (!fStoreDone && storeTry(target)) {
+		/* 0278: the root came up after the first estimate: the saved value replaces it once */
+	} else {
+		/* Toward the table value, at most 1 % per NB_SOC_RATE_S, monotonic with the filtered current:
+		 * the pack cannot gain charge while the net current leaves it, nor lose charge while it enters.
+		 * At rest (|avg| < NB_CUR_MA) both directions are allowed, so a cable that only holds the
+		 * phone (net ~0 mA, seen 2026-10-26) no longer freezes the value. */
+		int32_t next = target;
+		if (fCurAvg >= NB_CUR_MA && next < fSoc) {
+			next = fSoc;
+		}
+		if (fCurAvg <= -NB_CUR_MA && next > fSoc) {
+			next = fSoc;
+		}
+		int32_t step = (int32_t)(dtS * 100 / NB_SOC_RATE_S);
+		if (step < 1) {
+			step = 1;
+		}
+		if (next > fSoc + step) {
+			next = fSoc + step;
+		} else if (next < fSoc - step) {
+			next = fSoc - step;
+		}
+		fSoc = next > 10000 ? 10000 : next < 0 ? 0 : next;
+	}
+	/* Report 0 % only below the DT power-off voltage for 5 polls in a row on battery. */
+	fLowPolls = (!external && vbat < NB_POWER_OFF_MV) ? fLowPolls + 1 : 0;
+	if (fSoc < 100 && fLowPolls < 5) {
+		fSoc = 100;
+	}
+	unsigned percent = (unsigned)((fSoc + 50) / 100);
+	if (percent > 100) {
+		percent = 100;
+	}
+	storeSave(ns);                   /* 0278 */
+	/* Charging: the PD's status when it reports one; else the filtered current (no flicker between
+	 * the +78 mA and 0 mA polls of a cable that only holds the phone). */
+	/* 0365: the charging state, the adapter and the times (chargeState()) */
+	bool charging = false;
+	int instMa = curKnown ? cur : 0;
+	chargeState(s, external, curKnown, cur, percent,
+	    (glinkSoc >= 0 && glinkBstatus >= 1 && glinkBstatus <= 4) ? glinkBstatus : -1, charging, full, instMa);
+	{
+		int key = (int)percent | (fSocSrc << 8) | ((target / 100) << 12);
+		if (key != fSocLogKey) {
+			fSocLogKey = key;
+			IOLog("NEGRONI BATTERY: soc %u%% src=%s ocv=%dmV target=%d.%02d%% avg=%dmA vbat=%dmV cur=%s%d\n",
+			    percent, kSocSrcName[fSocSrc], fOcvMv, target / 100, target % 100, fCurAvg, vbat,
+			    curKnown ? "" : "?", cur);
+		}
+	}
+	/* Skin temperature as the battery's (VADC only); clamped so an outlier cannot stop charging in iOS. */
+	int centiC = s.tempOk ? (s.centiC < 0 ? 0 : s.centiC > 4500 ? 4500 : s.centiC) : 2500;
+	/* 0278: the cell temperature from the charger PD's gauge (GLINK BATT_TEMP) when fresh: a real value, not clamped */
+	int32_t battC = 0;
+	bool tempReal = negroni_pwr_temp_get(NEGRONI_PWR_T_BATT, &battC, NB_BATT_T_AGE_MS) && battC >= -2000 && battC <= 8000;
+	if (tempReal) {
+		centiC = battC;
+	}
+	putBool("NegroniBatteryTemperatureEstimated", !tempReal);
+	putString("NegroniBatteryTemperatureSource", tempReal ? "glink" : s.tempOk ? "skin" : "none");
+	if (s.tempOk) {
+		putNumber("NegroniSkinTemperature", (UInt32)s.centiC);
+	}
+	if (s.xoOk) {
+		putNumber("NegroniXoTemperature", (UInt32)s.xoC);
+	}
+	putBool("NegroniBatteryCurrentValid", curKnown);
+	putNumber("NegroniBatteryChargeCurrent", (UInt32)s.ichgMa);
+	putNumber("NegroniBatteryInputCurrent", (UInt32)s.iinMa);
+	putNumber("NegroniBatteryBCLMonitor", s.bclMon);
+	putBool("NegroniChargerRead", s.chgRead);
+	putNumber("NegroniChargerStatus1", s.st1);
+	putNumber("NegroniChargerUsbinRtSts", s.usbRt);
+	putNumber("NegroniChargerIclMa", s.chgRead ? s.iclSts * fChgStep : 0);
+	putNumber("NegroniChargerPowerPath", s.powerPath);
+	publish(percent, (unsigned)vbat, instMa, centiC, external, charging, full, source, s.usbMv, s.iinMa);
+}
+
+/*
+ * 0278: the saved percentage (bsd/dev/negroni_batt_store.c). True when it replaced fSoc. Tried at the first
+ * OCV estimate and, while the root is not mounted yet (EAGAIN), at the next NB_STORE_TRIES polls.
+ */
+bool
+NegroniBattery::storeTry(int32_t target)
+{
+	int32_t saved = -1;
+	uint64_t wall = 0;
+
+	if (fStoreDone) {
+		return false;
+	}
+	int rc = negroni_batt_store_load(&saved, &wall);
+	if (rc == EAGAIN && ++fStoreTries < NB_STORE_TRIES) {
+		return false;                       /* no root file system yet: the next poll tries again */
+	}
+	fStoreDone = true;
+	if (rc != 0) {
+		IOLog("NEGRONI BATTERY: store: no saved percentage (%s, error %d): the OCV estimate %d.%02d%% stays\n",
+		    rc == ENOENT ? "no file yet" : rc == EAGAIN ? "no root file system" : rc == EINVAL ? "file not understood" : "read error",
+		    rc, target / 100, target % 100);
+		return false;
+	}
+	int32_t diff = saved > target ? saved - target : target - saved;
+	if (diff > NB_STORE_TRUST) {
+		IOLog("NEGRONI BATTERY: store: saved %d.%02d%% (wall %llu) is %d.%02d %% from the OCV estimate %d.%02d%% (> 15 %%): "
+		    "the estimate wins\n", saved / 100, saved % 100, wall, diff / 100, diff % 100, target / 100, target % 100);
+		return false;
+	}
+	IOLog("NEGRONI BATTERY: store: soc restored %d.%02d%% (saved at wall %llu; OCV estimate %d.%02d%%, %d.%02d %% apart)\n",
+	    saved / 100, saved % 100, wall, target / 100, target % 100, diff / 100, diff % 100);
+	fSoc = saved;
+	return true;
+}
+
+/* 0278: queue a save on a 1 % change (the first one at once), at most once a minute; only after the restore decision. */
+void
+NegroniBattery::storeSave(uint64_t ns)
+{
+	if (!fStoreDone || !fHaveSoc) {
+		return;
+	}
+	int32_t d = fLastSavedSoc < 0 ? 10000 : (fSoc > fLastSavedSoc ? fSoc - fLastSavedSoc : fLastSavedSoc - fSoc);
+	if (d < 100 || (fLastSavedSoc >= 0 && ns - fLastSaveNs < NB_STORE_MIN_NS)) {
+		return;
+	}
+	negroni_batt_store_save(fSoc);
+	fLastSavedSoc = fSoc;
+	fLastSaveNs = ns;
+}
+
+/*
+ * 0382 (README-power-idle.md): the plug tick is negronibatt_fast (1 s) with the display on and
+ * negronibatt_dark_ms (default 5000; 0 = as with the display on) while it is asleep: a cable plugged in
+ * with the screen dark is seen within 5 s. The full read stays every NB_POLL_MS.
+ */
+extern "C" int negroni_display_asleep;  /* NegroniFramebuffer.cpp */
+
+unsigned
+NegroniBattery::nextMs(void)
+{
+	unsigned ms = fFastMs ? fFastMs : NB_POLL_MS;
+	if (fFastMs && fDarkMs > ms && __atomic_load_n(&negroni_display_asleep, __ATOMIC_ACQUIRE)) {
+		ms = fDarkMs;
+	}
+	fArmedMs = ms;
+	return ms;
+}
+
+void
+NegroniBattery::timerFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	NegroniBattery *self = OSDynamicCast(NegroniBattery, owner);
+	if (self && self->fRunning) {
+		/* 0276: a full read every NB_POLL_MS; between them the plug-state ticks (negronibatt_fast) */
+		/* 0382: the full read by time (the plug tick is longer while the display is asleep) */
+		self->fTicks += self->fArmedMs;
+		if (!self->fFastMs || self->fTicks >= NB_POLL_MS) {
+			self->fTicks = 0;
+			self->poll();
+		} else {
+			self->fastCheck();
+		}
+		sender->setTimeoutMS(self->nextMs());
+	}
+}
+
+/* 0276: the plug state only, between the full reads: VBUS through the VADC (modes 4/5; one ADC7
+ * conversion), else the BCL current direction (observer reads). On a change the keys the status bar
+ * reads first are published at once, then the full read runs. The charger's own USBIN plug bit
+ * (SMB5 USBIN_INT_RT_STS 0x1310 bit 4) has no APID in the HLOS map (0272/0273), and the SID 3 rt_sts
+ * bits the census watches (0x2710 bit 6) follow the load current, not the cable (logs 2026-10-26). */
+void
+NegroniBattery::fastCheck(void)
+{
+	bool known = false, ext = fExternal;
+	unsigned usbMv = 0;
+	uint64_t now, ns;
+	clock_get_uptime(&now);
+	absolutetime_to_nanoseconds(now, &ns);
+	if (fVadc) {
+		int64_t uv = 0;
+		if (adcMicro(kUsbIn, &uv)) {
+			usbMv = (unsigned)(uv / 1000);
+			ext = usbMv >= NB_EXT_MV;
+			known = true;
+		}
+	} else if (fReal && fIbatSeen) {
+		nb_sample s = {};
+		readBcl(s);
+		if (s.bclIbatOk && s.bclIbatNonzero) {
+			if (s.bclIbatMa >= NB_CUR_MA) {
+				ext = true;
+				known = true;
+			} else if (s.bclIbatMa <= -NB_CUR_MA) {
+				ext = false;
+				known = true;
+			}
+		}
+	}
+	uint64_t sinceMs = fFastNs && ns > fFastNs ? (ns - fFastNs) / 1000000ull : 0;
+	fFastNs = ns;
+	if (known) {
+		negroni_charge_batt_plug(ext, usbMv, fVadc ? 1 : 0);   /* 0377: every tick with a reading */
+	}
+#if NB_HAVE_GLINK
+	/* 0365 (review C2): a new PD cycle with a new BATT_STATUS runs the full read at once (the bolt follows in ~1 s) */
+	if (!known || ext == fExternal) {
+		negroni_chg_glink_status g;
+		if (negroni_chg_glink_get(&g) && g.up && g.ready && g.gen != fGlinkGen) {
+			fGlinkGen = g.gen;
+			if (g.bstatus != fGlinkBst) {
+				int was = fGlinkBst;
+				fGlinkBst = g.bstatus;
+				if (was != -1) {
+					IOLog("NEGRONI BATTERY: charge: PD status %d -> %d: full read now\n", was, g.bstatus);
+					fTicks = 0;
+					poll();
+				}
+			}
+		}
+		return;
+	}
+#endif
+	if (!known || ext == fExternal) {
+		return;
+	}
+	IOLog("NEGRONI BATTERY: external %d->%d (usbin %u mV) after %llu ms\n", fExternal, ext, usbMv,
+	    (unsigned long long)sinceMs);
+	fExternal = ext;
+	setExternalConnected(ext);
+	setExternalChargeCapable(ext);
+	if (!ext) {
+		setIsCharging(false);
+	}
+	putBool("AppleRawExternalConnected", ext);
+	updateStatus();
+	fTicks = 0;
+	poll();
+}
+
+bool
+NegroniBattery::start(IOService *provider)
+{
+	int mode = NB_READONLY;
+	(void)PE_parse_boot_argn("negronibatt", &mode, sizeof(mode));
+	if (mode == NB_OFF) {
+		IOLog("NEGRONI BATTERY: negronibatt=0: no power source\n");
+		return false;
+	}
+	if (!IOPMPowerSource::start(provider)) {
+		return false;
+	}
+	fMode = (mode >= NB_READONLY && mode <= NB_VADC_DIAG) ? mode : NB_READONLY;
+	fDiag = fMode == NB_RO_DIAG || fMode == NB_VADC_DIAG;
+	fReal = fMode != NB_STATIC && negroni_spmi_init() == 0;
+	fVadc = fReal && (fMode == NB_VADC || fMode == NB_VADC_DIAG) && negroni_spmi_vadc_unlock();
+	/* 0272: charger input (negronichg_ma, default 500; 0 = read only; negronichg_step mA/LSB; negronichg_force) */
+	unsigned chgMa = CHG_DEFAULT_MA, chgStep = CHG_STEP_MA, chgForce = 0;
+	(void)PE_parse_boot_argn("negronichg_ma", &chgMa, sizeof(chgMa));
+	(void)PE_parse_boot_argn("negronichg_step", &chgStep, sizeof(chgStep));
+	(void)PE_parse_boot_argn("negronichg_force", &chgForce, sizeof(chgForce));
+	fChgMa = chgMa > 3000 ? 3000 : chgMa;
+	fChgStep = (chgStep == 25 || chgStep == 50) ? chgStep : CHG_STEP_MA;
+	fChgForce = chgForce;
+	/* 0273: negronichg_arb=auto|normal|debug (or 0|1|2), negronichg_route_poll (default 3), negronichg_dbgfuse=0
+	 * (ignore the debug-bus fuse), negronichg_qdss=0 (no QDSS clock vote) */
+	char arb[16] = "auto";
+	unsigned routePoll = 3, dbgFuse = 1, qdss = 1, adsp = 0;
+	(void)PE_parse_boot_arg_str("negronichg_arb", arb, sizeof(arb));
+	(void)PE_parse_boot_argn("negronichg_route_poll", &routePoll, sizeof(routePoll));
+	(void)PE_parse_boot_argn("negronichg_dbgfuse", &dbgFuse, sizeof(dbgFuse));
+	(void)PE_parse_boot_argn("negronichg_qdss", &qdss, sizeof(qdss));
+	(void)PE_parse_boot_argn("negroniadsp", &adsp, sizeof(adsp));
+	fChgArb = (!strcmp(arb, "normal") || !strcmp(arb, "1")) ? 1 : (!strcmp(arb, "debug") || !strcmp(arb, "2")) ? 2 : 0;
+	fChgRoutePoll = routePoll ? routePoll : 1;
+	fChgDbgFuse = dbgFuse;
+	fChgQdss = qdss;
+	fAdsp = adsp;
+	fChgRoute = 0;
+	/* negronichg_arb=debug: no normal-path writes before the route poll either */
+	fChgWrite = fReal && fChgMa > 0 && fChgArb != 2 && negroni_spmi_chg_unlock(chgForce != 0);
+	if (fReal) {
+		IOLog("NEGRONI BATTERY: charger control %s (negronichg_ma=%u, %u mA/LSB, force=%u, negronichg_arb=%s: the path "
+		    "is chosen at poll %u)\n", fChgWrite ? "on" : (fChgMa ? "OFF: registers locked" : "off"), fChgMa, fChgStep,
+		    chgForce, arb, fChgRoutePoll);
+	}
+	if (fReal) {
+		/* 0278: the BCL monitor on when XBL/ABL left it off (bcl_pmic5.c:779); negronibcl_en=0: never written */
+		unsigned bclEn = 1;
+		(void)PE_parse_boot_argn("negronibcl_en", &bclEn, sizeof(bclEn));
+		if (bclEn) {
+			int r = negroni_spmi_bcl_monitor_on();
+			IOLog("NEGRONI BATTERY: BCL monitor: %s\n", r == 0 ? "already on (no write)" : r == 1 ? "switched on" :
+			    "off and not writable");
+		}
+		unsigned owner = 7;
+		int apid = negroni_spmi_apid(BCL_SID, BCL_BASE >> 8, &owner);
+		uint8_t type = 0xff, sub = 0xff, mon = 0xff, conv = 0xff;
+		(void)negroni_spmi_read(BCL_SID, BCL_BASE + 0x04, &type);
+		(void)negroni_spmi_read(BCL_SID, BCL_BASE + 0x05, &sub);
+		(void)negroni_spmi_read(BCL_SID, BCL_BASE + BCL_MONITOR_EN, &mon);
+		(void)negroni_spmi_read(BCL_SID, BCL_BASE + BCL_VBAT_CONV_REQ, &conv);
+		IOLog("NEGRONI BATTERY: negronibatt=%d, %s%s; BCL APID %d EE %u type/subtype %02x/%02x MONITOR_EN %02x "
+		    "VBAT_CONV_REQ %02x\n", fMode, fVadc ? "BCL + VADC" : "read-only BCL",
+		    (fMode == NB_VADC || fMode == NB_VADC_DIAG) && !fVadc ? " (VADC refused)" : "", apid, owner,
+		    type, sub, mon, conv);
+	} else {
+		IOLog("NEGRONI BATTERY: negronibatt=%d, static 100%% (no PMIC access)\n", fMode);
+	}
+	negroni_chg_glink_start();      /* 0274: the charger PD client thread (only with negronichg_glink=1 negroniadsp=1) */
+	/* Publish a complete source BEFORE registerService wakes powerd. */
+	poll();
+	if (fReal) {
+		fLoop = IOWorkLoop::workLoop();
+		fTimer = IOTimerEventSource::timerEventSource(this, &NegroniBattery::timerFired);
+		if (fLoop && fTimer && fLoop->addEventSource(fTimer) == kIOReturnSuccess) {
+			fTimerAdded = true;
+			fRunning = true;
+			fTimer->setTimeoutMS(nextMs());
+		} else {
+			fReal = false;
+			poll();
+			IOLog("NEGRONI BATTERY: timer unavailable; static fallback\n");
+		}
+	}
+	registerService();
+	return true;
+}
+
+void
+NegroniBattery::stop(IOService *provider)
+{
+	if (fLoop && fTimerAdded) {
+		/* Serialize against a running timer callback, including rearming. */
+		(void)fLoop->runAction(&NegroniBattery::stopPolling, this);
+		fLoop->removeEventSource(fTimer);
+		fTimerAdded = false;
+	}
+	IOPMPowerSource::stop(provider);
+}
+
+IOReturn
+NegroniBattery::stopPolling(OSObject *owner, void *, void *, void *, void *)
+{
+	NegroniBattery *self = OSDynamicCast(NegroniBattery, owner);
+	if (!self) {
+		return kIOReturnBadArgument;
+	}
+	self->fRunning = false;
+	self->fTimer->cancelTimeout();
+	self->fTimer->disable();
+	return kIOReturnSuccess;
+}
+
+void
+NegroniBattery::free(void)
+{
+	OSSafeReleaseNULL(fTimer);
+	OSSafeReleaseNULL(fLoop);
+	IOPMPowerSource::free();
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/iokit/Kernel/arm/NegroniEntitlements.cpp b/iokit/Kernel/arm/NegroniEntitlements.cpp
new file mode 100644
index 0000000..61cc02e
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniEntitlements.cpp
@@ -0,0 +1,184 @@
+/*
+ * Entitlements for the NEGRONI built-in AMFI interface (bsd/kern/negroni_amfi.c).
+ *
+ * Apple's AMFI keeps a CoreEntitlements context per code signature; that
+ * library is closed. Here each signature with an XML entitlements blob gets
+ * a NegroniEntitlements object: the blob parsed into an OSDictionary (the
+ * representation IOKit and the kernel KPIs hand out) plus the original XML,
+ * which csops(CS_OPS_ENTITLEMENTS_BLOB) returns. The blob was already
+ * checked against the code directory by csblob_get_entitlements().
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NEGRONI)
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <kern/cs_blobs.h>
+
+class NegroniEntitlements : public OSObject {
+	OSDeclareDefaultStructors(NegroniEntitlements);
+
+public:
+	OSDictionary *dict;
+	CS_GenericBlob *xml;            /* the signature's blob, header included */
+	size_t xml_len;
+
+	bool init(void) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(NegroniEntitlements, OSObject);
+
+bool
+NegroniEntitlements::init(void)
+{
+	return OSObject::init();
+}
+
+void
+NegroniEntitlements::free(void)
+{
+	OSSafeReleaseNULL(dict);
+	if (xml) {
+		kfree_data(xml, xml_len);
+		xml = NULL;
+	}
+	OSObject::free();
+}
+
+static NegroniEntitlements *
+negroni_ent(const void *obj)
+{
+	return OSDynamicCast(NegroniEntitlements, (OSObject *)(uintptr_t)obj);
+}
+
+extern "C" {
+/* Parsed entitlements for one XML blob (header included), or NULL. Retained. */
+void *
+negroni_entitlements_create(const CS_GenericBlob *blob, size_t blob_len)
+{
+	if (blob == NULL || blob_len <= sizeof(CS_GenericBlob) ||
+	    ntohl(blob->magic) != CSMAGIC_EMBEDDED_ENTITLEMENTS ||
+	    ntohl(blob->length) != blob_len) {
+		return NULL;
+	}
+
+	/* OSUnserializeXML needs a terminating NUL inside the buffer. */
+	size_t text_len = blob_len - sizeof(CS_GenericBlob);
+	char *text = (char *)kalloc_data(text_len + 1, Z_WAITOK);
+	if (text == NULL) {
+		return NULL;
+	}
+	memcpy(text, blob->data, text_len);
+	text[text_len] = '\0';
+	OSObject *parsed = OSUnserializeXML(text, text_len + 1);
+	kfree_data(text, text_len + 1);
+
+	OSDictionary *dict = OSDynamicCast(OSDictionary, parsed);
+	if (dict == NULL) {
+		OSSafeReleaseNULL(parsed);
+		return NULL;
+	}
+
+	NegroniEntitlements *ent = OSTypeAlloc(NegroniEntitlements);
+	CS_GenericBlob *xml = (CS_GenericBlob *)kalloc_data(blob_len, Z_WAITOK);
+	if (ent == NULL || !ent->init() || xml == NULL) {
+		OSSafeReleaseNULL(ent);
+		if (xml) {
+			kfree_data(xml, blob_len);
+		}
+		dict->release();
+		return NULL;
+	}
+	memcpy(xml, blob, blob_len);
+	ent->dict = dict;
+	ent->xml = xml;
+	ent->xml_len = blob_len;
+	return ent;
+}
+
+/* The entitlements as an OSDictionary. Retained. */
+void *
+negroni_entitlements_copy_dict(const void *obj)
+{
+	NegroniEntitlements *ent = negroni_ent(obj);
+	if (ent == NULL) {
+		return NULL;
+	}
+	ent->dict->retain();
+	return ent->dict;
+}
+
+/* A kalloc_data copy of the XML blob; the caller frees it (blob length). */
+bool
+negroni_entitlements_copy_xml(const void *obj, CS_GenericBlob **out)
+{
+	NegroniEntitlements *ent = negroni_ent(obj);
+	if (ent == NULL) {
+		return false;
+	}
+	CS_GenericBlob *copy = (CS_GenericBlob *)kalloc_data(ent->xml_len, Z_WAITOK);
+	if (copy == NULL) {
+		return false;
+	}
+	memcpy(copy, ent->xml, ent->xml_len);
+	*out = copy;
+	return true;
+}
+
+/* name is true (a boolean entitlement). */
+bool
+negroni_entitlements_bool(const void *obj, const char *name)
+{
+	NegroniEntitlements *ent = negroni_ent(obj);
+	return ent != NULL && ent->dict->getObject(name) == kOSBooleanTrue;
+}
+
+/* name is the string value, or an array containing it. */
+bool
+negroni_entitlements_string(const void *obj, const char *name, const char *value)
+{
+	NegroniEntitlements *ent = negroni_ent(obj);
+	if (ent == NULL || value == NULL) {
+		return false;
+	}
+	OSObject *v = ent->dict->getObject(name);
+	OSString *s = OSDynamicCast(OSString, v);
+	if (s != NULL) {
+		return s->isEqualTo(value);
+	}
+	OSArray *a = OSDynamicCast(OSArray, v);
+	for (unsigned int i = 0; a != NULL && i < a->getCount(); i++) {
+		s = OSDynamicCast(OSString, a->getObject(i));
+		if (s != NULL && s->isEqualTo(value)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* Number of entitlements. */
+unsigned int
+negroni_entitlements_count(const void *obj)
+{
+	NegroniEntitlements *ent = negroni_ent(obj);
+	return ent != NULL ? ent->dict->getCount() : 0;
+}
+
+/* The value of name, or NULL. Retained. */
+void *
+negroni_entitlements_copy_object(const void *obj, const char *name)
+{
+	NegroniEntitlements *ent = negroni_ent(obj);
+	OSObject *v = ent != NULL ? ent->dict->getObject(name) : NULL;
+	if (v != NULL) {
+		v->retain();
+	}
+	return v;
+}
+}
+#endif /* NEGRONI */
diff --git a/iokit/Kernel/arm/NegroniFramebuffer.cpp b/iokit/Kernel/arm/NegroniFramebuffer.cpp
new file mode 100644
index 0000000..4c98ee2
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniFramebuffer.cpp
@@ -0,0 +1,3860 @@
+/*
+ * Built-in IOMobileFramebuffer for NEGRONI: the ABL's continuous-splash
+ * framebuffer (1080x2412 a8r8g8b8 in RAM, the panel scans it out by
+ * itself) as the main display, driven by CoreAnimation's CPU renderer.
+ *
+ * IOMobileFramebuffer.framework (iOS 16.7) counts /arm-io children with
+ * device_type "display-subsystem", waits for that many services matching
+ * IOServiceMatching("IOMobileFramebuffer"), opens each with type 0 and
+ * reads canvas-width/canvas-height from the service's provider. The class
+ * here (AppleCLCD, an IOMobileFramebuffer) matches the /arm-io/disp0 nub.
+ *
+ * User client selectors used by CoreAnimation:
+ *   3  GetLayerDefaultSurface [layer, ?] -> [IOSurface port name]
+ *   4  SwapBegin -> [swap id]
+ *   5  SwapEnd, struct 0x46c: +0x50 swap id, +0x54 IOSurface id per layer
+ *      (4 layers), +0x64 rect a / +0xc4 rect b per layer (int x,y,w,h),
+ *      +0x104 enabled layer mask
+ *   6  SwapWait, 7 GetID, 8 GetDisplaySize -> [w, h],
+ *   12 RequestPowerChange [state]: 0 = display off (backboardd, power
+ *      button / auto-lock), else on. Off writes the panel memory black on
+ *      the next vsync tick (0275: stores only, ~3 ms; before: 7 read-modify-
+ *      write passes over the write-combined memory, ~1 s each, the work loop
+ *      blocked for 7 s), then the backlight sets DBV 0 and puts the panel to
+ *      sleep (0258) and the tick runs slowly until on again.
+ *   18 IsMainDisplay,
+ *   28 GetDotPitch, 72 Enable/DisableNotifications [func, refcon, type, 0]
+ * Everything else is accepted and logged once.
+ *
+ * SwapEnd copies the enabled layers' surfaces into the panel memory (no
+ * scaling, CPU copy). Vsync (notification type 5) is a 120 Hz timer that
+ * sends (count, mach_absolute_time, 0) as 32-bit halves to clients that
+ * enabled it, through the port they registered (IOConnectSetNotificationPort).
+ *
+ * GPU present (patch 0231, boot-arg negronifb_gpu, default 1): a swapped
+ * layer whose surface the GPU rendered (RedwoodGPU marks it at submission,
+ * NegroniSurface::gpuFence) is copied into the panel memory by the A730's 2D
+ * engine (NegroniGPUPresent), queued behind the render on the GPU's ring: no
+ * CPU copy and no wait, at every vsync tick (NEGRONI_FB_VSYNC_US, 120 Hz) or
+ * negronifb_gpuhz frames a second if that is lower.
+ * Its surface is held in use (IOSurfaceIsInUse, state page +0x18) from SwapEnd
+ * until the copy's fence is done, so CoreAnimation renders the next frame into
+ * another surface of its swap chain: the source side is double-buffered. The
+ * panel side is not: ABL's display engine keeps scanning its one buffer (a
+ * flip needs DPU programming, README-gpu-kernel.md), and the copy (well under
+ * a millisecond for 10 MB) can land mid-scan. Every other layer, and any frame
+ * the GPU cannot take, goes the CPU way below (negronifb_gpu=0: always), after
+ * the GPU's copies of the same frame and with the CPU's stale lines over a
+ * GPU-written surface dropped first.
+ *
+ * Zero-copy scanout (patch 0234, boot-arg negronifb_zerocopy=1, default 0):
+ * the display engine (SM8450 SDE) fetches backboardd's framebuffers itself.
+ * start() reads the engine's state (read only, always; boot-arg
+ * negronifb_dpuprobe=0 skips it) and finds the source pipe(s) whose address
+ * is the panel memory (ABL's splash layout). When the layout is the expected
+ * one, the rest of ABL's splash region becomes display slots that
+ * NegroniSurface.cpp gives backboardd's canvas-sized BGRA framebuffers. A swap
+ * of one such framebuffer alone, full canvas, is then shown by pointing the
+ * pipes at it (source address, stride, crop offset of the centred panel part)
+ * and a CTL flush: the engine takes the new address at its next frame start
+ * (the panel's 120 Hz refresh), so nothing tears and no CPU or GPU copies the
+ * frame. A GPU-rendered one is flipped once its fence is done (checked every
+ * vsync tick, nobody waits); for a CPU-rendered one the rows CoreAnimation
+ * wrote (the swaps' dirty regions) are cleaned from the CPU caches first. The
+ * shown and the pending framebuffer stay held in use; SwapWait (selector 6)
+ * answers 0 only when the swap it names is on screen (0254: else kIOReturnBusy
+ * at once, in every mode; before 0254 it waited up to 50 ms, as the S9 port,
+ * external/ios-s9 0096). The clock shift is done in the framebuffer
+ * itself while it is shown and undone before CoreAnimation gets it back. Any
+ * other frame takes the copy paths above, and the pipes go back to the panel
+ * memory once it holds that frame; display off and a panic do that too. No
+ * zero-copy with negronibadge=1, with the console drawn over the GUI
+ * (negronifb_noconsole=0) or with negronifb_shift.
+ *
+ * Per-second statistics (patch 0252, boot-arg negronifb_stats, default 1, 0 = off):
+ * once a second the vsync timer logs one "NEGRONI FB STAT:" line with the swaps,
+ * the frames shown by each path (CPU copy, GPU copy, zero-copy flip), the time
+ * of present() (CPU copy or GPU submit), the late vsync ticks (0254: more than half
+ * a NEGRONI_FB_VSYNC_US period after their deadline, and each deadline skipped), and
+ * the SwapWait calls (time in the call, calls answered "busy" (0254; before: calls that
+ * hit NEGRONI_ZC_WAIT_MS)); 0254 adds the
+ * ticks that left a frame pending for its GPU fence and the frames given up on. The
+ * counters start again each line.
+ *
+ * Refresh rate for CoreAnimation (patch 0253, boot-arg negronifb_carefresh, default 1, 0 = off):
+ * QuartzCore (20H392 AppleCLCDDisplay::heartbeat_rate) takes its base quantum from the
+ * "IOMFBDisplayRefresh" dictionary of this service (displayRefreshStepMachTime in mach ticks,
+ * then displayMinRefreshInterval) and falls back to 1/60 s without it. The property gives it
+ * one vsync period (NEGRONI_FB_VSYNC_US), and the vsync notification's third value (the
+ * interval, IOMFBServer::vsync_callback) carries the same tick count instead of 0.
+ *
+ * Display modes for CoreAnimation (patch 0364, boot-arg negronifb_modes, default 1, 0 = off): the
+ * properties TimingElements and ColorElements (one timing: the presented size at negronifb_modehz,
+ * default the panel rate divided by the negronifb_hz copy interval (120 with negronifb_hz=120), as SyncRate/PreciseSyncRate in 16.16 fixed point; one 8-bit RGB colour
+ * mode), read by IOMobileFramebufferGetSupportedDigitalOutModes (20H392 IOMobileFramebuffer
+ * kern_GetSupportedDigitalOutModes), and GetBlock (selector 79) block 0x40 at offset 0 (the second
+ * scalar) = the current mode's colour and timing id at +4/+8 (IOMobileFramebufferGetDigitalOutMode
+ * reads 40 bytes; QuartzCore
+ * IOMFBDisplay::fetch_current_iomfb_mode matches them against the modes). QuartzCore keeps the rate as
+ * bits 29..53 of its Display::Mode; -[CADisplayMode refreshRate] = round(that / 65536), and
+ * UIScreen.maximumFramesPerSecond = round(FBSDisplayConfiguration.refreshRate) of the current mode.
+ * Without a mode CADisplayMode falls back to the display's refresh interval. Port of HakiOS
+ * MiniIOMobileFramebuffer.cpp publishModes()/GetBlock (APSL 2.0, a derivative of Apple's XNU like this
+ * kernel; HakiOS LICENSE item 1, (c) 2025-2026 the HakiOS authors). The VRR idle rate (0259) is a
+ * kernel matter and does not change the published mode.
+ *
+ * Vsync tick without GPU waits (patch 0254): the timer is armed for fixed deadlines (the one
+ * before + NEGRONI_FB_VSYNC_US), so the period does not depend on the work of the handler; a
+ * deadline that has passed is skipped (counted as a late tick). The tick never waits for a
+ * render: swap() keeps the newest GPU fence of the frame's surfaces, and a frame whose fence is
+ * not done stays pending (nothing copied, nothing flipped) until a later tick (a "gpu-wait
+ * skip"). A newer swap replaces it, but the first frame that waits is kept as the older one
+ * and shown if its fence passes first, so a GPU slower than CoreAnimation still shows frames.
+ * A slow GPU is waited for. A fence is given up only when it is pending for more than
+ * NEGRONI_FB_GPU_GIVEUP_MS since the tick first saw it AND a GPU client has closed since then
+ * (its work may be the one left on the ring), or when the GPU has written no fence for
+ * NEGRONI_FB_GPU_STUCK_MS (hung; RedwoodGPU's own stop rule is the same 2 s): the frame is then
+ * copied by the CPU (log once per surface). A GPU the driver declared stopped answers every
+ * fence as done. The waits left on the tick are for the frame's own 2D copy (the render is
+ * done before it is queued), at most NEGRONI_FB_GPU_COPY_WAIT_MS.
+ *
+ * Clock shift after the GPU copy (patch 0256): negronifb_clockshift moves the status bar's
+ * left ear in the panel memory by hand (negroni_shift_clock). On a frame the GPU 2D engine
+ * copies, the CPU must shift only after that copy has reached the panel memory: a shift on
+ * rows the engine has not written yet shifts the previous frame's (already shifted) rows a
+ * second time, and the engine then writes the new rows unshifted around them (fragments of
+ * digits beside the clock, the top of the lock screen's date garbled). The tick waits for the
+ * copy's fence (at most NEGRONI_FB_GPU_COPY_WAIT_MS); when it is not done in time the shift
+ * is kept pending (fShiftFence) and done by the next tick that finds the fence done. The
+ * strip is the status bar only: NEGRONI_FB_CLOCK_ROWS panel rows (boot-arg
+ * negronifb_clockrows=N, 1..300), 120 = the 44 pt status bar at 3x (132 logical rows) less
+ * the 12 rows above the panel (fOffY); the old 150 reached 54 pt, into the lock screen's
+ * date line.
+ *
+ * Vsync after the frame, clock shift inside the copy (patch 0267): the tick queues its frame and
+ * publishes the swap id before it sends the vsync notification (negronifb_notifylate, default 1),
+ * so CoreAnimation's SwapWait right after the notification finds the id done instead of running
+ * out its 1 ms retry and skipping a heartbeat. negronifb_clockshift is applied by the copy itself
+ * (negronifb_clockcopy, default 1): the GPU copies the status bar strip as four rectangles (rows
+ * below it, its left half n pixels to the right, the n pixels pushed out at the middle to the left
+ * edge, its right half) in one submission, the CPU path copies the strip rows the same way; the
+ * write-combined panel memory is never read back or rewritten after the copy.
+ *
+ * The panel memory itself is published as an IOSurface and returned as the
+ * default framebuffer surface. The kernel text console keeps drawing over
+ * the GUI by default: boot-arg negronifb_noconsole=1 stops drawing it from
+ * the first swap on (it still reaches the persistent log; panics draw).
+ */
+#include "NegroniSurface.h"
+#include "NegroniGPU.h"
+
+extern "C" int negroni_console_muted;     /* osfmk/console/serial_console.c */
+extern "C" char negroni_gpu_badge[24];   /* bsd/dev/negroni_adreno.c */
+extern "C" uint32_t negroni_gpu_badge_color;
+extern "C" uint32_t negroni_gpu_ui_swaps;       /* bsd/dev/negroni_adreno.c (0286): the GPU DCVS UI floor */
+extern "C" uint32_t negroni_gpu_late_frames;    /* 0384: frames held for the GPU, the governor's late-frame step */
+extern "C" void negroni_gpu_display(bool on);   /* 0384: display power for the GPU governor and slumber */
+extern "C" char negroni_wifi_badge[24];   /* bsd/dev/negroni_wifi.c */
+extern "C" uint32_t negroni_wifi_badge_color;
+extern "C" unsigned char iso_font[256 * 16];
+extern "C" bool negroni_backlight_display_off(uint32_t fade_ms);  /* NegroniBacklight.cpp (0258) */
+extern "C" bool negroni_backlight_display_on(void);
+extern "C" void negroni_backlight_panic(void);
+
+#if defined(NEGRONI)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/system.h>
+#include <pexpert/pexpert.h>
+#include <kern/clock.h>
+#include <sys/proc.h>
+#include <kern/thread_call.h>
+
+/*
+ * The DPU registers (528 KiB) map from kernel_map, not io_submap: io_submap is 8 MiB for the whole
+ * kernel (osfmk/arm/io_map.c) and the GPU ladder + Wi-Fi survey + ADSP fill it (notes "io_submap").
+ * VM_WIMG_IO (osfmk/arm/memory_types.h) = 0x7, Device memory, the type ml_io_map uses.
+ */
+extern "C" vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+#define NEGRONI_WIMG_IO                   0x7u
+extern "C" void negroni_fb_panic(void);
+extern "C" int negroni_fb_te_wait(uint32_t frames, uint32_t timeout_ms);   /* 0353: bsd/dev/negroni_fp.c */
+static vm_offset_t negroni_fb_te_intf;    /* 0353: INTF_1 once teInit mapped it (0 = TE counter off) */
+
+enum {
+	kNegroniFBGetLayerDefaultSurface  = 3,
+	kNegroniFBSwapBegin               = 4,
+	kNegroniFBSwapEnd                 = 5,
+	kNegroniFBSwapWait                = 6,
+	kNegroniFBGetID                   = 7,
+	kNegroniFBGetDisplaySize          = 8,
+	kNegroniFBRequestPowerChange      = 12,
+	kNegroniFBIsMainDisplay           = 18,
+	kNegroniFBGetDotPitch             = 28,
+	kNegroniFBNotifications           = 72,
+	kNegroniFBGetBlock                = 79,   /* 0364: block 0x40 = the current mode (colour, timing id) */
+};
+
+#define NEGRONI_FB_SWAP_REC_SIZE          0x46c
+#define NEGRONI_FB_LAYERS                 4
+#define NEGRONI_FB_NOTIFY_TYPES           8
