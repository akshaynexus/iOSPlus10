From: iOSPlus10 ios26 port
Subject: [PATCH 0007] negroni IOKit drivers on xnu-12377 (compile level only)

The iOS 16 IOKit side copied unchanged from the iOS 16 reference tree: NegroniFramebuffer (AppleCLCD/IOMFB
stand-in), NegroniSurface (IOSurface stand-in), NegroniAccel/NegroniGPU (IOAccelerator/RedwoodGPU), NegroniBacklight,
NegroniBattery, NegroniVibrator, NegroniWLAN, NegroniWatchdog, NegroniKeyStore (AKS emulation), NegroniAMFI,
NegroniEntitlements, the HID event services (iokit/Kernel/arm/hid, NegroniHID); iokit/conf/files.arm64 lines and the
13 IOKit personalities of the iOS 16 KernelConfigTables NEGRONI block.
[V] 2026-10-27: all compile with Xcode 27.1 against xnu-12377 and the kernel links; their strong definitions replace
the weak defaults of 0006.
[I] Compile level only. These classes answer the user-client ABIs of iOS 16 (IOSurface, IOMobileFramebuffer,
AppleKeyStore, IOHIDEventService, IOAccelerator). The iOS 26.5.2 userland (IOSurface 393.5.7, IOMobileGraphicsFamily
343.0.0) must be re-traced selector by selector before they can work (docs/ios26-port-status.md section 5).

diff --git a/iokit/Kernel/arm/NegroniAMFI.cpp b/iokit/Kernel/arm/NegroniAMFI.cpp
new file mode 100644
index 0000000..72e9e94
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniAMFI.cpp
@@ -0,0 +1,112 @@
+/*
+ * A stand-in for AppleMobileFileIntegrity's IOService (ios-flame 0103).
+ * NEGRONI has no AMFI kext. Userland looks the service up by class name:
+ * ExtensionFoundation's +[NSDictionary _EX_dictionaryWithSignedURL:] reads
+ * signed caches (the extension point catalog
+ * /System/Library/xpc/extensions.plist) only after it asks AMFI whether the
+ * file's cdhash is in the trust cache. Without the service the read fails
+ * ("Unable to find AMFI"), sandboxed readers (lsd) get no extension point
+ * catalog, MobileInstallation rejects every app extension ("Extension cache
+ * does not have an entry for ...") and LaunchServices registers none:
+ * widgets, poster providers and other app extensions do not run.
+ *
+ * User client, IOConnectCallMethod:
+ *   6 trust cache query  [1 scalar] + struct cdhash -> 0 (trusted)
+ * Every cdhash is trusted: code signing is not enforced on NEGRONI and there
+ * is no trust cache to look in. Other selectors are logged once and answered
+ * kIOReturnUnsupported, which is what their callers got from the missing
+ * service. Boot-arg negroniamfi bit 2 clear (e.g. negroniamfi=0) leaves the
+ * service out (bsd/kern/negroni_amfi.c documents the other bits).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+#define NEGRONI_AMFI_OPT_SERVICE        0x4
+#define NEGRONI_AMFI_SEL_TRUST_QUERY    6
+
+class AppleMobileFileIntegrity : public IOService {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+
+IOService *
+AppleMobileFileIntegrity::probe(IOService *provider, SInt32 *score)
+{
+	uint32_t options = 0x7;
+	(void)PE_parse_boot_argn("negroniamfi", &options, sizeof(options));
+	if (!(options & NEGRONI_AMFI_OPT_SERVICE)) {
+		IOLog("NEGRONI AMFI: AppleMobileFileIntegrity left out (negroniamfi 0x%x)\n", options);
+		return NULL;
+	}
+	return IOService::probe(provider, score);
+}
+
+bool
+AppleMobileFileIntegrity::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleMobileFileIntegrityUserClient");
+	registerService();
+	IOLog("NEGRONI AMFI: AppleMobileFileIntegrity published (trust cache queries answer trusted)\n");
+	return true;
+}
+
+class AppleMobileFileIntegrityUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrityUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrityUserClient, IOUserClient);
+
+IOReturn
+AppleMobileFileIntegrityUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleMobileFileIntegrityUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	static uint32_t logged;         /* one line per selector */
+	uint32_t in_struct = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+
+	if (selector == NEGRONI_AMFI_SEL_TRUST_QUERY) {
+		if (!(logged & (1u << selector))) {
+			logged |= 1u << selector;
+			IOLog("NEGRONI AMFI: trust cache query (%u scalars, %u-byte cdhash): trusted\n",
+			    args->scalarInputCount, in_struct);
+		}
+		args->scalarOutputCount = 0;
+		return kIOReturnSuccess;
+	}
+	if (selector < 32 && !(logged & (1u << selector))) {
+		logged |= 1u << selector;
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("NEGRONI AMFI: %s selector %u (in %u/%u) unsupported\n", name, selector,
+		    args->scalarInputCount, in_struct);
+	}
+	return kIOReturnUnsupported;
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/iokit/Kernel/arm/NegroniAccel.cpp b/iokit/Kernel/arm/NegroniAccel.cpp
new file mode 100644
index 0000000..2062bde
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniAccel.cpp
@@ -0,0 +1,68 @@
+/*
+ * Empty IOAcceleratorES for NEGRONI: a stand-in so that CoreAnimation does not wait.
+ *
+ * QuartzCore (CAMetalContextCreate) polls IOServiceGetMatchingService(IOServiceMatching(
+ * "IOAcceleratorES")) 300 times, 100 ms apart, in every process that sets up CA rendering
+ * (backboardd, SpringBoard, apps): about 30 s each (live log: "IOK backboardd: matching1 ...
+ * IOAcceleratorES ... -> none", again and again). This service is found at once. It has no
+ * user client. Patch 0205 adds the driver plugin names (below); without them Metal
+ * (_MTLRegisterDevices) passes over the service and CoreAnimation keeps its CPU renderer.
+ *
+ * Driver plugin names (0205). Each user-space loader reads its own property; they do not conflict:
+ *  - IOGLESBundleName = "NegroniGL" (boot-arg negronigl, default 1; negronigl=0 removes it).
+ *    libGFXShared gfxInitializeLibrary dlopens /System/Library/Extensions/NegroniGL.bundle,
+ *    the OpenGL ES (GLD) renderer under Apple's GLEngine (docs/gl-renderer-plugin.md).
+ *    We never set IOGLESMetalBundleName, so the OpenGL ES choice does not depend on the
+ *    "UseMetal" preference or IOGLESDefaultUseMetal.
+ *  - MetalPluginName = "NegroniMetal", MetalPluginClassName = "NegroniMTLDevice" (boot-arg
+ *    negronimetal, default 1: Metal first, owner). Metal.framework MTLRegisterDevices loads the bundle and calls
+ *    -initWithAcceleratorPort:; a nil device is skipped (docs/metal-design.md).
+ *  The properties are set before registerService(), so the first lookup already sees them.
+ *
+ * A personality in iokit/KernelConfigTables.cpp attaches it below AppleCLCD (as in ios-sailfish
+ * 0166 and bergamota 0122, after ios-topaz 0138). Boot-arg negroniaccel=0 leaves it out.
+ *
+ * Not the GPU: RedwoodGPU (NegroniGPU.cpp, negroniadreno_keep=1) is a separate class and is not
+ * matched by IOAcceleratorES lookups. A real GPU driver that publishes its own IOAcceleratorES
+ * must replace this stub (remove the personality), not add a second one: Metal expects one.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NEGRONI)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	uint32_t enabled = 1, gl = 1, metal = 1;
+
+	PE_parse_boot_argn("negroniaccel", &enabled, sizeof(enabled));
+	if (enabled == 0 || !IOService::start(provider)) {
+		return false;
+	}
+	PE_parse_boot_argn("negronigl", &gl, sizeof(gl));
+	PE_parse_boot_argn("negronimetal", &metal, sizeof(metal));
+	if (gl != 0) {
+		setProperty("IOGLESBundleName", "NegroniGL");
+	}
+	if (metal != 0) {
+		setProperty("MetalPluginName", "NegroniMetal");
+		setProperty("MetalPluginClassName", "NegroniMTLDevice");
+	}
+	registerService();
+	IOLog("NEGRONI ACCEL: IOAcceleratorES on %s, GL plugin %s (negronigl=%u), Metal plugin %s (negronimetal=%u)\n",
+	    provider->getName(), gl ? "NegroniGL" : "none", gl, metal ? "NegroniMetal" : "none", metal);
+	return true;
+}
+#endif /* NEGRONI */
diff --git a/iokit/Kernel/arm/NegroniBacklight.cpp b/iokit/Kernel/arm/NegroniBacklight.cpp
new file mode 100644
index 0000000..f000034
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniBacklight.cpp
@@ -0,0 +1,1289 @@
+/*
+ * Panel brightness and display sleep for NEGRONI (OnePlus 10 Pro 5G, SM8450).
+ *
+ * Panel: Samsung AMB670YF08 (S6E3HC3 driver IC), AMOLED, DSI command mode,
+ * DSC, DSI0 only. The UEFI (XBL DisplayDxe, Panel_samsung_amb670yf08_*.xml)
+ * set it up at 1080x2412 with MDP auto-refresh, so the panel scans the RAM
+ * framebuffer by itself and nothing in the kernel kicks frames. Brightness
+ * is the DCS command 0x51 (set_display_brightness) with a 2-byte DBV, high
+ * byte first ("51 06 9f"; qcom,mdss-dsi-bl-inverted-dbv), 1..0x7ff normal,
+ * 0x800..0xfff HBM (not used here). 0x53 = 0x28 was already sent by the UEFI.
+ *
+ * DCS commands go through the DSI0 controller's command DMA in FIFO mode
+ * (CMD_DMA_TPG, no DMA buffer in RAM, no SMMU), as Linux
+ * dsi_ctrl_hw_cmn_kickoff_fifo_command (techpack/display, DSI 2.x) and
+ * sailfish 0168 (DSI 1.4). A write is skipped while the MDP stream is busy
+ * (DSI STATUS) for up to 20 ms; the controller queues a DMA trigger behind an
+ * MDP transfer anyway. Every access is serialized by negroni_dsi_lock.
+ *
+ * CoreBrightness (backboardd, iOS 16.7 20H392) finds the service through
+ * {IOPropertyMatch: {backlight-control: true}} and a class that conforms to
+ * AppleARMBacklight. Without "new-backlight-architecture" it uses its legacy
+ * path (__DisplaySetPhysicalBrightnessLegacyOnThread): it reads
+ * IODisplayParameters {brightness {min, max, value}} and sets
+ * {brightness = device level in min..max, FadePeriod = seconds as 16.16,
+ * backlight-level} with IORegistryEntrySetCFProperties. "brightness-nits"
+ * (nits as 16.16, _SetBLDriverNitsValue) is accepted too. The service does
+ * NOT publish "digital-dimming-min-nits": CoreBrightness enables digital
+ * dimming (a colour scaler on every frame, too slow for the CPU renderer)
+ * only when that value is below the hardware minimum.
+ *
+ * setProperties only records the request; the panel is written from this
+ * service's own work loop (fades in 16 ms steps), so backboardd never waits
+ * for the DSI.
+ *
+ * Display sleep (0258; AppleCLCD RequestPowerChange, NegroniFramebuffer.cpp):
+ * backboardd's RequestPowerChange(0) is the only path that darkens the
+ * panel (the power key only reaches iOS as a HID key; the 0251 kernel
+ * fast-off on a short press is gone). The framebuffer runs its fade to
+ * black first (7 vsync ticks), then calls negroni_backlight_display_off():
+ * DBV 0, and with negronifb_sleep >= 1 the panel's own off-command
+ * (live.dts qcom,mdss-dsi-off-command of the AMB670YF08 panel: DCS 0x28
+ * set_display_off, wait 0x15 = 21 ms, 0x10 enter_sleep_mode, wait 0x65 =
+ * 101 ms, LP mode). In sleep the panel sends no TE, so the MDP
+ * auto-refresh (TE-triggered) stops by itself; the DCS path waits for
+ * MDP-not-busy, so the commands go between two frames.
+ * RequestPowerChange(1) calls negroni_backlight_display_on(): 0268 sends
+ * the panel's whole on-command (live.dts, 94 packets incl. the 9E PPS, 0x11,
+ * 35 00 TE on, 2A/2B, 0x29) and the 0x0A PPS, with the DPU auto-refresh
+ * paused, then re-arms it, checks TE and frames, and sets the last lit DBV
+ * (wakePanel). 0258 sent only 0x11, 133 ms, 0x29: on the phone (2026-10-26
+ * 13:24-13:30, "display on (sleep-out 133 ms, DCS ok ...)") the panel stayed
+ * black with a purple strip. negronifb_wake=0 brings the 0258 wake back. The
+ * framebuffer redraws at its next tick; the MDP scans it on the first TE.
+ * negronifb_sleep=0: DBV 0 + black pixels only (the panel stays scanning).
+ * =2: also the panel rails: vddio (pm8350c_l12, 1.8 V) and vci
+ * (pm8350c_l13, 3.0 V) are RPMh LDOs. negroni_rpmh.c only votes rails on,
+ * and after a rail cycle the panel needs the reset sequence and the whole
+ * on-command (incl. the DSC PPS), which this kernel does not have; so 2 = 1
+ * (logged at start).
+ *
+ * Boot-args: negronifb_wake=0|1|2 (0268, default 2: on-command + PPS),
+ * negronibl=0 (off: no service, no DSI access), negronibl_max=DBV
+ * (default 2047, at most 4095), negronibl_curve=1 (square curve),
+ * negronibl_hs=1 (high-speed instead of low-power DCS), negronifb_sleep=0/1/2
+ * (default 1; the old name negronibl_sleep is accepted too),
+ * negronibl_nits=N (nits at full DBV for brightness-nits, default 500).
+ * See patches/xnu/README-brightness.md in the iOSPlus10 repo.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NEGRONI)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOWorkLoop.h>
+#include <IOKit/IOTimerEventSource.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include <kern/clock.h>
+#include <sys/proc.h>
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/* ---------------------------------------------------------------------- */
+/* DSI0 command DMA (FIFO mode)                                            */
+/* ---------------------------------------------------------------------- */
+
+/* live DT qcom,mdss_dsi_ctrl0@ae94000: reg <0xae94000 0x400>, "qcom,dsi-ctrl-hw-v2.6" */
+#define NDSI_PA                         0x0ae94000ull
+#define NDSI_SIZE                       0x400
+/* Register offsets: techpack/display dsi_ctrl_reg.h (= Linux dsi.xml.h + DSI_6G_REG_SHIFT 4) */
+#define NDSI_HW_VERSION                 0x000
+#define NDSI_CTRL                       0x004   /* bit0 ENABLE, bit2 CMD_MODE_EN */
+#define NDSI_STATUS                     0x008   /* bit1 CMD_MODE_DMA_BUSY, bit2 CMD_MODE_MDP_BUSY */
+#define NDSI_CMD_DMA_CTRL               0x03c   /* 31 BROADCAST_EN, 30 MASTER, 28 EMBEDDED, 26 LOW_POWER */
+#define NDSI_DMA_CMD_OFFSET             0x048   /* 0268: command buffer address (memory DMA) */
+#define NDSI_DMA_CMD_LENGTH             0x04c
+#define NDSI_DMA_FIFO_CTRL              0x050   /* 0268: bit 20/16 write/read watermark off (memory DMA) */
+#define NDSI_TRIG_CTRL                  0x084   /* bits 0-3 DMA trigger, 4 = software */
+#define NDSI_CMD_DMA_SW_TRIGGER         0x090
+#define NDSI_INT_CTRL                   0x110   /* even bits status (write 1 clears), odd bits enables */
+#define NDSI_TPG_CTRL                   0x15c   /* TEST_PATTERN_GEN_CTRL */
+#define NDSI_TPG_CMD_DMA_INIT_VAL       0x17c   /* TEST_PATTERN_GEN_CMD_DMA_INIT_VAL (FIFO port) */
+#define NDSI_TPG_DMA_FIFO_RESET         0x1ec
+
+#define NDSI_STATUS_DMA_BUSY            (1u << 1)
+#define NDSI_STATUS_MDP_BUSY            (1u << 2)
+#define NDSI_INT_DMA_DONE               (1u << 0)
+#define NDSI_INT_ENABLE_BITS            0xaaaaaaaau
+#define NDSI_TPG_FIFO_ON                (3u << 16 | 1u << 2 | 1u << 1)
+#define NDSI_DMA_TRIGGER_SW             4u
+#define NDSI_MAX_PAYLOAD                60      /* bytes; the TPG FIFO holds 64 with the 4-byte header (0259: was 16) */
+/*
+ * 0268: packets longer than the FIFO go from memory: the last 16 KiB of the UEFI's splash region
+ * (cont_splash_region 0xb8000000 + 0x2b00000; the 0234 display slots end at 0xbaafc000, the 0269
+ * panel buffers well before it).
+ */
+#define NDSI_MEM_PA                     0xbaafc000ull
+#define NDSI_MEM_SIZE                   0x4000u
+#define NDSI_MEM_MAX_PAYLOAD            1024u
+#define NDSI_SET_SKIP_LONG              1u      /* negroni_dsi_dcs_set_ex flags */
+#define NDSI_SET_GO_ON                  2u
+
+struct negroni_dsi_set_result {
+	uint32_t packets;       /* packets of the set handled (sent, skipped or failed long) */
+	uint32_t sent;
+	uint32_t longSent, longFailed, skipped;
+};
+extern "C" int negroni_dsi_dcs_set_ex(const uint8_t *set, uint32_t len, bool lp, uint32_t flags,
+    struct negroni_dsi_set_result *res);
+extern "C" int negroni_dsi_long_packet(uint8_t dt, const uint8_t *buf, uint32_t len, bool lp);
+
+static volatile uint32_t *negroni_dsi;
+static IOLock *negroni_dsi_lock;        /* every DSI command, see negroni_dsi_dcs_write */
+static bool negroni_dsi_dead;
+static bool negroni_dsi_panic;         /* 0258: panic path, other CPUs stopped: no lock */
+static uint32_t negroni_dsi_failures, negroni_dsi_mdp_waits;
+static IOLock *negroni_dsi_set_lock;    /* 0268: a whole command set (negroni_dsi_dcs_set_ex) */
+static volatile void *negroni_dsi_mem;  /* 0268: NDSI_MEM_PA, write-combined (NULL: no memory DMA) */
+static bool negroni_dsi_mem_off;        /* 0268: a memory DMA failed: FIFO packets only from then on */
+/* 0292: bsd/dev/negroni_dsi.c, command sets in batched memory DMAs (negronifb_dsidma) */
+#define NEGRONI_DSI_DMA_NOT_USED        (-100)
+extern "C" int negroni_dsi_dma_set(const uint8_t *set, uint32_t len, bool lp, uint32_t *sent, uint32_t *resume);
+extern "C" int negroni_dsi_dma_write(const uint8_t *buf, uint32_t len, bool lp);
+
+static inline uint32_t
+ndsi_rd(uint32_t off)
+{
+	return negroni_dsi[off / 4];
+}
+
+static inline void
+ndsi_wr(uint32_t off, uint32_t v)
+{
+	negroni_dsi[off / 4] = v;
+}
+
+/* Map DSI0 and check that it is a running command-mode DSI 2.x controller. */
+static bool
+negroni_dsi_init(void)
+{
+	if (negroni_dsi != NULL) {
+		return true;
+	}
+	negroni_dsi_lock = IOLockAlloc();
+	vm_offset_t va = ml_io_map((vm_offset_t)NDSI_PA, NDSI_SIZE);
+	if (negroni_dsi_lock == NULL || va == 0) {
+		IOLog("NEGRONI BL: DSI0 0x%llx not mapped\n", NDSI_PA);
+		return false;
+	}
+	volatile uint32_t *d = (volatile uint32_t *)va;
+	uint32_t ver = d[NDSI_HW_VERSION / 4], ctrl = d[NDSI_CTRL / 4];
+	IOLog("NEGRONI BL: DSI0 version 0x%08x ctrl 0x%08x status 0x%08x dma_ctrl 0x%08x trig 0x%08x tpg 0x%08x\n",
+	    ver, ctrl, d[NDSI_STATUS / 4], d[NDSI_CMD_DMA_CTRL / 4], d[NDSI_TRIG_CTRL / 4], d[NDSI_TPG_CTRL / 4]);
+	if ((ver >> 28) != 2 || (ctrl & 0x5u) != 0x5u) {
+		IOLog("NEGRONI BL: DSI0 not a running command-mode DSI 2.x controller; no DCS\n");
+		return false;
+	}
+	negroni_dsi = d;
+	negroni_dsi_set_lock = IOLockAlloc();
+	/* 0268: the command buffer for the packets the FIFO cannot hold (memory DMA) */
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(NDSI_MEM_PA, NDSI_MEM_SIZE, kIODirectionInOut);
+	IOMemoryMap *map = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
+	OSSafeReleaseNULL(md);                  /* the map keeps it */
+	negroni_dsi_mem = map != NULL ? (volatile void *)map->getVirtualAddress() : NULL;
+	IOLog("NEGRONI BL: DSI0 command buffer for long packets %s at 0x%llx (fifo_ctrl 0x%08x dma_offset 0x%08x)\n",
+	    negroni_dsi_mem != NULL ? "mapped" : "NOT mapped", NDSI_MEM_PA, d[NDSI_DMA_FIFO_CTRL / 4], d[NDSI_DMA_CMD_OFFSET / 4]);
+	return true;
+}
+
+/*
+ * Send one DSI packet (data type dt, payload buf/len) to the panel on virtual
+ * channel 0. Short types (0x05 DCS short, 0x15 DCS short + 1 parameter, 0x03/
+ * 0x13/0x23 generic short) carry at most 2 bytes in the header; long types
+ * (0x39 DCS long, 0x29 generic long, 0x0a PPS) carry a word count. A packet
+ * that fits the TPG FIFO (4-byte header + payload <= 64 bytes, dsi_ctrl.h:58
+ * DSI_CTRL_MAX_CMD_FIFO_STORE_SIZE) goes out in FIFO mode
+ * (dsi_ctrl_hw_cmn_kickoff_fifo_command); a longer one (0268: the 90-byte 9E
+ * PPS of the on-command, the 128-byte 0x0A PPS) from a buffer in memory, as
+ * Android always does (dsi_ctrl.c:1701-1731 copy + pad 0xff, dsi_ctrl_hw_cmn.c:870
+ * kickoff_command: DMA_CTRL embedded mode, DMA_FIFO_CTRL watermarks off,
+ * DMA_CMD_OFFSET/LENGTH, SW trigger). The buffer is the last 16 KiB of the
+ * UEFI's splash region (NDSI_MEM_PA): RAM XNU does not manage, read by the
+ * DSI DMA through the display's SMMU context like the pipes' fetch of the
+ * panel memory at the same physical addresses (the UEFI sent its 129-byte
+ * 9E PPS the same way). lp = low-power transmission. 0 when the controller
+ * reported CMD_DMA_DONE. After 3 failures in a row the DSI is left alone.
+ * Thread context only (sleeps on the lock, spins up to ~45 ms).
+ */
+static int
+negroni_dsi_packet(uint8_t dt, const uint8_t *buf, uint32_t len, bool lp)
+{
+	uint32_t words[2 + (NDSI_MAX_PAYLOAD + 3) / 4];
+	uint32_t n = 0, bytes;
+	bool isLong = dt == 0x39 || dt == 0x29 || dt == 0x0a;
+	bool mem = false;
+
+	if (negroni_dsi == NULL || len == 0 || (!isLong && len > 2) || len > NDSI_MEM_MAX_PAYLOAD) {
+		return -1;
+	}
+	if (isLong && len > NDSI_MAX_PAYLOAD) {
+		mem = true;
+		if (negroni_dsi_mem == NULL || negroni_dsi_mem_off || negroni_dsi_panic) {
+			return -6;      /* no command buffer in memory (or it failed before) */
+		}
+	}
+	/* Header in embedded mode: [7:0] data0/WC lo, [15:8] data1/WC hi, [21:16] DT, [23:22] VC, 30 long, 31 last */
+	if (!isLong) {
+		words[n++] = 1u << 31 | (uint32_t)dt << 16 | (len == 2 ? (uint32_t)buf[1] << 8 : 0u) | buf[0];
+		bytes = 4;
+	} else if (!mem) {
+		words[n++] = 1u << 31 | 1u << 30 | (uint32_t)dt << 16 | len;
+		for (uint32_t i = 0; i < len; i += 4) {
+			uint32_t w = 0;
+			for (uint32_t b = 0; b < 4 && i + b < len; b++) {
+				w |= (uint32_t)buf[i + b] << (8 * b);
+			}
+			words[n++] = w;
+		}
+		bytes = n * 4;
+		if (n & 1u) {
+			words[n++] = 0;         /* the FIFO takes an even number of words */
+		}
+	} else {
+		bytes = 4 + ((len + 3) & ~3u);
+	}
+
+	bool locked = !negroni_dsi_panic;       /* panic: no lock (a stopped holder must not hang it) */
+	if (locked) {
+		IOLockLock(negroni_dsi_lock);
+	}
+	if (negroni_dsi_dead) {
+		if (locked) {
+			IOLockUnlock(negroni_dsi_lock);
+		}
+		return -1;
+	}
+	int rc = 0;
+	uint32_t i;
+	for (i = 0; i < 250 && (ndsi_rd(NDSI_STATUS) & NDSI_STATUS_DMA_BUSY); i++) {
+		IODelay(20);
+	}
+	if (ndsi_rd(NDSI_STATUS) & NDSI_STATUS_DMA_BUSY) {
+		rc = -2;                /* someone else's command never finished: do not touch it */
+		goto out;
+	}
+	/* Between frames if possible (auto-refresh sends one per TE, ~6 ms of 8.3 ms at 120 Hz). */
+	for (i = 0; i < 1000 && (ndsi_rd(NDSI_STATUS) & NDSI_STATUS_MDP_BUSY); i++) {
+		IODelay(20);
+	}
+	if (i == 1000 && negroni_dsi_mdp_waits++ < 4) {
+		IOLog("NEGRONI BL: DSI0 MDP stream busy for 20 ms; sending anyway\n");
+	}
+	{
+		uint32_t tpg = ndsi_rd(NDSI_TPG_CTRL);
+		uint32_t dma = ndsi_rd(NDSI_CMD_DMA_CTRL);
+		uint32_t trig = ndsi_rd(NDSI_TRIG_CTRL);
+		uint32_t fifo = ndsi_rd(NDSI_DMA_FIFO_CTRL);
+		if ((trig & 0xfu) != NDSI_DMA_TRIGGER_SW) {
+			ndsi_wr(NDSI_TRIG_CTRL, (trig & ~0xfu) | NDSI_DMA_TRIGGER_SW);
+		}
+		ndsi_wr(NDSI_INT_CTRL, (ndsi_rd(NDSI_INT_CTRL) & NDSI_INT_ENABLE_BITS) | NDSI_INT_DMA_DONE);
+		uint32_t nd = (dma & ~(1u << 31 | 1u << 30 | 1u << 26)) | 1u << 28 | (lp ? 1u << 26 : 0u);
+		if (mem) {
+			/* dsi_ctrl_copy_and_pad_cmd: header (last command), payload, 0xff up to a word */
+			volatile uint8_t *m = (volatile uint8_t *)negroni_dsi_mem;
+			uint32_t h = 1u << 31 | 1u << 30 | (uint32_t)dt << 16 | len;
+			for (uint32_t b = 0; b < 4; b++) {
+				m[b] = (uint8_t)(h >> (8 * b));
+			}
+			for (uint32_t b = 0; b < bytes - 4; b++) {
+				m[4 + b] = b < len ? buf[b] : 0xff;
+			}
+			__builtin_arm_dsb(0xf);
+			ndsi_wr(NDSI_TPG_CTRL, 0);              /* DMA from memory, not from the TPG FIFO */
+			nd &= ~(1u << 24 | 1u << 29);           /* packet type, WC_SEL (kickoff_command) */
+			ndsi_wr(NDSI_CMD_DMA_CTRL, nd);
+			ndsi_wr(NDSI_DMA_FIFO_CTRL, fifo | 1u << 20 | 1u << 16);   /* watermarks off */
+			ndsi_wr(NDSI_DMA_CMD_OFFSET, (uint32_t)NDSI_MEM_PA);
+			ndsi_wr(NDSI_DMA_CMD_LENGTH, bytes & 0xffffffu);
+		} else {
+			ndsi_wr(NDSI_TPG_CTRL, NDSI_TPG_FIFO_ON);
+			for (uint32_t w = 0; w < n; w++) {
+				ndsi_wr(NDSI_TPG_CMD_DMA_INIT_VAL, words[w]);
+			}
+			ndsi_wr(NDSI_CMD_DMA_CTRL, nd);
+			ndsi_wr(NDSI_DMA_CMD_LENGTH, bytes);
+		}
+		__builtin_arm_dsb(0xf);
+		ndsi_wr(NDSI_CMD_DMA_SW_TRIGGER, 1);
+		__builtin_arm_dsb(0xf);
+		bool done = false;
+		for (i = 0; i < 1250 && !done; i++) {   /* 25 ms */
+			done = (ndsi_rd(NDSI_INT_CTRL) & NDSI_INT_DMA_DONE) != 0;
+			if (!done) {
+				IODelay(20);
+			}
+		}
+		ndsi_wr(NDSI_INT_CTRL, (ndsi_rd(NDSI_INT_CTRL) & NDSI_INT_ENABLE_BITS) | NDSI_INT_DMA_DONE);
+		/* dsi_ctrl_hw_cmn_reset_cmd_fifo, then the registers as found */
+		ndsi_wr(NDSI_TPG_CTRL, 0);
+		ndsi_wr(NDSI_TPG_DMA_FIFO_RESET, 1);
+		__builtin_arm_dsb(0xf);
+		IODelay(1);
+		ndsi_wr(NDSI_TPG_DMA_FIFO_RESET, 0);
+		ndsi_wr(NDSI_TPG_CTRL, tpg);
+		ndsi_wr(NDSI_CMD_DMA_CTRL, dma);
+		if (mem) {
+			ndsi_wr(NDSI_DMA_FIFO_CTRL, fifo);
+		}
+		if ((trig & 0xfu) != NDSI_DMA_TRIGGER_SW) {
+			ndsi_wr(NDSI_TRIG_CTRL, trig);
+		}
+		__builtin_arm_dsb(0xf);
+		if (!done) {
+			rc = -3;
+			if (mem) {
+				negroni_dsi_mem_off = true;     /* 0268: no second try from memory this boot */
+			}
+		}
+	}
+out:
+	if (rc != 0) {
+		negroni_dsi_failures++;
+		IOLog("NEGRONI BL: DSI packet 0x%02x cmd 0x%02x (%u bytes%s) failed %d, status 0x%08x int 0x%08x (failure %u)\n",
+		    dt, buf[0], len, mem ? ", from memory" : "", rc, ndsi_rd(NDSI_STATUS), ndsi_rd(NDSI_INT_CTRL),
+		    negroni_dsi_failures);
+		if (negroni_dsi_failures >= 3) {
+			negroni_dsi_dead = true;
+			IOLog("NEGRONI BL: DSI0 commands disabled after 3 failures\n");
+		}
+	} else {
+		negroni_dsi_failures = 0;
+	}
+	if (locked) {
+		IOLockUnlock(negroni_dsi_lock);
+	}
+	return rc;
+}
+
+/*
+ * Send one DCS write (buf[0] = command, then its parameters): short write
+ * without (0x05) or with one parameter (0x15), else a long write (0x39).
+ */
+extern "C" int
+negroni_dsi_dcs_write(const uint8_t *buf, uint32_t len, bool lp)
+{
+	if (len == 0 || len > NDSI_MAX_PAYLOAD) {
+		return -1;
+	}
+	if (!negroni_dsi_panic) {
+		/* 0292: negronifb_dsidma=2 sends single writes through the memory DMA too */
+		int drc = negroni_dsi_dma_write(buf, len, lp);
+		if (drc != NEGRONI_DSI_DMA_NOT_USED) {
+			return drc;
+		}
+	}
+	return negroni_dsi_packet(len == 1 ? 0x05 : len == 2 ? 0x15 : 0x39, buf, len, lp);
+}
+
+/*
+ * 0259/0268: send a command set in the Qualcomm device-tree format
+ * (dsi_panel.c dsi_panel_create_cmd_packets: per packet a 7-byte header
+ * {type, last, vc, flags, wait ms, length hi, length lo} then the payload).
+ * Each packet goes out as its own DMA with its own data type (0268: before,
+ * the type came from the length, so "39 bd 21" went out as a 0x15 short write;
+ * dsi_panel.c sends what the set says), behind the same MDP-not-busy wait; a
+ * wait byte is honoured after the packet. The whole set holds
+ * negroni_dsi_set_lock, so two sets (0259 VRR thread call, 0268 wake on the
+ * backlight work loop) never interleave inside a Samsung F0 5A 5A key.
+ * flags: NDSI_SET_SKIP_LONG skips the packets that need a memory DMA,
+ * NDSI_SET_GO_ON goes on after a failed long packet (the rest of an
+ * on-command is still worth sending). Thread context only. 0 when every
+ * packet that was tried went out, else the first error.
+ */
+extern "C" int
+negroni_dsi_dcs_set_ex(const uint8_t *set, uint32_t len, bool lp, uint32_t flags, struct negroni_dsi_set_result *res)
+{
+	struct negroni_dsi_set_result r = {};
+	uint32_t i = 0;
+	int rc = 0, first = 0;
+
+	if (negroni_dsi_set_lock != NULL) {
+		IOLockLock(negroni_dsi_set_lock);
+	}
+	if (!(flags & NDSI_SET_SKIP_LONG)) {
+		/*
+		 * 0292: negronifb_dsidma>=1: the set as Android sends it (memory fetch, batched up to the
+		 * packet without the 0x40 batch flag). If the memory DMA fails midway, the packets from
+		 * byte offset `resume` on go out one by one below.
+		 */
+		uint32_t dsent = 0, resume = 0;
+		rc = negroni_dsi_dma_set(set, len, lp, &dsent, &resume);
+		if (rc != NEGRONI_DSI_DMA_NOT_USED) {
+			for (uint32_t k = 0, n = 0; k + 7 <= len && n < dsent; n++) {
+				uint32_t plen = (uint32_t)set[k + 5] << 8 | set[k + 6];
+				r.longSent += (set[k] == 0x39 || set[k] == 0x29 || set[k] == 0x0a) && plen > NDSI_MAX_PAYLOAD;
+				k += 7 + plen;
+			}
+			r.packets = r.sent = dsent;
+			if (negroni_dsi_set_lock != NULL) {
+				IOLockUnlock(negroni_dsi_set_lock);
+			}
+			if (res != NULL) {
+				*res = r;
+			}
+			return rc;
+		}
+		rc = 0;
+		i = resume;
+		r.packets = r.sent = dsent;
+	}
+	while (i + 7 <= len) {
+		uint8_t type = set[i], wait = set[i + 4];
+		uint32_t plen = (uint32_t)set[i + 5] << 8 | set[i + 6];
+		if (plen == 0 || i + 7 + plen > len) {
+			rc = -4;
+			break;
+		}
+		if (type != 0x05 && type != 0x15 && type != 0x39 && type != 0x29 && type != 0x0a) {
+			rc = -5;        /* generic short and read packets are not expected in these sets */
+			break;
+		}
+		bool isLong = type == 0x39 || type == 0x29 || type == 0x0a;
+		if (isLong && plen > NDSI_MAX_PAYLOAD && (flags & NDSI_SET_SKIP_LONG)) {
+			r.skipped++;
+		} else {
+			rc = negroni_dsi_packet(type, set + i + 7, plen, lp);
+			if (rc == 0) {
+				r.sent++;
+				if (isLong && plen > NDSI_MAX_PAYLOAD) {
+					r.longSent++;
+				}
+				if (wait != 0) {
+					IOSleep(wait);
+				}
+			} else if (isLong && plen > NDSI_MAX_PAYLOAD && (flags & NDSI_SET_GO_ON) && !negroni_dsi_dead) {
+				r.longFailed++;
+				first = first != 0 ? first : rc;
+				rc = 0;
+			} else {
+				break;
+			}
+		}
+		r.packets++;
+		i += 7 + plen;
+	}
+	if (negroni_dsi_set_lock != NULL) {
+		IOLockUnlock(negroni_dsi_set_lock);
+	}
+	if (res != NULL) {
+		*res = r;
+	}
+	return rc != 0 ? rc : first;
+}
+
+/* 0259: the set alone; *sent = the packets that went out. */
+extern "C" int
+negroni_dsi_dcs_set(const uint8_t *set, uint32_t len, bool lp, uint32_t *sent)
+{
+	struct negroni_dsi_set_result r;
+	int rc = negroni_dsi_dcs_set_ex(set, len, lp, 0, &r);
+	if (sent != NULL) {
+		*sent = r.sent;
+	}
+	return rc;
+}
+
+/* 0268: one long packet of any data type (the 0x0A PPS after the on-command). */
+extern "C" int
+negroni_dsi_long_packet(uint8_t dt, const uint8_t *buf, uint32_t len, bool lp)
+{
+	if (dt != 0x39 && dt != 0x29 && dt != 0x0a) {
+		return -5;
+	}
+	return negroni_dsi_packet(dt, buf, len, lp);
+}
+
+/* 0292: the DSI0 registers, the lock and the state for bsd/dev/negroni_dsi.c (batched DMA, reads). */
+extern "C" volatile uint32_t *
+negroni_dsi_base(void)
+{
+	return negroni_dsi;
+}
+
+/* Take the DSI lock (not in the panic path); false (lock not held) when the DSI is off or dead. */
+extern "C" bool
+negroni_dsi_enter(void)
+{
+	if (negroni_dsi == NULL) {
+		return false;
+	}
+	if (!negroni_dsi_panic) {
+		IOLockLock(negroni_dsi_lock);
+	}
+	if (negroni_dsi_dead) {
+		if (!negroni_dsi_panic) {
+			IOLockUnlock(negroni_dsi_lock);
+		}
+		return false;
+	}
+	return true;
+}
+
+extern "C" void
+negroni_dsi_leave(void)
+{
+	if (!negroni_dsi_panic) {
+		IOLockUnlock(negroni_dsi_lock);
+	}
+}
+
+extern "C" bool
+negroni_dsi_in_panic(void)
+{
+	return negroni_dsi_panic;
+}
+
+/* 0268's command buffer (NULL: not mapped or a memory DMA failed); *pa = its physical address. */
+extern "C" volatile uint8_t *
+negroni_dsi_cmdbuf(uint64_t *pa)
+{
+	if (negroni_dsi_mem == NULL || negroni_dsi_mem_off) {
+		return NULL;
+	}
+	*pa = NDSI_MEM_PA;
+	return (volatile uint8_t *)negroni_dsi_mem;
+}
+
+/* A memory DMA failed (negroni_dsi.c): 0268's long packets stop using it too. */
+extern "C" void
+negroni_dsi_cmdbuf_failed(void)
+{
+	negroni_dsi_mem_off = true;
+}
