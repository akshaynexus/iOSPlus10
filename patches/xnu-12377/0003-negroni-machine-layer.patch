+
+#define CI_CPUS                 8
+#define CI_STATES               3       /* 0 core rail-pc, 1 cluster l3-off, 2 cluster llcc-off */
+#define PSCI_VERSION            0x84000000ull
+#define PSCI_FEATURES           0x8400000aull
+#define PSCI_CPU_SUSPEND64      0xc4000001ull
+#define PSCI_SET_SUSPEND_MODE   0x8400000full
+#define PSCI_INVALID_PARAMETERS (-2)
+#define PSCI_DENIED             (-3)
+#define PSCI_MODE_OSI           1ull
+#define CI_CL_SKIP              4       /* idles core-only after a DENIED cluster request */
+#define SS_AOP_PHYS             0xc3f0000ull    /* live.dts soc-sleep-stats@c3f0000 */
+#define SS_AOP_WIN              0x10000ull      /* base = 0xc3f0000 | offset word: inside this window */
+#define SS_RECORDS              3
+#define SS_RECORD               32
+#define SS_DDR_MAGIC            0xa1157a75u
+#define SS_DDR_MAX              0x14
+#define SS_CPUSS_CNT_PHYS       0x178c8000ull   /* apss_seq_mem_base 0x178c0000 + 0x8000 (LPM counters) */
+#define SS_CPUSS_RES_PHYS       0x178cc000ull   /* + 0xc000 (residency counters) */
+#define SS_TICKS_PER_MS         19200ull        /* AOP/arch counter 19.2 MHz */
+#define BC_CTL_PHYS             0x17420000ull   /* CNTCTLBase */
+#define BC_FRAME_PHYS           0x17421000ull   /* frame 0, CNTBase0 */
+#define BC_INTID                40              /* frame 0 physical timer: GIC_SPI 8 */
+#define CNTTIDR                 0x08
+#define CNTNSAR                 0x04
+#define CNTACR0                 0x40
+#define CNTACR_ALL              0x3f            /* RPCT RVCT RFRQ RVOFF RWVT RWPT */
+#define CNT_PCT_LO              0x00
+#define CNT_PCT_HI              0x04
+#define CNTP_CVAL_LO            0x20
+#define CNTP_CVAL_HI            0x24
+#define CNTP_CTL                0x2c
+#define CNT_CTL_ENABLE          1u
+#define CNT_CTL_IMASK           2u
+#define CI_SHORT_LIMIT          3
+#define CI_SHORT_SKIP           8
+
+struct ci_state {
+	const char *name;
+	uint32_t param, entry_us, exit_us, residency_us;
+	uint64_t exit_abs, residency_abs;
+};
+
+/* out/live.dts:733-775 */
+static struct ci_state ci_silver = { "silver-c4 rail-pc", 0x40000004, 800, 750, 4090, 0, 0 };
+static struct ci_state ci_gold = { "gold-c4 rail-pc", 0x40000004, 600, 1550, 4791, 0, 0 };
+static struct ci_state ci_l3 = { "cluster-d4 l3-off", 0x41000044, 1050, 2500, 5309, 0, 0 };
+static struct ci_state ci_llcc = { "cluster-e3 llcc-off", 0x4100c344, 2700, 3500, 13959, 0, 0 };
+
+struct ci_cpu {
+	struct ci_state *state[CI_STATES];      /* NULL: not allowed */
+	uint32_t cl_skip;                       /* 0383: idles left without a cluster param */
+	uint32_t index;                         /* the state being entered (CI_STATES: none) */
+	bool down;                              /* between CPU_SUSPEND and its return or resume */
+	uint64_t t0, mpidr;
+	uint32_t shorts, skip;
+	bool refused[CI_STATES];
+	/* counters (this core writes them; the log thread reads) */
+	uint32_t entered[CI_STATES], resumed[CI_STATES], returned[CI_STATES], denied[CI_STATES], early[CI_STATES];
+	uint64_t asleep_abs[CI_STATES];
+	uint32_t bcast_wakes;
+	int64_t last_rc;
+};
+
+static uint32_t ci_level, ci_mask = 0xff, ci_bcast_arg = 1;
+static bool ci_ready;
+/* 0383 */
+static uint32_t ci_llcc_arg, ci_stats_arg = ~0u;
+static bool ci_osi;                             /* SET_SUSPEND_MODE(OSI) accepted */
+static uint32_t ci_all_mask;                    /* cores with a core state */
+static uint32_t ci_down_mask;                   /* cores in or about to enter CPU_SUSPEND (bit per core) */
+static uint64_t ci_pop[CI_CPUS];                /* each core's timer deadline when it went down */
+static uint32_t cl_last, cl_pick[CI_STATES], cl_short, cl_rpmh_busy, cl_denied;
+static uint64_t ci_entry_pa;
+static struct ci_cpu ci[CI_CPUS];
+
+static vm_offset_t bc_ctl, bc_frame;
+static bool bc_on;
+static int64_t bc_off;                          /* frame CNTPCT - CNTVCT_EL0 */
+static uint32_t bc_lock_word;
+static uint64_t bc_wake[CI_CPUS];               /* mach time by which core n must be up (0: none) */
+static uint64_t bc_armed;
+static int bc_target = -1;
+static uint32_t bc_irqs;
+static uint32_t ci_log_event;            /* the log thread's wait event (never woken) */
+
+static int64_t
+ci_psci(uint64_t fn, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+                 "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+                 "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int64_t)(int32_t)x0;
+}
+
+static uint32_t
+bc_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+bc_wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+}
+
+static uint64_t
+bc_pct(void)
+{
+	uint32_t hi, lo;
+
+	do {
+		hi = bc_rd(bc_frame, CNT_PCT_HI);
+		lo = bc_rd(bc_frame, CNT_PCT_LO);
+	} while (hi != bc_rd(bc_frame, CNT_PCT_HI));
+	return (uint64_t)hi << 32 | lo;
+}
+
+static void
+bc_lock(void)
+{
+	while (__atomic_exchange_n(&bc_lock_word, 1, __ATOMIC_ACQUIRE)) {
+		while (__atomic_load_n(&bc_lock_word, __ATOMIC_RELAXED)) {
+			__builtin_arm_yield();
+		}
+	}
+}
+
+static void
+bc_unlock(void)
+{
+	__atomic_store_n(&bc_lock_word, 0, __ATOMIC_RELEASE);
+}
+
+/* bc_lock held: frame 0 fires at the earliest wake time of the cores that are down, at that core */
+static void
+bc_program_locked(void)
+{
+	uint64_t min = 0;
+	int who = -1;
+
+	for (int i = 0; i < CI_CPUS; i++) {
+		if (bc_wake[i] != 0 && (min == 0 || bc_wake[i] < min)) {
+			min = bc_wake[i];
+			who = i;
+		}
+	}
+	if (who < 0) {
+		bc_wr(bc_frame, CNTP_CTL, CNT_CTL_IMASK);
+		bc_armed = 0;
+		return;
+	}
+	if (who != bc_target) {
+		negroni_gic_spi_route(BC_INTID, ci[who].mpidr);
+		bc_target = who;
+	}
+	uint64_t cval = (uint64_t)((int64_t)min + bc_off);
+	bc_wr(bc_frame, CNTP_CTL, CNT_CTL_IMASK);
+	bc_wr(bc_frame, CNTP_CVAL_LO, (uint32_t)cval);
+	bc_wr(bc_frame, CNTP_CVAL_HI, (uint32_t)(cval >> 32));
+	bc_wr(bc_frame, CNTP_CTL, CNT_CTL_ENABLE);
+	__builtin_arm_dsb(DSB_SY);
+	bc_armed = min;
+}
+
+/* The wake timer's SPI (sleh.c, NEGRONI IRQ path, interrupts masked): IPI every core whose time came */
+bool
+negroni_cpuidle_bcast_irq(uint32_t intid)
+{
+	if (intid != BC_INTID || !bc_on) {
+		return false;
+	}
+	int self = getCpuDatap()->cpu_number;
+
+	bc_lock();
+	bc_irqs++;
+	bc_wr(bc_frame, CNTP_CTL, CNT_CTL_IMASK);
+	bc_armed = 0;
+	uint64_t now = mach_absolute_time();
+	for (int i = 0; i < CI_CPUS; i++) {
+		if (bc_wake[i] != 0 && bc_wake[i] <= now + ci_silver.exit_abs / 4) {
+			bc_wake[i] = 0;
+			ci[i].bcast_wakes++;
+			if (i != self) {
+				(void)cpu_signal(cpu_datap(i), SIGPnop, NULL, NULL);
+			}
+		}
+	}
+	bc_program_locked();
+	bc_unlock();
+	return true;
+}
+
+static void
+bc_leave(int n)
+{
+	if (!bc_on) {
+		return;
+	}
+	bc_lock();
+	bc_wake[n] = 0;                 /* the timer may still fire for it once: the handler finds nothing */
+	bc_unlock();
+}
+
+/*
+ * The deepest allowed state whose residency fits before the next timer deadline.
+ * 0383: a cluster state (1, 2) needs (a) in OSI mode: this core is the last one up and the earliest deadline of all
+ * cores fits (Linux genpd: the cluster's next wakeup = the earliest of its CPUs'); (b) RPMh idle with current
+ * SLEEP/WAKE sets (Linux rpmh_rsc_pd_cb); (c) no DENIED backoff.
+ */
+static uint32_t
+ci_pick(struct ci_cpu *c, int n, uint64_t now, uint64_t pop, uint32_t down_before)
+{
+	if (pop <= now) {
+		return CI_STATES;
+	}
+	uint64_t left = pop - now;
+	if (c->state[0] == NULL || c->refused[0] || left < c->state[0]->residency_abs) {
+		return CI_STATES;
+	}
+	if (c->state[1] == NULL) {
+		return 0;
+	}
+	if (c->cl_skip) {
+		c->cl_skip--;
+		return 0;
+	}
+	uint64_t cl_left = left;
+	if (ci_osi) {
+		uint32_t others = ci_all_mask & ~(1u << n);
+		if ((down_before & others) != others) {
+			return 0;
+		}
+		__atomic_fetch_add(&cl_last, 1, __ATOMIC_RELAXED);
+		for (int i = 0; i < CI_CPUS; i++) {
+			if (!(others & (1u << i))) {
+				continue;
+			}
+			uint64_t p = ci_pop[i];
+			if (p <= now) {
+				cl_left = 0;
+				break;
+			}
+			if (p - now < cl_left) {
+				cl_left = p - now;
+			}
+		}
+	}
+	for (int s = CI_STATES - 1; s >= 1; s--) {
+		if (c->state[s] != NULL && !c->refused[s] && cl_left >= c->state[s]->residency_abs) {
+			if (negroni_rpmh_sleep_ready == NULL || !negroni_rpmh_sleep_ready()) {
+				__atomic_fetch_add(&cl_rpmh_busy, 1, __ATOMIC_RELAXED);
+				return 0;
+			}
+			__atomic_fetch_add(&cl_pick[s], 1, __ATOMIC_RELAXED);
+			return (uint32_t)s;
+		}
+	}
+	if (ci_osi) {
+		__atomic_fetch_add(&cl_short, 1, __ATOMIC_RELAXED);
+	}
+	return 0;
+}
+
+/* cpu_idle(), interrupts masked, in place of the WFI */
+void
+negroni_cpuidle_idle(void)
+{
+	cpu_data_t *cdp = getCpuDatap();
+	int n = cdp->cpu_number;
+
+	if (!ci_ready || n < 0 || n >= CI_CPUS || ci[n].state[0] == NULL) {
+		__builtin_arm_dsb(DSB_SY);
+		__builtin_arm_wfi();
+		return;
+	}
+	struct ci_cpu *c = &ci[n];
+	uint64_t now = mach_absolute_time();
+	uint32_t s = CI_STATES;
+
+	if (c->skip) {
+		c->skip--;
+	} else {
+		/*
+		 * 0383: this core counts as down before it picks. The atomic OR orders the cores that go idle at the same time:
+		 * exactly one of them sees every other bit set (the last core). With a load after the pick, two cores that
+		 * pick together would both see the other one up and the cluster would stay on for that whole idle period.
+		 */
+		ci_pop[n] = cdp->rtcPop;
+		uint32_t down_before = __atomic_fetch_or(&ci_down_mask, 1u << n, __ATOMIC_ACQ_REL);
+		s = ci_pick(c, n, now, cdp->rtcPop, down_before);
+		if (s == CI_STATES) {
+			__atomic_fetch_and(&ci_down_mask, ~(1u << n), __ATOMIC_RELEASE);
+		}
+	}
+	if (s == CI_STATES) {
+		__builtin_arm_dsb(DSB_SY);
+		__builtin_arm_wfi();
+		return;
+	}
+	struct ci_state *st = c->state[s];
+	if (bc_on) {
+		uint64_t wake = cdp->rtcPop > st->exit_abs ? cdp->rtcPop - st->exit_abs : cdp->rtcPop;
+		bc_lock();
+		bc_wake[n] = wake;
+		if (bc_armed == 0 || wake < bc_armed) {
+			bc_program_locked();
+		}
+		bc_unlock();
+	}
+	c->index = s;
+	c->t0 = now;
+	c->entered[s]++;
+	c->down = true;
+	/* the resume path reads this core's record before its caches are back: clean it to the point of coherency */
+	for (uintptr_t a = (uintptr_t)c & ~(uintptr_t)63; a < (uintptr_t)c + sizeof(*c); a += 64) {
+		__asm__ volatile ("dc cvac, %0" : : "r"(a) : "memory");
+	}
+	__builtin_arm_dsb(DSB_SY);
+	int64_t rc = ci_psci(PSCI_CPU_SUSPEND64, st->param, ci_entry_pa, (uint64_t)n);
+	/* returned: no power-down (a pending interrupt, or the firmware said no) */
+	__atomic_fetch_and(&ci_down_mask, ~(1u << n), __ATOMIC_RELEASE);
+	c->down = false;
+	c->last_rc = rc;
+	if (rc == 0) {
+		c->returned[s]++;
+	} else {
+		c->denied[s]++;
+		if (rc == PSCI_INVALID_PARAMETERS) {
+			c->refused[s] = true;   /* this param is not the firmware's: never again on this core */
+		} else if (rc == PSCI_DENIED && s >= 1) {
+			__atomic_fetch_add(&cl_denied, 1, __ATOMIC_RELAXED);
+			c->cl_skip = CI_CL_SKIP; /* 0383: OSI view raced with a waking core: core-only for a few idles */
+		}
+	}
+	bc_leave(n);
+}
+
+/* cpu_idle_exit(TRUE): the core came back through the reset vector (interrupts masked, MMU on) */
+void
+negroni_cpuidle_resume(void)
+{
+	cpu_data_t *cdp = getCpuDatap();
+	int n = cdp->cpu_number;
+
+	if (n < 0 || n >= CI_CPUS || !ci[n].down) {
+		return;
+	}
+	struct ci_cpu *c = &ci[n];
+	uint32_t s = c->index < CI_STATES ? c->index : 0;
+
+	__atomic_fetch_and(&ci_down_mask, ~(1u << n), __ATOMIC_RELEASE);  /* 0383 */
+	PE_init_cpu();                  /* GIC redistributor wake + CPU interface (lost with the core) */
+	setPop(cdp->rtcPop);            /* the virtual timer's compare value was lost too */
+	uint64_t slept = mach_absolute_time() - c->t0;
+	c->down = false;
+	c->resumed[s]++;
+	c->asleep_abs[s] += slept;
+	if (slept < c->state[s]->residency_abs) {
+		c->early[s]++;
+		if (++c->shorts >= CI_SHORT_LIMIT) {
+			c->shorts = 0;
+			c->skip = CI_SHORT_SKIP;
+		}
+	} else {
+		c->shorts = 0;
+	}
+	bc_leave(n);
+}
+
+/*
+ * 0383: read-only sleep statistics (Linux soc_sleep_stats.c rpmh_data + DDR stats, qcom_cpuss_sleep_stats.c v1).
+ * Only 32-bit loads; a 64-bit counter is read as low word, high word (an update in between can give one odd
+ * sample, the next line corrects it).
+ */
+static vm_offset_t ss_aop, ss_ddr, ss_cnt, ss_res;
+static uint32_t ss_ddr_n;
+static uint32_t ss_prev_cnt[SS_RECORDS];
+static uint64_t ss_prev_acc[SS_RECORDS];
+static uint32_t ss_prev_ddr[SS_DDR_MAX];
+static uint64_t ss_prev_c4[CI_CPUS + 1], ss_prev_res[CI_CPUS + 1];
+
+static uint64_t
+ss_rd64(vm_offset_t base, uint32_t off)
+{
+	return (uint64_t)bc_rd(base, off + 4) << 32 | bc_rd(base, off);
+}
+
+/*
+ * A stats page may be outside the HLOS VM's stage-2 map (Gunyah injects a synchronous external abort): the first
+ * and the last word of each region are read with the 0297 try-accessor (sleh.c) first; a refused region stays off.
+ * negroni_mmio_try_rd32 returns -2 without an access on kernels without CONFIG_XNUPOST: then the stats stay off.
+ */
+static bool
+ss_probe(vm_offset_t base, uint32_t first, uint32_t last)
+{
+	uint32_t v;
+
+	return base != 0 && negroni_mmio_try_rd32(base + first, &v) == 0 && negroni_mmio_try_rd32(base + last, &v) == 0;
+}
+
+static void
+ss_start(void)
+{
+	if (ci_stats_arg & 3) {
+		vm_offset_t hdr = ml_io_map(SS_AOP_PHYS, 0x20);
+		uint32_t off = 0, doff = 0;
+		if (hdr == 0 || negroni_mmio_try_rd32(hdr + 0x4, &off) != 0 || negroni_mmio_try_rd32(hdr + 0x1c, &doff) != 0) {
+			printf("NEGRONI CPUIDLE: sleep stats header at 0x%llx not readable (try faults %u): AOP/DDR stats off\n",
+			    SS_AOP_PHYS, negroni_mmio_try_faults);
+			off = doff = 0;
+		}
+		/* Linux: stats_base = res->start | readl(res->start + 4); the word may hold the full address or the offset */
+		if ((off & ~(uint32_t)(SS_AOP_WIN - 1)) == SS_AOP_PHYS) {
+			off &= (uint32_t)(SS_AOP_WIN - 1);
+		}
+		if ((doff & ~(uint32_t)(SS_AOP_WIN - 1)) == SS_AOP_PHYS) {
+			doff &= (uint32_t)(SS_AOP_WIN - 1);
+		}
+		if ((ci_stats_arg & 1) && off != 0 && (off & 3) == 0 && off <= SS_AOP_WIN - SS_RECORDS * SS_RECORD) {
+			vm_offset_t a = ml_io_map(SS_AOP_PHYS | off, SS_RECORDS * SS_RECORD);
+			ss_aop = ss_probe(a, 0, SS_RECORDS * SS_RECORD - 4) ? a : 0;
+		}
+		if ((ci_stats_arg & 2) && doff != 0 && (doff & 3) == 0 && doff <= SS_AOP_WIN - (8 + SS_DDR_MAX * 16)) {
+			vm_offset_t d = ml_io_map(SS_AOP_PHYS | doff, 8 + SS_DDR_MAX * 16);
+			bool readable = ss_probe(d, 0, 8 + SS_DDR_MAX * 16 - 4);
+			uint32_t magic = readable ? bc_rd(d, 0) : 0, num = readable ? bc_rd(d, 4) : 0;
+			if (magic == SS_DDR_MAGIC && num > 0) {
+				ss_ddr = d;
+				ss_ddr_n = num < SS_DDR_MAX ? num : SS_DDR_MAX;
+			}
+			printf("NEGRONI CPUIDLE: DDR stats at 0x%llx: %s magic %#x, %u entries%s\n", SS_AOP_PHYS | doff,
+			    readable ? "readable," : "NOT readable,", magic, num, ss_ddr ? "" : ": not used");
+		}
+		printf("NEGRONI CPUIDLE: rpmh sleep stats at 0x%llx (offset word %#x)%s\n", SS_AOP_PHYS | off, off,
+		    ss_aop ? "" : ": not used");
+	}
+	if (ci_stats_arg & 4) {
+		vm_offset_t cnt = ml_io_map(SS_CPUSS_CNT_PHYS, 0x200), res = ml_io_map(SS_CPUSS_RES_PHYS, 0x200);
+		/* ss_log reads C4 0xd8 + 8n and residency 0xd0 + 8n, n = 0..CI_CPUS, 64 bit each */
+		if (ss_probe(cnt, 0xd8, 0xd8 + 8 * CI_CPUS + 4) && ss_probe(res, 0xd0, 0xd0 + 8 * CI_CPUS + 4)) {
+			ss_cnt = cnt;
+			ss_res = res;
+		} else {
+			printf("NEGRONI CPUIDLE: cpuss counters at 0x%llx not readable (try faults %u): off\n", SS_CPUSS_CNT_PHYS,
+			    negroni_mmio_try_faults);
+		}
+	}
+}
+
+/* every 60 s from the log thread */
+static void
+ss_log(void)
+{
+	if (ss_aop) {
+		char line[256];
+		int len = 0;
+		for (int i = 0; i < SS_RECORDS; i++) {
+			uint32_t b = (uint32_t)(i * SS_RECORD), type = bc_rd(ss_aop, b), cnt = bc_rd(ss_aop, b + 4);
+			uint64_t acc = ss_rd64(ss_aop, b + 0x18);
+			char name[5];
+			for (int k = 0; k < 4; k++) {
+				char ch = (char)(type >> (8 * k));
+				name[k] = (ch >= 0x20 && ch < 0x7f) ? ch : '.';
+			}
+			name[4] = 0;
+			len += snprintf(line + len, sizeof(line) - (size_t)len, "%s%s count %u (+%u) time %llu ms (+%llu ms)",
+			    i ? ", " : "", name, cnt, cnt - ss_prev_cnt[i], acc / SS_TICKS_PER_MS,
+			    (acc - ss_prev_acc[i]) / SS_TICKS_PER_MS);
+			if (len >= (int)sizeof(line)) {
+				len = (int)sizeof(line) - 1;
+			}
+			ss_prev_cnt[i] = cnt;
+			ss_prev_acc[i] = acc;
+		}
+		printf("NEGRONI CPUIDLE: rpmh stats (aosd = AOSS sleep / XO off, cxsd = CX collapse): %s\n", line);
+	}
+	if (ss_ddr) {
+		char line[256];
+		int len = 0;
+		for (uint32_t i = 0; i < ss_ddr_n; i++) {
+			uint32_t b = 8 + 16 * i, name = bc_rd(ss_ddr, b), cnt = bc_rd(ss_ddr, b + 4);
+			if (((name >> 8) & 0xff) != 0) {
+				continue;       /* frequency rows: not an LPM mode */
+			}
+			len += snprintf(line + len, sizeof(line) - (size_t)len, " lpm%#x %u (+%u)", name & 0xff, cnt,
+			    cnt - ss_prev_ddr[i]);
+			if (len >= (int)sizeof(line)) {
+				len = (int)sizeof(line) - 1;
+			}
+			ss_prev_ddr[i] = cnt;
+		}
+		printf("NEGRONI CPUIDLE: ddr stats:%s\n", len ? line : " no LPM rows");
+	}
+	if (ss_cnt && ss_res) {
+		char line[320];
+		int len = 0;
+		for (int i = 0; i <= CI_CPUS; i++) {
+			uint64_t c4 = ss_rd64(ss_cnt, 0xd8 + 8 * (uint32_t)i), res = ss_rd64(ss_res, 0xd0 + 8 * (uint32_t)i);
+			len += snprintf(line + len, sizeof(line) - (size_t)len, " %s%d %llu (+%llu, res +%llu)",
+			    i < CI_CPUS ? "C4 cpu" : "D4 cluster", i < CI_CPUS ? i : 0, c4, c4 - ss_prev_c4[i],
+			    res - ss_prev_res[i]);
+			if (len >= (int)sizeof(line)) {
+				len = (int)sizeof(line) - 1;
+			}
+			ss_prev_c4[i] = c4;
+			ss_prev_res[i] = res;
+		}
+		printf("NEGRONI CPUIDLE: cpuss hw counters (0 = counting off or never entered):%s\n", line);
+	}
+}
+
+static void
+ci_log(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t entered[CI_CPUS][CI_STATES] = {{ 0 }}, resumed[CI_CPUS][CI_STATES] = {{ 0 }};
+	uint64_t asleep[CI_CPUS][CI_STATES] = {{ 0 }}, last = mach_absolute_time();
+
+	for (uint32_t round = 0;; round++) {
+		assert_wait_timeout((event_t)&ci_log_event, THREAD_UNINT, round == 0 ? 10 : 60, NSEC_PER_SEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		uint64_t now = mach_absolute_time(), span_ns;
+		absolutetime_to_nanoseconds(now - last, &span_ns);
+		last = now;
+		for (int n = 0; n < CI_CPUS; n++) {
+			struct ci_cpu *c = &ci[n];
+			for (int s = 0; s < CI_STATES; s++) {
+				if (c->state[s] == NULL) {
+					continue;
+				}
+				uint64_t ns;
+				absolutetime_to_nanoseconds(c->asleep_abs[s] - asleep[n][s], &ns);
+				printf("NEGRONI CPUIDLE: cpu%d state %d param %#x (%s) entered %u times (+%u in %llu s): resumed %u (+%u), "
+				    "returned %u, denied %u (last rc %lld)%s, short %u, down %llu ms (%llu%%), bcast wakes %u\n", n, s + 1,
+				    c->state[s]->param, c->state[s]->name, c->entered[s], c->entered[s] - entered[n][s], span_ns / NSEC_PER_SEC,
+				    c->resumed[s], c->resumed[s] - resumed[n][s], c->returned[s], c->denied[s], c->last_rc,
+				    c->refused[s] ? " REFUSED" : "", c->early[s], ns / NSEC_PER_MSEC, span_ns ? ns * 100 / span_ns : 0,
+				    c->bcast_wakes);
+				entered[n][s] = c->entered[s];
+				resumed[n][s] = c->resumed[s];
+				asleep[n][s] = c->asleep_abs[s];
+			}
+		}
+		if (bc_on) {
+			printf("NEGRONI CPUIDLE: wake timer: %u interrupts, armed %s, target cpu%d\n", bc_irqs, bc_armed ? "yes" : "no",
+			    bc_target);
+		}
+		if (ci_level >= 2) {
+			printf("NEGRONI CPUIDLE: cluster (%s): last-core chances %u, l3-off picks %u, llcc-off picks %u, too short %u, "
+			    "rpmh busy %u, denied %u\n", ci_osi ? "OSI" : "PC", cl_last, cl_pick[1], cl_pick[2], cl_short, cl_rpmh_busy,
+			    cl_denied);
+			if (negroni_rpmh_sleep_log != NULL) {
+				negroni_rpmh_sleep_log();
+			}
+		}
+		ss_log();
+	}
+}
+
+/* 0383: level 0 with negronicpuidle_stats: only the statistics, every 60 s (the WFI-only baseline) */
+__dead2 static void
+ss_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	for (;;) {
+		assert_wait_timeout((event_t)&ci_log_event, THREAD_UNINT, 60, NSEC_PER_SEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		ss_log();
+	}
+}
+
+/* frame 0 of the memory-mapped timer as the wake source (Linux arch_timer_mem_frame + arch_timer_mem_find_best_frame) */
+static bool
+bc_start(void)
+{
+	bc_ctl = ml_io_map(BC_CTL_PHYS, 0x1000);
+	bc_frame = ml_io_map(BC_FRAME_PHYS, 0x1000);
+	if (bc_ctl == 0 || bc_frame == 0) {
+		printf("NEGRONI CPUIDLE: wake timer: cannot map 0x%llx/0x%llx\n", BC_CTL_PHYS, BC_FRAME_PHYS);
+		return false;
+	}
+	uint32_t tidr = bc_rd(bc_ctl, CNTTIDR), nsar = bc_rd(bc_ctl, CNTNSAR);
+	bc_wr(bc_ctl, CNTACR0, CNTACR_ALL);
+	uint32_t acr = bc_rd(bc_ctl, CNTACR0);
+	bc_wr(bc_frame, CNTP_CTL, CNT_CTL_IMASK);
+	uint32_t ctl = bc_rd(bc_frame, CNTP_CTL);
+	uint64_t vct0 = mach_absolute_time(), pct = bc_pct(), vct1 = mach_absolute_time();
+	bc_off = (int64_t)(pct - (vct0 + (vct1 - vct0) / 2));
+	bool ok = (tidr & 1) != 0 && (acr & 0x21) == 0x21 && (ctl & 3) == CNT_CTL_IMASK && pct != 0;
+	printf("NEGRONI CPUIDLE: wake timer frame 0 at 0x%llx: CNTTIDR %#x CNTNSAR %#x CNTACR0 %#x CTL %#x, CNTPCT - CNTVCT = %lld ticks: %s\n",
+	    BC_FRAME_PHYS, tidr, nsar, acr, ctl, bc_off, ok ? "usable, INTID 40" : "NOT USABLE");
+	if (!ok) {
+		return false;
+	}
+	negroni_gic_spi_enable(BC_INTID, ci[0].mpidr);
+	bc_target = 0;
+	return true;
+}
+
+/* NegroniCPU::startAll, after every core runs (thread context) */
+void
+negroni_cpuidle_init(void)
+{
+	(void)PE_parse_boot_argn("negronicpuidle", &ci_level, sizeof(ci_level));
+	(void)PE_parse_boot_argn("negronicpuidle_mask", &ci_mask, sizeof(ci_mask));
+	(void)PE_parse_boot_argn("negronicpuidle_bcast", &ci_bcast_arg, sizeof(ci_bcast_arg));
+	(void)PE_parse_boot_argn("negronicpuidle_llcc", &ci_llcc_arg, sizeof(ci_llcc_arg));
+	(void)PE_parse_boot_argn("negronicpuidle_stats", &ci_stats_arg, sizeof(ci_stats_arg));
+	if (ci_stats_arg == ~0u) {
+		ci_stats_arg = ci_level >= 1 ? 7 : 0;  /* 0383 default: the stats with the PSCI levels only */
+	}
+	if (ci_level > 3) {
+		ci_level = 3;
+	}
+	if (ci_level == 0) {
+		printf("NEGRONI CPUIDLE: level 0: WFI only (negronicpuidle=1 core, 2 + cluster PC, 3 + cluster OSI)%s\n",
+		    ci_stats_arg ? ", sleep stats every 60 s" : "");
+		if (ci_stats_arg) {
+			ss_start();
+			thread_t st;
+			if (kernel_thread_start(ss_thread, NULL, &st) == KERN_SUCCESS) {
+				thread_deallocate(st);
+			}
+		}
+		return;
+	}
+	int64_t ver = ci_psci(PSCI_VERSION, 0, 0, 0);
+	int64_t feat = ci_psci(PSCI_FEATURES, PSCI_CPU_SUSPEND64, 0, 0);
+	int64_t mode = ci_psci(PSCI_FEATURES, PSCI_SET_SUSPEND_MODE, 0, 0);
+	printf("NEGRONI CPUIDLE: PSCI version %lld.%lld, CPU_SUSPEND features %#llx (%s StateID, OSI %s), SET_SUSPEND_MODE %s: "
+	    "platform-coordinated mode (the PSCI default) is kept\n", ver >> 16, ver & 0xffff, feat,
+	    feat < 0 ? "?" : (feat & 2) ? "extended" : "original", feat < 0 ? "?" : (feat & 1) ? "supported" : "no",
+	    mode == 0 ? "present" : "absent");
+	/* PSCI 1.0 FEATURES(CPU_SUSPEND): bit 1 = extended StateID, bit 0 = OS-initiated (Linux uapi psci.h:99-103) */
+	if (feat < 0 || !(feat & 2)) {
+		printf("NEGRONI CPUIDLE: CPU_SUSPEND %s: the DT params are in the extended StateID format: WFI only\n",
+		    feat < 0 ? "is not offered" : "uses the original StateID format");
+		return;
+	}
+	struct ci_state *all[] = { &ci_silver, &ci_gold, &ci_l3, &ci_llcc };
+	for (unsigned i = 0; i < sizeof(all) / sizeof(all[0]); i++) {
+		nanoseconds_to_absolutetime((uint64_t)all[i]->exit_us * NSEC_PER_USEC, &all[i]->exit_abs);
+		nanoseconds_to_absolutetime((uint64_t)all[i]->residency_us * NSEC_PER_USEC, &all[i]->residency_abs);
+	}
+	const ml_topology_info_t *topo = ml_get_topology_info();
+	for (unsigned i = 0; i < topo->num_cpus && i < CI_CPUS; i++) {
+		const ml_topology_cpu_t *t = &topo->cpus[i];
+		if (t->cpu_id >= CI_CPUS) {
+			continue;
+		}
+		struct ci_cpu *c = &ci[t->cpu_id];
+		c->mpidr = t->phys_id;
+		c->index = CI_STATES;
+		if (!(ci_mask & (1u << t->cpu_id))) {
+			continue;
+		}
+		c->state[0] = ((t->phys_id >> 8) & 0xff) < 4 ? &ci_silver : &ci_gold;     /* MPIDR Aff1 0-3: the A510s */
+		if (ci_level >= 2) {
+			c->state[1] = &ci_l3;
+			c->state[2] = ci_llcc_arg ? &ci_llcc : NULL;   /* 0383: llcc-off only with negronicpuidle_llcc=1 */
+		}
+		ci_all_mask |= 1u << t->cpu_id;
+	}
+	/* 0383: OS-initiated mode (Linux psci_set_osi_mode), while every other core is still in WFI (ci_ready false) */
+	if (ci_level >= 3) {
+		if (ci_all_mask != (1u << topo->num_cpus) - 1u) {
+			printf("NEGRONI CPUIDLE: OSI needs every core in negronicpuidle_mask (%#x): PC mode\n", ci_all_mask);
+		} else if (!(feat & 1)) {
+			printf("NEGRONI CPUIDLE: OSI not offered (CPU_SUSPEND features %#llx): PC mode\n", feat);
+		} else {
+			int64_t rc = ci_psci(PSCI_SET_SUSPEND_MODE, PSCI_MODE_OSI, 0, 0);
+			ci_osi = rc == 0;
+			printf("NEGRONI CPUIDLE: SET_SUSPEND_MODE(OSI) rc %lld: %s\n", rc, ci_osi ? "OS-initiated mode" :
+			    "PC mode kept");
+		}
+	}
+	ci_entry_pa = ml_static_vtop((vm_offset_t)&negroni_secondary_entry);
+	bc_on = ci_bcast_arg != 0 && bc_start();
+	if (ci_bcast_arg != 0 && !bc_on) {
+		printf("NEGRONI CPUIDLE: no wake timer: WFI only (negronicpuidle_bcast=0 would power down without it)\n");
+		return;
+	}
+	printf("NEGRONI CPUIDLE: level %u, cores %#x (of %u), entry 0x%llx, wake timer %s; silver param %#x (exit %u us, residency %u us), "
+	    "gold param %#x (exit %u us, residency %u us)%s\n", ci_level, ci_mask, topo->num_cpus, ci_entry_pa, bc_on ? "on" : "OFF",
+	    ci_silver.param, ci_silver.exit_us, ci_silver.residency_us, ci_gold.param, ci_gold.exit_us, ci_gold.residency_us,
+	    ci_level >= 2 ? (ci_llcc_arg ? ", cluster l3-off 0x41000044 (>= 5309 us), llcc-off 0x4100c344 (>= 13959 us)" :
+	    ", cluster l3-off 0x41000044 (>= 5309 us), llcc-off off (negronicpuidle_llcc=1)") : "");
+	ss_start();
+	__atomic_store_n(&ci_ready, true, __ATOMIC_RELEASE);
+	thread_t thread;
+	if (kernel_thread_start(ci_log, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* NEGRONI */
diff --git a/osfmk/arm64/negroni_early.c b/osfmk/arm64/negroni_early.c
new file mode 100644
index 0000000..5cb1a28
--- /dev/null
+++ b/osfmk/arm64/negroni_early.c
@@ -0,0 +1,143 @@
+/*
+ * OnePlus 10 Pro 5G bootstrap console. No allocation, locks, ADT parsing or
+ * per-CPU state: panic() can reach this before a current thread exists.
+ * start.s maps the splash framebuffer VA=PA as Normal Non-Cacheable memory.
+ * arm_vm_init installs a reserved kernel VA alias before removing TTBR0;
+ * retain this console until the normal framebuffer serial console is ready.
+ */
+#include <arm64/negroni_early.h>
+
+#if defined(NEGRONI)
+#include <stdint.h>
+#include <kern/misc_protos.h>
+
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0xb8000000;   /* Mu GOP framebuffer ("Display Reserved") */
+#define EARLY_FB early_fb
+#define EARLY_WIDTH 1080u
+#define EARLY_HEIGHT 2412u
+#define EARLY_STRIDE (4320u / 4)
+#define EARLY_SCALE 2u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
+#define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+
+extern unsigned char iso_font[256 * 16];
+
+/* Initialized data must remain writable until disable, including panics. */
+static unsigned int early_row, early_col;
+static unsigned int early_started, early_disabled, early_panicking;
+
+static void
+negroni_early_clear_row(void)
+{
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
+		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+			line[x] = 0xff000000u;
+		}
+	}
+}
+
+void
+negroni_early_putc(char c)
+{
+	if (early_disabled) {
+		return;
+	}
+	if (!early_started) {
+		early_started = 1;
+		negroni_early_clear_row();
+	}
+	if (c == '\r') {
+		early_col = 0;
+		return;
+	}
+	if (c == '\n' || early_col == EARLY_COLS) {
+		early_col = 0;
+		early_row = (early_row + 1) % EARLY_ROWS;
+		negroni_early_clear_row();
+		if (c == '\n') {
+			return;
+		}
+	}
+	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+			volatile uint32_t *line = EARLY_FB +
+			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
+			    early_col * EARLY_CELL_W;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0xffffffffu : 0xff000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					line[gx * EARLY_SCALE + sx] = pixel;
+				}
+			}
+		}
+	}
+	early_col++;
+}
+
+static void
+negroni_early_string(const char *s)
+{
+	while (*s) {
+		negroni_early_putc(*s++);
+	}
+}
+
+void
+negroni_early_mark(unsigned int stage, const char *label)
+{
+	if (early_disabled || stage > 20) {
+		return;
+	}
+	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+			EARLY_FB[y * EARLY_STRIDE + x] = color;
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	negroni_early_string("NEGRONI EARLY ");
+	if (stage >= 10) {
+		negroni_early_putc((char)('0' + stage / 10));
+	}
+	negroni_early_putc((char)('0' + stage % 10));
+	negroni_early_string(": ");
+	negroni_early_string(label);
+	negroni_early_putc('\n');
+}
+
+void
+negroni_early_panic(const char *fmt, va_list *args)
+{
+	if (early_disabled || early_panicking) {
+		return;
+	}
+	early_panicking = 1;
+	negroni_early_string("\nNEGRONI EARLY PANIC: ");
+	va_list copy;
+	va_copy(copy, *args);
+	_doprnt(fmt, &copy, negroni_early_putc, 16);
+	va_end(copy);
+	negroni_early_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+negroni_early_relocate(uint64_t base)
+{
