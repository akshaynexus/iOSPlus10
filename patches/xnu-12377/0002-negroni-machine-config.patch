diff --git a/pexpert/pexpert/arm64/NEGRONI.h b/pexpert/pexpert/arm64/NEGRONI.h
new file mode 100644
index 0000000..5842a2c
--- /dev/null
+++ b/pexpert/pexpert/arm64/NEGRONI.h
@@ -0,0 +1,87 @@
+/*
+ * Board config for the OnePlus 10 Pro 5G ("negroni", Qualcomm SM8450 / Snapdragon 8 Gen 1):
+ * 1x Cortex-X2 + 3x Cortex-A710 + 4x Cortex-A510, ARMv9.0 (FEAT_PAuth present, Android reports
+ * "paca pacg"). XNU runs at EL1 under the Gunyah hypervisor (EL2).
+ *
+ * xnu-12377 (iOS 26) port. Same shape as the iOS 16 (xnu-8796) NEGRONI board: generic ARM like
+ * BCM2837 (no APPLE_ARM64_ARCH_FAMILY: none of Apple's implementation-defined system registers
+ * exist), 16K pages and GICv3 like VMAPPLE. The GIC has two security states: Group 0 belongs to
+ * TrustZone, so every interrupt, including the timer, is a Group 1 IRQ taken through sleh_irq().
+ *
+ * Stage 1 (default): plain arm64 kernel at an ARMv8.2 baseline, no PAC.
+ * Stage 2 (NEGRONI_ARM64E=1): arm64e kernel with the architected PAC instructions; the keys are
+ * written natively (no hvc, unlike VMAPPLE's HAS_PARAVIRTUALIZED_PAC). See docs/ios26-port-status.md.
+ */
+
+#ifndef _PEXPERT_ARM64_NEGRONI_H
+#define _PEXPERT_ARM64_NEGRONI_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define NEGRONI                   1
+
+/* All eight cores as one homogeneous SMP cluster (no AMP P/E clusters yet). */
+#define NEGRONI_SMP_MAX_CPUS      8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
+#define HAS_GIC_V3                1
+
+#if defined(NEGRONI_ARM64E) && NEGRONI_ARM64E
+/* Architected PAC (FEAT_PAuth) with natively written keys; not the Apple PAC MSRs of A12+. */
+#define CPU_HAS_APPLE_PAC         1
+#define HAS_NATIVE_ARM_PAC        1
+#endif
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif /* ! ASSEMBLER */
+
+/*
+ * Qualcomm numbers the architected timer PPIs 1/2/3/0 (secure phys, phys, virt, hyp) instead of
+ * the usual 13/14/11/10: the virtual timer XNU uses (CNTV) is INTID 16 + 3 = 19.
+ */
+#define NEGRONI_VTIMER_INTID      19
+#define NEGRONI_IPI_SGI           1       // SGI used for cross-CPU signals
+
+#define GIC_SPURIOUS_IRQ          1023    // IRQ no. for GIC spurious interrupt
+
+#define GICR_PE_SIZE              0x20000 // Size of each redistributor region
+
+/* GICv3 register definitions; see GICv3 spec (Arm IHI 0069G) */
+#define GICD_CTLR                 0x0
+
+/* Non-secure view of GICD_CTLR (DS=0) */
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+
+#define GICR_TYPER                              0x08
+#define GICR_WAKER                              0x14
+#define GICR_IGROUPR0                           0x10080
+#define GICR_ISENABLER0                         0x10100
+#define GICR_IPRIORITYR0                        0x10400
+
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT         32
+#define GICR_TYPER_LAST                         0x10
+
+#define GICR_WAKER_PROCESSORSLEEP               0x2
+#define GICR_WAKER_CHILDRENASLEEP               0x4
+
+#define ICC_CTLR_EOIMODE                        0x2
+
+#define ICC_SRE_SRE                             0x1
+/* End of GICv3 register definitions */
+
+#endif /* ! _PEXPERT_ARM64_NEGRONI_H */
