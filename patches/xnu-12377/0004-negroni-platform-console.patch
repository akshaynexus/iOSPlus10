diff --git a/osfmk/kern/negroni_top.c b/osfmk/kern/negroni_top.c
new file mode 100644
index 0000000..f84734a
--- /dev/null
+++ b/osfmk/kern/negroni_top.c
@@ -0,0 +1,342 @@
+/*
+ * NEGRONI (SM8450) "top" in the kernel log, patch 0382 (patches/xnu/README-power-idle.md).
+ *
+ * Why: the 0284 CPUFREQ line gives the busiest core of a domain, mostly at the moments a row changes
+ * (a biased sample), and nothing tells WHICH thread uses the CPU or how often the cores wake. Every
+ * negronitop seconds (default 60; 0 = off) one kernel thread prints:
+ *
+ *   NEGRONI TOP 60 s dark 1: busy% 3 1 0 0 0 0 0 0 | irq/s 1012 40 12 9 3 3 2 2 | timer/s ... | ipi/s ...
+ *   NEGRONI TOP procs: kernel_task 4.1%, backboardd[58] 0.9%, ...
+ *   NEGRONI TOP thr 3.0% kernel_task tid 123 "name" st 0x1 lr 0x... 0x... 0x... 0x... 0x...
+ *
+ * busy% per CPU = (user + system) / (user + system + idle) time of that processor over the window
+ * (recount_processor_usage, the same counters as host_statistics). irq/s = cpu_stat.irq_ex_cnt
+ * (every IRQ exception: device interrupts, the timer, IPIs), timer/s = cpu_stat.timer_cnt, ipi/s =
+ * cpu_stat.ipi_cnt: the wakeups. Threads: CPU time in the window (recount_thread_time_mach) in % of one
+ * core, top NT_TOP; for a kernel_task thread the first return addresses of its kernel stack (unslid:
+ * scripts/debug/panic-symbolize.sh -a ADDR...), which name the polling loop it sleeps in.
+ * Cost: one pass over the thread list per window under tasks_threads_lock (about 1-3 ms).
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NEGRONI)
+#include <stdint.h>
+#include <stdbool.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <kern/processor.h>
+#include <kern/recount.h>
+#include <kern/sched_prim.h>
+#include <kern/misc_protos.h>
+#include <mach/mach_time.h>
+#include <machine/machine_routines.h>
+#include <arm/cpu_data_internal.h>
+#include <pexpert/pexpert.h>
+#include <libkern/OSAtomic.h>
+
+extern lck_mtx_t tasks_threads_lock;
+extern char *proc_name_address(void *p);
+extern int task_pid(task_t task);
+extern processor_t cpu_to_processor(int cpu);
+extern int negroni_display_asleep;      /* NegroniFramebuffer.cpp (0382) */
+
+void negroni_top_start(void);
+
+#define NT_SLOTS        8192            /* thread table (open addressing on the thread id) */
+#define NT_TOP          6
+#define NT_PROCS        6
+#define NT_TASKS        96
+#define NT_FRAMES       6
+#define NT_CPUS         8
+
+struct nt_ent {
+	uint64_t tid;           /* 0 = empty */
+	uint64_t time;          /* recount_thread_time_mach at the last window */
+};
+
+static struct nt_ent *nt_tab[2];
+static int nt_cur;
+static uint32_t nt_secs = 60;
+
+static struct {
+	uint64_t busy, idle, irq, timer, ipi;
+} nt_cpu[NT_CPUS];
+
+static uint64_t
+nt_prev(const struct nt_ent *tab, uint64_t tid, bool *found)
+{
+	uint32_t h = (uint32_t)(tid * 2654435761u) & (NT_SLOTS - 1);
+	for (uint32_t n = 0; n < NT_SLOTS; n++, h = (h + 1) & (NT_SLOTS - 1)) {
+		if (tab[h].tid == tid) {
+			*found = true;
+			return tab[h].time;
+		}
+		if (tab[h].tid == 0) {
+			break;
+		}
+	}
+	*found = false;
+	return 0;
+}
+
+static void
+nt_put(struct nt_ent *tab, uint64_t tid, uint64_t time)
+{
+	uint32_t h = (uint32_t)(tid * 2654435761u) & (NT_SLOTS - 1);
+	for (uint32_t n = 0; n < NT_SLOTS; n++, h = (h + 1) & (NT_SLOTS - 1)) {
+		if (tab[h].tid == 0 || tab[h].tid == tid) {
+			tab[h].tid = tid;
+			tab[h].time = time;
+			return;
+		}
+	}
+}
+
+static void
+nt_name(task_t task, char *buf, size_t size)
+{
+	if (task == kernel_task) {
+		strlcpy(buf, "kernel_task", size);
+		return;
+	}
+	void *p = get_bsdtask_info(task);
+	snprintf(buf, size, "%s[%d]", p ? proc_name_address(p) : "?", task_pid(task));
+}
+
+static uint64_t
+nt_pct10(uint64_t part, uint64_t whole)        /* tenths of a percent */
+{
+	return whole ? part * 1000 / whole : 0;
+}
+
+static void
+nt_window(uint64_t window_abs, bool print)
+{
+	struct nt_ent *old = nt_tab[nt_cur], *tab = nt_tab[nt_cur ^ 1];
+	struct {
+		thread_t th;
+		uint64_t delta, tid;
+	} top[NT_TOP] = {};
+	static struct {
+		task_t task;
+		uint64_t sum;
+	} tasks[NT_TASKS];      /* one thread uses these: static, off the kernel stack */
+	static char thr[NT_TOP][300], procs[400];
+	uint32_t ntasks = 0, nthreads = 0;
+	char line[480];
+	int at;
+
+	/* per CPU: busy share and the wakeups */
+	const ml_topology_info_t *topo = ml_get_topology_info();
+	unsigned ncpu = topo->num_cpus < NT_CPUS ? topo->num_cpus : NT_CPUS;
+	uint32_t busy[NT_CPUS] = {}, irq[NT_CPUS] = {}, tmr[NT_CPUS] = {}, ipi[NT_CPUS] = {};
+	uint64_t ns;
+	absolutetime_to_nanoseconds(window_abs, &ns);
+	uint64_t ms = ns / NSEC_PER_MSEC ? ns / NSEC_PER_MSEC : 1;
+	for (unsigned i = 0; i < ncpu; i++) {
+		int cpu = (int)topo->cpus[i].cpu_id;
+		processor_t p = cpu_to_processor(cpu);
+		cpu_data_t *cd = cpu_datap(cpu);
+		if (p == PROCESSOR_NULL || cd == NULL) {
+			continue;
+		}
+		struct recount_usage u = { 0 };
+		uint64_t idle = 0;
+		recount_processor_usage(&p->pr_recount, &u, &idle);
+		uint64_t b = u.ru_user_time_mach + u.ru_system_time_mach;
+		uint64_t db = b - nt_cpu[i].busy, di = idle - nt_cpu[i].idle;
+		busy[i] = (uint32_t)(db + di ? db * 100 / (db + di) : 0);
+		irq[i] = (uint32_t)((cd->cpu_stat.irq_ex_cnt - nt_cpu[i].irq) * 1000 / ms);
+		tmr[i] = (uint32_t)((cd->cpu_stat.timer_cnt - nt_cpu[i].timer) * 1000 / ms);
+		ipi[i] = (uint32_t)((cd->cpu_stat.ipi_cnt - nt_cpu[i].ipi) * 1000 / ms);
+		nt_cpu[i].busy = b;
+		nt_cpu[i].idle = idle;
+		nt_cpu[i].irq = cd->cpu_stat.irq_ex_cnt;
+		nt_cpu[i].timer = cd->cpu_stat.timer_cnt;
+		nt_cpu[i].ipi = cd->cpu_stat.ipi_cnt;
+	}
+
+	bzero(tab, NT_SLOTS * sizeof(*tab));
+	bzero(tasks, sizeof(tasks));
+	lck_mtx_lock(&tasks_threads_lock);
+	thread_t th;
+	queue_iterate(&threads, th, thread_t, threads) {
+		uint64_t now_t = recount_thread_time_mach(th), tid = th->thread_id;
+		bool found;
+		uint64_t was = nt_prev(old, tid, &found);
+		uint64_t delta = found && now_t >= was ? now_t - was : (found ? 0 : now_t);
+		nt_put(tab, tid, now_t);
+		nthreads++;
+		if (!print || delta == 0) {
+			continue;
+		}
+		task_t task = get_threadtask(th);
+		uint32_t k;
+		for (k = 0; k < ntasks && tasks[k].task != task; k++) {
+			;
+		}
+		if (k < ntasks) {
+			tasks[k].sum += delta;
+		} else if (ntasks < NT_TASKS) {
+			tasks[ntasks].task = task;
+			tasks[ntasks++].sum = delta;
+		}
+		for (int i = 0; i < NT_TOP; i++) {
+			if (delta > top[i].delta) {
+				for (int j = NT_TOP - 1; j > i; j--) {
+					top[j] = top[j - 1];
+				}
+				top[i].th = th;
+				top[i].delta = delta;
+				top[i].tid = tid;
+				break;
+			}
+		}
+	}
+	/* still under the lock: the threads in top[] are on the list (review: no bzero(tasks) here, it cleared the sums) */
+	for (int i = 0; i < NT_TOP; i++) {
+		thr[i][0] = 0;
+		if (top[i].th == THREAD_NULL) {
+			continue;
+		}
+		thread_t t = top[i].th;
+		task_t task = get_threadtask(t);
+		char who[48], tn[MAXTHREADNAMESIZE] = "";
+		nt_name(task, who, sizeof(who));
+		thread_get_thread_name(t, tn);
+		at = snprintf(thr[i], sizeof(thr[i]), "NEGRONI TOP thr %llu.%llu%% %s tid %llu \"%s\" st 0x%x",
+		    nt_pct10(top[i].delta, window_abs) / 10, nt_pct10(top[i].delta, window_abs) % 10, who, top[i].tid,
+		    tn, t->state);
+		if (task == kernel_task && t != current_thread()) {
+			/*
+			 * A blocked kernel thread: its saved lr, then the frame chain (as the 0360 BT dump).
+			 * Review: read under the thread lock at splsched. A thread with TH_RUN clear cannot be
+			 * unblocked (thread_go needs this lock), so it keeps its kernel stack while we read it;
+			 * without the lock it could run, hand off its stack and stack_collect could unmap it.
+			 */
+			uint64_t fr[1 + NT_FRAMES];
+			int nfr = 0;
+			spl_t s = splsched();
+			thread_lock(t);
+			if (t->kernel_stack != 0 && !(t->state & TH_RUN)) {
+				thread_kernel_state_t ks = (thread_kernel_state_t)t->machine.kstackptr;
+				uint64_t base = t->kernel_stack, topa = base + kernel_stack_size;
+				uint64_t fp = ks->machine.ss.fp;
+				fr[nfr++] = ks->machine.ss.lr;
+				for (int f = 0; f < NT_FRAMES && fp >= base && fp + 16 <= topa && (fp & 7) == 0; f++) {
+					uint64_t next = ((uint64_t *)fp)[0];
+					fr[nfr++] = ((uint64_t *)fp)[1];
+					if (next <= fp) {
+						break;
+					}
+					fp = next;
+				}
+			}
+			thread_unlock(t);
+			splx(s);
+			for (int f = 0; f < nfr && at < 260; f++) {
+				at += snprintf(thr[i] + at, sizeof(thr[i]) - at, f ? " 0x%llx" : " lr 0x%llx",
+				    (uint64_t)VM_KERNEL_UNSLIDE(fr[f]));
+			}
+		}
+	}
+	/* process names under the lock too (the tasks are alive while their threads are listed) */
+	at = snprintf(procs, sizeof(procs), "NEGRONI TOP procs (%u threads):", nthreads);
+	for (int n = 0; n < NT_PROCS && print; n++) {
+		uint32_t best = NT_TASKS;
+		for (uint32_t k = 0; k < ntasks; k++) {
+			if (tasks[k].sum != 0 && (best == NT_TASKS || tasks[k].sum > tasks[best].sum)) {
+				best = k;
+			}
+		}
+		if (best == NT_TASKS) {
+			break;
+		}
+		char who[48];
+		nt_name(tasks[best].task, who, sizeof(who));
+		uint64_t p10 = nt_pct10(tasks[best].sum, window_abs);
+		at += snprintf(procs + at, sizeof(procs) - at, "%s %s %llu.%llu%%", n ? "," : "", who, p10 / 10, p10 % 10);
+		tasks[best].sum = 0;
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+	nt_cur ^= 1;
+	if (!print) {
+		return;
+	}
+
+	at = snprintf(line, sizeof(line), "NEGRONI TOP %llu s dark %d: busy%%", ms / 1000,
+	    __atomic_load_n(&negroni_display_asleep, __ATOMIC_ACQUIRE));
+	for (unsigned i = 0; i < ncpu; i++) {
+		at += snprintf(line + at, sizeof(line) - at, " %u", busy[i]);
+	}
+	at += snprintf(line + at, sizeof(line) - at, " | irq/s");
+	for (unsigned i = 0; i < ncpu; i++) {
+		at += snprintf(line + at, sizeof(line) - at, " %u", irq[i]);
+	}
+	at += snprintf(line + at, sizeof(line) - at, " | timer/s");
+	for (unsigned i = 0; i < ncpu; i++) {
+		at += snprintf(line + at, sizeof(line) - at, " %u", tmr[i]);
+	}
+	at += snprintf(line + at, sizeof(line) - at, " | ipi/s");
+	for (unsigned i = 0; i < ncpu; i++) {
+		at += snprintf(line + at, sizeof(line) - at, " %u", ipi[i]);
+	}
+	printf("%s\n", line);
+	printf("%s\n", procs);
+	for (int i = 0; i < NT_TOP; i++) {
+		if (thr[i][0]) {
+			printf("%s\n", thr[i]);
+		}
+	}
+}
+
+__attribute__((noreturn)) static void
+nt_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static int chan;
+	uint64_t last = mach_absolute_time();
+
+	nt_window(0, false);    /* the base of the first window */
+	for (;;) {
+		assert_wait_timeout((event_t)&chan, THREAD_UNINT, nt_secs, NSEC_PER_SEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		uint64_t now = mach_absolute_time();
+		nt_window(now - last, true);
+		last = now;
+	}
+}
+
+/* NegroniCPU.cpp, once all CPUs run (thread context). */
+void
+negroni_top_start(void)
+{
+	static bool started;
+	thread_t thread;
+
+	if (started) {
+		return;
+	}
+	started = true;
+	PE_parse_boot_argn("negronitop", &nt_secs, sizeof(nt_secs));
+	if (nt_secs == 0) {
+		printf("NEGRONI TOP: off (negronitop=0)\n");
+		return;
+	}
+	if (nt_secs < 5) {
+		nt_secs = 5;
+	}
+	for (int i = 0; i < 2; i++) {
+		nt_tab[i] = kalloc_data(NT_SLOTS * sizeof(struct nt_ent), Z_WAITOK | Z_ZERO);
+		if (nt_tab[i] == NULL) {
+			printf("NEGRONI TOP: no memory\n");
+			return;
+		}
+	}
+	if (kernel_thread_start(nt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("NEGRONI TOP: a line set every %u s (negronitop; 0 = off)\n", nt_secs);
+	}
+}
+#endif /* NEGRONI */
