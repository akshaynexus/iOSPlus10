diff --git a/osfmk/arm64/negroni_weak_hooks.c b/osfmk/arm64/negroni_weak_hooks.c
new file mode 100644
index 0000000..a806c58
--- /dev/null
+++ b/osfmk/arm64/negroni_weak_hooks.c
@@ -0,0 +1,32 @@
+/*
+ * iOS 26 port (xnu-12377): weak default definitions of the negroni driver hooks that the machine layer, the
+ * console and the platform expert call. The drivers (bsd/dev/negroni_*.c, iokit/Kernel/arm/Negroni*.cpp) give the
+ * strong definitions; ld64 takes those when they are linked. With only the machine layer (patches 0001-0004) the
+ * kernel still links and boots to the console: no persistent log, no PMIC reboot (PSCI only), no RTC (epoch).
+ */
+#include <stdint.h>
+#include <stdbool.h>
+#include <kern/clock.h>
+#include <kern/misc_protos.h>
+
+#define NEGRONI_WEAK __attribute__((weak))
+
+/* bsd/dev/negroni_ufs.c: persistent boot log, boot-log end mark (0047, 0367) */
+NEGRONI_WEAK void negroni_log_append(const char *c __unused, int size __unused) {}
+NEGRONI_WEAK void negroni_bootlog_end(unsigned kind __unused, const char *why __unused) {}
+/* bsd/dev/negroni_rpmh.c (0383): never ready = no cluster power-down request */
+NEGRONI_WEAK bool negroni_rpmh_sleep_ready(void) { return false; }
+NEGRONI_WEAK void negroni_rpmh_sleep_log(void) {}
+/* bsd/dev/negroni_reboot.c (0211, 0213, 0214) */
+NEGRONI_WEAK void negroni_reboot_prepare(void) {}
+NEGRONI_WEAK void negroni_reboot_settle(unsigned ms __unused) {}
+NEGRONI_WEAK void negroni_restart(void) {}
+NEGRONI_WEAK void negroni_power_off(void) {}
+NEGRONI_WEAK void negroni_panic_restart(void) { for (;;) { __builtin_arm_wfi(); } }
+/* NegroniFramebuffer.cpp (0234), negroni_tfa.c (0244), negroni_flash.c */
+NEGRONI_WEAK void negroni_fb_panic(void) {}
+NEGRONI_WEAK void negroni_tfa_panic(void) {}
+NEGRONI_WEAK int negroni_display_asleep;
+/* bsd/dev/negroni_rtc.c: no RTC = the epoch */
+NEGRONI_WEAK void negroni_rtc_get(clock_sec_t *secs, clock_nsec_t *nsecs) { *secs = 0; *nsecs = 0; }
+NEGRONI_WEAK void negroni_rtc_set(clock_sec_t secs __unused, clock_nsec_t nsecs __unused) {}
