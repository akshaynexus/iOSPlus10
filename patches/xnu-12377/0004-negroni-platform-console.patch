diff --git a/iokit/Kernel/arm/NegroniCPU.cpp b/iokit/Kernel/arm/NegroniCPU.cpp
new file mode 100644
index 0000000..750000d
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniCPU.cpp
@@ -0,0 +1,288 @@
+/*
+ * A55 SMP bring-up for negroni using XNU's legacy IOCPU interface and PSCI.
+ * The architected timer and SGI1 already enter through pe_fiq/sleh_irq.
+ * CPU_OFF, suspend and the A76 cores still require separate platform work.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NEGRONI)
+#include <IOKit/IOCPU.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <arm64/proc_reg.h>
+#include <machine/atomic.h>
+#include <kern/clock.h>
+#include <kern/processor.h>
+#include <kern/thread.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+
+extern "C" void negroni_secondary_entry(void);
+extern "C" boolean_t negroni_cpu_signal_is_enabled(unsigned int cpu);
+extern "C" void negroni_cpuidle_init(void);     /* osfmk/arm64/negroni_cpuidle.c (0288) */
+extern "C" void negroni_top_start(void);        /* osfmk/kern/negroni_top.c (0382) */
+
+class NegroniCPU;
+static NegroniCPU *negroni_cpus[MAX_CPUS];
+static uint32_t negroni_cpus_registered;
+
+/* SMCCC 1.0: x0 is the signed PSCI result; do not assume x1-x17 survive. */
+static int32_t
+negroni_psci_cpu_on(uint64_t target, uint64_t entry, uint64_t context)
+{
+	register uint64_t x0 __asm__("x0") = 0xC4000003ULL;
+	register uint64_t x1 __asm__("x1") = target;
+	register uint64_t x2 __asm__("x2") = entry;
+	register uint64_t x3 __asm__("x3") = context;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13",
+	    "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+class NegroniCPU : public IOCPU {
+	OSDeclareDefaultStructors(NegroniCPU);
+	const OSSymbol *cpuName = NULL;
+	uint32_t initialized = 0; /* release/acquire publication after initCPU sends SGI */
+
+public:
+	static void startAll(void *arg, wait_result_t result);
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	void initCPU(bool boot) APPLE_KEXT_OVERRIDE;
+	void quiesceCPU(void) APPLE_KEXT_OVERRIDE;
+	kern_return_t startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr) APPLE_KEXT_OVERRIDE;
+	void haltCPU(void) APPLE_KEXT_OVERRIDE;
+	void signalCPU(IOCPU *target) APPLE_KEXT_OVERRIDE;
+	const OSSymbol *getCPUName(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(NegroniCPU, IOCPU);
+
+/* CPUs left out by cpus= are not matched, so start() never fails for them. */
+IOService *
+NegroniCPU::probe(IOService *provider, SInt32 *score)
+{
+	OSNumber *logical = OSDynamicCast(OSNumber, provider->getProperty("logical-cpu-id"));
+
+	if (logical == NULL || logical->unsigned32BitValue() >= ml_get_topology_info()->num_cpus) {
+		return NULL;
+	}
+	return IOCPU::probe(provider, score);
+}
+
+bool
+NegroniCPU::start(IOService *provider)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	OSNumber *logical = OSDynamicCast(OSNumber, provider->getProperty("logical-cpu-id"));
+	OSData *reg = OSDynamicCast(OSData, provider->getProperty("reg"));
+
+	if (logical == NULL || reg == NULL || reg->getLength() != sizeof(uint32_t) ||
+	    logical->unsigned32BitValue() >= topology->num_cpus) {
+		return false;
+	}
+	const ml_topology_cpu_t *cpu = &topology->cpus[logical->unsigned32BitValue()];
+	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
+		return false;
+	}
+	/* MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
+	if (cpu->phys_id > 0x700 || (cpu->phys_id & 0xff) != 0 ||
+	    topology->num_cpus > NEGRONI_SMP_MAX_CPUS) {
+		panic("NEGRONI CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
+		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
+	}
+	if (!IOCPU::start(provider)) {
+		return false;
+	}
+	cpuName = OSSymbol::withCStringNoCopy("Kryo 470");
+	if (cpuName == NULL) {
+		return false;
+	}
+	setCPUNumber(cpu->cpu_id);
+
+	ml_processor_info_t info = {};
+	info.cpu_id = reinterpret_cast<cpu_id_t>(this);
+	info.phys_id = cpu->phys_id;
+	info.log_id = cpu->cpu_id;
+	info.cluster_id = cpu->cluster_id;
+	info.cluster_type = cpu->cluster_type;
+	info.l2_cache_id = cpu->l2_cache_id;
+	info.l2_cache_size = cpu->l2_cache_size;
+	info.l3_cache_id = cpu->l3_cache_id;
+	info.l3_cache_size = cpu->l3_cache_size;
+	perfmon_interrupt_handler_func pmi_handler = NULL;
+	kern_return_t result = ml_processor_register(&info, &machProcessor, &ipi_handler, &pmi_handler);
+	if (result != KERN_SUCCESS) {
+		panic("NEGRONI CPU: ml_processor_register failed: %d", result);
+	}
+	if (pmi_handler != NULL) {
+		panic("NEGRONI CPU: PMI routing is not implemented");
+	}
+
+	registerService();
+	__atomic_store_n(&negroni_cpus[cpu->cpu_id], this, __ATOMIC_RELEASE);
+	__atomic_add_fetch(&negroni_cpus_registered, 1, __ATOMIC_ACQ_REL);
+	if (cpu == topology->boot_cpu) {
+		thread_t thread;
+		result = kernel_thread_start(&NegroniCPU::startAll, NULL, &thread);
+		if (result != KERN_SUCCESS) {
+			panic("NEGRONI CPU: cannot create startup thread: %d", result);
+		}
+		thread_deallocate(thread);
+	}
+	return true;
+}
+
+/* Do not wait in a nub's start(): matching can be asynchronous or serialized. */
+void
+NegroniCPU::startAll(void *arg __unused, wait_result_t result __unused)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint32_t requested = 1;
+	PE_parse_boot_argn("cpus", &requested, sizeof(requested));
+	IOLog("NEGRONI CPU: requested=%u selected=%u (limit=%u)\n",
+	    requested, topology->num_cpus, NEGRONI_SMP_MAX_CPUS);
+
+	uint64_t deadline;
+	nanoseconds_to_deadline(10 * NSEC_PER_SEC, &deadline);
+	while (__atomic_load_n(&negroni_cpus_registered, __ATOMIC_ACQUIRE) != topology->num_cpus) {
+		if (mach_absolute_time() > deadline) {
+			for (unsigned int i = 0; i < topology->num_cpus; i++) {
+				if (__atomic_load_n(&negroni_cpus[i], __ATOMIC_ACQUIRE) == NULL) {
+					IOLog("NEGRONI CPU: cpu=%u NOT registered (IOKit matching timeout)\n", i);
+				}
+			}
+			panic("NEGRONI CPU: CPU registration timeout");
+		}
+		IOSleep(1);
+	}
+	/* The supplied ADT has cpu0 as the boot CPU and ascending A55 nodes. */
+	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0) {
+		panic("NEGRONI CPU: expected boot MPIDR 0 and logical CPU 0");
+	}
+	for (unsigned int i = 0; i < topology->num_cpus; i++) {
+		NegroniCPU *cpu = __atomic_load_n(&negroni_cpus[i], __ATOMIC_ACQUIRE);
+		kern_return_t kr = processor_start(cpu->machProcessor);
+		if (kr != KERN_SUCCESS) {
+			panic("NEGRONI CPU: cpu=%u processor_start failed: %d", i, kr);
+		}
+		/* processor_start() is asynchronous for secondaries in this XNU. */
+		nanoseconds_to_deadline(5 * NSEC_PER_SEC, &deadline);
+		while (__atomic_load_n(&cpu->initialized, __ATOMIC_ACQUIRE) == 0 ||
+		    !negroni_cpu_signal_is_enabled(i)) {
+			if (mach_absolute_time() > deadline) {
+				IOLog("NEGRONI CPU: cpu=%u mpidr=0x%x NOT alive after 5s\n",
+				    i, topology->cpus[i].phys_id);
+				panic("NEGRONI CPU: cpu=%u startup timeout (reset/MMU/GIC/SGI)", i);
+			}
+			IOSleep(1);
+		}
+		IOLog("NEGRONI CPU: cpu=%u mpidr=0x%x came alive; SGI1 OK\n",
+		    i, topology->cpus[i].phys_id);
+	}
+	/* Publish exactly once, after every selected CPU has completed initCPU(). */
+	ml_cpu_init_completed();
+	__atomic_load_n(&negroni_cpus[topology->boot_cpu->cpu_id], __ATOMIC_ACQUIRE)->cpusRunning();
+	IOService::publishResource(gIOAllCPUInitializedKey, kOSBooleanTrue);
+	ml_set_max_cpus(topology->max_cpu_id + 1);
+	IOLog("NEGRONI CPU: %u/%u CPUs initialized, SGI1 verified\n",
+	    topology->num_cpus, topology->num_cpus);
+	negroni_cpuidle_init();         /* 0288: CPU idle states (negronicpuidle, default 0 = WFI only) */
+	negroni_top_start();            /* 0382: NEGRONI TOP lines (negronitop, default 60 s) */
+	thread_terminate(current_thread());
+}
+
+void
+NegroniCPU::free(void)
+{
+	OSSafeReleaseNULL(cpuName);
+	IOCPU::free();
+}
+
+void
+NegroniCPU::initCPU(bool boot)
+{
+	if (!boot) {
+		panic("NEGRONI CPU: cpu=%u resume is not implemented", getCPUNumber());
+	}
+	assert(cpu_number() == (int)getCPUNumber());
+
+	ml_broadcast_cpu_event(CPU_BOOTED, getCPUNumber());
+
+	/* Secondary startup runs at splsched: queue the self-IPI and return.
+	 * startAll waits for its delivery after the startup thread unmasks IRQs.
+	 * Waiting here with DAIF.I set would deadlock every secondary. */
+	signalCPU(this);
+	setCPUState(kIOCPUStateRunning);
+	kprintf("NEGRONI CPU: cpu=%u entered initCPU mpidr=0x%llx EL%llu IRQs=%u\n",
+	    getCPUNumber(), __builtin_arm_rsr64("MPIDR_EL1") & 0xffffULL,
+	    __builtin_arm_rsr64("CurrentEL") >> 2, ml_get_interrupts_enabled());
+	__atomic_store_n(&initialized, 1, __ATOMIC_RELEASE);
+}
+
+void
+NegroniCPU::signalCPU(IOCPU *target)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	unsigned int logical = target->getCPUNumber();
+	if (logical >= topology->num_cpus) {
+		panic("NEGRONI CPU: invalid SGI target %u", logical);
+	}
+	/* Use the TARGET affinity, including Aff1, never the sender's MPIDR. */
+	uint64_t mpidr = topology->cpus[logical].phys_id;
+	unsigned int aff0 = mpidr & 0xff;
+	if (aff0 >= 16) {
+		panic("NEGRONI CPU: SGI target requires unsupported range selector");
+	}
+	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
+	    (((mpidr >> 16) & 0xff) << 32) |
+	    (((mpidr >> 8) & 0xff) << 16) |
+	    ((uint64_t)NEGRONI_IPI_SGI << 24) | (1ULL << aff0);
+	__builtin_arm_dsb(DSB_ISHST);
+	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+	__builtin_arm_isb(ISB_SY);
+}
+
+kern_return_t
+NegroniCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
+{
+	const ml_topology_cpu_t *cpu = &ml_get_topology_info()->cpus[getCPUNumber()];
+	/* cpu_start() passes NULL,NULL: x20/x21 are set by LowResetVectorBase. */
+	if (start_paddr != 0 || arg_paddr != 0 || cpu->phys_id == 0 ||
+	    __atomic_load_n(&initialized, __ATOMIC_ACQUIRE) != 0) {
+		panic("NEGRONI CPU: cpu=%u unsupported restart", getCPUNumber());
+	}
+	vm_offset_t entry = ml_static_vtop((vm_offset_t)&negroni_secondary_entry);
+	IOLog("NEGRONI CPU: cpu=%u CPU_ON target=0x%x entry_pa=0x%llx context=%u\n",
+	    getCPUNumber(), cpu->phys_id, (uint64_t)entry, getCPUNumber());
+	__builtin_arm_dsb(DSB_SY);
+	int32_t rc = negroni_psci_cpu_on(cpu->phys_id, entry, getCPUNumber());
+	IOLog("NEGRONI CPU: cpu=%u PSCI CPU_ON rc=%d\n", getCPUNumber(), rc);
+	/* cpu_start() discards PE_cpu_start's return; do not silently carry on. */
+	if (rc != 0) {
+		panic("NEGRONI CPU: cpu=%u NOT alive: PSCI CPU_ON rc=%d", getCPUNumber(), rc);
+	}
+	return KERN_SUCCESS;
+}
+
+void
+NegroniCPU::quiesceCPU(void)
+{
+	panic("NEGRONI CPU: CPU quiesce is not implemented");
+}
+
+void
+NegroniCPU::haltCPU(void)
+{
+	panic("NEGRONI CPU: CPU halt/suspend is not implemented");
+}
+
+const OSSymbol *
+NegroniCPU::getCPUName(void)
+{
+	return cpuName;
+}
+#endif /* NEGRONI */
diff --git a/iokit/Kernel/arm/NegroniPlatformExpert.cpp b/iokit/Kernel/arm/NegroniPlatformExpert.cpp
new file mode 100644
index 0000000..fb91679
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniPlatformExpert.cpp
@@ -0,0 +1,189 @@
+/*
+ * Minimal device-tree platform expert for OnePlus 10 Pro 5G (negroni).
+ * Uses XNU's normal platform, power-domain and nub initialization. Hardware
+ * interrupt and power-management services are supplied by separate drivers.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NEGRONI)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class NegroniPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(NegroniPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	void getUTCTimeOfDay(clock_sec_t *secs, clock_nsec_t *nsecs) APPLE_KEXT_OVERRIDE;
+	void setUTCTimeOfDay(clock_sec_t secs, clock_nsec_t nsecs) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(NegroniPlatformExpert, IODTPlatformExpert);
+
+/*
+ * Halt/restart (bsd/dev/negroni_reboot.c). Without a PE_halt_restart hook
+ * IOPlatformExpert::haltRestart() returned -1 for every type, so power off
+ * ("slide to power off": launchd reboot(RB_HALT) -> reboot_kernel() ->
+ * host_reboot(HOST_REBOOT_HALT) -> halt_all_cpus(FALSE) ->
+ * PEHaltRestart(kPEHaltCPU)) and restart only printed "CPU halted" /
+ * "MACH Reboot" and spun; 30 s later "Halt/Restart Timed Out" panicked.
+ *   kPEHaltCPU          PSCI SYSTEM_OFF (boot-arg negronipoweroff)
+ *   kPERestartCPU       reboot reason of kern.negroni_reboot_mode (0213;
+ *                       default normal), PSCI SYSTEM_RESET
+ *   kPEPanicRestartCPU  panic text kept on the screen for negronipanic
+ *                       seconds (default 0 = for ever), then reset
+ *   kPEPanicDiagnosticsDone  the same hold (0360): reached also when
+ *                       panicDebugging (debug=0x4) skips the restart
+ * kPEPanicBegin marks the panic; other types (panic callouts) do nothing.
+ */
+extern "C" {
+void negroni_reboot_prepare(void);
+void negroni_reboot(unsigned reason);
+void negroni_restart(void);
+void negroni_power_off(void);
+void negroni_panic_restart(void);
+void negroni_reboot_settle(unsigned ms);
+void negroni_fb_panic(void);            /* NegroniFramebuffer.cpp: zero-copy pipes back on the panel memory */
+void negroni_tfa_panic(void);           /* negroni_tfa.c (0244): speaker amps off, reset pins held */
+void negroni_bootlog_end(unsigned kind, const char *why);  /* negroni_ufs.c (0367): 3 halt, 4 restart */
+}
+
+static bool negroni_in_panic;
+
+static int
+negroni_halt_restart(unsigned int type)
+{
+	switch (type) {
+	case kPEPanicBegin:
+		negroni_in_panic = true;
+		negroni_fb_panic();             /* the panic text must be on screen (0234) */
+		negroni_tfa_panic();            /* no amp left playing a stuck buffer (0244) */
+		return 0;
+	case kPEHaltCPU:
+		if (negroni_in_panic) {
+			negroni_panic_restart();        /* does not return */
+		}
+		IOLog("NEGRONI: power off\n");
+		negroni_bootlog_end(3, "halt (power off)");     /* clean end mark in the boot log (0367) */
+		negroni_tfa_panic();                    /* amps off before the rails go (0244) */
+		negroni_reboot_settle(300);             /* the USB log thread sends the last lines */
+		negroni_power_off();
+		return -1;                              /* refused: halt_all_cpus() spins */
+	case kPERestartCPU:
+		if (negroni_in_panic) {
+			negroni_panic_restart();        /* does not return */
+		}
+		IOLog("NEGRONI: restart\n");
+		negroni_bootlog_end(4, "restart (reboot)");     /* clean end mark in the boot log (0367) */
+		negroni_tfa_panic();                    /* amps off (0244) */
+		negroni_reboot_settle(300);
+		negroni_restart();                      /* kern.negroni_reboot_mode (0213) */
+		return -1;
+	case kPEPanicRestartCPU:
+		negroni_panic_restart();                /* does not return */
+		return -1;
+	case kPEPanicDiagnosticsDone:
+		/*
+		 * 0360: the panic log is complete (paniclog, backtraces, the
+		 * console ring copy). Hold the panic here: with debug=0x4
+		 * (DB_NMI) xnu sets panicDebugging, never sends
+		 * kPEPanicRestartCPU and spins in panic_spin_forever(), so
+		 * negronipanic=N never reset (the 2026-10-26 panics). The hold
+		 * loop sends the log over USB, takes ctl commands and runs the
+		 * timed reset.
+		 */
+		if (negroni_in_panic) {
+			negroni_panic_restart();        /* does not return */
+		}
+		return 0;
+	default:
+		return 0;
+	}
+}
+
+bool
+NegroniPlatformExpert::start(IOService *provider)
+{
+	IOLog("NEGRONI: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	registerService();
+	negroni_reboot_prepare();
+	PE_halt_restart = &negroni_halt_restart;
+	IOLog("NEGRONI: platform expert registered, halt/restart hook set\n");
+	return true;
+}
+
+const char *
+NegroniPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+NegroniPlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+NegroniPlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	/*
+	 * The stock implementation requires an Apple NVRAM /options node.
+	 * NEGRONI has no NVRAM controller; publish real CPU/device nodes without
+	 * inventing one. createNubs adds the topology's logical CPU/cluster IDs.
+	 */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+
+	/*
+	 * No AppleARMIO driver publishes the /arm-io children: do it here so
+	 * built-in drivers (the display, AppleCLCD) can match them. The GIC is
+	 * driven by the platform code and gets no nub. The nubs hang off this
+	 * platform expert: IOPlatformDevice::compareName asks its provider.
+	 */
+	IORegistryEntry *armio = root->childFromPath("arm-io", gIODTPlane);
+	if (armio != NULL) {
+		createNubs(this, IODTFindMatchingEntries(armio, kIODTExclusive, "('gic')"));
+		armio->release();
+	}
+}
+
+/*
+ * hw.target / hw.product come from IODTPlatformExpert: the first root
+ * "compatible" string and "model" (D22AP / iPhone10,3 in the ADT), which
+ * is what the iPhone userland (MobileGestalt) expects.
+ */
+
+/*
+ * Calendar time (bsd/dev/negroni_rtc.c): the PMK8350 RTC + an offset, or
+ * a build-date floor. Without these overrides IOPlatformExpert returned 0
+ * and the calendar started at the epoch (1969-12-31 in Pacific time).
+ */
+extern "C" {
+void negroni_rtc_get(clock_sec_t *secs, clock_nsec_t *nsecs);
+void negroni_rtc_set(clock_sec_t secs, clock_nsec_t nsecs);
+}
+
+void
+NegroniPlatformExpert::getUTCTimeOfDay(clock_sec_t *secs, clock_nsec_t *nsecs)
+{
+	negroni_rtc_get(secs, nsecs);
+}
+
+void
+NegroniPlatformExpert::setUTCTimeOfDay(clock_sec_t secs, clock_nsec_t nsecs)
+{
+	negroni_rtc_set(secs, nsecs);
+}
+#endif /* NEGRONI */
