+/* ---- CCI ---- */
+
+static void
+cci_irq_clear(uint32_t bits)
+{
+	wr(cci + CCI_IRQ_CLEAR_0, bits);
+	wr(cci + CCI_IRQ_GLOBAL_CLEAR, 1);
+}
+
+/* reset (whole controller when all, else one master) and wait for RST_DONE_ACK (cam_cci_soc.c init_master) */
+static bool
+cci_reset(uint32_t what, uint32_t *took_us)
+{
+	uint32_t got = 0;
+	uint64_t t0 = now_us();
+	cci_irq_clear(CCI_IRQ_MASK_0_ALL);
+	wr(cci + CCI_RESET_CMD, what);
+	if (what == CCI_RESET_ALL) {
+		wr(cci + CCI_RESET_CMD, 0x1);   /* cam_cci_soc.c: RMSK, then 0x1, when ref_count == 1 */
+	}
+	bool ok = poll(cci + CCI_IRQ_STATUS_0, CCI_RST_DONE, CCI_RST_DONE, CCI_TIMEOUT_US, &got);
+	cci_irq_clear(got);
+	if (took_us) {
+		*took_us = (uint32_t)(now_us() - t0);
+	}
+	if (!ok) {
+		say("  CCI reset %#x: no RST_DONE_ACK in %u us (irq status %#x)", what, CCI_TIMEOUT_US, got);
+	}
+	return ok;
+}
+
+static void
+cci_timing(uint32_t m)
+{
+	wr(cci + CCI_M_SCL_CTL(m), (uint32_t)cci_t.thigh << 16 | cci_t.tlow);
+	wr(cci + CCI_M_SDA_CTL_0(m), (uint32_t)cci_t.tsu_sto << 16 | cci_t.tsu_sta);
+	wr(cci + CCI_M_SDA_CTL_1(m), (uint32_t)cci_t.thd_dat << 16 | cci_t.thd_sta);
+	wr(cci + CCI_M_SDA_CTL_2(m), cci_t.tbuf);
+	/* scl stretch: live.dts hw-scl-stretch-en 1 and cci-up CCI_I2C_MISC_CTL_SCL_STRETCH_EN */
+	wr(cci + CCI_M_MISC_CTL(m), 1u << 8 | (uint32_t)cci_t.trdhld << 4 | cci_t.tsp);
+}
+
+/* the cam_cci_init order after the clocks: version, reset, IRQ masks, RD threshold, timing of master m */
+static bool
+cci_init(uint32_t m)
+{
+	uint32_t ver = rd(cci + CCI_HW_VERSION), took = 0;
+	say("  CCI0 hw version %#x", ver);
+	if (ver == 0 || ver == 0xffffffffu) {
+		return false;
+	}
+	/* masks first: this file polls IRQ_STATUS_0 for RST_DONE_ACK (no interrupt handler) */
+	wr(cci + CCI_IRQ_MASK_0, CCI_IRQ_MASK_0_ALL);
+	cci_irq_on = true;
+	if (!cci_reset(CCI_RESET_ALL, &took)) {
+		return false;
+	}
+	say("  CCI0 reset done ack after %u us", took);
+	wr(cci + CCI_IRQ_MASK_0, CCI_IRQ_MASK_0_ALL);
+	wr(cci + CCI_IRQ_CLEAR_0, CCI_IRQ_MASK_0_ALL);
+	wr(cci + CCI_IRQ_MASK_1, CCI_IRQ_MASK_1_ALL);
+	wr(cci + CCI_IRQ_CLEAR_1, CCI_IRQ_MASK_1_ALL);
+	wr(cci + CCI_IRQ_GLOBAL_CLEAR, 1);
+	if (ver != CCI_VERSION_1_2_9) {
+		wr(cci + CCI_M_RD_THRESHOLD(0), CCI_RD_THRESHOLD_VALUE);
+		wr(cci + CCI_M_RD_THRESHOLD(1), CCI_RD_THRESHOLD_VALUE);
+	}
+	cci_timing(m);
+	say("  CCI0 M%u timing 19.2 MHz standard: scl %#x sda0 %#x sda1 %#x sda2 %#x misc %#x", m,
+	    rd(cci + CCI_M_SCL_CTL(m)), rd(cci + CCI_M_SDA_CTL_0(m)), rd(cci + CCI_M_SDA_CTL_1(m)),
+	    rd(cci + CCI_M_SDA_CTL_2(m)), rd(cci + CCI_M_MISC_CTL(m)));
+	return true;
+}
+
+/* halt + reset of one master after an error or a timeout (cam_cci_core.c flush / ISR halt-ack path) */
+static void
+cci_recover(uint32_t m)
+{
+	uint32_t got = 0;
+	wr(cci + CCI_HALT_REQ, 1u << m);
+	bool ok = poll(cci + CCI_IRQ_STATUS_0, CCI_HALT_ACK(m), CCI_HALT_ACK(m), CCI_TIMEOUT_US, &got);
+	say("  CCI0 M%u halt %s (irq status %#x)", m, ok ? "acked" : "NOT acked", got);
+	cci_irq_clear(got);
+	(void)cci_reset(m ? CCI_RESET_M1 : CCI_RESET_M0, NULL);
+	cci_timing(m);
+}
+
+/*
+ * One register read, as cam_cci_read (cam_cci_core.c): queue 1 gets SET_PARAM (sid), LOCK,
+ * WRITE_DISABLE_P (register, MSB first, no STOP), READ n, UNLOCK; then EXEC_WORD_CNT, QUEUE_START and
+ * RD_DONE. The first byte of READ_DATA is not data. Returns 0, ENXIO (NACK), EIO, ETIMEDOUT, EBUSY.
+ */
+static int
+cci_read16(uint32_t m, uint32_t sid, uint32_t reg, uint32_t *value)
+{
+	const uint32_t q = 1;
+	uint32_t got = 0, cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+
+	if (cnt != 0) {
+		say("  CCI0 M%u Q%u not empty (%u words)", m, q, cnt);
+		return EBUSY;
+	}
+	cci_irq_clear(CCI_IRQ_MASK_0_ALL);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_SET_PARAM | sid << 4);      /* retries 0, id_map 0 */
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_LOCK);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_WRITE_DISABLE_P | 2u << 4 | ((reg >> 8) & 0xffu) << 8 | (reg & 0xffu) << 16);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_READ | 2u << 4);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_UNLOCK);
+	cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+	wr(cci + CCI_MQ_EXEC_CNT(m, q), cnt);
+	wr(cci + CCI_QUEUE_START, 1u << (m * 2 + q));
+	bool done = false;
+	for (uint32_t us = 0; us <= CCI_TIMEOUT_US; us++) {
+		got = rd(cci + CCI_IRQ_STATUS_0);
+		if (got & (CCI_RD_DONE(m) | CCI_ERROR(m))) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || (got & CCI_ERROR(m))) {
+		say("  CCI0 M%u read sid %#x reg %#06x: %s, irq status %#x, %u words queued", m, sid, reg,
+		    !done ? "timeout" : (got & CCI_NACK(m)) ? "NACK" : "error", got, cnt);
+		cci_irq_clear(got);
+		cci_recover(m);
+		return !done ? ETIMEDOUT : (got & CCI_NACK(m)) ? ENXIO : EIO;
+	}
+	uint32_t words = rd(cci + CCI_M_READ_LEVEL(m));
+	if (words != 1) {               /* num_byte / 4 + 1 */
+		say("  CCI0 M%u read: %u words in the FIFO, 1 expected", m, words);
+		for (uint32_t i = 0; i < words && i < 64; i++) {
+			(void)rd(cci + CCI_M_READ_DATA(m));
+		}
+		cci_irq_clear(got);
+		return EIO;
+	}
+	uint32_t data = rd(cci + CCI_M_READ_DATA(m));
+	cci_irq_clear(got);
+	*value = ((data >> 8) & 0xffu) << 8 | ((data >> 16) & 0xffu);
+	say("  CCI0 M%u read sid %#x reg %#06x: data word %#010x -> %#06x", m, sid, reg, data, *value);
+	return 0;
+}
+
+/*
+ * One register write, as cam_cci_data_queue (cam_cci_core.c:770-1000) for one i2c_cmd with a word
+ * address and a byte value: queue 1 gets SET_PARAM, LOCK, WRITE (3 bytes: address MSB, LSB, value in one
+ * word), UNLOCK, REPORT (:330: cmd 8 | 1 << 8 | 1 << 9); then QUEUE_START and the Q1 REPORT bit.
+ */
+/* one-byte read: cci_read16 with READ 1 (cam_cci_read num_byte 1); value = byte 1 of the FIFO word */
+static int
+cci_read8(uint32_t m, uint32_t sid, uint32_t reg, uint32_t *value)
+{
+	const uint32_t q = 1;
+	uint32_t got = 0, cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+
+	if (cnt != 0) {
+		return EBUSY;
+	}
+	cci_irq_clear(CCI_IRQ_MASK_0_ALL);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_SET_PARAM | sid << 4);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_LOCK);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_WRITE_DISABLE_P | 2u << 4 | ((reg >> 8) & 0xffu) << 8 | (reg & 0xffu) << 16);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_READ | 1u << 4);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_UNLOCK);
+	cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+	wr(cci + CCI_MQ_EXEC_CNT(m, q), cnt);
+	wr(cci + CCI_QUEUE_START, 1u << (m * 2 + q));
+	bool done = false;
+	for (uint32_t us = 0; us <= CCI_TIMEOUT_US; us++) {
+		got = rd(cci + CCI_IRQ_STATUS_0);
+		if (got & (CCI_RD_DONE(m) | CCI_ERROR(m))) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || (got & CCI_ERROR(m))) {
+		cci_irq_clear(got);
+		cci_recover(m);
+		return !done ? ETIMEDOUT : (got & CCI_NACK(m)) ? ENXIO : EIO;
+	}
+	uint32_t words = rd(cci + CCI_M_READ_LEVEL(m)), data = 0;
+	for (uint32_t i = 0; i < words && i < 64; i++) {
+		uint32_t w = rd(cci + CCI_M_READ_DATA(m));
+		if (i == 0) {
+			data = w;
+		}
+	}
+	cci_irq_clear(got);
+	*value = (data >> 8) & 0xffu;
+	return words >= 1 ? 0 : EIO;
+}
+
+static int
+cci_write8(uint32_t m, uint32_t sid, uint32_t reg, uint32_t val)
+{
+	const uint32_t q = 1;
+	uint32_t got = 0, cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+
+	if (cnt != 0) {
+		return EBUSY;
+	}
+	cci_irq_clear(CCI_IRQ_MASK_0_ALL);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_SET_PARAM | sid << 4);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_LOCK);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_WRITE | 3u << 4 | ((reg >> 8) & 0xffu) << 8 | (reg & 0xffu) << 16 |
+	    (val & 0xffu) << 24);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_UNLOCK);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_REPORT | 1u << 8 | 1u << 9);
+	cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+	wr(cci + CCI_MQ_EXEC_CNT(m, q), cnt);
+	wr(cci + CCI_QUEUE_START, 1u << (m * 2 + q));
+	bool done = false;
+	for (uint32_t us = 0; us <= CCI_TIMEOUT_US; us++) {
+		got = rd(cci + CCI_IRQ_STATUS_0);
+		if (got & (CCI_M0_Q1_REPORT | CCI_ERROR(m))) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || (got & CCI_ERROR(m))) {
+		say("  CCI0 M%u write sid %#x reg %#06x = %#04x: %s, irq status %#x", m, sid, reg, val,
+		    !done ? "timeout" : (got & CCI_NACK(m)) ? "NACK" : "error", got);
+		cci_irq_clear(got);
+		cci_recover(m);
+		return !done ? ETIMEDOUT : (got & CCI_NACK(m)) ? ENXIO : EIO;
+	}
+	cci_irq_clear(got);
+	return 0;
+}
+
+/* ---- pins ---- */
+
+static void
+tlmm_set(uint32_t pin, uint32_t cfg, int out)
+{
+	vm_offset_t p = tlmm + (vm_offset_t)(pin - TLMM_FIRST) * 0x1000u;
+	if (out >= 0) {
+		wr(p + 4, out ? 2u : 0u);       /* io: out bit 1 (pinctrl-waipio.h out_bit) */
+	}
+	if (rd(p) & TLMM_EGPIO_PRESENT) {
+		cfg |= TLMM_EGPIO_ENABLE;       /* as negroni_wifi.c tlmm_cfg */
+	}
+	wr(p, cfg);
+	say("  gpio%u cfg %#x io %#x", pin, rd(p), rd(p + 4));
+}
+
+/* ---- rails ---- */
+
+static int
+rail_vote(const struct cam_rail *r, bool on)
+{
+	int mode = -1;
+	if (on) {
+		/* refuse anything that is not one fixed DT voltage inside the regulator node range */
+		if (r->uv == 0 || r->uv < r->rail_min || r->uv > r->rail_max || r->uv % 1000u) {
+			say("  %s (%s): REFUSED: %u uV is not a DT value inside %u-%u uV", r->name, r->res, r->uv,
+			    r->rail_min, r->rail_max);
+			return EINVAL;
+		}
+		if (r->hpm_ua) {
+			mode = r->load_ua >= r->hpm_ua ? 7 : 4;  /* PMIC5 LDO HPM / LPM (rpmh-regulator.c:286-287) */
+		}
+	}
+	int error = EBUSY;
+	/* the RPMh try-lock is shared with touch/Wi-Fi/ADSP votes: retry EBUSY up to 1 s (as 0240 rail_vote) */
+	for (unsigned i = 0; i < 100 && error == EBUSY; i++) {
+		error = negroni_rpmh_cam_rail(r->res, r->uv / 1000u, mode, on);
+		if (error == EBUSY) {
+			delay(10000);
+		}
+	}
+	say("  %s (%s) %s %u mV mode %d: %s (errno %d)", r->name, r->res, on ? "on" : "off", r->uv / 1000u, mode,
+	    error ? "FAILED" : "ok", error);
+	return error;
+}
+
+/* ---- power down: the reverse of what is on, sensor in the vendor order (module:50) ---- */
+
+static void
+cam_down(void)
+{
+	say("power down");
+	bool hfi_keep = false;          /* 0317: the ICP may still write the HFI block */
+	if (pas_started) {
+		uint64_t answer = ~0ull;
+		int32_t r = icp_scm("PAS shutdown (camera)", SCM_64 | SCM_SIP | SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_CAMERA, 0, 0,
+		    &answer);
+		say("  ICP PAS shutdown: %d, answer %#llx", r, answer);
+		hfi_keep = r != 0 || answer != 0;
+		pas_started = false;
+	}
+	if (icp_branches_on & 2u) {
+		(void)branch_set("cam_cc_icp_clk", camcc + 0x13120, false, true);
+	}
+	if (icp_branches_on & 1u) {
+		(void)branch_set("cam_cc_icp_ahb_clk", camcc + 0x13128, false, true);
+	}
+	icp_branches_on = 0;
+	if (tpg_on) {
+		wr(tpg + TPG_CTRL, 0);                  /* tpg_hw_v_1_3_reset (:350-376) */
+		wr(tpg + TPG_TOP_IRQ_MASK, 0);
+		wr(tpg + TPG_TOP_IRQ_CLEAR, 1);
+		wr(tpg + TPG_TOP_IRQ_CMD, 1);
+		wr(tpg + TPG_TOP_CLEAR, 1);
+		tpg_on = false;
+	}
+	if (csid_on) {
+		wr(csid + CSID_RDI0_CTRL, 0);           /* halt at frame boundary (camss-csid-680.c:141-142) */
+		wr(csid + CSID_RDI0_CFG0, rd(csid + CSID_RDI0_CFG0) & ~(1u << 31));
+		wr(csid + CSID_TOP_IRQ_MASK, 0);
+		wr(csid + CSID_BUF_DONE_MASK, 0);
+		wr(csid + CSID_RX_IRQ_MASK, 0);
+		wr(csid + CSID_RDI0_IRQ_MASK, 0);
+		csid_on = false;
+	}
+	if (wm_on) {
+		wr(ife + WM_RDI0 + WM_CFG, 0);          /* vfe_wm_stop */
+		wm_on = false;
+	}
+	if (csiphy_on) {
+		/* cam_csiphy_reset (reset enter: lanes off, PHY reset) + prgm_cmn_data(reset) + cphy_irq_disable */
+		wr(csiphy + 0x1014, 0);
+		wr(csiphy + 0x1000, 1);
+		wr(csiphy + 0x1084, 0);
+		wr(csiphy + 0x1018, 0);
+		wr(csiphy + 0x101c, 0);
+		for (uint32_t r = 0x102c; r <= 0x1054; r += 4) {
+			wr(csiphy + r, 0);
+		}
+		say("  CSIPHY1 in reset");
+		csiphy_on = false;
+	}
+	for (unsigned i = NPATH_BRANCHES; i-- > 0;) {
+		if (path_branches_on & (1u << i)) {
+			(void)branch_set(path_branches[i].name, camcc + path_branches[i].off, false, true);
+		}
+	}
+	path_branches_on = 0;
+	for (unsigned i = 0; i < NPATH_RCGS; i++) {
+		if (path_rcgs_set & (1u << i)) {
+			(void)rcg_set(path_rcgs[i].name, path_rcgs[i].off, 0, 0);      /* back to TCXO before the PLLs stop */
+		}
+	}
+	path_rcgs_set = 0;
+	for (unsigned i = NPLLS; i-- > 0;) {
+		if (plls_on & (1u << i)) {
+			pll_disable(&cam_plls[i]);
+		}
+	}
+	plls_on = 0;
+	if (ife_gdsc_ours) {
+		uint32_t got = 0;
+		wr(camcc + CC_IFE0_GDSCR, rd(camcc + CC_IFE0_GDSCR) | GDSC_SW_COLLAPSE);
+		bool ok = poll(camcc + CC_IFE0_GDSCR, GDSC_PWR_ON, 0, GDSC_TIMEOUT_US, &got);
+		say("  IFE0 GDSC collapse: %#x%s", got, ok ? "" : " (still on)");
+		ife_gdsc_ours = false;
+	}
+	if (mxc_voted) {
+		/* kept: a lower vote from this DRV could replace a boot vote on MXC (the same rule as MMCX) [I] */
+		say("  RPMh mxc.lvl vote %u stays (not dropped)", MXC_PLL_LEVEL);
+	}
+	if (streaming) {
+		int e = cci_write8(CCI_MASTER, SENSOR_SID, SENSOR_MODE_SEL, 0);    /* streamoff (cam_ftm_power_down :215-232) */
+		say("  IMX789 stream off: errno %d", e);
+		streaming = false;
+		delay(40000);                   /* > 1 frame at 30 fps, so the CSIPHY sees the end of frame [I] */
+	}
+	if (pins_cci) {
+		tlmm_set(PIN_CCI0_SDA, TLMM_CFG(1u, PULL_DOWN, false), -1);      /* cci0_suspend */
+		tlmm_set(PIN_CCI0_SCL, TLMM_CFG(1u, PULL_DOWN, false), -1);
+		pins_cci = false;
+	}
+	if (mclk_on) {
+		(void)branch_set("cam_cc_mclk0_clk", camcc + CC_MCLK0_CBCR, false, true);
+		mclk_on = false;
+		delay(1000);                    /* MCLK=0Hz+1ms */
+	}
+	if (pins_sensor) {
+		tlmm_set(PIN_MCLK0, TLMM_CFG(1u, PULL_DOWN, false), -1);         /* mclk0_suspend */
+	}
+	if (reset_high || pins_sensor) {
+		tlmm_set(PIN_RESET0, TLMM_CFG(0u, PULL_DOWN, true), 0);          /* reset_suspend: output-low */
+		if (reset_high) {
+			delay(1000);            /* RESET=0+1ms */
+		}
+		reset_high = false;
+		pins_sensor = false;
+	}
+	for (unsigned k = 0; k < NRAILS; k++) {
+		unsigned i = rails_down[k];
+		if (rails_on & (1u << i)) {
+			if (rail_vote(&rails[i], false) == 0) {
+				rails_on &= ~(1u << i);
+			}
+		}
+	}
+	if (rails_on) {
+		say("WARNING: rails still voted on: mask %#x", rails_on);
+	}
+	for (unsigned g = 0; g < NCAMGROUPS; g++) {
+		if (smr_added[g]) {
+			vm_offset_t smmu = ml_io_map_unmappable(APPS_SMMU_PA, 0x4000, CAM_WIMG_IO);
+			if (smmu) {
+				wr(smmu + SMMU_SMR(smr_added[g] - 1), 0);       /* SMR invalid first, then S2CR */
+				wr(smmu + SMMU_S2CR(smr_added[g] - 1), 2u << 16);
+				say("  %s: our bypass SMR%u removed", cam_groups[g].name, smr_added[g] - 1);
+				ml_io_unmap(smmu, 0x4000);
+			}
+			smr_added[g] = 0;
+		}
+	}
+	if (dma_s1) {
+		/* 0317: the IFE write master and the ICP are stopped above: the streams back as found */
+		negroni_s1_off(&cam_s1);
+		dma_s1 = false;
+		for (unsigned i = 0; i < 2; i++) {
+			frames[i].dva = 0;      /* the frames stay for /dev/negronicam-*, the IOVAs do not */
+		}
+		cam_iova_next = CAM_IOVA_IO;
+	}
+	/* 0317: the HFI block only after the SMMU mappings at 0x10400000/0x800000 are gone (s1 off above), and never
+	 * while the ICP may still run (failed PAS shutdown: the block is leaked on purpose) */
+	if (hfi_kva && hfi_keep) {
+		say("  HFI block at phys %#llx KEPT (leaked on purpose): the ICP PAS shutdown failed", hfi_pa);
+		hfi_uc = 0;
+		hfi_kva = 0;
+	}
+	if (hfi_uc) {
+		ml_io_unmap(hfi_uc, HFI_BLOCK);
+		hfi_uc = 0;
+	}
+	if (hfi_kva) {
+		kmem_free(kernel_map, hfi_kva, HFI_BLOCK);
+		hfi_kva = 0;
+	}
+	if (cpas_on) {
+		/* cam_cpastop_qchannel_handshake(power_on = false): clear the request, wait QACCEPTN and QDENY = 0,
+		 * 50 x 200-250 us (cam_cpas_hw_intf.h:20-24) */
+		uint32_t got = 0;
+		wr(cpas + QCHANNEL_CTRL, 0);
+		bool ok = poll(cpas + QCHANNEL_STATUS, 0x3u, 0, 12500, &got);
+		say("  CAMNOC qchannel idle: status %#x%s", got, ok ? "" : " (not idle after 12.5 ms)");
+		cpas_on = false;
+	}
+	if (cci_irq_on) {
+		wr(cci + CCI_IRQ_MASK_0, 0);
+		wr(cci + CCI_IRQ_MASK_1, 0);
+		cci_irq_clear(CCI_IRQ_MASK_0_ALL);
+		cci_irq_on = false;
+	}
+	for (unsigned i = NBRANCHES; i-- > 0;) {
+		if (branches_on & (1u << i)) {
+			(void)branch_set(cc_branches[i].name, camcc + cc_branches[i].off, false, cc_branches[i].poll);
+			branches_on &= ~(1u << i);
+		}
+	}
+	if (gdsc_ours) {
+		uint32_t got = 0;
+		wr(camcc + CC_TITAN_GDSCR, rd(camcc + CC_TITAN_GDSCR) | GDSC_SW_COLLAPSE);
+		bool ok = poll(camcc + CC_TITAN_GDSCR, GDSC_PWR_ON, 0, GDSC_TIMEOUT_US, &got);
+		say("  titan top GDSC collapse: %#x%s", got, ok ? "" : " (still on)");
+		gdsc_ours = false;
+	}
+	if (sf_ours) {
+		wr(gcc + GCC_CAMERA_SF, rd(gcc + GCC_CAMERA_SF) & ~CBCR_ENABLE);
+		sf_ours = false;
+	}
+	if (hf_ours) {
+		wr(gcc + GCC_CAMERA_HF, rd(gcc + GCC_CAMERA_HF) & ~CBCR_ENABLE);
+		hf_ours = false;
+	}
+	say("power down done");
+}
+
+/* ---- 0312: RPMh votes before the first camcc access ---- */
+
+static int
+vote_retry(int (*fn)(void *), void *arg)
+{
+	int error = EBUSY;
+	/* the RPMh try-lock is shared with other drivers: retry EBUSY for 1 s */
+	for (unsigned i = 0; i < 200 && error == EBUSY; i++) {
+		error = fn(arg);
+		if (error == EBUSY) {
+			delay(5000);
+		}
+	}
+	return error;
+}
+
+static int
+vote_mmcx(void *arg __unused)
+{
+	return negroni_rpmh_arc_vote("mmcx.lvl", MMCX_LEVEL);
+}
+
+static int
+vote_bcm(void *arg)
+{
+	const struct cam_bcm *b = arg;
+	uint32_t data = 0;
+	return negroni_rpmh_cam_bcm(b->name, CAM_BW_AVG_KBPS, CAM_BW_PEAK_KBPS, b->buswidth, b->channels, b->enable_mask,
+	           &data);
+}
+
+static bool
+l0_votes(void)
+{
+	step_begin("rpmh mmcx + camera noc votes");
+	int error = vote_retry(vote_mmcx, NULL);
+	say("  mmcx.lvl level %u: errno %d", MMCX_LEVEL, error);
+	if (error) {
+		return step_fail("MMCX vote");
+	}
+	for (unsigned i = 0; i < sizeof(cam_bcms) / sizeof(cam_bcms[0]); i++) {
+		error = vote_retry(vote_bcm, (void *)(uintptr_t)&cam_bcms[i]);
+		say("  BCM %s (%s): errno %d", cam_bcms[i].name, cam_bcms[i].enable_mask ? "on" : "avg 1 GB/s, peak 3 GB/s", error);
+		if (error) {
+			return step_fail("BCM vote");
+		}
+	}
+	say("  votes stay after the run (not dropped)");
+	return step_ok();
+}
+
+/* ---- level 1 steps ---- */
+
+static bool
+l1_map(void)
+{
+	step_begin("map");
+	gcc = gcc ? gcc : ml_io_map_unmappable(GCC_CAM_PA, 0x1000, CAM_WIMG_IO);
+	camcc = camcc ? camcc : ml_io_map_unmappable(CAMCC_PA, CAMCC_SIZE, CAM_WIMG_IO);
+	cci = cci ? cci : ml_io_map_unmappable(CCI0_PA, 0x1000, CAM_WIMG_IO);
+	if (level >= 2) {
+		tlmm = tlmm ? tlmm : ml_io_map_unmappable(TLMM_PA + TLMM_FIRST * 0x1000u, (TLMM_LAST - TLMM_FIRST + 1) * 0x1000u,
+		    CAM_WIMG_IO);
+		if (!tlmm) {
+			return step_fail("TLMM map");
+		}
+	}
+	if (!gcc || !camcc || !cci) {
+		return step_fail("ml_io_map_unmappable returned 0");
+	}
+	return step_ok();
+}
+
+static bool
+l1_gcc(void)
+{
+	step_begin("gcc camera clocks");
+	/* AHB and XO are CLK_IS_CRITICAL (gcc:1859-1915): Linux keeps them on; turn on only if off */
+	static const struct { const char *name; uint32_t off; } crit[] = {
+		{ "gcc_camera_ahb_clk", GCC_CAMERA_AHB }, { "gcc_camera_xo_clk", GCC_CAMERA_XO },
+	};
+	for (unsigned i = 0; i < 2; i++) {
+		uint32_t v = rd(gcc + crit[i].off);
+		if (!(v & CBCR_ENABLE)) {
+			wr(gcc + crit[i].off, v | CBCR_ENABLE);
+			delay(10);              /* BRANCH_HALT_DELAY */
+		}
+		uint32_t now = rd(gcc + crit[i].off);
+		say("  %s: %#x -> %#x%s", crit[i].name, v, now, (now & CBCR_HWCG) ? " (hw clock gating: CLK_OFF not checked)" : "");
+		/*
+		 * gcc_camera_ahb_clk has hwcg (gcc:1862-1863): with HWCG_EN (bit 1) set, CLK_OFF (bit 31) can read 1
+		 * while the clock runs, and Linux skips the halt check (branch:21, :80). Then only the enable bit counts.
+		 */
+		if (!(now & CBCR_ENABLE) || (!(now & CBCR_HWCG) && (now & CBCR_OFF))) {
+			return step_fail("a critical GCC camera clock stays off");
+		}
+	}
+	/* CPAS clocks gcc_axi_hf_clk, gcc_axi_sf_clk (live.dts:22720 clocks <gcc 0x10 gcc 0x11>) */
+	uint32_t v = rd(gcc + GCC_CAMERA_HF);
+	if (!(v & CBCR_ENABLE)) {
+		wr(gcc + GCC_CAMERA_HF, v | CBCR_ENABLE);
+		hf_ours = true;
+	}
+	uint32_t w = rd(gcc + GCC_CAMERA_SF);
+	if (!(w & CBCR_ENABLE)) {
+		wr(gcc + GCC_CAMERA_SF, w | CBCR_ENABLE);
+		sf_ours = true;
+	}
+	say("  gcc_camera_hf_axi_clk %#x -> %#x, gcc_camera_sf_axi_clk %#x -> %#x (halt skip)", v,
+	    rd(gcc + GCC_CAMERA_HF), w, rd(gcc + GCC_CAMERA_SF));
+	return step_ok();
+}
+
+static bool
+l1_gdsc(void)
+{
+	step_begin("titan top gdsc");
+	uint32_t g = rd(camcc + CC_GDSC_CLK);
+	if (!(g & CBCR_ENABLE)) {
+		wr(camcc + CC_GDSC_CLK, g | CBCR_ENABLE);
+	}
+	say("  cam_cc_gdsc_clk %#x -> %#x", g, rd(camcc + CC_GDSC_CLK));
+	uint32_t v = rd(camcc + CC_TITAN_GDSCR), got = 0;
+	say("  titan top GDSCR %#x", v);
+	if (v == 0xffffffffu) {
+		return step_fail("camcc reads all ones (no access)");
+	}
+	if (v & GDSC_HW_CONTROL) {
+		return step_fail("GDSC under HW control");
+	}
+	if (!(v & GDSC_PWR_ON)) {
+		/* gdsc_enable (gdsc:208-350): clear SW_COLLAPSE, 1 us, poll PWR_ON */
+		wr(camcc + CC_TITAN_GDSCR, v & ~GDSC_SW_COLLAPSE);
+		(void)rd(camcc + CC_TITAN_GDSCR);
+		delay(1);
+		gdsc_ours = true;
+		if (!poll(camcc + CC_TITAN_GDSCR, GDSC_PWR_ON, GDSC_PWR_ON, GDSC_TIMEOUT_US, &got)) {
+			say("  GDSCR %#x after %u us", got, GDSC_TIMEOUT_US);
+			return step_fail("GDSC did not power on (MMCX off?)");
+		}
+	} else {
+		say("  titan top GDSC already on: not ours, stays on");
+	}
+	v = rd(camcc + CC_TITAN_GDSCR);
+	if (!(v & GDSC_RETAIN_FF)) {
+		wr(camcc + CC_TITAN_GDSCR, v | GDSC_RETAIN_FF);  /* qcom,retain-regs (gdsc:347-350) */
+	}
+	say("  titan top GDSCR now %#x", rd(camcc + CC_TITAN_GDSCR));
+	return step_ok();
+}
+
+static bool
+l1_clocks(void)
+{
+	step_begin("camcc clocks");
+	/* sources first (cam_cc_slow_ahb/fast_ahb/camnoc_axi/cci_0 at 19.2 MHz TCXO) */
+	if (!rcg_to_xo("cam_cc_slow_ahb_clk_src", CC_SLOW_AHB) || !rcg_to_xo("cam_cc_fast_ahb_clk_src", CC_FAST_AHB) ||
+	    !rcg_to_xo("cam_cc_camnoc_axi_clk_src", CC_CAMNOC_AXI) || !rcg_to_xo("cam_cc_cci_0_clk_src", CC_CCI0)) {
+		return step_fail("RCG update");
+	}
+	for (unsigned i = 0; i < NBRANCHES; i++) {
+		branches_on |= 1u << i;
+		if (!branch_set(cc_branches[i].name, camcc + cc_branches[i].off, true, cc_branches[i].poll)) {
+			return step_fail("branch clock did not start");
+		}
+	}
+	return step_ok();
+}
+
+static bool
+l1_cci(void)
+{
+	step_begin("cci0 controller");
+	if (!cci_init(CCI_MASTER)) {
+		return step_fail("no version or no reset ack");
+	}
+	return step_ok();
+}
+
+/* ---- level 2 steps (sensor slot 0) ---- */
+
+static bool
+l2_pins(void)
+{
+	step_begin("sensor pins");
+	/* gpio request: reset output-low (flags 0); pinctrl cam_default: reset gpio no pull, MCLK cam_mclk */
+	pins_sensor = true;
+	tlmm_set(PIN_RESET0, TLMM_CFG(0u, PULL_NONE, true), 0);
+	tlmm_set(PIN_MCLK0, TLMM_CFG(1u, PULL_NONE, false), -1);
+	return step_ok();
+}
+
+static bool
+l2_rails(void)
+{
+	step_begin("sensor rails");
+	for (unsigned i = 0; i < NRAILS; i++) {
+		rails_on |= 1u << i;    /* an uncertain vote is undone too */
+		if (rail_vote(&rails[i], true)) {
+			return step_fail(rails[i].name);
+		}
+		/* module:49: every rail "+0 ms" (the RPMh vote waits for the AOP ack) */
+	}
+	return step_ok();
+}
+
+static bool
+l2_reset(void)
+{
+	step_begin("sensor reset high");
+	reset_high = true;
+	tlmm_set(PIN_RESET0, TLMM_CFG(0u, PULL_NONE, true), 1);
+	delay(1000);                            /* RESET=1+1ms */
+	return step_ok();
+}
+
+static bool
+l2_mclk(void)
+{
+	step_begin("mclk0 19.2 MHz");
+	if (!rcg_to_xo("cam_cc_mclk0_clk_src", CC_MCLK0)) {
+		return step_fail("RCG update");
+	}
+	mclk_on = true;
+	if (!branch_set("cam_cc_mclk0_clk", camcc + CC_MCLK0_CBCR, true, true)) {
+		return step_fail("MCLK branch did not start");
+	}
+	delay(1000);                            /* MCLK=19200000Hz+1ms */
+	return step_ok();
+}
+
+static bool
+l2_cci_pins(void)
+{
+	step_begin("cci0 m0 pins + reset");
+	/* camera_io_init after the power-up (cam_sensor_core.c): pinctrl m0_active, then the master reset */
+	pins_cci = true;
+	tlmm_set(PIN_CCI0_SDA, TLMM_CFG(1u, PULL_UP, false), -1);
+	tlmm_set(PIN_CCI0_SCL, TLMM_CFG(1u, PULL_UP, false), -1);
+	if (!cci_reset(CCI_RESET_M0, NULL)) {
+		return step_fail("no master reset ack");
+	}
+	cci_timing(CCI_MASTER);
+	return step_ok();
+}
+
+static bool
+l2_chip_id(void)
+{
+	step_begin("chip id");
+	uint32_t id = 0;
+	int error = EIO;
+	for (unsigned t = 1; t <= CCI_READ_TRIES; t++) {
+		error = cci_read16(CCI_MASTER, SENSOR_SID, SENSOR_ID_REG, &id);
+		if (!error) {
+			break;
+		}
+		say("  try %u/%u: errno %d", t, CCI_READ_TRIES, error);
+		delay(1000);
+	}
+	if (error) {
+		return step_fail(error == ENXIO ? "sensor NACK" : "CCI read");
+	}
+	say("chip id %#06x (expected %#06x, IMX789 slot 0 CCI0 M0 sid %#x reg %#06x): %s", id, SENSOR_ID,
+	    SENSOR_SID, SENSOR_ID_REG, id == SENSOR_ID ? "MATCH" : "MISMATCH");
+	if (id != SENSOR_ID) {
+		return step_fail("wrong chip id");
+	}
+	return step_ok();
+}
+
+/* ---- level 3: CPAS top + CAMNOC (0312) ---- */
+
+static bool
+l3_cpas(void)
+{
+	step_begin("cpas + camnoc");
+	cpas = cpas ? cpas : ml_io_map_unmappable(CPAS_TOP_PA, 0x1000, CAM_WIMG_IO);
+	camnoc = camnoc ? camnoc : ml_io_map_unmappable(CAMNOC_PA, CAMNOC_SIZE, CAM_WIMG_IO);
+	if (!cpas || !camnoc) {
+		return step_fail("map");
+	}
+	uint32_t camv = rd(cpas + 0x0), cpasv = rd(cpas + 0x4), cap = rd(cpas + 0x8);
+	/* cam_cpastop_get_hw_info: camera major 23:16, minor 15:8, incr 7:0; cpas major 31:28, minor 27:16, incr 15:0 */
+	say("  titan camera version %#x (%u.%u.%u), cpas version %#x (%u.%u.%u), capability %#x", camv,
+	    (camv >> 16) & 0xffu, (camv >> 8) & 0xffu, camv & 0xffu, cpasv, cpasv >> 28, (cpasv >> 16) & 0xfffu,
+	    cpasv & 0xffffu, cap);
+	if (camv == 0 || camv == 0xffffffffu) {
+		return step_fail("CPAS top does not answer");
+	}
+	if (camv != CAM_VERSION_680) {
+		say("  note: camera version is not 6.8.0 (cam_cpas_api.h:74); the v680 CAMNOC table may not fit");
+	}
+	cpas_on = true;
+	/* cam_cpastop_poweron: reset_irq (SBM clear, then SBM enable), then the QoS values of each port */
+	wr(camnoc + SBM_FLAGOUTCLR0, 0x1);
+	wr(camnoc + SBM_FAULTINEN0, 0x2 | 0x4 | 0x8 | 0x10 | 0x20);
+	for (unsigned i = 0; i < sizeof(camnoc_rdi_wr) / sizeof(camnoc_rdi_wr[0]); i++) {
+		uint32_t old = rd(camnoc + camnoc_rdi_wr[i].off);
+		wr(camnoc + camnoc_rdi_wr[i].off, camnoc_rdi_wr[i].value);
+		say("  %s %#x: %#x -> %#x", camnoc_rdi_wr[i].name, camnoc_rdi_wr[i].off, old, rd(camnoc + camnoc_rdi_wr[i].off));
+	}
+	say("  IFE_RDI_WR_MAXWR_LOW %#x, SBM fault status %#x, error logger mainctl %#x errvld %#x log0 %#x:%#x",
+	    rd(camnoc + CAMNOC_RDI_MAXWR), rd(camnoc + SBM_FAULTINSTAT), rd(camnoc + ERRLOG_MAINCTL),
+	    rd(camnoc + ERRLOG_ERRVLD), rd(camnoc + ERRLOG_LOG0_HI), rd(camnoc + ERRLOG_LOG0_LO));
+	return step_ok();
+}
+
+/* CAMNOC error logger after a DMA: errvld bit 0 = a logged error (cam_cpastop_handle_errlogger) */
+static void
+camnoc_report(const char *when)
+{
+	if (!cpas_on) {
+		return;
+	}
+	say("  CAMNOC %s: SBM fault status %#x, errvld %#x, errlog0 %#x:%#x", when, rd(camnoc + SBM_FAULTINSTAT),
+	    rd(camnoc + ERRLOG_ERRVLD), rd(camnoc + ERRLOG_LOG0_HI), rd(camnoc + ERRLOG_LOG0_LO));
+}
+
+/*
+ * The apps-SMMU state of each camera stream group: read only unless negronicam_smmu=2 (as the Wi-Fi
+ * wlan_dma_path, patch 0263). dma_ok[g] = the streams reach RAM by physical address.
+ */
+static bool
+l3_smmu(void)
+{
+	step_begin("apps smmu camera streams");
+	vm_offset_t smmu = ml_io_map_unmappable(APPS_SMMU_PA, 0x4000, CAM_WIMG_IO);
+	if (!smmu) {
+		return step_fail("map");
+	}
+	uint32_t scr0 = rd(smmu + SMMU_SCR0), idr0 = rd(smmu + SMMU_IDR0), nsmr = MIN(idr0 & 0xffu, 128u);
+	bool stop = false;
+	say("  sCR0 %#x (CLIENTPD %u, USFCFG %u, EXIDS %u), IDR0 %#x (%u SMRs), sGFSR %#x, policy negronicam_smmu=%u",
+	    scr0, scr0 & 1u, (scr0 >> 10) & 1u, (scr0 >> 3) & 1u, idr0, nsmr, rd(smmu + SMMU_SGFSR), smmu_policy);
+	if (scr0 == 0xffffffffu || nsmr == 0 || (scr0 & (1u << 3))) {
+		ml_io_unmap(smmu, 0x4000);
+		say("  global space does not answer or EXIDS is set: DMA path unknown");
+		return smmu_policy == 0 ? step_ok() : step_fail("SMMU state unknown");
+	}
+	for (unsigned g = 0; g < NCAMGROUPS; g++) {
+		const struct cam_stream_group *cg = &cam_groups[g];
+		unsigned bypass = 0, fault = 0, translate = 0, unmatched = 0;
+		uint32_t free_smr = ~0u;
+		for (uint32_t k = 0; k < cg->nsids; k++) {
+			uint32_t hit = ~0u;
+			for (uint32_t i = 0; i < nsmr; i++) {
+				uint32_t smr = rd(smmu + SMMU_SMR(i));
+				if (!(smr & SMR_VALID)) {
+					if (free_smr == ~0u) {
+						free_smr = i;
+					}
+					continue;
+				}
+				uint32_t id = smr & 0x7fffu, mask = (smr >> 16) & 0x7fffu;
+				if (((id ^ cg->sids[k]) & ~mask & 0x7fffu) == 0) {
+					hit = i;
+					break;
+				}
+			}
+			if (hit == ~0u) {
+				unmatched++;
+				continue;
+			}
+			uint32_t s2cr = rd(smmu + SMMU_S2CR(hit)), type = (s2cr >> 16) & 3u;
+			say("  %s SID %#x: SMR%u %#x S2CR %#x (%s, context %u)", cg->name, cg->sids[k], hit,
+			    rd(smmu + SMMU_SMR(hit)), s2cr, type == 0 ? "translate" : type == 1 ? "bypass" : "fault", s2cr & 0xffu);
+			bypass += type == 1;
+			translate += type == 0;
+			fault += type >= 2;
+		}
+		/* unmatched streams follow sCR0: CLIENTPD = whole SMMU bypassed, else USFCFG 0 bypass / 1 fault */
+		bool unmatched_bypass = (scr0 & 1u) || !(scr0 & (1u << 10));
+		if (unmatched_bypass) {
+			bypass += unmatched;
+		} else {
+			fault += unmatched;
+		}
+		say("  %s group (SMR %#x mask %#x): %u bypass, %u translate, %u fault (%u SIDs without SMR, unmatched -> %s)",
+		    cg->name, cg->sid, cg->mask, bypass, translate, fault, unmatched, unmatched_bypass ? "bypass" : "fault");
+		dma_ok[g] = bypass == cg->nsids;
+		if (!dma_ok[g] && smmu_policy == 2 && translate == 0 && unmatched == cg->nsids && free_smr != ~0u) {
+			/* arm-smmu.c order: S2CR first, then the SMR valid bit */
+			wr(smmu + SMMU_S2CR(free_smr), 1u << 16);
+			wr(smmu + SMMU_SMR(free_smr), SMR_VALID | cg->mask << 16 | cg->sid);
+			uint32_t smr = rd(smmu + SMMU_SMR(free_smr)), s2 = rd(smmu + SMMU_S2CR(free_smr));
+			say("  %s: SMR%u = %#x, S2CR%u = %#x (bypass added, negronicam_smmu=2)", cg->name, free_smr, smr, free_smr, s2);
+			smr_added[g] = free_smr + 1;
+			dma_ok[g] = smr == (SMR_VALID | cg->mask << 16 | cg->sid) && ((s2 >> 16) & 3u) == 1u;
+			if (!dma_ok[g]) {
+				say("  %s: the SMMU (or the hypervisor) did not take the bypass entry", cg->name);
+			}
+		}
+		say("  %s DMA by physical address: %s", cg->name, dma_ok[g] ? "YES" : "NO");
+		if (!dma_ok[g] && smmu_policy == 1 && (g == 0 ? level >= 5u : level == 6u)) {     /* IFE DMA at level 5, ICP at 6 */
+			stop = true;
+		}
+	}
+	ml_io_unmap(smmu, 0x4000);
+	if (stop) {
+		return step_fail("a camera stream group would fault or translate (negronicam_smmu=2 adds a bypass entry, "
+		           "=0 tries anyway)");
+	}
+	if (smmu_policy == 3 && level >= 5) {
+		/* 0317: our own translation context; IFE only below level 6 (fewer entries taken) */
+		cam_s1.nstreams = level == 6 ? 5u : 1u; /* 0318: level 7 (iOS stream) needs the IFE only */
+		if (negroni_s1_on(&cam_s1) != 0) {
+			return step_fail("no apps-SMMU stage-1 context for the camera streams (negronicam_smmu=3)");
+		}
+		dma_s1 = true;
+		dma_ok[0] = true;
+		dma_ok[1] = level == 6;
+		say("  camera DMA through SMMU context %u: IFE IOVAs from %#llx%s", cam_s1.cb, CAM_IOVA_IO,
+		    level == 6 ? ", ICP fw_uncached 0x10400000 + shared 0x800000" : "");
+	}
+	return step_ok();
+}
+
+/* ---- level 4: capture clocks + CSIPHY1 C-PHY (0313) ---- */
+
+static bool
+l4_clocks(void)
+{
+	step_begin("capture clocks");
+	use_plls = (src_mask & 2u) != 0;
+	if (use_plls) {
+		int error = EBUSY;
+		for (unsigned i = 0; i < 200 && error == EBUSY; i++) {
+			error = negroni_rpmh_arc_vote("mxc.lvl", MXC_PLL_LEVEL);
+			if (error == EBUSY) {
+				delay(5000);
+			}
+		}
+		say("  RPMh mxc.lvl level %u: errno %d", MXC_PLL_LEVEL, error);
+		if (error) {
+			return step_fail("MXC vote for the PLL calibration");
+		}
+		mxc_voted = true;
+		for (unsigned i = 0; i < NPLLS; i++) {
+			plls_on |= 1u << i;
+			if (!pll_enable(&cam_plls[i])) {
+				return step_fail("PLL did not lock");
+			}
+		}
+	}
+	for (unsigned i = 0; i < NPATH_RCGS; i++) {
+		path_rcgs_set |= 1u << i;
+		if (!rcg_set(path_rcgs[i].name, path_rcgs[i].off, use_plls ? path_rcgs[i].src : 0, use_plls ? path_rcgs[i].hid : 0)) {
+			return step_fail("RCG update");
+		}
+	}
+	/* IFE0 GDSC (ife0-supply, live.dts:23523), as l1_gdsc */
+	uint32_t v = rd(camcc + CC_IFE0_GDSCR), got = 0;
+	say("  IFE0 GDSCR %#x", v);
+	if (v & GDSC_HW_CONTROL) {
+		return step_fail("IFE0 GDSC under HW control");
+	}
+	if (!(v & GDSC_PWR_ON)) {
+		wr(camcc + CC_IFE0_GDSCR, v & ~GDSC_SW_COLLAPSE);
+		ife_gdsc_ours = true;
+		if (!poll(camcc + CC_IFE0_GDSCR, GDSC_PWR_ON, GDSC_PWR_ON, GDSC_TIMEOUT_US, &got)) {
+			say("  IFE0 GDSCR %#x after %u us", got, GDSC_TIMEOUT_US);
+			return step_fail("IFE0 GDSC did not power on");
+		}
+	}
+	wr(camcc + CC_IFE0_GDSCR, rd(camcc + CC_IFE0_GDSCR) | GDSC_RETAIN_FF);  /* qcom,retain-regs (live.dts:940) */
+	for (unsigned i = 0; i < NPATH_BRANCHES; i++) {
+		path_branches_on |= 1u << i;
+		if (!branch_set(path_branches[i].name, camcc + path_branches[i].off, true, true)) {
+			return step_fail("branch clock did not start");
+		}
+	}
+	return step_ok();
+}
+
+static void
+phy_write(const struct phy_reg *r, uint32_t lane_off, uint32_t delay_extra)
+{
+	uint32_t v = r->data;
+	if (r->type == PT_SETTLE_LO) {
+		v = settle_cnt & 0xffu;
+	} else if (r->type == PT_SETTLE_HI) {
+		v = (settle_cnt >> 8) & 0xffu;
+	}
+	wr(csiphy + r->addr + lane_off, v);
+	if (r->delay_us + delay_extra) {
+		delay(r->delay_us + delay_extra);
+	}
+}
+
+/*
+ * cam_csiphy_core.c CAM_START_DEV (:2379-2429) for one C-PHY device: clocks (l4_clocks), cam_csiphy_reset
+ * (reset enter :356-373), prgm_cmn_data(false) (:384-441, rgltr-enable-sync = 1 in the DT), config_dev
+ * (:1110-1321: common regs with the lane enable, data-rate regs, the 37 3-phase regs of each of the 3 trios,
+ * irq config), release from reset (3-phase: 0x1000 = 0x0e, then 3048 us), trio status (:2431-2451).
+ * Settle count: config_dev computes settle_time / 200000000 from the userland value; this file takes the
+ * count from the module file (mode 1, 4000x3008, settle 52, out/camera/modules.txt) as the count itself [I:
+ * the D-PHY modules give 26-40, which as a 300-400 MHz timer count is inside the MIPI THS-SETTLE window
+ * (85 ns + 6 UI .. 145 ns + 10 UI), so the module value is a count, not ns].
+ * Data rate [I]: IMX789 FTM PLL (cam_sensor_settings.h:6017-6141) IOP 19.2 / 2 (0x030d) x 343 (0x030e/f) =
+ * 3292.8 MHz, IOP_SYCK_DIV 4 (0x030b) -> 823 MSps per trio; 823e6 x 2.28 bit = 1.88e9 < 2.736e9 = entry 0.
+ */
+static bool
+l4_csiphy(void)
+{
+	step_begin("csiphy1 c-phy 3 trios");
+	if (drate_idx != 0) {
+		return step_fail("only data-rate entry 0 (<= 1.2 GSps) is carried in this file");
+	}
+	csiphy = csiphy ? csiphy : ml_io_map_unmappable(CSIPHY1_PA, CSIPHY_SIZE, CAM_WIMG_IO);
+	if (!csiphy) {
+		return step_fail("map");
+	}
+	csiphy_on = true;
+	say("  rails csi-vdd-0p9 pm8350_l5 / csi-vdd-1p2 pm8350_l6: shared with the UFS PHY, on, not voted");
+	/* reset enter (:51-54) */
+	wr(csiphy + 0x1014, 0);
+	wr(csiphy + 0x1000, 1);
+	/* common data (:44-49): DEFAULT_PARAMS entries */
+	wr(csiphy + 0x1084, 0x00);
+	wr(csiphy + 0x1018, 0x01);
+	wr(csiphy + 0x101c, 0x7a);
+	/* config_dev: common regs, lane enable first */
+	wr(csiphy + 0x1014, CPHY_LANE_ENABLE);
+	wr(csiphy + 0x1084, 0x00);
+	wr(csiphy + 0x1018, 0x01);
+	wr(csiphy + 0x101c, 0x7a);
+	for (uint32_t t = 0; t < 3; t++) {
+		for (unsigned i = 0; i < sizeof(cphy_drate0) / sizeof(cphy_drate0[0]); i++) {
+			phy_write(&cphy_drate0[i], 0x400u * t, 0);
+		}
+	}
+	wr(csiphy + 0x108c, 0x0c);              /* entry 0, trio 2 (:548) */
+	for (uint32_t t = 0; t < 3; t++) {
+		for (unsigned i = 0; i < NCPHY_LANE; i++) {
+			phy_write(&cphy_lane[i], 0x400u * t, (t == 2 && i == NCPHY_LANE - 1) ? 100 : 0);
+		}
+	}
+	/* cam_csiphy_cphy_irq_config: csiphy_irq_reg_2_1_0 (:62-74) */
+	static const uint8_t irqv[11] = { 0xff, 0xff, 0xfb, 0xff, 0x7f, 0xff, 0xff, 0xef, 0xff, 0xff, 0xff };
+	for (uint32_t i = 0; i < 11; i++) {
+		wr(csiphy + 0x102c + 4 * i, irqv[i]);
+	}
+	delay(100);                             /* 0x1054 entry delay 0x64 */
+	/* release from reset, 3-phase (:56-60): 0x1000 = 0x0e, delay 0xbe8 us */
+	wr(csiphy + 0x1000, 0x0e);
+	delay(3048);
+	/* trio status (status_regs_2_1_0 :18-24 cphy_lane_status 0x358/0x758/0xb58, low 5 bits; 0 or 8 = normal) */
+	for (uint32_t t = 0; t < 3; t++) {
+		uint32_t s = rd(csiphy + 0x358 + 0x400 * t);
+		say("  trio %u status %#x (low 5 bits %#x: %s)", t, s, s & 0x1fu, ((s & 0x1fu) == 0 || (s & 0x1fu) == 8) ?
+		    "normal" : "unexpected");
+	}
+	say("  lane enable %#x, settle count %u, data-rate entry %u, irq status0 %#x", rd(csiphy + 0x1014), settle_cnt,
+	    drate_idx, rd(csiphy + 0x10b0));
+	return step_ok();
+}
+
+/* ---- 0314: IMX789 FTM table, stream on ---- */
+
+static bool
+l4_stream(void)
+{
+	step_begin("imx789 ftm table + stream on");
+	uint32_t fc0 = 0, fc1 = 0, fc2 = 0;
+	for (unsigned i = 0; i < NFTM; i++) {
+		if (imx789_ftm[i].reg == SENSOR_MODE_SEL) {
+			streaming = true;               /* the stream off runs on every path after this write */
+		}
+		int e = cci_write8(CCI_MASTER, SENSOR_SID, imx789_ftm[i].reg, imx789_ftm[i].val);
+		if (e) {
+			say("  write %u/%u (%#06x = %#04x) failed: errno %d", i + 1, (unsigned)NFTM, imx789_ftm[i].reg,
+			    imx789_ftm[i].val, e);
+			return step_fail("CCI write");
+		}
+	}
+	say("  %u writes done (last: %#06x = %#04x, stream on)", (unsigned)NFTM, imx789_ftm[NFTM - 1].reg,
+	    imx789_ftm[NFTM - 1].val);
+	/* frame counter: 3 reads 50 ms apart (30 fps = 33 ms per frame) */
+	if (cci_read8(CCI_MASTER, SENSOR_SID, SENSOR_FRAME_CNT, &fc0) || (delay(50000), 0) ||
+	    cci_read8(CCI_MASTER, SENSOR_SID, SENSOR_FRAME_CNT, &fc1) || (delay(50000), 0) ||
+	    cci_read8(CCI_MASTER, SENSOR_SID, SENSOR_FRAME_CNT, &fc2)) {
+		return step_fail("frame counter read");
+	}
+	say("IMX789 frame counter %#04x -> %#04x -> %#04x: %s", fc0, fc1, fc2,
+	    (fc0 != fc1 && fc1 != fc2) ? "MOVES (sensor streams)" : "STUCK (no stream)");
+	if (fc0 == fc1 && fc1 == fc2) {
+		return step_fail("the sensor does not stream");
+	}
+	return step_ok();
+}
+
+/* ---- level 5: CSID0 + IFE0 RDI0 (+ TPG13) -> memory (0315) ---- */
+
+static bool
+l5_map(void)
+{
+	step_begin("csid0 + ife0 map");
+	if (!csid) {
+		csid = ml_io_map_unmappable(CSID0_PA, 0x1000, CAM_WIMG_IO);
+		csid_top = ml_io_map_unmappable(CSID_TOP_PA, 0x1000, CAM_WIMG_IO);
+		ife = ml_io_map_unmappable(IFE0_PA, IFE0_SIZE, CAM_WIMG_IO);
+		tpg = ml_io_map_unmappable(TPG13_PA, 0x1000, CAM_WIMG_IO);
+	}
+	if (!csid || !csid_top || !ife || !tpg) {
+		return step_fail("map");
+	}
+	uint32_t cv = rd(csid + 0x0), iv = rd(ife + 0x0), bv = rd(ife + 0xc00), tv = rd(tpg + TPG_VERSION);
+	say("  CSID0 hw version %#x (680 = 6.8.0, cam_ife_csid680.h:1185-1187), IFE0 top version %#x, bus version %#x, "
+	    "TPG13 version %#x (2.0.0 expected, tpg_hw_v_1_3.c:98-100)", cv, iv, bv, tv);
+	if (cv == 0 || cv == 0xffffffffu || iv == 0xffffffffu) {
+		return step_fail("CSID/IFE do not answer");
+	}
+	if (!dma_ok[0] && smmu_policy != 0) {
+		return step_fail("IFE stream group has no bypass (level 3); no DMA");
+	}
+	return step_ok();
+}
+
+static bool
+frame_alloc(struct cam_frame *f, uint32_t width, uint32_t height, uint32_t source)
+{
+	f->width = width;
+	f->height = height;
+	f->stride = width * 10u / 8u;   /* MIPI RAW10 bytes per line as received (RDI payload only) */
+	f->bytes = f->stride * height;
+	f->source = source;
+	f->done = 0;
+	if (f->kva == 0) {
+		/* two frames: the frame-based WM moves to addr + frame_incr for the next frame until the halt */
+		f->alloc = round_page((vm_size_t)f->bytes * 2u);
+		/* 0317: anywhere in RAM (0315 asked for < 4 GiB: impossible, XNU RAM starts at 0x840000000) */
+		if (kmem_alloc_contig(kernel_map, &f->kva, f->alloc, 0, 0, 0, KMA_KOBJECT, VM_KERN_MEMORY_IOKIT) !=
+		    KERN_SUCCESS) {
+			f->kva = 0;
+			say("  no %lu bytes of contiguous memory", (unsigned long)f->alloc);
+			return false;
+		}
+	}
+	f->pa = kvtophys(f->kva);
+	if (f->pa == 0 || kvtophys(f->kva + f->alloc - PAGE_SIZE) != f->pa + f->alloc - PAGE_SIZE) {
+		say("  buffer at phys %#llx is not one piece", f->pa);
+		return false;
+	}
+	if (dma_s1) {
+		if (f->dva == 0) {
+			uint64_t iova = cam_iova_next;
+			if (iova + f->alloc > CAM_IOVA_IO_END ||
+			    negroni_s1_map_kva(&cam_s1, iova, f->kva, f->alloc) != 0) {
+				say("  no IOVA for the buffer (SMMU map failed)");
+				return false;
+			}
+			f->dva = iova;
+			/* at least 1 MiB of unmapped IOVA after each buffer: a stray write past it faults */
+			cam_iova_next = (iova + f->alloc + 0x100000ull + 0xfffffull) & ~0xfffffull;
+		}
+	} else if (f->pa + f->alloc > 0x100000000ull) {
+		say("  buffer at phys %#llx has no 32-bit address and the stream is not translated: use negronicam_smmu=3",
+		    f->pa);
+		return false;
+	} else {
+		f->dva = f->pa;
+	}
+	memset((void *)f->kva, FRAME_FILL, f->alloc);
+	flush_dcache64((addr64_t)f->pa, (unsigned)f->alloc, TRUE);      /* clean + invalidate: RAM holds the fill */
+	say("  buffer %s: phys %#llx, device address %#llx (%s), %lu bytes (frame %u x %u RAW10, %u bytes per line, %u bytes)",
+	    source == 1 ? "TPG" : "sensor", f->pa, f->dva, dma_s1 ? "SMMU IOVA" : "physical", (unsigned long)f->alloc, width,
+	    height, f->stride, f->bytes);
+	return true;
+}
+
+/* CSID global reset (camss-csid-680.c csid_reset :290-330; cam_ife_csid680.h:1205-1217 values) */
+static bool
+csid_reset(void)
+{
+	uint32_t got = 0;
+	wr(csid + CSID_TOP_IRQ_MASK, CSID_TOP_IRQ_RESET);
+	wr(csid + CSID_IRQ_CMD, 1);
+	wr(csid + CSID_RESET_CFG, 1u | 1u << 4);        /* mode immediate, location complete */
+	wr(csid + CSID_RESET_CMD, 3);                   /* HW + SW reset */
+	bool ok = poll(csid + CSID_TOP_IRQ_STATUS, CSID_TOP_IRQ_RESET, CSID_TOP_IRQ_RESET, 100000, &got);
+	wr(csid + CSID_TOP_IRQ_CLEAR, got);
+	wr(csid + CSID_IRQ_CMD, 1);
+	say("  CSID0 reset %s (top irq status %#x)", ok ? "done" : "NOT acked in 100 ms", got);
+	return ok;
+}
+
+/*
+ * One frame: WM (vfe_wm_start/update, frame based as cam_vfe_bus_ver3_config_rdi_wm for MIPI RAW10), CSID
+ * top/RDI0/RX (csid_configure_stream), RUP + AUP (reg_update_rdi: bit 4 + n and 20 + n), RDI resume, then the
+ * source. Waits for BUF_DONE (RDI0) up to timeout_ms; then halts RDI0 and the WM.
+ */
+/* 0318: the pipe setup of capture(), also used by the iOS stream (frame increment 0 there) */
+static bool
+pipe_start(uint64_t dva, uint32_t stride, uint32_t incr, bool from_tpg)
+{
+	if (!csid_reset()) {
+		return false;
+	}
+	csid_on = true;
+	wr(csid_top + 0x0, 1u << 8 | 1u);       /* IO_PATH_CFG0(csid 0): OUTPUT_IFE_EN | input core IFE (camss-csid-680.c:224-231) */
+	/* WM RDI0 */
+	wr(ife + WM_RDI0 + WM_CFG, 0);
+	wr(ife + WM_RDI0 + WM_IMAGE_CFG0, 0xffffu);     /* frame based: width 0xffff, height 0 (bus_ver3.c:866-869) */
+	wr(ife + WM_RDI0 + WM_PACKER_CFG, 0);           /* PACKER_FMT_VER3_PLAIN_128 (bus_ver3.c:54) */
+	wr(ife + WM_RDI0 + WM_IMAGE_CFG2, (stride + 15u) & ~15u);
+	wr(ife + WM_RDI0 + WM_FRAME_INCR, incr);
+	wr(ife + WM_RDI0 + WM_IMAGE_ADDR, (uint32_t)dva);    /* 32-bit IOVA: no "expanded_memory" in the DT */
+	wr(ife + WM_RDI0 + WM_DROP_PERIOD, 0);
+	wr(ife + WM_RDI0 + WM_DROP_PATTERN, 1);
+	wr(ife + WM_RDI0 + WM_SUB_PERIOD, 0);
+	wr(ife + WM_RDI0 + WM_SUB_PATTERN, 1);
+	wr(ife + WM_RDI0 + WM_MMU_PREFETCH, 1);
+	wr(ife + WM_RDI0 + WM_MMU_PREFETCH_MAX, 0xffffffffu);
+	wr(ife + WM_RDI0 + WM_CFG, 1u << 16 | 1u);      /* frame based, enable */
+	wr(ife + WM_RDI0 + WM_DEBUG_CFG, 11u << 8);
+	wm_on = true;
+	/* CSID IRQ masks: the status bits are polled */
+	wr(csid + CSID_RDI0_IRQ_MASK, 0x7fff);
+	wr(csid + CSID_RDI0_IRQ_CLEAR, 0xffffffffu);
+	wr(csid + CSID_BUF_DONE_CLEAR, 0xffffffffu);
+	wr(csid + CSID_BUF_DONE_MASK, 0xffffffffu);
+	wr(csid + CSID_RX_IRQ_CLEAR, 0xffffffffu);
+	wr(csid + CSID_RX_IRQ_MASK, 0x0fffffffu);
+	wr(csid + CSID_TOP_IRQ_MASK, 0xffffffffu);
+	wr(csid + CSID_IRQ_CMD, 1);
+	/* RDI0 path */
+	wr(csid + CSID_RDI0_FRM_DROP_PERIOD, 0);
+	wr(csid + CSID_RDI0_CFG0, DECODE_PAYLOAD_ONLY << 12 | DT_RAW10 << 16 | 0u << 22 | 0u << 27);
+	wr(csid + CSID_RDI0_CFG1, RDI_CFG1_STB_FRAME | RDI_CFG1_BYTE_CNTR | RDI_CFG1_TIMESTAMP | RDI_CFG1_PACK_MIPI);
+	wr(csid + CSID_RDI0_SUBSAMPLE_PERIOD, 0);
+	wr(csid + CSID_RDI0_SUBSAMPLE_PATTERN, 1);
+	wr(csid + CSID_RDI0_CTRL, 0);
+	wr(csid + CSID_RDI0_CFG0, rd(csid + CSID_RDI0_CFG0) | 1u << 31);
+	/* RX (cam_ife_csid_ver2 rx cfg :4052-4080) */
+	uint32_t rx0;
+	if (from_tpg) {
+		/* 4 D-PHY lanes 0x3210, TPG mux on, TPG number 1 = tpg13 (phy-id 0) (ver2.c:2519-2522) */
+		rx0 = 3u | 0x3210u << 4 | 0u << 24 | RX_CFG0_TPG_MUX_EN | 1u << 28;
+	} else {
+		/* 3 trios, lane cfg 0x210, C-PHY (type 1), phy 1 + base index 1 (camss-csid-680.c:186-200) */
+		rx0 = 2u | 0x210u << 4 | 1u << 24 | (1u + 1u) << 20;
+	}
+	wr(csid + CSID_RX_CFG0, rx0);
+	wr(csid + CSID_RX_CFG1, 1u | 1u << 6);   /* ECC correction, MISR */
+	/* RUP + AUP for RDI0 */
+	wr(csid + CSID_RUP_AUP, 1u << 4 | 1u << 20);
+	wr(csid + CSID_RDI0_CTRL, 1);            /* resume at frame boundary */
+	say("  CSID0 rx cfg0 %#x cfg1 %#x, RDI0 cfg0 %#x cfg1 %#x; WM RDI0 cfg %#x addr %#x incr %#x", rd(csid + CSID_RX_CFG0),
+	    rd(csid + CSID_RX_CFG1), rd(csid + CSID_RDI0_CFG0), rd(csid + CSID_RDI0_CFG1), rd(ife + WM_RDI0 + WM_CFG),
+	    rd(ife + WM_RDI0 + WM_IMAGE_ADDR), rd(ife + WM_RDI0 + WM_FRAME_INCR));
+	/* the source */
+	if (from_tpg) {
+		wr(tpg + TPG_CTRL, 0);
+		wr(tpg + TPG_TOP_IRQ_MASK, 0);
+		wr(tpg + TPG_TOP_IRQ_CLEAR, 1);
+		wr(tpg + TPG_TOP_IRQ_CMD, 1);
+		wr(tpg + TPG_TOP_CLEAR, 1);
+		tpg_on = true;
+		/* configure_vc / configure_dt / configure_global_configs (:236-345, :147-190); HBI/VBI as Linux
+		 * camss-tpg-gen1.c tpg_stream_on: HBI = W * 10 bit * 545 % / (8 * 4 lanes), VBI = H * 10 % */
+		wr(tpg + TPG_VC0_COLORBAR, 0xau << 8);
+		wr(tpg + TPG_VC0_HBI, (TPG_W * 10u * 545u + 3199u) / 3200u);
+		wr(tpg + TPG_VC0_VBI, TPG_H / 10u);
+		wr(tpg + TPG_VC0_LFSR, 0x12345678);
+		wr(tpg + TPG_VC0_CFG0, 0);                                      /* 1 DT, VC 0, endless frames */
+		wr(tpg + TPG_VC0_DT0_CFG0, TPG_W << 16 | TPG_H);
+		wr(tpg + TPG_VC0_DT0_CFG1, DT_RAW10);
+		wr(tpg + TPG_VC0_DT0_CFG2, 2u << 20 | 8u);                       /* RAW_10_BIT, COLOR_BARS */
+		wr(tpg + TPG_THROTTLE, 0);
+		wr(tpg + TPG_TOP_IRQ_MASK, 1);
+		wr(tpg + TPG_CTRL, 0u << 30 | 3u << 4 | 0u << 6 | 0u << 3 | 1u);   /* 1 VC, 4 lanes, D-PHY, enable */
+		say("  TPG13 on: ctrl %#x status %#x", rd(tpg + TPG_CTRL), rd(tpg + TPG_STATUS));
+	} else if (!l4_stream()) {
+		return false;
+	}
+	return true;
+}
+
+static bool
+capture(struct cam_frame *f, bool from_tpg, uint32_t timeout_ms)
+{
+	uint32_t got = 0;
+	if (!pipe_start(f->dva, f->stride, f->bytes, from_tpg)) {
+		return false;
+	}
+	/* wait for the frame */
+	uint64_t t0 = now_us();
+	bool ok = poll(csid + CSID_BUF_DONE_STATUS, CSID_BUF_DONE_RDI0, CSID_BUF_DONE_RDI0, timeout_ms * 1000u, &got);
+	uint32_t took = (uint32_t)((now_us() - t0) / 1000u);
+	wr(csid + CSID_RDI0_CTRL, 0);            /* halt at the frame boundary */
+	uint32_t rdi_irq = rd(csid + CSID_RDI0_IRQ_STATUS), rx_irq = rd(csid + CSID_RX_IRQ_STATUS),
+	    top_irq = rd(csid + CSID_TOP_IRQ_STATUS);
+	say("  %s: BUF_DONE status %#x after %u ms; RDI0 irq %#x (SOF bit 12, EOF bit 9, overflow bit 2/19), RX irq %#x, "
+	    "top irq %#x", ok ? "FRAME DONE" : "NO FRAME", got, took, rdi_irq, rx_irq, top_irq);
+	say("  CSID0 rx packets %u, ECC %#x, CRC errors %u, long pkt hdr %#x, RDI0 format measure %#x",
+	    rd(csid + CSID_RX_TOTAL_PKTS), rd(csid + CSID_RX_STATS_ECC), rd(csid + CSID_RX_CRC_ERRORS),
+	    rd(csid + CSID_RX_LONG_PKT_0), rd(csid + CSID_RDI0_FORMAT_MEASURE0));
+	say("  IFE0 bus irq %#x %#x, violation %#x, overflow %#x, image violation %#x; WM addr status %#x, debug %#x %#x",
+	    rd(ife + VFE_BUS_IRQ_STATUS0), rd(ife + VFE_BUS_IRQ_STATUS1), rd(ife + VFE_BUS_VIOLATION),
+	    rd(ife + VFE_BUS_OVERFLOW), rd(ife + VFE_BUS_IMG_VIOLATION), rd(ife + WM_RDI0 + WM_ADDR_STATUS0),
+	    rd(ife + WM_RDI0 + WM_DEBUG_STATUS0), rd(ife + WM_RDI0 + WM_DEBUG_STATUS1));
+	camnoc_report("after the frame");
+	if (dma_s1) {
+		negroni_s1_report(&cam_s1, ok ? "after the frame" : "after NO FRAME");
+	}
+	delay(40000);                           /* let a frame in flight finish into the guard frame */
+	wr(ife + WM_RDI0 + WM_CFG, 0);
+	wm_on = false;
+	if (from_tpg) {
+		wr(tpg + TPG_CTRL, 0);
+		tpg_on = false;
+	} else if (streaming) {
+		int e = cci_write8(CCI_MASTER, SENSOR_SID, SENSOR_MODE_SEL, 0);
+		say("  IMX789 stream off: errno %d", e);
+		streaming = false;
+	}
+	wr(csid + CSID_RDI0_CFG0, rd(csid + CSID_RDI0_CFG0) & ~(1u << 31));
+	wr(csid + CSID_BUF_DONE_CLEAR, got);
+	wr(csid + CSID_RDI0_IRQ_CLEAR, rdi_irq);
+	wr(csid + CSID_RX_IRQ_CLEAR, rx_irq);
+	wr(csid + CSID_IRQ_CMD, 1);
+	return ok;
+}
+
+/* the proof lines: first bytes, bytes changed from the fill, distinct values, a coarse histogram */
+static bool
+frame_check(struct cam_frame *f, const char *name)
+{
+	flush_dcache64((addr64_t)f->pa, (unsigned)f->alloc, TRUE);      /* drop stale lines before the CPU reads */
+	const uint8_t *p = (const uint8_t *)f->kva;
+	uint32_t changed = 0, hist[8] = { 0 }, seen[8] = { 0 }, distinct = 0;
+	for (uint32_t i = 0; i < f->bytes; i++) {
+		changed += p[i] != FRAME_FILL;
+		hist[p[i] >> 5]++;
+		if (!(seen[p[i] >> 5] & (1u << (p[i] & 31u)))) {
+			seen[p[i] >> 5] |= 1u << (p[i] & 31u);
+			distinct++;
+		}
+	}
+	say("%s frame first bytes: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x", name,
+	    p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8], p[9], p[10], p[11], p[12], p[13], p[14], p[15]);
+	const uint8_t *m = p + (f->bytes / 2u & ~15u);
+	say("%s frame middle bytes: %02x %02x %02x %02x %02x %02x %02x %02x", name, m[0], m[1], m[2], m[3], m[4], m[5],
+	    m[6], m[7]);
+	say("%s frame: %u of %u bytes changed from the %#x fill, %u distinct byte values, histogram (byte >> 5) "
+	    "%u %u %u %u %u %u %u %u", name, changed, f->bytes, FRAME_FILL, distinct, hist[0], hist[1], hist[2], hist[3],
+	    hist[4], hist[5], hist[6], hist[7]);
+	bool good = changed > f->bytes / 2u && distinct > 4;
+	say("%s frame sanity: %s", name, good ? "PASS (non-constant data in most of the buffer)" : "FAIL");
+	f->done = good;
+	return good;
+}
+
+/* /dev/negronicam-tpg (minor 0) and /dev/negronicam-sensor (minor 1): 64-byte header + the frame bytes */
+struct camdev_hdr {
+	char magic[8];                  /* "NCAMRAW1" */
+	uint32_t version, width, height, stride, bytes, data_type, bits, packing, source, valid;
+	uint8_t pad[16];
+};
+_Static_assert(sizeof(struct camdev_hdr) == 64, "camdev header is 64 bytes");
+
+/* 0318: minor 2 = /dev/negronicam, the frame stream for iOS (level 7) */
+static int ios_read(struct uio *uio);
+static int ios_write(struct uio *uio);
+static volatile bool ios_open;
+
+static int
+camdev_open(dev_t dev, int flags __unused, int devtype __unused, struct proc *p __unused)
+{
+	if (minor(dev) == 2) {
+		if (level != 7) {
+			return ENXIO;
+		}
+		ios_open = true;
+		return 0;
+	}
+	return minor(dev) < 2 ? 0 : ENXIO;
+}
+
+static int
+camdev_close(dev_t dev, int flags __unused, int devtype __unused, struct proc *p __unused)
+{
+	if (minor(dev) == 2) {
+		ios_open = false;               /* the last close: the session ends at its next loop */
+	}
+	return 0;
+}
+
+static int
+camdev_write(dev_t dev, struct uio *uio, int ioflag __unused)
+{
+	return minor(dev) == 2 ? ios_write(uio) : ENODEV;
+}
+
+static int
+camdev_read(dev_t dev, struct uio *uio, int ioflag __unused)
+{
+	if (minor(dev) == 2) {
+		return ios_read(uio);
+	}
+	struct cam_frame *f = &frames[minor(dev) & 1];
+	if (f->kva == 0) {
+		return ENXIO;
+	}
+	struct camdev_hdr h;
+	bzero(&h, sizeof(h));
+	memcpy(h.magic, "NCAMRAW1", 8);
+	h.version = 1;
+	h.width = f->width;
+	h.height = f->height;
+	h.stride = f->stride;
+	h.bytes = f->bytes;
+	h.data_type = DT_RAW10;
+	h.bits = 10;
+	h.packing = 1;                  /* MIPI RAW10: 4 pixels in 5 bytes */
+	h.source = f->source;
+	h.valid = f->done;
+	int error = 0;
+	while (error == 0 && uio_resid(uio) > 0) {
+		off_t off = uio_offset(uio);
+		if (off < 0 || off >= (off_t)sizeof(h) + f->bytes) {
+			break;
+		}
+		if (off < (off_t)sizeof(h)) {
+			error = uiomove((caddr_t)&h + off, (int)MIN((off_t)sizeof(h) - off, uio_resid(uio)), uio);
+		} else {
+			off_t at = off - (off_t)sizeof(h);
+			int n = (int)MIN(MIN((off_t)f->bytes - at, uio_resid(uio)), (off_t)(1 << 20));
+			error = uiomove((caddr_t)(f->kva + at), n, uio);
+		}
+	}
+	return error;
+}
+
+static const struct cdevsw camdev_cdevsw = {
+	.d_open = camdev_open,
+	.d_close = camdev_close,
+	.d_read = camdev_read,
+	.d_write = camdev_write,
+	.d_ioctl = eno_ioctl,
+	.d_stop = eno_stop,
+	.d_reset = eno_reset,
+	.d_ttys = NULL,
+	.d_select = eno_select,
+	.d_mmap = eno_mmap,
+	.d_strategy = eno_strat,
+	.d_type = 0,
+};
+
+static void
+camdev_publish(void)
+{
+	if (camdev_major >= 0) {
+		return;
+	}
+	camdev_major = cdevsw_add(-1, &camdev_cdevsw);
+	if (camdev_major < 0) {
+		say("cdevsw_add failed: no /dev/negronicam-*");
+		return;
+	}
+	(void)devfs_make_node(makedev(camdev_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0440, "negronicam-tpg");
+	(void)devfs_make_node(makedev(camdev_major, 1), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0440, "negronicam-sensor");
+	say("frames readable as /dev/negronicam-tpg and /dev/negronicam-sensor (scripts/camera/pull-frame.sh)");
+}
+
+/* level 5: TPG frame (no sensor), then the sensor frame */
+static bool
+l5_frames(void)
+{
+	bool any = false, ok = true;
+	if (!l5_map()) {
+		return false;
+	}
+	if (src_mask & 1u) {
+		step_begin("tpg13 -> csid0 -> ife0 rdi0 -> memory");
+		if (!frame_alloc(&frames[0], TPG_W, TPG_H, 1)) {
+			return step_fail("buffer");
+		}
+		bool got = capture(&frames[0], true, 1000) && frame_check(&frames[0], "TPG");
+		any |= got;
+		ok &= got;
+		if (got) {
+			(void)step_ok();
+		} else {
+			(void)step_fail("no TPG frame");
+		}
+	}
+	if (src_mask & 2u) {
+		step_begin("imx789 -> csiphy1 -> csid0 -> ife0 rdi0 -> memory");
+		if (!frame_alloc(&frames[1], FTM_WIDTH, FTM_HEIGHT, 2)) {
+			return step_fail("buffer");
+		}
+		bool got = capture(&frames[1], false, 2000);
+		csiphy_status("after the sensor frame");
+		got = got && frame_check(&frames[1], "SENSOR");
+		any |= got;
+		ok &= got;
+		if (got) {
+			(void)step_ok();
+		} else {
+			(void)step_fail("no sensor frame");
+		}
+	}
+	if (any) {
+		camdev_publish();
+	}
+	return ok;
+}
+
+/* ---- level 6: ICP firmware through PAS 33 + HFI (0316) ---- */
+
+static struct area_header *icp_area;
+static uint8_t *icp_mdt;
+static uint32_t icp_mdt_size, icp_nseg, icp_min_pa, icp_max_pa;
+static struct icp_seg icp_segs[ICP_MAX_SEGS];
+static bool icp_reloc;
+
+static const struct area_entry *
+icp_area_file(const char *name)
+{
+	for (uint32_t i = 0; icp_area && i < icp_area->count; i++) {
+		if (strncmp(icp_area->entry[i].name, name, sizeof(icp_area->entry[i].name)) == 0) {
+			return &icp_area->entry[i];
+		}
+	}
+	return NULL;
+}
+
+static bool
+icp_area_check(const struct area_entry *e, uint8_t *buf)
+{
+	SHA256_CTX ctx;
+	uint8_t digest[32];
+	SHA256_Init(&ctx);
+	for (uint32_t at = 0; at < e->size; at += AREA_CHUNK) {
+		uint32_t n = MIN(AREA_CHUNK, e->size - at);
+		if (negroni_ufs_adsp_area_read(e->offset + at, buf, n) != 0) {
+			return false;
+		}
+		SHA256_Update(&ctx, buf, n);
+	}
+	SHA256_Final(digest, &ctx);
+	return memcmp(digest, e->sha256, 32) == 0;
+}
+
+/* the area header, CAMERA_ICP.mdt and its program headers (negroni_adsp.c step_firmware, mdt_loader.c) */
+static bool
+l6_firmware(vm_offset_t buf)
+{
+	step_begin("icp firmware (adsp area)");
+	vm_offset_t a = 0, m = 0;
+	if (kmem_alloc(kernel_map, &a, AREA_HEADER, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return step_fail("no memory");
+	}
+	icp_area = (struct area_header *)a;
+	if (negroni_ufs_adsp_area_read(0, icp_area, AREA_HEADER) != 0 || memcmp(icp_area->magic, AREA_MAGIC, 8) != 0 ||
+	    icp_area->version != 1 || icp_area->count == 0 || icp_area->count > AREA_MAX) {
+		return step_fail("no ADSP firmware area (scripts/fw/build-areas.sh + the userdata flash)");
+	}
+	for (uint32_t i = 0; i < icp_area->count; i++) {
+		struct area_entry *x = &icp_area->entry[i];
+		x->name[47] = 0;
+		if (x->offset < AREA_HEADER || x->offset > AREA_SIZE || x->size > AREA_SIZE - x->offset) {
+			return step_fail("area entry out of range");
+		}
+	}
+	const struct area_entry *e = icp_area_file("CAMERA_ICP.mdt");
+	if (e == NULL || e->size < 52 || e->size > PAGE_SIZE || !icp_area_check(e, (uint8_t *)buf)) {
+		return step_fail("CAMERA_ICP.mdt missing (scripts/camera/extract-icp-fw.sh), too big, or SHA-256 mismatch");
+	}
+	if (kmem_alloc(kernel_map, &m, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    negroni_ufs_adsp_area_read(e->offset, (void *)m, e->size) != 0) {
+		return step_fail("mdt read");
+	}
+	icp_mdt = (uint8_t *)m;
+	icp_mdt_size = e->size;
+	uint32_t phoff, phnum, bytes = 0;
+	memcpy(&phoff, icp_mdt + 28, 4);
+	phnum = (uint32_t)(icp_mdt[44] | icp_mdt[45] << 8);
+	if (memcmp(icp_mdt, "\177ELF\1\1", 6) != 0 || phnum == 0 || phnum > ICP_MAX_SEGS || phoff + 32 * phnum > icp_mdt_size) {
+		return step_fail("CAMERA_ICP.mdt is not an ELF32 LE header");
+	}
+	icp_nseg = phnum;
+	icp_min_pa = ~0u;
+	icp_max_pa = 0;
+	for (uint32_t i = 0; i < icp_nseg; i++) {
+		uint32_t ph[8];
+		memcpy(ph, icp_mdt + phoff + 32 * i, sizeof(ph));
+		icp_segs[i] = (struct icp_seg){ ph[0], ph[1], ph[3], ph[4], ph[5], ph[6] };
+		struct icp_seg *s = &icp_segs[i];
+		if (s->type != 1 || s->memsz == 0 || MDT_TYPE(s->flags) == MDT_TYPE_HASH) {
+			continue;
+		}
+		icp_reloc |= (s->flags & MDT_RELOCATABLE) != 0;
+		icp_min_pa = MIN(icp_min_pa, s->paddr);
+		icp_max_pa = MAX(icp_max_pa, s->paddr + s->memsz);
+		if (s->filesz == 0) {
+			continue;
+		}
+		char name[24];
+		snprintf(name, sizeof(name), "CAMERA_ICP.b%02u", i);
+		const struct area_entry *f = icp_area_file(name);
+		if (f == NULL || f->size != s->filesz || s->filesz > s->memsz || !icp_area_check(f, (uint8_t *)buf)) {
+			say("  %s missing, not %u bytes, or SHA-256 mismatch", name, s->filesz);
+			return step_fail("segment file");
+		}
+		bytes += f->size;
+	}
+	icp_max_pa = (icp_max_pa + 0xfffu) & ~0xfffu;
+	say("  CAMERA_ICP.mdt: %u program headers, load %#x..%#x (%u KiB), %u KiB of segments, %s", icp_nseg, icp_min_pa,
+	    icp_max_pa, (icp_max_pa - icp_min_pa) >> 10, bytes >> 10, icp_reloc ? "relocatable" : "fixed");
+	if (icp_min_pa == ~0u || icp_max_pa - icp_min_pa > CAMERA_REGION_SIZE || (!icp_reloc &&
+	    (icp_min_pa < CAMERA_REGION_PA || icp_max_pa > CAMERA_REGION_PA + CAMERA_REGION_SIZE))) {
+		return step_fail("the image does not fit camera_region");
+	}
+	return step_ok();
+}
+
+/* PAS init image + mem setup, segments into camera_region, auth and reset (lx7_core.c:528-663) */
+static bool
+l6_pas(vm_offset_t buf)
+{
+	step_begin("icp pas 33");
+	uint64_t answer = ~0ull;
+	uint32_t ehdr = icp_segs[0].filesz, hash = ~0u;
+	for (uint32_t i = 0; i < icp_nseg; i++) {
+		if (MDT_TYPE(icp_segs[i].flags) == MDT_TYPE_HASH) {
+			hash = i;
+			break;
+		}
+	}
+	if (icp_segs[0].type == 1 || hash == ~0u || ehdr == 0 || (uint64_t)ehdr + icp_segs[hash].filesz > PAGE_SIZE ||
+	    ehdr + icp_segs[hash].filesz != icp_mdt_size) {
+		return step_fail("no ELF-header + hash layout in CAMERA_ICP.mdt");
+	}
+	vm_offset_t meta = 0;
+	if (kmem_alloc(kernel_map, &meta, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return step_fail("no memory");
+	}
+	memcpy((void *)meta, icp_mdt, icp_mdt_size);           /* headers + hash, packed (qcom_mdt_read_metadata) */
+	clean_dcache(meta, PAGE_SIZE, FALSE);
+	if (icp_scm("PAS init image (camera)", SCM_64 | SCM_SIP | SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_CAMERA,
+	    kvtophys(meta), 0, &answer) != 0 || answer != 0) {
+		return step_fail("TrustZone refuses the CAMERA_ICP metadata");
+	}
+	say("  TrustZone accepts the CAMERA_ICP signature (PAS 33)");
+	pas_started = true;                     /* from here the power down sends PAS shutdown */
+	if (icp_reloc) {
+		answer = ~0ull;
+		if (icp_scm("PAS mem setup (camera)", SCM_64 | SCM_SIP | SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_CAMERA,
+		    CAMERA_REGION_PA, icp_max_pa - icp_min_pa, &answer) != 0 || answer != 0) {
+			return step_fail("TrustZone refuses camera_region");
+		}
+	}
+	volatile uint8_t *mem = (volatile uint8_t *)ml_io_map_unmappable(CAMERA_REGION_PA, CAMERA_REGION_SIZE, 0x6u);
+	if (mem == NULL) {
+		return step_fail("map camera_region");
+	}
+	for (uint32_t i = 0; i < CAMERA_REGION_SIZE; i++) {
+		mem[i] = 0;
+	}
+	bool ok = true;
+	for (uint32_t i = 0; i < icp_nseg && ok; i++) {
+		struct icp_seg *s = &icp_segs[i];
+		if (s->type != 1 || s->memsz == 0 || MDT_TYPE(s->flags) == MDT_TYPE_HASH || s->filesz == 0) {
+			continue;
+		}
+		char name[24];
+		snprintf(name, sizeof(name), "CAMERA_ICP.b%02u", i);
+		const struct area_entry *f = icp_area_file(name);
+		uint32_t base = (icp_reloc ? 0 : (uint32_t)(icp_min_pa - CAMERA_REGION_PA)) + (s->paddr - icp_min_pa);
+		for (uint32_t at = 0; f && at < f->size && ok; at += AREA_CHUNK) {
+			uint32_t n = MIN(AREA_CHUNK, f->size - at);
+			if (negroni_ufs_adsp_area_read(f->offset + at, (void *)buf, n) != 0) {
+				ok = false;
+				break;
+			}
+			for (uint32_t t = 0; t < n; t++) {
+				mem[base + at + t] = ((const uint8_t *)buf)[t];
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ml_io_unmap((vm_offset_t)mem, CAMERA_REGION_SIZE);
+	if (!ok) {
+		return step_fail("segment read");
+	}
+	say("  segments written into camera_region %#lx", CAMERA_REGION_PA);
+	answer = ~0ull;
+	if (icp_scm("PAS auth and reset (camera)", SCM_64 | SCM_SIP | SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_CAMERA, 0, 0,
+	    &answer) != 0 || answer != 0) {
+		return step_fail("PAS auth and reset (33) failed");
+	}
+	say("ICP: qcom_scm_pas_auth_and_reset(33) returned 0: TrustZone started the ICP");
+	return step_ok();
+}
+
+/* queue header word w of queue q, in the uncached view of the HFI block */
+#define QW(q, w)        (*(volatile uint32_t *)(hfi_uc + HFI_OFF_QTBL + 24u + 4u * (HFI_Q_WORDS * (q) + (w))))
+
+/*
+ * cam_hfi_init (hfi.c) with event mode 0 (INTR_MODE, cam_icp_mgr_hfi_init), then HFI_CMD_SYS_INIT
+ * (CAM_ICP_SEND_INIT, lx7_core.c:858-861) and a poll of the message queue for SYS_INIT_DONE.
+ * Addresses are physical: the ICP stream group must be in bypass (level 3) [I: the firmware may expect
+ * IOVAs inside the DT windows (live.dts:22646-22669); then the init response or the queue read fails].
+ */
+static bool
+l6_hfi(void)
+{
+	step_begin("icp hfi init");
+	/* 0317: anywhere in RAM (0316 asked for < 4 GiB: impossible here); the ICP sees IOVAs (smmu=3) */
+	if (kmem_alloc_contig(kernel_map, &hfi_kva, HFI_BLOCK, 0, 0, 0, KMA_KOBJECT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		hfi_kva = 0;
+		return step_fail("no HFI memory (8 MiB contiguous)");
+	}
+	hfi_pa = kvtophys(hfi_kva);
+	if (dma_s1) {
+		if (negroni_s1_map_kva(&cam_s1, CAM_IOVA_FWUNC, hfi_kva + HFI_OFF_SECHEAP, HFI_FWUNC_LEN) != 0 ||
+		    negroni_s1_map_kva(&cam_s1, CAM_IOVA_SHARED, hfi_kva + HFI_OFF_SHMEM, HFI_SHMEM_LEN) != 0) {
+			return step_fail("HFI map through the SMMU");
+		}
+		hfi_fwunc_dva = CAM_IOVA_FWUNC;
+		hfi_shmem_dva = CAM_IOVA_SHARED;
+	} else if (hfi_pa + HFI_BLOCK > 0x100000000ull) {
+		say("  HFI block at phys %#llx has no 32-bit address and the ICP stream is not translated: use "
+		    "negronicam_smmu=3", hfi_pa);
+		return step_fail("no 32-bit HFI address");
+	} else {
+		hfi_fwunc_dva = hfi_pa;
+		hfi_shmem_dva = hfi_pa + HFI_OFF_SHMEM;
+	}
+	bzero((void *)hfi_kva, HFI_BLOCK);
+	flush_dcache64((addr64_t)hfi_pa, HFI_BLOCK, TRUE);
+	/* from here only the non-cacheable view is used (no cached lines of the block are touched again) */
+	hfi_uc = ml_io_map_unmappable((vm_offset_t)hfi_pa, HFI_BLOCK, 0x6u);
+	icp_csr = icp_csr ? icp_csr : ml_io_map_unmappable(ICP_CSR_PA, 0x1000, CAM_WIMG_IO);
+	if (!hfi_uc || !icp_csr) {
+		return step_fail("map");
+	}
+	volatile uint32_t *qt = (volatile uint32_t *)(hfi_uc + HFI_OFF_QTBL);
+	qt[0] = 0xffffffffu;                            /* qtbl_version */
+	qt[1] = 24u + 4u * 4u * HFI_Q_WORDS;            /* sizeof(struct hfi_qtbl) */
+	qt[2] = 24u;                                    /* qhdr0 offset */
+	qt[3] = 4u * HFI_Q_WORDS;                       /* sizeof(struct hfi_q_hdr) */
+	qt[4] = 3;
+	qt[5] = 3;
+	static const uint32_t qoff[3] = { HFI_OFF_CMDQ, HFI_OFF_MSGQ, HFI_OFF_DBGQ };
+	static const uint32_t qsize[3] = { 4096u >> 2, 4096u >> 2, 102400u >> 2 };
+	for (uint32_t q = 0; q < 3; q++) {
+		QW(q, QH_STATUS) = 1;                   /* QHDR_ACTIVE */
+		QW(q, QH_START) = HFI_DVA(qoff[q]);
+		QW(q, QH_QSIZE) = qsize[q];
+		QW(q, QH_PKTSIZE) = 0;
+		QW(q, QH_DROP) = 0;
+		QW(q, QH_READ_IDX) = 0;
+		QW(q, QH_WRITE_IDX) = 0;
+		QW(q, QH_TYPE) = q;                     /* INTR_MODE: Q_CMD / Q_MSG / Q_DBG */
+		QW(q, QH_RX_WM) = 1;
+		QW(q, QH_TX_WM) = q == 2 ? 1024u : 1u;  /* dbg: SET_WM */
+		QW(q, QH_RX_REQ) = q == 2 ? 0u : 1u;
+		QW(q, QH_TX_REQ) = 0;
+		QW(q, QH_RX_IRQ) = 0;
+		QW(q, QH_TX_IRQ) = 0;
+	}
+	*(volatile uint32_t *)(hfi_uc + HFI_OFF_SFR) = 4096;    /* sfr_buf.size */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	vm_offset_t gp = icp_csr;
+	wr(gp + ICP_GP(HFI_QTBL_PTR), HFI_DVA(HFI_OFF_QTBL));
+	wr(gp + ICP_GP(HFI_SFR_PTR), HFI_DVA(HFI_OFF_SFR));
+	wr(gp + ICP_GP(HFI_SHMEM_PTR), HFI_DVA(HFI_OFF_SHMEM));
+	wr(gp + ICP_GP(HFI_SHMEM_SIZE), HFI_SHMEM_LEN);
+	wr(gp + ICP_GP(HFI_SECHEAP_PTR), HFI_DVA(HFI_OFF_SECHEAP));
+	wr(gp + ICP_GP(HFI_SECHEAP_SIZE), HFI_SECHEAP_LEN);
+	wr(gp + ICP_GP(HFI_QDSS_IOVA), 0);
+	wr(gp + ICP_GP(HFI_QDSS_SIZE), 0);
+	if (dma_s1) {
+		/* Android's io regions around the discard window (cam_icp_mgr_hfi_resume io_mem / io_mem2) */
+		wr(gp + ICP_GP(HFI_IO_IOVA), 0x10c00000u);
+		wr(gp + ICP_GP(HFI_IO_SIZE), 0xe0000000u - 0x10c00000u);
+		wr(gp + ICP_GP(HFI_IO2_IOVA), 0xe0800000u);
+		wr(gp + ICP_GP(HFI_IO2_SIZE), 0x10c00000u + 0xee300000u - 0xe0800000u);
+	} else {
+		wr(gp + ICP_GP(HFI_IO_IOVA), 0x80000000u);      /* [I] DRAM below 4 GiB as the IO window (bypass) */
+		wr(gp + ICP_GP(HFI_IO_SIZE), 0x7ff00000u);
+		wr(gp + ICP_GP(HFI_IO2_IOVA), 0);
+		wr(gp + ICP_GP(HFI_IO2_SIZE), 0);
+	}
+	wr(gp + ICP_GP(HFI_FWUNC_IOVA), HFI_DVA(HFI_OFF_SECHEAP));
+	wr(gp + ICP_GP(HFI_FWUNC_SIZE), HFI_FWUNC_LEN);
+	wr(gp + ICP_GP(HFI_INIT_REQ), 1);               /* ICP_INIT_REQUEST_SET */
+	uint32_t got = 0;
+	/* HFI_POLL_TIMEOUT_US 1.5 s (hfi.c:37-38) */
+	bool ok = poll(gp + ICP_GP(HFI_INIT_RESP), 0xffffffffu, 1, 1500000, &got);
+	if (dma_s1) {
+		negroni_s1_report(&cam_s1, ok ? "after the HFI init" : "after NO HFI init response");
+	}
+	say("  HFI block phys %#llx, ICP address qtbl %#x; INIT_RESPONSE %#x (1 = success, 2 = failed), FW_VERSION %#x, "
+	    "CIRQ ob status %#x, pfault %#x", hfi_pa, HFI_DVA(HFI_OFF_QTBL), got, rd(gp + ICP_GP(HFI_FW_VERSION)), rd(icp_csr + ICP_CIRQ_OFF + CIRQ_OB_STATUS),
+	    rd(icp_csr + ICP_CIRQ_OFF + CIRQ_PFAULT));
+	if (!ok) {
+		const char *sfr = (const char *)(hfi_uc + HFI_OFF_SFR + 4);
+		char text[96];
+		for (uint32_t i = 0; i < sizeof(text) - 1; i++) {
+			char c = sfr[i];
+			text[i] = (c >= 32 && c < 127) ? c : (c == 0 ? 0 : '.');
+			if (c == 0) {
+				break;
+			}
+		}
+		text[sizeof(text) - 1] = 0;
+		say("  ICP SFR (crash reason): \"%s\"", text);
+		return step_fail("no HFI init response");
+	}
+	say("ICP READY: HFI init response SUCCESS, firmware version %#x", rd(gp + ICP_GP(HFI_FW_VERSION)));
+	/* irq enable (cam_lx7_irq_enable): WDT bite 0 + ICP2HOST; the GIC line stays off, the queue is polled */
+	wr(icp_csr + ICP_CIRQ_OFF + CIRQ_OB_MASK, (1u << 4) | (1u << 2));
+	/* HFI_CMD_SYS_INIT: {size 8, pkt_type} into the command queue (hfi_write_cmd), then HOST2ICPINT */
+	volatile uint32_t *cmdq = (volatile uint32_t *)(hfi_uc + HFI_OFF_CMDQ);
+	uint32_t w = QW(0, QH_WRITE_IDX);
+	cmdq[w] = 8;
+	cmdq[w + 1] = HFI_CMD_SYS_INIT;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	QW(0, QH_WRITE_IDX) = w + 2;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(icp_csr + ICP_CIRQ_OFF + CIRQ_HOST2ICP, 1);
+	/* wait for a message: cam_icp_mgr_send_fw_init waits 5 s */
+	uint32_t msg_w = 0;
+	for (uint32_t ms = 0; ms < 5000; ms++) {
+		msg_w = QW(1, QH_WRITE_IDX);
+		if (msg_w != QW(1, QH_READ_IDX)) {
+			break;
+		}
+		delay(1000);
+	}
+	volatile uint32_t *msgq = (volatile uint32_t *)(hfi_uc + HFI_OFF_MSGQ);
+	uint32_t r = QW(1, QH_READ_IDX);
+	if (msg_w == r) {
+		say("  no message from the ICP in 5 s (cmd queue read idx %u, write idx %u)", QW(0, QH_READ_IDX), QW(0, QH_WRITE_IDX));
+		return step_fail("no SYS_INIT_DONE");
+	}
+	uint32_t size = msgq[r % 1024u], type = msgq[(r + 1) % 1024u], err = msgq[(r + 2) % 1024u];
+	say("ICP message: size %u, type %#x (%s), err %#x, num_prop %u", size, type,
+	    type == HFI_MSG_SYS_INIT_DONE ? "HFI_MSG_SYS_INIT_DONE" : "other", err, msgq[(r + 3) % 1024u]);
+	QW(1, QH_READ_IDX) = msg_w;
+	if (type != HFI_MSG_SYS_INIT_DONE || err != 0) {
+		return step_fail("unexpected first message");
+	}
+	return step_ok();
+}
+
+static bool
+l6_icp(void)
+{
+	vm_offset_t buf = 0;
+	bool ok = false;
+	step_begin("icp clocks");
+	if (!rcg_to_xo("cam_cc_icp_clk_src", 0x13108)) {
+		return step_fail("RCG update");
+	}
+	icp_branches_on |= 1u;
+	if (!branch_set("cam_cc_icp_ahb_clk", camcc + 0x13128, true, true)) {
+		return step_fail("icp ahb clock");
+	}
+	icp_branches_on |= 2u;
+	if (!branch_set("cam_cc_icp_clk", camcc + 0x13120, true, true)) {
+		return step_fail("icp clock");
+	}
+	(void)step_ok();
+	if (!dma_ok[1] && smmu_policy != 0) {
+		step_begin("icp dma path");
+		return step_fail("ICP stream group has no bypass (level 3)");
+	}
+	if (kmem_alloc(kernel_map, &buf, AREA_CHUNK, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	ok = l6_firmware(buf) && l6_pas(buf) && l6_hfi();
+	kmem_free(kernel_map, buf, AREA_CHUNK);
+	return ok;
+}
+
+/* ---- level 7: the frames for iOS, /dev/negronicam (0318) ---- */
+
+/*
+ * negronicam=7: nothing runs at boot; /dev/negronicam is published. The first read() after an open starts a
+ * session in its own thread: the level 1-5 bring-up (votes, camcc, CCI, IMX789 power + chip id, CPAS, the
+ * SMMU stage-1 context of 0317, capture clocks, CSIPHY1, CSID0/IFE0 map), a ring of NRING frame places (kernel
+ * memory, page by page at IOVAs from 0x10c00000), the 0315 pipe with frame increment 0, sensor stream on
+ * (negronicam_src=1: the TPG13 colour bars instead, no sensor power). The session ends after the last close, after
+ * IDLE_MS without a read, or on a fault (then /dev/negronicam answers EIO for the rest of the boot); the end
+ * is the stream off + cam_down() + the ring freed.
+ *
+ * The ABI is HakiOS's /dev/hakios-camera (out/src/hackios-next/userland/src/hakios.camera.h, MIT; the same
+ * struct layout under our own names, magic "NCFRAME1"), so their camera_device.c needs few edits:
+ *   read()   waits (at most 1 s, 4 s for the session's first frame) for the newest frame not read yet: the
+ *            header, then as many frame bytes as fit. A buffer of the header's size gets the header only.
+ *            EAGAIN on a time-out, EIO after a fault.
+ *   write()  struct negronicam_command: EXPOSURE (a lines, b gain x256 linear, c frame lines or 0) and SENSOR
+ *            (only sensor 1, the rear main, exists here). KEEP and FOCUS are accepted and ignored.
+ *
+ * Which place the IFE writes (as HakiOS's SOF scheme, our registers): at each RDI0 SOF (CSID path irq bit 4
+ * CAMIF_SOF or bit 12 INFO_INPUT_SOF, cam_ife_csid680.h:123-176) the address of the place for the frame after
+ * goes to WM_IMAGE_ADDR and RUP+AUP (CSID 0x18, camss-csid-gen3.c:33-34; the latch is at the next SOF). BUF_DONE
+ * (CSID 0x8c bit 14) marks the written place ready. Without any SOF bit in the first 3 frames the loop programs
+ * the next address at BUF_DONE instead (Linux camss vfe_buf_done order) [I: which one the 680 latches by].
+ * Exposure [I]: SMIA registers of the FTM table (0x0202/3 coarse integration, 0x0204/5 analog gain, 0x0340/1
+ * frame length) in a group hold (0x0104); Sony code = 1024 - 1024 / gain [I for IMX789], at most 16x.
+ */
+#define NRING           3u
+#define RING_SPARE      (256u << 10)            /* room after each frame: some come longer than the mode */
+#define IDLE_MS         1000u
+#define FIRST_FRAME_MS  4000u
+#define FRAME_TIMEOUT_MS 1500u
+#define RDI_SOF_BITS    ((1u << 4) | (1u << 12))
+#define NCAM_MAGIC      "NCFRAME1"
+#define NCAM_NO_FOCUS   0xffffffffu
+#define NCAM_GID_MOBILE 501             /* iOS group "mobile" (mediaserverd's) */
+#define CMD_EXPOSURE    1u
+#define CMD_KEEP        2u
+#define CMD_SENSOR      3u
+#define CMD_FOCUS       4u
+#define GAIN_UNITY      256u
+#define GAIN_MAX        (16u * GAIN_UNITY)
+#define EXPOSURE_MARGIN 48u                     /* coarse integration <= frame length - margin [I] */
+#define FTM_FRAME_LINES 3134u                   /* 0x0340/1 = 0x0c3e of the FTM table */
+#define FTM_LINE_NS     10636u                  /* 1e9 / (30 fps x 3134 lines) [I: from the 30 fps of the mode] */
+#define IMX789_BLACK    64u                     /* 10-bit pedestal [I: usual Sony value] */
+
+struct ncam_frame_hdr {                 /* = struct hakios_camera_frame */
+	char magic[8];
+	uint32_t header_bytes, width, height, stride, format, bayer, black;
+	uint64_t sequence, time;
+	uint32_t exposure_lines, line_ns, gain, gain_unity, gain_max, frame_lines, frame_lines_min, frame_lines_max, margin;
+	uint32_t sensor, focus, reserved[5];
+};
+_Static_assert(sizeof(struct ncam_frame_hdr) == 120, "the HakiOS frame header is 120 bytes");
+struct ncam_command { uint32_t command, bytes, a, b, c, d; };
+
+enum { PLACE_FREE, PLACE_WRITING, PLACE_READY, PLACE_READING };
+static struct {
+	vm_offset_t kva;
+	uint64_t dva;
+	uint8_t state;
+	uint64_t sequence, time;
+	uint32_t lines, gain, frame_lines;
+} place[NRING];
+static vm_size_t place_bytes;
+static uint32_t ios_w, ios_h, ios_stride, ios_bytes, ios_bayer;
+static lck_grp_t *ios_grp;
+static lck_mtx_t *ios_lock;
+static volatile bool ios_running, ios_broken;
+static volatile uint64_t ios_last_read_ms, ios_frames, ios_given;
+static struct { uint32_t lines, gain, frame_lines; bool pending; } ios_ask;
+static struct { uint32_t lines, gain, frame_lines; } ios_now;
+extern void IOSleep(unsigned int ms);
+
+static uint64_t
+ms_now(void)
+{
+	return now_us() / 1000u;
+}
+
+/* gain x256 linear -> Sony analog gain code (1024 - 1024 / gain) [I] */
+static uint32_t
+gain_code(uint32_t gain)
+{
+	gain = MAX(MIN(gain, GAIN_MAX), GAIN_UNITY);
+	return 1024u - (1024u * GAIN_UNITY + gain / 2u) / gain;
+}
+
+static bool
+exposure_write(uint32_t lines, uint32_t gain, uint32_t frame_lines)
+{
+	uint32_t code = gain_code(gain);
+	int e = cci_write8(CCI_MASTER, SENSOR_SID, 0x0104, 1);          /* group hold */
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0340, frame_lines >> 8);
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0341, frame_lines & 0xffu);
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0202, lines >> 8);
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0203, lines & 0xffu);
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0204, code >> 8);
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0205, code & 0xffu);
+	int e2 = cci_write8(CCI_MASTER, SENSOR_SID, 0x0104, 0);         /* release, also after a failed write */
+	if (e || e2) {
+		say("  exposure write failed: errno %d/%d", e, e2);
+		return false;
+	}
+	return true;
+}
+
+static void
+exposure_limits(uint32_t *lines, uint32_t *gain, uint32_t *frame_lines)
+{
+	uint32_t fl = *frame_lines ? *frame_lines : MAX(FTM_FRAME_LINES, *lines + EXPOSURE_MARGIN);
+	*frame_lines = MIN(MAX(fl, FTM_FRAME_LINES), 0xfff0u);
+	*lines = MIN(MAX(*lines, 8u), *frame_lines - EXPOSURE_MARGIN);
+	*gain = MIN(MAX(*gain, GAIN_UNITY), GAIN_MAX);
+}
+
+static void
+ring_free(void)
+{
+	for (unsigned i = 0; i < NRING; i++) {
+		if (place[i].kva) {
+			kmem_free(kernel_map, place[i].kva, place_bytes);
+		}
+		bzero(&place[i], sizeof(place[i]));
+	}
+}
+
+/* the ring: NRING places of kernel memory, each mapped at its own IOVA (needs the 0317 context) */
+static bool
+ring_alloc(void)
+{
+	step_begin("ios frame ring");
+	if (!dma_s1) {
+		return step_fail("the stream needs the SMMU stage-1 context (negronicam_smmu=3)");
+	}
+	place_bytes = round_page((vm_size_t)ios_bytes + RING_SPARE);
+	for (unsigned i = 0; i < NRING; i++) {
+		if (kmem_alloc(kernel_map, &place[i].kva, place_bytes, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			place[i].kva = 0;
+			return step_fail("no memory for the frame ring");
+		}
+		uint64_t iova = cam_iova_next;
+		if (iova + place_bytes > CAM_IOVA_IO_END || negroni_s1_map_kva(&cam_s1, iova, place[i].kva, place_bytes) != 0) {
+			return step_fail("ring map through the SMMU");
+		}
+		cam_iova_next = (iova + place_bytes + 0x100000ull + 0xfffffull) & ~0xfffffull;     /* >= 1 MiB unmapped gap */
+		place[i].dva = iova;
+		flush_dcache((vm_offset_t)place[i].kva, (unsigned)place_bytes, FALSE);  /* no dirty line over the DMA */
+	}
+	say("  %u places of %lu bytes (frame %ux%u RAW10, stride %u) at IOVA %#llx..", NRING, (unsigned long)place_bytes,
+	    ios_w, ios_h, ios_stride, place[0].dva);
+	return step_ok();
+}
+
+static bool
+ios_bringup(void)
+{
+	step = 0;
+	bool sensor = (src_mask & 2u) != 0;
+	bool ok = (votes_policy == 0 || l0_votes()) && l1_map() && l1_gcc() && l1_gdsc() && l1_clocks() && l1_cci();
+	if (ok && sensor) {
+		ok = l2_pins() && l2_rails() && l2_reset() && l2_mclk() && l2_cci_pins() && l2_chip_id();
+	}
+	ok = ok && l3_cpas() && l3_smmu() && l4_clocks() && (!sensor || l4_csiphy()) && l5_map();
+	if (!ok) {
+		return false;
+	}
+	ios_w = sensor ? FTM_WIDTH : TPG_W;
+	ios_h = sensor ? FTM_HEIGHT : TPG_H;
+	ios_stride = ios_w * 10u / 8u;
+	ios_bytes = ios_stride * ios_h;
+	if (!ring_alloc()) {
+		return false;
+	}
+	step_begin(sensor ? "ios stream: imx789 -> csid0 -> ife0 rdi0 -> ring" : "ios stream: tpg13 -> csid0 -> ife0 rdi0 -> ring");
+	if (!pipe_start(place[0].dva, ios_stride, 0, !sensor)) {
+		return step_fail("pipe start");
+	}
+	ios_now.lines = FTM_FRAME_LINES - EXPOSURE_MARGIN;
+	ios_now.gain = GAIN_UNITY;
+	ios_now.frame_lines = FTM_FRAME_LINES;
+	if (sensor) {
+		uint32_t hi = 0, lo = 0;
+		if (cci_read8(CCI_MASTER, SENSOR_SID, 0x0202, &hi) == 0 && cci_read8(CCI_MASTER, SENSOR_SID, 0x0203, &lo) == 0) {
+			ios_now.lines = hi << 8 | lo;
+		}
+	}
+	return step_ok();
+}
+
+/* the session: bring-up, the frame loop, the end; one at a time (ios_running) */
+static void
+ios_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	bool sensor = (src_mask & 2u) != 0, sof_mode = true, fault = false;
+	int writing = 0, next = 0;      /* place 0 is the WM's address from pipe_start: taken at the first SOF */
+	uint64_t last_frame, started = ms_now(), late = 0, sofs = 0;
+	const char *why = "closed";
+
+	say("ios session: start (%s)", sensor ? "IMX789" : "TPG13 colour bars");
+	if (!ios_bringup()) {
+		fault = true;
+		why = "the bring-up failed";
+		goto out;
+	}
+	lck_mtx_lock(ios_lock);
+	ios_frames = 0;
+	ios_given = 0;
+	ios_last_read_ms = ms_now();
+	lck_mtx_unlock(ios_lock);
+	last_frame = ms_now();
+	while (ios_open) {
+		IOSleep(1);
+		uint64_t now = ms_now();
+		uint32_t rdi = rd(csid + CSID_RDI0_IRQ_STATUS), bd = rd(csid + CSID_BUF_DONE_STATUS);
+		bool sof = (rdi & RDI_SOF_BITS) != 0, done = (bd & CSID_BUF_DONE_RDI0) != 0;
+		if (!sof && !done) {
+			if (now - last_frame > (ios_frames ? FRAME_TIMEOUT_MS : FIRST_FRAME_MS)) {
+				say("  ios session: no frame for %llu ms; RDI0 irq %#x, RX irq %#x, IFE bus violation %#x overflow %#x",
+				    now - last_frame, rdi, rd(csid + CSID_RX_IRQ_STATUS), rd(ife + VFE_BUS_VIOLATION),
+				    rd(ife + VFE_BUS_OVERFLOW));
+				fault = true;
+				why = "no frame";
+				break;
+			}
+			if (now - ios_last_read_ms > IDLE_MS) {
+				why = "nobody reads";
+				break;
+			}
+			continue;
+		}
+		if (rdi) {
+			wr(csid + CSID_RDI0_IRQ_CLEAR, rdi);
+		}
+		if (bd) {
+			wr(csid + CSID_BUF_DONE_CLEAR, bd);
+		}
+		wr(csid + CSID_IRQ_CMD, 1);
+		sofs += sof;
+		lck_mtx_lock(ios_lock);
+		if (done) {
+			last_frame = now;
+			ios_frames++;
+			place[writing].state = PLACE_READY;
+			place[writing].sequence = ios_frames;
+			place[writing].time = mach_absolute_time();
+			place[writing].lines = ios_now.lines;
+			place[writing].gain = ios_now.gain;
+			place[writing].frame_lines = ios_now.frame_lines;
+			if (ios_frames == 3 && sofs == 0) {
+				sof_mode = false;
+				say("  ios session: no SOF bit in 3 frames (RDI0 irq %#x): next address at BUF_DONE", rdi);
+			}
+		}
+		/* SOF mode: at SOF; BUF_DONE mode: at BUF_DONE. The address for the frame after the one starting now. */
+		if (sof_mode ? sof : done) {
+			if (next >= 0) {
+				writing = next;
+				next = -1;
+			} else {
+				late++;         /* no address waiting: this frame goes where the last one went */
+			}
+			place[writing].state = PLACE_WRITING;
+			for (unsigned i = 1; i < NRING; i++) {
+				int c = (int)((writing + i) % NRING);
+				if (place[c].state != PLACE_READING && (next < 0 || place[c].sequence < place[next].sequence)) {
+					next = c;
+				}
+			}
+			if (next >= 0) {
+				wr(ife + WM_RDI0 + WM_IMAGE_ADDR, (uint32_t)place[next].dva);
+				wr(csid + CSID_RUP_AUP, 1u << 4 | 1u << 20);
+			}
+		}
+		bool ask = done && ios_ask.pending;
+		uint32_t lines = ios_ask.lines, gain = ios_ask.gain, frame_lines = ios_ask.frame_lines;
+		ios_ask.pending = ios_ask.pending && !ask;
+		lck_mtx_unlock(ios_lock);
+		if (ask && sensor) {
+			exposure_limits(&lines, &gain, &frame_lines);
+			if ((lines != ios_now.lines || gain != ios_now.gain || frame_lines != ios_now.frame_lines) &&
+			    exposure_write(lines, gain, frame_lines)) {
+				ios_now.lines = lines;          /* [I] takes effect 2 frames later; the header says it now */
+				ios_now.gain = gain;
+				ios_now.frame_lines = frame_lines;
+			}
+		}
+		if (done && ios_frames % 30 == 0) {
+			if (negroni_s1_fsr(&cam_s1)) {
+				negroni_s1_report(&cam_s1, "while streaming");
+				fault = true;
+				why = "the SMMU refused the IFE";
+				break;
+			}
+			if (ios_frames == 30 || ios_frames % 900 == 0) {
+				say("  ios session: %llu frames in %llu ms, %llu late address updates, %llu read", ios_frames,
+				    now - started, late, ios_given);
+			}
+		}
+	}
+out:
+	say("ios session: end (%s) after %llu frames", why, ios_frames);
+	if (csid_on) {
+		wr(csid + CSID_RDI0_CTRL, 0);   /* halt at the frame boundary, then the rest in cam_down */
+	}
+	if (gcc && camcc && cci) {
+		cam_down();
+	}
+	lck_mtx_lock(ios_lock);
+	for (unsigned i = 0; i < NRING; i++) {
+		while (place[i].state == PLACE_READING) {       /* a read still copies: wait for it */
+			lck_mtx_unlock(ios_lock);
+			IOSleep(5);
+			lck_mtx_lock(ios_lock);
+		}
+		place[i].state = PLACE_FREE;
+	}
+	ios_broken = ios_broken || fault;
+	lck_mtx_unlock(ios_lock);
+	ring_free();
+	ios_running = false;
+	if (fault) {
+		say("ios session: FAULT: /dev/negronicam answers EIO until reboot");
+	}
+	(void)thread_terminate(current_thread());
+}
+
+static int
+ios_read(struct uio *uio)
+{
+	uint64_t t0 = ms_now(), limit = 1000;
+	int error = 0;
+
+	if (ios_broken) {
+		return EIO;
+	}
+	lck_mtx_lock(ios_lock);
+	ios_last_read_ms = ms_now();
+	if (!ios_running) {
+		thread_t th;
+		ios_running = true;
+		limit = FIRST_FRAME_MS + 2000u;         /* bring-up + the first frame */
+		if (kernel_thread_start(ios_thread, NULL, &th) != KERN_SUCCESS) {
+			ios_running = false;
+			lck_mtx_unlock(ios_lock);
+			return ENOMEM;
+		}
+		thread_deallocate(th);
+	}
+	int best = -1;
+	for (;;) {
+		for (unsigned i = 0; i < NRING; i++) {
+			if (place[i].state == PLACE_READY && place[i].sequence > ios_given &&
+			    (best < 0 || place[i].sequence > place[best].sequence)) {
+				best = (int)i;
+			}
+		}
+		if (best >= 0 || ios_broken || ms_now() - t0 > limit) {
+			break;
+		}
+		lck_mtx_unlock(ios_lock);
+		IOSleep(2);
+		lck_mtx_lock(ios_lock);
+		ios_last_read_ms = ms_now();
+	}
+	if (best < 0) {
+		lck_mtx_unlock(ios_lock);
+		return ios_broken ? EIO : EAGAIN;
+	}
+	struct ncam_frame_hdr h;
+	bzero(&h, sizeof(h));
+	memcpy(h.magic, NCAM_MAGIC, 8);
+	h.header_bytes = sizeof(h);
+	h.width = ios_w;
+	h.height = ios_h;
+	h.stride = ios_stride;
+	h.format = 1;
+	h.bayer = ios_bayer;
+	h.black = (src_mask & 2u) ? IMX789_BLACK : 0;
+	h.sequence = place[best].sequence;
+	h.time = place[best].time;
+	h.exposure_lines = place[best].lines;
+	h.line_ns = FTM_LINE_NS;
+	h.gain = place[best].gain;
+	h.gain_unity = GAIN_UNITY;
+	h.gain_max = GAIN_MAX;
+	h.frame_lines = place[best].frame_lines;
+	h.frame_lines_min = FTM_FRAME_LINES;
+	h.frame_lines_max = 0xfff0u;
+	h.margin = EXPOSURE_MARGIN;
+	h.sensor = 1;                   /* the wide (rear main) camera in HakiOS's numbering */
+	h.focus = NCAM_NO_FOCUS;
+	ios_given = place[best].sequence;
+	bool body = uio_resid(uio) > (user_ssize_t)sizeof(h);
+	if (body) {
+		place[best].state = PLACE_READING;
+	}
+	lck_mtx_unlock(ios_lock);
+	error = uiomove((caddr_t)&h, (int)MIN((user_ssize_t)sizeof(h), uio_resid(uio)), uio);
+	if (body) {
+		/* the CPU view of the DMA'd bytes: invalidate (the SMMU writes with Normal non-cacheable attributes) */
+		flush_dcache((vm_offset_t)place[best].kva, (unsigned)round_page(ios_bytes), FALSE);
+		for (uint32_t at = 0; error == 0 && at < ios_bytes && uio_resid(uio) > 0;) {
+			int n = (int)MIN(MIN((user_ssize_t)(ios_bytes - at), uio_resid(uio)), (user_ssize_t)(1 << 20));
+			error = uiomove((caddr_t)(place[best].kva + at), n, uio);
+			at += (uint32_t)n;
+		}
+		lck_mtx_lock(ios_lock);
+		place[best].state = PLACE_READY;
+		lck_mtx_unlock(ios_lock);
+	}
+	return error;
+}
+
+static int
+ios_write(struct uio *uio)
+{
+	struct ncam_command c;
+	int error;
+
+	if (uio_resid(uio) < (user_ssize_t)sizeof(c)) {
+		return EINVAL;
+	}
+	if ((error = uiomove((caddr_t)&c, sizeof(c), uio)) != 0) {
+		return error;
+	}
+	switch (c.command) {
+	case CMD_EXPOSURE:
+		lck_mtx_lock(ios_lock);
+		ios_ask.lines = c.a;
+		ios_ask.gain = c.b;
+		ios_ask.frame_lines = c.c;
+		ios_ask.pending = true;
+		lck_mtx_unlock(ios_lock);
+		return 0;
+	case CMD_SENSOR:
+		return c.a == 1 ? 0 : ENODEV;   /* only the rear main camera (IMX789) has a driver */
+	case CMD_KEEP:
+	case CMD_FOCUS:
+		if (c.bytes && uio_resid(uio) > 0) {
+			uio_update(uio, MIN((user_size_t)c.bytes, (user_size_t)uio_resid(uio)));     /* skip the payload */
+		}
+		return 0;
+	default:
+		return EINVAL;
+	}
+}
+
+static void
+ios_publish(void)
+{
+	ios_grp = lck_grp_alloc_init("negronicam", LCK_GRP_ATTR_NULL);
+	ios_lock = lck_mtx_alloc_init(ios_grp, LCK_ATTR_NULL);
+	(void)PE_parse_boot_argn("negronicam_bayer", &ios_bayer, sizeof(ios_bayer));
+	ios_bayer &= 3u;
+	camdev_publish();
+	if (camdev_major >= 0) {
+		/* root:mobile 0660: the reader is mediaserverd, which runs as mobile (uid/gid 501) */
+		(void)devfs_make_node(makedev(camdev_major, 2), DEVFS_CHAR, UID_ROOT, NCAM_GID_MOBILE, 0660, "negronicam");
+		say("level 7: /dev/negronicam for iOS (%s; open + read starts the camera, the last close stops it; bayer %u)",
+		    (src_mask & 2u) ? "IMX789 rear main" : "TPG13 colour bars", ios_bayer);
+	}
+}
+
+/* CSIPHY 3-phase status after the sensor streams (status_regs_2_1_0: 24 words at 0x340 per trio) */
+static void
+csiphy_status(const char *when)
+{
+	if (!csiphy_on) {
+		return;
+	}
+	for (uint32_t t = 0; t < 3; t++) {
+		vm_offset_t b = csiphy + 0x340 + 0x400 * t;
+		say("  CSIPHY1 trio %u %s: status0-7 %#x %#x %#x %#x %#x %#x %#x %#x", t, when, rd(b), rd(b + 4), rd(b + 8),
+		    rd(b + 12), rd(b + 16), rd(b + 20), rd(b + 24), rd(b + 28));
+	}
+	say("  CSIPHY1 irq status %#x %#x %#x %#x", rd(csiphy + 0x10b0), rd(csiphy + 0x10b4), rd(csiphy + 0x10b8),
+	    rd(csiphy + 0x10bc));
+}
+
+static void
+cam_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	bool ok = (votes_policy == 0 || l0_votes()) && l1_map() && l1_gcc() && l1_gdsc() && l1_clocks() && l1_cci();
+	if (ok) {
+		say("level 1 OK: camcc + CCI0 up");
+	}
+	if (ok && level >= 2 && (src_mask & 2u)) {
+		ok = l2_pins() && l2_rails() && l2_reset() && l2_mclk() && l2_cci_pins() && l2_chip_id();
+		if (ok) {
+			say("level 2 OK: IMX789 answered on CCI0 M0");
+		}
+	}
+	if (ok && level >= 3) {
+		ok = l3_cpas() && l3_smmu();
+		if (ok) {
+			say("level 3 OK: CPAS/CAMNOC up, IFE DMA %s, ICP DMA %s", dma_s1 ? "SMMU S1" : dma_ok[0] ? "bypass" :
+			    "NOT bypass", dma_s1 ? (dma_ok[1] ? "SMMU S1" : "not needed") : dma_ok[1] ? "bypass" : "NOT bypass");
+		}
+	}
+	if (ok && level >= 4) {
+		ok = l4_clocks() && ((src_mask & 2u) == 0 || l4_csiphy());
+		if (ok) {
+			csiphy_status("before stream");
+			say("level 4 OK: capture clocks%s", (src_mask & 2u) ? " + CSIPHY1 C-PHY configured" : " (TCXO, TPG only)");
+		}
+	}
+	if (ok && level >= 5) {
+		ok = l5_frames();
+		if (ok) {
+			say("level 5 OK: raw frame(s) in memory (%s%s)", (src_mask & 1u) ? "TPG " : "", (src_mask & 2u) ? "sensor" : "");
+		}
+	}
+	if (ok && level >= 6) {
+		ok = l6_icp();
+		if (ok) {
+			say("level 6 OK: ICP up (PAS 33 + HFI SYS_INIT_DONE)");
+		}
+	}
+	if (ok && level == 4 && (src_mask & 2u)) {
+		ok = l4_stream();
+		csiphy_status("streaming");
+		if (ok) {
+			say("level 4 OK: IMX789 streams into CSIPHY1");
+		}
+	}
+	if (gcc && camcc && cci) {
+		cam_down();
+	}
+	say("done (asked level %u, %s at step %u %s)", level, ok ? "complete" : "STOPPED", step, step_name);
+	(void)thread_terminate(current_thread());
+}
+
+void
+negroni_cam_init(void)
+{
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("negronicam", &level, sizeof(level));
+	if (level == 0) {
+		return;
+	}
+	(void)PE_parse_boot_argn("negronicam_pause", &pause_ms, sizeof(pause_ms));
+	if (!PE_parse_boot_argn("negronicam_smmu", &smmu_policy, sizeof(smmu_policy))) {
+		smmu_policy = 1u;       /* 2026-10-27: stage 1 is opt-in (negronicam_smmu=3) until the bank probe proves it */
+	}
+	(void)PE_parse_boot_argn("negronicam_src", &src_mask, sizeof(src_mask));
+	(void)PE_parse_boot_argn("negronicam_drate", &drate_idx, sizeof(drate_idx));
+	(void)PE_parse_boot_argn("negronicam_settle", &settle_cnt, sizeof(settle_cnt));
+	src_mask &= 3u;
+	if (src_mask == 0) {
+		src_mask = 3;
+	}
+	settle_cnt = MIN(settle_cnt, 0xffffu);
+	(void)PE_parse_boot_argn("negronicam_votes", &votes_policy, sizeof(votes_policy));
+	pause_ms = MIN(pause_ms, 2000u);
+	level = MIN(level, CAM_MAX_LEVEL);
+	say("level %u (UNTESTED: camcc + CCI0%s%s)", level, level >= 2 ? " + IMX789 power + chip id" : "",
+	    level >= 3 ? " + CPAS/CAMNOC + SMMU check" : "");
+	if (level >= 4) {
+		say("level 4+: source %s, C-PHY data-rate entry %u, settle %u", src_mask == 1 ? "TPG" : src_mask == 2 ? "sensor" :
+		    "TPG then sensor", drate_idx, settle_cnt);
+	}
+	if (level == 7) {
+		ios_publish();          /* 0318: no boot run; a reader of /dev/negronicam starts the camera */
+		return;
+	}
+	if (kernel_thread_start(cam_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		say("kernel_thread_start failed");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_charge.c b/bsd/dev/negroni_charge.c
new file mode 100644
index 0000000..b5b669b
--- /dev/null
+++ b/bsd/dev/negroni_charge.c
@@ -0,0 +1,408 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450) patch 0377: charge-only mode after a cable power-on.
+ *
+ * Problem: with the phone off, the USB cable powers the PMIC on (PON trigger USB_CHARGER). On
+ * Android, ABL then boots with androidboot.mode=charger and the off-mode charging screen runs.
+ * Our chain (ABL -> boot_a UEFI shim -> DarwinBoot -> XNU) does not pass ABL's /chosen/bootargs
+ * to XNU (the boot line comes from payload.bin), so iOS boots. The kernel reads the PMIC PON log
+ * (SDAM 0x7400, negroni_reboot.c 0214) and can tell the cable power-on apart by itself.
+ *
+ * negroni_charge_check() runs at the start of load_init_program() (bsd/kern/kern_exec.c), in
+ * the init process's thread, before launchd. Boot-args:
+ *   negronicharge=0 (default)  dry run: the decision is logged, iOS always boots
+ *   negronicharge=1            the decision is acted on
+ *   negronicharge_force=1      enter the mode on every boot, also without negronicharge=1 (test
+ *                              with fastboot boot: a RAM boot cannot be a cable power-on). The
+ *                              actions are the real ones.
+ * Decision (bsd/dev/negroni_charge_core.h, host-tested): enter when
+ *   (last PON trigger USB_CHARGER, or boot-arg androidboot.mode=charger) AND no reset entry after
+ *   that trigger AND no warm/hard reset type before it AND the power key is up AND VBUS is present
+ *   (the NegroniBattery plug reading: VADC USBIN >= 4000 mV in negronibatt=4/5; without the
+ *   VADC only a charge current >= 50 mA says "present", and nothing can say "absent", so the
+ *   unplug power off needs negronibatt=4/5).
+ * In the mode:
+ *   - launchd is never started; the kernel threads keep running (USB gadget + command server:
+ *     "op10tool ctl reboot|bootloader|poweroff" work; NegroniBattery; the ADSP charger PD and
+ *     GLINK client when negroniadsp/negronichg_glink are on). Nothing here writes the charger:
+ *     without the PD the PM8350B charges on its XBL/hardware defaults (README-battery.md).
+ *   - the kernel console stops drawing (negroni_console_muted; the log ring and USB log keep it)
+ *     and a battery screen is drawn into the boot framebuffer: an outline, the fill, the percent.
+ *   - screen off after 10 s (black pixels + negroni_backlight_display_off), a short power key
+ *     press turns it on again; key held >= 2 s: PS_HOLD type HARD_RESET + reason 0 + reset, so the
+ *     next boot logs PON trigger HARD_RESET and boots iOS; no VBUS for 3 s: PMIC power off
+ *     (negroni_power_off, 0214), and if that returns, the same reboot into iOS.
+ * Every line starts "NEGRONI CHARGE:". The mode's loop has one 50 ms tick; every step in it is
+ * bounded; it ends only with a reset or a power off (that is its purpose).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "negroni_charge_core.h"
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* */
+
+void negroni_charge_check(void);
+void negroni_charge_batt_update(int percent, int percent_known, int external, int charging, unsigned usb_mv,
+    int vbus_measured);
+void negroni_charge_batt_plug(int external, unsigned usb_mv, int vbus_measured);
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);  /* kernel_map VA */
+extern int negroni_reboot_pon_info(int *trigger, int *type_before, int *reset_after);  /* negroni_reboot.c */
+extern const char *negroni_reboot_pon_summary(void);
+extern int negroni_reboot_hard_type(void);
+extern void negroni_reboot(unsigned reason);
+extern void negroni_power_off(void);
+extern void negroni_bootlog_end(unsigned kind, const char *why);        /* negroni_ufs.c 0367 */
+extern int negroni_keys_power(void);                                    /* negroni_keys.c */
+extern int negroni_console_muted;                                       /* serial_console.c */
+extern unsigned char iso_font[256 * 16];
+extern bool negroni_backlight_display_off(uint32_t fade_ms);            /* NegroniBacklight.cpp */
+extern bool negroni_backlight_display_on(void);
+
+#define NC_TICK_MS              50u
+#define NC_WAIT_BATT_MS         15000u  /* at most this long for the first battery reading */
+#define NC_PLUG_AGE_MS          30000u  /* an older plug reading counts as "not known" */
+#define NC_STATUS_MS            60000u  /* one status line this often */
+#define NC_REDRAW_MS            30000u  /* the screen is drawn again this often while on */
+
+/* ---- the battery snapshot (written by NegroniBattery's work loop, read by the mode) ---- */
+static volatile int nc_pct = -1;                /* percent, -1 = no reading */
+/* VBUS in one word (no torn pair, review F1): NC_PLUG_NONE, else bit 0 = present, bit 1 = measured by the VADC */
+#define NC_PLUG_NONE    (-1)
+static volatile int nc_plug = NC_PLUG_NONE;
+static volatile int nc_chg = -1;                /* charging: 1 / 0 / -1 */
+static volatile unsigned nc_usb_mv;
+static volatile uint64_t nc_plug_ms;            /* time of the last plug reading, 0 = none */
+
+static uint64_t
+nc_now_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC + 1;          /* never 0: 0 means "not set" in the snapshot */
+}
+
+/*
+ * NegroniBattery (its work loop): publish() every full read (20 s), fastCheck() every plug tick
+ * (negronibatt_fast, 1 s) that has a reading. vbus_measured: the reading is the VADC USBIN voltage
+ * (negronibatt=4/5); else "external" is the driver's guess from the battery current (or false
+ * when it has nothing), which nc_vbus() uses only as "present".
+ */
+/* external -1: no plug state in this update (the driver's static placeholder) */
+void
+negroni_charge_batt_update(int percent, int percent_known, int external, int charging, unsigned usb_mv,
+    int vbus_measured)
+{
+	nc_pct = percent_known && percent >= 0 && percent <= 100 ? percent : -1;
+	nc_chg = charging ? 1 : 0;
+	if (external >= 0) {
+		negroni_charge_batt_plug(external, usb_mv, vbus_measured);
+	}
+}
+
+void
+negroni_charge_batt_plug(int external, unsigned usb_mv, int vbus_measured)
+{
+	nc_plug = (external ? 1 : 0) | (vbus_measured ? 2 : 0);
+	nc_usb_mv = usb_mv;
+	nc_plug_ms = nc_now_ms();
+}
+
+static int
+nc_vbus(void)
+{
+	uint64_t at = nc_plug_ms, now = nc_now_ms();
+	int plug = nc_plug;
+	if (at == 0 || now - at > NC_PLUG_AGE_MS || plug == NC_PLUG_NONE) {
+		return -1;
+	}
+	/* Only a measured VBUS can say "no cable" (that powers the phone off); a guess says "present" only. */
+	if ((plug & 1) == 0 && (plug & 2) == 0) {
+		return -1;
+	}
+	return plug & 1;
+}
+
+static int nc_sleep_chan;
+
+static void
+nc_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline((event_t)&nc_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* ---- the screen: the boot framebuffer (a8r8g8b8), write-combined, written only ---- */
+static volatile uint32_t *nc_fb;
+static uint32_t nc_w, nc_h, nc_stride;          /* stride in pixels */
+
+#define NC_BLACK        0xff000000u
+#define NC_WHITE        0xffffffffu
+#define NC_GREY         0xff808080u
+#define NC_GREEN        0xff30d158u
+#define NC_RED          0xffff453au
+
+static bool
+nc_fb_open(void)
+{
+	PE_Video v;
+
+	bzero(&v, sizeof(v));
+	PE_current_console(&v);
+	uint64_t pa = v.v_baseAddr & ~3ul;
+	if (pa == 0 || v.v_width == 0 || v.v_height == 0 || v.v_rowBytes < v.v_width * 4 || (v.v_rowBytes & 3) ||
+	    (v.v_depth != 0 && (v.v_depth & 0xff) != 32)) {
+		printf("NEGRONI CHARGE: no 32-bit boot framebuffer (base %#llx %lux%lu row %lu depth %lu): no screen\n",
+		    (unsigned long long)pa, v.v_width, v.v_height, v.v_rowBytes, v.v_depth);
+		return false;
+	}
+	/* 0x6 = VM_WIMG_WCOMB. Not ml_io_map_wcomb: io_submap is 8 MiB (KMA_NOFAIL panics), 1080x2412x4 = 10.4 MB */
+	vm_offset_t va = ml_io_map_unmappable((vm_offset_t)pa, (vm_size_t)(v.v_rowBytes * v.v_height), 0x6u);
+	if (va == 0) {
+		printf("NEGRONI CHARGE: framebuffer map failed: no screen\n");
+		return false;
+	}
+	nc_fb = (volatile uint32_t *)va;
+	nc_w = (uint32_t)v.v_width;
+	nc_h = (uint32_t)v.v_height;
+	nc_stride = (uint32_t)(v.v_rowBytes / 4);
+	printf("NEGRONI CHARGE: framebuffer %ux%u (row %u px) at %#llx\n", nc_w, nc_h, nc_stride,
+	    (unsigned long long)pa);
+	return true;
+}
+
+static void
+nc_rect(int x, int y, int w, int h, uint32_t c)
+{
+	if (nc_fb == NULL) {
+		return;
+	}
+	int x0 = x < 0 ? 0 : x, y0 = y < 0 ? 0 : y;
+	int x1 = x + w > (int)nc_w ? (int)nc_w : x + w, y1 = y + h > (int)nc_h ? (int)nc_h : y + h;
+	for (int yy = y0; yy < y1; yy++) {
+		volatile uint32_t *row = nc_fb + (uint32_t)yy * nc_stride;
+		for (int xx = x0; xx < x1; xx++) {
+			row[xx] = c;
+		}
+	}
+}
+
+/* Text in the 8x16 console font, each font pixel a scale x scale square, centred at cx. */
+static void
+nc_text(int cx, int y, int scale, const char *s, uint32_t c)
+{
+	int n = (int)strlen(s);
+	int x = cx - n * 8 * scale / 2;
+	for (int i = 0; i < n; i++, x += 8 * scale) {
+		const unsigned char *g = &iso_font[(unsigned char)s[i] * 16];
+		for (int gy = 0; gy < 16; gy++) {
+			for (int gx = 0; gx < 8; gx++) {
+				if (g[gy] & (1u << gx)) {
+					nc_rect(x + gx * scale, y + gy * scale, scale, scale, c);
+				}
+			}
+		}
+	}
+}
+
+static void
+nc_draw(int pct, int vbus, int chg)
+{
+	if (nc_fb == NULL) {
+		return;
+	}
+	const int W = (int)nc_w, H = (int)nc_h;
+	nc_rect(0, 0, W, H, NC_BLACK);
+	/* battery outline: body 360 x 640, wall 16, cap 140 x 40, upper half of the screen */
+	const int bw = 360, bh = 640, t = 16, capw = 140, caph = 40;
+	const int bx = (W - bw) / 2, by = H / 2 - bh - 40;
+	const uint32_t edge = NC_WHITE;
+	nc_rect(bx + (bw - capw) / 2, by - caph, capw, caph, edge);
+	nc_rect(bx, by, bw, t, edge);
+	nc_rect(bx, by + bh - t, bw, t, edge);
+	nc_rect(bx, by, t, bh, edge);
+	nc_rect(bx + bw - t, by, t, bh, edge);
+	/* fill from the bottom, inside a 12 px gap */
+	const int gap = 12, ih = bh - 2 * (t + gap), iw = bw - 2 * (t + gap);
+	uint32_t fill = pct < 0 ? NC_GREY : pct <= 15 ? NC_RED : chg == 1 ? NC_GREEN : NC_WHITE;
+	int fh = pct < 0 ? ih / 20 : ih * pct / 100;
+	if (fh > 0) {
+		nc_rect(bx + t + gap, by + t + gap + ih - fh, iw, fh, fill);
+	}
+	char line[16];
+	if (pct >= 0) {
+		snprintf(line, sizeof(line), "%d%%", pct);
+	} else {
+		strlcpy(line, "--%", sizeof(line));
+	}
+	nc_text(W / 2, H / 2 + 60, 14, line, NC_WHITE);                 /* 112 x 224 per glyph */
+	const char *state = vbus == 0 ? "Not connected" : chg == 1 ? "Charging" : vbus == 1 ? "Connected" : "";
+	nc_text(W / 2, H / 2 + 60 + 224 + 60, 5, state, chg == 1 ? NC_GREEN : NC_WHITE);
+	nc_text(W / 2, H - 260, 3, "Hold power 2 s to start iOS", NC_GREY);
+}
+
+static void
+nc_screen_off(void)
+{
+	nc_rect(0, 0, (int)nc_w, (int)nc_h, NC_BLACK);
+	if (!negroni_backlight_display_off(0)) {
+		printf("NEGRONI CHARGE: no backlight service: screen off = black pixels only\n");
+	}
+}
+
+/* Reboot into iOS: HARD_RESET type (a new PON trigger at the next boot), reason 0 (normal). */
+static void
+nc_reboot_ios(const char *why)
+{
+	printf("NEGRONI CHARGE: reboot into iOS (%s)\n", why);
+	if (negroni_reboot_hard_type() != 0) {
+		printf("NEGRONI CHARGE: PS_HOLD type HARD_RESET not set: the next boot may enter the mode again\n");
+	}
+	negroni_bootlog_end(4, why);
+	negroni_reboot(0);
+	printf("NEGRONI CHARGE: reset failed (PSCI returned)\n");
+}
+
+static void
+nc_power_off(void)
+{
+	printf("NEGRONI CHARGE: power off (no VBUS for %u ms)\n", NC_UNPLUG_MS);
+	negroni_bootlog_end(3, "power off (charge mode: cable unplugged)");
+	negroni_power_off();
+	printf("NEGRONI CHARGE: power off failed: rebooting into iOS instead\n");
+	nc_reboot_ios("charge mode: power off failed");
+}
+
+/* The mode. Never returns. */
+__attribute__((noreturn)) static void
+nc_mode(void)
+{
+	struct nc_state st;
+	uint64_t now = nc_now_ms(), drawn_at = 0, status_at = now;
+	int drawn_pct = -2, drawn_vbus = -2, drawn_chg = -2;
+	bool lit = true;        /* the panel is on (the boot left it on) */
+
+	negroni_console_muted = 1;
+	printf("NEGRONI CHARGE: mode on: launchd not started; console drawing muted; screen off after %u s, "
+	    "short press = screen on, hold %u s = iOS, unplug %u s = power off; USB ctl stays up\n",
+	    NC_SCREEN_MS / 1000, NC_LONG_PRESS_MS / 1000, NC_UNPLUG_MS / 1000);
+	(void)nc_fb_open();
+	nc_init(&st, now);
+	for (;;) {
+		now = nc_now_ms();
+		int key = negroni_keys_power(), vbus = nc_vbus(), pct = nc_pct, chg = nc_chg;
+		enum nc_action a = nc_step(&st, now, key, vbus);
+		switch (a) {
+		case NC_SCREEN_ON:
+			printf("NEGRONI CHARGE: short press: screen on%s\n", lit ? " (was on: 10 s again)" : "");
+			if (!lit) {
+				(void)negroni_backlight_display_on();
+				lit = true;
+			}
+			drawn_at = 0;   /* draw now */
+			break;
+		case NC_SCREEN_OFF:
+			printf("NEGRONI CHARGE: %u s without a press: screen off\n", NC_SCREEN_MS / 1000);
+			nc_screen_off();
+			lit = false;
+			break;
+		case NC_REBOOT:
+			printf("NEGRONI CHARGE: power key held %u ms\n", NC_LONG_PRESS_MS);
+			nc_reboot_ios("charge mode: power key held 2 s");
+			nc_sleep_ms(5000);      /* only if the reset failed: a new press tries again */
+			break;
+		case NC_POWEROFF:
+			nc_power_off();
+			nc_sleep_ms(5000);      /* only if both failed: try again after 5 s + 3 s */
+			st.unplug_since = 0;
+			break;
+		default:
+			break;
+		}
+		if (st.screen_on && (drawn_at == 0 || pct != drawn_pct || vbus != drawn_vbus || chg != drawn_chg ||
+		    now - drawn_at >= NC_REDRAW_MS)) {
+			nc_draw(pct, vbus, chg);
+			drawn_at = now;
+			drawn_pct = pct;
+			drawn_vbus = vbus;
+			drawn_chg = chg;
+		}
+		if (now - status_at >= NC_STATUS_MS) {
+			status_at = now;
+			printf("NEGRONI CHARGE: status: %d%% vbus %d (%u mV) charging %d key %d screen %s\n",
+			    pct, vbus, nc_usb_mv, chg, key, st.screen_on ? "on" : "off");
+		}
+		nc_sleep_ms(NC_TICK_MS);
+	}
+}
+
+void
+negroni_charge_check(void)
+{
+	static bool done;
+	int mode = 0, force = 0;
+	char abl[32];
+
+	if (done) {
+		return;
+	}
+	done = true;
+	(void)PE_parse_boot_argn("negronicharge", &mode, sizeof(mode));
+	(void)PE_parse_boot_argn("negronicharge_force", &force, sizeof(force));
+
+	if (force == 1) {
+		mode = 1;               /* the force acts; it is not a dry run */
+	}
+	struct nc_inputs in;
+	bzero(&in, sizeof(in));
+	in.pon = in.type_before = -1;
+	in.force = force == 1;
+	in.pon_decoded = negroni_reboot_pon_info(&in.pon, &in.type_before, &in.reset_after) == 0;
+	bzero(abl, sizeof(abl));
+	bool abl_seen = PE_parse_boot_arg_str("androidboot.mode", abl, sizeof(abl));
+	in.abl_charger = abl_seen && strcmp(abl, "charger") == 0;
+	printf("NEGRONI CHARGE: negronicharge=%d force=%d; PON log %s: trigger %#06x, reset type before %d, "
+	    "reset after %d (summary: %s); ABL mode %s\n", mode, force,
+	    in.pon_decoded ? "decoded" : "NOT decoded", in.pon < 0 ? 0 : in.pon, in.type_before, in.reset_after,
+	    negroni_reboot_pon_summary()[0] ? negroni_reboot_pon_summary() : "-",
+	    abl_seen ? abl : "not passed (the UEFI shim gives XNU the payload boot line, not ABL's /chosen/bootargs)");
+
+	enum nc_reason r = nc_boot_reason(&in);
+	if (!nc_enters(r) && mode != 0) {
+		printf("NEGRONI CHARGE: decision: boot iOS (%s)\n", nc_reason_text(r));
+		return;
+	}
+	/* A cable power-on (or forced, or the dry run): the key and VBUS too */
+	in.key = negroni_keys_power();
+	if (mode != 0) {
+		uint64_t until = nc_now_ms() + NC_WAIT_BATT_MS;
+		if (nc_plug_ms == 0) {
+			printf("NEGRONI CHARGE: waiting up to %u s for the first battery reading\n", NC_WAIT_BATT_MS / 1000);
+		}
+		while (nc_plug_ms == 0 && nc_now_ms() < until) {
+			nc_sleep_ms(100);
+		}
+	}
+	in.vbus = nc_vbus();
+	r = nc_decide(&in);
+	printf("NEGRONI CHARGE: key %d, vbus %d (%u mV), battery %d%% charging %d\n", in.key, in.vbus, nc_usb_mv,
+	    nc_pct, nc_chg);
+	if (mode == 0) {
+		printf("NEGRONI CHARGE: dry run (negronicharge=0): would %s (%s); iOS boots\n",
+		    nc_enters(r) ? "ENTER the charge-only mode" : "boot iOS", nc_reason_text(r));
+		return;
+	}
+	if (!nc_enters(r)) {
+		printf("NEGRONI CHARGE: decision: boot iOS (%s)\n", nc_reason_text(r));
+		return;
+	}
+	printf("NEGRONI CHARGE: decision: charge-only mode (%s)\n", nc_reason_text(r));
+	nc_mode();
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_charge_core.h b/bsd/dev/negroni_charge_core.h
new file mode 100644
index 0000000..d4f1d55
--- /dev/null
+++ b/bsd/dev/negroni_charge_core.h
@@ -0,0 +1,202 @@
+/*
+ * NEGRONI (SM8450) patch 0377: the decisions of the charge-only mode (bsd/dev/negroni_charge.c),
+ * as pure C with no kernel calls, so a host test (tools/charge-core-test, scripts/kernel/
+ * test-charge-core.sh) checks exactly this code.
+ *
+ *   nc_decide()  at boot, once: enter the charge-only mode or boot iOS.
+ *   nc_step()    in the mode, every tick: the power key, the cable and the screen timer.
+ *
+ * Inputs use -1 for "not known". Nothing here loops: every call is O(1).
+ */
+#ifndef NEGRONI_CHARGE_CORE_H
+#define NEGRONI_CHARGE_CORE_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* PMIC PON log codes (downstream pmic-pon-log.c, as decoded by negroni_reboot.c 0214) */
+#define NC_PON_USB_CHARGER_A    0x31c2
+#define NC_PON_USB_CHARGER_B    0x8732
+#define NC_TYPE_WARM_RESET      0x01
+#define NC_TYPE_HARD_RESET      0x07
+#define NC_TYPE_DVDD_HARD_RESET 0x08
+
+#define NC_LONG_PRESS_MS        2000u   /* power key held this long: reboot into iOS */
+#define NC_UNPLUG_MS            3000u   /* no VBUS this long: power off */
+#define NC_SCREEN_MS            10000u  /* screen on this long without a key press: screen off */
+
+struct nc_inputs {
+	int pon_decoded;        /* 1: the PON log was read and decoded */
+	int pon;                /* last PON trigger code, -1 none */
+	int type_before;        /* reset type logged before that trigger (the previous cycle's end), -1 none */
+	int reset_after;        /* 1: a RESET_TRIGGER/RESET_TYPE entry after the last PON trigger (warm reset) */
+	int abl_charger;        /* 1: boot-arg androidboot.mode=charger (ABL's mode, if a shim passes it) */
+	int key;                /* power key: 1 pressed, 0 released, -1 unknown */
+	int vbus;               /* 1 cable power present, 0 none, -1 unknown */
+	int force;              /* boot-arg negronicharge_force=1 */
+};
+
+enum nc_reason {
+	NC_YES_CABLE = 0,       /* enter: cable power-on */
+	NC_YES_FORCED,          /* enter: negronicharge_force=1 */
+	NC_NO_PON_UNKNOWN,      /* the PON log was not decoded */
+	NC_NO_TRIGGER,          /* the last PON trigger is not the charger (key, reset, RTC ...) */
+	NC_NO_RESET_BEFORE,     /* a reset type (warm/hard) before the trigger */
+	NC_NO_RESET_AFTER,      /* a reset after the last PON trigger: this boot is a reset */
+	NC_NO_KEY,              /* the power key is held */
+	NC_NO_VBUS,             /* no cable power */
+	NC_NO_VBUS_UNKNOWN,     /* cable power not known (no battery data) */
+};
+
+static inline const char *
+nc_reason_text(enum nc_reason r)
+{
+	switch (r) {
+	case NC_YES_CABLE:       return "cable power-on (PON trigger USB_CHARGER or ABL mode charger), key up, VBUS present";
+	case NC_YES_FORCED:      return "forced (negronicharge_force=1)";
+	case NC_NO_PON_UNKNOWN:  return "PON log not decoded and no ABL mode";
+	case NC_NO_TRIGGER:      return "the power-on trigger is not the charger";
+	case NC_NO_RESET_BEFORE: return "a warm/hard reset type before the PON trigger";
+	case NC_NO_RESET_AFTER:  return "a reset after the last PON trigger (this boot is a reset)";
+	case NC_NO_KEY:          return "the power key is held";
+	case NC_NO_VBUS:         return "no VBUS";
+	case NC_NO_VBUS_UNKNOWN: return "VBUS not known (no battery data)";
+	default:                 return "?";
+	}
+}
+
+static inline bool
+nc_is_charger_trigger(int pon)
+{
+	return pon == NC_PON_USB_CHARGER_A || pon == NC_PON_USB_CHARGER_B;
+}
+
+static inline bool
+nc_is_reset_type(int type)
+{
+	return type == NC_TYPE_WARM_RESET || type == NC_TYPE_HARD_RESET || type == NC_TYPE_DVDD_HARD_RESET;
+}
+
+/* Cable power-on by the boot reasons alone (no key, no VBUS): the first test, before any wait. */
+static inline enum nc_reason
+nc_boot_reason(const struct nc_inputs *in)
+{
+	if (in->force) {
+		return NC_YES_FORCED;
+	}
+	if (!in->abl_charger) {
+		if (!in->pon_decoded) {
+			return NC_NO_PON_UNKNOWN;
+		}
+		if (!nc_is_charger_trigger(in->pon)) {
+			return NC_NO_TRIGGER;
+		}
+	}
+	if (in->pon_decoded && in->reset_after) {
+		return NC_NO_RESET_AFTER;
+	}
+	if (in->pon_decoded && nc_is_reset_type(in->type_before)) {
+		return NC_NO_RESET_BEFORE;
+	}
+	return NC_YES_CABLE;
+}
+
+/* The whole decision. NC_YES_* = enter the charge-only mode. */
+static inline enum nc_reason
+nc_decide(const struct nc_inputs *in)
+{
+	enum nc_reason r = nc_boot_reason(in);
+	if (r != NC_YES_CABLE) {
+		return r;
+	}
+	if (in->key == 1) {
+		return NC_NO_KEY;
+	}
+	if (in->vbus == 0) {
+		return NC_NO_VBUS;
+	}
+	if (in->vbus < 0) {
+		return NC_NO_VBUS_UNKNOWN;
+	}
+	return NC_YES_CABLE;
+}
+
+static inline bool
+nc_enters(enum nc_reason r)
+{
+	return r == NC_YES_CABLE || r == NC_YES_FORCED;
+}
+
+/* The mode's state. Times in ms of one monotonic clock; 0 = "not set". */
+struct nc_state {
+	bool     screen_on;
+	uint64_t screen_on_at;
+	bool     key_down;          /* a press seen (key went 0 -> 1 in the mode) */
+	uint64_t key_down_at;
+	bool     key_long;          /* this press already asked for the reboot */
+	uint64_t unplug_since;
+};
+
+enum nc_action {
+	NC_NONE = 0,
+	NC_SCREEN_ON,           /* short press: screen on (and the 10 s timer starts again) */
+	NC_SCREEN_OFF,          /* 10 s without a press */
+	NC_REBOOT,              /* key held >= 2 s: reboot into iOS (once per press) */
+	NC_POWEROFF,            /* no VBUS for >= 3 s */
+};
+
+static inline void
+nc_init(struct nc_state *s, uint64_t now_ms)
+{
+	s->screen_on = true;
+	s->screen_on_at = now_ms;
+	s->key_down = false;
+	s->key_down_at = 0;
+	s->key_long = false;
+	s->unplug_since = 0;
+}
+
+/*
+ * One tick. key: 1, 0 or -1 (not known: no change). vbus: 1, 0, or -1 (not known: the unplug
+ * stretch starts again, so 3 s of new "0" readings are needed). A press that started before the mode
+ * (key already 1 at the first tick) counts from that tick. The power off wins over the key.
+ */
+static inline enum nc_action
+nc_step(struct nc_state *s, uint64_t now_ms, int key, int vbus)
+{
+	if (vbus == 0) {
+		if (s->unplug_since == 0) {
+			s->unplug_since = now_ms ? now_ms : 1;
+		} else if (now_ms - s->unplug_since >= NC_UNPLUG_MS) {
+			return NC_POWEROFF;
+		}
+	} else {
+		s->unplug_since = 0;    /* present, or not known (review F4) */
+	}
+	if (key == 1) {
+		if (!s->key_down) {
+			s->key_down = true;
+			s->key_down_at = now_ms;
+			s->key_long = false;
+		} else if (!s->key_long && now_ms - s->key_down_at >= NC_LONG_PRESS_MS) {
+			s->key_long = true;
+			return NC_REBOOT;
+		}
+	} else if (key == 0 && s->key_down) {
+		bool was_long = s->key_long;
+		s->key_down = false;
+		s->key_long = false;
+		if (!was_long) {
+			s->screen_on = true;
+			s->screen_on_at = now_ms;
+			return NC_SCREEN_ON;
+		}
+	}
+	if (s->screen_on && !s->key_down && now_ms - s->screen_on_at >= NC_SCREEN_MS) {
+		s->screen_on = false;
+		return NC_SCREEN_OFF;
+	}
+	return NC_NONE;
+}
+
+#endif /* NEGRONI_CHARGE_CORE_H */
