+
+/* ==== GPR ==== */
+
+struct gpr_hdr {
+	uint32_t w0;                    /* ver(4) | hdr_words(4) | pkt_size(24) */
+	uint8_t dst_domain, src_domain;
+	uint16_t reserved;
+	uint32_t src_port, dst_port, token, opcode;
+} __attribute__((packed));
+
+static void
+gpr_build_hdr(struct gpr_hdr *h, uint32_t pkt_size, uint32_t dst_port, uint32_t src_port, uint32_t opcode)
+{
+	h->w0 = GPR_VER | GPR_HDR_WORDS << 4 | pkt_size << 8;
+	h->dst_domain = GPR_DOMAIN_ADSP;
+	h->src_domain = GPR_DOMAIN_APPS;
+	h->reserved = 0;
+	h->src_port = src_port;
+	h->dst_port = dst_port;
+	h->token = 0;
+	h->opcode = opcode;
+}
+
+/* the GPR rx (one GLINK packet = one GPR packet); records a BASIC_RSP or GET_SPF_STATE reply */
+static void
+gpr_rx(const uint8_t *data, uint32_t len)
+{
+	const struct gpr_hdr *h = (const void *)data;
+	const uint32_t *pl = (const uint32_t *)(data + sizeof(*h));
+	uint32_t plwords;
+
+	if (len < sizeof(*h)) {
+		return;
+	}
+	plwords = (len - sizeof(*h)) / 4;
+	switch (h->opcode) {
+	case APM_RSP_GET_SPF_STATE:
+		if (plwords >= 1) {
+			spf_ready = pl[0];
+		}
+		break;
+	case GPR_BASIC_RSP_RESULT:              /* {opcode of the command, status} */
+		if (plwords >= 2 && gpr_wait_op && pl[0] == gpr_wait_op) {
+			gpr_reply_status = pl[1];
+			gpr_wait_op = 0;
+		}
+		break;
+	case PRM_RSP_REQUEST_HW_RSC:            /* gpr_ibasic_rsp_result_t {opcode, status} (q6prm.c prm_callback) */
+	case PRM_RSP_RELEASE_HW_RSC:
+		if (plwords >= 2 && gpr_wait_op && gpr_wait_rsp == h->opcode) {
+			gpr_reply_status = pl[1];
+			gpr_wait_op = 0;
+		}
+		break;
+	case APM_RSP_SHARED_MEM_MAP:            /* {mem_map_handle} */
+		if (plwords >= 1) {
+			mem_map_handle = pl[0];
+			if (gpr_wait_op && gpr_wait_rsp == APM_RSP_SHARED_MEM_MAP) {
+				gpr_reply_status = 0;
+				gpr_wait_op = 0;
+			}
+		}
+		break;
+	case DATA_RSP_WR_SH_MEM_EP_DONE:
+	case DATA_RSP_WR_SH_MEM_EP_DONE_V2:
+		os_atomic_inc(&write_done_count, relaxed);
+		break;
+	default:
+		break;
+	}
+}
+
+/*
+ * Send a GPR packet and poll GLINK for its answer: a BASIC_RSP_RESULT that echoes the packet's own
+ * opcode, or (rsp != 0) that specific response opcode. *status = the answer's status (0 = ok).
+ */
+static int
+gpr_send_wait(const void *pkt, uint32_t len, uint32_t rsp, uint32_t *status)
+{
+	struct gpr_hdr h;
+	int rc;
+
+	memcpy(&h, pkt, sizeof(h));
+	gpr_wait_rsp = rsp;
+	gpr_wait_op = h.opcode;
+	gpr_reply_status = ~0u;
+	rc = negroni_glink_send(NEGRONI_GLINK_GPR, pkt, len);
+	if (rc) {
+		gpr_wait_op = 0;
+		return rc;
+	}
+	for (uint32_t ms = 0; ms < budget_ms && gpr_wait_op; ms++) {
+		negroni_glink_poll();
+		if (gpr_wait_op) {
+			IOSleep(1);
+		}
+	}
+	if (gpr_wait_op) {
+		gpr_wait_op = 0;
+		return ETIMEDOUT;
+	}
+	if (status) {
+		*status = gpr_reply_status;
+	}
+	return 0;
+}
+
+/* ==== step 10: QRTR (HELLO, the ADSP's server list) ==== */
+
+struct qrtr_hdr {
+	uint32_t version, type, src_node, src_port, confirm_rx, size, dst_node, dst_port;
+} __attribute__((packed));
+/* control packet body (uapi qrtr.h struct qrtr_ctrl_pkt): cmd, then server {service, instance, node, port} */
+#define QRTR_CTRL_BYTES 20u                     /* a receiver drops control packets shorter than this (af_qrtr.c) */
+#define QRTR_VER        1u
+#define QRTR_TYPE_HELLO 2u
+#define QRTR_TYPE_NEW_SERVER 4u
+#define QRTR_PORT_CTRL  0xfffffffeu
+#define QRTR_NODE_BCAST 0xffffffffu
+#define QRTR_LOCAL_NODE 1u
+
+static uint32_t adsp_node = ~0u;         /* learned from the ADSP's HELLO/NEW_SERVER */
+static uint32_t adsp_servers;            /* NEW_SERVER packets seen */
+
+/* One QRTR control packet: header + the 20-byte body {cmd, a, b, c, d}. */
+static void
+qrtr_send_ctrl(uint32_t cmd, const uint32_t args[4], uint32_t dst_node)
+{
+	uint32_t pkt[(sizeof(struct qrtr_hdr) + QRTR_CTRL_BYTES) / 4];
+	struct qrtr_hdr h = {
+		.version = QRTR_VER, .type = cmd, .src_node = QRTR_LOCAL_NODE, .src_port = QRTR_PORT_CTRL,
+		.confirm_rx = 0, .size = QRTR_CTRL_BYTES, .dst_node = dst_node, .dst_port = QRTR_PORT_CTRL,
+	};
+
+	bzero(pkt, sizeof(pkt));
+	memcpy(pkt, &h, sizeof(h));
+	pkt[sizeof(h) / 4] = cmd;
+	if (args) {
+		memcpy(&pkt[sizeof(h) / 4 + 1], args, 16);
+	}
+	(void)negroni_glink_send(NEGRONI_GLINK_IPCRTR, pkt, sizeof(pkt));
+}
+
+static void
+qrtr_rx(const uint8_t *data, uint32_t len)
+{
+	struct qrtr_hdr h;
+	uint32_t b[5];
+
+	if (len < sizeof(h)) {
+		return;
+	}
+	memcpy(&h, data, sizeof(h));
+	bzero(b, sizeof(b));
+	memcpy(b, data + sizeof(h), MIN(len - (uint32_t)sizeof(h), (uint32_t)sizeof(b)));
+	if (h.type == QRTR_TYPE_HELLO) {
+		adsp_node = h.src_node;
+		say("QRTR: HELLO from node %u", h.src_node);
+		qrtr_send_ctrl(QRTR_TYPE_HELLO, NULL, h.src_node);     /* answer, as the Linux core does */
+	} else if (h.type == QRTR_TYPE_NEW_SERVER && len >= sizeof(h) + QRTR_CTRL_BYTES) {
+		adsp_node = h.src_node;
+		adsp_servers++;
+		/* b[0] = cmd, b[1] service, b[2] instance (version | instance << 8), b[3] node, b[4] port */
+		say("QRTR: NEW_SERVER service %u instance %#x node %u port %#x", b[1], b[2], b[3], b[4]);
+	}
+}
+
+/*
+ * No servreg locator (QMI service 0x40) is offered yet: nothing here answers GET_DOMAIN_LIST,
+ * so announcing one would only make the ADSP wait for replies. Step 11 polls GET_SPF_STATE
+ * directly; if it never gets ready, a locator (qcom_pd_mapper.c style) is the next thing to add.
+ */
+static bool
+step_qrtr(void)
+{
+	announce_note("QRTR: say HELLO on IPCRTR, record the ADSP's servers");
+	if (!negroni_glink_up(NEGRONI_GLINK_IPCRTR)) {
+		FAIL("GLINK channel IPCRTR is not up");
+		return false;
+	}
+	negroni_glink_set_rx(NEGRONI_GLINK_IPCRTR, qrtr_rx);
+	qrtr_send_ctrl(QRTR_TYPE_HELLO, NULL, QRTR_NODE_BCAST);
+	for (uint32_t ms = 0; ms < MIN(budget_ms, 3000u); ms++) {
+		negroni_glink_poll();
+		IOSleep(1);
+	}
+	say("QRTR: ADSP node %s, %u NEW_SERVER packets", adsp_node == ~0u ? "unknown (no HELLO)" : "known", adsp_servers);
+	return true;
+}
+
+/* ==== step 11: SPF ready ==== */
+
+struct apm_param {
+	uint32_t miid, pid, size, err;
+} __attribute__((packed));
+struct apm_cmd_hdr {
+	uint32_t addr_lsw, addr_msw, handle, size;
+} __attribute__((packed));
+
+static bool
+step_spf(void)
+{
+	/* GPR header + a zeroed 16-byte apm_cmd_header (q6apm_get_apm_state: 40 bytes) */
+	struct {
+		struct gpr_hdr hdr;
+		struct apm_cmd_hdr cmd;
+	} __attribute__((packed)) pkt;
+
+	announce_note("GPR: APM_CMD_GET_SPF_STATE on adsp_apps");
+	if (!negroni_glink_up(NEGRONI_GLINK_GPR)) {
+		FAIL("GLINK channel adsp_apps is not up");
+		return false;
+	}
+	negroni_glink_set_rx(NEGRONI_GLINK_GPR, gpr_rx);
+	for (uint32_t tenth = 0; tenth < budget_ms / 100; tenth++) {
+		spf_ready = 0;
+		bzero(&pkt, sizeof(pkt));
+		gpr_build_hdr(&pkt.hdr, sizeof(pkt), GPR_PORT_APM, GPR_APM_IID, APM_CMD_GET_SPF_STATE);
+		if (negroni_glink_send(NEGRONI_GLINK_GPR, &pkt, sizeof(pkt)) != 0) {
+			FAIL("GET_SPF_STATE does not go out");
+			return false;
+		}
+		for (uint32_t ms = 0; ms < 100 && !spf_ready; ms++) {
+			negroni_glink_poll();
+			IOSleep(1);
+		}
+		if (spf_ready == 1) {
+			say("SPF READY");
+			return true;
+		}
+	}
+	FAIL("no SPF ready (last state %u)", spf_ready);
+	return false;
+}
+
+/* ==== step 12: PRM clock + I2S pins ==== */
+
+
+static bool
+step_prm(void)
+{
+	struct {
+		struct gpr_hdr hdr;
+		struct apm_cmd_hdr cmd;
+		struct apm_param p;
+		uint32_t num_clk;
+		uint32_t clock_id, clock_freq, clock_attri, clock_root;
+	} __attribute__((packed)) pkt;
+	uint32_t status = ~0u;
+
+	bzero(&pkt, sizeof(pkt));
+	gpr_build_hdr(&pkt.hdr, sizeof(pkt), GPR_PORT_PRM, GPR_SRC_PORT, PRM_CMD_REQUEST_HW_RSC);
+	pkt.cmd.size = sizeof(pkt) - sizeof(pkt.hdr) - sizeof(pkt.cmd);
+	pkt.p.miid = GPR_PRM_IID;
+	pkt.p.pid = PARAM_ID_RSC_AUDIO_HW_CLK;
+	pkt.p.size = sizeof(pkt) - sizeof(pkt.hdr) - sizeof(pkt.cmd) - sizeof(pkt.p);
+	pkt.num_clk = 1;
+	pkt.clock_id = CLOCK_ID_TER_MI2S_IBIT;
+	pkt.clock_freq = MI2S_BCLK_HZ;
+	pkt.clock_attri = CLOCK_ATTR_COUPLE_NO;
+	pkt.clock_root = 0;
+
+	announce_note("PRM: request TER MI2S IBIT clock 3.072 MHz");
+	if (gpr_send_wait(&pkt, sizeof(pkt), PRM_RSP_REQUEST_HW_RSC, &status) != 0 || status != 0) {
+		FAIL("PRM clock request failed (status %#x)", status);
+		return false;
+	}
+	clock_on = true;
+	/* I2S pins 121..124 to function 1, 8 mA, no pull (output for the sink data on 124) */
+	if (tlmm == 0) {
+		/* GPIO121..124 = 0xf179000..0xf17cfff: two 16 KiB pages (ml_io_map rounds) */
+		tlmm = ml_io_map(TLMM_PHYS + TLMM_PIN(I2S_PIN_FIRST), TLMM_PIN(4));
+	}
+	if (tlmm == 0) {
+		FAIL("no TLMM mapping");
+		return false;
+	}
+	for (unsigned p = 121; p <= 124; p++) {
+		wr32(tlmm, (uint32_t)I2S_PIN(p), 1u << 2 | 3u << 6);     /* FUNC_SEL 1 (mi2s2), DRV 8 mA, no pull */
+	}
+	say("PRM clock up, I2S pins 121..124 to function 1 (ctl %#x %#x %#x %#x at %#lx)",
+	    *(volatile uint32_t *)(tlmm + I2S_PIN(121)), *(volatile uint32_t *)(tlmm + I2S_PIN(122)),
+	    *(volatile uint32_t *)(tlmm + I2S_PIN(123)), *(volatile uint32_t *)(tlmm + I2S_PIN(124)),
+	    TLMM_PHYS + TLMM_PIN(I2S_PIN_FIRST));
+	return true;
+}
+
+/* ==== step 13: graph open/prepare ==== */
+
+/* One sub-graph config block (apm_sub_graph_data in audioreach.c): 3 props. */
+struct sg_block {
+	uint32_t sub_graph_id, num_prop;
+	uint32_t perf_pid, perf_size, perf_mode;
+	uint32_t dir_pid, dir_size, dir;
+	uint32_t sid_pid, sid_size, sid;
+} __attribute__((packed));
+
+struct prop_hdr { uint32_t pid, size; } __attribute__((packed));
+
+static void
+fill_sg(struct sg_block *b, uint32_t id, uint32_t dir)
+{
+	b->sub_graph_id = id;
+	b->num_prop = 3;
+	b->perf_pid = APM_SG_PROP_ID_PERF_MODE;
+	b->perf_size = 4;
+	b->perf_mode = APM_SG_PERF_LOW_LATENCY;
+	b->dir_pid = APM_SG_PROP_ID_DIRECTION;
+	b->dir_size = 4;
+	b->dir = dir;
+	b->sid_pid = APM_SG_PROP_ID_SCENARIO_ID;
+	b->sid_size = 4;
+	b->sid = APM_SG_SID_PLAYBACK;
+}
+
+struct cont_block {
+	uint32_t container_id, num_prop;
+	uint32_t cap_pid, cap_size, num_cap, cap;
+	uint32_t pos_pid, pos_size, pos;
+	uint32_t stack_pid, stack_size, stack;
+	uint32_t dom_pid, dom_size, dom;
+} __attribute__((packed));
+
+static void
+fill_cont(struct cont_block *c, uint32_t id, uint32_t cap, uint32_t pos)
+{
+	c->container_id = id;
+	c->num_prop = 4;
+	c->cap_pid = APM_CONT_PROP_ID_CAPABILITY_LIST;
+	c->cap_size = 8;
+	c->num_cap = 1;
+	c->cap = cap;
+	c->pos_pid = APM_CONT_PROP_ID_GRAPH_POS;
+	c->pos_size = 4;
+	c->pos = pos;
+	c->stack_pid = APM_CONT_PROP_ID_STACK_SIZE;
+	c->stack_size = 4;
+	c->stack = graph_0243 ? 4096 : 8192;
+	c->dom_pid = APM_CONT_PROP_ID_PROC_DOMAIN;
+	c->dom_size = 4;
+	c->dom = APM_PROC_DOMAIN_ADSP;
+}
+
+struct mod_obj { uint32_t module_id, instance_id; } __attribute__((packed));
+struct conn_obj { uint32_t src_iid, src_op, dst_iid, dst_ip; } __attribute__((packed));
+struct mprop_obj {
+	uint32_t instance_id, num_props;
+	uint32_t pid, size, max_ip, max_op;
+} __attribute__((packed));
+
+/*
+ * GRAPH_OPEN: one apm_cmd_hdr, then 5 params (SUB_GRAPH_CONFIG, CONTAINER_CONFIG, MODULE_LIST,
+ * MODULE_PROP, MODULE_CONN), each an apm_param + its body (each param body 8-aligned). Two
+ * sub-graphs (stream, device), two containers, four modules, three connections.
+ */
+static uint8_t graph_pkt[1024] __attribute__((aligned(8)));
+
+static uint8_t *
+put32(uint8_t *p, uint32_t v)
+{
+	memcpy(p, &v, 4);
+	return p + 4;
+}
+static uint8_t *
+putobj(uint8_t *p, const void *o, uint32_t n)
+{
+	memcpy(p, o, n);
+	return p + n;
+}
+
+static uint32_t
+build_graph_open(void)
+{
+	uint8_t *p = graph_pkt, *start;
+	struct gpr_hdr hdr;
+	struct apm_cmd_hdr cmd;
+	struct apm_param pr;
+	uint32_t off;
+
+	bzero(graph_pkt, sizeof(graph_pkt));
+	p += sizeof(struct gpr_hdr) + sizeof(struct apm_cmd_hdr);
+
+	/* 1. SUB_GRAPH_CONFIG: num + 2 sg blocks */
+	{
+		struct sg_block sg;
+		uint32_t bodysz = 4 + 2 * sizeof(sg);
+		bzero(&pr, sizeof(pr));
+		pr.miid = APM_MODULE_INSTANCE_ID; pr.pid = APM_PARAM_ID_SUB_GRAPH_CONFIG; pr.size = (bodysz + 7) & ~7u;
+		p = putobj(p, &pr, sizeof(pr));
+		p = put32(p, 2);
+		fill_sg(&sg, SG_STREAM, APM_SG_DIR_RX); p = putobj(p, &sg, sizeof(sg));
+		fill_sg(&sg, SG_DEVICE, graph_0243 ? APM_SG_DIR_RX : APM_SG_DIR_TX); p = putobj(p, &sg, sizeof(sg));
+		p = graph_pkt + ((p - graph_pkt + 7) & ~7u);
+	}
+	/* 2. CONTAINER_CONFIG: num + 2 containers */
+	{
+		struct cont_block c;
+		uint32_t bodysz = 4 + 2 * sizeof(c);
+		bzero(&pr, sizeof(pr));
+		pr.miid = APM_MODULE_INSTANCE_ID; pr.pid = APM_PARAM_ID_CONTAINER_CONFIG; pr.size = (bodysz + 7) & ~7u;
+		p = putobj(p, &pr, sizeof(pr));
+		p = put32(p, 2);
+		fill_cont(&c, CONT_STREAM, graph_0243 ? APM_CONT_CAP_PP : APM_CONT_CAP_CD, APM_CONT_GRAPH_POS_STREAM);
+		p = putobj(p, &c, sizeof(c));
+		fill_cont(&c, CONT_DEVICE, APM_CONT_CAP_EP, graph_0243 ? APM_CONT_GRAPH_POS_STR_DEV : APM_CONT_GRAPH_POS_STREAM);
+		p = putobj(p, &c, sizeof(c));
+		p = graph_pkt + ((p - graph_pkt + 7) & ~7u);
+	}
+	/* 3. MODULE_LIST: num lists; list = {sg, cont, nmod} + mod_obj[] */
+	{
+		struct mod_obj mo;
+		start = p;
+		bzero(&pr, sizeof(pr));
+		pr.miid = APM_MODULE_INSTANCE_ID; pr.pid = APM_PARAM_ID_MODULE_LIST; pr.size = 0;   /* patched below */
+		p = putobj(p, &pr, sizeof(pr));
+		p = put32(p, 2);                                /* num lists */
+		p = put32(p, SG_STREAM); p = put32(p, CONT_STREAM); p = put32(p, 2);
+		mo.module_id = MODULE_ID_WR_SH_MEM_EP; mo.instance_id = IID_WR_EP; p = putobj(p, &mo, sizeof(mo));
+		mo.module_id = MODULE_ID_PCM_CNV; mo.instance_id = IID_PCM; p = putobj(p, &mo, sizeof(mo));
+		p = put32(p, SG_DEVICE); p = put32(p, CONT_DEVICE); p = put32(p, 2);
+		mo.module_id = MODULE_ID_MFC; mo.instance_id = IID_MFC; p = putobj(p, &mo, sizeof(mo));
+		mo.module_id = MODULE_ID_I2S_SINK; mo.instance_id = IID_I2S; p = putobj(p, &mo, sizeof(mo));
+		p = graph_pkt + ((p - graph_pkt + 7) & ~7u);
+		pr.size = (uint32_t)(p - start - sizeof(pr));
+		memcpy(start, &pr, sizeof(pr));
+	}
+	/* 4. MODULE_PROP: num + 4 mprop objs */
+	{
+		static const uint32_t ids[4] = { IID_WR_EP, IID_PCM, IID_MFC, IID_I2S };
+		static const uint32_t ipo[4][2] = { {0,1}, {1,1}, {1,1}, {1,0} };
+		struct mprop_obj m;
+		uint32_t bodysz = 4 + 4 * sizeof(m);
+		bzero(&pr, sizeof(pr));
+		pr.miid = APM_MODULE_INSTANCE_ID; pr.pid = APM_PARAM_ID_MODULE_PROP; pr.size = (bodysz + 7) & ~7u;
+		p = putobj(p, &pr, sizeof(pr));
+		p = put32(p, 4);
+		for (unsigned i = 0; i < 4; i++) {
+			bzero(&m, sizeof(m));
+			m.instance_id = ids[i]; m.num_props = 1; m.pid = 0x08001015u; m.size = 8;
+			m.max_ip = ipo[i][0]; m.max_op = ipo[i][1];
+			p = putobj(p, &m, sizeof(m));
+		}
+		p = graph_pkt + ((p - graph_pkt + 7) & ~7u);
+	}
+	/* 5. MODULE_CONN: num + 3 conns */
+	{
+		struct conn_obj c;
+		uint32_t bodysz = 4 + 3 * sizeof(c);
+		bzero(&pr, sizeof(pr));
+		pr.miid = APM_MODULE_INSTANCE_ID; pr.pid = APM_PARAM_ID_MODULE_CONN; pr.size = (bodysz + 7) & ~7u;
+		p = putobj(p, &pr, sizeof(pr));
+		p = put32(p, 3);
+		c.src_iid = IID_WR_EP; c.src_op = PORT_WR_EP_OUT; c.dst_iid = IID_PCM; c.dst_ip = PORT_PCM_IN; p = putobj(p, &c, sizeof(c));
+		c.src_iid = IID_PCM; c.src_op = PORT_PCM_OUT; c.dst_iid = IID_MFC; c.dst_ip = PORT_MFC_IN; p = putobj(p, &c, sizeof(c));
+		c.src_iid = IID_MFC; c.src_op = PORT_MFC_OUT; c.dst_iid = IID_I2S; c.dst_ip = PORT_I2S_IN; p = putobj(p, &c, sizeof(c));
+		p = graph_pkt + ((p - graph_pkt + 7) & ~7u);
+	}
+	off = (uint32_t)(p - graph_pkt);
+	gpr_build_hdr(&hdr, off, GPR_PORT_APM, GPR_APM_IID, APM_CMD_GRAPH_OPEN);
+	memcpy(graph_pkt, &hdr, sizeof(hdr));
+	bzero(&cmd, sizeof(cmd));
+	cmd.size = off - sizeof(struct gpr_hdr) - sizeof(struct apm_cmd_hdr);
+	memcpy(graph_pkt + sizeof(struct gpr_hdr), &cmd, sizeof(cmd));
+	return off;
+}
+
+/* one SET_CFG param packet to a module instance; body copied from `body`, bodysz bytes. */
+static int set_cfg_to(uint32_t dst_port, uint32_t src_port, uint32_t iid, uint32_t pid, const void *body, uint32_t bodysz);
+static int
+set_cfg(uint32_t iid, uint32_t pid, const void *body, uint32_t bodysz)
+{
+	return set_cfg_to(GPR_PORT_APM, GPR_APM_IID, iid, pid, body, bodysz);
+}
+
+static int
+set_cfg_to(uint32_t dst_port, uint32_t src_port, uint32_t iid, uint32_t pid, const void *body, uint32_t bodysz)
+{
+	uint8_t pkt[256] __attribute__((aligned(8)));
+	struct gpr_hdr *hdr = (void *)pkt;
+	struct apm_cmd_hdr *cmd = (void *)(pkt + sizeof(*hdr));
+	struct apm_param *pr = (void *)(pkt + sizeof(*hdr) + sizeof(*cmd));
+	uint32_t plen = sizeof(*hdr) + sizeof(*cmd) + sizeof(*pr) + ((bodysz + 7) & ~7u);
+	uint32_t status = ~0u;
+
+	if (plen > sizeof(pkt)) {
+		return EINVAL;
+	}
+	bzero(pkt, plen);
+	gpr_build_hdr(hdr, plen, dst_port, src_port, APM_CMD_SET_CFG);
+	cmd->size = plen - sizeof(*hdr) - sizeof(*cmd);
+	pr->miid = iid;
+	pr->pid = pid;
+	pr->size = (bodysz + 7) & ~7u;
+	memcpy(pkt + sizeof(*hdr) + sizeof(*cmd) + sizeof(*pr), body, bodysz);
+	if (gpr_send_wait(pkt, plen, 0, &status) != 0 || status != 0) {
+		FAIL("SET_CFG iid %#x pid %#x failed (status %#x)", iid, pid, status);
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+graph_mgmt(uint32_t opcode)
+{
+	struct {
+		struct gpr_hdr hdr;
+		struct apm_cmd_hdr cmd;
+		struct apm_param p;
+		uint32_t num_sg;
+		uint32_t sg[2];
+	} __attribute__((packed)) pkt;
+	uint32_t status = ~0u;
+
+	bzero(&pkt, sizeof(pkt));
+	gpr_build_hdr(&pkt.hdr, sizeof(pkt), GPR_PORT_APM, GPR_APM_IID, opcode);
+	pkt.cmd.size = sizeof(pkt) - sizeof(pkt.hdr) - sizeof(pkt.cmd);
+	pkt.p.miid = APM_MODULE_INSTANCE_ID;
+	pkt.p.pid = APM_PARAM_ID_SUB_GRAPH_LIST;
+	pkt.p.size = sizeof(pkt.num_sg) + sizeof(pkt.sg);
+	pkt.num_sg = 2;
+	pkt.sg[0] = SG_STREAM;
+	pkt.sg[1] = SG_DEVICE;
+	if (gpr_send_wait(&pkt, sizeof(pkt), 0, &status) != 0 || status != 0) {
+		FAIL("graph mgmt %#x failed (status %#x)", opcode, status);
+		return EIO;
+	}
+	return 0;
+}
+
+static bool
+step_graph(void)
+{
+	uint32_t len, status = ~0u;
+
+	(void)PE_parse_boot_argn("negroniaudio_graph", &graph_0243, sizeof(graph_0243));
+	say("graph values: %s", graph_0243 ? "0243 (negroniaudio_graph=1)" :
+	    "mainline topology (stream cap CD, device dir TX, pos STREAM, stacks 8192, WR EP format to its port)");
+	announce_note("APM: GRAPH_OPEN (WR_SH_MEM_EP -> PCM_CNV -> MFC -> I2S_SINK)");
+	len = build_graph_open();
+	if (gpr_send_wait(graph_pkt, len, 0, &status) != 0 || status != 0) {
+		FAIL("GRAPH_OPEN failed (status %#x, %u bytes)", status, len);
+		return false;
+	}
+	graph_opened = true;
+	say("GRAPH_OPEN ok (%u bytes)", len);
+
+	/* PCM_CNV output: 24-bit S24, stereo, L R */
+	{
+		struct { uint32_t data_format, fmt_id, payload_size;
+			uint16_t bit_width, alignment, bits_per_sample, q_factor, endianness, interleaved, reserved, num_channels;
+			uint8_t ch[2]; } __attribute__((packed)) o = { 0 };
+		o.data_format = DATA_FORMAT_FIXED_POINT;
+		o.fmt_id = MEDIA_FMT_ID_PCM;
+		o.payload_size = sizeof(o) - 12;
+		o.bit_width = 24; o.alignment = PCM_LSB_ALIGNED; o.bits_per_sample = 32; o.q_factor = 23;
+		o.endianness = PCM_LITTLE_ENDIAN; o.interleaved = 1; o.num_channels = 2;
+		o.ch[0] = PCM_CHANNEL_L; o.ch[1] = PCM_CHANNEL_R;
+		if (set_cfg(IID_PCM, PARAM_ID_PCM_OUTPUT_FORMAT_CFG, &o, sizeof(o))) {
+			return false;
+		}
+	}
+	/* MFC output: 48 kHz, 24-bit, 2 ch */
+	{
+		struct { uint32_t sample_rate; uint16_t bit_width, num_channels, ch[2]; } __attribute__((packed)) m = { 0 };
+		m.sample_rate = 48000; m.bit_width = 24; m.num_channels = 2;
+		m.ch[0] = PCM_CHANNEL_L; m.ch[1] = PCM_CHANNEL_R;
+		if (set_cfg(IID_MFC, PARAM_ID_MFC_OUTPUT_MEDIA_FORMAT, &m, sizeof(m))) {
+			return false;
+		}
+	}
+	/* I2S sink: TERTIARY, SD1, internal WS */
+	{
+		struct { uint32_t lpaif_type, intf_idx; uint16_t sd_line_idx, ws_src; } __attribute__((packed)) i = { 0 };
+		i.lpaif_type = 0; i.intf_idx = I2S_INTF_TERTIARY; i.sd_line_idx = I2S_SD1; i.ws_src = I2S_WS_SRC_INTERNAL;
+		if (set_cfg(IID_I2S, PARAM_ID_I2S_INTF_CFG, &i, sizeof(i))) {
+			return false;
+		}
+		struct { uint32_t sample_rate; uint16_t bit_width, num_channels; uint32_t data_format; } __attribute__((packed)) hw = { 0 };
+		hw.sample_rate = 48000; hw.bit_width = 24; hw.num_channels = 2; hw.data_format = DATA_FORMAT_FIXED_POINT;
+		if (set_cfg(IID_I2S, PARAM_ID_HW_EP_MF_CFG, &hw, sizeof(hw))) {
+			return false;
+		}
+		uint32_t fsf = 1;
+		if (set_cfg(IID_I2S, PARAM_ID_HW_EP_FRAME_SIZE_FACTOR, &fsf, sizeof(fsf))) {
+			return false;
+		}
+	}
+	if (graph_mgmt(APM_CMD_GRAPH_PREPARE)) {
+		return false;
+	}
+	say("GRAPH SET_CFG and PREPARE ok");
+	return true;
+}
+
+/* ==== step 14: shared memory + WR EP media format + START ==== */
+
+/* 0249: apps-SMMU SID 0x1801 -> our ring at AUDIO_IOVA through a stage-1 context of ours (as hackios
+ * redwood_sound.c space_on and Android msm_audio_ion.c). With negroniaudio_smmu=0 the 0243 path: the
+ * physical address with the SID bit (needs RAM below 4 GiB: not on this port). On a failure step 14
+ * stops cleanly and audio stays off. */
+static bool
+smmu_setup(void)
+{
+	bzero((void *)ring, round_page(RING_BYTES));
+	clean_dcache(ring, round_page(RING_BYTES), FALSE);
+	if (audio_smmu_policy != 0) {
+		if (smmu_on) {
+			return true;            /* the context and the ring mapping stay for the boot */
+		}
+		if (negroni_s1_on(&audio_s1) != 0) {
+			FAIL("no apps-SMMU stage-1 context for SID %#x (see the SMMU lines above)", AUDIO_SID);
+			return false;
+		}
+		if (negroni_s1_map_kva(&audio_s1, AUDIO_IOVA, ring, round_page(RING_BYTES)) != 0) {
+			negroni_s1_off(&audio_s1);
+			FAIL("ring map at IOVA %#llx failed", AUDIO_IOVA);
+			return false;
+		}
+		ring_iova = AUDIO_IOVA | ((uint64_t)(AUDIO_SID & 0xf) << 32);
+		smmu_on = true;
+		say("ring %u bytes at phys %#llx -> ADSP address %#llx (SMMU stage 1, SID %#x)", RING_BYTES, kvtophys(ring),
+		    ring_iova, AUDIO_SID);
+		return true;
+	}
+	/* a single-piece physical buffer so an untranslated SID sees it as one region */
+	if (kvtophys(ring) + RING_BYTES > 0x100000000ull) {
+		FAIL("ring at phys %#llx is not below 4 GiB (the SID bits go in addr_msw)", kvtophys(ring));
+		return false;
+	}
+	for (uint32_t off = 0x1000; off < RING_BYTES; off += 0x1000) {
+		if (kvtophys(ring + off) != kvtophys(ring) + off) {
+			FAIL("ring is not physically contiguous: the SMMU would have to translate (not implemented here)");
+			return false;
+		}
+	}
+	ring_iova = kvtophys(ring) | ((uint64_t)(AUDIO_SID & 0xf) << 32);
+	smmu_on = true;                         /* nothing programmed: untranslated path */
+	return true;
+}
+
+static int
+shmem_map(void)
+{
+	struct {
+		struct gpr_hdr hdr;
+		uint16_t pool, nregions;
+		uint32_t flags;
+		uint32_t addr_lsw, addr_msw, size;
+	} __attribute__((packed)) pkt;
+	uint32_t status = ~0u;
+
+	bzero(&pkt, sizeof(pkt));
+	gpr_build_hdr(&pkt.hdr, sizeof(pkt), GPR_PORT_APM, GPR_APM_IID, APM_CMD_SHARED_MEM_MAP);
+	pkt.pool = MEM_POOL_SHMEM8_4K;
+	pkt.nregions = 1;
+	pkt.flags = 0;
+	pkt.addr_lsw = (uint32_t)ring_iova;
+	pkt.addr_msw = (uint32_t)(ring_iova >> 32);
+	pkt.size = RING_BYTES;
+	mem_map_handle = 0;
+	if (gpr_send_wait(&pkt, sizeof(pkt), APM_RSP_SHARED_MEM_MAP, &status) != 0 || mem_map_handle == 0) {
+		FAIL("SHARED_MEM_MAP_REGIONS gave no handle");
+		return EIO;
+	}
+	say("shared memory mapped: handle %#x, ring IOVA %#llx, %u bytes", mem_map_handle, ring_iova, RING_BYTES);
+	return 0;
+}
+
+static bool
+step_shmem(void)
+{
+	announce_note("APM: map our ring, set the WR EP media format, START");
+	if (ring == 0) {
+		/* 0249: one physical piece anywhere (0243 asked for < 4 GiB: impossible here); the SMMU gives the
+		 * ADSP its 32-bit view (smmu_setup) */
+		(void)PE_parse_boot_argn("negroniaudio_smmu", &audio_smmu_policy, sizeof(audio_smmu_policy));
+		if (kmem_alloc_contig(kernel_map, &ring, round_page(RING_BYTES), 0, 0, 0,
+		    KMA_KOBJECT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			ring = 0;
+			FAIL("no memory for the ring");
+			return false;
+		}
+	}
+	lck_mtx_lock(&negroni_smmu_lock);
+	bool ok = smmu_setup();
+	lck_mtx_unlock(&negroni_smmu_lock);
+	if (!ok) {
+		return false;
+	}
+	if (shmem_map()) {
+		return false;
+	}
+	/* WR EP media format: S24 in 32-bit, 48 kHz, stereo */
+	{
+		struct { uint32_t data_format, fmt_id, payload_size, sample_rate;
+			uint16_t bit_width, alignment, bits_per_sample, q_factor, endianness, num_channels;
+			uint8_t ch[2]; } __attribute__((packed)) f = { 0 };
+		f.data_format = DATA_FORMAT_FIXED_POINT;
+		f.fmt_id = MEDIA_FMT_ID_PCM;
+		f.payload_size = sizeof(f) - 12;
+		f.sample_rate = 48000; f.bit_width = 24; f.alignment = PCM_LSB_ALIGNED;
+		f.bits_per_sample = 32; f.q_factor = 23; f.endianness = PCM_LITTLE_ENDIAN; f.num_channels = 2;
+		f.ch[0] = PCM_CHANNEL_L; f.ch[1] = PCM_CHANNEL_R;
+		if (graph_0243 ? set_cfg(IID_WR_EP, PARAM_ID_MEDIA_FORMAT, &f, sizeof(f)) :
+		    set_cfg_to(IID_WR_EP, GPR_SRC_PORT, IID_WR_EP, PARAM_ID_MEDIA_FORMAT, &f, sizeof(f))) {
+			return false;
+		}
+	}
+	if (graph_mgmt(APM_CMD_GRAPH_START)) {
+		return false;
+	}
+	graph_started = true;
+	say("GRAPH STARTED");
+	return true;
+}
+
+/* ==== step 15: /dev/negroni-audio ==== */
+
+#include "negroni_audio_abi.h"
+
+static uint8_t *ring_bytes(void) { return (uint8_t *)ring; }
+static uint32_t ring_head;                      /* period being filled (0..PERIODS-1) */
+static uint32_t fill_frames;                    /* frames already in the period at ring_head */
+static uint64_t periods_sent;                   /* DATA buffers given to the WR EP (under audio_lock) */
+static uint32_t busy_drops;                     /* consecutive periods dropped as "all in flight" */
+static bool rebase_logged;
+static uint64_t frames_in, frames_dropped, frames_played;       /* under audio_lock */
+/*
+ * SET_VOLUME (0244): `below` (1/8 dB) and `muted` go to the guard; the guard's cap is the 0 dB of
+ * the HAL volume. iOS keeps the D22 speaker in software volume, so the plug-in sends 0 dB normally.
+ */
+static uint32_t volume_below, muted;
+static lck_mtx_t *audio_lock;
+static lck_grp_t *audio_grp;
+static lck_mtx_t *feed_lock;                    /* one feeder at a time (write(), the tone): guard + ring */
+
+/* ==== 0244: the guard and the amps ==== */
+#define SILENCE_PEAK            16u              /* |sample| <= 16 of 32768 (-66 dBFS) is silence */
+#define SILENCE_STOP_MS         3000u
+static uint32_t cap_db = 20;                    /* negroniaudio_capdb: the loudest sample, dB under full scale */
+static uint32_t audio_route = NEGRONI_TFA_ROUTE_SPEAKER;
+static volatile uint64_t last_sound;            /* mach_absolute_time of the last non-silent block */
+static uint64_t amp_retry_at;                   /* no new start attempt before (after a failed one) */
+static bool amps_probed, watch_started;
+static uint32_t amp_starts_ok, amp_starts_failed;
+
+static uint64_t
+ms_to_abs(uint32_t ms)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &t);
+	return t;
+}
+
+/* Start the amps for the current route if sound comes and they are off (feeder thread, no lock). */
+static void
+amps_on_sound(void)
+{
+	uint64_t now = mach_absolute_time();
+	int rc;
+
+	last_sound = now;
+	if (!amps_probed || negroni_tfa_playing() || !negroni_tfa_ready() || now < amp_retry_at) {
+		return;
+	}
+	rc = negroni_tfa_start(audio_route);
+	if (rc == 0) {
+		amp_starts_ok++;
+		ng_guard_ramp();
+		say("amps on (%s), guard cap -%u dBFS, clip monitor -%u/8 dB, start %u", audio_route == NEGRONI_TFA_ROUTE_RECEIVER ?
+		    "earpiece" : "speaker", ng_guard_cap_db(), ng_guard_monitor(), amp_starts_ok);
+	} else {
+		amp_starts_failed++;
+		amp_retry_at = now + ms_to_abs(2000);
+		if (amp_starts_failed <= 8) {
+			say("amp start failed (%d), next try in 2 s (%u failures)", rc, amp_starts_failed);
+		}
+	}
+}
+
+/* every 500 ms: the silence timer, every 1 s the amps' status (fault stop, clip monitor) */
+static void
+amp_watch(__unused void *arg, __unused wait_result_t wr)
+{
+	for (uint32_t tick = 0;; tick++) {
+		IOSleep(500);
+		if (!negroni_tfa_playing()) {
+			continue;
+		}
+		if (mach_absolute_time() - last_sound > ms_to_abs(SILENCE_STOP_MS)) {
+			negroni_tfa_stop("3 s of silence");
+			continue;
+		}
+		if (tick & 1) {
+			int rc = negroni_tfa_check(tick % 20 == 1);    /* a status line every 10 s */
+			if (rc == EAGAIN) {
+				ng_guard_monitor_add(8);
+				say("amp reports clipping: guard 1 dB lower (now -%u/8 dB)", ng_guard_monitor());
+			}
+		}
+	}
+}
+
+/* step 15 with negroniaudio_amp=1: probe (reset, revision, table); amps start on sound */
+static void
+amps_setup(void)
+{
+	thread_t th;
+
+	if (!negroni_tfa_wanted()) {
+		say("amps: negroniaudio_amp=0: no amp init (the I2S data reaches amps in power-down: silence)");
+		return;
+	}
+	if (negroni_tfa_probe() != 0) {
+		say("amps: probe failed: no sound (the sink still runs)");
+		return;
+	}
+	amps_probed = true;
+	if (!watch_started && kernel_thread_start(amp_watch, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+		watch_started = true;
+	}
+}
+
+/* send one period (PERIOD_BYTES at period index) to the WR EP as a DATA buffer */
+/*
+ * negroniaudio_v2=1: DATA_CMD_WR_SH_MEM_EP_DATA_BUFFER_V2 0x0400100A (11 words, metadata fields 0;
+ * DONE 0x05001004), as current Linux q6apm.c and the phone's GSL send. Default 0: V1 0x04001000
+ * (7 words, DONE 0x05001000). If step 15 shows no DONE, try V2 first.
+ */
+static uint32_t data_v2;
+
+static int
+send_period(uint32_t idx)
+{
+	struct {
+		struct gpr_hdr hdr;
+		uint32_t addr_lsw, addr_msw, handle, size, ts_lsw, ts_msw, flags;
+		uint32_t md_addr_lsw, md_addr_msw, md_handle, md_size;          /* V2 only */
+	} __attribute__((packed)) pkt;
+	uint64_t pa = ring_iova + (uint64_t)idx * PERIOD_BYTES;
+	uint32_t len = data_v2 ? sizeof(pkt) : sizeof(pkt) - 16;
+
+	bzero(&pkt, sizeof(pkt));
+	/* from our dynamic port to the WR EP module instance (q6apm_write_async: dst = shm iid) */
+	gpr_build_hdr(&pkt.hdr, len, IID_WR_EP, GPR_SRC_PORT,
+	    data_v2 ? DATA_CMD_WR_SH_MEM_EP_DATA_BUFFER_V2 : DATA_CMD_WR_SH_MEM_EP_DATA_BUFFER);
+	pkt.hdr.token = idx;
+	pkt.addr_lsw = (uint32_t)pa;
+	pkt.addr_msw = (uint32_t)(pa >> 32);
+	pkt.handle = mem_map_handle;
+	pkt.size = PERIOD_BYTES;
+	return negroni_glink_send(NEGRONI_GLINK_GPR, &pkt, len);
+}
+
+/*
+ * write(): whole S16LE stereo frames (the HAL writer sends ~240 frames every ~5 ms, not whole
+ * periods). Each frame goes as S24-in-32-bit into the period at ring_head; a full period is
+ * cleaned to the point of coherency (LPASS does not snoop our cache) and sent to the WR EP.
+ * In-flight periods = periods_sent - DONE events (write_done_count, counted by gpr_rx when
+ * negroni_glink_poll() runs here); with PERIODS - 1 in flight the new period is dropped and its
+ * slot reused, so a period the ADSP still reads is never overwritten.
+ * This call can block the writer thread for up to ~1.2 s inside negroni_glink_send (an intent
+ * request or a full GLINK FIFO); it never blocks the HAL real-time thread (the plug-in's writer
+ * thread calls it). audio_lock serializes writers; it is not held across GLINK calls (gpr_rx runs
+ * under the GLINK lock).
+ */
+/* one frame (already through the guard, Q23) into the ring; a full period goes to the WR EP */
+static void
+sink_put(const int32_t q[2])
+{
+	int32_t *out;
+	uint32_t idx;
+	bool full, busy;
+
+	{
+		lck_mtx_lock(audio_lock);
+		idx = ring_head;
+		out = (int32_t *)(void *)(ring_bytes() + (uint64_t)idx * PERIOD_BYTES);
+		out[fill_frames * 2 + 0] = q[0];
+		out[fill_frames * 2 + 1] = q[1];
+		fill_frames++;
+		frames_in++;
+		full = fill_frames == PERIOD_FRAMES;
+		lck_mtx_unlock(audio_lock);
+		if (!full) {
+			return;
+		}
+		negroni_glink_poll();                   /* take the DONE events (and RX_DONEs for our TX intents) */
+		lck_mtx_lock(audio_lock);
+		fill_frames = 0;
+		{
+			uint64_t done = os_atomic_load(&write_done_count, relaxed);
+			/*
+			 * A spurious extra DONE (done > sent) or lost DONEs (busy for 2 * PERIODS periods in
+			 * a row: 0.32 s of no progress) would stop the writer for good: re-base the count.
+			 */
+			if (done > periods_sent || busy_drops >= 2 * PERIODS) {
+				if (!rebase_logged) {
+					rebase_logged = true;
+					say("sink: DONE count re-based (sent %llu, done %llu, %u busy drops); logged once",
+					    periods_sent, done, busy_drops);
+				}
+				periods_sent = done;
+				busy_drops = 0;
+			}
+			busy = periods_sent - done >= PERIODS - 1;
+		}
+		if (busy) {
+			busy_drops++;
+			frames_dropped += PERIOD_FRAMES;        /* keep ring_head: the slot is filled again */
+			lck_mtx_unlock(audio_lock);
+			return;
+		}
+		busy_drops = 0;
+		clean_dcache((vm_offset_t)out, PERIOD_BYTES, FALSE);
+		ring_head = (ring_head + 1) % PERIODS;
+		periods_sent++;
+		lck_mtx_unlock(audio_lock);
+		int sent = send_period(idx);
+		lck_mtx_lock(audio_lock);
+		if (sent == 0) {
+			frames_played += PERIOD_FRAMES;
+		} else {
+			frames_dropped += PERIOD_FRAMES;
+			periods_sent--;                 /* no DONE will come for it */
+		}
+		lck_mtx_unlock(audio_lock);
+	}
+}
+
+/* n <= NG_GUARD_MAX_FRAMES S16 stereo frames: amps on sound, the guard, the ring (feed_lock held) */
+static void
+sink_feed(const int16_t *fr, uint32_t n)
+{
+	int32_t q[2 * NG_GUARD_MAX_FRAMES];
+	uint32_t peak = 0;
+
+	for (uint32_t i = 0; i < 2 * n; i++) {
+		uint32_t a = (uint32_t)(fr[i] < 0 ? -fr[i] : fr[i]);
+		peak = MAX(peak, a);
+	}
+	if (peak > SILENCE_PEAK && !muted) {
+		amps_on_sound();                        /* may take ~100 ms the first time (bit-banged I2C) */
+	}
+	(void)ng_guard_process(fr, q, n, audio_route == NEGRONI_TFA_ROUTE_RECEIVER);
+	for (uint32_t i = 0; i < n; i++) {
+		sink_put(&q[2 * i]);
+	}
+}
+
+/*
+ * 0246: the earpiece. NEGRONI_TFA_ROUTE_* = NEGRONI_AUDIO_ROUTE_* (1 speaker, 2 receiver). The amps
+ * stop on a change; the next sound starts the new route (with the guard's 20 ms ramp).
+ */
+_Static_assert(NEGRONI_AUDIO_ROUTE_SPEAKER == NEGRONI_TFA_ROUTE_SPEAKER &&
+    NEGRONI_AUDIO_ROUTE_RECEIVER == NEGRONI_TFA_ROUTE_RECEIVER, "route numbers");
+static int
+route_set(uint32_t r)
+{
+	if (r != NEGRONI_AUDIO_ROUTE_SPEAKER && r != NEGRONI_AUDIO_ROUTE_RECEIVER) {
+		return EINVAL;
+	}
+	if (feed_lock == NULL) {
+		audio_route = r;
+		return 0;
+	}
+	lck_mtx_lock(feed_lock);
+	if (r != audio_route) {
+		audio_route = r;
+		say("route: %s", r == NEGRONI_AUDIO_ROUTE_RECEIVER ? "earpiece (0x34, profile receiver)" : "speaker (both amps)");
+		if (negroni_tfa_playing()) {
+			negroni_tfa_stop("route change");
+		}
+	}
+	lck_mtx_unlock(feed_lock);
+	return 0;
+}
+
+static int
+audio_write(dev_t dev, struct uio *uio, int ioflag)
+{
+	(void)dev; (void)ioflag;
+	int16_t fr[2 * NG_GUARD_MAX_FRAMES];
+	int err = 0;
+
+	if (!sink_on || !graph_started) {
+		return ENODEV;
+	}
+	lck_mtx_lock(feed_lock);
+	while (uio_resid(uio) >= (user_ssize_t)4) {
+		uint32_t n = (uint32_t)MIN(uio_resid(uio) / 4, (user_ssize_t)NG_GUARD_MAX_FRAMES);
+
+		err = uiomove((caddr_t)fr, (int)(n * 4), uio);
+		if (err) {
+			break;
+		}
+		sink_feed(fr, n);
+	}
+	lck_mtx_unlock(feed_lock);
+	return err;
+}
+
+static int
+audio_open(dev_t dev, int flags, int devtype, struct proc *p)
+{
+	(void)dev; (void)flags; (void)devtype; (void)p;
+	return sink_on ? 0 : ENODEV;
+}
+static int
+audio_close(dev_t dev, int flags, int devtype, struct proc *p)
+{
+	(void)dev; (void)flags; (void)devtype; (void)p;
+	return 0;
+}
+static int
+audio_ioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	(void)dev; (void)flag; (void)p;
+	switch (cmd) {
+	case NEGRONI_AUDIO_SET_VOLUME: {
+		struct negroni_audio_volume *v = (void *)data;
+		volume_below = v->below;
+		muted = v->muted;
+		ng_guard_volume(volume_below, muted);
+		return 0;
+	}
+	case NEGRONI_AUDIO_SET_ROUTE: {
+		uint32_t r = *(uint32_t *)(void *)data;
+		return route_set(r);
+	}
+	case NEGRONI_AUDIO_GET_STATS: {
+		struct negroni_audio_stats *st = (void *)data;
+		bzero(st, sizeof(*st));
+		lck_mtx_lock(audio_lock);
+		st->frames_in = frames_in;
+		st->frames_dropped = frames_dropped;
+		st->frames_played = frames_played;
+		st->state = !sink_on ? NEGRONI_AUDIO_STATE_NOSINK : graph_started ? NEGRONI_AUDIO_STATE_RUNNING :
+		    NEGRONI_AUDIO_STATE_IDLE;
+		lck_mtx_unlock(audio_lock);
+		ng_guard_stats(&st->peak_in, &st->peak_out, &st->limiter_gain_q15);
+		return 0;
+	}
+	default:
+		return ENOTTY;
+	}
+}
+
+static const struct cdevsw audio_cdevsw = {
+	.d_open = audio_open,
+	.d_close = audio_close,
+	.d_read = eno_rdwrt,
+	.d_write = audio_write,
+	.d_ioctl = audio_ioctl,
+	.d_stop = eno_stop,
+	.d_reset = eno_reset,
+	.d_ttys = NULL,
+	.d_select = eno_select,
+	.d_mmap = eno_mmap,
+	.d_strategy = eno_strat,
+	.d_type = 0,
+};
+static int audio_major = -1;
+
+void
+negroni_audio_init(void)
+{
+	if (audio_major >= 0) {
+		return;
+	}
+	audio_grp = lck_grp_alloc_init("negroni_audio", LCK_GRP_ATTR_NULL);
+	audio_lock = lck_mtx_alloc_init(audio_grp, LCK_ATTR_NULL);
+	feed_lock = lck_mtx_alloc_init(audio_grp, LCK_ATTR_NULL);
+	audio_major = cdevsw_add(-1, &audio_cdevsw);
+	if (audio_major < 0) {
+		printf("NEGRONI AUDIO: cdevsw_add failed\n");
+		return;
+	}
+	devfs_make_node(makedev(audio_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "negroni-audio");  /* NEGRONI_AUDIO_DEVICE without the /dev/ */
+}
+
+/*
+ * 0245: negroniaudio_tone=1 (speaker) or 2 (earpiece): a kernel-made 1 kHz sine for 2 s, then 0.5 s
+ * of zeros, through the same guard and ring as write(): the proof the owner HEARS. The sine is full
+ * scale before the guard; the guard's cap (negroniaudio_capdb, default 20) makes it -20 dBFS at the
+ * I2S, and the amps' TDMSPKG attenuation is held at a floor (negroni_tfa.c). Pacing: a period goes out when fewer than
+ * PERIODS - 2 are in flight (DONE events), else after 200 ms anyway (then the sink drops it and the
+ * stats line shows it). The amps go off at the end.
+ */
+static const int16_t sine_1k[48] = {
+	0, 4277, 8481, 12539, 16383, 19947, 23170, 25996, 28377, 30273, 31650, 32487,
+	32767, 32487, 31650, 30273, 28377, 25996, 23170, 19947, 16383, 12539, 8481, 4277,
+	0, -4277, -8481, -12539, -16383, -19947, -23170, -25996, -28377, -30273, -31650, -32487,
+	-32767, -32487, -31650, -30273, -28377, -25996, -23170, -19947, -16384, -12539, -8481, -4277,
+};
+
+static void
+tone_play(uint32_t route)
+{
+	int16_t buf[2 * 240];
+	uint64_t t0 = mach_absolute_time(), ns = 0, done0 = os_atomic_load(&write_done_count, relaxed);
+	uint64_t sent0, drop0;
+	uint32_t pin = 0, pout = 0, gq = 0, waits = 0;
+	const uint32_t tone_periods = 100, quiet_periods = 25;         /* 2 s, 0.5 s */
+
+	lck_mtx_lock(audio_lock);
+	sent0 = periods_sent;
+	drop0 = frames_dropped;
+	lck_mtx_unlock(audio_lock);
+	(void)route_set(route);
+	say("TONE: 1 kHz, 2 s, %s, -%u dBFS at the I2S (guard cap), amps %s", route == NEGRONI_TFA_ROUTE_RECEIVER ?
+	    "earpiece (left slot, 0x34)" : "speaker (both)", ng_guard_cap_db(), amps_probed ? "probed" : "NOT probed (no sound)");
+	ng_guard_stats(&pin, &pout, &gq);               /* clear the peaks */
+	for (uint32_t p = 0; p < tone_periods + quiet_periods; p++) {
+		uint32_t ms = 0;
+		for (; ms < 200; ms++) {                /* pace on the DONE events */
+			uint64_t inflight;
+			negroni_glink_poll();
+			lck_mtx_lock(audio_lock);
+			inflight = periods_sent - os_atomic_load(&write_done_count, relaxed);
+			lck_mtx_unlock(audio_lock);
+			if (inflight < PERIODS - 2) {
+				break;
+			}
+			IOSleep(1);
+		}
+		if (ms == 200) {
+			waits++;
+		}
+		if (p == 10 && os_atomic_load(&write_done_count, relaxed) == done0) {
+			say("TONE stopped: no DONE event after 10 periods: the ADSP does not take the data (try negroniaudio_v2=1)");
+			break;
+		}
+		for (uint32_t c = 0; c < PERIOD_FRAMES / 240; c++) {
+			for (uint32_t f = 0; f < 240; f++) {
+				int16_t s = p < tone_periods ? sine_1k[f % 48] : 0;   /* 960 and 240 are multiples of 48 */
+				buf[2 * f] = s;
+				buf[2 * f + 1] = s;                    /* the guard mixes L+R to the left slot for the earpiece */
+			}
+			lck_mtx_lock(feed_lock);
+			sink_feed(buf, 240);
+			lck_mtx_unlock(feed_lock);
+		}
+		if (p == tone_periods / 2) {
+			(void)negroni_tfa_check(1);     /* the amps' status in the middle of the tone */
+		}
+	}
+	ng_guard_stats(&pin, &pout, &gq);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	lck_mtx_lock(audio_lock);
+	say("TONE done in %llu ms (2500 expected at the 48 kHz pace): periods sent %llu, DONE %llu, frames dropped %llu, "
+	    "%u periods sent after a 200 ms wait; guard peak in %u out %u (of 32768), least gain %u/32768",
+	    ns / 1000000, periods_sent - sent0, os_atomic_load(&write_done_count, relaxed) - done0,
+	    frames_dropped - drop0, waits, pin, pout, gq);
+	lck_mtx_unlock(audio_lock);
+	negroni_tfa_stop("tone done");
+}
+
+/*
+ * sysctl kern.negroni_audio_route (1 speaker, 2 earpiece) and kern.negroni_audio_tone (write 1 or 2:
+ * the 0245 tone on that route now; root only; needs the running sink). For tests over SSH.
+ */
+static int
+sysctl_audio_route(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int v = (int)audio_route, changed = 0, error;
+
+	error = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	return route_set((uint32_t)v);
+}
+SYSCTL_PROC(_kern, OID_AUTO, negroni_audio_route, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    NULL, 0, sysctl_audio_route, "I", "NEGRONI audio route: 1 speaker, 2 earpiece");
+
+static int
+sysctl_audio_tone(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int v = 0, changed = 0, error;
+	uint32_t keep;
+
+	error = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (req->p != NULL && proc_suser(req->p) != 0) {
+		return EPERM;
+	}
+	if (v != 1 && v != 2) {
+		return EINVAL;
+	}
+	if (!sink_on || !graph_started) {
+		return ENODEV;
+	}
+	keep = audio_route;
+	tone_play(v == 2 ? NEGRONI_TFA_ROUTE_RECEIVER : NEGRONI_TFA_ROUTE_SPEAKER);
+	(void)route_set(keep);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, negroni_audio_tone, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED,
+    NULL, 0, sysctl_audio_tone, "I", "NEGRONI audio: write 1 (speaker) or 2 (earpiece): 2 s 1 kHz test tone");
+
+static bool
+step_sink(void)
+{
+	uint32_t tone = 0;
+	announce_note("enable /dev/negroni-audio");
+	if (!graph_started) {
+		FAIL("the graph is not started");
+		return false;
+	}
+	negroni_audio_init();
+	if (audio_major < 0) {
+		FAIL("the /dev/negroni-audio node was not made");
+		return false;
+	}
+	(void)PE_parse_boot_argn("negroniaudio_v2", &data_v2, sizeof(data_v2));
+	(void)PE_parse_boot_argn("negroniaudio_capdb", &cap_db, sizeof(cap_db));
+	ng_guard_config(cap_db);
+	ng_guard_volume(volume_below, muted);
+	busy_drops = 0;
+	fill_frames = ring_head = 0;
+	periods_sent = os_atomic_load(&write_done_count, relaxed);
+	sink_on = true;
+	say("data buffers: %s", data_v2 ? "V2 0x0400100A (negroniaudio_v2=1)" : "V1 0x04001000");
+	say("guard: cap -%u dBFS (negroniaudio_capdb, >= %u), 200 Hz high-pass, power + peak limiter", ng_guard_cap_db(),
+	    NG_GUARD_MIN_CAP_DB);
+	say("THE SPEAKER SINK IS LIVE: write S16LE stereo 48 kHz to /dev/negroni-audio");
+	{
+		uint32_t r = NEGRONI_AUDIO_ROUTE_SPEAKER;
+		(void)PE_parse_boot_argn("negroniaudio_route", &r, sizeof(r));
+		(void)route_set(r);
+	}
+	amps_setup();
+	(void)PE_parse_boot_argn("negroniaudio_tone", &tone, sizeof(tone));
+	if (tone == 1 || tone == 2) {
+		tone_play(tone == 2 ? NEGRONI_TFA_ROUTE_RECEIVER : NEGRONI_TFA_ROUTE_SPEAKER);
+	}
+	return true;
+}
+
+/* ==== step dispatch (called by negroni_adsp.c steps 10..15) ==== */
+
+static void announce_note(const char *what) { say("about to: %s", what); }
+
+bool
+negroni_audio_step(uint32_t n, uint32_t step_budget, char *why_out, size_t whylen)
+{
+	bool ok;
+
+	step = n;
+	budget_ms = MIN(MAX(step_budget, 1000u), 120000u);
+	fail_why[0] = 0;
+	switch (n) {
+	case 10: ok = step_qrtr(); break;
+	case 11: ok = step_spf(); break;
+	case 12: ok = step_prm(); break;
+	case 13: ok = step_graph(); break;
+	case 14: ok = step_shmem(); break;
+	case 15: ok = step_sink(); break;
+	default: ok = false; snprintf(fail_why, sizeof(fail_why), "no such audio step %u", n); break;
+	}
+	if (!ok && why_out) {
+		strlcpy(why_out, fail_why[0] ? fail_why : "no reason logged", whylen);
+	}
+	return ok;
+}
+
+const char *
+negroni_audio_step_name(uint32_t n)
+{
+	switch (n) {
+	case 10: return "QRTR";
+	case 11: return "SPF ready";
+	case 12: return "PRM clock";
+	case 13: return "graph open";
+	case 14: return "shmem + start";
+	case 15: return "sink";
+	default: return "?";
+	}
+}
+
+void
+negroni_audio_dsp_lost(const char *reason)
+{
+	say("ADSP LOST (%s): amps off, sink off, graph state dropped (no GPR to a dead DSP)", reason ? reason : "");
+	negroni_tfa_stop("ADSP lost");
+	if (audio_lock) {
+		lck_mtx_lock(audio_lock);
+	}
+	sink_on = false;
+	graph_started = false;
+	graph_opened = false;
+	clock_on = false;
+	mem_map_handle = 0;
+	if (audio_lock) {
+		lck_mtx_unlock(audio_lock);
+	}
+}
+
+void
+negroni_audio_stop(const char *reason)
+{
+	step = 0;
+	say("audio stop: %s", reason ? reason : "");
+	negroni_tfa_stop("audio stop");                 /* before the I2S clock goes */
+	sink_on = false;
+	if (graph_started) {
+		(void)graph_mgmt(APM_CMD_GRAPH_STOP);
+		graph_started = false;
+	}
+	if (graph_opened) {
+		(void)graph_mgmt(APM_CMD_GRAPH_CLOSE);
+		graph_opened = false;
+	}
+	if (mem_map_handle) {
+		struct { struct gpr_hdr hdr; uint32_t handle; } __attribute__((packed)) pkt;
+		uint32_t status;
+		bzero(&pkt, sizeof(pkt));
+		gpr_build_hdr(&pkt.hdr, sizeof(pkt), GPR_PORT_APM, GPR_APM_IID, APM_CMD_SHARED_MEM_UNMAP);
+		pkt.handle = mem_map_handle;
+		(void)gpr_send_wait(&pkt, sizeof(pkt), 0, &status);
+		mem_map_handle = 0;
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_audio_abi.h b/bsd/dev/negroni_audio_abi.h
new file mode 100644
index 0000000..d03bb15
--- /dev/null
+++ b/bsd/dev/negroni_audio_abi.h
@@ -0,0 +1,57 @@
+/*
+ * /dev/negroni-audio: the user/kernel ABI between NegroniAudio.driver (the CoreAudio HAL
+ * plug-in in mediaserverd) and the kernel sink (bsd/dev/negroni_audio.c, patches/xnu/0241+).
+ * The kernel keeps its own copy of these numbers (it has no userland headers): change both.
+ *
+ * Model: HackiOS sys/redwood_audio.h (external/hackios-xnu-userland, MIT).
+ *
+ *   write()  whole frames, S16LE, 2 channels (left, right), 48000 frames/s. Never blocks (the
+ *            writer is the HAL real-time I/O thread). The return value is the number of bytes
+ *            the kernel took; the rest is dropped. ENODEV: no sink is running (no ADSP graph):
+ *            the plug-in counts the frames as dropped and goes on.
+ *   ioctl    NEGRONI_AUDIO_SET_VOLUME: the HAL volume control, in 1/8 dB below the kernel's
+ *            maximum (the kernel maximum is a safe, low level: see the kernel limiter).
+ *            NEGRONI_AUDIO_GET_STATS: counters for scripts/audio/phone-test.sh.
+ */
+#ifndef NEGRONI_AUDIO_H
+#define NEGRONI_AUDIO_H
+
+#include <sys/ioccom.h>
+
+#define NEGRONI_AUDIO_DEVICE    "/dev/negroni-audio"
+#define NEGRONI_AUDIO_RATE      48000
+#define NEGRONI_AUDIO_CHANNELS  2
+#define NEGRONI_AUDIO_FRAME     4       /* bytes per frame */
+
+struct negroni_audio_volume {
+	uint32_t below;                 /* 1/8 dB below the kernel maximum (0243: stored, not applied yet) */
+	uint32_t muted;                 /* 1: iOS volume 0 */
+};
+
+struct negroni_audio_stats {
+	uint64_t frames_in;             /* frames written by user space */
+	uint64_t frames_dropped;        /* frames the sink did not take */
+	uint64_t frames_played;         /* frames the sink gave to the DSP */
+	uint32_t state;                 /* NEGRONI_AUDIO_STATE_* */
+	uint32_t peak_in;               /* peak |sample| written since the last GET_STATS */
+	uint32_t peak_out;              /* peak |sample| after the limiter since the last GET_STATS */
+	uint32_t limiter_gain_q15;      /* limiter gain now, 32768 = 0 dB */
+};
+
+#define NEGRONI_AUDIO_STATE_NOSINK      0       /* the device exists, no sink: samples are dropped */
+#define NEGRONI_AUDIO_STATE_IDLE        1       /* a sink exists, not running */
+#define NEGRONI_AUDIO_STATE_RUNNING     2       /* the graph runs, samples go to the DSP */
+#define NEGRONI_AUDIO_STATE_FAILED      3       /* the sink stopped after an error */
+
+#define NEGRONI_AUDIO_SET_VOLUME        _IOW('n', 1, struct negroni_audio_volume)
+#define NEGRONI_AUDIO_GET_STATS         _IOR('n', 2, struct negroni_audio_stats)
+/*
+ * 0246: the output route of the Speaker stream. SPEAKER: both TFA9874 amps (stereo); RECEIVER: the
+ * top amp only in its "receiver" profile (the earpiece; the kernel plays (L + R) / 2). A change
+ * stops the amps; the next non-silent write starts the new route. Also: sysctl kern.negroni_audio_route.
+ */
+#define NEGRONI_AUDIO_ROUTE_SPEAKER     1u
+#define NEGRONI_AUDIO_ROUTE_RECEIVER    2u
+#define NEGRONI_AUDIO_SET_ROUTE         _IOW('n', 3, uint32_t)
+
+#endif
diff --git a/bsd/dev/negroni_audio_guard.c b/bsd/dev/negroni_audio_guard.c
new file mode 100644
index 0000000..bdfd61e
--- /dev/null
+++ b/bsd/dev/negroni_audio_guard.c
@@ -0,0 +1,256 @@
+/*
+ * NEGRONI (SM8450) speaker guard (iOSPlus10 patch 0244): every sample on its way to the TFA9874
+ * amps goes through it, in place of the NXP protection algorithm that Android runs in the ADSP
+ * (module 0x1700B911 with V/I feedback). We have no feedback and no speaker model, so the guard
+ * works from the samples only. Model: hackios-xnu-kernel bsd/dev/redwood_guard.c (APSL 2.0); the
+ * structure and the Q30 tables follow it, the limits are ours.
+ *
+ * Order, per block:
+ *   gain     cap x volume: the cap (negroniaudio_capdb, default 20 dB under full scale, at least
+ *            10 dB) is the loudest any sample can be; the HAL volume (SET_VOLUME, 1/8 dB) and the
+ *            clip monitor (1 dB per clipping report of the amps, at most 12 dB) come on top
+ *   ramp     after an amp start the gain rises from 0 over 20 ms (no pop on a running signal)
+ *   high-pass 2nd-order Butterworth at 200 Hz (a phone speaker gives nothing below its resonance;
+ *            what it gets there only moves the cone and heats the coil)
+ *   power    two averages per channel, 0.2 s and 3 s; the gain goes down so that the 0.2 s power
+ *            stays at or under a full-scale sine at the cap and the 3 s power 3 dB under that
+ *   peaks    no sample above the cap: a limiter that acts at the sample and lets go in 43 ms
+ *   route    the earpiece plays the left slot only (0x34): left = (L + R) / 2, right = 0
+ * Output: S24 in 32-bit (Q23), the WR EP format. Integer math only. One caller at a time (the
+ * sink, under audio_lock); the volume/monitor setters may run on other threads.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include "negroni_audio_guard.h"
+
+#define ONE             (1ll << 30)
+#define RMS_FRAMES      9600            /* 0.2 s */
+#define FAST_FRAMES     144000          /* 3 s */
+#define RELEASE_SHIFT   11              /* 2048 frames, 43 ms */
+#define RAMP_FRAMES     960             /* 20 ms */
+
+/* 10^(-n/160), n = 0..47, Q30: n eighths of a dB as an amplitude factor (redwood_guard.c) */
+static const uint32_t eighths[48] = {
+	1073741824, 1058400094, 1043277569, 1028371116, 1013677647, 999194121, 984917536, 970844937, 956973408, 943300077,
+	929822112, 916536722, 903441154, 890532697, 877808678, 865266461, 852903448, 840717079, 828704830, 816864213,
+	805192776, 793688102, 782347808, 771169545, 760150998, 749289885, 738583957, 728030996, 717628817, 707375265,
+	697268218, 687305580, 677485290, 667805313, 658263644, 648858308, 639587356, 630448869, 621440953, 612561743,
+	603809400, 595182112, 586678091, 578295576, 570032831, 561888146, 553859832, 545946228,
+};
+#define SIX_DB          538145694       /* 10^(-6/20), Q30 */
+
+/* 200 Hz high-pass at 48 kHz, Q = 1/sqrt(2) (RBJ cookbook), Q30: b0, b1, b2, a1, a2 */
+static const int64_t hpf_b0 = 1054047540, hpf_b1 = -2108095079, hpf_b2 = 1054047540;
+static const int64_t hpf_a1 = -2107733822, hpf_a2 = 1034714513;
+
+static struct {
+	uint64_t cap;                   /* Q30 amplitude of the cap */
+	uint32_t cap_eighths;
+	volatile uint32_t below;        /* HAL volume, eighths of a dB */
+	volatile uint32_t muted;
+	volatile uint32_t monitor;      /* clip monitor, eighths of a dB */
+	volatile uint32_t ramp;         /* frames left in the soft start */
+	int64_t x1[2], x2[2], y1[2], y2[2];     /* filter state, 1/256 of a full-scale-16-bit sample */
+	uint64_t rms[2], fast[2];       /* Q30 of full-scale square power */
+	uint64_t level;                 /* the power gain at the end of the last block, Q30 */
+	uint64_t envelope;              /* the peak limiter, 1/65536 of a sample */
+	uint32_t peak_in, peak_out;     /* since the last stats call */
+	uint32_t least_gain_q15;
+} g = { .cap_eighths = 160, .level = ONE, .least_gain_q15 = 32768 };
+
+static uint64_t
+amplitude(uint32_t n)
+{
+	uint64_t v = eighths[n % 48];
+
+	for (uint32_t i = 0; i < n / 48 && v != 0; i++) {
+		v = v * SIX_DB >> 30;
+	}
+	return v;
+}
+
+static uint64_t
+isqrt(uint64_t value)
+{
+	uint64_t root = 0, bit = 1ull << 62;
+
+	while (bit > value) {
+		bit >>= 2;
+	}
+	while (bit != 0) {
+		if (value >= root + bit) {
+			value -= root + bit;
+			root = (root >> 1) + bit;
+		} else {
+			root >>= 1;
+		}
+		bit >>= 2;
+	}
+	return root;
+}
+
+static uint64_t
+headroom(uint64_t power, uint64_t limit)
+{
+	return power <= limit ? (uint64_t)ONE : (limit << 30) / power;
+}
+
+void
+ng_guard_config(uint32_t cap_db)
+{
+	cap_db = MIN(MAX(cap_db, NG_GUARD_MIN_CAP_DB), 60u);
+	g.cap_eighths = cap_db * 8;
+	g.cap = amplitude(g.cap_eighths);
+	bzero(g.x1, sizeof(g.x1));
+	bzero(g.x2, sizeof(g.x2));
+	bzero(g.y1, sizeof(g.y1));
+	bzero(g.y2, sizeof(g.y2));
+	bzero(g.rms, sizeof(g.rms));
+	bzero(g.fast, sizeof(g.fast));
+	g.level = ONE;
+	g.envelope = 0;
+}
+
+uint32_t
+ng_guard_cap_db(void)
+{
+	return g.cap_eighths / 8;
+}
+
+void
+ng_guard_volume(uint32_t below, uint32_t muted)
+{
+	g.below = MIN(below, 96u * 8);
+	g.muted = muted;
+}
+
+void
+ng_guard_monitor_add(uint32_t eighths_more)
+{
+	g.monitor = MIN(g.monitor + eighths_more, 12u * 8);
+}
+
+uint32_t
+ng_guard_monitor(void)
+{
+	return g.monitor;
+}
+
+void
+ng_guard_ramp(void)
+{
+	g.ramp = RAMP_FRAMES;
+}
+
+void
+ng_guard_stats(uint32_t *peak_in, uint32_t *peak_out, uint32_t *least_gain_q15)
+{
+	*peak_in = g.peak_in;
+	*peak_out = g.peak_out;
+	*least_gain_q15 = g.least_gain_q15;
+	g.peak_in = g.peak_out = 0;
+	g.least_gain_q15 = 32768;
+}
+
+/*
+ * count <= NG_GUARD_MAX_FRAMES stereo S16 frames in, Q23 frames out. Returns the block's input peak
+ * (|sample|, 0..32768) for the silence timer.
+ */
+uint32_t
+ng_guard_process(const int16_t *in, int32_t *out, uint32_t count, bool receiver)
+{
+	static int32_t work[2 * NG_GUARD_MAX_FRAMES];   /* 1/256 of a 16-bit sample */
+	uint64_t pre, sum[2] = { 0, 0 }, g2 = ONE, gain_now, start = g.level, ceiling;
+	uint32_t peak = 0;
+
+	if (count == 0 || count > NG_GUARD_MAX_FRAMES) {
+		return 0;
+	}
+	/* the gain before everything: cap x volume x monitor (Q30) */
+	pre = g.muted ? 0 : g.cap * amplitude(g.below + g.monitor) >> 30;
+	for (uint32_t i = 0; i < 2 * count; i++) {
+		unsigned c = i & 1;
+		int64_t x, y;
+		int32_t s = in[i];
+		uint32_t a = (uint32_t)(s < 0 ? -s : s);
+
+		if (receiver) {
+			s = c == 0 ? (in[i] + in[i + 1]) / 2 : 0;
+		}
+		peak = MAX(peak, a);
+		x = (int64_t)s * (int64_t)pre >> 22;            /* 1/256 of a sample */
+		y = (hpf_b0 * x + hpf_b1 * g.x1[c] + hpf_b2 * g.x2[c] - hpf_a1 * g.y1[c] - hpf_a2 * g.y2[c]) >> 30;
+		g.x2[c] = g.x1[c];
+		g.x1[c] = x;
+		g.y2[c] = g.y1[c];
+		g.y1[c] = y;
+		work[i] = (int32_t)y;
+		{
+			int64_t w = y >> 8;                     /* back to 16-bit units for the power */
+			sum[c] += (uint64_t)(w * w);
+		}
+	}
+	g.peak_in = MAX(g.peak_in, peak);
+	/* power: 0.2 s average <= a full-scale sine at the cap (half a square's power), 3 s 3 dB under */
+	{
+		uint64_t cap2 = g.cap * g.cap >> 30;            /* the cap's power, Q30 of a square at full scale */
+		uint64_t lim_rms = cap2 / 2, lim_fast = cap2 / 4;
+		for (unsigned c = 0; c < 2; c++) {
+			uint64_t power = (sum[c] / count << 30) / (32768ull * 32768ull), h;
+			g.rms[c] = (uint64_t)((int64_t)g.rms[c] + ((int64_t)power - (int64_t)g.rms[c]) * (int64_t)count / RMS_FRAMES);
+			g.fast[c] = (uint64_t)((int64_t)g.fast[c] + ((int64_t)power - (int64_t)g.fast[c]) * (int64_t)count / FAST_FRAMES);
+			if ((h = headroom(g.rms[c], lim_rms)) < g2) {
+				g2 = h;
+			}
+			if ((h = headroom(g.fast[c], lim_fast)) < g2) {
+				g2 = h;
+			}
+		}
+	}
+	gain_now = isqrt(g2 << 30);
+	if (gain_now > (uint64_t)ONE) {
+		gain_now = ONE;
+	}
+	/* peaks: no sample above the cap (in 1/256-sample units: 32767 * 256 * cap) */
+	ceiling = (32767ull * 256 * g.cap) >> 30;
+	for (uint32_t f = 0; f < count; f++) {
+		uint64_t gain = (uint64_t)((int64_t)start + ((int64_t)gain_now - (int64_t)start) * (int64_t)(f + 1) / (int64_t)count);
+		uint64_t level, pg = 65536;
+		int64_t y[2];
+
+		if (g.ramp) {
+			gain = gain * (RAMP_FRAMES - g.ramp) / RAMP_FRAMES;
+			g.ramp--;
+		}
+		for (unsigned c = 0; c < 2; c++) {
+			y[c] = (int64_t)work[2 * f + c] * (int64_t)gain >> 30;
+		}
+		level = (uint64_t)MAX(y[0] < 0 ? -y[0] : y[0], y[1] < 0 ? -y[1] : y[1]);
+		g.envelope -= g.envelope >> RELEASE_SHIFT;
+		if (level << 16 > g.envelope) {
+			g.envelope = level << 16;
+		}
+		if (ceiling && g.envelope > ceiling << 16) {
+			pg = (ceiling << 32) / g.envelope;
+		}
+		if ((uint32_t)(gain >> 15) * pg / 65536 < g.least_gain_q15) {
+			g.least_gain_q15 = (uint32_t)((gain >> 15) * pg / 65536);
+		}
+		for (unsigned c = 0; c < 2; c++) {
+			int64_t o = y[c] * (int64_t)pg >> 16;   /* 1/256 of a 16-bit sample = Q23 / 1 (2^8 x 2^15) */
+			uint32_t mag;
+			if (o > (int64_t)ceiling) {      /* signed compare: a negative sample stays negative */
+				o = (int64_t)ceiling;
+			} else if (o < -(int64_t)ceiling) {
+				o = -(int64_t)ceiling;
+			}
+			out[2 * f + c] = (int32_t)o;            /* 1/256 of S16 = S24 units */
+			mag = (uint32_t)((o < 0 ? -o : o) >> 8);
+			g.peak_out = MAX(g.peak_out, mag);
+		}
+	}
+	g.level = gain_now;
+	return peak;
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
