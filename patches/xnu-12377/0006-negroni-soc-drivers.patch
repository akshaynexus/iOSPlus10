+#include <net/if_media.h>
+#include <net/dlil.h>
+#include <sys/kern_event.h>
+#include "negroni_chg_glink.h"            /* 0368: adapter type / VOOC state for the PHY repair gate */
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void negroni_usb_probe(void);
+static void negroni_usb_gadget_start(vm_offset_t dwc);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+/*
+ * Panic mode (patch 0360, README-panic.md). negroni_usb_panic_begin(),
+ * called by negroni_panic_restart() (negroni_reboot.c), sets ud_in_panic.
+ * From then on this file runs on the panicking CPU only, with interrupts
+ * off and the other CPUs halted: no locks (the panicking CPU may hold
+ * ud.lock), no mbuf allocation or free, no sleep, no WFE delay, no
+ * os_log. printf then writes to the console ring only (sent over USB, not
+ * drawn: the panic text stays on the screen).
+ */
+extern int kdb_printf(const char *format, ...) __printflike(1, 2);
+extern void negroni_log_append(const char *c, int size);
+static volatile bool ud_in_panic;
+static volatile bool ud_log_rewind;     /* "log" command: ud_log_thread sends the last 64 KiB again */
+static volatile uint64_t ud_log_sent;   /* console ring position that ud_log_thread has sent up to */
+static volatile bool ud_log_resock;     /* 0381: a data path re-init: ud_log_thread makes a new socket */
+
+static int ud_panic_log(const char *fmt, ...) __printflike(1, 2);
+static int
+ud_panic_log(const char *fmt, ...)
+{
+	char buf[160];
+	va_list ap;
+
+	va_start(ap, fmt);
+	int n = vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	if (n > (int)sizeof(buf) - 1) {
+		n = (int)sizeof(buf) - 1;
+	}
+	negroni_log_append(buf, n);
+	return n;
+}
+#define printf(...) (ud_in_panic ? ud_panic_log(__VA_ARGS__) : printf(__VA_ARGS__))
+
+#define GCC_PA                  0x00100000
+#define GCC_SIZE                0x00090000
+#define GCC_USB30_PRIM_GDSCR    0x49004         /* bit 31: power on (Linux gcc-sm8450.c) */
+#define CBCR_CLK_OFF            (1u << 31)
+
+static const struct {
+	const char *name;
+	uint32_t    off;
+} usb_cbcr[] = {
+	{ "master", 0x49018 },
+	{ "sleep", 0x49020 },
+	{ "utmi", 0x49024 },
+	{ "cfg-noc-axi", 0x49084 },
+	{ "aggre-axi", 0x49088 },
+	{ "phy-aux", 0x4905c },
+};
+
+#define DWC3_PA                 0x0a600000
+#define DWC3_SIZE               0x0000d000
+
+static uint32_t
+usb_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+void
+negroni_usb_probe(void)
+{
+	int enabled = 1;
+	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
+	bool clocks_on = true;
+
+	/* negroniusb=0 off, 1 (default) report state only, 2 also start the USB device */
+	PE_parse_boot_argn("negroniusb", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	if (gcc == 0) {
+		printf("NEGRONI USB: GCC map failed\n");
+		return;
+	}
+	gdscr = usb_rd(gcc, GCC_USB30_PRIM_GDSCR);
+	printf("NEGRONI USB: GDSC usb30_prim 0x%08x (%s)\n", gdscr, (gdscr & (1u << 31)) ? "on" : "off");
+	for (unsigned i = 0; i < sizeof(usb_cbcr) / sizeof(usb_cbcr[0]); i++) {
+		cbcr[i] = usb_rd(gcc, usb_cbcr[i].off);
+		printf("NEGRONI USB: clk %-12s CBCR 0x%08x (%s)\n", usb_cbcr[i].name, cbcr[i],
+		    (cbcr[i] & CBCR_CLK_OFF) ? "off" : "on");
+	}
+	/* DWC3 registers need the GDSC, the master clock and the config-NoC path. */
+	clocks_on = (gdscr & (1u << 31)) && !(cbcr[0] & CBCR_CLK_OFF) && !(cbcr[3] & CBCR_CLK_OFF);
+	if (!clocks_on) {
+		printf("NEGRONI USB: controller unpowered or unclocked; DWC3 not read\n");
+		return;
+	}
+	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	if (dwc == 0) {
+		printf("NEGRONI USB: DWC3 map failed\n");
+		return;
+	}
+	printf("NEGRONI USB: DWC3 GSNPSID 0x%08x GCTL 0x%08x GSTS 0x%08x GUSB2PHYCFG 0x%08x\n",
+	    usb_rd(dwc, 0xc120), usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc118), usb_rd(dwc, 0xc200));
+	printf("NEGRONI USB: DWC3 DCFG 0x%08x DCTL 0x%08x DEVTEN 0x%08x DSTS 0x%08x DALEPENA 0x%08x\n",
+	    usb_rd(dwc, 0xc700), usb_rd(dwc, 0xc704), usb_rd(dwc, 0xc708), usb_rd(dwc, 0xc70c),
+	    usb_rd(dwc, 0xc720));
+	printf("NEGRONI USB: DWC3 GEVNTADR 0x%08x%08x GEVNTSIZ 0x%08x GEVNTCOUNT 0x%08x GHWPARAMS0 0x%08x\n",
+	    usb_rd(dwc, 0xc404), usb_rd(dwc, 0xc400), usb_rd(dwc, 0xc408), usb_rd(dwc, 0xc40c),
+	    usb_rd(dwc, 0xc140));
+	if (enabled >= 2) {
+		negroni_usb_gadget_start(dwc);
+	}
+}
+
+/*
+ * Step 2: USB device mode with only the default control endpoint, enough
+ * for the host to enumerate the phone (boot-arg negroniusb=2). ABL leaves
+ * the DWC3 powered, clocked, in device mode and halted, with the PHY set
+ * up, so only the device controller is restarted: soft reset, an event
+ * buffer in our memory, endpoint 0, run. Events are polled from a kernel
+ * thread (no interrupt), like the UFS driver. DMA is not cache coherent
+ * (DT qcom,gsi-disable-io-coherency): buffers are cleaned/invalidated.
+ * Register layout and the control-transfer state machine follow the
+ * Synopsys DWC3 databook as used by Linux drivers/usb/dwc3 (gadget.c,
+ * ep0.c).
+ */
+#define GCTL            0xc110
+#define GEVNTADRLO      0xc400
+#define GEVNTADRHI      0xc404
+#define GEVNTSIZ        0xc408
+#define GEVNTCOUNT      0xc40c
+#define DCFG            0xc700
+#define DCTL            0xc704
+#define DEVTEN          0xc708
+#define DSTS            0xc70c
+#define DALEPENA        0xc720
+#define DEPCMDPAR2(n)   (0xc800 + 0x10 * (n))
+#define DEPCMDPAR1(n)   (0xc804 + 0x10 * (n))
+#define DEPCMDPAR0(n)   (0xc808 + 0x10 * (n))
+#define DEPCMD(n)       (0xc80c + 0x10 * (n))
+
+/*
+ * Qualcomm wrapper registers ("QSCRATCH", core base + 0xf8800). The
+ * controller only connects (pull-up on D+) while it sees a valid VBUS
+ * session; Linux dwc3-qcom forces that in software when the charger
+ * reports a cable (dwc3_qcom_vbus_override_enable).
+ */
+#define QSCRATCH_PA             0x0a6f8800
+#define QSCRATCH_HS_PHY_CTRL    0x10
+#define   UTMI_OTG_VBUS_VALID   (1u << 20)
+#define   SW_SESSVLD_SEL        (1u << 28)
+#define QSCRATCH_SS_PHY_CTRL    0x30
+#define   LANE0_PWR_PRESENT     (1u << 24)
+
+#define DCTL_RUN_STOP   (1u << 31)
+#define DCTL_CSFTRST    (1u << 30)
+#define DSTS_DEVCTRLHLT (1u << 22)
+/* 0366: reconnect after unplug (Linux dwc3 core.h) */
+#define GUSB2PHYCFG     0xc200
+#define   GUSB2PHYCFG_SUSPHY    (1u << 6)       /* the core may suspend the UTMI PHY */
+#define   GUSB2PHYCFG_ENBLSLPM  (1u << 8)       /* utmi_sleep_n / l1_suspend_n */
+#define DSTS_SOFFN(d)   (((d) >> 3) & 0x3fff)   /* (micro)frame number of the last SOF */
+#define DSTS_LINK(d)    (((d) >> 18) & 0xf)     /* USBLNKST */
+#define DEVTEN_BASE     0x7u                    /* disconnect, USB reset, connect done (the old mask) */
+/* + wakeup, U3/L2-L1 suspend, erratic error: as Linux dwc3_gadget_enable_irq for a DWC_usb31 (no link state change) */
+#define DEVTEN_MORE     ((1u << 4) | (1u << 6) | (1u << 9))
+#define DEVTEN_ULSTCNG  (1u << 3)               /* link state change (negroniusb_events=2) */
+#define DEPCMD_ENDTRANSFER      8
+#define DEPCMD_FORCERM          (1u << 11)
+#define DEPCMD_CMDIOC           (1u << 8)
+
+#define DEPCMD_SETEPCONFIG      1
+#define DEPCMD_SETTRANSFRESOURCE 2
+#define DEPCMD_SETSTALL         4
+#define DEPCMD_STARTTRANSFER    6
+#define DEPCMD_DEPSTARTCFG      9
+#define DEPCMD_CMDACT           (1u << 10)
+
+#define TRB_HWO         (1u << 0)
+#define TRB_LST         (1u << 1)
+#define TRB_ISP_IMI     (1u << 10)
+#define TRB_IOC         (1u << 11)
+#define TRBCTL_SETUP    (2u << 4)
+#define TRBCTL_STATUS2  (3u << 4)
+#define TRBCTL_STATUS3  (4u << 4)
+#define TRBCTL_DATA     (5u << 4)
+
+/* DMA area layout */
+#define UD_EVT          0x0000          /* event buffer, 4 KiB */
+#define UD_EVT_SIZE     0x1000
+#define UD_TRB_OUT      0x1000          /* ep0 OUT TRB */
+#define UD_TRB_IN       0x1010          /* ep0 IN TRB */
+#define UD_TRB_RX       0x1020          /* ep1 OUT (bulk, host -> phone) */
+#define UD_TRB_TX       0x1030          /* ep1 IN (bulk, phone -> host) */
+#define UD_TRB_INT      0x1050          /* ep2 IN (interrupt, notifications) */
+#define UD_SETUP        0x1040          /* 8-byte setup packet */
+#define UD_DATA         0x1100          /* ep0 data stage, 512 bytes */
+#define UD_NOTIFY       0x1300          /* 16-byte notification */
+#define UD_RX           0x2000          /* one received frame */
+#define UD_TX           0x2800          /* one frame to send */
+#define UD_FRAME_MAX    0x800
+/*
+ * Patch 0361: an RX ring and TX batches. Before, one TRB per direction was
+ * in flight and ud_thread re-armed it only on its next 1 ms poll: at most one
+ * frame per poll and direction (measured 1.1-1.2 MB/s both ways at high
+ * speed). Now UD_RXN receive TRBs form a ring (link TRB at the end) that the
+ * controller fills without us, and up to UD_TXB queued frames go out in one
+ * transfer (one TRB per frame, LST + IOC on the last). DMA is not cache
+ * coherent: an RX TRB is armed again only when all 4 TRBs of its 64-byte
+ * cache line are done, so a cache clean never overwrites a TRB the controller
+ * is writing back. Boot-arg negroniusb_ring=0: the old one-TRB paths.
+ */
+#define UD_RING_TRBS    0x4000          /* RX ring: UD_RXN TRBs + link TRB */
+#define UD_TXB_TRBS     0x4400          /* TX batch: UD_TXB TRBs */
+#define UD_RXN          32
+#define UD_TXB          32
+#define UD_RXBUF        0x8000          /* UD_RXN x UD_FRAME_MAX */
+#define UD_TXBUF        0x18000         /* UD_TXB x UD_FRAME_MAX */
+#define UD_SIZE         0x28000
+#define TRB_CSP         (1u << 3)
+#define TRBCTL_LINK     (8u << 4)
+#define DEPCMD_UPDATETRANSFER 7
+
+/* Physical endpoints: 2n = OUT, 2n+1 = IN */
+#define EP_RX           2               /* 0x01 bulk OUT */
+#define EP_TX           3               /* 0x81 bulk IN */
+#define EP_INT          5               /* 0x82 interrupt IN */
+#define TRBCTL_NORMAL   (1u << 4)
+
+#define UD_TXQ          128             /* 0361: was 32 (a full queue drops frames: TCP backs off) */
+
+static struct {
+	vm_offset_t dwc;
+	vm_offset_t dma;
+	uint64_t    dma_pa;
+	uint32_t    evt_pos;
+	int         sleep_chan;
+	enum { EP0_SETUP, EP0_DATA, EP0_WAIT_STATUS2, EP0_WAIT_STATUS3, EP0_STATUS } state;
+	bool        data_in;        /* data stage direction */
+	uint32_t    events;
+	bool        configured;
+	uint8_t     data_alt;       /* data interface alternate setting */
+	/* network */
+	ifnet_t     ifp;
+	lck_mtx_t  *lock;           /* TX ring and TX endpoint */
+	mbuf_t      txq[UD_TXQ];
+	unsigned    txq_head, txq_count;
+	bool        tx_busy;
+	uint64_t    rx_frames, tx_frames;
+	/* 0361: RX ring, TX batch, counters */
+	unsigned    rx_idx;         /* next RX ring TRB to look at */
+	uint32_t    rx_rsc;         /* RX transfer resource index (UPDATETRANSFER) */
+	bool        rx_started;
+	bool        tx_batch;       /* the transfer on the IN endpoint is a batch (not UD_TRB_TX) */
+	uint64_t    rx_bytes, tx_bytes, tx_drops;
+	uint32_t    rx_max_poll, tx_max_batch;
+	uint64_t    last_active;    /* mach_absolute_time of the last frame or event */
+	uint64_t    last_rx;        /* 0382: the last host frame or host event (not our own TX completions) */
+	int         poll_chan;      /* 0382: ud_thread's own sleep (ud_if_output wakes it) */
+	bool        poll_long;      /* 0382: ud_thread sleeps longer than 1 ms now */
+	/* 0366: transfers per physical endpoint, link watchdog */
+	bool        ep_busy[6];     /* STARTTRANSFER issued, no XferComplete or ENDTRANSFER since */
+	uint32_t    ep_rsc[6];      /* its transfer resource index (for ENDTRANSFER) */
+	vm_offset_t qs;             /* QSCRATCH (VBUS override) */
+	uint64_t    next_watch;     /* next DSTS sample */
+	uint32_t    last_soffn, last_link;
+	uint64_t    sof_seen;       /* time DSTS.SOFFN last changed (the host sends SOFs every 125 us) */
+	uint64_t    dev_event_at;   /* time of the last device event */
+	bool        nosof_logged;
+	bool        event_rule_done; /* the "device event without SOF" reconnect ran in this episode */
+	bool        ever_configured; /* 0371: SET_CONFIGURATION(1) happened in this boot */
+	bool        lost_reboot_done; /* 0371: the reboot is scheduled */
+	uint64_t    lost_since;     /* 0371: time of the last SOF before the current SOF-less stretch (0 = SOFs come) */
+	bool        sof_moved;      /* 0375: SOFFN changed in the last 100 ms sample (0371 needs two in a row) */
+	/* 0375: data-path watchdog (negroniusb_idle_reboot), read by ud_idle_thread */
+	uint64_t    out_at;         /* last bulk OUT frame from the host (0 = none in this boot) */
+	uint64_t    out_frames;     /* bulk OUT frames (command server + stack), not in panic mode */
+	uint64_t    tx_start_at;    /* last STARTTRANSFER on the IN endpoint */
+	uint64_t    tx_done_at;     /* last XferComplete on the IN endpoint */
+	uint64_t    beat;           /* ud_thread: start of its last loop pass */
+	volatile uint32_t where;    /* ud_thread: the step it is in (UD_AT_*) */
+	uint32_t    last_ev;        /* ud_thread: the last event it took */
+	/* 0381: the data path after a re-enumeration (negroniusb_datafix) */
+	uint64_t    alt1_at;        /* SET_INTERFACE(data, alt 1) while configured: the host's link up (0 = none since the last re-init) */
+	uint32_t    speed;          /* DSTS.CONNECTSPD at the last connect done: 0 high, 1 or 3 full, 2 low, 4 super */
+	uint64_t    arp_req;        /* ARP requests for 192.168.7.2 on the OUT path (counted while negroniusb_datafix != 0) */
+	uint32_t    episode_reconnects;
+	uint64_t    reconnects;
+	uint32_t    devevents[16];  /* device events per type (rate-limited log) */
+	/* command server (UDP 5141), used by ud_thread only */
+	bool        ctl_enabled;
+	int         ctl_action;
+	uint64_t    ctl_deadline;
+	uint16_t    ctl_ip_id;
+} ud;
+static int  ud_panic_enabled = 1;       /* 0360: boot-arg negronipanicusb */
+static int  ud_ring = 1;                /* 0361: boot-arg negroniusb_ring (0 = one TRB per direction) */
+static int  ud_poll_us = 200;           /* 0361: boot-arg negroniusb_pollus: poll period while frames move */
+/*
+ * 0382 (README-power-idle.md): ud_thread's poll period when nothing moves. Host data in the last 2 s,
+ * a TX in flight or the PHY watch window: 1 ms as before. Else negroniusb_idle_ms (default 4) with the
+ * display on and negroniusb_idle_off_ms (default 20) with the display asleep or no host configured.
+ * negroniusb_idle_ms=1 = the old fixed 1 ms. A frame we send (ud_if_output) wakes the thread at once.
+ */
+static int  ud_idle_ms = 4;
+static int  ud_idle_off_ms = 20;
+extern int negroni_display_asleep;      /* NegroniFramebuffer.cpp (0382) */
+static bool ud_running;                 /* 0360: gadget set up (event buffer, ep0) */
+
+static inline void
+dwc_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(ud.dwc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+dwc_rd(uint32_t off)
+{
+	return usb_rd(ud.dwc, off);
+}
+
+static void
+ud_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(ud.dma_pa + off), len, TRUE);
+}
+
+/* 0361: short sleeps with no timer coalescing (the default leeway can stretch them to ms). */
+static void
+ud_sleep_us(unsigned us)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(us, NSEC_PER_USEC, &deadline);
+	(void)assert_wait_deadline_with_leeway(&ud.sleep_chan, THREAD_UNINT,
+	    TIMEOUT_URGENCY_SYS_CRITICAL | TIMEOUT_URGENCY_LEEWAY, deadline, 0);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+ud_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* delay() waits with WFE (or blocks the thread); in panic mode spin on the counter instead. */
+static void
+ud_udelay(uint32_t us)
+{
+	if (!ud_in_panic) {
+		delay(us);
+		return;
+	}
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &abs);
+	uint64_t end = mach_absolute_time() + abs;
+	while (mach_absolute_time() < end) {
+	}
+}
+
+static int
+ud_epcmd(unsigned ep, uint32_t cmd, uint32_t p0, uint32_t p1, uint32_t p2)
+{
+	dwc_wr(DEPCMDPAR0(ep), p0);
+	dwc_wr(DEPCMDPAR1(ep), p1);
+	dwc_wr(DEPCMDPAR2(ep), p2);
+	dwc_wr(DEPCMD(ep), cmd | DEPCMD_CMDACT);
+	for (int i = 0; i < 1000; i++) {
+		uint32_t v = dwc_rd(DEPCMD(ep));
+		if (!(v & DEPCMD_CMDACT)) {
+			uint32_t status = (v >> 12) & 0xf;
+			if (status) {
+				printf("NEGRONI USB: ep%u cmd 0x%x status %u\n", ep, cmd & 0xf, status);
+				return -1;
+			}
+			if (ep < 6 && (cmd & 0xf) == DEPCMD_STARTTRANSFER) {
+				ud.ep_rsc[ep] = (v >> 16) & 0x7f;       /* 0366 */
+				ud.ep_busy[ep] = true;
+			}
+			return 0;
+		}
+		ud_udelay(1);
+	}
+	printf("NEGRONI USB: ep%u cmd 0x%x timeout\n", ep, cmd & 0xf);
+	return -1;
+}
+
+/* One TRB (at DMA offset trb) on physical endpoint ep. */
+static void
+ud_start_trb(unsigned ep, uint32_t trb, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + trb);
+	uint64_t bpa = ud.dma_pa + buf;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = len;
+	t[3] = ctl | TRB_HWO | TRB_LST | TRB_ISP_IMI | TRB_IOC;
+	ud_sync(trb, 16);
+	if (len) {
+		ud_sync(buf, len);
+	}
+	uint64_t tpa = ud.dma_pa + trb;
+	ud_epcmd(ep, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+static void
+ud_start(unsigned ep, uint32_t buf, uint32_t len, uint32_t ctl)
+{
+	ud_start_trb(ep, ep ? UD_TRB_IN : UD_TRB_OUT, buf, len, ctl);
+}
+
+static void
+ud_start_setup(void)
+{
+	ud.state = EP0_SETUP;
+	ud_start(0, UD_SETUP, 8, TRBCTL_SETUP);
+}
+
+static void
+ud_stall(void)
+{
+	ud_epcmd(0, DEPCMD_SETSTALL, 0, 0, 0);
+	ud_start_setup();
+}
+
+/*
+ * USB descriptors: a CDC-ECM (Ethernet) function, which Linux (cdc_ether)
+ * and macOS drive without extra drivers. VID 0x1209 / PID 0x0001 =
+ * pid.codes test ID, not a product.
+ */
+static const uint8_t ud_dev_desc[18] = {
+	18, 1, 0x00, 0x02, 0x02, 0x00, 0x00, 64,
+	0x09, 0x12, 0x01, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_cfg_desc[80] = {
+	9, 2, 80, 0, 2, 1, 0, 0x80, 250,                /* config: 2 interfaces, 500 mA */
+	9, 4, 0, 0, 1, 0x02, 0x06, 0x00, 0,             /* comm interface 0: CDC ECM, 1 endpoint */
+	5, 0x24, 0x00, 0x10, 0x01,                      /* header, CDC 1.10 */
+	5, 0x24, 0x06, 0, 1,                            /* union: control 0, data 1 */
+	13, 0x24, 0x0f, 4, 0, 0, 0, 0, 0xea, 0x05, 0, 0, 0, /* ethernet: MAC string 4, max segment 1514 */
+	7, 5, 0x82, 0x03, 16, 0, 9,                     /* ep 0x82 interrupt IN, 16 bytes, 2^(9-1) uframes */
+	9, 4, 1, 0, 0, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 0: no endpoints */
+	9, 4, 1, 1, 2, 0x0a, 0x00, 0x00, 0,             /* data interface 1 alt 1: two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
+/* The host side's MAC (ECM iMACAddress); the phone's own is ..:02 */
+static const char *const ud_strings[] = {
+	NULL, "ios-negroni", "Negroni iOS (USB Ethernet)", "0001", "02005E77EE01",
+};
+static const uint8_t ud_phone_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x02 };
+static const uint8_t ud_host_mac[ETHER_ADDR_LEN] = { 0x02, 0x00, 0x5e, 0x77, 0xee, 0x01 };
+
+static uint32_t
+ud_string(unsigned idx, uint8_t *out)
+{
+	if (idx == 0) {
+		out[0] = 4; out[1] = 3; out[2] = 0x09; out[3] = 0x04;   /* en-US */
+		return 4;
+	}
+	if (idx >= sizeof(ud_strings) / sizeof(ud_strings[0])) {
+		return 0;
+	}
+	const char *str = ud_strings[idx];
+	uint32_t n = 2;
+	for (; *str && n < 126; str++) {
+		out[n++] = (uint8_t)*str;
+		out[n++] = 0;
+	}
+	out[0] = (uint8_t)n;
+	out[1] = 3;
+	return n;
+}
+
+static void ud_rx_arm(void);
+static void ud_tx_kick_locked(void);
+static void ud_link_event(bool up);
+static int ud_reset_drop = 1;           /* 0282: boot-arg negroniusb_resetdrop (0 = the old behaviour) */
+static int ud_reset_end = 1;            /* 0366: boot-arg negroniusb_resetend: ENDTRANSFER on reset/disconnect */
+static int ud_reconnect_s = 5;          /* 0366: boot-arg negroniusb_reconnect: s without SOF before a soft reconnect */
+static int ud_more_events = 1;          /* 0366: boot-arg negroniusb_events: 0 = DEVTEN 0x7 (the old mask), 1 = + wakeup/suspend/erratic (Linux set, default), 2 = + link state change */
+static int ud_phycfg = 1;               /* 0366: boot-arg negroniusb_phycfg: clear GUSB2PHYCFG SUSPHY/ENBLSLPM */
+static int ud_lost_reboot_s = 0;        /* 0371: boot-arg negroniusb_lost_reboot: s without host before a reboot (0 = off) */
+static int ud_idle_reboot_s = 0;        /* 0375: boot-arg negroniusb_idle_reboot: s without USB data before a reboot (0 = off) */
+/*
+ * 0381: boot-arg negroniusb_datafix (README-usb.md "0381"), default 0 = off. Bits:
+ *   1 re-init: when the host enumerated the device (SET_INTERFACE alt 1) and sends SOFs, but no frame
+ *     comes from it for negroniusb_datafix_s s, or an IN transfer stays active that long: two state
+ *     lines, then soft reconnect with a PHY init (also past the 5 per ADSP start), TX queue dropped,
+ *     ue0 up again (192.168.7.2 added again if it is gone), new log socket. At most 3 per episode.
+ *   2 raw link: the live log goes as raw UDP frames to the host MAC (no socket, no route, no ARP), and
+ *     ud_thread answers ARP requests for 192.168.7.2 itself (the frame still goes to the stack).
+ *   4 watch only: the state lines of bit 1, no re-init (bit 1 is then ignored).
+ *   8 full speed: a link that comes up at full speed gets 64-byte bulk packets (descriptor and
+ *     endpoints); before, 512 (a high-speed-only value) in both.
+ */
+#define UD_DF_REINIT    1
+#define UD_DF_RAW       2
+#define UD_DF_WATCH     4
+#define UD_DF_FS        8
+#define UD_DF_TRIES     3
+static int ud_datafix = 0;              /* 0381: boot-arg negroniusb_datafix */
+static int ud_datafix_s = 10;           /* 0381: boot-arg negroniusb_datafix_s (3..120) */
+
+/* 0381: bulk max packet of the current link: 64 at full speed with bit 8, else 512 */
+static uint32_t
+ud_bulk_mps(void)
+{
+	return (ud_datafix & UD_DF_FS) && (ud.speed == 1 || ud.speed == 3) ? 64 : 512;
+}
+
+/* 0375: ud_thread steps for the stall line of ud_idle_thread */
+enum { UD_AT_START, UD_AT_EVENTS, UD_AT_RXPOLL, UD_AT_CTLPOLL, UD_AT_LINKWATCH, UD_AT_HPWATCH, UD_AT_SLEEP,
+       UD_AT_LINKEVENT, UD_AT_IFINPUT, UD_AT_TXLOCK, UD_AT_DROPLOCK, UD_AT_RECONNECT, UD_AT_DATAWATCH, UD_AT_N };
+static const char *const ud_at_names[UD_AT_N] = {
+	"start", "events", "rx poll", "ctl poll", "link watch", "PHY watch", "sleep",
+	"dlil_post_msg (link event)", "ifnet_input", "ud.lock (TX complete)", "ud.lock (drop data)", "soft reconnect",
+	"data watch (0381)",
+};
+static void ud_drop_data(void);
+static void ud_end_transfer(unsigned ep);
+static bool ud_ctl_input(const uint8_t *frame, uint32_t len);
+static void ud_panic_rx(const uint8_t *frame, uint32_t len);
+static void ud_arp_answer(const uint8_t *frame, uint32_t len);      /* 0381 */
+
+/* NETWORK_CONNECTION notification: the host brings its link up on it. */
+static void
+ud_notify_connected(void)
+{
+	uint8_t *n = (uint8_t *)(ud.dma + UD_NOTIFY);
+	n[0] = 0xa1; n[1] = 0x00;       /* NETWORK_CONNECTION */
+	n[2] = 1; n[3] = 0;             /* connected */
+	n[4] = 0; n[5] = 0;             /* interface 0 */
+	n[6] = 0; n[7] = 0;
+	if (ud_reset_end) {
+		ud_end_transfer(EP_INT);        /* 0366: an old notification the host never read */
+	}
+	ud_start_trb(EP_INT, UD_TRB_INT, UD_NOTIFY, 8, TRBCTL_NORMAL);
+}
+
+/* SET_CONFIGURATION(1): bulk IN/OUT and the interrupt endpoint. */
+static void
+ud_configure(void)
+{
+	if (ud.configured) {
+		return;
+	}
+	uint32_t mps = ud_bulk_mps();   /* 0381: 512, or 64 on a full-speed link with negroniusb_datafix bit 8 */
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG | (2u << 16), 0, 0, 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETEPCONFIG, (2u << 1) | (mps << 3), (1u << 8) | ((uint32_t)EP_RX << 25), 0) ||
+	    ud_epcmd(EP_RX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETEPCONFIG, (2u << 1) | (mps << 3) | (1u << 17), (1u << 8) | ((uint32_t)EP_TX << 25), 0) ||
+	    ud_epcmd(EP_TX, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETEPCONFIG, (3u << 1) | (16u << 3) | (2u << 17),
+	    (1u << 8) | (8u << 16) | ((uint32_t)EP_INT << 25), 0) ||
+	    ud_epcmd(EP_INT, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("NEGRONI USB: data endpoints setup failed\n");
+		return;
+	}
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) | (1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT));
+	ud.configured = true;
+	ud.ever_configured = true;      /* 0371 */
+	ud_rx_arm();
+	printf("NEGRONI USB: ECM endpoints configured\n");
+}
+
+static void
+ud_setup(void)
+{
+	const uint8_t *st = (const uint8_t *)(ud.dma + UD_SETUP);
+	uint8_t *data = (uint8_t *)(ud.dma + UD_DATA);
+	uint8_t type = st[0], req = st[1];
+	uint16_t value = (uint16_t)(st[2] | st[3] << 8);
+	uint16_t index = (uint16_t)(st[4] | st[5] << 8);
+	uint16_t length = (uint16_t)(st[6] | st[7] << 8);
+	uint32_t n = 0;
+	bool ok = true;
+
+	printf("NEGRONI USB: setup %02x %02x %04x %04x len %u\n", type, req, value, index, length);
+	ud.data_in = (type & 0x80) != 0;
+	if ((type & 0x60) == 0x20) {    /* class request (e.g. SET_ETHERNET_PACKET_FILTER) */
+		ok = (length == 0);
+	} else if ((type & 0x60) != 0) {
+		ok = false;
+	} else if (req == 6) {          /* GET_DESCRIPTOR */
+		switch (value >> 8) {
+		case 1: memcpy(data, ud_dev_desc, sizeof(ud_dev_desc)); n = sizeof(ud_dev_desc); break;
+		case 2:
+			memcpy(data, ud_cfg_desc, sizeof(ud_cfg_desc));
+			n = sizeof(ud_cfg_desc);
+			if (ud_bulk_mps() == 64) {
+				/* 0381: full speed: wMaxPacketSize 64 of ep 0x81 (bytes 70-71) and ep 0x01 (77-78) */
+				data[70] = 64; data[71] = 0;
+				data[77] = 64; data[78] = 0;
+			}
+			break;
+		case 3: n = ud_string(value & 0xff, data); ok = n != 0; break;
+		default: ok = false; break;
+		}
+	} else if (req == 5) {          /* SET_ADDRESS: takes effect now (DWC3 handles the timing) */
+		uint32_t dcfg = dwc_rd(DCFG) & ~(0x7fu << 3);
+		dwc_wr(DCFG, dcfg | ((uint32_t)(value & 0x7f) << 3));
+		printf("NEGRONI USB: address %u\n", value & 0x7f);
+	} else if (req == 9) {          /* SET_CONFIGURATION */
+		if (value == 1) {
+			ud_configure();
+		} else if (value == 0 && ud.configured && ud_reset_end) {
+			ud_drop_data();         /* 0366: the host deconfigured the device */
+		}
+		printf("NEGRONI USB: configured (%u)\n", value);
+	} else if (req == 8) {          /* GET_CONFIGURATION */
+		data[0] = ud.configured ? 1 : 0; n = 1;
+	} else if (req == 0) {          /* GET_STATUS */
+		data[0] = 0; data[1] = 0; n = 2;
+	} else if (req == 11) {         /* SET_INTERFACE */
+		if (index == 1) {
+			ud.data_alt = (uint8_t)value;
+			if (value == 1 && ud.configured) {
+				ud.alt1_at = mach_absolute_time();      /* 0381: the host's link up */
+				ud_notify_connected();
+				ud_link_event(true);
+			}
+		}
+	} else if (req == 10) {         /* GET_INTERFACE */
+		data[0] = index == 1 ? ud.data_alt : 0; n = 1;
+	} else if (req == 1 || req == 3) { /* CLEAR/SET_FEATURE (halt, remote wakeup) */
+	} else {
+		ok = false;
+	}
+	if (!ok) {
+		ud_stall();
+		return;
+	}
+	if (length == 0) {
+		ud.state = EP0_WAIT_STATUS2;    /* status stage on XferNotReady */
+		return;
+	}
+	ud.state = EP0_DATA;
+	if (ud.data_in) {
+		if (n > length) {
+			n = length;
+		}
+		ud_start(1, UD_DATA, n, TRBCTL_DATA);
+	} else {
+		ud_start(0, UD_DATA, 64, TRBCTL_DATA);  /* OUT data is not used here */
+	}
+}
+
+/* ---- network interface (ue0) ---- */
+
+static void ud_rx_ring_start(void);
+
+static void
+ud_rx_arm(void)
+{
+	if (ud_ring) {
+		ud_rx_ring_start();
+		return;
+	}
+	ud_start_trb(EP_RX, UD_TRB_RX, UD_RX, UD_FRAME_MAX, TRBCTL_NORMAL);
+}
+
+/*
+ * One received frame at buf. Frames for the stack are copied into an mbuf
+ * and appended to the chain head/tail (one ifnet_input per poll, 0361).
+ */
+static void
+ud_rx_frame(const uint8_t *buf, uint32_t len, mbuf_t *head, mbuf_t *tail, struct ifnet_stat_increment_param *stats)
+{
+	if (ud_in_panic) {
+		/* 0360: no network stack in panic mode; only ARP and the command server */
+		if (len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
+			ud.rx_frames++;
+			ud_panic_rx(buf, len);
+		}
+		return;
+	}
+	if (len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
+		ud.out_at = mach_absolute_time();       /* 0375: a host frame reached the OUT path */
+		ud.out_frames++;
+		if (ud_datafix != 0) {
+			ud_arp_answer(buf, len);        /* 0381: counts ARP for 192.168.7.2; answers it with bit 2 */
+		}
+	}
+	if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN &&
+	    ud_ctl_input(buf, len)) {
+		ud.rx_frames++;         /* a command: taken before the stack */
+	} else if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
+		/*
+		 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket
+		 * may return a first mbuf of length 0: stripping the header from
+		 * it panicked "Failed mbuf validity check: len -14".)
+		 */
+		mbuf_t m = NULL;
+		if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) == 0 &&
+		    (mbuf_flags(m) & MBUF_EXT) && mbuf_maxlen(m) >= len) {
+			memcpy(mbuf_data(m), buf, len);
+			mbuf_setlen(m, len);
+			mbuf_pkthdr_setlen(m, len);
+			void *frame_header = mbuf_data(m);
+			mbuf_pkthdr_setrcvif(m, ud.ifp);
+			mbuf_pkthdr_setheader(m, frame_header);
+			mbuf_pkthdr_adjustlen(m, -ETHER_HDR_LEN);
+			(void)mbuf_setdata(m, (char *)mbuf_data(m) + ETHER_HDR_LEN, mbuf_len(m) - ETHER_HDR_LEN);
+			stats->packets_in++;
+			stats->bytes_in += len;
+			ud.rx_frames++;
+			ud.rx_bytes += len;
+			if (*tail != NULL) {
+				mbuf_setnextpkt(*tail, m);
+			} else {
+				*head = m;
+			}
+			*tail = m;
+		} else if (m != NULL) {
+			mbuf_freem(m);
+		}
+	}
+}
+
+static void
+ud_rx_input(mbuf_t head, struct ifnet_stat_increment_param *stats)
+{
+	if (head != NULL) {
+		uint32_t was = ud.where;
+		ud.where = UD_AT_IFINPUT;       /* 0375 */
+		ifnet_input(ud.ifp, head, stats);
+		ud.where = was;
+	}
+}
+
+static void
+ud_rx_done(void)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
+	struct ifnet_stat_increment_param stats = {};
+	mbuf_t head = NULL, tail = NULL;
+
+	ud_sync(UD_TRB_RX, 16);
+	ud.last_rx = mach_absolute_time();      /* 0382 */
+	uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
+	ud_sync(UD_RX, UD_FRAME_MAX);
+	ud_rx_frame((const uint8_t *)(ud.dma + UD_RX), len, &head, &tail, &stats);
+	ud_rx_input(head, &stats);
+	ud_rx_arm();
+}
+
+/* ---- 0361: RX ring ---- */
+
+static void
+ud_rx_ring_set(unsigned i)
+{
+	volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_RING_TRBS + 16 * i);
+	uint64_t bpa = ud.dma_pa + UD_RXBUF + (uint64_t)i * UD_FRAME_MAX;
+
+	t[0] = (uint32_t)bpa;
+	t[1] = (uint32_t)(bpa >> 32);
+	t[2] = UD_FRAME_MAX;
+	/* CSP: a short packet (the end of a frame) completes this TRB and the controller goes on with the next */
+	t[3] = TRBCTL_NORMAL | TRB_CSP | TRB_HWO;
+}
+
+static void
+ud_rx_ring_start(void)
+{
+	volatile uint32_t *link = (volatile uint32_t *)(ud.dma + UD_RING_TRBS + 16 * UD_RXN);
+	uint64_t rpa = ud.dma_pa + UD_RING_TRBS;
+
+	for (unsigned i = 0; i < UD_RXN; i++) {
+		ud_rx_ring_set(i);
+	}
+	link[0] = (uint32_t)rpa;
+	link[1] = (uint32_t)(rpa >> 32);
+	link[2] = 0;
+	link[3] = TRBCTL_LINK | TRB_HWO;
+	ud_sync(UD_RING_TRBS, 16 * (UD_RXN + 1));
+	ud_sync(UD_RXBUF, UD_RXN * UD_FRAME_MAX);
+	ud.rx_idx = 0;
+	ud.rx_started = false;
+	if (ud_epcmd(EP_RX, DEPCMD_STARTTRANSFER, (uint32_t)(rpa >> 32), (uint32_t)rpa, 0) == 0) {
+		ud.rx_rsc = (dwc_rd(DEPCMD(EP_RX)) >> 16) & 0x7f;
+		ud.rx_started = true;
+	}
+}
+
+/*
+ * Every frame the controller has written since the last call (in ring
+ * order), from ud_thread or the panic loop. A TRB is armed again only
+ * when its whole cache line (4 TRBs) is done; then one UPDATETRANSFER.
+ */
+static void
+ud_rx_ring_poll(void)
+{
+	struct ifnet_stat_increment_param stats = {};
+	mbuf_t head = NULL, tail = NULL;
+	uint32_t frames = 0;
+	bool rearmed = false;
+
+	if (!ud_ring || !ud.rx_started || !ud.configured) {
+		return;
+	}
+	for (;;) {
+		unsigned i = ud.rx_idx;
+		volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_RING_TRBS + 16 * i);
+		ud_sync(UD_RING_TRBS + 16 * i, 16);
+		if (t[3] & TRB_HWO) {
+			break;
+		}
+		uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
+		ud_sync(UD_RXBUF + i * UD_FRAME_MAX, UD_FRAME_MAX);
+		ud_rx_frame((const uint8_t *)(ud.dma + UD_RXBUF + i * UD_FRAME_MAX), len, &head, &tail, &stats);
+		frames++;
+		/* the controller must not see this TRB again before it is armed: HWO stays 0 until the line is done */
+		if ((i & 3) == 3) {
+			for (unsigned j = i - 3; j <= i; j++) {
+				ud_rx_ring_set(j);
+			}
+			ud_sync(UD_RXBUF + (i - 3) * UD_FRAME_MAX, 4 * UD_FRAME_MAX);
+			ud_sync(UD_RING_TRBS + 16 * (i - 3), 64);
+			rearmed = true;
+		}
+		ud.rx_idx = (i + 1) % UD_RXN;
+		if (frames >= UD_RXN) {
+			break;
+		}
+	}
+	if (rearmed) {
+		(void)ud_epcmd(EP_RX, DEPCMD_UPDATETRANSFER | (ud.rx_rsc << 16), 0, 0, 0);
+	}
+	if (frames) {
+		if (frames > ud.rx_max_poll) {
+			ud.rx_max_poll = frames;
+		}
+		ud.last_active = mach_absolute_time();
+		ud.last_rx = ud.last_active;    /* 0382 */
+	}
+	if (!ud_in_panic) {
+		ud_rx_input(head, &stats);
+	}
+}
+
+/*
+ * Start the queued frames if the IN endpoint is idle. ud.lock held. 0361:
+ * up to UD_TXB frames in one transfer, one TRB each (not chained: each
+ * frame ends with its own short packet); negroniusb_ring=0: one frame.
+ */
+static void
+ud_tx_kick_locked(void)
+{
+	unsigned n = 0, max = ud_ring ? UD_TXB : 1;
+	volatile uint32_t *t = NULL;
+
+	if (ud.tx_busy || !ud.configured) {
+		return;
+	}
+	while (n < max && ud.txq_count > 0) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN) {
+			mbuf_freem(m);
+			continue;
+		}
+		uint32_t boff = ud_ring ? UD_TXBUF + n * UD_FRAME_MAX : UD_TX;
+		mbuf_copydata(m, 0, len, (void *)(ud.dma + boff));
+		mbuf_freem(m);
+		/* A frame of a multiple of the max packet (512, 0381: 64 at full
+		 * speed) would need a zero-length packet to end it; one pad byte
+		 * does the same (IP ignores it). */
+		if ((len % ud_bulk_mps()) == 0) {
+			((uint8_t *)(ud.dma + boff))[len++] = 0;
+		}
+		ud.tx_frames++;
+		ud.tx_bytes += len;
+		if (!ud_ring) {
+			ud.tx_start_at = mach_absolute_time();  /* 0375: before tx_busy (ud_idle_thread reads tx_busy first) */
+			__atomic_store_n(&ud.tx_busy, true, __ATOMIC_RELEASE);
+			ud.tx_batch = false;
+			ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, (uint32_t)len, TRBCTL_NORMAL);
+			return;
+		}
+		uint64_t bpa = ud.dma_pa + boff;
+		t = (volatile uint32_t *)(ud.dma + UD_TXB_TRBS + 16 * n);
+		t[0] = (uint32_t)bpa;
+		t[1] = (uint32_t)(bpa >> 32);
+		t[2] = (uint32_t)len;
+		t[3] = TRBCTL_NORMAL | TRB_HWO;
+		ud_sync(boff, (uint32_t)len);
+		n++;
+	}
+	if (n == 0) {
+		return;
+	}
+	t[3] |= TRB_LST | TRB_IOC;
+	ud_sync(UD_TXB_TRBS, 16 * n);
+	if (n > ud.tx_max_batch) {
+		ud.tx_max_batch = n;
+	}
+	ud.last_active = mach_absolute_time();
+	ud.tx_start_at = ud.last_active;        /* 0375: before tx_busy (ud_idle_thread reads tx_busy first) */
+	__atomic_store_n(&ud.tx_busy, true, __ATOMIC_RELEASE);
+	ud.tx_batch = true;
+	uint64_t tpa = ud.dma_pa + UD_TXB_TRBS;
+	ud_epcmd(EP_TX, DEPCMD_STARTTRANSFER, (uint32_t)(tpa >> 32), (uint32_t)tpa, 0);
+}
+
+static errno_t
+ud_if_output(ifnet_t ifp, mbuf_t m)
+{
+	lck_mtx_lock(ud.lock);
+	if (ud.txq_count == UD_TXQ || !ud.configured) {
+		ud.tx_drops++;
+		lck_mtx_unlock(ud.lock);
+		mbuf_freem(m);
+		ifnet_stat_increment_out(ifp, 0, 0, 1);
+		return 0;
+	}
+	ifnet_stat_increment_out(ifp, 1, mbuf_pkthdr_len(m), 0);
+	ud.txq[(ud.txq_head + ud.txq_count) % UD_TXQ] = m;
+	ud.txq_count++;
+	ud_tx_kick_locked();
+	lck_mtx_unlock(ud.lock);
+	if (__atomic_load_n(&ud.poll_long, __ATOMIC_SEQ_CST)) {
+		thread_wakeup((event_t)&ud.poll_chan);  /* 0382: the completion is seen within 1 ms, not one idle period */
+	}
+	return 0;
+}
