+	return __atomic_load_n(&adsp_phase, __ATOMIC_ACQUIRE);
+}
+
+/* 0376: lcx/lmx are one APPS vote for both DSPs; the SLPI keeps its vote while the ADSP holds them */
+bool
+negroni_adsp_rails_held(void)
+{
+	return rails_on;
+}
+
+#define say(fmt, ...) printf("NEGRONI ADSP: %u " fmt "\n", step, ##__VA_ARGS__)
+/* the reason of a failed step: kept for the "step N failed" line, and logged at once */
+#define FAIL(fmt, ...) do { snprintf(fail_why, sizeof(fail_why), fmt, ##__VA_ARGS__); say("stop: %s", fail_why); } while (0)
+
+static void
+announce(const char *what)
+{
+	say("about to: %s", what);
+	if (pause_ms) {
+		IOSleep(pause_ms);
+	}
+}
+
+/* 32-bit accesses only (SMEM, QMP message RAM and IPCC implement 32-bit accesses). */
+static uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb osh" ::: "memory");
+	return v;
+}
+
+static void
+wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb osh" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static int32_t
+scm(const char *what, uint64_t function, uint64_t args, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t *answer)
+{
+	/*
+	 * Linux drivers/firmware/qcom/qcom_scm-smc.c: resume an interrupted call (x0 = 1, same args, x6 = session) until
+	 * it ends; retry a busy TrustZone (QCOM_SCM_V2_EBUSY -12) with 30 ms sleeps, 20 times; WAITQ_SLEEP (2) needs the
+	 * SCM interrupt this port does not wire: report and fail (review 2026-10-27).
+	 */
+	uint64_t t0 = mach_absolute_time(), ns;
+
+	say("SCM %s: smc %#llx (%#llx, %#llx, %#llx)", what, function, a0, a1, a2);
+	for (int busy = 0; busy <= 20; busy++) {
+		uint64_t session = 0;
+		int i;
+		for (i = 0; i < 2000000; i++) {
+			register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+			register uint64_t x1 __asm__("x1") = args;
+			register uint64_t x2 __asm__("x2") = a0;
+			register uint64_t x3 __asm__("x3") = a1;
+			register uint64_t x4 __asm__("x4") = a2;
+			register uint64_t x5 __asm__("x5") = 0;
+			register uint64_t x6 __asm__("x6") = session;
+			register uint64_t x7 __asm__("x7") = 0;
+
+			__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+			    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+			session = x6;
+			if (x0 == SCM_INTERRUPTED) {
+				continue;
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			if ((int32_t)x0 == -12 && busy < 20) {
+				say("SCM %s: TrustZone busy (-12), retry %d in 30 ms", what, busy + 1);
+				IOSleep(30);
+				break;
+			}
+			if (x0 == 2) {
+				say("SCM %s: WAITQ_SLEEP (wq_ctx %#llx, ctx %#llx) after %d resumes, %llu ms: not supported",
+				    what, x1, x2, i, ns / 1000000);
+				return -1;
+			}
+			say("SCM %s -> %d, answer %#llx (%d resumes, %llu ms)", what, (int32_t)x0, x1, i, ns / 1000000);
+			*answer = x1;
+			return (int32_t)x0;
+		}
+		if (i == 2000000) {
+			break;
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	say("SCM %s keeps returning interrupted or busy (%llu ms)", what, ns / 1000000);
+	return -1;
+}
+
+/* ---- SMEM ---- */
+
+/* Partition of hosts (a, b): offset from the SMEM base, 0 if none. */
+static uint32_t
+smem_partition(uint16_t a, uint16_t b, uint32_t *size, uint32_t *cacheline)
+{
+	uint32_t toc = SMEM_SIZE - 0x1000;
+
+	if (rd32(smem, toc) != 0x434f5424 /* "$TOC" */ || rd32(smem, toc + 4) != 1) {
+		return 0;
+	}
+	uint32_t count = rd32(smem, toc + 8);
+	for (uint32_t i = 0; i < count && i < 64; i++) {
+		uint32_t e = toc + 32 + 48 * i;
+		uint32_t off = rd32(smem, e), sz = rd32(smem, e + 4), hosts = rd32(smem, e + 12);
+		uint16_t h0 = (uint16_t)hosts, h1 = (uint16_t)(hosts >> 16);
+		if (off == 0 || sz == 0 || !((h0 == a && h1 == b) || (h0 == b && h1 == a))) {
+			continue;
+		}
+		if ((uint64_t)off + sz > toc || rd32(smem, off) != 0x54525024 /* "$PRT" */ || rd32(smem, off + 8) != sz) {
+			return 0;
+		}
+		*size = sz;
+		*cacheline = rd32(smem, e + 16);
+		return off;
+	}
+	return 0;
+}
+
+/* Item in partition p (uncached list, then cached list): offset of its data, 0 if absent. */
+static uint32_t
+smem_find_in(uint32_t p, uint32_t psize, uint32_t cacheline, uint32_t item, uint32_t *size)
+{
+	uint32_t free_uncached = rd32(smem, p + 12), free_cached = rd32(smem, p + 16);
+
+	if (free_uncached > psize || free_cached > psize) {
+		return 0;
+	}
+	for (uint32_t at = 32; at + 16 <= free_uncached;) {
+		uint32_t w0 = rd32(smem, p + at), sz = rd32(smem, p + at + 4), pad = rd32(smem, p + at + 8);
+		if ((w0 & 0xffff) != SMEM_CANARY || sz > psize) {
+			break;
+		}
+		if ((w0 >> 16) == item) {
+			*size = sz - (pad & 0xffff);
+			return p + at + 16 + (pad >> 16);
+		}
+		at += 16 + (pad >> 16) + sz;
+	}
+	if (cacheline == 0 || (cacheline & (cacheline - 1))) {
+		return 0;
+	}
+	uint32_t back = (16 + cacheline - 1) & ~(cacheline - 1);
+	for (uint32_t at = psize - back; at > free_cached && at < psize;) {
+		uint32_t w0 = rd32(smem, p + at), sz = rd32(smem, p + at + 4), pad = rd32(smem, p + at + 8);
+		if ((w0 & 0xffff) != SMEM_CANARY || sz > at) {
+			break;
+		}
+		if ((w0 >> 16) == item) {
+			*size = sz - (pad & 0xffff);
+			return p + at - sz;
+		}
+		if (sz + back > at) {
+			break;
+		}
+		at -= sz + back;
+	}
+	return 0;
+}
+
+static uint32_t
+smem_item(uint32_t item, uint32_t *size)
+{
+	static const uint16_t hosts[2][2] = { { SMEM_APPS, SMEM_ADSP }, { SMEM_GLOBAL, SMEM_GLOBAL } };
+
+	for (unsigned h = 0; h < 2; h++) {
+		uint32_t psize = 0, cacheline = 0, p = smem_partition(hosts[h][0], hosts[h][1], &psize, &cacheline);
+		uint32_t at = p ? smem_find_in(p, psize, cacheline, item, size) : 0;
+		if (at) {
+			return at;
+		}
+	}
+	return 0;
+}
+
+static void
+last_words(void)
+{
+	char text[81];
+	uint32_t size = 0, at = smem_item(ITEM_CRASH_REASON, &size);
+
+	if (at == 0 || size == 0) {
+		say("item %u (last words): not there", ITEM_CRASH_REASON);
+		return;
+	}
+	bzero(text, sizeof(text));
+	for (uint32_t i = 0; i < MIN(size, (uint32_t)sizeof(text) - 1) / 4; i++) {
+		uint32_t w = rd32(smem, at + 4 * i);
+		memcpy(text + 4 * i, &w, 4);
+	}
+	say("ADSP LAST WORDS (item %u, %u bytes): \"%s\"", ITEM_CRASH_REASON, size, text);
+}
+
+/* Value of entry `name` in an SMP2P item at `at`; false if the entry is not there. */
+static bool
+smp2p_value(uint32_t at, const char *name, uint32_t *value)
+{
+	if (rd32(smem, at) != SMP2P_MAGIC) {
+		return false;
+	}
+	uint32_t valid = rd32(smem, at + 12) >> 16;
+	for (uint32_t i = 0; i < valid && i < SMP2P_ENTRIES; i++) {
+		char n[17];
+		for (uint32_t w = 0; w < 4; w++) {
+			uint32_t v = rd32(smem, at + 20 + 20 * i + 4 * w);
+			memcpy(n + 4 * w, &v, 4);
+		}
+		n[16] = 0;
+		if (strncmp(n, name, 16) == 0) {
+			*value = rd32(smem, at + 36 + 20 * i);
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool
+step_survey(void)
+{
+	uint32_t psize = 0, cacheline = 0, size = 0, p, at, value = 0;
+	uint64_t answer = 0;
+
+	if (smem == 0) {
+		/* kept for the life of the system (GLINK, stage (b), reads it too) */
+		smem = ml_io_map_unmappable(SMEM_PHYS, SMEM_SIZE, ADSP_WIMG_WCOMB);
+	}
+	if (smem == 0) {
+		FAIL("no mapping of SMEM %#lx + %#x", SMEM_PHYS, SMEM_SIZE);
+		return false;
+	}
+	p = smem_partition(SMEM_APPS, SMEM_ADSP, &psize, &cacheline);
+	if (p == 0) {
+		FAIL("no SMEM partition for hosts 0/2 ($TOC %#x)", rd32(smem, SMEM_SIZE - 0x1000));
+		return false;
+	}
+	say("SMEM partition 0/2 at %#lx, %#x bytes, cacheline %u, free uncached %#x cached %#x", SMEM_PHYS + p, psize,
+	    cacheline, rd32(smem, p + 12), rd32(smem, p + 16));
+	at = smem_item(ITEM_SMP2P_THEIRS, &size);
+	if (at != 0) {
+		bool have = smp2p_value(at, "slave-kernel", &value);
+		FAIL("ADSP SMP2P item %u is there (slave-kernel %s %#x): the ADSP has run since the reset; "
+		    "not started twice", ITEM_SMP2P_THEIRS, have ? "=" : "missing", value);
+		last_words();
+		return false;
+	}
+	say("no ADSP SMP2P item %u: the ADSP has not run since the reset", ITEM_SMP2P_THEIRS);
+	at = smem_item(ITEM_SMP2P_OURS, &size);
+	say("our SMP2P item %u: %s", ITEM_SMP2P_OURS, at ? "present (an earlier kernel made it)" : "absent");
+	/*
+	 * 0241: on the NE2211 this query answers 0 for image 1 (USB log 2026-10-26 00:00:35, smc 0x42000207
+	 * -> 0, answer 0), but Linux's qcom_q6v5_pas never asks it (only the mss and wcnss drivers do), and the
+	 * GPU zap PAS calls with the same encoding succeed on this TrustZone. So the answer is logged, not obeyed.
+	 */
+	scm("PAS is supported (adsp)", SCM_64 | SCM_SIP | SCM_PAS_IS_SUPPORTED, SCM_ONE_VALUE, PAS_ADSP, 0, 0, &answer);
+	if (answer != 1) {
+		say("note: TrustZone does not report PAS image %u as supported (answer %#llx); Linux never asks, so "
+		    "the steps go on", PAS_ADSP, answer);
+	}
+	return true;
+}
+
+/* ---- firmware area ---- */
+
+static const struct area_entry *
+area_file(const char *name)
+{
+	for (uint32_t i = 0; area && i < area->count; i++) {
+		if (strncmp(area->entry[i].name, name, sizeof(area->entry[i].name)) == 0) {
+			return &area->entry[i];
+		}
+	}
+	return NULL;
+}
+
+/* SHA-256 of an area file, read in CHUNK pieces through buf (kmem, CHUNK bytes). */
+static bool
+area_check(const struct area_entry *e, uint8_t *buf)
+{
+	SHA256_CTX ctx;
+	uint8_t digest[32];
+
+	SHA256_Init(&ctx);
+	for (uint32_t at = 0; at < e->size; at += CHUNK) {
+		uint32_t n = MIN(CHUNK, e->size - at);
+		if (negroni_ufs_adsp_area_read(e->offset + at, buf, n) != 0) {
+			return false;
+		}
+		SHA256_Update(&ctx, buf, n);
+	}
+	SHA256_Final(digest, &ctx);
+	return memcmp(digest, e->sha256, 32) == 0;
+}
+
+static bool
+step_firmware(void)
+{
+	vm_offset_t a = 0, b = 0, m = 0;
+	const struct area_entry *e;
+	uint32_t phoff, phnum, bytes = 0;
+	bool ok = false;
+
+	if (kmem_alloc(kernel_map, &a, AREA_HEADER, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, &b, CHUNK, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		FAIL("no memory");
+		goto out;
+	}
+	area = (struct area_header *)a;
+	if (negroni_ufs_adsp_area_read(0, area, AREA_HEADER) != 0 || memcmp(area->magic, AREA_MAGIC, 8) != 0 ||
+	    area->version != 1 || area->count == 0 || area->count > AREA_MAX) {
+		FAIL("no ADSP firmware area (scripts/audio/mkadsparea.py + dd; magic %.8s)", area->magic);
+		goto out;
+	}
+	for (uint32_t i = 0; i < area->count; i++) {
+		struct area_entry *x = &area->entry[i];
+		x->name[47] = 0;
+		if (x->offset < AREA_HEADER || x->offset > AREA_SIZE || x->size > AREA_SIZE - x->offset) {
+			FAIL("area entry %u (%s) out of range", i, x->name);
+			goto out;
+		}
+	}
+	say("firmware area: %u files", area->count);
+	e = area_file("adsp.mdt");
+	if (e == NULL || e->size < 52 || e->size > PAGE_SIZE || !area_check(e, (uint8_t *)b)) {
+		FAIL("adsp.mdt missing, too big for one page, or SHA-256 mismatch");
+		goto out;
+	}
+	if (kmem_alloc(kernel_map, &m, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    negroni_ufs_adsp_area_read(e->offset, (void *)m, e->size) != 0) {
+		goto out;
+	}
+	mdt = (uint8_t *)m;
+	mdt_size = e->size;
+	memcpy(&phoff, mdt + 28, 4);
+	phnum = (uint32_t)(mdt[44] | mdt[45] << 8);
+	if (memcmp(mdt, "\177ELF\1\1", 6) != 0 || phnum == 0 || phnum > MAX_SEGMENTS || phoff + 32 * phnum > mdt_size) {
+		FAIL("adsp.mdt is not an ELF32 LE header with <= %u program headers", MAX_SEGMENTS);
+		goto out;
+	}
+	nseg = phnum;
+	min_pa = ~0u;
+	max_pa = 0;
+	for (uint32_t i = 0; i < nseg; i++) {
+		uint32_t ph[8];
+		memcpy(ph, mdt + phoff + 32 * i, sizeof(ph));
+		segs[i] = (struct seg){ ph[0], ph[1], ph[3], ph[4], ph[5], ph[6] };
+		if (segs[i].type != PT_LOAD || segs[i].memsz == 0 || MDT_TYPE(segs[i].flags) == MDT_TYPE_HASH) {
+			continue;
+		}
+		relocatable |= (segs[i].flags & MDT_RELOCATABLE) != 0;
+		min_pa = MIN(min_pa, segs[i].paddr);
+		max_pa = MAX(max_pa, segs[i].paddr + segs[i].memsz);
+		if (segs[i].filesz == 0) {
+			continue;
+		}
+		char name[16];
+		snprintf(name, sizeof(name), "adsp.b%02u", i);
+		const struct area_entry *f = area_file(name);
+		if (f == NULL || f->size != segs[i].filesz || segs[i].filesz > segs[i].memsz) {
+			FAIL("%s missing or not %u bytes", name, segs[i].filesz);
+			goto out;
+		}
+		if (!area_check(f, (uint8_t *)b)) {
+			FAIL("%s SHA-256 mismatch", name);
+			goto out;
+		}
+		bytes += f->size;
+	}
+	max_pa = (max_pa + 0xfff) & ~0xfffu;
+	say("adsp.mdt: %u program headers, load %#x..%#x (%u KiB), %u KiB of segments, %s", nseg, min_pa, max_pa,
+	    (max_pa - min_pa) >> 10, bytes >> 10, relocatable ? "relocatable" : "fixed");
+	if (min_pa == ~0u || max_pa - min_pa > ADSP_MEM_SIZE || (!relocatable && (min_pa < ADSP_MEM_PHYS ||
+	    max_pa > ADSP_MEM_PHYS + ADSP_MEM_SIZE))) {
+		FAIL("the image does not fit the carveout %#lx + %#x", ADSP_MEM_PHYS, ADSP_MEM_SIZE);
+		goto out;
+	}
+	ok = true;
+out:
+	if (b) {
+		kmem_free(kernel_map, b, CHUNK);
+	}
+	return ok;
+}
+
+/* ---- rails, AOP ---- */
+
+/*
+ * negroni_rpmh.c has one TCS behind a try-lock: it answers EBUSY while another thread (touch,
+ * Wi-Fi, GPU init run at the same time as this thread) sends. Retry for up to 1 s, and say so
+ * when a vote (or the drop of a vote) does not go through.
+ */
+static int
+rail_vote(const char *res, unsigned level)
+{
+	int error = EBUSY;
+
+	for (int i = 0; i < 200 && error == EBUSY; i++) {
+		error = negroni_rpmh_arc_vote(res, level);
+		if (error == EBUSY) {
+			IOSleep(5);
+		}
+	}
+	if (error != 0) {
+		say("RPMh vote %s level %u failed: errno %d", res, level, error);
+	}
+	return error;
+}
+
+static bool
+step_rails(void)
+{
+	announce("vote RPMh lcx.lvl and lmx.lvl to level 384 (ADSP proxy votes)");
+	if (rail_vote("lcx.lvl", 384) != 0 || rail_vote("lmx.lvl", 384) != 0) {
+		FAIL("rail vote failed");
+		return false;
+	}
+	rails_on = true;
+	return true;
+}
+
+static void
+kick(uint32_t client, uint32_t signal)
+{
+	wr32(ipcc, IPCC_SEND_ID, client << 16 | signal);
+}
+
+static bool
+qmp_wait(uint32_t off, uint32_t want, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms; i++) {
+		if (rd32(aoss, off) == want) {
+			return true;
+		}
+		IOSleep(1);
+	}
+	return rd32(aoss, off) == want;
+}
+
+static bool
+step_aop(void)
+{
+	static const char text[] = "{class: image, res: load_state, name: adsp, val: on}";
+	uint32_t words[QMP_MSG_LEN / 4] = { 0 }, box, boxsize;
+
+	if (ipcc == 0) {
+		ipcc = ml_io_map(IPCC_PHYS, 0x1000);
+	}
+	if (aoss == 0) {
+		aoss = ml_io_map(AOSS_PHYS, AOSS_SIZE);
+	}
+	if (rd32(aoss, QMP_MAGIC) != QMP_MAGIC_VALUE || rd32(aoss, QMP_VERSION) != 1) {
+		FAIL("AOSS QMP magic %#x version %u", rd32(aoss, QMP_MAGIC), rd32(aoss, QMP_VERSION));
+		return false;
+	}
+	box = rd32(aoss, QMP_MCORE_MBOX_OFFSET);
+	boxsize = rd32(aoss, QMP_MCORE_MBOX_SIZE);
+	if ((box & 3) || box < 0x3c || boxsize < QMP_MSG_LEN + 4 || box + boxsize > AOSS_SIZE) {
+		FAIL("QMP mailbox at %#x size %#x does not fit", box, boxsize);
+		return false;
+	}
+	if (rd32(aoss, QMP_MCORE_LINK) == QMP_UP && rd32(aoss, QMP_MCORE_LINK_ACK) == QMP_UP &&
+	    rd32(aoss, QMP_MCORE_CH) == QMP_UP && rd32(aoss, QMP_UCORE_CH) == QMP_UP && rd32(aoss, QMP_MCORE_CH_ACK) == QMP_UP) {
+		say("QMP link and channel are already up");
+	} else {
+		announce("open the QMP link and channel to the AOP (qmp_open)");
+		wr32(aoss, QMP_UCORE_LINK_ACK, rd32(aoss, QMP_UCORE_LINK));
+		wr32(aoss, QMP_MCORE_LINK, QMP_UP);
+		kick(IPCC_CLIENT_AOP, 0);
+		if (!qmp_wait(QMP_MCORE_LINK_ACK, QMP_UP, 1000)) {
+			FAIL("AOP does not ack our QMP link");
+			return false;
+		}
+		wr32(aoss, QMP_MCORE_CH, QMP_UP);
+		kick(IPCC_CLIENT_AOP, 0);
+		if (!qmp_wait(QMP_UCORE_CH, QMP_UP, 1000)) {
+			FAIL("AOP does not open its QMP channel");
+			return false;
+		}
+		wr32(aoss, QMP_UCORE_CH_ACK, QMP_UP);
+		kick(IPCC_CLIENT_AOP, 0);
+		if (!qmp_wait(QMP_MCORE_CH_ACK, QMP_UP, 1000)) {
+			FAIL("AOP does not ack our QMP channel");
+			return false;
+		}
+		say("QMP OPEN");
+	}
+	if (rd32(aoss, box) != 0) {
+		FAIL("QMP mailbox still holds %u bytes", rd32(aoss, box));
+		return false;
+	}
+	memcpy(words, text, sizeof(text));
+	announce("send the AOP \"adsp load_state on\"");
+	for (uint32_t i = 0; i < QMP_MSG_LEN / 4; i++) {
+		wr32(aoss, box + 4 + 4 * i, words[i]);
+	}
+	wr32(aoss, box, QMP_MSG_LEN);
+	kick(IPCC_CLIENT_AOP, 0);
+	if (!qmp_wait(box, 0, 1000)) {
+		wr32(aoss, box, 0);
+		FAIL("AOP does not take the QMP message");
+		return false;
+	}
+	say("AOP took \"%s\"", text);
+	return true;
+}
+
+/* ---- PAS ---- */
+
+static bool
+step_pas_init(void)
+{
+	vm_offset_t page = 0;
+	uint64_t answer = ~0ull;
+	uint32_t ehdr = segs[0].filesz, hash = ~0u;
+
+	for (uint32_t i = 0; i < nseg; i++) {
+		if (MDT_TYPE(segs[i].flags) == MDT_TYPE_HASH) {
+			hash = i;
+			break;
+		}
+	}
+	if (segs[0].type == PT_LOAD || hash == ~0u || ehdr == 0 || ehdr > mdt_size ||
+	    (uint64_t)ehdr + segs[hash].filesz > PAGE_SIZE) {
+		FAIL("no usable ELF-header/hash segments (hash segment %u)", hash);
+		return false;
+	}
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	/* qcom_mdt_read_metadata: ELF header + program headers, then the hash segment. */
+	memcpy((void *)page, mdt, ehdr);
+	if (ehdr + segs[hash].filesz == mdt_size) {
+		memcpy((void *)(page + ehdr), mdt + ehdr, segs[hash].filesz);           /* packed after the headers */
+	} else if ((uint64_t)segs[hash].offset + segs[hash].filesz <= mdt_size) {
+		memcpy((void *)(page + ehdr), mdt + segs[hash].offset, segs[hash].filesz);
+	} else {
+		char name[16];
+		snprintf(name, sizeof(name), "adsp.b%02u", hash);
+		const struct area_entry *f = area_file(name);
+		if (f == NULL || f->size != segs[hash].filesz ||
+		    negroni_ufs_adsp_area_read(f->offset, (void *)(page + ehdr), f->size) != 0) {
+			FAIL("hash segment %s not readable", name);
+			return false;
+		}
+	}
+	clean_dcache((vm_offset_t)page, PAGE_SIZE, FALSE);      /* TrustZone reads memory, not our cache */
+	/* page stays allocated: TrustZone may read it until auth and reset (Linux frees it after). */
+	announce("hand the ADSP metadata to TrustZone (PAS init image, id 1)");
+	if (scm("PAS init image (adsp)", SCM_64 | SCM_SIP | SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_ADSP,
+	    kvtophys(page), 0, &answer) != 0 || answer != 0) {
+		FAIL("TrustZone refuses the ADSP metadata (%#llx)", answer);
+		return false;
+	}
+	say("TRUSTZONE ACCEPTS THE ADSP SIGNATURE");
+	if (relocatable) {
+		answer = ~0ull;
+		if (scm("PAS mem setup (adsp)", SCM_64 | SCM_SIP | SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_ADSP, ADSP_MEM_PHYS,
+		    max_pa - min_pa, &answer) != 0 || answer != 0) {
+			FAIL("TrustZone refuses the carveout (%#llx)", answer);
+			return false;
+		}
+		say("TrustZone takes the carveout %#lx + %#x", ADSP_MEM_PHYS, max_pa - min_pa);
+	}
+	return true;
+}
+
+static void
+pas_shutdown(const char *why)
+{
+	uint64_t answer = ~0ull;
+
+	say("PAS shutdown: %s", why);
+	scm("PAS shutdown (adsp)", SCM_64 | SCM_SIP | SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_ADSP, 0, 0, &answer);
+}
+
+static bool
+step_load(void)
+{
+	vm_offset_t buf = 0;
+	volatile uint64_t *mem;
+	bool ok = false;
+
+	if (kmem_alloc(kernel_map, &buf, CHUNK, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	announce("zero the carveout 0x85700000 + 40 MiB and write the PT_LOAD segments");
+	/* kernel_map VA (not io_submap): ml_io_unmap at "out" removes it; ADSP_MEM_SIZE is 16 KiB aligned */
+	mem = (volatile uint64_t *)ml_io_map_unmappable(ADSP_MEM_PHYS, ADSP_MEM_SIZE, ADSP_WIMG_WCOMB);
+	if (mem == NULL) {
+		FAIL("no mapping of the carveout %#lx + %#x", ADSP_MEM_PHYS, ADSP_MEM_SIZE);
+		kmem_free(kernel_map, buf, CHUNK);
+		return false;
+	}
+	for (uint32_t i = 0; i < ADSP_MEM_SIZE / 8; i++) {
+		mem[i] = 0;
+	}
+	for (uint32_t i = 0; i < nseg; i++) {
+		struct seg *s = &segs[i];
+		if (s->type != PT_LOAD || s->memsz == 0 || MDT_TYPE(s->flags) == MDT_TYPE_HASH || s->filesz == 0) {
+			continue;
+		}
+		char name[16];
+		snprintf(name, sizeof(name), "adsp.b%02u", i);
+		const struct area_entry *f = area_file(name);
+		uint32_t base = (relocatable ? 0 : (uint32_t)(min_pa - ADSP_MEM_PHYS)) + (s->paddr - min_pa);
+		SHA256_CTX ctx;
+		uint8_t digest[32];
+
+		if (f == NULL || (base & 7)) {
+			FAIL("%s missing or not 8-byte aligned (+%#x)", name, base);
+			goto out;
+		}
+		for (uint32_t at = 0; at < f->size; at += CHUNK) {
+			uint32_t n = MIN(CHUNK, f->size - at);
+			if (negroni_ufs_adsp_area_read(f->offset + at, (void *)buf, n) != 0) {
+				FAIL("read error in %s", name);
+				goto out;
+			}
+			uint32_t words = n / 8;
+			const uint64_t *src = (const uint64_t *)buf;
+			for (uint32_t w = 0; w < words; w++) {
+				mem[(base + at) / 8 + w] = src[w];
+			}
+			for (uint32_t t = words * 8; t < n; t++) {
+				((volatile uint8_t *)mem)[base + at + t] = ((const uint8_t *)buf)[t];
+			}
+		}
+		/* read back */
+		SHA256_Init(&ctx);
+		for (uint32_t at = 0; at < f->size; at += CHUNK) {
+			uint32_t n = MIN(CHUNK, f->size - at);
+			for (uint32_t t = 0; t < n; t++) {
+				((uint8_t *)buf)[t] = ((volatile uint8_t *)mem)[base + at + t];
+			}
+			SHA256_Update(&ctx, (const void *)buf, n);
+		}
+		SHA256_Final(digest, &ctx);
+		if (memcmp(digest, f->sha256, 32) != 0) {
+			FAIL("%s does not read back from the carveout (+%#x)", name, base);
+			goto out;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	say("segments written at %#lx and read back OK", ADSP_MEM_PHYS);
+	ok = true;
+out:
+	ml_io_unmap((vm_offset_t)mem, ADSP_MEM_SIZE);
+	kmem_free(kernel_map, buf, CHUNK);
+	return ok;
+}
+
+/* ---- our SMP2P item ---- */
+
+/*
+ * Allocate item `item` of `bytes` in the apps<->ADSP partition, under TCSR mutex 3 (Linux
+ * qcom_smem_alloc_private: uncached list, size rounded to 8, padding_data = the rounding).
+ * An item that is already there counts as allocated.
+ */
+static bool
+smem_alloc(uint32_t item, uint32_t bytes)
+{
+	uint32_t psize = 0, cacheline = 0, p = smem_partition(SMEM_APPS, SMEM_ADSP, &psize, &cacheline);
+	uint32_t size = (bytes + 7) & ~7u, owner = ~0u, at, have = 0;
+	bool made = false;
+
+	if (p == 0) {
+		FAIL("no SMEM partition 0/2 for item %u", item);
+		return false;
+	}
+	if (smem_item(item, &have) != 0) {
+		say("SMEM item %u is there already (%u bytes)", item, have);
+		return true;
+	}
+	if (tcsr == 0) {
+		tcsr = ml_io_map(TCSR_MUTEX_PHYS, 0x1000);
+	}
+	for (uint32_t ms = 0; ms <= 1000; ms++) {
+		wr32(tcsr, 0, 1);               /* QCOM_MUTEX_APPS_PROC_ID */
+		owner = rd32(tcsr, 0);
+		if (owner == 1) {
+			break;
+		}
+		IOSleep(1);
+	}
+	if (owner != 1) {
+		FAIL("SMEM hwlock 3 held by %u (item %u)", owner, item);
+		return false;
+	}
+	uint32_t free_uncached = rd32(smem, p + 12), free_cached = rd32(smem, p + 16);
+	for (at = 32; at < free_uncached;) {
+		uint32_t w0 = rd32(smem, p + at), sz = rd32(smem, p + at + 4), pad = rd32(smem, p + at + 8);
+		if ((w0 & 0xffff) != SMEM_CANARY || (w0 >> 16) == item || sz > psize) {
+			break;
+		}
+		at += 16 + (pad >> 16) + sz;
+	}
+	if (at != free_uncached || free_uncached > free_cached || at + 16 + size > free_cached) {
+		FAIL("SMEM partition walk for item %u ends at +%#x, free uncached +%#x cached +%#x: nothing written", item, at,
+		    free_uncached, free_cached);
+		goto out;
+	}
+	wr32(smem, p + at, SMEM_CANARY | item << 16);
+	wr32(smem, p + at + 4, size);
+	wr32(smem, p + at + 8, size - bytes);                   /* padding_data, padding_hdr 0 */
+	wr32(smem, p + at + 12, 0);
+	wr32(smem, p + 12, at + 16 + size);
+	say("SMEM item %u: %u bytes at %#lx", item, bytes, SMEM_PHYS + p + at + 16);
+	made = true;
+out:
+	wr32(tcsr, 0, 0);
+	return made;
+}
+
+static bool
+step_smp2p(void)
+{
+	static const char name[16] = "master-kernel";
+	uint32_t size = 0, w[4];
+
+	announce("create/fill our SMP2P item 429 in SMEM (TCSR mutex 3) and ring the ADSP (IPCC 3/2)");
+	our_item = smem_item(ITEM_SMP2P_OURS, &size);
+	if (our_item == 0) {
+		if (!smem_alloc(ITEM_SMP2P_OURS, SMP2P_ITEM_SIZE)) {
+			return false;
+		}
+		our_item = smem_item(ITEM_SMP2P_OURS, &size);
+	}
+	if (our_item == 0 || size < SMP2P_ITEM_SIZE) {
+		FAIL("our item %u not found after allocation", ITEM_SMP2P_OURS);
+		return false;
+	}
+	for (uint32_t at = 0; at < SMP2P_ITEM_SIZE; at += 4) {
+		wr32(smem, our_item + at, 0);
+	}
+	wr32(smem, our_item, SMP2P_MAGIC);
+	wr32(smem, our_item + 8, SMEM_APPS | SMEM_ADSP << 16);         /* local, remote pid */
+	memcpy(w, name, sizeof(w));
+	for (uint32_t i = 0; i < 4; i++) {
+		wr32(smem, our_item + 20 + 4 * i, w[i]);
+	}
+	wr32(smem, our_item + 12, SMP2P_ENTRIES | 1u << 16);           /* total 16, valid 1 */
+	wr32(smem, our_item + 4, SMP2P_FEATURE_SSR_ACK << 8);
+	wr32(smem, our_item + 4, SMP2P_FEATURE_SSR_ACK << 8 | SMP2P_VERSION);  /* version last (smp2p.c) */
+	kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_SMP2P);
+	say("our SMP2P item at %#lx: magic %#x version %#x pids %#x counts %#x", SMEM_PHYS + our_item,
+	    rd32(smem, our_item), rd32(smem, our_item + 4), rd32(smem, our_item + 8), rd32(smem, our_item + 12));
+	return true;
+}
+
+/* ---- start ---- */
+
+static bool
+step_start(void)
+{
+	uint64_t answer = ~0ull;
+	uint32_t theirs = 0, size = 0, value = 0, last = ~0u, ms;
+	bool ready = false, fatal = false;
+
+	negroni_usb_adsp_event(0);              /* 0368: USB PHY snapshot + 10 ms watch from here */
+	announce("ask TrustZone to authenticate and start the ADSP (PAS auth and reset, id 1)");
+	if (scm("PAS auth and reset (adsp)", SCM_64 | SCM_SIP | SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_ADSP, 0, 0,
+	    &answer) != 0 || answer != 0) {
+		FAIL("TrustZone does not start the ADSP (%#llx)", answer);
+		pas_shutdown("auth and reset failed");
+		return false;
+	}
+	say("TRUSTZONE HAS RELEASED THE ADSP FROM RESET; waiting %u s for ready", wait_s);
+	for (ms = 0; ms < wait_s * 1000; ms++) {
+		if (theirs == 0) {
+			theirs = smem_item(ITEM_SMP2P_THEIRS, &size);
+			if (theirs) {
+				say("+%u ms: ADSP SMP2P item %u appears (%u bytes, version %#x)", ms, ITEM_SMP2P_THEIRS, size,
+				    rd32(smem, theirs + 4));
+			}
+		}
+		if (theirs && smp2p_value(theirs, "slave-kernel", &value) && value != last) {
+			say("+%u ms: slave-kernel = %#x%s%s%s%s", ms, value, value & DSP_FATAL ? " FATAL" : "",
+			    value & DSP_READY ? " READY" : "", value & DSP_HANDOVER ? " HANDOVER" : "",
+			    value & DSP_STOP_ACK ? " STOP-ACK" : "");
+			last = value;
+			if ((value & DSP_HANDOVER) && rails_on && unvote) {
+				(void)rail_vote("lcx.lvl", 0);
+				(void)rail_vote("lmx.lvl", 0);
+				rails_on = false;
+				say("proxy rail votes dropped (handover)");
+			}
+			if (value & DSP_FATAL) {
+				fatal = true;
+				break;
+			}
+			if (value & DSP_READY) {
+				ready = true;
+				break;
+			}
+		}
+		IOSleep(1);
+	}
+	if (!ready) {
+		say("%s after %u ms", fatal ? "ADSP REPORTS FATAL" : "NO READY FROM THE ADSP", ms);
+		last_words();
+		pas_shutdown(fatal ? "fatal" : "no ready");
+		return false;
+	}
+	say("THE ADSP IS UP after %u ms", ms);
+	adsp_running = true;
+	negroni_usb_adsp_event(1);              /* 0368 */
+	/* Linux drops the proxy votes on handover; wait up to 2 s more for it. */
+	for (uint32_t t = 0; t < 2000 && rails_on && unvote; t++) {
+		if (smp2p_value(theirs, "slave-kernel", &value) && (value & DSP_HANDOVER)) {
+			(void)rail_vote("lcx.lvl", 0);
+			(void)rail_vote("lmx.lvl", 0);
+			rails_on = false;
+			say("+%u ms: handover (slave-kernel = %#x): proxy rail votes dropped", ms + t, value);
+		}
+		IOSleep(1);
+	}
+	if (rails_on) {
+		say("no handover seen: the rail votes stay at level 384");
+	}
+	for (uint32_t item = ITEM_GLINK_DESC; item <= ITEM_GLINK_FIFO1; item++) {
+		uint32_t at = smem_item(item, &size);
+		say("GLINK SMEM item %u: %s (%u bytes)", item, at ? "present" : "absent", at ? size : 0);
+	}
+	return true;
+}
+
+/* ---- GLINK over SMEM (step 9; Linux qcom_glink_smem.c + qcom_glink_native.c, read for the protocol) ---- */
+
+/*
+ * Transport: item 478 = 4 words {our TX tail, our TX head, our RX tail, our RX head} (32 bytes),
+ * item 479 = our TX FIFO (16 KiB, we allocate), item 480 = our RX FIFO (the ADSP allocates it).
+ * Every message is padded to 8 bytes; the heads and tails stay 8-byte aligned, so the 32-bit
+ * copies below never cross the FIFO end inside a word. IPCC client 3 signal 0 is the doorbell
+ * (live DT glink-edge "lpass": mboxes <&ipcc 3 0>). No interrupt: negroni_glink_poll() is called
+ * by any client (the ADSP thread, the /dev/negroni-audio writer, the charger client); gl_lock, a
+ * recursive mutex inside the public API, serializes them.
+ */
+#define GLINK_FIFO_SIZE         0x4000u
+#define GLINK_RESERVE           16u             /* FIFO_FULL_RESERVE + TX_BLOCKED_CMD_RESERVE */
+#define IPCC_SIGNAL_GLINK       0u
+#define GL_VERSION              0
+#define GL_VERSION_ACK          1
+#define GL_OPEN                 2
+#define GL_CLOSE                3
+#define GL_OPEN_ACK             4
+#define GL_INTENT               5
+#define GL_RX_DONE              6
+#define GL_RX_INTENT_REQ        7
+#define GL_RX_INTENT_REQ_ACK    8
+#define GL_TX_DATA              9
+#define GL_CLOSE_ACK            11
+#define GL_TX_DATA_CONT         12
+#define GL_READ_NOTIF           13
+#define GL_RX_DONE_W_REUSE      14
+#define GL_SIGNALS              15
+#define GL_FEATURE_INTENT_REUSE 1u
+#define GL_OURS                 12              /* local (RX) intents per channel (8 given at open, 4 for RX_INTENT_REQ) */
+#define GL_THEIRS               32              /* remote (TX) intents per channel */
+#define GL_INTENT_SIZE          4096u           /* our default RX intents and our largest TX message */
+#define GL_INTENT_MAX           0x4400u         /* largest RX intent we grant (live DT IPCRTR intents: 5 x 0x800, 3 x 0x2000, 2 x 0x4400) */
+#define GL_MSG_MAX              (GL_INTENT_MAX + 16)
+#define GL_LOG_MAX              8               /* lines per kind of repeated GLINK complaint */
+
+struct gl_intent {
+	uint32_t id, size;
+	bool used;
+};
+
+struct gl_channel {
+	const char *name;
+	uint16_t lcid, rcid;
+	bool open_sent, remote_open, open_acked, ack_sent, intents_sent;
+	int32_t req_result;                     /* RX_INTENT_REQ answer: -1 none yet */
+	struct gl_intent ours[GL_OURS];
+	uint8_t *buf[GL_OURS];
+	uint32_t fill[GL_OURS];                 /* bytes of a fragmented message so far */
+	uint32_t nours;
+	struct gl_intent theirs[GL_THEIRS];
+	void (*rx)(const uint8_t *data, uint32_t len);
+	uint64_t rx_count, tx_count;
+};
+
+static struct gl_channel gl_ch[NEGRONI_GLINK_CHANNELS] = {
+	{ .name = "IPCRTR", .lcid = 1 },        /* QRTR (stage (b): service discovery, servreg locator) */
+	{ .name = "adsp_apps", .lcid = 2 },     /* GPR (stage (b): APM, PRM) */
+	{ .name = "PMIC_RTR_ADSP_APPS", .lcid = 3 },    /* 0274: charger PD, answered only with negronichg_glink=1 */
+	{ .name = "PMIC_LOGS_ADSP_APPS", .lcid = 4 },   /* 0373: charger PD log (ulog), answered only with negronichg_ulog=1 */
+};
+static uint32_t gl_desc, gl_tx, gl_rx, gl_rx_len, gl_features = GL_FEATURE_INTENT_REUSE, gl_next_liid = 1;
+static bool gl_version_ok, gl_dead, gl_notified;
+static uint8_t gl_msg[GL_MSG_MAX];
+static uint32_t gl_complaints;                  /* repeated-error lines printed so far (capped at GL_LOG_MAX) */
+#define gl_complain(fmt, ...) do { if (gl_complaints < GL_LOG_MAX) { gl_complaints++; say(fmt, ##__VA_ARGS__); } } while (0)
+
+/*
+ * One lock over the GLINK state (FIFO heads/tails, intents, the static TX buffer): the ADSP thread,
+ * the /dev/negroni-audio writer (0243) and the charger client (0274) all send. Recursive for the
+ * owning thread, because an RX callback inside negroni_glink_poll() may call negroni_glink_send().
+ */
+static LCK_GRP_DECLARE(gl_grp, "negroni_glink");
+static LCK_MTX_DECLARE(gl_mtx, &gl_grp);
+static thread_t gl_owner;
+static uint32_t gl_depth;
+
+static void
+gl_lock(void)
+{
+	if (gl_owner == current_thread()) {
+		gl_depth++;
+		return;
+	}
+	lck_mtx_lock(&gl_mtx);
+	gl_owner = current_thread();
+	gl_depth = 1;
+}
+
+static void
+gl_unlock(void)
+{
+	if (--gl_depth == 0) {
+		gl_owner = NULL;
+		lck_mtx_unlock(&gl_mtx);
+	}
+}
+
+static uint32_t
+gl_mod(uint32_t v, uint32_t len)
+{
+	return v >= len ? v - len : v;
+}
+
+static uint32_t
+gl_tx_avail(void)
+{
+	uint32_t tail = rd32(smem, gl_desc + 0), head = rd32(smem, gl_desc + 4);
+	uint32_t avail = tail <= head ? GLINK_FIFO_SIZE - head + tail : tail - head;
+
+	return avail < GLINK_RESERVE ? 0 : avail - GLINK_RESERVE;
+}
+
+/* One message (len a multiple of 8) into our TX FIFO, then the doorbell. ETIMEDOUT after 200 ms full. */
+static int
+gl_write(const void *msg, uint32_t len)
+{
+	const uint32_t *w = msg;
+	uint32_t head;
+
+	if (gl_dead || (len & 7) || len >= GLINK_FIFO_SIZE - GLINK_RESERVE) {
+		return EINVAL;
+	}
+	for (uint32_t ms = 0; gl_tx_avail() < len; ms++) {
+		if (ms == 200) {
+			gl_complain("GLINK: our TX FIFO stays full (tail %#x head %#x)", rd32(smem, gl_desc), rd32(smem, gl_desc + 4));
+			return ETIMEDOUT;
+		}
+		if (!gl_notified) {
+			uint32_t note[2] = { GL_READ_NOTIF, 0 };
+			gl_notified = true;
+			head = rd32(smem, gl_desc + 4);
+			uint32_t tl = rd32(smem, gl_desc + 0);
+			uint32_t raw = tl <= head ? GLINK_FIFO_SIZE - head + tl : tl - head;
+			if (raw > 8) {                  /* raw space: gl_tx_avail() already keeps the reserve back */
+				wr32(smem, gl_tx + head, note[0]);
+				wr32(smem, gl_tx + head + 4, note[1]);
+				wr32(smem, gl_desc + 4, gl_mod(head + 8, GLINK_FIFO_SIZE));
+				kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_GLINK);
+			}
+		}
+		IOSleep(1);
+	}
+	gl_notified = false;
+	head = rd32(smem, gl_desc + 4);
+	for (uint32_t i = 0; i < len / 4; i++) {
+		wr32(smem, gl_tx + head, w[i]);
+		head = gl_mod(head + 4, GLINK_FIFO_SIZE);
+	}
+	wr32(smem, gl_desc + 4, head);          /* wr32 orders the FIFO stores before the head */
+	kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_GLINK);
+	return 0;
+}
+
+static int
+gl_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	uint32_t m[2] = { cmd | (uint32_t)p1 << 16, p2 };
+	return gl_write(m, sizeof(m));
+}
+
+static uint32_t
+gl_rx_avail(void)
+{
+	uint32_t size = 0;
+
+	if (gl_rx == 0) {
+		gl_rx = smem_item(ITEM_GLINK_FIFO1, &size);
+		if (gl_rx == 0) {
+			return 0;
+		}
+		gl_rx_len = size & ~7u;
+		say("GLINK: the ADSP's FIFO (item %u) is there: %#x bytes", ITEM_GLINK_FIFO1, size);
+		if (gl_rx_len < 64 || gl_rx_len > 0x100000) {
+			say("GLINK: FIFO size %#x is not usable", size);
+			gl_dead = true;
+			gl_rx = 0;
+			return 0;
+		}
+	}
+	uint32_t tail = rd32(smem, gl_desc + 8), head = rd32(smem, gl_desc + 12);
+	if (head >= gl_rx_len || tail >= gl_rx_len) {
+		say("GLINK: RX head %#x / tail %#x outside the FIFO (%#x): GLINK stopped", head, tail, gl_rx_len);
+		gl_dead = true;
+		return 0;
+	}
+	return head >= tail ? head - tail : gl_rx_len - tail + head;
+}
+
+/* Copy `len` bytes (rounded up to 4) at `off` past our RX tail. */
+static void
+gl_peek(uint32_t off, void *dst, uint32_t len)
+{
+	uint32_t *w = dst, at = gl_mod(rd32(smem, gl_desc + 8) + off, gl_rx_len);
+
+	for (uint32_t i = 0; i < (len + 3) / 4; i++) {
+		w[i] = rd32(smem, gl_rx + at);
+		at = gl_mod(at + 4, gl_rx_len);
+	}
+}
+
+static void
+gl_advance(uint32_t len)
+{
+	wr32(smem, gl_desc + 8, gl_mod(rd32(smem, gl_desc + 8) + ((len + 7) & ~7u), gl_rx_len));
+}
+
+static struct gl_channel *
+gl_by_rcid(uint32_t rcid)
+{
+	for (unsigned c = 0; c < NEGRONI_GLINK_CHANNELS; c++) {
+		if (gl_ch[c].remote_open && gl_ch[c].rcid == rcid) {
+			return &gl_ch[c];
+		}
+	}
+	return NULL;
+}
+
+static bool
+gl_up(const struct gl_channel *ch)
+{
+	return ch->remote_open && ch->open_acked;
+}
+
+static int
+gl_send_open(struct gl_channel *ch)
+{
+	uint32_t m[2 + 8] = { 0 }, n = (uint32_t)strlen(ch->name) + 1;
+
+	m[0] = GL_OPEN | (uint32_t)ch->lcid << 16;
+	m[1] = n;
+	memcpy(&m[2], ch->name, n);
+	ch->open_sent = true;
+	return gl_write(m, (8 + n + 7) & ~7u);
+}
+
+static int
+gl_advertise(struct gl_channel *ch, unsigned i)
+{
+	uint32_t m[4];
+
+	m[0] = GL_INTENT | (uint32_t)ch->lcid << 16;
+	m[1] = 1;
+	m[2] = ch->ours[i].size;
+	m[3] = ch->ours[i].id;
+	return gl_write(m, sizeof(m));
+}
+
+/* Advertise one local intent of `size` bytes (GL_INTENT_SIZE..GL_INTENT_MAX, kmem). */
+static bool
+gl_add_intent(struct gl_channel *ch, uint32_t size)
+{
+	vm_offset_t b = 0;
+	uint32_t bytes = MAX(size, GL_INTENT_SIZE);
+
+	if (ch->nours >= GL_OURS || size > GL_INTENT_MAX ||
+	    kmem_alloc(kernel_map, &b, round_page(bytes), KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	unsigned i = ch->nours++;
+	ch->buf[i] = (uint8_t *)b;
+	ch->ours[i] = (struct gl_intent){ gl_next_liid++, bytes, false };
+	ch->fill[i] = 0;
+	return gl_advertise(ch, i) == 0;
+}
+
+static void
+gl_rx_data(struct gl_channel *ch, uint32_t liid, const uint8_t *data, uint32_t chunk, uint32_t left)
+{
+	unsigned i;
+
+	for (i = 0; i < ch->nours && ch->ours[i].id != liid; i++) {
+	}
+	if (i == ch->nours) {
+		gl_complain("GLINK: %s: data for an intent %u we never gave", ch->name, liid);
+		return;
+	}
+	if (ch->fill[i] + chunk > ch->ours[i].size) {
+		gl_complain("GLINK: %s: %u + %u bytes do not fit intent %u: dropped", ch->name, ch->fill[i], chunk, liid);
+		ch->fill[i] = 0;
+		return;
+	}
+	memcpy(ch->buf[i] + ch->fill[i], data, chunk);
+	ch->fill[i] += chunk;
+	if (left) {
+		return;
+	}
+	uint32_t whole = ch->fill[i];
+	ch->fill[i] = 0;
+	ch->rx_count++;
+	if (ch->rx) {
+		ch->rx(ch->buf[i], whole);
+	}
+	/*
+	 * RX_DONE_W_REUSE {cmd, our lcid, liid} keeps the intent when both sides agreed on
+	 * INTENT_REUSE (feature bit 0); otherwise RX_DONE ends it and we give the same buffer again.
+	 */
+	if (gl_features & GL_FEATURE_INTENT_REUSE) {
+		(void)gl_cmd(GL_RX_DONE_W_REUSE, ch->lcid, liid);
+	} else {
+		(void)gl_cmd(GL_RX_DONE, ch->lcid, liid);
+		ch->ours[i].id = gl_next_liid++;
+		(void)gl_advertise(ch, i);
+	}
+}
+
+/* Handle every complete message in our RX FIFO (with gl_lock held). */
+static void
+gl_poll(void)
+{
+	for (int n = 0; n < 256 && !gl_dead; n++) {
+		uint32_t avail = gl_rx_avail(), hdr[4], cmd, p1, p2, need = 8;
+		struct gl_channel *ch;
+
+		if (avail < 8) {
+			return;
+		}
+		gl_peek(0, hdr, 8);
+		cmd = hdr[0] & 0xffff;
+		p1 = hdr[0] >> 16;
+		p2 = hdr[1];
+		switch (cmd) {
+		case GL_VERSION:
+			if (p1 == 1) {
+				gl_features &= p2;
+			}
+			gl_advance(8);
+			if (p1 != 0) {
+				/* any version != 0 is acked with version 1, as Linux's default case does */
+				(void)gl_cmd(GL_VERSION_ACK, 1, gl_features);
+				if (!gl_version_ok) {
+					say("GLINK: the ADSP offers version %u features %#x: version 1 ok (features %#x)", p1, p2, gl_features);
+				}
+				gl_version_ok = true;
+			}
+			break;
+		case GL_VERSION_ACK:
+			gl_advance(8);
+			if (p1 == 0) {
+				say("GLINK: the ADSP refuses version 1");
+				gl_dead = true;
+			} else if (p1 == 1 && p2 != gl_features) {
+				gl_features &= p2;
+				(void)gl_cmd(GL_VERSION, 1, gl_features);
+			} else {
+				if (!gl_version_ok) {
+					say("GLINK: version 1 ok (features %#x)", gl_features);
+				}
+				gl_version_ok = true;
+			}
+			break;
+		case GL_OPEN: {
+			char name[33];
+			uint32_t len = p2 & 0xffff;
+
+			need = 8 + len;
+			if (avail < need) {
+				return;
+			}
+			bzero(name, sizeof(name));
+			if (len > 32) {
+				len = 32;
+			}
+			{
+				uint32_t w[10];
+				gl_peek(0, w, 8 + len);
+				memcpy(name, (uint8_t *)w + 8, len);
+			}
+			name[32] = 0;
+			gl_advance(need);
+			ch = NULL;
+			for (unsigned c = 0; c < NEGRONI_GLINK_CHANNELS; c++) {
+				if ((c != NEGRONI_GLINK_PMIC || negroni_chg_pmic_wanted()) &&
+				    (c != NEGRONI_GLINK_ULOG || negroni_chg_ulog_wanted()) && strcmp(gl_ch[c].name, name) == 0) {
+					ch = &gl_ch[c];
+				}
+			}
+			if (ch == NULL) {
+				say("GLINK: the ADSP opens \"%s\" (rcid %u): not ours, left unanswered", name, p1);
+				break;
+			}
+			ch->rcid = (uint16_t)p1;
+			ch->remote_open = true;
+			say("GLINK: the ADSP opens %s (rcid %u)", ch->name, p1);
+			(void)gl_cmd(GL_OPEN_ACK, ch->rcid, 0);
+			ch->ack_sent = true;
+			if (!ch->open_sent) {
+				(void)gl_send_open(ch);
+			}
+			break;
+		}
+		case GL_CLOSE:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			say("GLINK: the ADSP closes rcid %u (%s)", p1, ch ? ch->name : "?");
+			(void)gl_cmd(GL_CLOSE_ACK, (uint16_t)p1, 0);
+			if (ch) {
+				ch->remote_open = false;
+			}
+			break;
+		case GL_CLOSE_ACK:
+			gl_advance(8);
+			break;
+		case GL_OPEN_ACK:
+			gl_advance(8);
+			for (unsigned c = 0; c < NEGRONI_GLINK_CHANNELS; c++) {
+				if (gl_ch[c].lcid == p1) {
+					gl_ch[c].open_acked = true;
+					say("GLINK: the ADSP acks our open of %s", gl_ch[c].name);
+				}
+			}
+			break;
+		case GL_INTENT: {
+			uint32_t pair[2];
+
+			need = 8 + 8 * p2;
+			if (p2 > 64) {
+				say("GLINK: INTENT with %u entries: GLINK stopped", p2);
+				gl_dead = true;
+				return;
+			}
+			if (avail < need) {
+				return;
+			}
+			ch = gl_by_rcid(p1);
+			for (uint32_t i = 0; ch && i < p2; i++) {
+				gl_peek(8 + 8 * i, pair, 8);
+				for (unsigned k = 0; k < GL_THEIRS; k++) {
+					if (ch->theirs[k].size == 0) {
+						ch->theirs[k] = (struct gl_intent){ pair[1], pair[0], false };
+						break;
+					}
+				}
+			}
+			gl_advance(need);
+			break;
+		}
+		case GL_RX_DONE:
+		case GL_RX_DONE_W_REUSE:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			for (unsigned k = 0; ch && k < GL_THEIRS; k++) {
+				if (ch->theirs[k].size && ch->theirs[k].id == p2) {
+					if (cmd == GL_RX_DONE) {
+						ch->theirs[k].size = 0;
+					}
+					ch->theirs[k].used = false;
+				}
+			}
+			break;
+		case GL_RX_INTENT_REQ:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			if (ch) {
+				bool granted = gl_add_intent(ch, p2);
+				(void)gl_cmd(GL_RX_INTENT_REQ_ACK, ch->lcid, granted);
+				if (!granted) {
+					gl_complain("GLINK: %s: the ADSP asks for an intent of %u bytes: refused", ch->name, p2);
+				}
+			}
+			break;
+		case GL_RX_INTENT_REQ_ACK:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			if (ch) {
+				ch->req_result = (int32_t)p2;
+			}
+			break;
+		case GL_TX_DATA:
+		case GL_TX_DATA_CONT: {
+			uint32_t chunk, left;
+
+			if (avail < 16) {
+				return;
+			}
+			gl_peek(0, hdr, 16);
+			chunk = hdr[2];
+			left = hdr[3];
+			need = 16 + chunk;
+			if (chunk > GL_INTENT_MAX) {
+				say("GLINK: a %u-byte chunk is bigger than any intent of ours: GLINK stopped", chunk);
+				gl_dead = true;
+				return;
+			}
+			if (avail < need) {
+				return;
+			}
+			gl_peek(16, gl_msg, chunk);
+			gl_advance(need);
+			ch = gl_by_rcid(p1);
+			if (ch) {
+				gl_rx_data(ch, p2, gl_msg, chunk, left);
+			}
+			break;
+		}
+		case GL_READ_NOTIF:
+			gl_advance(8);
+			kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_GLINK);
+			break;
+		case GL_SIGNALS:
+			gl_advance(8);
+			break;
+		default:
+			say("GLINK: unknown command %u (%#x %#x): GLINK stopped", cmd, hdr[0], hdr[1]);
+			gl_dead = true;
+			return;
+		}
+	}
+}
+
+bool
+negroni_glink_up(unsigned c)
+{
+	return c < NEGRONI_GLINK_CHANNELS && !gl_dead && gl_up(&gl_ch[c]);
+}
+
+void
+negroni_glink_set_rx(unsigned c, void (*fn)(const uint8_t *data, uint32_t len))
+{
+	if (c < NEGRONI_GLINK_CHANNELS) {
+		gl_ch[c].rx = fn;
+	}
+}
+
+/*
+ * One message to the ADSP on channel c: needs a remote intent of >= len bytes (asks for one with
+ * RX_INTENT_REQ and waits up to 1 s). One chunk: len <= GL_INTENT_SIZE. With gl_lock held.
+ */
+static int
+gl_send(unsigned c, const void *data, uint32_t len)
+{
+	struct gl_channel *ch;
+	struct gl_intent *best = NULL;
+
+	if (c >= NEGRONI_GLINK_CHANNELS || len == 0 || len > GL_INTENT_SIZE) {
+		return EINVAL;
+	}
+	ch = &gl_ch[c];
+	if (gl_dead || !gl_up(ch)) {
+		return ENOTCONN;
+	}
+	for (int round = 0; round < 2 && best == NULL; round++) {
+		for (unsigned k = 0; k < GL_THEIRS; k++) {
+			struct gl_intent *t = &ch->theirs[k];
+			if (t->size >= len && !t->used && (best == NULL || t->size < best->size)) {
+				best = t;
+			}
+		}
+		if (best == NULL && round == 0) {
+			ch->req_result = -1;
+			if (gl_cmd(GL_RX_INTENT_REQ, ch->lcid, len) != 0) {
+				return EIO;
+			}
+			for (uint32_t ms = 0; ms < 1000 && ch->req_result < 0; ms++) {
+				gl_poll();
+				if (ch->req_result < 0) {
+					IOSleep(1);
+				}
+			}
+			gl_poll();           /* the INTENT may follow the ack */
+			if (ch->req_result <= 0) {
+				gl_complain("GLINK: %s: the ADSP gives no intent for %u bytes (answer %d)", ch->name, len, ch->req_result);
+				return EAGAIN;
+			}
+		}
+	}
+	if (best == NULL) {
+		return EAGAIN;
+	}
+	best->used = true;
+	{
+		static uint32_t m[(16 + GL_INTENT_SIZE + 7) / 4];     /* under gl_lock: no 4 KiB stack copy */
+		m[0] = GL_TX_DATA | (uint32_t)ch->lcid << 16;
+		m[1] = best->id;
+		m[2] = len;
+		m[3] = 0;
+		memcpy(&m[4], data, len);
+		bzero((uint8_t *)&m[4] + len, ((len + 7) & ~7u) - len);
+		if (gl_write(m, 16 + ((len + 7) & ~7u)) != 0) {
+			best->used = false;
+			return EIO;
+		}
+	}
+	ch->tx_count++;
+	return 0;
+}
+
+/* Public API (stable for 0243 and the charger client 0274): each call takes gl_lock. */
+void
+negroni_glink_poll(void)
+{
+	gl_lock();
+	gl_poll();
+	gl_unlock();
+}
+
+/*
+ * Send one message (len <= 4096) on channel c. Blocks the caller for up to ~1.2 s (an intent
+ * request, a full TX FIFO); returns 0, EINVAL, ENOTCONN, EAGAIN (no remote intent) or EIO.
+ */
+int
+negroni_glink_send(unsigned c, const void *data, uint32_t len)
+{
+	int error;
+
+	gl_lock();
+	error = gl_send(c, data, len);
+	gl_unlock();
+	return error;
+}
+
+/* 0274: open a channel after step 9 (the charger PD's PMIC_RTR_ADSP_APPS). gl_lock per poll. */
+int
+negroni_glink_open(unsigned c, unsigned intents, uint32_t wait_ms)
+{
+	struct gl_channel *ch;
+	int error = 0;
+
+	if (c >= NEGRONI_GLINK_CHANNELS) {
+		return EINVAL;
+	}
+	ch = &gl_ch[c];
+	gl_lock();
+	if (gl_dead || !gl_version_ok) {
+		error = ENOTCONN;
+	} else if (!ch->open_sent && gl_send_open(ch) != 0) {
+		error = EIO;
+	}
+	gl_unlock();
+	for (uint32_t ms = 0; error == 0 && ms < wait_ms; ms++) {
+		bool done;
+		gl_lock();
+		gl_poll();
+		done = gl_up(ch) || gl_dead;
+		gl_unlock();
+		if (done) {
+			break;
+		}
+		IOSleep(1);
+	}
+	if (error) {
+		return error;
+	}
+	gl_lock();
+	if (gl_dead) {
+		error = ENOTCONN;
+	} else if (!gl_up(ch)) {
+		error = ETIMEDOUT;
+	} else {
+		/*
+		 * A re-open after a remote CLOSE: the ADSP forgot our intents and we forget its intents.
+		 * Advertise all of ours again, clear theirs. [U] whether the ADSP takes the old lcid (we
+		 * never send CLOSE or a second OPEN).
+		 */
+		if (ch->nours > 0 && ch->intents_sent) {
+			bzero(ch->theirs, sizeof(ch->theirs));
+			for (unsigned i = 0; error == 0 && i < ch->nours; i++) {
+				ch->fill[i] = 0;
+				error = gl_advertise(ch, i) == 0 ? 0 : EIO;
+			}
+		}
+		while (error == 0 && ch->nours < MIN(intents, (unsigned)GL_OURS)) {
+			error = gl_add_intent(ch, GL_INTENT_SIZE) ? 0 : ENOMEM;
+		}
+		if (error == 0) {
+			ch->intents_sent = true;
+		}
+	}
+	gl_unlock();
+	return error;
+}
+
+static bool
+step_glink(void)
+{
+	uint32_t size = 0, ms;
+
+	announce("GLINK: allocate SMEM items 478 (descriptors) and 479 (our TX FIFO), say version 1");
+	if (!smem_alloc(ITEM_GLINK_DESC, 32) || !smem_alloc(ITEM_GLINK_FIFO0, GLINK_FIFO_SIZE)) {
+		return false;
+	}
+	gl_desc = smem_item(ITEM_GLINK_DESC, &size);
+	if (gl_desc == 0 || size != 32) {
+		FAIL("GLINK descriptor item %u: %s (%u bytes)", ITEM_GLINK_DESC, gl_desc ? "wrong size" : "absent", size);
+		return false;
+	}
+	gl_tx = smem_item(ITEM_GLINK_FIFO0, &size);
+	if (gl_tx == 0 || size < GLINK_FIFO_SIZE) {
+		FAIL("GLINK TX FIFO item %u: %s (%u bytes)", ITEM_GLINK_FIFO0, gl_tx ? "too small" : "absent", size);
+		return false;
+	}
+	wr32(smem, gl_desc + 8, 0);             /* our RX tail */
+	wr32(smem, gl_desc + 4, 0);             /* our TX head */
+	say("GLINK: descriptors at %#lx, TX FIFO at %#lx (%#x bytes)", SMEM_PHYS + gl_desc, SMEM_PHYS + gl_tx, size);
+	if (gl_cmd(GL_VERSION, 1, gl_features) != 0) {
+		FAIL("GLINK: VERSION does not go out");
+		return false;
+	}
+	for (ms = 0; ms < step_budget_ms && !gl_dead; ms++) {
+		negroni_glink_poll();
+		if (gl_version_ok) {
+			for (unsigned c = 0; c < NEGRONI_GLINK_STEP9; c++) {
+				if (!gl_ch[c].open_sent) {
+					say("GLINK: open %s (lcid %u)", gl_ch[c].name, gl_ch[c].lcid);
+					(void)gl_send_open(&gl_ch[c]);
+				}
+			}
+		}
+		if (gl_up(&gl_ch[0]) && gl_up(&gl_ch[1])) {
+			break;
+		}
+		IOSleep(1);
+	}
+	if (gl_dead || !gl_up(&gl_ch[0]) || !gl_up(&gl_ch[1])) {
+		FAIL("GLINK not up after %u ms: FIFO 480 %s, version %s, IPCRTR remote %u ack %u, adsp_apps remote %u ack %u%s", ms,
+		    gl_rx ? "there" : "missing", gl_version_ok ? "ok" : "no answer", gl_ch[0].remote_open, gl_ch[0].open_acked,
+		    gl_ch[1].remote_open, gl_ch[1].open_acked, gl_dead ? ", GLINK stopped" : "");
+		return false;
+	}
+	for (unsigned c = 0; c < NEGRONI_GLINK_STEP9; c++) {
+		for (unsigned i = 0; i < (c == 0 ? 4u : 8u); i++) {         /* leaves 4 slots for RX_INTENT_REQ */
+			if (!gl_add_intent(&gl_ch[c], GL_INTENT_SIZE)) {
+				FAIL("GLINK: %s: intent %u not given", gl_ch[c].name, i);
+				return false;
+			}
+		}
+		say("GLINK: channel %s open (lcid %u rcid %u), %u intents of %u bytes given", gl_ch[c].name, gl_ch[c].lcid,
+		    gl_ch[c].rcid, gl_ch[c].nours, GL_INTENT_SIZE);
+	}
+	negroni_glink_poll();
+	say("GLINK UP after %u ms", ms);
+	return true;
+}
+
+
+/*
+ * 0248: the ADSP crash watch (Linux qcom_q6v5.c fatal IRQ -> rproc_report_crash -> qcom_q6v5_request_stop
+ * + qcom_q6v5_pas.c PAS shutdown, read for the order). No interrupt here: a thread reads the ADSP's
+ * slave-kernel SMP2P entry every 200 ms. On FATAL: the ADSP's last words (item 423), the amps off and
+ * the audio sink off (negroni_audio_dsp_lost: no GPR to a dead DSP), GLINK stopped, our master-kernel
+ * "stop" bit (bit 0, qcom,smem-states <... 0> "stop") set + IPCC kick, up to 5 s for STOP-ACK (bit 3),
+ * then PAS shutdown. No restart (the "has run since the reset" gate stays: HackiOS saw a SoC reset on a
+ * second start without a stop-ack). The watch does not see a watchdog bite (a separate LPASS IRQ in
+ * Linux) [I]; GLINK timeouts then show it.
+ */
+static void
+adsp_watch(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t size = 0, value = 0, last = ~0u, theirs;
+
+	say("watch: polling slave-kernel every 200 ms for FATAL");
+	for (;;) {
+		IOSleep(200);
+		theirs = smem_item(ITEM_SMP2P_THEIRS, &size);
+		if (theirs == 0 || !smp2p_value(theirs, "slave-kernel", &value) || value == last) {
+			continue;
+		}
+		say("watch: slave-kernel = %#x%s%s", value, value & DSP_FATAL ? " FATAL" : "", value & DSP_STOP_ACK ? " STOP-ACK" : "");
+		last = value;
+		if (value & DSP_FATAL) {
+			break;
+		}
+	}
+	say("ADSP FATAL AFTER START: audio off, stop, PAS shutdown (no restart in this boot)");
+	last_words();
+	negroni_audio_dsp_lost("ADSP fatal");
+	gl_dead = true;
+	if (our_item) {
+		wr32(smem, our_item + 36, rd32(smem, our_item + 36) | 1u);     /* master-kernel entry 0: "stop" */
+		kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_SMP2P);
+		for (uint32_t ms = 0; ms < 5000; ms += 10) {
+			if (smp2p_value(theirs, "slave-kernel", &value) && (value & DSP_STOP_ACK)) {
+				say("watch: STOP-ACK after %u ms", ms);
+				break;
+			}
+			IOSleep(10);
+		}
+		wr32(smem, our_item + 36, rd32(smem, our_item + 36) & ~1u);    /* stop bit cleared again (Linux does) */
+		kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_SMP2P);
+	}
+	negroni_usb_adsp_event(2);              /* 0368 */
+	pas_shutdown("ADSP fatal after start");
+	adsp_running = false;
+	(void)thread_terminate(current_thread());
+}
+
+/* steps 10..15 are stage (b) (negroni_audio.c): one bridge per step keeps the timing/fail line. */
+static bool
+step_audio(uint32_t n)
+{
+	if (negroni_audio_step(n, step_budget_ms, stage_b_why, sizeof(stage_b_why))) {
+		return true;
+	}
+	strlcpy(fail_why, stage_b_why, sizeof(fail_why));
+	return false;
+}
+static bool step_audio10(void) { return step_audio(10); }
+static bool step_audio11(void) { return step_audio(11); }
+static bool step_audio12(void) { return step_audio(12); }
+static bool step_audio13(void) { return step_audio(13); }
+static bool step_audio14(void) { return step_audio(14); }
+static bool step_audio15(void) { return step_audio(15); }
+
+static bool (*const steps[STEPS])(void) = {
+	step_survey, step_firmware, step_rails, step_aop, step_pas_init, step_load, step_smp2p, step_start, step_glink,
+	step_audio10, step_audio11, step_audio12, step_audio13, step_audio14, step_audio15,
+};
+_Static_assert(sizeof(step_names) / sizeof(step_names[0]) == 9, "one name per ADSP step 1..9");
+
+static void
+adsp_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	bool failed = false;
+
+	for (step = 1; step <= last_step; step++) {
+		uint64_t t0 = mach_absolute_time(), ns = 0;
+		bool ok;
+
+		fail_why[0] = 0;
+		ok = steps[step - 1]();
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		if (!ok) {
+			printf("NEGRONI ADSP: step %u (%s) failed: %s (after %llu ms)\n", step,
+			    step <= 9 ? step_names[step - 1] : negroni_audio_step_name(step),
+			    fail_why[0] ? fail_why : "no reason logged", ns / 1000000);
+			failed = true;
+			break;
+		}
+		printf("NEGRONI ADSP: step %u (%s) ok in %llu ms%s\n", step,
+		    step <= 9 ? step_names[step - 1] : negroni_audio_step_name(step), ns / 1000000,
+		    ns / 1000000 > step_budget_ms ? " (OVER the step time limit)" : "");
+	}
+	if (failed && step >= 10) {
+		negroni_audio_stop("a stage (b) step failed");       /* graph/clock down; keeps the ADSP up */
+	}
+	if (failed && step >= 5 && step < 8) {
+		pas_shutdown("a step after PAS init failed");
+	}
+	if (failed && rails_on) {
+		(void)rail_vote("lcx.lvl", 0);
+		(void)rail_vote("lmx.lvl", 0);
+		rails_on = false;               /* 0376 review F3: negroni_adsp_rails_held() reads it */
+	}
+	printf("NEGRONI ADSP: done (asked 1..%u, %s at %u)\n", last_step, failed ? "stopped" : "complete",
+	    MIN(step, last_step));
+	if (adsp_running) {
+		thread_t w;
+		if (kernel_thread_start(adsp_watch, NULL, &w) == KERN_SUCCESS) {
+			thread_deallocate(w);
+		}
+	}
+	__atomic_store_n(&adsp_phase, 2, __ATOMIC_RELEASE);    /* 0376: QMP and the SMEM mutex are free for the SLPI thread */
+	(void)thread_terminate(current_thread());
+}
+
+void
+negroni_adsp_init(void)
+{
+	uint32_t on = 0;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("negroniadsp", &on, sizeof(on));
+	if (on == 0) {
+		return;
+	}
+	(void)PE_parse_boot_argn("negroniadsp_step", &last_step, sizeof(last_step));
+	(void)PE_parse_boot_argn("negroniadsp_pause", &pause_ms, sizeof(pause_ms));
+	(void)PE_parse_boot_argn("negroniadsp_wait", &wait_s, sizeof(wait_s));
+	(void)PE_parse_boot_argn("negroniadsp_unvote", &unvote, sizeof(unvote));
+	(void)PE_parse_boot_argn("negroniadsp_steptimeout", &step_budget_ms, sizeof(step_budget_ms));
+	step_budget_ms = MIN(MAX(step_budget_ms, 1000u), 120000u);
+	last_step = MIN(MAX(last_step, 1u), (uint32_t)STEPS);
+	printf("NEGRONI ADSP: steps 1..%u (UNTESTED stage (a): PAS id 1, carveout %#lx)\n", last_step, ADSP_MEM_PHYS);
+	adsp_phase = 1;                         /* 0376 */
+	if (kernel_thread_start(adsp_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		adsp_phase = 2;
+		printf("NEGRONI ADSP: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_adsp.h b/bsd/dev/negroni_adsp.h
new file mode 100644
index 0000000..84dc207
--- /dev/null
+++ b/bsd/dev/negroni_adsp.h
@@ -0,0 +1,44 @@
+/*
+ * NEGRONI (SM8450) audio DSP: the interface between negroni_adsp.c (stage (a): ADSP start, step 9
+ * GLINK) and negroni_audio.c (stage (b): QRTR, GPR, the speaker graph, /dev/negroni-audio).
+ * iOSPlus10 docs/audio-plan.md. One recursive mutex (gl_lock) inside the public GLINK API
+ * serializes its callers (the ADSP thread, the audio writer, the charger client).
+ */
+#ifndef _NEGRONI_ADSP_H_
+#define _NEGRONI_ADSP_H_
+
+#define NEGRONI_GLINK_CHANNELS  4       /* 0274: + PMIC_RTR_ADSP_APPS; 0373: + PMIC_LOGS_ADSP_APPS */
+#define NEGRONI_GLINK_STEP9     2       /* step 9 opens and waits for channels 0..1 only */
+#define NEGRONI_GLINK_IPCRTR    0       /* QRTR */
+#define NEGRONI_GLINK_GPR       1       /* "adsp_apps": GPR */
+#define NEGRONI_GLINK_PMIC      2       /* "PMIC_RTR_ADSP_APPS": charger PD (0274: negronichg_glink=1; 0374: or negronichg_typec) */
+#define NEGRONI_GLINK_ULOG      3       /* "PMIC_LOGS_ADSP_APPS": charger PD log (0373, only with negronichg_ulog=1) */
+
+/* GLINK (negroni_adsp.c) */
+void negroni_glink_poll(void);
+bool negroni_glink_up(unsigned channel);
+void negroni_glink_set_rx(unsigned channel, void (*fn)(const uint8_t *data, uint32_t len));
+int negroni_glink_send(unsigned channel, const void *data, uint32_t len);
+/* 0274: open a channel after step 9 (under gl_lock): our OPEN, wait up to wait_ms for both opens,
+ * then `intents` RX intents. 0 = up; ENOTCONN, ETIMEDOUT, ENOMEM, EIO, EINVAL. */
+int negroni_glink_open(unsigned channel, unsigned intents, uint32_t wait_ms);
+/* 0274 (negroni_chg_glink.c): boot-args negronichg_glink=1 and negroniadsp set */
+bool negroni_chg_glink_wanted(void);
+/* 0374 (negroni_chg_glink.c): PMIC_RTR_ADSP_APPS is ours: negronichg_glink=1, or negronichg_typec != 0 alone */
+bool negroni_chg_pmic_wanted(void);
+/* 0373 (negroni_chg_glink.c): boot-args negronichg_ulog=1 and negroniadsp set */
+bool negroni_chg_ulog_wanted(void);
+
+/* stage (b) (negroni_audio.c): first and last step numbers it runs */
+#define NEGRONI_AUDIO_FIRST_STEP        10
+#define NEGRONI_AUDIO_LAST_STEP         15
+/* Run step n (10..15). false: failed, the reason is in why. budget_ms: time limit of the step. */
+bool negroni_audio_step(uint32_t n, uint32_t budget_ms, char *why, size_t whylen);
+const char *negroni_audio_step_name(uint32_t n);
+/* After a failed or a final step: graph down, clock released, sink off (safe to call twice). */
+void negroni_audio_stop(const char *reason);
+void negroni_audio_init(void);          /* /dev/negroni-audio (ENODEV until step 15 runs) */
+/* 0248: the ADSP died: amps off, sink off, no more GPR (the graph is gone with the DSP). */
+void negroni_audio_dsp_lost(const char *reason);
+
+#endif
diff --git a/bsd/dev/negroni_apple80211.c b/bsd/dev/negroni_apple80211.c
new file mode 100644
index 0000000..9f178a3
--- /dev/null
+++ b/bsd/dev/negroni_apple80211.c
@@ -0,0 +1,920 @@
+/*
+ * Copyright (c) 2026 iOSPlus10. Derived from HakiOS (oosexgang/hackios-xnu-kernel, xnu/files/bsd/dev/
+ * hakios.apple80211.c, Apple Public Source License 2.0): the request types, the 16.5 layouts and their checks,
+ * the event format; adapted to the NEGRONI backend (negroni_wlan_ios.h -> negroni_wlan_api.h).
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_START@
+ *
+ * This file contains Original Code and/or Modifications of Original Code
+ * as defined in and that are subject to the Apple Public Source License
+ * Version 2.0 (the 'License'). You may not use this file except in
+ * compliance with the License. The rights granted to you under the License
+ * may not be used to create, or enable the creation or redistribution of,
+ * unlawful or unlicensed software or any other software. Please obtain a
+ * copy of the License at http://www.opensource.apple.com/apsl/ and read it
+ * before using this file.
+ *
+ * The Original Code and all software distributed under the License are
+ * distributed on an 'AS IS' basis, WITHOUT WARRANTY OF ANY KIND, EITHER
+ * EXPRESS OR IMPLIED, AND APPLE HEREBY DISCLAIMS ALL SUCH WARRANTIES,
+ * INCLUDING WITHOUT LIMITATION, ANY WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE, QUIET ENJOYMENT OR NON-INFRINGEMENT.
+ * Please see the License for the specific language governing rights and
+ * limitations under the License.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+/*
+ * NEGRONI Wi-Fi, iOS side (patch 0341): Apple80211 answered in the kernel.
+ *
+ * wifid (and through it Settings, Control Center and the status bar) talks to the driver with Apple80211
+ * requests. Our registry service has no user client (NegroniWLAN.cpp), so IO80211.framework logs "Falling back
+ * to IOCTL path" and sends every request as SIOCGA80211 / SIOCSA80211 on a socket: a struct apple80211req with the
+ * interface name, a type, a value, a length and a user buffer. XNU passes an interface ioctl it does not know to
+ * the interface (bsd/net/if.c ifioctl default -> ifnet_ioctl), so en0's ioctl (negroni_wlan_ios.c) calls this.
+ *
+ * Gets: card capabilities (12), power (19), op mode (15), channels (27, 254, 207), join result (21), scan result
+ * (11, one BSS per request, EIO after the last), state (13), SSID (1), BSSID (9), channel (4), RSSI (16), current
+ * network (103), auth type (2), driver/hardware names (43, 44). Sets: associate (20), disassociate (22), power
+ * (19), scan (10). Events: kernel events class 6 (KEV_IEEE80211_CLASS) subclass 1, code = Apple80211 event,
+ * data = the interface name in 16 bytes (+ the 32-byte link data for LINK_CHANGED).
+ *
+ * Root only: every set, and gets 1 SSID, 9 BSSID, 11 SCAN_RESULT, 103 CURRENT_NETWORK (EPERM otherwise; wifid runs
+ * as root).
+ *
+ * Patch 0345 (scan + join completion for wifid 20H392; layouts read from IO80211.framework 20H392):
+ *   gets 106 RSSI_BOUNDS {version 1, min, max, threshold} (Apple80211GetWithIOCTL: 16 bytes, CFNumbers RSSI_MIN at +4,
+ *   RSSI_MAX at +8, RSSI_THRESHOLD at +12), 5 POWERSAVE (value 0: off), 18 INT_MIT (value 0: off), 6 PROTMODE
+ *   {version, 0, 0}, 14 PHY_MODE {version, supported a/b/g, active}, 17 NOISE (the RSSI layout, -95 dBm), 8 RATE (value:
+ *   the joined BSS's highest legacy rate, Mbit/s); sets 86 SCAN_REQ_MULTIPLE (same scan as 10), 5 POWERSAVE and
+ *   365 DISPLAY_STATE and 382 ABORT_SCAN (accepted, nothing to do). Request lines: at most PER_KIND_LOG of each kind (a new error, or
+ *   a new value of a get, is always said); scans, joins, leaves and power sets always (wifid's CURRENT_NETWORK polls ate the 400 lines in t21).
+ *   The summary comes 180 s after en0 and then every 600 s while new requests come.
+ *
+ * Layouts: as HakiOS read them out of IO80211.framework of iOS 16.5 (20F66) [I: the same in 16.7 20H392; the
+ * _Static_asserts keep them as HakiOS had them]. Each request is logged (process, get/set, type, value, length,
+ * never the SSID or key) for the first negroniwlan_ios_log requests, and a per-type summary 180 s after en0.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/kern_event.h>
+#include <sys/kauth.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <libkern/libkern.h>
+#include "negroni_wlan_ios.h"
+
+struct apple80211req {
+	char req_if_name[16];
+	int32_t req_type;
+	int32_t req_val;
+	uint32_t req_len;
+	user_addr_t req_data __attribute__((aligned(8)));
+};
+
+static const char *
+type_name(int32_t type)
+{
+	static const struct {
+		int32_t type;
+		const char *name;
+	} names[] = {
+		{ 1, "SSID" }, { 2, "AUTH_TYPE" }, { 3, "CIPHER_KEY" }, { 4, "CHANNEL" }, { 5, "POWERSAVE" }, { 6, "PROTMODE" },
+		{ 7, "TXPOWER" }, { 8, "RATE" }, { 9, "BSSID" }, { 10, "SCAN_REQ" }, { 11, "SCAN_RESULT" }, { 12, "CARD_CAPABILITIES" },
+		{ 13, "STATE" }, { 14, "PHY_MODE" }, { 15, "OP_MODE" }, { 16, "RSSI" }, { 17, "NOISE" }, { 18, "INT_MIT" }, { 19, "POWER" },
+		{ 20, "ASSOCIATE" }, { 21, "ASSOCIATE_RESULT" }, { 22, "DISASSOCIATE" }, { 23, "STATUS_DEV_NAME" }, { 24, "IBSS_MODE" },
+		{ 25, "HOST_AP_MODE" }, { 26, "AP_MODE" }, { 27, "SUPPORTED_CHANNELS" }, { 28, "LOCALE" }, { 29, "DEAUTH" },
+		{ 30, "COUNTERMEASURES" }, { 32, "RATE_SET" }, { 42, "STATION_LIST" }, { 43, "DRIVER_VERSION" },
+		{ 44, "HARDWARE_VERSION" }, { 46, "RSN_IE" }, { 47, "BACKGROUND_SCAN" }, { 48, "AP_IE_LIST" }, { 49, "STATS" },
+		{ 50, "ASSOCIATION_STATUS" }, { 51, "COUNTRY_CODE" }, { 54, "RADIO_INFO" }, { 57, "MCS" }, { 66, "MCS_INDEX_SET" },
+		{ 79, "STA_STATS" }, { 80, "ROAM_THRESH" }, { 85, "IE" }, { 86, "SCAN_REQ_MULTIPLE" }, { 87, "BTCOEX_MODE" },
+		{ 90, "SCANCACHE_CLEAR" }, { 94, "VIRTUAL_IF_CREATE" }, { 95, "VIRTUAL_IF_DELETE" }, { 103, "CURRENT_NETWORK" },
+		{ 106, "RSSI_BOUNDS" }, { 107, "ROAM" }, { 207, "CHANNELS_INFO" }, { 254, "HW_SUPPORTED_CHANNELS" },
+		/* 0345: names from IO80211.framework 20H392 (kIoctlNameTable) for the types wifid sent in t21 */
+		{ 96, "VIRTUAL_IF_ROLE" }, { 97, "VIRTUAL_IF_PARENT" }, { 115, "POWER_DEBUG_INFO" }, { 365, "DISPLAY_STATE" },
+		{ 383, "SET_PROPERTY" }, { 419, "LTE_RESTRICTED_CHANNELS" }, { 382, "ABORT_SCAN" }, { 267, "SUPPRESS_SCANS" },
+	};
+
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (names[i].type == type) {
+			return names[i].name;
+		}
+	}
+	return "?";
+}
+
+/* ---- the layouts (HakiOS, IO80211.framework 16.5) ---------------------------------------------------------- */
+
+#define CHANNEL_20MHZ           0x2u
+#define CHANNEL_2GHZ            0x8u
+#define CHANNEL_5GHZ            0x10u
+#define CHANNEL_ACTIVE          0x80u
+#define CHANNEL_DFS             0x100u
+
+struct apple80211_channel {
+	uint32_t version, channel, flags;
+};
+
+struct apple80211_channels {
+	uint32_t version, count;
+	struct apple80211_channel channels[401];
+	uint32_t unused;
+};
+
+struct apple80211_channels_info {
+	uint8_t unknown_0[12];
+	uint16_t count;
+	uint8_t unknown_1[800];
+	uint8_t number[400], indoor[400], dfs[400], passive[400], wide_40[400], wide_80[400];
+	uint8_t unknown_2[1602];
+	uint32_t flags[400];
+	uint8_t unknown_3[3600];
+} __attribute__((packed));
+
+struct apple80211_scan_request {
+	uint32_t version, bss_type;
+	uint8_t bssid[6], unused_0[2];
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint32_t scan_type;
+	uint32_t phy_mode;
+	uint16_t dwell_ms, unused_1;
+	uint32_t rest_ms;
+	uint32_t channel_count;
+	struct apple80211_channel channels[400];
+	uint64_t flags;
+	uint32_t unused_2;
+	uint32_t name_count;
+	uint8_t names[10][56];
+	uint32_t short_ssid, unused_3;
+};
+
+struct apple80211_scan_result {
+	uint32_t version;
+	struct apple80211_channel channel;
+	uint16_t noise_known;
+	int16_t noise, snr, rssi;
+	uint16_t beacon_interval, capability;
+	uint8_t bssid[6];
+	uint8_t rate_count, unused_0;
+	uint32_t rates[15];
+	uint8_t ssid_length, ssid[32], unused_1[3];
+	uint32_t age_ms;
+	uint8_t flags, unused_2;
+	uint16_t elements_length;
+	uint8_t elements[1024];
+};
+
+struct apple80211_assoc {
+	uint32_t version;
+	uint16_t mode, auth_lower, auth_upper, unused_0;
+	uint32_t ssid_length;
+	uint8_t ssid[32];
+	uint8_t bssid[6], unused_1[2];
+	uint32_t key_version, key_length, key_cipher;
+	uint16_t key_flags, key_index;
+	uint8_t key[64];
+	uint8_t rest[0x250 - 0x88];
+};
+
+#define CIPHER_PMK              6
+#define CIPHER_PASSPHRASE       10
+
+/* 0345: RSSI_BOUNDS answer (dBm). Guess: no Apple driver value is known; min < threshold < max as wifid prints them */
+#define RSSI_BOUND_MIN          (-90)
+#define RSSI_BOUND_MAX          (-40)
+#define RSSI_BOUND_THRESHOLD    (-80)
+#define NOISE_DBM               (-95)
+
+/* PHY modes (APPLE80211_MODE_*): 11a 0x2, 11b 0x4, 11g 0x8 */
+#define PHY_11A                 0x2u
+#define PHY_11B                 0x4u
+#define PHY_11G                 0x8u
+
+#define PER_KIND_LOG            6       /* request lines of one kind (type + get/set) */
+#define KEY_LOG_MAX             200     /* scan / join / leave / power lines (always said, up to this many) */
+
+struct apple80211_link_changed {
+	uint8_t down, unused_0[3];
+	int32_t rssi;
+	uint16_t snr, noise;
+	uint8_t unused_1[4];
+	uint8_t involuntary, unused_2[3];
+	uint32_t reason, subreason;
+	uint8_t unused_3[4];
+};
+
+_Static_assert(sizeof(struct apple80211req) == 40, "struct apple80211req (SIOCGA80211 length 0x28)");
+_Static_assert(sizeof(struct apple80211_assoc) == 592 && offsetof(struct apple80211_assoc, key) == 0x48,
+    "the association request as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_link_changed) == 32 && offsetof(struct apple80211_link_changed, reason) == 0x14,
+    "the link event as iOS 16.5 reads it");
+_Static_assert(sizeof(struct apple80211_channels) == 4824, "the channel list as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_channels_info) == 10016 && offsetof(struct apple80211_channels_info, number) == 0x32e &&
+    offsetof(struct apple80211_channels_info, flags) == 0x12d0, "the channels' description as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_request) == 5456 && offsetof(struct apple80211_scan_request, channels) == 0x48 &&
+    offsetof(struct apple80211_scan_request, flags) == 0x1308 && offsetof(struct apple80211_scan_request, names) == 0x1318,
+    "the scan request as iOS 16.5 has it");
+_Static_assert(sizeof(struct apple80211_scan_result) == 1164 && offsetof(struct apple80211_scan_result, ssid_length) == 0x60 &&
+    offsetof(struct apple80211_scan_result, age_ms) == 0x84 && offsetof(struct apple80211_scan_result, elements) == 0x8c,
+    "a scan's result as iOS 16.5 has it");
+
+/* Apple80211 events (APPLE80211_M_...) */
+enum { EVENT_POWER_CHANGED = 1, EVENT_SSID_CHANGED = 2, EVENT_BSSID_CHANGED = 3, EVENT_LINK_CHANGED = 4, EVENT_ASSOC_DONE = 9,
+       EVENT_SCAN_DONE = 10 };
+
+static const char interface_name[16] = NWIOS_IFNAME;
+
+static LCK_GRP_DECLARE(a80211_lock_group, "negroni-apple80211");
+static LCK_MTX_DECLARE(a80211_lock, &a80211_lock_group);
+static unsigned result_next;            /* which BSS of the last scan the next SCAN_RESULT gets */
+static uint32_t join_result;            /* of the last join: 0 while it runs, then Apple80211's result number */
+
+/* ---- channels: the regulatory set of the QCA6490 board file is not read; a world-safe list ------------------ */
+
+static const uint16_t channel_list[] = {
+	2412, 2417, 2422, 2427, 2432, 2437, 2442, 2447, 2452, 2457, 2462, 2467, 2472,
+	5180, 5200, 5220, 5240, 5260, 5280, 5300, 5320, 5500, 5520, 5540, 5560, 5580, 5600, 5620, 5640, 5660, 5680, 5700,
+	5720, 5745, 5765, 5785, 5805, 5825,
+};
+#define CHANNEL_COUNT   (sizeof(channel_list) / sizeof(channel_list[0]))
+
+static bool
+channel_radar(unsigned frequency)
+{
+	return frequency >= 5260 && frequency <= 5720;         /* UNII-2 / UNII-2e: DFS, listen only */
+}
+
+static unsigned
+channel_number(unsigned frequency)
+{
+	return frequency == 2484 ? 14 : frequency < 4000 ? (frequency - 2407) / 5 : (frequency - 5000) / 5;
+}
+
+static void
+channel_fill(struct apple80211_channel *channel, unsigned frequency)
+{
+	bool radar = channel_radar(frequency);
+
+	channel->version = 1;
+	channel->channel = channel_number(frequency);
+	channel->flags = CHANNEL_20MHZ | (frequency < 4000 ? CHANNEL_2GHZ : CHANNEL_5GHZ) | (radar ? CHANNEL_DFS : CHANNEL_ACTIVE);
+}
+
+/* ---- answers ---------------------------------------------------------------------------------------------- */
+
+static int
+give(const struct apple80211req *request, const void *data, size_t length)
+{
+	return request->req_data == USER_ADDR_NULL ? 0 : copyout(data, request->req_data, length < request->req_len ? length :
+	       request->req_len);
+}
+
+static uint64_t
+now_ms(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* one BSS in the scan-result layout; the caller says how much room for elements it has */
+static int
+give_network(const struct apple80211req *request, const struct nwlan_bss *bss)
+{
+	struct apple80211_scan_result *result = kalloc_data(sizeof(*result), Z_WAITOK | Z_ZERO);
+	unsigned room = sizeof(result->elements), have;
+	uint64_t now = now_ms();
+	int error;
+
+	if (result == NULL) {
+		return ENOMEM;
+	}
+	if (request->req_len >= sizeof(*result) && copyin(request->req_data, result, offsetof(struct apple80211_scan_result,
+	    elements)) == 0 && result->elements_length < room) {
+		room = result->elements_length;
+	}
+	bzero(result, sizeof(*result));
+	result->version = 1;
+	channel_fill(&result->channel, bss->freq);
+	result->rssi = bss->rssi;
+	result->noise = -95;
+	result->snr = (int16_t)(bss->rssi + 95);
+	result->beacon_interval = bss->beacon_int;
+	result->capability = bss->capab;
+	memcpy(result->bssid, bss->bssid, sizeof(result->bssid));
+	result->ssid_length = MIN(bss->ssid_len, (uint8_t)NWLAN_SSID_MAX);
+	memcpy(result->ssid, bss->ssid, result->ssid_length);
+	result->age_ms = bss->seen_ms != 0 && now > bss->seen_ms ? (uint32_t)MIN(now - bss->seen_ms, 0xffffffffull) : 0;
+	/* the elements as a beacon has them: SSID (0) first, then what the driver kept (rates, RSN, WPA, HT, VHT) */
+	have = 2u + result->ssid_length + MIN(bss->ie_len, (uint16_t)NWLAN_IE_MAX);
+	if (have <= room) {
+		result->elements[0] = 0;
+		result->elements[1] = result->ssid_length;
+		memcpy(result->elements + 2, bss->ssid, result->ssid_length);
+		memcpy(result->elements + 2 + result->ssid_length, bss->ie, MIN(bss->ie_len, (uint16_t)NWLAN_IE_MAX));
+		result->elements_length = (uint16_t)have;
+	}
+	/* rates (elements 1 and 50, units of 500 kbit/s) */
+	for (unsigned at = 0; at + 2 <= result->elements_length && at + 2 + result->elements[at + 1] <= result->elements_length;
+	    at += 2 + result->elements[at + 1]) {
+		for (unsigned i = 0; (result->elements[at] == 1 || result->elements[at] == 50) && i < result->elements[at + 1]; i++) {
+			unsigned rate = (result->elements[at + 2 + i] & 0x7f) / 2;
+
+			if (rate != 0 && rate <= 54 && result->rate_count < 15) {
+				result->rates[result->rate_count++] = rate;
+			}
+		}
+	}
+	error = give(request, result, sizeof(*result));
+	kfree_data(result, sizeof(*result));
+	return error;
+}
+
+/* the joined network as a struct nwlan_bss (for CURRENT_NETWORK) */
+static void
+joined_bss(const struct nwlan_link *link, struct nwlan_bss *bss)
+{
+	bzero(bss, sizeof(*bss));
+	/* the scan list has the elements of the joined BSS; take them when it is there */
+	for (uint32_t i = 0; nwios_result(i, bss); i++) {
+		if (memcmp(bss->bssid, link->bssid, 6) == 0) {
+			bss->rssi = link->rssi;
+			return;
+		}
+	}
+	bzero(bss, sizeof(*bss));
+	memcpy(bss->bssid, link->bssid, 6);
+	bss->ssid_len = MIN(link->ssid_len, (uint8_t)NWLAN_SSID_MAX);
+	memcpy(bss->ssid, link->ssid, bss->ssid_len);
+	bss->rssi = link->rssi;
+	bss->freq = link->freq;
+	bss->beacon_int = 100;
+	bss->capab = (uint16_t)(0x0001 | (link->security != NWLAN_SEC_OPEN ? 0x0010 : 0));
+	bss->security = link->security;
+}
+
+/* 0345: the highest legacy rate (Mbit/s) in the rates elements (1, 50) of a BSS; 0 if it has none */
+static unsigned
+bss_best_rate(const struct nwlan_bss *bss)
+{
+	unsigned best = 0, length = MIN(bss->ie_len, (uint16_t)NWLAN_IE_MAX);
+
+	for (unsigned at = 0; at + 2 <= length && at + 2 + bss->ie[at + 1] <= length; at += 2 + bss->ie[at + 1]) {
+		for (unsigned i = 0; (bss->ie[at] == 1 || bss->ie[at] == 50) && i < bss->ie[at + 1]; i++) {
+			unsigned rate = (bss->ie[at + 2 + i] & 0x7f) / 2;
+
+			if (rate <= 54 && rate > best) {
+				best = rate;
+			}
+		}
+	}
+	return best;
+}
+
+/* ---- get -------------------------------------------------------------------------------------------------- */
+
+static int
+get(struct apple80211req *request)
+{
+	struct nwlan_link *link;
+	int error = 0;
+
+	switch (request->req_type) {
+	case 43:
+	case 44: {                              /* driver and hardware name: text in 256 bytes */
+		static const char name[256] = "negroni: QCA6490 (WCN6855) over PCIe/MHI";
+
+		return give(request, name, sizeof(name));
+	}
+	case 12: {                              /* card capabilities (HakiOS bits: AES, AES-CCM, PM, short slot/preamble, WPA2, WME, SGI20) */
+		uint8_t bits[13] = { 0 };
+		static const uint8_t has[] = { 2, 3, 6, 9, 10, 14, 17, 19 };
+
+		for (unsigned i = 0; i < sizeof(has); i++) {
+			bits[has[i] / 8] |= (uint8_t)(1u << (has[i] % 8));
+		}
+		return give(request, bits, sizeof(bits));
+	}
+	case 19: {                              /* power: one radio; counts as on until en0 exists */
+		struct {
+			uint32_t version, radios, state[4];
+		} answer = { .version = 1, .radios = 1, .state = { !nwios_present() || nwios_powered() } };
+
+		return give(request, &answer, sizeof(answer));
+	}
+	case 15:                                /* op mode: station (APPLE80211_M_STA) */
+		request->req_val = 1;
+		return 0;
+	case 106: {                             /* 0345: RSSI bounds {version, min, max, threshold} (dBm) */
+		struct {
+			uint32_t version;
+			int32_t min, max, threshold;
+		} answer = { .version = 1, .min = RSSI_BOUND_MIN, .max = RSSI_BOUND_MAX, .threshold = RSSI_BOUND_THRESHOLD };
+
+		return give(request, &answer, sizeof(answer));
+	}
+	case 5:                                 /* 0345: power save: off (value) */
+	case 18:                                /* 0345: interference mitigation: off (value) */
+		request->req_val = 0;
+		return 0;
+	case 6: {                               /* 0345: protection mode {version, mode (off), threshold} */
+		struct {
+			uint32_t version, mode, threshold;
+		} answer = { .version = 1 };
+
+		return give(request, &answer, sizeof(answer));
+	}
+	case 27:
+	case 254: {
+		struct apple80211_channels *answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO);
+
+		if (answer == NULL) {
+			return ENOMEM;
+		}
+		answer->version = 1;
+		answer->count = CHANNEL_COUNT;
+		for (unsigned i = 0; i < CHANNEL_COUNT; i++) {
+			channel_fill(&answer->channels[i], channel_list[i]);
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 207: {
+		struct apple80211_channels_info *answer = kalloc_data(sizeof(*answer), Z_WAITOK | Z_ZERO);
+
+		if (answer == NULL) {
+			return ENOMEM;
+		}
+		answer->count = CHANNEL_COUNT;
+		for (unsigned i = 0; i < CHANNEL_COUNT; i++) {
+			struct apple80211_channel channel;
+
+			channel_fill(&channel, channel_list[i]);
+			answer->number[i] = (uint8_t)channel.channel;
+			answer->dfs[i] = channel_radar(channel_list[i]);
+			answer->passive[i] = channel_radar(channel_list[i]);
+			answer->flags[i] = channel.flags;
+		}
+		error = give(request, answer, sizeof(*answer));
+		kfree_data(answer, sizeof(*answer));
+		return error;
+	}
+	case 21:
+		lck_mtx_lock(&a80211_lock);
+		request->req_val = (int32_t)join_result;
+		lck_mtx_unlock(&a80211_lock);
+		return 0;
+	case 11: {                              /* one BSS of the last scan per request; EIO: that was all */
+		struct nwlan_bss *bss = kalloc_data(sizeof(*bss), Z_WAITOK);
+		unsigned index;
+
+		if (bss == NULL) {
+			return ENOMEM;
+		}
+		lck_mtx_lock(&a80211_lock);
+		index = result_next++;
+		lck_mtx_unlock(&a80211_lock);
+		error = nwios_result(index, bss) ? give_network(request, bss) : EIO;
+		kfree_data(bss, sizeof(*bss));
+		return error;
+	}
+	default:
+		break;
+	}
+
+	if ((link = kalloc_data(sizeof(*link), Z_WAITOK | Z_ZERO)) == NULL) {
+		return ENOMEM;
+	}
+	nwios_link(link);
+	switch (request->req_type) {
+	case 13:                                /* APPLE80211_S_INIT 0, _SCAN 1, _AUTH 2, _ASSOC 3, _RUN 4 */
+		request->req_val = nwios_joined() ? 4 : link->state == NWLAN_STATE_HANDSHAKE ? 3 :
+		    link->state == NWLAN_STATE_JOINING ? 2 : link->state == NWLAN_STATE_SCANNING ? 1 : 0;
+		break;
+	case 1:
+		if (!nwios_joined()) {
+			error = ENXIO;
+		} else if ((error = give(request, link->ssid, MIN(link->ssid_len, (uint8_t)NWLAN_SSID_MAX))) == 0) {
+			request->req_len = MIN(link->ssid_len, (uint8_t)NWLAN_SSID_MAX);
+		}
+		break;
+	case 9:
+		error = !nwios_joined() ? ENXIO : give(request, link->bssid, 6);
+		break;
+	case 4: {
+		struct {
+			uint32_t version;
+			struct apple80211_channel channel;
+		} answer = { .version = 1 };
+
+		if (!nwios_joined()) {
+			error = ENXIO;
+		} else {
+			channel_fill(&answer.channel, link->freq);
+			error = give(request, &answer, sizeof(answer));
+		}
+		break;
+	}
+	case 16: {
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} answer = { .version = 1, .radios = 1, .each = { link->rssi }, .all = link->rssi,
+			     .each_ext = { link->rssi }, .all_ext = link->rssi };
+
+		error = !nwios_joined() ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 14: {                              /* 0345: PHY mode {version, supported, active}: a/b/g; active 0 when not joined */
+		struct {
+			uint32_t version, supported, active;
+		} answer = { .version = 1, .supported = PHY_11A | PHY_11B | PHY_11G };
+
+		if (nwios_joined()) {
+			answer.active = link->freq != 0 && link->freq < 4000 ? PHY_11G : PHY_11A;
+		}
+		error = give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 17: {                              /* 0345: noise, the RSSI layout; the driver measures none: -95 dBm */
+		struct {
+			uint32_t version, radios, unit;
+			int32_t each[4], all, each_ext[4], all_ext;
+		} answer = { .version = 1, .radios = 1, .each = { NOISE_DBM }, .all = NOISE_DBM, .each_ext = { NOISE_DBM },
+			     .all_ext = NOISE_DBM };
+
+		error = !nwios_joined() ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	case 8: {                               /* 0345: rate (value, Mbit/s): the joined BSS's best legacy rate, not measured */
+		struct nwlan_bss *bss = kalloc_data(sizeof(*bss), Z_WAITOK);
+		unsigned rate;
+
+		if (bss == NULL) {
+			error = ENOMEM;
+		} else {
+			if (!nwios_joined()) {
+				error = ENXIO;
+			} else {
+				joined_bss(link, bss);
+				rate = bss_best_rate(bss);
+				request->req_val = (int32_t)(rate != 0 ? rate : 54);
+			}
+			kfree_data(bss, sizeof(*bss));
+		}
+		break;
+	}
+	case 103: {
+		struct nwlan_bss *bss = kalloc_data(sizeof(*bss), Z_WAITOK);
+
+		if (bss == NULL) {
+			error = ENOMEM;
+		} else {
+			if (!nwios_joined()) {
+				error = ENXIO;
+			} else {
+				joined_bss(link, bss);
+				error = give_network(request, bss);
+			}
+			kfree_data(bss, sizeof(*bss));
+		}
+		break;
+	}
+	case 2: {                               /* open system; upper 8 = WPA2-PSK, 0 = none */
+		struct {
+			uint32_t version, lower, upper, extended;
+		} answer = { .version = 1, .lower = 1, .upper = link->security & NWLAN_SEC_WPA2_PSK ? 8 : 0 };
+
+		error = !nwios_joined() ? ENXIO : give(request, &answer, sizeof(answer));
+		break;
+	}
+	default:
+		error = EOPNOTSUPP;
+		break;
+	}
+	kfree_data(link, sizeof(*link));
+	return error;
+}
+
+/* ---- set -------------------------------------------------------------------------------------------------- */
+
+static int
+set_scan(const struct apple80211req *request, char *said, size_t said_size)
+{
+	struct apple80211_scan_request *asked;
+	int error;
+
+	if (request->req_type == 86) {
+		/*
+		 * 0345: SCAN_REQ_MULTIPLE (IO80211 Apple80211ScanDynamic; a list of names and channels). The driver scans all
+		 * channels passively in any case (0326), so this is the same scan as type 10; the layout is not read.
+		 */
+		if (!nwios_present()) {
+			return EBUSY;
+		}
+		snprintf(said, said_size, " (a scan of several names, %u bytes)", request->req_len);
+		lck_mtx_lock(&a80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&a80211_lock);
+		return nwios_scan();
+	}
+	if (request->req_len != sizeof(*asked)) {
+		return EINVAL;
+	}
+	if (!nwios_present()) {
+		return EBUSY;                   /* the radio is being brought up: the framework retries */
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK);
+	if (asked == NULL) {
+		return ENOMEM;
+	}
+	error = copyin(request->req_data, asked, sizeof(*asked));
+	if (error == 0) {
+		/* the driver scans every channel passively (0326); the request's channels and names are only logged */
+		snprintf(said, said_size, " (a scan: type %u, %u channels, %u ms each, a name of %u bytes, %u more names)",
+		    asked->scan_type, asked->channel_count, asked->dwell_ms, asked->ssid_length, asked->name_count);
+		lck_mtx_lock(&a80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&a80211_lock);
+		error = nwios_scan();
+	}
+	kfree_data(asked, sizeof(*asked));
+	return error;
+}
+
+static int
+set_join(const struct apple80211req *request, char *said, size_t said_size)
+{
+	static const char hex[] = "0123456789abcdef";
+	struct apple80211_assoc *asked;
+	char *psk;
+	uint32_t psk_len = 0;
+	int error;
+
+	if (request->req_len < offsetof(struct apple80211_assoc, rest)) {
+		return EINVAL;
+	}
+	asked = kalloc_data(sizeof(*asked), Z_WAITOK | Z_ZERO);
+	psk = kalloc_data(NWLAN_PSK_MAX + 1, Z_WAITOK | Z_ZERO);
+	if (asked == NULL || psk == NULL) {
+		error = ENOMEM;
+		goto out;
+	}
+	if ((error = copyin(request->req_data, asked, offsetof(struct apple80211_assoc, rest))) != 0) {
+		goto out;
+	}
+	snprintf(said, said_size, " (a join: a name of %u bytes, %s access point, authentication %#x/%#x, a key of %u bytes of kind %u)",
+	    asked->ssid_length, (asked->bssid[0] | asked->bssid[1] | asked->bssid[2] | asked->bssid[3] | asked->bssid[4] |
+	    asked->bssid[5]) ? "a given" : "any", asked->auth_lower, asked->auth_upper, asked->key_length, asked->key_cipher);
+	if (asked->ssid_length == 0 || asked->ssid_length > NWLAN_SSID_MAX) {
+		error = EINVAL;
+		goto out;
+	}
+	if (asked->key_length == 0) {
+		psk_len = 0;
+	} else if (asked->key_cipher == CIPHER_PASSPHRASE && asked->key_length >= NWLAN_PSK_MIN && asked->key_length <= 63) {
+		memcpy(psk, asked->key, asked->key_length);
+		psk_len = asked->key_length;
+	} else if (asked->key_cipher == CIPHER_PMK && asked->key_length == 32) {
+		for (unsigned i = 0; i < 32; i++) {     /* the seam takes a raw PMK as 64 hex digits */
+			psk[2 * i] = hex[asked->key[i] >> 4];
+			psk[2 * i + 1] = hex[asked->key[i] & 0xf];
+		}
+		psk_len = 64;
+	} else {
+		error = EINVAL;
+		goto out;
+	}
+	lck_mtx_lock(&a80211_lock);
+	join_result = 0;
+	lck_mtx_unlock(&a80211_lock);
+	error = nwios_associate(asked->ssid, asked->ssid_length, psk_len != 0 ? psk : NULL, psk_len);
+out:
+	if (asked != NULL) {
+		memset_s(asked, sizeof(*asked), 0, sizeof(*asked));
+		kfree_data(asked, sizeof(*asked));
+	}
+	if (psk != NULL) {
+		memset_s(psk, NWLAN_PSK_MAX + 1, 0, NWLAN_PSK_MAX + 1);
+		kfree_data(psk, NWLAN_PSK_MAX + 1);
+	}
+	return error;
+}
+
+static int
+set(const struct apple80211req *request, char *said, size_t said_size)
+{
+	switch (request->req_type) {
+	case 20:
+		return set_join(request, said, said_size);
+	case 22:
+		return nwios_disassociate();
+	case 19: {
+		struct {
+			uint32_t version, radios, state[4];
+		} asked;
+		int error;
+
+		if (request->req_len < sizeof(asked)) {
+			return EINVAL;
+		}
+		if ((error = copyin(request->req_data, &asked, sizeof(asked))) != 0) {
+			return error;
+		}
+		snprintf(said, said_size, " (power: %s)", asked.state[0] ? "on" : "off");
+		return nwios_set_power(asked.state[0] != 0);
+	}
+	case 10:
+	case 86:
+		return set_scan(request, said, said_size);
+	case 5:                                 /* 0345: power save (value): the driver has none; accepted */
+	case 365:                               /* 0345: display state (value: on/off): nothing to do; accepted */
+	case 382:                               /* 0345: abort scan: the passive scan ends by itself (SCAN_DONE) */
+		snprintf(said, said_size, " (accepted, nothing to do)");
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+/* ---- events ------------------------------------------------------------------------------------------------ */
+
+static void
+post(uint32_t code, const void *data, uint32_t length)
+{
+	struct kev_msg message = { .vendor_code = KEV_VENDOR_APPLE, .kev_class = KEV_IEEE80211_CLASS, .kev_subclass = 1,
+		                   .event_code = code };
+	char name[16];
+
+	memcpy(name, interface_name, sizeof(name));
+	message.dv[0].data_length = sizeof(name);
+	message.dv[0].data_ptr = name;
+	if (length != 0) {
+		message.dv[1].data_length = length;
+		message.dv[1].data_ptr = __DECONST(void *, data);
+	}
+	kev_post_msg(&message);
+}
+
+void
+negroni_apple80211_event(enum nwios_event event, int status)
+{
+	static unsigned said;
+
+	if (said < 200) {
+		said++;
+		printf("NEGRONI WLAN iOS: Apple80211 event: %s, %d\n", event == NWIOS_EV_POWER ? "power" : event == NWIOS_EV_SCAN_DONE ?
+		    "scan done" : event == NWIOS_EV_JOIN_DONE ? "join done" : "link", status);
+	}
+	switch (event) {
+	case NWIOS_EV_POWER:
+		post(EVENT_POWER_CHANGED, NULL, 0);
+		break;
+	case NWIOS_EV_SCAN_DONE:
+		lck_mtx_lock(&a80211_lock);
+		result_next = 0;
+		lck_mtx_unlock(&a80211_lock);
+		post(EVENT_SCAN_DONE, NULL, 0);
+		break;
+	case NWIOS_EV_JOIN_DONE:
+		/* 1 success, 21 invalid PMK (wrong passphrase), 9 time-out, 2 failure */
+		lck_mtx_lock(&a80211_lock);
+		join_result = status == 0 ? 1 : status == EAUTH ? 21 : status == ETIMEDOUT ? 9 : 2;
+		lck_mtx_unlock(&a80211_lock);
+		post(EVENT_ASSOC_DONE, NULL, 0);
+		break;
+	case NWIOS_EV_LINK: {
+		struct apple80211_link_changed data = { .down = status != 1, .involuntary = status != 1 && status != 0,
+			                                .reason = status != 1 && status != 0 ? 4 : 0 };
+		struct nwlan_link link;
+
+		nwios_link(&link);
+		data.rssi = status == 1 ? link.rssi : 0;
+		post(EVENT_SSID_CHANGED, NULL, 0);
+		post(EVENT_BSSID_CHANGED, NULL, 0);
+		post(EVENT_LINK_CHANGED, &data, sizeof(data));
+		break;
+	}
+	}
+}
+
+/* ---- per-type counts (said once, 180 s after en0) ----------------------------------------------------------- */
+
+static struct {
+	int32_t type;
+	bool set;
+	unsigned times, answered;
+	int last_error;
+	int said_error;                 /* 0345: the result of the last request line said for this kind */
+	int32_t said_val;               /* 0345: the value of that line (gets: 21 ASSOCIATE_RESULT 0 -> 1, 13 STATE) */
+} kinds[96];
+static unsigned kind_count;
+static uint64_t requests_total, requests_at_summary;
+
+/*
+ * Count the request; true if it gets a log line (0345): the first PER_KIND_LOG of its kind, or a result (error, or
+ * for a get the value) that differs from the last one said for its kind. Scans, joins, leaves and power sets are said
+ * in any case (the caller).
+ */
+static bool
+note(const struct apple80211req *request, bool is_set, int error)
+{
+	bool say = false;
+	unsigned i;
+
+	lck_mtx_lock(&a80211_lock);
+	requests_total++;
+	for (i = 0; i < kind_count && !(kinds[i].type == request->req_type && kinds[i].set == is_set); i++) {
+	}
+	if (i < sizeof(kinds) / sizeof(kinds[0])) {
+		if (i == kind_count) {
+			kinds[kind_count].type = request->req_type;
+			kinds[kind_count].set = is_set;
+			kind_count++;
+		}
+		kinds[i].times++;
+		kinds[i].answered += error == 0;
+		kinds[i].last_error = error != 0 ? error : kinds[i].last_error;
+		say = kinds[i].times <= PER_KIND_LOG || kinds[i].said_error != error ||
+		    (!is_set && kinds[i].said_val != request->req_val);
+		if (say) {
+			kinds[i].said_error = error;
+			kinds[i].said_val = request->req_val;
+		}
+	} else {
+		say = true;                     /* the table is full: say every one of the other kinds */
+	}
+	lck_mtx_unlock(&a80211_lock);
+	return say;
+}
+
+/* 0345: true if requests came since the last summary (the worker says one every 600 s then) */
+bool
+negroni_apple80211_summary_due(void)
+{
+	return requests_total != requests_at_summary;
+}
+
+void
+negroni_apple80211_summary(void)
+{
+	requests_at_summary = requests_total;
+	printf("NEGRONI WLAN iOS: Apple80211 summary: %u request kinds, %llu requests\n", kind_count, requests_total);
+	for (unsigned i = 0; i < kind_count; i++) {
+		printf("NEGRONI WLAN iOS: Apple80211 %s %d (%s) %u times, answered %u, last refusal %d%s\n", kinds[i].set ? "set" : "get",
+		    kinds[i].type, type_name(kinds[i].type), kinds[i].times, kinds[i].answered, kinds[i].last_error,
+		    kinds[i].last_error == EOPNOTSUPP ? " (not built)" : "");
+	}
+}
+
+/* ---- entry ------------------------------------------------------------------------------------------------- */
+
+int
+negroni_apple80211_ioctl(unsigned long command, void *data)
+{
+	static unsigned said, said_key;
+	struct apple80211req *request = data;
+	char who[32] = "?", what[200] = "";
+	bool is_set = command == SIOCSA80211_CMD, key, say;
+	int error;
+
+	if (command != SIOCSA80211_CMD && command != SIOCGA80211_CMD) {
+		return EOPNOTSUPP;
+	}
+	proc_selfname(who, sizeof(who));
+	/*
+	 * Root only (wifid runs as root: its launchd job has no UserName [V 20H392]): every set, and the gets that
+	 * reveal where the phone is (SSID 1, BSSID 9, scan results 11, current network 103).
+	 */
+	if ((is_set || request->req_type == 1 || request->req_type == 9 || request->req_type == 11 || request->req_type == 103) &&
+	    !kauth_cred_issuser(kauth_cred_get())) {
+		error = EPERM;
+	} else {
+		error = is_set ? set(request, what, sizeof(what)) : get(request);
+	}
+	/* scans (10, 86), joins (20), leaves (22) and power sets (19): always said, up to KEY_LOG_MAX lines */
+	key = is_set && (request->req_type == 10 || request->req_type == 86 || request->req_type == 20 ||
+	    request->req_type == 22 || request->req_type == 19);
+	say = note(request, is_set, error);
+
+	/* negroniwlan_ios_log=0 turns all request lines off, the key lines too */
+	if (negroni_wlan_ios_log_max() != 0 && (key ? said_key < KEY_LOG_MAX : (say && said < negroni_wlan_ios_log_max()))) {
+		if (key) {
+			said_key++;
+		} else {
+			said++;
+		}
+		printf("NEGRONI WLAN iOS: %s %s %d (%s), value %d, %u bytes%s: %s%s\n", who, is_set ? "sets" : "gets", request->req_type,
+		    type_name(request->req_type), request->req_val, request->req_len, what, error == 0 ? "answered" :
+		    error == EOPNOTSUPP ? "REFUSED (not built)" : "error ", error == 0 || error == EOPNOTSUPP ? "" :
+		    (error == ENXIO ? "ENXIO" : error == EIO ? "EIO (end of list)" : error == ENETDOWN ? "ENETDOWN" :
+		    error == EBUSY ? "EBUSY" : error == EINVAL ? "EINVAL" : error == EPERM ? "EPERM (not root)" : "other"));
+	}
+	return error;
+}
