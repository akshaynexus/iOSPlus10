+void negroni_wlan_sta_service(void);
+/* the BSS of a frame, element walk; host-testable (no kernel state). 0, ENOENT (not a beacon/probe resp), EBADMSG */
+int negroni_wlan_sta_parse_bss(const uint8_t *f, uint32_t len, struct nwlan_bss *out);
+
+/* negroni_wlan_wmi.c (0326): a passive scan of all channels on vdev 0, without waiting */
+int negroni_wlan_wmi_scan_start(void);
+
+/* negroni_wlan_wmi.c */
+const uint8_t *negroni_wlan_wmi_mac(void);
+uint32_t negroni_wlan_wmi_pdev_id(void);
+uint32_t negroni_wlan_wmi_chains(void);
+int negroni_wlan_wmi_send(uint32_t cmd, const void *tlvs, uint32_t len);
+int negroni_wlan_wmi_wait(volatile bool *flag, uint32_t ms, const char *what);
+
+/* negroni_wlan_sta.c helpers for the join / data / WPA parts */
+bool negroni_wlan_sta_find(const uint8_t *ssid, uint32_t ssid_len, struct nwlan_bss *out);
+void negroni_wlan_sta_set_link(const struct nwlan_bss *b, uint32_t state, int error, uint16_t reason, uint16_t aid);
+uint32_t negroni_wlan_sta_state(void);
+bool negroni_wlan_sta_scanning(void);
+void negroni_wlan_sta_scan_cancel(void);
+void negroni_wlan_sta_join_failed(const struct nwlan_bss *b, int error, uint16_t reason);
+void negroni_wlan_sta_deliver(const uint8_t *frame, uint32_t len);
+
+/* a small DMA buffer: contiguous, Normal NC CPU view, device address (IOVA) (negroni_wlan_join.c, 0327) */
+struct nwlan_dma {
+	vm_offset_t kva, nc;
+	uint64_t pa, dva;
+	uint32_t size;
+};
+int negroni_wlan_dma_alloc(uint32_t size, struct nwlan_dma *d);
+void negroni_wlan_dma_free(struct nwlan_dma *d);
+/* clear a secret (not optimised away) */
+void negroni_wlan_wipe(void *p, size_t n);
+
+/* negroni_wlan_join.c (0327) */
+bool negroni_wlan_join_wmi_event(uint32_t id, const uint8_t *p, uint32_t len);
+int negroni_wlan_peer_set_param(const uint8_t mac[6], uint32_t param, uint32_t value);
+void negroni_wlan_join_handshake_done(int error, uint16_t reason);
+const struct nwlan_bss *negroni_wlan_join_bss(void);
+
