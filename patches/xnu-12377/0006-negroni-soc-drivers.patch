+	uint64_t session = 0;
+
+	say("  SCM %s: smc %#llx (%#llx, %#llx, %#llx)", what, function, a0, a1, a2);
+	for (int i = 0; i < 2000000; i++) {     /* 0317 (as 0240, 2026-10-27): Linux resumes until done; 100 was too few */
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = args;
+		register uint64_t x2 __asm__("x2") = a0;
+		register uint64_t x3 __asm__("x3") = a1;
+		register uint64_t x4 __asm__("x4") = a2;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			say("  SCM %s -> %d, answer %#llx (%d resumes)", what, (int32_t)x0, x1, i);
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	say("  SCM %s keeps returning interrupted", what);
+	return -1;
+}
+
+/* RCG to source src with divider field hid (level 4 path clocks) */
+static bool
+rcg_set(const char *name, uint32_t off, uint32_t src, uint32_t hid)
+{
+	vm_offset_t cmd = camcc + off;
+	uint32_t got = 0, cfg = rd(cmd + 4);
+
+	wr(cmd + 4, (cfg & ~RCG_CFG_MASK) | (hid & 0x1fu) | (src & 7u) << 8);
+	wr(cmd, rd(cmd) | RCG_CMD_ROOT_EN);
+	wr(cmd, rd(cmd) | RCG_CMD_UPDATE);
+	bool ok = poll(cmd, RCG_CMD_UPDATE, 0, 500, &got);
+	wr(cmd, rd(cmd) & ~RCG_CMD_ROOT_EN);
+	say("  %s: cfg %#x -> %#x (src %u div field %u), cmd %#x%s", name, cfg, rd(cmd + 4), src, hid, got,
+	    ok ? "" : " (UPDATE stuck)");
+	return ok;
+}
+
+/* clk_lucid_evo_pll_configure + alpha_pll_lucid_evo_enable (clk-alpha-pll.c:2969-3105) */
+static bool
+pll_enable(const struct cam_pll *p)
+{
+	vm_offset_t b = camcc + p->off;
+	uint32_t mode = rd(b + PLL_MODE), op = rd(b + PLL_OPMODE), user = rd(b + PLL_USER_CTL), got = 0;
+
+	say("  %s: mode %#x opmode %#x user_ctl %#x l %#x", p->name, mode, op, user, rd(b + PLL_L_VAL));
+	if (user & PLL_VOTE_RUN) {
+		say("  %s is in FSM vote mode: not ours, not touched", p->name);
+		return false;
+	}
+	if ((op & 1u) && (mode & PLL_OUTCTRL)) {
+		say("  %s already runs: not ours, used as is", p->name);
+		return true;
+	}
+	wr(b + PLL_L_VAL, (p->cal_l << 16) | p->l);
+	wr(b + PLL_ALPHA_VAL, p->alpha);
+	wr(b + PLL_CONFIG_CTL, p->cfg);
+	wr(b + PLL_CONFIG_CTL_U, p->cfg_u);
+	wr(b + PLL_CONFIG_CTL_U1, p->cfg_u1);
+	wr(b + PLL_USER_CTL, p->user);
+	wr(b + PLL_USER_CTL_U, p->user_u);
+	wr(b + PLL_MODE, rd(b + PLL_MODE) & ~PLL_OUTCTRL);
+	wr(b + PLL_OPMODE, 0);                  /* STANDBY */
+	wr(b + PLL_MODE, rd(b + PLL_MODE) | PLL_RESET_N);
+	wr(b + PLL_OPMODE, 1);                  /* RUN */
+	bool ok = poll(b + PLL_MODE, PLL_LOCK_DET, PLL_LOCK_DET, 200, &got);     /* Linux: 100 x 1 us */
+	if (!ok) {
+		say("  %s: no LOCK_DET (mode %#x)", p->name, got);
+		wr(b + PLL_OPMODE, 0);
+		return false;
+	}
+	wr(b + PLL_USER_CTL, rd(b + PLL_USER_CTL) | PLL_OUT_MASK);
+	wr(b + PLL_MODE, rd(b + PLL_MODE) | PLL_OUTCTRL);
+	say("  %s locked: mode %#x user_ctl %#x", p->name, rd(b + PLL_MODE), rd(b + PLL_USER_CTL));
+	return true;
+}
+
+static void
+pll_disable(const struct cam_pll *p)
+{
+	vm_offset_t b = camcc + p->off;
+	wr(b + PLL_MODE, rd(b + PLL_MODE) & ~PLL_OUTCTRL);
+	wr(b + PLL_USER_CTL, rd(b + PLL_USER_CTL) & ~PLL_OUT_MASK);
+	wr(b + PLL_OPMODE, 0);
+	say("  %s off: mode %#x", p->name, rd(b + PLL_MODE));
+}
