+static void
+k_step20(void)
+{
+	k_args();
+	if (k_busy_pct) {
+		wr(gmu + GMU_REG(K_AO_GPU_CX_BUSY_MASK), 0xff000000);
+		wr(gmu + GMU_REG(K_POWER_COUNTER_SELECT_0), (rd(gmu + GMU_REG(K_POWER_COUNTER_SELECT_0)) & ~0xffu) | 0x20);
+		wr(gmu + GMU_REG(K_POWER_COUNTER_ENABLE), 1);
+	}
+	if (k_protect) {
+		wr(gpu_regs + GPU_WORD(K_CP_PROTECT_CNTL), 1u << 0 | 1u << 1 | 1u << 3);
+		for (unsigned i = 0; i < sizeof(k_protect_regs) / sizeof(k_protect_regs[0]); i++) {
+			uint32_t count = k_protect_regs[i].end - k_protect_regs[i].start;
+			wr(gpu_regs + GPU_WORD(K_CP_PROTECT_REG + k_protect_regs[i].idx),
+			    (k_protect_regs[i].start & 0x3ffff) | (count & 0x1fff) << 18 | k_protect_regs[i].noaccess << 31);
+		}
+	}
+	if (k_chicken) {
+		wr(gpu_regs + GPU_WORD(K_CP_CHICKEN_DBG), 1);
+		wr(gpu_regs + GPU_WORD(K_CP_BV_CHICKEN_DBG), 1);
+		wr(gpu_regs + GPU_WORD(K_CP_LPAC_CHICKEN_DBG), 1);
+	}
+	if (k_hwcg) {
+		wr(gmu + GMU_REG(K_AO_CGC_MODE_CNTL), 0x00020000);
+		wr(gmu + GMU_REG(K_AO_CGC_DELAY_CNTL), 0x00010111);
+		wr(gmu + GMU_REG(K_AO_CGC_HYST_CNTL), 0x00005555);
+		for (unsigned i = 0; i < sizeof(k_hwcg_regs) / sizeof(k_hwcg_regs[0]); i++) {
+			wr(gpu_regs + GPU_WORD(k_hwcg_regs[i][0]), k_hwcg_regs[i][1]);
+		}
+		wr(gpu_regs + GPU_WORD(K_RBBM_CLOCK_CNTL), 0x8aa8aa82);
+	}
+	printf("NEGRONI ADRENO: 20 KGSL settings (0298): busy counter %s, CP_PROTECT %s (%u ranges), CHICKEN_DBG %s, HWCG %s "
+	    "(%u registers, RBBM_CLOCK_CNTL %#x), rptr shadow %s, ME_INIT DMS %s\n", k_busy_pct ? "on" : "off",
+	    k_protect ? "on" : "off", (unsigned)(sizeof(k_protect_regs) / sizeof(k_protect_regs[0])), k_chicken ? "1" : "untouched",
+	    k_hwcg ? "on" : "off", (unsigned)(sizeof(k_hwcg_regs) / sizeof(k_hwcg_regs[0])),
+	    rd(gpu_regs + GPU_WORD(K_RBBM_CLOCK_CNTL)), k_rptr_shadow ? "on" : "off", k_dms_off ? "off (BIT(11))" : "default");
+}
