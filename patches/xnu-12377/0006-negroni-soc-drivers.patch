+/*
+ * ---- level 10 (patch 0323): steps 33-35, one STA vdev and a passive scan ----
+ *   step 33  WMI channel list   WMI_PDEV_SET_HW_MODE DBS (ath11k core.c:2203-2210 for single_pdev_only with 2
+ *                               rxdma) and WMI_SCAN_CHAN_LIST: 2.4 GHz 1-13 and 5 GHz 36-165, every channel
+ *                               passive (nothing is transmitted)
+ *   step 34  WMI VDEV_CREATE    vdev 0, type STA, the chip's MAC, the pdev id of SERVICE_READY_EXT, tx/rx
+ *                               streams per band = the RF chains (wmi.c:726-800)
+ *   step 35  WMI passive scan   WMI_START_SCAN (wmi.c:2264, ath11k_wmi_start_scan_init timings, passive flag),
+ *                               the SCAN events, and every beacon / probe response in WMI_MGMT_RX: one line per
+ *                               new BSS with its SSID and RSSI (rssi = snr - 95, core.h:605)
+ * Without the HTT/REO data path (0324+) the firmware still sends management frames as WMI MGMT_RX events
+ * (ath11k wmi.c ath11k_mgmt_rx_event) [I: ath11k always sets the HTT rings up before a scan, so an empty scan
+ * result here points at the missing rxdma rings first].
+ */
+#define WMI_SCAN_FLAG_PASSIVE           0x1u
+#define WMI_SCAN_CHAN_STAT_EVENT        0x10u
+#define WMI_SCAN_EV_STARTED             0x1u
+#define WMI_SCAN_EV_COMPLETED           0x2u
+#define WMI_SCAN_EV_BSS_CHANNEL         0x4u
+#define WMI_SCAN_EV_FOREIGN_CHAN        0x8u
+#define WMI_SCAN_EV_DEQUEUED            0x10u
+#define WMI_SCAN_EV_START_FAILED        0x40u
+#define WMI_CHAN_MODE_11A               0u
+#define WMI_CHAN_MODE_11G               1u
+#define WMI_CHAN_PASSIVE                (1u << 7)
+#define WMI_CHAN_DFS                    (1u << 10)
+#define WMI_CHAN_ALLOW_HT               (1u << 11)
+#define WMI_VDEV_TYPE_STA               2u
+#define WLAN_NOISE_FLOOR                (-95)
+#define WLAN_SCAN_ID                    0xa001u
+#define WLAN_BSS_MAX                    64u
+
+static const uint16_t g_freqs[] = {
+	2412, 2417, 2422, 2427, 2432, 2437, 2442, 2447, 2452, 2457, 2462, 2467, 2472,
+	5180, 5200, 5220, 5240, 5260, 5280, 5300, 5320,
+	5500, 5520, 5540, 5560, 5580, 5600, 5620, 5640, 5660, 5680, 5700, 5720,
+	5745, 5765, 5785, 5805, 5825,
+};
+#define NFREQ   ((uint32_t)(sizeof(g_freqs) / sizeof(g_freqs[0])))
+
+struct bss_seen {
+	uint8_t bssid[6];
+	int32_t rssi;
+	uint32_t freq, frames;
+};
+static struct {
+	volatile bool started, completed, failed, hw_mode_resp;
+	uint32_t events, reason, foreign, frames, beacons, other_frames, bad, nbss, dropped;
+	struct bss_seen bss[WLAN_BSS_MAX];
+} S;
+
+static void
+scan_mgmt_rx(const uint8_t *p, uint32_t len)
+{
+	struct wmi_tlv_it it = { p, p + len };
+	const uint8_t *v, *hdr = NULL, *frame = NULL;
+	uint32_t tag, l, hl = 0, fl = 0;
+	struct wlan_bss b;
+
+	while (negroni_wmi_tlv_next(&it, &tag, &v, &l) == 1) {
+		if (tag == WMI_TAG_MGMT_RX_HDR && !hdr) {
+			hdr = v;
+			hl = l;
+		} else if (tag == WMI_TAG_ARRAY_BYTE && !frame) {
+			frame = v;
+			fl = l;
+		}
+	}
+	if (!hdr || hl < 6 * 4 || !frame) {
+		S.bad++;
+		return;
+	}
+	uint32_t snr = rd32(hdr + 4), buf_len = rd32(hdr + 16), status = rd32(hdr + 20);
+	uint32_t freq = hl >= 17 * 4 ? rd32(hdr + 64) : 0;
+	S.frames++;
+	if (status != 0 || buf_len > fl) {      /* rx error bits, or a length beyond the TLV */
+		S.bad++;
+		return;
+	}
+	negroni_wlan_sta_mgmt_rx(frame, buf_len, (int32_t)snr + WLAN_NOISE_FLOOR, freq);  /* 0326: the API's BSS list */
+	int r = negroni_wlan_beacon_parse(frame, buf_len, &b);
+	if (r == ENOENT) {
+		S.other_frames++;
+		return;
+	}
+	if (r) {
+		S.bad++;
+		return;
+	}
+	S.beacons++;
+	int32_t rssi = (int32_t)snr + WLAN_NOISE_FLOOR;
+	for (uint32_t i = 0; i < S.nbss; i++) {
+		if (!memcmp(S.bss[i].bssid, b.bssid, 6)) {
+			S.bss[i].frames++;
+			if (rssi > S.bss[i].rssi) {
+				S.bss[i].rssi = rssi;
+			}
+			return;
+		}
+	}
+	if (S.nbss >= WLAN_BSS_MAX) {
+		S.dropped++;
+		return;
+	}
+	struct bss_seen *n = &S.bss[S.nbss++];
+	memcpy(n->bssid, b.bssid, 6);
+	n->rssi = rssi;
+	n->freq = freq;
+	n->frames = 1;
+	/* the BSSID's last 3 bytes are masked: the log may be shared */
+	/* 0326: the SSID itself is not logged (privacy): its length only */
+	printf("NEGRONI WLAN: BSS %u: SSID of %u bytes%s, RSSI %d dBm, %u MHz (DS channel %u), BSSID %02x:%02x:%02x:xx:xx:xx, "
+	    "%s, beacon interval %u\n", S.nbss, b.ssid_len, b.hidden ? " (hidden)" : "", rssi, freq, b.channel,
+	    b.bssid[0], b.bssid[1], b.bssid[2], b.rsn ? "RSN" : b.wpa ? "WPA" : (b.capab & 0x10) ? "WEP" : "open",
+	    b.beacon_int);
+}
+
+static void
+scan_cb(uint32_t id, const uint8_t *p, uint32_t len)
+{
+	struct wmi_tlv_it it = { p, p + len };
+	const uint8_t *v;
+	uint32_t tag, l;
+
+	if (id == WMI_MGMT_RX_EVENTID) {
+		scan_mgmt_rx(p, len);
+		return;
+	}
+	if (id == WMI_PDEV_SET_HW_MODE_RESP_EVENTID) {
+		S.hw_mode_resp = true;
+		return;
+	}
+	if (id != WMI_SCAN_EVENTID) {
+		return;                 /* CHAN_INFO: counted with the scan events below */
+	}
+	while (negroni_wmi_tlv_next(&it, &tag, &v, &l) == 1) {
+		if (tag != WMI_TAG_SCAN_EVENT || l < 6 * 4) {
+			continue;
+		}
+		uint32_t ev = rd32(v), reason = rd32(v + 4), freq = rd32(v + 8), scan_id = rd32(v + 16);
+		S.events++;
+		if (scan_id != WLAN_SCAN_ID) {
+			continue;
+		}
+		switch (ev) {
+		case WMI_SCAN_EV_STARTED:
+			S.started = true;
+			printf("NEGRONI WLAN: SCAN event STARTED\n");
+			break;
+		case WMI_SCAN_EV_COMPLETED:
+		case WMI_SCAN_EV_DEQUEUED:
+			S.reason = reason;
+			S.completed = true;
+			negroni_wlan_sta_scan_done(reason);    /* 0326 */
+			break;
+		case WMI_SCAN_EV_START_FAILED:
+			S.reason = reason;
+			S.failed = true;
+			negroni_wlan_sta_scan_done(reason);    /* 0326: the API scan ends too */
+			break;
+		case WMI_SCAN_EV_FOREIGN_CHAN:
+			if (S.foreign++ < 3) {
+				printf("NEGRONI WLAN: SCAN on %u MHz\n", freq);
+			}
+			break;
+		default:
+			break;
+		}
+	}
+}
+
+static int
+wmi_chan_list(void)
+{
+	static uint8_t m[4 + 12 + 4 + NFREQ * 28];
+	uint8_t *p = m, *c;
+	int error;
+
+	/* WMI_PDEV_SET_HW_MODE DBS (pdev id SOC = 0), as ath11k after READY; the response is optional */
+	{
+		uint8_t h[4 + 12];
+		c = put_tlv(h, WMI_TAG_PDEV_SET_HW_MODE_CMD, 12);
+		c = put32(c, 0);
+		c = put32(c, 1);        /* WMI_HOST_HW_MODE_DBS */
+		(void)put32(c, 0);
+		error = negroni_wlan_wmi_send(WMI_PDEV_SET_HW_MODE_CMDID, h, sizeof(h));
+		if (error) {
+			return error;
+		}
+		(void)negroni_wlan_wmi_wait(&S.hw_mode_resp, 2000, "WMI PDEV_SET_HW_MODE_RESP");
+		printf("NEGRONI WLAN: WMI PDEV_SET_HW_MODE DBS %s\n", S.hw_mode_resp ? "answered" : "sent (no answer in 2 s; "
+		    "going on)");
+	}
+	/* 0328: HTT version + the rx rings (ath11k: after the hw mode, before the pdev comes up) */
+	error = negroni_wlan_dp_pdev_setup();
+	if (error) {
+		return error;
+	}
+	/* in pieces that fit the WMI endpoint's max message, the later ones with APPEND (wmi.c:2590-2660) */
+	uint32_t room = g_ep[g_wmi_eid].max_msg > 4 + 16 + 4 ? (g_ep[g_wmi_eid].max_msg - 4 - 16 - 4) / 28 : 0;
+	uint32_t per = MIN(room, NFREQ), sent = 0, sends = 0;
+	if (per == 0) {
+		return negroni_wlan_failed(EMSGSIZE, "WMI max message %u bytes: no room for a channel", g_ep[g_wmi_eid].max_msg);
+	}
+	while (sent < NFREQ) {
+		uint32_t nch = MIN(per, NFREQ - sent);
+		memset(m, 0, sizeof(m));
+		p = m;
+		c = put_tlv(p, WMI_TAG_SCAN_CHAN_LIST_CMD, 12);
+		c = put32(c, nch);
+		c = put32(c, sends ? 1u : 0u);  /* WMI_APPEND_TO_EXISTING_CHAN_LIST_FLAG */
+		p = put32(c, negroni_wlan_wmi_pdev_id());
+		p = put_tlv(p, WMI_TAG_ARRAY_STRUCT, nch * 28);
+		for (uint32_t i = sent; i < sent + nch; i++) {
+			uint32_t f = g_freqs[i];
+			uint32_t info = (f < 4000 ? WMI_CHAN_MODE_11G : WMI_CHAN_MODE_11A) | WMI_CHAN_PASSIVE | WMI_CHAN_ALLOW_HT;
+			if (f >= 5260 && f <= 5720) {
+				info |= WMI_CHAN_DFS;
+			}
+			c = put_tlv(p, WMI_TAG_CHANNEL, 24);
+			c = put32(c, f);                        /* mhz */
+			c = put32(c, f);                        /* band_center_freq1 */
+			c = put32(c, 0);                        /* band_center_freq2 */
+			c = put32(c, info);
+			c = put32(c, (40u << 8) | (40u << 16)); /* reg_info_1: max power, max reg power (0.5 dB units) */
+			p = put32(c, 40u << 8);                 /* reg_info_2: max tx power */
+		}
+		error = negroni_wlan_wmi_send(WMI_SCAN_CHAN_LIST_CMDID, m, (uint32_t)(p - m));
+		if (error) {
+			return error;
+		}
+		sent += nch;
+		sends++;
+	}
+	printf("NEGRONI WLAN: WMI SCAN_CHAN_LIST: %u channels (2.4 GHz 1-13, 5 GHz 36-165) in %u commands, all passive, "
+	    "pdev %u\n", NFREQ, sends, negroni_wlan_wmi_pdev_id());
+	return 0;
+}
+
+static int
+wmi_vdev_create(void)
+{
+	uint8_t m[4 + 36 + 4 + 2 * 16];
+	const uint8_t *mac = negroni_wlan_wmi_mac();
+	uint32_t ch = negroni_wlan_wmi_chains(), mac_lo, mac_hi = 0;
+	uint8_t *p, *c;
+
+	memset(m, 0, sizeof(m));
+	memcpy(&mac_lo, mac, 4);
+	memcpy(&mac_hi, mac + 4, 2);
+	c = put_tlv(m, WMI_TAG_VDEV_CREATE_CMD, 36);
+	c = put32(c, 0);                        /* vdev_id */
+	c = put32(c, WMI_VDEV_TYPE_STA);
+	c = put32(c, 0);                        /* subtype none */
+	c = put32(c, mac_lo);                   /* wmi_mac_addr: 6 bytes + 2 pad */
+	c = put32(c, mac_hi);
+	c = put32(c, 2);                        /* num_cfg_txrx_streams */
+	c = put32(c, negroni_wlan_wmi_pdev_id());
+	c = put32(c, 0);                        /* mbssid_flags */
+	p = put32(c, 0);                        /* mbssid_tx_vdev_id */
+	p = put_tlv(p, WMI_TAG_ARRAY_STRUCT, 2 * 16);
+	for (uint32_t band = 0; band < 2; band++) {     /* WMI_TPC_CHAINMASK_CONFIG_BAND_2G / _5G */
+		c = put_tlv(p, WMI_TAG_VDEV_TXRX_STREAMS, 12);
+		c = put32(c, band);
+		c = put32(c, ch);
+		p = put32(c, ch);
+	}
+	int error = negroni_wlan_wmi_send(WMI_VDEV_CREATE_CMDID, m, (uint32_t)(p - m));
+	if (!error) {
+		printf("NEGRONI WLAN: WMI VDEV_CREATE: vdev 0 STA, MAC %02x:%02x:%02x:%02x:%02x:%02x, pdev %u, %u streams\n",
+		    mac[0], mac[1], mac[2], mac[3], mac[4], mac[5], negroni_wlan_wmi_pdev_id(), ch);
+	}
+	return error;
+}
+
+static int
+wmi_start_scan(void)
+{
+	static uint8_t m[4 + 39 * 4 + 4 + NFREQ * 4 + 4 + 4 + 8 + 4];
+	uint8_t *p, *c;
+
+	memset(m, 0, sizeof(m));
+	c = put_tlv(m, WMI_TAG_START_SCAN_CMD, 39 * 4);
+	uint32_t w[39] = { 0 };
+	w[0] = WLAN_SCAN_ID;                    /* scan_id */
+	w[1] = 1;                               /* scan_req_id */
+	w[2] = 0;                               /* vdev */
+	w[3] = 1;                               /* priority LOW */
+	w[4] = WMI_SCAN_EV_STARTED | WMI_SCAN_EV_COMPLETED | WMI_SCAN_EV_BSS_CHANNEL | WMI_SCAN_EV_FOREIGN_CHAN |
+	    WMI_SCAN_EV_DEQUEUED;
+	w[5] = 50;                              /* dwell active */
+	w[6] = 150;                             /* dwell passive */
+	w[7] = 50;                              /* min rest */
+	w[8] = 500;                             /* max rest */
+	w[12] = 20000;                          /* max scan time */
+	w[13] = 5;                              /* probe delay */
+	w[14] = WMI_SCAN_FLAG_PASSIVE | WMI_SCAN_CHAN_STAT_EVENT;
+	w[16] = NFREQ;                          /* num_chan */
+	w[17] = 1;                              /* num_bssid */
+	w[36] = 40;                             /* dwell_time_active_6g */
+	w[37] = 30;                             /* dwell_time_passive_6g */
+	memcpy(c, w, sizeof(w));
+	p = c + sizeof(w);
+	c = put_tlv(p, WMI_TAG_ARRAY_UINT32, NFREQ * 4);
+	for (uint32_t i = 0; i < NFREQ; i++) {
+		c = put32(c, g_freqs[i]);
+	}
+	p = put_tlv(c, WMI_TAG_ARRAY_FIXED_STRUCT, 0);         /* ssids: none (passive) */
+	c = put_tlv(p, WMI_TAG_ARRAY_FIXED_STRUCT, 8);         /* bssid: broadcast */
+	memset(c, 0xff, 6);
+	p = put_tlv(c + 8, WMI_TAG_ARRAY_BYTE, 0);             /* extra IEs: none */
+	return negroni_wlan_wmi_send(WMI_START_SCAN_CMDID, m, (uint32_t)(p - m));
+}
+
+/* 0326: another passive scan on vdev 0 (API request); the end comes as negroni_wlan_sta_scan_done */
+int
+negroni_wlan_wmi_scan_start(void)
+{
+	S.started = S.completed = S.failed = false;
+	return wmi_start_scan();
+}
+
+int
+negroni_wlan_scan_level(void)
+{
+	int error;
+
+	memset(&S, 0, sizeof(S));
+	negroni_wlan_wmi_scan_cb = scan_cb;
+
+	negroni_wlan_step(33, "WMI channel list");
+	error = wmi_chan_list();
+	if (error) {
+		return error;
+	}
+	negroni_wlan_step(34, "WMI VDEV_CREATE STA");
+	error = wmi_vdev_create();
+	if (error) {
+		return error;
+	}
+	negroni_wlan_step(35, "WMI passive scan");
+	error = wmi_start_scan();
+	if (error) {
+		return error;
+	}
+	error = negroni_wlan_wmi_wait(&S.started, MAX(negroni_wlan_timeout(), 5000u), "SCAN STARTED");
+	if (!error && S.failed) {
+		error = negroni_wlan_failed(EIO, "SCAN START_FAILED (reason %u)", S.reason);
+	}
+	if (error) {
+		return error;
+	}
+	error = negroni_wlan_wmi_wait(&S.completed, 30000, "SCAN COMPLETED");
+	if (error) {
+		return error;
+	}
+	printf("NEGRONI WLAN: SCAN done (reason %u): %u BSS seen, %u beacons/probe responses, %u other frames, %u "
+	    "refused, %u scan events, %u over the table\n", S.reason, S.nbss, S.beacons, S.other_frames, S.bad, S.events,
+	    S.dropped);
+	for (uint32_t i = 0; i < S.nbss; i++) {
+		printf("NEGRONI WLAN: SCAN result %u: BSSID %02x:%02x:%02x:xx:xx:xx, best RSSI %d dBm, %u MHz, %u frames\n", i + 1,
+		    S.bss[i].bssid[0], S.bss[i].bssid[1], S.bss[i].bssid[2], S.bss[i].rssi, S.bss[i].freq, S.bss[i].frames);
+	}
+	if (S.nbss == 0) {
+		printf("NEGRONI WLAN: no beacon reached the host; next suspect: the HTT rx rings (0324+) [I]\n");
+	}
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_wlan_wmi.h b/bsd/dev/negroni_wlan_wmi.h
new file mode 100644
index 0000000..e8dbb95
--- /dev/null
+++ b/bsd/dev/negroni_wlan_wmi.h
@@ -0,0 +1,108 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: HTC and WMI (patch 0322) and the passive scan (patch 0323).
+ *
+ * Wire formats from Linux ath11k (BSD-3-Clause-Clear) htc.h / htc.c and wmi.h / wmi.c (values and layouts
+ * only; the code in negroni_wlan_wmi.c is our own). Message ids and TLV tags were computed from the ath11k
+ * enums (WMI_TLV_CMD(grp) = grp << 12 | 1, enum wmi_tlv_tag) and are listed with their names.
+ */
+#ifndef _NEGRONI_WLAN_WMI_H_
+#define _NEGRONI_WLAN_WMI_H_
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#define HTC_EP_COUNT            9u      /* ATH11K_HTC_EP_COUNT */
+#define HTC_CONN_DISABLE_CREDIT 0x8u    /* ATH11K_HTC_CONN_FLAGS_DISABLE_CREDIT_FLOW_CTRL */
+#define HTC_RECORD_CREDITS      1u      /* ATH11K_HTC_RECORD_CREDITS */
+
+/* WMI command ids (wmi.h:222-610) */
+#define WMI_INIT_CMDID                  0x00001u
+#define WMI_START_SCAN_CMDID            0x03001u
+#define WMI_STOP_SCAN_CMDID             0x03002u
+#define WMI_SCAN_CHAN_LIST_CMDID        0x03003u
+#define WMI_PDEV_SET_HW_MODE_CMDID      0x0401eu
+#define WMI_VDEV_CREATE_CMDID           0x05001u
+#define WMI_VDEV_DELETE_CMDID           0x05002u
+/* WMI event ids (wmi.h:630-827) */
+#define WMI_SERVICE_READY_EVENTID       0x00001u
+#define WMI_READY_EVENTID               0x00002u
+#define WMI_SERVICE_AVAILABLE_EVENTID   0x00003u
+#define WMI_SCAN_EVENTID                0x03001u
+#define WMI_CHAN_INFO_EVENTID           0x04002u
+#define WMI_SERVICE_READY_EXT_EVENTID   0x04009u
+#define WMI_PDEV_SET_HW_MODE_RESP_EVENTID 0x04010u
+#define WMI_SERVICE_READY_EXT2_EVENTID  0x04022u
+#define WMI_MGMT_RX_EVENTID             0x07001u
+#define WMI_DEBUG_MESG_EVENTID          0x1d003u
+#define WMI_DIAG_EVENTID                0x1d011u
+#define WMI_REG_CHAN_LIST_CC_EVENTID    0x3a001u
+#define WMI_REG_CHAN_LIST_CC_EXT_EVENTID 0x3a003u
+/* TLV tags (enum wmi_tlv_tag) */
+#define WMI_TAG_ARRAY_UINT32            0x10u
+#define WMI_TAG_ARRAY_BYTE              0x11u
+#define WMI_TAG_ARRAY_STRUCT            0x12u
+#define WMI_TAG_ARRAY_FIXED_STRUCT      0x13u
+#define WMI_TAG_SERVICE_READY_EVENT     0x20u
+#define WMI_TAG_READY_EVENT             0x23u
+#define WMI_TAG_SCAN_EVENT              0x24u
+#define WMI_TAG_MGMT_RX_HDR             0x2cu
+#define WMI_TAG_INIT_CMD                0x4au
+#define WMI_TAG_RESOURCE_CONFIG         0x4bu
+#define WMI_TAG_START_SCAN_CMD          0x4du
+#define WMI_TAG_SCAN_CHAN_LIST_CMD      0x4fu
+#define WMI_TAG_CHANNEL                 0x50u
+#define WMI_TAG_VDEV_CREATE_CMD         0x56u
+#define WMI_TAG_VDEV_TXRX_STREAMS       0x19bu
+#define WMI_TAG_SERVICE_READY_EXT_EVENT 0x1acu
+#define WMI_TAG_PDEV_SET_HW_MODE_CMD    0x203u
+#define WMI_TAG_MAC_PHY_CAPABILITIES    0x210u
+#define WMI_TAG_SOC_MAC_PHY_HW_MODE_CAPS 0x212u
+#define WMI_TAG_SERVICE_AVAILABLE_EVENT 0x22fu
+#define WMI_TAG_REG_CHAN_LIST_CC_EVENT  0x261u
+#define WMI_TAG_REG_CHAN_LIST_CC_EXT_EVENT 0x3aau
+
+/* services (wmi.h:2041-2145) */
+#define WMI_SERVICE_EXT2_MSG            220u
+#define WMI_SERVICE_REG_CC_EXT_EVENT    281u
+#define WMI_MAX_SERVICE                 128u
+#define WMI_MAX_EXT2_SERVICE            384u
+
+/* ---- pure parsers (no kernel state; host-tested by patches/xnu/tests/wlan-wmi-test.c) ---- */
+struct htc_frame {
+	uint32_t eid, flags, seq;
+	const uint8_t *payload;         /* without the trailer */
+	uint32_t payload_len;
+	const uint8_t *trailer;
+	uint32_t trailer_len;
+};
+/* the HTC header and trailer bounds of one CE buffer; 0 or EBADMSG */
+int negroni_htc_parse(const uint8_t *b, uint32_t len, struct htc_frame *f);
+/* the credit records of a trailer, added per endpoint into credits[HTC_EP_COUNT]; 0 or EBADMSG */
+int negroni_htc_trailer_credits(const uint8_t *t, uint32_t len, uint32_t credits[HTC_EP_COUNT]);
+
+/* WMI TLV walk: { u32 header (len 15:0, tag 31:16); value[len] }, every length checked */
+struct wmi_tlv_it {
+	const uint8_t *p, *end;
+};
+/* 1 and the next TLV, 0 at the clean end, -1 on a TLV that runs past the end */
+int negroni_wmi_tlv_next(struct wmi_tlv_it *it, uint32_t *tag, const uint8_t **v, uint32_t *len);
+
+/* one BSS from a beacon / probe response (0323) */
+struct wlan_bss {
+	uint8_t bssid[6];
+	char ssid[33];                  /* printable copy; non-printable bytes as '?' */
+	uint32_t ssid_len;
+	uint16_t beacon_int, capab;
+	uint8_t channel;                /* DS parameter set, 0 if absent */
+	bool rsn, wpa, hidden;
+};
+/* parse an 802.11 beacon or probe response frame; 0, ENOENT (another frame type) or EBADMSG */
+int negroni_wlan_beacon_parse(const uint8_t *f, uint32_t len, struct wlan_bss *out);
+
+/* ---- driver (negroni_wlan_wmi.c) ---- */
+int negroni_wlan_wmi_level(void);       /* level 9: steps 29-32 (0322) */
+int negroni_wlan_scan_level(void);      /* level 10: steps 33-35 (0323) */
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
+#endif /* _NEGRONI_WLAN_WMI_H_ */
diff --git a/bsd/dev/negroni_wlan_wpa.c b/bsd/dev/negroni_wlan_wpa.c
new file mode 100644
index 0000000..39971f8
--- /dev/null
+++ b/bsd/dev/negroni_wlan_wpa.c
@@ -0,0 +1,398 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi (patch 0329): WPA2-PSK (AKM 00-0f-ac:2, CCMP pairwise and group) in the kernel.
+ *
+ * The arithmetic (PMK, PTK, MIC, key unwrap, message 2/4 and group replies) is HakiOS lx_wpa.c (MIT, ported as
+ * negroni_wlan_wpa_crypto.c, host-tested). This file runs the handshake on the driver thread:
+ *   start (after VDEV_UP): PMK from the passphrase (PBKDF2, 4096 rounds) or the 64-hex PMK, a fresh nonce
+ *     (read_random), the RSN element of our ASSOC REQ; the passphrase is wiped at once
+ *   EAPOL frames from the data path (0328) are queued in the poller and handled in the top-level pass:
+ *     message 1 -> message 2; message 3 -> message 4, then (after message 4 left the TX ring) WMI_VDEV_INSTALL_KEY
+ *     pairwise (index 0) and group (its index, RSC from message 3), each confirmed by INSTALL_KEY_COMPLETE, then
+ *     negroni_wlan_join_handshake_done -> PEER AUTHORIZE -> CONNECTED; a later group message -> reply + new group key
+ *   10 s without a complete handshake, a bad MIC (wrong passphrase) or a refused key -> the join goes down
+ *     (802.11 reason 15, 4-way handshake time-out).
+ * No key or passphrase byte is ever printed. Management frame protection (MFP) is not offered (RSN capabilities 0):
+ * a network that requires it refuses the association. UNTESTED ON HARDWARE.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/random.h>
+#include "negroni_wlan.h"
+#include "negroni_wlan_mhi.h"
+#include "negroni_wlan_wmi.h"
+#include "negroni_wlan_sta.h"
+#include "negroni_wlan_wpa_crypto.h"
+
+#define WMI_VDEV_INSTALL_KEY_CMDID      0x5009u
+#define TAG_VDEV_INSTALL_KEY_CMD        0x60u
+#define TAG_VDEV_INSTALL_KEY_COMPLETE_EVENT 0x2au
+#define TAG_ARRAY_BYTE                  0x11u
+#define WMI_KEY_PAIRWISE                0u
+#define WMI_KEY_GROUP                   1u
+#define WMI_CIPHER_AES_CCM              4u
+#define HANDSHAKE_MS                    10000u
+#define REASON_4WAY_TIMEOUT             15u
+#define EAPOL_MAX                       640u
+#define EAPOLQ_N                        4u
+
+static struct lx_wpa g_wpa;
+static bool g_active, g_keys_on;
+static uint64_t g_deadline;
+static uint8_t g_rsn[2 + 20];
+static uint8_t g_q[EAPOLQ_N][EAPOL_MAX];
+static uint16_t g_qlen[EAPOLQ_N];
+static volatile uint32_t g_qhead, g_qtail;
+static volatile bool g_key_done;
+static uint32_t g_key_status, g_key_idx_seen, g_key_flags_seen, g_expect_idx, g_expect_flags;
+/* review W1: the group key now installed (never install the same one twice) */
+static uint8_t g_gtk_on[32];
+static uint32_t g_gtk_on_len, g_gtk_on_idx;
+static uint8_t g_ap_rsn[2 + 255];
+
+/* our RSN element: version 1, group CCMP, pairwise CCMP, AKM PSK, capabilities 0 */
+static const uint8_t RSN_IE[22] = {
+	48, 20, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 4, 1, 0, 0x00, 0x0f, 0xac, 2, 0, 0,
+};
+
+uint32_t
+negroni_wlan_wpa_caps(void)
+{
+	return (negroni_wlan_dp_caps() & NWLAN_CAP_DATA) ? NWLAN_CAP_WPA2_PSK : 0;
+}
+
+/* the AP's RSN group cipher must be CCMP (we install a CCMP group key only) */
+static bool
+ap_group_ccmp(void)
+{
+	const struct nwlan_bss *b = negroni_wlan_join_bss();
+	if (!b) {
+		return false;
+	}
+	for (uint32_t o = 0; o + 2 <= b->ie_len;) {
+		uint32_t el = b->ie[o + 1];
+		if (o + 2 + el > b->ie_len) {
+			break;
+		}
+		const uint8_t *d = b->ie + o + 2;
+		if (b->ie[o] == 48) {
+			return el < 6 || (d[2] == 0x00 && d[3] == 0x0f && d[4] == 0xac && d[5] == 4);
+		}
+		o += 2 + el;
+	}
+	return false;
+}
+
+/* the RSN element body for the ASSOC REQ (without id/length); 0 when we cannot join this network */
+uint32_t
+negroni_wlan_wpa_rsn_ie(uint8_t *out, uint32_t cap)
+{
+	if (cap < sizeof(RSN_IE) - 2) {
+		return 0;
+	}
+	if (!ap_group_ccmp()) {
+		printf("NEGRONI WLAN: WPA2: the AP's group cipher is not CCMP (TKIP?); not supported\n");
+		return 0;
+	}
+	memcpy(out, RSN_IE + 2, sizeof(RSN_IE) - 2);
+	return sizeof(RSN_IE) - 2;
+}
+
+static int
+hexval(char c)
+{
+	return (c >= '0' && c <= '9') ? c - '0' : (c >= 'a' && c <= 'f') ? c - 'a' + 10 : (c >= 'A' && c <= 'F') ? c - 'A' + 10 : -1;
+}
+
+/* the PMK from a passphrase (printable ASCII 8..63) or 64 hex digits; false on a bad value */
+static bool
+make_pmk(const uint8_t *ssid, uint32_t ssid_len, const char *psk, uint32_t psk_len, uint8_t pmk[32])
+{
+	if (psk_len == 64) {
+		for (uint32_t i = 0; i < 32; i++) {
+			int hi = hexval(psk[2 * i]), lo = hexval(psk[2 * i + 1]);
+			if (hi < 0 || lo < 0) {
+				return false;
+			}
+			pmk[i] = (uint8_t)(hi << 4 | lo);
+		}
+		return true;
+	}
+	if (psk_len < 8 || psk_len > 63) {
+		return false;
+	}
+	for (uint32_t i = 0; i < psk_len; i++) {
+		if (psk[i] < 0x20 || psk[i] > 0x7e) {
+			return false;
+		}
+	}
+	lx_wpa_pmk((const unsigned char *)psk, psk_len, ssid, ssid_len, pmk);
+	return true;
+}
+
+void
+negroni_wlan_wpa_start(const uint8_t bssid[6], const uint8_t *ssid, uint32_t ssid_len, const char *psk,
+    uint32_t psk_len, const uint8_t *rsn_ie, uint32_t rsn_len)
+{
+	(void)rsn_ie;
+	(void)rsn_len;
+	negroni_wlan_wpa_reset();
+	uint64_t t0 = negroni_wlan_ms();
+	if (!psk || !make_pmk(ssid, ssid_len, psk, psk_len, g_wpa.pmk)) {
+		printf("NEGRONI WLAN: WPA2: the passphrase is not 8..63 printable characters or 64 hex digits\n");
+		negroni_wlan_join_handshake_done(EINVAL, REASON_4WAY_TIMEOUT);
+		return;
+	}
+	memcpy(g_wpa.own, negroni_wlan_wmi_mac(), 6);
+	memcpy(g_wpa.peer, bssid, 6);
+	read_random(g_wpa.own_nonce, sizeof(g_wpa.own_nonce));
+	memcpy(g_rsn, RSN_IE, sizeof(RSN_IE));
+	g_wpa.rsn = g_rsn;
+	g_wpa.rsn_length = sizeof(RSN_IE);
+	/* review: message 3's RSN element must be the beacon's (downgrade check) */
+	const struct nwlan_bss *b = negroni_wlan_join_bss();
+	for (uint32_t o = 0; b && o + 2 <= b->ie_len;) {
+		uint32_t el = b->ie[o + 1];
+		if (o + 2 + el > b->ie_len) {
+			break;
+		}
+		if (b->ie[o] == 48) {
+			memcpy(g_ap_rsn, b->ie + o, 2 + el);
+			g_wpa.ap_rsn = g_ap_rsn;
+			g_wpa.ap_rsn_length = 2 + el;
+			break;
+		}
+		o += 2 + el;
+	}
+	g_active = true;
+	g_deadline = negroni_wlan_ms() + HANDSHAKE_MS;
+	printf("NEGRONI WLAN: WPA2: PMK ready in %llu ms; waiting for message 1\n", negroni_wlan_ms() - t0);
+}
+
+void
+negroni_wlan_wpa_reset(void)
+{
+	negroni_wlan_wipe(&g_wpa, sizeof(g_wpa));
+	negroni_wlan_wipe(g_q, sizeof(g_q));
+	negroni_wlan_wipe(g_gtk_on, sizeof(g_gtk_on));
+	g_gtk_on_len = g_gtk_on_idx = 0;
+	g_qhead = g_qtail = 0;
+	g_active = g_keys_on = false;
+}
+
+/* from the data path's poller: queue only (the handshake runs at the top level) */
+bool
+negroni_wlan_wpa_rx_eapol(const uint8_t *body, uint32_t len)
+{
+	if (!g_active && !g_keys_on) {
+		return false;
+	}
+	uint32_t next = (g_qhead + 1) % EAPOLQ_N;
+	if (len <= EAPOL_MAX && next != g_qtail) {
+		memcpy(g_q[g_qhead], body, len);
+		g_qlen[g_qhead] = (uint16_t)len;
+		g_qhead = next;
+	}
+	return true;    /* EAPOL never goes to the client */
+}
+
+void
+negroni_wlan_wpa_key_event(const uint8_t *p, uint32_t len)
+{
+	struct wmi_tlv_it it = { p, p + len };
+	const uint8_t *v;
+	uint32_t tag, l;
+
+	while (negroni_wmi_tlv_next(&it, &tag, &v, &l) == 1) {
+		if (tag == TAG_VDEV_INSTALL_KEY_COMPLETE_EVENT && l >= 24) {
+			uint32_t vdev;
+			memcpy(&vdev, v, 4);
+			memcpy(&g_key_idx_seen, v + 12, 4);
+			memcpy(&g_key_flags_seen, v + 16, 4);
+			memcpy(&g_key_status, v + 20, 4);
+			/* review: only the completion of the key we installed (vdev 0, our index and flags, the AP's MAC) */
+			if (vdev == 0 && g_key_idx_seen == g_expect_idx && g_key_flags_seen == g_expect_flags &&
+			    memcmp(v + 4, g_wpa.peer, 6) == 0) {
+				g_key_done = true;
+			}
+			return;
+		}
+	}
+}
+
+/* WMI_VDEV_INSTALL_KEY (ath11k_wmi_vdev_install_key) and wait for INSTALL_KEY_COMPLETE */
+static int
+install_key(uint32_t idx, uint32_t flags, const uint8_t *key, uint32_t key_len, const uint8_t rsc[8])
+{
+	uint8_t m[4 + 100 + 4 + 32];
+	uint32_t w[25];
+
+	if (key_len > 32) {
+		return EINVAL;
+	}
+	memset(w, 0, sizeof(w));
+	w[0] = 0;                                       /* vdev */
+	memcpy(&w[1], g_wpa.peer, 6);                   /* wmi_mac_addr (the AP for both keys in STA mode) */
+	w[3] = idx;
+	w[4] = flags;
+	w[5] = WMI_CIPHER_AES_CCM;
+	if (rsc) {
+		memcpy(&w[6], rsc, 8);                  /* key_rsc_counter */
+	}
+	/* w[8..9] global rsc, w[10..11] tsc, w[12..19] wpi counters */
+	w[20] = key_len;                                /* key_len, txmic 0, rxmic 0, group id valid 0, id 0 */
+	uint32_t h = (TAG_VDEV_INSTALL_KEY_CMD << 16) | sizeof(w);
+	memcpy(m, &h, 4);
+	memcpy(m + 4, w, sizeof(w));
+	uint32_t ka = (key_len + 3) & ~3u;
+	h = (TAG_ARRAY_BYTE << 16) | ka;
+	memcpy(m + 4 + sizeof(w), &h, 4);
+	memset(m + 8 + sizeof(w), 0, ka);
+	memcpy(m + 8 + sizeof(w), key, key_len);
+	g_key_done = false;
+	g_expect_idx = idx;
+	g_expect_flags = flags;
+	int error = negroni_wlan_wmi_send(WMI_VDEV_INSTALL_KEY_CMDID, m, 8 + sizeof(w) + ka);
+	negroni_wlan_wipe(m, sizeof(m));
+	if (!error) {
+		error = negroni_wlan_wmi_wait(&g_key_done, 1000, "INSTALL_KEY_COMPLETE");
+	}
+	if (!error && g_key_status != 0) {
+		error = negroni_wlan_failed(EIO, "INSTALL_KEY %s index %u refused, status %u",
+		           flags == WMI_KEY_GROUP ? "group" : "pairwise", idx, g_key_status);
+	}
+	return error;
+}
+
+/* review W1: install a group key unless the same key with the same index is already installed */
+static int
+install_group(void)
+{
+	if (g_gtk_on_len == g_wpa.group_length && g_gtk_on_idx == g_wpa.group_index &&
+	    memcmp(g_gtk_on, g_wpa.group, g_gtk_on_len) == 0) {
+		printf("NEGRONI WLAN: WPA2: group key %u already installed; not again\n", g_wpa.group_index);
+		return 0;
+	}
+	int error = install_key(g_wpa.group_index, WMI_KEY_GROUP, g_wpa.group, g_wpa.group_length, g_wpa.group_counter);
+	if (!error) {
+		memcpy(g_gtk_on, g_wpa.group, g_wpa.group_length);
+		g_gtk_on_len = g_wpa.group_length;
+		g_gtk_on_idx = g_wpa.group_index;
+	}
+	return error;
+}
+
+/* message 4 must leave unencrypted before the pairwise key exists (mac80211 order) */
+static void
+wait_tx_idle(void)
+{
+	uint64_t deadline = negroni_wlan_ms() + 500;
+	while (!negroni_wlan_dp_tx_idle() && negroni_wlan_ms() < deadline) {
+		if (negroni_wlan_service()) {
+			return;
+		}
+		negroni_wlan_nap(2);
+	}
+}
+
+static void
+fail(int error, const char *why)
+{
+	printf("NEGRONI WLAN: WPA2 handshake failed: %s\n", why);
+	g_active = false;
+	negroni_wlan_wpa_reset();
+	negroni_wlan_join_handshake_done(error, REASON_4WAY_TIMEOUT);
+}
+
+/* top level (keep-alive pass): the queued EAPOL frames and the time-out */
+void
+negroni_wlan_wpa_service(void)
+{
+	static uint8_t reply[LX_WPA_REPLY_MOST], msg[EAPOL_MAX];
+
+	while (g_qtail != g_qhead) {
+		uint32_t len = g_qlen[g_qtail];
+		memcpy(msg, g_q[g_qtail], len);
+		negroni_wlan_wipe(g_q[g_qtail], EAPOL_MAX);
+		g_qtail = (g_qtail + 1) % EAPOLQ_N;
+
+		unsigned rl = 0;
+		const char *why = "";
+		/* review W2: a message 1 (pairwise, ACK, no MIC) outside our handshake is ignored (no PTK rekey support) */
+		if (len >= 7) {
+			uint32_t info = (uint32_t)msg[5] << 8 | msg[6];
+			if ((info & 0x0188u) == 0x0088u && !g_active) {
+				negroni_wlan_wipe(msg, sizeof(msg));
+				continue;
+			}
+		}
+		int r = lx_wpa_message(&g_wpa, msg, len, reply, &rl, &why);
+		negroni_wlan_wipe(msg, sizeof(msg));
+		switch (r) {
+		case LX_WPA_ANSWER:
+			printf("NEGRONI WLAN: WPA2: message 1 -> message 2 (%u bytes)\n", rl);
+			(void)negroni_wlan_dp_tx_eapol(reply, rl);
+			break;
+		case LX_WPA_KEYS: {
+			if (g_keys_on) {
+				/* review W1 (KRACK): a retransmitted message 3: message 4 again, no re-install, no new done */
+				printf("NEGRONI WLAN: WPA2: message 3 again -> message 4 only (keys stay installed)\n");
+				(void)negroni_wlan_dp_tx_eapol(reply, rl);
+				break;
+			}
+			printf("NEGRONI WLAN: WPA2: message 3 (MIC good) -> message 4; installing the keys\n");
+			(void)negroni_wlan_dp_tx_eapol(reply, rl);
+			wait_tx_idle();
+			int error = install_key(0, WMI_KEY_PAIRWISE, g_wpa.pairwise, 16, NULL);
+			if (!error) {
+				error = install_group();
+			}
+			if (!error) {
+				(void)negroni_wlan_dp_secure();        /* 0328 review D5/D6: PN check, decrypted frames only */
+			}
+			if (error) {
+				fail(error, "a key was not installed");
+				return;
+			}
+			g_active = false;
+			g_keys_on = true;               /* group rekeys still come */
+			printf("NEGRONI WLAN: WPA2: pairwise + group key %u installed (CCMP)\n", g_wpa.group_index);
+			negroni_wlan_join_handshake_done(0, 0);
+			break;
+		}
+		case LX_WPA_GROUP: {
+			if (!g_keys_on) {
+				break;                  /* a group message before the 4-way handshake ended: ignored */
+			}
+			(void)negroni_wlan_dp_tx_eapol(reply, rl);
+			wait_tx_idle();
+			int error = install_group();
+			if (error) {
+				/* review W4: no group key = no broadcast/multicast frames: the link goes down, with a line */
+				printf("NEGRONI WLAN: WPA2: group rekey: the new group key was not installed (error %d)\n", error);
+				g_keys_on = false;
+				negroni_wlan_join_handshake_done(error, REASON_4WAY_TIMEOUT);
+				return;
+			}
+			printf("NEGRONI WLAN: WPA2: group key %u current\n", g_wpa.group_index);
+			break;
+		}
+		case LX_WPA_BAD:
+			printf("NEGRONI WLAN: WPA2: key message refused: %s\n", why);
+			if (g_active && why == LX_WPA_WHY_MIC) {           /* review: by code, not by text */
+				fail(EPERM, "bad MIC (wrong passphrase?)");
+				return;
+			}
+			break;
+		default:
+			break;
+		}
+		negroni_wlan_wipe(reply, sizeof(reply));
+	}
+	if (g_active && negroni_wlan_ms() > g_deadline) {
+		fail(ETIMEDOUT, "no complete 4-way handshake in 10 s");
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
