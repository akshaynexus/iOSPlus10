diff --git a/bsd/dev/negroni_batt_store.c b/bsd/dev/negroni_batt_store.c
new file mode 100644
index 0000000..bcb20c7
--- /dev/null
+++ b/bsd/dev/negroni_batt_store.c
@@ -0,0 +1,199 @@
+/*
+ * NEGRONI (SM8450) patch 0278: the battery percentage kept across boots, in the same way patch 0203
+ * keeps the RTC offset (bsd/dev/negroni_rtc.c: a text file in /private/var/db, read with vnode_open +
+ * vn_rdwr, written by a thread call with O_CREAT | O_TRUNC + VNOP_FSYNC, a failed write tried again
+ * every 30 s, 60 times, while the root is read only).
+ *
+ * File /private/var/db/negroni_batt (text):
+ *   negroni-batt 1
+ *   soc 1234            hundredths of a percent, the value the battery service showed
+ *   wall 1793001749     calendar seconds of the write (for the log only)
+ * The battery service (iokit/Kernel/arm/NegroniBattery.cpp) reads it at its first OCV estimate and uses
+ * it only when it is within 15 % of that estimate (else the estimate wins); it saves on each 1 % change
+ * and at most once a minute.
+ * Log prefix "NEGRONI BATTERY: store:".
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/mount.h>
+#include <sys/vnode.h>
+#include <sys/vnode_if.h>
+#include <sys/kauth.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+
+int negroni_batt_store_load(int32_t *soc_centi, uint64_t *wall_s);
+void negroni_batt_store_save(int32_t soc_centi);
+
+#define NB_FILE         "/private/var/db/negroni_batt"
+#define NB_RETRY_S      30
+#define NB_RETRIES      60
+
+static LCK_GRP_DECLARE(nbs_grp, "negroni_batt_store");
+static LCK_MTX_DECLARE(nbs_lock, &nbs_grp);
+static thread_call_t nbs_call;
+static int32_t nbs_want = -1;           /* the value to write; -1 = nothing */
+static int32_t nbs_written = -1;        /* the value in the file */
+static unsigned nbs_retries;
+static bool nbs_logged_fail;
+
+static bool
+root_mounted(void)
+{
+	vnode_t r = vfs_rootvnode();
+	if (r == NULLVP) {
+		return false;
+	}
+	vnode_put(r);
+	return true;
+}
+
+/* 0: *soc_centi (0..10000) and *wall_s set. EAGAIN: no root yet. ENOENT / EINVAL / an I/O error. */
+int
+negroni_batt_store_load(int32_t *soc_centi, uint64_t *wall_s)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	char buf[128];
+	int resid = 0, error;
+	bool magic = false, haveSoc = false;
+	int64_t soc = -1;
+	uint64_t wall = 0;
+
+	if (!root_mounted()) {
+		return EAGAIN;
+	}
+	bzero(buf, sizeof(buf));
+	error = vnode_open(NB_FILE, FREAD, 0, 0, &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	error = vn_rdwr(UIO_READ, vp, buf, sizeof(buf) - 1, 0, UIO_SYSSPACE, IO_NODELOCKED,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	(void)vnode_close(vp, FREAD, ctx);
+	if (error != 0) {
+		return error;
+	}
+	/* "key value" lines */
+	for (char *line = buf; line && *line;) {
+		char *nl = strchr(line, '\n');
+		if (nl) {
+			*nl = 0;
+		}
+		char *sp = strchr(line, ' ');
+		if (sp) {
+			*sp = 0;
+			uint64_t v = 0;
+			bool num = sp[1] != 0;
+			for (char *c = sp + 1; *c; c++) {
+				if (*c < '0' || *c > '9' || v > 100000000000ull) {
+					num = false;
+					break;
+				}
+				v = v * 10 + (uint64_t)(*c - '0');
+			}
+			if (strcmp(line, "negroni-batt") == 0 && num && v == 1) {
+				magic = true;
+			} else if (strcmp(line, "soc") == 0 && num) {
+				soc = (int64_t)v;
+				haveSoc = true;
+			} else if (strcmp(line, "wall") == 0 && num) {
+				wall = v;
+			}
+		}
+		line = nl ? nl + 1 : NULL;
+	}
+	if (!magic || !haveSoc || soc < 0 || soc > 10000) {
+		return EINVAL;
+	}
+	*soc_centi = (int32_t)soc;
+	*wall_s = wall;
+	lck_mtx_lock(&nbs_lock);
+	nbs_written = (int32_t)soc;
+	lck_mtx_unlock(&nbs_lock);
+	return 0;
+}
+
+static void
+nbs_persist(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	char text[96];
+	int resid = 0, error;
+	clock_sec_t now_s;
+	clock_usec_t now_us;
+
+	lck_mtx_lock(&nbs_lock);
+	int32_t soc = nbs_want;
+	bool same = soc == nbs_written;
+	lck_mtx_unlock(&nbs_lock);
+	if (soc < 0 || same) {
+		return;
+	}
+	if (!root_mounted()) {
+		error = EAGAIN;
+	} else {
+		clock_get_calendar_microtime(&now_s, &now_us);
+		snprintf(text, sizeof(text), "negroni-batt 1\nsoc %d\nwall %lu\n", soc, (unsigned long)now_s);
+		error = vnode_open(NB_FILE, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, S_IRUSR | S_IWUSR,
+		    VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+		if (error == 0) {
+			error = vn_rdwr(UIO_WRITE, vp, text, (int)strlen(text), 0, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (error == 0 && resid != 0) {
+				error = EIO;
+			}
+			if (error == 0) {
+				error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+			}
+			(void)vnode_close(vp, FWRITE, ctx);
+		}
+	}
+	lck_mtx_lock(&nbs_lock);
+	if (error == 0) {
+		if (nbs_written < 0) {
+			printf("NEGRONI BATTERY: store: soc %d.%02d%% saved to %s (then on each 1 %% change, at most once a minute)\n",
+			    soc / 100, soc % 100, NB_FILE);
+		}
+		nbs_written = soc;
+		nbs_retries = 0;
+	} else if (nbs_retries++ < NB_RETRIES) {
+		if (!nbs_logged_fail) {
+			nbs_logged_fail = true;
+			printf("NEGRONI BATTERY: store: %s not written (error %d): again every %d s\n", NB_FILE, error, NB_RETRY_S);
+		}
+		uint64_t deadline;
+		clock_interval_to_deadline(NB_RETRY_S, NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(nbs_call, deadline);
+	}
+	lck_mtx_unlock(&nbs_lock);
+}
+
+/* Queue a write of soc_centi (a thread call; the caller does not wait). */
+void
+negroni_batt_store_save(int32_t soc_centi)
+{
+	if (soc_centi < 0 || soc_centi > 10000) {
+		return;
+	}
+	lck_mtx_lock(&nbs_lock);
+	if (nbs_call == NULL) {
+		nbs_call = thread_call_allocate_with_options(nbs_persist, NULL, THREAD_CALL_PRIORITY_LOW, 0);
+	}
+	nbs_want = soc_centi;
+	if (nbs_retries >= NB_RETRIES) {
+		nbs_retries = 0;                /* a new value: try again */
+	}
+	thread_call_t c = nbs_call;
+	lck_mtx_unlock(&nbs_lock);
+	if (c != NULL) {
+		thread_call_enter(c);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_bootlog_core.h b/bsd/dev/negroni_bootlog_core.h
new file mode 100644
index 0000000..ca5209b
--- /dev/null
+++ b/bsd/dev/negroni_bootlog_core.h
@@ -0,0 +1,101 @@
+/*
+ * NEGRONI boot log (patch 0367): the pure checks, shared by the kernel
+ * (bsd/dev/negroni_ufs.c, bsd/dev/negroni_usb.c) and the host unit test
+ * (tools/bootlog-core-test, scripts/kernel/test-bootlog-core.sh takes this
+ * file from the patch). No includes: the includer gives uint8_t, uint32_t,
+ * uint64_t, bool and size_t.
+ */
+#ifndef NEGRONI_BOOTLOG_CORE_H
+#define NEGRONI_BOOTLOG_CORE_H
+
+#define NBL_CORE_BLOCK          4096u
+#define NBL_CORE_AREA_BLOCKS    9216u           /* 36 MiB */
+#define NBL_CORE_FROM_END       28673u          /* area start = partition end - 28673 (op10tool, root-simg.sh) */
+#define NBL_CORE_MIN_REL        16u             /* the area start must leave the partition start alone */
+
+/* [lba, lba + count) inside the partition [first, first + nblocks), count 1..max_count, 32-bit LBA. */
+static inline bool
+nbl_core_in_partition(uint64_t first, uint64_t nblocks, uint64_t lba, uint32_t count, uint32_t max_count)
+{
+	return nblocks != 0 && count != 0 && count <= max_count && lba >= first && lba - first < nblocks &&
+	       count <= nblocks - (lba - first) && lba + count - 1 <= 0xffffffffull;
+}
+
+/* [lba, lba + count) inside the open log window [lo, hi); hi == 0 = closed. */
+static inline bool
+nbl_core_in_window(uint64_t lo, uint64_t hi, uint64_t lba, uint32_t count)
+{
+	return hi != 0 && hi > lo && count != 0 && lba >= lo && count <= hi - lo && lba <= hi - count;
+}
+
+/*
+ * HFS+ / HFSX volume end in 4096-byte device blocks from the partition
+ * start. vh = the volume header (partition byte 1024): signature at 0
+ * ("H+" 0x482b / "HX" 0x4858), block size at 40, total blocks at 44, big
+ * endian. 0 = ok, -1 = not an HFS+ header.
+ */
+static inline int
+nbl_core_hfs_end(const uint8_t *vh, uint64_t *end)
+{
+	uint32_t sig = (uint32_t)vh[0] << 8 | vh[1];
+	uint32_t bsize = (uint32_t)vh[40] << 24 | (uint32_t)vh[41] << 16 | (uint32_t)vh[42] << 8 | vh[43];
+	uint32_t nblk = (uint32_t)vh[44] << 24 | (uint32_t)vh[45] << 16 | (uint32_t)vh[46] << 8 | vh[47];
+	if ((sig != 0x482b && sig != 0x4858) || bsize < 512 || (bsize & (bsize - 1)) != 0 || nblk == 0) {
+		return -1;
+	}
+	*end = ((uint64_t)bsize * nblk + NBL_CORE_BLOCK - 1) / NBL_CORE_BLOCK;
+	return 0;
+}
+
+/*
+ * The area start (blocks from the partition start) for a partition of
+ * nblocks and an HFS+ volume of hfs_end blocks. 0 = ok, -1 = partition too
+ * small, -2 = the volume reaches the area.
+ */
+static inline int
+nbl_core_area_rel(uint64_t nblocks, uint64_t hfs_end, uint64_t *rel)
+{
+	if (nblocks < (uint64_t)NBL_CORE_FROM_END + NBL_CORE_MIN_REL) {
+		return -1;
+	}
+	*rel = nblocks - NBL_CORE_FROM_END;
+	return hfs_end > *rel ? -2 : 0;
+}
+
+/* Decimal number at *q (advanced past it); *ok = false if there is no digit or more than 9 digits. */
+static inline uint32_t
+nbl_core_parse_u32(const char **q, bool *ok)
+{
+	uint32_t v = 0;
+	const char *p = *q;
+	unsigned n = 0;
+	if (*p < '0' || *p > '9') {
+		*ok = false;
+	}
+	while (*p >= '0' && *p <= '9') {
+		if (++n > 9) {
+			*ok = false;
+			break;
+		}
+		v = v * 10 + (uint32_t)(*p++ - '0');
+	}
+	*q = p;
+	return v;
+}
+
+/* CRC-32 (IEEE 802.3, the zlib / crc32fast value). */
+static inline uint32_t
+nbl_core_crc32(const void *buf, size_t n)
+{
+	const uint8_t *b = (const uint8_t *)buf;
+	uint32_t c = 0xffffffffu;
+	while (n--) {
+		c ^= *b++;
+		for (int k = 0; k < 8; k++) {
+			c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1u)));
+		}
+	}
+	return ~c;
+}
+
+#endif /* NEGRONI_BOOTLOG_CORE_H */
diff --git a/bsd/dev/negroni_bt.c b/bsd/dev/negroni_bt.c
new file mode 100644
index 0000000..fe90d7d
--- /dev/null
+++ b/bsd/dev/negroni_bt.c
@@ -0,0 +1,953 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450): QCA6490 Bluetooth, stage A part 1 (patch 0330):
+ * power sequence + GENI high-speed UART on QUP wrapper 2 SE5 ("qupv3_se20_4uart").
+ *
+ * Hardware [V out/live.dts, iOSPlus10 docs/bluetooth-plan.md]:
+ *   UART  qcom,qup_uart@894000 "qcom,msm-geni-serial-hs", reg 0x894000 0x4000, wrapper
+ *         qcom,qupv3_2_geni_se@8c0000; clocks GCC 130 (QUPV3_WRAP2_S5), 138 (WRAP_2_M_AHB), 139 (WRAP_2_S_AHB);
+ *         pins CTS 76, RTS 77, TX 78, RX 79 (function qup20 = 1; pinctrl "active" state);
+ *         qcom,wakeup-byte 0xfd (in-band sleep WAKE_IND).
+ *   bt_qca6490: BT_EN GPIO81 (qcom,bt-reset-gpio), WLAN_EN GPIO80, SW_CTRL GPIO82, XO_CLK GPIO204;
+ *         vdd-aon/dig = pm8350_s11 (smpb11) 966 mV, rfa1 = pm8350c_s1 (smpc1) 1900 mV,
+ *         rfa2 = pm8350_s12 (smpb12) 1350 mV, asd = pmr735a_l7 (ldoe7) 2800 mV; qcom,vreg_ipa "s3e" (AOP, not voted here).
+ * Power sequence = OnePlus kernel drivers/bluetooth/btpower.c bt_configure_gpios (out/src/op-kernel):
+ *   rails on; BT_EN low, 50 ms; WLAN_EN low -> wait 100 ms (AON discharge); XO_CLK high, 100-200 us,
+ *   BT_EN high, XO_CLK low after 4-6 ms; 50 ms; SW_CTRL should read 1.
+ * UART programming = Linux qcom_geni_serial.c / qcom-geni-se.c (FIFO mode, polled, no IRQ, no DMA).
+ * The SE clock: the GCC RCG of SE5 (0x2e618) is DFS-capable; when the boot chain enabled DFS the SE picks a
+ * level with SE_GENI_CLK_SEL (Linux geni_serial_set_rate), else this file programs the RCG from the
+ * gcc-waipio.c frequency table. Oversampling 16 (QUP >= 2.5), 32 below.
+ *
+ * Boot-args (default: nothing runs, no register is touched):
+ *   negronibt=1          steps 1-8: map, pin census, rails, clocks, GENI check, UART 115200, BT_EN, RX idle bytes
+ *   negronibt=2          + the HCI stage steps 9-11: reset, version, baud (negroni_bt_hci.c, patch 0331)
+ *   negronibt=3          + steps 12-19: rampatch + NVM from the WLAN firmware area, reset, BD address
+ *   negronibt=4          + step 20 (BD address from the ADT) + the iOS H4 transport (negroni_bt_h4.c, patch 0332):
+ *                        kernel control com.apple.uart.bluetooth, /dev/uart.bluetooth, /dev/cu.bluetooth, /dev/btwake
+ *   negronibt_delay=S    seconds before step 1 (default 3)
+ *   negronibt_noflow=1   ignore CTS (no hardware flow control)
+ *   negronibt_rfropen=1  start RX with the vendor parameters (RFR open, skip frame-error/break chars)
+ *   negronibt_aon_ms=N   BT_EN wait when WLAN_EN is low (default 100; btpower.c uses 500 below TEMP_THRESHOLD 5000 = 5 C)
+ *   negronibt_off=1      BT_EN low again at the end (negronibt=4: the transport then reports a failure)
+ * Failure after step 7: BT_EN low again. Failure after step 4: the GCC vote word is restored when it changed.
+ * The four rails are never voted off (all shared; smpb12 is the UFS vccq parent).
+ * Log: "NEGRONI BT: step N NAME" before each step, then detail lines; "NEGRONI BT: stop: ..." on failure.
+ * Every wait is bounded. A failure stops the thread; it never blocks boot.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "negroni_bt.h"
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern kern_return_t thread_terminate(thread_t);
+extern void thread_deallocate(thread_t);
+extern void IOSleep(unsigned int milliseconds);
+extern int negroni_rpmh_bt_enable(const char *res, unsigned mv);
+extern int negroni_rpmh_qup_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uint32_t *data_out);
+void negroni_bt_init(void);
+
+#define BT_WIMG_IO              0x7u            /* VM_WIMG_IO, as negroni_wifi.c */
+#define BT_PAGE                 0x4000u
+
+/* GCC (Linux gcc-sm8450.c = vendor gcc-waipio.c offsets) */
+#define GCC_PHYS                0x00100000u
+#define GCC_QUP_WIN             0x2c000u        /* maps 0x2c000..0x33fff: RCG/CBCRs of wrap2 + core CBCRs */
+#define GCC_QUP_WIN_SIZE        0x8000u
+#define GCC_VOTE_WIN            0x60000u
+#define GCC_VOTE_QUP            0x62010u        /* APCS branch vote: bit 0 wrap2 core, 1 s_ahb, 2 m_ahb, 3 core_2x, 9 s5 */
+#define GCC_VOTE_BITS           (1u << 0 | 1u << 1 | 1u << 2 | 1u << 3 | 1u << 9)
+#define GCC_M_AHB_CBCR          0x2e004u
+#define GCC_S_AHB_CBCR          0x2e008u
+#define GCC_S5_CBCR             0x2e610u
+#define GCC_S5_RCGR             0x2e618u
+#define GCC_CORE_CBCR           0x33280u
+#define GCC_CORE2X_CBCR         0x3328cu
+#define CBCR_OFF                (1u << 31)
+#define CBCR_HW_CTL             (1u << 1)       /* hwcg_bit 1: the branch gates itself when idle (m_ahb, s_ahb) */
+#define QUP_CORE2X_100MHZ_KBPS  5000u           /* qcom-geni-se.h CORE_2X_100_MHZ, the qup-core icc vote */
+#define RCG_CMD_UPDATE          (1u << 0)
+#define RCG_CMD_ROOT_OFF        (1u << 31)
+#define RCG_CFG                 0x4u
+#define RCG_M                   0x8u
+#define RCG_N                   0xcu
+#define RCG_D                   0x10u
+#define RCG_DFSR                0x14u           /* bit 0 DFS enable */
+#define RCG_PERF_DFSR(l)        (0x1cu + 4u * (l))
+#define RCG_PERF_M_DFSR(l)      (0x5cu + 4u * (l))
+#define RCG_PERF_N_DFSR(l)      (0x9cu + 4u * (l))
+#define RCG_LEVELS              8u
+#define RCG_HID_MASK            0x1fu           /* hid_width 5 */
+#define RCG_MND_MASK            0xffffu         /* mnd_width 16 */
+
+/* TLMM */
+#define TLMM_PHYS               0x0f100000u
+#define TLMM_PIN(n)             ((uint32_t)(n) * 0x1000u)
+#define PIN_CTS                 76u
+#define PIN_RTS                 77u
+#define PIN_TX                  78u
+#define PIN_RX                  79u
+#define PIN_WLAN_EN             80u
+#define PIN_BT_EN               81u
+#define PIN_SW_CTRL             82u
+#define PIN_XO_CLK              204u
+#define TLMM_EGPIO_PRESENT      (1u << 11)
+#define TLMM_EGPIO_ENABLE       (1u << 12)
+#define TLMM_OE                 (1u << 9)
+#define QUP20_FUNC              1u              /* pinctrl-sm8450.c PINGROUP(76..79, qup20, ...) */
+
+/* QUP wrapper 2 and SE5 (Linux geni-se.h, qcom_geni_serial.c) */
+#define QUP2_PHYS               0x008c0000u
+#define QUP_HW_VER              0x4u
+#define SE_PHYS                 0x00894000u
+#define GENI_FORCE_DEFAULT      0x020u
+#define GENI_OUTPUT_CTRL        0x024u
+#define GENI_CGC_CTRL           0x028u
+#define GENI_STATUS             0x040u          /* bit 0 M active, bit 12 S active */
+#define GENI_SER_M_CLK_CFG      0x048u
+#define GENI_SER_S_CLK_CFG      0x04cu
+#define GENI_CLK_CTRL_RO        0x060u
+#define GENI_IF_DISABLE_RO      0x064u          /* bit 0 FIFO_IF_DISABLE */
+#define GENI_FW_REVISION_RO     0x068u          /* bits 15:8 protocol, 2 = UART */
+#define GENI_FW_S_REVISION_RO   0x06cu
+#define GENI_CLK_SEL            0x07cu
+#define UART_LOOPBACK_CFG       0x22cu
+#define GENI_BYTE_GRAN          0x254u
+#define GENI_DMA_MODE_EN        0x258u
+#define UART_TX_TRANS_CFG       0x25cu          /* bit 0 parity, bit 1 CTS mask (1 = ignore CTS) */
+#define GENI_TX_PACKING_CFG0    0x260u
+#define GENI_TX_PACKING_CFG1    0x264u
+#define UART_TX_WORD_LEN        0x268u
+#define UART_TX_STOP_BIT_LEN    0x26cu
+#define UART_TX_TRANS_LEN       0x270u
+#define UART_RX_TRANS_CFG       0x280u
+#define GENI_RX_PACKING_CFG0    0x284u
+#define GENI_RX_PACKING_CFG1    0x288u
+#define UART_RX_WORD_LEN        0x28cu
+#define UART_RX_STALE_CNT       0x294u
+#define UART_TX_PARITY_CFG      0x2a4u
+#define UART_RX_PARITY_CFG      0x2a8u
+#define UART_MANUAL_RFR         0x2acu          /* bit 31 manual, bit 1 not ready, bit 0 ready */
+#define GENI_M_CMD0             0x600u
+#define GENI_M_CMD_CTRL         0x604u          /* bit 1 abort, bit 2 cancel */
+#define GENI_M_IRQ_STATUS       0x610u
+#define GENI_M_IRQ_EN           0x614u
+#define GENI_M_IRQ_CLEAR        0x618u
+#define GENI_S_CMD0             0x630u
+#define GENI_S_CMD_CTRL         0x634u
+#define GENI_S_IRQ_STATUS       0x640u
+#define GENI_S_IRQ_EN           0x644u
+#define GENI_S_IRQ_CLEAR        0x648u
+#define GENI_TX_FIFO            0x700u
+#define GENI_RX_FIFO            0x780u
+#define GENI_TX_FIFO_STATUS     0x800u          /* bits 27:0 word count */
+#define GENI_RX_FIFO_STATUS     0x804u          /* bit 31 last, 30:28 last-word bytes, 24:0 word count */
+#define GENI_TX_WATERMARK       0x80cu
+#define GENI_RX_WATERMARK       0x810u
+#define GENI_RX_RFR_WATERMARK   0x814u
+#define GENI_IOS                0x908u          /* bit 1 CTS pin level, bit 0 RX pin level */
+#define DMA_TX_IRQ_CLR          0xc44u
+#define DMA_RX_IRQ_CLR          0xd44u
+#define SE_GSI_EVENT_EN         0xe18u
+#define SE_IRQ_EN               0xe1cu
+#define SE_HW_PARAM_0           0xe24u
+#define SE_HW_PARAM_1           0xe28u
+#define SE_DMA_GENERAL_CFG      0xe30u
+#define M_CMD_DONE              (1u << 0)
+#define M_CMD_CANCEL            (1u << 4)
+#define M_CMD_ABORT             (1u << 5)
+#define S_CMD_CANCEL            (1u << 4)
+#define S_CMD_ABORT             (1u << 5)
+#define CMD_CTRL_ABORT          (1u << 1)
+#define CMD_CTRL_CANCEL         (1u << 2)
+#define UART_START_TX           1u
+#define UART_START_READ         1u
+#define UART_PARAM_VENDOR       (1u << 5 | 1u << 6 | 1u << 7)   /* msm_geni_serial start_rx_sequencer */
+#define UART_CTS_MASK           (1u << 1)
+#define PROTO_UART              2u
+
+#define RX_RING                 4096u
+
+static struct {
+	uint32_t mode, noflow, rfropen, aon_ms, poweroff;
+	vm_offset_t gcc_qup, gcc_vote, tlmm_uart, tlmm_xo, se, qup;
+	uint32_t qup_ver, sampling, tx_depth, rx_depth, baud;
+	bool dfs, powered, voted;
+	uint32_t vote_before;
+	uint32_t levels;
+	uint64_t level_hz[RCG_LEVELS];
+	uint8_t ring[RX_RING];
+	uint32_t head, tail, dropped;
+} bt;
+
+#define SAY(...)        printf("NEGRONI BT: " __VA_ARGS__)
+#define STEP(n, name)   printf("NEGRONI BT: step %u %s\n", (unsigned)(n), name)
+
+static inline uint32_t
+rd(vm_offset_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+wr(vm_offset_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+uint64_t
+negroni_bt_us(void)
+{
+	uint64_t t, ns;
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &ns);
+	return ns / 1000ull;
+}
+
+void
+negroni_bt_sleep_ms(uint32_t ms)
+{
+	IOSleep(ms);
+}
+
+uint32_t
+negroni_bt_arg(const char *name, uint32_t def)
+{
+	char key[48];
+	uint32_t v = def;
+	snprintf(key, sizeof(key), "negronibt_%s", name);
+	if (!PE_parse_boot_argn(key, &v, sizeof(v))) {
+		v = def;
+	}
+	return v;
+}
+
+uint32_t
+negroni_bt_uart_baud(void)
+{
+	return bt.baud;
+}
+
+static vm_offset_t
+map(uint32_t pa, uint32_t size)
+{
+	uint32_t base = pa & ~(BT_PAGE - 1u);
+	uint32_t len = (pa + size - base + BT_PAGE - 1u) & ~(BT_PAGE - 1u);
+	vm_offset_t va = ml_io_map_unmappable(base, len, BT_WIMG_IO);
+	return va ? va + (pa - base) : 0;
+}
+
+/* ---- pins ---- */
+
+static vm_offset_t
+pin(uint32_t n)
+{
+	if (n >= PIN_CTS && n <= PIN_SW_CTRL + 1u) {
+		return bt.tlmm_uart + TLMM_PIN(n - PIN_CTS);
+	}
+	return bt.tlmm_xo;                      /* PIN_XO_CLK only */
+}
+
+static void
+pin_cfg(uint32_t n, uint32_t cfg)
+{
+	if (rd(pin(n)) & TLMM_EGPIO_PRESENT) {
+		cfg |= TLMM_EGPIO_ENABLE;       /* eGPIO: bit 12 gives the pin to the TLMM (pinctrl-msm.c) */
+	}
+	wr(pin(n), cfg);
+}
+
+static void
+gpio_out(uint32_t n, bool high, uint32_t pull)
+{
+	wr(pin(n) + 4u, high ? 2u : 0u);
+	pin_cfg(n, TLMM_OE | pull);             /* function 0 (gpio), 2 mA */
+}
+
+static uint32_t
+gpio_in(uint32_t n)
+{
+	return rd(pin(n) + 4u) & 1u;
+}
+
+static void
+pin_line(const char *name, uint32_t n)
+{
+	uint32_t c = rd(pin(n)), io = rd(pin(n) + 4u);
+	SAY("2 GPIO%u %s: cfg %#x (func %u, drive %u mA, pull %u, %s) in %u out %u\n", n, name, c,
+	    (c >> 2) & 0xfu, ((c >> 6) & 7u) * 2u + 2u, c & 3u, (c & TLMM_OE) ? "output" : "input", io & 1u, (io >> 1) & 1u);
+}
+
+/* ---- rails ---- */
+
+static int
+rail(const char *res, unsigned mv)
+{
+	int e = EBUSY;
+	for (unsigned i = 0; i < 40 && e == EBUSY; i++) {       /* the RPMh voter is shared: retry while busy */
+		e = negroni_rpmh_bt_enable(res, mv);
+		if (e == EBUSY) {
+			IOSleep(50);
+		}
+	}
+	SAY("3 %s %u mV: errno %d\n", res, mv, e);
+	return e;
+}
+
+/* ---- clocks ---- */
+
+static uint64_t
+parent_hz(uint32_t src)
+{
+	switch (src) {
+	case 0: return 19200000ull;     /* bi_tcxo */
+	case 1: return 600000000ull;    /* gpll0 */
+	case 6: return 300000000ull;    /* gpll0_out_even */
+	default: return 0;
+	}
+}
+
+/* clk-rcg2.c calc_rate */
+static uint64_t
+rcg_rate(uint32_t cfg, uint32_t m, uint32_t notnm)
+{
+	uint64_t r = parent_hz((cfg >> 8) & 7u);
+	uint32_t hid = cfg & RCG_HID_MASK, mode = (cfg >> 12) & 3u;
+	if (hid) {
+		r = r * 2u / (hid + 1u);
+	}
+	if (mode) {
+		uint32_t mm = m & RCG_MND_MASK, n = ((~notnm) & RCG_MND_MASK) + mm;
+		if (n) {
+			r = r * mm / n;
+		}
+	}
+	return r;
+}
+
+/*
+ * clk-branch.c clk_branch_wait: a branch in hardware clock gating mode (CBCR HW_CTL set) is not
+ * checked (the CLK_OFF bit reads 1 while the bus is idle); m_ahb and s_ahb of the wrapper have hwcg_bit 1
+ * (gcc-sm8450.c gcc_qupv3_wrap_2_m_ahb_clk/s_ahb_clk, halt_check BRANCH_HALT_VOTED, hwcg_reg = halt_reg).
+ * 0330 read s_ahb CBCR 0x80000002 (HW_CTL 1, CLK_OFF 1) on the phone and stopped here: that was this case.
+ */
+enum { BR_OFF, BR_ON, BR_HWCG };
+
+static int
+cbcr_state(uint32_t off, uint32_t us)
+{
+	for (uint32_t i = 0; i <= us; i += 10) {
+		uint32_t v = rd(bt.gcc_qup + (off - GCC_QUP_WIN));
+		if (!(v & CBCR_OFF)) {
+			return BR_ON;
+		}
+		if (v & CBCR_HW_CTL) {
+			return BR_HWCG;
+		}
+		delay(10);
+	}
+	return BR_OFF;
+}
+
+static const char *
+br_name(int st)
+{
+	return st == BR_ON ? "on" : st == BR_HWCG ? "hw-gated (HW_CTL, not checked, as Linux)" : "OFF";
+}
+
+/* RPMh BCM QUP2 vote (Linux geni_icc_enable, path "qup-core"); failure is logged, not fatal */
+static void
+bcm_vote(void)
+{
+	uint32_t kbps = negroni_bt_arg("bcm_kbps", QUP_CORE2X_100MHZ_KBPS), data = 0;
+	int e = EBUSY;
+
+	if (!negroni_bt_arg("bcm", 1)) {
+		SAY("4 BCM QUP2 vote skipped (negronibt_bcm=0)\n");
+		return;
+	}
+	if (kbps == 0 || kbps > 100000u) {
+		kbps = QUP_CORE2X_100MHZ_KBPS;
+	}
+	for (unsigned i = 0; i < 40 && e == EBUSY; i++) {       /* the RPMh voter is shared: retry while busy */
+		e = negroni_rpmh_qup_bcm("QUP2", kbps, kbps, &data);
+		if (e == EBUSY) {
+			IOSleep(50);
+		}
+	}
+	SAY("4 BCM QUP2 (qup2_core_master -> qup2_core_slave) avg = peak %u kBps: data %#x, errno %d%s\n", kbps, data, e,
+	    e ? " (not fatal: the core clocks may run on the boot chain's vote)" : "");
+}
+
+static bool
+step_clocks(void)
+{
+	vm_offset_t rcg = bt.gcc_qup + (GCC_S5_RCGR - GCC_QUP_WIN);
+	uint32_t vote = rd(bt.gcc_vote + (GCC_VOTE_QUP - GCC_VOTE_WIN));
+
+	bcm_vote();
+	SAY("4 GCC vote %#x before (want bits %#x)\n", vote, GCC_VOTE_BITS);
+	bt.vote_before = vote;
+	bt.voted = (vote | GCC_VOTE_BITS) != vote;
+	wr(bt.gcc_vote + (GCC_VOTE_QUP - GCC_VOTE_WIN), vote | GCC_VOTE_BITS);
+	int core = cbcr_state(GCC_CORE_CBCR, 500), core2x = cbcr_state(GCC_CORE2X_CBCR, 500);
+	int mahb = cbcr_state(GCC_M_AHB_CBCR, 500), sahb = cbcr_state(GCC_S_AHB_CBCR, 500), s5 = cbcr_state(GCC_S5_CBCR, 500);
+	SAY("4 branches: wrap2 core %s, core_2x %s, m_ahb %s, s_ahb %s, s5 %s (CBCR %#x %#x %#x %#x %#x, vote now %#x)\n",
+	    br_name(core), br_name(core2x), br_name(mahb), br_name(sahb), br_name(s5),
+	    rd(bt.gcc_qup + (GCC_CORE_CBCR - GCC_QUP_WIN)), rd(bt.gcc_qup + (GCC_CORE2X_CBCR - GCC_QUP_WIN)),
+	    rd(bt.gcc_qup + (GCC_M_AHB_CBCR - GCC_QUP_WIN)), rd(bt.gcc_qup + (GCC_S_AHB_CBCR - GCC_QUP_WIN)),
+	    rd(bt.gcc_qup + (GCC_S5_CBCR - GCC_QUP_WIN)), rd(bt.gcc_vote + (GCC_VOTE_QUP - GCC_VOTE_WIN)));
+	uint32_t cmd = rd(rcg), cfg = rd(rcg + RCG_CFG), dfsr = rd(rcg + RCG_DFSR);
+	bt.dfs = (dfsr & 1u) != 0;
+	SAY("4 S5 RCG cmd %#x cfg %#x m %#x n %#x d %#x dfsr %#x: DFS %s, now %llu Hz\n", cmd, cfg, rd(rcg + RCG_M),
+	    rd(rcg + RCG_N), rd(rcg + RCG_D), dfsr, bt.dfs ? "on" : "off",
+	    rcg_rate(cfg, rd(rcg + RCG_M), rd(rcg + RCG_N)));
+	bt.levels = 0;
+	if (bt.dfs) {
+		for (uint32_t l = 0; l < RCG_LEVELS; l++) {
+			uint32_t c = rd(rcg + RCG_PERF_DFSR(l));
+			bt.level_hz[l] = rcg_rate(c, rd(rcg + RCG_PERF_M_DFSR(l)), rd(rcg + RCG_PERF_N_DFSR(l)));
+			SAY("4 DFS level %u: cfg %#x -> %llu Hz\n", l, c, bt.level_hz[l]);
+			bt.levels++;
+		}
+	}
+	if (core == BR_OFF || mahb == BR_OFF || sahb == BR_OFF) {
+		SAY("stop: the QUP2 core/AHB clocks do not run (a branch without HW_CTL reads CLK_OFF)\n");
+		return false;
+	}
+	if (s5 == BR_OFF) {
+		SAY("4 note: the S5 branch reads CLK_OFF before its RCG is set (step 6 sets the rate)\n");
+	}
+	return true;
+}
+
+/* gcc-waipio.c ftbl_gcc_qupv3_wrap0_s0_clk_src: rate, src, pre_div, m, n (used when DFS is off) */
+static const struct { uint32_t hz, src, div, m, n; } ftbl[] = {
+	{ 7372800, 6, 1, 384, 15625 }, { 14745600, 6, 1, 768, 15625 }, { 19200000, 0, 1, 0, 0 },
+	{ 29491200, 6, 1, 1536, 15625 }, { 32000000, 6, 1, 8, 75 }, { 48000000, 6, 1, 4, 25 },
+	{ 64000000, 6, 1, 16, 75 }, { 75000000, 6, 4, 0, 0 }, { 80000000, 6, 1, 4, 15 },
+	{ 96000000, 6, 1, 8, 25 }, { 100000000, 1, 6, 0, 0 },
+};
+
+static bool
+rcg_program(uint32_t i)
+{
+	vm_offset_t rcg = bt.gcc_qup + (GCC_S5_RCGR - GCC_QUP_WIN);
+	uint32_t cfg = rd(rcg + RCG_CFG) & ~(RCG_HID_MASK | 7u << 8 | 3u << 12);
+	cfg |= ftbl[i].src << 8;
+	if (ftbl[i].div > 1) {
+		cfg |= (2u * ftbl[i].div - 1u) & RCG_HID_MASK;
+	}
+	if (ftbl[i].n) {
+		wr(rcg + RCG_M, ftbl[i].m);
+		wr(rcg + RCG_N, ~(ftbl[i].n - ftbl[i].m) & RCG_MND_MASK);
+		wr(rcg + RCG_D, ~ftbl[i].n & RCG_MND_MASK);
+		cfg |= 2u << 12;                /* dual edge */
+	}
+	wr(rcg + RCG_CFG, cfg);
+	wr(rcg, rd(rcg) | RCG_CMD_UPDATE);
+	for (uint32_t us = 0; us < 1000; us += 10) {
+		if (!(rd(rcg) & RCG_CMD_UPDATE)) {
+			return true;
+		}
+		delay(10);
+	}
+	return false;
+}
+
+/* geni_se_clk_freq_match (exact = false) over the DFS levels or the table, then the divider */
+int
+negroni_bt_uart_set_baud(uint32_t baud)
+{
+	uint64_t want = (uint64_t)baud * bt.sampling, best_delta = ~0ull, best_hz = 0;
+	uint32_t best = 0, n = bt.dfs ? bt.levels : (uint32_t)(sizeof(ftbl) / sizeof(ftbl[0]));
+
+	if (!baud || !bt.se) {
+		return EINVAL;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		uint64_t hz = bt.dfs ? bt.level_hz[i] : ftbl[i].hz;
+		if (!hz) {
+			continue;
+		}
+		uint64_t div = (hz + want - 1u) / want;
+		uint64_t got = hz / div, delta = want > got ? want - got : got - want;
+		if (div <= 0xfffu && delta < best_delta) {
+			best_delta = delta;
+			best = i;
+			best_hz = hz;
+		}
+	}
+	if (!best_hz || best_delta * 50u > want) {      /* more than 2 % off: refuse */
+		SAY("baud %u: no clock level within 2 %% (best %llu Hz)\n", baud, best_hz);
+		return ERANGE;
+	}
+	uint32_t div = (uint32_t)((best_hz + want - 1u) / want);
+	if (bt.dfs) {
+		wr(bt.se + GENI_CLK_SEL, best & 7u);
+	} else {
+		if (!rcg_program(best)) {
+			SAY("baud %u: the S5 RCG update did not complete\n", baud);
+			return ETIMEDOUT;
+		}
+		wr(bt.se + GENI_CLK_SEL, 0);
+	}
+	uint32_t ser = 1u | div << 4;           /* SER_CLK_EN | CLK_DIV */
+	wr(bt.se + GENI_SER_M_CLK_CFG, ser);
+	wr(bt.se + GENI_SER_S_CLK_CFG, ser);
+	bt.baud = baud;
+	SAY("baud %u: %s %u = %llu Hz / %u / %u (error %llu Hz)\n", baud, bt.dfs ? "DFS level" : "table entry", best,
+	    best_hz, div, bt.sampling, best_delta / bt.sampling);
+	return 0;
+}
+
+/* ---- GENI UART ---- */
+
+static bool
+wait_bits(vm_offset_t reg, uint32_t mask, bool set, uint32_t us)
+{
+	for (uint32_t t = 0; t <= us; t += 5) {
+		if (((rd(reg) & mask) != 0) == set) {
+			return true;
+		}
+		delay(5);
+	}
+	return false;
+}
+
+static void
+rx_drain(void)
+{
+	uint32_t st = rd(bt.se + GENI_RX_FIFO_STATUS), wc = st & 0x1ffffffu;
+	for (uint32_t i = 0; i < wc; i++) {
+		/*
+		 * Patch 0332: read a FIFO word only when the ring has room for all 4 bytes. Else the word stays in the
+		 * FIFO, the FIFO fills, RFR (it follows the FIFO) stops the controller: no byte is lost. This matters
+		 * when negroni_bt_uart_write drains RX during a long send while the H4 RX thread waits for the UART.
+		 */
+		if ((bt.tail + RX_RING - bt.head - 1u) % RX_RING < 4u) {
+			break;
+		}
+		uint32_t w = rd(bt.se + GENI_RX_FIFO), nb = 4;
+		if (i == wc - 1u && (st & (1u << 31))) {
+			nb = (st >> 28) & 7u;
+			if (nb == 0 || nb > 4) {
+				nb = 4;
+			}
+		}
+		for (uint32_t b = 0; b < nb; b++) {
+			uint32_t next = (bt.head + 1u) % RX_RING;
+			if (next == bt.tail) {
+				bt.dropped++;
+			} else {
+				bt.ring[bt.head] = (uint8_t)(w >> (8u * b));
+				bt.head = next;
+			}
+		}
+	}
+	uint32_t s = rd(bt.se + GENI_S_IRQ_STATUS);
+	if (s) {
+		wr(bt.se + GENI_S_IRQ_CLEAR, s);
+	}
+	if (!(rd(bt.se + GENI_STATUS) & (1u << 12))) {  /* the read command ended (break, error): restart it */
+		wr(bt.se + GENI_S_CMD0, UART_START_READ << 27 | (bt.rfropen ? UART_PARAM_VENDOR : 0u));
+	}
+}
+
+uint32_t
+negroni_bt_uart_read(uint8_t *buf, uint32_t max)
+{
+	uint32_t n = 0;
+	rx_drain();
+	while (n < max && bt.tail != bt.head) {
+		buf[n++] = bt.ring[bt.tail];
+		bt.tail = (bt.tail + 1u) % RX_RING;
+	}
+	return n;
+}
+
+static void
+m_cancel(void)
+{
+	wr(bt.se + GENI_M_CMD_CTRL, CMD_CTRL_CANCEL);
+	if (!wait_bits(bt.se + GENI_M_IRQ_STATUS, M_CMD_CANCEL, true, 2000)) {
+		wr(bt.se + GENI_M_CMD_CTRL, CMD_CTRL_ABORT);
+		(void)wait_bits(bt.se + GENI_M_IRQ_STATUS, M_CMD_ABORT, true, 2000);
+	}
+	wr(bt.se + GENI_M_IRQ_CLEAR, 0xffffffffu);
+}
+
+int
+negroni_bt_uart_write(const uint8_t *buf, uint32_t len)
+{
+	/* time on the wire at 10 bits/char + 100 ms for CTS held by the controller */
+	uint64_t limit = (uint64_t)len * 10u * 1000000u / (bt.baud ? bt.baud : 115200u) + 100000u;
+	uint64_t t0 = negroni_bt_us();
+
+	if (!len) {
+		return 0;
+	}
+	if (rd(bt.se + GENI_STATUS) & 1u) {
+		m_cancel();
+	}
+	wr(bt.se + GENI_M_IRQ_CLEAR, M_CMD_DONE);
+	wr(bt.se + UART_TX_TRANS_LEN, len);
+	wr(bt.se + GENI_M_CMD0, UART_START_TX << 27);
+	for (uint32_t i = 0; i < len; i += 4) {
+		uint32_t w = 0;
+		for (uint32_t b = 0; b < 4 && i + b < len; b++) {
+			w |= (uint32_t)buf[i + b] << (8u * b);
+		}
+		while ((rd(bt.se + GENI_TX_FIFO_STATUS) & 0x0fffffffu) >= bt.tx_depth) {
+			rx_drain();             /* keep RX moving while TX waits for CTS */
+			if (negroni_bt_us() - t0 > limit) {
+				SAY("TX stalled at byte %u of %u (FIFO full, GENI_IOS %#x: CTS %u)\n", i, len,
+				    rd(bt.se + GENI_IOS), (rd(bt.se + GENI_IOS) >> 1) & 1u);
+				m_cancel();
+				return ETIMEDOUT;
+			}
+			delay(2);
+		}
+		wr(bt.se + GENI_TX_FIFO, w);
+	}
+	while (!(rd(bt.se + GENI_M_IRQ_STATUS) & M_CMD_DONE)) {
+		rx_drain();
+		if (negroni_bt_us() - t0 > limit) {
+			SAY("TX of %u bytes did not complete (GENI_IOS %#x, TX FIFO %#x)\n", len, rd(bt.se + GENI_IOS),
+			    rd(bt.se + GENI_TX_FIFO_STATUS));
+			m_cancel();
+			return ETIMEDOUT;
+		}
+		delay(2);
+	}
+	wr(bt.se + GENI_M_IRQ_CLEAR, M_CMD_DONE);
+	return 0;
+}
+
+void
+negroni_bt_uart_flow(bool on)
+{
+	uint32_t tx = rd(bt.se + UART_TX_TRANS_CFG);
+	if (on) {
+		wr(bt.se + UART_MANUAL_RFR, 0);                                 /* RFR follows the RX FIFO */
+		tx = bt.noflow ? (tx | UART_CTS_MASK) : (tx & ~UART_CTS_MASK);
+	} else {
+		wr(bt.se + UART_MANUAL_RFR, 1u << 31 | 1u << 1);                /* manual, NOT ready */
+		tx |= UART_CTS_MASK;
+	}
+	wr(bt.se + UART_TX_TRANS_CFG, tx);
+}
+
+static bool
+step_geni(void)
+{
+	uint32_t fw = rd(bt.se + GENI_FW_REVISION_RO), ifd = rd(bt.se + GENI_IF_DISABLE_RO);
+	uint32_t p0 = rd(bt.se + SE_HW_PARAM_0), p1 = rd(bt.se + SE_HW_PARAM_1);
+
+	bt.qup_ver = rd(bt.qup + QUP_HW_VER);
+	bool big = bt.qup_ver >= 0x30010000u;   /* QUP >= 3.10: depth in bits 23:16 */
+	bt.tx_depth = (p0 >> 16) & (big ? 0xffu : 0x3fu);
+	bt.rx_depth = (p1 >> 16) & (big ? 0xffu : 0x3fu);
+	bt.sampling = bt.qup_ver >= 0x20050000u ? 16u : 32u;
+	SAY("5 QUP2 HW version %#x (oversampling %u); SE5 FW revision %#x (protocol %u, version %#x), S revision %#x, "
+	    "IF_DISABLE %#x, status %#x, CLK_CTRL %#x\n", bt.qup_ver, bt.sampling, fw, (fw >> 8) & 0xffu, fw & 0xffu,
+	    rd(bt.se + GENI_FW_S_REVISION_RO), ifd, rd(bt.se + GENI_STATUS), rd(bt.se + GENI_CLK_CTRL_RO));
+	SAY("5 HW_PARAM_0 %#x (TX FIFO %u words of %u bits), HW_PARAM_1 %#x (RX FIFO %u words), DMA_MODE_EN %#x\n",
+	    p0, bt.tx_depth, (p0 >> 24) & 0x3fu, p1, bt.rx_depth, rd(bt.se + GENI_DMA_MODE_EN));
+	if (fw == 0xffffffffu || ((fw >> 8) & 0xffu) != PROTO_UART) {
+		SAY("stop: SE5 has no UART firmware (protocol %u; XBL loads it from qupfw; Linux would load it itself)\n",
+		    (fw >> 8) & 0xffu);
+		return false;
+	}
+	if (ifd & 1u) {
+		SAY("stop: SE5 FIFO interface disabled (GSI only, like QUP0 SE4 for touch)\n");
+		return false;
+	}
+	if (bt.tx_depth < 4 || bt.rx_depth < 4) {
+		SAY("stop: FIFO depth %u/%u words is not usable\n", bt.tx_depth, bt.rx_depth);
+		return false;
+	}
+	return true;
+}
+
+static bool
+step_uart(void)
+{
+	/* the pinctrl "active" state: CTS no pull, RTS pull-down, TX pull-up, RX no pull; 2 mA; function qup20 */
+	pin_cfg(PIN_CTS, QUP20_FUNC << 2 | 0u);
+	pin_cfg(PIN_RTS, QUP20_FUNC << 2 | 1u);
+	pin_cfg(PIN_TX, QUP20_FUNC << 2 | 3u);
+	pin_cfg(PIN_RX, QUP20_FUNC << 2 | 0u);
+	SAY("6 pins 76-79 -> qup20: cfg %#x %#x %#x %#x\n", rd(pin(PIN_CTS)), rd(pin(PIN_RTS)), rd(pin(PIN_TX)),
+	    rd(pin(PIN_RX)));
+	if (rd(bt.se + GENI_STATUS) & 1u) {
+		m_cancel();
+	}
+	if (rd(bt.se + GENI_STATUS) & (1u << 12)) {
+		wr(bt.se + GENI_S_CMD_CTRL, CMD_CTRL_CANCEL);
+		if (!wait_bits(bt.se + GENI_S_IRQ_STATUS, S_CMD_CANCEL, true, 2000)) {
+			wr(bt.se + GENI_S_CMD_CTRL, CMD_CTRL_ABORT);
+			(void)wait_bits(bt.se + GENI_S_IRQ_STATUS, S_CMD_ABORT, true, 2000);
+		}
+	}
+	/* geni_se_irq_clear, geni_se_io_init, geni_se_io_set_mode (FIFO) */
+	wr(bt.se + SE_GSI_EVENT_EN, 0);
+	wr(bt.se + GENI_M_IRQ_CLEAR, 0xffffffffu);
+	wr(bt.se + GENI_S_IRQ_CLEAR, 0xffffffffu);
+	wr(bt.se + DMA_TX_IRQ_CLR, 0xffffffffu);
+	wr(bt.se + DMA_RX_IRQ_CLR, 0xffffffffu);
+	wr(bt.se + SE_IRQ_EN, 0xffffffffu);
+	wr(bt.se + GENI_CGC_CTRL, rd(bt.se + GENI_CGC_CTRL) | 0x7fu);
+	wr(bt.se + SE_DMA_GENERAL_CFG, rd(bt.se + SE_DMA_GENERAL_CFG) | 0xfu);
+	wr(bt.se + GENI_OUTPUT_CTRL, 0x7fu);
+	wr(bt.se + GENI_FORCE_DEFAULT, 1u);
+	wr(bt.se + GENI_DMA_MODE_EN, rd(bt.se + GENI_DMA_MODE_EN) & ~1u);
+	wr(bt.se + GENI_M_IRQ_EN, 0);           /* polled: no interrupt sources */
+	wr(bt.se + GENI_S_IRQ_EN, 0);
+	wr(bt.se + GENI_RX_WATERMARK, 2u);
+	wr(bt.se + GENI_RX_RFR_WATERMARK, bt.rx_depth - 2u);
+	wr(bt.se + GENI_TX_WATERMARK, 0);
+	/* geni_se_config_packing(8 bits, 4 per word, LSB first): Linux values for UART */
+	wr(bt.se + GENI_TX_PACKING_CFG0, 0x4380eu);
+	wr(bt.se + GENI_TX_PACKING_CFG1, 0xc3e0eu);
+	wr(bt.se + GENI_RX_PACKING_CFG0, 0x4380eu);
+	wr(bt.se + GENI_RX_PACKING_CFG1, 0xc3e0eu);
+	wr(bt.se + GENI_BYTE_GRAN, 0);
+	/* set_termios: 8N1, no loopback, stale timeout 16 chars, flow control on */
+	wr(bt.se + UART_RX_STALE_CNT, 10u * 16u);
+	wr(bt.se + UART_LOOPBACK_CFG, 0);
+	wr(bt.se + UART_TX_TRANS_CFG, bt.noflow ? UART_CTS_MASK : 0u);
+	wr(bt.se + UART_RX_TRANS_CFG, 0);
+	wr(bt.se + UART_TX_PARITY_CFG, 0);
+	wr(bt.se + UART_RX_PARITY_CFG, 0);
+	wr(bt.se + UART_TX_WORD_LEN, 8u);
+	wr(bt.se + UART_RX_WORD_LEN, 8u);
+	wr(bt.se + UART_TX_STOP_BIT_LEN, 0);
+	wr(bt.se + UART_MANUAL_RFR, 0);
+	if (negroni_bt_uart_set_baud(115200u) != 0) {
+		SAY("stop: no SE clock for 115200 baud\n");
+		return false;
+	}
+	bt.head = bt.tail = bt.dropped = 0;
+	wr(bt.se + GENI_S_CMD0, UART_START_READ << 27 | (bt.rfropen ? UART_PARAM_VENDOR : 0u));
+	SAY("6 UART 115200 8N1, flow control %s, RX started (param %#x), status %#x, IOS %#x\n",
+	    bt.noflow ? "off (negronibt_noflow)" : "RTS/CTS", bt.rfropen ? UART_PARAM_VENDOR : 0u,
+	    rd(bt.se + GENI_STATUS), rd(bt.se + GENI_IOS));
+	return true;
+}
+
+/* btpower.c bt_configure_gpios(on) for a QCA6490 with WLAN_EN and XO_CLK GPIOs */
+static bool
+step_power_on(void)
+{
+	uint32_t wlan_on = gpio_in(PIN_WLAN_EN);       /* pin level, as btpower.c gpio_get_value */
+
+	/* SW_CTRL as input with the census pull (btpower.c gpio_direction_input before it reads it) */
+	pin_cfg(PIN_SW_CTRL, rd(pin(PIN_SW_CTRL)) & 3u);
+	SAY("7 BT_EN low, 50 ms (WLAN_EN %u, SW_CTRL %u)\n", wlan_on, gpio_in(PIN_SW_CTRL));
+	gpio_out(PIN_BT_EN, false, 1u);
+	IOSleep(50);
+	SAY("7 after BT_EN low: SW_CTRL %u\n", gpio_in(PIN_SW_CTRL));
+	if (!wlan_on) {
+		SAY("7 WLAN_EN is low: wait %u ms for the AON output to discharge\n", bt.aon_ms);
+		IOSleep(bt.aon_ms);
+	}
+	gpio_out(PIN_XO_CLK, true, 0);
+	delay(150);
+	gpio_out(PIN_BT_EN, true, 1u);
+	bt.powered = true;
+	delay(5000);
+	gpio_out(PIN_XO_CLK, false, 0);
+	IOSleep(50);
+	uint32_t sw = gpio_in(PIN_SW_CTRL);
+	SAY("7 BT_EN out %u (cfg %#x), XO_CLK pulsed (cfg %#x), SW_CTRL %u (%s)\n", (rd(pin(PIN_BT_EN) + 4u) >> 1) & 1u,
+	    rd(pin(PIN_BT_EN)), rd(pin(PIN_XO_CLK)), sw, sw ? "asserted: the chip's BT side is up" :
+	    "NOT asserted: no power or no clock to the BT side");
+	return true;            /* SW_CTRL is diagnostic only (btpower.c also continues) */
+}
+
+static void
+step_rx_idle(void)
+{
+	uint8_t b[32];
+	uint32_t n = 0, sum = 0;
+	char hex[3 * 32 + 1];
+
+	for (uint32_t ms = 0; ms < 200; ms += 10) {
+		IOSleep(10);
+		uint32_t got = negroni_bt_uart_read(b + n, sizeof(b) - n);
+		n += got;
+		sum += got;
+		if (n == sizeof(b)) {
+			break;
+		}
+	}
+	hex[0] = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		snprintf(hex + 3 * i, 4, " %02x", b[i]);
+	}
+	SAY("8 %u bytes from the controller after power-on (200 ms)%s%s, RX ring dropped %u, IOS %#x\n", sum,
+	    n ? ":" : "", hex, bt.dropped, rd(bt.se + GENI_IOS));
+}
+
+/*
+ * 0335: power cycle for the H4 transport (negroni_bt_h4.c power worker). Off = BT_EN low (btpower.c power off
+ * drives only the enable GPIO; the rails are shared and stay, the QUP2 clocks stay voted). On = the line back to
+ * 115200 (the ROM rate after BT_EN), the step 7 sequence, step 8, then the whole HCI stage (version, 3 Mbaud,
+ * rampatch, NVM, reset, BD address), as at boot.
+ */
+void
+negroni_bt_chip_off(void)
+{
+	if (!bt.powered) {
+		return;
+	}
+	gpio_out(PIN_BT_EN, false, 1u);
+	bt.powered = false;
+	SAY("power off: BT_EN low (SW_CTRL %u); rails and QUP2 clocks stay\n", gpio_in(PIN_SW_CTRL));
+}
+
+int
+negroni_bt_chip_on(void)
+{
+	uint64_t t0 = negroni_bt_us();
+	int error;
+
+	SAY("power on: line to 115200, BT_EN sequence, HCI stage\n");
+	negroni_bt_uart_flow(true);
+	if ((error = negroni_bt_uart_set_baud(115200u)) != 0) {
+		SAY("power on: no SE clock for 115200 (%d)\n", error);
+		return error;
+	}
+	bt.head = bt.tail = 0;
+	(void)step_power_on();
+	step_rx_idle();
+	error = negroni_bt_hci_run(bt.mode);
+	if (error) {
+		negroni_bt_chip_off();
+	}
+	SAY("power on: %s after %llu ms (error %d)\n", error ? "FAILED" : "chip ready", (negroni_bt_us() - t0) / 1000u,
+	    error);
+	return error;
+}
+
+static void
+bt_thread(void *arg __unused, wait_result_t w __unused)
+{
+	bool ok = false;
+	uint32_t delay_s = negroni_bt_arg("delay", 3);
+	if (delay_s > 120) {
+		delay_s = 120;
+	}
+	IOSleep(delay_s * 1000u);
+	SAY("start (negronibt=%u; stage A: UART + BT_EN%s%s)\n", bt.mode, bt.mode >= 2 ? " + HCI" : "",
+	    bt.mode >= 4 ? " + iOS transport" : "");
+	if (bt.mode >= 4) {
+		negroni_bt_h4_attach();         /* userland can open the transport now; sends wait for the chip */
+	}
+
+	STEP(1, "map GCC, TLMM, QUP2, SE5");
+	bt.gcc_qup = map(GCC_PHYS + GCC_QUP_WIN, GCC_QUP_WIN_SIZE);
+	bt.gcc_vote = map(GCC_PHYS + GCC_VOTE_WIN, BT_PAGE);
+	bt.tlmm_uart = map(TLMM_PHYS + TLMM_PIN(PIN_CTS), TLMM_PIN(8));
+	bt.tlmm_xo = map(TLMM_PHYS + TLMM_PIN(PIN_XO_CLK), 0x1000u);
+	bt.qup = map(QUP2_PHYS, 0x2000u);
+	bt.se = map(SE_PHYS, 0x4000u);
+	if (!bt.gcc_qup || !bt.gcc_vote || !bt.tlmm_uart || !bt.tlmm_xo || !bt.qup || !bt.se) {
+		SAY("stop: a mapping failed\n");
+		goto out;
+	}
+
+	STEP(2, "pin census");
+	pin_line("CTS", PIN_CTS);
+	pin_line("RTS", PIN_RTS);
+	pin_line("TX", PIN_TX);
+	pin_line("RX", PIN_RX);
+	pin_line("WLAN_EN", PIN_WLAN_EN);
+	pin_line("BT_EN", PIN_BT_EN);
+	pin_line("SW_CTRL", PIN_SW_CTRL);
+	pin_line("XO_CLK", PIN_XO_CLK);
+
+	STEP(3, "rails (RPMh apps DRV2 votes, DT bt-vdd-*-config)");
+	if (rail("smpb11", 966) || rail("smpc1", 1900) || rail("smpb12", 1350) || rail("ldoe7", 2800)) {
+		SAY("stop: a rail vote failed; BT_EN stays low\n");
+		goto out;
+	}
+
+	STEP(4, "clocks (GCC QUP2 core, AHB, S5)");
+	if (!step_clocks()) {
+		goto out;
+	}
+
+	STEP(5, "GENI SE5 firmware and FIFO check");
+	if (!step_geni()) {
+		goto out;
+	}
+
+	STEP(6, "UART init (FIFO mode, 115200)");
+	if (!step_uart()) {
+		goto out;
+	}
+
+	STEP(7, "BT_EN power sequence (btpower.c)");
+	(void)step_power_on();
+
+	STEP(8, "RX idle bytes");
+	step_rx_idle();
+
+	if (bt.mode >= 2 && negroni_bt_hci_run(bt.mode) != 0) {
+		SAY("stop: the HCI stage failed\n");
+		goto out;
+	}
+	ok = true;
+	SAY("stage A done (RX ring dropped %u bytes)\n", bt.dropped);
+	if (bt.mode >= 4) {
+		if (bt.poweroff) {
+			negroni_bt_h4_fail("negronibt_off=1");
+		} else {
+			negroni_bt_h4_start();          /* the transport owns the UART from here */
+		}
+	}
+out:
+	if (!ok && bt.mode >= 4) {
+		negroni_bt_h4_fail("stage A or the HCI stage failed");
+	}
+	if (bt.powered && (!ok || bt.poweroff)) {
+		gpio_out(PIN_BT_EN, false, 1u);
+		SAY("BT_EN low again (%s); rails stay on\n", ok ? "negronibt_off=1" : "failure");
+	}
+	if (!ok && bt.voted && bt.gcc_vote) {
+		wr(bt.gcc_vote + (GCC_VOTE_QUP - GCC_VOTE_WIN), bt.vote_before);
+		SAY("GCC vote restored to %#x\n", bt.vote_before);
+	}
+	(void)thread_terminate(current_thread());
+}
+
+void
+negroni_bt_init(void)
+{
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("negronibt", &bt.mode, sizeof(bt.mode));
+	if (bt.mode == 0) {
+		return;
+	}
+	bt.noflow = negroni_bt_arg("noflow", 0);
+	bt.rfropen = negroni_bt_arg("rfropen", 0);
+	bt.aon_ms = negroni_bt_arg("aon_ms", 100);
+	if (bt.aon_ms > 1000) {
+		bt.aon_ms = 1000;
+	}
+	bt.poweroff = negroni_bt_arg("off", 0);
+	if (kernel_thread_start(bt_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_bt.h b/bsd/dev/negroni_bt.h
new file mode 100644
index 0000000..1cffff3
--- /dev/null
+++ b/bsd/dev/negroni_bt.h
@@ -0,0 +1,47 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450): Bluetooth of the QCA6490 combo chip (patches 0330-0349).
+ * The seam between the UART/power stage (negroni_bt.c, patch 0330) and the HCI stage
+ * (negroni_bt_hci.c, patch 0331). Plan and facts: iOSPlus10 docs/bluetooth-plan.md.
+ */
+#ifndef _NEGRONI_BT_H_
+#define _NEGRONI_BT_H_
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <stdint.h>
+#include <stdbool.h>
+
+/* UART stage, implemented in negroni_bt.c */
+int negroni_bt_uart_write(const uint8_t *buf, uint32_t len);    /* 0 or errno; waits until sent */
+uint32_t negroni_bt_uart_read(uint8_t *buf, uint32_t max);      /* bytes now in the RX ring, no wait */
+int negroni_bt_uart_set_baud(uint32_t baud);                    /* 0 or errno (no clock level fits) */
+void negroni_bt_uart_flow(bool on);     /* false: RFR not ready + CTS ignored (hci_qca baud switch) */
+uint32_t negroni_bt_uart_baud(void);
+uint64_t negroni_bt_us(void);
+void negroni_bt_sleep_ms(uint32_t ms);
+uint32_t negroni_bt_arg(const char *name, uint32_t def);        /* "negronibt_" + name boot-arg */
+
+/* HCI stage, implemented in negroni_bt_hci.c (patch 0331): runs on the BT thread after step 8 when negronibt >= 2.
+ * 0 or errno; an error makes negroni_bt.c drive BT_EN low (the stage A failure path). */
+int negroni_bt_hci_run(uint32_t mode);
+
+/* iOS H4 transport, implemented in negroni_bt_h4.c (patch 0332), negronibt >= 4. */
+void negroni_bt_h4_attach(void);                /* kernel control + /dev nodes; sends wait for the chip */
+void negroni_bt_h4_start(void);                 /* chip ready: RX thread, sends go to the UART */
+void negroni_bt_h4_fail(const char *why);       /* chip not ready: sends fail with EIO */
+void negroni_bt_h4_inject(const uint8_t *pkt, uint32_t len);    /* one H4 packet toward userland */
+int negroni_bt_h4_send_cmd(const uint8_t *pkt, uint32_t len, bool from_rx);   /* 0338: a shim command to the chip */
+
+/* 0335: chip power for the transport (negroni_bt.c); the caller owns the UART (no RX thread read meanwhile) */
+void negroni_bt_chip_off(void);                 /* BT_EN low; rails and clocks stay */
+int negroni_bt_chip_on(void);                   /* BT_EN sequence + HCI stage again; 0 or errno (BT_EN low on error) */
+
+/* HCI shim, implemented in negroni_bt_shim.c (patch 0333 replaces the 0332 pass-through) */
+#define NEGRONI_BT_SHIM_PASS    0               /* send / deliver the packet unchanged (or as rewritten) */
+#define NEGRONI_BT_SHIM_DONE    1               /* host command answered in the kernel: not sent */
+#define NEGRONI_BT_SHIM_DROP    2               /* controller packet not delivered to userland */
+void negroni_bt_shim_init(void);
+int negroni_bt_shim_tx(uint8_t *pkt, uint32_t len);            /* host -> controller, pkt[0] = H4 type; may rewrite in place (0337) */
+int negroni_bt_shim_rx(uint8_t *pkt, uint32_t len);            /* controller -> host, may rewrite in place */
+void negroni_bt_shim_session(void);                             /* a new userland client: reset per-client state */
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
+#endif /* _NEGRONI_BT_H_ */
diff --git a/bsd/dev/negroni_bt_h4.c b/bsd/dev/negroni_bt_h4.c
new file mode 100644
index 0000000..028b61b
--- /dev/null
+++ b/bsd/dev/negroni_bt_h4.c
@@ -0,0 +1,1307 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450): QCA6490 Bluetooth, stage B (patch 0332): the H4 transport that iOS
+ * bluetoothd and BlueTool open, on top of the GENI UART of patch 0330 after the firmware download of patch 0331.
+ * negronibt=4 only. Plan: iOSPlus10 docs/bluetooth-plan.md section 4; README-bluetooth.md section 0332.
+ *
+ * What iOS 16 (20H392, iPhone10,3 userland) opens [V, addresses in usr/sbin/bluetoothd]:
+ *   - main 0x100026af4..0x100026b68: access("/dev/cu.bluetooth"), access("/dev/uart.bluetooth"), else an
+ *     IORegistry service named "marconi-bt" or "bluetooth"; none: "No bluetooth on this device", exit 0.
+ *   - transport choice 0x100156160: env BT_HCI_TRANSPORT ("H4BC:POSIX:com.apple.uart.bluetooth,3000000"), else
+ *     the ADT u32 transport-encoding (3 = H4BC).
+ *   - POSIX open 0x100066bdc: socket(PF_SYSTEM, SOCK_STREAM, SYSPROTO_CONTROL), CTLIOCGINFO on the control name
+ *     (default "com.apple.uart.sk.bluetooth" = Skywalk, not made here), connect; for a plain name:
+ *     getsockopt(SYSPROTO_CONTROL, TIOCGETA 0x40487413, 72 bytes), cfmakeraw + cfsetspeed (ADT transport-speed,
+ *     default 2400000), c_cflag 0x38b00 (CS8 CREAD HUPCL CLOCAL CRTSCTS), setsockopt(TIOCSETA 0x80487414) whose
+ *     return value is not checked (0x1000671c8). Then plain read/write of H4 bytes.
+ *   - H4BC opens /dev/btwake (0x100066b24); a failure is only logged.
+ * So this file makes:
+ *   1. the kernel control "com.apple.uart.bluetooth" (SOCK_STREAM, not privileged: bluetoothd and BlueTool run as
+ *      mobile), TIOCGETA/TIOCSETA as socket options;
+ *   2. /dev/uart.bluetooth and /dev/cu.bluetooth (one char device: read/write raw H4 bytes, select/poll/kqueue,
+ *      TIOCGETA/TIOCSETA/FIONREAD) and /dev/btwake (open/close do nothing: the kernel owns BT_EN);
+ *   3. one client at a time (control or device), EBUSY for a second one. A client change empties the queues.
+ * Data path:
+ *   RX: a kernel thread polls the UART (0330 helpers; the GENI SE has no interrupt line wired here). Poll period 1 ms
+ *       for 200 ms after traffic, 5 ms up to 5 s, then 20 ms; RFR follows the RX FIFO, so the controller waits while
+ *       the host does not read (no loss, no busy loop). H4 framing (type 04 event, 02 ACL, 03 SCO, 05 ISO), the QCA
+ *       in-band sleep bytes (hci_qca.c: 0xfe SLEEP_IND, 0xfd WAKE_IND -> answer 0xfc WAKE_ACK, 0xfc WAKE_ACK) are
+ *       handled here and never reach userland. Whole packets go to a 64 KiB queue; the UART is not read while the
+ *       queue has less than one maximal packet + one read of room (flow control by RFR).
+ *   TX: userland bytes are framed into H4 packets; each packet goes through the HCI shim (negroni_bt_shim.c,
+ *       patch 0333) and then to the UART. When the controller sent SLEEP_IND, a WAKE_IND goes first and the send
+ *       waits up to 100 ms per try for WAKE_ACK (3 tries, IBS_WAKE_RETRANS_TIMEOUT_MS of hci_qca.c).
+ *   Termios from userland is stored and logged; the line stays at the rate stage A set (the controller would not
+ *   follow a host-only change) with RTS/CTS on.
+ * Limits: a send is a bounded busy-wait in the 0330 helper (delay(2) polls of the TX FIFO: wire time + 100 ms for CTS);
+ * RX throughput is bounded by the GENI RX FIFO depth per poll period (the controller waits on RFR in between).
+ * Before the chip is ready (stage A + HCI stage still running), a send waits up to negronibt_wait_ms (default 30000);
+ * after a stage A/HCI failure it fails with EIO. Every wait is bounded.
+ * Boot-args: negronibt_h4log=N (log the first N packets per direction, default 300; HW errors, IBS and the shim are
+ *   always logged), negronibt_wait_ms=MS.
+ * 0335 (power follows the client, dead-chip answers):
+ *   - With a working chip, the last client closing starts a timer (negronibt_off_ms, default 3000); when no client
+ *     came back, a power worker drives BT_EN low (negroni_bt_chip_off). The next client (bluetoothd after a toggle
+ *     on, or its restart) powers the chip on again: BT_EN sequence + the whole HCI stage (negroni_bt_chip_on); its
+ *     sends wait for that (negronibt_wait_ms). negronibt_pwrfollow=0 keeps the chip on.
+ *   - With a failed chip (stage A or HCI stage failed), every host command gets a local Command Complete with status
+ *     0x03 (Hardware Failure) instead of a send error (EIO), so bluetoothd's stack init ends with an HCI error and
+ *     not a hung power-on (owner bug 2026-10-27: the Bluetooth switch stayed on). negronibt_dead=0: EIO as before;
+ *     negronibt_dead=2: the connect is refused (bluetoothd then stops with "Transport layer initialization failed").
+ * Log lines start "NEGRONI BT: h4 ". Proof of a working path: "h4 control ... connected", "h4 tx cmd 0x0c03",
+ * "h4 rx evt 0x0e ... op 0x0c03 status 0".
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/conf.h>
+#include <sys/uio.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/select.h>
+#include <sys/termios.h>
+#include <sys/ttycom.h>
+#include <sys/filio.h>
+#include <sys/kern_control.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/vnode.h>                  /* IO_NDELAY */
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include "negroni_bt.h"
+
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+
+#define SAY(...)        printf("NEGRONI BT: h4 " __VA_ARGS__)
+
+#define H4_CTL_NAME     "com.apple.uart.bluetooth"
+#define H4_CMD          0x01u
+#define H4_ACL          0x02u
+#define H4_SCO          0x03u
+#define H4_EVT          0x04u
+#define H4_ISO          0x05u
+#define IBS_SLEEP_IND   0xfeu
+#define IBS_WAKE_IND    0xfdu
+#define IBS_WAKE_ACK    0xfcu
+#define PKT_MAX         4104u           /* largest H4 frame accepted in each direction (ACL 5 + 4095 + slack) */
+#define RXQ_SIZE        (64u << 10)
+#define RD_CHUNK        512u            /* UART bytes per poll */
+#define RXQ_ROOM        (PKT_MAX + RD_CHUNK + 64u)
+#define CTL_CHUNK       2048u
+#define DUMP_MAX        16u
+
+#define OWNER_NONE      0u
+#define OWNER_CTL       1u
+#define OWNER_DEV       2u
+
+#define MINOR_UART      0
+#define MINOR_CU        1
+#define MINOR_WAKE      2
+
+static LCK_GRP_DECLARE(h4_grp, "negroni_bt_h4");
+static LCK_MTX_DECLARE(h4_lock, &h4_grp);       /* state, queues, owner */
+static LCK_MTX_DECLARE(h4_uart, &h4_grp);       /* the 0330 UART helpers (not reentrant) */
+static LCK_MTX_DECLARE(h4_tx, &h4_grp);         /* TX framing + packet order */
+
+static struct {
+	bool attached, ready, failed, kick, ctl_full, ctrl_awake, ibs_seen, ackd;
+	uint32_t owner, unit, log_tx, log_rx, wait_ms;
+	kern_ctl_ref ref;
+	int major;
+	uint64_t last_act, last_stats;
+	/* RX (thread only) */
+	uint8_t rx[PKT_MAX];
+	uint32_t rxn;
+	/* RX queue toward userland (h4_lock) */
+	uint8_t q[RXQ_SIZE];
+	uint32_t qh, qt, qn;
+	struct selinfo rsel;
+	/* TX framing (h4_tx) */
+	uint8_t tx[PKT_MAX];
+	uint32_t txn;
+	struct termios tio;
+	/* counters */
+	uint32_t n_tx, n_rx, n_local, n_drop_noowner, n_drop_full, n_drop_shim, n_garbage_rx, n_garbage_tx;
+	uint32_t n_ibs_rx, n_ibs_wake, n_ibs_timeout, n_tx_err, n_wake_open;
+	/* 0335 power worker (h4_lock) */
+	bool off, powering, worker, rx_running, rx_reset;
+	uint32_t dead_mode, pwr_follow, off_ms, n_dead, n_off, n_on, n_on_fail;
+	uint64_t gone_at;
+	uint64_t b_tx, b_rx, b_user;
+	char why[64];
+	/* 0338: a shim command deferred from the RX thread while the controller sleeps (h4_lock) */
+	bool shim_pend;
+	uint32_t shim_len, n_shim_defer;
+	uint8_t shim_pkt[64];
+} t;
+
+static uint8_t ctl_buf[CTL_CHUNK];              /* RX thread only */
+
+static inline uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static uint64_t
+now_us(void)
+{
+	return negroni_bt_us();
+}
+
+/* " xx xx ..." of the first DUMP_MAX bytes into s (caller's buffer: TX and RX run on different threads) */
+static const char *
+hexs(char *s, size_t sz, const uint8_t *b, uint32_t n)
+{
+	uint32_t i, m = MIN(n, DUMP_MAX);
+	s[0] = 0;
+	for (i = 0; i < m && 3 * i + 4 <= sz; i++) {
+		snprintf(s + 3 * i, 4, " %02x", b[i]);
+	}
+	if (n > m && 3 * i + 5 <= sz) {
+		strlcpy(s + 3 * i, " ...", 5);
+	}
+	return s;
+}
+
+static const char *
+type_name(uint8_t ty)
+{
+	switch (ty) {
+	case H4_CMD: return "cmd";
+	case H4_ACL: return "acl";
+	case H4_SCO: return "sco";
+	case H4_EVT: return "evt";
+	case H4_ISO: return "iso";
+	default: return "?";
+	}
+}
+
+/*
+ * Bytes of the H4 frame that starts at p (n bytes there): 0 = not known yet (need more bytes), else the frame
+ * length. dir_tx: host -> controller (command header 3 bytes), else controller -> host (event header 2 bytes).
+ * Unknown type: returns UINT32_MAX.
+ */
+static uint32_t
+frame_len(const uint8_t *p, uint32_t n, bool dir_tx)
+{
+	switch (p[0]) {
+	case H4_CMD:
+		if (!dir_tx) {
+			return UINT32_MAX;
+		}
+		return n < 4 ? 0 : 4u + p[3];
+	case H4_EVT:
+		if (dir_tx) {
+			return UINT32_MAX;
+		}
+		return n < 3 ? 0 : 3u + p[2];
+	case H4_ACL:
+		return n < 5 ? 0 : 5u + le16(p + 3);
+	case H4_SCO:
+		return n < 4 ? 0 : 4u + p[3];
+	case H4_ISO:
+		return n < 5 ? 0 : 5u + (le16(p + 3) & 0x3fffu);
+	default:
+		return UINT32_MAX;
+	}
+}
+
+static void
+log_pkt(const char *dir, const uint8_t *p, uint32_t n)
+{
+	char hx[3 * DUMP_MAX + 8], what[64];
+	what[0] = 0;
+	if (p[0] == H4_CMD && n >= 4) {
+		snprintf(what, sizeof(what), " %#06x plen %u", le16(p + 1), p[3]);
+	} else if (p[0] == H4_EVT && n >= 3) {
+		const uint8_t *e = p + 3;
+		uint32_t pl = p[2];
+		if (p[1] == 0x0e && pl >= 4) {
+			snprintf(what, sizeof(what), " 0x0e plen %u (Command Complete op %#06x status %#x)", pl, le16(e + 1), e[3]);
+		} else if (p[1] == 0x0e && pl >= 3) {
+			snprintf(what, sizeof(what), " 0x0e plen %u (Command Complete op %#06x)", pl, le16(e + 1));
+		} else if (p[1] == 0x0f && pl >= 4) {
+			snprintf(what, sizeof(what), " 0x0f plen %u (Command Status op %#06x status %#x)", pl, le16(e + 2), e[0]);
+		} else if (p[1] == 0x10 && pl >= 1) {
+			snprintf(what, sizeof(what), " 0x10 plen %u (Hardware Error code %#x)", pl, e[0]);
+		} else if (p[1] == 0x3e && pl >= 1) {
+			snprintf(what, sizeof(what), " 0x3e plen %u (LE Meta sub %#x)", pl, e[0]);
+		} else {
+			snprintf(what, sizeof(what), " %#04x plen %u", p[1], pl);
+		}
+	} else if ((p[0] == H4_ACL || p[0] == H4_ISO) && n >= 5) {
+		snprintf(what, sizeof(what), " handle %#x len %u", le16(p + 1) & 0x0fffu, le16(p + 3));
+	} else if (p[0] == H4_SCO && n >= 4) {
+		snprintf(what, sizeof(what), " handle %#x len %u", le16(p + 1) & 0x0fffu, p[3]);
+	}
+	SAY("%s %s%s:%s\n", dir, type_name(p[0]), what, hexs(hx, sizeof(hx), p, n));
+}
+
+/* ---- RX queue (h4_lock held) ---- */
+
+static void
+q_put(const uint8_t *p, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		t.q[t.qh] = p[i];
+		t.qh = (t.qh + 1u) % RXQ_SIZE;
+	}
+	t.qn += n;
+}
+
+static uint32_t
+q_peek(uint8_t *p, uint32_t max)
+{
+	uint32_t n = MIN(max, t.qn), at = t.qt;
+	for (uint32_t i = 0; i < n; i++) {
+		p[i] = t.q[at];
+		at = (at + 1u) % RXQ_SIZE;
+	}
+	return n;
+}
+
+static void
+q_drop(uint32_t n)
+{
+	n = MIN(n, t.qn);
+	t.qt = (t.qt + n) % RXQ_SIZE;
+	t.qn -= n;
+}
+
+static void
+q_flush(void)
+{
+	t.qh = t.qt = t.qn = 0;
+	t.ctl_full = false;
+}
+
+/* wake the RX thread (fast poll, ctl delivery) */
+static void
+kick(void)
+{
+	lck_mtx_lock(&h4_lock);
+	t.kick = true;
+	lck_mtx_unlock(&h4_lock);
+	wakeup(&t.kick);
+}
+
+/* one whole packet toward the current client (any thread) */
+static void
+deliver(const uint8_t *p, uint32_t n, bool local)
+{
+	bool owner_dev = false, ok = false;
+
+	lck_mtx_lock(&h4_lock);
+	if (t.owner == OWNER_NONE) {
+		t.n_drop_noowner++;
+	} else if (RXQ_SIZE - t.qn < n) {
+		t.n_drop_full++;
+	} else {
+		q_put(p, n);
+		ok = true;
+		owner_dev = t.owner == OWNER_DEV;
+		if (local) {
+			t.n_local++;
+		}
+	}
+	t.kick = true;
+	lck_mtx_unlock(&h4_lock);
+	if (ok && owner_dev) {
+		selwakeup(&t.rsel);
+		wakeup(&t.q);
+	}
+	wakeup(&t.kick);
+}
+
+void
+negroni_bt_h4_inject(const uint8_t *pkt, uint32_t len)
+{
+	if (len == 0 || len > PKT_MAX) {
+		return;
+	}
+	if (t.log_rx > 0) {
+		log_pkt("rx(local)", pkt, len);
+	}
+	deliver(pkt, len, true);
+}
+
+/* ---- UART side ---- */
+
+static int
+uart_send(const uint8_t *p, uint32_t n)
+{
+	lck_mtx_lock(&h4_uart);
+	int error = negroni_bt_uart_write(p, n);
+	lck_mtx_unlock(&h4_uart);
+	return error;
+}
+
+/* TX side of in-band sleep: wake the controller first when it said SLEEP_IND (h4_tx held, not h4_lock) */
+static void
+ibs_wake(void)
+{
+	lck_mtx_lock(&h4_lock);
+	bool awake = t.ctrl_awake;
+	lck_mtx_unlock(&h4_lock);
+	if (awake) {
+		return;
+	}
+	for (uint32_t try = 0; try < 3; try++) {
+		uint8_t b = IBS_WAKE_IND;
+		lck_mtx_lock(&h4_lock);
+		t.ackd = false;
+		lck_mtx_unlock(&h4_lock);
+		(void)uart_send(&b, 1);
+		kick();
+		lck_mtx_lock(&h4_lock);
+		if (!t.ackd) {
+			struct timespec ts = { 0, 100 * 1000 * 1000 };  /* IBS_WAKE_RETRANS_TIMEOUT_MS, hci_qca.c:49 */
+			(void)msleep(&t.ackd, &h4_lock, PZERO, "nbtibs", &ts);
+		}
+		bool ok = t.ackd;
+		t.n_ibs_wake++;
+		lck_mtx_unlock(&h4_lock);
+		if (ok) {
+			return;
+		}
+	}
+	lck_mtx_lock(&h4_lock);
+	t.n_ibs_timeout++;
+	t.ctrl_awake = true;            /* send anyway; the next SLEEP_IND sets it again */
+	lck_mtx_unlock(&h4_lock);
+	SAY("IBS: no WAKE_ACK after 3 x 100 ms; the packet goes out anyway\n");
+}
+
+/*
+ * 0338: a command that the shim makes (legacy -> extended LE translation). from_rx = false: the TX path calls it with
+ * h4_tx held (IBS wake as for a host packet). from_rx = true: the RX thread sends the next command of a chain right
+ * after the controller's answer to the previous one. It does not take h4_tx (the TX path can wait in ibs_wake for
+ * a WAKE_ACK that only this thread reads) and does not wait for WAKE_ACK: the controller sent an event just now,
+ * so it is awake [I]. uart_send keeps each packet whole (h4_uart).
+ */
+int
+negroni_bt_h4_send_cmd(const uint8_t *p, uint32_t n, bool from_rx)
+{
+	if (n < 4 || n > PKT_MAX) {
+		return EINVAL;
+	}
+	if (t.log_tx > 0) {
+		t.log_tx--;
+		log_pkt(from_rx ? "tx(shim, rx thread)" : "tx(shim)", p, n);
+	}
+	t.n_tx++;
+	t.b_tx += n;
+	if (!from_rx) {
+		ibs_wake();
+	} else {
+		lck_mtx_lock(&h4_lock);
+		bool awake = t.ctrl_awake;
+		lck_mtx_unlock(&h4_lock);
+		if (!awake && n <= sizeof(t.shim_pkt)) {
+			/* review F5: the controller sleeps; the power worker sends it after ibs_wake (WAKE_ACK) with h4_tx */
+			lck_mtx_lock(&h4_lock);
+			memcpy(t.shim_pkt, p, n);
+			t.shim_len = n;
+			t.shim_pend = true;
+			t.n_shim_defer++;
+			lck_mtx_unlock(&h4_lock);
+			wakeup(&t.worker);
+			SAY("tx(shim): controller said SLEEP_IND; %#06x goes out from the power worker after WAKE_ACK (#%u)\n",
+			    le16(p + 1), t.n_shim_defer);
+			return 0;
+		}
+	}
+	int error = uart_send(p, n);
+	t.last_act = now_us();
+	kick();
+	if (error && t.n_tx_err++ < 16) {
+		SAY("tx(shim): UART write of %u bytes failed (%d)\n", n, error);
+	}
+	return error ? EIO : 0;
+}
+
+/* one complete packet from the controller (RX thread) */
+static void
+rx_packet(uint8_t *p, uint32_t n)
+{
+	t.n_rx++;
+	t.b_rx += n;
+	bool hw_err = p[0] == H4_EVT && n >= 3 && p[1] == 0x10;
+	if (t.log_rx > 0 || hw_err) {
+		if (t.log_rx > 0) {
+			t.log_rx--;
+		}
+		log_pkt("rx", p, n);
+	}
+	if (negroni_bt_shim_rx(p, n) == NEGRONI_BT_SHIM_DROP) {
+		t.n_drop_shim++;
+		return;
+	}
+	deliver(p, n, false);
+}
+
+static void
+rx_bytes(const uint8_t *b, uint32_t n)
+{
+	while (n > 0) {
+		uint32_t m = MIN(n, PKT_MAX - t.rxn);
+		memcpy(t.rx + t.rxn, b, m);
+		t.rxn += m;
+		b += m;
+		n -= m;
+		while (t.rxn > 0) {
+			uint8_t c = t.rx[0];
+			uint32_t need;
+			if (c == IBS_SLEEP_IND || c == IBS_WAKE_IND || c == IBS_WAKE_ACK) {
+				lck_mtx_lock(&h4_lock);
+				t.ibs_seen = true;
+				t.ctrl_awake = c != IBS_SLEEP_IND;
+				if (c == IBS_WAKE_ACK) {
+					t.ackd = true;
+				}
+				uint32_t k = t.n_ibs_rx++;
+				lck_mtx_unlock(&h4_lock);
+				if (c == IBS_WAKE_ACK) {
+					wakeup(&t.ackd);
+				}
+				if (c == IBS_WAKE_IND) {
+					uint8_t ack = IBS_WAKE_ACK;
+					(void)uart_send(&ack, 1);
+				}
+				if (k < 32) {
+					SAY("IBS %s from the controller%s\n", c == IBS_SLEEP_IND ? "SLEEP_IND" :
+					    c == IBS_WAKE_IND ? "WAKE_IND" : "WAKE_ACK", c == IBS_WAKE_IND ? " (WAKE_ACK sent)" : "");
+				}
+				memmove(t.rx, t.rx + 1, --t.rxn);
+				continue;
+			}
+			need = frame_len(t.rx, t.rxn, false);
+			if (need == UINT32_MAX || need > PKT_MAX) {
+				if (t.n_garbage_rx++ < 32) {
+					SAY("rx: byte %#x is no packet start (or the frame is too long), dropped\n", c);
+				}
+				memmove(t.rx, t.rx + 1, --t.rxn);
+				continue;
+			}
+			if (need == 0 || t.rxn < need) {
+				break;
+			}
+			rx_packet(t.rx, need);
+			t.rxn -= need;
+			memmove(t.rx, t.rx + need, t.rxn);
+		}
+	}
+}
+
+/* queued bytes -> the kernel control client (RX thread only; no lock held around ctl_*) */
+static void
+deliver_ctl(void)
+{
+	for (;;) {
+		lck_mtx_lock(&h4_lock);
+		if (t.owner != OWNER_CTL || t.qn == 0 || t.ctl_full) {
+			lck_mtx_unlock(&h4_lock);
+			return;
+		}
+		uint32_t unit = t.unit;
+		uint32_t n = q_peek(ctl_buf, CTL_CHUNK);
+		kern_ctl_ref ref = t.ref;
+		lck_mtx_unlock(&h4_lock);
+
+		size_t space = 0;
+		errno_t e = ctl_getenqueuespace(ref, unit, &space);
+		if (e == 0 && space == 0) {
+			e = ENOBUFS;
+		}
+		if (e == 0) {
+			n = (uint32_t)MIN((size_t)n, space);
+			e = ctl_enqueuedata(ref, unit, ctl_buf, n, 0);
+		}
+		lck_mtx_lock(&h4_lock);
+		if (e == 0) {
+			if (t.owner == OWNER_CTL && t.unit == unit) {
+				q_drop(n);
+			}
+			t.b_user += n;
+		} else if (e == ENOBUFS) {
+			t.ctl_full = true;      /* ctl_rcvd clears it */
+		}
+		lck_mtx_unlock(&h4_lock);
+		if (e) {
+			if (e != ENOBUFS) {
+				SAY("control unit %u: enqueue error %d\n", unit, e);
+			}
+			return;
+		}
+	}
+}
+
+static void
+stats(bool force)
+{
+	uint64_t now = now_us();
+	if (!force && now - t.last_stats < 60ull * 1000000u) {
+		return;
+	}
+	t.last_stats = now;
+	SAY("stats: tx %u pkts %llu B, rx %u pkts %llu B, to user %llu B, local answers %u, dropped (no client %u, "
+	    "queue full %u, shim %u), garbage rx %u tx %u, IBS rx %u wake %u timeouts %u, tx errors %u\n",
+	    t.n_tx, t.b_tx, t.n_rx, t.b_rx, t.b_user, t.n_local, t.n_drop_noowner, t.n_drop_full, t.n_drop_shim,
+	    t.n_garbage_rx, t.n_garbage_tx, t.n_ibs_rx, t.n_ibs_wake, t.n_ibs_timeout, t.n_tx_err);
+}
+
+static void
+h4_rx_thread(void *arg __unused, wait_result_t w __unused)
+{
+	uint8_t buf[RD_CHUNK];
+	uint32_t last_counts = 0;
+
+	SAY("RX thread running (poll 1/5/20 ms, queue %u KiB)\n", RXQ_SIZE >> 10);
+	for (;;) {
+		uint32_t n = 0;
+		lck_mtx_lock(&h4_lock);
+		bool room = RXQ_SIZE - t.qn >= RXQ_ROOM && !t.off && !t.powering && !t.failed;
+		bool reset = t.rx_reset;
+		t.rx_reset = false;
+		lck_mtx_unlock(&h4_lock);
+		if (reset) {
+			t.rxn = 0;       /* 0335: no partial frame across a chip off/on */
+		}
+		if (room) {
+			lck_mtx_lock(&h4_uart);
+			n = negroni_bt_uart_read(buf, sizeof(buf));
+			lck_mtx_unlock(&h4_uart);
+		}
+		if (n) {
+			t.last_act = now_us();
+			rx_bytes(buf, n);
+		}
+		deliver_ctl();
+		if (t.n_tx + t.n_rx != last_counts) {
+			last_counts = t.n_tx + t.n_rx;
+			stats(false);
+		}
+		if (n == sizeof(buf)) {
+			continue;               /* more bytes are waiting in the FIFO */
+		}
+		uint64_t idle = now_us() - t.last_act;
+		uint32_t ms = idle < 200000u ? 1u : idle < 5000000u ? 5u : 20u;
+		if (t.off && !t.powering) {
+			ms = 1000u;     /* 0382: chip off (BT_EN low): nothing to read; power-on kicks (kick()) */
+		}
+		lck_mtx_lock(&h4_lock);
+		if (!t.kick) {
+			struct timespec ts = { 0, (long)ms * 1000 * 1000 };
+			(void)msleep(&t.kick, &h4_lock, PZERO, "nbth4rx", &ts);
+		}
+		t.kick = false;
+		lck_mtx_unlock(&h4_lock);
+	}
+}
+
+/* ---- TX side (userland -> controller) ---- */
+
+static int
+wait_ready(void)
+{
+	uint64_t end = now_us() + (uint64_t)t.wait_ms * 1000u;
+	int error = 0;
+
+	lck_mtx_lock(&h4_lock);
+	while (!t.ready && !t.failed) {
+		if (now_us() >= end) {
+			error = ETIMEDOUT;
+			break;
+		}
+		struct timespec ts = { 1, 0 };
+		int r = msleep(&t.ready, &h4_lock, PZERO | PCATCH, "nbth4up", &ts);
+		if (r == EINTR || r == ERESTART) {
+			error = r;
+			break;
+		}
+	}
+	if (!error && !t.ready) {
+		error = EIO;
+	}
+	lck_mtx_unlock(&h4_lock);
+	return error;
+}
+
+/*
+ * 0335: commands whose controller answer is a Command Status event (Core spec Vol 4 Part E 7.x "Command Status
+ * event shall be generated"), so the dead-chip answer has the event type the host waits for.
+ */
+static bool
+uses_cmd_status(uint16_t op)
+{
+	static const uint16_t ops[] = {
+		/* 0337 review F2: 0x0408 (Create_Connection_Cancel) answers with Command Complete; 0x205e, 0x042a,
+		 * 0x0810, 0x2044, 0x2064, 0x2068, 0x206b, 0x206d added */
+		0x0401, 0x0405, 0x0406, 0x0409, 0x040a, 0x040f, 0x0411, 0x0413, 0x0415, 0x0417, 0x0419, 0x041b,
+		0x041c, 0x041d, 0x041f, 0x0428, 0x0429, 0x042a, 0x043d, 0x043e, 0x0801, 0x0803, 0x0804, 0x0807,
+		0x080b, 0x0810, 0x200d, 0x2013, 0x2016, 0x2019, 0x2025, 0x2026, 0x2032, 0x2043, 0x2044, 0x205e,
+		0x2064, 0x2068, 0x206b, 0x206d,
+	};
+	for (size_t i = 0; i < sizeof(ops) / sizeof(ops[0]); i++) {
+		if (ops[i] == op) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* one complete host packet (h4_tx held) */
+static int
+tx_packet(uint8_t *p, uint32_t n)
+{
+	t.n_tx++;
+	t.b_tx += n;
+	if (t.log_tx > 0) {
+		t.log_tx--;
+		log_pkt("tx", p, n);
+	}
+	if (t.failed) {
+		/* 0335: dead chip: a local Command Complete, status 0x03 Hardware Failure; other packets dropped */
+		if (p[0] == H4_CMD && n >= 4) {
+			bool cs = uses_cmd_status(le16(p + 1));
+			uint8_t cc[7] = { H4_EVT, 0x0e, 4, 1, p[1], p[2], 0x03 };
+			uint8_t st[7] = { H4_EVT, 0x0f, 4, 0x03, 1, p[1], p[2] };      /* Command Status: status, ncmd, op */
+			if (t.n_dead++ < 16) {
+				SAY("dead chip: cmd %#06x answered locally with %s status 0x03 (Hardware Failure)\n", le16(p + 1),
+				    cs ? "Command Status" : "Command Complete");
+			}
+			negroni_bt_h4_inject(cs ? st : cc, 7);
+		}
+		return 0;
+	}
+	if (negroni_bt_shim_tx(p, n) == NEGRONI_BT_SHIM_DONE) {
+		return 0;
+	}
+	ibs_wake();
+	int error = uart_send(p, n);
+	t.last_act = now_us();
+	kick();                         /* the answer comes soon: fast poll */
+	if (error) {
+		if (t.n_tx_err++ < 16) {
+			SAY("tx: UART write of %u bytes failed (%d)\n", n, error);
+		}
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+tx_bytes(const uint8_t *b, uint32_t n)
+{
+	int error = 0;
+	while (n > 0 && !error) {
+		uint32_t m = MIN(n, PKT_MAX - t.txn);
+		memcpy(t.tx + t.txn, b, m);
+		t.txn += m;
+		b += m;
+		n -= m;
+		while (t.txn > 0 && !error) {
+			uint32_t need = frame_len(t.tx, t.txn, true);
+			if (need == UINT32_MAX || need > PKT_MAX) {
+				if (t.n_garbage_tx++ < 32) {
+					SAY("tx: byte %#x is no host packet start (or the frame is too long), dropped\n", t.tx[0]);
+				}
+				memmove(t.tx, t.tx + 1, --t.txn);
+				continue;
+			}
+			if (need == 0 || t.txn < need) {
+				break;
+			}
+			error = tx_packet(t.tx, need);
+			t.txn -= need;
+			memmove(t.tx, t.tx + need, t.txn);
+		}
+	}
+	return error;
+}
+
+static int
+send_user(const uint8_t *b, uint32_t n)
+{
+	int error = wait_ready();
+	if (error == EIO && t.failed && t.dead_mode == 1) {
+		error = 0;                      /* 0335: tx_packet answers each command locally */
+	}
+	if (error) {
+		return error;
+	}
+	lck_mtx_lock(&h4_tx);
+	error = tx_bytes(b, n);
+	lck_mtx_unlock(&h4_tx);
+	return error;
+}
+
+/* ---- termios (socket option and ioctl) ---- */
+
+static void
+tio_default(void)
+{
+	bzero(&t.tio, sizeof(t.tio));
+	t.tio.c_cflag = CS8 | CREAD | CLOCAL | CRTSCTS;
+	t.tio.c_ispeed = t.tio.c_ospeed = negroni_bt_uart_baud() ? negroni_bt_uart_baud() : 3000000u;
+}
+
+static void
+tio_set(const struct termios *n, const char *via)
+{
+	uint32_t line = negroni_bt_uart_baud();
+	SAY("%s: termios speed %lu, c_cflag %#lx (%s flow control), c_iflag %#lx; the line stays at %u baud, RTS/CTS on\n",
+	    via, (unsigned long)n->c_ospeed, (unsigned long)n->c_cflag,
+	    (n->c_cflag & CRTSCTS) == CRTSCTS ? "RTS/CTS" : "no", (unsigned long)n->c_iflag, line);
+	if (n->c_ospeed && n->c_ospeed != line) {
+		SAY("%s: speed %lu asked, %u kept (the controller was set to %u in stage A)\n", via,
+		    (unsigned long)n->c_ospeed, line, line);
+	}
+	t.tio = *n;
+}
+
+/* ---- session (one client) ---- */
+
+static void
+session_reset(void)         /* h4_lock held */
+{
+	q_flush();
+	t.log_tx = t.log_rx = negroni_bt_arg("h4log", 300);
+	tio_default();
+}
+
+/* ---- 0335: power follows the client ---- */
+
+/* a client came or went (h4_lock held); the worker decides */
+static void
+power_client_changed(bool came)
+{
+	if (!came) {
+		t.gone_at = now_us();
+	} else if (t.off && t.failed) {
+		t.failed = false;       /* a runtime power-on failed before: this connect tries once more */
+	}
+	t.kick = true;
+	wakeup(&t.worker);
+}
+
+static void
+h4_power_thread(void *arg __unused, wait_result_t w __unused)
+{
+	SAY("power worker running (off %u ms after the last client, power follows the client %s)\n", t.off_ms,
+	    t.pwr_follow ? "on" : "off");
+	for (;;) {
+		lck_mtx_lock(&h4_lock);
+		bool client = t.owner != OWNER_NONE;
+		bool want_on = client && t.off && !t.failed && !t.powering;
+		bool want_off = !client && t.ready && t.pwr_follow && now_us() - t.gone_at >= (uint64_t)t.off_ms * 1000u;
+		bool pending = !client && t.ready && t.pwr_follow;
+		if (want_on || want_off) {
+			t.powering = true;
+			t.ready = false;        /* sends wait (power on) or find no client (power off) */
+		}
+		lck_mtx_unlock(&h4_lock);
+
+		if (want_off) {
+			lck_mtx_lock(&h4_tx);
+			lck_mtx_lock(&h4_uart);
+			negroni_bt_chip_off();
+			lck_mtx_unlock(&h4_uart);
+			lck_mtx_unlock(&h4_tx);
+			lck_mtx_lock(&h4_lock);
+			t.off = true;
+			t.powering = false;
+			t.rx_reset = true;
+			t.shim_pend = false;            /* 0338: no deferred shim command across a chip off */
+			t.n_off++;
+			q_flush();
+			lck_mtx_unlock(&h4_lock);
+			SAY("power off #%u: no client for %u ms; the next client powers the chip on\n", t.n_off, t.off_ms);
+			continue;
+		}
+		if (want_on) {
+			SAY("power on #%u: a client is back\n", t.n_on + 1u);
+			lck_mtx_lock(&h4_uart);
+			int e = negroni_bt_chip_on();
+			lck_mtx_unlock(&h4_uart);
+			lck_mtx_lock(&h4_lock);
+			t.powering = false;
+			t.n_on++;
+			t.rx_reset = true;
+			if (e == 0) {
+				t.off = false;
+				t.failed = false;
+				t.ready = true;
+				t.ctrl_awake = true;
+				q_flush();      /* nothing from the power-on reaches the client */
+			} else {
+				t.n_on_fail++;
+				t.failed = true;        /* t.off stays: the next connect retries once (power_client_changed) */
+				snprintf(t.why, sizeof(t.why), "power on failed (%d)", e);
+			}
+			t.last_act = now_us();
+			lck_mtx_unlock(&h4_lock);
+			wakeup(&t.ready);
+			kick();
+			SAY("power on #%u: %s\n", t.n_on, e ? "FAILED: dead-chip answers from now on" : "transport ready again");
+			continue;
+		}
+		lck_mtx_lock(&h4_lock);
+		bool sp = t.shim_pend && t.ready;
+		uint8_t pkt[sizeof(t.shim_pkt)];
+		uint32_t pn = t.shim_len;
+		if (sp) {
+			memcpy(pkt, t.shim_pkt, pn);
+			t.shim_pend = false;
+		}
+		lck_mtx_unlock(&h4_lock);
+		if (sp) {
+			/* 0338: a deferred shim command: wake the controller (IBS) as the TX path does, then send */
+			lck_mtx_lock(&h4_tx);
+			int e = negroni_bt_h4_send_cmd(pkt, pn, false);
+			lck_mtx_unlock(&h4_tx);
+			SAY("tx(shim): deferred %#06x sent by the power worker (error %d)\n", le16(pkt + 1), e);
+			continue;
+		}
+		lck_mtx_lock(&h4_lock);
+		struct timespec ts = { 0, 200 * 1000 * 1000 };
+		if (!(t.shim_pend && t.ready)) {
+			(void)msleep(&t.worker, &h4_lock, PZERO, "nbth4pw", pending ? &ts : NULL);
+		}
+		lck_mtx_unlock(&h4_lock);
+	}
+}
+
+/* ---- kernel control ---- */
+
+static errno_t
+ctl_connect_cb(kern_ctl_ref ref __unused, struct sockaddr_ctl *sac, void **unitinfo)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	lck_mtx_lock(&h4_lock);
+	if (t.owner != OWNER_NONE) {
+		uint32_t o = t.owner;
+		lck_mtx_unlock(&h4_lock);
+		SAY("control connect from %s[%d] refused: busy (%s client)\n", name, proc_selfpid(),
+		    o == OWNER_CTL ? "control" : "/dev");
+		return EBUSY;
+	}
+	if (t.failed && t.dead_mode == 2) {
+		lck_mtx_unlock(&h4_lock);
+		SAY("control connect from %s[%d] refused: chip FAILED (negronibt_dead=2)\n", name, proc_selfpid());
+		return ECONNREFUSED;
+	}
+	t.owner = OWNER_CTL;
+	t.unit = sac->sc_unit;
+	session_reset();
+	power_client_changed(true);
+	bool ready = t.ready, failed = t.failed, off = t.off;
+	lck_mtx_unlock(&h4_lock);
+	lck_mtx_lock(&h4_tx);
+	t.txn = 0;
+	lck_mtx_unlock(&h4_tx);
+	negroni_bt_shim_session();
+	*unitinfo = NULL;
+	SAY("control %s connected (unit %u) by %s[%d]; chip %s\n", H4_CTL_NAME, sac->sc_unit, name, proc_selfpid(),
+	    ready ? "ready" : failed ? (t.dead_mode == 1 ? "FAILED (commands answered with status 0x03)" : "FAILED") :
+	    off ? "off: powering on" : "not ready yet");
+	return 0;
+}
+
+static errno_t
+ctl_disconnect_cb(kern_ctl_ref ref __unused, u_int32_t unit, void *unitinfo __unused)
+{
+	lck_mtx_lock(&h4_lock);
+	bool mine = t.owner == OWNER_CTL && t.unit == unit;
+	if (mine) {
+		t.owner = OWNER_NONE;
+		q_flush();
+		power_client_changed(false);
+	}
+	lck_mtx_unlock(&h4_lock);
+	if (mine) {
+		SAY("control unit %u disconnected%s\n", unit, t.ready && t.pwr_follow ? "; power off follows if no client comes back" : "");
+		stats(true);
+	}
+	return 0;
+}
+
+static errno_t
+ctl_send_cb(kern_ctl_ref ref __unused, u_int32_t unit, void *unitinfo __unused, mbuf_t m, int flags __unused)
+{
+	errno_t error = 0;
+
+	lck_mtx_lock(&h4_lock);
+	bool mine = t.owner == OWNER_CTL && t.unit == unit;
+	lck_mtx_unlock(&h4_lock);
+	if (!mine) {
+		mbuf_freem(m);
+		return ENOTCONN;
+	}
+	for (mbuf_t n = m; n != NULL && !error; n = mbuf_next(n)) {
+		if (mbuf_len(n) > 0) {
+			error = send_user((const uint8_t *)mbuf_data(n), (uint32_t)mbuf_len(n));
+		}
+	}
+	mbuf_freem(m);
+	return error;
+}
+
+static errno_t
+ctl_setopt_cb(kern_ctl_ref ref __unused, u_int32_t unit __unused, void *unitinfo __unused, int opt, void *data,
+    size_t len)
+{
+	if ((unsigned)opt == (unsigned)TIOCSETA || (unsigned)opt == (unsigned)TIOCSETAW ||
+	    (unsigned)opt == (unsigned)TIOCSETAF) {
+		if (data == NULL || len < sizeof(struct termios)) {
+			return EINVAL;
+		}
+		tio_set((const struct termios *)data, "setsockopt");
+		return 0;
+	}
+	SAY("setsockopt %#x (%zu bytes) ignored\n", (unsigned)opt, len);
+	return 0;
+}
+
+static errno_t
+ctl_getopt_cb(kern_ctl_ref ref __unused, u_int32_t unit __unused, void *unitinfo __unused, int opt, void *data,
+    size_t *len)
+{
+	if ((unsigned)opt == (unsigned)TIOCGETA) {
+		if (data == NULL) {
+			*len = sizeof(struct termios);
+			return 0;
+		}
+		if (*len < sizeof(struct termios)) {
+			return EINVAL;
+		}
+		memcpy(data, &t.tio, sizeof(struct termios));
+		*len = sizeof(struct termios);
+		return 0;
+	}
+	SAY("getsockopt %#x (%zu bytes): not supported\n", (unsigned)opt, *len);
+	return ENOTSUP;
+}
+
+static void
+ctl_rcvd_cb(kern_ctl_ref ref __unused, u_int32_t unit, void *unitinfo __unused, int flags __unused)
+{
+	lck_mtx_lock(&h4_lock);
+	if (t.owner == OWNER_CTL && t.unit == unit) {
+		t.ctl_full = false;
+		t.kick = true;
+	}
+	lck_mtx_unlock(&h4_lock);
+	wakeup(&t.kick);
+}
+
+/* ---- /dev/uart.bluetooth, /dev/cu.bluetooth, /dev/btwake ---- */
+
+static int
+h4_open(dev_t dev, int flags __unused, int devtype __unused, struct proc *p __unused)
+{
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	if (minor(dev) == MINOR_WAKE) {
+		if (t.n_wake_open++ < 8) {
+			SAY("/dev/btwake opened by %s[%d] (BT_WAKE: nothing to do, BT_EN is the kernel's)\n", name,
+			    proc_selfpid());
+		}
+		return 0;
+	}
+	if (minor(dev) > MINOR_CU) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&h4_lock);
+	if (t.owner != OWNER_NONE) {
+		lck_mtx_unlock(&h4_lock);
+		SAY("/dev open by %s[%d] refused: busy\n", name, proc_selfpid());
+		return EBUSY;
+	}
+	if (t.failed && t.dead_mode == 2) {
+		lck_mtx_unlock(&h4_lock);
+		SAY("/dev open by %s[%d] refused: chip FAILED (negronibt_dead=2)\n", name, proc_selfpid());
+		return ENXIO;
+	}
+	t.owner = OWNER_DEV;
+	session_reset();
+	power_client_changed(true);
+	lck_mtx_unlock(&h4_lock);
+	lck_mtx_lock(&h4_tx);
+	t.txn = 0;
+	lck_mtx_unlock(&h4_tx);
+	negroni_bt_shim_session();
+	SAY("/dev/%s opened by %s[%d]\n", minor(dev) == MINOR_UART ? "uart.bluetooth" : "cu.bluetooth", name,
+	    proc_selfpid());
+	return 0;
+}
+
+static int
+h4_close(dev_t dev, int flags __unused, int devtype __unused, struct proc *p __unused)
+{
+	if (minor(dev) == MINOR_WAKE) {
+		return 0;
+	}
+	lck_mtx_lock(&h4_lock);
+	bool mine = t.owner == OWNER_DEV;
+	if (mine) {
+		t.owner = OWNER_NONE;
+		q_flush();
+		power_client_changed(false);
+	}
+	lck_mtx_unlock(&h4_lock);
+	wakeup(&t.q);                   /* a reader blocked in h4_read sees the closed client (EIO) */
+	selwakeup(&t.rsel);
+	if (mine) {
+		SAY("/dev client closed\n");
+		stats(true);
+	}
+	return 0;
+}
+
+static int
+h4_read(dev_t dev, struct uio *uio, int ioflag)
+{
+	uint8_t b[1024];
+	int error = 0;
+
+	if (minor(dev) > MINOR_CU) {
+		return ENODEV;
+	}
+	lck_mtx_lock(&h4_lock);
+	while (t.qn == 0) {
+		if (t.owner != OWNER_DEV) {
+			error = EIO;
+			break;
+		}
+		if (ioflag & IO_NDELAY) {
+			error = EWOULDBLOCK;
+			break;
+		}
+		error = msleep(&t.q, &h4_lock, PZERO | PCATCH, "nbth4rd", NULL);
+		if (error) {
+			break;
+		}
+	}
+	uint32_t n = 0;
+	if (!error) {
+		n = q_peek(b, (uint32_t)MIN((user_ssize_t)sizeof(b), uio_resid(uio)));
+		q_drop(n);
+		t.b_user += n;
+		t.kick = true;
+	}
+	lck_mtx_unlock(&h4_lock);
+	wakeup(&t.kick);
+	if (!error && n) {
+		error = uiomove((const char *)b, (int)n, uio);
+	}
+	return error;
+}
+
+static int
+h4_write(dev_t dev, struct uio *uio, int ioflag __unused)
+{
+	uint8_t b[1024];
+	int error = 0;
+
+	if (minor(dev) > MINOR_CU) {
+		return ENODEV;
+	}
+	while (uio_resid(uio) > 0 && !error) {
+		int n = (int)MIN((user_ssize_t)sizeof(b), uio_resid(uio));
+		error = uiomove((char *)b, n, uio);
+		if (!error) {
+			error = send_user(b, (uint32_t)n);
+		}
+	}
+	return error;
+}
+
+static int
+h4_ioctl(dev_t dev, u_long cmd, caddr_t data, int flag __unused, struct proc *p __unused)
+{
+	if (minor(dev) > MINOR_CU) {
+		return ENOTTY;
+	}
+	switch (cmd) {
+	case TIOCGETA:
+		memcpy(data, &t.tio, sizeof(struct termios));
+		return 0;
+	case TIOCSETA:
+	case TIOCSETAW:
+	case TIOCSETAF:
+		tio_set((const struct termios *)data, "ioctl");
+		return 0;
+	case FIONREAD:
+		lck_mtx_lock(&h4_lock);
+		*(int *)data = (int)t.qn;
+		lck_mtx_unlock(&h4_lock);
+		return 0;
+	case FIONBIO:
+	case FIOASYNC:
+	case TIOCEXCL:
+	case TIOCNXCL:
+		return 0;
+	case TIOCFLUSH:
+		if (*(int *)data == 0 || (*(int *)data & FREAD)) {
+			lck_mtx_lock(&h4_lock);
+			q_flush();
+			lck_mtx_unlock(&h4_lock);
+		}
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+h4_select(dev_t dev, int which, void *wql, struct proc *p)
+{
+	int ready = 0;
+	if (minor(dev) > MINOR_CU) {
+		return 0;
+	}
+	lck_mtx_lock(&h4_lock);
+	if (which == FREAD) {
+		ready = t.qn > 0 || t.owner != OWNER_DEV;
+		if (!ready) {
+			selrecord(p, &t.rsel, wql);
+		}
+	} else if (which == FWRITE) {
+		ready = 1;
+	}
+	lck_mtx_unlock(&h4_lock);
+	return ready;
+}
+
+static const struct cdevsw h4_cdevsw = {
+	.d_open = h4_open,
+	.d_close = h4_close,
+	.d_read = h4_read,
+	.d_write = h4_write,
+	.d_ioctl = h4_ioctl,
+	.d_stop = eno_stop,
+	.d_reset = eno_reset,
+	.d_ttys = NULL,
+	.d_select = h4_select,
+	.d_mmap = eno_mmap,
+	.d_strategy = eno_strat,
+	.d_type = 0,
+};
+
+/* ---- stage hooks (negroni_bt.c) ---- */
+
+void
+negroni_bt_h4_attach(void)
+{
+	struct kern_ctl_reg reg;
+	errno_t e;
+
+	if (t.attached) {
+		return;
+	}
+	t.attached = true;
+	t.wait_ms = MIN(negroni_bt_arg("wait_ms", 30000), 120000u);
+	t.dead_mode = MIN(negroni_bt_arg("dead", 1), 2u);
+	t.pwr_follow = negroni_bt_arg("pwrfollow", 1) != 0;
+	t.off_ms = MIN(MAX(negroni_bt_arg("off_ms", 3000), 100u), 600000u);
+	t.ctrl_awake = true;
+	lck_mtx_lock(&h4_lock);
+	session_reset();
+	lck_mtx_unlock(&h4_lock);
+	negroni_bt_shim_init();
+
+	bzero(&reg, sizeof(reg));
+	strlcpy(reg.ctl_name, H4_CTL_NAME, sizeof(reg.ctl_name));
+	reg.ctl_flags = CTL_FLAG_REG_SOCK_STREAM | CTL_FLAG_REG_EXTENDED;       /* not CTL_FLAG_PRIVILEGED */
+	reg.ctl_sendsize = 64u << 10;
+	reg.ctl_recvsize = 128u << 10;
+	reg.ctl_connect = ctl_connect_cb;
+	reg.ctl_disconnect = ctl_disconnect_cb;
+	reg.ctl_send = ctl_send_cb;
+	reg.ctl_setopt = ctl_setopt_cb;
+	reg.ctl_getopt = ctl_getopt_cb;
+	reg.ctl_rcvd = ctl_rcvd_cb;
+	e = ctl_register(&reg, &t.ref);
+	SAY("kernel control %s: %s (error %d)\n", H4_CTL_NAME, e ? "NOT registered" : "registered", e);
+
+	t.major = cdevsw_add(-1, &h4_cdevsw);
+	if (t.major < 0) {
+		SAY("cdevsw_add failed: no /dev nodes\n");
+		return;
+	}
+	void *a = devfs_make_node(makedev(t.major, MINOR_UART), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "uart.bluetooth");
+	void *b = devfs_make_node(makedev(t.major, MINOR_CU), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "cu.bluetooth");
+	void *c = devfs_make_node(makedev(t.major, MINOR_WAKE), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "btwake");
+	SAY("/dev/uart.bluetooth %s, /dev/cu.bluetooth %s, /dev/btwake %s (major %d); sends wait up to %u ms for the chip\n",
+	    a ? "ok" : "FAILED", b ? "ok" : "FAILED", c ? "ok" : "FAILED", t.major, t.wait_ms);
+}
+
+/* the RX thread also delivers local answers to the kernel control client (deliver_ctl), so a dead chip needs it too */
+static bool
+rx_thread_start(void)
+{
+	thread_t thread;
+
+	if (t.rx_running) {
+		return true;
+	}
+	if (kernel_thread_start(h4_rx_thread, NULL, &thread) != KERN_SUCCESS) {
+		return false;
+	}
+	t.rx_running = true;
+	thread_deallocate(thread);
+	return true;
+}
+
+void
+negroni_bt_h4_start(void)
+{
+	thread_t thread;
+
+	if (!t.attached) {
+		negroni_bt_h4_attach();
+	}
+	lck_mtx_lock(&h4_lock);
+	tio_default();
+	lck_mtx_unlock(&h4_lock);
+	t.last_act = now_us();
+	if (!rx_thread_start()) {
+		negroni_bt_h4_fail("no RX thread");
+		return;
+	}
+	lck_mtx_lock(&h4_lock);
+	t.ready = true;
+	lck_mtx_unlock(&h4_lock);
+	wakeup(&t.ready);
+	SAY("transport ready at %u baud: the UART belongs to the transport now\n", negroni_bt_uart_baud());
+	if (!t.worker && kernel_thread_start(h4_power_thread, NULL, &thread) == KERN_SUCCESS) {
+		t.worker = true;
+		thread_deallocate(thread);
+	}
+	lck_mtx_lock(&h4_lock);
+	if (t.owner == OWNER_NONE) {
+		t.gone_at = now_us();   /* no client yet: the off timer starts now */
+	}
+	lck_mtx_unlock(&h4_lock);
+}
+
+void
+negroni_bt_h4_fail(const char *why)
+{
+	lck_mtx_lock(&h4_lock);
+	t.failed = true;
+	strlcpy(t.why, why, sizeof(t.why));
+	lck_mtx_unlock(&h4_lock);
+	wakeup(&t.ready);
+	if (t.attached && t.dead_mode == 1 && !rx_thread_start()) {
+		SAY("transport not usable: no RX thread for the local answers\n");
+	}
+	SAY("transport not usable: %s (%s)\n", why, t.dead_mode == 1 ? "commands get a local status 0x03 answer" :
+	    t.dead_mode == 2 ? "clients are refused" : "sends fail with EIO");
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_bt_hci.c b/bsd/dev/negroni_bt_hci.c
new file mode 100644
index 0000000..918af32
--- /dev/null
+++ b/bsd/dev/negroni_bt_hci.c
@@ -0,0 +1,925 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450): QCA6490 Bluetooth, stage A part 2 (patch 0331): the HCI stage over H4 on
+ * the GENI UART of patch 0330 (negroni_bt.c). Runs on the BT thread after step 8 when negronibt >= 2.
+ *
+ * The QCA6490 BT core is the "HSP" family (rampatch hpbtfwNN.tlv, NVM hpnvNN.bXX or hpnvNN.bin), which Linux drives as
+ * QCA_WCN6855 (soc_type >= QCA_WCN3991: EDL answers come in Command Complete events). Sequence and frame formats
+ * from Linux drivers/bluetooth/btqca.c and hci_qca.c (read for the protocol; this file is our own code):
+ *   negronibt=2   step 9  HCI_RESET (0x0c03) at 115200, wait for Command Complete
+ *                 step 10 EDL_PATCH_VER_REQ (0xfc00, sub 0x19): product / SoC / ROM / patch version (qca_read_soc_version)
+ *                 step 11 baud change (0xfc48 + QCA baud code; RFR not ready while the command goes out; 10 ms; host
+ *                         UART reprogrammed; RFR follows the FIFO again; qca_set_speed / qca_set_baudrate), then
+ *                         the version request again at the new rate (proof the link works there)
+ *   negronibt=3   + step 12 firmware pack from the WLAN firmware area ("negroni-bt.bin", scripts/bt/mkbtarea.sh)
+ *                 step 13 rampatch hpbtfwNN.tlv in 243-byte EDL_PATCH_TLV_REQ segments (0xfc00, sub 0x1e)
+ *                 step 14 board id (0xfc00, sub 0x23) -> NVM name (qca_get_nvm_name_by_board)
+ *                 step 15 NVM (TLV type 2; tag 17 baud byte = the current rate), every segment acked
+ *                 step 16 SoC logging off (0xfc17), step 17 HCI_RESET, step 18 firmware build label (0xfc00, sub 0x20)
+ *                 step 19 HCI_Read_BD_ADDR (0x1009), compared with the NVM tag 2 default (qca_check_bdaddr)
+ *   negronibt=4   + step 20 (patch 0332) the BD address from the ADT (/arm-io/bluetooth local-mac-address, the
+ *                 address bluetoothd reads) with EDL_WRITE_BD_ADDR (0xfc14, qca_set_bdaddr btqca.c:1005: the
+ *                 address goes out in display order), then HCI_Read_BD_ADDR again; then negroni_bt.c hands the
+ *                 UART to the iOS transport (negroni_bt_h4.c)
+ * Boot-args: negronibt_to=MS (every wait, default 2000, max 30000), negronibt_baud=B (default 3000000; 115200 =
+ *   no change), negronibt_ibs=1 (NVM: set the in-band sleep bit, tag 17 byte 0 bit 7, and the deep sleep bit,
+ *   tag 27 byte 0 bit 0, as Linux does; default: the file's bits stay; the host has no IBS state machine).
+ * Log: "NEGRONI BT: step N NAME", one line per HCI event ("evt ...", first 16 bytes), "stop: ..." on failure.
+ * A non-zero return makes negroni_bt.c drive BT_EN low (0330 failure path). Every wait is bounded; every RX
+ * length is checked before it is used.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include <libkern/crypto/sha2.h>
+#include <pexpert/device_tree.h>
+#include "negroni_bt.h"
+
+extern int negroni_ufs_wlan_area_read(uint64_t at, void *dst, uint32_t count);
+
+#define SAY(...)        printf("NEGRONI BT: " __VA_ARGS__)
+#define STEP(n, name)   printf("NEGRONI BT: step %u %s\n", (unsigned)(n), name)
+
+/* H4 packet indicators (Bluetooth Core, Vol 4 Part A) and the QCA in-band sleep bytes (hci_qca.c:44-46) */
+#define H4_CMD          0x01u
+#define H4_ACL          0x02u
+#define H4_SCO          0x03u
+#define H4_EVT          0x04u
+#define IBS_SLEEP_IND   0xfeu
+#define IBS_WAKE_IND    0xfdu
+#define IBS_WAKE_ACK    0xfcu
+
+#define EV_CMD_COMPLETE 0x0eu
+#define EV_CMD_STATUS   0x0fu
+#define EV_HW_ERROR     0x10u
+#define EV_VENDOR       0xffu
+
+#define OP_RESET        0x0c03u
+#define OP_READ_BD_ADDR 0x1009u
+#define OP_EDL          0xfc00u         /* EDL_PATCH_CMD_OPCODE, btqca.h:8 */
+#define OP_SET_BAUD     0xfc48u         /* hci_qca.c:1347 */
+#define OP_LOGGING      0xfc17u         /* QCA_DISABLE_LOGGING, btqca.h:20 */
+#define OP_WRITE_BDADDR 0xfc14u         /* EDL_WRITE_BD_ADDR_OPCODE, btqca.h; qca_set_bdaddr btqca.c:1005 (patch 0332) */
+#define EDL_VER_REQ     0x19u
+#define EDL_TLV_REQ     0x1eu
+#define EDL_BUILD_INFO  0x20u
+#define EDL_BID_REQ     0x23u
+#define EDL_APP_VER_RES 0x02u           /* VSE form of the version answer (older SoCs) */
+#define EDL_TLV_RES     0x04u           /* VSE form of the TLV ack */
+#define TLV_SEG         243u            /* MAX_SIZE_PER_TLV_SEGMENT, btqca.h:18 */
+#define TAG_BD_ADDR     2u
+#define TAG_HCI         17u
+#define TAG_DEEP_SLEEP  27u
+
+#define RX_BUF          1100u           /* largest H4 frame accepted: ACL 5 + 1021 */
+#define DUMP_MAX        16u
+
+/* WLAN firmware area header (scripts/wifi/mkwlanarea.py, negroni_wlan.c) and the BT pack inside it */
+#define AREA_HDR        0x8000u
+#define AREA_MAX        256u
+#define PACK_NAME       "negroni-bt.bin"
+#define PACK_HDR        0x4000u
+#define PACK_MAX        160u
+#define FW_CAP          (512u << 10)    /* hpbtfw20.tlv is 201560 B */
+
+struct fw_entry {
+	char name[48];
+	uint32_t offset;
+	uint32_t size;
+	uint8_t sha256[32];
+} __attribute__((packed));
+struct area_header {
+	char magic[8];
+	uint32_t version;
+	uint32_t count;
+	struct fw_entry e[AREA_MAX];
+} __attribute__((packed));
+struct pack_header {
+	char magic[8];                  /* "NEGRBTFW" */
+	uint32_t version;               /* 1 */
+	uint32_t count;
+	struct fw_entry e[PACK_MAX];
+} __attribute__((packed));
+_Static_assert(sizeof(struct fw_entry) == 88, "entry is 88 bytes (mkwlanarea.py, mkbtpack.py)");
+_Static_assert(sizeof(struct area_header) <= AREA_HDR, "area header larger than 32 KiB");
+_Static_assert(sizeof(struct pack_header) <= PACK_HDR, "pack header larger than 16 KiB");
+
+struct qca_ver {
+	uint32_t product, soc;
+	uint16_t patch, rom;
+};
+
+static struct {
+	uint32_t to_ms, ibs, quiet, garbage;
+	uint8_t rx[RX_BUF];
+	uint32_t rxn;
+	uint8_t type;                   /* H4 type of the last packet */
+	uint8_t pkt[RX_BUF];            /* last packet without the type byte */
+	uint32_t pktn;
+	struct qca_ver ver;
+	uint8_t rom;                    /* firmware file ROM number, e.g. 0x21 */
+	bool gf;
+	uint8_t nvm_bdaddr[6];
+	bool nvm_bdaddr_set;
+	struct pack_header *pack;
+	uint64_t pack_at;               /* byte offset of the pack inside the WLAN area */
+	uint32_t pack_size;
+	uint8_t *fw;
+} h;
+
+static inline uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static inline uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* " xx xx ..." of the first DUMP_MAX bytes, " ..." when longer */
+static const char *
+hex(const uint8_t *b, uint32_t n)
+{
+	static char s[3 * DUMP_MAX + 8];
+	uint32_t i, m = MIN(n, DUMP_MAX);
+	s[0] = 0;
+	for (i = 0; i < m; i++) {
+		snprintf(s + 3 * i, 4, " %02x", b[i]);
+	}
+	if (n > m) {
+		strlcpy(s + 3 * m, " ...", 5);
+	}
+	return s;
+}
+
+static void
+consume(uint32_t n)
+{
+	if (n >= h.rxn) {
+		h.rxn = 0;
+		return;
+	}
+	memmove(h.rx, h.rx + n, h.rxn - n);
+	h.rxn -= n;
+}
+
+/* Next H4 packet from the UART into h.type / h.pkt, or ETIMEDOUT at `deadline` (us). */
+static int
+h4_next(uint64_t deadline)
+{
+	for (;;) {
+		while (h.rxn > 0) {
+			uint8_t t = h.rx[0];
+			uint32_t need;
+
+			if (t == IBS_WAKE_IND || t == IBS_SLEEP_IND || t == IBS_WAKE_ACK) {
+				SAY("IBS byte %#x from the controller%s\n", t, t == IBS_WAKE_IND ? " (WAKE_ACK sent)" : "");
+				if (t == IBS_WAKE_IND) {
+					uint8_t ack = IBS_WAKE_ACK;
+					(void)negroni_bt_uart_write(&ack, 1);
+				}
+				consume(1);
+				continue;
+			}
+			if (t == H4_EVT) {
+				if (h.rxn < 3) {
+					break;
+				}
+				need = 3u + h.rx[2];
+			} else if (t == H4_ACL) {
+				if (h.rxn < 5) {
+					break;
+				}
+				need = 5u + le16(h.rx + 3);
+			} else if (t == H4_SCO) {
+				if (h.rxn < 4) {
+					break;
+				}
+				need = 4u + h.rx[3];
+			} else {
+				if (h.garbage++ < 16) {
+					SAY("H4: byte %#x is no packet type, dropped\n", t);
+				}
+				consume(1);
+				continue;
+			}
+			if (need > RX_BUF) {
+				SAY("H4: type %#x length %u larger than %u, byte dropped\n", t, need, RX_BUF);
+				consume(1);
+				continue;
+			}
+			if (h.rxn < need) {
+				break;
+			}
+			h.type = t;
+			h.pktn = need - 1u;
+			memcpy(h.pkt, h.rx + 1, h.pktn);
+			consume(need);
+			return 0;
+		}
+		uint32_t got = negroni_bt_uart_read(h.rx + h.rxn, RX_BUF - h.rxn);
+		h.rxn += got;
+		if (negroni_bt_us() > deadline) {     /* every pass: a stream with no gap must not extend the wait */
+			return ETIMEDOUT;
+		}
+		if (got == 0) {
+			delay(20);
+		}
+	}
+}
+
+/* One log line per HCI event: code, length, decoded CC/CS fields, first 16 bytes of the event */
+static void
+log_event(void)
+{
+	const uint8_t *p = h.pkt + 2;
+	uint32_t plen = h.pkt[1];
+	char what[64];
+
+	what[0] = 0;
+	if (h.pkt[0] == EV_CMD_COMPLETE && plen >= 3) {
+		if (plen >= 4) {
+			snprintf(what, sizeof(what), " (Command Complete op %#06x status %#x)", le16(p + 1), p[3]);
+		} else {
+			snprintf(what, sizeof(what), " (Command Complete op %#06x)", le16(p + 1));
+		}
+	} else if (h.pkt[0] == EV_CMD_STATUS && plen >= 4) {
+		snprintf(what, sizeof(what), " (Command Status op %#06x status %#x)", le16(p + 2), p[0]);
+	} else if (h.pkt[0] == EV_HW_ERROR && plen >= 1) {
+		snprintf(what, sizeof(what), " (Hardware Error code %#x)", p[0]);
+	} else if (h.pkt[0] == EV_VENDOR) {
+		snprintf(what, sizeof(what), " (vendor event)");
+	}
+	SAY("evt %#04x plen %u%s:%s\n", h.pkt[0], plen, what, hex(h.pkt, h.pktn));
+}
+
+static int
+hci_cmd(uint16_t op, const uint8_t *par, uint8_t len, bool log)
+{
+	uint8_t b[4 + 255];
+	b[0] = H4_CMD;
+	b[1] = (uint8_t)op;
+	b[2] = (uint8_t)(op >> 8);
+	b[3] = len;
+	if (len) {
+		memcpy(b + 4, par, len);
+	}
+	if (log) {
+		SAY("cmd %#06x plen %u:%s\n", op, len, hex(b, 4u + len));
+	}
+	int error = negroni_bt_uart_write(b, 4u + len);
+	if (error) {
+		SAY("cmd %#06x: UART write error %d\n", op, error);
+	}
+	return error;
+}
+
+#define R_CC    1
+#define R_VSE   2
+
+/*
+ * Wait for the answer to `op`: its Command Complete (return parameters in *ret / *rlen) or a vendor event
+ * [00 vse ...] (vse = the EDL response type; VSE_ANY: any vendor event; VSE_NONE: none). Command Status with an
+ * error ends the wait (EIO). Other packets are logged and skipped. Returns R_CC, R_VSE or -errno.
+ */
+#define VSE_NONE        (-1)
+#define VSE_ANY         0x100
+
+static int
+wait_reply(uint16_t op, int vse, const uint8_t **ret, uint32_t *rlen)
+{
+	uint64_t deadline = negroni_bt_us() + (uint64_t)h.to_ms * 1000u;
+
+	for (;;) {
+		if (h4_next(deadline)) {
+			SAY("no answer to %#06x within %u ms (RX buffer %u bytes:%s)\n", op, h.to_ms, h.rxn, hex(h.rx, h.rxn));
+			return -ETIMEDOUT;
+		}
+		if (h.type != H4_EVT) {
+			SAY("H4 type %#x, %u bytes, skipped:%s\n", h.type, h.pktn, hex(h.pkt, h.pktn));
+			continue;
+		}
+		const uint8_t *p = h.pkt + 2;
+		uint32_t plen = h.pkt[1];
+		if (!h.quiet) {
+			log_event();
+		}
+		if (h.pkt[0] == EV_CMD_COMPLETE && plen >= 3 && le16(p + 1) == op) {
+			*ret = p + 3;
+			*rlen = plen - 3u;
+			return R_CC;
+		}
+		if (h.pkt[0] == EV_CMD_STATUS && plen >= 4 && le16(p + 2) == op && p[0] != 0) {
+			if (h.quiet) {
+				log_event();
+			}
+			return -EIO;
+		}
+		if (h.pkt[0] == EV_VENDOR && (vse == VSE_ANY || (vse >= 0 && plen >= 2 && p[0] == 0 && p[1] == vse))) {
+			*ret = p;
+			*rlen = plen;
+			return R_VSE;
+		}
+		if (h.pkt[0] == EV_HW_ERROR && h.quiet) {
+			log_event();
+		}
+	}
+}
+
+/* Command + its Command Complete with status 0 */
+static int
+cmd_cc(uint16_t op, const uint8_t *par, uint8_t len, const uint8_t **ret, uint32_t *rlen)
+{
+	int r = hci_cmd(op, par, len, true);
+	if (r) {
+		return r;
+	}
+	r = wait_reply(op, VSE_NONE, ret, rlen);
+	if (r < 0) {
+		return -r;
+	}
+	if (*rlen < 1 || (*ret)[0] != 0) {
+		SAY("%#06x: Command Complete status %#x (%u return bytes)\n", op, *rlen ? (*ret)[0] : 0xffu, *rlen);
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+step_reset(uint32_t n)
+{
+	const uint8_t *r;
+	uint32_t rl;
+	uint64_t t0 = negroni_bt_us();
+	int error = cmd_cc(OP_RESET, NULL, 0, &r, &rl);
+	if (!error) {
+		SAY("%u HCI_RESET: Command Complete status 0 after %llu ms at %u baud\n", n, (negroni_bt_us() - t0) / 1000u,
+		    negroni_bt_uart_baud());
+	}
+	return error;
+}
+
+/* btqca.c:16 qca_read_soc_version: CC form (soc_type >= WCN3991, 15 bytes) or VSE form (rtype 0x02) */
+static int
+read_version(uint32_t n)
+{
+	const uint8_t sub = EDL_VER_REQ;
+	const uint8_t *r, *v = NULL;
+	uint32_t rl;
+	int error = hci_cmd(OP_EDL, &sub, 1, true), k;
+
+	if (error) {
+		return error;
+	}
+	k = wait_reply(OP_EDL, EDL_APP_VER_RES, &r, &rl);
+	if (k < 0) {
+		return -k;
+	}
+	if (k == R_CC && rl >= 15 && r[0] == 0 && r[1] == EDL_VER_REQ) {
+		v = r + 3;
+	} else if (k == R_VSE && rl >= 14 && r[0] == 0 && r[1] == EDL_APP_VER_RES) {
+		v = r + 2;
+	}
+	if (!v) {
+		SAY("%u version answer not understood (%s, %u bytes)\n", n, k == R_CC ? "CC" : "VSE", rl);
+		return EILSEQ;
+	}
+	h.ver.product = le32(v);
+	h.ver.patch = le16(v + 4);
+	h.ver.rom = le16(v + 6);
+	h.ver.soc = le32(v + 8);
+	uint32_t soc_ver = h.ver.soc << 16 | h.ver.rom;         /* btqca.h:51 get_soc_ver */
+	h.rom = (uint8_t)(((soc_ver & 0xf00u) >> 4) | (soc_ver & 0xfu));     /* btqca.c:776 */
+	h.gf = (h.ver.soc & 0xff00u) == 0x1200u;                /* QCA_HSP_GF_SOC_ID / _MASK, btqca.h:54 */
+	SAY("%u QCA product %#010x, SoC %#010x, ROM %#06x, patch %#06x (%s): controller version %#010x, firmware "
+	    "ROM %02x%s\n", n, h.ver.product, h.ver.soc, h.ver.rom, h.ver.patch, k == R_CC ? "Command Complete" :
+	    "vendor event", soc_ver, h.rom, h.gf ? " GF (\"g\" NVM)" : "");
+	if (h.ver.soc == 0 || h.ver.rom == 0) {                 /* btqca.c:79 */
+		return EILSEQ;
+	}
+	return 0;
+}
+
+static int
+baud_code(uint32_t baud)
+{
+	switch (baud) {                                         /* hci_qca.c:1306 qca_get_baudrate_value */
+	case 115200: return 0x00;
+	case 230400: return 0x05;
+	case 460800: return 0x07;
+	case 921600: return 0x0a;
+	case 1000000: return 0x0b;
+	case 2000000: return 0x0d;
+	case 3000000: return 0x0e;
+	case 3200000: return 0x11;
+	default: return -1;
+	}
+}
+
+/* hci_qca.c:1487 qca_set_speed (WCN6855 branch) + :1342 qca_set_baudrate */
+static int
+step_baud(uint32_t baud)
+{
+	int code = baud_code(baud);
+	uint8_t c;
+	const uint8_t *r;
+	uint32_t rl;
+
+	if (code < 0) {
+		SAY("11 negronibt_baud=%u is not a QCA baud code; stop\n", baud);
+		return EINVAL;
+	}
+	c = (uint8_t)code;
+	negroni_bt_uart_flow(false);                            /* RFR not ready while the rate changes */
+	int error = hci_cmd(OP_SET_BAUD, &c, 1, true);
+	if (error) {
+		negroni_bt_uart_flow(true);
+		return error;
+	}
+	negroni_bt_sleep_ms(10);                                /* usleep_range(1000, 10000), hci_qca.c:1386 */
+	error = negroni_bt_uart_set_baud(baud);
+	negroni_bt_uart_flow(true);
+	if (error) {
+		SAY("11 the host UART cannot run at %u (error %d); the controller may already have switched\n", baud, error);
+		return error;
+	}
+	SAY("11 controller and host at %u baud (code %#x)\n", baud, c);
+	/* events for 0xfc48 (if any) arrive at the new rate: log them for 100 ms */
+	uint32_t saved = h.to_ms;
+	h.to_ms = 100;
+	int k = wait_reply(OP_SET_BAUD, VSE_ANY, &r, &rl);
+	h.to_ms = saved;
+	SAY("11 answer to 0xfc48 at the new rate: %s\n", k == R_CC ? "Command Complete" : k == R_VSE ? "vendor event" :
+	    "none within 100 ms (hci_qca.c does not wait for one)");
+	return read_version(11);
+}
+
+/* ---- firmware pack (scripts/bt/mkbtpack.py) inside the WLAN area (scripts/wifi/mkwlanarea.py) ---- */
+
+static int
+step_area(void)
+{
+	struct area_header *a = NULL;
+	int error = ENOENT;
+
+	if (kmem_alloc(kernel_map, (vm_offset_t *)&a, AREA_HDR, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, (vm_offset_t *)&h.pack, PACK_HDR, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, (vm_offset_t *)&h.fw, FW_CAP, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		SAY("12 no memory for the firmware buffers; stop\n");
+		error = ENOMEM;
+		goto out;
+	}
+	error = negroni_ufs_wlan_area_read(0, a, AREA_HDR);
+	if (error || memcmp(a->magic, "NEGRWLAN", 8) != 0 || a->version != 1 || a->count == 0 || a->count > AREA_MAX) {
+		SAY("12 no WLAN firmware area header (read error %d); write out/bt/wlan-bt-area.bin "
+		    "(README-bluetooth.md); stop\n", error);
+		error = error ? error : EINVAL;
+		goto out;
+	}
+	error = ENOENT;
+	for (uint32_t i = 0; i < a->count; i++) {
+		const struct fw_entry *e = &a->e[i];
+		if (strncmp(e->name, PACK_NAME, sizeof(e->name)) != 0) {
+			continue;
+		}
+		if (e->offset < AREA_HDR || e->size < PACK_HDR || e->size > (8u << 20)) {
+			SAY("12 %s offset %#x size %u out of range; stop\n", PACK_NAME, e->offset, e->size);
+			error = ERANGE;
+			goto out;
+		}
+		h.pack_at = e->offset;
+		h.pack_size = e->size;
+		error = 0;
+		break;
+	}
+	if (error) {
+		SAY("12 the WLAN area (%u files) has no %s: write out/bt/wlan-bt-area.bin (scripts/bt/mkbtarea.sh); "
+		    "stop\n", a->count, PACK_NAME);
+		goto out;
+	}
+	error = negroni_ufs_wlan_area_read(h.pack_at, h.pack, PACK_HDR);
+	if (error || memcmp(h.pack->magic, "NEGRBTFW", 8) != 0 || h.pack->version != 1 || h.pack->count == 0 ||
+	    h.pack->count > PACK_MAX) {
+		SAY("12 %s header bad (read error %d); stop\n", PACK_NAME, error);
+		error = error ? error : EINVAL;
+		goto out;
+	}
+	SAY("12 %s at area byte %#llx, %u bytes, %u files\n", PACK_NAME, h.pack_at, h.pack_size, h.pack->count);
+out:
+	if (a) {
+		kmem_free(kernel_map, (vm_offset_t)a, AREA_HDR);
+	}
+	return error;
+}
+
+/* Read one file of the pack into h.fw, check its SHA-256 */
+static int
+fw_load(const char *name, uint32_t *size)
+{
+	for (uint32_t i = 0; i < h.pack->count; i++) {
+		const struct fw_entry *e = &h.pack->e[i];
+		if (strncmp(e->name, name, sizeof(e->name)) != 0) {
+			continue;
+		}
+		if (e->size == 0 || e->size > FW_CAP || e->offset < PACK_HDR || e->offset > h.pack_size ||
+		    e->size > h.pack_size - e->offset) {
+			SAY("%s size %u / offset %#x out of range\n", name, e->size, e->offset);
+			return ERANGE;
+		}
+		int error = negroni_ufs_wlan_area_read(h.pack_at + e->offset, h.fw, e->size);
+		if (error) {
+			SAY("%s read error %d\n", name, error);
+			return error;
+		}
+		uint8_t d[32];
+		SHA256_CTX c;
+		SHA256_Init(&c);
+		SHA256_Update(&c, h.fw, e->size);
+		SHA256_Final(d, &c);
+		if (memcmp(d, e->sha256, 32) != 0) {
+			SAY("%s %u bytes, sha-256 MISMATCH\n", name, e->size);
+			return EBADMSG;
+		}
+		SAY("%s %u bytes loaded, sha-256 OK\n", name, e->size);
+		*size = e->size;
+		return 0;
+	}
+	SAY("%s not in %s\n", name, PACK_NAME);
+	return ENOENT;
+}
+
+/*
+ * btqca.c:553 qca_download_firmware + :460 qca_tlv_send_segment: the whole file in 243-byte EDL_PATCH_TLV_REQ
+ * commands. skip (download mode 1 or 3): only the last (or a short) segment is acked; else every segment.
+ * Ack = Command Complete [00 1e] (soc_type >= WCN3991) or vendor event [00 04 result].
+ * Events are logged for segments 0, 1 and the last one; the rest are counted.
+ */
+static int
+tlv_download(uint32_t n, const uint8_t *data, uint32_t size, bool skip)
+{
+	uint8_t cmd[2 + TLV_SEG];
+	uint32_t seg = 0, acks = 0;
+	uint64_t t0 = negroni_bt_us();
+	int error = 0;
+
+	for (uint32_t at = 0; at < size; seg++) {
+		uint32_t len = MIN(TLV_SEG, size - at);
+		bool last = at + len == size || len < TLV_SEG;
+		bool wait = !skip || last;
+		const uint8_t *r;
+		uint32_t rl;
+
+		cmd[0] = EDL_TLV_REQ;
+		cmd[1] = (uint8_t)len;
+		memcpy(cmd + 2, data + at, len);
+		h.quiet = !(seg < 2 || last);
+		error = hci_cmd(OP_EDL, cmd, (uint8_t)(len + 2u), !h.quiet);
+		if (error) {
+			break;
+		}
+		at += len;
+		if (!wait) {
+			continue;
+		}
+		int k = wait_reply(OP_EDL, EDL_TLV_RES, &r, &rl);
+		if (k < 0) {
+			SAY("%u segment %u (byte %u of %u): no ack\n", n, seg, at, size);
+			error = -k;
+			break;
+		}
+		if (k == R_CC && rl >= 2 && r[0] == 0 && r[1] == EDL_TLV_REQ) {
+			acks++;
+		} else if (k == R_VSE && rl >= 3 && r[0] == 0 && r[1] == EDL_TLV_RES) {
+			acks++;
+			if (r[2]) {
+				SAY("%u segment %u: TLV result %#x (btqca.c logs it, goes on)\n", n, seg, r[2]);
+			}
+		} else {
+			if (h.quiet) {
+				log_event();
+			}
+			SAY("%u segment %u: ack not understood (%s, %u bytes)\n", n, seg, k == R_CC ? "CC" : "VSE", rl);
+			error = EIO;
+			break;
+		}
+	}
+	h.quiet = 0;
+	SAY("%u %u segments of <= %u bytes sent, %u acks, %llu ms, at %u baud%s\n", n, seg, TLV_SEG, acks,
+	    (negroni_bt_us() - t0) / 1000u, negroni_bt_uart_baud(), error ? " (FAILED)" : "");
+	return error;
+}
+
+static int
+step_rampatch(void)
+{
+	char name[24];
+	uint32_t size;
+
+	snprintf(name, sizeof(name), "hpbtfw%02x.tlv", h.rom);           /* btqca.c:849 (WCN6855 fallback name) */
+	int error = fw_load(name, &size);
+	if (error) {
+		return error;
+	}
+	const uint8_t *f = h.fw;
+	if (size < 28 || (f[0] & 0xffu) != 1) {                         /* tlv_type_hdr + tlv_type_patch */
+		SAY("13 %s: no TLV type 1 header\n", name);
+		return EINVAL;
+	}
+	uint8_t mode = f[14];
+	uint16_t rom_build = le16(f + 18);
+	SAY("13 %s: TLV length %u, total %u, data %u, format %u, signature %u, download mode %u, product %#06x, "
+	    "ROM build %#06x, patch %#06x\n", name, le32(f) >> 8, le32(f + 4), le32(f + 8), f[12], f[13], mode,
+	    le16(f + 16), rom_build, le16(f + 20));
+	if (rom_build != h.ver.rom) {
+		SAY("13 note: ROM build %#06x != controller ROM %#06x\n", rom_build, h.ver.rom);
+	}
+	error = tlv_download(13, f, size, mode == 1 || mode == 3);      /* QCA_SKIP_EVT_VSE / _VSE_CC */
+	negroni_bt_sleep_ms(10);                                        /* btqca.c:860 */
+	return error;
+}
+
+/* btqca.c:193 qca_read_fw_board_id: CC [00 23 xx hi lo] */
+static uint16_t
+read_bid(void)
+{
+	const uint8_t sub = EDL_BID_REQ;
+	const uint8_t *r;
+	uint32_t rl;
+
+	if (cmd_cc(OP_EDL, &sub, 1, &r, &rl)) {
+		SAY("14 board id: no answer; the default NVM follows\n");
+		return 0;
+	}
+	if (rl < 5 || r[1] != EDL_BID_REQ) {
+		SAY("14 board id: answer not understood (%u bytes); the default NVM follows\n", rl);
+		return 0;
+	}
+	return (uint16_t)(r[3] << 8 | r[4]);
+}
+
+/* btqca.c:291 qca_tlv_check_data, TLV_TYPE_NVM: bounds, tag 2 (BD address), tag 17 baud, optional IBS bits */
+static int
+nvm_patch(uint8_t *f, uint32_t size, uint8_t code)
+{
+	uint32_t off = 4;
+	if (size < 4) {
+		return EINVAL;
+	}
+	uint32_t tl = le32(f), len = tl >> 8, type = tl & 0xffu;
+	if (type == 4) {
+		if (size < 8) {
+			return EINVAL;
+		}
+		tl = le32(f + 4);
+		len = tl >> 8;
+		type = tl & 0xffu;
+		off = 8;
+	}
+	if (type != 2 || len > size - off) {
+		SAY("15 NVM: TLV type %u length %u (file %u bytes) not usable\n", type, len, size);
+		return EINVAL;
+	}
+	uint32_t tags = 0;
+	for (uint32_t i = 0; i + 12u <= len; tags++) {
+		uint8_t *t = f + off + i;
+		uint16_t id = le16(t), tlen = le16(t + 2);
+		uint8_t *d = t + 12;
+		if (len < i + 12u + tlen) {
+			return EINVAL;
+		}
+		if (id == TAG_BD_ADDR) {
+			if (tlen != 6) {
+				return EINVAL;
+			}
+			memcpy(h.nvm_bdaddr, d, 6);
+			h.nvm_bdaddr_set = true;
+		} else if (id == TAG_HCI) {
+			if (tlen < 3) {
+				return EINVAL;
+			}
+			SAY("15 NVM tag 17 (HCI transport) before:%s\n", hex(d, tlen));
+			if (h.ibs) {
+				d[0] |= 0x80u;
+			}
+			d[1] = code;                                    /* soc_type >= WCN3991: byte 1 (btqca.c:429) */
+			SAY("15 NVM tag 17 after: byte 0 %#x, baud byte %#x\n", d[0], d[1]);
+		} else if (id == TAG_DEEP_SLEEP && h.ibs) {
+			if (tlen < 1) {
+				return EINVAL;
+			}
+			d[0] |= 0x01u;
+		}
+		i += 12u + tlen;
+	}
+	SAY("15 NVM: %u tags, BD address tag %s\n", tags, h.nvm_bdaddr_set ? "present" : "absent");
+	return 0;
+}
+
+static int
+step_nvm(void)
+{
+	char name[32];
+	uint32_t size;
+	uint16_t bid = read_bid();
+	const char *v = h.gf ? "g" : "";
+	int error;
+
+	if (bid == 0 || bid == 0xffffu) {                                /* btqca.c:715 qca_get_nvm_name_by_board */
+		snprintf(name, sizeof(name), "hpnv%02x%s.bin", h.rom, v);
+	} else {
+		snprintf(name, sizeof(name), "hpnv%02x%s.b%02x", h.rom, v, bid);
+	}
+	SAY("14 board id %#x -> %s\n", bid, name);
+	STEP(15, "NVM download");
+	error = fw_load(name, &size);
+	if (error == ENOENT && bid != 0 && bid != 0xffffu) {             /* btqca.c:570 qca_get_alt_nvm_file */
+		snprintf(name, sizeof(name), "hpnv%02x%s.bin", h.rom, v);
+		error = fw_load(name, &size);
+	}
+	if (error) {
+		return error;
+	}
+	int code = baud_code(negroni_bt_uart_baud());
+	error = nvm_patch(h.fw, size, (uint8_t)(code < 0 ? 0 : code));
+	if (error) {
+		SAY("15 %s: NVM TLV check failed (%d)\n", name, error);
+		return error;
+	}
+	return tlv_download(15, h.fw, size, false);
+}
+
+static void
+step_build_info(void)
+{
+	const uint8_t sub = EDL_BUILD_INFO;
+	const uint8_t *r;
+	uint32_t rl;
+	char label[80];
+
+	if (cmd_cc(OP_EDL, &sub, 1, &r, &rl) || rl < 3 || r[1] != EDL_BUILD_INFO) {
+		SAY("18 build info: no answer (btqca.c:91; not needed for the next steps)\n");
+		return;
+	}
+	uint32_t n = MIN((uint32_t)r[2], rl - 3u);
+	n = MIN(n, (uint32_t)sizeof(label) - 1u);
+	for (uint32_t i = 0; i < n; i++) {
+		label[i] = (r[3 + i] >= 0x20 && r[3 + i] < 0x7f) ? (char)r[3 + i] : '.';
+	}
+	label[n] = 0;
+	SAY("18 firmware build label \"%s\"\n", label);
+}
+
+static int
+step_bdaddr(uint32_t n, uint8_t out[6])
+{
+	const uint8_t *r;
+	uint32_t rl;
+	int error = cmd_cc(OP_READ_BD_ADDR, NULL, 0, &r, &rl);
+	if (error) {
+		return error;
+	}
+	if (rl != 7) {                                                  /* status + bdaddr (btqca.c:700) */
+		SAY("%u Read_BD_ADDR: %u return bytes, expected 7\n", n, rl);
+		return EIO;
+	}
+	const uint8_t *a = r + 1;                                       /* little endian on the wire */
+	bool dflt = h.nvm_bdaddr_set && memcmp(a, h.nvm_bdaddr, 6) == 0;
+	SAY("%u BD address %02x:%02x:%02x:%02x:%02x:%02x (%s)\n", n, a[5], a[4], a[3], a[2], a[1], a[0],
+	    dflt ? "= the NVM default: no unique address; the host must set one (0xfc14, btqca.c:1005)" :
+	    "not the NVM default");
+	if (out) {
+		memcpy(out, a, 6);
+	}
+	return 0;
+}
+
+/*
+ * Step 20 (negronibt=4, patch 0332): give the controller the address bluetoothd uses. bluetoothd 20H392 reads
+ * local-mac-address of the registry entry "bluetooth" (main 0x1000269b4 -> 0x100027920) and discards the
+ * BT_DEVICE_ADDRESS env value (0x1000268f4/0x1000268f8 store zero after the sscanf). The ADT bytes are in display
+ * order (02:00:5e:...), which is the order 0xfc14 wants (btqca.c:1011 swaps the little-endian bdaddr_t).
+ * A failure is logged only: the controller then keeps the NVM default and bluetoothd still runs.
+ */
+static void
+step_set_bdaddr(void)
+{
+	DTEntry node;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	const uint8_t *r;
+	uint32_t rl;
+	uint8_t now[6];
+
+	if (SecureDTLookupEntry(NULL, "/arm-io/bluetooth", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "local-mac-address", &prop, &size) != kSuccess || size < 6) {
+		SAY("20 no /arm-io/bluetooth local-mac-address in the ADT: the controller keeps its address\n");
+		return;
+	}
+	const uint8_t *a = prop;
+	if (cmd_cc(OP_WRITE_BDADDR, a, 6, &r, &rl)) {
+		SAY("20 0xfc14 failed: the controller keeps its address\n");
+		return;
+	}
+	if (step_bdaddr(20, now) == 0) {
+		bool same = true;
+		for (uint32_t i = 0; i < 6; i++) {
+			same = same && now[i] == a[5 - i];
+		}
+		SAY("20 ADT address %02x:%02x:%02x:%02x:%02x:%02x %s\n", a[0], a[1], a[2], a[3], a[4], a[5],
+		    same ? "is the controller address now" : "NOT taken by the controller");
+	}
+}
+
+int
+negroni_bt_hci_run(uint32_t mode)
+{
+	uint32_t baud = negroni_bt_arg("baud", 3000000);
+	int error;
+
+	memset(&h, 0, sizeof(h));
+	h.to_ms = negroni_bt_arg("to", 2000);
+	h.to_ms = MAX(MIN(h.to_ms, 30000u), 50u);
+	h.ibs = negroni_bt_arg("ibs", 0);
+	SAY("HCI stage (patch 0331): negronibt=%u, wait %u ms, baud %u, IBS bits %s\n", mode, h.to_ms, baud,
+	    h.ibs ? "set" : "as in the file");
+
+	STEP(9, "HCI_RESET (ROM)");
+	if (step_reset(9)) {
+		SAY("9 no Command Complete for HCI_RESET; the version request decides\n");
+	}
+	STEP(10, "EDL version request (0xfc00 0x19)");
+	if ((error = read_version(10))) {
+		SAY("stop: step 10 version request failed (%d)\n", error);
+		goto out;
+	}
+	STEP(11, "baud change (0xfc48)");
+	if (baud != 115200 && (error = step_baud(baud))) {
+		SAY("stop: step 11 baud change to %u failed (%d)\n", baud, error);
+		goto out;
+	}
+	if (mode < 3) {
+		SAY("HCI stage done at step 11 (negronibt=2)\n");
+		goto out;
+	}
+	STEP(12, "firmware pack in the WLAN area");
+	if ((error = step_area())) {
+		goto out;
+	}
+	STEP(13, "rampatch download");
+	if ((error = step_rampatch())) {
+		SAY("stop: step 13 rampatch failed (%d)\n", error);
+		goto out;
+	}
+	STEP(14, "board id (0xfc00 0x23)");
+	if ((error = step_nvm())) {
+		SAY("stop: step 15 NVM failed (%d)\n", error);
+		goto out;
+	}
+	STEP(16, "SoC logging off (0xfc17)");
+	{
+		const uint8_t par[2] = { 0x14, 0x00 };                  /* QCA_DISABLE_LOGGING_SUB_OP */
+		const uint8_t *r;
+		uint32_t rl;
+		if (cmd_cc(OP_LOGGING, par, 2, &r, &rl)) {
+			SAY("16 no Command Complete (btqca.c:949 stops here; this stage goes on)\n");
+		}
+	}
+	STEP(17, "HCI_RESET (patched firmware)");
+	if ((error = step_reset(17))) {
+		SAY("stop: step 17 HCI_RESET after the download failed (%d)\n", error);
+		goto out;
+	}
+	STEP(18, "firmware build info (0xfc00 0x20)");
+	step_build_info();
+	STEP(19, "HCI_Read_BD_ADDR (0x1009)");
+	if ((error = step_bdaddr(19, NULL))) {
+		SAY("stop: step 19 failed (%d)\n", error);
+		goto out;
+	}
+	if (mode >= 4) {
+		STEP(20, "BD address from the ADT (0xfc14)");
+		step_set_bdaddr();
+	}
+	SAY("HCI stage done: firmware ROM %02x%s loaded, %u baud\n", h.rom, h.gf ? " GF" : "", negroni_bt_uart_baud());
+out:
+	if (h.fw) {
+		kmem_free(kernel_map, (vm_offset_t)h.fw, FW_CAP);
+	}
+	if (h.pack) {
+		kmem_free(kernel_map, (vm_offset_t)h.pack, PACK_HDR);
+	}
+	h.fw = NULL;
+	h.pack = NULL;
+	SAY("HCI stage end: %s (error %d, %u non-H4 bytes dropped)\n", error ? "FAILED" : "ok", error, h.garbage);
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_bt_shim.c b/bsd/dev/negroni_bt_shim.c
new file mode 100644
index 0000000..99c5d42
--- /dev/null
+++ b/bsd/dev/negroni_bt_shim.c
@@ -0,0 +1,792 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450): QCA6490 Bluetooth, stage B part 2 (patch 0333): the HCI shim between iOS
+ * (bluetoothd / BlueTool, which expect a Broadcom controller) and the Qualcomm controller. Called by the H4
+ * transport (negroni_bt_h4.c, patch 0332) for every complete packet. negronibt=4 only.
+ *
+ * Why [V, 20H392 usr/sbin/bluetoothd and usr/sbin/BlueTool, iPhone10,3]:
+ *   - bluetoothd does not boot the chip: it asks BlueTool over XPC (RunBuiltinScript "boot"/"init", reply handler
+ *     0x10027249c reads "result" 0x100272580, "firmware" 0x10027261c, "manufacturer" 0x100272630; result 10 or 13 =
+ *     "Couldn't find a platform / chipset / firmware combination" 0x10062ccb8 -> power state 2 = "Unknown
+ *     platform/chipset/manufacturer combination, restarting" 0x1003a619c). BlueTool's built-in scripts are
+ *     Broadcom only (.hcd patchram: 0xfc2e download minidriver, 0xfc4c write RAM, 0xfc4e launch RAM; 0xfc18 baud,
+ *     0xfc01 BD address, 0xfc27 sleep mode; opcodes as in Linux btbcm.c:155-379, hci_bcm.c:195-399). The
+ *     /etc/bluetool override scripts are read only when MobileGestalt ReleaseType is Vendor or Internal
+ *     (BlueTool 0x100016054-0x100016280). Userland answer: a BlueTool stand-in (userland/bluetooth).
+ *   - bluetoothd's own stack init (initCmd*CB) is standard HCI. Read Local Version (initCmdReadLocalVersionCB
+ *     0x10010bc6c) keeps HCI version, HCI revision, LMP version and LMP subversion (0x10010bcd4-0x10010bd10) and
+ *     NOT the manufacturer: no manufacturer check there, so 0x001d (Qualcomm) passes unchanged by default.
+ *   - bluetoothd has 220 Broadcom/Apple vendor commands (name table 0x100804a20: BD_VSC_*, OLYMPIC, LE_META ...).
+ *     On the QCA6490 the OGF 0x3f space is Qualcomm's: 0xfc00 EDL patch, 0xfc0b, 0xfc14 BD address, 0xfc17 logging,
+ *     0xfc48 baud rate (btqca.h, hci_qca.c). A Broadcom opcode that is a different QCA command can change the
+ *     controller state (the baud rate!). So by default NO host vendor command reaches the controller: each one is
+ *     answered here with a Command Complete. Status 0 (success, no return parameters) for the Broadcom "write"
+ *     commands that return only a status (table below), status 0x01 (Unknown HCI Command) for all others: a
+ *     controller without the command answers the same way, and a status != 0 makes bluetoothd skip the return
+ *     parameter parser ("Unsupported command %!, ignoring error").
+ *   - Controller vendor events (code 0xff, QCA debug/log) are not delivered: bluetoothd would read them as Broadcom
+ *     or Apple vendor events.
+ * Policy boot-arg negronibt_shim: 1 (default) as above; 0 = everything passes (raw controller); 2 = every vendor
+ * command gets status 0 (experiment: may make bluetoothd parse missing return parameters).
+ * negronibt_mfr=N: rewrite the manufacturer of the Read Local Version Command Complete to N (e.g. 15 = Broadcom);
+ * default 0 = unchanged (see above).
+ * Log ("NEGRONI BT: shim ..."): every intercepted opcode (first 4 times per opcode, then every 64th), every rewrite,
+ * the controller's Read Local Version once per client, dropped vendor events (first 16).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include "negroni_bt.h"
+
+#define SAY(...)        printf("NEGRONI BT: shim " __VA_ARGS__)
+
+#define H4_CMD          0x01u
+#define H4_EVT          0x04u
+#define EV_CMD_COMPLETE 0x0eu
+#define EV_VENDOR       0xffu
+#define OGF_VENDOR      0x3fu
+#define OP_READ_LOCAL_VERSION 0x1001u
+#define EV_CMD_STATUS   0x0fu
+/*
+ * 0336 (iOSPlus10): standard commands of bluetoothd's HCI init that the QCA6490 does not take [V, phone 2026-10-27,
+ * logs/usblog-t2.txt and phone-log-20261027-025222.txt]:
+ *   0x0c6d Write_LE_Host_Support: bluetoothd sends 01 6d 0c 02 01 01; the chip lists the command (mask octet 24
+ *          bit 6) but answers 0x11 (Unsupported Feature or Parameter Value) because Simultaneous_LE_Host must be 0x00
+ *          since Core 4.1. 0337: the parameter is rewritten to 0x00 and the command goes to the chip; only if the
+ *          chip still rejects it, its status is rewritten to 0 (0336 answered it locally).
+ *   0x0c5b Write_Default_Erroneous_Data_Reporting / 0x0c5a Read_...: bluetoothd never sends them; its stack checks the
+ *          Read_Local_Supported_Commands mask (octet 18 bit 3 / bit 2, as Linux hci_sync.c commands[18] & 0x08 / 0x04),
+ *          fails locally ("OI_HCICMD_WriteDefaultErroneousDataReporting (status=628)", "HCI initialization failed",
+ *          restart reason 108). So the 0x1002 answer gets both bits, and when the chip did not have them the commands
+ *          are answered here (write: status 0; read: status 0, reporting 0x00 disabled).
+ * Every other non-zero status from the chip is logged ("controller rejected ...") for the next round.
+ * negronibt_shimfix=0 turns 0336/0337 off (no effect with negronibt_shim=0: then every packet passes unchanged).
+ *
+ * 0337 (iOSPlus10): Apple/Broadcom vendor commands [V phone 2026-10-27 03:17, logs/phone-log-20261027-031731.txt and
+ * the kernel h4 log]: bluetoothd's BCM VSC completion parser _BCM_ByteStreamEventParser (bluetoothd 0x100126134,
+ * bcm_vsc.c) calls the waiting command's callback only when at least 2 bytes follow the status; with fewer it logs
+ * "Invalid data size %d" and returns, so the command never completes: "BD_VSC_OLYMPIC_ANTENNA_PREF_B timedout waiting
+ * for controller" after 15 s, "Notifying BT Firmware Crashed", restart reason 3602. _BCM_SubOpcodeChecker
+ * (0x100126390) matches 0xfce9 answers by the first return byte = the command's sub-opcode. So every vendor command
+ * answered here carries return data: byte 0 = the first parameter byte (sub-opcode echo), then zeros
+ * (negronibt_vscdata, default 8 bytes, 2..32). The opcodes bluetoothd sent on the QCA6490 get status 0 (feature
+ * configuration; names from the error order in the log [I]). 0x2007 LE_Read_Advertising_Physical_Channel_Tx_Power:
+ * the chip answers 0x0c (Command Disallowed); rewritten to status 0, 0 dBm.
+ * 0338 review of 0337 [V h4 logs usblog-t6 and usblog-20261026-233816 04:06]: 0xfce2 is a multiplex opcode (byte 0 =
+ * sub-opcode: 0x0b, 0x1c, 0x15, 0x26, 0x1e, 0x36 seen; the error order names 0x0b CHANGE_LE_SETTINGS, 0x1c
+ * SET_MIN_AFH_LE_CHANNELS, 0x15 ANTENNA_PREF_B [I]). 0xfd48 carries 01 + a 6-byte address (the same address goes in
+ * the next 0x2005 LE_Set_Random_Address): an address list VSC [I], not SET_MIN_AFH_LE_CHANNELS. With 0337 bluetoothd
+ * passed all VSCs (no "timedout waiting for controller") and stopped at 0x200b (below).
+ *
+ * 0338 (iOSPlus10): the QCA6490 firmware (BTFW.HSP.2.1.0-00394) rejects legacy LE advertising/scanning commands with
+ * 0x0c Command Disallowed although the host sent no extended LE command [V usblog-20261026-233816 04:06:33: 0x2007
+ * and 0x200b LE_Set_Scan_Parameters 00 e0 01 30 00 01 00 -> status 0x0c; bluetoothd exits with status 1 and launchd
+ * restarts it every ~10 s]. bluetoothd uses only legacy LE commands on this chip ("support for Extended Scanning is
+ * disabled": its chipset table, not the chip's LE features). So the shim translates (negronibt_lext=1, default; 0 =
+ * pass the legacy commands unchanged):
+ *   0x200b Set_Scan_Parameters  -> 0x2041 Set_Extended_Scan_Parameters (1M PHY), answer op rewritten
+ *   0x200c Set_Scan_Enable      -> 0x2042 Set_Extended_Scan_Enable (duration 0, period 0), answer op rewritten
+ *   0x200d Create_Connection    -> 0x2043 Extended_Create_Connection (1M PHY), Command Status op rewritten
+ *   0x2006 Set_Advertising_Parameters -> 0x2036 (set 0, legacy PDU properties) [+ 0x2035 set random address]
+ *   0x2008 / 0x2009 Set_Advertising_Data / Scan_Response_Data -> 0x2037 / 0x2038 (set 0, complete data)
+ *   0x200a Set_Advertising_Enable -> 0x2039 (set 0)
+ *   0x2005 Set_Random_Address: sent as is; when set 0 exists, 0x2035 for set 0 follows (status only logged)
+ *   events: LE Extended Advertising Report (0x3e sub 0x0d) -> one LE Advertising Report (sub 0x02) per legacy-PDU
+ *   report (extended PDUs dropped: a legacy scan does not see them); LE Advertising Set Terminated (sub 0x12) and
+ *   LE Scan Timeout (sub 0x11) dropped; LE event mask (0x2001) gets bit 12 (Extended Advertising Report).
+ * The advertising commands run as a chain: one command at a time, the next after the controller's answer (RX
+ * thread), then one legacy Command Complete with the first failing status (0x2035 failures are only logged).
+ */
+#define OP_READ_SUPPORTED_COMMANDS 0x1002u
+#define OP_READ_ERR_DATA  0x0c5au
+#define OP_WRITE_ERR_DATA 0x0c5bu
+#define OP_WRITE_LE_HOST  0x0c6du
+#define OP_LE_READ_ADV_TX_POWER 0x2007u
+#define OP_RESET          0x0c03u
+#define OP_LE_EVENT_MASK  0x2001u
+#define OP_LE_RAND_ADDR   0x2005u
+#define OP_LE_ADV_PARAM   0x2006u
+#define OP_LE_ADV_DATA    0x2008u
+#define OP_LE_SCAN_RSP    0x2009u
+#define OP_LE_ADV_ENABLE  0x200au
+#define OP_LE_SCAN_PARAM  0x200bu
+#define OP_LE_SCAN_ENABLE 0x200cu
+#define OP_LE_CREATE_CONN 0x200du
+#define OP_LE_SET_RAND    0x2035u
+#define OP_LE_EXT_ADV_PARAM 0x2036u
+#define OP_LE_EXT_ADV_DATA  0x2037u
+#define OP_LE_EXT_SCAN_RSP  0x2038u
+#define OP_LE_EXT_ADV_EN    0x2039u
+#define OP_LE_EXT_SCAN_PARAM 0x2041u
+#define OP_LE_EXT_SCAN_EN   0x2042u
+#define OP_LE_EXT_CONN      0x2043u
+#define EV_LE_META        0x3eu
+#define VSC_DATA_DEF      8u
+#define CMDS_OCTET_ERR    18u
+#define CMDS_ERR_BITS     0x0cu         /* bit 2 read, bit 3 write */
+
+struct shim_op {
+	uint16_t op;
+	uint8_t status;         /* Command Complete status */
+	const char *name;
+};
+
+/*
+ * Broadcom vendor commands with a status-only Command Complete, answered "success" (so BlueTool.orig scripts and
+ * bluetoothd's sleep/PCM setup go on). Everything else in OGF 0x3f: status 0x01.
+ */
+static const struct shim_op shim_ops[] = {
+	{ 0xfc01, 0x00, "BCM Write_BD_ADDR (btbcm.c:155; the kernel set the ADT address, step 20)" },
+	{ 0xfc18, 0x00, "BCM Update_UART_Baud_Rate (hci_bcm.c:214; the line stays, see h4 termios)" },
+	{ 0xfc1c, 0x00, "BCM Write_SCO_PCM_Int_Param (btbcm.c:201)" },
+	{ 0xfc1e, 0x00, "BCM Write_PCM_Data_Format_Param" },
+	{ 0xfc27, 0x00, "BCM Write_Sleep_Mode_Param (hci_bcm.c:399; BD_VSC_WRITE_SLEEPMODE_PARAM)" },
+	{ 0xfc2e, 0x00, "BCM Download_Minidriver (btbcm.c:223)" },
+	{ 0xfc45, 0x00, "BCM Write_UART_Clock_Setting (hci_bcm.c:195)" },
+	{ 0xfc4c, 0x00, "BCM Write_RAM (.hcd patchram record)" },
+	{ 0xfc4e, 0x00, "BCM Launch_RAM (.hcd patchram end)" },
+	{ 0xfc6d, 0x00, "BCM Write_I2SPCM_Interface_Param" },
+	{ 0xfc1d, 0x01, "BCM Read_SCO_PCM_Int_Param (btbcm.c:173)" },
+	{ 0xfc5a, 0x01, "BCM Read_USB_Product (btbcm.c:379)" },
+	{ 0xfc6e, 0x01, "BCM Read_Controller_Features (btbcm.c:359)" },
+	{ 0xfc79, 0x01, "BCM Read_Verbose_Config_Version_Info (btbcm.c:339)" },
+	/* 0337: Apple VSCs bluetoothd sends on this chip (opcode [V] h4 log; name [I] from the error order) */
+	{ 0xfd3c, 0x00, "Apple VSC 0xfd3c (after \"BCM_4357 supports the following VSCs\")" },
+	{ 0xfce9, 0x00, "Apple LE_META (BD_VSC_LE_META_ENA_FEATURES; sub-opcode in byte 0, _BCM_SubOpcodeChecker)" },
+	{ 0xfce2, 0x00, "Apple OLYMPIC (sub 0x0b CHANGE_LE_SETTINGS, 0x1c SET_MIN_AFH_LE_CHANNELS, 0x15 ANTENNA_PREF_B; "
+	  "sub-opcode in byte 0)" },
+	{ 0xfd48, 0x00, "Apple VSC 0xfd48 (01 + a 6-byte address; an address list command [I])" },
+	{ 0xfd47, 0x00, "Apple VSC 0xfd47 (BD_VSC_ENABLE_EXTENDED_DUPLICATE_FILTER)" },
+};
+
+#define SEEN_SLOTS      1024u           /* OCF 0..0x3ff */
+
+static struct {
+	uint32_t policy, mfr;
+	bool version_logged;
+	uint16_t seen[SEEN_SLOTS];
+	uint32_t n_local, n_vse;
+	uint32_t fix, vscdata;
+	bool lehost_logged, advtx_logged, lehost_rej_logged;
+	bool chip_err_rd, chip_err_wr, cmds_known;
+	uint8_t rej[SEEN_SLOTS];
+	/* 0338 legacy -> extended LE */
+	uint32_t lext;
+	bool adv_set, rnd_known;
+	uint8_t rnd[6];
+	uint32_t n_xlat, n_rep_in, n_rep_out, n_rep_drop, n_ev_drop, n_rep_logged, n_chain_stale;
+	uint8_t adv_type;               /* legacy Advertising_Type of the last accepted 0x2006 (0 = ADV_IND default) */
+	uint8_t pend_scan_p, pend_scan_e, pend_conn;
+	struct {
+		bool active;
+		uint16_t legacy;
+		uint8_t n, i, status, crit;     /* crit: bit i = a failure of step i is the legacy status */
+		uint8_t want_type;              /* 0x2006 chain: its legacy type, kept when 0x2036 succeeds */
+		uint64_t at_us;                 /* last step sent (stale chain check) */
+		uint8_t len[3];
+		uint8_t cmd[3][48];
+	} ch;
+} s;
+
+static inline uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+void
+negroni_bt_shim_init(void)
+{
+	s.policy = negroni_bt_arg("shim", 1);
+	s.mfr = negroni_bt_arg("mfr", 0);
+	s.fix = negroni_bt_arg("shimfix", 1);
+	s.vscdata = negroni_bt_arg("vscdata", VSC_DATA_DEF);
+	if (s.vscdata < 2 || s.vscdata > 32) {
+		s.vscdata = VSC_DATA_DEF;
+	}
+	SAY("0336/0337 init fixes %s: 0x0c6d Simultaneous_LE_Host -> 0x00; 0x0c5a/0x0c5b Erroneous Data Reporting bits "
+	    "set in the 0x1002 mask and answered here when the chip lacks them; 0x2007 0x0c -> status 0, 0 dBm; vendor "
+	    "answers carry %u data bytes (sub-opcode echo + zeros)\n", s.fix ? "on" : "off", s.vscdata);
+	s.lext = negroni_bt_arg("lext", 1);
+	SAY("0338 legacy LE -> extended LE translation %s (negronibt_lext): 0x200b/0x200c/0x200d/0x2006/0x2008/0x2009/"
+	    "0x200a -> 0x2041/0x2042/0x2043/0x2036/0x2037/0x2038/0x2039; extended reports -> legacy reports\n",
+	    s.lext ? "on" : "off");
+	SAY("policy %u (%s), manufacturer rewrite %s%#x; %zu Broadcom opcodes answered with success, other vendor "
+	    "commands with status 0x01\n", s.policy,
+	    s.policy == 0 ? "pass everything" : s.policy == 2 ? "all vendor commands succeed" : "vendor commands local",
+	    s.mfr ? "to " : "off ", s.mfr, sizeof(shim_ops) / sizeof(shim_ops[0]));
+	for (size_t i = 0; i < sizeof(shim_ops) / sizeof(shim_ops[0]); i++) {
+		SAY("table %#06x -> status %#x: %s\n", shim_ops[i].op, shim_ops[i].status, shim_ops[i].name);
+	}
+}
+
+void
+negroni_bt_shim_session(void)
+{
+	s.version_logged = false;
+	bzero(s.seen, sizeof(s.seen));
+	bzero(s.rej, sizeof(s.rej));
+	s.cmds_known = s.chip_err_rd = s.chip_err_wr = false;
+	s.lehost_logged = s.advtx_logged = s.lehost_rej_logged = false;
+	s.adv_set = s.rnd_known = false;
+	s.adv_type = 0;
+	s.pend_scan_p = s.pend_scan_e = s.pend_conn = 0;
+	bzero(&s.ch, sizeof(s.ch));
+}
+
+static void
+answer(uint16_t op, uint8_t status)
+{
+	/* H4 event: 04 0e 04 <Num_HCI_Command_Packets 1> <op lo> <op hi> <status> */
+	const uint8_t ev[7] = { H4_EVT, EV_CMD_COMPLETE, 4, 1, (uint8_t)op, (uint8_t)(op >> 8), status };
+	negroni_bt_h4_inject(ev, sizeof(ev));
+}
+
+/* 0337: a vendor command answer with return data (BCM parser needs >= 2 bytes after the status) */
+static void
+answer_vsc(uint16_t op, uint8_t status, uint8_t sub)
+{
+	uint8_t ev[7 + 32];
+	uint32_t n = s.vscdata;
+	bzero(ev, sizeof(ev));
+	ev[0] = H4_EVT;
+	ev[1] = EV_CMD_COMPLETE;
+	ev[2] = (uint8_t)(4u + n);
+	ev[3] = 1;
+	ev[4] = (uint8_t)op;
+	ev[5] = (uint8_t)(op >> 8);
+	ev[6] = status;
+	ev[7] = sub;
+	negroni_bt_h4_inject(ev, 7u + n);
+}
+
+/*
+ * ---- 0338: legacy -> extended LE ----
+ * Locking: the state below changes on the TX path (h4_tx held) and on the RX thread, without a lock. This is safe
+ * because the controller gives one command credit and bluetoothd sends the next LE command only after the answer
+ * to the previous one (review F8). Late answers after an HCI_Reset go to bluetoothd with the extended opcode.
+ */
+
+static uint8_t
+mkcmd(uint8_t *b, uint16_t op, const uint8_t *par, uint8_t plen)
+{
+	b[0] = H4_CMD;
+	b[1] = (uint8_t)op;
+	b[2] = (uint8_t)(op >> 8);
+	b[3] = plen;
+	memcpy(b + 4, par, plen);
+	return (uint8_t)(4u + plen);
+}
+
+/* 0x2036 for set 0 from the 15 legacy parameter bytes (NULL: legacy defaults, ADV_IND 1.28 s, public) */
+static uint8_t
+mk_ext_adv_param(uint8_t *b, const uint8_t *lp)
+{
+	static const uint8_t def[15] = { 0x00, 0x08, 0x00, 0x08, 0x00, 0x00, 0x00, 0, 0, 0, 0, 0, 0, 0x07, 0x00 };
+	const uint8_t *l = lp ? lp : def;
+	uint16_t props;
+	switch (l[4]) {
+	case 0x00: props = 0x0013; break;       /* ADV_IND: legacy, connectable, scannable */
+	case 0x01: props = 0x001d; break;       /* ADV_DIRECT_IND high duty */
+	case 0x02: props = 0x0012; break;       /* ADV_SCAN_IND */
+	case 0x03: props = 0x0010; break;       /* ADV_NONCONN_IND */
+	case 0x04: props = 0x0015; break;       /* ADV_DIRECT_IND low duty */
+	default:   props = 0x0013; break;
+	}
+	uint8_t p[25] = {
+		0x00, (uint8_t)props, (uint8_t)(props >> 8),
+		l[0], l[1], 0x00,                       /* primary interval min (3 bytes) */
+		l[2], l[3], 0x00,                       /* primary interval max */
+		l[13], l[5], l[6],                      /* channel map, own address type, peer address type */
+		l[7], l[8], l[9], l[10], l[11], l[12],  /* peer address */
+		l[14], 0x7f, 0x01, 0x00, 0x01, 0x00, 0x00 /* filter, TX power no preference, 1M, skip 0, 1M, SID 0, no notify */
+	};
+	return mkcmd(b, OP_LE_EXT_ADV_PARAM, p, sizeof(p));
+}
+
+static void
+chain_answer(uint8_t status)
+{
+	uint16_t op = s.ch.legacy;
+	s.ch.active = false;
+	if (status != 0 || s.n_xlat < 16) {
+		SAY("lext: legacy %#06x answered with status %#x after %u extended command(s)\n", op, status, s.ch.i + 1u);
+	}
+	answer(op, status);
+}
+
+/* send step s.ch.i; false = the UART send failed (the legacy command is answered with 0x03 Hardware Failure) */
+static bool
+chain_send(bool from_rx)
+{
+	s.ch.at_us = negroni_bt_us();
+	if (negroni_bt_h4_send_cmd(s.ch.cmd[s.ch.i], s.ch.len[s.ch.i], from_rx) != 0) {
+		chain_answer(0x03);
+		return false;
+	}
+	return true;
+}
+
+static int
+chain_start(uint16_t legacy, uint8_t crit)
+{
+	s.ch.active = true;
+	s.ch.legacy = legacy;
+	s.ch.i = 0;
+	s.ch.status = 0;
+	s.ch.crit = crit;
+	s.n_xlat++;
+	(void)chain_send(false);
+	return NEGRONI_BT_SHIM_DONE;
+}
+
+/* the controller answered a command; true = it was a chain step (the event is not delivered) */
+static bool
+chain_rx(uint16_t op, uint8_t status)
+{
+	if (!s.ch.active || s.ch.len[s.ch.i] < 4 || op != le16(s.ch.cmd[s.ch.i] + 1)) {
+		return false;
+	}
+	if (op == OP_LE_EXT_ADV_PARAM && status == 0) {
+		s.adv_set = true;               /* review F2: set 0 exists only after the controller took 0x2036 */
+		s.adv_type = s.ch.want_type;
+	}
+	if (status != 0) {
+		if (s.ch.crit & (1u << s.ch.i)) {
+			chain_answer(status);
+			return true;
+		}
+		SAY("lext: %#06x (step %u of legacy %#06x) status %#x: only logged\n", op, s.ch.i + 1u, s.ch.legacy, status);
+	}
+	if (s.ch.i + 1u < s.ch.n) {
+		s.ch.i++;
+		(void)chain_send(true);
+		return true;
+	}
+	chain_answer(0);
+	return true;
+}
+
+/* host command -> extended form; NEGRONI_BT_SHIM_PASS when the command is not translated */
+static int
+lext_tx(uint8_t *pkt, uint32_t len)
+{
+	uint16_t op = le16(pkt + 1);
+	uint8_t plen = pkt[3];
+	const uint8_t *l = pkt + 4;
+	if (len < 4u + plen) {
+		return NEGRONI_BT_SHIM_PASS;
+	}
+	if (op == OP_RESET) {
+		s.adv_set = s.rnd_known = false;
+		s.adv_type = 0;
+		s.pend_scan_p = s.pend_scan_e = s.pend_conn = 0;
+		bzero(&s.ch, sizeof(s.ch));
+		return NEGRONI_BT_SHIM_PASS;
+	}
+	if (op == OP_LE_EVENT_MASK && plen >= 8 && (pkt[5] & 0x10u) == 0) {
+		SAY("lext: LE event mask byte 1 %#x -> %#x (Extended Advertising Report on)\n", pkt[5], pkt[5] | 0x10u);
+		pkt[5] |= 0x10u;
+		return NEGRONI_BT_SHIM_PASS;
+	}
+	bool adv = op == OP_LE_ADV_PARAM || op == OP_LE_ADV_DATA || op == OP_LE_SCAN_RSP || op == OP_LE_ADV_ENABLE ||
+	    (op == OP_LE_RAND_ADDR && s.adv_set);
+	if (adv && s.ch.active && negroni_bt_us() - s.ch.at_us > 2000000u) {
+		/* review F6: a step answer never came (lost command); bluetoothd has its own timeout for the old one */
+		s.n_chain_stale++;
+		SAY("lext: chain of legacy %#06x had no answer for step %u in 2 s: dropped (#%u)\n", s.ch.legacy,
+		    s.ch.i + 1u, s.n_chain_stale);
+		s.ch.active = false;
+	}
+	if (adv && s.ch.active) {
+		SAY("lext: %#06x while legacy %#06x is still running: answered with 0x0c Command Disallowed\n", op,
+		    s.ch.legacy);
+		answer(op, 0x0c);
+		return NEGRONI_BT_SHIM_DONE;
+	}
+	uint8_t b[48];
+	switch (op) {
+	case OP_LE_SCAN_PARAM:
+		if (plen < 7) {
+			break;
+		} else {
+			/* own type, filter, PHYs 1M, [type, interval, window] */
+			const uint8_t p[8] = { l[5], l[6], 0x01, l[0], l[1], l[2], l[3], l[4] };
+			s.pend_scan_p++;
+			s.n_xlat++;
+			if (negroni_bt_h4_send_cmd(b, mkcmd(b, OP_LE_EXT_SCAN_PARAM, p, sizeof(p)), false) != 0) {
+				s.pend_scan_p--;
+				answer(op, 0x03);
+			}
+			return NEGRONI_BT_SHIM_DONE;
+		}
+	case OP_LE_SCAN_ENABLE:
+		if (plen < 2) {
+			break;
+		} else {
+			const uint8_t p[6] = { l[0], l[1], 0, 0, 0, 0 };
+			s.pend_scan_e++;
+			s.n_xlat++;
+			if (negroni_bt_h4_send_cmd(b, mkcmd(b, OP_LE_EXT_SCAN_EN, p, sizeof(p)), false) != 0) {
+				s.pend_scan_e--;
+				answer(op, 0x03);
+			}
+			return NEGRONI_BT_SHIM_DONE;
+		}
+	case OP_LE_CREATE_CONN:
+		if (plen < 25) {
+			break;
+		} else {
+			/* filter, own type, peer type, peer address, PHYs 1M, scan interval/window, conn interval min/max,
+			 * latency, supervision timeout, CE length min/max */
+			const uint8_t p[26] = { l[4], l[12], l[5], l[6], l[7], l[8], l[9], l[10], l[11], 0x01,
+				                l[0], l[1], l[2], l[3], l[13], l[14], l[15], l[16], l[17], l[18], l[19], l[20],
+				                l[21], l[22], l[23], l[24] };
+			s.pend_conn++;
+			s.n_xlat++;
+			if (negroni_bt_h4_send_cmd(b, mkcmd(b, OP_LE_EXT_CONN, p, sizeof(p)), false) != 0) {
+				s.pend_conn--;
+				const uint8_t st[7] = { H4_EVT, EV_CMD_STATUS, 4, 0x03, 1, (uint8_t)op, (uint8_t)(op >> 8) };
+				negroni_bt_h4_inject(st, sizeof(st));
+			}
+			return NEGRONI_BT_SHIM_DONE;
+		}
+	case OP_LE_ADV_PARAM:
+		if (plen < 15) {
+			break;
+		}
+		s.ch.n = 1;
+		s.ch.len[0] = mk_ext_adv_param(s.ch.cmd[0], l);
+		s.ch.want_type = l[4];
+		if ((l[5] == 0x01 || l[5] == 0x03) && s.rnd_known) {
+			const uint8_t p[7] = { 0x00, s.rnd[0], s.rnd[1], s.rnd[2], s.rnd[3], s.rnd[4], s.rnd[5] };
+			s.ch.len[1] = mkcmd(s.ch.cmd[1], OP_LE_SET_RAND, p, sizeof(p));
+			s.ch.n = 2;
+		}
+		return chain_start(op, 0x01);
+	case OP_LE_ADV_DATA:
+	case OP_LE_SCAN_RSP:
+		if (plen < 1) {
+			break;
+		} else if (s.adv_set && ((op == OP_LE_ADV_DATA && (s.adv_type == 0x01 || s.adv_type == 0x04)) ||
+		    (op == OP_LE_SCAN_RSP && l[0] != 0 && s.adv_type != 0x00 && s.adv_type != 0x02))) {
+			/* review F4: legacy takes and ignores data the PDU type cannot carry; 0x2037/0x2038 answer 0x12 */
+			if (s.n_xlat < 64) {
+				SAY("lext: %#06x for legacy type %u: the PDU carries no such data; local status 0\n", op,
+				    s.adv_type);
+			}
+			answer(op, 0);
+			return NEGRONI_BT_SHIM_DONE;
+		} else {
+			uint8_t dl = MIN(l[0], (uint8_t)31);
+			dl = (uint8_t)MIN((uint32_t)dl, (uint32_t)plen - 1u);
+			uint8_t p[4 + 31];
+			p[0] = 0x00;                    /* set 0 */
+			p[1] = 0x03;                    /* complete data */
+			p[2] = 0x01;                    /* no fragmentation preference */
+			p[3] = dl;
+			memcpy(p + 4, l + 1, dl);
+			uint8_t k = 0;
+			if (!s.adv_set) {
+				s.ch.len[k++] = mk_ext_adv_param(s.ch.cmd[0], NULL);
+				s.ch.want_type = 0x00;
+			}
+			s.ch.len[k] = mkcmd(s.ch.cmd[k], op == OP_LE_ADV_DATA ? OP_LE_EXT_ADV_DATA : OP_LE_EXT_SCAN_RSP, p,
+			    (uint8_t)(4u + dl));
+			s.ch.n = (uint8_t)(k + 1u);
+			return chain_start(op, 0x03);
+		}
+	case OP_LE_ADV_ENABLE:
+		if (plen < 1) {
+			break;
+		} else {
+			if (!s.adv_set && l[0] == 0) {
+				answer(op, 0);          /* nothing advertises: a legacy disable succeeds */
+				return NEGRONI_BT_SHIM_DONE;
+			}
+			/* review F3: high duty directed needs a duration (1.28 s = 0x0080 x 10 ms), as the legacy timeout */
+			bool hd = s.adv_set && s.adv_type == 0x01 && l[0] != 0;
+			const uint8_t p[6] = { l[0] ? 0x01 : 0x00, 0x01, 0x00, hd ? 0x80 : 0x00, 0x00, 0x00 };
+			uint8_t k = 0;
+			if (!s.adv_set) {
+				s.ch.len[k++] = mk_ext_adv_param(s.ch.cmd[0], NULL);
+				s.ch.want_type = 0x00;
+			}
+			s.ch.len[k] = mkcmd(s.ch.cmd[k], OP_LE_EXT_ADV_EN, p, sizeof(p));
+			s.ch.n = (uint8_t)(k + 1u);
+			return chain_start(op, 0x03);
+		}
+	case OP_LE_RAND_ADDR:
+		if (plen < 6) {
+			break;
+		}
+		memcpy(s.rnd, l, 6);
+		s.rnd_known = true;
+		if (!s.adv_set) {
+			return NEGRONI_BT_SHIM_PASS;
+		} else {
+			const uint8_t p[7] = { 0x00, l[0], l[1], l[2], l[3], l[4], l[5] };
+			s.ch.len[0] = mkcmd(s.ch.cmd[0], OP_LE_RAND_ADDR, l, 6);
+			s.ch.len[1] = mkcmd(s.ch.cmd[1], OP_LE_SET_RAND, p, sizeof(p));
+			s.ch.n = 2;
+			return chain_start(op, 0x01);
+		}
+	default:
+		break;
+	}
+	return NEGRONI_BT_SHIM_PASS;
+}
+
+/* LE Extended Advertising Report -> LE Advertising Report(s); always NEGRONI_BT_SHIM_DROP for the original */
+static int
+lext_report(const uint8_t *pkt, uint32_t len)
+{
+	uint32_t end = MIN(len, 3u + pkt[2]);
+	uint32_t at = 5;                        /* 04 3e plen 0d num */
+	uint8_t num = len > 4 ? pkt[4] : 0;
+	for (uint8_t r = 0; r < num && at + 24u <= end; r++) {
+		const uint8_t *e = pkt + at;
+		uint16_t et = le16(e);
+		uint8_t dl = e[23];
+		if (at + 24u + dl > end) {
+			break;
+		}
+		at += 24u + dl;
+		s.n_rep_in++;
+		if ((et & 0x10u) == 0 || dl > 31 || e[2] == 0xff) {
+			s.n_rep_drop++;         /* extended PDU (a legacy scan does not see it) or anonymous */
+			continue;
+		}
+		uint8_t lt;
+		if (et & 0x08u) {
+			lt = 0x04;              /* SCAN_RSP */
+		} else if (et & 0x04u) {
+			lt = 0x01;              /* ADV_DIRECT_IND */
+		} else if ((et & 0x03u) == 0x03u) {
+			lt = 0x00;              /* ADV_IND */
+		} else if (et & 0x02u) {
+			lt = 0x02;              /* ADV_SCAN_IND */
+		} else {
+			lt = 0x03;              /* ADV_NONCONN_IND */
+		}
+		uint8_t ev[3 + 12 + 31];        /* plen = sub, num, type, addr type, addr(6), len, data, RSSI = 12 + dl */
+		ev[0] = H4_EVT;
+		ev[1] = EV_LE_META;
+		ev[2] = (uint8_t)(12u + dl);
+		ev[3] = 0x02;
+		ev[4] = 1;
+		ev[5] = lt;
+		ev[6] = e[2];
+		memcpy(ev + 7, e + 3, 6);
+		ev[13] = dl;
+		memcpy(ev + 14, e + 24, dl);
+		ev[14 + dl] = e[13];            /* RSSI */
+		s.n_rep_out++;
+		negroni_bt_h4_inject(ev, 14u + dl + 1u);
+	}
+	if (s.n_rep_in > 0 && s.n_rep_in != s.n_rep_logged && (s.n_rep_logged == 0 || s.n_rep_in - s.n_rep_logged >= 1024u)) {
+		s.n_rep_logged = s.n_rep_in;
+		SAY("lext: extended advertising reports %u in, %u legacy reports out, %u dropped (extended PDU)\n",
+		    s.n_rep_in, s.n_rep_out, s.n_rep_drop);
+	}
+	return NEGRONI_BT_SHIM_DROP;
+}
+
+/* controller -> host in translation mode; NEGRONI_BT_SHIM_PASS = go on with the normal rx checks */
+static int
+lext_rx(uint8_t *pkt, uint32_t len)
+{
+	if (pkt[1] == EV_LE_META && len >= 4) {
+		if (pkt[3] == 0x0d) {
+			return lext_report(pkt, len);
+		}
+		if (pkt[3] == 0x12 || pkt[3] == 0x11) {
+			if (s.n_ev_drop++ < 8) {
+				SAY("lext: LE Meta sub %#x (%s) not delivered (bluetoothd runs legacy advertising/scanning)\n",
+				    pkt[3], pkt[3] == 0x12 ? "Advertising Set Terminated" : "Scan Timeout");
+			}
+			return NEGRONI_BT_SHIM_DROP;
+		}
+		return NEGRONI_BT_SHIM_PASS;
+	}
+	bool cc = pkt[1] == EV_CMD_COMPLETE && pkt[2] >= 4 && len >= 7;
+	bool cs = pkt[1] == EV_CMD_STATUS && pkt[2] >= 4 && len >= 7;
+	if (!cc && !cs) {
+		return NEGRONI_BT_SHIM_PASS;
+	}
+	uint8_t *opp = cc ? pkt + 4 : pkt + 5;
+	uint16_t op = le16(opp);
+	uint8_t st = cc ? pkt[6] : pkt[3];
+	if (chain_rx(op, st)) {
+		return NEGRONI_BT_SHIM_DROP;
+	}
+	uint16_t to = 0;
+	if (op == OP_LE_EXT_SCAN_PARAM && s.pend_scan_p) {
+		s.pend_scan_p--;
+		to = OP_LE_SCAN_PARAM;
+	} else if (op == OP_LE_EXT_SCAN_EN && s.pend_scan_e) {
+		s.pend_scan_e--;
+		to = OP_LE_SCAN_ENABLE;
+	} else if (op == OP_LE_EXT_CONN && s.pend_conn) {
+		s.pend_conn--;
+		to = OP_LE_CREATE_CONN;
+	}
+	if (to) {
+		opp[0] = (uint8_t)to;
+		opp[1] = (uint8_t)(to >> 8);
+		if (st != 0 || s.n_xlat < 16) {
+			SAY("lext: %#06x answer (status %#x) delivered as legacy %#06x\n", op, st, to);
+		}
+	}
+	return NEGRONI_BT_SHIM_PASS;
+}
+
+int
+negroni_bt_shim_tx(uint8_t *pkt, uint32_t len)
+{
+	if (s.policy == 0 || len < 4 || pkt[0] != H4_CMD) {
+		return NEGRONI_BT_SHIM_PASS;
+	}
+	uint16_t op = le16(pkt + 1);
+	if (s.lext && (op >> 10) == 0x08u) {
+		int r = lext_tx(pkt, len);
+		if (r != NEGRONI_BT_SHIM_PASS) {
+			return r;
+		}
+	} else if (s.lext && op == OP_RESET) {
+		(void)lext_tx(pkt, len);
+	}
+	if (s.fix && op == OP_WRITE_LE_HOST && len >= 6 && pkt[3] >= 2 && pkt[5] != 0) {
+		if (!s.lehost_logged) {
+			s.lehost_logged = true;
+			SAY("init fix: 0x0c6d Write_LE_Host_Support LE %#x Simultaneous_LE_Host %#x -> 0x00 (Core 4.1+), sent to "
+			    "the chip\n", pkt[4], pkt[5]);
+		}
+		pkt[5] = 0;
+		return NEGRONI_BT_SHIM_PASS;
+	}
+	if (s.fix && s.cmds_known && ((op == OP_WRITE_ERR_DATA && !s.chip_err_wr) ||
+	    (op == OP_READ_ERR_DATA && !s.chip_err_rd))) {
+		uint16_t k = s.seen[op & (SEEN_SLOTS - 1u)]++;
+		s.n_local++;
+		if (k < 4 || (k % 64u) == 0) {
+			SAY("init fix: %#06x plen %u (#%u) answered locally with status 0 (not in the chip's supported-commands "
+			    "mask)\n", op, pkt[3], k + 1u);
+		}
+		if (op == OP_READ_ERR_DATA) {
+			const uint8_t ev[8] = { H4_EVT, EV_CMD_COMPLETE, 5, 1, (uint8_t)op, (uint8_t)(op >> 8), 0, 0 };
+			negroni_bt_h4_inject(ev, sizeof(ev));
+		} else {
+			answer(op, 0);
+		}
+		return NEGRONI_BT_SHIM_DONE;
+	}
+	if ((op >> 10) != OGF_VENDOR) {
+		return NEGRONI_BT_SHIM_PASS;
+	}
+	uint8_t status = 0x01;
+	const char *name = "not in the table (Broadcom/Apple VSC; the QCA opcode space differs)";
+	for (size_t i = 0; i < sizeof(shim_ops) / sizeof(shim_ops[0]); i++) {
+		if (shim_ops[i].op == op) {
+			status = shim_ops[i].status;
+			name = shim_ops[i].name;
+			break;
+		}
+	}
+	if (s.policy == 2) {
+		status = 0x00;
+	}
+	uint16_t k = s.seen[op & (SEEN_SLOTS - 1u)]++;
+	s.n_local++;
+	if (k < 4 || (k % 64u) == 0) {
+		SAY("intercepted %#06x plen %u (#%u) -> local Command Complete status %#x + %u data bytes: %s\n", op, pkt[3],
+		    k + 1u, status, s.vscdata, name);
+	}
+	answer_vsc(op, status, pkt[3] > 0 && len >= 5 ? pkt[4] : 0);
+	return NEGRONI_BT_SHIM_DONE;
+}
+
+int
+negroni_bt_shim_rx(uint8_t *pkt, uint32_t len)
+{
+	if (s.policy == 0 || len < 3 || pkt[0] != H4_EVT) {
+		return NEGRONI_BT_SHIM_PASS;
+	}
+	if (pkt[1] == EV_VENDOR) {
+		if (s.n_vse++ < 16) {
+			SAY("controller vendor event (plen %u) not delivered (QCA debug/log; iOS reads 0xff as its own)\n",
+			    pkt[2]);
+		}
+		return NEGRONI_BT_SHIM_DROP;
+	}
+	if (s.lext && lext_rx(pkt, len) == NEGRONI_BT_SHIM_DROP) {
+		return NEGRONI_BT_SHIM_DROP;
+	}
+	/* 0336: the supported-commands mask (04 0e 44 01 02 10 00 <64 bytes>): log it, add the Erroneous Data bits */
+	if (pkt[1] == EV_CMD_COMPLETE && pkt[2] >= 68 && len >= 71 && le16(pkt + 4) == OP_READ_SUPPORTED_COMMANDS &&
+	    pkt[6] == 0) {
+		uint8_t *m = pkt + 7;
+		if (!s.cmds_known) {
+			char hx[3 * 32 + 1];
+			for (unsigned half = 0; half < 2; half++) {
+				for (unsigned i = 0; i < 32; i++) {
+					snprintf(hx + 3 * i, 4, " %02x", m[32 * half + i]);
+				}
+				SAY("supported commands octets %u-%u:%s\n", 32 * half, 32 * half + 31, hx);
+			}
+		}
+		s.cmds_known = true;
+		s.chip_err_rd = (m[CMDS_OCTET_ERR] & 0x04u) != 0;
+		s.chip_err_wr = (m[CMDS_OCTET_ERR] & 0x08u) != 0;
+		if (s.fix && (m[CMDS_OCTET_ERR] & CMDS_ERR_BITS) != CMDS_ERR_BITS) {
+			SAY("supported commands: octet 18 %#x -> %#x (Read/Write_Default_Erroneous_Data_Reporting answered here)\n",
+			    m[CMDS_OCTET_ERR], m[CMDS_OCTET_ERR] | CMDS_ERR_BITS);
+			m[CMDS_OCTET_ERR] |= CMDS_ERR_BITS;
+		}
+	}
+	/* 0337: chip answers that bluetoothd treats as fatal or that block its init */
+	if (s.fix && pkt[1] == EV_CMD_COMPLETE && pkt[2] >= 4 && len >= 7 && pkt[6] != 0) {
+		uint16_t op = le16(pkt + 4);
+		if (op == OP_WRITE_LE_HOST) {
+			if (!s.lehost_rej_logged) {
+				s.lehost_rej_logged = true;
+				SAY("init fix: the chip still rejects 0x0c6d (status %#x) -> status 0\n", pkt[6]);
+			}
+			pkt[6] = 0;
+		} else if (op == OP_LE_READ_ADV_TX_POWER && pkt[6] == 0x0c && pkt[2] >= 5 && len >= 8) {
+			if (!s.advtx_logged) {
+				s.advtx_logged = true;
+				SAY("init fix: 0x2007 LE_Read_Advertising_Physical_Channel_Tx_Power status 0xc (Command Disallowed) "
+				    "-> status 0, 0 dBm\n");
+			}
+			pkt[6] = 0;
+			pkt[7] = 0;
+		}
+	}
+	/* 0336: log every standard command the chip rejects (Command Complete or Command Status with status != 0) */
+	if ((pkt[1] == EV_CMD_COMPLETE && pkt[2] >= 4 && len >= 7 && pkt[6] != 0) ||
+	    (pkt[1] == EV_CMD_STATUS && pkt[2] >= 4 && len >= 7 && pkt[3] != 0)) {
+		bool cc = pkt[1] == EV_CMD_COMPLETE;
+		uint16_t op = cc ? le16(pkt + 4) : le16(pkt + 5);
+		uint8_t st = cc ? pkt[6] : pkt[3];
+		if ((op >> 10) != OGF_VENDOR && s.rej[op & (SEEN_SLOTS - 1u)]++ < 4) {
+			SAY("controller rejected %#06x: %s status %#x\n", op, cc ? "Command Complete" : "Command Status", st);
+		}
+	}
+	/* 04 0e plen ncmd op(2) status hci_ver hci_rev(2) lmp_ver mfr(2) lmp_subver(2): plen 12, len 15 */
+	if (pkt[1] == EV_CMD_COMPLETE && pkt[2] >= 12 && len >= 15 && le16(pkt + 4) == OP_READ_LOCAL_VERSION &&
+	    pkt[6] == 0) {
+		uint16_t mfr = le16(pkt + 11);
+		if (!s.version_logged) {
+			s.version_logged = true;
+			SAY("Read_Local_Version: HCI %u rev %#06x, LMP %u subversion %#06x, manufacturer %#06x%s\n", pkt[7],
+			    le16(pkt + 8), pkt[10], le16(pkt + 13), mfr, mfr == 0x1d ? " (Qualcomm)" : "");
+		}
+		if (s.mfr && s.mfr != mfr) {
+			pkt[11] = (uint8_t)s.mfr;
+			pkt[12] = (uint8_t)(s.mfr >> 8);
+			SAY("Read_Local_Version: manufacturer %#06x rewritten to %#06x (negronibt_mfr)\n", mfr, s.mfr & 0xffffu);
+		}
+	}
+	return NEGRONI_BT_SHIM_PASS;
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
