+static bool
+step_core_start(void)
+{
+	if (!core_space_on) {
+		printf("NEGRONI ADRENO: 20 stop: no 3D core memory (step 19)\n");
+		return false;
+	}
+	announce("write the 3D core's registers (Linux hw_init, A730)");
+	gpu_put("GBIF_HALT", REG_GBIF_HALT, 0);
+	gpu_put("RBBM_GBIF_HALT", REG_RBBM_GBIF_HALT, 0);
+	gpu_put("RBBM_SECVID_TSB_CNTL", REG_RBBM_SECVID_TSB_CNTL, 0);
+	gpu_put64("RBBM_SECVID_TSB_TRUSTED_BASE", REG_RBBM_SECVID_TSB_BASE, 0);
+	gpu_put("RBBM_SECVID_TSB_TRUSTED_SIZE", REG_RBBM_SECVID_TSB_SIZE, 0);
+	gpu_put("RBBM_GBIF_CLIENT_QOS_CNTL", REG_RBBM_GBIF_CLIENT_QOS, 0x2120212);
+	gpu_put("UCHE_GBIF_GX_CONFIG", REG_UCHE_GBIF_GX_CONFIG, 0x10240e0);
+	gpu_put("RBBM_PERFCTR_GPU_BUSY_MASKED", REG_RBBM_PERFCTR_BUSY, 0xffffffff);
+	gpu_put64("UCHE_TRAP_BASE", REG_UCHE_TRAP_BASE, UCHE_TRAP_BASE_VALUE);
+	gpu_put64("UCHE_WRITE_THRU_BASE", REG_UCHE_WRITE_THRU, UCHE_TRAP_BASE_VALUE);
+	gpu_put("UCHE_CACHE_WAYS", REG_UCHE_CACHE_WAYS, 1u << 23);
+	gpu_put("CP_AHB_CNTL", REG_CP_AHB_CNTL, 1);
+	gpu_put("RBBM_PERFCTR_CNTL", REG_RBBM_PERFCTR_CNTL, 1);
+	/* a6xx_set_ubwc_config for A730: highest bank bit 16 (hbb_lo 3), ubwc 4.0, macrotile mode 1 */
+	gpu_put("RB_NC_MODE_CNTL", REG_RB_NC_MODE_CNTL, 1u << 11 | 1u << 4 | 3u << 1);
+	gpu_put("TPL1_NC_MODE_CNTL", REG_TPL1_NC_MODE_CNTL, 3u << 1);
+	gpu_put("SP_NC_MODE_CNTL", REG_SP_NC_MODE_CNTL, 2u << 4 | 3u << 1);
+	gpu_put("GRAS_NC_MODE_CNTL", REG_GRAS_NC_MODE_CNTL, 3u << 5);
+	gpu_put("UCHE_MODE_CNTL", REG_UCHE_MODE_CNTL, 3u << 21);
+	gpu_put("RBBM_NC_MODE_CNTL", REG_RBBM_NC_MODE_CNTL, 1);
+	gpu_put("RBBM_INTERFACE_HANG_INT_CNTL", REG_RBBM_HANG_INT_CNTL, 1u << 30 | 0xcfffff);
+	gpu_put("UCHE_CLIENT_PF", REG_UCHE_CLIENT_PF, 1u << 7 | 1);
+	gpu_put("UCHE_CMDQ_CONFIG", REG_UCHE_CMDQ_CONFIG, 6u << 16 | 6u << 12 | 9u << 8 | 1u << 3 | 1u << 2 | 2u);
+	gpu_put("CP_APRIV_CNTL", REG_CP_APRIV_CNTL, 0x6f);
+	gpu_put("CP_BV_APRIV_CNTL", REG_CP_BV_APRIV_CNTL, 0xf);
+	gpu_put("CP_LPAC_APRIV_CNTL", REG_CP_LPAC_APRIV_CNTL, 0xf);
+	gpu_put("RB_CMP_DBG_ECO_CNTL", REG_RB_CMP_DBG_ECO_CNTL,
+	    rd(gpu_regs + GPU_WORD(REG_RB_CMP_DBG_ECO_CNTL)) | 1u << 11);
+	k_step20();                     /* patch 0298: power counter, CP_PROTECT, CHICKEN_DBG, HWCG (KGSL gen7_start order) */
+	gpu_put64("CP_SQE_INSTR_BASE", REG_CP_SQE_INSTR_BASE, CORE_SQE_ADDRESS);
+	gpu_put64("CP_RB_BASE", REG_CP_RB_BASE, CORE_RING_ADDRESS);
+	k_args();
+	gpu_put("CP_RB_CNTL", REG_CP_RB_CNTL, k_rptr_shadow ? CP_RB_CNTL_VALUE & ~(1u << 27) : CP_RB_CNTL_VALUE);   /* 0298 */
+	gpu_put64("CP_RB_RPTR_ADDR", REG_CP_RB_RPTR_ADDR, CORE_SCRATCH_ADDRESS + 0x80);
+	gpu_put64("CP_BV_RB_RPTR_ADDR", REG_CP_BV_RB_RPTR_ADDR, CORE_SCRATCH_ADDRESS + 0x100);
+
+	announce("start the 3D core's command processor (SQE)");
+	core_runs = true;
+	gpu_put("CP_SQE_CNTL", REG_CP_SQE_CNTL, 1);
+	delay(pm_rewaking ? 1000 : 20000);
+	printf("NEGRONI ADRENO: 20 alive after the SQE start: RBBM_STATUS %#x, CP_HW_FAULT %#x, rptr %u\n",
+	    rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS)), rd(gpu_regs + GPU_WORD(REG_CP_HW_FAULT)),
+	    rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR)));
+	if (space_faulted(&core_space)) {
+		return false;
+	}
+	/* a7xx_cp_init; patch 0285: with IFPC on, the power-up register list (mask BIT(8), KGSL gen7_cp_init_cmds) */
+	bool list = pm_ifpc_ok && pwrup_list_build();
+	ring_command(CP_THREAD_CONTROL, 1);
+	ring(1u << 27);
+	ring_command(CP_ME_INIT, 7);
+	ring(1u << 0 | 1u << 1 | 1u << 3 | 1u << 6 | (list ? 1u << 8 : 0) | (k_dms_off ? 1u << 11 : 0));       /* 0298: BIT(11) DMS off */
+	ring(0x00000003);
+	ring(0x20000000);
+	ring(0x00000002);
+	ring(list ? CORE_SCRATCH_ADDRESS + PWRUP_AT : 0);
+	ring(0);
+	ring(list ? 1u << 31 : 0);
+	if (!ring_run("initialize its command processor (CP_ME_INIT)")) {
+		return false;
+	}
+	printf("NEGRONI ADRENO: 20 THE 3D CORE TAKES COMMANDS\n");
+	clock_probe_start();
+	clock_measure("with the CP running");
+	return true;
+}
+
+static bool
+step_zap_and_secure(void)
+{
+	const uint8_t *mdt, *seg;
+	uint32_t mdt_size = 0, seg_size = 0;
+	uint64_t answer = ~0ull;
+	vm_offset_t page = 0;
+	volatile uint8_t *mem;
+
+	if (!core_runs) {
+		printf("NEGRONI ADRENO: 21 stop: the command processor does not run (step 20)\n");
+		return false;
+	}
+	/*
+	 * qcom_mdt_pas_init / qcom_mdt_load: the PT_LOAD segments go at (p_paddr - lowest p_paddr) in the
+	 * reserved memory, each from its own .bNN file; TrustZone is told the span from the lowest
+	 * address to the highest end rounded up to 4K. On the A730 zap that is segment 1 (.b01).
+	 */
+	uint32_t min_pa = ~0u, max_pa = 0, nseg;
+	mdt = negroni_fw_get("a730_zap.mdt", &mdt_size);
+	if (mdt == NULL || mdt_size < 52 || mdt_size > PAGE_SIZE || memcmp(mdt, "\177ELF\1", 5) != 0) {
+		printf("NEGRONI ADRENO: 21 stop: no usable a730_zap.mdt\n");
+		return false;
+	}
+	uint32_t phoff;
+	memcpy(&phoff, mdt + 28, 4);
+	nseg = (uint32_t)(mdt[44] | mdt[45] << 8);
+	if (phoff + 32 * nseg > mdt_size || nseg > 16) {
+		printf("NEGRONI ADRENO: 21 stop: bad program header table\n");
+		return false;
+	}
+	for (uint32_t i = 0; i < nseg; i++) {
+		uint32_t ph[8];
+		memcpy(ph, mdt + phoff + 32 * i, sizeof(ph));
+		bool hash = ((ph[6] >> 24) & 7) == 2;
+		if (ph[0] != 1 || hash || ph[5] == 0) {
+			continue;
+		}
+		min_pa = MIN(min_pa, ph[3]);
+		max_pa = MAX(max_pa, (ph[3] + ph[5] + 0xfffu) & ~0xfffu);
+	}
+	if (min_pa == ~0u || max_pa - min_pa > ZAP_MEMORY_SIZE) {
+		printf("NEGRONI ADRENO: 21 stop: zap load range %#x..%#x does not fit\n", min_pa, max_pa);
+		return false;
+	}
+	printf("NEGRONI ADRENO: 21 zap: %u segments, load range %#x..%#x\n", nseg, min_pa, max_pa);
+	announce("ask TrustZone to drop a zap shader an earlier run may have left");
+	scm("PAS shutdown (zap)", SCM_64 | SCM_SIP | SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_GPU, 0, 0, &answer);
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	memcpy((void *)page, mdt, mdt_size);
+	clean_dcache((vm_offset_t)page, PAGE_SIZE, FALSE);
+	answer = ~0ull;
+	if (scm("PAS init image (zap)", SCM_64 | SCM_SIP | SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_GPU,
+	    kvtophys(page), 0, &answer) != 0 || answer != 0) {
+		printf("NEGRONI ADRENO: 21 stop: TrustZone refuses the zap header (%#llx)\n", answer);
+		return false;
+	}
+	answer = ~0ull;
+	if (scm("PAS mem setup (zap)", SCM_64 | SCM_SIP | SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_GPU, ZAP_MEMORY,
+	    max_pa - min_pa, &answer) != 0 || answer != 0) {
+		printf("NEGRONI ADRENO: 21 stop: TrustZone refuses the zap memory (%#llx)\n", answer);
+		return false;
+	}
+	announce("write the zap PT_LOAD segments into 0x8b91a000 and ask TrustZone to authenticate and run it");
+	mem = (volatile uint8_t *)ml_io_map_wcomb(ZAP_MEMORY, ZAP_MEMORY_SIZE);
+	for (uint32_t i = 0; i < ZAP_MEMORY_SIZE; i++) {
+		mem[i] = 0;
+	}
+	for (uint32_t i = 0; i < nseg; i++) {
+		uint32_t ph[8];
+		char name[24];
+		memcpy(ph, mdt + phoff + 32 * i, sizeof(ph));
+		if (ph[0] != 1 || ((ph[6] >> 24) & 7) == 2 || ph[4] == 0) {
+			continue;
+		}
+		snprintf(name, sizeof(name), "a730_zap.b%02u", i);
+		seg = negroni_fw_get(name, &seg_size);
+		if (seg == NULL || seg_size < ph[4] || ph[3] - min_pa + ph[4] > ZAP_MEMORY_SIZE) {
+			printf("NEGRONI ADRENO: 21 stop: segment %u (%s) missing or too large\n", i, name);
+			return false;
+		}
+		for (uint32_t b = 0; b < ph[4]; b++) {
+			mem[ph[3] - min_pa + b] = seg[b];
+		}
+		printf("NEGRONI ADRENO: 21 zap segment %u (%s): %#x bytes at +%#x\n", i, name, ph[4], ph[3] - min_pa);
+	}
+	__asm__ volatile ("dsb sy");
+	answer = ~0ull;
+	if (scm("PAS auth and reset (zap)", SCM_64 | SCM_SIP | SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_GPU, 0, 0,
+	    &answer) != 0 || answer != 0) {
+		printf("NEGRONI ADRENO: 21 stop: TrustZone does not authenticate the zap shader (%#llx)\n", answer);
+		return false;
+	}
+	printf("NEGRONI ADRENO: 21 TRUSTZONE RUNS THE ZAP SHADER\n");
+	ring_command(CP_SET_SECURE_MODE, 1);
+	ring(0);
+	if (!ring_run("leave secure mode")) {
+		return false;
+	}
+	core_unsecure = true;
+	ring_command(CP_MEM_WRITE, 3);
+	ring(CORE_SCRATCH_ADDRESS);
+	ring(0);
+	ring(0x600dc0de);
+	if (!ring_run("write a word into our page")) {
+		return false;
+	}
+	to_memory(core_scratch.memory, 64);
+	uint32_t word = *(volatile uint32_t *)core_scratch.memory;
+	printf("NEGRONI ADRENO: 21 scratch reads %#x: %s\n", word,
+	    word == 0x600dc0de ? "THE 3D CORE WRITES OUR MEMORY ON COMMAND" : "not what it was told");
+	return word == 0x600dc0de;
+}
+
+/* The 2D engine fills rectangles (Mesa fd6_clear_surface), sysmem, BGRA linear. */
+#define REG_GRAS_2D_BLIT_CNTL   0x8400
+#define REG_GRAS_2D_DST_TL      0x8405
+#define REG_GRAS_2D_DST_BR      0x8406
+#define REG_RB_2D_BLIT_CNTL     0x8c00
+#define REG_RB_2D_PIXEL_CNTL    0x8c01
+#define REG_RB_2D_DST_INFO      0x8c17
+#define REG_RB_2D_DST           0x8c18
+#define REG_RB_2D_DST_PITCH     0x8c1a
+#define REG_RB_2D_SRC_SOLID_C0  0x8c2c
+#define REG_SP_2D_DST_FORMAT    0xacc0
+#define FORMAT_8888             0x30
+#define BLIT_SOLID_8888         (1u << 7 | FORMAT_8888 << 8 | 0xfu << 20 | 0x10u << 24)
+#define DST_BGRA_LINEAR         (FORMAT_8888 | 1u << 10)
+#define TARGET_WIDTH            1080
+#define TARGET_HEIGHT           2400
+#define TARGET_ROW              4352
+
+/* CP_REG_TO_MEM of one 64-bit register pair into the scratch page (patch 0236) */
+#define CP_REG_TO_MEM           0x3e
+static void
+ring_sample(uint32_t reg, uint32_t at)
+{
+	ring_command(CP_REG_TO_MEM, 3);
+	ring(reg | 2u << 18 | 1u << 30);        /* CNT 2, 64B */
+	ring(CORE_SCRATCH_ADDRESS + at);
+	ring(0);
+}
+
+static void
+ring_fill(uint32_t top, uint32_t bottom, uint32_t r, uint32_t g, uint32_t b)
+{
+	ring_register(REG_GRAS_2D_DST_TL, top << 16);
+	ring_register(REG_GRAS_2D_DST_BR, (TARGET_WIDTH - 1) | (bottom - 1) << 16);
+	ring_register(REG_RB_2D_SRC_SOLID_C0, r);
+	ring_register(REG_RB_2D_SRC_SOLID_C0 + 1, g);
+	ring_register(REG_RB_2D_SRC_SOLID_C0 + 2, b);
+	ring_register(REG_RB_2D_SRC_SOLID_C0 + 3, 255);
+	ring_register(REG_RB_2D_BLIT_CNTL, BLIT_SOLID_8888);
+	ring_register(REG_GRAS_2D_BLIT_CNTL, BLIT_SOLID_8888);
+	ring_register(REG_SP_2D_DST_FORMAT, 1 | FORMAT_8888 << 3 | 0xfu << 12);
+	ring_register(REG_RB_2D_PIXEL_CNTL, 0);
+	ring_register(REG_RB_2D_DST_INFO, DST_BGRA_LINEAR);
+	ring_register(REG_RB_2D_DST, CORE_TARGET_ADDRESS);
+	ring_register(REG_RB_2D_DST + 1, 0);
+	ring_register(REG_RB_2D_DST_PITCH, TARGET_ROW >> 6);
+	ring_command(CP_WAIT_FOR_IDLE, 0);
+	ring_command(CP_BLIT, 1);
+	ring(3);
+}
+
+static bool
+step_frame(void)
+{
+	if (!core_unsecure) {
+		printf("NEGRONI ADRENO: 22 stop: the 3D core is still secure (step 21)\n");
+		return false;
+	}
+	announce("make 10 MB for a picture and have the 2D engine fill three bands");
+	if (!core_block(&core_target, "picture", CORE_TARGET_ADDRESS, TARGET_ROW * TARGET_HEIGHT, 0)) {
+		return false;
+	}
+	for (uint32_t i = 0; i < core_space.table_count; i++) {
+		to_memory((vm_offset_t)core_space.tables[i].table, 4096);
+	}
+	volatile uint64_t *t = (volatile uint64_t *)(core_scratch.memory + CLK_AT);
+	if (clk_timetest) {
+		/* patch 0236: AO counter and CP cycles before and after the blit, as Linux a7xx_submit does */
+		t[0] = t[1] = t[2] = t[3] = 0;
+		to_memory(core_scratch.memory, 4096);
+		ring_sample(CLK_CP_ALWAYS_ON, CLK_AT);
+		ring_sample(CLK_RBBM_PERFCTR_CP_0, CLK_AT + 8);
+	}
+	ring_fill(0, 800, 255, 128, 0);
+	ring_fill(800, 1600, 255, 255, 255);
+	ring_fill(1600, TARGET_HEIGHT, 0, 128, 255);
+	ring_command(CP_EVENT_WRITE7, 1);
+	ring(EVENT_CCU_FLUSH_COLOR);
+	ring_command(CP_EVENT_WRITE7, 1);
+	ring(EVENT_CACHE_CLEAN);
+	ring_command(CP_WAIT_FOR_IDLE, 0);
+	if (clk_timetest) {
+		ring_sample(CLK_CP_ALWAYS_ON, CLK_AT + 16);
+		ring_sample(CLK_RBBM_PERFCTR_CP_0, CLK_AT + 24);
+		ring_command(CP_WAIT_FOR_IDLE, 0);
+	}
+	if (!ring_run("fill a picture")) {
+		return false;
+	}
+	if (clk_timetest) {
+		to_memory(core_scratch.memory, 4096);
+		uint64_t ticks = t[2] - t[0], cycles = t[3] - t[1];
+		printf("NEGRONI ADRENO: 22 blit %u.%u Mpx in %llu us (AO ticks %llu), CP cycles %llu (%u MHz); raw AO %#llx..%#llx\n",
+		    TARGET_WIDTH * TARGET_HEIGHT / 1000000, TARGET_WIDTH * TARGET_HEIGHT / 100000 % 10, ticks * 10 / 192, ticks,
+		    cycles, clk_mhz(cycles, ticks), t[0], t[2]);
+	}
+	to_memory(core_target.memory, core_target.size);
+	const volatile uint8_t *px = (const volatile uint8_t *)core_target.memory;
+	uint32_t mid = 1200 * TARGET_ROW + 2160, last = 2399 * TARGET_ROW + 4316;
+	printf("NEGRONI ADRENO: 22 pixels (B G R A): top %02x %02x %02x %02x (want 00 80 ff ff), middle %02x %02x %02x %02x "
+	    "(want ff ff ff ff), bottom %02x %02x %02x %02x (want ff 80 00 ff)\n", px[0], px[1], px[2], px[3], px[mid],
+	    px[mid + 1], px[mid + 2], px[mid + 3], px[last], px[last + 1], px[last + 2], px[last + 3]);
+	bool ok = px[1] == 0x80 && px[2] == 0xff && px[mid] == 0xff && px[last] == 0xff && px[last + 2] == 0;
+	printf("NEGRONI ADRENO: 22 %s\n", ok ? "THE GPU DREW A PICTURE" : "the picture is not what was drawn");
+	return ok;
+}
+
+static bool (*const steps[])(void) = {
+	step_gcc, step_gpucc_read, step_gmu_read_if_on, step_cx_power, step_clocks, step_gmu_first_words,
+	step_rscc, step_smmu, step_smmu_context, step_gmu_memory, step_trustzone,
+	step_zap_signature, step_gmu_space, step_gmu_firmware, step_gmu_start, step_hfi_start,
+	step_hfi_messages, step_core_power, step_core_space, step_core_start, step_zap_and_secure, step_frame,
+};
+
+
+/*
+ * The way back (Linux a6xx_gmu_shutdown, a6xx_rpmh_stop): when the ladder ends, nothing of the
+ * GPU block is left running unless negroniadreno_keep=1. Slumber (the GMU powers the 3D core down
+ * and drops its votes), halt the GMU, put the GPU RSC to sleep, take the SMMU routes and contexts
+ * back, have TrustZone drop the zap shader, collapse CX.
+ */
+static void
+smmu_space_off(struct gpu_space *space, uint32_t match)
+{
+	put(smmu, "SMR (off)", SMMU_SMR(match), 0);
+	put(smmu, "S2CR (fault)", SMMU_S2CR(match), SMMU_S2CR_FAULT);
+	put(smmu, "CB SCTLR (off)", (smmu_pages + space->context) * smmu_page + SMMU_CB_SCTLR, 0);
+}
+
+static void
+gpu_stop(void)
+{
+	uint64_t answer = 0;
+
+	step = 99;
+	printf("NEGRONI ADRENO: stopping the GPU block\n");
+	if (gmu_started) {
+		if (gx_on) {
+			wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << OOB_GPU_SET_ACK);      /* clear OOB GPU_SET */
+		}
+		uint32_t slumber[3] = { 0, 0, 0 };
+		hfi_send("PREPARE_SLUMBER", 33, slumber, sizeof(slumber));
+		gmu_put("GMU2HOST_INTR_MASK", 0x1f993, ~0u);
+		gmu_put("CM3_SYSRESET", GMU_CM3_SYSRESET, 1);
+		gmu_put("RSCC_CONTROL_REQ (sleep)", 0x23b07, 1);
+		bool asleep = wait_for(rscc + RSCC_STATUS0, 1u << 16, 1u << 16, 10);
+		gmu_put("RSCC_CONTROL_REQ", 0x23b07, 0);
+		printf("NEGRONI ADRENO: GPU RSC %s, GX GDSC %#x\n", asleep ? "asleep" : "DID NOT SLEEP",
+		    rd(gpucc + GPUCC_GX_GDSCR));
+	}
+	if (core_space_on) {
+		smmu_space_off(&core_space, core_space.match);
+	}
+	if (gmu_space_on) {
+		smmu_space_off(&gmu_space, gmu_space.match);
+	}
+	if (core_unsecure || core_runs) {
+		scm("PAS shutdown (zap)", SCM_64 | SCM_SIP | SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_GPU, 0, 0, &answer);
+	}
+	if (cx_is_on() && !(rd(gpucc + GPUCC_GX_GDSCR) & GDSC_PWR_ON)) {
+		put(gpucc, "GPU_CX_GDSCR (collapse)", GPUCC_CX_GDSCR, rd(gpucc + GPUCC_CX_GDSCR) | GDSC_SW_COLLAPSE);
+	}
+	printf("NEGRONI ADRENO: GPU block stopped\n");
+}
+
+/*
+ * ---- the GPU kept on, for programs to draw with (iokit/Kernel/arm/NegroniGPU.cpp) ----
+ *
+ * With negroniadreno_keep=1 and all 22 steps done, the 3D core stays running and these are what
+ * the RedwoodGPU service (Linux msm DRM for Mesa's freedreno) is built on: GET_PARAM answers,
+ * addresses in context 0 of the GPU's SMMU, page mappings, submission of command buffers the way
+ * Linux's a7xx_submit puts them in the ring, and the fence the core writes when one is done.
+ * One address space for every client, as on the HackiOS port of the same interface.
+ */
+#define CP_WAIT_TIMESTAMP       0x14
+#define CP_INDIRECT_BUFFER_PFE  0x3f
+#define CP_SET_MARKER           0x65
+#define CP_SET_THREAD_BR        1u
+#define CP_SET_THREAD_BV        2u
+#define CP_SET_THREAD_BOTH      3u
+#define CP_SYNC_THREADS         (1u << 31)
+#define EVENT_CCU_INVALIDATE_DEPTH 0x18
+#define EVENT_CCU_INVALIDATE_COLOR 0x19
+#define EVENT_WRITE_ENABLED     (1u << 27)
+#define REG_CP_SCRATCH_REG2     0x0885
+#define GPU_FENCE_AT            0x200   /* in the scratch page: the fence BR writes last */
+#define GPU_BV_FENCE_AT         0x210   /* ... and the one BV writes when it is done */
+#define GPU_CHIP_ID             0x07030001u
+#define GPU_ADDRESSES_START     0x100000000ull
+#define GPU_ADDRESSES_SIZE      0x3f00000000ull
+#define GPU_ADDRESS_GRANULE     0x10000ull
+
+static bool gpu_kept;
+static uint32_t gpu_fence;
+
+/* A first-fit list of free GPU address ranges (the kernel's, and each client's with negronigpu_pt=1). */
+struct gpu_range {
+	uint64_t start, size;
+};
+struct gpu_heap {
+	struct gpu_range *free;
+	unsigned count, cap;
+};
+static struct gpu_range gpu_free[1024];
+static struct gpu_heap gpu_heap = { gpu_free, 0, sizeof(gpu_free) / sizeof(gpu_free[0]) };
+
+/*
+ * Per-client GPU address spaces (boot-arg negronigpu_pt=1, default 0; patch 0233). Each client
+ * gets its own translation tables; the kernel's part, root entries 0..GPU_KERNEL_ROOTS-1
+ * (0..4 GiB: ring, microcode, scratch, the present's mappings), points to the same level-2 tables
+ * in every root, so the kernel's commands work under any client's tables. The CPU switches the
+ * 3D core's SMMU context (TTBR0, then TLBIASID) between two submissions of different clients
+ * while the core is idle (every fence done, the ring read to its end); the first submission after
+ * a switch starts with a UCHE invalidate (the GPU caches by GPU address). Not the Linux way
+ * (CP_SMMU_TABLE_UPDATE from the ring): that needs the CP's SMMU aperture on our context bank
+ * (TrustZone call QCOM_SCM_SVC_MP 0x0c, cmd 0x1b, in Linux qcom_scm_set_gpu_smmu_aperture) and the
+ * hypervisor's agreement; our context is 2, not the 0 Linux's adreno-smmu gives the GPU, and
+ * nothing of it is tested on this phone. The CPU switch uses only register writes the ladder
+ * already makes (step 19: TTBR0 of this context, read back).
+ */
+#define GPU_KERNEL_ROOTS        4u                      /* root entries shared by every table: 0..4 GiB */
+#define GPU_KERNEL_HEAP_START   0x20000000ull           /* kernel-chosen addresses with negronigpu_pt=1 */
+#define GPU_KERNEL_HEAP_END     ((uint64_t)GPU_KERNEL_ROOTS << 30)
+#define GPU_VM_WINDOW_START     0x100000000ull          /* a client's MSM_PARAM_VA_START (Turnip's own addresses) */
+#define GPU_VM_WINDOW_SIZE      0x400000000ull          /* 16 GiB, as Linux's A730 address_space_size */
+#define GPU_VM_HEAP_START       0x1000000000ull         /* a client's kernel-chosen addresses */
+#define GPU_VM_HEAP_SIZE        0x3000000000ull         /* to 256 GiB; the context's limit is 512 GiB (39 bits) */
+#define GPU_VM_PAGES            2048u                   /* PAGE_SIZE pages of tables per client: 8192 tables */
+#define GPU_IDLE_US             2000u                   /* longest wait for the ring to be read to its end */
+#define EVENT_CACHE_INVALIDATE7 0x33                    /* adreno_pm4.xml CACHE_INVALIDATE7 (A7XX) */
+
+struct negroni_gpu_vm {
+	uint64_t *root;
+	uint64_t root_phys;
+	unsigned page_count, tables_left;
+	vm_offset_t pages[GPU_VM_PAGES];
+	struct gpu_range ranges[1024];
