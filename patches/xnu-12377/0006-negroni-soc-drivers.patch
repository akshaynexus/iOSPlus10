+void negroni_wlan_sta_mgmt_rx(const uint8_t *frame, uint32_t len, int32_t rssi, uint32_t freq);
+/* a scan ended (inside the service pass) */
+void negroni_wlan_sta_scan_done(uint32_t reason);
