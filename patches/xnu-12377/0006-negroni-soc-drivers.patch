diff --git a/bsd/dev/negroni_wlan.c b/bsd/dev/negroni_wlan.c
new file mode 100644
index 0000000..5c9dc50
--- /dev/null
+++ b/bsd/dev/negroni_wlan.c
@@ -0,0 +1,1780 @@
+/*
+ * NEGRONI (SM8450) QCA6490 Wi-Fi driver, stage 1 (patch 0261): BAR0 claim, firmware choice,
+ * firmware download over MHI (BHI + BHIe), the READY -> M0 transition and the start of the IPCR
+ * channels. Stage 2 (QRTR on MHI 20/21, QMI WLFW, WMI/HTT, en0) builds on the running chip and
+ * the m3 buffer this stage leaves ready. See docs/wifi-plan.md and patches/xnu/README-wifi.md.
+ *
+ * The survey (bsd/dev/negroni_wifi.c) powers the chip, trains PCIe0 and maps the config window.
+ * This driver reuses those handles (negroni_wifi_pcie_handles) and runs on its own kernel thread,
+ * so a failure never blocks boot. Every step prints one "NEGRONI WLAN: ..." line with its result
+ * and every wait has a time-out. On a failure the chip loses bus mastering before its DMA memory
+ * is freed.
+ *
+ * Protocol reference: Linux drivers/bus/mhi/host and drivers/net/wireless/ath/ath11k
+ * (BSD-3-Clause-Clear / GPL-2.0) and the OnePlus cnss2 kernel (out/src/op-kernel). We read them;
+ * we do not copy them. UNTESTED ON HARDWARE.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include <arm/caches_internal.h>
+#include <libkern/crypto/sha2.h>
+#include <stdarg.h>
+#include "negroni_wlan.h"
+#include "negroni_wlan_mhi.h"
+#include "negroni_wlan_qrtr.h"
+#include "negroni_wlan_ce.h"
+#include "negroni_wlan_wmi.h"
+#include "negroni_wlan_sta.h"     /* 0326: API state */
+#include "negroni_mmio.h"      /* 0325: PARF BDF-to-SID access before the step-6 include below */
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern kern_return_t thread_terminate(thread_t);
+extern int vsnprintf(char *, size_t, const char *, va_list);
+extern void IOSleep(unsigned int ms);
+extern char negroni_wifi_badge[24];             /* negroni_wifi.c, drawn by NegroniFramebuffer */
+extern uint32_t negroni_wifi_badge_color;
+
+/*
+ * VM_WIMG_WCOMB (osfmk/arm/memory_types.h, not exported to bsd/): Normal non-cacheable. Used for
+ * the pool's second view. ml_io_map (VM_WIMG_IO) is not used for RAM: its io_submap mapping is
+ * permanent, so ml_io_unmap of it panics in vm_map_delete ("Attempting to remove permanent VM
+ * map entry"); ml_io_map_unmappable maps in kernel_map and ml_io_unmap can remove it.
+ */
+#define WLAN_WIMG_WCOMB 0x6u
+/*
+ * VM_WIMG_IO (same header) = 0x7, Device memory, the type ml_io_map uses. BAR0 (2 MiB) maps with
+ * ml_io_map_unmappable too: io_submap is only 8 MiB for the whole kernel and the GPU ladder and the
+ * survey already use most of it (notes "io_submap"); an io_submap allocation that does not fit
+ * panics (KMA_NOFAIL).
+ */
+#define WLAN_WIMG_IO    0x7u
+/* ml_io_unmap -> pmap_remove asserts a 16 KiB page multiple (MACH_ASSERT is on in DEVELOPMENT) */
+#define WLAN_POOL_MAP   (((vm_size_t)NEGRONI_WLAN_POOL_SIZE + PAGE_MASK) & ~(vm_size_t)PAGE_MASK)
+
+/* ---- DMA pool byte layout (sum = NEGRONI_WLAN_POOL_SIZE); each ring aligned to its size ---- */
+#define OFF_CHCTX       0x0000u         /* channel context array, all 128 channels (5632 B) */
+#define OFF_EVCTX       0x1800u         /* 2 event contexts */
+#define OFF_CMDCTX      0x1900u         /* 1 command context */
+#define OFF_EV0         0x2000u         /* event ring 0: 32 elements (control) */
+#define OFF_EV1         0x3000u         /* event ring 1: 256 elements (IPCR) */
+#define OFF_CMD         0x4000u         /* command ring: 128 elements */
+#define OFF_CH20        0x5000u         /* IPCR out ring: 64 elements */
+#define OFF_CH21        0x6000u         /* IPCR in ring: 64 elements */
+#define OFF_MSI         0x8000u         /* 0344: MSI mailbox word (negroniwlan_msi bit 0), one 4 KiB page alone */
+#define OFF_FW          0x10000u        /* firmware image */
+#define FW_CAP          0x600000u       /* 6 MiB (amss.bin is 5609392 B) */
+#define OFF_M3          0x610000u       /* m3.bin, kept for the stage 2 QMI m3_info */
+#define M3_CAP          0x80000u        /* 512 KiB (m3.bin is 266684 B) */
+#define OFF_VEC         0x690000u       /* BHIe vector table (12 entries x 16 B for 6 MiB) */
+
+_Static_assert(OFF_CHCTX + NEGRONI_WLAN_CHCTX_SIZE <= OFF_EVCTX, "channel contexts overlap");
+_Static_assert(OFF_FW + FW_CAP <= OFF_M3 && OFF_M3 + M3_CAP <= OFF_VEC, "pool layout overlap");
+_Static_assert(OFF_VEC + (FW_CAP / MHI_SEG) * 16 <= NEGRONI_WLAN_POOL_SIZE, "vector table outside the pool");
+
+#define EV0_N           32u
+#define EV1_N           256u
+#define CMD_N           128u
+#define CH_N            64u
+_Static_assert(OFF_CH21 + CH_N * 16u <= OFF_MSI && OFF_MSI + 0x1000u <= OFF_FW && !(OFF_MSI & 0xfffu),
+    "0344: the MSI mailbox page overlaps a ring or the firmware");
+
+#define SOC_VERSION     0x224u          /* BAR0 + 0x224: family[31:28] device[27:16] major[15:8] minor[7:0] */
+#define BAR0_MAP        0x200000u       /* map at most 2 MiB of BAR0 (MHI MMIO + doorbell arrays) */
+#define BHI_SPAN        0x100u          /* BHI registers used: up to BHI_OEMPKHASH (0x64 + 4 * n) */
+#define BHIE_SPAN       0x80u           /* BHIe registers used: up to RXVECSTATUS (0x78) */
+
+/* ---- WLAN firmware area header (scripts/wifi/mkwlanarea.py) ---- */
+#define WLAN_AREA_HDR   0x8000u         /* 32 KiB header */
+#define WLAN_FW_MAX     256u
+
+struct wlan_area_entry {
+	char name[48];
+	uint32_t offset;
+	uint32_t size;
+	uint8_t sha256[32];
+} __attribute__((packed));
+struct wlan_area_header {
+	char magic[8];                  /* "NEGRWLAN" */
+	uint32_t version;
+	uint32_t count;
+	struct wlan_area_entry e[WLAN_FW_MAX];
+} __attribute__((packed));
+_Static_assert(sizeof(struct wlan_area_entry) == 88, "mkwlanarea.py entry is 88 bytes");
+_Static_assert(sizeof(struct wlan_area_header) <= WLAN_AREA_HDR, "header larger than 32 KiB");
+
+static vm_offset_t g_bar0;              /* non-cacheable BAR0 (inside the MEM_BASE iATU window) */
+static uint32_t g_bar_len;              /* mapped BAR0 bytes */
+static vm_offset_t g_pool_kva;          /* cacheable view (firmware fill) */
+static vm_offset_t g_pool_nc;           /* Normal non-cacheable view (contexts, rings, vector) */
+static uint64_t g_pool_pa;
+static uint64_t g_pool_dva;             /* 0320: the pool as the chip sees it (negroni_wlan_dma_map) */
+static uint64_t g_xfer_pa;              /* 0320: physical IPCR buffers (H.xfer_pa is the chip's address) */
+static uint32_t g_keep_s;               /* 0320: negroniwlan_keep, keep-alive seconds (0 = until a chip error) */
+static void (*g_pollers[WLAN_POLLERS])(void);
+static struct mhi_host H;
+static uint32_t g_timeout_ms = 10000;   /* cnss2 MHI time-out 10 s (ath11k 20 s) */
+static uint32_t g_m3_size;              /* m3.bin bytes, at g_pool_pa + OFF_M3 (for stage 2) */
+static uint32_t g_level = WLAN_LEVEL_SBL;       /* boot-arg negroniwlan */
+/*
+ * negroniwlan_smmu: 0 report only, 1 stop on a sure fault, 2 add a bypass entry (the hypervisor turns it into FAULT),
+ * 3 (0324/0325, opt-in) a stage-1 context with Android's IOVA window, every chip address an IOVA. Default 1 again
+ * (2026-10-27): a 0249 boot showed Gunyah refuses GR1 CBAR writes of a "free" bank (SEA); =3 waits for the bank probe.
+ */
+static uint32_t g_smmu_policy = 1;
+static struct negroni_wlan_pcie P;      /* the survey's handles */
+static uint32_t g_fw_size;
+static const char *g_fw;
+static bool g_master;                   /* bus master was turned on (BAR0 claimed) */
+static vm_offset_t g_xfer_kva;          /* 0264: IPCR RX/TX buffers (cacheable view; H.xfer_nc is the NC one) */
+/*
+ * 0342: boot-arg negroniwlan_swreset, the ath11k power-up reset before BHI (wlan_sw_reset): 0 off (the 0261-0341
+ * flow), 1 the clears only (LTSSM, PCIe interrupts, QFPROM power, BHIe vectors, warm-boot entry, reset cause),
+ * 2 the clears + PCIE_SOC_GLOBAL_RESET + MHICTRL RESET (the full ath11k_pci_sw_reset(ab, true) order).
+ */
+static uint32_t g_swreset;
+static uint64_t g_bar_pa;               /* 0342: BAR0 bus address, to check the BAR after a SoC reset */
+/*
+ * 0344: boot-arg negroniwlan_msi (default 0 = the 0261-0343 flow, no MSI). Bit 0: the endpoint MSI capability is
+ * enabled before BHI with the address of a mailbox word in our DMA pool (OFF_MSI, through the SMMU context), so each
+ * MSI the chip sends lands in RAM and the polls print it. Bit 1: PCIE_SOC_WAKE = 1 before BHI (bisect only).
+ */
+static uint32_t g_msi_mode;
+
+/* ---- step lines (0263): "step N NAME" before, "step N NAME failed: REASON" on an error ---- */
+static uint32_t g_step;
+static const char *g_step_name = "start";
+static bool g_why_set;
+
+void
+negroni_wlan_step(uint32_t n, const char *name)
+{
+	g_step = n;
+	g_step_name = name;
+	g_why_set = false;
+	snprintf(negroni_wifi_badge, sizeof(negroni_wifi_badge), "WLAN %u", n);
+	negroni_wifi_badge_color = 0x00d0a000;
+	printf("NEGRONI WLAN: step %u %s\n", n, name);
+}
+
+int
+negroni_wlan_failed(int error, const char *fmt, ...)
+{
+	char why[192];
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsnprintf(why, sizeof(why), fmt, ap);
+	va_end(ap);
+	if (!g_why_set) {       /* the first (innermost) reason of a step wins */
+		printf("NEGRONI WLAN: step %u %s failed: %s\n", g_step, g_step_name, why);
+		g_why_set = true;
+	}
+	return error;
+}
+
+static const char *
+errno_text(int e)
+{
+	switch (e) {
+	case ETIMEDOUT: return "time-out";
+	case EIO: return "I/O error (SYSERR, chip error or link down)";
+	case ENXIO: return "no device answer";
+	case ENOMEM: return "no memory";
+	case ERANGE: return "value out of range";
+	case ENOENT: return "file not found";
+	case EBADMSG: return "bad data (checksum or message format)";
+	case EINVAL: return "invalid answer";
+	case EPERM: return "refused by a safety check";
+	default: return "error";
+	}
+}
+
+/* ---- shared register and timing helpers (negroni_wlan_mhi.h prototypes) ---- */
+/* An offset outside the mapped BAR0 (a bad BHIOFF/CHDBOFF from the chip) never reaches the bus. */
+static inline bool
+bar_ok(uint32_t off)
+{
+	return g_bar0 && off < g_bar_len && g_bar_len - off >= 4 && !(off & 3);
+}
+
+uint32_t
+negroni_wlan_rd(uint32_t off)
+{
+	if (!bar_ok(off)) {
+		return MHI_ALL_ONES;
+	}
+	return *(volatile uint32_t *)(g_bar0 + off);
+}
+
+void
+negroni_wlan_wr(uint32_t off, uint32_t v)
+{
+	if (!bar_ok(off)) {
+		return;
+	}
+	*(volatile uint32_t *)(g_bar0 + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+uint32_t
+negroni_wlan_timeout(void)
+{
+	return g_timeout_ms;
+}
+
+uint64_t
+negroni_wlan_ms(void)
+{
+	uint64_t t, ns;
+
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &ns);
+	return ns / 1000000ull;
+}
+
+uint32_t
+negroni_wlan_seq(void)
+{
+	static uint32_t s = 0x9e3779b9u;
+	uint64_t t;
+
+	clock_get_uptime(&t);
+	s = s * 1664525u + 1013904223u + (uint32_t)t;
+	uint32_t r = s & BHI_SEQ_MASK;
+	return r ? r : 1;
+}
+
+/*
+ * 0320: the chip's address for host memory. Identity (bypass, the 0261-0266 assumption) here; patch 0324
+ * adds the SMMU stage-1 path (negroniwlan_smmu=3). Every address handed to the chip goes through it.
+ */
+uint64_t
+negroni_wlan_dma_map(uint64_t pa, uint32_t size)
+{
+	if (size == 0 || pa + size - 1 > MHI_DMA_MASK) {
+		return WLAN_DMA_NONE;
+	}
+	if (g_smmu_policy == 3) {
+		/* 0325: never a physical address while the policy is 3 (no context = no address) */
+		return negroni_wlan_smmu_active() ? negroni_wlan_smmu_map(pa, size) : WLAN_DMA_NONE;
+	}
+	return pa;
+}
+
+/* 0325: a buffer the chip had an address for goes away (identity mappings need nothing) */
+void
+negroni_wlan_dma_unmap(uint64_t dva, uint32_t size)
+{
+	if (g_smmu_policy == 3 && dva != WLAN_DMA_NONE) {
+		negroni_wlan_smmu_unmap(dva, size);
+	}
+}
+
+/* 0320: sleep, so a poller does not hold a core (delay() spins in this XNU) */
+void
+negroni_wlan_nap(uint32_t ms)
+{
+	IOSleep(ms ? ms : 1);
+}
+
+void
+negroni_wlan_add_poller(void (*fn)(void))
+{
+	for (uint32_t i = 0; i < WLAN_POLLERS; i++) {
+		if (g_pollers[i] == fn) {
+			return;
+		}
+		if (!g_pollers[i]) {
+			g_pollers[i] = fn;
+			return;
+		}
+	}
+	printf("NEGRONI WLAN: no poller slot left\n");
+}
+
+/* 0320: MHI events + QRTR (QMI) + later pollers; EIO when the chip stopped (SYSERR, RDDM, dead link) */
+int
+negroni_wlan_service(void)
+{
+	int error;
+
+	negroni_wlan_msi_poll("service");       /* 0344 */
+	if (negroni_qrtr.attached) {
+		error = negroni_wlan_qrtr_pump(&H);
+	} else {
+		(void)negroni_wlan_mhi_poll(&H);
+		uint32_t st = negroni_wlan_rd(MHI_STATUS);
+		error = (H.syserr || H.rddm_seen || st == MHI_ALL_ONES || (st & MHI_STATUS_SYSERR)) ? EIO : 0;
+	}
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < WLAN_POLLERS && g_pollers[i]; i++) {
+		g_pollers[i]();
+	}
+	return 0;
+}
+
+/*
+ * 0320 keep-alive (audit 2026-10-26 section 2.4): after the last asked level the thread stays and drains the
+ * event rings every 20 ms (sleeping, not spinning), so the chip never stalls on a full IPCR ring, M1 gets its
+ * answer and late QMI indications are seen. negroniwlan_keep=S stops it after S seconds (0 = until the chip
+ * stops). A chip error here takes the normal failure path (MHI reset, bus master off, then free).
+ */
+static int
+wlan_keep_alive(void)
+{
+	uint64_t start = negroni_wlan_ms(), next_log = start + 60000;
+	uint32_t ev0 = H.events, rx0 = H.rx_packets;
+	int error;
+
+	printf("NEGRONI WLAN: keep-alive poller on (20 ms, %s)\n", g_keep_s ? "negroniwlan_keep seconds" :
+	    "until a chip error");
+	for (;;) {
+		error = negroni_wlan_service();
+		if (error) {
+			printf("NEGRONI WLAN: keep-alive: the chip stopped after %llu s (MHISTATUS %#x, EE %u)\n",
+			    (negroni_wlan_ms() - start) / 1000, negroni_wlan_rd(MHI_STATUS), H.ee);
+			return error;
+		}
+		if (negroni_qrtr.attached) {
+			negroni_wlan_wlfw_idle();
+		}
+		if (g_level >= WLAN_LEVEL_SCAN) {
+			negroni_wlan_sta_service();     /* 0326: API requests (scan, join, data) at the top level */
+		}
+		uint64_t now = negroni_wlan_ms();
+		if (now >= next_log) {
+			next_log = now + 60000;
+			printf("NEGRONI WLAN: keep-alive %llu s: %u MHI events, %u IPCR packets, %u M1 seen\n",
+			    (now - start) / 1000, H.events - ev0, H.rx_packets - rx0, H.m1_seen);
+			(void)negroni_wlan_smmu_check("keep-alive");    /* 0325: a line only when a fault appeared */
+			negroni_wlan_dp_report();                       /* 0328 */
+		}
+		if (g_keep_s && now - start >= (uint64_t)g_keep_s * 1000) {
+			printf("NEGRONI WLAN: keep-alive ends after %u s (negroniwlan_keep); the chip keeps running\n", g_keep_s);
+			negroni_wlan_sta_lifecycle(NWLAN_STATE_OFF, 0);       /* 0326: nobody services the chip any more */
+			return 0;
+		}
+		negroni_wlan_nap(20);
+	}
+}
+
+/*
+ * Size BAR0 (all-ones probe with decode off), place it at the first size-aligned address of the
+ * iATU memory window (Linux: 0x60400000 for a 2 MiB BAR above 0x60300000), check the read-back,
+ * enable memory decode + bus master and map it.
+ */
+static int
+wlan_bar0(struct negroni_wlan_pcie *p)
+{
+	volatile uint32_t *cfg = (volatile uint32_t *)p->cfg_bus1;
+	uint32_t cmd = cfg[0x04 / 4] & 0xffff;
+	uint32_t orig = cfg[0x10 / 4];
+	uint64_t mask, size, base;
+	bool is64;
+
+	if (orig == MHI_ALL_ONES || cmd == 0xffff) {
+		printf("NEGRONI WLAN: endpoint config space reads 0xffffffff (link down?); stop\n");
+		return ENXIO;
+	}
+	if (orig & 1) {
+		printf("NEGRONI WLAN: BAR0 %#x is an I/O BAR; stop\n", orig);
+		return ENXIO;
+	}
+	is64 = (orig & 6) == 4;
+	cfg[0x04 / 4] = cmd & ~7u;                      /* I/O, memory decode and bus master off */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	cfg[0x10 / 4] = 0xffffffffu;
+	mask = cfg[0x10 / 4] & ~0xfu;
+	if (is64) {
+		cfg[0x14 / 4] = 0xffffffffu;
+		mask |= (uint64_t)cfg[0x14 / 4] << 32;
+	} else {
+		mask |= 0xffffffff00000000ull;
+	}
+	size = ~mask + 1;
+	if ((mask & 0xffffffffu) == 0 || size < 0x1000u || (size & (size - 1)) ||
+	    size > p->mem_limit - p->mem_base + 1) {
+		printf("NEGRONI WLAN: BAR0 size probe %#llx gives size %#llx; stop\n", mask, size);
+		return ENXIO;
+	}
+	base = (p->mem_base + size - 1) & ~(size - 1);
+	if (base + size - 1 > p->mem_limit) {
+		printf("NEGRONI WLAN: BAR0 of %#llx bytes does not fit the window %#llx-%#llx; stop\n",
+		    size, p->mem_base, p->mem_limit);
+		return ENXIO;
+	}
+	cfg[0x10 / 4] = (uint32_t)base;
+	if (is64) {
+		cfg[0x14 / 4] = 0;
+	}
+	if ((cfg[0x10 / 4] & ~0xfu) != (uint32_t)base) {
+		printf("NEGRONI WLAN: BAR0 reads back %#x, wrote %#llx; stop\n", cfg[0x10 / 4], base);
+		return ENXIO;
+	}
+	/* memory decode + bus master; the upper 16 bits (status, RW1C) are written as 0 */
+	cfg[0x04 / 4] = (cmd & ~1u) | (1u << 1) | (1u << 2);
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	g_bar_pa = base;
+	g_bar_len = (uint32_t)MIN(size, (uint64_t)BAR0_MAP);
+	g_bar0 = ml_io_map_unmappable((vm_offset_t)base, g_bar_len, WLAN_WIMG_IO);
+	if (!g_bar0) {
+		printf("NEGRONI WLAN: BAR0 map of %#llx failed\n", base);
+		return ENOMEM;
+	}
+	uint32_t reglen = negroni_wlan_rd(MHI_REGLEN), ver = negroni_wlan_rd(MHI_VER);
+	printf("NEGRONI WLAN: BAR0 %s %#llx bytes at %#llx, MHI REGLEN %#x VER %#x\n",
+	    is64 ? "64-bit" : "32-bit", size, base, reglen, ver);
+	if (reglen == MHI_ALL_ONES || ver == MHI_ALL_ONES) {
+		printf("NEGRONI WLAN: BAR0 reads 0xffffffff (no MHI MMIO behind it); stop\n");
+		return ENXIO;
+	}
+	return 0;
+}
+
+/*
+ * 0325: ASPM off on both link ends during the firmware download (ath11k pci.c:828-831 ath11k_pci_aspm_disable:
+ * "problems switching to AMSS state"). LNKCTL bits 1:0 = ASPM L0s/L1 control. Only the low 16 bits are written
+ * (LNKSTA above them has RW1C bits). Endpoint: the PCIe capability (ID 0x10) from the list at 0x34; root port:
+ * DBI 0x70 + 0x10 (negroni_wifi.c DBI_LNKCTL2 comment).
+ */
+static void
+wlan_aspm_off(struct negroni_wlan_pcie *p)
+{
+	volatile uint32_t *cfg = (volatile uint32_t *)p->cfg_bus1;
+	uint32_t ep = MHI_ALL_ONES, rp = MHI_ALL_ONES, cap = 0;
+
+	for (uint32_t ptr = cfg[0x34 / 4] & 0xfcu, guard = 48; ptr >= 0x40 && guard--; ) {
+		uint32_t h = cfg[ptr / 4];
+		if ((h & 0xffu) == 0x10u) {
+			cap = ptr;
+			break;
+		}
+		ptr = (h >> 8) & 0xfcu;
+	}
+	if (cap) {
+		ep = cfg[(cap + 0x10) / 4];
+		if (ep != MHI_ALL_ONES && (ep & 3u)) {
+			cfg[(cap + 0x10) / 4] = ep & 0xfffcu;
+		}
+	}
+	if (p->dbi) {
+		volatile uint32_t *lc = (volatile uint32_t *)(p->dbi + 0x80);
+		rp = *lc;
+		if (rp != MHI_ALL_ONES && (rp & 3u)) {
+			*lc = rp & 0xfffcu;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("NEGRONI WLAN: ASPM: endpoint LNKCTL %#x (cap %#x) -> ASPM %u, root port LNKCTL %#x -> ASPM %u (off for the "
+	    "download, ath11k)\n", ep & 0xffffu, cap, cap ? cfg[(cap + 0x10) / 4] & 3u : 9u, rp & 0xffffu,
+	    p->dbi ? *(volatile uint32_t *)(p->dbi + 0x80) & 3u : 9u);
+}
+
+/*
+ * 0325: the PCIe controller's BDF-to-SID table (pci-msm.c msm_pcie_config_sid, called on every link enable):
+ * the survey's core reset (step 7) puts it back to reset state, BYPASS on. Android writes BYPASS off, zeroes the
+ * 256 hash entries and puts BDF 0x0100 -> SID offset 1 (iommu-map 0x100 -> 0x1c01, smmu-sid-base 0x1c00) at
+ * crc8(BDF big endian, poly 0x07, MSB first). RID 0 -> offset 0 is the value 0 = an empty entry. Only with
+ * negroniwlan_smmu=3 (the SMR then matches 0x1c00/0x1c01 anyway, see negroni_wlan_smmu.c).
+ */
+#define PARF_BDF_TO_SID_TABLE   0x2000u
+#define PARF_BDF_TO_SID_CFG     0x2c00u         /* bit 0: BYPASS */
+#define WLAN_EP_BDF             0x0100u
+
+static uint8_t
+crc8_msb07(const uint8_t *b, uint32_t n)
+{
+	uint8_t c = 0;
+
+	while (n--) {
+		c ^= *b++;
+		for (int i = 0; i < 8; i++) {
+			c = (uint8_t)((c & 0x80) ? (c << 1) ^ 0x07 : c << 1);
+		}
+	}
+	return c;
+}
+
+static void
+wlan_pcie_sid(bool program)
+{
+	if (!P.parf) {
+		printf("NEGRONI WLAN: no PARF handle; BDF-to-SID table not checked\n");
+		return;
+	}
+	uint32_t cfg = negroni_mmio_rd32(P.parf + PARF_BDF_TO_SID_CFG);
+	uint8_t be[2] = { WLAN_EP_BDF >> 8, WLAN_EP_BDF & 0xff };
+	uint32_t hash = crc8_msb07(be, 2), val = WLAN_EP_BDF << 16 | 1u << 8;
+
+	printf("NEGRONI WLAN: PCIe BDF-to-SID: CFG %#x (BYPASS %u), entry %#x = %#x\n", cfg, cfg & 1u, hash,
+	    negroni_mmio_rd32(P.parf + PARF_BDF_TO_SID_TABLE + 4 * hash));
+	if (!program) {
+		return;
+	}
+	negroni_mmio_wr32(P.parf + PARF_BDF_TO_SID_CFG, cfg & ~1u);
+	for (uint32_t i = 0; i < 256; i++) {
+		negroni_mmio_wr32(P.parf + PARF_BDF_TO_SID_TABLE + 4 * i, 0);
+	}
+	negroni_mmio_wr32(P.parf + PARF_BDF_TO_SID_TABLE + 4 * hash, val);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t got = negroni_mmio_rd32(P.parf + PARF_BDF_TO_SID_TABLE + 4 * hash);
+	cfg = negroni_mmio_rd32(P.parf + PARF_BDF_TO_SID_CFG);
+	printf("NEGRONI WLAN: PCIe BDF-to-SID programmed: CFG %#x, entry %#x = %#x (BDF %#x -> SID 0x1c00 + 1)%s\n", cfg,
+	    hash, got, WLAN_EP_BDF, (got == val && !(cfg & 1u)) ? "" : " - DID NOT TAKE, the chip may use SID 0x1c00");
+}
+
+/*
+ * 0339: why the SBL does not come up (phone t6, 2026-10-27: BHI SBL done, then MHISTATUS 0 / EE 0 for 10 s, no SMMU
+ * fault). The registers cnss2 dumps every few seconds during MHI power-on (pci.c cnss_boot_debug_timeout_hdlr):
+ * MHI and BHI registers, the PBL logging register, the SBL log pointer (PCIE_BHI_ERRDBG2/3), PBL_WLAN_BOOT_CFG,
+ * PBL_BOOTSTRAP_STATUS, the SoC scratch registers, the PBL log SRAM (QCA6490: 0x01403da0, 40 bytes) and the SBL log
+ * SRAM (start/size from ERRDBG2/3, at most 48 bytes, inside 0x01400000-0x01800000). Read only; windowed reads
+ * through the CE code's window (0328).
+ */
+#define QCA_TCSR_PBL_LOGGING    0x01b000f8u     /* cnss2 reg.h */
+#define QCA_PCIE_BHI_ERRDBG2    0x01e0e238u
+#define QCA_PCIE_BHI_ERRDBG3    0x01e0e23cu
+#define QCA_PBL_WLAN_BOOT_CFG   0x01e22b34u
+#define QCA_PBL_BOOTSTRAP_STATUS 0x01910008u
+#define QCA_PCIE_SCRATCH_0      0x01e04040u
+#define QCA_PCIE_SCRATCH_1      0x01e04044u
+#define QCA_PCIE_SCRATCH_2      0x01e0405cu
+#define QCA_WLAON_WL_PWR_STATUS 0x01f8002cu
+#define QCA6490_PBL_LOG_SRAM    0x01403da0u
+#define QCA6490_PBL_LOG_MAX     40u
+#define QCA6490_SBL_LOG_MAX     48u
+#define QCA_SRAM_START          0x01400000u
+#define QCA_SRAM_END            0x01800000u
+
+/* 0343: the PCIe-side and WLAON registers of the boot dump (after the 0342 register names); negroniwlan_bootdbg */
+static uint32_t g_bootdbg = 1;
+static void wlan_boot_dump_pcie(const char *when);
+
+void
+negroni_wlan_boot_dump(struct mhi_host *h, const char *when)
+{
+	uint32_t b = h->bhi;
+
+	if (!g_bar0) {
+		return;
+	}
+	negroni_wlan_msi_poll(when);    /* 0344 */
+	printf("NEGRONI WLAN: BOOT %s: MHI REGLEN %#x VER %#x CFG %#x CTRL %#x STATUS %#x BHIOFF %#x BHIEOFF %#x\n", when,
+	    negroni_wlan_rd(MHI_REGLEN), negroni_wlan_rd(MHI_VER), negroni_wlan_rd(MHI_CFG), negroni_wlan_rd(MHI_CTRL),
+	    negroni_wlan_rd(MHI_STATUS), negroni_wlan_rd(MHI_BHIOFF), negroni_wlan_rd(MHI_BHIEOFF));
+	if (b) {
+		printf("NEGRONI WLAN: BOOT %s: BHI IMGADDR %#x:%08x IMGSIZE %#x TXDB %#x INTVEC %#x EXECENV %#x STATUS %#x ERRCODE %#x "
+		    "ERRDBG %#x %#x %#x SERIAL %#x\n", when, negroni_wlan_rd(b + BHI_IMGADDR_HIGH), negroni_wlan_rd(b + BHI_IMGADDR_LOW),
+		    negroni_wlan_rd(b + BHI_IMGSIZE), negroni_wlan_rd(b + BHI_IMGTXDB), negroni_wlan_rd(b + BHI_INTVEC),
+		    negroni_wlan_rd(b + BHI_EXECENV), negroni_wlan_rd(b + BHI_STATUS), negroni_wlan_rd(b + BHI_ERRCODE),
+		    negroni_wlan_rd(b + BHI_ERRDBG1), negroni_wlan_rd(b + BHI_ERRDBG1 + 4), negroni_wlan_rd(b + BHI_ERRDBG1 + 8),
+		    negroni_wlan_rd(b + BHI_SERIALNU));
+	}
+	uint32_t sbl_start = negroni_wlan_reg_rd(QCA_PCIE_BHI_ERRDBG2), sbl_size = negroni_wlan_reg_rd(QCA_PCIE_BHI_ERRDBG3);
+	printf("NEGRONI WLAN: BOOT %s: TCSR_PBL_LOGGING %#x SBL log at %#x size %#x PBL_WLAN_BOOT_CFG %#x PBL_BOOTSTRAP_STATUS %#x "
+	    "WLAON_WL_PWR_STATUS %#x SCRATCH %#x %#x %#x\n", when, negroni_wlan_reg_rd(QCA_TCSR_PBL_LOGGING), sbl_start, sbl_size,
+	    negroni_wlan_reg_rd(QCA_PBL_WLAN_BOOT_CFG), negroni_wlan_reg_rd(QCA_PBL_BOOTSTRAP_STATUS),
+	    negroni_wlan_reg_rd(QCA_WLAON_WL_PWR_STATUS), negroni_wlan_reg_rd(QCA_PCIE_SCRATCH_0),
+	    negroni_wlan_reg_rd(QCA_PCIE_SCRATCH_1), negroni_wlan_reg_rd(QCA_PCIE_SCRATCH_2));
+	uint32_t w[12];
+	for (uint32_t i = 0; i < QCA6490_PBL_LOG_MAX / 4; i++) {
+		w[i] = negroni_wlan_reg_rd(QCA6490_PBL_LOG_SRAM + 4 * i);
+	}
+	printf("NEGRONI WLAN: BOOT %s: PBL log %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n", when, w[0], w[1], w[2], w[3],
+	    w[4], w[5], w[6], w[7], w[8], w[9]);
+	sbl_size = MIN(sbl_size, QCA6490_SBL_LOG_MAX);
+	if (sbl_start >= QCA_SRAM_START && sbl_start < QCA_SRAM_END && sbl_start + sbl_size <= QCA_SRAM_END && sbl_size) {
+		memset(w, 0, sizeof(w));
+		for (uint32_t i = 0; i < sbl_size / 4; i++) {
+			w[i] = negroni_wlan_reg_rd(sbl_start + 4 * i);
+		}
+		printf("NEGRONI WLAN: BOOT %s: SBL log %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n", when, w[0], w[1],
+		    w[2], w[3], w[4], w[5], w[6], w[7], w[8], w[9], w[10], w[11]);
+	} else {
+		printf("NEGRONI WLAN: BOOT %s: no SBL log (start %#x size %#x outside the SRAM)\n", when, sbl_start, sbl_size);
+	}
+	wlan_boot_dump_pcie(when);      /* 0343 */
+	(void)negroni_wlan_smmu_check(when);
+}
+
+/*
+ * 0342: the ath11k power-up reset before the BHI download (wlan-linux ath11k pci.c:380 ath11k_pci_sw_reset(ab, true),
+ * called by ath11k_pci_power_up before mhi_sync_power_up; registers from ath11k pci.h, same values in cnss2 reg.h).
+ * Phone t6 + the 0339 boot: BHI SBL DONE, no SMMU fault, then EE 0 and MHISTATUS 0 for 30 s and no SBL log pointer
+ * (PCIE_BHI_ERRDBG2 0): the SBL never reached its MHI start. ath11k names two causes that fit:
+ *   - PCIE_PCIE_INT_ALL_CLEAR: "When target receive Hotreset, but will set the interrupt. So when download SBL again,
+ *     SBL will open Interrupt and receive it, and crash immediately." (the survey trains the link up to 3 times)
+ *   - WLAON_WARM_SW_ENTRY = 0: "prevent Q6 from continuing warm path and entering dead loop"; WLAON_SOC_RESET_CAUSE
+ *     is read-clear: "prevent Q6 from entering wrong code path". The WLAON block is on the aon rail (pmr735a_s2,
+ *     shared, never cycled by us), so it can keep a warm entry from an earlier boot (Android, or an iOS attempt).
+ * cnss2 (Android) does none of this: it power-cycles all five rails, which we do not. ath11k's clear_vector writes
+ * 0x360/0x368/0x394/0x39c = BHIe 0x324 + TXVECDB/TXVECSTATUS/RXVECDB/RXVECSTATUS (QCA6390); this chip reports
+ * BHIe at 0x224, so the same four registers are written relative to MHI_BHIEOFF. fix_l1ss is false for WCN6855.
+ */
+#define QCA_PCIE_SOC_WAKE               0x3004u         /* BAR0 direct (below the window) */
+#define QCA_PCIE_SOC_GLOBAL_RESET       0x3008u
+#define QCA_PCIE_SOC_GLOBAL_RESET_V     0x1u
+#define QCA_PCIE_PARF_LTSSM             0x01e081b0u
+#define QCA_PARM_LTSSM_VALUE            0x111u
+#define QCA_GCC_PCIE_HOT_RST            0x01e402bcu
+#define QCA_GCC_PCIE_HOT_RST_VAL        0x10u
+#define QCA_PCIE_PARF_INT_STATUS        0x01e08220u
+#define QCA_PCIE_INT_ALL_STATUS         0x01e08224u
+#define QCA_PCIE_INT_ALL_CLEAR          0x01e08228u
+#define QCA_PCIE_INT_ALL_MASK           0x01e0822cu
+#define QCA_WLAON_QFPROM_PWR_CTRL       0x01f8031cu
+#define QCA_QFPROM_VDD4BLOW             0x4u
+#define QCA_PCIE_Q6_COOKIE_ADDR         0x01f80500u
+#define QCA_WLAON_WARM_SW_ENTRY         0x01f80504u
+#define QCA_WLAON_SOC_RESET_CAUSE       0x01f8060cu     /* read-clear: read only in wlan_sw_reset */
+#define QCA_BHIE_TXVECDB                0x3cu
+#define QCA_BHIE_TXVECSTATUS            0x44u
+#define QCA_BHIE_RXVECDB                0x70u
+#define QCA_BHIE_RXVECSTATUS            0x78u
+
+static int
+wlan_sw_reset(void)
+{
+	volatile uint32_t *cfg = (volatile uint32_t *)P.cfg_bus1;
+	uint32_t v, i;
+
+	if (!g_swreset) {
+		printf("NEGRONI WLAN: SW RESET off (negroniwlan_swreset=0): BHI on the chip as the survey left it\n");
+		return 0;
+	}
+	printf("NEGRONI WLAN: SW RESET level %u (ath11k_pci_sw_reset order%s)\n", g_swreset,
+	    g_swreset >= 2 ? ", with PCIE_SOC_GLOBAL_RESET" : ", no SoC reset");
+	negroni_wlan_nap(100);                          /* ath11k: mdelay(100) first */
+
+	/* ath11k_pci_enable_ltssm: PARF_LTSSM = 0x111 (up to 5 writes), then GCC_PCIE_HOT_RST |= 0x10, 5 ms */
+	uint32_t ltssm0 = negroni_wlan_reg_rd(QCA_PCIE_PARF_LTSSM);
+	v = ltssm0;
+	for (i = 0; v != QCA_PARM_LTSSM_VALUE && i < 5; i++) {
+		if (v == MHI_ALL_ONES) {
+			delay(5000);
+		}
+		negroni_wlan_reg_wr(QCA_PCIE_PARF_LTSSM, QCA_PARM_LTSSM_VALUE);
+		v = negroni_wlan_reg_rd(QCA_PCIE_PARF_LTSSM);
+	}
+	uint32_t hot0 = negroni_wlan_reg_rd(QCA_GCC_PCIE_HOT_RST);
+	negroni_wlan_reg_wr(QCA_GCC_PCIE_HOT_RST, hot0 | QCA_GCC_PCIE_HOT_RST_VAL);
+	uint32_t hot = negroni_wlan_reg_rd(QCA_GCC_PCIE_HOT_RST);
+	delay(5000);
+	printf("NEGRONI WLAN: SW RESET: PARF_LTSSM %#x -> %#x (%u writes), GCC_PCIE_HOT_RST %#x -> %#x\n", ltssm0, v, i,
+	    hot0, hot);
+
+	/* ath11k_pci_clear_all_intrs: the interrupts a hot reset / link-down left for the SBL */
+	uint32_t ia = negroni_wlan_reg_rd(QCA_PCIE_INT_ALL_STATUS), pi = negroni_wlan_reg_rd(QCA_PCIE_PARF_INT_STATUS);
+	negroni_wlan_reg_wr(QCA_PCIE_INT_ALL_CLEAR, 0xffffffffu);
+	printf("NEGRONI WLAN: SW RESET: PCIE_INT_ALL_STATUS %#x -> %#x after INT_ALL_CLEAR (PARF_INT_STATUS %#x, mask %#x)\n",
+	    ia, negroni_wlan_reg_rd(QCA_PCIE_INT_ALL_STATUS), pi, negroni_wlan_reg_rd(QCA_PCIE_INT_ALL_MASK));
+
+	/* ath11k_pci_set_wlaon_pwr_ctrl: QFPROM VDD4BLOW off */
+	uint32_t q0 = negroni_wlan_reg_rd(QCA_WLAON_QFPROM_PWR_CTRL);
+	if (q0 != MHI_ALL_ONES) {
+		negroni_wlan_reg_wr(QCA_WLAON_QFPROM_PWR_CTRL, q0 & ~QCA_QFPROM_VDD4BLOW);
+	}
+
+	/* ath11k_mhi_clear_vector: BHIe TX/RX vector doorbell and status = 0 */
+	uint32_t bhie = negroni_wlan_rd(MHI_BHIEOFF);
+	if (bhie != MHI_ALL_ONES && bhie && !(bhie & 3) && bhie < g_bar_len && g_bar_len - bhie >= BHIE_SPAN) {
+		negroni_wlan_wr(bhie + QCA_BHIE_TXVECDB, 0);
+		negroni_wlan_wr(bhie + QCA_BHIE_TXVECSTATUS, 0);
+		negroni_wlan_wr(bhie + QCA_BHIE_RXVECDB, 0);
+		negroni_wlan_wr(bhie + QCA_BHIE_RXVECSTATUS, 0);
+	}
+
+	/* ath11k_pci_clear_dbg_registers: the Q6 cookie, the warm-boot entry = 0, the reset cause (read-clear) */
+	uint32_t cookie = negroni_wlan_reg_rd(QCA_PCIE_Q6_COOKIE_ADDR);
+	uint32_t warm0 = negroni_wlan_reg_rd(QCA_WLAON_WARM_SW_ENTRY);
+	negroni_wlan_nap(10);
+	negroni_wlan_reg_wr(QCA_WLAON_WARM_SW_ENTRY, 0);
+	negroni_wlan_nap(10);
+	uint32_t warm = negroni_wlan_reg_rd(QCA_WLAON_WARM_SW_ENTRY);
+	uint32_t cause = negroni_wlan_reg_rd(QCA_WLAON_SOC_RESET_CAUSE);
+	printf("NEGRONI WLAN: SW RESET: QFPROM_PWR_CTRL %#x -> %#x, BHIe %#x vectors cleared, Q6 cookie %#x, "
+	    "WARM_SW_ENTRY %#x -> %#x, SOC_RESET_CAUSE %#x (read-clear)\n", q0, negroni_wlan_reg_rd(QCA_WLAON_QFPROM_PWR_CTRL),
+	    bhie, cookie, warm0, warm, cause);
+
+	if (g_swreset < 2) {
+		return 0;
+	}
+
+	/* ath11k_pci_soc_global_reset: V bit 10 ms, V off (else the SoC stays in reset), 10 ms */
+	v = negroni_wlan_rd(QCA_PCIE_SOC_GLOBAL_RESET);
+	if (v == MHI_ALL_ONES) {
+		return negroni_wlan_failed(EIO, "PCIE_SOC_GLOBAL_RESET reads 0xffffffff before the reset (link down)");
+	}
+	negroni_wlan_wr(QCA_PCIE_SOC_GLOBAL_RESET, v | QCA_PCIE_SOC_GLOBAL_RESET_V);
+	(void)negroni_wlan_rd(QCA_PCIE_SOC_GLOBAL_RESET);       /* flush the posted write */
+	negroni_wlan_nap(10);
+	negroni_wlan_wr(QCA_PCIE_SOC_GLOBAL_RESET, v & ~QCA_PCIE_SOC_GLOBAL_RESET_V);
+	(void)negroni_wlan_rd(QCA_PCIE_SOC_GLOBAL_RESET);
+	negroni_wlan_nap(10);
+	uint32_t after = negroni_wlan_rd(QCA_PCIE_SOC_GLOBAL_RESET);
+	negroni_wlan_window_forget();                   /* the reset cleared the window register */
+	if (after == MHI_ALL_ONES) {
+		printf("NEGRONI WLAN: SW RESET: PCIE_SOC_GLOBAL_RESET reads 0xffffffff after the reset (link down); stop\n");
+		return negroni_wlan_failed(EIO, "PCIe link down after PCIE_SOC_GLOBAL_RESET");
+	}
+
+	/* the endpoint's BAR0 and command register must survive the SoC reset (ath11k assumes they do) */
+	uint32_t bar = cfg[0x10 / 4], cmd = cfg[0x04 / 4] & 0xffff;
+	bool restored = false;
+	if ((bar & ~0xfu) != (uint32_t)g_bar_pa || (cmd & 6u) != 6u) {
+		cfg[0x10 / 4] = (uint32_t)g_bar_pa;
+		if ((bar & 6u) == 4u) {
+			cfg[0x14 / 4] = (uint32_t)(g_bar_pa >> 32);
+		}
+		cfg[0x04 / 4] = (cmd & ~1u) | (1u << 1) | (1u << 2);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		restored = true;
+	}
+
+	/* ath11k_mhi_set_mhictrl_reset: "after SOC_GLOBAL_RESET, MHISTATUS may still have SYSERR" -> MHICTRL = RESET */
+	uint32_t st = negroni_wlan_rd(MHI_STATUS);
+	negroni_wlan_wr(MHI_CTRL, MHI_CTRL_RESET);
+	negroni_wlan_nap(10);
+	/* not in ath11k (mhi_async_power_up reads the EE next): log when the PBL takes the reset, at most 1 s */
+	uint64_t t0 = negroni_wlan_ms();
+	uint32_t c;
+	do {
+		c = negroni_wlan_rd(MHI_CTRL);
+		if (c == MHI_ALL_ONES || !(c & MHI_CTRL_RESET)) {
+			break;
+		}
+		negroni_wlan_nap(5);
+	} while (negroni_wlan_ms() - t0 < 1000);
+	printf("NEGRONI WLAN: SW RESET: GLOBAL_RESET %#x -> %#x, BAR0 %#x command %#x%s, MHISTATUS was %#x, MHICTRL RESET "
+	    "written: MHICTRL %#x after %llu ms, MHISTATUS %#x, SOC_WAKE %#x\n", v, after, bar, cmd,
+	    restored ? " (restored)" : "", st, c, negroni_wlan_ms() - t0, negroni_wlan_rd(MHI_STATUS),
+	    negroni_wlan_rd(QCA_PCIE_SOC_WAKE));
+	return 0;
+}
+
+/*
+ * 0343: a more precise boot dump (negroniwlan_bootdbg=1, the default; 0 = off). The 0339 lines could not tell a
+ * crashed SBL from one that never started, nor a DMA that failed on the bus. Added, read only:
+ *   - chip PCIe side: PCIE_INT_ALL_STATUS / PARF_INT_STATUS / INT_ALL_MASK (a latched hot-reset or link-down interrupt
+ *     = ath11k's "SBL ... crash immediately" case), PARF_LTSSM, PARF_PM_STTS, GCC_PCIE_HOT_RST, PCIE_SOC_GLOBAL_RESET,
+ *     PCIE_SOC_WAKE;
+ *   - WLAON (cnss2 wlaon_reg_access_seq): SOC_POWER_CTRL, Q6 cookie, WARM_SW_ENTRY (non-zero = the Q6 takes the
+ *     warm path), RESET_DBG_SW_ENTRY, WLAON_DEBUG, WLPM_SIGNAL, PBL_STACK_CANARY, POWERCTRL_PMU, PCIE_PWR_CTRL,
+ *     QFPROM_PWR_CTRL. WLAON_SOC_RESET_CAUSE is read-clear: only 0342 reads it;
+ *   - host PCIe side: the endpoint and root-port command/status and PCIe DEVSTA (status bit 28 received target
+ *     abort / bit 29 received master abort on the endpoint = the chip's BHI read got a CA/UR completion; DEVSTA
+ *     bits 0-3 = correctable / non-fatal / fatal / UR detected), the root port's secondary status, the MSI control.
+ * One line "BOOT <when>: PCIe ..." and one line "BOOT <when>: WLAON ...", plus a verdict line.
+ */
+#define QCA_PCIE_PARF_PM_STTS           0x01e08024u
+#define QCA_WLAON_SOC_POWER_CTRL        0x01f80000u
+#define QCA_WLAON_RESET_DBG_SW_ENTRY    0x01f80508u
+#define QCA_WLAON_DEBUG                 0x01f80600u
+#define QCA_WLAON_WLPM_SIGNAL           0x01f80608u
+#define QCA_WLAON_PBL_STACK_CANARY      0x01f80614u
+#define QCA_WLAON_POWERCTRL_PMU         0x01f806b4u
+#define QCA_WLAON_PCIE_PWR_CTRL         0x01f806bcu
+
+/* the capability ID `id` of a config space, 0 if none (bounded walk; 0344: any ID) */
+static uint32_t
+wlan_cfg_cap(volatile uint32_t *cfg, uint32_t id)
+{
+	for (uint32_t ptr = cfg[0x34 / 4] & 0xfcu, guard = 48; ptr >= 0x40 && guard--; ) {
+		uint32_t h = cfg[ptr / 4];
+		if (h == MHI_ALL_ONES) {
+			return 0;
+		}
+		if ((h & 0xffu) == id) {
+			return ptr;
+		}
+		ptr = (h >> 8) & 0xfcu;
+	}
+	return 0;
+}
+
+/* the PCIe capability (ID 0x10) of a config space, 0 if none */
+static uint32_t
+wlan_pcie_cap(volatile uint32_t *cfg)
+{
+	return wlan_cfg_cap(cfg, 0x10u);
+}
+
+static void
+wlan_boot_dump_pcie(const char *when)
+{
+	if (!g_bootdbg || !g_bar0) {
+		return;
+	}
+	uint32_t ia = negroni_wlan_reg_rd(QCA_PCIE_INT_ALL_STATUS), pi = negroni_wlan_reg_rd(QCA_PCIE_PARF_INT_STATUS);
+	printf("NEGRONI WLAN: BOOT %s: PCIe INT_ALL_STATUS %#x PARF_INT_STATUS %#x INT_ALL_MASK %#x PARF_LTSSM %#x PM_STTS %#x "
+	    "HOT_RST %#x GLOBAL_RESET %#x SOC_WAKE %#x\n", when, ia, pi, negroni_wlan_reg_rd(QCA_PCIE_INT_ALL_MASK),
+	    negroni_wlan_reg_rd(QCA_PCIE_PARF_LTSSM), negroni_wlan_reg_rd(QCA_PCIE_PARF_PM_STTS),
+	    negroni_wlan_reg_rd(QCA_GCC_PCIE_HOT_RST), negroni_wlan_rd(QCA_PCIE_SOC_GLOBAL_RESET),
+	    negroni_wlan_rd(QCA_PCIE_SOC_WAKE));
+	uint32_t warm = negroni_wlan_reg_rd(QCA_WLAON_WARM_SW_ENTRY);
+	printf("NEGRONI WLAN: BOOT %s: WLAON SOC_POWER_CTRL %#x Q6_COOKIE %#x WARM_SW_ENTRY %#x RESET_DBG_SW_ENTRY %#x DEBUG %#x "
+	    "WLPM_SIGNAL %#x PBL_STACK_CANARY %#x POWERCTRL_PMU %#x PCIE_PWR_CTRL %#x QFPROM_PWR_CTRL %#x\n", when,
+	    negroni_wlan_reg_rd(QCA_WLAON_SOC_POWER_CTRL), negroni_wlan_reg_rd(QCA_PCIE_Q6_COOKIE_ADDR), warm,
+	    negroni_wlan_reg_rd(QCA_WLAON_RESET_DBG_SW_ENTRY), negroni_wlan_reg_rd(QCA_WLAON_DEBUG),
+	    negroni_wlan_reg_rd(QCA_WLAON_WLPM_SIGNAL), negroni_wlan_reg_rd(QCA_WLAON_PBL_STACK_CANARY),
+	    negroni_wlan_reg_rd(QCA_WLAON_POWERCTRL_PMU), negroni_wlan_reg_rd(QCA_WLAON_PCIE_PWR_CTRL),
+	    negroni_wlan_reg_rd(QCA_WLAON_QFPROM_PWR_CTRL));
+
+	uint32_t ep_cs = MHI_ALL_ONES, ep_dev = MHI_ALL_ONES, msi = MHI_ALL_ONES;
+	uint32_t rp_cs = MHI_ALL_ONES, rp_sec = MHI_ALL_ONES, rp_dev = MHI_ALL_ONES;
+	if (P.cfg_bus1) {
+		volatile uint32_t *cfg = (volatile uint32_t *)P.cfg_bus1;
+		uint32_t cap = wlan_pcie_cap(cfg);
+		ep_cs = cfg[0x04 / 4];
+		ep_dev = cap ? cfg[(cap + 0x08) / 4] : MHI_ALL_ONES;
+		msi = cfg[0x50 / 4];                    /* survey step 10: MSI capability at 0x50 */
+	}
+	if (P.dbi) {
+		volatile uint32_t *dbi = (volatile uint32_t *)P.dbi;
+		uint32_t cap = wlan_pcie_cap(dbi);
+		rp_cs = dbi[0x04 / 4];
+		rp_sec = dbi[0x1c / 4];
+		rp_dev = cap ? dbi[(cap + 0x08) / 4] : MHI_ALL_ONES;
+	}
+	printf("NEGRONI WLAN: BOOT %s: host PCIe endpoint CMD/STS %#x DEVCTL/STA %#x MSI %#x; root port CMD/STS %#x "
+	    "SEC_STS %#x DEVCTL/STA %#x\n", when, ep_cs, ep_dev, msi, rp_cs, rp_sec, rp_dev);
+
+	/* a verdict from what is set (observations only; the meaning is the PCI spec's and ath11k's) */
+	bool dma_err = ep_cs != MHI_ALL_ONES && (ep_cs & (3u << 28));
+	bool rp_err = rp_sec != MHI_ALL_ONES && (rp_sec & (0xfu << 27));
+	printf("NEGRONI WLAN: BOOT %s: verdict:%s%s%s%s%s\n", when,
+	    (ia && ia != MHI_ALL_ONES) ? " chip PCIe interrupts pending (ath11k: the SBL crashes on them; try negroniwlan_swreset=1)" : "",
+	    (warm && warm != MHI_ALL_ONES) ? " WARM_SW_ENTRY set (ath11k: warm path dead loop; try negroniwlan_swreset=1)" : "",
+	    dma_err ? " the chip received an abort on a DMA read (CA/UR from the host: check the IOVA / SMMU / BDF-to-SID)" : "",
+	    rp_err ? " root port secondary status has error bits" : "",
+	    (!(ia && ia != MHI_ALL_ONES) && !(warm && warm != MHI_ALL_ONES) && !dma_err && !rp_err) ? " no PCIe/WLAON error bit" : "");
+}
+
+/*
+ * 0344: the chip's MSI into a RAM mailbox (boot-arg negroniwlan_msi bit 0). Phone 2026-10-27: BHI SBL DONE, then EE 0,
+ * MHISTATUS 0, no SBL log pointer for 30 s; the endpoint MSI capability (0x50) reads 0x10a7005 = MSI off, 32 vectors,
+ * per-vector mask, 32-bit address only. Linux (ath11k_pci_alloc_msi, cnss2 cnss_pci_enable_msi) always enables MSI
+ * before the MHI power-up; on Android the PCIe0 MSIs go to the GIC ITS, which this port does not set up. Here the MSI
+ * address is the IOVA of one word in our DMA pool (OFF_MSI, its own 4 KiB page between the IPCR rings and the
+ * firmware), mapped through our SMMU context (negroniwlan_smmu=3), so each MSI the chip sends is a 32-bit memory write
+ * of "data base | vector" into that word. Data base 0xa500 (32-aligned: the chip puts the vector in bits 4:0).
+ * The word holds the sentinel 0xffffffff; every poll (the boot dumps, the BHI wait, the READY wait, the service pass)
+ * prints a change and writes the sentinel again. Two MSIs between two polls show as one (the last one wins).
+ * Without an SMMU context the pool is above 4 GiB (RAM starts at 0x840000000) and the 32-bit-only capability cannot
+ * take its address: then MSI stays off. On every failure path (wlan_quiesce) MSI is masked and turned off before the
+ * pool and the SMMU context go away. With MSI off the chip sends no MSI write (PCI 3.0 6.8.1.3: MSI Enable 0 =
+ * the function must not use MSI); masked vectors only set pending bits.
+ */
+#define MSI_CAP_ID              0x05u
+#define MSI_CTL_ENABLE          0x0001u
+#define MSI_CTL_MMC(c)          (((c) >> 1) & 7u)
+#define MSI_CTL_MME(c)          (((c) >> 4) & 7u)
+#define MSI_CTL_MME_MASK        0x0070u
+#define MSI_CTL_64BIT           0x0080u
+#define MSI_CTL_PVM             0x0100u
+#define MSI_DATA_BASE           0xa500u
+#define MSI_SENTINEL            0xffffffffu
+#define MSI_LINES_MAX           64u
+_Static_assert((MSI_DATA_BASE & 31u) == 0, "MSI data base must leave the low 5 bits for 32 vectors");
+
+static uint32_t g_msi_cap;              /* config offset of the capability we programmed (0 = not touched) */
+static bool g_msi_on;
+static uint32_t g_msi_vectors;
+static uint32_t g_msi_count, g_msi_lines;
+static uint64_t g_msi_t0;
+
+bool
+negroni_wlan_msi_on(void)
+{
+	return g_msi_on;
+}
+
+/* register offsets inside the MSI capability (PCI 3.0 6.8.1): 32-bit layout or 64-bit layout */
+static void
+msi_offsets(uint32_t cap, uint32_t ctl, uint32_t *data, uint32_t *mask)
+{
+	bool is64 = (ctl & MSI_CTL_64BIT) != 0;
+
+	*data = cap + (is64 ? 0x0cu : 0x08u);
+	*mask = (ctl & MSI_CTL_PVM) ? cap + (is64 ? 0x10u : 0x0cu) : 0;
+}
+
+void
+negroni_wlan_msi_poll(const char *when)
+{
+	if (!g_msi_on || !g_pool_nc) {
+		return;
+	}
+	volatile uint32_t *box = (volatile uint32_t *)(g_pool_nc + OFF_MSI);
+	uint32_t v = *box;
+	if (v == MSI_SENTINEL) {
+		return;
+	}
+	*box = MSI_SENTINEL;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	g_msi_count++;
+	if (g_msi_lines >= MSI_LINES_MAX) {
+		return;
+	}
+	g_msi_lines++;
+	uint32_t vmask = g_msi_vectors ? g_msi_vectors - 1 : 0;
+	char vec[24];
+	if ((v & ~vmask) == MSI_DATA_BASE) {
+		snprintf(vec, sizeof(vec), "vector %u", v & vmask);
+	} else {
+		snprintf(vec, sizeof(vec), "not our data base");
+	}
+	printf("NEGRONI WLAN: MSI #%u data %#x (%s) at %s after %llu ms%s\n", g_msi_count, v, vec, when,
+	    negroni_wlan_ms() - g_msi_t0, g_msi_lines == MSI_LINES_MAX ? " (last MSI line; later MSIs are only counted)" : "");
+}
+
+/* step 7, after the PBL check, before BHI: bit 1 SOC_WAKE, bit 0 the MSI mailbox. A refusal leaves MSI off (no stop). */
+static void
+wlan_msi_setup(void)
+{
+	volatile uint32_t *cfg = (volatile uint32_t *)P.cfg_bus1;
+
+	if (g_msi_mode & 2u) {
+		uint32_t w0 = negroni_wlan_rd(QCA_PCIE_SOC_WAKE);
+		negroni_wlan_wr(QCA_PCIE_SOC_WAKE, 1);
+		negroni_wlan_nap(5);
+		printf("NEGRONI WLAN: SOC_WAKE %#x -> wrote 1 -> %#x after 5 ms (negroniwlan_msi bit 1)\n", w0,
+		    negroni_wlan_rd(QCA_PCIE_SOC_WAKE));
+	}
+	if (!(g_msi_mode & 1u)) {
+		return;
+	}
+	if (!cfg) {
+		printf("NEGRONI WLAN: MSI: no endpoint config space; MSI stays off\n");
+		return;
+	}
+	uint32_t cap = wlan_cfg_cap(cfg, MSI_CAP_ID);
+	if (!cap) {
+		printf("NEGRONI WLAN: MSI: no MSI capability in the endpoint list; MSI stays off\n");
+		return;
+	}
+	uint32_t hdr = cfg[cap / 4], ctl = hdr >> 16, data_off, mask_off;
+	msi_offsets(cap, ctl, &data_off, &mask_off);
+
+	/* the chip's address for the mailbox: inside the pool's device mapping, inside the SMMU window, 32-bit if need be */
+	uint64_t base = 0, limit = 0, addr = g_pool_dva + OFF_MSI;
+	const char *why = NULL;
+	if (g_pool_dva == WLAN_DMA_NONE || !g_pool_nc) {
+		why = "the DMA pool has no device address";
+	} else if (g_smmu_policy != 3 || !negroni_wlan_smmu_window(&base, &limit)) {
+		why = "no SMMU context (negroniwlan_smmu=3 needed: the pool's physical address is above 4 GiB)";
+	} else if (g_pool_dva < base || g_pool_dva + NEGRONI_WLAN_POOL_SIZE - 1 > limit || addr + 3 > limit) {
+		why = "the mailbox IOVA is outside the SMMU window";
+	} else if (!(ctl & MSI_CTL_64BIT) && addr > 0xfffffffcull) {
+		why = "the capability takes a 32-bit address only";
+	} else if (ctl & MSI_CTL_ENABLE) {
+		why = "MSI is already enabled (not by us)";
+	}
+	/*
+	 * the root port's iMSI-RX (DWC PCIE_MSI_ADDR_LO/HI, DBI 0x820/0x824) ends an inbound write to its address in the
+	 * port and never sends it to the SMMU. Linux (dw_pcie_msi_init) programs it; our survey does not: log what the
+	 * UEFI left, and refuse a mailbox in the same 4 KiB page.
+	 */
+	if (!why && P.dbi) {
+		volatile uint32_t *dbi = (volatile uint32_t *)P.dbi;
+		uint32_t imsi_lo = dbi[0x820 / 4], imsi_hi = dbi[0x824 / 4], imsi_en = dbi[0x828 / 4];
+		printf("NEGRONI WLAN: MSI: root port iMSI-RX address %#x:%08x, vector enable %#x (DBI 0x820/0x824/0x828)\n",
+		    imsi_hi, imsi_lo, imsi_en);
+		if (imsi_hi == (uint32_t)(addr >> 32) && (imsi_lo & ~0xfffu) == ((uint32_t)addr & ~0xfffu)) {
+			why = "the root port iMSI-RX address is in the mailbox page (the write would stop in the port)";
+		}
+	}
+	if (why) {
+		printf("NEGRONI WLAN: MSI: capability %#x control %#x, mailbox %#llx: %s; MSI stays off\n", cap, ctl, addr, why);
+		return;
+	}
+
+	volatile uint32_t *box = (volatile uint32_t *)(g_pool_nc + OFF_MSI);
+	*box = MSI_SENTINEL;
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	g_msi_cap = cap;                /* from here on wlan_msi_off undoes it */
+	cfg[(cap + 0x04) / 4] = (uint32_t)addr;
+	if (ctl & MSI_CTL_64BIT) {
+		cfg[(cap + 0x08) / 4] = (uint32_t)(addr >> 32);
+	}
+	cfg[data_off / 4] = MSI_DATA_BASE;      /* the upper 16 bits (extended data) stay 0 */
+	if (mask_off) {
+		cfg[mask_off / 4] = 0;          /* all vectors unmasked */
+	}
+	uint32_t mmc = MSI_CTL_MMC(ctl);
+	uint32_t nctl = (ctl & ~(uint32_t)MSI_CTL_MME_MASK) | (mmc << 4) | MSI_CTL_ENABLE;
+	cfg[cap / 4] = (nctl << 16) | (hdr & 0xffffu);   /* ID and next pointer are read only */
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	uint32_t rctl = cfg[cap / 4] >> 16, raddr = cfg[(cap + 0x04) / 4], rdata = cfg[data_off / 4] & 0xffffu;
+	uint32_t rmask = mask_off ? cfg[mask_off / 4] : 0;
+	g_msi_vectors = 1u << MSI_CTL_MME(rctl);
+	g_msi_count = g_msi_lines = 0;
+	g_msi_t0 = negroni_wlan_ms();
+	g_msi_on = (rctl & MSI_CTL_ENABLE) && raddr == (uint32_t)addr && rdata == MSI_DATA_BASE;
+	printf("NEGRONI WLAN: MSI %s: capability %#x control %#x -> %#x (%u of %u vectors, %s address, per-vector mask %s), "
+	    "address %#x (pool + %#x, SMMU window %#llx-%#llx), data %#x, mask %#x, mailbox %#x\n",
+	    g_msi_on ? "on" : "DID NOT TAKE", cap, ctl, rctl, g_msi_vectors, 1u << mmc, (ctl & MSI_CTL_64BIT) ? "64-bit" : "32-bit",
+	    mask_off ? "yes" : "no", raddr, OFF_MSI, base, limit, rdata, rmask, *box);
+	if (!g_msi_on) {
+		cfg[cap / 4] = ((rctl & ~(uint32_t)(MSI_CTL_ENABLE | MSI_CTL_MME_MASK)) << 16) | (hdr & 0xffffu);
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
+
+/* every failure path (wlan_quiesce), before the pool and the SMMU context go: no MSI write to a stale address later */
+static void
+wlan_msi_off(const char *why)
+{
+	volatile uint32_t *cfg = (volatile uint32_t *)P.cfg_bus1;
+	uint32_t cap = g_msi_cap;
+
+	if (!cap || !cfg) {
+		return;
+	}
+	negroni_wlan_msi_poll(why);     /* the last MSI before the stop */
+	uint32_t hdr = cfg[cap / 4], ctl = hdr >> 16, data_off, mask_off;
+	g_msi_on = false;
+	if (hdr == MHI_ALL_ONES) {
+		/* link down: the chip cannot send anything upstream; the SMMU context still goes away after the quiesce */
+		g_msi_cap = 0;
+		printf("NEGRONI WLAN: MSI off (%s): config space reads 0xffffffff (link down); not written, %u MSIs seen\n", why,
+		    g_msi_count);
+		return;
+	}
+	msi_offsets(cap, ctl, &data_off, &mask_off);
+	if (mask_off) {
+		cfg[mask_off / 4] = 0xffffffffu;        /* mask first: no new message */
+	}
+	cfg[cap / 4] = ((ctl & ~(uint32_t)(MSI_CTL_ENABLE | MSI_CTL_MME_MASK)) << 16) | (hdr & 0xffffu);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	cfg[(cap + 0x04) / 4] = 0;
+	if (ctl & MSI_CTL_64BIT) {
+		cfg[(cap + 0x08) / 4] = 0;
+	}
+	cfg[data_off / 4] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	g_msi_on = false;
+	g_msi_cap = 0;
+	printf("NEGRONI WLAN: MSI off (%s): control %#x, address %#x, %u MSIs seen\n", why, cfg[cap / 4] >> 16,
+	    cfg[(cap + 0x04) / 4], g_msi_count);
+}
+
+/* Turn off bus mastering: from here on the chip cannot read or write host memory (PCIe BME). */
+static void
+wlan_quiesce(struct negroni_wlan_pcie *p)
+{
+	volatile uint32_t *cfg = (volatile uint32_t *)p->cfg_bus1;
+
+	wlan_msi_off("stop");          /* 0344: before the MHI reset and the frees */
+	negroni_wlan_mhi_reset(&H);
+	cfg[0x04 / 4] = (cfg[0x04 / 4] & 0xffff) & ~(1u << 2);
+	(void)cfg[0x04 / 4];                            /* non-posted read: the write has landed */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	delay(10000);
+	printf("NEGRONI WLAN: MHI reset requested and bus master off, command %#x\n", cfg[0x04 / 4] & 0xffff);
+}
+
+/* Read one named file of the area into dst and check its SHA-256 (0266: shared with level 6). */
+static int
+wlan_area_get(const struct wlan_area_header *hdr, const char *name, void *dst, uint32_t cap, uint32_t *out)
+{
+	for (uint32_t i = 0; i < hdr->count; i++) {
+		const struct wlan_area_entry *e = &hdr->e[i];
+
+		if (strncmp(e->name, name, sizeof(e->name)) != 0) {
+			continue;
+		}
+		if (e->size == 0 || e->size > cap || e->offset < WLAN_AREA_HDR) {
+			printf("NEGRONI WLAN: %s size %u / offset %#x out of range\n", name, e->size, e->offset);
+			return ERANGE;
+		}
+		int error = negroni_ufs_wlan_area_read(e->offset, dst, e->size);
+		if (error) {
+			printf("NEGRONI WLAN: %s read error %d\n", name, error);
+			return error;
+		}
+		uint8_t digest[32];
+		SHA256_CTX c;
+		SHA256_Init(&c);
+		SHA256_Update(&c, dst, e->size);
+		SHA256_Final(digest, &c);
+		if (memcmp(digest, e->sha256, 32) != 0) {
+			printf("NEGRONI WLAN: %s %u bytes loaded, sha-256 MISMATCH; stop\n", name, e->size);
+			return EBADMSG;
+		}
+		printf("NEGRONI WLAN: %s %u bytes loaded, sha-256 OK\n", name, e->size);
+		*out = e->size;
+		return 0;
+	}
+	printf("NEGRONI WLAN: %s not found in the firmware area\n", name);
+	return ENOENT;
+}
+
+/* Read one named file from the area into the pool (cacheable view), check SHA-256, push it to RAM. */
+static int
+wlan_load(const struct wlan_area_header *hdr, const char *name, uint32_t off, uint32_t cap, uint32_t *out)
+{
+	int error = wlan_area_get(hdr, name, (void *)(g_pool_kva + off), cap, out);
+
+	if (!error) {
+		flush_dcache64((addr64_t)(g_pool_pa + off), *out, TRUE);
+	}
+	return error;
+}
+
+int
+negroni_wlan_fw_file(const char *name, void *dst, uint32_t cap, uint32_t *size)
+{
+	struct wlan_area_header *hdr = NULL;
+	int error;
+
+	if (kmem_alloc(kernel_map, (vm_offset_t *)&hdr, WLAN_AREA_HDR, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	error = negroni_ufs_wlan_area_read(0, hdr, WLAN_AREA_HDR);
+	if (!error && (memcmp(hdr->magic, "NEGRWLAN", 8) != 0 || hdr->version != 1 || hdr->count == 0 ||
+	    hdr->count > WLAN_FW_MAX)) {
+		error = EINVAL;
+	}
+	if (!error) {
+		error = wlan_area_get(hdr, name, dst, cap, size);
+	}
+	kmem_free(kernel_map, (vm_offset_t)hdr, WLAN_AREA_HDR);
+	return error;
+}
+
+/* Fill the ring/context pointers of H from the pool layout (non-cacheable view). */
+static void
+wlan_rings(void)
+{
+	vm_offset_t nc = g_pool_nc;     /* integer base: offset math, then cast (no cast-align) */
+
+	H.pool = g_pool_nc;
+	H.pool_pa = g_pool_dva;         /* 0320: every ring address below is the chip's view */
+
+	H.ev[0].va = (volatile struct mhi_el *)(nc + OFF_EV0);
+	H.ev[0].pa = g_pool_dva + OFF_EV0;
+	H.ev[0].n = EV0_N;
+	H.ev[0].ctx = (volatile struct mhi_ctx *)(nc + OFF_EVCTX);
+	H.ev[1].va = (volatile struct mhi_el *)(nc + OFF_EV1);
+	H.ev[1].pa = g_pool_dva + OFF_EV1;
+	H.ev[1].n = EV1_N;
+	H.ev[1].ctx = (volatile struct mhi_ctx *)(nc + OFF_EVCTX + sizeof(struct mhi_ctx));
+
+	H.cmd.va = (volatile struct mhi_el *)(nc + OFF_CMD);
+	H.cmd.pa = g_pool_dva + OFF_CMD;
+	H.cmd.n = CMD_N;
+	H.cmd.ctx = (volatile struct mhi_ctx *)(nc + OFF_CMDCTX);
+
+	H.ch_out.va = (volatile struct mhi_el *)(nc + OFF_CH20);
+	H.ch_out.pa = g_pool_dva + OFF_CH20;
+	H.ch_out.n = CH_N;
+	H.ch_out.ctx = (volatile struct mhi_ctx *)(nc + OFF_CHCTX + MHI_IPCR_OUT * sizeof(struct mhi_ctx));
+	H.ch_in.va = (volatile struct mhi_el *)(nc + OFF_CH21);
+	H.ch_in.pa = g_pool_dva + OFF_CH21;
+	H.ch_in.n = CH_N;
+	H.ch_in.ctx = (volatile struct mhi_ctx *)(nc + OFF_CHCTX + MHI_IPCR_IN * sizeof(struct mhi_ctx));
+}
+
+/*
+ * Build the BHIe vector table over the contiguous firmware: one { u64 pa, u64 size } per 512 KiB
+ * segment, the last one holds the rest (boot.c mhi_firmware_copy).
+ */
+static uint32_t
+wlan_vector(uint32_t fw_size)
+{
+	volatile uint64_t *vec = (volatile uint64_t *)(g_pool_nc + OFF_VEC);
+	uint32_t entries = (fw_size + MHI_SEG - 1) / MHI_SEG;
+
+	for (uint32_t i = 0; i < entries; i++) {
+		uint32_t seg = (i + 1 == entries) ? (fw_size - i * MHI_SEG) : MHI_SEG;
+
+		vec[i * 2] = g_pool_dva + OFF_FW + (uint64_t)i * MHI_SEG;
+		vec[i * 2 + 1] = seg;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return entries;
+}
+
+static void
+wlan_cleanup(void)
+{
+	negroni_wlan_wlfw_free();       /* 0266: firmware memory segments (after wlan_quiesce) */
+	negroni_wlan_ce_free();         /* 0321: CE rings and buffers */
+	negroni_wlan_dp_free();         /* 0328: DP rings, link descriptors, rx/tx buffers */
+	if (H.xfer_nc) {
+		ml_io_unmap(H.xfer_nc, WLAN_XFER_SIZE);
+		H.xfer_nc = 0;
+	}
+	if (g_xfer_kva) {
+		flush_dcache64((addr64_t)g_xfer_pa, WLAN_XFER_SIZE, TRUE);
+		kmem_free(kernel_map, g_xfer_kva, WLAN_XFER_SIZE);
+		g_xfer_kva = 0;
+	}
+	if (g_pool_nc) {
+		ml_io_unmap(g_pool_nc, WLAN_POOL_MAP);
+		g_pool_nc = 0;
+	}
+	if (g_bar0) {
+		/* after wlan_quiesce: nothing reads BAR0 any more */
+		vm_offset_t va = g_bar0 & ~(vm_offset_t)PAGE_MASK;
+		ml_io_unmap(va, ((vm_size_t)g_bar_len + (g_bar0 - va) + PAGE_MASK) & ~(vm_size_t)PAGE_MASK);
+		g_bar0 = 0;
+		g_bar_len = 0;
+	}
+	if (g_pool_kva) {
+		/* drop any line the cacheable view holds, so the next owner reads what is in RAM */
+		flush_dcache64((addr64_t)g_pool_pa, NEGRONI_WLAN_POOL_SIZE, TRUE);
+		kmem_free(kernel_map, g_pool_kva, NEGRONI_WLAN_POOL_SIZE);
+		g_pool_kva = 0;
+	}
+}
+
+/*
+ * Step 6 (0263, read only unless negroniwlan_smmu=2): can the chip's DMA reach RAM?
+ * PCIe0 DMA uses apps-SMMU stream 0x1c01 (out/live.dts iommu-map) through the PCIe TBU
+ * (clock gcc_ddrss_pcie_sf_tbu_clk) and the aggre NoC (gcc_aggre_noc_pcie_0_axi_clk). A stream
+ * the SMMU faults, or a gated TBU/NoC clock, can hang or fault the first BHI read [I]; the phone
+ * restarted during the first BHI SBL download (notes section 16, 2026-10-26).
+ */
+#include "negroni_mmio.h"      /* 0255: hypervisor-safe apps SMMU access (here: later patches anchor on the include list) */
+#define APPS_SMMU_PHYS          0x15000000u
+#define SMMU_SCR0               0x000
+#define SMMU_SCR0_CLIENTPD      (1u << 0)
+#define SMMU_SCR0_USFCFG        (1u << 10)
+#define SMMU_SCR0_EXIDENABLE    (1u << 3)
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_SGFSR              0x048
+#define SMMU_SMR(n)             (0x800u + 4u * (n))
+#define SMMU_S2CR(n)            (0xc00u + 4u * (n))
+#define SMMU_SMR_VALID          (1u << 31)
+#define PCIE0_SID               0x1c01u
+#define GCC_AGGRE_NOC_PCIE_0    0x7b08cu        /* gcc-sm8450.c gcc_aggre_noc_pcie_0_axi_clk halt reg */
+#define GCC_DDRSS_PCIE_SF_TBU   0x9d094u        /* gcc_ddrss_pcie_sf_tbu_clk halt reg */
+#define GCC_CLK_OFF             (1u << 31)
+#define GCC_VOTE_0              0x62000u        /* APCS clock branch enable vote */
+#define GCC_VOTE_NOC            (1u << 12)      /* gcc_aggre_noc_pcie_0_axi_clk */
+#define GCC_VOTE_TBU            (1u << 19)      /* gcc_ddrss_pcie_sf_tbu_clk */
+
+static int
+wlan_dma_path(void)
+{
+	uint32_t noc = MHI_ALL_ONES, tbu = MHI_ALL_ONES, vote = MHI_ALL_ONES;
+
+	if (P.gcc) {
+		noc = *(volatile uint32_t *)(P.gcc + GCC_AGGRE_NOC_PCIE_0);
+		tbu = *(volatile uint32_t *)(P.gcc + GCC_DDRSS_PCIE_SF_TBU);
+		vote = *(volatile uint32_t *)(P.gcc + GCC_VOTE_0);
+	}
+	/*
+	 * Both branches are BRANCH_HALT_SKIP with hardware clock gating (gcc-waipio.c:1756, :1971): CLK_OFF
+	 * (bit 31) reads 1 while the branch is idle, so it is only a report. The proof is the vote bit
+	 * in GCC 0x62000 (bit 12 NoC, bit 19 TBU; gcc-waipio.c:1761, :1976), set by survey step 5.
+	 */
+	printf("NEGRONI WLAN: GCC AGGRE_NOC_PCIE_0_AXI %#x (CLK_OFF %u), DDRSS_PCIE_SF_TBU %#x (CLK_OFF %u), vote %#x = %#x\n",
+	    noc, (noc & GCC_CLK_OFF) ? 1 : 0, tbu, (tbu & GCC_CLK_OFF) ? 1 : 0, GCC_VOTE_0, vote);
+	if (g_smmu_policy != 0 && P.gcc && (vote & (GCC_VOTE_NOC | GCC_VOTE_TBU)) != (GCC_VOTE_NOC | GCC_VOTE_TBU)) {
+		return negroni_wlan_failed(EPERM, "GCC vote %#x lacks the PCIe NoC (bit 12) or TBU (bit 19) clock: chip DMA would hang",
+		           vote);
+	}
+
+	wlan_pcie_sid(g_smmu_policy == 3);     /* 0325: which SID the chip's DMA carries */
+	if (g_smmu_policy == 3) {
+		return negroni_wlan_smmu_on();  /* 0324: our own translation context, no bypass entry */
+	}
+	vm_offset_t smmu = ml_io_map_unmappable(APPS_SMMU_PHYS, PAGE_SIZE, WLAN_WIMG_IO);
+	if (!smmu) {
+		printf("NEGRONI WLAN: apps SMMU map failed; DMA path not checked\n");
+		return 0;
+	}
+	/* single plain ldr/str only: Gunyah emulates this space and injects an SEA on writeback/pair/WZR (0255) */
+#define SRD(o) negroni_mmio_rd32(smmu + (o))
+#define SWR(o, v) negroni_mmio_wr32(smmu + (o), (v))
+	uint32_t scr0 = SRD(SMMU_SCR0), idr0 = SRD(SMMU_IDR0), idr1 = SRD(SMMU_IDR1), gfsr = SRD(SMMU_SGFSR);
+	uint32_t nsmr = MIN(MIN(idr0 & 0xffu, 0x78u), 128u), hit = ~0u, free_smr = ~0u, s2cr = 0;
+	int error = 0;
+
+	printf("NEGRONI WLAN: apps SMMU sCR0 %#x (CLIENTPD %u, USFCFG %u, EXIDS %u), IDR0 %#x (%u SMRs), IDR1 %#x, sGFSR %#x\n",
+	    scr0, scr0 & SMMU_SCR0_CLIENTPD ? 1 : 0, scr0 & SMMU_SCR0_USFCFG ? 1 : 0,
+	    scr0 & SMMU_SCR0_EXIDENABLE ? 1 : 0, idr0, nsmr, idr1, gfsr);
+	if (scr0 == MHI_ALL_ONES || idr0 == MHI_ALL_ONES || nsmr == 0) {
+		printf("NEGRONI WLAN: apps SMMU global space does not answer; DMA path not checked\n");
+		goto out;
+	}
+	if (scr0 & SMMU_SCR0_EXIDENABLE) {
+		/* extended stream IDs: VALID moves to S2CR bit 10 and the SMR holds 16-bit IDs; no scan, no write */
+		printf("NEGRONI WLAN: apps SMMU EXIDS set; SMR format not handled, DMA path not checked\n");
+		goto out;
+	}
+	for (uint32_t i = 0; i < nsmr; i++) {
+		uint32_t smr = SRD(SMMU_SMR(i));
+		uint32_t id = smr & 0x7fffu, mask = (smr >> 16) & 0x7fffu;
+
+		if (!(smr & SMMU_SMR_VALID)) {
+			if (free_smr == ~0u) {
+				free_smr = i;
+			}
+			continue;
+		}
+		if (((id ^ PCIE0_SID) & ~mask & 0x7fffu) == 0 && hit == ~0u) {
+			hit = i;
+		}
+	}
+	if (hit != ~0u) {
+		s2cr = SRD(SMMU_S2CR(hit));
+		uint32_t type = (s2cr >> 16) & 3u;
+		printf("NEGRONI WLAN: stream %#x matches SMR%u %#x, S2CR %#x (%s, context %u)\n", PCIE0_SID, hit,
+		    SRD(SMMU_SMR(hit)), s2cr, type == 0 ? "translate" : type == 1 ? "bypass" : "fault", s2cr & 0xffu);
+		if (type == 2 && g_smmu_policy != 0) {
+			error = negroni_wlan_failed(EPERM, "SMMU stream %#x is set to fault (S2CR%u %#x)", PCIE0_SID, hit, s2cr);
+		} else if (type == 0) {
+			/* a context we did not program: the chip's physical addresses would be translated */
+			printf("NEGRONI WLAN: stream %#x goes through context %u that this kernel did not set up [I]\n",
+			    PCIE0_SID, s2cr & 0xffu);
+			if (g_smmu_policy != 0) {
+				error = negroni_wlan_failed(EPERM, "SMMU stream %#x translates through context %u (not ours)",
+				           PCIE0_SID, s2cr & 0xffu);
+			}
+		}
+		goto out;
+	}
+	if (scr0 & SMMU_SCR0_CLIENTPD) {
+		printf("NEGRONI WLAN: stream %#x has no SMR; the SMMU is in client bypass (CLIENTPD)\n", PCIE0_SID);
+		goto out;
+	}
+	if (!(scr0 & SMMU_SCR0_USFCFG)) {
+		printf("NEGRONI WLAN: stream %#x has no SMR; unmatched streams bypass (USFCFG 0)\n", PCIE0_SID);
+		goto out;
+	}
+	printf("NEGRONI WLAN: stream %#x has no SMR and unmatched streams FAULT (USFCFG 1)\n", PCIE0_SID);
+	if (g_smmu_policy == 2 && free_smr != ~0u) {
+		/* opt-in write: S2CR bypass first, then the SMR (arm-smmu.c order: S2CR before SMR valid) */
+		SWR(SMMU_S2CR(free_smr), 1u << 16);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		SWR(SMMU_SMR(free_smr), SMMU_SMR_VALID | PCIE0_SID);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		uint32_t smr = SRD(SMMU_SMR(free_smr)), s2 = SRD(SMMU_S2CR(free_smr));
+		printf("NEGRONI WLAN: SMR%u = %#x, S2CR%u = %#x (bypass for stream %#x, negroniwlan_smmu=2)\n",
+		    free_smr, smr, free_smr, s2, PCIE0_SID);
+		if (smr != (SMMU_SMR_VALID | PCIE0_SID) || ((s2 >> 16) & 3u) != 1u) {
+			error = negroni_wlan_failed(EPERM, "the SMMU (or the hypervisor) did not take the bypass entry");
+		}
+	} else if (g_smmu_policy != 0) {
+		error = negroni_wlan_failed(EPERM, "SMMU stream %#x would fault; boot with negroniwlan_smmu=2 to add a "
+		           "bypass entry, or =0 to try anyway", PCIE0_SID);
+	}
+out:
+#undef SRD
+#undef SWR
+	ml_io_unmap(smmu, PAGE_SIZE);
+	return error;
+}
+
+/* ---- level 2: steps 1-8 (BAR0, firmware, pool, DMA path, PBL, BHI SBL) ---- */
+static int
+wlan_level_sbl(void)
+{
+	struct wlan_area_header *hdr = NULL;
+	uint32_t ee, st;
+	int error;
+
+	negroni_wlan_step(1, "PCIe link hand-over");
+	if (!negroni_wifi_pcie_handles(&P) || !P.linked) {
+		printf("NEGRONI WLAN: the PCIe survey did not hand over a live link; stop\n");
+		return negroni_wlan_failed(ENXIO, "the survey did not hand over a live PCIe link");
+	}
+	printf("NEGRONI WLAN: reusing survey PCIe handles, chip %04x:%04x\n", P.chip_id & 0xffff, P.chip_id >> 16);
+
+	negroni_wlan_step(2, "BAR0 claim");
+	error = wlan_bar0(&P);
+	if (error) {
+		return error;   /* no DMA address was given yet */
+	}
+	g_master = true;
+	wlan_aspm_off(&P);      /* 0325 */
+	H.bar = g_bar0;
+	H.bar_len = g_bar_len;
+	H.timeout_ms = g_timeout_ms;
+
+	negroni_wlan_step(3, "SoC version");
+	uint32_t soc = negroni_wlan_rd(SOC_VERSION);
+	if (soc == MHI_ALL_ONES) {
+		printf("NEGRONI WLAN: SoC version reads 0xffffffff; stop\n");
+		return negroni_wlan_failed(EIO, "SoC version (BAR0 + 0x224) reads 0xffffffff");
+	}
+	uint32_t major = (soc >> 8) & 0xff;
+	g_fw = ((major & 0xf) == 2) ? "amss20.bin" : "amss.bin";  /* cnss2 pci.c: lower 4 bits, FW_V2_NUMBER */
+	printf("NEGRONI WLAN: SoC version %#x (major %u) -> firmware %s\n", soc, major, g_fw);
+
+	negroni_wlan_step(4, "DMA pool");
+	if (kmem_alloc_contig(kernel_map, &g_pool_kva, NEGRONI_WLAN_POOL_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("NEGRONI WLAN: no %u byte contiguous DMA pool\n", NEGRONI_WLAN_POOL_SIZE);
+		g_pool_kva = 0;
+		return negroni_wlan_failed(ENOMEM, "no %u byte contiguous DMA pool", NEGRONI_WLAN_POOL_SIZE);
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)g_pool_kva);
+	if (!pn) {
+		return negroni_wlan_failed(ENOMEM, "the DMA pool has no physical page");
+	}
+	g_pool_pa = ptoa_64(pn);
+	if (g_pool_pa + NEGRONI_WLAN_POOL_SIZE - 1 > MHI_DMA_MASK) {
+		return negroni_wlan_failed(ERANGE, "DMA pool %#llx is above the chip's 36-bit DMA mask", g_pool_pa);
+	}
+	/* zeroes to RAM, no line left in the cacheable view (the chip and the NC view see RAM) */
+	flush_dcache64((addr64_t)g_pool_pa, NEGRONI_WLAN_POOL_SIZE, TRUE);
+	g_pool_nc = ml_io_map_unmappable((vm_offset_t)g_pool_pa, NEGRONI_WLAN_POOL_SIZE, WLAN_WIMG_WCOMB);
+	if (!g_pool_nc) {
+		return negroni_wlan_failed(ENOMEM, "the non-cacheable pool map failed");
+	}
+	printf("NEGRONI WLAN: DMA pool %u bytes at %#llx\n", NEGRONI_WLAN_POOL_SIZE, g_pool_pa);
+	g_pool_dva = g_pool_pa;         /* 0320: step 6 replaces it when an SMMU context translates (0324) */
+
+	negroni_wlan_step(5, "firmware area");
+	if (kmem_alloc(kernel_map, (vm_offset_t *)&hdr, WLAN_AREA_HDR, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return negroni_wlan_failed(ENOMEM, "no memory for the area header");
+	}
+	error = negroni_ufs_wlan_area_read(0, hdr, WLAN_AREA_HDR);
+	if (error || memcmp(hdr->magic, "NEGRWLAN", 8) != 0 || hdr->version != 1 ||
+	    hdr->count == 0 || hdr->count > WLAN_FW_MAX) {
+		printf("NEGRONI WLAN: no firmware area header (error %d)\n", error);
+		kmem_free(kernel_map, (vm_offset_t)hdr, WLAN_AREA_HDR);
+		return negroni_wlan_failed(error ? error : EINVAL, "no firmware area header (read error %d); write "
+		           "out/wlan-area.bin (README-wifi.md)", error);
+	}
+	printf("NEGRONI WLAN: firmware area has %u files\n", hdr->count);
+	error = wlan_load(hdr, g_fw, OFF_FW, FW_CAP, &g_fw_size);
+	if (!error) {
+		error = wlan_load(hdr, "m3.bin", OFF_M3, M3_CAP, &g_m3_size);
+	}
+	kmem_free(kernel_map, (vm_offset_t)hdr, WLAN_AREA_HDR);
+	if (error) {
+		return negroni_wlan_failed(error, "loading %s / m3.bin from the area failed", g_fw);
+	}
+
+	negroni_wlan_step(6, "DMA path (clocks, apps SMMU)");
+	error = wlan_dma_path();
+	if (error) {
+		return error;
+	}
+	g_pool_dva = negroni_wlan_dma_map(g_pool_pa, NEGRONI_WLAN_POOL_SIZE);  /* 0324: an IOVA with smmu=3 */
+	if (g_pool_dva == WLAN_DMA_NONE) {
+		return negroni_wlan_failed(ENOMEM, "no device address for the DMA pool");
+	}
+
+	negroni_wlan_step(7, "PBL check");
+	error = wlan_sw_reset();        /* 0342: negroniwlan_swreset */
+	if (error) {
+		return error;
+	}
+	wlan_rings();
+	H.bhi = negroni_wlan_rd(MHI_BHIOFF);
+	H.bhie = negroni_wlan_rd(MHI_BHIEOFF);
+	if (H.bhi == 0 || (H.bhi & 3) || H.bhi >= g_bar_len || g_bar_len - H.bhi < BHI_SPAN ||
+	    H.bhie == 0 || (H.bhie & 3) || H.bhie >= g_bar_len || g_bar_len - H.bhie < BHIE_SPAN) {
+		printf("NEGRONI WLAN: BHI off %#x / BHIe off %#x outside BAR0 (%#x bytes); stop\n",
+		    H.bhi, H.bhie, g_bar_len);
+		error = negroni_wlan_failed(ERANGE, "BHI off %#x / BHIe off %#x outside BAR0", H.bhi, H.bhie);
+		H.bhi = 0;      /* later status lines must not read through a bad offset */
+		return error;
+	}
+	ee = negroni_wlan_rd(H.bhi + BHI_EXECENV);
+	st = negroni_wlan_rd(MHI_STATUS);
+	printf("NEGRONI WLAN: BHI off %#x, BHIe off %#x, execution environment %u, MHISTATUS %#x, serial %#x\n",
+	    H.bhi, H.bhie, ee, st, negroni_wlan_rd(H.bhi + BHI_SERIALNU));
+	/*
+	 * 0342: with negroniwlan_swreset >= 1, a PBL with SYSERR is reset as Linux does (op-kernel pm.c:1141-1164
+	 * mhi_async_power_up: MHICTRL RESET, wait for the chip to clear it, BHI_INTVEC again).
+	 */
+	if (g_swreset && ee == MHI_EE_PBL && st != MHI_ALL_ONES && (st & MHI_STATUS_SYSERR)) {
+		uint64_t t0 = negroni_wlan_ms();
+		uint32_t c;
+		negroni_wlan_wr(MHI_CTRL, MHI_CTRL_RESET);
+		do {
+			negroni_wlan_nap(5);
+			c = negroni_wlan_rd(MHI_CTRL);
+		} while (c != MHI_ALL_ONES && (c & MHI_CTRL_RESET) && negroni_wlan_ms() - t0 < g_timeout_ms);
+		negroni_wlan_wr(H.bhi + BHI_INTVEC, 0);
+		st = negroni_wlan_rd(MHI_STATUS);
+		ee = negroni_wlan_rd(H.bhi + BHI_EXECENV);
+		printf("NEGRONI WLAN: PBL had SYSERR: MHICTRL RESET -> MHICTRL %#x after %llu ms, now EE %u MHISTATUS %#x\n", c,
+		    negroni_wlan_ms() - t0, ee, st);
+	}
+	/* only the cold path: PBL -> BHI (pm.c: MHI_IN_PBL -> DEV_ST_TRANSITION_PBL) */
+	if (ee != MHI_EE_PBL || st == MHI_ALL_ONES || (st & MHI_STATUS_SYSERR)) {
+		printf("NEGRONI WLAN: the chip is not in PBL (need execution environment 0, no SYSERR); stop\n");
+		return negroni_wlan_failed(EIO, "the chip is not in PBL (EE %u, MHISTATUS %#x)", ee, st);
+	}
+	wlan_msi_setup();               /* 0344: negroniwlan_msi (default 0: nothing) */
+
+	/*
+	 * 0339: the image as the chip will read it (through the Normal non-cacheable view = RAM after the clean to PoC):
+	 * an ELF header (7f 45 4c 46) at the start of the SBL; and the state before the doorbell.
+	 */
+	{
+		volatile const uint8_t *img = (volatile const uint8_t *)(g_pool_nc + OFF_FW);
+		printf("NEGRONI WLAN: SBL image in RAM: %02x %02x %02x %02x %02x %02x %02x %02x (%s), %u of %u bytes, device %#llx\n",
+		    img[0], img[1], img[2], img[3], img[4], img[5], img[6], img[7],
+		    (img[0] == 0x7f && img[1] == 'E' && img[2] == 'L' && img[3] == 'F') ? "ELF" : "NOT ELF", MIN(g_fw_size, MHI_SEG),
+		    g_fw_size, g_pool_dva + OFF_FW);
+		negroni_wlan_boot_dump(&H, "before BHI");
+	}
+
+	/* BHI: the SBL, the first 512 KiB of the image (op-kernel boot.c:247 mhi_fw_load_bhi, :493 sbl_size) */
+	negroni_wlan_step(8, "BHI SBL download");
+	return negroni_wlan_bhi_sbl(&H, g_pool_dva + OFF_FW, MIN(g_fw_size, MHI_SEG));
+}
+
+/* ---- level 3: steps 9-12 (pm.c:193 mhi_ready_state_transition, called from boot.c:546) ---- */
+static int
+wlan_level_mhi(void)
+{
+	int error;
+
+	negroni_wlan_step(9, "MHI READY");
+	error = negroni_wlan_mhi_ready(&H);
+	if (error) {
+		return error;
+	}
+	negroni_wlan_step(10, "MHI MMIO contexts");
+	error = negroni_wlan_mhi_init(&H);
+	if (error) {
+		return error;
+	}
+	negroni_wlan_step(11, "MHI M0");
+	error = negroni_wlan_mhi_m0(&H);
+	if (error) {
+		return error;
+	}
+	/* the SBL runs: EE event SBL (pm.c:767 DEV_ST_TRANSITION_SBL) */
+	negroni_wlan_step(12, "EE SBL");
+	return negroni_wlan_mhi_wait_ee(&H, MHI_EE_SBL, "SBL");
+}
+
+/* ---- level 4: steps 13-15 (pm.c:780 mhi_download_amss_image -> boot.c:566, mission mode, channels) ---- */
+static int
+wlan_level_amss(void)
+{
+	int error;
+
+	negroni_wlan_step(13, "BHIe full image");
+	uint32_t entries = wlan_vector(g_fw_size);
+	error = negroni_wlan_bhie_image(&H, g_pool_dva + OFF_VEC, entries);
+	if (error) {
+		return error;
+	}
+	negroni_wlan_step(14, "EE AMSS (mission)");
+	error = negroni_wlan_mhi_wait_ee(&H, MHI_EE_AMSS, "AMSS (mission)");
+	if (error) {
+		return error;
+	}
+	negroni_wlan_step(15, "IPCR channels 20/21");
+	/* 0264: RX/TX buffers for QRTR, a second contiguous allocation (inside the 0..36-bit MHI window) */
+	if (kmem_alloc_contig(kernel_map, &g_xfer_kva, WLAN_XFER_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		g_xfer_kva = 0;
+		return negroni_wlan_failed(ENOMEM, "no %u byte contiguous transfer buffer", WLAN_XFER_SIZE);
+	}
+	ppnum_t xpn = pmap_find_phys(kernel_pmap, (addr64_t)g_xfer_kva);
+	if (!xpn || ptoa_64(xpn) + WLAN_XFER_SIZE - 1 > MHI_DMA_MASK) {
+		return negroni_wlan_failed(ERANGE, "transfer buffer page %#x outside the DMA mask", xpn);
+	}
+	g_xfer_pa = ptoa_64(xpn);
+	flush_dcache64((addr64_t)g_xfer_pa, WLAN_XFER_SIZE, TRUE);
+	H.xfer_nc = ml_io_map_unmappable((vm_offset_t)g_xfer_pa, WLAN_XFER_SIZE, WLAN_WIMG_WCOMB);
+	H.xfer_pa = negroni_wlan_dma_map(g_xfer_pa, WLAN_XFER_SIZE);    /* 0320: the TREs carry the chip's view */
+	if (H.xfer_pa == WLAN_DMA_NONE) {
+		return negroni_wlan_failed(ENOMEM, "no device address for the transfer buffers");
+	}
+	if (!H.xfer_nc) {
+		return negroni_wlan_failed(ENOMEM, "the non-cacheable transfer buffer map failed");
+	}
+	error = negroni_wlan_mhi_start_ipcr(&H);
+	if (error) {
+		return error;
+	}
+	printf("NEGRONI WLAN: stage 1 complete: mission mode, IPCR 20/21 up, m3 %u bytes ready at %#llx\n",
+	    g_m3_size, g_pool_dva + OFF_M3);
+	return 0;
+}
+
+/* ---- level 5: steps 16-17 (0265: QRTR over IPCR, the chip's name service, the WLFW server) ---- */
+static int
+wlan_level_qrtr(void)
+{
+	int error;
+
+	negroni_wlan_step(16, "QRTR HELLO");
+	error = negroni_wlan_qrtr_hello(&H);
+	if (error) {
+		return error;
+	}
+	negroni_wlan_step(17, "WLFW service lookup");
+	return negroni_wlan_qrtr_find_wlfw(&H);
+}
+
+/* ---- level 6: steps 18-24 (0266: QMI WLFW, negroni_wlan_qmi.c) ---- */
+static int
+wlan_level_wlfw(void)
+{
+	return negroni_wlan_wlfw_run(&H, g_m3_size ? g_pool_dva + OFF_M3 : 0, g_m3_size);
+}
+
+/* ---- level 7: steps 25-26 (0320: QMI WLAN_CFG + WLAN_MODE mission, negroni_wlan_qmi.c) ---- */
+static int
+wlan_level_cfg(void)
+{
+	return negroni_wlan_wlfw_start(&H);
+}
+
+/* ---- level 8: steps 27-28 (0321: copy engines + HAL SRNG, the first HTC message) ---- */
+struct negroni_wlan_htc_ready negroni_wlan_ready;
+
+static int
+wlan_level_ce(void)
+{
+	int error;
+
+	negroni_wlan_step(27, "CE rings");
+	error = negroni_wlan_ce_start();
+	if (error) {
+		return error;
+	}
+	error = negroni_wlan_dp_common_setup();        /* 0328: DP rings + link descriptors (ath11k_dp_alloc) */
+	if (error) {
+		return error;
+	}
+	negroni_wlan_step(28, "HTC READY");
+	error = negroni_wlan_ce_wait_ready(&negroni_wlan_ready);
+	if (error) {
+		return negroni_wlan_failed(error, "the first CE message is not a valid HTC READY");
+	}
+	printf("NEGRONI WLAN: HTC READY on CE%u: %u credits of %u bytes, %u endpoints%s (version %u, bundle %u)\n",
+	    negroni_wlan_ready.pipe, negroni_wlan_ready.credits, negroni_wlan_ready.credit_size,
+	    negroni_wlan_ready.max_endpoints, negroni_wlan_ready.extended ? ", extended" : "",
+	    negroni_wlan_ready.version, negroni_wlan_ready.max_bundle);
+	return 0;
+}
+
+static int (*const wlan_levels[WLAN_LEVEL_MAX + 1])(void) = {
+	[WLAN_LEVEL_SBL] = wlan_level_sbl,
+	[WLAN_LEVEL_MHI] = wlan_level_mhi,
+	[WLAN_LEVEL_AMSS] = wlan_level_amss,
+	[WLAN_LEVEL_QRTR] = wlan_level_qrtr,
+	[WLAN_LEVEL_WLFW] = wlan_level_wlfw,
+	[WLAN_LEVEL_CFG] = wlan_level_cfg,
+	[WLAN_LEVEL_CE] = wlan_level_ce,
+	[WLAN_LEVEL_WMI] = negroni_wlan_wmi_level,      /* 0322: steps 29-32, negroni_wlan_wmi.c */
+	[WLAN_LEVEL_SCAN] = negroni_wlan_scan_level,    /* 0323: steps 33-35 */
+};
+
+/*
+ * Run the levels 2..negroniwlan. A failure stops the chip's DMA (MHI reset + bus master off) and
+ * frees the memory. When the asked level is reached the chip keeps running and every buffer it
+ * was given stays allocated (it may still DMA into them).
+ */
+static int
+wlan_run(void)
+{
+	uint32_t lvl;
+	int error = 0;
+
+	for (lvl = WLAN_LEVEL_SBL; lvl <= g_level && lvl <= WLAN_LEVEL_MAX; lvl++) {
+		error = wlan_levels[lvl]();
+		if (error) {
+			break;
+		}
+		printf("NEGRONI WLAN: level %u done (step %u)\n", lvl, g_step);
+		negroni_wlan_smmu_report();     /* 0325: one SMMU line per level (also "no fault") */
+	}
+	if (!error) {
+		snprintf(negroni_wifi_badge, sizeof(negroni_wifi_badge), "WLAN OK %u", MIN(g_level, (uint32_t)WLAN_LEVEL_MAX));
+		negroni_wifi_badge_color = 0x000060c0;
+		if (g_level < WLAN_LEVEL_AMSS) {
+			return 0;       /* no channel runs yet: nothing to drain */
+		}
+		if (g_level >= WLAN_LEVEL_SCAN) {
+			negroni_wlan_sta_lifecycle(NWLAN_STATE_IDLE, 0);       /* 0326: the API is usable */
+		}
+		error = wlan_keep_alive();
+		if (!error) {
+			return 0;
+		}
+		g_why_set = true;       /* the keep-alive printed the reason */
+	}
+	if (!g_why_set) {
+		printf("NEGRONI WLAN: step %u %s failed: %s (error %d)\n", g_step, g_step_name, errno_text(error), error);
+	}
+	negroni_wlan_sta_lifecycle(NWLAN_STATE_FAILED, error);        /* 0326 */
+	snprintf(negroni_wifi_badge, sizeof(negroni_wifi_badge), "WLAN STOP %u", g_step);
+	negroni_wifi_badge_color = 0x00c00000;
+	negroni_wlan_smmu_report();     /* 0324: a context fault explains a time-out */
+	if (g_master || g_bar0) {
+		wlan_quiesce(&P);       /* before the pool goes back to the VM: no DMA after this */
+	}
+	negroni_wlan_qrtr_detach(&H);   /* 0265: no RX callback into the freed buffers */
+	wlan_cleanup();
+	negroni_wlan_smmu_off();        /* 0324: after the quiesce, the stream back as it was */
+	return error;
+}
+
+static void
+wlan_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int error = wlan_run();
+
+	printf("NEGRONI WLAN: %s at step %u (level %u asked, error %d, events seen %u)\n",
+	    error ? "stopped" : "done", g_step, g_level, error, H.events);
+	(void)thread_terminate(current_thread());
+}
+
+void
+negroni_wlan_start(void)
+{
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("negroniwlan", &g_level, sizeof(g_level));
+	(void)PE_parse_boot_argn("negroniwlan_to", &g_timeout_ms, sizeof(g_timeout_ms));
+	(void)PE_parse_boot_argn("negroniwlan_smmu", &g_smmu_policy, sizeof(g_smmu_policy));
+	(void)PE_parse_boot_argn("negroniwlan_keep", &g_keep_s, sizeof(g_keep_s));
+	(void)PE_parse_boot_argn("negroniwlan_swreset", &g_swreset, sizeof(g_swreset));     /* 0342 */
+	(void)PE_parse_boot_argn("negroniwlan_bootdbg", &g_bootdbg, sizeof(g_bootdbg));     /* 0343 */
+	(void)PE_parse_boot_argn("negroniwlan_msi", &g_msi_mode, sizeof(g_msi_mode));       /* 0344 */
+	g_msi_mode &= 3u;
+	g_swreset = MIN(g_swreset, 2u);
+	g_timeout_ms = MIN(MAX(g_timeout_ms, 100u), 60000u);
+	g_level = MAX(g_level, (uint32_t)WLAN_LEVEL_SBL);
+	if (g_level > WLAN_LEVEL_MAX) {
+		printf("NEGRONI WLAN: negroniwlan=%u asked; this build stops at level %u\n", g_level, WLAN_LEVEL_MAX);
+	}
+	printf("NEGRONI WLAN: start: levels %u..%u, time-out %u ms per wait, SMMU policy %u, SW reset %u, MSI %u\n",
+	    WLAN_LEVEL_SBL, MIN(g_level, (uint32_t)WLAN_LEVEL_MAX), g_timeout_ms, g_smmu_policy, g_swreset, g_msi_mode);
+	negroni_wlan_sta_lifecycle(NWLAN_STATE_STARTING, 0);  /* 0326 */
+	if (kernel_thread_start(wlan_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("NEGRONI WLAN: kernel_thread_start failed\n");
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_wlan.h b/bsd/dev/negroni_wlan.h
new file mode 100644
index 0000000..eb4be8a
--- /dev/null
+++ b/bsd/dev/negroni_wlan.h
@@ -0,0 +1,44 @@
+/*
+ * NEGRONI (SM8450) QCA6490 Wi-Fi driver: the shared seam between the PCIe
+ * survey (bsd/dev/negroni_wifi.c, slop 0106/0120/0122 + patch 0260) and the
+ * ath11k-style MHI/QMI/WMI driver (bsd/dev/negroni_wlan.c, patch 0261+).
+ *
+ * The survey powers the chip, trains PCIe0 and maps the config/DBI windows.
+ * The driver reuses those mapped handles instead of repeating the bring-up.
+ */
+#ifndef _NEGRONI_WLAN_H_
+#define _NEGRONI_WLAN_H_
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+
+/* Mapped PCIe0 register windows left by the survey (negroni_wifi.c). */
+struct negroni_wlan_pcie {
+	vm_offset_t gcc;        /* GCC base (0x00100000) */
+	vm_offset_t tlmm;       /* TLMM base (0x0f100000) */
+	vm_offset_t parf;       /* PCIe0 PARF (0x01c00000) */
+	vm_offset_t phy;        /* PCIe0 PHY (0x01c06000) */
+	vm_offset_t dbi;        /* root-port DBI (0x60000000) */
+	vm_offset_t cfg_bus1;   /* endpoint config space on bus 1 (0x60100000) */
+	uint64_t mem_base;      /* the iATU memory window to the endpoint (0x60300000) */
+	uint64_t mem_limit;     /* its last byte (0x63ffffff) */
+	uint32_t chip_id;       /* 17cb:1103 when the QCA6490 answered */
+	bool linked;            /* the PCIe link is up and the chip answered */
+};
+
+/* negroni_wifi.c: copies the survey's mapped handles. False if the survey did not link. */
+bool negroni_wifi_pcie_handles(struct negroni_wlan_pcie *out);
+
+/*
+ * bsd/dev/negroni_wlan.c: stage 1 (MHI host, firmware download, polling). The survey calls it
+ * after its step 10 when boot-arg negroniwlan >= 2. It starts a kernel thread and returns at once.
+ */
+void negroni_wlan_start(void);
+
+/* negroni_ufs.c: reads the WLAN firmware area (32 MiB right before the ADSP area). */
+int negroni_ufs_wlan_area_read(uint64_t at, void *dst, uint32_t count);
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
+#endif /* _NEGRONI_WLAN_H_ */
diff --git a/bsd/dev/negroni_wlan_api.h b/bsd/dev/negroni_wlan_api.h
new file mode 100644
index 0000000..cadeb6e
--- /dev/null
+++ b/bsd/dev/negroni_wlan_api.h
@@ -0,0 +1,142 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: the seam between the kernel driver (bsd/dev/negroni_wlan*.c, patches 0261-0329) and the
+ * iOS side (the Apple80211 / IO80211 interface and en0). Patch 0326 defines it; 0327-0329 fill it in.
+ *
+ * Plain C, no IOKit types: an IOKit (C++) client includes it inside extern "C" { }. Every function may be called
+ * from any thread, after negroni_wlan_api_ready() returns true. None of them blocks on the chip: a request goes
+ * into the driver thread's mailbox and the result comes back as an event (callback) and in negroni_wlan_link().
+ *
+ * Threads: the driver owns the chip on its own kernel thread (the keep-alive poller, 20 ms). Callbacks run on that
+ * thread. A callback must not block, sleep or call back into this API except negroni_wlan_tx() and the getters;
+ * copy what you need and return. RX frames are only valid during the callback.
+ *
+ * Frames: 802.3 / Ethernet II, as en0 sees them: dst[6] src[6] ethertype[2] payload. The driver converts to and
+ * from 802.11 (data path, 0328). EAPOL (0x888e) never reaches the RX callback while the kernel's own WPA2 handshake
+ * runs (0329); it does after the link is up only if the AP starts a new group-key handshake (the driver answers it,
+ * the frame is not passed on).
+ *
+ * Status of each function: see the NWLAN_CAP_* bits returned by negroni_wlan_api_caps(). A function whose bit is not
+ * set returns ENOTSUP. The caller checks NWLAN_API_VERSION against negroni_wlan_api_version().
+ */
+#ifndef _NEGRONI_WLAN_API_H_
+#define _NEGRONI_WLAN_API_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#define NWLAN_API_VERSION       1u
+
+#define NWLAN_SSID_MAX          32u
+#define NWLAN_IE_MAX            320u    /* RSN, WPA, HT/VHT capability elements of a BSS, as received */
+#define NWLAN_BSS_MAX           64u     /* the driver keeps the newest 64 BSS of the last scans */
+#define NWLAN_PSK_MIN           8u      /* passphrase 8..63 printable ASCII, or 64 hex digits (a raw PMK) */
+#define NWLAN_PSK_MAX           64u
+
+/* capability bits: which parts of this API the running kernel implements */
+#define NWLAN_CAP_SCAN          (1u << 0)       /* 0326: scan list + passive scan request */
+#define NWLAN_CAP_JOIN_OPEN     (1u << 1)       /* 0327: associate to an open network */
+#define NWLAN_CAP_DATA          (1u << 2)       /* 0328: negroni_wlan_tx and the RX callback carry frames */
+#define NWLAN_CAP_WPA2_PSK      (1u << 3)       /* 0329: associate with a passphrase (WPA2-PSK, CCMP) */
+
+/* security of a BSS (bits) */
+#define NWLAN_SEC_OPEN          0u
+#define NWLAN_SEC_WEP           (1u << 0)       /* privacy bit without RSN/WPA: not supported for joining */
+#define NWLAN_SEC_WPA           (1u << 1)       /* WPA1 element: not supported for joining */
+#define NWLAN_SEC_WPA2_PSK      (1u << 2)       /* RSN with AKM 00-0f-ac:2 and CCMP */
+#define NWLAN_SEC_WPA2_OTHER    (1u << 3)       /* RSN with another AKM (802.1X, SAE, ...): not supported */
+
+/* link state (struct nwlan_link.state) */
+enum nwlan_state {
+	NWLAN_STATE_OFF = 0,            /* driver not started, or stopped after a chip error */
+	NWLAN_STATE_STARTING,           /* firmware download .. WMI READY */
+	NWLAN_STATE_IDLE,               /* firmware up, no association */
+	NWLAN_STATE_SCANNING,
+	NWLAN_STATE_JOINING,            /* channel, authentication, association */
+	NWLAN_STATE_HANDSHAKE,          /* associated, WPA2 4-way handshake running */
+	NWLAN_STATE_CONNECTED,          /* data frames flow (open: after association; WPA2: after the keys) */
+	NWLAN_STATE_FAILED,             /* the chip stopped; see last_error */
+};
+
+/* events (struct nwlan_callbacks.event) */
+enum nwlan_event {
+	NWLAN_EV_STATE = 1,             /* the state changed: read negroni_wlan_link() */
+	NWLAN_EV_SCAN_DONE,             /* a scan ended: read negroni_wlan_scan_results() */
+	NWLAN_EV_LINK_UP,               /* CONNECTED reached (en0: link up, start DHCP) */
+	NWLAN_EV_LINK_DOWN,             /* the association ended (deauth, beacon loss, failure, request) */
+	NWLAN_EV_RSSI,                  /* a new RSSI value (at most once per second) */
+};
+
+struct nwlan_bss {
+	uint8_t bssid[6];
+	uint8_t ssid_len;               /* 0 = hidden */
+	uint8_t ssid[NWLAN_SSID_MAX];   /* raw bytes, not NUL terminated */
+	int8_t rssi;                    /* dBm */
+	uint8_t channel;
+	uint16_t freq;                  /* MHz */
+	uint16_t beacon_int;            /* TU */
+	uint16_t capab;                 /* 802.11 capability information */
+	uint32_t security;              /* NWLAN_SEC_* */
+	uint64_t seen_ms;               /* uptime of the last beacon / probe response */
+	uint16_t ie_len;
+	uint8_t ie[NWLAN_IE_MAX];       /* selected elements as received (id, len, data)...: RSN 48, WPA 221, HT 45, VHT 191 */
+};
+
+struct nwlan_link {
+	uint32_t state;                 /* enum nwlan_state */
+	uint8_t mac[6];                 /* the chip's MAC (WMI READY); en0's address */
+	uint8_t bssid[6];               /* valid in JOINING .. CONNECTED */
+	uint8_t ssid_len;
+	uint8_t ssid[NWLAN_SSID_MAX];
+	int8_t rssi;                    /* dBm, last value */
+	uint16_t freq;
+	uint16_t aid;
+	uint32_t security;              /* NWLAN_SEC_* of the joined BSS */
+	int32_t last_error;             /* errno of the last failure (0 = none) */
+	uint16_t reason;                /* 802.11 status (auth/assoc) or reason (deauth/disassoc) code of the last failure */
+	uint64_t tx_frames, rx_frames, tx_dropped, rx_dropped;
+};
+
+struct nwlan_callbacks {
+	void *ctx;
+	/* one 802.3 frame received (valid only during the call) */
+	void (*rx)(void *ctx, const uint8_t *frame, uint32_t len);
+	/* enum nwlan_event */
+	void (*event)(void *ctx, uint32_t event);
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+uint32_t negroni_wlan_api_version(void);        /* NWLAN_API_VERSION of the kernel */
+uint32_t negroni_wlan_api_caps(void);           /* NWLAN_CAP_* */
+bool negroni_wlan_api_ready(void);              /* the firmware is up (state >= IDLE) */
+
+/* one client (the en0 driver); NULL unregisters. Returns EBUSY if another client is registered. */
+int negroni_wlan_register(const struct nwlan_callbacks *cb);
+
+/* link state, counters, MAC (copy) */
+int negroni_wlan_link(struct nwlan_link *out);
+
+/* start a passive scan of all channels (about 6 s); NWLAN_EV_SCAN_DONE at the end. EBUSY while joining. */
+int negroni_wlan_scan(void);
+/* copy up to `max` BSS of the list (newest first); returns how many were copied */
+uint32_t negroni_wlan_scan_results(struct nwlan_bss *out, uint32_t max);
+
+/*
+ * Join `ssid` (the strongest BSS with that SSID from the list; a scan runs first if none is known).
+ * psk == NULL / psk_len == 0: open network. Else WPA2-PSK: a passphrase (8..63 bytes) or 64 hex digits.
+ * Returns at once (0, EINVAL, ENOTSUP, EBUSY); the result is NWLAN_EV_LINK_UP or NWLAN_EV_LINK_DOWN with
+ * last_error / reason in negroni_wlan_link(). The passphrase is copied, never logged, and wiped after use.
+ */
+int negroni_wlan_associate(const uint8_t *ssid, uint32_t ssid_len, const char *psk, uint32_t psk_len);
+int negroni_wlan_disassociate(void);
+
+/* send one 802.3 frame (copied). ENOTCONN when not CONNECTED, ENOBUFS when the TX queue is full (64 frames). */
+int negroni_wlan_tx(const uint8_t *frame, uint32_t len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _NEGRONI_WLAN_API_H_ */
diff --git a/bsd/dev/negroni_wlan_bhi.c b/bsd/dev/negroni_wlan_bhi.c
new file mode 100644
index 0000000..2c5d30c
--- /dev/null
+++ b/bsd/dev/negroni_wlan_bhi.c
@@ -0,0 +1,117 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: MHI boot-interface (BHI / BHIe) firmware download (patch 0261).
+ *
+ * BHI loads the first 512 KiB of the firmware (the SBL) while the chip is in the PBL execution
+ * environment. BHIe then loads the whole firmware image as a vector table of 512 KiB segments
+ * (FBC download) once the chip runs the SBL, is READY and in M0 (Linux: after the SBL EE event). Both are register-only transfers over
+ * BAR0; the data comes from host DMA memory that negroni_wlan.c filled.
+ *
+ * Layout and procedure from Linux drivers/bus/mhi/host/boot.c (GPL-2.0, Copyright (c) 2018 The
+ * Linux Foundation) and the OnePlus kernel copy in out/src/op-kernel: mhi_fw_load_bhi (BHI) and
+ * mhi_fw_load_bhie (BHIe). We read the layout; we do not copy the code. UNTESTED ON HARDWARE.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include "negroni_wlan_mhi.h"
+
+/*
+ * Poll BHI_STATUS / BHIE_TXVECSTATUS: the status field is bits [31:30] (BHI_STATUS_SHIFT 30).
+ * `bhi_err` != 0: on an error also print the BHI ERRCODE / ERRDBG1..3 registers (boot.c).
+ */
+static int
+bhi_wait(struct mhi_host *h, uint32_t status_off, uint32_t bhi_err, const char *what)
+{
+	uint64_t start = negroni_wlan_ms(), deadline = start + h->timeout_ms, beat = start + 1000;
+	uint32_t reg;
+
+	do {
+		negroni_wlan_msi_poll(what);    /* 0344: Linux gets an MSI on vector 0 (BHI_INTVEC) at the end */
+		reg = negroni_wlan_rd(status_off);
+		uint32_t st = (reg >> 30) & 0x3;
+
+		if (reg == MHI_ALL_ONES) {
+			printf("NEGRONI WLAN: %s status reads 0xffffffff (PCIe link down?)\n", what);
+			return negroni_wlan_failed(EIO, "%s status reads 0xffffffff (PCIe link down)", what);
+		}
+		/* heartbeat (0263): if the phone restarts during the chip's DMA, the log shows how long it ran */
+		if (negroni_wlan_ms() >= beat) {
+			printf("NEGRONI WLAN: %s waiting %llu ms, status %#x, EE %u, MHISTATUS %#x\n", what,
+			    negroni_wlan_ms() - start, reg, negroni_wlan_rd(h->bhi + BHI_EXECENV),
+			    negroni_wlan_rd(MHI_STATUS));
+			(void)negroni_wlan_smmu_check(what);    /* 0325: a context fault explains a stuck transfer */
+			beat += 1000;
+		}
+		if (st == BHI_ST_DONE) {
+			/* 0339: how long the transfer took and what the chip shows right after it */
+			printf("NEGRONI WLAN: %s done after %llu ms, status %#x, EE %u, MHISTATUS %#x\n", what,
+			    negroni_wlan_ms() - start, reg, negroni_wlan_rd(h->bhi + BHI_EXECENV), negroni_wlan_rd(MHI_STATUS));
+			negroni_wlan_boot_dump(h, what);
+			return 0;
+		}
+		if (st == BHI_ST_ERROR) {
+			if (bhi_err) {
+				printf("NEGRONI WLAN: %s error, status %#x, errcode %#x dbg %#x %#x %#x\n", what, reg,
+				    negroni_wlan_rd(bhi_err + BHI_ERRCODE), negroni_wlan_rd(bhi_err + BHI_ERRDBG1),
+				    negroni_wlan_rd(bhi_err + BHI_ERRDBG1 + 4), negroni_wlan_rd(bhi_err + BHI_ERRDBG1 + 8));
+			} else {
+				printf("NEGRONI WLAN: %s error, status %#x\n", what, reg);
+			}
+			return negroni_wlan_failed(EIO, "%s: the chip reports an error, status %#x, errcode %#x", what, reg,
+			           negroni_wlan_rd(h->bhi + BHI_ERRCODE));
+		}
+		delay(1000);
+	} while (negroni_wlan_ms() < deadline);
+	printf("NEGRONI WLAN: %s timed out after %u ms, status %#x\n", what, h->timeout_ms, reg);
+	return negroni_wlan_failed(ETIMEDOUT, "%s not done in %u ms, status %#x, EE %u, errcode %#x", what,
+	           h->timeout_ms, reg, negroni_wlan_rd(h->bhi + BHI_EXECENV), negroni_wlan_rd(h->bhi + BHI_ERRCODE));
+}
+
+/*
+ * BHI: download `size` bytes at physical `pa` (the SBL, the first 512 KiB of the image).
+ * The chip must be in PBL. A random non-zero session id in the doorbell starts the transfer.
+ */
+int
+negroni_wlan_bhi_sbl(struct mhi_host *h, uint64_t pa, uint32_t size)
+{
+	uint32_t seq = negroni_wlan_seq();
+
+	negroni_wlan_wr(h->bhi + BHI_INTVEC, 0);        /* BHI MSI vector 0 (pm.c power-up); MSI only with negroniwlan_msi=1 (0344) */
+	negroni_wlan_wr(h->bhi + BHI_STATUS, 0);
+	negroni_wlan_wr(h->bhi + BHI_IMGADDR_HIGH, (uint32_t)(pa >> 32));
+	negroni_wlan_wr(h->bhi + BHI_IMGADDR_LOW, (uint32_t)pa);
+	negroni_wlan_wr(h->bhi + BHI_IMGSIZE, size);
+	/* 0339: the BHI registers must hold what we wrote before the doorbell */
+	printf("NEGRONI WLAN: BHI before the doorbell: IMGADDR %#x:%08x (wrote %#x:%08x) IMGSIZE %#x STATUS %#x INTVEC %#x\n",
+	    negroni_wlan_rd(h->bhi + BHI_IMGADDR_HIGH), negroni_wlan_rd(h->bhi + BHI_IMGADDR_LOW), (uint32_t)(pa >> 32),
+	    (uint32_t)pa, negroni_wlan_rd(h->bhi + BHI_IMGSIZE), negroni_wlan_rd(h->bhi + BHI_STATUS),
+	    negroni_wlan_rd(h->bhi + BHI_INTVEC));
+	negroni_wlan_wr(h->bhi + BHI_IMGTXDB, seq);
+	printf("NEGRONI WLAN: BHI SBL %u bytes at %#llx, session %u\n", size, pa, seq);
+	return bhi_wait(h, h->bhi + BHI_STATUS, h->bhi, "BHI SBL");
+}
+
+/*
+ * BHIe: download the full image. `vec_pa` points at a vector table of `entries` records, each a
+ * { uint64 segment_pa; uint64 segment_size }. The table byte length goes in TXVECSIZE; a random
+ * non-zero sequence in TXVECDB starts the transfer.
+ */
+int
+negroni_wlan_bhie_image(struct mhi_host *h, uint64_t vec_pa, uint32_t entries)
+{
+	uint32_t seq = negroni_wlan_seq();
+	uint32_t bytes = entries * 16;          /* sizeof(bhi_vec_entry) = 16 */
+
+	negroni_wlan_wr(h->bhie + BHIE_TXVECADDR_HIGH, (uint32_t)(vec_pa >> 32));
+	negroni_wlan_wr(h->bhie + BHIE_TXVECADDR_LOW, (uint32_t)vec_pa);
+	negroni_wlan_wr(h->bhie + BHIE_TXVECSIZE, bytes);
+	negroni_wlan_wr(h->bhie + BHIE_TXVECDB, seq);
+	printf("NEGRONI WLAN: BHIe image %u segments (%u byte vector) at %#llx, seq %u\n",
+	    entries, bytes, vec_pa, seq);
+	return bhi_wait(h, h->bhie + BHIE_TXVECSTATUS, 0, "BHIe image");
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_wlan_ce.c b/bsd/dev/negroni_wlan_ce.c
new file mode 100644
index 0000000..22b7952
--- /dev/null
+++ b/bsd/dev/negroni_wlan_ce.c
@@ -0,0 +1,577 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi, level 8 (patch 0321): the copy engines (CE) the host uses for HTC/WMI, on HAL
+ * SRNG rings in host memory, driven by polling (no MSI: this XNU has no GICv3 ITS).
+ *
+ *   step 27  CE rings      one contiguous DMA area: read-pointer area, CE0/CE3 source rings (host -> target),
+ *                          CE1/CE2 destination + status rings (target -> host), 2048-byte buffers; the ring
+ *                          registers (R0 config, R2 head/tail) through the BAR0 register window; the RX
+ *                          buffers posted; every host head/tail update through its shadow register
+ *   step 28  HTC READY     the first message on a CE: HTC endpoint 0, HTC_MSG_READY (credits, credit size)
+ *
+ * Sequence and register meaning: Linux ath11k (BSD-3-Clause-Clear) ce.c ath11k_ce_init_pipes /
+ * ath11k_ce_rx_post_pipe / ath11k_ce_send / ath11k_ce_completed_recv_next, hal.c ath11k_hal_srng_setup /
+ * _src_hw_init / _dst_hw_init / ath11k_hal_ce_dst_setup / _access_end, hal_desc.h CE descriptors,
+ * pci.c ath11k_pci_window_write32; values in negroni_wlan_ce.h. Our own code, written from those
+ * descriptions; not copied. Design reference: external/ios-spes 0099 (WCN6750 CE, polled; no license file,
+ * read only). UNTESTED ON HARDWARE.
+ *
+ * Polling without MSI: the HAL writes a source ring's tail pointer and a destination ring's head pointer
+ * into the read-pointer area in host memory (TP_ADDR / HP_ADDR registers) whether or not MSI is set up
+ * (hal.c:331-341, :437-445); the ring interrupt thresholds stay 0 and no MSI address is given. ath11k
+ * itself needs MSI (pcic.c, one vector at least); this is the "legacy" path ath11k does not have, so the
+ * polled read of the read-pointer area replaces the CE interrupt (ce.c ath11k_ce_per_engine_service).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include <arm/caches_internal.h>
+#include "negroni_wlan.h"
+#include "negroni_wlan_mhi.h"
+#include "negroni_wlan_ce.h"
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+#define WLAN_WIMG_WCOMB         0x6u            /* Normal non-cacheable (negroni_wlan.c) */
+
+/* ---- DMA area layout (all ring bases 8-byte aligned, ce.h CE_DESC_RING_ALIGN) ---- */
+#define CE_BUF                  2048u           /* src_sz_max of CE0-3 (ce.c:118-160) */
+#define CE0_N                   16u             /* host CE0 src_nentries (ce.c:121) */
+#define CE3_N                   32u             /* host CE3 src_nentries (ce.c:144) */
+#define CE4_N                   32u             /* 0328: host CE4 (HTT host->target, 256-byte messages); ath11k 2048 */
+#define CE1_N                   32u             /* host CE1 dst: ath11k posts 512, 32 is enough for HTC */
+#define CE2_N                   64u             /* host CE2 dst (WMI events) */
+#define CE_SRC_DESC             16u             /* hal_ce_srng_src_desc: 4 dwords */
+#define CE_DST_DESC             8u              /* hal_ce_srng_dest_desc: 2 dwords */
+#define CE_STS_DESC             16u             /* hal_ce_srng_dst_status_desc: 4 dwords */
+
+#define OFF_RDP                 0x0000u         /* u32 per ring id (HAL_RING_ID_MAX = 128) */
+#define OFF_CE0_SRC             0x1000u
+#define OFF_CE3_SRC             (OFF_CE0_SRC + CE0_N * CE_SRC_DESC)
+#define OFF_CE1_DST             (OFF_CE3_SRC + CE3_N * CE_SRC_DESC)
+#define OFF_CE1_STS             (OFF_CE1_DST + CE1_N * CE_DST_DESC)
+#define OFF_CE2_DST             (OFF_CE1_STS + CE1_N * CE_STS_DESC)
+#define OFF_CE2_STS             (OFF_CE2_DST + CE2_N * CE_DST_DESC)
+#define OFF_CE4_SRC             (OFF_CE2_STS + CE2_N * CE_STS_DESC)        /* 0328 */
+#define OFF_BUF                 0x4000u
+#define OFF_CE0_BUF             OFF_BUF
+#define OFF_CE3_BUF             (OFF_CE0_BUF + CE0_N * CE_BUF)
+#define OFF_CE1_BUF             (OFF_CE3_BUF + CE3_N * CE_BUF)
+#define OFF_CE2_BUF             (OFF_CE1_BUF + CE1_N * CE_BUF)
+#define OFF_CE4_BUF             (OFF_CE2_BUF + CE2_N * CE_BUF)          /* 0328 */
+#define CE_AREA                 (OFF_CE4_BUF + CE4_N * CE_BUF)          /* 0x5c000 = 368 KiB */
+_Static_assert(HAL_RING_ID_MAX * 4 <= OFF_CE0_SRC, "read-pointer area overlaps the rings");
+_Static_assert(OFF_CE4_SRC + CE4_N * CE_SRC_DESC <= OFF_BUF, "rings overlap the buffers");
+_Static_assert((CE_AREA & 0x3fffu) == 0, "the CE area is a multiple of 16 KiB pages");
+
+/* ---- SRNG register offsets inside a ring's R0 group (wcn6855_regs, relative to ring base LSB) ---- */
+#define SRC_BASE_MSB            0x04u   /* tcl1 base_msb - base_lsb */
+#define SRC_ID                  0x08u
+#define SRC_MISC                0x10u
+#define SRC_TP_ADDR_LSB         0x1cu
+#define SRC_TP_ADDR_MSB         0x20u
+#define SRC_CONSR_INT_IX0       0x30u
+#define SRC_CONSR_INT_IX1       0x34u
+#define DST_BASE_MSB            0x04u   /* reo1 base_msb - base_lsb */
+#define DST_ID                  0x08u
+#define DST_MISC                0x10u
+#define DST_HP_ADDR_LSB         0x14u
+#define DST_HP_ADDR_MSB         0x18u
+#define DST_PRODUCER_INT        0x24u
+#define MISC_MSI_LOOPCNT_OFF    (1u << 1)       /* HAL_TCL1_RING_MISC_MSI_LOOPCNT_DISABLE */
+#define MISC_SRNG_ENABLE        (1u << 6)
+#define BASE_MSB_SIZE_SHIFT     8u              /* RING_SIZE (27:8), in dwords; ADDR_MSB (7:0) */
+
+/* one SRNG ring as the host sees it; hp/tp in dwords like the hardware */
+struct ce_ring {
+	const char *name;
+	uint32_t ring_id;
+	uint32_t n, esz;                /* entries, entry size in dwords */
+	uint32_t r0, r2;                /* register group bases (BAR0 / window offsets) */
+	uint32_t shadow;                /* BAR0 offset of the shadow register for our pointer */
+	bool src;                       /* the host produces (CE_SRC, CE_DST) or consumes (CE_DST_STATUS) */
+	uint32_t off;                   /* area offset of the ring */
+	uint32_t hp, tp;                /* host producer head / host consumer tail, dwords */
+};
+
+struct ce_pipe {
+	uint32_t num;
+	struct ce_ring src;             /* tx pipes */
+	struct ce_ring dst, sts;        /* rx pipes */
+	uint32_t buf_off, nbuf;
+	uint32_t sw;                    /* rx: next slot to complete; tx: next slot to reap */
+	uint32_t pending;               /* tx: sent, not completed */
+};
+
+static vm_offset_t g_area_kva, g_area_nc;
+static uint64_t g_area_pa, g_area_dva;
+static uint32_t g_window = ~0u;
+static struct ce_pipe g_ce[5];      /* 0328: + CE4 (HTT out) */
+static bool g_ce_on;
+static uint8_t g_rx_copy[CE_BUF];
+
+struct negroni_wlan_ce_stats negroni_wlan_ce_stats;
+void (*negroni_wlan_ce_rx_cb)(uint32_t pipe, const uint8_t *data, uint32_t len);
+
+/* step 28 default receiver (0322 installs the HTC one): keep the first endpoint-0 message */
+static uint8_t g_first[256];
+static uint32_t g_first_len, g_first_pipe;
+
+/* ---- register access: below 0x80000 direct, above through the window (pci.c:75-128) ---- */
+static void
+ce_select(uint32_t off)
+{
+	uint32_t w = (off >> WLAN_WINDOW_SHIFT) & WLAN_WINDOW_VALUE;
+
+	if (w != g_window) {
+		negroni_wlan_wr(WLAN_WINDOW_REG, WLAN_WINDOW_ENABLE | w);
+		(void)negroni_wlan_rd(WLAN_WINDOW_REG);         /* the select lands before the access */
+		g_window = w;
+	}
+}
+
+static void
+ce_wr(uint32_t off, uint32_t v)
+{
+	if (off < WLAN_WINDOW_START) {
+		negroni_wlan_wr(off, v);
+		return;
+	}
+	ce_select(off);
+	negroni_wlan_wr(WLAN_WINDOW_START + (off & WLAN_WINDOW_RANGE), v);
+}
+
+static uint32_t
+ce_rd(uint32_t off)
+{
+	if (off < WLAN_WINDOW_START) {
+		return negroni_wlan_rd(off);
+	}
+	ce_select(off);
+	return negroni_wlan_rd(WLAN_WINDOW_START + (off & WLAN_WINDOW_RANGE));
+}
+
+/* 0328: the same windowed access for the data path's UMAC registers (one window owner) */
+void
+negroni_wlan_reg_wr(uint32_t off, uint32_t v)
+{
+	ce_wr(off, v);
+}
+
+uint32_t
+negroni_wlan_reg_rd(uint32_t off)
+{
+	return ce_rd(off);
+}
+
+/*
+ * 0342: PCIE_SOC_GLOBAL_RESET clears the window register in the chip (ath11k pci.c ath11k_pci_soc_global_reset
+ * "Restore window register as its content is cleared during hardware global reset"). Forget the cached value, so
+ * the next windowed access writes the select again.
+ */
+void
+negroni_wlan_window_forget(void)
+{
+	g_window = ~0u;
+}
+
+static inline volatile uint32_t *
+area32(uint32_t off)
+{
+	return (volatile uint32_t *)(g_area_nc + off);
+}
+
+/* the hardware-written pointer of a ring (TP of a source ring, HP of a destination ring), checked */
+static bool
+ce_hw_ptr(const struct ce_ring *r, uint32_t *v)
+{
+	uint32_t x = *area32(OFF_RDP + 4 * r->ring_id);
+	uint32_t size = r->n * r->esz;
+
+	__asm__ volatile ("dmb ld" ::: "memory");       /* pointer before the descriptors it covers */
+	if (x >= size || (x % r->esz)) {
+		negroni_wlan_ce_stats.bad_ptr++;
+		return false;
+	}
+	*v = x;
+	return true;
+}
+
+static void
+ce_ring_def(struct ce_ring *r, const char *name, uint32_t ring_id, uint32_t n, uint32_t desc, uint32_t r0,
+    uint32_t r2, uint32_t shadow_idx, bool src, uint32_t off)
+{
+	memset(r, 0, sizeof(*r));
+	r->name = name;
+	r->ring_id = ring_id;
+	r->n = n;
+	r->esz = desc / 4;
+	r->r0 = r0;
+	r->r2 = r2;
+	r->shadow = HAL_SHADOW_REG(shadow_idx);
+	r->src = src;
+	r->off = off;
+}
+
+/*
+ * HAL SRNG hardware init (hal.c ath11k_hal_srng_src_hw_init / _dst_hw_init), no MSI, no interrupt
+ * thresholds. The pointer area slot of the ring gets the hardware's pointer copies.
+ */
+static void
+ce_ring_hw_init(const struct ce_ring *r)
+{
+	uint64_t base = g_area_dva + r->off;
+	uint64_t ptr = g_area_dva + OFF_RDP + 4ull * r->ring_id;
+	uint32_t size = r->n * r->esz;
+
+	memset((void *)(g_area_nc + r->off), 0, (size_t)size * 4);
+	*area32(OFF_RDP + 4 * r->ring_id) = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ce_wr(r->r0, (uint32_t)base);
+	ce_wr(r->r0 + (r->src ? SRC_BASE_MSB : DST_BASE_MSB),
+	    (uint32_t)((base >> 32) & 0xff) | (size << BASE_MSB_SIZE_SHIFT));
+	if (r->src) {
+		ce_wr(r->r0 + SRC_ID, r->esz);                  /* entry size only (hal.c:384) */
+		ce_wr(r->r0 + SRC_CONSR_INT_IX0, 0);
+		ce_wr(r->r0 + SRC_CONSR_INT_IX1, 0);
+		ce_wr(r->r0 + SRC_TP_ADDR_LSB, (uint32_t)ptr);
+		ce_wr(r->r0 + SRC_TP_ADDR_MSB, (uint32_t)(ptr >> 32));
+	} else {
+		ce_wr(r->r0 + DST_ID, (r->ring_id << 8) | r->esz);
+		ce_wr(r->r0 + DST_PRODUCER_INT, 0);
+		ce_wr(r->r0 + DST_HP_ADDR_LSB, (uint32_t)ptr);
+		ce_wr(r->r0 + DST_HP_ADDR_MSB, (uint32_t)(ptr >> 32));
+	}
+	ce_wr(r->r2, 0);                                        /* HP */
+	ce_wr(r->r2 + HAL_HP_TO_TP, 0);                         /* TP */
+	ce_wr(r->r0 + (r->src ? SRC_MISC : DST_MISC), (r->src ? MISC_MSI_LOOPCNT_OFF : 0) | MISC_SRNG_ENABLE);
+}
+
+/* host pointer update through the shadow register (hal.c ath11k_hal_srng_access_end, shadow path) */
+static void
+ce_ring_commit(const struct ce_ring *r)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");               /* descriptors before the pointer */
+	ce_wr(r->shadow, r->src ? r->hp : r->tp);
+}
+
+static void
+ce_pipe_tx(struct ce_pipe *p, uint32_t num, uint32_t n, uint32_t ring_off, uint32_t buf_off, uint32_t shadow)
+{
+	memset(p, 0, sizeof(*p));
+	p->num = num;
+	ce_ring_def(&p->src, "src", HAL_RING_ID_CE_SRC(num), n, CE_SRC_DESC, HAL_CE0_SRC_R0 + num * HAL_CE_STRIDE,
+	    HAL_CE0_SRC_R0 + num * HAL_CE_STRIDE + HAL_CE_RING_HP, shadow, true, ring_off);
+	p->buf_off = buf_off;
+	p->nbuf = n;
+}
+
+static void
+ce_pipe_rx(struct ce_pipe *p, uint32_t num, uint32_t n, uint32_t dst_off, uint32_t sts_off, uint32_t buf_off,
+    uint32_t sh_dst, uint32_t sh_sts)
+{
+	uint32_t base = HAL_CE0_DST_R0 + num * HAL_CE_STRIDE;
+
+	memset(p, 0, sizeof(*p));
+	p->num = num;
+	/* CE_DST is a source ring for the HAL (the host produces buffer pointers, hal.c:94-101) */
+	ce_ring_def(&p->dst, "dst", HAL_RING_ID_CE_DST(num), n, CE_DST_DESC, base, base + HAL_CE_RING_HP, sh_dst,
+	    true, dst_off);
+	ce_ring_def(&p->sts, "status", HAL_RING_ID_CE_STS(num), n, CE_STS_DESC, base + HAL_CE_DST_STATUS_R0,
+	    base + HAL_CE_STATUS_RING_HP, sh_sts, false, sts_off);
+	p->buf_off = buf_off;
+	p->nbuf = n;
+}
+
+/* post the buffer of slot dst.hp (slot k always owns buffer k): hal_ce_dst_set_desc */
+static void
+ce_rx_post_one(struct ce_pipe *p)
+{
+	struct ce_ring *d = &p->dst;
+	uint32_t slot = d->hp / d->esz;
+	uint64_t a = g_area_dva + p->buf_off + (uint64_t)slot * CE_BUF;
+	volatile uint32_t *desc = area32(d->off + d->hp * 4);
+
+	desc[0] = (uint32_t)a;
+	desc[1] = (uint32_t)((a >> 32) & 0xff);         /* addr bits 39:32 (HAL_CE_DEST_DESC_ADDR_INFO_ADDR_HI) */
+	d->hp = (d->hp + d->esz) % (d->n * d->esz);
+}
+
+static void
+ce_rx_init(struct ce_pipe *p)
+{
+	ce_ring_hw_init(&p->dst);
+	ce_ring_hw_init(&p->sts);
+	/* ath11k_hal_ce_dst_setup: the largest buffer the CE may write into a destination slot */
+	uint32_t ctrl = ce_rd(p->dst.r0 + HAL_CE_DST_RING_CTRL);
+	ce_wr(p->dst.r0 + HAL_CE_DST_RING_CTRL, (ctrl & ~0xffffu) | CE_BUF);
+	for (uint32_t i = 0; i + 1 < p->nbuf; i++) {     /* a ring holds n - 1 entries */
+		ce_rx_post_one(p);
+	}
+	ce_ring_commit(&p->dst);
+}
+
+/* drain one rx pipe: every status entry the hardware wrote, then re-post (ce.c:363-447) */
+static void
+ce_rx_poll(struct ce_pipe *p)
+{
+	struct ce_ring *s = &p->sts;
+	uint32_t hw, size = s->n * s->esz, guard = s->n;
+	bool moved = false;
+
+	if (!ce_hw_ptr(s, &hw)) {
+		return;
+	}
+	while (s->tp != hw && guard--) {
+		volatile uint32_t *st = area32(s->off + s->tp * 4);
+		uint32_t len = st[0] >> 16;                     /* HAL_CE_DST_STATUS_DESC_FLAGS_LEN */
+		uint32_t slot = p->sw;
+
+		if (len == 0 || len > CE_BUF) {
+			negroni_wlan_ce_stats.bad_len++;
+		} else {
+			memcpy(g_rx_copy, (const void *)(g_area_nc + p->buf_off + slot * CE_BUF), len);
+			negroni_wlan_ce_stats.rx[p->num & 3]++;
+			if (negroni_wlan_ce_rx_cb) {
+				negroni_wlan_ce_rx_cb(p->num, g_rx_copy, len);
+			}
+		}
+		st[0] = 0;
+		p->sw = (p->sw + 1) % p->nbuf;
+		s->tp = (s->tp + s->esz) % size;
+		ce_rx_post_one(p);
+		moved = true;
+	}
+	if (moved) {
+		ce_ring_commit(s);              /* status TP: the slots may be reused */
+		ce_ring_commit(&p->dst);        /* new buffers */
+	}
+}
+
+/* reap completed tx descriptors (the hardware TP passed them) */
+static void
+ce_tx_reap(struct ce_pipe *p)
+{
+	struct ce_ring *r = &p->src;
+	uint32_t hw;
+
+	if (!ce_hw_ptr(r, &hw)) {
+		return;
+	}
+	while (r->tp != hw && p->pending) {
+		r->tp = (r->tp + r->esz) % (r->n * r->esz);
+		p->pending--;
+		negroni_wlan_ce_stats.tx_done++;
+	}
+}
+
+static struct ce_pipe *
+ce_pipe_get(uint32_t num)
+{
+	return (g_ce_on && num < 5) ? &g_ce[num] : NULL;
+}
+
+/* ath11k_ce_send: one buffer, one descriptor; ENOBUFS when the ring is full */
+int
+negroni_wlan_ce_send(uint32_t pipe, const void *data, uint32_t len, uint32_t transfer_id)
+{
+	struct ce_pipe *p = ce_pipe_get(pipe);
+	struct ce_ring *r;
+
+	if (!p || (pipe != 0 && pipe != 3 && pipe != 4) || len == 0 || len > (pipe == 4 ? 256u : CE_BUF)) {
+		return EINVAL;
+	}
+	r = &p->src;
+	ce_tx_reap(p);
+	uint32_t size = r->n * r->esz, next = (r->hp + r->esz) % size;
+	if (next == r->tp) {
+		negroni_wlan_ce_stats.tx_full++;
+		return ENOBUFS;
+	}
+	uint32_t slot = r->hp / r->esz;
+	uint64_t a = g_area_dva + p->buf_off + (uint64_t)slot * CE_BUF;
+	volatile uint32_t *desc = area32(r->off + r->hp * 4);
+
+	memcpy((void *)(g_area_nc + p->buf_off + slot * CE_BUF), data, len);
+	desc[0] = (uint32_t)a;
+	desc[1] = (uint32_t)((a >> 32) & 0xff) | (len << 16);  /* ADDR_HI, no swap, no gather, LEN 31:16 */
+	desc[2] = transfer_id & 0xffff;                         /* META_INFO: the HTC endpoint */
+	desc[3] = 0;
+	r->hp = next;
+	p->pending++;
+	ce_ring_commit(r);
+	negroni_wlan_ce_stats.tx[pipe]++;
+	return 0;
+}
+
+/* tx slots free on a pipe (after a reap) */
+uint32_t
+negroni_wlan_ce_tx_free(uint32_t pipe)
+{
+	struct ce_pipe *p = ce_pipe_get(pipe);
+
+	if (!p || (pipe != 0 && pipe != 3 && pipe != 4)) {
+		return 0;
+	}
+	ce_tx_reap(p);
+	return p->src.n - 1 - p->pending;
+}
+
+void
+negroni_wlan_ce_poll(void)
+{
+	if (!g_ce_on) {
+		return;
+	}
+	ce_rx_poll(&g_ce[1]);
+	ce_rx_poll(&g_ce[2]);
+	ce_tx_reap(&g_ce[0]);
+	ce_tx_reap(&g_ce[3]);
+	ce_tx_reap(&g_ce[4]);
+}
+
+/* free after the chip lost bus mastering (negroni_wlan.c failure path) */
+void
+negroni_wlan_ce_free(void)
+{
+	g_ce_on = false;
+	negroni_wlan_ce_rx_cb = NULL;
+	if (g_area_nc) {
+		ml_io_unmap(g_area_nc, CE_AREA);
+		g_area_nc = 0;
+	}
+	if (g_area_kva) {
+		flush_dcache64((addr64_t)g_area_pa, CE_AREA, TRUE);
+		kmem_free(kernel_map, g_area_kva, CE_AREA);
+		g_area_kva = 0;
+	}
+}
+
+static void
+ce_first_rx(uint32_t pipe, const uint8_t *data, uint32_t len)
+{
+	if (g_first_len == 0) {
+		g_first_len = MIN(len, (uint32_t)sizeof(g_first));
+		g_first_pipe = pipe;
+		memcpy(g_first, data, g_first_len);
+	}
+}
+
+/* step 27 */
+int
+negroni_wlan_ce_start(void)
+{
+	if (kmem_alloc_contig(kernel_map, &g_area_kva, CE_AREA, PAGE_MASK, (ppnum_t)(atop_64(MHI_DMA_MASK + 1) - 1), 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		g_area_kva = 0;
+		return negroni_wlan_failed(ENOMEM, "no %u contiguous bytes for the CE rings", CE_AREA);
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)g_area_kva);
+	g_area_pa = ptoa_64(pn);
+	if (!pn || g_area_pa + CE_AREA - 1 > MHI_DMA_MASK) {
+		return negroni_wlan_failed(ERANGE, "CE area page %#x outside the DMA mask", pn);
+	}
+	flush_dcache64((addr64_t)g_area_pa, CE_AREA, TRUE);
+	g_area_nc = ml_io_map_unmappable((vm_offset_t)g_area_pa, CE_AREA, WLAN_WIMG_WCOMB);
+	if (!g_area_nc) {
+		return negroni_wlan_failed(ENOMEM, "the non-cacheable CE area map failed");
+	}
+	g_area_dva = negroni_wlan_dma_map(g_area_pa, CE_AREA);
+	if (g_area_dva == WLAN_DMA_NONE) {
+		return negroni_wlan_failed(ENOMEM, "no device address for the CE area");
+	}
+	printf("NEGRONI WLAN: CE area %u bytes at %#llx (device %#llx)\n", CE_AREA, g_area_pa, g_area_dva);
+
+	uint32_t w0 = negroni_wlan_rd(WLAN_WINDOW_REG);
+	ce_pipe_tx(&g_ce[0], 0, CE0_N, OFF_CE0_SRC, OFF_CE0_BUF, WLAN_SHADOW_CE0_SRC);
+	ce_pipe_rx(&g_ce[1], 1, CE1_N, OFF_CE1_DST, OFF_CE1_STS, OFF_CE1_BUF, WLAN_SHADOW_CE1_DST, WLAN_SHADOW_CE1_STS);
+	ce_pipe_rx(&g_ce[2], 2, CE2_N, OFF_CE2_DST, OFF_CE2_STS, OFF_CE2_BUF, WLAN_SHADOW_CE2_DST, WLAN_SHADOW_CE2_STS);
+	ce_pipe_tx(&g_ce[3], 3, CE3_N, OFF_CE3_SRC, OFF_CE3_BUF, WLAN_SHADOW_CE3_SRC);
+	ce_pipe_tx(&g_ce[4], 4, CE4_N, OFF_CE4_SRC, OFF_CE4_BUF, WLAN_SHADOW_CE4_SRC);  /* 0328: HTT host->target */
+	ce_ring_hw_init(&g_ce[0].src);
+	ce_ring_hw_init(&g_ce[3].src);
+	ce_ring_hw_init(&g_ce[4].src);
+
+	/* proof that the window reaches the CE registers: the base we wrote reads back */
+	uint32_t want = (uint32_t)(g_area_dva + OFF_CE0_SRC), got = ce_rd(g_ce[0].src.r0);
+	printf("NEGRONI WLAN: window register %#x -> %#x; CE0 SRC base reads %#x (wrote %#x), MISC %#x\n", w0,
+	    negroni_wlan_rd(WLAN_WINDOW_REG), got, want, ce_rd(g_ce[0].src.r0 + SRC_MISC));
+	if (got != want) {
+		return negroni_wlan_failed(EIO, "CE0 SRC base reads %#x, wrote %#x: the register window does not reach "
+		           "the CE block", got, want);
+	}
+	negroni_wlan_ce_rx_cb = ce_first_rx;
+	ce_rx_init(&g_ce[1]);
+	ce_rx_init(&g_ce[2]);
+	g_ce_on = true;
+	negroni_wlan_add_poller(negroni_wlan_ce_poll);
+	printf("NEGRONI WLAN: CE0 src %u, CE1 dst %u (+status), CE2 dst %u (+status), CE3 src %u; %u + %u RX buffers "
+	    "of %u bytes posted\n", CE0_N, CE1_N, CE2_N, CE3_N, CE1_N - 1, CE2_N - 1, CE_BUF);
+	return 0;
+}
+
+/* ==== pure HTC READY parser (host-tested, patches/xnu/tests/wlan-wmi-test.c) ==== */
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+int
+negroni_wlan_htc_parse_ready(const uint8_t *b, uint32_t len, uint32_t pipe, struct negroni_wlan_htc_ready *out)
+{
+	memset(out, 0, sizeof(*out));
+	out->pipe = pipe;
+	if (!b || len < HTC_HDR_LEN + 8) {
+		return EBADMSG;
+	}
+	uint32_t info = le32(b), eid = info & 0xff, plen = info >> 16;
+	if (eid != 0 || plen < 8 || plen > len - HTC_HDR_LEN) {
+		return EBADMSG;
+	}
+	uint32_t w0 = le32(b + 8), w1 = le32(b + 12);
+	if ((w0 & 0xffff) != HTC_MSG_READY) {
+		return EBADMSG;
+	}
+	out->credits = w0 >> 16;
+	out->credit_size = w1 & 0xffff;
+	out->max_endpoints = (w1 >> 16) & 0xff;
+	if (plen >= 12) {
+		uint32_t w2 = le32(b + 16);
+		out->extended = true;
+		out->version = w2 & 0xff;
+		out->max_bundle = (w2 >> 8) & 0xff;
+	}
+	return (out->credits && out->credit_size) ? 0 : EBADMSG;
+}
+/* ==== end of the pure parser ==== */
+
+/* step 28: the first message is HTC_MSG_READY on endpoint 0 (htc.c ath11k_htc_wait_target) */
+int
+negroni_wlan_ce_wait_ready(struct negroni_wlan_htc_ready *out)
+{
+	uint64_t deadline = negroni_wlan_ms() + MAX(negroni_wlan_timeout(), 10000u);
+	int error;
+
+	while (g_first_len == 0) {
+		error = negroni_wlan_service();
+		if (error) {
+			return negroni_wlan_failed(error, "the chip stopped while waiting for HTC READY");
+		}
+		if (negroni_wlan_ms() >= deadline) {
+			return negroni_wlan_failed(ETIMEDOUT, "no CE message in %u ms (CE1 rx %u, CE2 rx %u, bad ptr %u, "
+			           "status HP CE1 %#x CE2 %#x)", MAX(negroni_wlan_timeout(), 10000u),
+			           negroni_wlan_ce_stats.rx[1], negroni_wlan_ce_stats.rx[2], negroni_wlan_ce_stats.bad_ptr,
+			           *area32(OFF_RDP + 4 * HAL_RING_ID_CE_STS(1)), *area32(OFF_RDP + 4 * HAL_RING_ID_CE_STS(2)));
+		}
+		negroni_wlan_nap(5);
+	}
+	return negroni_wlan_htc_parse_ready(g_first, g_first_len, g_first_pipe, out);
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_wlan_ce.h b/bsd/dev/negroni_wlan_ce.h
new file mode 100644
index 0000000..fa0f151
--- /dev/null
+++ b/bsd/dev/negroni_wlan_ce.h
@@ -0,0 +1,180 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: copy engine (CE) layout shared by the QMI WLAN_CFG message (patch 0320)
+ * and the CE/HAL SRNG code (patch 0321).
+ *
+ * Values only (no code) from Linux ath11k (BSD-3-Clause-Clear): hw.c
+ * ath11k_target_ce_config_wlan_qca6390 / ath11k_target_service_to_ce_map_wlan_qca6390 (used by the
+ * wcn6855 hw2.0/2.1 hw_params, core.c:412-577; PCI id 17cb:1103 = WCN6855, pci.c:32), hw.c
+ * wcn6855_regs, hal.h, hal.c ath11k_hal_srng_create_config / hw_srng_config_template, ce.c
+ * ath11k_ce_get_shadow_config (non-CE rings first, then the CE rings of the host CE table).
+ */
+#ifndef _NEGRONI_WLAN_CE_H_
+#define _NEGRONI_WLAN_CE_H_
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* ---- register window (pcic.h:17-21, pci.c:75-128): BAR0 offsets >= 0x80000 go through it ---- */
+#define WLAN_WINDOW_REG         0x310cu         /* window select register in BAR0 */
+#define WLAN_WINDOW_ENABLE      0x40000000u
+#define WLAN_WINDOW_START       0x80000u        /* the 512 KiB window in BAR0 */
+#define WLAN_WINDOW_RANGE       0x7ffffu        /* offset bits 18:0 */
+#define WLAN_WINDOW_SHIFT       19u             /* window value = offset bits 24:19 */
+#define WLAN_WINDOW_VALUE       0x3fu
+
+/* ---- pipe directions (ce.h:42-46) and service ids (htc.h:158-195, SVC(g, i) = g << 8 | i) ---- */
+#define WLAN_PIPEDIR_NONE       0u
+#define WLAN_PIPEDIR_IN         1u      /* target -> host */
+#define WLAN_PIPEDIR_OUT        2u      /* host -> target */
+#define WLAN_PIPEDIR_INOUT      3u
+#define WLAN_PIPEDIR_INOUT_H2H  4u
+#define WLAN_CE_ATTR_DIS_INTR   8u      /* ce.h:16 (CE_ATTR_FLAGS = 0 on little endian, ce.h:22) */
+
+#define HTC_SVC_RSVD_CTRL       0x0001u
+#define HTC_SVC_WMI_CONTROL     0x0100u
+#define HTC_SVC_WMI_DATA_BE     0x0101u
+#define HTC_SVC_WMI_DATA_BK     0x0102u
+#define HTC_SVC_WMI_DATA_VI     0x0103u
+#define HTC_SVC_WMI_DATA_VO     0x0104u
+#define HTC_SVC_HTT_DATA        0x0300u
+
+/* target CE configuration (WLAN_CFG tgt_cfg), hw.c:1623-1714 */
+struct wlan_ce_tgt {
+	uint32_t pipe, dir, nentries, nbytes_max, flags;
+};
+#define WLAN_CE_TGT_N           9u
+static const struct wlan_ce_tgt wlan_ce_tgt_cfg[WLAN_CE_TGT_N] = {
+	{ 0, WLAN_PIPEDIR_OUT, 32, 2048, 0 },                           /* host->target HTC control */
+	{ 1, WLAN_PIPEDIR_IN, 32, 2048, 0 },                            /* target->host HTT + HTC control */
+	{ 2, WLAN_PIPEDIR_IN, 32, 2048, 0 },                            /* target->host WMI */
+	{ 3, WLAN_PIPEDIR_OUT, 32, 2048, 0 },                           /* host->target WMI */
+	{ 4, WLAN_PIPEDIR_OUT, 256, 256, WLAN_CE_ATTR_DIS_INTR },       /* host->target HTT */
+	{ 5, WLAN_PIPEDIR_IN, 32, 2048, 0 },                            /* target->host pktlog */
+	{ 6, WLAN_PIPEDIR_INOUT, 32, 16384, 0 },                        /* target autonomous hif_memcpy */
+	{ 7, WLAN_PIPEDIR_INOUT_H2H, 0, 0, WLAN_CE_ATTR_DIS_INTR },     /* host only */
+	{ 8, WLAN_PIPEDIR_INOUT, 32, 16384, 0 },                        /* IPA */
+};
+
+/* service -> pipe map (WLAN_CFG svc_cfg), hw.c:1720-1800 (14 entries, no terminator) */
+struct wlan_ce_svc {
+	uint32_t service, dir, pipe;
+};
+#define WLAN_CE_SVC_N           14u
+static const struct wlan_ce_svc wlan_ce_svc_map[WLAN_CE_SVC_N] = {
+	{ HTC_SVC_WMI_DATA_VO, WLAN_PIPEDIR_OUT, 3 }, { HTC_SVC_WMI_DATA_VO, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_WMI_DATA_BK, WLAN_PIPEDIR_OUT, 3 }, { HTC_SVC_WMI_DATA_BK, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_WMI_DATA_BE, WLAN_PIPEDIR_OUT, 3 }, { HTC_SVC_WMI_DATA_BE, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_WMI_DATA_VI, WLAN_PIPEDIR_OUT, 3 }, { HTC_SVC_WMI_DATA_VI, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_WMI_CONTROL, WLAN_PIPEDIR_OUT, 3 }, { HTC_SVC_WMI_CONTROL, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_RSVD_CTRL, WLAN_PIPEDIR_OUT, 0 }, { HTC_SVC_RSVD_CTRL, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_HTT_DATA, WLAN_PIPEDIR_OUT, 4 }, { HTC_SVC_HTT_DATA, WLAN_PIPEDIR_IN, 1 },
+};
+
+/* ---- HAL SRNG register map of the CE rings (wcn6855_regs, hal.h:43-60, :198-204) ---- */
+#define HAL_CE0_SRC_R0          0x01b80000u     /* hal_seq_wcss_umac_ce0_src_reg */
+#define HAL_CE0_DST_R0          0x01b81000u     /* hal_seq_wcss_umac_ce0_dst_reg */
+#define HAL_CE_STRIDE           0x2000u         /* ce1_src_reg - ce0_src_reg */
+#define HAL_CE_DST_STATUS_R0    0x58u           /* HAL_CE_DST_STATUS_RING_BASE_LSB */
+#define HAL_CE_DST_RING_CTRL    0xb0u           /* MAX_LEN in bits 15:0 */
+#define HAL_CE_RING_HP          0x400u          /* HAL_CE_DST_RING_HP (R2 group) */
+#define HAL_CE_STATUS_RING_HP   0x408u          /* HAL_CE_DST_STATUS_RING_HP */
+#define HAL_HP_TO_TP            4u              /* HAL_OFFSET_FROM_HP_TO_TP */
+#define HAL_SHADOW_BASE         0x8fcu          /* wcn6855 hal_shadow_base_addr */
+#define HAL_SHADOW_REG(i)       (HAL_SHADOW_BASE + 4u * (i))
+#define HAL_SHADOW_MAX          36u             /* HAL_SHADOW_NUM_REGS = QMI v01 shadow_reg_v2 max */
+
+/* ring ids (hal.h:333-398): the slot of a ring's HW-written pointer in the read-pointer area */
+#define HAL_RING_ID_CE_SRC(n)   (32u + (n))
+#define HAL_RING_ID_CE_DST(n)   (56u + (n))
+#define HAL_RING_ID_CE_STS(n)   (80u + (n))
+#define HAL_RING_ID_MAX         128u
+
+/*
+ * Shadow register v2 list as ath11k builds it for wcn6855 (ce.c:840-862): first every non-CE,
+ * non-LMAC ring of hw_srng_config_template in type order (hal.c:13-192; for a source ring the HP
+ * register, for a destination ring HP + 4 = TP), then for each host CE with src entries its
+ * CE_SRC HP and with dst entries its CE_DST HP and CE_DST_STATUS TP (ce.c:821-838, host CE table
+ * ce.c:118-189: src on CE 0/3/4/7, dst on CE 1/2/5). Index i of this list is the host's shadow
+ * register HAL_SHADOW_REG(i); the firmware copies a write there to the target register.
+ */
+#define WLAN_SHADOW_N           30u
+static const uint32_t wlan_shadow_v2[WLAN_SHADOW_N] = {
+	/* REO_DST x4 (REO 0xa38000 + reo1_ring_hp 0x3030, stride 8, + TP) */
+	0x00a3b034u, 0x00a3b03cu, 0x00a3b044u, 0x00a3b04cu,
+	0x00a3b064u,    /* REO_EXCEPTION (reo_tcl_ring_hp 0x3060 + TP) */
+	0x00a3b028u,    /* REO_REINJECT (sw2reo_ring_hp 0x3028) */
+	0x00a3b020u,    /* REO_CMD (reo_cmd_ring_hp 0x3020) */
+	0x00a3b07cu,    /* REO_STATUS (reo_status_hp 0x3078 + TP) */
+	/* TCL_DATA x3 (TCL 0xa44000 + 0x2000, stride 8) */
+	0x00a46000u, 0x00a46008u, 0x00a46010u,
+	0x00a46018u,    /* TCL_CMD (0x2018) */
+	0x00a46034u,    /* TCL_STATUS (0x2030 + TP) */
+	0x00a370b0u,    /* WBM_IDLE_LINK (WBM 0xa34000 + 0x30b0) */
+	0x00a37018u,    /* SW2WBM_RELEASE (0x3018) */
+	/* WBM2SW_RELEASE x5 (0x30c0, stride 8, + TP) */
+	0x00a370c4u, 0x00a370ccu, 0x00a370d4u, 0x00a370dcu, 0x00a370e4u,
+	/* CE rings, host CE order */
+	0x01b80400u,    /* 20: CE0 SRC HP */
+	0x01b83400u,    /* 21: CE1 DST HP */
+	0x01b8340cu,    /* 22: CE1 DST_STATUS TP */
+	0x01b85400u,    /* 23: CE2 DST HP */
+	0x01b8540cu,    /* 24: CE2 DST_STATUS TP */
+	0x01b86400u,    /* 25: CE3 SRC HP */
+	0x01b88400u,    /* 26: CE4 SRC HP */
+	0x01b8b400u,    /* 27: CE5 DST HP */
+	0x01b8b40cu,    /* 28: CE5 DST_STATUS TP */
+	0x01b8e400u,    /* 29: CE7 SRC HP */
+};
+_Static_assert(WLAN_SHADOW_N <= HAL_SHADOW_MAX, "shadow list longer than the v01 maximum");
+/* shadow indexes of the CE rings this driver runs (0321) */
+#define WLAN_SHADOW_CE0_SRC     20u
+#define WLAN_SHADOW_CE1_DST     21u
+#define WLAN_SHADOW_CE1_STS     22u
+#define WLAN_SHADOW_CE2_DST     23u
+#define WLAN_SHADOW_CE2_STS     24u
+#define WLAN_SHADOW_CE3_SRC     25u
+#define WLAN_SHADOW_CE4_SRC     26u     /* 0328: HTT host->target */
+
+/* ---- 0321: the CE driver (negroni_wlan_ce.c) ---- */
+/* HTC header (htc.h:12-30): htc_info = eid 7:0 | flags 15:8 | payload length 31:16; ctrl_info = trailer
+ * length 7:0 (ControlBytes0) | sequence 15:8 */
+#define HTC_HDR_LEN             8u
+#define HTC_FLAG_NEED_CREDIT    0x01u
+#define HTC_FLAG_TRAILER        0x02u
+#define HTC_MSG_READY           1u
+#define HTC_MSG_CONNECT         2u
+#define HTC_MSG_CONNECT_RESP    3u
+#define HTC_MSG_SETUP_COMPLETE_EX 5u
+#define HTC_MAX_LEN             4096u   /* ATH11K_HTC_MAX_LEN */
+
+struct negroni_wlan_htc_ready {
+	uint32_t pipe;                  /* the CE it came on */
+	uint32_t credits, credit_size, max_endpoints;
+	uint32_t version, max_bundle;   /* the extended part, when present */
+	bool extended;
+};
+
+struct negroni_wlan_ce_stats {
+	uint32_t rx[5], tx[5], tx_done, tx_full, bad_len, bad_ptr;
+};
+extern struct negroni_wlan_ce_stats negroni_wlan_ce_stats;
+/* every received CE buffer (a private copy, valid during the call); 0322 installs the HTC receiver */
+extern void (*negroni_wlan_ce_rx_cb)(uint32_t pipe, const uint8_t *data, uint32_t len);
+
+extern struct negroni_wlan_htc_ready negroni_wlan_ready;  /* negroni_wlan.c, step 28 */
+int negroni_wlan_ce_start(void);                        /* step 27 */
+int negroni_wlan_ce_wait_ready(struct negroni_wlan_htc_ready *out);     /* step 28 */
+int negroni_wlan_ce_send(uint32_t pipe, const void *data, uint32_t len, uint32_t transfer_id);
+uint32_t negroni_wlan_ce_tx_free(uint32_t pipe);
+void negroni_wlan_ce_poll(void);
+void negroni_wlan_ce_free(void);
+/* 0328: BAR0 register access through the CE code's window (offsets >= 0x80000 windowed) */
+void negroni_wlan_reg_wr(uint32_t off, uint32_t v);
+uint32_t negroni_wlan_reg_rd(uint32_t off);
+void negroni_wlan_window_forget(void);             /* 0342: after PCIE_SOC_GLOBAL_RESET */
+/* pure parser of an HTC READY buffer (header included); 0 or EBADMSG (host-tested) */
+int negroni_wlan_htc_parse_ready(const uint8_t *b, uint32_t len, uint32_t pipe, struct negroni_wlan_htc_ready *out);
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
+#endif /* _NEGRONI_WLAN_CE_H_ */
diff --git a/bsd/dev/negroni_wlan_dp.c b/bsd/dev/negroni_wlan_dp.c
new file mode 100644
index 0000000..9b17e3a
--- /dev/null
+++ b/bsd/dev/negroni_wlan_dp.c
@@ -0,0 +1,1311 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi (patch 0328): the HTT data path (ath11k dp.c, dp_rx.c, dp_tx.c, hal.c, hal_rx.c, hal_tx.c for
+ * WCN6855 hw2.x: single pdev, 2 rxdma per pdev, rx_mac_buf_ring, shadow registers, htt peer map v1), polled.
+ *
+ *   common setup (after the CE rings, before HTC READY; ath11k_dp_alloc): WBM idle link ring + one link-descriptor
+ *     bank, SW2WBM release, TCL cmd/status, TCL data 0 + its WBM2SW0 completion ring, REO reinject, WBM2SW3 (rx
+ *     release), REO exception/cmd/status, REO hash routing + aging (ath11k_hw_wcn6855_reo_setup), DSCP->TID maps
+ *   REO setup (after SERVICE_READY, before WMI INIT; ath11k_dp_pdev_reo_setup): REO2SW1..4
+ *   pdev setup (after WMI READY + hw mode; ath11k_dp_tx_htt_h2t_ver_req_msg + ath11k_dp_rx_pdev_alloc): HTT version,
+ *     the LMAC rings (refill = host->fw rx buffers, 2 rx_mac_buf, 2 rxdma error dst, 2 monitor status), the rx
+ *     buffers, HTT SRING_SETUP for each, monitor status filter off (ath11k_mac_config_mon_status_default(false))
+ *   peer (join, 0327): HTT PEER_MAP wait, PEER_SET_DEFAULT_ROUTING, a REO queue per TID 0..16
+ *     (ath11k_dp_peer_setup / ath11k_peer_rx_tid_setup), vdev TX encap + RX decap = Ethernet
+ *   data: TX = one TCL data descriptor per 802.3 frame (Ethernet encap), completions on WBM2SW0; RX = REO2SW1..4
+ *     MSDUs (Ethernet decap; native-Wi-Fi decap converted), buffers re-posted; error rings recycle buffers and give
+ *     link descriptors back to WBM.
+ *
+ * Every ring address, buffer and link descriptor is a device address from negroni_wlan_dma_alloc (an IOVA with
+ * negroniwlan_smmu=3). Ring pointers: non-LMAC rings through the shadow registers of the 0320 list (host pointer),
+ * the hardware's pointer in the read-pointer area (rdp); LMAC rings through rdp/wrp memory (HTT gives the firmware
+ * the addresses). Boot-arg negroniwlan_dp=0 skips all of it (0323 behaviour). UNTESTED ON HARDWARE.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <pexpert/pexpert.h>
+#include <stdarg.h>
+#include "negroni_wlan.h"
+#include "negroni_wlan_mhi.h"
+#include "negroni_wlan_ce.h"
+#include "negroni_wlan_wmi.h"
+#include "negroni_wlan_sta.h"
+
+/* ---- UMAC register blocks (hal.h) and wcn6855_regs (hw.c) ---- */
+#define REO_REG                 0x00a38000u
+#define TCL_REG                 0x00a44000u
+#define WBM_REG                 0x00a34000u
+/* R0 relative offsets inside a ring's group (as negroni_wlan_ce.c) */
+#define R0_BASE_MSB             0x04u
+#define R0_ID                   0x08u
+#define R0_MISC                 0x10u
+#define R0_SRC_TP_ADDR_LSB      0x1cu
+#define R0_SRC_TP_ADDR_MSB      0x20u
+#define R0_SRC_INT_IX0          0x30u
+#define R0_SRC_INT_IX1          0x34u
+#define R0_DST_HP_ADDR_LSB      0x14u
+#define R0_DST_HP_ADDR_MSB      0x18u
+#define R0_DST_PRODUCER_INT     0x24u
+#define MISC_LOOPCNT_OFF        (1u << 1)
+#define MISC_SRNG_ENABLE        (1u << 6)
+/* REO / TCL control */
+#define REO1_GEN_ENABLE         0x000u
+#define REO1_DEST_RING_CTRL_IX_2 0x00cu
+#define REO1_DEST_RING_CTRL_IX_3 0x010u
+#define REO1_MISC_CTL           0x630u
+#define REO1_AGING_IX(n)        (0x5bcu + 4u * (n))
+#define REO_AGING_US            (40u * 1000u)
+#define TCL1_CMN_CTRL           0x014u
+#define TCL1_DSCP_TID_MAP       0x02cu
+#define TCL_DSCP_PROG_EN        (1u << 17)
+
+/* ---- ring ids (hal.h) ---- */
+#define RID_REO2SW(n)           (0u + (n))
+#define RID_REO2TCL             4u
+#define RID_SW2REO              5u
+#define RID_REO_CMD             8u
+#define RID_REO_STATUS          9u
+#define RID_SW2TCL(n)           (16u + (n))
+#define RID_SW2TCL_CMD          24u
+#define RID_TCL_STATUS          25u
+#define RID_WBM_IDLE_LINK       104u
+#define RID_WBM_SW_RELEASE      105u
+#define RID_WBM2SW(n)           (106u + (n))
+#define RID_LMAC1               128u
+#define RINGS_PER_LMAC          15u
+#define RID_SW2RXDMA0_BUF       (RID_LMAC1 + 0u)
+#define RID_SW2RXDMA1_BUF       (RID_LMAC1 + 1u)
+#define RID_SW2RXDMA1_STATBUF   (RID_LMAC1 + 4u)
+#define RID_RXDMA2SW0           (RID_LMAC1 + 5u)
+#define RID_MAX                 172u            /* 127 + 3 x 15 */
+#define LMAC_RINGS              45u
+
+/* ---- descriptors (hal_desc.h) ---- */
+#define RBM_IDLE_DESC_LIST      1u
+#define RBM_SW0                 3u              /* TCL 0 -> WBM2SW0 completions (tcl2wbm_rbm_map) */
+#define RBM_SW1                 4u              /* rx buffers (hal_params rx_buf_rbm) */
+#define HAL_TCL_DATA_CMD_TAG    324u
+#define HAL_REO_GET_QUEUE_STATS_TAG 306u
+#define LINK_DESC_SIZE          128u
+#define N_LINK_DESC             4096u           /* ath11k computes ~ 32k for 64 clients; one STA needs few */
+#define RX_BUF                  2048u           /* DP_RX_BUFFER_SIZE */
+#define RX_DESC_SZ              392u            /* sizeof(hal_rx_desc_wcn6855), host-checked */
+#define RXD_MSDU_END_INFO2      44u
+#define RXD_ATTN_INFO2          92u
+#define RXD_MSDU_START_INFO1    104u
+#define RXD_MSDU_START_INFO2    108u
+#define RXD_MSDU_DONE           (1u << 31)
+#define RXD_MPDU_START_INFO1    188u            /* mpdu_start.info1 (host-checked offsets) */
+#define RXD_MPDU_START_INFO2    172u
+#define RXD_MPDU_ENC_VALID      (1u << 9)       /* RX_MPDU_START_INFO1_ENCRYPT_INFO_VALID */
+#define HAL_ENC_OPEN            7u              /* HAL_ENCRYPT_TYPE_OPEN; RX_MPDU_START_INFO2_ENC_TYPE = bits 5:2 */
+#define DECAP_NATIVE_WIFI       1u
+#define DECAP_ETH2              2u
+#define TCL_ENCAP_ETHERNET      2u
+#define TCL_SEARCH_DEFAULT      0u
+#define TCL_ADDRY_EN            2u
+#define WBM_REL_SRC_SW          4u
+#define WBM_REL_DESC_MSDU_LINK  1u
+#define PUSH_ROUTING            1u
+#define HTT_SW_TO_HW            1u
+#define HTT_HW_TO_SW            0u
+#define HTT_SW_TO_SW            2u
+#define HTT_RXDMA_HOST_BUF_RING 0u
+#define HTT_RXDMA_MON_STATUS_RING 1u
+#define HTT_HOST1_TO_FW_RXBUF_RING 5u
+#define HTT_RXDMA_NON_MON_DEST_RING 7u
+#define HTT_H2T_VERSION_REQ     0u
+#define HTT_H2T_SRING_SETUP     0xbu
+#define HTT_H2T_RX_RING_SEL_CFG 0xcu
+#define HTT_T2H_VERSION_CONF    0u
+#define HTT_T2H_PEER_MAP        3u
+#define HTT_T2H_PEER_UNMAP      4u
+#define HTT_T2H_PEER_MAP2       0x1eu
+#define HTT_T2H_PEER_UNMAP2     0x1fu
+#define WMI_PEER_REORDER_QUEUE_SETUP_CMDID 0x6013u
+#define WMI_TAG_REORDER_QUEUE_SETUP_CMD 0x225u
+#define WMI_PEER_SET_DEFAULT_ROUTING 0x13u
+#define WMI_VDEV_SET_PARAM_CMDID 0x5008u
+#define WMI_TAG_VDEV_SET_PARAM_CMD 0x5fu
+#define VDEV_PARAM_TX_ENCAP_TYPE 0x30u
+#define VDEV_PARAM_RX_DECAP_TYPE 0x5bu
+#define HW_TXRX_ETHERNET        2u
+#define NUM_TIDS                17u             /* 0..15 + non-QoS 16 */
+#define QDESC_SIZE              512u            /* hal_rx_reo_queue (128) + 3 ext (128 each), 128-aligned */
+
+/* ---- sizes of our rings (entries) ---- */
+#define N_WBM_REL               64u
+#define N_TCL_CMD               32u
+#define N_TCL_STATUS            32u
+#define N_TCL_DATA              64u
+#define N_TX_COMP               256u
+#define N_REO_REINJECT          32u
+#define N_RX_REL                128u
+#define N_REO_EXCEPT            128u
+#define N_REO_CMD               64u
+#define N_REO_STATUS            64u
+#define N_REO_DST               256u
+#define N_REFILL                512u
+#define N_MAC_BUF               256u
+#define N_ERR_DST               64u
+#define N_MON_STATUS            64u
+#define N_RX_BUFS               (N_REFILL - 1 + 2 * (N_MON_STATUS - 1))
+#define N_TX_BUFS               64u
+#define TX_BUF                  2048u
+#define TXQ_N                   64u
+#define TXQ_FRAME               1600u
+#define EAPOLQ_N                4u
+
+struct dp_ring {
+	bool skip_cont;                         /* review: per ring: the rest of a multi-buffer MSDU is dropped */
+	const char *name;
+	uint32_t ring_id, esz, n, size;         /* esz, size: dwords */
+	bool src, lmac;
+	uint32_t r0, r2;
+	int shadow;                             /* non-LMAC: index into the 0320 shadow list */
+	uint32_t lmac_idx;
+	volatile uint32_t *base;
+	uint64_t dva;
+	uint32_t hp, tp;                        /* dwords */
+};
+
+static bool g_dp_enabled = true, g_dp_on, g_pdev_on;
+static struct nwlan_dma g_rings, g_link, g_rxb, g_txb, g_qd;
+static uint32_t g_rings_used;
+static volatile uint32_t *g_rdp, *g_wrp;
+static uint64_t g_rdp_dva, g_wrp_dva;
+static struct dp_ring R_wbm_idle, R_wbm_rel, R_tcl_cmd, R_tcl_status, R_tcl_data, R_tx_comp, R_reo_reinject, R_rx_rel,
+    R_reo_except, R_reo_cmd, R_reo_status, R_reo_dst[4], R_refill, R_mac_buf[2], R_err_dst[2], R_mon[2];
+static bool g_rx_posted[N_RX_BUFS];             /* true: the buffer belongs to the hardware */
+static uint16_t g_repost[N_RX_BUFS];            /* review D2: host-owned buffers waiting for room in the refill ring */
+static uint32_t g_repost_n, g_rx_unposted;
+static uint32_t g_lpend[2 * 32], g_lpend_n;     /* review: link descriptors waiting for room in SW2WBM */
+static bool g_tx_busy[N_TX_BUFS];
+static uint32_t g_tx_next;
+/* HTT state (set in the service pass) */
+static volatile bool g_htt_ver, g_peer_mapped, g_peer_lost;
+static bool g_secured;                          /* review D6: keys installed: only decrypted frames (and EAPOL) pass */
+static uint32_t g_htt_major, g_htt_minor, g_peer_id;
+static uint8_t g_peer_mac[6];
+/* link */
+static bool g_link_up;
+static uint8_t g_bssid[6];
+static uint32_t g_tcl_meta;
+/* counters */
+static uint64_t g_tx_frames, g_rx_frames, g_tx_drops, g_rx_drops;
+static uint32_t g_rx_err, g_rx_bad, g_tx_fail, g_rel_bufs, g_link_returned, g_htt_other;
+static bool g_in_poll;
+/* TX queue from the API (any thread) */
+static LCK_GRP_DECLARE(dp_grp, "negroni_wlan_dp");
+static LCK_MTX_DECLARE(dp_txq_mtx, &dp_grp);
+static uint8_t g_txq[TXQ_N][TXQ_FRAME];
+static uint16_t g_txq_len[TXQ_N];
+static uint32_t g_txq_head, g_txq_tail;
