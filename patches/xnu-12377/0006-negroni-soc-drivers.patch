+static void
+ud_if_detach(ifnet_t ifp __unused)
+{
+}
+
+/* 192.168.7.2/24 on ue0 (SIOCAIFADDR); 0381: also after a data path re-init when the address is gone. */
+static errno_t
+ud_if_addr_add(void)
+{
+	socket_t so = NULL;
+	errno_t err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	if (err == 0) {
+		struct ifaliasreq ifra;
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "ue0");
+		struct sockaddr_in *a = (struct sockaddr_in *)&ifra.ifra_addr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a80702);         /* 192.168.7.2 */
+		a = (struct sockaddr_in *)&ifra.ifra_mask;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xffffff00);
+		a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a807ff);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	return err;
+}
+
+/* 0381: 1 = ue0 has 192.168.7.2, 0 = it has not (configd or someone removed it), -1 = unknown */
+static int
+ud_if_has_addr(void)
+{
+	ifaddr_t *list = NULL;
+	int found = 0;
+
+	if (ud.ifp == NULL) {
+		return -1;
+	}
+	errno_t err = ifnet_get_address_list_family(ud.ifp, &list, AF_INET);
+	if (err == ENXIO) {
+		return 0;               /* no IPv4 address at all */
+	}
+	if (err != 0 || list == NULL) {
+		return -1;
+	}
+	for (int i = 0; list[i] != NULL; i++) {
+		struct sockaddr_in sin;
+		bzero(&sin, sizeof(sin));
+		if (ifaddr_address(list[i], (struct sockaddr *)&sin, sizeof(sin)) == 0 && sin.sin_family == AF_INET &&
+		    sin.sin_addr.s_addr == htonl(UD_IP_PHONE)) {
+			found = 1;
+		}
+	}
+	ifnet_free_address_list(list);
+	return found;
+}
+
+/* ue0, 192.168.7.2/24 (the host side is 192.168.7.1). */
+static void
+ud_if_create(void)
+{
+	struct ifnet_init_eparams init;
+	static lck_grp_t *grp;
+
+	grp = lck_grp_alloc_init("negroni_usb", LCK_GRP_ATTR_NULL);
+	ud.lock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "negroni-usb-ecm";
+	init.uniqueid_len = sizeof("negroni-usb-ecm") - 1;
+	init.name = "ue";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = ud_if_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = ud_if_ioctl;
+	init.detach = ud_if_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &ud.ifp) != 0) {
+		printf("NEGRONI USB: ifnet_allocate failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(ud.ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(ud.ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(ud.ifp, ETHERMTU);
+	ifnet_set_baudrate(ud.ifp, 480000000);
+	ifnet_set_flags(ud.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(ud.ifp, NULL) != 0) {
+		printf("NEGRONI USB: ifnet_attach failed\n");
+		ud.ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(ud.ifp, ud_phone_mac, ETHER_ADDR_LEN);
+
+	errno_t err = proto_plumb(PF_INET, ud.ifp);
+	if (err == 0) {
+		err = ud_if_addr_add();         /* 0381: the same code as before, now a function */
+	}
+	ifnet_set_flags(ud.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("NEGRONI USB: ue0 192.168.7.2/24 %s (err %d)\n", err ? "NOT configured" : "up", err);
+}
+
+/*
+ * ---- 0366: reconnect after unplug ----
+ *
+ * The driver forces VBUS valid in QSCRATCH (no charger driver tells it about
+ * the cable), so the controller never sees the cable go: no disconnect
+ * event. It only sees the bus go idle (USB 2.0 suspend, L2), and with the
+ * old DEVTEN 0x7 not even that. Before this patch a bus reset only cleared
+ * DALEPENA: the RX ring (0361, always active), a TX batch and a CDC
+ * notification stayed active in the controller, and nothing ever retried
+ * when the host did not come back. Now, as Linux dwc3 gadget.c:
+ *   - bus reset, disconnect, SET_CONFIGURATION(0): ENDTRANSFER (FORCERM) on
+ *     every active data transfer, ep0 back to the setup phase
+ *     (dwc3_gadget_reset_interrupt, dwc3_stop_active_transfers,
+ *     dwc3_ep0_reset_state); SET_CONFIGURATION(1) sets everything up again;
+ *   - more device events (wakeup, U3/L2 suspend, erratic error), each type
+ *     logged (rate-limited);
+ *   - GUSB2PHYCFG SUSPHY and ENBLSLPM cleared (sm8450.dtsi
+ *     snps,dis_u2_susphy_quirk + snps,dis_enblslpm_quirk);
+ *   - a watchdog (ud_link_watch, every 100 ms from ud_thread and the panic
+ *     loop) reads DSTS: no SOF for negroniusb_reconnect s (default 5), or a
+ *     device event that brought no SOF within 1 s (once per episode), means the host is gone or
+ *     did not get the device: soft disconnect + soft connect
+ *     (dwc3_gadget_soft_disconnect / _soft_connect: ENDTRANSFER, RUN_STOP 0,
+ *     wait for the halt, pull-up off 100 ms, core soft reset, event buffer,
+ *     ep0, RUN_STOP 1). The host sees a fresh attach. Then again every
+ *     negroniusb_reconnect s (6x as long after 12 tries in one episode, or
+ *     at once while configured in L2: a sleeping host) until SOFs come.
+ */
+static uint64_t
+ud_abs_ms(uint64_t ms)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime(ms * NSEC_PER_MSEC, &abs);
+	return abs;
+}
+
+static const char *
+ud_link_name(uint32_t l)
+{
+	switch (l) {
+	case 0: return "on";
+	case 2: return "sleep L1";
+	case 3: return "suspend L2";
+	case 4: return "disconnected";
+	case 5: return "early suspend";
+	case 14: return "reset";
+	case 15: return "resume";
+	default: return "?";
+	}
+}
+
+/* Device event type t happened: true = log it (the first 8 of each type, then every 100th). */
+static bool
+ud_devevent_note(unsigned t)
+{
+	uint32_t n = ++ud.devevents[t & 15];
+	return n <= 8 || (n % 100) == 0;
+}
+
+/*
+ * ENDTRANSFER on physical endpoint ep if a transfer is active. Data
+ * endpoints: FORCERM (Linux dwc3_stop_active_transfer); ep0/ep1: CMDIOC
+ * without FORCERM (Linux dwc3_ep0_end_control_data; the completion event is
+ * not used). Then 1 ms before the next command on that endpoint: Linux
+ * mdelay(1) for a DWC_usb31 without GUCTL2[14] (the end may still be in
+ * progress when the command bit clears).
+ */
+static void
+ud_end_transfer(unsigned ep)
+{
+	if (ep >= 6 || !ud.ep_busy[ep]) {
+		return;
+	}
+	ud.ep_busy[ep] = false;
+	uint32_t flags = ep <= 1 ? DEPCMD_CMDIOC : DEPCMD_FORCERM;
+	(void)ud_epcmd(ep, DEPCMD_ENDTRANSFER | flags | (ud.ep_rsc[ep] << 16), 0, 0, 0);
+	ud_udelay(1000);
+}
+
+/*
+ * Bus reset, disconnect, SET_CONFIGURATION(0), soft reconnect: every data
+ * transfer ended, the data endpoints off, "not configured". Also from the
+ * panic loop (no lock there).
+ */
+static void
+ud_drop_data(void)
+{
+	bool was = ud.configured;
+
+	uint32_t was_at = ud.where;
+	if (!ud_in_panic) {
+		ud.where = UD_AT_DROPLOCK;      /* 0375 */
+		lck_mtx_lock(ud.lock);
+		ud.where = was_at;
+	}
+	ud.configured = false;          /* ud_if_output and ud_tx_kick_locked stop here */
+	if (ud_reset_end) {
+		ud_end_transfer(EP_TX);
+	}
+	ud.tx_busy = false;
+	ud.tx_batch = false;
+	if (!ud_in_panic) {
+		lck_mtx_unlock(ud.lock);
+	}
+	if (ud_reset_end) {
+		ud_end_transfer(EP_RX);
+		ud_end_transfer(EP_INT);
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud.rx_started = false;          /* 0361: SET_CONFIGURATION starts the ring again */
+	ud.data_alt = 0;
+	if (was) {
+		ud_link_event(false);
+	}
+}
+
+/* ep0 back to the setup phase (Linux dwc3_ep0_reset_state: end the control transfer, stall, restart). */
+static void
+ud_ep0_reset(void)
+{
+	if (ud.state == EP0_SETUP || !ud_reset_end) {
+		return;
+	}
+	printf("NEGRONI USB: ep0 was in state %d: control transfer ended, setup phase again\n", (int)ud.state);
+	ud_end_transfer(0);
+	ud_end_transfer(1);
+	ud_stall();
+}
+
+/*
+ * Device controller start: from negroni_usb_gadget_start() and after a soft
+ * disconnect (Linux dwc3_gadget_soft_connect: core soft reset, event
+ * buffer, __dwc3_gadget_start, run). The PHY and the global setup stay as
+ * the firmware left them (but GUSB2PHYCFG, see 0366 above).
+ */
+static bool
+ud_hw_start(bool loud)
+{
+	int i;
+
+	/* Port in device mode (Linux dwc3_set_prtcap: GCTL PRTCAPDIR = 2); the firmware may have left it a host. */
+	dwc_wr(GCTL, (dwc_rd(GCTL) & ~(3u << 12)) | (2u << 12));
+	/* Device controller soft reset (PHY and global setup stay as the firmware left them). */
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		ud_udelay(1000);
+	}
+	if (loud || (dwc_rd(DCTL) & DCTL_CSFTRST)) {
+		printf("NEGRONI USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+		    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+	}
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return false;
+	}
+	/* 0366: Linux dwc3_core_soft_reset waits 50 ms after the reset for a DWC_usb31 <= 1.80a (ours: 1.10a) before PHY-domain writes */
+	ud_udelay(50 * 1000);
+	if (ud_phycfg) {
+		/* 0366: Linux snps,dis_u2_susphy_quirk + snps,dis_enblslpm_quirk (sm8450.dtsi) */
+		uint32_t p = dwc_rd(GUSB2PHYCFG), q = p & ~(GUSB2PHYCFG_SUSPHY | GUSB2PHYCFG_ENBLSLPM);
+		if (q != p) {
+			dwc_wr(GUSB2PHYCFG, q);
+		}
+		if (loud) {
+			printf("NEGRONI USB: GUSB2PHYCFG 0x%08x -> 0x%08x (SUSPHY, ENBLSLPM off; negroniusb_phycfg=0 keeps it)\n",
+			    p, dwc_rd(GUSB2PHYCFG));
+		}
+	}
+
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+
+	/* High speed, address 0 */
+	uint32_t dcfg = dwc_rd(DCFG) & ~(7u | (0x7fu << 3));
+	dwc_wr(DCFG, dcfg | 0);
+	/* Events: disconnect, USB reset, connect done (+ 0366: wakeup, U3/L2 suspend, erratic error) */
+	dwc_wr(DEVTEN, DEVTEN_BASE | (ud_more_events >= 1 ? DEVTEN_MORE : 0) | (ud_more_events >= 2 ? DEVTEN_ULSTCNG : 0));
+	for (i = 0; i < 6; i++) {
+		ud.ep_busy[i] = false;  /* the soft reset ended every transfer */
+	}
+
+	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("NEGRONI USB: endpoint 0 setup failed\n");
+		return false;
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud_start_setup();
+
+	if (ud.qs != 0) {
+		uint32_t hs = usb_rd(ud.qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(ud.qs, QSCRATCH_SS_PHY_CTRL);
+		if (loud) {
+			printf("NEGRONI USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x GENERAL_CFG 0x%08x\n",
+			    hs, ss, usb_rd(ud.qs, 0x08));
+		}
+		*(volatile uint32_t *)(ud.qs + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		*(volatile uint32_t *)(ud.qs + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		if (loud) {
+			printf("NEGRONI USB: VBUS override on: HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x\n",
+			    usb_rd(ud.qs, QSCRATCH_HS_PHY_CTRL), usb_rd(ud.qs, QSCRATCH_SS_PHY_CTRL));
+		}
+	}
+
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		ud_udelay(1000);
+	}
+	if (loud) {
+		printf("NEGRONI USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_pa);
+	}
+	return true;
+}
+
+/*
+ * 0368: the ADSP charger firmware and the HS PHY (README-usb.md "0368").
+ * [V] The ADSP image has a USB PHY utility (adsp.b14 strings, usb_pmic_util_log.c):
+ * usb_hs_phy_reset, usb_hs_phy_set_nondrive_mode, usb_hs_phy_toggle_dp, usb_hs_phy_dp_high,
+ * usb_hs_phy_dp_default_state, usb_hs_phy_enable_clkref ("clk_cnt %d, enable %d") on
+ * gcc_eusb3_0_clkref_en, which is the ref_clk of our PHY (live.dts hsphy@88e3000 clocks
+ * <gcc 0x1f>, gcc-waipio.h 31 = GCC_EUSB3_0_CLKREF_EN, register 0x9c00c). Its BC1.2/APSD,
+ * HVDCP and VOOC detection takes D+/D- from the PHY when the charger PD starts with a cable in.
+ * [V] Android starts the gadget after the ADSP, and dwc3-msm runs the PHY init on every role
+ * change; we start the gadget long before the ADSP and never touched the PHY. [I] So the PHY
+ * stays reset / non-driving / without its reference clock after the ADSP's detection, and the
+ * host sees no device at all.
+ * Here: snapshot of the PHY, its GCC reset and ref clock at the gadget start (the baseline, a
+ * working link), a log of every change (10 ms samples from the ADSP start to 10 s after it is
+ * up), and a repair: PHY init as Linux qcom_snps_hsphy_init (ref clock on, block reset,
+ * register sequence with the baseline's FSEL/REFCLK_SEL/overrides) inside a soft reconnect.
+ */
+#define HSPHY_PA                0x088e3000      /* live.dts hsphy@88e3000 "qcom,usb-hsphy-snps-femto" */
+#define EUD_EN_PA               0x088e2000      /* live.dts hsphy reg "eud_enable_reg" */
+#define GCC_HSPHY_BCR_PA        (GCC_PA + 0x22000)      /* GCC_QUSB2PHY_PRIM_BCR (gcc-sm8450.c, gcc-waipio.c) */
+#define GCC_CLKREF_PAGE         (GCC_PA + 0x9c000)      /* GCC_EUSB3_0_CLKREF_EN at +0xc */
+#define GCC_CLKREF_OFF          0x00c
+/* Linux phy-qcom-snps-femto-v2.c register offsets (the same in ios-flame 0089) */
+#define HP_UTMI_CTRL0   0x3c    /* SLEEPM 0, OPMODE 4:3 (1 = non-driving), TERMSEL 5 */
+#define HP_UTMI_CTRL1   0x40    /* XCVRSEL */
+#define HP_UTMI_CTRL5   0x50    /* POR 1 */
+#define HP_COMMON0      0x54    /* SIDDQ 2, FSEL 6:4 */
+#define HP_COMMON1      0x58    /* VBUSVLDEXTSEL0 4, PLLBTUNE 5 */
+#define HP_COMMON2      0x5c    /* VREGBYPASS 0 */
+#define HP_CTRL1        0x60    /* VBUSVLDEXT0 0 */
+#define HP_CTRL2        0x64    /* USB2_SUSPEND_N 2, USB2_SUSPEND_N_SEL 3 */
+#define HP_X0           0x6c    /* parameter overrides X0..X3 */
+#define HP_CFG0         0x94    /* UTMI_PHY_DATAPATH_CTRL_OVERRIDE_EN 0, UTMI_PHY_CMN_CTRL_OVERRIDE_EN 1 */
+#define HP_REFCLK       0xa0    /* REFCLK_SEL 1:0 */
+static const uint16_t hp_regs[] = { HP_UTMI_CTRL0, HP_UTMI_CTRL1, HP_UTMI_CTRL5, HP_COMMON0, HP_COMMON1,
+	                            HP_COMMON2, HP_CTRL1, HP_CTRL2, HP_X0, HP_X0 + 4, HP_X0 + 8, HP_X0 + 12, HP_CFG0, HP_REFCLK };
+static const char *const hp_names[] = { "utmi0", "utmi1", "utmi5", "common0", "common1", "common2", "ctrl1",
+	                                "ctrl2", "x0", "x1", "x2", "x3", "cfg0", "refclk", "clkref_en", "bcr", "eud_en" };
+#define HP_N            (sizeof(hp_regs) / sizeof(hp_regs[0]))
+#define HP_CLKREF       HP_N            /* snapshot slots after the PHY registers */
+#define HP_BCR          (HP_N + 1)
+#define HP_EUD          (HP_N + 2)
+#define HP_SLOTS        (HP_N + 3)
+_Static_assert(sizeof(hp_names) / sizeof(hp_names[0]) == HP_SLOTS, "0368 PHY slot names");
+/* live.dts hsphy qcom,param-override-seq = <0xe7 0x6c 0x0f 0x70 0x17 0x74 0x03 0x78> (value, offset) */
+static const uint8_t hp_dt_override[4] = { 0xe7, 0x0f, 0x17, 0x03 };
+
+static int ud_phyfix = 1;       /* boot-arg negroniusb_phyfix: 0 log only, 1 repair a changed PHY (default), 2 also re-init 3 s after each ADSP up */
+static int ud_phyfix_ms = 1500; /* boot-arg negroniusb_phyfix_ms: the PHY must stay unchanged this long before a repair */
+static int ud_phyfix_holdoff_s = 5;     /* boot-arg negroniusb_phyfix_holdoff_s: no PHY init until ADSP up + N s (HVDCP holds D+ ~1.25 s) */
+#define HP_MAX_INITS            5       /* PHY inits per ADSP start; then log only (review F3) */
+#define HP_MAX_WINDOW_LINES     200     /* change lines in the 10 ms window (review F4) */
+static struct {
+	vm_offset_t phy, eud, bcr, clkref;
+	bool        ok;                 /* mapped and the baseline taken */
+	bool        reinit_next;        /* the next soft reconnect runs hp_init() */
+	bool        differs;            /* the last sample differs from ref[] */
+	uint32_t    base[HP_SLOTS];     /* at the gadget start: a working link (restore values) */
+	uint32_t    ref[HP_SLOTS];      /* what a repair compares with: base, then the state after the last repair */
+	uint32_t    last[HP_SLOTS];
+	volatile uint64_t adsp_start_at, adsp_up_at;    /* mach_absolute_time (negroni_usb_adsp_event) */
+	volatile bool adsp_seen;
+	uint64_t    next, changed_at, last_repair, forced_for;
+	uint32_t    change_lines, repairs;
+	bool        host_seen;          /* review 2: DSTS.SOFFN changed between two of our samples (a host sends SOFs) */
+	bool        sof_valid;
+	uint32_t    last_sof;
+	uint32_t    start_inits;        /* PHY inits since the last ADSP start (review F3: at most HP_MAX_INITS) */
+	uint32_t    window_lines;       /* change lines in the 10 ms window (review F4: at most HP_MAX_WINDOW_LINES) */
+	bool        cap_bypass;         /* 0381: a data path re-init may run one PHY init past HP_MAX_INITS */
+	char        why[160];           /* 0385: hp_init_blocked() reason with the adapter type (ud_thread only) */
+} hp;
+
+/* the slots a repair looks at: the PHY registers, clkref enable (bit 0) + CLK_OFF (bit 31), BCR (bit 0); not EUD */
+static uint32_t
+hp_cmp_mask(unsigned i)
+{
+	return i < HP_N ? 0xffffffffu : i == HP_CLKREF ? 0x80000001u : i == HP_BCR ? 1u : 0u;
+}
+
+static bool
+hp_same(const uint32_t *a, const uint32_t *b)
+{
+	for (unsigned i = 0; i < HP_SLOTS; i++) {
+		if ((a[i] ^ b[i]) & hp_cmp_mask(i)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+hp_snap(uint32_t *v)
+{
+	for (unsigned i = 0; i < HP_N; i++) {
+		v[i] = usb_rd(hp.phy, hp_regs[i]);
+	}
+	v[HP_CLKREF] = usb_rd(hp.clkref, GCC_CLKREF_OFF);
+	v[HP_BCR] = usb_rd(hp.bcr, 0);
+	v[HP_EUD] = usb_rd(hp.eud, 0);
+}
+
+static void
+hp_dump(const char *when, const uint32_t *v)
+{
+	printf("NEGRONI USB: PHY %s: utmi0 %x utmi1 %x utmi5 %x common0 %x common1 %x common2 %x ctrl1 %x ctrl2 %x "
+	    "x0-3 %x %x %x %x cfg0 %x refclk %x | clkref_en 0x%08x bcr 0x%x eud_en 0x%x\n", when, v[0], v[1], v[2],
+	    v[3], v[4], v[5], v[6], v[7], v[8], v[9], v[10], v[11], v[12], v[13], v[HP_CLKREF], v[HP_BCR], v[HP_EUD]);
+}
+
+/* ms from t (mach_absolute_time) to now: negative when t is later than now; -1 when t is 0 (not set) */
+static int64_t
+hp_ms_since(uint64_t t, uint64_t now)
+{
+	if (t == 0) {
+		return -1;
+	}
+	return now >= t ? (int64_t)((now - t) * 1000 / ud_abs_ms(1000)) : -(int64_t)((t - now) * 1000 / ud_abs_ms(1000));
+}
+
+/* At the gadget start: map, read the boot-args, take the baseline. */
+static void
+hp_setup(void)
+{
+	PE_parse_boot_argn("negroniusb_phyfix", &ud_phyfix, sizeof(ud_phyfix));
+	PE_parse_boot_argn("negroniusb_phyfix_ms", &ud_phyfix_ms, sizeof(ud_phyfix_ms));
+	PE_parse_boot_argn("negroniusb_phyfix_holdoff_s", &ud_phyfix_holdoff_s, sizeof(ud_phyfix_holdoff_s));
+	if (ud_phyfix_holdoff_s < 0 || ud_phyfix_holdoff_s > 120) {
+		ud_phyfix_holdoff_s = 5;
+	}
+	if (ud_phyfix_ms < 100 || ud_phyfix_ms > 60000) {
+		ud_phyfix_ms = 1500;
+	}
+	hp.phy = ml_io_map(HSPHY_PA, 0x1000);
+	hp.eud = ml_io_map(EUD_EN_PA, 0x1000);
+	hp.bcr = ml_io_map(GCC_HSPHY_BCR_PA, 0x1000);
+	hp.clkref = ml_io_map(GCC_CLKREF_PAGE, 0x1000);
+	if (!hp.phy || !hp.eud || !hp.bcr || !hp.clkref) {
+		printf("NEGRONI USB: PHY watch off: map failed\n");
+		return;
+	}
+	hp_snap(hp.base);
+	memcpy(hp.ref, hp.base, sizeof(hp.ref));
+	memcpy(hp.last, hp.base, sizeof(hp.last));
+	hp.ok = true;
+	hp_dump("baseline at the gadget start", hp.base);
+	printf("NEGRONI USB: PHY watch on: repair %s (negroniusb_phyfix=%d), stable %d ms before a repair (negroniusb_phyfix_ms), "
+	    "hold-off ADSP up + %d s, at most %d PHY inits per ADSP start, host ports (SDP/CDP/PD_SDP) or a host in this boot, "
+	    "not for a wall charger without SET_CONFIGURATION, not during VOOC\n",
+	    ud_phyfix >= 2 ? "on + re-init after each ADSP up" : ud_phyfix ? "on" : "off (log only)", ud_phyfix, ud_phyfix_ms,
+	    ud_phyfix_holdoff_s, HP_MAX_INITS);
+}
+
+static void
+hp_rmw(uint32_t off, uint32_t mask, uint32_t val)
+{
+	uint32_t v = usb_rd(hp.phy, off);
+	*(volatile uint32_t *)(hp.phy + off) = (v & ~mask) | (val & mask);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * 0385: the charger client's adapter type (Linux POWER_SUPPLY_USB_TYPE_*, oplus_battery_sm8450.c usb_type_work).
+ * Host ports: SDP 1, CDP 3, PD_SDP 17 (oplus_charger.h:481, OPLUS: "USB With PD Port", a PD source that is also
+ * a USB host, e.g. a Mac Type-C port; stock maps it to POWER_SUPPLY_TYPE_USB). Wall chargers: DCP 2, BrickID 9,
+ * QTI HVDCP 0x80/0x81/0x82 (stock maps all of them to POWER_SUPPLY_TYPE_USB_DCP).
+ */
+static bool
+hp_type_host(int32_t t)
+{
+	return t == 1 || t == 3 || t == 17;
+}
+
+static bool
+hp_type_wall(int32_t t)
+{
+	return t == 2 || t == 9 || (t >= 0x80 && t <= 0x82);
+}
+
+/*
+ * Review F2/F3: may the PHY be set up now? Not while the EUD owns the PHY (eud_en bit 0), not before ADSP up +
+ * negroniusb_phyfix_holdoff_s, not while the ADSP's VOOC path is active, at most HP_MAX_INITS per ADSP start.
+ * 0385: then yes when the adapter type is a host port (SDP/CDP/PD_SDP) or a host was there in this boot
+ * (SET_CONFIGURATION once, or SOFFN moved); never for a wall charger (DCP/HVDCP/BrickID) without a
+ * SET_CONFIGURATION in this boot. NULL = yes, else the reason. ud_thread only (hp.why).
+ */
+static const char *
+hp_init_blocked(void)
+{
+	struct negroni_chg_glink_status cs;
+	uint64_t now = mach_absolute_time(), up = hp.adsp_up_at;
+
+	if (usb_rd(hp.eud, 0) & 1) {
+		return "the EUD is on (eud_en bit 0)";
+	}
+	if (hp.adsp_start_at != 0 && (up == 0 || now < up + ud_abs_ms((uint64_t)ud_phyfix_holdoff_s * 1000))) {
+		return "ADSP hold-off (up + negroniusb_phyfix_holdoff_s not reached)";
+	}
+	if (hp.start_inits >= HP_MAX_INITS && !hp.cap_bypass) {
+		return "5 PHY inits since the ADSP start already (log only now)";
+	}
+	/*
+	 * 0385: a host in this boot (SET_CONFIGURATION or SOFFN moved) also allows the init. t25: the PD reported
+	 * adapter type 17 (POWER_SUPPLY_USB_TYPE_PD_SDP, oplus_charger.h:481 "USB With PD Port", stock maps it to
+	 * POWER_SUPPLY_TYPE_USB = SDP) for a Mac port; the old SDP/CDP-only rule refused every repair.
+	 */
+	bool host = ud.ever_configured || hp.host_seen;
+	if (negroni_chg_glink_get(&cs) && cs.ready) {
+		if (cs.vooc_active) {
+			return "VOOC is active (the ADSP owns D+/D-)";      /* 0369 */
+		}
+		if (hp_type_host(cs.usb_type)) {
+			return NULL;
+		}
+		if (hp_type_wall(cs.usb_type) && !ud.ever_configured) {
+			snprintf(hp.why, sizeof(hp.why), "a wall charger (adapter type %d, DCP/HVDCP/BrickID) and no "
+			    "SET_CONFIGURATION in this boot", cs.usb_type);
+			return hp.why;
+		}
+		if (host) {
+			return NULL;
+		}
+		snprintf(hp.why, sizeof(hp.why), "no host seen in this boot (no SET_CONFIGURATION, SOFFN never moved) "
+		    "and adapter type %d is not a host port (SDP 1/CDP 3/PD_SDP 17)", cs.usb_type);
+		return hp.why;
+	}
+	return host ? NULL : "no host seen in this boot (no SET_CONFIGURATION, SOFFN never moved) and no adapter type";
+}
+
+/*
+ * PHY init as Linux qcom_snps_hsphy_init (phy-qcom-snps-femto-v2.c) after
+ * reset_control_assert/deassert of GCC_QUSB2PHY_PRIM_BCR and with the ref clock on.
+ * FSEL, REFCLK_SEL and the X0..X3 overrides come from the baseline (the firmware's working
+ * setup). Called with the controller halted (soft reconnect); ud_hw_start() follows.
+ */
+static void
+hp_init(void)
+{
+	uint32_t before[HP_SLOTS], after[HP_SLOTS];
+	bool clk_was_off;
+
+	hp_snap(before);
+	clk_was_off = !(before[HP_CLKREF] & 1);
+	if (clk_was_off) {
+		*(volatile uint32_t *)(hp.clkref + GCC_CLKREF_OFF) = before[HP_CLKREF] | 1;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (int i = 0; i < 100 && (usb_rd(hp.clkref, GCC_CLKREF_OFF) & 0x80000000u); i++) {
+			ud_udelay(10);
+		}
+	}
+	*(volatile uint32_t *)hp.bcr = usb_rd(hp.bcr, 0) | 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ud_udelay(150);
+	*(volatile uint32_t *)hp.bcr = usb_rd(hp.bcr, 0) & ~1u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ud_udelay(150);
+	hp_rmw(HP_CFG0, 1u << 1, 1u << 1);                     /* UTMI_PHY_CMN_CTRL_OVERRIDE_EN */
+	hp_rmw(HP_UTMI_CTRL5, 1u << 1, 1u << 1);               /* POR */
+	hp_rmw(HP_COMMON0, 7u << 4, hp.base[3] & (7u << 4));   /* FSEL */
+	hp_rmw(HP_COMMON1, 1u << 5, 1u << 5);                  /* PLLBTUNE */
+	hp_rmw(HP_REFCLK, 3u, hp.base[13] & 3u);               /* REFCLK_SEL */
+	hp_rmw(HP_COMMON1, 1u << 4, 1u << 4);                  /* VBUSVLDEXTSEL0 */
+	hp_rmw(HP_CTRL1, 1u << 0, 1u << 0);                    /* VBUSVLDEXT0 */
+	for (unsigned i = 0; i < 4; i++) {                     /* parameter overrides (Linux: before VREGBYPASS) */
+		hp_rmw(HP_X0 + 4 * i, 0xffu, hp.base[8 + i] & 0xffu);
+	}
+	hp_rmw(HP_COMMON2, 1u << 0, 1u << 0);                  /* VREGBYPASS */
+	hp_rmw(HP_CTRL2, (1u << 3) | (1u << 2), (1u << 3) | (1u << 2));        /* USB2_SUSPEND_N_SEL | USB2_SUSPEND_N */
+	hp_rmw(HP_UTMI_CTRL0, 1u << 0, 1u << 0);               /* SLEEPM */
+	hp_rmw(HP_COMMON0, 1u << 2, 0);                        /* SIDDQ off */
+	ud_udelay(100);
+	hp_rmw(HP_UTMI_CTRL5, 1u << 1, 0);                     /* POR release */
+	hp_rmw(HP_CTRL2, 1u << 3, 0);                          /* USB2_SUSPEND_N_SEL off */
+	hp_rmw(HP_CFG0, 3u, hp.base[12] & 3u);                 /* override enables as at the baseline (Linux: CMN off) */
+	/*
+	 * 0385: the PD's UTMI overrides off in any case (t25: utmi0 9 = SLEEPM + OPMODE non-driving with cfg0 1 =
+	 * datapath override: no pull-up). utmi0/utmi1/ctrl2 as at the gadget start, then cfg0 as at the gadget start
+	 * (0 = the controller drives UTMI). Whole-register writes: these are byte registers (reads repeat the byte).
+	 */
+	*(volatile uint32_t *)(hp.phy + HP_UTMI_CTRL0) = hp.base[0];
+	*(volatile uint32_t *)(hp.phy + HP_UTMI_CTRL1) = hp.base[1];
+	*(volatile uint32_t *)(hp.phy + HP_CTRL2) = hp.base[7];
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(hp.phy + HP_CFG0) = hp.base[12];
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ud_udelay(1000);
+	hp_snap(after);
+	bool clean = after[0] == hp.base[0] && after[1] == hp.base[1] && after[7] == hp.base[7] &&
+	    after[12] == hp.base[12];
+	hp.repairs++;
+	hp.start_inits++;
+	if (hp.repairs <= 10 || hp.repairs % 10 == 0) {
+		hp_dump("before the re-init", before);
+		hp_dump("after the re-init", after);
+		printf("NEGRONI USB: PHY re-init #%u (%u since the ADSP start): ref clock %s, block reset, Linux init sequence, "
+		    "cfg0 datapath override (bit 0) %u -> %u (overrides x0-3 %x %x %x %x; DT has %x %x %x %x)\n",
+		    hp.repairs, hp.start_inits, clk_was_off ? "was OFF, now on" : "on", before[12] & 1, after[12] & 1,
+		    after[8], after[9], after[10], after[11],
+		    hp_dt_override[0], hp_dt_override[1], hp_dt_override[2], hp_dt_override[3]);
+		printf("NEGRONI USB: PHY re-init #%u: UTMI overrides %s: utmi0 %x->%x utmi1 %x->%x ctrl2 %x->%x cfg0 %x->%x "
+		    "(gadget start %x %x %x %x)\n", hp.repairs, clean ? "cleared (as at the gadget start)" : "NOT cleared",
+		    before[0], after[0], before[1], after[1], before[7], after[7], before[12], after[12],
+		    hp.base[0], hp.base[1], hp.base[7], hp.base[12]);
+	}
+	memcpy(hp.ref, after, sizeof(hp.ref));
+	memcpy(hp.last, after, sizeof(hp.last));
+	hp.differs = false;
+}
+
+/*
+ * 0368: called by negroni_adsp.c: 0 = the ADSP is about to start (PAS auth and reset), 1 = it is
+ * up (READY), 2 = it stopped or failed. Only timestamps and one snapshot line (no writes).
+ */
+/*
+ * 0372: the USB PHY supply rails and the ADSP (README-usb.md "0372").
+ * [V] t11-t13 (2026-10-27): the Mac loses the device ~2-3 s after ADSP up, also without any
+ * charger GLINK client; the PHY registers read unchanged and soft reconnects + PHY re-inits
+ * (0366/0368) bring nothing back until a reboot. [V] The ADSP image votes the PMIC rails
+ * "/pm/ldob2", "/pm/ldob5", "/pm/ldob6", "/pm/ldoc1" (en, mode, mV; adsp.b14 strings): exactly
+ * the HS PHY supplies (live.dts hsphy@88e3000: vdd = pm8350_l5 0.88 V, vdda18 = pm8350c_l1 1.8 V,
+ * vdda33 = pm8350_l2 3.072 V) and the SS PHY core (pm8350_l6 1.2 V). [V] Linux/Android always hold
+ * an APPS vote for them (rpmh-regulator init-voltage/init-mode HPM with qcom,set = 3; the PHY
+ * driver enables them); XNU holds none. [I] So when the charger PD releases its own votes after
+ * its port detection, RPMh turns the PHY's analog rails off (or to LPM): the pull-up and the HS
+ * transceiver die, the digital registers still read. A soft reconnect cannot fix that.
+ * negroniusb_rails: 0 = off; 1 (default) = log only: the four LDOs' PMIC registers (SPMI observer
+ * reads: STATUS1 0x08, VSET 0x40/0x41, MODE 0x45, EN_CTL 0x46) at the ADSP start / up and every
+ * 50 ms from the start to up + 30 s; 2 = also APPS RPMh votes (HPM, DT voltages) before the ADSP
+ * starts (negroni_rpmh_usb_rails), so the ADSP's release cannot turn them off.
+ */
+extern int negroni_spmi_read_rc(unsigned sid, unsigned addr, uint8_t *out);
+extern int negroni_rpmh_usb_rails(void);
+extern kern_return_t thread_terminate(thread_t);
+#define UR_N            4
+#define UR_REGS         5
+#define UR_ERR          0x8000u         /* + negroni_spmi_read_rc code */
+#define UR_MAX_LINES    100
+static const struct { const char *name; unsigned sid, base; } ur_rail[UR_N] = {
+	{ "L5B vdd", 1, 0x4400 }, { "L1C vdda18", 2, 0x4000 }, { "L2B vdda33", 1, 0x4100 }, { "L6B ss", 1, 0x4500 },
+};
+static const uint8_t ur_off[UR_REGS] = { 0x08, 0x40, 0x41, 0x45, 0x46 };
+static int ur_mode = -1;                        /* boot-arg negroniusb_rails */
+static volatile bool ur_watch_running;
+static volatile uint64_t ur_start_at, ur_up_at;
+static int ur_vote_failed = -1;                 /* -1 = no vote sent */
+
+static void
+ur_snap(uint16_t v[UR_N][UR_REGS])
+{
+	for (unsigned r = 0; r < UR_N; r++) {
+		for (unsigned i = 0; i < UR_REGS; i++) {
+			uint8_t b = 0;
+			int rc = negroni_spmi_read_rc(ur_rail[r].sid, ur_rail[r].base + ur_off[i], &b);
+			v[r][i] = rc ? (uint16_t)(UR_ERR | (unsigned)rc) : b;
+		}
+	}
+}
+
+static void
+ur_text(char *buf, size_t size, uint16_t v[UR_N][UR_REGS])
+{
+	size_t n = 0;
+	buf[0] = 0;
+	for (unsigned r = 0; r < UR_N && n < size; r++) {
+		unsigned bad = UR_REGS;
+		for (unsigned i = 0; i < UR_REGS && bad == UR_REGS; i++) {
+			if (v[r][i] & UR_ERR) {
+				bad = i;        /* any failed read: no half-valid line */
+			}
+		}
+		if (bad < UR_REGS) {
+			n += snprintf(buf + n, size - n, "%s%s: read %#x rc %u", r ? " | " : "", ur_rail[r].name,
+			    ur_rail[r].base + ur_off[bad], v[r][bad] & 0xffu);
+			continue;
+		}
+		/* [I] PMIC5 LDO: STATUS1 bit 7 VREG_READY, VSET in mV (LSB 0x40, MSB 0x41), MODE 7 HPM / 5 LPM / 3 RET, EN_CTL bit 7 */
+		n += snprintf(buf + n, size - n, "%s%s: st %02x %u mV mode %02x en %02x", r ? " | " : "", ur_rail[r].name,
+		    v[r][0] & 0xffu, ((v[r][2] & 0xffu) << 8) | (v[r][1] & 0xffu), v[r][3] & 0xffu, v[r][4] & 0xffu);
+	}
+}
+
+static void
+ur_dump(const char *when)
+{
+	uint16_t v[UR_N][UR_REGS];
+	char text[400];
+	ur_snap(v);
+	ur_text(text, sizeof(text), v);
+	printf("NEGRONI USB: PHY rails %s: %s\n", when, text);
+}
+
+static int64_t
+ur_ms(uint64_t t, uint64_t now)
+{
+	return t == 0 ? -1 : (int64_t)((now - t) * 1000 / ud_abs_ms(1000));
+}
+
+/* 50 ms samples from the ADSP start until ADSP up + 30 s (60 s at most without up); one line per change. */
+static void
+ur_watch_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint16_t last[UR_N][UR_REGS], v[UR_N][UR_REGS];
+	char text[400];
+	unsigned changes = 0;
+
+	ur_snap(last);
+	for (;;) {
+		ud_sleep_ms(50);
+		uint64_t now = mach_absolute_time(), up = ur_up_at;
+		if ((up != 0 && now - up > ud_abs_ms(30000)) || now - ur_start_at > ud_abs_ms(60000)) {
+			break;
+		}
+		ur_snap(v);
+		if (memcmp(v, last, sizeof(v)) != 0) {
+			changes++;
+			if (changes <= UR_MAX_LINES) {
+				ur_text(text, sizeof(text), v);
+				printf("NEGRONI USB: PHY rails change #%u (ADSP start +%lld ms, up +%lld ms): %s\n", changes,
+				    ur_ms(ur_start_at, now), ur_ms(up, now), text);
+			}
+			memcpy(last, v, sizeof(v));
+		}
+	}
+	ur_text(text, sizeof(text), last);
+	printf("NEGRONI USB: PHY rails watch end: %u changes%s; now %s\n", changes,
+	    ur_vote_failed == 0 ? " (APPS votes held)" : ur_vote_failed > 0 ? " (APPS vote FAILED for some)" : " (no APPS vote)",
+	    text);
+	ur_watch_running = false;
+	(void)thread_terminate(current_thread());
+}
+
+/* Called from negroni_usb_adsp_event (the ADSP thread): 0 before PAS auth-and-reset, 1 at ADSP up, 2 stop. */
+static void
+ur_event(int what)
+{
+	if (ur_mode < 0) {
+		ur_mode = 1;
+		PE_parse_boot_argn("negroniusb_rails", &ur_mode, sizeof(ur_mode));
+		printf("NEGRONI USB: PHY rails (negroniusb_rails=%d): %s\n", ur_mode,
+		    ur_mode >= 2 ? "log + APPS RPMh votes before the ADSP start" : ur_mode == 1 ? "log only" : "off");
+	}
+	if (ur_mode <= 0) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (what == 0) {
+		ur_start_at = now;
+		ur_up_at = 0;
+		ur_dump("at the ADSP start");
+		if (ur_mode >= 2 && ur_vote_failed != 0) {
+			ur_vote_failed = negroni_rpmh_usb_rails();
+			printf("NEGRONI USB: PHY rails: APPS votes ldob5 880, ldoc1 1800, ldob2 3072, ldob6 1200 mV HPM: %s (fail mask %#x)\n",
+			    ur_vote_failed ? "NOT all voted" : "all voted", ur_vote_failed);
+			ur_dump("after our votes");
+		}
+		thread_t t;
+		if (!ur_watch_running) {
+			ur_watch_running = true;
+			if (kernel_thread_start(ur_watch_thread, NULL, &t) == KERN_SUCCESS) {
+				thread_deallocate(t);
+			} else {
+				ur_watch_running = false;
+			}
+		}
+	} else if (what == 1) {
+		ur_up_at = now;
+		ur_dump("at ADSP up");
+	} else {
+		ur_dump("at the ADSP stop");
+	}
+}
+
+void negroni_usb_adsp_event(int what);
+void
+negroni_usb_adsp_event(int what)
+{
+	uint32_t v[HP_SLOTS];
+
+	ur_event(what);                 /* 0372: the PHY supply rails (independent of the PHY watch) */
+	if (!hp.ok) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (what == 0) {
+		hp.adsp_start_at = now;
+		hp.adsp_up_at = 0;
+		hp.adsp_seen = true;
+		hp.start_inits = 0;
+		hp.window_lines = 0;
+	} else if (what == 1) {
+		hp.adsp_up_at = now;
+	}
+	hp_snap(v);
+	hp_dump(what == 0 ? "at the ADSP start" : what == 1 ? "at ADSP up" : "at the ADSP stop", v);
+}
+
+/* Soft disconnect + soft connect: the host sees the device go and come back (a fresh attach). */
+static void
+ud_soft_reconnect(const char *why, uint32_t dsts, uint64_t quiet_ms)
+{
+	uint32_t dropped = 0;
+	int i;
+
+	uint32_t was_at = ud.where;
+	ud.where = UD_AT_RECONNECT;     /* 0375 */
+	ud.reconnects++;
+	ud.episode_reconnects++;
+	bool loud = ud.episode_reconnects <= 3 || (ud.reconnects % 10) == 0;
+	if (loud) {
+		printf("NEGRONI USB: soft reconnect #%llu (%u in this episode): %s; no SOF for %llu ms, DSTS 0x%08x "
+		    "link %u (%s), %sconfigured, rx %llu tx %llu frames\n", ud.reconnects, ud.episode_reconnects, why,
+		    quiet_ms, dsts, DSTS_LINK(dsts), ud_link_name(DSTS_LINK(dsts)), ud.configured ? "" : "not ",
+		    ud.rx_frames, ud.tx_frames);
+	}
+	/* Linux dwc3_gadget_soft_disconnect: end the active transfers, ep0 to setup, RUN_STOP 0, wait for the halt */
+	ud_drop_data();
+	ud_end_transfer(0);
+	ud_end_transfer(1);
+	ud.state = EP0_SETUP;
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	for (i = 0; i < 500 && !(dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		/* the controller halts only when the event buffer is empty: ack what comes (not handled) */
+		uint32_t c = dwc_rd(GEVNTCOUNT) & 0xffff;
+		if (c) {
+			ud.evt_pos = (ud.evt_pos + c) % UD_EVT_SIZE;
+			dwc_wr(GEVNTCOUNT, c);
+			dropped += c / 4;
+		}
+		ud_udelay(1000);
+	}
+	bool halted = (dwc_rd(DSTS) & DSTS_DEVCTRLHLT) != 0;
+	/* pull-up off long enough for any host to see a disconnect */
+	if (ud_in_panic) {
+		ud_udelay(100 * 1000);
+	} else {
+		ud_sleep_ms(100);
+	}
+	/* 0368: after an ADSP start (or a PHY change), set the PHY up again before the controller */
+	if (hp.ok && ud_phyfix >= 1 && (hp.reinit_next || hp.adsp_seen)) {
+		/* review F1: never a PHY block reset under a running controller; F2/F3: hp_init_blocked() */
+		const char *no = !halted ? "the controller did not halt" : hp_init_blocked();
+		hp.reinit_next = false;
+		if (no == NULL) {
+			hp_init();
+		} else if (hp.repairs < 20) {
+			printf("NEGRONI USB: PHY init skipped in this reconnect: %s\n", no);
+		}
+	}
+	bool ok = ud_hw_start(false);
+	if (ud.events > 140) {
+		ud.events = 140;        /* print the next enumeration's events again */
+	}
+	if (loud || !ok || !halted) {
+		printf("NEGRONI USB: soft reconnect #%llu: %s after %d ms (%u events dropped), restart %s, DSTS 0x%08x\n",
+		    ud.reconnects, halted ? "halted" : "NOT halted", i, dropped, ok ? "ok" : "FAILED", dwc_rd(DSTS));
+	}
+	ud.where = was_at;
+}
+
+/*
+ * Every 100 ms (ud_thread, panic loop): DSTS link state and SOF number.
+ * No SOF for negroniusb_reconnect s: soft reconnect.
+ */
+static void
+ud_link_watch(void)
+{
+	uint64_t now = mach_absolute_time();
+
+	if (now < ud.next_watch) {
+		return;
+	}
+	ud.next_watch = now + ud_abs_ms(100);
+	uint32_t dsts = dwc_rd(DSTS);
+	uint32_t sof = DSTS_SOFFN(dsts), link = DSTS_LINK(dsts);
+	if (link != ud.last_link) {
+		if (ud_devevent_note(13)) {     /* type 13 is unused by the controller: our DSTS poll */
+			printf("NEGRONI USB: link %u (%s) -> %u (%s), DSTS 0x%08x\n", ud.last_link,
+			    ud_link_name(ud.last_link), link, ud_link_name(link), dsts);
+		}
+		ud.last_link = link;
+	}
+	if (ud.sof_seen == 0 || sof != ud.last_soffn) {
+		if (ud.nosof_logged) {
+			printf("NEGRONI USB: SOF again after %llu ms (link %u, %sconfigured, %u reconnects)\n",
+			    ud.sof_seen ? (now - ud.sof_seen) * 1000 / ud_abs_ms(1000) : 0, link,
+			    ud.configured ? "" : "not ", ud.episode_reconnects);
+		}
+		ud.last_soffn = sof;
+		ud.sof_seen = now;
+		/*
+		 * 0371: the host is there. 0375: only when SOFFN also moved in the
+		 * sample before (100 ms earlier): one change alone (for example
+		 * the frame number of a restarted controller) does not end the
+		 * stretch.
+		 */
+		if (ud.sof_moved) {
+			ud.lost_since = 0;
+		}
+		ud.sof_moved = true;
+		ud.nosof_logged = false;
+		ud.event_rule_done = false;
+		ud.episode_reconnects = 0;
+		return;
+	}
+	uint64_t quiet = now - ud.sof_seen;
+	uint64_t quiet_ms = quiet * 1000 / ud_abs_ms(1000);
+	/*
+	 * 0371: keep the phone reachable. Tests are RAM boots (fastboot boot) and
+	 * boot_a holds a known-good image, so a normal reboot always brings USB
+	 * back. With negroniusb_lost_reboot=S: when the device was configured at
+	 * least once in this boot and then had no SOF for S s in one stretch
+	 * (soft reconnects do not end the stretch, only a SOF does), end the boot
+	 * log and reset with reason 0 through the USB "reboot" command path
+	 * (ud_ctl_poll: negroni_bootlog_end 4 + negroni_reboot_reset, 500 ms
+	 * later so the line reaches the boot log). Never in panic mode: the panic
+	 * hold loop has its own timed reset.
+	 */
+	ud.sof_moved = false;           /* 0375 */
+	if (ud.lost_since == 0) {
+		ud.lost_since = ud.sof_seen;
+	}
+	if (ud_lost_reboot_s > 0 && ud.ever_configured && !ud_in_panic && !ud.lost_reboot_done &&
+	    ud.ctl_action == UD_CTL_NONE && now - ud.lost_since >= ud_abs_ms((uint64_t)ud_lost_reboot_s * 1000)) {
+		ud.lost_reboot_done = true;
+		bool set = negroni_reboot_set_reason(0) == 0;
+		printf("NEGRONI USB: host lost for %d s: rebooting (negroniusb_lost_reboot); DSTS 0x%08x link %u (%s), "
+		    "%llu soft reconnects, reason 0 %s\n", ud_lost_reboot_s, dsts, link, ud_link_name(link), ud.reconnects,
+		    set ? "set" : "NOT set (plain reset)");
+		snprintf(ud_ctl_why, sizeof(ud_ctl_why), "reset (USB host lost %d s)", ud_lost_reboot_s);
+		ud_ctl_schedule(UD_CTL_RESET);
+		return;
+	}
+	if (!ud.nosof_logged && quiet >= ud_abs_ms(3000)) {
+		ud.nosof_logged = true;
+		printf("NEGRONI USB: no SOF for 3 s (%sconfigured): DSTS 0x%08x link %u (%s), DCTL 0x%08x DEVTEN 0x%08x "
+		    "GUSB2PHYCFG 0x%08x, tx busy %d, rx %llu tx %llu frames (cable out, host asleep, or link lost)\n",
+		    ud.configured ? "" : "not ", dsts, link, ud_link_name(link), dwc_rd(DCTL), dwc_rd(DEVTEN),
+		    dwc_rd(GUSB2PHYCFG), ud.tx_busy, ud.rx_frames, ud.tx_frames);
+	}
+	if (ud_reconnect_s <= 0) {
+		return;
+	}
+	/* the long period at once while configured and in L2: most likely a sleeping host (review N2) */
+	bool slow = ud.episode_reconnects >= 12 || (link == 3 && ud.configured);
+	uint64_t wait = ud_abs_ms((uint64_t)ud_reconnect_s * (slow ? 6000 : 1000));
+	if (quiet >= wait) {
+		ud_soft_reconnect(slow ? "no SOF (long period)" : "no SOF", dsts, quiet_ms);
+	} else if (!ud.event_rule_done && ud.dev_event_at > ud.sof_seen + ud_abs_ms(500) &&
+	    now - ud.dev_event_at >= ud_abs_ms(1000)) {
+		/* a device event (wakeup, reset, ...) long after the last SOF and still no SOF 1 s later: the replug did not take (once per episode) */
+		ud.event_rule_done = true;
+		ud_soft_reconnect("device event without SOF", dsts, quiet_ms);
+	} else {
+		return;
+	}
+	ud.dev_event_at = 0;
+	ud.last_soffn = DSTS_SOFFN(dwc_rd(DSTS));
+	ud.sof_moved = false;                   /* 0375 */
+	ud.sof_seen = mach_absolute_time();     /* the next try one period later */
+	ud.next_watch = ud.sof_seen + ud_abs_ms(100);
+}
+
+/*
+ * 0368: PHY watch (ud_thread). Samples every 10 ms from the ADSP start until 10 s after
+ * ADSP up (30 s at most), else every 100 ms. Logs each change. Repair (negroniusb_phyfix >= 1):
+ * when the sample differs from ref[] (the baseline, or the state after the last repair) and
+ * has not changed for negroniusb_phyfix_ms, at most every 3 s: soft reconnect with hp_init().
+ */
+static void
+hp_watch(void)
+{
+	uint32_t v[HP_SLOTS];
+
+	if (!hp.ok) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (now < hp.next) {
+		return;
+	}
+	uint64_t st = hp.adsp_start_at, up = hp.adsp_up_at;
+	bool window = st != 0 && now < st + ud_abs_ms(30000) && (up == 0 || now < up + ud_abs_ms(10000));
+	hp.next = now + ud_abs_ms(window ? 10 : 100);
+	/* review 2: a host is there only when the SOF number moves between two samples (ud.sof_seen is set on the first sample) */
+	uint32_t sofn = DSTS_SOFFN(dwc_rd(DSTS));
+	if (hp.sof_valid && sofn != hp.last_sof && !hp.host_seen) {
+		hp.host_seen = true;
+		printf("NEGRONI USB: PHY watch: a host is there (SOF number moves)\n");
+	}
+	hp.last_sof = sofn;
+	hp.sof_valid = true;
+	hp_snap(v);
+	if (memcmp(v, hp.last, sizeof(v)) != 0) {
+		hp.changed_at = now;
+		bool wl = window && hp.window_lines < HP_MAX_WINDOW_LINES;
+		if (wl) {
+			hp.window_lines++;
+		}
+		if (wl || hp.change_lines < 64 || hp.change_lines % 100 == 0) {
+			char line[400];
+			int n = snprintf(line, sizeof(line), "NEGRONI USB: PHY change (ADSP start %+lld ms, up %+lld ms):",
+			    hp_ms_since(st, now), hp_ms_since(up, now));
+			for (unsigned i = 0; i < HP_SLOTS && n > 0 && n < (int)sizeof(line) - 40; i++) {
+				if (v[i] != hp.last[i]) {
+					n += snprintf(line + n, sizeof(line) - n, " %s %x->%x", hp_names[i], hp.last[i], v[i]);
+				}
+			}
+			printf("%s\n", line);
+		}
+		hp.change_lines++;
+		memcpy(hp.last, v, sizeof(v));
+	}
+	bool differs = !hp_same(v, hp.ref);
+	if (differs != hp.differs) {
+		hp.differs = differs;
+		hp_dump(differs ? "differs from the reference" : "back at the reference", v);
+	}
+	if (ud_phyfix <= 0 || (hp.last_repair != 0 && now - hp.last_repair < ud_abs_ms(3000))) {
+		return;
+	}
+	bool force = ud_phyfix >= 2 && up != 0 && hp.forced_for != up && now >= up + ud_abs_ms(3000);
+	/* only after an ADSP start: nothing else writes the PHY (no reconnect loop on a register that moves by itself) */
+	if (!force && !(hp.adsp_seen && differs && now - hp.changed_at >= ud_abs_ms((uint64_t)ud_phyfix_ms))) {
+		return;
+	}
+	const char *no = hp_init_blocked();
+	if (no != NULL) {
+		if (hp.differs && hp.change_lines < 400) {
+			hp.change_lines += 50;          /* rate limit: this line at most ~8 times */
+			printf("NEGRONI USB: PHY repair waits: %s\n", no);
+		}
+		hp.last_repair = now;           /* look again in 3 s */
+		return;
+	}
+	if (force) {
+		hp.forced_for = up;
+	}
+	hp.last_repair = now;
+	hp.reinit_next = true;
+	uint32_t dsts = dwc_rd(DSTS);
+	ud_soft_reconnect(force ? "PHY re-init 3 s after ADSP up (negroniusb_phyfix=2)" :
+	    "the PHY differs from the reference (ADSP charger firmware?)", dsts,
+	    ud.sof_seen ? (now - ud.sof_seen) * 1000 / ud_abs_ms(1000) : 0);
+	ud.dev_event_at = 0;
+	ud.last_soffn = DSTS_SOFFN(dwc_rd(DSTS));
+	ud.sof_moved = false;                   /* 0375 */
+	ud.sof_seen = mach_absolute_time();     /* the no-SOF rule counts from here */
+	ud.next_watch = ud.sof_seen + ud_abs_ms(100);
+	hp.last_repair = mach_absolute_time();
+}
+
+/*
+ * ---- 0381: the data path after a re-enumeration (negroniusb_datafix, README-usb.md "0381") ----
+ *
+ * t22 (logs/usblog-20261026-233816.txt, logs/bootlog-12.txt): after the charger PD's Type-C restart
+ * the Mac enumerated the gadget again (05:05:25, again at 05:10:02 after a host re-enumeration), so
+ * ud_thread and ep0 worked, but no frame moved in either direction (no log, no ARP, no ctl answer)
+ * for 7 h, and no USB line reached the boot log. The boot log ring had lost that time. These
+ * functions find that state (configured, data alt 1, SOFs move, but no host frame since the link up
+ * or one IN transfer hangs), print what the next test needs to tell the causes apart (speed, the
+ * endpoints, the TRBs, the PHY against the gadget start, ue0 and its address), and with bit 1 set
+ * the whole data path up again.
+ */
+static struct {
+	uint64_t    next;           /* next check (100 ms) */
+	uint64_t    last_line;      /* last state line (re-inits used up / watch only: every 300 s) */
+	uint32_t    tries;          /* re-inits in this episode (an episode ends when host frames come) */
+	uint32_t    lines;          /* periodic state lines in this episode (at most 24) */
+	bool        logged;         /* the first state line of this episode is out */
+} df;
+
+static uint64_t
+ud_df_ms(uint64_t t, uint64_t now)
+{
+	return t == 0 || now < t ? 0 : (now - t) * 1000 / ud_abs_ms(1000);
+}
+
+static const char *
+ud_speed_name(uint32_t s)
+{
+	switch (s) {
+	case 0: return "high";
+	case 1: return "full";
+	case 2: return "low";
+	case 3: return "full 48 MHz";
+	case 4: return "super";
+	default: return "?";
+	}
+}
+
+/* Two lines: the counters of the data path, then the controller, TRB, PHY and ue0 state. */
+static void
+ud_data_state(const char *head, const char *why)
+{
+	uint64_t now = mach_absolute_time();
+	bool busy = __atomic_load_n(&ud.tx_busy, __ATOMIC_ACQUIRE);
+
+	printf("NEGRONI USB: %s: %s; speed %u (%s), %sconfigured, data alt %u, link up %llu ms ago, OUT frames %llu (last %llu ms "
+	    "ago, ARP for 192.168.7.2 %llu), IN %s %llu ms, last IN done %llu ms ago, txq %u, tx drops %llu, rx %llu tx %llu frames\n",
+	    head, why, ud.speed, ud_speed_name(ud.speed), ud.configured ? "" : "not ", ud.data_alt, ud_df_ms(ud.alt1_at, now),
+	    ud.out_frames, ud_df_ms(ud.out_at, now), ud.arp_req, busy ? "active" : "idle", busy ? ud_df_ms(ud.tx_start_at, now) : 0,
+	    ud_df_ms(ud.tx_done_at, now), ud.txq_count, ud.tx_drops, ud.rx_frames, ud.tx_frames);
+
+	uint32_t dsts = dwc_rd(DSTS);
+	ud_sync(UD_TXB_TRBS, 16);
+	uint32_t trb0 = *(volatile uint32_t *)(ud.dma + UD_TXB_TRBS + 12);
+	unsigned armed = 0;
+	ud_sync(UD_RING_TRBS, 16 * UD_RXN);
+	for (unsigned i = 0; i < UD_RXN; i++) {
+		if (*(volatile uint32_t *)(ud.dma + UD_RING_TRBS + 16 * i + 12) & TRB_HWO) {
+			armed++;
+		}
+	}
+	uint32_t v[HP_SLOTS];
+	bool phy_same = true;
+	if (hp.ok) {
+		hp_snap(v);
+		phy_same = hp_same(v, hp.base);
+	} else {
+		bzero(v, sizeof(v));
+	}
+	/* ifnet_flags() only reads if_flags (no lock); the address list is read by ud_df_stack (review: not in ud_thread) */
+	printf("NEGRONI USB: %s state: DSTS 0x%08x link %u (%s), SOF %llu ms ago, DCFG 0x%08x DCTL 0x%08x DALEPENA 0x%08x GCTL 0x%08x "
+	    "GUSB2PHYCFG 0x%08x QSCRATCH HS 0x%08x, ep busy rx %d tx %d int %d, TX TRB0 ctl 0x%08x, RX ring %u of %u armed, "
+	    "PHY %s (clkref_en 0x%08x cfg0 %x utmi0 %x utmi1 %x), ue0 flags 0x%x, %llu soft reconnects\n",
+	    head, dsts, DSTS_LINK(dsts), ud_link_name(DSTS_LINK(dsts)), ud_df_ms(ud.sof_seen, now), dwc_rd(DCFG), dwc_rd(DCTL),
+	    dwc_rd(DALEPENA), dwc_rd(GCTL), dwc_rd(GUSB2PHYCFG), ud.qs ? usb_rd(ud.qs, QSCRATCH_HS_PHY_CTRL) : 0,
+	    ud.ep_busy[EP_RX], ud.ep_busy[EP_TX], ud.ep_busy[EP_INT], trb0, armed, UD_RXN,
+	    !hp.ok ? "not watched" : phy_same ? "as at the gadget start" : "DIFFERS from the gadget start",
+	    v[HP_CLKREF], v[12], v[0], v[1], ud.ifp ? (unsigned)ifnet_flags(ud.ifp) : 0u, ud.reconnects);
+	if (hp.ok && !phy_same) {
+		hp_dump("now (0381)", v);
+	}
+}
+
+/*
+ * Review of 0381: the network stack part (the ue0 address list, ifnet_set_flags, SIOCAIFADDR) runs
+ * in this thread call, never in ud_thread. ud_thread serves ep0 and the command server ("reboot"
+ * must work while the stack hangs, cause (c)), so it must not wait for a stack lock. p1: 1 = report
+ * the address only (state lines), 2 = re-init (ue0 IFF_UP|IFF_RUNNING, the address again if gone).
+ */
+static thread_call_t ud_df_call;
+
+static void
+ud_df_stack(thread_call_param_t p0 __unused, thread_call_param_t p1)
+{
+	bool fix = (uintptr_t)p1 == 2;
+	int has = ud_if_has_addr();
+	errno_t err = 0;
+
+	if (fix && ud.ifp != NULL) {
+		ifnet_set_flags(ud.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+		if (has == 0) {
+			err = ud_if_addr_add();
+		}
+	}
+	printf("NEGRONI USB: data path %s: ue0 flags 0x%x, 192.168.7.2 %s\n", fix ? "re-init, stack part" : "state, stack part",
+	    ud.ifp ? (unsigned)ifnet_flags(ud.ifp) : 0u,
+	    has > 0 ? "on ue0" : has < 0 ? "unknown (address list failed)" : !fix ? "GONE from ue0" :
+	    err ? "was GONE, add FAILED" : "was GONE, added again");
+	if (err != 0) {
+		printf("NEGRONI USB: data path re-init: SIOCAIFADDR 192.168.7.2 on ue0 failed: %d\n", err);
+	}
+}
+
+static void
+ud_df_stack_enter(uintptr_t what)
+{
+	if (ud_df_call != NULL) {
+		(void)thread_call_enter1(ud_df_call, (thread_call_param_t)what);    /* a pending call takes the new p1 */
+	}
+}
+
+/* TX queue empty (the frames of the dead link are old). */
+static unsigned
+ud_txq_flush(void)
+{
+	unsigned n = 0;
+	uint32_t was = ud.where;
+
+	ud.where = UD_AT_DROPLOCK;
+	lck_mtx_lock(ud.lock);
+	ud.where = was;
+	while (ud.txq_count > 0) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		mbuf_freem(m);
+		n++;
+	}
+	lck_mtx_unlock(ud.lock);
+	return n;
+}
+
+/*
+ * The whole data path again: soft reconnect with a PHY init (0368 hp_init, one past the 5 per ADSP
+ * start; the EUD, hold-off and VOOC rules stay), TX queue dropped, ue0 IFF_UP|IFF_RUNNING, the
+ * address again if it is gone, a new log socket. The host sees a detach + attach and enumerates
+ * again; SET_CONFIGURATION starts the endpoints and the RX ring as at boot.
+ */
+static void
+ud_data_reinit(void)
+{
+	uint64_t now = mach_absolute_time();
+	uint32_t repairs = hp.repairs;
+
+	if (hp.ok && ud_phyfix >= 1) {  /* review: negroniusb_phyfix=0 means no PHY writes (and no stale reinit_next) */
+		hp.reinit_next = true;
+		hp.cap_bypass = true;
+	}
+	ud_soft_reconnect("data path dead (negroniusb_datafix)", dwc_rd(DSTS), ud_df_ms(ud.sof_seen, now));
+	hp.cap_bypass = false;
+	/* as hp_watch after its reconnect: the 0366/0371 rules count from here */
+	ud.dev_event_at = 0;
+	ud.last_soffn = DSTS_SOFFN(dwc_rd(DSTS));
+	ud.sof_moved = false;
+	ud.sof_seen = mach_absolute_time();
+	ud.next_watch = ud.sof_seen + ud_abs_ms(100);
+	ud.alt1_at = 0;
+	unsigned flushed = ud_txq_flush();
+	ud_df_stack_enter(2);           /* ue0 up + the address: in the thread call (review: not in ud_thread) */
+	ud_log_resock = true;
+	printf("NEGRONI USB: data path re-init done: PHY init %s, %u queued frames dropped, ue0 + 192.168.7.2 in a thread call, "
+	    "new log socket; the host enumerates again\n",
+	    hp.repairs != repairs ? "done" : ud_phyfix < 1 ? "off (negroniusb_phyfix=0)" : "NOT done (see the reconnect lines)",
+	    flushed);
+}
+
+/* Every 100 ms from ud_thread. */
+static void
+ud_data_watch(void)
+{
+	char why[112];
+
+	if (!(ud_datafix & (UD_DF_REINIT | UD_DF_WATCH)) || ud_in_panic) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (now < df.next) {
+		return;
+	}
+	df.next = now + ud_abs_ms(100);
+	if (!ud.configured || ud.data_alt != 1 || ud.alt1_at == 0) {
+		return;                 /* no host link: 0366 (no SOF) and 0371 handle that */
+	}
+	uint64_t lim = ud_abs_ms((uint64_t)ud_datafix_s * 1000);
+	bool host = ud.sof_seen != 0 && now - ud.sof_seen < ud_abs_ms(1000);   /* SOFFN moved in the last second */
+	bool got_out = ud.out_at >= ud.alt1_at;
+	bool busy = __atomic_load_n(&ud.tx_busy, __ATOMIC_ACQUIRE);
+	uint64_t tx_at = __atomic_load_n(&ud.tx_start_at, __ATOMIC_RELAXED);
+	why[0] = 0;
+	if (host && !got_out && now - ud.alt1_at >= lim) {
+		snprintf(why, sizeof(why), "no frame from the host %d s after its link up (SET_INTERFACE alt 1)", ud_datafix_s);
+	} else if (host && busy && tx_at != 0 && now > tx_at && now - tx_at >= lim) {
+		snprintf(why, sizeof(why), "IN transfer active %d s while the host sends SOFs", ud_datafix_s);
+	}
+	if (why[0] == 0) {
+		if (got_out && (df.tries != 0 || df.logged)) {
+			printf("NEGRONI USB: data path works: %llu OUT frames, host frames since the link up, after %u re-inits "
+			    "(negroniusb_datafix)\n", ud.out_frames, df.tries);
+			df.tries = 0;
+			df.lines = 0;
+			df.logged = false;
+		}
+		return;
+	}
+	if ((ud_datafix & UD_DF_WATCH) || df.tries >= UD_DF_TRIES) {
+		/* watch only, or the re-inits are used up: the state lines once, then every 300 s (at most 24) */
+		if (!df.logged || (now - df.last_line >= ud_abs_ms(300000) && df.lines < 24)) {
+			df.logged = true;
+			df.lines++;
+			df.last_line = now;
+			ud_data_state((ud_datafix & UD_DF_WATCH) ? "data path dead (watch only)" :
+			    "data path still dead (3 re-inits done; 0371/0375 decide)", why);
+			ud_df_stack_enter(1);
+		}
+		return;
+	}
+	df.tries++;
+	char head[64];
+	snprintf(head, sizeof(head), "data path dead (re-init %u of %u)", df.tries, UD_DF_TRIES);
+	ud_data_state(head, why);
+	ud_data_reinit();
+}
+
+static void
+ud_event(uint32_t ev)
+{
+	if (ev & 1) {                   /* device event */
+		uint32_t type = (ev >> 8) & 0xf;
+		ud.dev_event_at = mach_absolute_time();
+		if (type == 1) {        /* USB reset */
+			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+			ud_ep0_reset();         /* 0366 */
+			if (ud_reset_drop && ud.configured) {
+				/*
+				 * Patch 0282: a bus reset kills every endpoint but 0. Before, ud.configured stayed
+				 * true, so the host's next SET_CONFIGURATION(1) did nothing (ud_configure returned
+				 * early): the device enumerated again ("en10 up" 3 s after "gone") but no frame
+				 * ever moved (no RX TRB armed, tx_busy stuck). Drop the data state: the next
+				 * SET_CONFIGURATION sets the endpoints up again (DEPSTARTCFG 2 resets the
+				 * transfer resources, as Linux dwc3 does after a reset). 0366: ud_drop_data()
+				 * also ends the active transfers (ENDTRANSFER), as the databook asks.
+				 */
+				ud_drop_data();
+				printf("NEGRONI USB: bus reset: data endpoints dropped until SET_CONFIGURATION (#%u, DSTS 0x%08x)\n",
+				    ++ud.devevents[1], dwc_rd(DSTS));
+			} else {
+				/* negroniusb_resetdrop=0 with a configuration: the old path, nothing ended (ud_configure would not restart it) */
+				if (ud_reset_end && !ud.configured) {
+					ud_end_transfer(EP_INT);        /* not configured: no data transfer is active, at most a notification */
+				}
+				printf("NEGRONI USB: bus reset (#%u, DSTS 0x%08x)\n", ++ud.devevents[1], dwc_rd(DSTS));
+			}
+		} else if (type == 2) { /* connect done */
+			uint32_t speed = dwc_rd(DSTS) & 7;
+			ud.speed = speed;       /* 0381 */
+			/* ep0 max packet: 64 at high/full speed (modify action) */
+			ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (0u << 25), 0);
+			ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30),
+			    (1u << 8) | (1u << 10) | (1u << 25), 0);
+			printf("NEGRONI USB: connected, speed %u (#%u, DSTS 0x%08x)\n", speed, ++ud.devevents[2], dwc_rd(DSTS));
+			if (ud_datafix != 0 && speed != 0) {
+				printf("NEGRONI USB: the link is not high speed (speed %u, %s)%s\n", speed, ud_speed_name(speed),
+				    ud_bulk_mps() == 64 ? ": 64-byte bulk packets, full-speed descriptor (negroniusb_datafix bit 8)" :
+				    ": the bulk endpoints stay at 512 bytes (negroniusb_datafix bit 8 off)");
+			}
+		} else if (type == 0) {
+			/* 0366: Linux dwc3_gadget_disconnect_interrupt (only seen without the VBUS override) */
+			printf("NEGRONI USB: disconnect (#%u, DSTS 0x%08x link %u)\n", ++ud.devevents[0], dwc_rd(DSTS),
+			    DSTS_LINK(dwc_rd(DSTS)));
+			ud_ep0_reset();
+			if (ud_reset_end) {
+				ud_drop_data();
+			}
+		} else if (ud_devevent_note(type)) {
+			/* 0366: 3 link state change, 4 wakeup, 6 U3/L2 suspend, 9 erratic error, ...: logged only */
+			static const char *const names[16] = {
+				[3] = "link state change", [4] = "wakeup (resume)", [5] = "hibernation request",
+				[6] = "suspend (U3/L2)", [7] = "SOF", [8] = "L1 suspend", [9] = "erratic error",
+				[10] = "command complete", [11] = "event overflow", [12] = "vendor test LMP", [14] = "L1 wakeup",
+			};
+			uint32_t info = (ev >> 16) & 0xf, dsts = dwc_rd(DSTS);
+			printf("NEGRONI USB: device event %u %s (#%u), info %u (%s), DSTS 0x%08x link %u (%s), %sconfigured\n",
+			    type, names[type] ? names[type] : "?", ud.devevents[type], info, ud_link_name(info), dsts,
+			    DSTS_LINK(dsts), ud_link_name(DSTS_LINK(dsts)), ud.configured ? "" : "not ");
+		}
+		return;
+	}
+	unsigned ep = (ev >> 1) & 0x1f;
+	unsigned type = (ev >> 6) & 0xf;
+	unsigned status = (ev >> 12) & 0xf;
+
+	if (type == 1 && ep < 6 && ep != EP_TX && (ep != EP_RX || !ud_ring)) {
+		ud.ep_busy[ep] = false;         /* 0366: ep0, notification, one-TRB RX; EP_TX below under the lock */
+	}
+
+	if (ep == EP_RX) {
+		if (ud_ring) {
+			ud_rx_ring_poll();      /* 0361: the ring does not complete; ud_thread polls it too */
+		} else if (type == 1) {
+			ud_rx_done();
+		}
+		return;
+	}
+	if (ep == EP_TX && type == 1) {
+		if (ud_in_panic) {
+			ud.ep_busy[EP_TX] = false;
+			ud.tx_busy = false;     /* 0360: negroni_usb_panic_service() sends the next frame */
+			return;
+		}
+		uint32_t was = ud.where;
+		ud.where = UD_AT_TXLOCK;        /* 0375 */
+		lck_mtx_lock(ud.lock);
+		ud.where = was;
+		ud.ep_busy[EP_TX] = false;
+		ud.tx_busy = false;
+		ud.tx_done_at = mach_absolute_time();   /* 0375 */
+		ud_tx_kick_locked();
+		lck_mtx_unlock(ud.lock);
+		return;
+	}
+	if (ep > 1) {
+		return;
+	}
+	/*
+	 * Control transfer state machine (Linux dwc3 ep0.c): SETUP completes ->
+	 * request handled; the data stage (if any) is started right away; the
+	 * status stage is started when the controller reports XferNotReady
+	 * with status "control status"; its completion re-arms SETUP.
+	 */
+	if (type == 1) {                /* XferComplete */
+		switch (ud.state) {
+		case EP0_SETUP:
+			ud_sync(UD_SETUP, 8);
+			ud_setup();
+			break;
+		case EP0_DATA:
+			ud.state = EP0_WAIT_STATUS3;
+			break;
+		case EP0_STATUS:
+			ud_start_setup();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+	if (type == 3 && status == 2) { /* XferNotReady, control status phase */
+		if (ud.state == EP0_WAIT_STATUS2 || ud.state == EP0_WAIT_STATUS3) {
+			uint32_t ctl = ud.state == EP0_WAIT_STATUS3 ? TRBCTL_STATUS3 : TRBCTL_STATUS2;
+			ud.state = EP0_STATUS;
+			ud_start(ep, UD_DATA, 0, ctl);
+		}
+	}
+}
+
+/* 0382: ud_thread's long sleep, on its own event: ud_if_output wakes it, nothing else does. */
+static void
+ud_poll_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud.poll_chan, THREAD_UNINT, deadline);
+	/*
+	 * Review: a frame queued after ud_poll_period() (poll_long still false in ud_if_output, or its
+	 * wakeup before this assert_wait) would wait one long period for its completion: check again.
+	 * Only for a long sleep: the 1 ms sleep with a TX in flight must still sleep (no spin).
+	 */
+	if (ms > 1 && (__atomic_load_n(&ud.tx_busy, __ATOMIC_SEQ_CST) || __atomic_load_n(&ud.txq_count, __ATOMIC_SEQ_CST) != 0)) {
+		clear_wait(current_thread(), THREAD_AWAKENED);
+		return;
+	}
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* 0382: the next poll period in us (see ud_idle_ms). */
+static unsigned
+ud_poll_period(uint64_t now, uint64_t idle_after)
+{
+	bool fast_ok = ud_poll_us > 0 && ud_poll_us < 1000;
+
+	if (ud_idle_ms <= 1) {
+		/* the 0361 rule */
+		return fast_ok && now - ud.last_active < idle_after ? (unsigned)ud_poll_us : 1000;
+	}
+	bool txq = __atomic_load_n(&ud.tx_busy, __ATOMIC_ACQUIRE) || ud.txq_count != 0;
+	uint64_t rx_age = now - ud.last_rx;
+	if (fast_ok && ud.last_rx != 0 && (rx_age < idle_after || (txq && rx_age < ud_abs_ms(2000)))) {
+		return (unsigned)ud_poll_us;    /* the host sends (or acks a stream of ours) */
+	}
+	if (txq || now - ud.last_active < idle_after || (ud.last_rx != 0 && rx_age < ud_abs_ms(2000)) ||
+	    ud.ctl_action != UD_CTL_NONE) {
+		return 1000;
+	}
+	if (hp.ok) {
+		uint64_t st = hp.adsp_start_at, up = hp.adsp_up_at;
+		if (st != 0 && now < st + ud_abs_ms(30000) && (up == 0 || now < up + ud_abs_ms(10000))) {
+			return 1000;            /* 0368: the PHY watch samples every 10 ms in this window */
+		}
+	}
+	bool dark = __atomic_load_n(&negroni_display_asleep, __ATOMIC_ACQUIRE) != 0;
+	return (unsigned)(dark || !ud.configured ? ud_idle_off_ms : ud_idle_ms) * 1000u;
+}
+
+static void
+ud_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t next_report = 0, period, idle_after, now;
+	uint64_t rep_rx = 0, rep_tx = 0, rep_rxb = 0, rep_txb = 0;
+
+	nanoseconds_to_absolutetime(10 * NSEC_PER_SEC, &period);
+	nanoseconds_to_absolutetime(20 * NSEC_PER_MSEC, &idle_after);
+	for (;;) {
+		if (ud_in_panic) {              /* 0360: the panic CPU owns the controller now */
+			ud_sleep_ms(1000);
+			continue;
+		}
+		ud.beat = mach_absolute_time();         /* 0375 */
+		ud.where = UD_AT_EVENTS;
+		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+		if (count) {
+			ud_sync(UD_EVT, UD_EVT_SIZE);
+			for (uint32_t done = 0; done < count; done += 4) {
+				uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+				ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+				/*
+				 * 0360: ack each event before it is handled, so a panic
+				 * inside ud_event() leaves GEVNTCOUNT and evt_pos in step
+				 * for the panic mode event loop.
+				 */
+				dwc_wr(GEVNTCOUNT, 4);
+				if (ud.events++ < 200) {
+					printf("NEGRONI USB: event 0x%08x\n", ev);
+				}
+				ud.last_ev = ev;        /* 0375 */
+				if ((ev & 1) || ((ev >> 1) & 0x1f) != EP_TX) {
+					ud.last_rx = mach_absolute_time();      /* 0382: a host event, not our TX completion */
+				}
+				ud_event(ev);
+			}
+			ud.last_active = mach_absolute_time();
+		}
+		ud.where = UD_AT_RXPOLL;        /* 0375: the steps for the stall line */
+		ud_rx_ring_poll();
+		ud.where = UD_AT_CTLPOLL;
+		ud_ctl_poll();
+		ud.where = UD_AT_LINKWATCH;
+		ud_link_watch();                /* 0366 */
+		ud.where = UD_AT_DATAWATCH;
+		ud_data_watch();                /* 0381 */
+		ud.where = UD_AT_HPWATCH;
+		hp_watch();                     /* 0368 */
+		ud.where = UD_AT_SLEEP;
+		now = mach_absolute_time();
+		if (now >= next_report) {
+			/*
+			 * 0361: every 10 s with traffic (more than the live log's own ~10 frames/s):
+			 * frames and bytes per second of the gadget itself.
+			 */
+			if (next_report != 0 && (ud.rx_frames - rep_rx >= 100 || ud.tx_frames - rep_tx >= 500)) {
+				printf("NEGRONI USB: ue0 rx %llu tx %llu frames; last 10 s: rx %llu KiB/s %llu frames/s, "
+				    "tx %llu KiB/s %llu frames/s, tx drops %llu, rx max %u/poll, tx max %u/batch\n",
+				    ud.rx_frames, ud.tx_frames, (ud.rx_bytes - rep_rxb) / 10240, (ud.rx_frames - rep_rx) / 10,
+				    (ud.tx_bytes - rep_txb) / 10240, (ud.tx_frames - rep_tx) / 10, ud.tx_drops,
+				    ud.rx_max_poll, ud.tx_max_batch);
+			}
+			rep_rx = ud.rx_frames; rep_tx = ud.tx_frames; rep_rxb = ud.rx_bytes; rep_txb = ud.tx_bytes;
+			next_report = now + period;
+		}
+		/*
+		 * 0361: poll every negroniusb_pollus while frames move (20 ms after the last), else every 1 ms.
+		 * 0382: "move" = host frames or host events (our own TX completions alone no longer keep 200 us);
+		 * a TX in flight or queued, host data in the last 2 s, a recent event or the PHY watch window:
+		 * 1 ms; else the idle period (ud_poll_period). The old rule with negroniusb_idle_ms=1.
+		 */
+		unsigned us = ud_poll_period(now, idle_after);
+		__atomic_store_n(&ud.poll_long, us > 1000, __ATOMIC_SEQ_CST);
+		if (us < 1000) {
+			ud_sleep_us(us);
+		} else {
+			ud_poll_sleep_ms(us / 1000);
+		}
+		__atomic_store_n(&ud.poll_long, false, __ATOMIC_RELAXED);
+	}
+}
+
+/*
+ * 0375: data-path watchdog (boot-arg negroniusb_idle_reboot=S, default 0 =
+ * off). Its own kernel thread, so it runs when ud_thread, the network stack
+ * or the endpoint queues are stuck. Every 250 ms. Once the device was
+ * configured AND a host frame reached the bulk OUT path in this boot: when
+ * no OUT frame came for S s, or one IN transfer has been active for S s
+ * without XferComplete, it logs one line, sets reboot reason 0 and resets
+ * like the "reboot" command (0367 boot log end mark, PSCI SYSTEM_RESET).
+ * It does the reset itself (ud_ctl_poll runs in ud_thread, which may be the
+ * stuck part); a thread_call resets 5 s later if the end mark blocks (UFS
+ * lock). Once per boot. Never in panic mode. A pending USB command (reset,
+ * power off, panic) wins; only when it is still not run 5 s after its time
+ * (ud_thread stuck) the watchdog resets (the command's reason stays).
+ * It also logs when ud_thread has not started a loop pass for 5 s (step,
+ * last event) and keeps its own DSTS.SOFFN sample (SOF age in the line).
+ * Host side: something must reach the phone at least every S s; the
+ * usblog script sends a UDP broadcast every 10 s (USBLOG_KEEPALIVE).
+ */
+static int ud_idle_chan;
+static thread_call_t ud_idle_fallback;
+
+static void
+ud_idle_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud_idle_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+ud_idle_fallback_reset(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
+{
+	if (ud_in_panic) {
+		return;
+	}
+	printf("NEGRONI USB: idle reboot: the end mark did not finish in 5 s: PSCI SYSTEM_RESET now\n");
+	negroni_reboot_reset();
+}
+
+static uint64_t
+ud_ms_since(uint64_t t, uint64_t now)
+{
+	return t == 0 || now < t ? 0 : (now - t) * 1000 / ud_abs_ms(1000);
+}
+
+static void
+ud_idle_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t limit = ud_abs_ms((uint64_t)ud_idle_reboot_s * 1000), stall = ud_abs_ms(5000);
+	uint64_t sof_at = 0;
+	uint32_t last_sof = 0, stalls = 0;
+	bool stall_open = false, wait_logged = false;
+
+	for (;;) {
+		ud_idle_sleep_ms(250);
+		if (ud_in_panic) {
+			continue;               /* the panic hold loop owns the controller and has its own timed reset */
+		}
+		uint64_t now = mach_absolute_time();
+		uint32_t dsts = dwc_rd(DSTS), sof = DSTS_SOFFN(dsts);
+		if (sof_at == 0 || sof != last_sof) {
+			last_sof = sof;
+			sof_at = now;
+		}
+		uint64_t beat = ud.beat;
+		uint32_t at = ud.where;
+		if (beat != 0 && now > beat && now - beat >= stall) {
+			if (!stall_open && stalls < 8) {
+				stalls++;
+				printf("NEGRONI USB: ud_thread has not run for %llu ms: in step %s, last event 0x%08x, "
+				    "DSTS 0x%08x link %u (%s), SOF %llu ms ago (0375 watch)\n", ud_ms_since(beat, now),
+				    at < UD_AT_N ? ud_at_names[at] : "?", ud.last_ev, dsts, DSTS_LINK(dsts),
+				    ud_link_name(DSTS_LINK(dsts)), ud_ms_since(sof_at, now));
+			}
+			stall_open = true;
+		} else if (stall_open && now - beat < stall) {
+			stall_open = false;
+			printf("NEGRONI USB: ud_thread runs again (0375 watch)\n");
+		}
+		if (!ud.ever_configured || ud.out_at == 0) {
+			continue;               /* no host data in this boot yet: a boot with no cable never reboots */
+		}
+		/* tx_busy first: ud_tx_kick_locked stores tx_start_at before it (release), so a busy flag never pairs with an older start */
+		bool busy = __atomic_load_n(&ud.tx_busy, __ATOMIC_ACQUIRE);
+		uint64_t out_at = ud.out_at, tx_at = __atomic_load_n(&ud.tx_start_at, __ATOMIC_RELAXED);
+		bool out_idle = now > out_at && now - out_at >= limit;
+		bool tx_stuck = busy && tx_at != 0 && now > tx_at && now - tx_at >= limit;
+		if (!out_idle && !tx_stuck) {
+			wait_logged = false;
+			continue;
+		}
+		int action = __atomic_load_n(&ud.ctl_action, __ATOMIC_ACQUIRE);   /* then ctl_deadline: ud_ctl_schedule stores it first */
+		bool takeover = false;
+		if (action == UD_CTL_WATCHDOG) {
+			continue;
+		}
+		if (action != UD_CTL_NONE) {
+			if (now < ud.ctl_deadline + stall) {
+				if (!wait_logged) {
+					wait_logged = true;
+					printf("NEGRONI USB: idle reboot waits: a USB command is pending (%d)\n", action);
+				}
+				continue;       /* the pending command wins */
+			}
+			takeover = true;        /* still pending 5 s after its time: ud_thread does not run it */
+		}
+		if (!__atomic_compare_exchange_n(&ud.ctl_action, &action, UD_CTL_WATCHDOG, false,
+		    __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+			continue;               /* ud_ctl_poll took the command, or a command came in just now: it wins */
+		}
+		if (ud_idle_fallback != NULL) {
+			thread_call_enter_delayed(ud_idle_fallback, now + stall);
+		}
+		printf("NEGRONI USB: no USB data for %d s: rebooting (negroniusb_idle_reboot); %s; last OUT frame %llu ms "
+		    "ago (%llu OUT frames), IN transfer %s %llu ms, last IN done %llu ms ago, txq %u, tx drops %llu, "
+		    "rx %llu tx %llu frames; SOF %llu ms ago, DSTS 0x%08x link %u (%s), %sconfigured, %llu soft reconnects; "
+		    "ud_thread %llu ms ago in step %s, last event 0x%08x%s\n", ud_idle_reboot_s,
+		    out_idle && tx_stuck ? "no OUT frame and IN stuck" : out_idle ? "no OUT frame" : "IN transfer stuck",
+		    ud_ms_since(out_at, now), ud.out_frames, ud.tx_busy ? "active" : "idle", ud.tx_busy ? ud_ms_since(tx_at, now) : 0,
+		    ud_ms_since(ud.tx_done_at, now), ud.txq_count, ud.tx_drops, ud.rx_frames, ud.tx_frames,
+		    ud_ms_since(sof_at, now), dsts, DSTS_LINK(dsts), ud_link_name(DSTS_LINK(dsts)),
+		    ud.configured ? "" : "not ", ud.reconnects, ud_ms_since(beat, now), at < UD_AT_N ? ud_at_names[at] : "?",
+		    ud.last_ev, takeover ? "; a pending USB command was not run: reset now (its reason stays)" : "");
+		if (!takeover || action != UD_CTL_RESET) {
+			bool set = negroni_reboot_set_reason(0) == 0;
+			printf("NEGRONI USB: idle reboot: reason 0 %s\n", set ? "set" : "NOT set (plain reset)");
+			snprintf(ud_ctl_why, sizeof(ud_ctl_why), "reset (USB data idle %d s)", ud_idle_reboot_s);
+		}
+		ud_idle_sleep_ms(UD_CTL_DELAY_MS);      /* the live log may still carry the line */
+		if (ud_in_panic) {
+			continue;
+		}
+		negroni_bootlog_end(4, ud_ctl_why);     /* 0367 */
+		printf("NEGRONI USB: idle reboot: PSCI SYSTEM_RESET\n");
+		negroni_reboot_reset();         /* returns only if PSCI refused (logged there) */
+		__atomic_store_n(&ud.ctl_action, UD_CTL_NONE, __ATOMIC_SEQ_CST);  /* USB commands (poweroff, panic) work again */
+		return;
+	}
+}
+
+/*
+ * Live console log over USB Ethernet: every 100 ms the new bytes of the
+ * console ring (bsd/dev/negroni_ufs.c) go as UDP datagrams to
+ * 192.168.7.1:5140 (on the PC: nc -ukl 5140). Starts with the last 64 KiB
+ * so the boot is included. Nothing here may print (it would feed itself).
+ * Boot-arg negroniusblog=0 disables it.
+ */
+extern uint32_t negroni_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t negroni_log_position(void);
+
+static void
+ud_log_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char chunk[1400];
+	socket_t so = NULL;
+	struct sockaddr_in to;
+	uint64_t pos = negroni_log_position();
+	static const uint8_t host_ip[4] = { 192, 168, 7, 1 };
+
+	pos = pos > 65536 ? pos - 65536 : 0;
+	ud_log_sent = pos;
+	bzero(&to, sizeof(to));
+	to.sin_len = sizeof(to);
+	to.sin_family = AF_INET;
+	to.sin_port = htons(5140);
+	to.sin_addr.s_addr = htonl(0xc0a80701);         /* 192.168.7.1 */
+	for (;;) {
+		/* 0382: 100 ms; 250 ms with the display asleep; 1 s with no host configured */
+		ud_sleep_ms(!ud.configured ? 1000 : __atomic_load_n(&negroni_display_asleep, __ATOMIC_ACQUIRE) ? 250 : 100);
+		if (!ud.configured || ud_in_panic) {
+			continue;
+		}
+		if (ud_log_rewind) {            /* 0360: "log" command */
+			ud_log_rewind = false;
+			uint64_t end = negroni_log_position();
+			pos = end > 65536 ? end - 65536 : 0;
+		}
+		if (ud_log_resock) {            /* 0381: data path re-init: no cached route or ARP state of the old link */
+			ud_log_resock = false;
+			if (so != NULL) {
+				sock_close(so);
+				so = NULL;
+			}
+		}
+		bool raw = (ud_datafix & UD_DF_RAW) != 0;      /* 0381: raw frames only (no socket, route or ARP) */
+		if (!raw && so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+			so = NULL;
+			continue;
+		}
+		uint32_t n;
+		while ((n = negroni_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+			struct iovec iov = { .iov_base = chunk, .iov_len = n };
+			struct msghdr msg = {
+				.msg_name = &to, .msg_namelen = sizeof(to),
+				.msg_iov = &iov, .msg_iovlen = 1,
+			};
+			size_t sent = 0;
+			if (raw || sock_send(so, &msg, 0, &sent) != 0) {
+				/*
+				 * No route, or ue0 down (if_down_all() in the
+				 * shutdown path): the same datagram as a raw frame
+				 * to the host MAC (ECM iMACAddress), so the last
+				 * lines before a power off or restart still arrive.
+				 */
+				for (int w = 0; w < 20 && ud.txq_count >= UD_TXQ / 2; w++) {
+					ud_sleep_ms(1);
+				}
+				if (!ud_udp_send(ud_host_mac, host_ip, 5140, 5140, chunk, n)) {
+					break;
+				}
+			}
+			ud_log_sent = pos;      /* 0360: the panic flush starts here */
+		}
+	}
+}
+
+/*
+ * ---- panic mode (patch 0360, README-panic.md) ----
+ *
+ * negroni_panic_restart() (negroni_reboot.c) holds a panic on the panic
+ * screen. It calls negroni_usb_panic_begin() once and then
+ * negroni_usb_panic_service() in a busy loop. Each call:
+ *   - handles the DWC3 events (polled; ep0 enumeration works, so a host that
+ *     connects after the panic still gets the link),
+ *   - answers ARP for 192.168.7.2 (the stack is dead; the host must still
+ *     resolve the phone's MAC to send a command),
+ *   - takes commands on UDP 5141 (ping, log, reboot, bootloader, recovery,
+ *     poweroff) and returns the requested action to the caller,
+ *   - sends one frame when the IN endpoint is free, in this order: the
+ *     command replies, the log frames that were still on the TX ring
+ *     (copied; mbufs are not freed), then the console ring (panic text,
+ *     register dump, backtrace) from where ud_log_thread stopped, as
+ *     UDP 192.168.7.2:5140 -> 192.168.7.1:5140 like the live log.
+ * Nothing waits for the host: a frame that the host does not take in 2 s is
+ * ended (ENDTRANSFER) and sent again, so no text is lost while the cable or
+ * the host is away. Boot-arg negronipanicusb=0 disables all of this.
+ */
+#define UD_PANIC_REPLIES        4
+#define UD_PANIC_RING_MAX       (1u << 20)      /* at most the last 1 MiB of console text */
+#define UD_PANIC_CHUNK          1400
+#define NEGRONI_PANIC_ACT_POWEROFF 0x100        /* also in negroni_reboot.c */
+
+bool negroni_usb_panic_begin(void);
+int negroni_usb_panic_service(bool busy);
+
+enum { UD_PREPLY_UDP = 1, UD_PREPLY_ARP = 2 };
+static struct {
+	uint8_t     kind;
+	uint8_t     mac[ETHER_ADDR_LEN];
+	uint8_t     ip[4];
+	uint16_t    port;
+	char        text[64];
+} ud_preply[UD_PANIC_REPLIES];
+static unsigned ud_preply_head, ud_preply_count;
+static bool     ud_panic_ok, ud_panic_busy;
+static int      ud_panic_action = -1;
+static uint64_t ud_panic_pos;           /* next console ring byte to send */
+static uint64_t ud_panic_tx_at;         /* start time of the frame on the IN endpoint */
+static uint64_t ud_panic_tx_timeout;    /* 2 s in absolute time units */
+static uint32_t ud_panic_tx_len;        /* its length (sent again after a timeout) */
+static uint32_t ud_panic_tx_rsc;        /* its transfer resource index (for ENDTRANSFER) */
+static unsigned ud_panic_txq_left;      /* frames of ud.txq not looked at yet */
+static uint32_t ud_panic_timeouts;
+static bool     ud_panic_host_seen;     /* a frame from 192.168.7.1 came since the last configuration */
+static bool     ud_panic_was_configured;
+static uint64_t ud_panic_conf_at;       /* time of that configuration */
+static uint64_t ud_panic_host_wait;     /* 10 s: then the ring is sent without a sign of the host */
+static uint64_t ud_panic_gap, ud_panic_last;    /* log frames at most one per 1 ms (1.4 MB/s) */
+static const uint8_t ud_host_ip[4] = { 192, 168, 7, 1 };
+
+static void
+ud_panic_queue(int kind, const uint8_t *mac, const uint8_t *ip, uint16_t port, const char *text)
+{
+	if (ud_preply_count == UD_PANIC_REPLIES) {
+		return;                         /* full: the host asks again */
+	}
+	unsigned i = (ud_preply_head + ud_preply_count) % UD_PANIC_REPLIES;
+	ud_preply[i].kind = (uint8_t)kind;
+	memcpy(ud_preply[i].mac, mac, ETHER_ADDR_LEN);
+	memcpy(ud_preply[i].ip, ip, 4);
+	ud_preply[i].port = port;
+	strlcpy(ud_preply[i].text, text != NULL ? text : "", sizeof(ud_preply[i].text));
+	ud_preply_count++;
+}
+
+/* One received frame in panic mode: ARP for 192.168.7.2, or a command on UDP 5141. */
+static void
+ud_panic_rx(const uint8_t *f, uint32_t len)
+{
+	uint16_t type = ud_be16(f + 12);
+
+	/*
+	 * Any ARP or IPv4 frame from 192.168.7.1 shows that the host has its
+	 * address (usblog.sh sends "settime" when the link comes up): only then
+	 * the console ring is sent, so the panic text does not go out before
+	 * the host can receive it.
+	 */
+	if ((type == ETHERTYPE_ARP && len >= ETHER_HDR_LEN + 28 && ud_be32(f + ETHER_HDR_LEN + 14) == UD_IP_HOST) ||
+	    (type == ETHERTYPE_IP && len >= ETHER_HDR_LEN + 20 && ud_be32(f + ETHER_HDR_LEN + 12) == UD_IP_HOST)) {
+		ud_panic_host_seen = true;
+	}
+	if (type == ETHERTYPE_ARP) {
+		const uint8_t *a = f + ETHER_HDR_LEN;
+		if (len >= ETHER_HDR_LEN + 28 && ud_be16(a) == 1 && ud_be16(a + 2) == ETHERTYPE_IP &&
+		    a[4] == ETHER_ADDR_LEN && a[5] == 4 && ud_be16(a + 6) == 1 && ud_be32(a + 24) == UD_IP_PHONE) {
+			ud_panic_queue(UD_PREPLY_ARP, a + 8, a + 14, 0, NULL);  /* sender MAC and IP */
+		}
+		return;
+	}
+	if (!ud.ctl_enabled || type != ETHERTYPE_IP || len < ETHER_HDR_LEN + 20 + 8) {
+		return;
+	}
+	const uint8_t *ip = f + ETHER_HDR_LEN;
+	uint32_t ihl = (ip[0] & 0xfu) * 4, tot = ud_be16(ip + 2);
+	if ((ip[0] >> 4) != 4 || ihl < 20 || ip[9] != IPPROTO_UDP || tot < ihl + 8 ||
+	    ETHER_HDR_LEN + tot > len || (ud_be16(ip + 6) & 0x3fff) != 0) {
+		return;
+	}
+	const uint8_t *udp = ip + ihl;
+	uint32_t ulen = ud_be16(udp + 4);
+	if (ud_be32(ip + 16) != UD_IP_PHONE || ud_be16(udp + 2) != UD_CTL_PORT || ud_be32(ip + 12) != UD_IP_HOST ||
+	    ud_sum_fold(ud_sum_add(0, ip, ihl)) != 0 || ulen < 8 || ulen > tot - ihl) {
+		return;
+	}
+	char cmd[32];
+	uint32_t n = ulen - 8;
+	const uint8_t *p = udp + 8;
+	while (n > 0 && (p[n - 1] == '\n' || p[n - 1] == '\r' || p[n - 1] == ' ' ||
+	    p[n - 1] == '\t' || p[n - 1] == 0)) {
+		n--;
+	}
+	if (n >= sizeof(cmd)) {
+		n = sizeof(cmd) - 1;            /* too long: no command matches */
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		cmd[i] = (p[i] >= 0x20 && p[i] < 0x7f) ? (char)p[i] : '?';
+	}
+	cmd[n] = 0;
+
+	const char *reply;
+	char text[64];
+	int action = -1;
+	if (strcmp(cmd, "ping") == 0) {
+		reply = "pong (panic)";
+	} else if (strcmp(cmd, "log") == 0) {
+		uint64_t end = negroni_log_position();
+		ud_panic_pos = end > 65536 ? end - 65536 : 0;
+		reply = "ok log (panic)";
+	} else if (strcmp(cmd, "reboot") == 0 || strcmp(cmd, "recovery") == 0 ||
+	    strcmp(cmd, "bootloader") == 0 || strcmp(cmd, "poweroff") == 0) {
+		if (ud_panic_busy || ud_panic_action >= 0) {
+			reply = "error: busy";
+		} else {
+			action = cmd[0] == 'r' ? (cmd[2] == 'b' ? 0 : 1) :
+			    cmd[0] == 'b' ? 2 : NEGRONI_PANIC_ACT_POWEROFF;
+			snprintf(text, sizeof(text), "ok %s (panic)", cmd);
+			reply = text;
+		}
+	} else if (strcmp(cmd, "panic") == 0) {
+		reply = "error: already in panic";
+	} else {
+		reply = "error: panic mode: ping log reboot bootloader recovery poweroff";
+	}
+	printf("NEGRONI PANIC CTL: \"%s\" -> %s\n", cmd, reply);
+	ud_panic_queue(UD_PREPLY_UDP, f + ETHER_ADDR_LEN, ip + 12, ud_be16(udp), reply);
+	if (action >= 0) {
+		ud_panic_action = action;
+	}
+}
+
+/* The frame in the TX buffer (len bytes) goes out on the IN endpoint. */
+static void
+ud_panic_tx_start(uint32_t len)
+{
+	uint8_t *buf = (uint8_t *)(ud.dma + UD_TX);
+
+	if ((len % ud_bulk_mps()) == 0) {
+		buf[len++] = 0;                 /* as ud_tx_kick_locked: no zero-length packet needed */
+	}
+	ud_panic_tx_len = len;
+	ud.tx_busy = true;
+	ud.tx_batch = false;
+	ud.tx_frames++;
+	ud_panic_tx_at = mach_absolute_time();
+	ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, len, TRBCTL_NORMAL);
+	ud_panic_tx_rsc = (dwc_rd(DEPCMD(EP_TX)) >> 16) & 0x7f;
+}
+
+/* A log frame from before the panic (UDP to 5140, or a 5141 reply): worth sending. */
+static bool
+ud_panic_is_log_frame(const uint8_t *f, uint32_t len)
+{
+	const uint8_t *ip = f + ETHER_HDR_LEN;
+	if (len < ETHER_HDR_LEN + 20 + 8 || ud_be16(f + 12) != ETHERTYPE_IP || ip[9] != IPPROTO_UDP) {
+		return false;
+	}
+	uint32_t ihl = (ip[0] & 0xfu) * 4;
+	if (ihl < 20 || ETHER_HDR_LEN + ihl + 8 > len) {
+		return false;
+	}
+	const uint8_t *udp = ip + ihl;
+	return ud_be16(udp + 2) == 5140 || ud_be16(udp) == UD_CTL_PORT;
+}
+
+static void
+ud_panic_tx_next(void)
+{
+	uint8_t *f = (uint8_t *)(ud.dma + UD_TX);
+
+	if (ud_preply_count > 0) {
+		unsigned i = ud_preply_head;
+		ud_preply_head = (ud_preply_head + 1) % UD_PANIC_REPLIES;
+		ud_preply_count--;
+		if (ud_preply[i].kind == UD_PREPLY_ARP) {
+			/* ARP reply: 192.168.7.2 is at 02:00:5e:77:ee:02 */
+			bzero(f, ETHER_HDR_LEN + 28);
+			memcpy(f, ud_preply[i].mac, ETHER_ADDR_LEN);
+			memcpy(f + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+			ud_put16(f + 12, ETHERTYPE_ARP);
+			uint8_t *a = f + ETHER_HDR_LEN;
+			ud_put16(a, 1);
+			ud_put16(a + 2, ETHERTYPE_IP);
+			a[4] = ETHER_ADDR_LEN;
+			a[5] = 4;
+			ud_put16(a + 6, 2);
+			memcpy(a + 8, ud_phone_mac, ETHER_ADDR_LEN);
+			ud_put32(a + 14, UD_IP_PHONE);
+			memcpy(a + 18, ud_preply[i].mac, ETHER_ADDR_LEN);
+			memcpy(a + 24, ud_preply[i].ip, 4);
+			ud_panic_tx_start(ETHER_HDR_LEN + 28);
+		} else {
+			ud_panic_tx_start(ud_udp_build(f, ud_preply[i].mac, ud_preply[i].ip, UD_CTL_PORT,
+			    ud_preply[i].port, ud_preply[i].text, (uint32_t)strlen(ud_preply[i].text)));
+		}
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (!ud_panic_host_seen && now - ud_panic_conf_at < ud_panic_host_wait) {
+		return;                         /* the host may not have 192.168.7.1 yet */
+	}
+	if (now - ud_panic_last < ud_panic_gap) {
+		return;                         /* pace: the host's UDP receive buffer is not unlimited */
+	}
+	ud_panic_last = now;
+	while (ud_panic_txq_left > 0 && ud.txq_count > 0) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		ud_panic_txq_left--;
+		/* not freed: no allocator calls in panic context */
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN || mbuf_copydata(m, 0, len, f) != 0 ||
+		    !ud_panic_is_log_frame(f, (uint32_t)len)) {
+			continue;
+		}
+		ud_panic_tx_start((uint32_t)len);
+		return;
+	}
+	uint32_t n = negroni_log_copy(&ud_panic_pos, (char *)f + ETHER_HDR_LEN + 20 + 8, UD_PANIC_CHUNK);
+	if (n > 0) {
+		ud_panic_tx_start(ud_udp_build(f, ud_host_mac, ud_host_ip, 5140, 5140,
+		    f + ETHER_HDR_LEN + 20 + 8, n));
+	}
+}
+
+/* Once, from negroni_panic_restart(). false: no USB in this panic (not started, or negronipanicusb=0). */
+bool
+negroni_usb_panic_begin(void)
+{
+	if (ud_in_panic) {
+		return ud_panic_ok;
+	}
+	if (!ud_panic_enabled || !ud_running || ud.dwc == 0 || ud.dma == 0) {
+		return false;
+	}
+	ud_in_panic = true;
+	nanoseconds_to_absolutetime(2 * NSEC_PER_SEC, &ud_panic_tx_timeout);
+	nanoseconds_to_absolutetime(10 * NSEC_PER_SEC, &ud_panic_host_wait);
+	nanoseconds_to_absolutetime(NSEC_PER_MSEC, &ud_panic_gap);
+	/* the live log reached the host before the panic: no need to wait for it */
+	ud_panic_host_seen = ud.configured && ud.rx_frames > 0;
+	ud_panic_was_configured = ud.configured;
+	ud_panic_conf_at = mach_absolute_time();
+	uint64_t end = negroni_log_position(), from = ud_log_sent;
+	if (from > end || end - from > UD_PANIC_RING_MAX) {
+		from = end > UD_PANIC_RING_MAX ? end - UD_PANIC_RING_MAX : 0;
+	}
+	ud_panic_pos = from;
+	ud_panic_txq_left = ud.txq_count;
+	if (ud.tx_busy) {
+		/* a frame of the normal path is on the endpoint: give it the same 2 s */
+		volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
+		ud_sync(UD_TRB_TX, 16);
+		uint32_t len = t[2] & 0xffffff;
+		ud_panic_tx_len = (!ud.tx_batch && len > 0 && len < UD_FRAME_MAX) ? len : 0; /* 0361: a batch is not sent again */
+		ud_panic_tx_rsc = (dwc_rd(DEPCMD(EP_TX)) >> 16) & 0x7f;
+		ud_panic_tx_at = mach_absolute_time();
+	}
+	ud_panic_ok = true;
+	kdb_printf("NEGRONI PANIC: USB %s: console ring %llu bytes to send, %u frames queued; "
+	    "commands on udp 192.168.7.2:%u %s\n", ud.configured ? "configured" : "not configured (waiting for the host)",
+	    end - from, ud.txq_count, UD_CTL_PORT, ud.ctl_enabled ? "on" : "off");
+	return true;
+}
+
+/*
+ * One step of the panic loop. busy: the caller still has an action to run
+ * (new reset commands get "error: busy"). Returns -1, a reboot reason
+ * (0 normal, 1 recovery, 2 bootloader) or NEGRONI_PANIC_ACT_POWEROFF.
+ */
+int
+negroni_usb_panic_service(bool busy)
+{
+	if (!ud_panic_ok) {
+		return -1;
+	}
+	ud_panic_busy = busy;
+	uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+	if (count > UD_EVT_SIZE) {
+		count = UD_EVT_SIZE;
+	}
+	if (count) {
+		ud_sync(UD_EVT, UD_EVT_SIZE);
+		for (uint32_t done = 0; done + 4 <= count; done += 4) {
+			uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+			ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+			dwc_wr(GEVNTCOUNT, 4);
+			ud_event(ev);
+		}
+	}
+	ud_rx_ring_poll();                      /* 0361 */
+	ud_link_watch();                        /* 0366: replug during a panic */
+	if (ud.configured != ud_panic_was_configured) {
+		ud_panic_was_configured = ud.configured;
+		if (ud.configured) {            /* (re)enumerated in panic mode: wait for the host's address */
+			ud_panic_host_seen = false;
+			ud_panic_conf_at = mach_absolute_time();
+		}
+	}
+	if (ud.tx_busy && mach_absolute_time() - ud_panic_tx_at > ud_panic_tx_timeout) {
+		/* The host did not take the frame in 2 s: end the transfer and start it again. */
+		(void)ud_epcmd(EP_TX, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | (ud_panic_tx_rsc << 16), 0, 0, 0);
+		ud_udelay(1000);                /* 0366: 1 ms before the next STARTTRANSFER (Linux, DWC_usb31) */
+		ud.ep_busy[EP_TX] = false;      /* 0366 */
+		ud.tx_busy = false;
+		ud_panic_timeouts++;
+		if (ud.configured && ud_panic_tx_len > 0) {
+			uint32_t len = ud_panic_tx_len;
+			ud.tx_frames--;
+			ud_panic_tx_start(len);
+		}
+	}
+	if (ud.configured && !ud.tx_busy) {
+		ud_panic_tx_next();
+	}
+	int action = ud_panic_action;
+	ud_panic_action = -1;
+	return action;
+}
+
+static void
+negroni_usb_gadget_start(vm_offset_t dwc)
+{
+	thread_t thread;
+
+	ud.dwc = dwc;
+	if (kmem_alloc_contig(kernel_map, &ud.dma, UD_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("NEGRONI USB: no DMA memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)ud.dma);
+	if (!pn) {
+		return;
+	}
+	ud.dma_pa = ptoa_64(pn);
+	/* 0361: read before ud_if_create (the stack may send at once); ring 0 = the old one-TRB paths */
+	PE_parse_boot_argn("negroniusb_ring", &ud_ring, sizeof(ud_ring));
+	/* 0381: before ud_if_create and the log thread (both read it) */
+	PE_parse_boot_argn("negroniusb_datafix", &ud_datafix, sizeof(ud_datafix));
+	PE_parse_boot_argn("negroniusb_datafix_s", &ud_datafix_s, sizeof(ud_datafix_s));
+	if (ud_datafix_s < 3 || ud_datafix_s > 120) {
+		ud_datafix_s = 10;
+	}
+	if (ud_datafix != 0) {
+		printf("NEGRONI USB: data path (negroniusb_datafix=0x%x): %s%s%s, check after %d s (negroniusb_datafix_s)\n", ud_datafix,
+		    (ud_datafix & UD_DF_WATCH) ? "state lines only (watch)" : (ud_datafix & UD_DF_REINIT) ? "re-init when dead (3 per episode)" : "no watch",
+		    (ud_datafix & UD_DF_RAW) ? ", raw live log + kernel ARP answer" : "",
+		    (ud_datafix & UD_DF_FS) ? ", 64-byte bulk at full speed" : "", ud_datafix_s);
+		if (ud_datafix & (UD_DF_REINIT | UD_DF_WATCH)) {
+			ud_df_call = thread_call_allocate(ud_df_stack, NULL);  /* review: the stack part out of ud_thread */
+		}
+	}
+	printf("NEGRONI USB: RX ring %u TRBs, TX batch %u, queue %u (negroniusb_ring=%d)\n",
+	    ud_ring ? UD_RXN : 1, ud_ring ? UD_TXB : 1, UD_TXQ, ud_ring);
+	ud_if_create();
+
+	/* 0366: boot-args for the reconnect handling (README-usb.md) */
+	PE_parse_boot_argn("negroniusb_resetend", &ud_reset_end, sizeof(ud_reset_end));
+	PE_parse_boot_argn("negroniusb_reconnect", &ud_reconnect_s, sizeof(ud_reconnect_s));
+	PE_parse_boot_argn("negroniusb_events", &ud_more_events, sizeof(ud_more_events));
+	PE_parse_boot_argn("negroniusb_phycfg", &ud_phycfg, sizeof(ud_phycfg));
+	PE_parse_boot_argn("negroniusb_lost_reboot", &ud_lost_reboot_s, sizeof(ud_lost_reboot_s));
+	if (ud_lost_reboot_s > 0) {
+		printf("NEGRONI USB: reboot after %d s without host once configured (negroniusb_lost_reboot)\n", ud_lost_reboot_s);
+	}
+	PE_parse_boot_argn("negroniusb_idle_reboot", &ud_idle_reboot_s, sizeof(ud_idle_reboot_s));
+	ud.qs = ml_io_map(QSCRATCH_PA, 0x100);
+	hp_setup();                     /* 0368: PHY baseline before our controller start */
+	if (!ud_hw_start(true)) {
+		return;
+	}
+	printf("NEGRONI USB: reconnect handling: ENDTRANSFER on reset %s, soft reconnect after %d s without SOF%s, "
+	    "DEVTEN 0x%08x (negroniusb_resetend/_reconnect/_events/_phycfg)\n", ud_reset_end ? "on" : "off",
+	    ud_reconnect_s, ud_reconnect_s > 0 ? "" : " (off)", dwc_rd(DEVTEN));
+	int ctl = 1;
+	PE_parse_boot_argn("negronictl", &ctl, sizeof(ctl));
+	PE_parse_boot_argn("negroniusb_resetdrop", &ud_reset_drop, sizeof(ud_reset_drop));
+	PE_parse_boot_argn("negroniusb_pollus", &ud_poll_us, sizeof(ud_poll_us));
+	PE_parse_boot_argn("negroniusb_idle_ms", &ud_idle_ms, sizeof(ud_idle_ms));
+	PE_parse_boot_argn("negroniusb_idle_off_ms", &ud_idle_off_ms, sizeof(ud_idle_off_ms));
+	if (ud_idle_ms > 100) {
+		ud_idle_ms = 100;
+	}
+	if (ud_idle_off_ms < ud_idle_ms) {
+		ud_idle_off_ms = ud_idle_ms;
+	} else if (ud_idle_off_ms > 100) {
+		ud_idle_off_ms = 100;
+	}
+	printf("NEGRONI USB: 0382 idle poll %d ms, %d ms dark or no host (1 ms with host data in the last 2 s; "
+	    "negroniusb_idle_ms/_idle_off_ms)\n", ud_idle_ms <= 1 ? 1 : ud_idle_ms, ud_idle_ms <= 1 ? 1 : ud_idle_off_ms);
+	ud.ctl_enabled = ctl != 0 && ud.ifp != NULL;
+	PE_parse_boot_argn("negronipanicusb", &ud_panic_enabled, sizeof(ud_panic_enabled));
+	ud_running = true;              /* 0360: event buffer and ep0 are set up */
+	printf("NEGRONI CTL: commands on udp 192.168.7.2:%u %s (boot-arg negronictl)\n", UD_CTL_PORT,
+	    ud.ctl_enabled ? "on" : "off");
+	if (kernel_thread_start(ud_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	if (ud_idle_reboot_s > 0) {
+		/* 0375: the data-path watchdog, independent of ud_thread */
+		ud_idle_fallback = thread_call_allocate(ud_idle_fallback_reset, NULL);
+		bool started = kernel_thread_start(ud_idle_thread, NULL, &thread) == KERN_SUCCESS;
+		if (started) {
+			thread_deallocate(thread);
+		}
+		printf("NEGRONI USB: reboot after %d s without USB data once configured and host data came "
+		    "(negroniusb_idle_reboot)%s\n", ud_idle_reboot_s, started ? "" : ": thread NOT started");
+	}
+	int livelog = 1;
+	PE_parse_boot_argn("negroniusblog", &livelog, sizeof(livelog));
+	if (livelog && ud.ifp != NULL && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_weak_iokit.c b/bsd/dev/negroni_weak_iokit.c
new file mode 100644
index 0000000..732765a
--- /dev/null
+++ b/bsd/dev/negroni_weak_iokit.c
@@ -0,0 +1,44 @@
+/*
+ * iOS 26 port (xnu-12377): weak default definitions of the hooks that the bsd/dev negroni drivers call in the
+ * IOKit drivers (iokit/Kernel/arm/Negroni*.cpp: backlight/DSI, framebuffer/fingerprint overlay, HID, GPU, WLAN
+ * interface) and in osfmk/kern/exception.c (process sampler). Those files answer the iOS 16 user-client ABIs and
+ * are not ported yet; their strong definitions replace these when they are linked.
+ * Defaults: "not ready / no display / refused", so a driver that asks gets a clean no.
+ */
+#include <stdint.h>
+#include <stdbool.h>
+#include <mach/mach_types.h>
+
+#define NEGRONI_WEAK __attribute__((weak))
+
+/* NegroniBacklight.cpp (0250, 0259, 0268, 0275) */
+NEGRONI_WEAK bool negroni_backlight_display_on(void) { return false; }
+NEGRONI_WEAK bool negroni_backlight_display_off(uint32_t fade_ms __unused) { return false; }
+NEGRONI_WEAK bool negroni_backlight_panel_ready(bool *lp) { if (lp) { *lp = false; } return false; }
+NEGRONI_WEAK volatile uint32_t *negroni_dsi_base(void) { return NULL; }
+NEGRONI_WEAK volatile uint8_t *negroni_dsi_cmdbuf(uint64_t *pa) { if (pa) { *pa = 0; } return NULL; }
+NEGRONI_WEAK void negroni_dsi_cmdbuf_failed(void) {}
+NEGRONI_WEAK bool negroni_dsi_enter(void) { return false; }
+NEGRONI_WEAK void negroni_dsi_leave(void) {}
+NEGRONI_WEAK bool negroni_dsi_in_panic(void) { return false; }
+NEGRONI_WEAK void negroni_dsi_set_enter(void) {}
+NEGRONI_WEAK void negroni_dsi_set_leave(void) {}
+/* NegroniFramebuffer.cpp (0351-0354 fingerprint overlay, TE) */
+NEGRONI_WEAK int negroni_fb_te_wait(uint32_t frames __unused, uint32_t timeout_ms __unused) { return -1; }
+NEGRONI_WEAK int negroni_fp_hbm(bool on __unused) { return -1; }
+NEGRONI_WEAK void negroni_fp_ui_set(int v __unused) {}
+NEGRONI_WEAK void negroni_fp_capture_window(bool on __unused) {}
+NEGRONI_WEAK int negroni_fp_finger_down(void) { return 0; }
+NEGRONI_WEAK void negroni_fp_touch(int finger __unused, int down __unused, int x __unused, int y __unused) {}
+/* iokit/Kernel/arm/hid/NegroniHID.cpp (slop 0058, 0060) */
+NEGRONI_WEAK void negroni_hid_key(int key __unused, int down __unused) {}
+NEGRONI_WEAK void negroni_hid_touch(int finger __unused, int down __unused, int x __unused, int y __unused) {}
+/* NegroniGPU.cpp (0118, 0287) */
+NEGRONI_WEAK void NegroniGPUStart(void) {}
+NEGRONI_WEAK void NegroniGPUWatchFault(const char *why __unused, uint32_t completed __unused) {}
+/* NegroniWLAN.cpp (0340) */
+NEGRONI_WEAK bool negroni_wlan_ios_dt_entry(void) { return false; }
+NEGRONI_WEAK bool negroni_wlan_ios_adt_mac(uint8_t mac[6] __unused) { return false; }
+NEGRONI_WEAK void negroni_wlan_ios_publish(const char *ifname __unused, const uint8_t mac[6] __unused) {}
+/* osfmk/kern/exception.c (slop 0054 process sampler) */
+NEGRONI_WEAK void negroni_sample_task(const char *name __unused, int pid __unused, task_t task __unused) {}
diff --git a/bsd/dev/negroni_wifi.c b/bsd/dev/negroni_wifi.c
new file mode 100644
index 0000000..0073c08
--- /dev/null
+++ b/bsd/dev/negroni_wifi.c
@@ -0,0 +1,763 @@
+/*
+ * NEGRONI (SM8450) Wi-Fi: QCA6490 (ath11k "WCN6855 hw2.1") on PCIe0, brought
+ * up step by step like negroni_adreno.c (Linux ath11k/MHI as the reference;
+ * the chip sits on PCIe0). Steps 1-4 only read.
+ *
+ * Boot arg negroniwifi=N performs steps 1..N (default 0: nothing).
+ *   1  reads   GCC PCIe0: the GDSC and the branches (AUX, CFG AHB, MSTR/SLV AXI, PIPE)
+ *   2  reads   TLMM pins: WLAN_EN 80, BT_EN 81, SW_CTRL 82, PERST 94, WAKE 96, XO_CLK 204
+ *   3  reads   cmd-db (aop_cmd_db_mem 0x80860000, plain memory; no RSC access): the RPMh
+ *              addresses of the chip's rails (vendor DT qcom,cnss-qca6490:
+ *              aon smpe2 1.012 V, dig smpb11 0.966 V, io smpb10 1.8 V, rfa1 smpc1 1.9 V,
+ *              rfa2 smpb12 1.35 V)
+ *   4  reads   PCIe0 PARF (0x1c00000) and the PHY (0x1c06000), only if CFG AHB runs: what ABL left
+ *   5  writes  GCC: the PCIe0 GDSC on, the branch votes (0x62008 bits 0-5, 0x62000 bits 11 12 19 22),
+ *              CLKREF_EN, PHY_RCHNG at 100 MHz (GPLL0 / 6), the pipe mux on XO until the PHY runs
+ *   6  writes  TLMM: PERST (94) low, WLAN_EN (80) high, the chip given 50 ms after voting all five supplies at their board voltages
+ *   7  writes  the controller (Linux qcom_pcie_init_2_7_0) and the PHY (qmp_pcie_init/power_on, the
+ *              sm8450 gen3x1 tables), pipe mux to the PHY, waits for PHYSTATUS
+ *   8  writes  the root port (bridge class, bus 0 -> 1), iATU 0 bus 1 config at 0x60100000 (ECAM layout),
+ *              iATU 1 memory 0x60300000-0x63ffffff; PERST high, LTSSM on, waits for the link (DLLLA)
+ *   9  reads   bus 1 config space: the chip's vendor/device (17cb:1103), class, BAR0
+ *  10  reads   bus 1 command/status, BAR0 type and the PCI capability list (MSI / MSI-X present?);
+ *              no config-space writes. negroniwlan=1 runs 1..10 (same as negroniwifi=10)
+ *
+ * negroniwlan=N (N >= 2): steps 1..10, then, if step 10 passed, the driver on its own thread
+ * (bsd/dev/negroni_wlan.c, patches 0261 + 0263+). N is the driver level: 2 = BHI SBL download,
+ * 3 = MHI READY/M0/EE SBL, 4 = BHIe + mission mode + IPCR channels, higher = QRTR/QMI (see
+ * negroni_wlan_mhi.h WLAN_LEVEL_*).
+ *
+ * 0262: step 6 also muxes CLKREQ# (GPIO95), waits 100 ms if BT_EN is low and pulses XO_CLK (GPIO204)
+ * around WLAN_EN (cnss2); step 7 programs the DBI/iATU decode consistently (negroniwifi_dbi=0 vendor
+ * pci-msm recipe, default; =1 Linux pcie-qcom recipe) and stops if the DBI reads 0xffffffff; step 8
+ * asks Gen2 first (cnss2), checks LNKSTA DLLLA + ELBI XMLH_LINK_UP and retries the training
+ * (negroniwifi_tries, default 3).
+ *
+ * Addresses: sm8450.dtsi pcie@1c00000 / phy@1c06000, gcc-sm8450.c, the phone's DT.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+
+#include "negroni_wifi_phy.h"
+#include "negroni_wlan.h"
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* */
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/*
+ * 0290 (iOSPlus10): io_submap is 8 MiB for the whole kernel (osfmk/arm/io_map.c IO_MAP_SIZE,
+ * permanent entries, KMA_NOFAIL: a request that does not fit panics). The GCC (2 MiB) and TLMM (840 KiB) map uses
+ * ml_io_map_unmappable (kernel_map VA) with VM_WIMG_IO (osfmk/arm/memory_types.h, 0x7): the same
+ * Device memory type as ml_io_map, without the io_submap space. Table: docs/notes.md "io_submap".
+ */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+#define WIFI_WIMG_IO 0x7u
+void negroni_wifi_init(void);
+extern int negroni_rpmh_wifi_enable(const char *res, unsigned mv);
+extern uint32_t negroni_probe_wifi;
+
+/* corner badge, second line (NegroniFramebuffer) */
+char negroni_wifi_badge[24] = "";
+uint32_t negroni_wifi_badge_color = 0x00606060;
+
+#define GCC_PHYS                0x00100000UL
+#define GCC_SIZE                0x1f4200UL
+#define GCC_PCIE_0_GDSCR        0x7b004
+#define GCC_PCIE_0_SLV_AXI      0x7b020
+#define GCC_PCIE_0_MSTR_AXI     0x7b028
+#define GCC_PCIE_0_CFG_AHB      0x7b030
+#define GCC_PCIE_0_AUX          0x7b034
+#define GCC_PCIE_0_PIPE         0x7b03c
+#define CBCR_OFF                (1u << 31)
+#define GDSC_PWR_ON             (1u << 31)
+
+#define TLMM_PHYS               0x0f100000UL
+#define TLMM_PIN(n)             ((vm_offset_t)(n) * 0x1000)
+#define TLMM_SIZE               (TLMM_PIN(210))
+
+#define PARF_PHYS               0x01c00000UL
+#define PARF_SIZE               0x3000UL
+#define PARF_SYS_CTRL           0x00
+#define PARF_PHY_CTRL           0x40
+#define PARF_LTSSM              0x1b0
+#define PHY_PHYS                0x01c06000UL
+#define PHY_SIZE                0x2000UL
+#define PARF_PM_CTRL            0x20
+#define PARF_MHI_CLOCK_RESET_CTRL 0x174
+#define PARF_AXI_MSTR_WR_ADDR_HALT_V2 0x1a8
+#define PARF_DBI_BASE_ADDR_V2   0x350
+#define PARF_DBI_BASE_ADDR_V2_HI 0x354
+#define PARF_ATU_BASE_ADDR      0x634
+#define PARF_ATU_BASE_ADDR_HI   0x638
+#define PARF_DEVICE_TYPE        0x1000
+#define DBI_PHYS                0x60000000UL
+#define DBI_SIZE                0x2000UL
+#define ATU_OFFSET              0x1000UL        /* the iATU's unrolled registers, after the DBI (sm8450.dtsi "atu") */
+#define CFG_BUS1_PHYS           0x60100000UL
+#define MEM_BASE                0x60300000UL
+#define MEM_LIMIT               0x63ffffffUL
+#define GCC_PCIE_0_BCR          0x7b000
+#define GCC_PCIE_0_PHY_BCR      0x7c01c
+#define GCC_PCIE_0_NOCSR_COM_PHY_BCR 0x7c020
+#define GCC_PCIE_0_PIPE_MUX     0x7b060         /* 0: the PHY's pipe clock, 2: XO */
+#define GCC_PCIE_0_AUX_RCGR     0x7b064
+#define GCC_PCIE_0_RCHNG_RCGR   0x7b048
+#define GCC_PCIE_0_CLKREF_EN    0x9c004
+#define GCC_VOTE_0              0x62000
+#define GCC_VOTE_0_PCIE0        (1u << 11 | 1u << 12 | 1u << 19 | 1u << 22)
+#define GCC_VOTE_2              0x62008
+#define GCC_VOTE_2_PCIE0        0x3fu
+#define WLAN_EN_PIN             80
+#define PERST_PIN               94
+/*
+ * 0262 (iOSPlus10): the power-up and controller details the survey missed, from the phone's own
+ * kernel (OnePlus sm8450 e9da592: drivers/pci/controller/pci-msm.c, cnss2/power.c, cnss2/pci.c),
+ * the live DT (out/live.dts) and Linux (pcie-qcom.c, pinctrl-sm8450.c).
+ */
+#define BT_EN_PIN               81
+#define SW_CTRL_PIN             82
+#define CLKREQ_PIN              95              /* live.dts pcie0_clkreq_default: function pcie0_clkreqn, pull-up */
+#define CLKREQ_FUNC             1u              /* pinctrl-sm8450.c PINGROUP(95, pcie0_clkreqn, ...) */
+#define XO_CLK_PIN              204             /* live.dts qcom,cnss-qca6490 qcom,xo-clk-gpio (slop 0125: wcn6855-pmu xo-clk-gpios) */
+#define TLMM_EGPIO_PRESENT      (1u << 11)      /* pinctrl-sm8450.c egpio_present / egpio_enable */
+#define TLMM_EGPIO_ENABLE       (1u << 12)
+#define PARF_SLV_ADDR_SPACE_SIZE_V2     0x358
+#define PARF_SLV_ADDR_SPACE_SIZE_V2_HI  0x35c
+#define MSM_SLV_ADDR_SPACE      0x4000000u      /* waipio-pcie.dtsi pcie0 qcom,slv-addr-space-size */
+#define ELBI_SYS_STTS           0xf28           /* ELBI 0x60000f20 + 8 (pci-msm.c PCIE20_ELBI_SYS_STTS) */
+#define ELBI_XMLH_LINK_UP       (1u << 10)
+#define DBI_LNKCTL2             (0x70 + 0x30)   /* PCIe capability at 0x70 (the code above uses 0x70 + 0x14) */
+#define CHIP_ID                 0x110317cbu     /* 17cb:1103 */
+
+static uint32_t pause_ms = 300;
+static uint32_t step;
+static vm_offset_t gcc, tlmm, parf, phy, dbi, cfg_bus1;
+static bool powered, controller, linked;
+
+static uint32_t __attribute__((noinline))
+rd(vm_offset_t address)
+{
+	uint32_t value;
+
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (value) : "r" (address) : "memory");
+	return value;
+}
+
+static void
+wr(vm_offset_t address, uint32_t value)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (value), "r" (address) : "memory");
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+set(vm_offset_t address, uint32_t bits)
+{
+	wr(address, rd(address) | bits);
+}
+
+static void
+clear(vm_offset_t address, uint32_t bits)
+{
+	wr(address, rd(address) & ~bits);
+}
+
+static bool
+wait_for(vm_offset_t address, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	for (uint32_t i = 0; i < 10 * ms; i++) {
+		if ((rd(address) & mask) == want) {
+			return true;
+		}
+		delay(100);
+	}
+	return (rd(address) & mask) == want;
+}
+
+static void
+announce(const char *what)
+{
+	printf("NEGRONI WIFI: %u about to %s\n", step, what);
+	delay(pause_ms * 1000);
+}
+
+static bool
+step_gcc(void)
+{
+	static const struct { const char *name; uint32_t off; } r[] = {
+		{ "GCC_PCIE_0_AUX_CLK", GCC_PCIE_0_AUX }, { "GCC_PCIE_0_CFG_AHB_CLK", GCC_PCIE_0_CFG_AHB },
+		{ "GCC_PCIE_0_MSTR_AXI_CLK", GCC_PCIE_0_MSTR_AXI }, { "GCC_PCIE_0_SLV_AXI_CLK", GCC_PCIE_0_SLV_AXI },
+		{ "GCC_PCIE_0_PIPE_CLK", GCC_PCIE_0_PIPE },
+	};
+	uint32_t g;
+
+	announce("read the GCC PCIe0 GDSC and clocks");
+	g = rd(gcc + GCC_PCIE_0_GDSCR);
+	printf("NEGRONI WIFI: 1 PCIE_0_GDSC = %#x (%s)\n", g, (g & GDSC_PWR_ON) ? "powered" : "off");
+	for (unsigned i = 0; i < sizeof(r) / sizeof(r[0]); i++) {
+		uint32_t v = rd(gcc + r[i].off);
+		printf("NEGRONI WIFI: 1 %s = %#x (%s)\n", r[i].name, v, (v & CBCR_OFF) ? "off" : "running");
+	}
+	return true;
+}
+
+static bool
+step_pins(void)
+{
+	static const struct { const char *name; uint32_t pin; } p[] = {
+		{ "WLAN_EN", 80 }, { "BT_EN", 81 }, { "SW_CTRL", 82 }, { "PERST", 94 }, { "CLKREQ", 95 }, { "WAKE", 96 }, { "XO_CLK", 204 },
+	};
+
+	announce("read the Wi-Fi pins (TLMM)");
+	for (unsigned i = 0; i < sizeof(p) / sizeof(p[0]); i++) {
+		uint32_t cfg = rd(tlmm + TLMM_PIN(p[i].pin)), io = rd(tlmm + TLMM_PIN(p[i].pin) + 4);
+		printf("NEGRONI WIFI: 2 GPIO%u %s: cfg %#x (func %u, %s, drive %u mA, pull %u) in %u out %u\n",
+		    p[i].pin, p[i].name, cfg, (cfg >> 2) & 0xf, (cfg >> 9) & 1 ? "output" : "input",
+		    2 * (((cfg >> 6) & 7) + 1), cfg & 3, io & 1, (io >> 1) & 1);
+	}
+	return true;
+}
+
+/* cmd-db (Linux drivers/soc/qcom/cmd-db.c): header, 8 slave headers, then entries of 24 bytes. */
+#define CMD_DB_PHYS             0x80860000UL
+#define CMD_DB_SIZE             0x20000u
+#define CMD_DB_HEADER           (4 + 4 + 8 * 16 + 4 + 4)        /* version, magic, slaves, checksum, reserved */
+
+static vm_offset_t cmd_db;
+
+static uint32_t
+db32(uint32_t off)
+{
+	return off + 4 <= CMD_DB_SIZE ? rd(cmd_db + off) : 0;
+}
+
+static uint16_t
+db16(uint32_t off)
+{
+	return (uint16_t)(db32(off & ~3u) >> (8 * (off & 2)));
+}
+
+static int
+cmd_db_lookup(const char *name, uint32_t *address)
+{
+	uint32_t key[2] = { 0, 0 };
+
+	for (unsigned i = 0; i < 8 && name[i]; i++) {
+		key[i / 4] |= (uint32_t)(uint8_t)name[i] << (8 * (i % 4));
+	}
+	for (unsigned s = 0; s < 8; s++) {
+		uint32_t h = 8 + 16 * s;
+		uint32_t entries = CMD_DB_HEADER + db16(h + 2), count = db16(h + 6);
+		if (db16(h) == 0 || count > 1024 || entries + count * 24 > CMD_DB_SIZE) {
+			continue;
+		}
+		for (uint32_t j = 0; j < count; j++) {
+			uint32_t e = entries + 24 * j;
+			if (db32(e) == key[0] && db32(e + 4) == key[1]) {
+				*address = db32(e + 16);
+				return 0;
+			}
+		}
+	}
+	return ENOENT;
+}
+
+static bool
+step_rails(void)
+{
+	static const char *const rails[] = { "smpe2", "smpb11", "smpb10", "smpc1", "smpb12" };
+	unsigned found = 0;
+
+	announce("look the Wi-Fi rails up in cmd-db at 0x80860000 (read only)");
+	cmd_db = ml_io_map(CMD_DB_PHYS, CMD_DB_SIZE);
+	if (!cmd_db || db32(4) != 0x0c0330db) {
+		printf("NEGRONI WIFI: 3 stop: no cmd-db at %#lx (magic %#x)\n", CMD_DB_PHYS, cmd_db ? db32(4) : 0);
+		return false;
+	}
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
+		uint32_t address = 0;
+		int error = cmd_db_lookup(rails[i], &address);
+		printf("NEGRONI WIFI: 3 %s -> %s %#x\n", rails[i], error ? "error" : "address", error ? (uint32_t)error : address);
+		found += !error;
+	}
+	return found == sizeof(rails) / sizeof(rails[0]);
+}
+
+static bool
+step_pcie(void)
+{
+	if (rd(gcc + GCC_PCIE_0_CFG_AHB) & CBCR_OFF) {
+		printf("NEGRONI WIFI: 4 PCIe0 CFG AHB is off: its registers have no clock (bring-up writes it later)\n");
+		return true;
+	}
+	announce("read PCIe0 PARF and PHY as ABL left them");
+	if (!parf) {
+		parf = ml_io_map(PARF_PHYS, PARF_SIZE);
+	}
+	if (!phy) {
+		phy = ml_io_map(PHY_PHYS, PHY_SIZE);
+	}
+	printf("NEGRONI WIFI: 4 PARF SYS_CTRL %#x PHY_CTRL %#x LTSSM %#x\n", rd(parf + PARF_SYS_CTRL),
+	    rd(parf + PARF_PHY_CTRL), rd(parf + PARF_LTSSM));
+	printf("NEGRONI WIFI: 4 PARF DBI base %#x:%#x, slave space %#x:%#x, ATU base %#x:%#x\n",
+	    rd(parf + PARF_DBI_BASE_ADDR_V2_HI), rd(parf + PARF_DBI_BASE_ADDR_V2),
+	    rd(parf + PARF_SLV_ADDR_SPACE_SIZE_V2_HI), rd(parf + PARF_SLV_ADDR_SPACE_SIZE_V2),
+	    rd(parf + PARF_ATU_BASE_ADDR_HI), rd(parf + PARF_ATU_BASE_ADDR));
+	printf("NEGRONI WIFI: 4 PHY [0x0] %#x [0x214] %#x\n", rd(phy), rd(phy + 0x214));
+	return true;
+}
+
+static bool
+step_power(void)
+{
+	announce("switch on the PCIe0 GDSC and clocks (GCC writes)");
+	clear(gcc + GCC_PCIE_0_GDSCR, 1u);                     /* SW_COLLAPSE off */
+	if (!wait_for(gcc + GCC_PCIE_0_GDSCR, GDSC_PWR_ON, GDSC_PWR_ON, 10)) {
+		printf("NEGRONI WIFI: 5 stop: PCIE_0_GDSC does not come on (%#x)\n", rd(gcc + GCC_PCIE_0_GDSCR));
+		return false;
+	}
+	wr(gcc + GCC_PCIE_0_PIPE_MUX, 2);                       /* XO until the PHY makes the pipe clock */
+	wr(gcc + GCC_PCIE_0_RCHNG_RCGR + 4, 1u << 8 | (2 * 6 - 1));     /* GPLL0 main / 6 = 100 MHz */
+	set(gcc + GCC_PCIE_0_RCHNG_RCGR, 1u);
+	if (!wait_for(gcc + GCC_PCIE_0_RCHNG_RCGR, 1u, 0, 10)) {
+		printf("NEGRONI WIFI: 5 stop: RCHNG clock update timed out\n");
+		return false;
+	}
+	/* AUX uses XO / 1 = 19.2 MHz, not an unverified inherited RCG rate. */
+	wr(gcc + GCC_PCIE_0_AUX_RCGR + 4, 1u);
+	set(gcc + GCC_PCIE_0_AUX_RCGR, 1u);
+	if (!wait_for(gcc + GCC_PCIE_0_AUX_RCGR, 1u, 0, 10)) {
+		printf("NEGRONI WIFI: 5 stop: AUX clock update timed out\n");
+		return false;
+	}
+	set(gcc + GCC_VOTE_0, GCC_VOTE_0_PCIE0);
+	set(gcc + GCC_VOTE_2, GCC_VOTE_2_PCIE0 & ~(1u << 4));  /* the pipe clock after the PHY (step 7) */
+	set(gcc + GCC_PCIE_0_CLKREF_EN, 1u);
+	delay(100);
+	bool ok = !(rd(gcc + GCC_PCIE_0_CFG_AHB) & CBCR_OFF) && !(rd(gcc + GCC_PCIE_0_AUX) & CBCR_OFF);
+	printf("NEGRONI WIFI: 5 GDSC %#x, CFG AHB %#x, AUX %#x, MSTR %#x, SLV %#x, RCHNG cfg %#x: %s\n",
+	    rd(gcc + GCC_PCIE_0_GDSCR), rd(gcc + GCC_PCIE_0_CFG_AHB), rd(gcc + GCC_PCIE_0_AUX),
+	    rd(gcc + GCC_PCIE_0_MSTR_AXI), rd(gcc + GCC_PCIE_0_SLV_AXI), rd(gcc + GCC_PCIE_0_RCHNG_RCGR + 4),
+	    ok ? "running" : "NOT running");
+	powered = ok;
+	return ok;
+}
+
+static void
+tlmm_cfg(uint32_t pin, uint32_t cfg)
+{
+	/* an eGPIO pin (bit 11 present) belongs to the TLMM only with bit 12 set (Linux msm_pinmux_set_mux) */
+	if (rd(tlmm + TLMM_PIN(pin)) & TLMM_EGPIO_PRESENT) {
+		cfg |= TLMM_EGPIO_ENABLE;
+	}
+	wr(tlmm + TLMM_PIN(pin), cfg);
+}
+
+static void
+gpio_out(uint32_t pin, bool high)
+{
+	wr(tlmm + TLMM_PIN(pin) + 4, high ? 2u : 0);
+	tlmm_cfg(pin, 7u << 6 | 1u << 9);                      /* gpio function, 16 mA, no pull, output */
+}
+
+static uint32_t
+gpio_level(uint32_t pin, bool output)
+{
+	uint32_t io = rd(tlmm + TLMM_PIN(pin) + 4);
+	return output ? (io >> 1) & 1 : io & 1;
+}
+
+static bool
+step_chip_on(void)
+{
+	static const struct { const char *name; unsigned mv; } rails[] = {
+		{ "smpe2", 1012 }, { "smpb11", 966 }, { "smpb10", 1800 },
+		{ "smpc1", 1900 }, { "smpb12", 1350 },
+	};
+	announce("vote QCA6490 supplies before WLAN_EN (SM8450 apps DRV2)");
+	gpio_out(PERST_PIN, false);
+	gpio_out(WLAN_EN_PIN, false);
+	/* CLKREQ# to the PCIe0 controller (live.dts pcie0_clkreq_default: pcie0_clkreqn, 2 mA, pull-up) */
+	tlmm_cfg(CLKREQ_PIN, CLKREQ_FUNC << 2 | 3u);
+	printf("NEGRONI WIFI: 6 CLKREQ GPIO%u cfg %#x (function %u, pull-up), PERST low, WLAN_EN low\n", CLKREQ_PIN,
+	    rd(tlmm + TLMM_PIN(CLKREQ_PIN)), (rd(tlmm + TLMM_PIN(CLKREQ_PIN)) >> 2) & 0xf);
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); i++) {
+		int error = negroni_rpmh_wifi_enable(rails[i].name, rails[i].mv);
+		printf("NEGRONI WIFI: 6 %s %u mV: errno %d\n", rails[i].name, rails[i].mv, error);
+		if (error) {
+			printf("NEGRONI WIFI: 6 stop: WLAN remains in reset; no link attempt\n");
+			return false;
+		}
+	}
+	/* cnss2 power.c cnss_select_pinctrl_enable: with BT_EN off the QCA6490 PMU needs 100 ms before WLAN_EN */
+	if (!gpio_level(BT_EN_PIN, false)) {
+		printf("NEGRONI WIFI: 6 BT_EN is low: wait 100 ms before WLAN_EN (cnss2 PMU sequencing)\n");
+		delay(100000);
+	}
+	/*
+	 * cnss2 power.c cnss_select_pinctrl_state + cnss_set_xo_clk_gpio_state (QCA6490 only): XO_CLK high
+	 * 100-200 us before WLAN_EN, WLAN_EN high, 1 ms (WLAN_ENABLE_DELAY), XO_CLK held 2-5 ms more for a
+	 * valid latch, then XO_CLK low. (slop 0125 pulses the same pin: XO low 10 ms, high 200 us, WLAN_EN,
+	 * 10 ms, XO low; this is the cnss2 timing, with the XO pin driven low 10 ms first as 0125 does.)
+	 */
+	gpio_out(XO_CLK_PIN, false);
+	delay(10000);
+	gpio_out(XO_CLK_PIN, true);
+	delay(200);
+	gpio_out(WLAN_EN_PIN, true);
+	delay(1000);
+	delay(5000);
+	gpio_out(XO_CLK_PIN, false);
+	printf("NEGRONI WIFI: 6 XO_CLK GPIO%u pulsed around WLAN_EN (cfg %#x)\n", XO_CLK_PIN, rd(tlmm + TLMM_PIN(XO_CLK_PIN)));
+	delay(50000);
+	printf("NEGRONI WIFI: 6 WLAN_EN out %u, PERST out %u, XO_CLK out %u, SW_CTRL in %u, BT_EN in %u, CLKREQ in %u\n",
+	    gpio_level(WLAN_EN_PIN, true), gpio_level(PERST_PIN, true), gpio_level(XO_CLK_PIN, true),
+	    gpio_level(SW_CTRL_PIN, false), gpio_level(BT_EN_PIN, false), gpio_level(CLKREQ_PIN, false));
+	return true;
+}
+
+static void
+bcr_pulse(uint32_t off)
+{
+	wr(gcc + off, 1);
+	delay(1000);
+	wr(gcc + off, 0);
+	delay(1000);
+}
+
+static bool
+step_phy(void)
+{
+	uint32_t status;
+
+	if (!powered) {
+		printf("NEGRONI WIFI: 7 stop: no clocks (step 5)\n");
+		return false;
+	}
+	announce("set the controller up and start the PHY (PARF and PHY writes)");
+	if (!parf) {
+		parf = ml_io_map(PARF_PHYS, PARF_SIZE);
+	}
+	if (!phy) {
+		phy = ml_io_map(PHY_PHYS, PHY_SIZE);
+	}
+	bcr_pulse(GCC_PCIE_0_BCR);
+	wr(parf + PARF_DEVICE_TYPE, 4);                         /* root complex */
+	clear(parf + PARF_PHY_CTRL, 1u);                        /* PHY_TEST_PWR_DOWN */
+	/*
+	 * Where the DBI and the iATU sit in the controller's slave space. Two consistent recipes:
+	 * 0 (default) the phone's own kernel, pci-msm.c msm_pcie_enable: after the core reset,
+	 *   DBI base 0 (offset in the slave space), slave space 0x4000000, the ATU base left at its reset
+	 *   value (the vendor DT maps the iATU at 0x60001000).
+	 * 1 Linux pcie-qcom.c qcom_pcie_configure_dbi_atu_base (= slop 0125): DBI and ATU base = CPU
+	 *   physical addresses AND slave space 0x80000000_00000000.
+	 * Before 0262 the survey wrote the Linux addresses without the slave space size: the DBI was
+	 * not decoded and every DBI/config read gave 0xffffffff (photo 2026-10-25).
+	 */
+	uint32_t recipe = 0;
+	(void)PE_parse_boot_argn("negroniwifi_dbi", &recipe, sizeof(recipe));
+	if (recipe == 1) {
+		wr(parf + PARF_DBI_BASE_ADDR_V2, (uint32_t)DBI_PHYS);
+		wr(parf + PARF_DBI_BASE_ADDR_V2_HI, 0);
+		wr(parf + PARF_ATU_BASE_ADDR, (uint32_t)(DBI_PHYS + ATU_OFFSET));
+		wr(parf + PARF_ATU_BASE_ADDR_HI, 0);
+		wr(parf + PARF_SLV_ADDR_SPACE_SIZE_V2, 0);
+		wr(parf + PARF_SLV_ADDR_SPACE_SIZE_V2_HI, 0x80000000u);
+	} else {
+		wr(parf + PARF_DBI_BASE_ADDR_V2, 0);
+		wr(parf + PARF_SLV_ADDR_SPACE_SIZE_V2, MSM_SLV_ADDR_SPACE);
+	}
+	printf("NEGRONI WIFI: 7 %s recipe (negroniwifi_dbi=%u): DBI base %#x:%#x, slave space %#x:%#x, ATU base %#x:%#x\n",
+	    recipe == 1 ? "Linux" : "vendor", recipe, rd(parf + PARF_DBI_BASE_ADDR_V2_HI), rd(parf + PARF_DBI_BASE_ADDR_V2),
+	    rd(parf + PARF_SLV_ADDR_SPACE_SIZE_V2_HI), rd(parf + PARF_SLV_ADDR_SPACE_SIZE_V2),
+	    rd(parf + PARF_ATU_BASE_ADDR_HI), rd(parf + PARF_ATU_BASE_ADDR));
+	clear(parf + PARF_SYS_CTRL, 1u << 29);                  /* MAC_PHY_POWERDOWN_IN_P2_D_MUX_EN */
+	set(parf + PARF_MHI_CLOCK_RESET_CTRL, 1u << 4);         /* BYPASS */
+	clear(parf + PARF_PM_CTRL, 1u << 5);                    /* REQ_NOT_ENTR_L1 */
+	set(parf + PARF_AXI_MSTR_WR_ADDR_HALT_V2, 1u << 31);
+
+	wr(gcc + GCC_PCIE_0_PHY_BCR, 1);
+	wr(gcc + GCC_PCIE_0_NOCSR_COM_PHY_BCR, 1);
+	delay(300);
+	wr(gcc + GCC_PCIE_0_PHY_BCR, 0);
+	set(phy + PCS_POWER_DOWN_CONTROL, 1u | 2u);             /* SW_PWRDN | REFCLK_DRV_DSBL */
+	for (unsigned i = 0; i < sizeof(phy_init) / sizeof(phy_init[0]); i++) {
+		wr(phy + phy_init[i][0], phy_init[i][1]);
+	}
+	wr(gcc + GCC_PCIE_0_NOCSR_COM_PHY_BCR, 0);
+	clear(phy + PCS_SW_RESET, 1u);
+	set(phy + PCS_START_CONTROL, 1u | 2u);                  /* SERDES_START | PCS_START */
+	delay(1200);
+	wr(gcc + GCC_PCIE_0_PIPE_MUX, 0);
+	set(gcc + GCC_VOTE_2, 1u << 4);                         /* pipe clock */
+	wait_for(phy + PCS_PCS_STATUS1, 1u << 6, 0, 20);
+	status = rd(phy + PCS_PCS_STATUS1);
+	printf("NEGRONI WIFI: 7 PHY PCS_STATUS1 %#x (%s), pipe %#x\n", status, (status & (1u << 6)) ? "NOT ready" : "ready",
+	    rd(gcc + GCC_PCIE_0_PIPE));
+	controller = !(status & (1u << 6));
+	if (!controller) {
+		return false;
+	}
+	/* The DBI must answer now (pci-msm.c reads LNKCAP here, before PERST is released). */
+	if (!dbi) {
+		dbi = ml_io_map(DBI_PHYS, DBI_SIZE);
+	}
+	uint32_t id = rd(dbi), lnkcap = rd(dbi + 0x70 + 0x0c), sys = rd(dbi + ELBI_SYS_STTS);
+	printf("NEGRONI WIFI: 7 root port DBI ID %04x:%04x, LNKCAP %#x, ELBI SYS_STTS %#x\n", id & 0xffff, id >> 16,
+	    lnkcap, sys);
+	if (id == 0xffffffffu) {
+		printf("NEGRONI WIFI: 7 stop: the DBI does not answer (reads 0xffffffff); try the other negroniwifi_dbi recipe\n");
+		controller = false;
+		return false;
+	}
+	return controller;
+}
+
+static void
+atu(vm_offset_t base, unsigned index, uint32_t type, uint64_t from, uint64_t limit, uint64_t to)
+{
+	vm_offset_t r = base + ATU_OFFSET + ((vm_offset_t)index << 9);
+
+	wr(r + 0x08, (uint32_t)from);
+	wr(r + 0x0c, (uint32_t)(from >> 32));
+	wr(r + 0x10, (uint32_t)limit);
+	wr(r + 0x20, (uint32_t)(limit >> 32));
+	wr(r + 0x14, (uint32_t)to);
+	wr(r + 0x18, (uint32_t)(to >> 32));
+	wr(r + 0x00, type);
+	wr(r + 0x04, 1u << 31);
+}
+
+static const char *
+ltssm_name(uint32_t state)
+{
+	/* DesignWare LTSSM states (pci-msm.c TO_LTSSM_STR) */
+	static const char *const n[] = {
+		"DETECT_QUIET", "DETECT_ACT", "POLL_ACTIVE", "POLL_COMPLIANCE", "POLL_CONFIG", "PRE_DETECT_QUIET",
+		"DETECT_WAIT", "CFG_LINKWD_START", "CFG_LINKWD_ACEPT", "CFG_LANENUM_WAIT", "CFG_LANENUM_ACEPT",
+		"CFG_COMPLETE", "CFG_IDLE", "RCVRY_LOCK", "RCVRY_SPEED", "RCVRY_RCVRCFG", "RCVRY_IDLE", "L0",
+	};
+	return state < sizeof(n) / sizeof(n[0]) ? n[state] : "other";
+}
+
+static bool
+step_link(void)
+{
+	uint32_t status = 0, sys = 0, tries = 3, ltssm = 0;
+
+	if (!controller || !dbi) {
+		printf("NEGRONI WIFI: 8 stop: no PHY or no DBI (step 7)\n");
+		return false;
+	}
+	(void)PE_parse_boot_argn("negroniwifi_tries", &tries, sizeof(tries));
+	tries = MIN(MAX(tries, 1u), 10u);
+	announce("make the root port a bridge, map bus 1, release PERST and train the link");
+	set(dbi + 0x8bc, 1u);                                   /* DBI_RO_WR_EN */
+	wr(dbi + 0x08, (rd(dbi + 0x08) & 0xff) | 0x0604u << 16);        /* PCI-to-PCI bridge */
+	clear(dbi + 0x70 + 0x14, 1u << 6);                      /* no hot plug */
+	clear(dbi + 0x8bc, 1u);
+	wr(dbi + 0x10, 0);
+	wr(dbi + 0x14, 0);
+	wr(dbi + 0x18, 0x00010100);                             /* primary 0, secondary 1, subordinate 1 */
+	set(dbi + 0x04, 2u | 4u);                               /* memory, bus master */
+	/* cnss2 pci.c cnss_pci_enumerate: QCA6490 starts at Gen2 ("link issues if it boots up with Gen3") */
+	wr(dbi + DBI_LNKCTL2, (rd(dbi + DBI_LNKCTL2) & ~0xfu) | 2u);
+	atu(dbi, 0, 4, CFG_BUS1_PHYS, CFG_BUS1_PHYS + 0xfffff, 1ull << 24);     /* CFG0 to bus 1 */
+	atu(dbi, 1, 0, MEM_BASE, MEM_LIMIT, MEM_BASE);
+	printf("NEGRONI WIFI: 8 root port class %#x, buses %#x, LNKCTL2 %#x, iATU0 %#x/%#x\n", rd(dbi + 0x08) >> 8,
+	    rd(dbi + 0x18), rd(dbi + DBI_LNKCTL2), rd(dbi + ATU_OFFSET), rd(dbi + ATU_OFFSET + 4));
+	for (uint32_t t = 1; t <= tries && !linked; t++) {
+		delay(100000);                                  /* PERST held 100 ms (PCIE_T_PVPERL_MS) */
+		gpio_out(PERST_PIN, true);
+		delay(1000);                                    /* pci-msm.c PERST_PROPAGATION_DELAY_US */
+		set(parf + PARF_LTSSM, 1u << 8);
+		for (int i = 0; i < 100; i++) {                 /* 1 s; pci-msm.c waits 20 x 5 ms */
+			status = rd(dbi + 0x80);
+			sys = rd(dbi + ELBI_SYS_STTS);
+			if (status != 0xffffffffu && (status & (1u << 29)) && (sys & ELBI_XMLH_LINK_UP)) {
+				break;
+			}
+			delay(10000);
+		}
+		/*
+		 * 0xffffffff is a failed read, not a status (photo 2026-10-25: "link up: LNKSTA 0xffff (gen 15
+		 * x63), LTSSM 0x180"). A link needs a real LNKSTA with DLLLA (bit 13) and ELBI XMLH_LINK_UP.
+		 * PARF_LTSSM [5:0] and ELBI SYS_STTS [17:12] hold the LTSSM state (0x11 = L0).
+		 */
+		ltssm = rd(parf + PARF_LTSSM);
+		if (status == 0xffffffffu) {
+			printf("NEGRONI WIFI: 8 try %u: link DOWN: the root port's LNKSTA reads 0xffffffff (DBI does not "
+			    "answer), LTSSM %#x (state %#x %s)\n", t, ltssm, ltssm & 0x3f, ltssm_name(ltssm & 0x3f));
+			break;
+		}
+		linked = (status & (1u << 29)) && (sys & ELBI_XMLH_LINK_UP);
+		printf("NEGRONI WIFI: 8 try %u: link %s: LNKSTA %#x (gen %u x%u), ELBI %#x (state %#x %s), LTSSM %#x\n", t,
+		    linked ? "UP" : "DOWN", status >> 16, (status >> 16) & 0xf, (status >> 20) & 0x3f, sys,
+		    (sys >> 12) & 0x3f, ltssm_name((sys >> 12) & 0x3f), ltssm);
+		if (!linked) {
+			/* pci-msm.c on a failed training: PERST back on; cnss2 retries up to 3 times */
+			clear(parf + PARF_LTSSM, 1u << 8);
+			gpio_out(PERST_PIN, false);
+		}
+	}
+	return linked;
+}
+
+static bool
+step_chip(void)
+{
+	uint32_t id;
+
+	if (!linked) {
+		printf("NEGRONI WIFI: 9 stop: no link (step 8)\n");
+		return false;
+	}
+	announce("read the chip's config space on bus 1");
+	cfg_bus1 = ml_io_map(CFG_BUS1_PHYS, 0x1000);
+	id = rd(cfg_bus1);
+	printf("NEGRONI WIFI: 9 bus 1 device %04x:%04x, class %#x, BAR0 %#x, BAR1 %#x\n", id & 0xffff, id >> 16,
+	    rd(cfg_bus1 + 0x08) >> 8, rd(cfg_bus1 + 0x10), rd(cfg_bus1 + 0x14));
+	if (id == CHIP_ID) {
+		printf("NEGRONI WIFI: 9 THE QCA6490 ANSWERS ON PCIe\n");
+	} else if (id == 0xffffffffu) {
+		printf("NEGRONI WIFI: 9 stop: bus 1 config space reads 0xffffffff (no answer: no link)\n");
+		linked = false;     /* no step 10, no driver hand-over (negroni_wifi_pcie_handles) */
+	} else {
+		printf("NEGRONI WIFI: 9 stop: %08x is not the QCA6490 (17cb:1103)\n", id);
+		linked = false;
+	}
+	return id == CHIP_ID;
+}
+
+/* The endpoint's command/status, BAR0 type and capability list (PCI 3.0 6.7: status bit 4,
+ * pointer at 0x34, ID 0x05 MSI, 0x11 MSI-X). Reads only: no BAR is assigned and no vector is
+ * enabled (no XNU MSI route exists for PCIe0 yet). Linux ath11k_pci_probe sizes BAR0 and
+ * enables MSI only after this point. */
+static bool
+step_pci_caps(void)
+{
+	uint32_t command, bar0, status, cap;
+	unsigned count = 0;
+	bool msi = false, msix = false;
+
+	if (!linked || !cfg_bus1) {
+		printf("NEGRONI WIFI: 10 stop: no bus 1 config space (step 9)\n");
+		return false;
+	}
+	announce("read the chip's PCI capability list (read only)");
+	command = rd(cfg_bus1 + 0x04);
+	status = command >> 16;
+	bar0 = rd(cfg_bus1 + 0x10);
+	printf("NEGRONI WIFI: 10 BAR0 %#x (%s, %s), command %#x, status %#x\n",
+	    bar0, (bar0 & 1) ? "I/O" : "memory",
+	    (bar0 & 1) ? "n/a" : ((bar0 & 6) == 4 ? "64-bit" : "32-bit"),
+	    command & 0xffff, status);
+	if (!(status & (1u << 4))) {
+		printf("NEGRONI WIFI: 10 endpoint reports no capability list\n");
+		return true;
+	}
+	cap = rd(cfg_bus1 + 0x34) & 0xff;
+	while (cap >= 0x40 && cap <= 0xfc && !(cap & 3) && count++ < 48) {
+		uint32_t header = rd(cfg_bus1 + cap);
+		uint32_t id = header & 0xff;
+		uint32_t next = (header >> 8) & 0xff;
+		if (id == 0x05) {
+			msi = true;
+			printf("NEGRONI WIFI: 10 MSI capability at %#x control %#x\n", cap, (header >> 16) & 0xffff);
+		} else if (id == 0x11) {
+			msix = true;
+			printf("NEGRONI WIFI: 10 MSI-X capability at %#x control %#x\n", cap, (header >> 16) & 0xffff);
+		}
+		if (!next || next == cap) {
+			break;
+		}
+		cap = next;
+	}
+	printf("NEGRONI WIFI: 10 interrupt inventory: MSI %s, MSI-X %s; no vector enabled\n",
+	    msi ? "present" : "absent", msix ? "present" : "absent");
+	return true;
+}
+
+static bool (*const steps[])(void) = {
+	step_gcc, step_pins, step_rails, step_pcie, step_power, step_chip_on, step_phy, step_link, step_chip, step_pci_caps,
+};
+
+/*
+ * Hand the survey's mapped PCIe0 handles to the driver (bsd/dev/negroni_wlan.c).
+ * The driver reuses them (BAR0 is in the 0x60300000 iATU window) instead of
+ * repeating the GCC/PHY/link bring-up. False unless step 9 saw the chip.
+ */
+
+bool
+negroni_wifi_pcie_handles(struct negroni_wlan_pcie *out)
+{
+	if (!out || !linked || !cfg_bus1) {
+		return false;
+	}
+	out->gcc = gcc;
+	out->tlmm = tlmm;
+	out->parf = parf;
+	out->phy = phy;
+	out->dbi = dbi;
+	out->cfg_bus1 = cfg_bus1;
+	out->mem_base = MEM_BASE;
+	out->mem_limit = MEM_LIMIT;
+	out->chip_id = rd(cfg_bus1);
+	out->linked = true;
+	return true;
+}
+
+void negroni_wlan_ios_init(void);        /* 0340: bsd/dev/negroni_wlan_ios.c */
+
+void
+negroni_wifi_init(void)
+{
+	uint32_t last = 0;
+	uint32_t wlan = 0;
+	bool failed = false;
+
+	(void)PE_parse_boot_argn("negroniwifi", &last, sizeof(last));
+	(void)PE_parse_boot_argn("negroniwlan", &wlan, sizeof(wlan));
+	negroni_wlan_ios_init();        /* 0340: IODeviceTree "wlan" (wifid) now; en0 + Apple80211 when the driver is ready */
+	if (wlan) {
+		last = (uint32_t)(sizeof(steps) / sizeof(steps[0]));   /* opt-in: power, link, ID, step 10 */
+	}
+	if (negroni_probe_wifi != ~0u) {
+		last = negroni_probe_wifi;      /* probe menu (negroni_keys.c) */
+	}
+	(void)PE_parse_boot_argn("negroniwifi_pause", &pause_ms, sizeof(pause_ms));
+	if (last == 0) {
+		return;
+	}
+	last = MIN(last, (uint32_t)(sizeof(steps) / sizeof(steps[0])));
+	printf("NEGRONI WIFI: steps 1..%u\n", last);
+	gcc = ml_io_map_unmappable(GCC_PHYS, GCC_SIZE, WIFI_WIMG_IO);
+	tlmm = ml_io_map_unmappable(TLMM_PHYS, TLMM_SIZE, WIFI_WIMG_IO);
+	for (step = 1; step <= last; step++) {
+		snprintf(negroni_wifi_badge, sizeof(negroni_wifi_badge), "WIFI %u", step);
+		negroni_wifi_badge_color = 0x00d0a000;
+		if (!steps[step - 1]()) {
+			failed = true;
+			break;
+		}
+	}
+	if (failed) {
+		snprintf(negroni_wifi_badge, sizeof(negroni_wifi_badge), "WIFI STOP %u", step);
+		negroni_wifi_badge_color = 0x00c00000;
+	} else {
+		snprintf(negroni_wifi_badge, sizeof(negroni_wifi_badge), "WIFI OK %u", last);
+		negroni_wifi_badge_color = 0x000060c0;
+	}
+	printf("NEGRONI WIFI: done (asked %u)\n", last);
+	if (wlan >= 2) {
+		if (!failed && last == (uint32_t)(sizeof(steps) / sizeof(steps[0]))) {
+			negroni_wlan_start();   /* own thread: boot does not wait */
+		} else {
+			printf("NEGRONI WLAN: not started: the survey stopped before step 10 passed\n");
+		}
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
