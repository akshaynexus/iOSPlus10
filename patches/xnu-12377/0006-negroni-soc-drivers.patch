+/*
+ * NEGRONI Wi-Fi, iOS side (patches 0340, 0341): what the three parts know of each other.
+ *
+ *   bsd/dev/negroni_wlan_ios.c      en0 (BSD interface KPI), the worker thread, the backend (the driver seam
+ *                                   bsd/dev/negroni_wlan_api.h, or a fake radio for UI tests), link state.
+ *   bsd/dev/negroni_apple80211.c    the Apple80211 ioctls (SIOCGA80211 / SIOCSA80211) and the class-6 events.
+ *   iokit/Kernel/arm/NegroniWLAN.cpp the registry: IODeviceTree "wlan" (launchd starts wifid only if it exists),
+ *                                   IO80211Controller + IONetworkInterface property-only services (wifid, configd).
+ *
+ * Boot-arg negroniwlan_ios: 0 off; 1 (default) on when negroniwlan >= 10: en0 appears when the driver API is
+ * ready (state IDLE); 2 fake radio: no chip needed, en0 at once, 3 fake networks, joins without data.
+ */
+#ifndef _NEGRONI_WLAN_IOS_H_
+#define _NEGRONI_WLAN_IOS_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "negroni_wlan_api.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define NWIOS_IFNAME            "en0"
+#define SIOCSA80211_CMD         0x802869c8ul    /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211_CMD         0xc02869c9ul    /* _IOWR('i', 201, struct apple80211req) */
+
+/* ---- backend (negroni_wlan_ios.c); every call returns at once, results come as events ---- */
+const char *nwios_backend_name(void);           /* "driver" or "fake" */
+uint32_t nwios_caps(void);                      /* NWLAN_CAP_* */
+bool nwios_present(void);                       /* en0 exists and the backend answers */
+bool nwios_powered(void);                       /* the soft radio switch (Settings / Control Center) */
+int nwios_set_power(bool on);                   /* off: leave the network; event NWIOS_EV_POWER */
+int nwios_scan(void);                           /* 0 / ENETDOWN / ENXIO; always ends in NWIOS_EV_SCAN_DONE */
+/* the BSS list of the last finished scan, copied at NWIOS_EV_SCAN_DONE; returns false past the end */
+bool nwios_result(uint32_t index, struct nwlan_bss *out);
+/* psk NULL: open; else a passphrase (8..63) or 64 hex digits; always ends in NWIOS_EV_JOIN_DONE */
+int nwios_associate(const uint8_t *ssid, uint32_t ssid_len, const char *psk, uint32_t psk_len);
+int nwios_disassociate(void);
+void nwios_link(struct nwlan_link *out);        /* state, bssid, ssid, rssi, freq of the backend */
+bool nwios_joined(void);                        /* en0's link is up */
+
+/* ---- Apple80211 (negroni_apple80211.c) ---- */
+enum nwios_event {
+	NWIOS_EV_POWER,                         /* status 1 on, 0 off */
+	NWIOS_EV_SCAN_DONE,                     /* status 0 or errno */
+	NWIOS_EV_JOIN_DONE,                     /* status 0 or errno (EAUTH: wrong passphrase, ETIMEDOUT) */
+	NWIOS_EV_LINK,                          /* status 1 joined, 0 left when asked, errno: lost */
+};
+int negroni_apple80211_ioctl(unsigned long command, void *data);
+void negroni_apple80211_event(enum nwios_event event, int status);     /* worker thread only */
+void negroni_apple80211_summary(void);
+bool negroni_apple80211_summary_due(void);     /* 0345: requests came since the last summary */
+
+/* ---- registry (NegroniWLAN.cpp) ---- */
+bool negroni_wlan_ios_dt_entry(void);          /* make IODeviceTree "wlan" if no entry has that name */
+bool negroni_wlan_ios_adt_mac(uint8_t mac[6]);  /* /chosen mac-address-wifi0 */
+void negroni_wlan_ios_publish(const char *ifname, const uint8_t mac[6]);
+
+void negroni_wlan_ios_init(void);               /* from negroni_wifi_init() */
+uint32_t negroni_wlan_ios_log_max(void);        /* negroniwlan_ios_log */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _NEGRONI_WLAN_IOS_H_ */
diff --git a/bsd/dev/negroni_wlan_join.c b/bsd/dev/negroni_wlan_join.c
new file mode 100644
index 0000000..1701782
--- /dev/null
+++ b/bsd/dev/negroni_wlan_join.c
@@ -0,0 +1,1071 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi (patch 0327): join a BSS as a station (open system authentication), the link
+ * life cycle and the API's associate / disassociate.
+ *
+ * Sequence (ath11k mac.c: assign_vif_chanctx -> vdev start, sta_state NOTEXIST->NONE -> peer create, mac80211
+ * auth/assoc frames -> WMI mgmt tx, bss_info_changed(assoc) -> ath11k_bss_assoc: peer assoc + vdev up):
+ *   1. the strongest BSS with the SSID from the scan list (a passive scan first if none was seen in 60 s)
+ *   2. WMI_PEER_CREATE (the AP; WCN6855 vdev_start_delay: the peer before the vdev start), 0328: HTT peer map
+ *   3. WMI_VDEV_START on its channel, 20 MHz (channel mode HE20 as ath11k_phymodes), wait VDEV_START_RESP
+ *   4. AUTH (open, seq 1) by WMI_MGMT_TX_SEND, wait AUTH seq 2 status 0 (3 tries, 500 ms each)
+ *   5. ASSOC REQ (ESS, rates as the AP's, HT capabilities 20 MHz, WMM info if the AP has WMM, RSN from 0329),
+ *      wait ASSOC RESP status 0 + AID (3 tries)
+ *   6. WMI_PEER_ASSOC (legacy + HT rates and caps from the AP's elements, ath11k_peer_assoc_prepare), wait
+ *      PEER_ASSOC_CONF; WMI_VDEV_UP (AID, BSSID); VDEV_PARAM DTIM_POLICY stick; STA powersave off
+ *   7. open: PEER_SET_PARAM AUTHORIZE 1 -> CONNECTED. WPA2 (0329): HANDSHAKE, keys, then AUTHORIZE.
+ * Down (request, deauth/disassoc from the AP, PEER_STA_KICKOUT, ROAM BMISS, 10 s without a beacon): DEAUTH
+ * frame (our request only), VDEV_DOWN, VDEV_STOP, PEER_DELETE -> IDLE + NWLAN_EV_LINK_DOWN. A join that ends before
+ * JOINING (no BSS, wrong security) also sends NWLAN_EV_LINK_DOWN with last_error.
+ *
+ * Management frames go out by WMI with the frame in a DMA buffer (IOVA via negroni_wlan_dma_map) and its first
+ * 64 bytes inline (wmi.c ath11k_wmi_mgmt_send). UNTESTED ON HARDWARE.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include <arm/caches_internal.h>
+#include "negroni_wlan.h"
+#include "negroni_wlan_mhi.h"
+#include "negroni_wlan_wmi.h"
+#include "negroni_wlan_sta.h"
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+/* WMI ids and tags (computed from ath11k wmi.h enums: WMI_TLV_CMD(grp) = grp << 12 | 1, enum wmi_tlv_tag) */
+#define WMI_VDEV_START_REQUEST_CMDID    0x5003u
+#define WMI_VDEV_UP_CMDID               0x5005u
+#define WMI_VDEV_STOP_CMDID             0x5006u
+#define WMI_VDEV_DOWN_CMDID             0x5007u
+#define WMI_VDEV_SET_PARAM_CMDID        0x5008u
+#define WMI_PEER_CREATE_CMDID           0x6001u
+#define WMI_PEER_DELETE_CMDID           0x6002u
+#define WMI_PEER_SET_PARAM_CMDID        0x6004u
+#define WMI_PEER_ASSOC_CMDID            0x6005u
+#define WMI_MGMT_TX_SEND_CMDID          0x7008u
+#define WMI_STA_POWERSAVE_MODE_CMDID    0x9001u
+#define WMI_VDEV_START_RESP_EVENTID     0x5001u
+#define WMI_VDEV_STOPPED_EVENTID        0x5002u
+#define WMI_VDEV_INSTALL_KEY_COMPLETE_EVENTID 0x5003u
+#define WMI_PEER_STA_KICKOUT_EVENTID    0x6001u
+#define WMI_PEER_ASSOC_CONF_EVENTID     0x6006u
+#define WMI_PEER_DELETE_RESP_EVENTID    0x6007u
+#define WMI_MGMT_TX_COMPLETION_EVENTID  0x7006u
+#define WMI_ROAM_EVENTID                0xb001u
+#define TAG_CHANNEL                     0x50u
+#define TAG_VDEV_START_REQUEST_CMD      0x58u
+#define TAG_VDEV_UP_CMD                 0x5cu
+#define TAG_VDEV_STOP_CMD               0x5du
+#define TAG_VDEV_DOWN_CMD               0x5eu
+#define TAG_VDEV_SET_PARAM_CMD          0x5fu
+#define TAG_PEER_CREATE_CMD             0x61u
+#define TAG_PEER_DELETE_CMD             0x62u
+#define TAG_PEER_SET_PARAM_CMD          0x64u
+#define TAG_PEER_ASSOC_COMPLETE_CMD     0x65u
+#define TAG_VHT_RATE_SET                0x66u
+#define TAG_STA_POWERSAVE_MODE_CMD      0x6cu
+#define TAG_MGMT_TX_SEND_CMD            0x1a6u
+#define TAG_VDEV_START_RESPONSE_EVENT   0x28u
+#define TAG_PEER_STA_KICKOUT_EVENT      0x2bu
+#define TAG_ROAM_EVENT                  0x30u
+#define TAG_MGMT_TX_COMPL_EVENT         0x1a7u
+#define TAG_PEER_ASSOC_CONF_EVENT       0x1b2u
+#define TAG_ARRAY_BYTE                  0x11u
+#define TAG_ARRAY_STRUCT                0x12u
+/* values (wmi.h, mac.h) */
+#define MODE_11A                        0u
+#define MODE_11G                        1u
+#define MODE_11B                        2u
+#define MODE_11NA_HT20                  4u
+#define MODE_11NG_HT20                  5u
+#define MODE_11AX_HE20                  16u
+#define MODE_11AX_HE20_2G               21u
+#define VDEV_START_LDPC_RX_ENABLED      (1u << 3)
+#define PEER_AUTH                       0x1u
+#define PEER_QOS                        0x2u
+#define PEER_NEED_PTK_4_WAY             0x4u
+#define PEER_HT                         0x1000u
+#define PEER_LDPC                       0x10000u
+#define RC_DS_FLAG                      0x01u
+#define RC_SGI_FLAG                     0x04u
+#define RC_HT_FLAG                      0x08u
+#define PEER_PARAM_AUTHORIZE            0x3u
+#define VDEV_PARAM_DTIM_POLICY          0x47u
+#define DTIM_POLICY_STICK               3u
+#define ROAM_REASON_BMISS               2u      /* WMI_ROAM_REASON_BEACON_MISS */
+#define MGMT_SEND_DOWNLD_LEN            64u
+
+#define JOIN_TRIES                      3u
+#define JOIN_FRAME_MS                   500u
+#define BEACON_LOSS_MS                  10000u
+#define MGMT_SLOTS                      4u
+#define MGMT_SLOT                       1024u
+
+/* ---- a small DMA buffer (contiguous, Normal NC view, device address through the SMMU) ---- */
+#define WLAN_WIMG_WCOMB                 0x6u
+int
+negroni_wlan_dma_alloc(uint32_t size, struct nwlan_dma *d)
+{
+	memset(d, 0, sizeof(*d));
+	d->size = (size + PAGE_MASK) & ~(uint32_t)PAGE_MASK;
+	if (kmem_alloc_contig(kernel_map, &d->kva, d->size, PAGE_MASK, (ppnum_t)(atop_64(MHI_DMA_MASK + 1) - 1), 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		d->kva = 0;
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)d->kva);
+	d->pa = ptoa_64(pn);
+	flush_dcache64((addr64_t)d->pa, d->size, TRUE);
+	d->nc = ml_io_map_unmappable((vm_offset_t)d->pa, d->size, WLAN_WIMG_WCOMB);
+	d->dva = d->nc ? negroni_wlan_dma_map(d->pa, d->size) : WLAN_DMA_NONE;
+	if (!pn || !d->nc || d->dva == WLAN_DMA_NONE) {
+		negroni_wlan_dma_free(d);
+		return ENOMEM;
+	}
+	return 0;
+}
+
+/* only after the chip can no longer use it (unmapped from the SMMU first) */
+void
+negroni_wlan_dma_free(struct nwlan_dma *d)
+{
+	if (d->dva && d->dva != WLAN_DMA_NONE) {
+		negroni_wlan_dma_unmap(d->dva, d->size);
+	}
+	if (d->nc) {
+		ml_io_unmap(d->nc, d->size);
+	}
+	if (d->kva) {
+		flush_dcache64((addr64_t)d->pa, d->size, TRUE);
+		kmem_free(kernel_map, d->kva, d->size);
+	}
+	memset(d, 0, sizeof(*d));
+}
+
+/* ---- request mailbox (API threads) ---- */
+static LCK_GRP_DECLARE(j_grp, "negroni_wlan_join");
+static LCK_MTX_DECLARE(j_mtx, &j_grp);
+static struct {
+	bool assoc, disassoc;
+	uint8_t ssid[NWLAN_SSID_MAX];
+	uint32_t ssid_len;
+	char psk[NWLAN_PSK_MAX + 1];
+	uint32_t psk_len;
+} R;
+
+/* ---- driver-thread state ---- */
+static struct {
+	/* event flags (set in the service pass) */
+	volatile bool start_resp, assoc_conf, stopped, peer_deleted;
+	uint32_t start_status;
+	volatile bool auth_rx, assoc_rx;
+	uint16_t auth_status, assoc_status, assoc_aid, assoc_capab;
+	volatile bool lost;
+	uint16_t lost_reason;
+	const char *lost_why;
+	/* the BSS being joined / joined */
+	struct nwlan_bss bss;
+	bool active, vdev_started, peer, up;
+	uint64_t last_beacon_ms;
+	uint16_t seq;
+	/* management TX */
+	struct nwlan_dma mgmt;
+	bool mgmt_busy[MGMT_SLOTS];
+	uint32_t mgmt_sent, mgmt_done, mgmt_fail;
+} J;
+
+/* ---- WMI helpers ---- */
+static uint8_t *
+tlv(uint8_t *p, uint32_t tag, uint32_t len)
+{
+	uint32_t h = (tag << 16) | (len & 0xffff);
+	memcpy(p, &h, 4);
+	return p + 4;
+}
+
+static uint8_t *
+w32(uint8_t *p, uint32_t v)
+{
+	memcpy(p, &v, 4);
+	return p + 4;
+}
+
+static uint8_t *
+wmac(uint8_t *p, const uint8_t mac[6])
+{
+	memset(p, 0, 8);                /* wmi_mac_addr: 6 bytes + 2 pad */
+	memcpy(p, mac, 6);
+	return p + 8;
+}
+
+static uint32_t
+rd32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* the first TLV of an event with `tag` and at least `min` bytes */
+static const uint8_t *
+ev_tlv(const uint8_t *p, uint32_t len, uint32_t tag, uint32_t min)
+{
+	struct wmi_tlv_it it = { p, p + len };
+	const uint8_t *v;
+	uint32_t t, l;
+
+	while (negroni_wmi_tlv_next(&it, &t, &v, &l) == 1) {
+		if (t == tag && l >= min) {
+			return v;
+		}
+	}
+	return NULL;
+}
+
+/* WMI events of the join (inside the service pass: record only). True when handled. */
+bool
+negroni_wlan_join_wmi_event(uint32_t id, const uint8_t *p, uint32_t len)
+{
+	const uint8_t *v;
+
+	switch (id) {
+	case WMI_VDEV_START_RESP_EVENTID:
+		if ((v = ev_tlv(p, len, TAG_VDEV_START_RESPONSE_EVENT, 16))) {
+			J.start_status = rd32(v + 12);
+			J.start_resp = true;
+		}
+		return true;
+	case WMI_VDEV_STOPPED_EVENTID:
+		J.stopped = true;
+		return true;
+	case WMI_PEER_ASSOC_CONF_EVENTID:
+		J.assoc_conf = true;
+		return true;
+	case WMI_PEER_DELETE_RESP_EVENTID:
+		J.peer_deleted = true;
+		return true;
+	case WMI_MGMT_TX_COMPLETION_EVENTID:
+		if ((v = ev_tlv(p, len, TAG_MGMT_TX_COMPL_EVENT, 8))) {
+			uint32_t desc = rd32(v), status = rd32(v + 4);
+			if (desc < MGMT_SLOTS) {
+				J.mgmt_busy[desc] = false;
+			}
+			J.mgmt_done++;
+			if (status != 0) {
+				J.mgmt_fail++;
+			}
+		}
+		return true;
+	case WMI_PEER_STA_KICKOUT_EVENTID:
+		if ((v = ev_tlv(p, len, TAG_PEER_STA_KICKOUT_EVENT, 6)) && J.up && !memcmp(v, J.bss.bssid, 6)) {
+			J.lost = true;
+			J.lost_why = "PEER_STA_KICKOUT";
+		}
+		return true;
+	case WMI_ROAM_EVENTID:
+		if ((v = ev_tlv(p, len, TAG_ROAM_EVENT, 8)) && J.up && rd32(v + 4) == ROAM_REASON_BMISS) {
+			J.lost = true;
+			J.lost_why = "ROAM beacon miss";
+		}
+		return true;
+	case WMI_VDEV_INSTALL_KEY_COMPLETE_EVENTID:
+		negroni_wlan_wpa_key_event(p, len);    /* 0329 */
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* ---- 802.11 frames ---- */
+static uint32_t
+hdr80211(uint8_t *f, uint32_t fc, const uint8_t *da, const uint8_t *bssid)
+{
+	const uint8_t *mac = negroni_wlan_wmi_mac();
+
+	f[0] = (uint8_t)fc;
+	f[1] = (uint8_t)(fc >> 8);
+	f[2] = f[3] = 0;                /* duration: the firmware fills it */
+	memcpy(f + 4, da, 6);
+	memcpy(f + 10, mac, 6);
+	memcpy(f + 16, bssid, 6);
+	uint16_t sc = (uint16_t)(J.seq++ << 4);
+	f[22] = (uint8_t)sc;
+	f[23] = (uint8_t)(sc >> 8);
+	return 24;
+}
+
+/* an element of the BSS's saved elements (NULL if absent) */
+static const uint8_t *
+bss_ie(const struct nwlan_bss *b, uint32_t id, uint32_t *len)
+{
+	for (uint32_t o = 0; o + 2 <= b->ie_len;) {
+		uint32_t el = b->ie[o + 1];
+		if (o + 2 + el > b->ie_len) {
+			break;
+		}
+		if (b->ie[o] == id) {
+			*len = el;
+			return b->ie + o + 2;
+		}
+		o += 2 + el;
+	}
+	return NULL;
+}
+
+static bool
+bss_wmm(const struct nwlan_bss *b)
+{
+	for (uint32_t o = 0; o + 2 <= b->ie_len;) {
+		uint32_t el = b->ie[o + 1];
+		if (o + 2 + el > b->ie_len) {
+			break;
+		}
+		const uint8_t *d = b->ie + o + 2;
+		if (b->ie[o] == 221 && el >= 5 && d[0] == 0x00 && d[1] == 0x50 && d[2] == 0xf2 && d[3] == 2) {
+			return true;
+		}
+		o += 2 + el;
+	}
+	return false;
+}
+
+/* send one management frame by WMI (frame copied into a DMA slot) */
+static int
+mgmt_send(const uint8_t *frame, uint32_t len)
+{
+	uint8_t m[4 + 36 + 4 + MGMT_SEND_DOWNLD_LEN];
+	uint32_t slot = MGMT_SLOTS;
+
+	if (len > MGMT_SLOT || !J.mgmt.nc) {
+		return EMSGSIZE;
+	}
+	for (uint32_t i = 0; i < MGMT_SLOTS; i++) {
+		if (!J.mgmt_busy[i]) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot == MGMT_SLOTS) {
+		return ENOBUFS;
+	}
+	memcpy((void *)(J.mgmt.nc + slot * MGMT_SLOT), frame, len);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint64_t a = J.mgmt.dva + (uint64_t)slot * MGMT_SLOT;
+	uint32_t dl = MIN(len, MGMT_SEND_DOWNLD_LEN);
+	memset(m, 0, sizeof(m));
+	uint8_t *p = tlv(m, TAG_MGMT_TX_SEND_CMD, 32);
+	p = w32(p, 0);                  /* vdev */
+	p = w32(p, slot);               /* desc_id */
+	p = w32(p, 0);                  /* chanfreq: the vdev's channel */
+	p = w32(p, (uint32_t)a);
+	p = w32(p, (uint32_t)(a >> 32));
+	p = w32(p, len);
+	p = w32(p, dl);
+	p = w32(p, 0);                  /* tx_params_valid */
+	p = tlv(p, TAG_ARRAY_BYTE, dl);
+	memcpy(p, frame, dl);
+	p += (dl + 3) & ~3u;
+	J.mgmt_busy[slot] = true;
+	J.mgmt_sent++;
+	int error = negroni_wlan_wmi_send(WMI_MGMT_TX_SEND_CMDID, m, (uint32_t)(p - m));
+	if (error) {
+		J.mgmt_busy[slot] = false;
+	}
+	return error;
+}
+
+/* non-beacon management frames from WMI MGMT_RX (service pass: record only) */
+void
+negroni_wlan_sta_join_frame(const uint8_t *f, uint32_t len)
+{
+	if (len < 24 || !J.active) {
+		return;
+	}
+	uint32_t fc = f[0] | f[1] << 8, type = (fc >> 2) & 3, sub = (fc >> 4) & 0xf;
+	const uint8_t *sa = f + 10, *body = f + 24;
+	uint32_t bl = len - 24;
+
+	if (type != 0 || memcmp(sa, J.bss.bssid, 6) || memcmp(f + 4, negroni_wlan_wmi_mac(), 6)) {
+		return;
+	}
+	switch (sub) {
+	case 11:        /* authentication */
+		if (bl >= 6 && (body[0] | body[1] << 8) == 0 && (body[2] | body[3] << 8) == 2) {
+			J.auth_status = (uint16_t)(body[4] | body[5] << 8);
+			J.auth_rx = true;
+		}
+		break;
+	case 1:         /* association response */
+	case 3:         /* reassociation response */
+		if (bl >= 6) {
+			J.assoc_capab = (uint16_t)(body[0] | body[1] << 8);
+			J.assoc_status = (uint16_t)(body[2] | body[3] << 8);
+			J.assoc_aid = (uint16_t)((body[4] | body[5] << 8) & 0x3fff);
+			J.assoc_rx = true;
+		}
+		break;
+	case 10:        /* disassociation */
+	case 12:        /* deauthentication */
+		if (J.up || J.peer) {
+			J.lost = true;
+			J.lost_reason = bl >= 2 ? (uint16_t)(body[0] | body[1] << 8) : 0;
+			J.lost_why = sub == 12 ? "deauthentication from the AP" : "disassociation from the AP";
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+void
+negroni_wlan_sta_beacon_seen(const uint8_t bssid[6])
+{
+	if (J.active && !memcmp(bssid, J.bss.bssid, 6)) {
+		J.last_beacon_ms = negroni_wlan_ms();
+	}
+}
+
+/* ---- WMI commands ---- */
+static bool
+is_2g(uint32_t f)
+{
+	return f < 3000;
+}
+
+static int
+vdev_start(const struct nwlan_bss *b)
+{
+	uint8_t m[4 + 104 + 4 + 24 + 4];
+	uint32_t chains = negroni_wlan_wmi_chains();
+	uint8_t *p;
+
+	memset(m, 0, sizeof(m));
+	/* wmi_vdev_start_request_cmd: 26 u32 after the header (wmi.h:2681) */
+	p = m + 4;
+	p = w32(p, 0);                          /* vdev_id */
+	p = w32(p, 0);                          /* requestor_id */
+	p = w32(p, b->beacon_int ? b->beacon_int : 100);
+	p = w32(p, 1);                          /* dtim_period (the TIM element updates it in the firmware) */
+	p = w32(p, VDEV_START_LDPC_RX_ENABLED); /* flags */
+	p += 36;                                /* wmi_ssid {len, 8 words}: empty for a STA */
+	p = w32(p, 0);                          /* bcn_tx_rate */
+	p = w32(p, 0);                          /* bcn_txpower */
+	p = w32(p, 0);                          /* num_noa_descriptors */
+	p = w32(p, 0);                          /* disable_hw_ack */
+	p = w32(p, chains);                     /* preferred_tx_streams */
+	p = w32(p, chains);                     /* preferred_rx_streams */
+	p = w32(p, 0);                          /* he_ops */
+	p = w32(p, 0);                          /* cac_duration_ms */
+	p = w32(p, 0);                          /* regdomain */
+	p = w32(p, 0);                          /* min_data_rate */
+	p = w32(p, 0);                          /* mbssid_flags */
+	p = w32(p, 0);                          /* mbssid_tx_vdev_id */
+	(void)tlv(m, TAG_VDEV_START_REQUEST_CMD, (uint32_t)(p - m) - 4);
+	p = tlv(p, TAG_CHANNEL, 24);
+	p = w32(p, b->freq);
+	p = w32(p, b->freq);                    /* band_center_freq1: 20 MHz */
+	p = w32(p, 0);
+	p = w32(p, is_2g(b->freq) ? MODE_11AX_HE20_2G : MODE_11AX_HE20);       /* ath11k_phymodes[band][20] */
+	p = w32(p, (20u << 8) | (20u << 16));   /* reg_info_1: max power, max reg power (dBm) */
+	p = w32(p, 20u << 8);                   /* reg_info_2: max tx power */
+	p = tlv(p, TAG_ARRAY_STRUCT, 0);        /* no NoA descriptors */
+	J.start_resp = false;
+	int error = negroni_wlan_wmi_send(WMI_VDEV_START_REQUEST_CMDID, m, (uint32_t)(p - m));
+	if (!error) {
+		error = negroni_wlan_wmi_wait(&J.start_resp, 3000, "VDEV_START_RESP");
+	}
+	if (!error && J.start_status != 0) {
+		error = negroni_wlan_failed(EIO, "VDEV_START status %u", J.start_status);
+	}
+	return error;
+}
+
+static int
+vdev_simple(uint32_t cmd, uint32_t tag, const char *what)
+{
+	uint8_t m[4 + 4];
+	(void)w32(tlv(m, tag, 4), 0);
+	int error = negroni_wlan_wmi_send(cmd, m, sizeof(m));
+	if (error) {
+		printf("NEGRONI WLAN: JOIN %s not sent (error %d)\n", what, error);
+	}
+	return error;
+}
+
+static int
+peer_cmd(uint32_t cmd, uint32_t tag, bool create)
+{
+	uint8_t m[4 + 4 + 8 + 4];
+	uint8_t *p = tlv(m, tag, create ? 16 : 12);
+	p = w32(p, 0);
+	p = wmac(p, J.bss.bssid);
+	if (create) {
+		p = w32(p, 0);                  /* WMI_PEER_TYPE_DEFAULT */
+	}
+	return negroni_wlan_wmi_send(cmd, m, (uint32_t)(p - m));
+}
+
+int
+negroni_wlan_peer_set_param(const uint8_t mac[6], uint32_t param, uint32_t value)
+{
+	uint8_t m[4 + 4 + 8 + 8];
+	uint8_t *p = tlv(m, TAG_PEER_SET_PARAM_CMD, 20);
+	p = w32(p, 0);
+	p = wmac(p, mac);
+	p = w32(p, param);
+	p = w32(p, value);
+	return negroni_wlan_wmi_send(WMI_PEER_SET_PARAM_CMDID, m, (uint32_t)(p - m));
+}
+
+static int
+vdev_set_param(uint32_t param, uint32_t value)
+{
+	uint8_t m[4 + 12];
+	uint8_t *p = tlv(m, TAG_VDEV_SET_PARAM_CMD, 12);
+	p = w32(p, 0);
+	p = w32(p, param);
+	p = w32(p, value);
+	return negroni_wlan_wmi_send(WMI_VDEV_SET_PARAM_CMDID, m, (uint32_t)(p - m));
+}
+
+static int
+sta_ps_off(void)
+{
+	uint8_t m[4 + 8];
+	uint8_t *p = tlv(m, TAG_STA_POWERSAVE_MODE_CMD, 8);
+	p = w32(p, 0);
+	p = w32(p, 0);                  /* WMI_STA_PS_MODE_DISABLED */
+	return negroni_wlan_wmi_send(WMI_STA_POWERSAVE_MODE_CMDID, m, (uint32_t)(p - m));
+}
+
+/* ath11k_parse_mpdudensity */
+static uint32_t
+mpdu_density(uint32_t d)
+{
+	static const uint8_t t[8] = { 0, 1, 1, 1, 2, 4, 8, 16 };
+	return t[d & 7];
+}
+
+/* the AP's rates in ath11k's form: 500 kb/s units, bit 7 for CCK (ath11k_mac_bitrate_to_rate) */
+static uint32_t
+legacy_rates(const struct nwlan_bss *b, uint8_t out[16])
+{
+	uint32_t n = 0, l;
+	const uint8_t *d;
+
+	for (uint32_t id = 1; id <= 50; id += 49) {     /* supported rates (1), extended (50) */
+		if (!(d = bss_ie(b, id, &l))) {
+			continue;
+		}
+		for (uint32_t i = 0; i < l && n < 16; i++) {
+			uint32_t r = d[i] & 0x7f;
+			if (r == 0x7f || r == 0) {
+				continue;               /* BSS membership selectors */
+			}
+			bool cck = r == 2 || r == 4 || r == 11 || r == 22;
+			if (cck && !is_2g(b->freq)) {
+				continue;
+			}
+			out[n++] = (uint8_t)(r | (cck ? 0x80 : 0));
+		}
+	}
+	return n;
+}
+
+/* WMI_PEER_ASSOC from the AP's elements (ath11k_peer_assoc_prepare for a 20 MHz HT or legacy peer) */
+static int
+peer_assoc(bool rsn)
+{
+	static uint8_t m[512];
+	uint8_t leg[16], ht[16];
+	uint32_t nleg = legacy_rates(&J.bss, leg), nht = 0, l = 0;
+	const uint8_t *htc = bss_ie(&J.bss, 45, &l);
+	bool has_ht = htc && l >= 19;
+	uint32_t chains = MAX(negroni_wlan_wmi_chains(), 1u), nss = 1;
+	uint32_t flags = PEER_AUTH, rate_caps = 0, ht_caps = 0, max_mpdu = 0, density = 0, phymode;
+	bool ofdm_only = true;
+
+	for (uint32_t i = 0; i < nleg; i++) {
+		ofdm_only = ofdm_only && !(leg[i] & 0x80);
+	}
+	if (has_ht) {
+		uint32_t cap = htc[0] | htc[1] << 8, ampdu = htc[2];
+		ht_caps = cap & ~(0x20u | 0x40u);       /* SGI bits cleared, RC_SGI instead (default GI) */
+		max_mpdu = (1u << (13 + (ampdu & 3))) - 1;
+		density = mpdu_density((ampdu >> 2) & 7);
+		rate_caps |= RC_HT_FLAG;
+		if (cap & 0x20) {
+			rate_caps |= RC_SGI_FLAG;
+		}
+		if (cap & 0x1) {
+			flags |= PEER_LDPC;
+		}
+		for (uint32_t i = 0; i < 8 * MIN(chains, 2u); i++) {
+			if (htc[3 + i / 8] & (1u << (i % 8))) {
+				ht[nht++] = (uint8_t)i;
+				nss = MAX(nss, i / 8 + 1);
+			}
+		}
+		if (htc[4] && chains >= 2) {
+			rate_caps |= RC_DS_FLAG;
+		}
+		if (nht == 0) {                         /* ath11k: MCS 0-7 are mandatory */
+			for (nht = 0; nht < 8; nht++) {
+				ht[nht] = (uint8_t)nht;
+			}
+		}
+		flags |= PEER_HT;
+	}
+	if (bss_wmm(&J.bss)) {
+		flags |= PEER_QOS;                      /* is_wme_set + qos_flag */
+	} else {
+		flags &= ~(PEER_HT | PEER_LDPC);        /* ath11k sets HT flags only with WME */
+	}
+	if (rsn) {
+		flags |= PEER_NEED_PTK_4_WAY;
+		flags &= ~PEER_AUTH;                    /* authorised at key installation (hw crypto) */
+	}
+	if (is_2g(J.bss.freq)) {
+		phymode = has_ht ? MODE_11NG_HT20 : ofdm_only ? MODE_11G : MODE_11B;
+	} else {
+		phymode = has_ht ? MODE_11NA_HT20 : MODE_11A;
+	}
+
+	uint32_t la = (nleg + 3) & ~3u, ha = (nht + 3) & ~3u;
+	uint8_t *p = m;
+	memset(m, 0, sizeof(m));
+	/* wmi_peer_assoc_complete_cmd: hdr, mac(8), then 17 u32 up to num_peer_ht_rates..., see wmi.h */
+	uint8_t *c = p + 4;
+	c = wmac(c, J.bss.bssid);
+	c = w32(c, 0);                          /* vdev_id */
+	c = w32(c, 1);                          /* peer_new_assoc */
+	c = w32(c, J.assoc_aid);                /* peer_associd */
+	c = w32(c, flags);
+	c = w32(c, J.assoc_capab);              /* peer_caps */
+	c = w32(c, 10);                         /* peer_listen_intval (our ASSOC REQ) */
+	c = w32(c, ht_caps);
+	c = w32(c, max_mpdu);
+	c = w32(c, density);
+	c = w32(c, rate_caps);
+	c = w32(c, nss);
+	c = w32(c, 0);                          /* peer_vht_caps */
+	c = w32(c, phymode);
+	c = w32(c, 0);                          /* peer_ht_info[0] */
+	c = w32(c, 0);                          /* peer_ht_info[1] */
+	c = w32(c, nleg);
+	c = w32(c, nht);
+	c = w32(c, 0);                          /* peer_bw_rxnss_override */
+	/* wmi_ppe_threshold: numss_m1, ru_count, ppet16_ppet8_ru3_ru0[8] */
+	for (int i = 0; i < 10; i++) {
+		c = w32(c, 0);
+	}
+	c = w32(c, 0);                          /* peer_he_cap_info */
+	c = w32(c, 0);                          /* peer_he_ops */
+	for (int i = 0; i < 3; i++) {
+		c = w32(c, 0);                  /* peer_he_cap_phy[3] */
+	}
+	c = w32(c, 0);                          /* peer_he_mcs */
+	c = w32(c, 0);                          /* peer_he_cap_info_ext */
+	c = w32(c, 0);                          /* peer_he_cap_info_internal */
+	c = w32(c, 0);                          /* min_data_rate */
+	c = w32(c, 0);                          /* peer_he_caps_6ghz */
+	(void)tlv(p, TAG_PEER_ASSOC_COMPLETE_CMD, (uint32_t)(c - p) - 4);
+	p = tlv(c, TAG_ARRAY_BYTE, la);
+	memcpy(p, leg, nleg);
+	p += la;
+	p = tlv(p, TAG_ARRAY_BYTE, ha);
+	memcpy(p, ht, nht);
+	p += ha;
+	p = tlv(p, TAG_VHT_RATE_SET, 20);       /* wmi_vht_rate_set: not VHT capable -> zeroes */
+	p += 20;
+	p = tlv(p, TAG_ARRAY_STRUCT, 0);        /* no HE rate sets */
+	J.assoc_conf = false;
+	int error = negroni_wlan_wmi_send(WMI_PEER_ASSOC_CMDID, m, (uint32_t)(p - m));
+	printf("NEGRONI WLAN: JOIN PEER_ASSOC: AID %u, phymode %u, %u legacy + %u HT rates, nss %u, flags %#x, rate caps %#x, "
+	    "ht caps %#x\n", J.assoc_aid, phymode, nleg, nht, nss, flags, rate_caps, ht_caps);
+	if (!error) {
+		error = negroni_wlan_wmi_wait(&J.assoc_conf, 1000, "PEER_ASSOC_CONF");
+	}
+	return error;
+}
+
+static int
+vdev_up(void)
+{
+	uint8_t m[4 + 8 + 16 + 8];
+	uint8_t *p = tlv(m, TAG_VDEV_UP_CMD, 32);
+	p = w32(p, 0);
+	p = w32(p, J.assoc_aid);
+	p = wmac(p, J.bss.bssid);
+	p = wmac(p, (const uint8_t[6]){ 0 });   /* tx_vdev_bssid */
+	p = w32(p, 0);
+	p = w32(p, 0);
+	return negroni_wlan_wmi_send(WMI_VDEV_UP_CMDID, m, (uint32_t)(p - m));
+}
+
+/* wait for a received frame flag, servicing the chip; false on time-out */
+static bool
+wait_frame(volatile bool *flag, uint32_t ms)
+{
+	uint64_t deadline = negroni_wlan_ms() + ms;
+	while (!*flag) {
+		if (negroni_wlan_service() || negroni_wlan_ms() >= deadline) {
+			return false;
+		}
+		negroni_wlan_nap(2);
+	}
+	return true;
+}
+
+static int
+send_auth(void)
+{
+	uint8_t f[24 + 6];
+	uint32_t n = hdr80211(f, 0x00b0, J.bss.bssid, J.bss.bssid);
+	f[n++] = 0; f[n++] = 0;                 /* open system */
+	f[n++] = 1; f[n++] = 0;                 /* transaction 1 */
+	f[n++] = 0; f[n++] = 0;                 /* status */
+	return mgmt_send(f, n);
+}
+
+static int
+send_assoc(const uint8_t *rsn_ie, uint32_t rsn_len)
+{
+	uint8_t f[MGMT_SLOT];
+	uint32_t n = hdr80211(f, 0x0000, J.bss.bssid, J.bss.bssid), l;
+	uint16_t capab = 0x0001 | (J.bss.capab & (0x0020 | 0x0400)) | (rsn_len ? 0x0010 : 0);
+	const uint8_t *d;
+
+	f[n++] = (uint8_t)capab;
+	f[n++] = (uint8_t)(capab >> 8);
+	f[n++] = 10; f[n++] = 0;                /* listen interval */
+	f[n++] = 0;                             /* SSID */
+	f[n++] = J.bss.ssid_len;
+	memcpy(f + n, J.bss.ssid, J.bss.ssid_len);
+	n += J.bss.ssid_len;
+	for (uint32_t id = 1; id <= 50; id += 49) {     /* rates as the AP announces them */
+		if ((d = bss_ie(&J.bss, id, &l)) && l <= 255) {
+			f[n++] = (uint8_t)id;
+			f[n++] = (uint8_t)l;
+			memcpy(f + n, d, l);
+			n += l;
+		}
+	}
+	if (rsn_len && rsn_len + 2 <= 64) {
+		f[n++] = 48;
+		f[n++] = (uint8_t)rsn_len;
+		memcpy(f + n, rsn_ie, rsn_len);
+		n += rsn_len;
+	}
+	if (bss_ie(&J.bss, 45, &l) && bss_wmm(&J.bss)) {
+		/* HT capabilities (9.4.2.56): LDPC, SM PS disabled, SGI 20; A-MPDU 64 KiB; MCS 0-7 (0-15 with 2 chains) */
+		uint16_t cap = 0x0001 | 0x000c | 0x0020;
+		memset(f + n, 0, 28);
+		f[n] = 45;
+		f[n + 1] = 26;
+		f[n + 2] = (uint8_t)cap;
+		f[n + 3] = (uint8_t)(cap >> 8);
+		f[n + 4] = 0x03;                        /* max A-MPDU exponent 3, no density restriction */
+		f[n + 5] = 0xff;                        /* rx MCS bitmask: MCS 0-7 */
+		f[n + 6] = negroni_wlan_wmi_chains() >= 2 ? 0xff : 0x00;
+		f[n + 17] = 0x01;                       /* tx MCS set defined (byte 12 of the MCS set) */
+		n += 28;
+	}
+	if (bss_wmm(&J.bss)) {
+		static const uint8_t wmm[9] = { 221, 7, 0x00, 0x50, 0xf2, 2, 0, 1, 0 };
+		memcpy(f + n, wmm, sizeof(wmm));
+		n += sizeof(wmm);
+	}
+	return mgmt_send(f, n);
+}
+
+static int
+send_deauth(uint16_t reason)
+{
+	uint8_t f[26];
+	uint32_t n = hdr80211(f, 0x00c0, J.bss.bssid, J.bss.bssid);
+	f[n++] = (uint8_t)reason;
+	f[n++] = (uint8_t)(reason >> 8);
+	return mgmt_send(f, n);
+}
+
+/* everything down, back to IDLE (ath11k bss_disassoc + peer delete + vdev stop) */
+static void
+join_down(int error, uint16_t reason, const char *why)
+{
+	negroni_wlan_wpa_reset();                       /* 0329: keys and handshake state */
+	negroni_wlan_dp_link_down();                   /* 0328 */
+	if (J.up) {
+		(void)vdev_simple(WMI_VDEV_DOWN_CMDID, TAG_VDEV_DOWN_CMD, "VDEV_DOWN");
+	}
+	/* ath11k station_remove with vdev_start_delay: stop the vdev early, then delete the peer */
+	if (J.vdev_started) {
+		J.stopped = false;
+		if (!vdev_simple(WMI_VDEV_STOP_CMDID, TAG_VDEV_STOP_CMD, "VDEV_STOP")) {
+			(void)negroni_wlan_wmi_wait(&J.stopped, 3000, "VDEV_STOPPED");
+		}
+	}
+	if (J.peer) {
+		J.peer_deleted = false;
+		if (!peer_cmd(WMI_PEER_DELETE_CMDID, TAG_PEER_DELETE_CMD, false)) {
+			(void)negroni_wlan_wmi_wait(&J.peer_deleted, 3000, "PEER_DELETE_RESP");
+		}
+	}
+	printf("NEGRONI WLAN: JOIN down: %s (error %d, 802.11 code %u)\n", why, error, reason);
+	J.up = J.peer = J.vdev_started = J.active = false;
+	negroni_wlan_sta_set_link(NULL, NWLAN_STATE_IDLE, error, reason, 0);
+}
+
+/* the whole join, on the driver thread (top level) */
+static void
+join_run(const uint8_t *ssid, uint32_t ssid_len, const char *psk, uint32_t psk_len)
+{
+	int error;
+	bool rsn = psk_len != 0;
+
+	if (!negroni_wlan_sta_find(ssid, ssid_len, &J.bss)) {
+		printf("NEGRONI WLAN: JOIN: SSID not in the list; scanning\n");
+		negroni_wlan_sta_set_link(NULL, NWLAN_STATE_SCANNING, 0, 0, 0);
+		if (negroni_wlan_wmi_scan_start() == 0) {
+			uint64_t deadline = negroni_wlan_ms() + 30000;
+			while (negroni_wlan_sta_state() == NWLAN_STATE_SCANNING && negroni_wlan_ms() < deadline) {
+				if (negroni_wlan_service()) {
+					break;
+				}
+				negroni_wlan_nap(5);
+			}
+		}
+		if (!negroni_wlan_sta_find(ssid, ssid_len, &J.bss)) {
+			negroni_wlan_sta_join_failed(NULL, ENOENT, 0);         /* LINK_DOWN with last_error */
+			printf("NEGRONI WLAN: JOIN: no BSS with that SSID\n");
+			return;
+		}
+	}
+	if ((J.bss.security & (NWLAN_SEC_WEP | NWLAN_SEC_WPA | NWLAN_SEC_WPA2_OTHER)) ||
+	    (rsn != !!(J.bss.security & NWLAN_SEC_WPA2_PSK))) {
+		printf("NEGRONI WLAN: JOIN: BSS security %#x does not match the request (%s)\n", J.bss.security,
+		    rsn ? "WPA2-PSK" : "open");
+		negroni_wlan_sta_join_failed(&J.bss, ENOTSUP, 0);
+		return;
+	}
+	J.active = true;
+	J.lost = false;
+	J.last_beacon_ms = negroni_wlan_ms();
+	negroni_wlan_sta_set_link(&J.bss, NWLAN_STATE_JOINING, 0, 0, 0);
+	printf("NEGRONI WLAN: JOIN %02x:%02x:%02x:xx:xx:xx, %u MHz, RSSI %d dBm, security %#x\n", J.bss.bssid[0],
+	    J.bss.bssid[1], J.bss.bssid[2], J.bss.freq, J.bss.rssi, J.bss.security);
+
+	if (!J.mgmt.nc && (error = negroni_wlan_dma_alloc(MGMT_SLOTS * MGMT_SLOT, &J.mgmt))) {
+		join_down(error, 0, "no DMA buffer for management frames");
+		return;
+	}
+	/* WCN6855 has vdev_start_delay: the BSS peer must exist before VDEV_START (ath11k mac.c assign_vif_chanctx) */
+	if ((error = peer_cmd(WMI_PEER_CREATE_CMDID, TAG_PEER_CREATE_CMD, true))) {
+		join_down(error, 0, "PEER_CREATE not sent");
+		return;
+	}
+	J.peer = true;
+	if ((error = negroni_wlan_dp_wait_peer(J.bss.bssid))) {        /* 0328: HTT peer map + dp peer setup */
+		join_down(error, 0, "peer map / data path peer setup");
+		return;
+	}
+	if ((error = vdev_start(&J.bss))) {
+		join_down(error, 0, "VDEV_START failed");
+		return;
+	}
+	J.vdev_started = true;
+	printf("NEGRONI WLAN: JOIN vdev 0 started on %u MHz\n", J.bss.freq);
+
+	bool ok = false;
+	for (uint32_t t = 0; t < JOIN_TRIES && !ok; t++) {
+		J.auth_rx = false;
+		if ((error = send_auth())) {
+			break;
+		}
+		ok = wait_frame(&J.auth_rx, JOIN_FRAME_MS) && J.auth_status == 0;
+		if (J.auth_rx && J.auth_status != 0) {
+			break;
+		}
+	}
+	printf("NEGRONI WLAN: JOIN AUTH %s (status %u, %u mgmt frames sent, %u completed, %u failed)\n",
+	    ok ? "accepted" : "FAILED", J.auth_rx ? J.auth_status : 0xffff, J.mgmt_sent, J.mgmt_done, J.mgmt_fail);
+	if (!ok) {
+		join_down(error ? error : ETIMEDOUT, J.auth_rx ? J.auth_status : 0, "authentication");
+		return;
+	}
+
+	uint8_t rsn_ie[32];
+	uint32_t rsn_len = rsn ? negroni_wlan_wpa_rsn_ie(rsn_ie, sizeof(rsn_ie)) : 0;   /* 0329 */
+	if (rsn && rsn_len == 0) {
+		join_down(ENOTSUP, 0, "WPA2 not possible with this AP (group cipher)");      /* 0329 */
+		return;
+	}
+	ok = false;
+	for (uint32_t t = 0; t < JOIN_TRIES && !ok; t++) {
+		J.assoc_rx = false;
+		if ((error = send_assoc(rsn_ie, rsn_len))) {
+			break;
+		}
+		ok = wait_frame(&J.assoc_rx, JOIN_FRAME_MS) && J.assoc_status == 0;
+		if (J.assoc_rx && J.assoc_status != 0) {
+			break;
+		}
+	}
+	printf("NEGRONI WLAN: JOIN ASSOC %s (status %u, AID %u, capability %#x)\n", ok ? "accepted" : "FAILED",
+	    J.assoc_rx ? J.assoc_status : 0xffff, J.assoc_aid, J.assoc_capab);
+	if (!ok) {
+		join_down(error ? error : ETIMEDOUT, J.assoc_rx ? J.assoc_status : 0, "association");
+		return;
+	}
+	if ((error = peer_assoc(rsn)) || (error = vdev_up())) {
+		join_down(error, 0, "PEER_ASSOC / VDEV_UP");
+		return;
+	}
+	J.up = true;
+	J.last_beacon_ms = negroni_wlan_ms();
+	(void)vdev_set_param(VDEV_PARAM_DTIM_POLICY, DTIM_POLICY_STICK);
+	(void)sta_ps_off();
+	negroni_wlan_dp_link_up(J.bss.bssid, J.assoc_aid);    /* 0328 */
+	printf("NEGRONI WLAN: JOIN associated (SSID of %u bytes) AID %u\n", J.bss.ssid_len, J.assoc_aid);   /* no SSID in the log */
+	if (rsn) {
+		negroni_wlan_sta_set_link(&J.bss, NWLAN_STATE_HANDSHAKE, 0, 0, J.assoc_aid);
+		negroni_wlan_wpa_start(J.bss.bssid, J.bss.ssid, J.bss.ssid_len, psk, psk_len, rsn_ie, rsn_len);
+		return;
+	}
+	if ((error = negroni_wlan_peer_set_param(J.bss.bssid, PEER_PARAM_AUTHORIZE, 1))) {
+		join_down(error, 0, "PEER AUTHORIZE");
+		return;
+	}
+	negroni_wlan_sta_set_link(&J.bss, NWLAN_STATE_CONNECTED, 0, 0, J.assoc_aid);
+}
+
+/* 0329 calls it when the 4-way handshake ended (keys installed: authorise; else down) */
+void
+negroni_wlan_join_handshake_done(int error, uint16_t reason)
+{
+	if (error) {
+		J.lost = true;
+		J.lost_reason = reason;
+		J.lost_why = "WPA2 handshake";
+		return;
+	}
+	if (negroni_wlan_peer_set_param(J.bss.bssid, PEER_PARAM_AUTHORIZE, 1) == 0) {
+		negroni_wlan_sta_set_link(&J.bss, NWLAN_STATE_CONNECTED, 0, 0, J.assoc_aid);
+	} else {
+		J.lost = true;
+		J.lost_why = "PEER AUTHORIZE";
+	}
+}
+
+const struct nwlan_bss *
+negroni_wlan_join_bss(void)
+{
+	return J.active ? &J.bss : NULL;
+}
+
+/* keep-alive pass (top level) */
+void
+negroni_wlan_sta_join_service(void)
+{
+	bool assoc, disassoc;
+	uint8_t ssid[NWLAN_SSID_MAX];
+	uint32_t ssid_len = 0, psk_len = 0;
+	char psk[NWLAN_PSK_MAX + 1];
+
+	if (negroni_wlan_sta_scanning()) {
+		return;                 /* an API scan runs: requests wait for its end (or its 30 s time-out) */
+	}
+	lck_mtx_lock(&j_mtx);
+	assoc = R.assoc;
+	disassoc = R.disassoc;
+	R.assoc = R.disassoc = false;
+	if (assoc) {
+		ssid_len = R.ssid_len;
+		memcpy(ssid, R.ssid, ssid_len);
+		psk_len = R.psk_len;
+		memcpy(psk, R.psk, sizeof(psk));
+		negroni_wlan_wipe(R.psk, sizeof(R.psk));
+		R.psk_len = 0;
+	}
+	lck_mtx_unlock(&j_mtx);
+
+	if ((disassoc || assoc) && J.active) {
+		if (J.up) {
+			(void)send_deauth(3);           /* leaving */
+		}
+		join_down(0, 3, disassoc ? "disassociate request" : "new associate request");
+	}
+	if (assoc) {
+		negroni_wlan_sta_scan_cancel();        /* a scan request not yet started ends with SCAN_DONE */
+		join_run(ssid, ssid_len, psk_len ? psk : NULL, psk_len);
+		negroni_wlan_wipe(psk, sizeof(psk));
+		return;
+	}
+	if (!J.active) {
+		return;
+	}
+	if (J.up && !J.lost && negroni_wlan_dp_peer_lost()) {
+		J.lost = true;
+		J.lost_why = "HTT PEER_UNMAP of the AP";             /* 0328 review */
+	}
+	if (J.up && !J.lost && negroni_wlan_ms() - J.last_beacon_ms > BEACON_LOSS_MS) {
+		J.lost = true;
+		J.lost_why = "no beacon for 10 s";
+	}
+	if (J.lost) {
+		join_down(ENOTCONN, J.lost_reason, J.lost_why ? J.lost_why : "link lost");
+		return;
+	}
+	negroni_wlan_wpa_service();                    /* 0329: handshake time-outs */
+}
+
+uint32_t
+negroni_wlan_sta_join_caps(void)
+{
+	return NWLAN_CAP_JOIN_OPEN | negroni_wlan_dp_caps() | negroni_wlan_wpa_caps();
+}
+
+/* ---- API ---- */
+int
+negroni_wlan_associate(const uint8_t *ssid, uint32_t ssid_len, const char *psk, uint32_t psk_len)
+{
+	if (!ssid || ssid_len == 0 || ssid_len > NWLAN_SSID_MAX || (psk && psk_len && (psk_len < NWLAN_PSK_MIN ||
+	    psk_len > NWLAN_PSK_MAX))) {
+		return EINVAL;
+	}
+	if (psk && psk_len && !(negroni_wlan_wpa_caps() & NWLAN_CAP_WPA2_PSK)) {
+		return ENOTSUP;
+	}
+	uint32_t st = negroni_wlan_sta_state();
+	if (st < NWLAN_STATE_IDLE || st == NWLAN_STATE_FAILED) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&j_mtx);
+	R.assoc = true;
+	R.ssid_len = ssid_len;
+	memcpy(R.ssid, ssid, ssid_len);
+	negroni_wlan_wipe(R.psk, sizeof(R.psk));
+	R.psk_len = (psk && psk_len) ? psk_len : 0;
+	if (R.psk_len) {
+		memcpy(R.psk, psk, psk_len);
+	}
+	lck_mtx_unlock(&j_mtx);
+	return 0;
+}
+
+int
+negroni_wlan_disassociate(void)
+{
+	lck_mtx_lock(&j_mtx);
+	R.disassoc = true;
+	R.assoc = false;
+	negroni_wlan_wipe(R.psk, sizeof(R.psk));
+	lck_mtx_unlock(&j_mtx);
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_wlan_mhi.c b/bsd/dev/negroni_wlan_mhi.c
new file mode 100644
index 0000000..9aa8643
--- /dev/null
+++ b/bsd/dev/negroni_wlan_mhi.c
@@ -0,0 +1,635 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: MHI host (patch 0261). The READY handshake, context setup, M0, event
+ * ring polling (no MSI: this port has no GICv3 ITS, so the host polls the context read pointers)
+ * and the start of the IPCR channels 20 (host -> device) and 21 (device -> host).
+ *
+ * Order, as Linux does it after the BHI SBL download (op-kernel drivers/bus/mhi/host):
+ *   pm.c mhi_ready_state_transition: MHICTRL RESET clear -> MHISTATUS READY -> mhi_init_mmio ->
+ *   event ring elements + doorbells (mhi_setup_event_rings) -> MHICTRL M0;
+ *   main.c EE event SBL -> pm.c DEV_ST_TRANSITION_SBL -> boot.c mhi_download_amss_image (BHIe);
+ *   EE event AMSS -> mission mode -> channels.
+ *
+ * Context and ring layout from Linux drivers/bus/mhi/host (GPL-2.0) init.c / main.c / pm.c and the
+ * OnePlus kernel copy in out/src/op-kernel; register offsets and field masks confirmed against
+ * drivers/bus/mhi/host/internal.h. We read the layout; we do not copy the code. The caller
+ * (negroni_wlan.c) owns the DMA pool and fills every ring's va / pa / n / ctx before mhi_init.
+ * UNTESTED ON HARDWARE.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include "negroni_wlan_mhi.h"
+
+/* field positions (internal.h): MHICFG NHWER [31:24] NER [23:16], MHICTRL/MHISTATUS MHISTATE [15:8]. */
+#define MHICFG_NER_SHIFT        16
+#define MHICFG_NER_HWER_MASK    0xffff0000u
+#define MHISTATE_SHIFT          8
+#define MHISTATE_MASK           0xffu
+#define CHAN_ENABLED            0x1u            /* chcfg chstate [7:0] */
+#define CHAN_BRST_DISABLE       (0x2u << 8)     /* chcfg brstmode [9:8] = MHI_DB_BRST_DISABLE */
+#define ER_TYPE_VALID           0x1u            /* event ctx ertype */
+#define IPCR_ER_INDEX           1               /* IPCR events on event ring 1 */
+#define CHAN_TYPE_OUT           1               /* DMA_TO_DEVICE */
+#define CHAN_TYPE_IN            2               /* DMA_FROM_DEVICE */
+
+/* Last command completion code seen by the poller (0xff: none yet). One MHI instance. */
+static uint32_t mhi_last_cmd_cc = 0xff;
+
+static inline void
+ctx_set64(volatile uint32_t *lohi, uint64_t v)
+{
+	lohi[0] = (uint32_t)v;
+	lohi[1] = (uint32_t)(v >> 32);
+}
+
+/* host memory (Normal non-cacheable) writes must reach RAM before the doorbell MMIO write */
+static inline void
+mhi_wmb(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * Write a 64-bit doorbell or base register pair at BAR0 offset `off`: high word first, then the
+ * low word, which triggers the doorbell (main.c mhi_write_db, init.c mhi_init_mmio reg_info).
+ */
+static void
+mhi_write64(uint32_t off, uint64_t v)
+{
+	negroni_wlan_wr(off + 4, (uint32_t)(v >> 32));
+	negroni_wlan_wr(off, (uint32_t)v);
+}
+
+/* MHISTATUS: 0 = ok to go on, EIO = SYSERR or a dead link (the error was printed). */
+static int
+mhi_check_status(struct mhi_host *h, const char *during)
+{
+	uint32_t s = negroni_wlan_rd(MHI_STATUS);
+
+	if (s == MHI_ALL_ONES) {
+		printf("NEGRONI WLAN: MHISTATUS reads 0xffffffff while %s (PCIe link down?)\n", during);
+		return negroni_wlan_failed(EIO, "MHISTATUS reads 0xffffffff while %s (PCIe link down)", during);
+	}
+	if ((s & MHI_STATUS_SYSERR) || ((s >> MHISTATE_SHIFT) & MHISTATE_MASK) == MHI_ST_SYS_ERR || h->syserr) {
+		printf("NEGRONI WLAN: MHISTATUS SYSERR %#x while %s\n", s, during);
+		h->syserr = true;
+		return negroni_wlan_failed(EIO, "the chip reports SYSERR (MHISTATUS %#x, EE %u) while %s", s,
+		           h->bhi ? negroni_wlan_rd(h->bhi + BHI_EXECENV) : MHI_ALL_ONES, during);
+	}
+	if (h->rddm_seen) {
+		return negroni_wlan_failed(EIO, "the firmware crashed (EE event RDDM) while %s", during);
+	}
+	return 0;
+}
+
+/*
+ * Wait (time-out h->timeout_ms each) for MHICTRL RESET to clear, then for MHISTATUS READY. The
+ * chip shows READY once the SBL from the BHI download runs (pm.c mhi_ready_state_transition).
+ */
+int
+negroni_wlan_mhi_ready(struct mhi_host *h)
+{
+	uint64_t deadline = negroni_wlan_ms() + h->timeout_ms;
+	uint32_t c, s = 0;
+
+	do {
+		c = negroni_wlan_rd(MHI_CTRL);
+		if (c != MHI_ALL_ONES && !(c & MHI_CTRL_RESET)) {
+			break;
+		}
+		delay(1000);
+	} while (negroni_wlan_ms() < deadline);
+	if (c == MHI_ALL_ONES || (c & MHI_CTRL_RESET)) {
+		printf("NEGRONI WLAN: MHICTRL RESET never cleared (%#x)\n", c);
+		return negroni_wlan_failed(ETIMEDOUT, "MHICTRL RESET did not clear in %u ms (MHICTRL %#x)", h->timeout_ms, c);
+	}
+
+	/*
+	 * 0339: cnss2 waits up to 3 x (perf) or 6 x the MHI time-out during power-on (pci.c:1775-1780) and dumps the boot
+	 * registers every few seconds: wait MAX(negroniwlan_to, 30 s) here, a BOOT dump every 3 s and at the end.
+	 */
+	uint64_t t0 = negroni_wlan_ms(), next_dump = t0 + 3000;
+	uint32_t wait_ms = MAX(h->timeout_ms, 30000u), last_ee = ~0u;
+	deadline = t0 + wait_ms;
+	do {
+		negroni_wlan_msi_poll("READY wait");   /* 0344 */
+		if (mhi_check_status(h, "waiting for READY")) {
+			negroni_wlan_boot_dump(h, "SYSERR while waiting for READY");
+			return EIO;
+		}
+		s = negroni_wlan_rd(MHI_STATUS);
+		if (s & MHI_STATUS_READY) {
+			printf("NEGRONI WLAN: MHISTATUS READY (%#x) after %llu ms, execution environment %u\n", s, negroni_wlan_ms() - t0,
+			    negroni_wlan_rd(h->bhi + BHI_EXECENV));
+			return 0;
+		}
+		uint32_t ee = negroni_wlan_rd(h->bhi + BHI_EXECENV);
+		if (ee != last_ee) {
+			printf("NEGRONI WLAN: waiting for READY: execution environment %u after %llu ms\n", ee, negroni_wlan_ms() - t0);
+			last_ee = ee;
+		}
+		if (negroni_wlan_ms() >= next_dump) {
+			negroni_wlan_boot_dump(h, "waiting for READY");
+			next_dump += 3000;
+		}
+		delay(1000);
+	} while (negroni_wlan_ms() < deadline);
+	negroni_wlan_boot_dump(h, "READY time-out");
+	printf("NEGRONI WLAN: MHISTATUS never READY (%#x)\n", s);
+	return negroni_wlan_failed(ETIMEDOUT, "MHISTATUS not READY in %u ms (%#x, EE %u)", wait_ms, s,
+	           negroni_wlan_rd(h->bhi + BHI_EXECENV));
+}
+
+/*
+ * Program the device contexts and the MHI MMIO base pointers (init.c mhi_init_mmio). Runs after
+ * READY. The channel contexts stay zero (disabled) here; negroni_wlan_mhi_start_ipcr enables
+ * 20/21. Event and command rings get their base, length and pointers.
+ */
+int
+negroni_wlan_mhi_init(struct mhi_host *h)
+{
+	uint64_t ch_ctx_pa, ev_ctx_pa, cmd_ctx_pa;
+
+	h->chdb = negroni_wlan_rd(MHI_CHDBOFF);
+	h->erdb = negroni_wlan_rd(MHI_ERDBOFF);
+	/* init.c: CHDBOFF < reg_len - 8 * 127 (wake doorbell), ERDBOFF < reg_len - 8 * NER */
+	if ((h->chdb & 3) || h->chdb >= h->bar_len || h->bar_len - h->chdb < 8 * MHI_MAX_CH ||
+	    (h->erdb & 3) || h->erdb >= h->bar_len || h->bar_len - h->erdb < 8 * MHI_EV_RINGS) {
+		printf("NEGRONI WLAN: doorbell offsets out of range: chdboff %#x erdboff %#x (BAR0 %#x bytes)\n",
+		    h->chdb, h->erdb, h->bar_len);
+		return negroni_wlan_failed(ERANGE, "doorbell offsets chdboff %#x erdboff %#x outside BAR0", h->chdb, h->erdb);
+	}
+
+	/* context array base addresses (ch_out.ctx sits at channel index 20 of the channel array). */
+	ch_ctx_pa = h->pool_pa + ((vm_offset_t)h->ch_out.ctx - MHI_IPCR_OUT * sizeof(struct mhi_ctx) - h->pool);
+	ev_ctx_pa = h->pool_pa + ((vm_offset_t)h->ev[0].ctx - h->pool);
+	cmd_ctx_pa = h->pool_pa + ((vm_offset_t)h->cmd.ctx - h->pool);
+
+	for (uint32_t i = 0; i < MHI_EV_RINGS; i++) {
+		volatile struct mhi_ctx *c = h->ev[i].ctx;
+
+		c->w0 = 0;                      /* intmod: no moderation (polling) */
+		c->w1 = ER_TYPE_VALID;
+		c->w2 = negroni_wlan_msi_on() ? i + 1 : 0;      /* msivec; 0344: ath11k MHI irq 1, 2 when MSI is on */
+		ctx_set64(c->rbase, h->ev[i].pa);
+		ctx_set64(c->rlen, (uint64_t)h->ev[i].n * sizeof(struct mhi_el));
+		ctx_set64(c->rp, h->ev[i].pa);
+		ctx_set64(c->wp, h->ev[i].pa);
+		h->ev[i].rp = 0;
+		h->ev[i].wp = 0;
+		h->ev[i].db = h->erdb + i * 8;
+	}
+
+	h->cmd.ctx->w0 = h->cmd.ctx->w1 = h->cmd.ctx->w2 = 0;
+	ctx_set64(h->cmd.ctx->rbase, h->cmd.pa);
+	ctx_set64(h->cmd.ctx->rlen, (uint64_t)h->cmd.n * sizeof(struct mhi_el));
+	ctx_set64(h->cmd.ctx->rp, h->cmd.pa);
+	ctx_set64(h->cmd.ctx->wp, h->cmd.pa);
+	h->cmd.rp = h->cmd.wp = 0;
+
+	h->ch_out.db = h->chdb + MHI_IPCR_OUT * 8;
+	h->ch_in.db = h->chdb + MHI_IPCR_IN * 8;
+	h->wake_db = h->chdb + MHI_WAKE_DB * 8;
+
+	mhi_wmb();
+
+	/* device wake de-asserted (init.c), then the MMIO base pointers (high word first). */
+	mhi_write64(h->wake_db, 0);
+	mhi_write64(MHI_CCABAP, ch_ctx_pa);
+	mhi_write64(MHI_ECABAP, ev_ctx_pa);
+	mhi_write64(MHI_CRCBAP, cmd_ctx_pa);
+	uint32_t cfg = negroni_wlan_rd(MHI_CFG);
+	cfg = (cfg & ~MHICFG_NER_HWER_MASK) | (MHI_EV_RINGS << MHICFG_NER_SHIFT);   /* NER 2, NHWER 0 */
+	negroni_wlan_wr(MHI_CFG, cfg);
+	/*
+	 * The device may DMA only inside CTRL/DATA base..limit. cnss2 without an SMMU uses 0 .. the
+	 * 36-bit DMA mask (op-kernel cnss2/pci.c:5509-5510); patch 0263 does the same, because the
+	 * QRTR buffers and the QMI firmware memory (stages 4-6) are separate allocations.
+	 */
+	uint64_t wbase = 0, wlimit = MHI_DMA_MASK;
+	(void)negroni_wlan_smmu_window(&wbase, &wlimit);       /* 0325: with the SMMU, the IOVA window (cnss2 pci.c:5505) */
+	mhi_write64(MHI_CTRLBASE, wbase);
+	mhi_write64(MHI_DATABASE, wbase);
+	mhi_write64(MHI_CTRLLIMIT, wlimit);
+	mhi_write64(MHI_DATALIMIT, wlimit);
+	h->mmio_set = true;
+	printf("NEGRONI WLAN: MHI ctx ch %#llx ev %#llx cmd %#llx, chdboff %#x erdboff %#x, window %#llx-%#llx\n",
+	    ch_ctx_pa, ev_ctx_pa, cmd_ctx_pa, h->chdb, h->erdb, wbase, wlimit);
+	return 0;
+}
+
+/* Read the device write pointer of event ring `i` as an element index. */
+static uint32_t
+ev_dev_idx(struct mhi_host *h, uint32_t i)
+{
+	uint64_t rp = (uint64_t)h->ev[i].ctx->rp[0] | ((uint64_t)h->ev[i].ctx->rp[1] << 32);
+	uint64_t len = (uint64_t)h->ev[i].n * sizeof(struct mhi_el);
+
+	if (rp < h->ev[i].pa || rp >= h->ev[i].pa + len || ((rp - h->ev[i].pa) % sizeof(struct mhi_el))) {
+		return h->ev[i].rp;     /* out of range: nothing new */
+	}
+	return (uint32_t)((rp - h->ev[i].pa) / sizeof(struct mhi_el));
+}
+
+/* Ring channel `ch`'s doorbell with its current write index (main.c mhi_ring_chan_db). */
+static void
+mhi_ring_chan(struct mhi_ring *ch)
+{
+	uint64_t wp_pa = ch->pa + (uint64_t)ch->wp * sizeof(struct mhi_el);
+
+	ctx_set64(ch->ctx->wp, wp_pa);
+	mhi_wmb();
+	mhi_write64(ch->db, wp_pa);
+}
+
+/* Put RX buffer `buf` on channel 21 (inbound, EOT) at the write index; no doorbell. */
+static void
+mhi_rx_queue(struct mhi_host *h, uint32_t buf)
+{
+	struct mhi_ring *ch = &h->ch_in;
+	volatile struct mhi_el *el = &ch->va[ch->wp];
+
+	el->ptr = h->xfer_pa + (uint64_t)buf * WLAN_RX_LEN;
+	el->dw0 = WLAN_RX_LEN;
+	el->dw1 = MHI_TRE_DW1_EOT;
+	h->in_slot_buf[ch->wp] = (uint8_t)buf;
+	ch->wp = (ch->wp + 1) % ch->n;
+}
+
+/*
+ * A transfer event (main.c parse_xfer_event): `ptr` is the last TRE the device completed; every
+ * TRE from the local read index up to it is done. Inbound: hand the data to h->rx_cb, then put the
+ * buffer back (cnss2 auto_queue). Outbound: free the TX buffer.
+ */
+static void
+mhi_xfer_event(struct mhi_host *h, uint64_t ptr, uint32_t dw0, uint32_t dw1)
+{
+	uint32_t chid = (dw1 >> 24) & 0xff, code = (dw0 >> 24) & 0xff, len = dw0 & 0xffff;
+	struct mhi_ring *ch = chid == MHI_IPCR_IN ? &h->ch_in : chid == MHI_IPCR_OUT ? &h->ch_out : NULL;
+	uint64_t span;
+
+	if (!ch || !h->ch_started) {
+		h->xfer_errors++;
+		return;
+	}
+	if (code == MHI_EV_CC_DB_MODE) {        /* the device asks for a doorbell (DB mode) */
+		mhi_ring_chan(ch);
+		return;
+	}
+	span = (uint64_t)ch->n * sizeof(struct mhi_el);
+	if (ptr < ch->pa || ptr >= ch->pa + span || ((ptr - ch->pa) % sizeof(struct mhi_el)) ||
+	    (code != MHI_EV_CC_EOT && code != MHI_EV_CC_EOB && code != MHI_EV_CC_OVERFLOW)) {
+		if (h->xfer_errors++ < 4) {
+			printf("NEGRONI WLAN: channel %u transfer event code %#x ptr %#llx ignored\n", chid, code, ptr);
+		}
+		return;
+	}
+	uint32_t last = (uint32_t)((ptr - ch->pa) / sizeof(struct mhi_el));
+	uint32_t guard = ch->n;
+	bool requeued = false;
+
+	__asm__ volatile ("dmb ld" ::: "memory");       /* event before the data it describes */
+	while (guard--) {
+		uint32_t slot = ch->rp;
+		bool is_last = slot == last;
+
+		if (ch == &h->ch_in) {
+			uint32_t buf = h->in_slot_buf[slot];
+			uint32_t n = is_last ? MIN(len, WLAN_RX_LEN) : WLAN_RX_LEN;
+
+			if (code == MHI_EV_CC_OVERFLOW) {
+				h->rx_overflow++;
+			}
+			h->rx_packets++;
+			if (h->rx_cb && buf < WLAN_RX_N) {
+				h->rx_cb(h, (const void *)(h->xfer_nc + (vm_offset_t)buf * WLAN_RX_LEN), n);
+			}
+			if (buf < WLAN_RX_N) {
+				mhi_rx_queue(h, buf);
+				requeued = true;
+			}
+		} else {
+			uint32_t buf = h->out_slot_buf[slot];
+
+			if (buf < WLAN_TX_N) {
+				h->tx_busy[buf] = false;
+			}
+			h->tx_done++;
+		}
+		ch->rp = (slot + 1) % ch->n;
+		if (is_last) {
+			break;
+		}
+	}
+	if (requeued) {
+		mhi_ring_chan(ch);
+	}
+}
+
+/*
+ * Drain both event rings. The device is the producer; the host consumes from its local read
+ * index up to the device write pointer (the context rp, updated by the device in host RAM).
+ * State-change and EE events update the MHI host state; command completions set
+ * mhi_last_cmd_cc. Each consumed element goes back to the device (main.c
+ * mhi_recycle_ev_ring_element + mhi_ring_er_db). Returns the number of events processed.
+ */
+int
+negroni_wlan_mhi_poll(struct mhi_host *h)
+{
+	int done = 0;
+
+	for (uint32_t i = 0; i < MHI_EV_RINGS; i++) {
+		struct mhi_ring *r = &h->ev[i];
+		uint32_t dev = ev_dev_idx(h, i);
+		bool moved = false;
+
+		/* the context rp read must complete before the element reads (Normal NC memory) */
+		__asm__ volatile ("dmb ld" ::: "memory");
+		while (r->rp != dev) {
+			volatile struct mhi_el *el = &r->va[r->rp];
+			uint32_t type = (el->dw1 >> 16) & 0xff;
+			uint32_t code = (el->dw0 >> 24) & 0xff;
+
+			switch (type) {
+			case MHI_PKT_STATE_CHANGE:
+				h->state = code;
+				if (code == MHI_ST_SYS_ERR) {
+					h->syserr = true;
+				} else if (code == MHI_ST_M1 && h->mmio_set) {
+					/*
+					 * pm.c:334-363 mhi_pm_m1_transition (0320 fix): write MHISTATE M2, then,
+					 * because device wake is held, wake_get(force) + wake_put: the wake
+					 * doorbell is written 1 again and never 0 (the count stays above 0).
+					 */
+					uint32_t ctrl = negroni_wlan_rd(MHI_CTRL);
+					ctrl = (ctrl & ~(MHISTATE_MASK << MHISTATE_SHIFT)) | (MHI_ST_M2 << MHISTATE_SHIFT);
+					negroni_wlan_wr(MHI_CTRL, ctrl);
+					mhi_write64(h->wake_db, 1);
+					if (h->m1_seen++ == 0) {
+						printf("NEGRONI WLAN: device entered M1; host wrote M2 and device wake 1 (pm.c:341-359)\n");
+					}
+				}
+				break;
+			case MHI_PKT_EE_EVENT:
+				h->ee = code;
+				if (code == MHI_EE_SBL) {
+					h->sbl_seen = true;
+				} else if (code == MHI_EE_AMSS) {
+					h->amss_seen = true;
+				} else if (code == MHI_EE_RDDM) {
+					h->rddm_seen = true;
+				}
+				break;
+			case MHI_PKT_CMD_DONE:
+				mhi_last_cmd_cc = code;
+				break;
+			case MHI_PKT_TX_EVENT:
+				mhi_xfer_event(h, el->ptr, el->dw0, el->dw1);
+				break;
+			default:
+				break;
+			}
+			h->events++;
+			done++;
+			r->rp = (r->rp + 1) % r->n;
+			moved = true;
+		}
+		if (moved) {
+			uint32_t wp = (r->rp + r->n - 1) % r->n;
+			uint64_t wp_pa = r->pa + (uint64_t)wp * sizeof(struct mhi_el);
+
+			ctx_set64(r->ctx->wp, wp_pa);
+			r->wp = wp;
+			mhi_wmb();
+			mhi_write64(r->db, wp_pa);
+		}
+	}
+	return done;
+}
+
+/*
+ * Give the event rings to the device, request M0 and wait for MHISTATE M0, then assert device
+ * wake (pm.c mhi_ready_state_transition tail + mhi_pm_m0_transition wake_get).
+ */
+int
+negroni_wlan_mhi_m0(struct mhi_host *h)
+{
+	uint64_t deadline;
+	uint32_t s = 0;
+
+	/* mhi_setup_event_rings(add_el): host wp = the last element, in the context and the doorbell */
+	for (uint32_t i = 0; i < MHI_EV_RINGS; i++) {
+		struct mhi_ring *r = &h->ev[i];
+		uint64_t wp_pa = r->pa + (uint64_t)(r->n - 1) * sizeof(struct mhi_el);
+
+		r->wp = r->n - 1;
+		ctx_set64(r->ctx->wp, wp_pa);
+		mhi_wmb();
+		mhi_write64(r->db, wp_pa);
+	}
+
+	uint32_t ctrl = negroni_wlan_rd(MHI_CTRL);
+	ctrl = (ctrl & ~(MHISTATE_MASK << MHISTATE_SHIFT)) | (MHI_ST_M0 << MHISTATE_SHIFT);
+	negroni_wlan_wr(MHI_CTRL, ctrl);
+
+	deadline = negroni_wlan_ms() + h->timeout_ms;
+	do {
+		(void)negroni_wlan_mhi_poll(h);
+		if (mhi_check_status(h, "waiting for M0")) {
+			return EIO;
+		}
+		s = (negroni_wlan_rd(MHI_STATUS) >> MHISTATE_SHIFT) & MHISTATE_MASK;
+		if (s == MHI_ST_M0) {
+			h->state = MHI_ST_M0;
+			mhi_write64(h->wake_db, 1);     /* keep the device in M0 (no M1/M2 during stage 1) */
+			printf("NEGRONI WLAN: MHI state M0, device wake asserted\n");
+			return 0;
+		}
+		delay(1000);
+	} while (negroni_wlan_ms() < deadline);
+	printf("NEGRONI WLAN: MHI never reached M0 (MHISTATE %#x)\n", s);
+	return negroni_wlan_failed(ETIMEDOUT, "MHISTATE %#x, not M0 after %u ms", s, h->timeout_ms);
+}
+
+/*
+ * Wait for execution environment `target`: either its EE event on an event ring (how Linux learns
+ * it, main.c MHI_PKT_TYPE_EE_EVENT) or BHI_EXECENV (mhi_get_exec_env). Stops on SYSERR.
+ */
+int
+negroni_wlan_mhi_wait_ee(struct mhi_host *h, uint32_t target, const char *name)
+{
+	uint64_t deadline = negroni_wlan_ms() + h->timeout_ms;
+	uint32_t ee = MHI_ALL_ONES;
+
+	do {
+		if (h->mmio_set) {
+			(void)negroni_wlan_mhi_poll(h);
+		}
+		if (mhi_check_status(h, name)) {
+			return EIO;
+		}
+		ee = negroni_wlan_rd(h->bhi + BHI_EXECENV);
+		bool by_event = (target == MHI_EE_SBL && h->sbl_seen) || (target == MHI_EE_AMSS && h->amss_seen);
+		if (ee == target || by_event) {
+			printf("NEGRONI WLAN: execution environment %s (%u, seen in %s)\n", name, target,
+			    ee == target ? "BHI_EXECENV" : "an EE event");
+			return 0;
+		}
+		delay(1000);
+	} while (negroni_wlan_ms() < deadline);
+	printf("NEGRONI WLAN: never reached %s, execution environment stuck at %u\n", name, ee);
+	return negroni_wlan_failed(ETIMEDOUT, "execution environment %u, not %s after %u ms (events %u)", ee, name,
+	           h->timeout_ms, h->events);
+}
+
+/* Enable one channel context and issue a START_CHAN command, then wait for its completion. */
+static int
+mhi_start_chan(struct mhi_host *h, uint32_t chid, struct mhi_ring *ch, uint32_t type)
+{
+	volatile struct mhi_el *cmd;
+	uint64_t deadline;
+
+	ch->ctx->w0 = CHAN_ENABLED | CHAN_BRST_DISABLE;
+	ch->ctx->w1 = type;
+	ch->ctx->w2 = IPCR_ER_INDEX;
+	ctx_set64(ch->ctx->rbase, ch->pa);
+	ctx_set64(ch->ctx->rlen, (uint64_t)ch->n * sizeof(struct mhi_el));
+	ctx_set64(ch->ctx->rp, ch->pa);
+	ctx_set64(ch->ctx->wp, ch->pa);
+	ch->rp = ch->wp = 0;
+
+	cmd = &h->cmd.va[h->cmd.wp];
+	cmd->ptr = 0;
+	cmd->dw0 = 0;
+	cmd->dw1 = (chid << 24) | (MHI_PKT_START_CHAN << 16);
+	h->cmd.wp = (h->cmd.wp + 1) % h->cmd.n;
+	ctx_set64(h->cmd.ctx->wp, h->cmd.pa + (uint64_t)h->cmd.wp * sizeof(struct mhi_el));
+
+	mhi_last_cmd_cc = 0xff;
+	mhi_wmb();
+	mhi_write64(MHI_CRDB, h->cmd.pa + (uint64_t)h->cmd.wp * sizeof(struct mhi_el));
+
+	deadline = negroni_wlan_ms() + h->timeout_ms;
+	do {
+		(void)negroni_wlan_mhi_poll(h);
+		if (mhi_last_cmd_cc != 0xff) {
+			break;
+		}
+		if (mhi_check_status(h, "starting a channel")) {
+			return EIO;
+		}
+		delay(1000);
+	} while (negroni_wlan_ms() < deadline);
+
+	if (mhi_last_cmd_cc == MHI_EV_CC_SUCCESS) {
+		printf("NEGRONI WLAN: channel %u started\n", chid);
+		return 0;
+	}
+	if (mhi_last_cmd_cc == 0xff) {
+		printf("NEGRONI WLAN: channel %u start timed out after %u ms (no command completion)\n",
+		    chid, h->timeout_ms);
+		return negroni_wlan_failed(ETIMEDOUT, "no START_CHAN %u completion in %u ms", chid, h->timeout_ms);
+	}
+	printf("NEGRONI WLAN: channel %u start failed, completion code %#x\n", chid, mhi_last_cmd_cc);
+	return negroni_wlan_failed(EIO, "START_CHAN %u completion code %#x", chid, mhi_last_cmd_cc);
+}
+
+/* Start the IPCR channels (20 out, 21 in). QRTR/QMI buffers are stage 2. */
+int
+negroni_wlan_mhi_start_ipcr(struct mhi_host *h)
+{
+	int error = mhi_start_chan(h, MHI_IPCR_OUT, &h->ch_out, CHAN_TYPE_OUT);
+
+	if (!error) {
+		error = mhi_start_chan(h, MHI_IPCR_IN, &h->ch_in, CHAN_TYPE_IN);
+	}
+	if (error) {
+		return error;
+	}
+	h->ch_started = true;
+	/* 0264: inbound buffers after START_CHAN (main.c mhi_prepare_channel, auto_queue) */
+	if (h->xfer_nc) {
+		for (uint32_t i = 0; i < WLAN_TX_N; i++) {
+			h->tx_busy[i] = false;
+		}
+		for (uint32_t i = 0; i < WLAN_RX_N; i++) {
+			mhi_rx_queue(h, i);
+		}
+		mhi_ring_chan(&h->ch_in);
+		printf("NEGRONI WLAN: channel 21: %u RX buffers of %u bytes at %#llx\n", WLAN_RX_N, WLAN_RX_LEN,
+		    h->xfer_pa);
+	}
+	return 0;
+}
+
+/*
+ * Send one IPCR packet on channel 20 (qrtr mhi.c qcom_mhi_qrtr_send: one MHI_EOT transfer per
+ * QRTR packet). Waits (polling) for a free TX buffer. The data is copied; returns at once.
+ */
+int
+negroni_wlan_mhi_tx(struct mhi_host *h, const void *data, uint32_t len)
+{
+	struct mhi_ring *ch = &h->ch_out;
+	uint64_t deadline = negroni_wlan_ms() + h->timeout_ms;
+	uint32_t buf = ~0u;
+
+	if (!h->ch_started || !h->xfer_nc) {
+		return negroni_wlan_failed(ENXIO, "TX before the IPCR channels started");
+	}
+	if (len == 0 || len > WLAN_TX_LEN) {
+		return negroni_wlan_failed(ERANGE, "TX packet of %u bytes (max %u)", len, WLAN_TX_LEN);
+	}
+	for (;;) {
+		for (uint32_t k = 0; k < WLAN_TX_N; k++) {
+			uint32_t i = (h->tx_next + k) % WLAN_TX_N;
+			if (!h->tx_busy[i]) {
+				buf = i;
+				break;
+			}
+		}
+		/* keep one ring slot empty: wp + 1 == rp means full */
+		if (buf != ~0u && (ch->wp + 1) % ch->n != ch->rp) {
+			break;
+		}
+		buf = ~0u;
+		(void)negroni_wlan_mhi_poll(h);
+		if (h->syserr || negroni_wlan_ms() >= deadline) {
+			return negroni_wlan_failed(ETIMEDOUT, "no free TX buffer on channel 20 in %u ms (sent %u, done %u)",
+			           h->timeout_ms, h->tx_packets, h->tx_done);
+		}
+		delay(1000);
+	}
+	vm_offset_t va = h->xfer_nc + (vm_offset_t)WLAN_RX_N * WLAN_RX_LEN + (vm_offset_t)buf * WLAN_TX_LEN;
+	uint64_t pa = h->xfer_pa + (uint64_t)WLAN_RX_N * WLAN_RX_LEN + (uint64_t)buf * WLAN_TX_LEN;
+	volatile struct mhi_el *el = &ch->va[ch->wp];
+
+	memcpy((void *)va, data, len);
+	h->tx_busy[buf] = true;
+	h->tx_next = (buf + 1) % WLAN_TX_N;
+	h->out_slot_buf[ch->wp] = (uint8_t)buf;
+	el->ptr = pa;
+	el->dw0 = len;
+	el->dw1 = MHI_TRE_DW1_EOT;
+	ch->wp = (ch->wp + 1) % ch->n;
+	h->tx_packets++;
+	mhi_ring_chan(ch);
+	return 0;
+}
+
+/* Failure path: drop device wake and set MHICTRL RESET (pm.c power-down), so the chip stops MHI. */
+void
+negroni_wlan_mhi_reset(struct mhi_host *h)
+{
+	if (h->mmio_set) {
+		mhi_write64(h->wake_db, 0);
+	}
+	uint32_t ctrl = negroni_wlan_rd(MHI_CTRL);
+	if (ctrl != MHI_ALL_ONES) {
+		negroni_wlan_wr(MHI_CTRL, ctrl | MHI_CTRL_RESET);
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_wlan_mhi.h b/bsd/dev/negroni_wlan_mhi.h
new file mode 100644
index 0000000..5c72617
--- /dev/null
+++ b/bsd/dev/negroni_wlan_mhi.h
@@ -0,0 +1,251 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: MHI host definitions shared by negroni_wlan.c, negroni_wlan_bhi.c and
+ * negroni_wlan_mhi.c (patch 0261). Register layout from Linux drivers/bus/mhi/common.h
+ * (GPL-2.0, Copyright (c) 2022 Linaro Ltd.) and include/linux/mhi.h; values only, no code.
+ */
+#ifndef _NEGRONI_WLAN_MHI_H_
+#define _NEGRONI_WLAN_MHI_H_
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+
+/* MHI registers (BAR0 offsets) */
+#define MHI_REGLEN              0x00
+#define MHI_VER                 0x08
+#define MHI_CFG                 0x10
+#define MHI_CHDBOFF             0x18
+#define MHI_ERDBOFF             0x20
+#define MHI_BHIOFF              0x28
+#define MHI_BHIEOFF             0x2c
+#define MHI_CTRL                0x38
+#define MHI_STATUS              0x48
+#define MHI_CCABAP              0x58    /* low, then high at +4 */
+#define MHI_ECABAP              0x60
+#define MHI_CRCBAP              0x68
+#define MHI_CRDB                0x70
+#define MHI_CTRLBASE            0x80
+#define MHI_CTRLLIMIT           0x88
+#define MHI_DATABASE            0x98
+#define MHI_DATALIMIT           0xa0
+#define MHI_CTRL_RESET          (1u << 1)
+#define MHI_STATUS_READY        (1u << 0)
+#define MHI_STATUS_SYSERR       (1u << 2)
+#define MHI_ALL_ONES            0xffffffffu     /* a read over a dead PCIe link */
+
+/* BHI (offsets from BHIOFF) */
+#define BHI_IMGADDR_LOW         0x08
+#define BHI_IMGADDR_HIGH        0x0c
+#define BHI_IMGSIZE             0x10
+#define BHI_IMGTXDB             0x18
+#define BHI_INTVEC              0x20
+#define BHI_EXECENV             0x28
+#define BHI_STATUS              0x2c
+#define BHI_ERRCODE             0x30
+#define BHI_ERRDBG1             0x34
+#define BHI_SERIALNU            0x40
+
+/* BHIe (offsets from BHIEOFF) */
+#define BHIE_TXVECADDR_LOW      0x2c
+#define BHIE_TXVECADDR_HIGH     0x30
+#define BHIE_TXVECSIZE          0x34
+#define BHIE_TXVECDB            0x3c
+#define BHIE_TXVECSTATUS        0x44
+#define BHI_SEQ_MASK            0x3fffffffu
+#define BHI_ST_DONE             2       /* status field bits 31:30 */
+#define BHI_ST_ERROR            3
+
+/* states and execution environments */
+#define MHI_ST_RESET            0x0
+#define MHI_ST_READY            0x1
+#define MHI_ST_M0               0x2
+#define MHI_ST_M1               0x3
+#define MHI_ST_M2               0x4
+#define MHI_ST_M3               0x5
+#define MHI_ST_SYS_ERR          0xff
+#define MHI_EE_PBL              0
+#define MHI_EE_SBL              1
+#define MHI_EE_AMSS             2
+#define MHI_EE_RDDM             3
+#define MHI_EE_WFW              4
+#define MHI_EE_PTHRU            5
+#define MHI_EE_EDL              6
+
+/* ring element types (dword1 bits 23:16) */
+#define MHI_PKT_TRANSFER        0x02
+#define MHI_PKT_START_CHAN      0x12
+#define MHI_PKT_STATE_CHANGE    0x20
+#define MHI_PKT_CMD_DONE        0x21
+#define MHI_PKT_TX_EVENT        0x22
+#define MHI_PKT_EE_EVENT        0x40
+#define MHI_EV_CC_SUCCESS       0x1
+#define MHI_EV_CC_EOT           0x2
+#define MHI_EV_CC_OVERFLOW      0x3
+#define MHI_EV_CC_EOB           0x4
+#define MHI_EV_CC_DB_MODE       0x6
+/* transfer ring element dword1 (internal.h MHI_TRE_DATA_DWORD1): type 2, IEOT bit 9 */
+#define MHI_TRE_DW1_EOT         ((MHI_PKT_TRANSFER << 16) | (1u << 9))
+
+/* 0264: the IPCR data path. RX buffers like cnss2 (buf_len 0x8000, pci.c:228), TX for QMI <= 6.2 KiB */
+#define WLAN_RX_N               16u
+#define WLAN_RX_LEN             0x8000u
+#define WLAN_TX_N               8u
+#define WLAN_TX_LEN             0x2000u
+#define WLAN_XFER_SIZE          (WLAN_RX_N * WLAN_RX_LEN + WLAN_TX_N * WLAN_TX_LEN)    /* 576 KiB */
+
+/* configuration (Linux ath11k mhi.c ath11k_mhi_config_qca6390) */
+#define MHI_MAX_CH              128
+#define MHI_WAKE_DB             127     /* device-wake doorbell = channel doorbell 127 (internal.h) */
+#define MHI_EV_RINGS            2
+#define MHI_CMD_ELEMENTS        128
+#define MHI_CH_ELEMENTS         64
+#define MHI_IPCR_OUT            20
+#define MHI_IPCR_IN             21
+#define MHI_SEG                 (512u << 10)    /* sbl_size = seg_len */
+#define MHI_DMA_MASK            ((1ull << 36) - 1)
+
+/*
+ * One contiguous DMA pool holds the contexts, rings, firmware image, m3 buffer and BHIe vector
+ * table (negroni_wlan.c owns the byte layout). The size is shared so mhi_init can set the MHI
+ * CTRL/DATA address window (MHICTRLBASE..MHICTRLLIMIT) to the whole pool.
+ */
+#define NEGRONI_WLAN_POOL_SIZE  0x691000u       /* 6.57 MiB, page aligned */
+#define NEGRONI_WLAN_CHCTX_SIZE (MHI_MAX_CH * 44u)      /* full channel context array (5632 B) */
+
+/* host memory structures: little endian, accessed through a Normal non-cacheable mapping */
+struct mhi_el {                 /* ring element, 16 bytes */
+	uint64_t ptr;
+	uint32_t dw0, dw1;
+};
+struct mhi_ctx {                /* channel / event / command context, 44 bytes (packed) */
+	uint32_t w0, w1, w2;    /* chcfg chtype erindex | intmod ertype msivec | reserved */
+	uint32_t rbase[2], rlen[2], rp[2], wp[2];
+} __attribute__((packed, aligned(4)));
+
+/* a host ring: virtual base (non-cacheable), DMA address, size, local pointers */
+struct mhi_ring {
+	volatile struct mhi_el *va;
+	uint64_t pa;
+	uint32_t n;             /* elements */
+	uint32_t rp, wp;        /* element indexes */
+	volatile struct mhi_ctx *ctx;
+	uint32_t db;            /* doorbell BAR0 offset */
+};
+
+/* the MHI host state (negroni_wlan_mhi.c) */
+struct mhi_host {
+	vm_offset_t bar;
+	uint32_t bar_len;       /* mapped BAR0 bytes; every MHI offset is checked against it */
+	uint32_t bhi, bhie, chdb, erdb, wake_db;
+	vm_offset_t pool;       /* non-cacheable view of the DMA pool */
+	uint64_t pool_pa;
+	struct mhi_ring ev[MHI_EV_RINGS], cmd, ch_out, ch_in;
+	uint32_t timeout_ms;
+	uint32_t ee, state;     /* last seen by event */
+	bool sbl_seen, amss_seen, rddm_seen, syserr, ch_started, mmio_set;
+	uint32_t events, m1_seen;
+	/* 0264: IPCR transfer buffers (one contiguous allocation, Normal non-cacheable view) */
+	vm_offset_t xfer_nc;
+	uint64_t xfer_pa;
+	uint8_t in_slot_buf[MHI_CH_ELEMENTS];   /* RX buffer index of each channel-21 ring slot */
+	uint8_t out_slot_buf[MHI_CH_ELEMENTS];  /* TX buffer index of each channel-20 ring slot */
+	bool tx_busy[WLAN_TX_N];
+	uint32_t tx_next;
+	uint32_t rx_packets, tx_packets, tx_done, rx_overflow, xfer_errors;
+	/* called from negroni_wlan_mhi_poll for each received IPCR transfer (data in NC memory) */
+	void (*rx_cb)(struct mhi_host *h, const void *data, uint32_t len);
+};
+
+/*
+ * Stage levels (boot-arg negroniwlan=N runs every level up to N; patch 0263):
+ *   2  steps 1-8:   BAR0, firmware, DMA pool, SMMU/clock check, PBL, BHI SBL download
+ *   3  steps 9-12:  MHI READY, MMIO contexts, M0 + device wake, EE SBL
+ *   4  steps 13-15: BHIe full image, EE AMSS (mission), IPCR channels 20/21
+ *   5  steps 16-17: QRTR HELLO, WLFW service lookup (0265, negroni_wlan_qrtr.c)
+ *   6  steps 18-24: QMI WLFW IND_REGISTER .. FW_INIT_DONE (0266, negroni_wlan_qmi.c)
+ *   7  steps 25-26: QMI WLFW WLAN_CFG (CE pipes, service map, shadow registers) + WLAN_MODE mission (0320)
+ *   8  steps 27-28: CE rings (HAL SRNG, register window, shadow registers), HTC READY (0321)
+ *   9  steps 29-32: HTC connect (HTT, WMI), WMI SERVICE_READY(+EXT), WMI INIT, WMI READY + MAC (0322)
+ *  10  steps 33-35: WMI channel list, VDEV_CREATE STA, passive scan: SSID + RSSI of every BSS (0323)
+ * Each step prints "NEGRONI WLAN: step N NAME" before it starts and, on an error,
+ * "NEGRONI WLAN: step N NAME failed: REASON". Every wait has a time-out (negroniwlan_to).
+ */
+#define WLAN_LEVEL_SBL          2
+#define WLAN_LEVEL_MHI          3
+#define WLAN_LEVEL_AMSS         4
+#define WLAN_LEVEL_QRTR         5       /* 0265 */
+#define WLAN_LEVEL_WLFW         6       /* 0266 */
+#define WLAN_LEVEL_CFG          7       /* 0320 */
+#define WLAN_LEVEL_CE           8       /* 0321 */
+#define WLAN_LEVEL_WMI          9       /* 0322 */
+#define WLAN_LEVEL_SCAN         10      /* 0323 */
+#define WLAN_LEVEL_MAX          10      /* the highest level this build implements */
+/* level 4 (0264) also posts the RX buffers on channel 21 (cnss2 auto_queue, pci.c:181) */
+
+void negroni_wlan_step(uint32_t n, const char *name);
+int negroni_wlan_failed(int error, const char *fmt, ...) __printflike(2, 3);
+
+/* negroni_wlan.c (rd returns MHI_ALL_ONES and wr does nothing for an offset outside BAR0) */
+uint32_t negroni_wlan_rd(uint32_t off);
+void negroni_wlan_wr(uint32_t off, uint32_t v);
+uint64_t negroni_wlan_ms(void);
+uint32_t negroni_wlan_timeout(void);    /* 0321: negroniwlan_to in ms */
+uint32_t negroni_wlan_seq(void);
+/* 0266: one file of the firmware area into dst (SHA-256 checked); ENOENT if it is not there */
+int negroni_wlan_fw_file(const char *name, void *dst, uint32_t cap, uint32_t *size);
+
+/*
+ * 0320: the address the chip gets for host memory at physical `pa` (`size` bytes, contiguous). The identity
+ * unless an SMMU translation context is on (0324, negroniwlan_smmu=3); WLAN_DMA_NONE when it cannot map.
+ */
+#define WLAN_DMA_NONE           (~0ull)
+uint64_t negroni_wlan_dma_map(uint64_t pa, uint32_t size);
+/* 0324: apps-SMMU stage-1 context for stream 0x1c01 (negroniwlan_smmu=3, negroni_wlan_smmu.c) */
+int negroni_wlan_smmu_on(void);
+bool negroni_wlan_smmu_active(void);
+uint64_t negroni_wlan_smmu_map(uint64_t pa, uint32_t size);
+void negroni_wlan_smmu_report(void);
+void negroni_wlan_smmu_off(void);
+/* 0325: negroniwlan_smmu=3 is the default; unmap, the MHI window, a fault check for heartbeats */
+void negroni_wlan_dma_unmap(uint64_t dva, uint32_t size);
+void negroni_wlan_smmu_unmap(uint64_t iova, uint32_t size);
+bool negroni_wlan_smmu_window(uint64_t *base, uint64_t *limit);
+bool negroni_wlan_smmu_check(const char *where);
+/* 0320: sleep (not spin) for `ms` milliseconds; for the keep-alive poller and the later levels */
+void negroni_wlan_nap(uint32_t ms);
+/* 0320: one service pass: MHI events, QRTR packets (QMI indications) and the registered pollers */
+int negroni_wlan_service(void);
+/* 0320: pollers of later levels (CE rings 0321, WMI events 0322); at most WLAN_POLLERS */
+#define WLAN_POLLERS            4u
+void negroni_wlan_add_poller(void (*fn)(void));
+
+/* negroni_wlan_qmi.c (0266): level 6; free only after the chip lost bus mastering */
+int negroni_wlan_wlfw_run(struct mhi_host *h, uint64_t m3_pa, uint32_t m3_size);
+void negroni_wlan_wlfw_free(void);
+int negroni_wlan_wlfw_start(struct mhi_host *h);       /* 0320: level 7, WLAN_CFG + WLAN_MODE */
+void negroni_wlan_wlfw_idle(void);                      /* 0320: keep-alive, late QMI indications */
+
+/* 0339: the MHI/BHI/PBL/SBL state in a few lines (cnss2 cnss_boot_debug_timeout_hdlr: mhi regs, scratch regs,
+ * cnss_pci_dump_bl_sram_mem), for the boot of the chip's SBL */
+void negroni_wlan_boot_dump(struct mhi_host *h, const char *when);
+/* 0344: negroniwlan_msi bit 0: print an MSI the chip wrote into the RAM mailbox (nothing when MSI is off) */
+void negroni_wlan_msi_poll(const char *when);
+bool negroni_wlan_msi_on(void);
+
+/* negroni_wlan_bhi.c */
+int negroni_wlan_bhi_sbl(struct mhi_host *h, uint64_t pa, uint32_t size);
+int negroni_wlan_bhie_image(struct mhi_host *h, uint64_t vec_pa, uint32_t entries);
+
+/* negroni_wlan_mhi.c, in the Linux order (op-kernel boot.c mhi_fw_load_handler, pm.c) */
+int negroni_wlan_mhi_ready(struct mhi_host *h);         /* MHICTRL RESET clear, MHISTATUS READY */
+int negroni_wlan_mhi_init(struct mhi_host *h);          /* mhi_init_mmio */
+int negroni_wlan_mhi_m0(struct mhi_host *h);            /* event rings to the device, M0, wake */
+int negroni_wlan_mhi_wait_ee(struct mhi_host *h, uint32_t ee, const char *name);
+int negroni_wlan_mhi_poll(struct mhi_host *h);
+int negroni_wlan_mhi_start_ipcr(struct mhi_host *h);
+int negroni_wlan_mhi_tx(struct mhi_host *h, const void *data, uint32_t len);    /* channel 20, EOT */
+void negroni_wlan_mhi_reset(struct mhi_host *h);        /* failure path: MHICTRL RESET */
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
+#endif /* _NEGRONI_WLAN_MHI_H_ */
diff --git a/bsd/dev/negroni_wlan_qmi.c b/bsd/dev/negroni_wlan_qmi.c
new file mode 100644
index 0000000..ee196ec
--- /dev/null
+++ b/bsd/dev/negroni_wlan_qmi.c
@@ -0,0 +1,1020 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi, level 6 (patch 0266): QMI WLFW over QRTR (0265).
+ *
+ *   step 18  WLFW IND_REGISTER     ask for FW_READY, FW_INIT_DONE, REQUEST_MEM, FW_MEM_READY, CAL_DONE
+ *   step 19  WLFW HOST_CAP         the fields cnss2 sets for QCA6490 (cnss2 qmi.c:271)
+ *   step 20  WLFW firmware memory  wait REQUEST_MEM_IND, allocate contiguous segments, RESPOND_MEM
+ *   step 21  WLFW FW_MEM_READY + CAP   wait FW_MEM_READY_IND, CAP_REQ: chip / board / firmware ids
+ *   step 22  WLFW BDF download     regdb.bin (type 4, may fail), then the board file (type 1, ELF)
+ *   step 23  WLFW M3_INFO          the m3.bin copy that level 2 left in the DMA pool
+ *   step 24  WLFW FW_INIT_DONE     wait FW_INIT_DONE_IND (HSP; FW_READY_IND on older firmware)
+ *
+ * Order and fields: OnePlus cnss2 (out/src/op-kernel drivers/net/wireless/cnss2 qmi.c:133
+ * ind_register, :271 host_cap, :410 respond_mem, :499 tgt_cap, :950 bdf, :1103 m3; main.c:509
+ * cnss_fw_mem_ready_hdlr) and Linux ath11k qmi.c (same WLFW family). Every response is checked
+ * (TLV 0x02 result/error, logged). The generic TLV coder below is our own code, written from the
+ * wire format; the tables are in negroni_wlfw_tables.h. UNTESTED ON HARDWARE.
+ *
+ * The firmware memory segments stay allocated while the chip runs; negroni_wlan_wlfw_free runs
+ * only on the failure path, after the chip lost bus mastering (negroni_wlan.c wlan_quiesce).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include <arm/caches_internal.h>
+#include "negroni_wlan.h"
+#include "negroni_wlan_mhi.h"
+#include "negroni_wlan_qrtr.h"
+#include "negroni_wlan_qmi.h"
+#include "negroni_wlfw_tables.h"
+#include "negroni_wlan_ce.h"
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+
+/* =============================== generic QMI TLV coder =============================== */
+
+struct qw {             /* writer */
+	uint8_t *b;
+	uint32_t cap, pos;
+};
+struct qr {             /* reader, [p, end) */
+	const uint8_t *p, *end;
+};
+
+static uint32_t
+qf_width(uint8_t kind)
+{
+	switch (kind) {
+	case QF_U8: return 1;
+	case QF_U16: return 2;
+	case QF_U32: return 4;
+	case QF_U64: return 8;
+	default: return 0;
+	}
+}
+
+/* C-side load/store of a scalar of `n` bytes (host little endian, unaligned safe) */
+static uint64_t
+c_load(const uint8_t *s, uint32_t n)
+{
+	uint8_t v8;
+	uint16_t v16;
+	uint32_t v32;
+	uint64_t v64;
+
+	switch (n) {
+	case 1: memcpy(&v8, s, 1); return v8;
+	case 2: memcpy(&v16, s, 2); return v16;
+	case 4: memcpy(&v32, s, 4); return v32;
+	default: memcpy(&v64, s, 8); return v64;
+	}
+}
+
+static void
+c_store(uint8_t *d, uint64_t v, uint32_t n)
+{
+	uint8_t v8 = (uint8_t)v;
+	uint16_t v16 = (uint16_t)v;
+	uint32_t v32 = (uint32_t)v;
+
+	switch (n) {
+	case 1: memcpy(d, &v8, 1); break;
+	case 2: memcpy(d, &v16, 2); break;
+	case 4: memcpy(d, &v32, 4); break;
+	default: memcpy(d, &v, 8); break;
+	}
+}
+
+static int
+w_put(struct qw *w, uint64_t v, uint32_t n)
+{
+	if (w->cap - w->pos < n) {
+		return EMSGSIZE;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		w->b[w->pos++] = (uint8_t)(v >> (8 * i));
+	}
+	return 0;
+}
+
+static int
+r_get(struct qr *r, uint32_t n, uint64_t *v)
+{
+	if ((uint32_t)(r->end - r->p) < n) {
+		return EBADMSG;
+	}
+	*v = 0;
+	for (uint32_t i = 0; i < n; i++) {
+		*v |= (uint64_t)r->p[i] << (8 * i);
+	}
+	r->p += n;
+	return 0;
+}
+
+static int qf_enc(const struct qmi_field *f, const uint8_t *base, struct qw *w, int level);
+static int qf_dec(const struct qmi_field *f, uint8_t *base, struct qr *r, int level);
+
+static int
+qf_enc_members(const struct qmi_field *sub, uint16_t n, const uint8_t *base, struct qw *w, int level)
+{
+	for (uint16_t i = 0; i < n; i++) {
+		int e = qf_enc(&sub[i], base, w, level);
+		if (e) {
+			return e;
+		}
+	}
+	return 0;
+}
+
+static int
+qf_enc(const struct qmi_field *f, const uint8_t *base, struct qw *w, int level)
+{
+	const uint8_t *v = base + f->off;
+	uint32_t n = qf_width(f->kind);
+
+	switch (f->kind) {
+	case QF_U8:
+	case QF_U16:
+	case QF_U32:
+	case QF_U64:
+		return w_put(w, c_load(v, n), n);
+	case QF_STRING: {
+		/* nested prefix: u8 when elem_len = max + 1 <= 255 (qmi_encdec.c:131, :247) */
+		uint32_t len = (uint32_t)strnlen((const char *)v, (size_t)f->max + 1);
+		if (len > f->max) {
+			return EINVAL;
+		}
+		if (level > 1) {
+			int e = w_put(w, len, f->max + 1u <= 255u ? 1 : 2);
+			if (e) {
+				return e;
+			}
+		}
+		if (w->cap - w->pos < len) {
+			return EMSGSIZE;
+		}
+		memcpy(w->b + w->pos, v, len);
+		w->pos += len;
+		return 0;
+	}
+	case QF_STRUCT:
+		return qf_enc_members(f->sub, f->nsub, v, w, level + 1);
+	case QF_VARRAY: {
+		uint32_t cnt = (uint32_t)c_load(base + f->count, 4);
+		uint32_t ew = qf_width(f->ekind);
+		int e;
+
+		if (cnt > f->max || (f->lensz != 1 && f->lensz != 2)) {
+			return EINVAL;
+		}
+		e = w_put(w, cnt, f->lensz);
+		if (e) {
+			return e;
+		}
+		if (f->ekind != QF_STRUCT && ew == 1) {         /* byte array: one copy */
+			if (w->cap - w->pos < cnt) {
+				return EMSGSIZE;
+			}
+			memcpy(w->b + w->pos, v, cnt);
+			w->pos += cnt;
+			return 0;
+		}
+		for (uint32_t i = 0; i < cnt; i++) {
+			const uint8_t *el = v + (size_t)i * f->esize;
+			e = f->ekind == QF_STRUCT ? qf_enc_members(f->sub, f->nsub, el, w, level + 1) :
+			    w_put(w, c_load(el, ew), ew);
+			if (e) {
+				return e;
+			}
+		}
+		return 0;
+	}
+	default:
+		return EINVAL;
+	}
+}
+
+static int
+qf_dec_members(const struct qmi_field *sub, uint16_t n, uint8_t *base, struct qr *r, int level)
+{
+	for (uint16_t i = 0; i < n; i++) {
+		int e = qf_dec(&sub[i], base, r, level);
+		if (e) {
+			return e;
+		}
+	}
+	return 0;
+}
+
+static int
+qf_dec(const struct qmi_field *f, uint8_t *base, struct qr *r, int level)
+{
+	uint8_t *v = base + f->off;
+	uint32_t n = qf_width(f->kind);
+	uint64_t x;
+	int e;
+
+	switch (f->kind) {
+	case QF_U8:
+	case QF_U16:
+	case QF_U32:
+	case QF_U64:
+		e = r_get(r, n, &x);
+		if (!e) {
+			c_store(v, x, n);
+		}
+		return e;
+	case QF_STRING: {
+		uint32_t len;
+		if (level > 1) {
+			e = r_get(r, f->max + 1u <= 255u ? 1 : 2, &x);
+			if (e) {
+				return e;
+			}
+			len = (uint32_t)x;
+		} else {
+			len = (uint32_t)(r->end - r->p);        /* the TLV length */
+		}
+		if (len > f->max || (uint32_t)(r->end - r->p) < len) {
+			return EBADMSG;
+		}
+		memcpy(v, r->p, len);
+		v[len] = 0;                                     /* C storage is char[max + 1] */
+		r->p += len;
+		return 0;
+	}
+	case QF_STRUCT:
+		return qf_dec_members(f->sub, f->nsub, v, r, level + 1);
+	case QF_VARRAY: {
+		uint32_t ew = qf_width(f->ekind), cnt;
+		if (f->lensz != 1 && f->lensz != 2) {
+			return EINVAL;
+		}
+		e = r_get(r, f->lensz, &x);
+		if (e) {
+			return e;
+		}
+		cnt = (uint32_t)x;
+		if (cnt > f->max) {
+			return EBADMSG;
+		}
+		c_store(base + f->count, cnt, 4);
+		for (uint32_t i = 0; i < cnt; i++) {
+			uint8_t *el = v + (size_t)i * f->esize;
+			if (f->ekind == QF_STRUCT) {
+				e = qf_dec_members(f->sub, f->nsub, el, r, level + 1);
+			} else {
+				e = r_get(r, ew, &x);
+				if (!e) {
+					c_store(el, x, ew);
+				}
+			}
+			if (e) {
+				return e;
+			}
+		}
+		return 0;
+	}
+	default:
+		return EINVAL;
+	}
+}
+
+int
+negroni_qmi_header(const uint8_t *buf, uint32_t len, uint8_t *type, uint16_t *txn, uint16_t *msg_id,
+    uint16_t *msg_len)
+{
+	if (!buf || len < QMI_HDR_LEN) {
+		return EBADMSG;
+	}
+	*type = buf[0];
+	*txn = (uint16_t)(buf[1] | (buf[2] << 8));
+	*msg_id = (uint16_t)(buf[3] | (buf[4] << 8));
+	*msg_len = (uint16_t)(buf[5] | (buf[6] << 8));
+	if (*msg_len > len - QMI_HDR_LEN) {
+		return EBADMSG;
+	}
+	return 0;
+}
+
+int
+negroni_qmi_encode(const struct qmi_msg_desc *d, uint8_t type, uint16_t txn, const void *c, uint8_t *buf,
+    uint32_t cap, uint32_t *outlen)
+{
+	struct qw w = { .b = buf, .cap = cap, .pos = QMI_HDR_LEN };
+	const uint8_t *base = c;
+
+	if (cap < QMI_HDR_LEN) {
+		return EMSGSIZE;
+	}
+	for (uint16_t i = 0; i < d->n; i++) {
+		const struct qmi_field *f = &d->f[i];
+		uint32_t at = w.pos;
+		int e;
+
+		if (f->valid != QF_MANDATORY && base[f->valid] == 0) {
+			continue;
+		}
+		e = w_put(&w, f->tlv, 1);
+		if (!e) {
+			e = w_put(&w, 0, 2);            /* length, patched below */
+		}
+		if (!e) {
+			e = qf_enc(f, base, &w, 1);
+		}
+		if (e) {
+			return e;
+		}
+		uint32_t tl = w.pos - at - 3;
+		if (tl > 0xffff) {
+			return EMSGSIZE;
+		}
+		buf[at + 1] = (uint8_t)tl;
+		buf[at + 2] = (uint8_t)(tl >> 8);
+	}
+	uint32_t ml = w.pos - QMI_HDR_LEN;
+	if (ml > 0xffff) {
+		return EMSGSIZE;
+	}
+	buf[0] = type;
+	buf[1] = (uint8_t)txn;
+	buf[2] = (uint8_t)(txn >> 8);
+	buf[3] = (uint8_t)d->id;
+	buf[4] = (uint8_t)(d->id >> 8);
+	buf[5] = (uint8_t)ml;
+	buf[6] = (uint8_t)(ml >> 8);
+	*outlen = w.pos;
+	return 0;
+}
+
+int
+negroni_qmi_decode(const struct qmi_msg_desc *d, const uint8_t *buf, uint32_t len, void *c)
+{
+	uint8_t type, *base = c;
+	uint16_t txn, id, ml;
+	uint64_t seen = 0;      /* one bit per table row (tables have < 64 rows) */
+	const uint8_t *p, *end;
+
+	memset(c, 0, d->csize);
+	if (negroni_qmi_header(buf, len, &type, &txn, &id, &ml) || d->n > 64) {
+		return EBADMSG;
+	}
+	p = buf + QMI_HDR_LEN;
+	end = p + ml;
+	while (p < end) {
+		uint32_t t, tl;
+
+		if (end - p < 3) {
+			return EBADMSG;
+		}
+		t = p[0];
+		tl = (uint32_t)p[1] | ((uint32_t)p[2] << 8);
+		p += 3;
+		if ((uint32_t)(end - p) < tl) {
+			return EBADMSG;
+		}
+		for (uint16_t i = 0; i < d->n; i++) {
+			const struct qmi_field *f = &d->f[i];
+			if (f->tlv != t) {
+				continue;
+			}
+			struct qr r = { .p = p, .end = p + tl };
+			if (qf_dec(f, base, &r, 1)) {
+				return EBADMSG;
+			}
+			if (f->valid != QF_MANDATORY) {
+				base[f->valid] = 1;
+			}
+			seen |= 1ull << i;
+			break;          /* trailing bytes in a TLV are ignored (newer firmware) */
+		}
+		p += tl;                /* unknown TLV types are skipped */
+	}
+	for (uint16_t i = 0; i < d->n; i++) {
+		if (d->f[i].valid == QF_MANDATORY && !(seen & (1ull << i))) {
+			return EBADMSG;
+		}
+	}
+	return 0;
+}
+
+/* =============================== WLFW client =============================== */
+
+#define WLFW_MEM_TOTAL_MAX      (64u << 20)     /* refuse a request above 64 MiB in total */
+#define WLFW_SEG_MAX            (32u << 20)
+#define WLFW_FILE_CAP           (256u << 10)    /* regdb.bin 24 KiB, bdwlan.* 59 KiB on 16.0.3.530 */
+#define WLFW_DELAY_SEG_CNT      5u              /* ath11k qmi.h:29 ATH11K_QMI_FW_MEM_REQ_SEGMENT_CNT */
+
+struct wlfw_seg {
+	vm_offset_t kva;
+	uint64_t pa;
+	uint64_t dva;           /* 0320: the address the chip gets (negroni_wlan_dma_map) */
+	uint32_t size, alloc, type;
+};
+
+static struct {
+	struct mhi_host *h;
+	uint16_t txn;
+	/* the one request in flight */
+	bool waiting, done;
+	uint16_t wait_id, wait_txn;
+	const struct qmi_msg_desc *wait_d;
+	void *wait_out;
+	int wait_err;
+	/* indications (kept until consumed) */
+	bool req_mem, fw_mem_ready, fw_init_done, fw_ready, cal_done, init_any;
+	uint32_t ind_other, resp_other;
+	struct wlfw_request_mem_ind mem;
+	struct wlfw_fw_init_done_ind init_done;
+	/* results */
+	struct wlfw_seg seg[WLFW_MAX_NUM_MEM_SEG];
+	uint32_t nseg;
+	uint32_t chip_id, board_id;
+} W;
+
+static uint8_t g_qbuf[WLAN_TX_LEN - QRTR_HDR_V1_LEN];  /* one encoded request */
+static struct wlfw_bdf_download_req g_bdf;              /* 6.2 KiB, not on the stack */
+static struct wlfw_cap_resp g_cap;
+static struct wlfw_respond_mem_req g_resp_mem;
+
+/* QRTR DATA from the WLFW server (qrtr_pump context: decode, store, never send) */
+static void
+wlfw_data(uint32_t node, uint32_t port, const uint8_t *p, uint32_t len)
+{
+	uint8_t type;
+	uint16_t txn, id, ml;
+
+	if (node != negroni_qrtr.wlfw.node || port != negroni_qrtr.wlfw.port ||
+	    negroni_qmi_header(p, len, &type, &txn, &id, &ml)) {
+		if (W.resp_other++ < 4) {
+			printf("NEGRONI WLAN: QMI packet of %u bytes from node %u port %#x ignored\n", len, node, port);
+		}
+		return;
+	}
+	if (type == QMI_RESPONSE) {
+		if (W.waiting && !W.done && id == W.wait_id && txn == W.wait_txn) {
+			W.wait_err = negroni_qmi_decode(W.wait_d, p, len, W.wait_out);
+			W.done = true;
+		} else if (W.resp_other++ < 4) {
+			printf("NEGRONI WLAN: QMI response %#x txn %u not expected (waiting %#x txn %u)\n", id, txn,
+			    W.wait_id, W.wait_txn);
+		}
+		return;
+	}
+	if (type != QMI_INDICATION) {
+		if (W.ind_other++ < 4) {
+			printf("NEGRONI WLAN: QMI message type %u id %#x from the chip ignored\n", type, id);
+		}
+		return;
+	}
+	switch (id) {
+	case WLFW_REQUEST_MEM_IND:
+		if (negroni_qmi_decode(&wlfw_request_mem_ind_d, p, len, &W.mem)) {
+			printf("NEGRONI WLAN: QMI REQUEST_MEM_IND of %u bytes does not decode; ignored\n", len);
+			memset(&W.mem, 0, sizeof(W.mem));
+			break;
+		}
+		W.req_mem = true;
+		break;
+	case WLFW_FW_MEM_READY_IND:
+		W.fw_mem_ready = true;
+		break;
+	case WLFW_FW_INIT_DONE_IND:
+		(void)negroni_qmi_decode(&wlfw_fw_init_done_ind_d, p, len, &W.init_done);
+		W.fw_init_done = W.init_any = true;
+		break;
+	case WLFW_FW_READY_IND:
+		W.fw_ready = W.init_any = true;
+		break;
+	case WLFW_CAL_DONE_IND:
+		W.cal_done = true;
+		break;
+	default:
+		if (W.ind_other++ < 8) {
+			printf("NEGRONI WLAN: QMI indication %#x (%u bytes) ignored\n", id, ml);
+		}
+		break;
+	}
+}
+
+/* pump QRTR until *flag or the time-out; the WLFW server must stay up */
+static int
+wlfw_wait(volatile bool *flag, uint32_t ms, const char *what)
+{
+	uint64_t deadline = negroni_wlan_ms() + ms;
+	int error;
+
+	for (;;) {
+		error = negroni_wlan_qrtr_pump(W.h);
+		if (error) {
+			return error;
+		}
+		if (*flag) {
+			return 0;
+		}
+		if (negroni_qrtr.wlfw_gone || negroni_qrtr.bye) {
+			return negroni_wlan_failed(EIO, "the WLFW server left (%s) while waiting for %s",
+			           negroni_qrtr.bye ? "BYE" : "DEL_SERVER", what);
+		}
+		if (negroni_wlan_ms() >= deadline) {
+			return negroni_wlan_failed(ETIMEDOUT, "no %s in %u ms", what, ms);
+		}
+		delay(1000);
+	}
+}
+
+/*
+ * One request -> response (qmi_send_request + qmi_txn_wait). The response struct starts with
+ * struct wlfw_resp (TLV 0x02); its result/error is logged. allow_error: return 0 on a refusal and
+ * let the caller look at resp (the delayed RESPOND_MEM).
+ */
+static int
+wlfw_txn(const struct qmi_msg_desc *rq, const void *req, const struct qmi_msg_desc *rs, void *resp,
+    bool allow_error, bool quiet)
+{
+	struct wlfw_resp *r = resp;
+	uint32_t len;
+	char what[48];
+	int error;
+
+	W.txn = (uint16_t)(W.txn + 1);
+	if (W.txn == 0) {
+		W.txn = 1;
+	}
+	error = negroni_qmi_encode(rq, QMI_REQUEST, W.txn, req, g_qbuf, sizeof(g_qbuf), &len);
+	if (error) {
+		return negroni_wlan_failed(error, "QMI %s request does not encode (error %d)", rq->name, error);
+	}
+	W.wait_id = rq->id;
+	W.wait_txn = W.txn;
+	W.wait_d = rs;
+	W.wait_out = resp;
+	W.wait_err = 0;
+	W.done = false;
+	W.waiting = true;
+	error = negroni_wlan_qrtr_send(W.h, QRTR_TYPE_DATA, QRTR_LOCAL_PORT, negroni_qrtr.wlfw.node,
+	    negroni_qrtr.wlfw.port, g_qbuf, len);
+	if (!error) {
+		snprintf(what, sizeof(what), "the %s response (0x%02x, txn %u)", rq->name, rq->id, W.txn);
+		error = wlfw_wait(&W.done, W.h->timeout_ms, what);
+	}
+	W.waiting = false;
+	if (error) {
+		return error;
+	}
+	if (W.wait_err) {
+		return negroni_wlan_failed(EBADMSG, "the QMI %s response does not decode", rq->name);
+	}
+	if (!quiet || r->result != QMI_RESULT_SUCCESS) {
+		printf("NEGRONI WLAN: QMI %s (0x%02x) response: result %u error %u\n", rq->name, rq->id, r->result,
+		    r->error);
+	}
+	if (r->result != QMI_RESULT_SUCCESS && !allow_error) {
+		return negroni_wlan_failed(EIO, "QMI %s refused: result %u error %u", rq->name, r->result, r->error);
+	}
+	return 0;
+}
+
+void
+negroni_wlan_wlfw_free(void)
+{
+	for (uint32_t i = 0; i < W.nseg; i++) {
+		if (W.seg[i].kva) {
+			negroni_wlan_dma_unmap(W.seg[i].dva, W.seg[i].alloc);  /* 0325: no IOVA left on freed pages */
+			flush_dcache64((addr64_t)W.seg[i].pa, W.seg[i].alloc, TRUE);
+			kmem_free(kernel_map, W.seg[i].kva, W.seg[i].alloc);
+		}
+	}
+	memset(W.seg, 0, sizeof(W.seg));
+	W.nseg = 0;
+}
+
+/* allocate every requested segment: physically contiguous, zeroed, inside the 36-bit MHI window */
+static int
+wlfw_alloc(const struct wlfw_request_mem_ind *m)
+{
+	uint64_t sum = 0;
+
+	for (uint32_t i = 0; i < m->mem_seg_len; i++) {
+		const struct wlfw_mem_seg *s = &m->mem_seg[i];
+		printf("NEGRONI WLAN: firmware asks segment %u: %#x bytes, type %u, %u config entries\n", i, s->size,
+		    s->type, s->mem_cfg_len);
+		if (s->size == 0 || s->size > WLFW_SEG_MAX) {
+			return negroni_wlan_failed(ERANGE, "segment %u size %#x (type %u) refused", i, s->size, s->type);
+		}
+		sum += s->size;
+	}
+	if (m->mem_seg_len == 0 || sum > WLFW_MEM_TOTAL_MAX) {
+		return negroni_wlan_failed(ERANGE, "%u segments of %llu bytes in total refused (max %u)", m->mem_seg_len,
+		           sum, WLFW_MEM_TOTAL_MAX);
+	}
+	for (uint32_t i = 0; i < m->mem_seg_len; i++) {
+		struct wlfw_seg *g = &W.seg[i];
+		vm_offset_t kva = 0;
+		uint32_t alloc = (m->mem_seg[i].size + PAGE_MASK) & ~(uint32_t)PAGE_MASK;
+
+		/* every page below 36 bit (the chip's DMA mask): max_pnum = last page number under 1 << 36 */
+		if (kmem_alloc_contig(kernel_map, &kva, alloc, PAGE_MASK, (ppnum_t)(atop_64(MHI_DMA_MASK + 1) - 1), 0,
+		    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("NEGRONI WLAN: no %#x contiguous bytes for segment %u\n", alloc, i);
+			return ENOMEM;
+		}
+		W.nseg = i + 1;
+		g->kva = kva;
+		g->alloc = alloc;
+		g->size = m->mem_seg[i].size;
+		g->type = m->mem_seg[i].type;
+		ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)kva);
+		g->pa = ptoa_64(pn);
+		if (!pn || g->pa + alloc - 1 > MHI_DMA_MASK) {
+			return negroni_wlan_failed(ERANGE, "segment %u at %#llx outside the 36-bit DMA window", i, g->pa);
+		}
+		flush_dcache64((addr64_t)g->pa, alloc, TRUE);  /* zeroes in RAM, no line left in the cache */
+		g->dva = negroni_wlan_dma_map(g->pa, alloc);
+		if (g->dva == WLAN_DMA_NONE) {
+			return negroni_wlan_failed(ENOMEM, "segment %u: no device address (SMMU table full)", i);
+		}
+		printf("NEGRONI WLAN: segment %u type %u: %#x bytes at %#llx (device %#llx)\n", i, g->type, g->size,
+		    g->pa, g->dva);
+	}
+	return 0;
+}
+
+static int
+wlfw_respond_mem(uint32_t nseg)
+{
+	struct wlfw_resp_only r;
+
+	memset(&g_resp_mem, 0, sizeof(g_resp_mem));
+	g_resp_mem.mem_seg_len = nseg;
+	for (uint32_t i = 0; i < nseg; i++) {
+		g_resp_mem.mem_seg[i].addr = W.seg[i].dva;
+		g_resp_mem.mem_seg[i].size = W.seg[i].size;
+		g_resp_mem.mem_seg[i].type = W.seg[i].type;
+	}
+	int error = wlfw_txn(&wlfw_respond_mem_req_d, &g_resp_mem, &wlfw_respond_mem_resp_d, &r, nseg == 0, false);
+	if (!error && nseg == 0 && r.resp.result != QMI_RESULT_SUCCESS && r.resp.error != 0) {
+		/* ath11k qmi.c:1943: with zero segments the refusal is expected only with error 0 */
+		return negroni_wlan_failed(EIO, "QMI RESPOND_MEM (0 segments) refused with error %u", r.resp.error);
+	}
+	return error;
+}
+
+/* step 20: REQUEST_MEM_IND -> allocate -> RESPOND_MEM; once ath11k's "smaller chunks" retry */
+static int
+wlfw_memory(void)
+{
+	int error;
+
+	for (int attempt = 0; attempt < 2; attempt++) {
+		error = wlfw_wait(&W.req_mem, W.h->timeout_ms, "REQUEST_MEM_IND");
+		if (error) {
+			return error;
+		}
+		W.req_mem = false;
+		error = wlfw_alloc(&W.mem);
+		if (error == ENOMEM && attempt == 0 && W.mem.mem_seg_len <= WLFW_DELAY_SEG_CNT) {
+			/* ath11k qmi.c:1886-1897: answer 0 segments, the firmware asks again in smaller pieces */
+			negroni_wlan_wlfw_free();
+			printf("NEGRONI WLAN: contiguous allocation failed; RESPOND_MEM with 0 segments (ask smaller)\n");
+			error = wlfw_respond_mem(0);
+			if (error) {
+				return error;
+			}
+			continue;
+		}
+		if (error) {
+			return error == ENOMEM ? negroni_wlan_failed(ENOMEM, "no contiguous memory for the firmware "
+			           "segments") : error;
+		}
+		return wlfw_respond_mem(W.nseg);
+	}
+	return negroni_wlan_failed(ENOMEM, "the second REQUEST_MEM could not be met either");
+}
+
+/* step 22 helper: send one file in <= 6144-byte segments (cnss2 qmi.c:1005-1062) */
+static int
+wlfw_bdf_file(const char *name, uint32_t bdf_type, bool must)
+{
+	struct wlfw_bdf_download_resp r;
+	vm_offset_t kva = 0;
+	uint32_t size = 0, off = 0, seg = 0;
+	int error;
+
+	if (kmem_alloc(kernel_map, &kva, WLFW_FILE_CAP, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return negroni_wlan_failed(ENOMEM, "no memory for %s", name);
+	}
+	error = negroni_wlan_fw_file(name, (void *)kva, WLFW_FILE_CAP, &size);
+	if (error) {
+		kmem_free(kernel_map, kva, WLFW_FILE_CAP);
+		if (!must) {
+			printf("NEGRONI WLAN: %s not sent (error %d); cnss2 goes on without it\n", name, error);
+			return 0;
+		}
+		return negroni_wlan_failed(error, "board file %s not in the firmware area (error %d)", name, error);
+	}
+	while (off < size) {
+		uint32_t n = MIN(size - off, WLFW_MAX_DATA_SIZE);
+
+		memset(&g_bdf, 0, sizeof(g_bdf));
+		g_bdf.valid = 1;
+		g_bdf.file_id_valid = 1;
+		g_bdf.file_id = W.board_id;
+		g_bdf.total_size_valid = 1;
+		g_bdf.total_size = size - off;          /* cnss2 sends the remaining bytes (qmi.c:1011) */
+		g_bdf.seg_id_valid = 1;
+		g_bdf.seg_id = seg;
+		g_bdf.data_valid = 1;
+		g_bdf.data_len = n;
+		memcpy(g_bdf.data, (const void *)(kva + off), n);
+		g_bdf.end_valid = 1;
+		g_bdf.end = (off + n == size) ? 1 : 0;
+		g_bdf.bdf_type_valid = 1;
+		g_bdf.bdf_type = (uint8_t)bdf_type;
+		error = wlfw_txn(&wlfw_bdf_download_req_d, &g_bdf, &wlfw_bdf_download_resp_d, &r, !must, true);
+		if (error) {
+			break;
+		}
+		if (r.resp.result != QMI_RESULT_SUCCESS) {      /* only when !must */
+			printf("NEGRONI WLAN: %s segment %u refused (result %u error %u); cnss2 goes on without it\n",
+			    name, seg, r.resp.result, r.resp.error);
+			break;
+		}
+		off += n;
+		seg++;
+	}
+	kmem_free(kernel_map, kva, WLFW_FILE_CAP);
+	if (!error && off == size) {
+		printf("NEGRONI WLAN: %s (type %u) %u bytes sent in %u segments, file id %#x%s\n", name, bdf_type, size,
+		    seg, W.board_id, r.host_bdf_data_valid ? "" : ", no host_bdf_data");
+		if (r.host_bdf_data_valid) {
+			printf("NEGRONI WLAN: host_bdf_data %#llx (HW_XPA %u)\n", r.host_bdf_data,
+			    (r.host_bdf_data & WLFW_HW_XPA) ? 1 : 0);
+		}
+	}
+	return error;
+}
+
+/* cnss2 qmi.c:729 cnss_get_bdf_file_name (CNSS_BDF_ELF) with the OnePlus default (qmi.c:724) */
+static void
+wlfw_bdf_name(char *name, size_t len)
+{
+	bool gf = (W.chip_id & WLFW_CHIP_ID_GF_MASK) != 0;
+
+	if (W.board_id == 0xff) {
+		snprintf(name, len, gf ? "bdwlang.elf" : "bdwlan.elf");
+	} else if (W.board_id < 0xff) {
+		snprintf(name, len, gf ? "bdwlang.e%02x" : "bdwlan.e%02x", W.board_id);
+	} else {
+		snprintf(name, len, "bdwlan%02x.e%02x", (W.board_id >> 8) & 0xff, W.board_id & 0xff);
+	}
+}
+
+/* boot-arg negroniwlan_hostcap=android (or =1): HOST_CAP with the phone's Android fields (0320) */
+static bool
+wlfw_hostcap_android(void)
+{
+	char v[16] = { 0 };
+
+	if (!PE_parse_boot_argn("negroniwlan_hostcap", v, sizeof(v))) {
+		return false;
+	}
+	/* PE_parse_boot_argn stores a number as an int, a word as a string */
+	return strncmp(v, "android", sizeof(v)) == 0 || (v[0] == 1 && v[1] == 0);
+}
+
+int
+negroni_wlan_wlfw_run(struct mhi_host *h, uint64_t m3_pa, uint32_t m3_size)
+{
+	int error;
+
+	memset(&W, 0, sizeof(W));
+	W.h = h;
+	W.board_id = 0xff;
+	negroni_qrtr.data_cb = wlfw_data;
+
+	negroni_wlan_step(18, "WLFW IND_REGISTER");
+	{
+		struct wlfw_ind_register_req q;
+		struct wlfw_ind_register_resp r;
+
+		memset(&q, 0, sizeof(q));
+		q.fw_ready_enable_valid = q.fw_ready_enable = 1;
+		q.client_id_valid = 1;
+		q.client_id = WLFW_CLIENT_ID;
+		q.request_mem_enable_valid = q.request_mem_enable = 1;
+		q.fw_mem_ready_enable_valid = q.fw_mem_ready_enable = 1;
+		q.fw_init_done_enable_valid = q.fw_init_done_enable = 1;
+		q.cal_done_enable_valid = q.cal_done_enable = 1;
+		error = wlfw_txn(&wlfw_ind_register_req_d, &q, &wlfw_ind_register_resp_d, &r, false, false);
+		if (error) {
+			return error;
+		}
+		if (r.fw_status_valid) {
+			printf("NEGRONI WLAN: IND_REGISTER fw_status %#llx\n", r.fw_status);
+			if (r.fw_status & WLFW_ALREADY_REGISTERED) {
+				/* cnss2 qmi.c:212: a warm firmware; the cold sequence below would not match */
+				return negroni_wlan_failed(EALREADY, "the firmware reports ALREADY_REGISTERED (warm chip)");
+			}
+		}
+	}
+
+	negroni_wlan_step(19, "WLFW HOST_CAP");
+	{
+		struct wlfw_host_cap_req q;
+		struct wlfw_resp_only r;
+
+		memset(&q, 0, sizeof(q));
+		q.num_clients_valid = 1;
+		q.num_clients = 1;
+		q.bdf_support_valid = q.bdf_support = 1;
+		q.m3_support_valid = q.m3_support = 1;
+		q.m3_cache_support_valid = q.m3_cache_support = 1;
+		q.cal_done_valid = 1;           /* cal_done 0: no cold-boot calibration data yet */
+		q.host_build_type_valid = 1;
+		q.host_build_type = WLFW_HOST_BUILD_SECONDARY;
+		q.feature_list_valid = 1;
+		q.feature_list = WLFW_FEATURE_LIST;
+		if (wlfw_hostcap_android()) {
+			/* 0320: the Android HOST_CAP (DRV bit + the WSA gpio entry of project 20847) */
+			q.feature_list = WLFW_FEATURE_LIST_ANDROID;
+			q.gpios_valid = 1;
+			q.gpios_len = 1;
+			q.gpios[0] = WLFW_GPIO_WSA_20847;
+			printf("NEGRONI WLAN: HOST_CAP as Android (negroniwlan_hostcap=android): feature_list %#llx, gpios {%#x}\n",
+			    q.feature_list, q.gpios[0]);
+		}
+		/* not sent: wake_msi (no MSI), ddr_range (no SMMU stage 1: bypass), mlo_* (KIWI/MANGO only) */
+		error = wlfw_txn(&wlfw_host_cap_req_d, &q, &wlfw_host_cap_resp_d, &r, false, false);
+		if (error) {
+			return error;
+		}
+	}
+
+	negroni_wlan_step(20, "WLFW firmware memory");
+	error = wlfw_memory();
+	if (error) {
+		return error;
+	}
+
+	negroni_wlan_step(21, "WLFW FW_MEM_READY + CAP");
+	error = wlfw_wait(&W.fw_mem_ready, h->timeout_ms, "FW_MEM_READY_IND");
+	if (error) {
+		return error;
+	}
+	{
+		struct wlfw_empty q = { 0 };
+
+		error = wlfw_txn(&wlfw_cap_req_d, &q, &wlfw_cap_resp_d, &g_cap, false, false);
+		if (error) {
+			return error;
+		}
+		W.chip_id = g_cap.chip_info_valid ? g_cap.chip_info.chip_id : 0;
+		W.board_id = g_cap.board_info_valid ? g_cap.board_info.v : 0xff;      /* cnss2 qmi.c:557-560 */
+		printf("NEGRONI WLAN: chip id %#x family %#x, board id %#x, soc id %#x, otp %#x\n", W.chip_id,
+		    g_cap.chip_info_valid ? g_cap.chip_info.chip_family : 0, W.board_id,
+		    g_cap.soc_info_valid ? g_cap.soc_info.v : 0, g_cap.otp_version_valid ? g_cap.otp_version : 0);
+		printf("NEGRONI WLAN: firmware version %#x, timestamp \"%s\", build \"%s\"\n",
+		    g_cap.fw_version_info_valid ? g_cap.fw_version_info.fw_version : 0,
+		    g_cap.fw_version_info_valid ? g_cap.fw_version_info.fw_build_timestamp : "",
+		    g_cap.fw_build_id_valid ? g_cap.fw_build_id : "");
+		printf("NEGRONI WLAN: fw_caps %#llx, voltage %u mV, time freq %u Hz, foundry \"%s\", regdb support %u mandatory %u\n",
+		    g_cap.fw_caps_valid ? g_cap.fw_caps : 0, g_cap.voltage_mv_valid ? g_cap.voltage_mv : 0,
+		    g_cap.time_freq_hz_valid ? g_cap.time_freq_hz : 0, g_cap.foundry_name_valid ? g_cap.foundry_name : "",
+		    g_cap.regdb_support_valid ? g_cap.regdb_support : 0, g_cap.regdb_mandatory_valid ? g_cap.regdb_mandatory : 0);
+	}
+
+	negroni_wlan_step(22, "WLFW BDF download");
+	{
+		char name[48];
+		bool regdb_must = g_cap.regdb_mandatory_valid && g_cap.regdb_mandatory;
+
+		/* cnss2 main.c:525: regdb first, its failure is ignored (unless the firmware calls it mandatory) */
+		error = wlfw_bdf_file("regdb.bin", WLFW_BDF_TYPE_REGDB, regdb_must);
+		if (error) {
+			return error;
+		}
+		wlfw_bdf_name(name, sizeof(name));
+		error = wlfw_bdf_file(name, WLFW_BDF_TYPE_ELF, true);
+		if (error) {
+			return error;
+		}
+	}
+
+	negroni_wlan_step(23, "WLFW M3_INFO");
+	{
+		struct wlfw_m3_info_req q = { .addr = m3_pa, .size = m3_size };
+		struct wlfw_resp_only r;
+
+		if (!m3_pa || !m3_size) {
+			return negroni_wlan_failed(ENOENT, "no m3.bin in the DMA pool");
+		}
+		printf("NEGRONI WLAN: m3.bin %u bytes at %#llx\n", m3_size, m3_pa);
+		error = wlfw_txn(&wlfw_m3_info_req_d, &q, &wlfw_m3_info_resp_d, &r, false, false);
+		if (error) {
+			return error;
+		}
+	}
+
+	negroni_wlan_step(24, "WLFW FW_INIT_DONE");
+	/* HSP firmware sends FW_INIT_DONE_IND (cnss2 qmi.c:159); older firmware FW_READY_IND */
+	error = wlfw_wait(&W.init_any, MAX(h->timeout_ms, 10000u), "FW_INIT_DONE_IND / FW_READY_IND");
+	if (error) {
+		return error;
+	}
+	printf("NEGRONI WLAN: step 24 %s received%s (hang data offset %#x length %u)\n",
+	    W.fw_init_done ? "FW_INIT_DONE_IND" : "FW_READY_IND", W.cal_done ? ", CAL_DONE seen" : "",
+	    W.init_done.hang_data_addr_offset, W.init_done.hang_data_length);
+	return 0;
+}
+
+/*
+ * Level 7 (0320): steps 25-26, ath11k qmi.c:2841-2869 ath11k_qmi_firmware_start (core.c:2242-2256 builds the
+ * shadow list first). WLAN_CFG carries the target CE pipes, the service -> pipe map and the shadow register v2
+ * list (negroni_wlan_ce.h); WLAN_MODE MISSION starts the WLAN firmware. ath11k sends WLAN_INI (enablefwlog)
+ * first for wcn6855 (fw_wmi_diag_event); we do not: the cnss2 v01 table has no WLAN_INI message and its only
+ * effect is firmware log events over WMI.
+ */
+static struct wlfw_wlan_cfg_req g_cfg;
+
+int
+negroni_wlan_wlfw_start(struct mhi_host *h)
+{
+	struct wlfw_resp_only r;
+	int error;
+
+	W.h = h;
+	negroni_qrtr.data_cb = wlfw_data;
+
+	negroni_wlan_step(25, "WLFW WLAN_CFG");
+	memset(&g_cfg, 0, sizeof(g_cfg));
+	g_cfg.host_version_valid = 1;
+	strlcpy(g_cfg.host_version, WLFW_HOST_VERSION, sizeof(g_cfg.host_version));
+	g_cfg.tgt_cfg_valid = 1;
+	g_cfg.tgt_cfg_len = WLAN_CE_TGT_N;
+	for (uint32_t i = 0; i < WLAN_CE_TGT_N; i++) {
+		g_cfg.tgt_cfg[i].pipe_num = wlan_ce_tgt_cfg[i].pipe;
+		g_cfg.tgt_cfg[i].pipe_dir = wlan_ce_tgt_cfg[i].dir;
+		g_cfg.tgt_cfg[i].nentries = wlan_ce_tgt_cfg[i].nentries;
+		g_cfg.tgt_cfg[i].nbytes_max = wlan_ce_tgt_cfg[i].nbytes_max;
+		g_cfg.tgt_cfg[i].flags = wlan_ce_tgt_cfg[i].flags;
+	}
+	g_cfg.svc_cfg_valid = 1;
+	g_cfg.svc_cfg_len = WLAN_CE_SVC_N;
+	for (uint32_t i = 0; i < WLAN_CE_SVC_N; i++) {
+		g_cfg.svc_cfg[i].service_id = wlan_ce_svc_map[i].service;
+		g_cfg.svc_cfg[i].pipe_dir = wlan_ce_svc_map[i].dir;
+		g_cfg.svc_cfg[i].pipe_num = wlan_ce_svc_map[i].pipe;
+	}
+	g_cfg.shadow_reg_v2_valid = 1;
+	g_cfg.shadow_reg_v2_len = WLAN_SHADOW_N;
+	memcpy(g_cfg.shadow_reg_v2, wlan_shadow_v2, sizeof(wlan_shadow_v2));
+	printf("NEGRONI WLAN: WLAN_CFG host \"%s\", %u CE pipes, %u service routes, %u shadow registers v2 "
+	    "(CE0 src -> shadow %u at BAR0 %#x)\n", g_cfg.host_version, WLAN_CE_TGT_N, WLAN_CE_SVC_N, WLAN_SHADOW_N,
+	    WLAN_SHADOW_CE0_SRC, HAL_SHADOW_REG(WLAN_SHADOW_CE0_SRC));
+	error = wlfw_txn(&wlfw_wlan_cfg_req_d, &g_cfg, &wlfw_wlan_cfg_resp_d, &r, false, false);
+	if (error) {
+		return error;
+	}
+
+	negroni_wlan_step(26, "WLFW WLAN_MODE mission");
+	{
+		struct wlfw_wlan_mode_req q = { .mode = WLFW_MODE_MISSION, .hw_debug_valid = 1, .hw_debug = 0 };
+
+		error = wlfw_txn(&wlfw_wlan_mode_req_d, &q, &wlfw_wlan_mode_resp_d, &r, false, false);
+		if (error) {
+			return error;
+		}
+	}
+	printf("NEGRONI WLAN: WLAN firmware in mission mode (ath11k: copy engines next)\n");
+	return 0;
+}
+
+/* keep-alive (0320): QMI indications that arrive after level 6 are logged once each */
+void
+negroni_wlan_wlfw_idle(void)
+{
+	static bool cal_logged, ready_logged;
+
+	if (W.cal_done && !cal_logged) {
+		cal_logged = true;
+		printf("NEGRONI WLAN: QMI CAL_DONE_IND seen\n");
+	}
+	if (W.fw_ready && !ready_logged) {
+		ready_logged = true;
+		printf("NEGRONI WLAN: QMI FW_READY_IND seen\n");
+	}
+	if (W.req_mem) {
+		W.req_mem = false;
+		printf("NEGRONI WLAN: QMI REQUEST_MEM_IND after level 6 (%u segments); not answered\n", W.mem.mem_seg_len);
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_wlan_qmi.h b/bsd/dev/negroni_wlan_qmi.h
new file mode 100644
index 0000000..4a619e4
--- /dev/null
+++ b/bsd/dev/negroni_wlan_qmi.h
@@ -0,0 +1,74 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: a generic QMI TLV encoder/decoder (patch 0266).
+ *
+ * QMI wire format (Linux include/linux/soc/qcom/qmi.h, drivers/soc/qcom/qmi_encdec.c; read, not
+ * copied): a 7-byte header {u8 type; le16 txn_id; le16 msg_id; le16 msg_len}, then msg_len bytes
+ * of TLVs {u8 type; le16 length; value}. Inside a value, all numbers are little endian and packed:
+ *   - a nested string has a length prefix (u8 if max + 1 <= 255, else le16); a top-level
+ *     string has no prefix (the TLV length is the string length);
+ *   - a variable array has an element-count prefix (u8 or le16, set per field), then the elements;
+ *   - a struct is its members in order, with no padding.
+ * Optional TLVs (type >= 0x10) carry a "valid" byte in our C structs, not on the wire. A decoder
+ * skips TLV types it does not know (a newer firmware may add some).
+ *
+ * The message tables are in negroni_wlfw_tables.h. Every length the chip sends is checked.
+ */
+#ifndef _NEGRONI_WLAN_QMI_H_
+#define _NEGRONI_WLAN_QMI_H_
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#define QMI_HDR_LEN             7u
+#define QMI_REQUEST             0u      /* qmi.h:32 */
+#define QMI_RESPONSE            2u
+#define QMI_INDICATION          4u
+#define QMI_RESULT_SUCCESS      0u      /* qmi.h QMI_RESULT_SUCCESS_V01 */
+#define QMI_TLV_RESULT          0x02u   /* struct qmi_response_type_v01 {u16 result; u16 error} */
+
+enum {
+	QF_U8 = 1,      /* 1 byte */
+	QF_U16,         /* 2 bytes */
+	QF_U32,         /* 4 bytes (also the v01 signed 4-byte enums) */
+	QF_U64,         /* 8 bytes */
+	QF_STRING,      /* char[max + 1] in C; see above for the prefix */
+	QF_STRUCT,      /* members in `sub` */
+	QF_VARRAY,      /* count prefix (lensz bytes) + elements of `ekind` (QF_U8..QF_U64 or QF_STRUCT) */
+};
+
+#define QF_MANDATORY    (-1)
+
+struct qmi_field {
+	uint8_t tlv;            /* TLV type (top-level fields only; 0 in a nested table) */
+	uint8_t kind;           /* QF_* */
+	uint8_t lensz;          /* QF_VARRAY count prefix / nested QF_STRING length prefix: 1 or 2 */
+	uint8_t ekind;          /* QF_VARRAY element kind */
+	uint16_t off;           /* offset of the value in the C struct */
+	int16_t valid;          /* offset of the u8 valid flag, or QF_MANDATORY */
+	uint16_t count;         /* QF_VARRAY: offset of the uint32_t element count */
+	uint16_t max;           /* QF_VARRAY: max elements; QF_STRING: max characters */
+	uint16_t esize;         /* QF_VARRAY: C size of one element */
+	uint16_t nsub;          /* QF_STRUCT / QF_VARRAY of QF_STRUCT: number of members */
+	const struct qmi_field *sub;
+};
+
+struct qmi_msg_desc {
+	uint16_t id;            /* message id (request and response share it) */
+	const char *name;
+	const struct qmi_field *f;
+	uint16_t n;             /* fields in f */
+	uint32_t csize;         /* sizeof the C struct */
+};
+
+/* Encode `c` as one QMI message (header + TLVs) into buf. 0 or EMSGSIZE / EINVAL. */
+int negroni_qmi_encode(const struct qmi_msg_desc *d, uint8_t type, uint16_t txn, const void *c,
+    uint8_t *buf, uint32_t cap, uint32_t *outlen);
+/* Decode the TLVs of the message at buf (header included) into `c` (zeroed first). 0 or EBADMSG. */
+int negroni_qmi_decode(const struct qmi_msg_desc *d, const uint8_t *buf, uint32_t len, void *c);
+/* Header only: 0 and the fields, or EBADMSG (short, or msg_len beyond len). */
+int negroni_qmi_header(const uint8_t *buf, uint32_t len, uint8_t *type, uint16_t *txn, uint16_t *msg_id,
+    uint16_t *msg_len);
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
+#endif /* _NEGRONI_WLAN_QMI_H_ */
diff --git a/bsd/dev/negroni_wlan_qrtr.c b/bsd/dev/negroni_wlan_qrtr.c
new file mode 100644
index 0000000..dfe107d
--- /dev/null
+++ b/bsd/dev/negroni_wlan_qrtr.c
@@ -0,0 +1,389 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi, level 5 (patch 0265): QRTR over the MHI IPCR channels.
+ * Channel 20 carries host -> chip packets, channel 21 chip -> host (0264). One MHI transfer is
+ * one QRTR packet (Linux net/qrtr/mhi.c qcom_mhi_qrtr_send / dl_callback).
+ *
+ *   step 16  QRTR HELLO:          we send HELLO (v1 header, src node 1 port CTRL, dst node
+ *                                 BCAST until the chip's node is known, af_qrtr.c qrtr_hello_work
+ *                                 + qrtr_node_enqueue); the chip answers HELLO from its node.
+ *   step 17  WLFW service lookup: the chip's name service sends NEW_SERVER for each service;
+ *                                 we wait for service 0x45 version 1 (any instance) and keep its
+ *                                 node and port (the QMI WLFW server, cnss2 qmi.c:3292).
+ *
+ * Every field the chip sends is checked before use (negroni_qrtr_parse follows the rules of
+ * af_qrtr.c qrtr_endpoint_post). Received packets are copied out of the RX buffer by the MHI
+ * poller (rx_cb, which must not send) and handled later by negroni_wlan_qrtr_pump.
+ * Wire format read from Linux net/qrtr (GPL-2.0); this is our own code. UNTESTED ON HARDWARE.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include "negroni_wlan_mhi.h"
+#include "negroni_wlan_qrtr.h"
+
+struct qrtr_state negroni_qrtr;
+
+/* RX queue: filled by rx_cb (inside negroni_wlan_mhi_poll), drained by negroni_wlan_qrtr_pump */
+static uint8_t g_rxq[QRTR_RXQ_N][QRTR_RXQ_LEN];
+static uint32_t g_rxq_len[QRTR_RXQ_N];
+static uint32_t g_rxq_head, g_rxq_count;
+static uint8_t g_txb[WLAN_TX_LEN];      /* one packet being sent (send is never re-entered) */
+
+static inline uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+static inline uint32_t
+le16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+}
+
+static inline void
+put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16);
+	p[3] = (uint8_t)(v >> 24);
+}
+
+int
+negroni_qrtr_parse(const uint8_t *b, uint32_t len, struct qrtr_pkt *o)
+{
+	uint32_t hdrlen;
+
+	memset(o, 0, sizeof(*o));
+	if (!b || len == 0 || (len & 3)) {
+		return EBADMSG;
+	}
+	o->version = b[0];      /* v1: le32 version, low byte first; v2: u8 version */
+	if (o->version == QRTR_PROTO_VER_1) {
+		if (len < QRTR_HDR_V1_LEN) {
+			return EBADMSG;
+		}
+		o->type = le32(b + 4);
+		o->src_node = le32(b + 8);
+		o->src_port = le32(b + 12);
+		o->confirm_rx = le32(b + 16) != 0;
+		o->size = le32(b + 20);
+		o->dst_node = le32(b + 24);
+		o->dst_port = le32(b + 28);
+		hdrlen = QRTR_HDR_V1_LEN;
+	} else if (o->version == QRTR_PROTO_VER_2) {
+		if (len < QRTR_HDR_V2_LEN) {
+			return EBADMSG;
+		}
+		o->type = b[1];
+		o->confirm_rx = (b[2] & QRTR_FLAGS_CONFIRM_RX) != 0;
+		hdrlen = QRTR_HDR_V2_LEN + b[3];        /* optlen */
+		o->size = le32(b + 4);
+		o->src_node = le16(b + 8);
+		o->src_port = le16(b + 10);
+		o->dst_node = le16(b + 12);
+		o->dst_port = le16(b + 14);
+		if (o->src_port == (QRTR_PORT_CTRL & 0xffff)) {
+			o->src_port = QRTR_PORT_CTRL;
+		}
+		if (o->dst_port == (QRTR_PORT_CTRL & 0xffff)) {
+			o->dst_port = QRTR_PORT_CTRL;
+		}
+	} else {
+		return EBADMSG;
+	}
+	if (o->dst_port == QRTR_PORT_CTRL_LEGACY) {
+		o->dst_port = QRTR_PORT_CTRL;
+	}
+	/* size != 0, inside the buffer, and the buffer is exactly header + size padded to 4 */
+	if (hdrlen > len || o->size == 0 || o->size > len - hdrlen || ((o->size + 3u) & ~3u) != len - hdrlen) {
+		return EBADMSG;
+	}
+	if ((o->type == QRTR_TYPE_NEW_SERVER || o->type == QRTR_TYPE_DEL_SERVER ||
+	    o->type == QRTR_TYPE_RESUME_TX || o->type == QRTR_TYPE_DEL_CLIENT) && o->size < QRTR_CTRL_LEN) {
+		return EBADMSG;
+	}
+	if (o->type != QRTR_TYPE_DATA && o->type != QRTR_TYPE_RESUME_TX && o->dst_port != QRTR_PORT_CTRL) {
+		return EBADMSG;
+	}
+	o->payload = b + hdrlen;
+	return 0;
+}
+
+/* MHI channel 21 callback (inside negroni_wlan_mhi_poll): copy the packet out, nothing else. */
+static void
+qrtr_rx_cb(__unused struct mhi_host *h, const void *data, uint32_t len)
+{
+	if (len == 0 || len > QRTR_RXQ_LEN || g_rxq_count == QRTR_RXQ_N) {
+		if (negroni_qrtr.rx_drop++ < 4) {
+			printf("NEGRONI WLAN: QRTR packet of %u bytes dropped (%s)\n", len,
+			    g_rxq_count == QRTR_RXQ_N ? "queue full" : "size");
+		}
+		return;
+	}
+	uint32_t slot = (g_rxq_head + g_rxq_count) % QRTR_RXQ_N;
+
+	memcpy(g_rxq[slot], data, len);
+	g_rxq_len[slot] = len;
+	g_rxq_count++;
+}
+
+void
+negroni_wlan_qrtr_attach(struct mhi_host *h)
+{
+	if (!negroni_qrtr.attached) {
+		memset(&negroni_qrtr, 0, sizeof(negroni_qrtr));
+		g_rxq_head = g_rxq_count = 0;
+		negroni_qrtr.attached = true;
+	}
+	h->rx_cb = qrtr_rx_cb;
+}
+
+void
+negroni_wlan_qrtr_detach(struct mhi_host *h)
+{
+	h->rx_cb = NULL;
+	negroni_qrtr.data_cb = NULL;
+	negroni_qrtr.attached = false;
+	g_rxq_count = 0;
+}
+
+int
+negroni_wlan_qrtr_send(struct mhi_host *h, uint32_t type, uint32_t src_port, uint32_t dst_node,
+    uint32_t dst_port, const void *payload, uint32_t len)
+{
+	uint32_t padded = (len + 3u) & ~3u;
+
+	if (len == 0 || len > WLAN_TX_LEN - QRTR_HDR_V1_LEN || padded > WLAN_TX_LEN - QRTR_HDR_V1_LEN) {
+		return negroni_wlan_failed(ERANGE, "QRTR payload of %u bytes (max %u)", len,
+		           WLAN_TX_LEN - QRTR_HDR_V1_LEN);
+	}
+	put32(g_txb + 0, QRTR_PROTO_VER_1);
+	put32(g_txb + 4, type);
+	put32(g_txb + 8, QRTR_LOCAL_NODE);
+	put32(g_txb + 12, src_port);
+	put32(g_txb + 16, 0);                   /* confirm_rx: we never ask for RESUME_TX */
+	put32(g_txb + 20, len);
+	put32(g_txb + 24, dst_node);
+	put32(g_txb + 28, dst_port);
+	memcpy(g_txb + QRTR_HDR_V1_LEN, payload, len);
+	memset(g_txb + QRTR_HDR_V1_LEN + len, 0, padded - len);
+	return negroni_wlan_mhi_tx(h, g_txb, QRTR_HDR_V1_LEN + padded);
+}
+
+static int
+qrtr_send_ctrl(struct mhi_host *h, uint32_t cmd, uint32_t dst_node, uint32_t dst_port, uint32_t a, uint32_t b)
+{
+	uint8_t pkt[QRTR_CTRL_LEN];
+
+	memset(pkt, 0, sizeof(pkt));
+	put32(pkt, cmd);
+	put32(pkt + 4, a);
+	put32(pkt + 8, b);
+	return negroni_wlan_qrtr_send(h, cmd, cmd == QRTR_TYPE_RESUME_TX ? QRTR_LOCAL_PORT : QRTR_PORT_CTRL,
+	           dst_node, dst_port, pkt, sizeof(pkt));
+}
+
+static void
+qrtr_new_server(const struct qrtr_pkt *k)
+{
+	struct qrtr_server s = {
+		.service = le32(k->payload + 4), .instance = le32(k->payload + 8),
+		.node = le32(k->payload + 12), .port = le32(k->payload + 16),
+	};
+	struct qrtr_state *q = &negroni_qrtr;
+
+	for (uint32_t i = 0; i < q->nsrv; i++) {
+		if (!memcmp(&q->srv[i], &s, sizeof(s))) {
+			return;
+		}
+	}
+	if (q->nsrv < QRTR_MAX_SERVERS) {
+		q->srv[q->nsrv++] = s;
+	}
+	if (q->new_server_logged < QRTR_NEW_SERVER_LOG_MAX) {   /* the chip may send any number */
+		q->new_server_logged++;
+		printf("NEGRONI WLAN: QRTR NEW_SERVER service %#x version %u instance %u at node %u port %#x (from node %u)\n",
+		    s.service, s.instance & 0xff, s.instance >> 8, s.node, s.port, k->src_node);
+	}
+	if (s.service == WLFW_SERVICE_ID && (s.instance & 0xff) == WLFW_SERVICE_VERS && !q->wlfw_found) {
+		q->wlfw = s;
+		q->wlfw_found = true;
+		q->wlfw_gone = false;
+	}
+}
+
+static void
+qrtr_del_server(const struct qrtr_pkt *k)
+{
+	struct qrtr_server s = {
+		.service = le32(k->payload + 4), .instance = le32(k->payload + 8),
+		.node = le32(k->payload + 12), .port = le32(k->payload + 16),
+	};
+	struct qrtr_state *q = &negroni_qrtr;
+
+	for (uint32_t i = 0; i < q->nsrv; i++) {
+		if (!memcmp(&q->srv[i], &s, sizeof(s))) {
+			q->srv[i] = q->srv[--q->nsrv];
+			break;
+		}
+	}
+	printf("NEGRONI WLAN: QRTR DEL_SERVER service %#x instance %#x node %u port %#x\n", s.service,
+	    s.instance, s.node, s.port);
+	if (q->wlfw_found && !memcmp(&q->wlfw, &s, sizeof(s))) {
+		q->wlfw_gone = true;
+	}
+}
+
+static void
+qrtr_handle(struct mhi_host *h, const uint8_t *buf, uint32_t len)
+{
+	struct qrtr_state *q = &negroni_qrtr;
+	struct qrtr_pkt k;
+
+	if (negroni_qrtr_parse(buf, len, &k)) {
+		if (q->rx_bad++ < 4) {
+			printf("NEGRONI WLAN: QRTR bad packet of %u bytes ignored (first word %#x)\n", len,
+			    len >= 4 ? le32(buf) : 0);
+		}
+		return;
+	}
+	q->rx_ok++;
+	switch (k.type) {
+	case QRTR_TYPE_HELLO:
+		if (!q->hello_rx) {
+			q->hello_rx = true;
+			q->remote_node = k.src_node;
+			printf("NEGRONI WLAN: step 16 QRTR HELLO from node %u\n", k.src_node);
+			printf("NEGRONI WLAN: QRTR header v%u, HELLO src port %#x, dst node %#x port %#x\n",
+			    k.version == QRTR_PROTO_VER_1 ? 1 : 2, k.src_port, k.dst_node, k.dst_port);
+		} else if (k.src_node != q->remote_node) {
+			printf("NEGRONI WLAN: QRTR second HELLO from node %u (first node %u) ignored\n", k.src_node,
+			    q->remote_node);
+		}
+		break;
+	case QRTR_TYPE_NEW_SERVER:
+		qrtr_new_server(&k);
+		break;
+	case QRTR_TYPE_DEL_SERVER:
+		qrtr_del_server(&k);
+		break;
+	case QRTR_TYPE_BYE:
+		q->bye = true;
+		printf("NEGRONI WLAN: QRTR BYE from node %u\n", k.src_node);
+		break;
+	case QRTR_TYPE_RESUME_TX:
+		q->rx_resume++;
+		break;
+	case QRTR_TYPE_DATA:
+		if (k.dst_port != QRTR_LOCAL_PORT || !q->data_cb) {
+			if (q->rx_unrouted++ < 4) {
+				printf("NEGRONI WLAN: QRTR DATA of %u bytes from node %u port %#x to port %#x dropped\n",
+				    k.size, k.src_node, k.src_port, k.dst_port);
+			}
+			break;
+		}
+		q->rx_data++;
+		/* the sender waits for RESUME_TX (af_qrtr.c qrtr_recvmsg -> qrtr_send_resume_tx) */
+		if (k.confirm_rx) {
+			if (!qrtr_send_ctrl(h, QRTR_TYPE_RESUME_TX, k.src_node, k.src_port, QRTR_LOCAL_NODE,
+			    QRTR_LOCAL_PORT)) {
+				q->tx_resume++;
+			}
+		}
+		q->data_cb(k.src_node, k.src_port, k.payload, k.size);
+		break;
+	default:        /* DEL_CLIENT, PING, lookups: nothing for a client-only node */
+		break;
+	}
+}
+
+int
+negroni_wlan_qrtr_pump(struct mhi_host *h)
+{
+	(void)negroni_wlan_mhi_poll(h);
+	while (g_rxq_count) {
+		uint32_t slot = g_rxq_head;
+
+		/* the slot stays counted while it is handled: rx_cb (during a send) cannot reuse it */
+		qrtr_handle(h, g_rxq[slot], g_rxq_len[slot]);
+		g_rxq_head = (g_rxq_head + 1) % QRTR_RXQ_N;
+		g_rxq_count--;
+	}
+	uint32_t st = negroni_wlan_rd(MHI_STATUS);
+	if (h->syserr || h->rddm_seen || st == MHI_ALL_ONES || (st & MHI_STATUS_SYSERR)) {
+		h->syserr = true;
+		return negroni_wlan_failed(EIO, "the chip stopped (MHISTATUS %#x, EE %u, RDDM %u)", st, h->ee,
+		           h->rddm_seen ? 1 : 0);
+	}
+	return 0;
+}
+
+int
+negroni_wlan_qrtr_hello(struct mhi_host *h)
+{
+	struct qrtr_state *q = &negroni_qrtr;
+	uint64_t deadline;
+	int error;
+
+	negroni_wlan_qrtr_attach(h);
+	error = negroni_wlan_qrtr_pump(h);      /* the chip may say HELLO first */
+	if (error) {
+		return error;
+	}
+	error = qrtr_send_ctrl(h, QRTR_TYPE_HELLO, q->hello_rx ? q->remote_node : QRTR_NODE_BCAST,
+	    QRTR_PORT_CTRL, 0, 0);
+	if (error) {
+		return error;
+	}
+	q->hello_sent = true;
+	printf("NEGRONI WLAN: QRTR HELLO sent from node %u (channel 20, %u RX packets so far)\n", QRTR_LOCAL_NODE,
+	    h->rx_packets);
+	deadline = negroni_wlan_ms() + h->timeout_ms;
+	while (!q->hello_rx) {
+		error = negroni_wlan_qrtr_pump(h);
+		if (error) {
+			return error;
+		}
+		if (negroni_wlan_ms() >= deadline) {
+			return negroni_wlan_failed(ETIMEDOUT, "no HELLO from the chip in %u ms (RX packets %u, bad %u, "
+			           "dropped %u, TX done %u of %u)", h->timeout_ms, h->rx_packets, q->rx_bad, q->rx_drop,
+			           h->tx_done, h->tx_packets);
+		}
+		delay(1000);
+	}
+	return 0;
+}
+
+int
+negroni_wlan_qrtr_find_wlfw(struct mhi_host *h)
+{
+	struct qrtr_state *q = &negroni_qrtr;
+	uint64_t deadline = negroni_wlan_ms() + h->timeout_ms;
+	int error;
+
+	while (!q->wlfw_found) {
+		error = negroni_wlan_qrtr_pump(h);
+		if (error) {
+			return error;
+		}
+		if (q->bye) {
+			return negroni_wlan_failed(EIO, "the chip sent BYE before the WLFW service");
+		}
+		if (negroni_wlan_ms() >= deadline) {
+			return negroni_wlan_failed(ETIMEDOUT, "no NEW_SERVER for service %#x version %u in %u ms "
+			           "(%u other servers seen)", WLFW_SERVICE_ID, WLFW_SERVICE_VERS, h->timeout_ms, q->nsrv);
+		}
+		delay(1000);
+	}
+	printf("NEGRONI WLAN: step 17 WLFW service at node %u port %#x\n", q->wlfw.node, q->wlfw.port);
+	printf("NEGRONI WLAN: WLFW instance %#x (version %u, instance id %u), %u servers known\n", q->wlfw.instance,
+	    q->wlfw.instance & 0xff, q->wlfw.instance >> 8, q->nsrv);
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_wlan_qrtr.h b/bsd/dev/negroni_wlan_qrtr.h
new file mode 100644
index 0000000..4dc5b36
--- /dev/null
+++ b/bsd/dev/negroni_wlan_qrtr.h
@@ -0,0 +1,93 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: QRTR (IPC router) over the MHI IPCR channels 20/21 (patch 0265).
+ * Wire format from Linux net/qrtr (af_qrtr.c struct qrtr_hdr_v1 / qrtr_hdr_v2, ns.c,
+ * include/uapi/linux/qrtr.h; GPL-2.0, values only, no code) and the OnePlus copy in
+ * out/src/op-kernel net/qrtr. UNTESTED ON HARDWARE.
+ *
+ * The host is node QRTR_LOCAL_NODE with one client port (QRTR_LOCAL_PORT). The chip runs its
+ * own name service: after our HELLO it answers with its HELLO and one NEW_SERVER per service
+ * (ns.c ctrl_cmd_hello -> announce_servers). A NEW_LOOKUP never goes over the link (ns.c:
+ * lookups are local only).
+ */
+#ifndef _NEGRONI_WLAN_QRTR_H_
+#define _NEGRONI_WLAN_QRTR_H_
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+
+#include <stdint.h>
+#include <stdbool.h>
+#include "negroni_wlan_mhi.h"
+
+#define QRTR_PROTO_VER_1        1u      /* af_qrtr.c:30 */
+#define QRTR_PROTO_VER_2        3u      /* af_qrtr.c:31 */
+#define QRTR_HDR_V1_LEN         32u     /* 8 x le32 */
+#define QRTR_HDR_V2_LEN         16u     /* u8 x4, le32 size, le16 x4 */
+#define QRTR_CTRL_LEN           20u     /* struct qrtr_ctrl_pkt: le32 cmd + 4 x le32 */
+#define QRTR_NODE_BCAST         0xffffffffu     /* uapi qrtr.h:8 */
+#define QRTR_PORT_CTRL          0xfffffffeu     /* uapi qrtr.h:9 */
+#define QRTR_PORT_CTRL_LEGACY   0xffffu         /* af_qrtr.c:37 */
+#define QRTR_FLAGS_CONFIRM_RX   0x1u            /* v2 flags bit 0 */
+
+/* uapi qrtr.h enum qrtr_pkt_type */
+#define QRTR_TYPE_DATA          1u
+#define QRTR_TYPE_HELLO         2u
+#define QRTR_TYPE_BYE           3u
+#define QRTR_TYPE_NEW_SERVER    4u
+#define QRTR_TYPE_DEL_SERVER    5u
+#define QRTR_TYPE_DEL_CLIENT    6u
+#define QRTR_TYPE_RESUME_TX     7u
+#define QRTR_TYPE_EXIT          8u
+#define QRTR_TYPE_PING          9u
+#define QRTR_TYPE_NEW_LOOKUP    10u
+#define QRTR_TYPE_DEL_LOOKUP    11u
+
+/* CONFIG_QRTR_NODE_ID default 1 (op-kernel net/qrtr/Kconfig:17-19); first ephemeral port 0x4000 */
+#define QRTR_LOCAL_NODE         1u
+#define QRTR_LOCAL_PORT         0x4000u
+
+/* WLFW service (wlan_firmware_service_v01.h:11-12); NEW_SERVER instance = version | ins << 8 */
+#define WLFW_SERVICE_ID         0x45u
+#define WLFW_SERVICE_VERS       0x01u
+
+#define QRTR_MAX_SERVERS        32u
+#define QRTR_NEW_SERVER_LOG_MAX 48u             /* NEW_SERVER lines printed at most */
+#define QRTR_RXQ_N              8u              /* received packets waiting for qrtr_pump */
+#define QRTR_RXQ_LEN            0x2000u         /* 8 KiB per queued packet (WLFW max 1824 + headers) */
+
+/* one decoded packet (all values host order; payload points into the caller's buffer) */
+struct qrtr_pkt {
+	uint32_t version, type, src_node, src_port, dst_node, dst_port, size;
+	bool confirm_rx;
+	const uint8_t *payload;
+};
+
+struct qrtr_server {
+	uint32_t service, instance, node, port;
+};
+
+struct qrtr_state {
+	bool attached, hello_sent, hello_rx, bye;
+	uint32_t remote_node;           /* src node of the chip's HELLO */
+	struct qrtr_server srv[QRTR_MAX_SERVERS];
+	uint32_t nsrv, new_server_logged;
+	bool wlfw_found, wlfw_gone;
+	struct qrtr_server wlfw;
+	uint32_t rx_ok, rx_bad, rx_drop, rx_data, rx_unrouted, rx_resume, tx_resume;
+	/* 0266: QMI layer; called from qrtr_pump for each DATA packet to our port (payload only) */
+	void (*data_cb)(uint32_t node, uint32_t port, const uint8_t *p, uint32_t len);
+};
+
+extern struct qrtr_state negroni_qrtr;
+
+/* pure decoder, every length checked against len (af_qrtr.c qrtr_endpoint_post rules) */
+int negroni_qrtr_parse(const uint8_t *buf, uint32_t len, struct qrtr_pkt *out);
+
+void negroni_wlan_qrtr_attach(struct mhi_host *h);      /* rx_cb on channel 21 */
+void negroni_wlan_qrtr_detach(struct mhi_host *h);
+int negroni_wlan_qrtr_pump(struct mhi_host *h);         /* MHI poll + handle queued packets */
+int negroni_wlan_qrtr_send(struct mhi_host *h, uint32_t type, uint32_t src_port, uint32_t dst_node,
+    uint32_t dst_port, const void *payload, uint32_t len);
+int negroni_wlan_qrtr_hello(struct mhi_host *h);        /* step 16 */
+int negroni_wlan_qrtr_find_wlfw(struct mhi_host *h);    /* step 17 */
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
+#endif /* _NEGRONI_WLAN_QRTR_H_ */
diff --git a/bsd/dev/negroni_wlan_smmu.c b/bsd/dev/negroni_wlan_smmu.c
new file mode 100644
index 0000000..aaa1cc7
--- /dev/null
+++ b/bsd/dev/negroni_wlan_smmu.c
@@ -0,0 +1,737 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi (patches 0324, 0325): an apps-SMMU stage-1 context for the WLAN PCIe stream.
+ * Opt-in with negroniwlan_smmu=3 (the default is 1 again: a 0249 boot showed Gunyah refusing a GR1 CBAR write).
+ *
+ * Why: XNU's RAM starts at 0x840000000, so every buffer the 0261-0323 code gives the chip is above 4 GiB.
+ * Android gives this chip IOVAs from 0xa0000000 + 256 MiB (out/live.dts cnss_pci_iommu_group:
+ * qcom,iommu-dma-addr-pool, qcom,iommu-dma = "fastmap", qcom,iommu-pagetable = "coherent", qcom,iommu-faults =
+ * "stall-disable", "HUPCF", "no-CFRE", "non-fatal"). The hypervisor (Gunyah) turns an S2CR BYPASS into FAULT
+ * (Linux arm-smmu-qcom.c bypass quirk, U-Boot qcom-hyp-smmu.c), so the only way for the chip to reach RAM is a
+ * translation context. Each host buffer is mapped page by page at the next free IOVA from 0xa0000000.
+ *
+ * Stream: PCIe0 has qcom,smmu-sid-base 0x1c00 and iommu-map RID 0x100 -> 0x1c01 (RID 0 -> 0x1c00). The PCIe
+ * controller makes the SID from its BDF-to-SID table (pci-msm.c msm_pcie_config_sid), which the survey's core
+ * reset clears; negroni_wlan.c programs it again (0325). The SMR covers 0x1c00 and 0x1c01 (mask 1) when no
+ * other SMR covers either, so a table that did not take still matches.
+ *
+ * Context bank choice (U-Boot qcom-hyp-smmu.c alloc_cb + Linux sm8450 arm-smmu.c, as 0249 after the 2026-10-27
+ * panic): from MAX(IDR1.NUMS2CB, 1); not marked READ_ABORT / CLAIM_REFUSED / OURS in negroni_smmu_cb_verdict[] (0249
+ * probe); CBAR type S2_TRANS, or S1_TRANS_S2_BYPASS with VMID 0xff; SCTLR.M = 0; no valid S2CR translating into it;
+ * then the claim (SCTLR 0, CBA2R, CBAR) through negroni_mmio_try_wr32 (0297): a refused write skips the bank. CBAR and
+ * CBA2R are never written back on teardown.
+ * Programming (Linux arm_smmu_write_context_bank order): SCTLR 0, CBA2R VA64, CBAR S1_TRANS_S2_BYPASS VMID 0,
+ * TCR2, TCR, TTBR0/1, MAIR0/1, FSR clear, TLBIASID + sync, SCTLR on (M TRE AFE HUPCF ASIDPNE; no CFRE, no CFIE,
+ * CFCFG 0 = no stall: Android's fault attributes), then S2CR -> context, then SMR (arm_smmu_write_sme order).
+ * Every write is read back. Faults: context FSR/FAR/FSYNR0/FSYNR1/CBFRSYNRA and global sGFSR/sGFSYNR0-2
+ * are decoded at every heartbeat, at the end of each level and on the failure path.
+ *
+ * Every access is one plain 32-bit ldr/str (negroni_mmio.h, 0255): Gunyah emulates the global space and
+ * injects a synchronous external abort on a writeback, pair, 64-bit or WZR access. UNTESTED ON HARDWARE.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include "negroni_mmio.h"
+#include "negroni_wlan.h"
+#include "negroni_wlan_mhi.h"
+#include <kern/locks.h>
+#include "negroni_smmu_s1.h"       /* 0249: negroni_smmu_claim_lock, shared with the camera/audio stage-1 helper */
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+extern vm_map_address_t phystokv(uint64_t pa);  /* osfmk/arm/pmap/pmap.h */
+
+#define APPS_SMMU_PHYS          0x15000000u
+#define APPS_SMMU_SIZE          0x100000u       /* live.dts apps-smmu reg */
+#define WLAN_WIMG_IO            0x7u
+#define WLAN_SID_EP             0x1c01u         /* RID 0x100 (bus 1, the QCA6490) */
+#define WLAN_SID_RC             0x1c00u         /* RID 0 (root port) */
+#define IOVA_BASE               0xa0000000ull   /* live.dts qcom,iommu-dma-addr-pool, as Android */
+#define IOVA_SIZE               0x10000000ull
+
+/* global space 0 */
+#define SMMU_SCR0               0x000
+#define SMMU_SCR0_EXIDENABLE    (1u << 3)
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_SGFSR              0x048
+#define SMMU_SGFSYNR0           0x050
+#define SMMU_SGFSYNR1           0x054
+#define SMMU_SGFSYNR2           0x058
+#define SMMU_SMR(n)             (0x800u + 4u * (n))
+#define SMMU_S2CR(n)            (0xc00u + 4u * (n))
+#define SMMU_SMR_VALID          (1u << 31)
+/* global space 1 (one page after space 0) */
+#define SMMU_CBAR(n)            (4u * (n))
+#define SMMU_CBFRSYNRA(n)       (0x400u + 4u * (n))
+#define SMMU_CBA2R(n)           (0x800u + 4u * (n))
+#define CBAR_TYPE(v)            (((v) >> 16) & 3u)
+#define CBAR_VMID(v)            ((v) & 0xffu)
+#define CBAR_TYPE_S2_TRANS      0u
+#define CBAR_TYPE_S1_S2_BYPASS  1u
+#define VMID_UNUSED             0xffu           /* U-Boot qcom-hyp-smmu.c */
+/* S1_TRANS_S2_BYPASS (type 1), BPSHCFG 3 (non-shareable), MEMATTR 0xf (WB), VMID 0 (U-Boot, Linux arm-smmu) */
+#define CBAR_S1                 (1u << 16 | 0xfu << 12 | 3u << 8)
+#define CBA2R_VA64              1u
+/* context bank page */
+#define CB_SCTLR                0x00
+#define CB_TCR2                 0x10
+#define CB_TTBR0                0x20
+#define CB_TTBR1                0x28
+#define CB_TCR                  0x30
+#define CB_MAIR0                0x38
+#define CB_MAIR1                0x3c
+#define CB_FSR                  0x58
+#define CB_FAR                  0x60
+#define CB_FSYNR0               0x68
+#define CB_FSYNR1               0x6c
+#define CB_TLBIASID             0x610
+#define CB_TLBSYNC              0x7f0
+#define CB_TLBSTATUS            0x7f4
+/*
+ * SCTLR: M (0), TRE (1), AFE (2), HUPCF (8, "HUPCF"), ASIDPNE (12). Not set: CFRE (5, Android "no-CFRE": a
+ * faulting access completes as read-zero / write-ignored instead of an abort to the chip), CFIE (6, nobody takes
+ * the interrupt), CFCFG (7, "stall-disable": terminate, never stall).
+ */
+#define SCTLR_ON                (1u << 0 | 1u << 1 | 1u << 2 | 1u << 8 | 1u << 12)
+/* TCR: T0SZ 25 (39-bit IOVA), IRGN0/ORGN0 WBWA, SH0 inner shareable ("coherent" walk), TG0 4 KiB, EPD1 */
+#define TCR_39                  (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+/* TCR2: PASIZE 36 bit, AS (16-bit ASID), SEP upstream */
+#define TCR2_36                 (1u | 1u << 4 | 7u << 15)
+#define MAIR0                   0xf404ff44u     /* Linux io-pgtable: 0 Normal NC, 1 WBWA, 2 Device nGnRE */
+#define FSR_ALL                 0xc00001feu
+/* page entry (io-pgtable-arm.c, non-cacheable buffer): page | AttrIndx 0 (NC) | AP unprivileged | SH outer | AF | nG */
+#define PTE_VALID               3ull
+#define PTE_ATTR                ((1ull << 6) | (2ull << 8) | (1ull << 10) | (1ull << 11))
+#define PTE_ADDR                0x0000fffffffff000ull
+/*
+ * 16 KiB kernel pages, 4 tables each: 192 tables. The whole IOVA window 0xa0000000-0xafffffff lies in one level-1
+ * entry, so mapping all of it takes 1 root + 1 level-2 + 128 level-3 tables = 130 (each level-3 table maps 2 MiB):
+ * HTT rings, CE and RX buffers can never run out of tables before the 256 MiB window itself is full.
+ */
+#define TABLE_PAGES             48u
+#define TLB_SYNC_MS             500u            /* as 0249 (SMMU agent, 2026-10-27) */
+#define CLAIM_TRIES             8u
+
+static vm_offset_t g_smmu;
+static uint32_t g_page, g_pages, g_ctx_n, g_smr_n, g_nums2cb;
+static uint32_t g_cb = ~0u, g_smr = ~0u, g_smr_val, g_old_smr, g_old_s2cr, g_old_cbar, g_old_cba2r;
+static bool g_on, g_smr_reused, g_cb_written, g_sme_written;
+/* 0325 (review 2026-10-27): what setup proved writable (written and read back); teardown writes only these */
+static bool g_ok_sctlr, g_ok_cba2r, g_ok_cbar, g_ok_s2cr, g_ok_smr;
+static uint32_t g_gfsr0, g_last_fsr, g_last_gfsr, g_fault_lines;
+static uint64_t g_next = IOVA_BASE;
+static vm_offset_t g_tpage[TABLE_PAGES];
+static uint32_t g_tpages, g_tleft;
+static uint64_t *g_root;
+static uint64_t g_root_pa;
+static uint32_t g_mapped_pages;
+
+#define SR(o)           negroni_mmio_rd32(g_smmu + (o))
+#define SW(o, v)        negroni_mmio_wr32(g_smmu + (o), (v))
+#define GR1(o)          (g_page + (o))
+#define CB(o)           ((g_pages + g_cb) * g_page + (o))
+
+/*
+ * Write, read back, compare (as slop 0105 put()). Bits in `must` that do not read back stop the step before
+ * any DMA; other differences are printed and kept (redwood: "everything read back as written but two bits").
+ */
+static int
+sr_put(const char *name, uint32_t off, uint32_t v, uint32_t must)
+{
+	SW(off, v);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t got = SR(off);
+	if ((got ^ v) & must) {
+		return negroni_wlan_failed(EPERM, "SMMU %s reads %#x after writing %#x (the hypervisor refused it?)", name, got, v);
+	}
+	if (got != v) {
+		printf("NEGRONI WLAN: SMMU %s reads %#x after writing %#x (bits %#x not kept; not needed)\n", name, got, v,
+		    got ^ v);
+	}
+	return 0;
+}
+
+static bool
+smmu_tlb_sync(uint32_t ms_max)
+{
+	uint64_t deadline = negroni_wlan_ms() + ms_max;
+
+	SW(CB(CB_TLBIASID), g_cb);
+	SW(CB(CB_TLBSYNC), 1);
+	while (SR(CB(CB_TLBSTATUS)) & 1) {
+		if (negroni_wlan_ms() >= deadline) {
+			return false;
+		}
+		delay(10);
+	}
+	return true;
+}
+
+static void
+tbl_flush(const void *p, size_t n)
+{
+	for (vm_offset_t a = (vm_offset_t)p & ~(vm_offset_t)63; a < (vm_offset_t)p + n; a += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (a));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static uint64_t *
+tbl_new(uint64_t *pa_out)
+{
+	if (g_tleft == 0) {
+		if (g_tpages == TABLE_PAGES || kmem_alloc(kernel_map, &g_tpage[g_tpages], PAGE_SIZE,
+		    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		g_tpages++;
+		g_tleft = PAGE_SIZE / 4096;
+	}
+	uint64_t *t = (uint64_t *)(g_tpage[g_tpages - 1] + PAGE_SIZE - 4096 * g_tleft--);
+	tbl_flush(t, 4096);
+	*pa_out = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)(vm_offset_t)t)) + ((vm_offset_t)t & PAGE_MASK);
+	return t;
+}
+
+static uint64_t *
+tbl_next(uint64_t *entry, bool make)
+{
+	uint64_t pa;
+
+	if (*entry & 1) {
+		return (uint64_t *)phystokv(*entry & PTE_ADDR);
+	}
+	if (!make) {
+		return NULL;
+	}
+	uint64_t *t = tbl_new(&pa);
+	if (t) {
+		*entry = pa | PTE_VALID;
+		tbl_flush(entry, sizeof(*entry));
+	}
+	return t;
+}
+
+static uint64_t *
+pte_of(uint64_t iova, bool make)
+{
+	uint64_t *l2 = tbl_next(&g_root[(iova >> 30) & 0x1ff], make);
+	uint64_t *l3 = l2 ? tbl_next(&l2[(iova >> 21) & 0x1ff], make) : NULL;
+
+	return l3 ? &l3[(iova >> 12) & 0x1ff] : NULL;
+}
+
+/* the chip's IOVA for `size` contiguous bytes at `pa` (negroni_wlan_dma_map with negroniwlan_smmu=3) */
+uint64_t
+negroni_wlan_smmu_map(uint64_t pa, uint32_t size)
+{
+	uint64_t span = ((pa & 0xfff) + size + 0xfff) & ~0xfffull, iova = g_next;
+
+	if (!g_on || size == 0 || iova + span > IOVA_BASE + IOVA_SIZE) {
+		printf("NEGRONI WLAN: SMMU map of %#x bytes at %#llx refused (%s)\n", size, pa,
+		    !g_on ? "no context" : "IOVA window full");
+		return WLAN_DMA_NONE;
+	}
+	for (uint64_t o = 0; o < span; o += 4096) {
+		uint64_t *e = pte_of(iova + o, true);
+		if (!e) {
+			printf("NEGRONI WLAN: SMMU map: no page-table page left (%u pages mapped)\n", g_mapped_pages);
+			return WLAN_DMA_NONE;
+		}
+		*e = (((pa & ~0xfffull) + o) & PTE_ADDR) | PTE_ATTR | PTE_VALID;
+		tbl_flush(e, sizeof(*e));
+	}
+	g_next = (iova + span + 0xffff) & ~0xffffull;   /* 64 KiB apart: a stray access past a buffer faults */
+	g_mapped_pages += (uint32_t)(span / 4096);
+	if (!smmu_tlb_sync(TLB_SYNC_MS)) {    /* fresh IOVAs have no stale entry; cheap, once per buffer */
+		printf("NEGRONI WLAN: SMMU map: TLB sync did not finish in %u ms; IOVA %#llx not used\n", TLB_SYNC_MS, iova);
+		return WLAN_DMA_NONE;
+	}
+	printf("NEGRONI WLAN: SMMU map %#llx (%#x bytes) -> IOVA %#llx\n", pa, size, iova + (pa & 0xfff));
+	return iova + (pa & 0xfff);
+}
+
+/* 0325: take a mapping away (a buffer freed while the chip runs); the IOVA is not handed out again */
+void
+negroni_wlan_smmu_unmap(uint64_t iova, uint32_t size)
+{
+	if (!g_on || iova < IOVA_BASE || iova >= IOVA_BASE + IOVA_SIZE || size == 0) {
+		return;
+	}
+	uint64_t start = iova & ~0xfffull, end = (iova + size + 0xfff) & ~0xfffull;
+	for (uint64_t a = start; a < end; a += 4096) {
+		uint64_t *e = pte_of(a, false);
+		if (e && (*e & 1)) {
+			*e = 0;
+			tbl_flush(e, sizeof(*e));
+			g_mapped_pages--;
+		}
+	}
+	if (!smmu_tlb_sync(TLB_SYNC_MS)) {
+		printf("NEGRONI WLAN: SMMU unmap: TLB sync did not finish in %u ms\n", TLB_SYNC_MS);
+	}
+	printf("NEGRONI WLAN: SMMU unmap IOVA %#llx (%#x bytes)\n", iova, size);
+}
+
+bool
+negroni_wlan_smmu_active(void)
+{
+	return g_on;
+}
+
+/* 0325: the MHI CTRL/DATA window = the IOVA window (cnss2 pci.c:5505-5507 with an SMMU) */
+bool
+negroni_wlan_smmu_window(uint64_t *base, uint64_t *limit)
+{
+	if (!g_on) {
+		return false;
+	}
+	*base = IOVA_BASE;
+	*limit = IOVA_BASE + IOVA_SIZE - 1;
+	return true;
+}
+
+static void
+fsr_text(char *b, size_t n, uint32_t fsr)
+{
+	static const struct { uint32_t bit; const char *name; } k[] = {
+		{ 1u << 1, "TF translation" }, { 1u << 2, "AFF access flag" }, { 1u << 3, "PF permission" },
+		{ 1u << 4, "EF external" }, { 1u << 5, "TLBMCF" }, { 1u << 6, "TLBLKF" }, { 1u << 7, "ASF" },
+		{ 1u << 8, "UUT" }, { 1u << 30, "SS stalled" }, { 1u << 31, "MULTI" },
+	};
+	b[0] = 0;
+	for (size_t i = 0; i < sizeof(k) / sizeof(k[0]); i++) {
+		if (fsr & k[i].bit) {
+			strlcat(b, b[0] ? ", " : "", n);
+			strlcat(b, k[i].name, n);
+		}
+	}
+	if (!b[0]) {
+		strlcpy(b, "none", n);
+	}
+}
+
+static void
+gfsr_text(char *b, size_t n, uint32_t g)
+{
+	static const struct { uint32_t bit; const char *name; } k[] = {
+		{ 1u << 0, "ICF invalid context" }, { 1u << 1, "USF unidentified stream" }, { 1u << 2, "SMCF stream match conflict" },
+		{ 1u << 3, "UCBF" }, { 1u << 4, "UCIF" }, { 1u << 5, "CAF" }, { 1u << 6, "EF" }, { 1u << 7, "PF" },
+		{ 1u << 8, "UUT" }, { 1u << 31, "MULTI" },
+	};
+	b[0] = 0;
+	for (size_t i = 0; i < sizeof(k) / sizeof(k[0]); i++) {
+		if (g & k[i].bit) {
+			strlcat(b, b[0] ? ", " : "", n);
+			strlcat(b, k[i].name, n);
+		}
+	}
+	if (!b[0]) {
+		strlcpy(b, "none", n);
+	}
+}
+
+/* one full fault line: context (FSR decoded, FAR, FSYNR0 W/R + level, the faulting SID) and global */
+static void
+smmu_fault_line(const char *where, uint32_t fsr, uint32_t gfsr)
+{
+	char ft[96], gt[96];
+	uint32_t fsynr0 = SR(CB(CB_FSYNR0));
+
+	fsr_text(ft, sizeof(ft), fsr);
+	gfsr_text(gt, sizeof(gt), gfsr);
+	printf("NEGRONI WLAN: SMMU %s: context %u FSR %#x (%s) FAR %#x%08x FSYNR0 %#x (%s, level %u%s) FSYNR1 %#x "
+	    "SID %#x; global sGFSR %#x (%s) sGFSYNR0 %#x sGFSYNR1 %#x (SID %#x) sGFSYNR2 %#x; %u pages mapped\n", where,
+	    g_cb, fsr, ft, SR(CB(CB_FAR + 4)), SR(CB(CB_FAR)), fsynr0, (fsynr0 & (1u << 4)) ? "write" : "read",
+	    fsynr0 & 3u, (fsynr0 & (1u << 10)) ? ", table walk" : "", SR(CB(CB_FSYNR1)),
+	    SR(GR1(SMMU_CBFRSYNRA(g_cb))) & 0xffffu, gfsr, gt, SR(SMMU_SGFSYNR0), SR(SMMU_SGFSYNR1),
+	    SR(SMMU_SGFSYNR1) & 0xffffu, SR(SMMU_SGFSYNR2), g_mapped_pages);
+}
+
+/*
+ * 0325: cheap check for heartbeats and waits: prints a full fault line only when the context FSR or the
+ * global sGFSR changed since the last check (at most 16 lines per boot). True when a context fault is recorded.
+ */
+bool
+negroni_wlan_smmu_check(const char *where)
+{
+	if (!g_on) {
+		return false;
+	}
+	uint32_t fsr = SR(CB(CB_FSR)) & FSR_ALL, gfsr = SR(SMMU_SGFSR);
+	if ((fsr != g_last_fsr || gfsr != g_last_gfsr) && g_fault_lines < 16) {
+		g_fault_lines++;
+		smmu_fault_line(where, fsr, gfsr);
+	}
+	g_last_fsr = fsr;
+	g_last_gfsr = gfsr;
+	return fsr != 0;
+}
+
+/* always one line (also "no fault"): failure path before the quiesce, and after each level */
+void
+negroni_wlan_smmu_report(void)
+{
+	if (!g_on) {
+		return;
+	}
+	uint32_t fsr = SR(CB(CB_FSR)) & FSR_ALL, gfsr = SR(SMMU_SGFSR);
+	smmu_fault_line(fsr ? "FAULT" : "report (no context fault)", fsr, gfsr);
+	if (gfsr != g_gfsr0) {
+		printf("NEGRONI WLAN: SMMU global sGFSR changed since setup: %#x -> %#x (USF = a stream without an SMR, "
+		    "e.g. the chip on another SID than %#x)\n", g_gfsr0, gfsr, WLAN_SID_EP);
+	}
+	g_last_fsr = fsr;
+	g_last_gfsr = gfsr;
+}
+
+/* after the chip lost bus mastering: the stream back as it was, the context off, the tables freed */
+void
+negroni_wlan_smmu_off(void)
+{
+	bool locked = g_smmu && (g_sme_written || g_cb_written);
+
+	if (locked) {
+		lck_mtx_lock(&negroni_smmu_claim_lock);        /* 0249's helper scans the same entries */
+	}
+	/*
+	 * Only registers that setup wrote AND read back as written are written again here: a register the hypervisor
+	 * refused may also raise an SEA on the next write (0249 boot, 2026-10-27: SEA on a GR1 CBAR restore).
+	 */
+	if (g_smmu && g_sme_written) {
+		if (g_smr_reused) {
+			if (g_ok_s2cr) {
+				SW(SMMU_S2CR(g_smr), g_old_s2cr);       /* the SMR still matches: its old S2CR first */
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+			if (g_ok_smr) {
+				SW(SMMU_SMR(g_smr), g_old_smr);
+			}
+		} else {
+			if (g_ok_smr) {
+				SW(SMMU_SMR(g_smr), g_old_smr);         /* invalid first, then the S2CR */
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+			if (g_ok_s2cr) {
+				SW(SMMU_S2CR(g_smr), g_old_s2cr);
+			}
+		}
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	if (g_smmu && g_cb_written) {
+		if (g_ok_sctlr) {
+			SW(CB(CB_SCTLR), 0);
+			__asm__ volatile ("dsb sy" ::: "memory");
+			if (!smmu_tlb_sync(TLB_SYNC_MS)) {
+				printf("NEGRONI WLAN: SMMU context %u: TLB sync did not finish in %u ms at teardown\n", g_cb, TLB_SYNC_MS);
+			}
+		}
+		/*
+		 * CBAR and CBA2R are never written back (0249 panic, 2026-10-27: Gunyah refused a CBAR write with an SEA): the
+		 * bank stays claimed (stage 1, SCTLR 0) and negroni_smmu_cb_verdict[] keeps it as OURS.
+		 */
+		__asm__ volatile ("dsb sy" ::: "memory");
+		printf("NEGRONI WLAN: SMMU context %u off (SCTLR 0 %u; S2CR %u SMR %u restored; CBAR/CBA2R left claimed)\n", g_cb,
+		    g_ok_sctlr, g_ok_s2cr, g_ok_smr);
+	}
+	if (locked) {
+		lck_mtx_unlock(&negroni_smmu_claim_lock);
+	}
+	for (uint32_t i = 0; i < g_tpages; i++) {
+		kmem_free(kernel_map, g_tpage[i], PAGE_SIZE);
+	}
+	g_tpages = g_tleft = 0;
+	g_root = NULL;
+	if (g_smmu) {
+		ml_io_unmap(g_smmu, APPS_SMMU_SIZE);
+		g_smmu = 0;
+	}
+	g_on = g_cb_written = g_sme_written = false;
+	g_ok_sctlr = g_ok_cba2r = g_ok_cbar = g_ok_s2cr = g_ok_smr = false;
+	g_cb = g_smr = ~0u;
+	g_next = IOVA_BASE;
+	g_mapped_pages = 0;
+}
+
+/* (i1, m1) and (i2, m2) match a common stream ID (arm-smmu.c arm_smmu_find_sme overlap test) */
+static inline bool
+smr_overlap(uint32_t i1, uint32_t m1, uint32_t i2, uint32_t m2)
+{
+	return ((i1 ^ i2) & ~(m1 | m2) & 0x7fffu) == 0;
+}
+
+/* the stream-match entry: one that already matches 0x1c01 (reused), else a free one with our ID/mask */
+static int
+smmu_pick_smr(void)
+{
+	bool rc_taken = false;
+
+	for (uint32_t i = 0; i < g_smr_n; i++) {
+		uint32_t smr = SR(SMMU_SMR(i)), id = smr & 0x7fffu, mask = (smr >> 16) & 0x7fffu;
+		if (!(smr & SMMU_SMR_VALID)) {
+			continue;
+		}
+		if (g_smr == ~0u && smr_overlap(id, mask, WLAN_SID_EP, 0)) {
+			/*
+			 * Reuse only as the 0249 helper does: the SMR is exactly one of ours (0x1c00 mask 1, or 0x1c01) and its
+			 * S2CR does not translate (fault or bypass). Anything else is somebody's.
+			 */
+			uint32_t s2 = SR(SMMU_S2CR(i)), type = (s2 >> 16) & 3u;
+			bool exact = smr == (SMMU_SMR_VALID | WLAN_SID_RC | 1u << 16) || smr == (SMMU_SMR_VALID | WLAN_SID_EP);
+			if (!exact || type == 0) {
+				return negroni_wlan_failed(EBUSY, "SMMU SMR%u %#x (mask %#x) matches %#x and S2CR %#x %s (not ours)", i,
+				           smr, mask, WLAN_SID_EP, s2, !exact ? "is not one of our SMR values" : "translates");
+			}
+			g_smr = i;
+			g_smr_reused = true;
+			g_old_smr = smr;
+			g_smr_val = smr;
+			g_old_s2cr = s2;
+			printf("NEGRONI WLAN: SMMU SMR%u %#x (id %#x mask %#x) already matches %#x, S2CR %#x (%s): reused\n", i, smr, id,
+			    mask, WLAN_SID_EP, s2, type == 2 ? "fault" : "bypass");
+		} else if (smr_overlap(id, mask, WLAN_SID_RC, 0)) {
+			rc_taken = true;
+			printf("NEGRONI WLAN: SMMU SMR%u %#x matches the root-port stream %#x (S2CR %#x)\n", i, smr, WLAN_SID_RC,
+			    SR(SMMU_S2CR(i)));
+		}
+	}
+	if (g_smr != ~0u) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < g_smr_n; i++) {
+		uint32_t smr = SR(SMMU_SMR(i));
+		if (!(smr & SMMU_SMR_VALID)) {
+			g_smr = i;
+			g_old_smr = smr;
+			g_old_s2cr = SR(SMMU_S2CR(i));
+			break;
+		}
+	}
+	if (g_smr == ~0u) {
+		return negroni_wlan_failed(EBUSY, "no free SMMU stream-match entry (%u in use)", g_smr_n);
+	}
+	/* 0x1c00/mask 1: also matches if the controller's BDF-to-SID table did not take (bypass -> base SID [I]) */
+	g_smr_val = SMMU_SMR_VALID | (rc_taken ? WLAN_SID_EP : (WLAN_SID_RC | 1u << 16));
+	printf("NEGRONI WLAN: SMMU SMR%u free (was %#x, S2CR %#x): will match %s\n", g_smr, g_old_smr, g_old_s2cr,
+	    rc_taken ? "0x1c01 only (0x1c00 has its own SMR)" : "0x1c00-0x1c01 (mask 1)");
+	return 0;
+}
+
+/*
+ * A context bank and its claim (Linux sm8450 arm-smmu.c + U-Boot qcom-hyp-smmu.c, as 0249 after the 2026-10-27 panic):
+ * stage-1 banks from MAX(IDR1.NUMS2CB, 1) upward; skip a bank the 0249 probe or helper marked READ_ABORT, CLAIM_REFUSED
+ * or OURS (negroni_smmu_cb_verdict[]); every read of a candidate and the claim writes (SCTLR 0, CBA2R VA64, CBAR
+ * S1_TRANS_S2_BYPASS VMID 0) go through negroni_mmio_try_rd32/wr32 (0297: an SEA returns an error instead of a
+ * panic); a refused or not-kept claim skips the bank, at most CLAIM_TRIES banks. Under negroni_smmu_claim_lock.
+ */
+static int
+smmu_pick_cb(void)
+{
+	uint32_t n_s2 = 0, n_free_s1 = 0, n_other = 0, n_on = 0, n_ptr = 0, n_skip = 0, n_refused = 0, tries = 0;
+	uint32_t force = ~0u, first = MAX(g_nums2cb, 1u);
+
+	(void)PE_parse_boot_argn("negroniwlan_smmu_cb", &force, sizeof(force));
+	for (uint32_t c = first; c < g_ctx_n && c < 128 && g_cb == ~0u && tries < CLAIM_TRIES; c++) {
+		int8_t verdict = negroni_smmu_cb_verdict[c];
+		if (verdict == NEGRONI_CB_READ_ABORT || verdict == NEGRONI_CB_CLAIM_REFUSED || verdict == NEGRONI_CB_OURS ||
+		    verdict == NEGRONI_CB_REWRITE_REFUSED || verdict == NEGRONI_CB_REWRITE_CHANGED) {
+			n_skip++;
+			continue;
+		}
+		vm_offset_t cbp = g_smmu + (g_pages + c) * g_page;
+		uint32_t cbar = 0, cba2r = 0, sctlr = 0, tlbst = 0;
+		int r = negroni_mmio_try_rd32(g_smmu + GR1(SMMU_CBAR(c)), &cbar);
+		if (!r) {
+			r = negroni_mmio_try_rd32(g_smmu + GR1(SMMU_CBA2R(c)), &cba2r);
+		}
+		if (!r) {
+			r = negroni_mmio_try_rd32(cbp + CB_SCTLR, &sctlr);
+		}
+		if (!r) {
+			r = negroni_mmio_try_rd32(cbp + CB_TLBSTATUS, &tlbst);
+		}
+		if (r == -2) {
+			/* no XNUPOST in this kernel: no caught accesses, so no claim at all (an SEA would panic) */
+			return negroni_wlan_failed(ENOTSUP, "negroni_mmio_try_* not available (no CONFIG_XNUPOST): no safe claim");
+		}
+		if (r) {
+			negroni_smmu_cb_verdict[c] = NEGRONI_CB_READ_ABORT;
+			n_skip++;
+			continue;
+		}
+		if (tlbst & 1) {
+			n_skip++;               /* a TLB sync still runs in this bank: somebody uses it */
+			continue;
+		}
+		uint32_t type = CBAR_TYPE(cbar), vmid = CBAR_VMID(cbar);
+		bool by_cbar = type == CBAR_TYPE_S2_TRANS || (type == CBAR_TYPE_S1_S2_BYPASS && vmid == VMID_UNUSED);
+		bool on = (sctlr & 1) != 0, pointed = false;
+
+		for (uint32_t m = 0; !pointed && m < g_smr_n; m++) {
+			uint32_t s2 = SR(SMMU_S2CR(m));
+			pointed = (SR(SMMU_SMR(m)) & SMMU_SMR_VALID) && ((s2 >> 16) & 3u) == 0 && (s2 & 0xffu) == c &&
+			    !(g_smr_reused && m == g_smr);  /* our reused SMR is rewritten anyway */
+		}
+		n_s2 += type == CBAR_TYPE_S2_TRANS;
+		n_free_s1 += type == CBAR_TYPE_S1_S2_BYPASS && vmid == VMID_UNUSED;
+		n_other += !by_cbar;
+		n_on += on;
+		n_ptr += pointed;
+		if (on || pointed || !(by_cbar || c == force)) {
+			continue;
+		}
+		/* the claim is the test (0249 order): CBA2R VA64, CBAR stage 1, each caught and read back; SCTLR 0 after */
+		tries++;
+		uint32_t got = 0;
+		bool refused = negroni_mmio_try_wr32(g_smmu + GR1(SMMU_CBA2R(c)), CBA2R_VA64) ||
+		    negroni_mmio_try_rd32(g_smmu + GR1(SMMU_CBA2R(c)), &got) || !(got & CBA2R_VA64);
+		if (!refused) {
+			refused = negroni_mmio_try_wr32(g_smmu + GR1(SMMU_CBAR(c)), CBAR_S1) ||
+			    negroni_mmio_try_rd32(g_smmu + GR1(SMMU_CBAR(c)), &got) || CBAR_TYPE(got) != CBAR_TYPE_S1_S2_BYPASS;
+		}
+		if (refused) {
+			negroni_smmu_cb_verdict[c] = NEGRONI_CB_CLAIM_REFUSED;
+			n_refused++;
+			printf("NEGRONI WLAN: SMMU context %u: claim refused or not kept (CBAR was %#x, reads %#x); left as it is, "
+			    "next bank\n", c, cbar, got);
+			continue;
+		}
+		if (sctlr != 0 && negroni_mmio_try_wr32(cbp + CB_SCTLR, 0)) {
+			negroni_smmu_cb_verdict[c] = NEGRONI_CB_CLAIM_REFUSED;
+			n_refused++;
+			printf("NEGRONI WLAN: SMMU context %u: SCTLR %#x cannot be cleared; next bank\n", c, sctlr);
+			continue;
+		}
+		negroni_smmu_cb_verdict[c] = NEGRONI_CB_OURS;
+		g_cb = c;
+		g_old_cbar = cbar;
+		g_old_cba2r = cba2r;
+		g_cb_written = true;
+		g_ok_cba2r = g_ok_cbar = true;
+	}
+	printf("NEGRONI WLAN: SMMU contexts from %u (NUMS2CB %u): %u S2_TRANS, %u S1_TRANS_S2_BYPASS with VMID 0xff, %u other, "
+	    "%u with SCTLR.M on, %u targeted by an S2CR, %u skipped (probe/helper verdict or read abort), %u claims refused\n",
+	    first, g_nums2cb, n_s2, n_free_s1, n_other, n_on, n_ptr, n_skip, n_refused);
+	if (g_cb == ~0u) {
+		return negroni_wlan_failed(EBUSY, "no usable SMMU context bank (%u claims tried; negroniwlan_smmu_cb=N forces one)",
+		           tries);
+	}
+	printf("NEGRONI WLAN: SMMU context %u claimed: CBAR was %#x (type %u, VMID %#x) CBA2R %#x, now CBAR %#x CBA2R %#x\n", g_cb,
+	    g_old_cbar, CBAR_TYPE(g_old_cbar), CBAR_VMID(g_old_cbar), g_old_cba2r, SR(GR1(SMMU_CBAR(g_cb))),
+	    SR(GR1(SMMU_CBA2R(g_cb))));
+	return 0;
+}
+
+static int smmu_claim(void);
+
+/* step 6 with negroniwlan_smmu=3 (opt-in) */
+int
+negroni_wlan_smmu_on(void)
+{
+	int error;
+
+	g_smmu = ml_io_map_unmappable(APPS_SMMU_PHYS, APPS_SMMU_SIZE, WLAN_WIMG_IO);
+	if (!g_smmu) {
+		return negroni_wlan_failed(ENOMEM, "apps SMMU map failed");
+	}
+	uint32_t scr0 = SR(SMMU_SCR0), idr0 = SR(SMMU_IDR0), idr1 = SR(SMMU_IDR1);
+	g_page = (idr1 >> 31) ? 0x10000u : 0x1000u;
+	g_pages = 2u << ((idr1 >> 28) & 7);
+	g_ctx_n = MIN(idr1 & 0xff, 0x4eu);            /* live.dts qcom,num-context-banks-override 0x4e */
+	g_nums2cb = (idr1 >> 16) & 0xffu;              /* IDR1.NUMS2CB: stage-1 banks start here (Linux) */
+	g_smr_n = MIN(MIN(idr0 & 0xff, 0x78u), 128u); /* live.dts qcom,num-smr-override 0x78 */
+	g_gfsr0 = g_last_gfsr = SR(SMMU_SGFSR);
+	printf("NEGRONI WLAN: SMMU S1 setup: sCR0 %#x, IDR0 %#x IDR1 %#x: %u SMRs, %u contexts, %u pages of %#x; sGFSR %#x\n",
+	    scr0, idr0, idr1, g_smr_n, g_ctx_n, g_pages, g_page, g_gfsr0);
+	if (scr0 == ~0u || g_smr_n == 0 || g_ctx_n == 0 || 2ull * g_pages * g_page > APPS_SMMU_SIZE) {
+		return negroni_wlan_failed(ENXIO, "the apps SMMU layout does not fit (IDR0 %#x IDR1 %#x)", idr0, idr1);
+	}
+	if (scr0 & SMMU_SCR0_EXIDENABLE) {
+		return negroni_wlan_failed(ENOTSUP, "apps SMMU uses extended stream IDs; SMR format not handled");
+	}
+	/* the root table before the claim: kmem_alloc may block, the claim lock must not be held across it */
+	g_root = tbl_new(&g_root_pa);
+	if (!g_root) {
+		return negroni_wlan_failed(ENOMEM, "no page for the SMMU root table");
+	}
+	/*
+	 * One lock with 0249's helper (negroni_smmu_s1.c takes SMRs/CBs from the top down, we from the bottom up):
+	 * held from the scan of free SMRs and contexts to the last SMR write, so both never pick the same entry.
+	 */
+	lck_mtx_lock(&negroni_smmu_claim_lock);
+	error = smmu_claim();
+	lck_mtx_unlock(&negroni_smmu_claim_lock);
+	if (error) {
+		return error;
+	}
+	g_on = true;
+	g_last_fsr = SR(CB(CB_FSR)) & FSR_ALL;
+	printf("NEGRONI WLAN: SMMU SMR%u = %#x, S2CR%u = %#x, CB%u CBAR %#x CBA2R %#x SCTLR %#x TCR %#x TCR2 %#x TTBR0 %#x%08x "
+	    "MAIR0 %#x FSR %#x (root %#llx)\n", g_smr, SR(SMMU_SMR(g_smr)), g_smr, SR(SMMU_S2CR(g_smr)), g_cb,
+	    SR(GR1(SMMU_CBAR(g_cb))), SR(GR1(SMMU_CBA2R(g_cb))), SR(CB(CB_SCTLR)), SR(CB(CB_TCR)), SR(CB(CB_TCR2)),
+	    SR(CB(CB_TTBR0 + 4)), SR(CB(CB_TTBR0)), SR(CB(CB_MAIR0)), SR(CB(CB_FSR)), g_root_pa);
+	printf("NEGRONI WLAN: stream %#x translates through context %u; IOVA window %#llx-%#llx (Android's)\n", WLAN_SID_EP,
+	    g_cb, IOVA_BASE, IOVA_BASE + IOVA_SIZE - 1);
+	return 0;
+}
+
+/* under negroni_smmu_claim_lock: pick the SMR and the context, program the context, then S2CR + SMR */
+static int
+smmu_claim(void)
+{
+	int error;
+
+	if ((error = smmu_pick_smr()) || (error = smmu_pick_cb())) {
+		return error;
+	}
+	uint64_t ttbr = g_root_pa | ((uint64_t)g_cb << 48);    /* ASID = context number */
+
+	/* context bank (Linux arm_smmu_write_context_bank order), SCTLR last */
+	/* SCTLR 0, CBA2R and CBAR were written by the claim in smmu_pick_cb */
+	if ((error = sr_put("CB TCR2", CB(CB_TCR2), TCR2_36, 7u)) ||                          /* PASIZE */
+	    (error = sr_put("CB TCR", CB(CB_TCR), TCR_39, 0x3fu | 3u << 14)) ||               /* T0SZ, TG0 */
+	    (error = sr_put("CB TTBR0 lo", CB(CB_TTBR0), (uint32_t)ttbr, ~0u)) ||
+	    (error = sr_put("CB TTBR0 hi", CB(CB_TTBR0 + 4), (uint32_t)(ttbr >> 32), ~0u)) ||
+	    (error = sr_put("CB TTBR1 lo", CB(CB_TTBR1), 0, 0)) ||
+	    (error = sr_put("CB TTBR1 hi", CB(CB_TTBR1 + 4), 0, 0)) ||
+	    (error = sr_put("CB MAIR0", CB(CB_MAIR0), MAIR0, 0xffu)) ||                       /* attr 0 (NC) */
+	    (error = sr_put("CB MAIR1", CB(CB_MAIR1), 0, 0))) {
+		return error;
+	}
+	SW(CB(CB_FSR), FSR_ALL);        /* write 1 to clear */
+	if (!smmu_tlb_sync(TLB_SYNC_MS)) {
+		return negroni_wlan_failed(ETIMEDOUT, "SMMU TLB sync does not finish in %u ms (%#x)", TLB_SYNC_MS,
+		           SR(CB(CB_TLBSTATUS)));
+	}
+	if ((error = sr_put("CB SCTLR", CB(CB_SCTLR), SCTLR_ON, 1u))) {
+		return error;
+	}
+	g_ok_sctlr = true;
+
+	/* the SMR again, right before the write: nobody may have taken (or changed) it since the scan */
+	uint32_t now = SR(SMMU_SMR(g_smr));
+	if (g_smr_reused ? now != g_old_smr : (now & SMMU_SMR_VALID) != 0) {
+		return negroni_wlan_failed(EBUSY, "SMMU SMR%u changed since the scan (%#x, was %#x)", g_smr, now, g_old_smr);
+	}
+	/* stream: S2CR translate -> context first, then the SMR valid (arm_smmu_write_sme order) */
+	g_sme_written = true;
+	if ((error = sr_put("S2CR", SMMU_S2CR(g_smr), g_cb, 0x300ffu))) {        /* type 0 (translate), CBNDX */
+		return error;
+	}
+	g_ok_s2cr = true;
+	if ((error = sr_put("SMR", SMMU_SMR(g_smr), g_smr_val, ~0u))) {
+		return error;
+	}
+	g_ok_smr = true;
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_wlan_sta.c b/bsd/dev/negroni_wlan_sta.c
new file mode 100644
index 0000000..078ea9f
--- /dev/null
+++ b/bsd/dev/negroni_wlan_sta.c
@@ -0,0 +1,519 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: the station manager and the API for the iOS side (negroni_wlan_api.h).
+ *
+ * 0326: API state, client registration, the BSS list (every beacon / probe response of WMI_MGMT_RX, with its
+ *       security and the elements a join needs), scan requests from the API.
+ * 0327+: join, data path and WPA2 add to the service pass.
+ *
+ * Threads: the API functions take g_mtx, copy, post a request flag and return. The driver thread (keep-alive loop,
+ * negroni_wlan_sta_service) does all chip work. Callbacks run on the driver thread with g_mtx not held.
+ * UNTESTED ON HARDWARE.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include "negroni_wlan.h"
+#include "negroni_wlan_mhi.h"
+#include "negroni_wlan_sta.h"
+
+static LCK_GRP_DECLARE(g_grp, "negroni_wlan_api");
+static LCK_MTX_DECLARE(g_mtx, &g_grp);
+
+static struct nwlan_link g_link;                /* under g_mtx */
+static struct nwlan_bss g_bss[NWLAN_BSS_MAX];   /* under g_mtx */
+static uint32_t g_nbss;
+static struct nwlan_callbacks g_cb;             /* under g_mtx */
+static bool g_cb_set;
+static uint32_t g_caps = NWLAN_CAP_SCAN;
+/* requests from the API (under g_mtx) */
+static bool g_req_scan;
+static bool g_scanning;                         /* driver thread only */
+static uint32_t g_scan_count;
+static uint64_t g_scan_start_ms;
+#define API_SCAN_TIMEOUT_MS     30000u
+
+/* ---- events: called on the driver thread without the lock ---- */
+static void
+emit(uint32_t ev)
+{
+	struct nwlan_callbacks cb;
+	bool set;
+
+	lck_mtx_lock(&g_mtx);
+	cb = g_cb;
+	set = g_cb_set;
+	lck_mtx_unlock(&g_mtx);
+	if (set && cb.event) {
+		cb.event(cb.ctx, ev);
+	}
+}
+
+static void
+set_state(uint32_t st, int error)
+{
+	uint32_t old;
+
+	lck_mtx_lock(&g_mtx);
+	old = g_link.state;
+	g_link.state = st;
+	if (error) {
+		g_link.last_error = error;
+	}
+	lck_mtx_unlock(&g_mtx);
+	if (old != st) {
+		printf("NEGRONI WLAN: API state %u -> %u%s\n", old, st, error ? " (error)" : "");
+		emit(NWLAN_EV_STATE);
+	}
+}
+
+void
+negroni_wlan_sta_lifecycle(uint32_t state, int error)
+{
+	if (state == NWLAN_STATE_IDLE) {
+		const uint8_t *mac = negroni_wlan_wmi_mac();
+		lck_mtx_lock(&g_mtx);
+		if (mac) {
+			memcpy(g_link.mac, mac, 6);
+		}
+		lck_mtx_unlock(&g_mtx);
+	}
+	set_state(state, error);
+}
+
+/* ---- the BSS of a beacon / probe response (pure: no kernel state; IEEE 802.11-2016 9.3.3.3, 9.4.2) ---- */
+static bool
+oui_is(const uint8_t *d, uint32_t a, uint32_t b, uint32_t c, uint32_t t)
+{
+	return d[0] == a && d[1] == b && d[2] == c && d[3] == t;
+}
+
+/* RSN element (9.4.2.25): WPA2-PSK = AKM 00-0f-ac:2 and CCMP (00-0f-ac:4) pairwise */
+static uint32_t
+rsn_security(const uint8_t *d, uint32_t n)
+{
+	uint32_t o = 2, cnt;
+	bool ccmp = false, psk = false, other = false;
+
+	if (n < 2 || (d[0] | d[1] << 8) != 1) {
+		return NWLAN_SEC_WPA2_OTHER;
+	}
+	if (n < o + 4) {
+		return NWLAN_SEC_WPA2_PSK;      /* defaults: CCMP + PSK (9.4.2.25.1) */
+	}
+	o += 4;                                 /* group cipher */
+	if (n < o + 2) {
+		return NWLAN_SEC_WPA2_PSK;
+	}
+	cnt = d[o] | d[o + 1] << 8;
+	o += 2;
+	if (cnt == 0 || n < o + 4 * cnt) {
+		return NWLAN_SEC_WPA2_OTHER;
+	}
+	for (uint32_t i = 0; i < cnt; i++, o += 4) {
+		ccmp = ccmp || oui_is(d + o, 0x00, 0x0f, 0xac, 4);
+	}
+	if (n < o + 2) {
+		return ccmp ? NWLAN_SEC_WPA2_PSK : NWLAN_SEC_WPA2_OTHER;
+	}
+	cnt = d[o] | d[o + 1] << 8;
+	o += 2;
+	if (cnt == 0 || n < o + 4 * cnt) {
+		return NWLAN_SEC_WPA2_OTHER;
+	}
+	for (uint32_t i = 0; i < cnt; i++, o += 4) {
+		if (oui_is(d + o, 0x00, 0x0f, 0xac, 2)) {
+			psk = true;
+		} else {
+			other = true;
+		}
+	}
+	return (psk && ccmp) ? NWLAN_SEC_WPA2_PSK : (other || !ccmp ? NWLAN_SEC_WPA2_OTHER : NWLAN_SEC_WPA2_PSK);
+}
+
+int
+negroni_wlan_sta_parse_bss(const uint8_t *f, uint32_t len, struct nwlan_bss *out)
+{
+	memset(out, 0, sizeof(*out));
+	if (!f || len < 24) {
+		return EBADMSG;
+	}
+	uint32_t fc = (uint32_t)f[0] | (uint32_t)f[1] << 8;
+	if (((fc >> 2) & 3) != 0 || (((fc >> 4) & 0xf) != 8 && ((fc >> 4) & 0xf) != 5)) {
+		return ENOENT;
+	}
+	if (len < 36) {
+		return EBADMSG;
+	}
+	memcpy(out->bssid, f + 16, 6);
+	out->beacon_int = (uint16_t)(f[32] | f[33] << 8);
+	out->capab = (uint16_t)(f[34] | f[35] << 8);
+	bool have_ssid = false, rsn = false, wpa = false;
+	for (uint32_t o = 36; o < len;) {
+		if (len - o < 2) {
+			return EBADMSG;
+		}
+		uint32_t id = f[o], el = f[o + 1];
+		const uint8_t *d = f + o + 2;
+		if (el > len - o - 2) {
+			return EBADMSG;
+		}
+		bool keep = false;
+		if (id == 0 && !have_ssid) {
+			if (el > NWLAN_SSID_MAX) {
+				return EBADMSG;
+			}
+			have_ssid = true;
+			out->ssid_len = (uint8_t)el;
+			memcpy(out->ssid, d, el);
+		} else if (id == 3 && el >= 1) {
+			out->channel = d[0];
+		} else if (id == 48 && !rsn) {
+			rsn = true;
+			out->security |= rsn_security(d, el);
+			keep = true;
+		} else if (id == 221 && el >= 4 && d[0] == 0x00 && d[1] == 0x50 && d[2] == 0xf2) {
+			wpa = wpa || d[3] == 1;
+			keep = d[3] == 1 || d[3] == 2;  /* WPA, WMM */
+		} else if (id == 1 || id == 50 || id == 45 || id == 61 || id == 191 || id == 192 || id == 127) {
+			keep = true;                    /* rates, ext rates, HT cap/op, VHT cap/op, ext cap */
+		}
+		if (keep && out->ie_len + 2 + el <= NWLAN_IE_MAX) {
+			memcpy(out->ie + out->ie_len, f + o, 2 + el);
+			out->ie_len = (uint16_t)(out->ie_len + 2 + el);
+		}
+		o += 2 + el;
+	}
+	if (!rsn) {
+		out->security |= wpa ? NWLAN_SEC_WPA : (out->capab & 0x10) ? NWLAN_SEC_WEP : NWLAN_SEC_OPEN;
+	}
+	return 0;
+}
+
+static uint8_t
+freq_channel(uint32_t f)
+{
+	if (f == 2484) {
+		return 14;
+	}
+	if (f >= 2412 && f < 2484) {
+		return (uint8_t)((f - 2407) / 5);
+	}
+	if (f >= 5000 && f < 5900) {
+		return (uint8_t)((f - 5000) / 5);
+	}
+	return 0;
+}
+
+/* MGMT_RX (inside the service pass): beacons and probe responses into the list; later patches add join frames */
+void
+negroni_wlan_sta_mgmt_rx(const uint8_t *frame, uint32_t len, int32_t rssi, uint32_t freq)
+{
+	static struct nwlan_bss b;      /* driver thread only */
+	uint64_t now = negroni_wlan_ms();
+	bool rssi_ev = false;
+
+	if (negroni_wlan_sta_parse_bss(frame, len, &b) != 0) {
+		negroni_wlan_sta_join_frame(frame, len);       /* 0327: auth / assoc / deauth */
+		return;
+	}
+	b.rssi = (int8_t)MAX(MIN(rssi, 0), -127);
+	b.freq = (uint16_t)freq;
+	if (!b.channel) {
+		b.channel = freq_channel(freq);
+	}
+	b.seen_ms = now;
+	lck_mtx_lock(&g_mtx);
+	uint32_t i, oldest = 0;
+	for (i = 0; i < g_nbss; i++) {
+		if (!memcmp(g_bss[i].bssid, b.bssid, 6)) {
+			break;
+		}
+		if (g_bss[i].seen_ms < g_bss[oldest].seen_ms) {
+			oldest = i;
+		}
+	}
+	if (i == g_nbss) {
+		i = g_nbss < NWLAN_BSS_MAX ? g_nbss++ : oldest;
+	}
+	if (b.ssid_len == 0 && g_bss[i].ssid_len && !memcmp(g_bss[i].bssid, b.bssid, 6)) {
+		/* a hidden beacon after a probe response: keep the name */
+		b.ssid_len = g_bss[i].ssid_len;
+		memcpy(b.ssid, g_bss[i].ssid, b.ssid_len);
+	}
+	g_bss[i] = b;
+	if (g_link.state >= NWLAN_STATE_JOINING && g_link.state <= NWLAN_STATE_CONNECTED &&
+	    !memcmp(g_link.bssid, b.bssid, 6)) {
+		static uint64_t last_rssi_ms;
+		g_link.rssi = b.rssi;
+		if (now - last_rssi_ms >= 1000) {
+			last_rssi_ms = now;
+			rssi_ev = true;
+		}
+	}
+	lck_mtx_unlock(&g_mtx);
+	negroni_wlan_sta_beacon_seen(b.bssid);         /* 0327: beacon-loss timer */
+	if (rssi_ev) {
+		emit(NWLAN_EV_RSSI);
+	}
+}
+
+void
+negroni_wlan_sta_scan_done(uint32_t reason)
+{
+	(void)reason;
+	if (!g_scanning && g_link.state != NWLAN_STATE_SCANNING) {
+		g_scan_count++;                 /* the level-10 scan or a join's own scan: no API scan to finish */
+		emit(NWLAN_EV_SCAN_DONE);
+		return;
+	}
+	g_scanning = false;
+	g_scan_count++;
+	printf("NEGRONI WLAN: API scan %u done: %u BSS in the list\n", g_scan_count, g_nbss);
+	if (g_link.state == NWLAN_STATE_SCANNING) {
+		set_state(NWLAN_STATE_IDLE, 0);
+	}
+	emit(NWLAN_EV_SCAN_DONE);
+}
+
+/* driver thread, top level (keep-alive loop) */
+void
+negroni_wlan_sta_service(void)
+{
+	bool scan;
+
+	lck_mtx_lock(&g_mtx);
+	scan = g_req_scan && !g_scanning && g_link.state == NWLAN_STATE_IDLE;
+	if (scan) {
+		g_req_scan = false;
+	}
+	lck_mtx_unlock(&g_mtx);
+	if (scan) {
+		int error = negroni_wlan_wmi_scan_start();
+		if (error) {
+			printf("NEGRONI WLAN: API scan not started (error %d)\n", error);
+			emit(NWLAN_EV_SCAN_DONE);
+		} else {
+			g_scanning = true;
+			g_scan_start_ms = negroni_wlan_ms();
+			set_state(NWLAN_STATE_SCANNING, 0);
+		}
+	}
+	if (g_scanning && negroni_wlan_ms() - g_scan_start_ms > API_SCAN_TIMEOUT_MS) {
+		printf("NEGRONI WLAN: API scan time-out after %u ms (no SCAN COMPLETED)\n", API_SCAN_TIMEOUT_MS);
+		negroni_wlan_sta_scan_done(~0u);
+	}
+	negroni_wlan_sta_join_service();               /* 0327 */
+}
+
+void
+negroni_wlan_wipe(void *p, size_t n)
+{
+	volatile uint8_t *v = p;
+	while (n--) {
+		*v++ = 0;
+	}
+}
+
+/* ================================ API ================================ */
+uint32_t
+negroni_wlan_api_version(void)
+{
+	return NWLAN_API_VERSION;
+}
+
+uint32_t
+negroni_wlan_api_caps(void)
+{
+	return g_caps | negroni_wlan_sta_join_caps();
+}
+
+bool
+negroni_wlan_api_ready(void)
+{
+	uint32_t st = g_link.state;
+	return st >= NWLAN_STATE_IDLE && st != NWLAN_STATE_FAILED;
+}
+
+int
+negroni_wlan_register(const struct nwlan_callbacks *cb)
+{
+	int error = 0;
+
+	lck_mtx_lock(&g_mtx);
+	if (!cb) {
+		memset(&g_cb, 0, sizeof(g_cb));
+		g_cb_set = false;
+	} else if (g_cb_set) {
+		error = EBUSY;
+	} else {
+		g_cb = *cb;
+		g_cb_set = true;
+	}
+	lck_mtx_unlock(&g_mtx);
+	return error;
+}
+
+int
+negroni_wlan_link(struct nwlan_link *out)
+{
+	if (!out) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&g_mtx);
+	*out = g_link;
+	lck_mtx_unlock(&g_mtx);
+	negroni_wlan_sta_link_counters(out);           /* 0328: data counters */
+	return 0;
+}
+
+int
+negroni_wlan_scan(void)
+{
+	int error = 0;
+
+	lck_mtx_lock(&g_mtx);
+	if (g_link.state != NWLAN_STATE_IDLE && g_link.state != NWLAN_STATE_SCANNING) {
+		error = (g_link.state < NWLAN_STATE_IDLE || g_link.state == NWLAN_STATE_FAILED) ? ENXIO : EBUSY;
+	} else {
+		g_req_scan = true;
+	}
+	lck_mtx_unlock(&g_mtx);
+	return error;
+}
+
+uint32_t
+negroni_wlan_scan_results(struct nwlan_bss *out, uint32_t max)
+{
+	uint32_t n = 0;
+	bool used[NWLAN_BSS_MAX] = { false };
+
+	if (!out) {
+		return 0;
+	}
+	lck_mtx_lock(&g_mtx);
+	while (n < max && n < g_nbss) {
+		uint32_t best = ~0u;
+		for (uint32_t i = 0; i < g_nbss; i++) {
+			if (!used[i] && (best == ~0u || g_bss[i].seen_ms > g_bss[best].seen_ms)) {
+				best = i;
+			}
+		}
+		used[best] = true;
+		out[n++] = g_bss[best];
+	}
+	lck_mtx_unlock(&g_mtx);
+	return n;
+}
+
+/* the strongest BSS named `ssid` seen in the last 60 s (copy); false if none */
+bool
+negroni_wlan_sta_find(const uint8_t *ssid, uint32_t ssid_len, struct nwlan_bss *out)
+{
+	uint64_t now = negroni_wlan_ms();
+	bool found = false;
+
+	lck_mtx_lock(&g_mtx);
+	for (uint32_t i = 0; i < g_nbss; i++) {
+		struct nwlan_bss *b = &g_bss[i];
+		if (b->ssid_len != ssid_len || memcmp(b->ssid, ssid, ssid_len) || now - b->seen_ms > 60000 || b->freq == 0) {
+			continue;
+		}
+		if (!found || b->rssi > out->rssi) {
+			*out = *b;
+			found = true;
+		}
+	}
+	lck_mtx_unlock(&g_mtx);
+	return found;
+}
+
+/* a scan runs (the join waits for its end) */
+bool
+negroni_wlan_sta_scanning(void)
+{
+	return g_scanning;
+}
+
+/* a join starts: a scan request not yet started ends now (SCAN_DONE with the current list) */
+void
+negroni_wlan_sta_scan_cancel(void)
+{
+	bool pending;
+
+	lck_mtx_lock(&g_mtx);
+	pending = g_req_scan;
+	g_req_scan = false;
+	lck_mtx_unlock(&g_mtx);
+	if (pending) {
+		emit(NWLAN_EV_SCAN_DONE);
+	}
+}
+
+/* a join that ends before JOINING (no BSS, wrong security, ...): state IDLE and always NWLAN_EV_LINK_DOWN */
+void
+negroni_wlan_sta_join_failed(const struct nwlan_bss *b, int error, uint16_t reason)
+{
+	negroni_wlan_sta_set_link(b, NWLAN_STATE_IDLE, error, reason, 0);
+	emit(NWLAN_EV_LINK_DOWN);
+}
+
+/* 0327+: helpers for the join / data parts */
+void
+negroni_wlan_sta_set_link(const struct nwlan_bss *b, uint32_t state, int error, uint16_t reason, uint16_t aid)
+{
+	uint32_t old;
+
+	lck_mtx_lock(&g_mtx);
+	old = g_link.state;
+	if (b) {
+		memcpy(g_link.bssid, b->bssid, 6);
+		g_link.ssid_len = b->ssid_len;
+		memcpy(g_link.ssid, b->ssid, b->ssid_len);
+		g_link.rssi = b->rssi;
+		g_link.freq = b->freq;
+		g_link.security = b->security;
+	}
+	g_link.state = state;
+	g_link.aid = aid;
+	if (error || reason) {
+		g_link.last_error = error;
+		g_link.reason = reason;
+	}
+	lck_mtx_unlock(&g_mtx);
+	if (old != state) {
+		printf("NEGRONI WLAN: API state %u -> %u (error %d, reason %u)\n", old, state, error, reason);
+		emit(NWLAN_EV_STATE);
+		if (state == NWLAN_STATE_CONNECTED) {
+			emit(NWLAN_EV_LINK_UP);
+		} else if (old >= NWLAN_STATE_JOINING && old <= NWLAN_STATE_CONNECTED &&
+		    (state < NWLAN_STATE_JOINING || state > NWLAN_STATE_CONNECTED)) {
+			emit(NWLAN_EV_LINK_DOWN);
+		}
+	}
+}
+
+uint32_t
+negroni_wlan_sta_state(void)
+{
+	return g_link.state;
+}
+
+/* deliver one 802.3 frame to the client (driver thread) */
+void
+negroni_wlan_sta_deliver(const uint8_t *frame, uint32_t len)
+{
+	struct nwlan_callbacks cb;
+	bool set;
+
+	lck_mtx_lock(&g_mtx);
+	cb = g_cb;
+	set = g_cb_set;
+	lck_mtx_unlock(&g_mtx);
+	if (set && cb.rx) {
+		cb.rx(cb.ctx, frame, len);
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
