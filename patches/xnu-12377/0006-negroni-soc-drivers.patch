+	uint32_t fifo_depth, fifo_width;
+	bool se_clocked, pins_spi, powered, ldo_voted;
+	thread_t thread;
+} fp;
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static void
+step(unsigned n, const char *name)
+{
+	printf("NEGRONI FP: step %u %s\n", n, name);
+}
+
+/* true when (reg & mask) == want within us microseconds */
+static bool
+wait_for(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned us)
+{
+	for (unsigned i = 0; i < us; i++) {
+		if ((rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(1);
+	}
+	return (rd(base, off) & mask) == want;
+}
+
+int
+negroni_fp_irq_level(void)
+{
+	if (fp.tlmm == 0) {
+		return -1;
+	}
+	return (int)(rd(fp.tlmm, FP_PIN(FP_PIN_IRQ) + 4) & TLMM_IN);
+}
+
+static void
+pin_cfg(unsigned pin, uint32_t cfg)
+{
+	wr(fp.tlmm, FP_PIN(pin), cfg);
+}
+
+static void
+pin_out(unsigned pin, int high)
+{
+	wr(fp.tlmm, FP_PIN(pin) + 4, high ? TLMM_OUT : 0);
+}
+
+/* ---- GCC ---- */
+
+static bool
+gcc_branch_on(uint32_t vote_bit, vm_offset_t halt_base, uint32_t halt_off, const char *name)
+{
+	uint32_t v = rd(fp.gcc_vote, GCC_VOTE - FP_GCC_VOTE_PAGE);
+	if (!(v & vote_bit)) {
+		wr(fp.gcc_vote, GCC_VOTE - FP_GCC_VOTE_PAGE, v | vote_bit);
+	}
+	/*
+	 * 0354: a branch in hardware clock gating mode (CBCR HW_CTL set) is not checked: CLK_OFF reads 1
+	 * while the AHB is idle (Linux clk-branch.c clk_branch_wait; gcc-sm8450.c: wrap_1_m_ahb and
+	 * wrap_1_s_ahb have hwcg_bit 1). The phone read s_ahb CBCR 0x80000002 and 0350 stopped there
+	 * (logs/usblog-everything-0363.txt); 0334 made the same fix for QUP2.
+	 */
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t c = rd(halt_base, halt_off);
+		if (!(c & CBCR_CLK_OFF)) {
+			printf("NEGRONI FP: clock %s on (CBCR %#x)\n", name, c);
+			return true;
+		}
+		if (c & CBCR_HW_CTL) {
+			printf("NEGRONI FP: clock %s hw-gated (CBCR %#x: HW_CTL, not checked, as Linux)\n", name, c);
+			return true;
+		}
+		delay(1);
+	}
+	printf("NEGRONI FP: clock %s does not come on (CBCR %#x)\n", name, rd(halt_base, halt_off));
+	return false;
+}
+
+/* 0354: RPMh BCM QUP1 vote (Linux geni_icc_enable, path "qup-core"), as 0334 for QUP2; failure is logged, not fatal */
+static void
+gcc_bcm_vote(void)
+{
+	int on = 1, kbps = (int)QUP_CORE2X_100MHZ_KBPS, e = EBUSY;
+	uint32_t data = 0;
+	(void)PE_parse_boot_argn("negronifp_bcm", &on, sizeof(on));
+	(void)PE_parse_boot_argn("negronifp_bcm_kbps", &kbps, sizeof(kbps));
+	if (!on) {
+		printf("NEGRONI FP: BCM QUP1 vote skipped (negronifp_bcm=0)\n");
+		return;
+	}
+	if (kbps <= 0 || kbps > 100000) {
+		kbps = (int)QUP_CORE2X_100MHZ_KBPS;
+	}
+	for (unsigned i = 0; i < 40 && e == EBUSY; i++) {       /* the RPMh voter is shared: retry while busy */
+		e = negroni_rpmh_qup_bcm("QUP1", (uint32_t)kbps, (uint32_t)kbps, &data);
+		if (e == EBUSY) {
+			IOSleep(50);
+		}
+	}
+	printf("NEGRONI FP: BCM QUP1 (qup1_core_master -> qup1_core_slave) avg = peak %d kBps: data %#x, errno %d%s\n", kbps, data, e,
+	    e ? " (not fatal: the core clocks may run on the boot chain's vote)" : "");
+}
+
+static bool
+gcc_s2_rcg_xo(void)
+{
+	/* CFG: src 0 (bi_tcxo), div field 1 (= divide by 1), mode 0 (no M/N); then UPDATE */
+	uint32_t cmd = GCC_S2_CMD_RCGR - FP_GCC_QUP_PAGE;
+	uint32_t cfg = rd(fp.gcc_qup, cmd + 4);
+	printf("NEGRONI FP: s2 RCG before: CMD %#x CFG %#x\n", rd(fp.gcc_qup, cmd), cfg);
+	wr(fp.gcc_qup, cmd + 4, 0x1u);
+	wr(fp.gcc_qup, cmd, rd(fp.gcc_qup, cmd) | RCG_CMD_UPDATE | RCG_CMD_ROOT_EN);
+	if (!wait_for(fp.gcc_qup, cmd, RCG_CMD_UPDATE, 0, 1000)) {
+		printf("NEGRONI FP: s2 RCG update does not complete (CMD %#x)\n", rd(fp.gcc_qup, cmd));
+		return false;
+	}
+	return true;
+}
+
+static void
+gcc_restore(void)
+{
+	if (!fp.se_clocked) {
+		return;
+	}
+	/* only the bits we set go away; other EEs' votes are separate registers */
+	uint32_t v = rd(fp.gcc_vote, GCC_VOTE - FP_GCC_VOTE_PAGE);
+	uint32_t ours = (GCC_VOTE_S2 | GCC_VOTE_M_AHB | GCC_VOTE_S_AHB | GCC_VOTE_CORE | GCC_VOTE_CORE_2X) &
+	    ~fp.vote_before;
+	wr(fp.gcc_vote, GCC_VOTE - FP_GCC_VOTE_PAGE, v & ~ours);
+	fp.se_clocked = false;
+}
+
+/* ---- GENI SPI ---- */
+
+static void
+se_irq_clear(void)
+{
+	wr(fp.se, SE_GSI_EVENT_EN, 0);
+	wr(fp.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	wr(fp.se, SE_GENI_S_IRQ_CLEAR, 0xffffffffu);
+	wr(fp.se, SE_DMA_TX_IRQ_CLR, 0xffffffffu);
+	wr(fp.se, SE_DMA_RX_IRQ_CLR, 0xffffffffu);
+	wr(fp.se, SE_IRQ_EN, 0xffffffffu);
+}
+
+/* geni_se_init + geni_se_select_fifo_mode (qcom-geni-se.c) with the SPI driver's watermarks */
+static void
+se_init_fifo(void)
+{
+	se_irq_clear();
+	wr(fp.se, GENI_CGC_CTRL, rd(fp.se, GENI_CGC_CTRL) | DEFAULT_CGC_EN);
+	wr(fp.se, SE_DMA_GENERAL_CFG, rd(fp.se, SE_DMA_GENERAL_CFG) | DMA_GENERAL_CGC);
+	wr(fp.se, GENI_OUTPUT_CTRL, DEFAULT_IO_OUTPUT_CTRL);
+	wr(fp.se, GENI_FORCE_DEFAULT_REG, 1);
+	wr(fp.se, SE_IRQ_EN, rd(fp.se, SE_IRQ_EN) | SE_IRQ_EN_ALL);
+	wr(fp.se, SE_GENI_DMA_MODE_EN, rd(fp.se, SE_GENI_DMA_MODE_EN) & ~1u);
+	wr(fp.se, SE_GSI_EVENT_EN, 0);
+	wr(fp.se, SE_GENI_RX_WATERMARK, fp.fifo_depth - 3);
+	wr(fp.se, SE_GENI_RX_RFR_WATERMARK, fp.fifo_depth - 2);
+	/* no interrupt line is wired here: the enables only make the status bits latch */
+	wr(fp.se, SE_GENI_M_IRQ_EN, 0x7eu | M_CMD_DONE | M_TX_FIFO_WATERMARK | M_RX_FIFO_WATERMARK | M_RX_FIFO_LAST);
+	wr(fp.se, SE_GENI_S_IRQ_EN, 0x3eu | 1u);
+	wr(fp.se, SE_GENI_DMA_MODE_EN, rd(fp.se, SE_GENI_DMA_MODE_EN) & ~1u);
+}
+
+/* geni_se_config_packing(bpw 8, pack_words 4, msb first): 4 vectors of 10 bits */
+static void
+se_packing_8bit(void)
+{
+	uint32_t cfg[4], iter = fp.fifo_width / 8;
+	if (iter == 0 || iter > 4) {
+		iter = 4;
+	}
+	for (uint32_t i = 0; i < iter; i++) {
+		cfg[i] = ((7u + 8u * i) << 5) | (1u << 4) | (7u << 1);
+	}
+	cfg[iter - 1] |= 1u;
+	for (uint32_t i = iter; i < 4; i++) {
+		cfg[i] = 0;
+	}
+	uint32_t cfg0 = cfg[0] | (cfg[1] << 10), cfg1 = cfg[2] | (cfg[3] << 10);
+	wr(fp.se, SE_GENI_TX_PACKING_CFG0, cfg0);
+	wr(fp.se, SE_GENI_TX_PACKING_CFG1, cfg1);
+	wr(fp.se, SE_GENI_RX_PACKING_CFG0, cfg0);
+	wr(fp.se, SE_GENI_RX_PACKING_CFG1, cfg1);
+	wr(fp.se, SE_GENI_BYTE_GRAN, 0);
+	wr(fp.se, SE_SPI_WORD_LEN, 8u - 4u);
+}
+
+static void
+se_spi_setup(unsigned hz, unsigned mode)
+{
+	uint32_t div = (SE_CLK_HZ + hz - 1) / hz;
+	if (div == 0) {
+		div = 1;
+	}
+	if (div > 0xfff) {
+		div = 0xfff;
+	}
+	se_packing_8bit();
+	wr(fp.se, SE_SPI_LOOPBACK, 0);
+	wr(fp.se, SE_SPI_DEMUX_SEL, 0);
+	wr(fp.se, SE_SPI_CPHA, (mode & 1u) ? CPHA : 0);
+	wr(fp.se, SE_SPI_CPOL, (mode & 2u) ? CPOL : 0);
+	wr(fp.se, SE_SPI_DEMUX_OUTPUT_INV, 0);
+	wr(fp.se, SE_SPI_TRANS_CFG, rd(fp.se, SE_SPI_TRANS_CFG) & ~CS_TOGGLE);
+	wr(fp.se, SE_SPI_PRE_POST_CMD_DLY, 0);
+	wr(fp.se, SE_SPI_DELAY_COUNTERS, 0);
+	wr(fp.se, SE_GENI_CLK_SEL, 0);
+	wr(fp.se, GENI_SER_M_CLK_CFG, (div << 4) | SER_CLK_EN);
+	printf("NEGRONI FP: SPI %u Hz (div %u of 19.2 MHz), mode %u\n", SE_CLK_HZ / div, div, mode);
+}
+
+/* Cancel, then abort, a command that did not finish. */
+static void
+se_cancel(const char *what)
+{
+	printf("NEGRONI FP: %s did not finish (M_IRQ %#x STATUS %#x TXS %#x RXS %#x): cancel\n", what,
+	    rd(fp.se, SE_GENI_M_IRQ_STATUS), rd(fp.se, SE_GENI_STATUS),
+	    rd(fp.se, SE_GENI_TX_FIFO_STATUS), rd(fp.se, SE_GENI_RX_FIFO_STATUS));
+	wr(fp.se, SE_GENI_M_CMD_CTRL_REG, M_GENI_CMD_CANCEL);
+	if (!wait_for(fp.se, SE_GENI_M_IRQ_STATUS, M_CMD_CANCEL, M_CMD_CANCEL, 10000)) {
+		wr(fp.se, SE_GENI_M_CMD_CTRL_REG, M_GENI_CMD_ABORT);
+		(void)wait_for(fp.se, SE_GENI_M_IRQ_STATUS, M_CMD_ABORT, M_CMD_ABORT, 10000);
+	}
+	wr(fp.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+}
+
+/* One sequencer command without data (CS assert/deassert). 0 ok. */
+static int
+se_cmd_simple(uint32_t opcode, const char *what)
+{
+	wr(fp.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	wr(fp.se, SE_GENI_M_CMD0, (opcode << 27));
+	if (!wait_for(fp.se, SE_GENI_M_IRQ_STATUS, M_CMD_DONE, M_CMD_DONE, FP_POLL_US)) {
+		se_cancel(what);
+		return -1;
+	}
+	wr(fp.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	return 0;
+}
+
+/* TX-only transfer of len bytes (<= one FIFO), CS kept asserted (FRAGMENTATION). 0 ok. */
+static int
+se_tx(const uint8_t *buf, uint32_t len)
+{
+	wr(fp.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	wr(fp.se, SE_SPI_TX_TRANS_LEN, len);
+	wr(fp.se, SE_GENI_M_CMD0, (SPI_TX_ONLY << 27) | FRAGMENTATION);
+	for (uint32_t i = 0; i < len; i += 4) {
+		uint32_t w = 0;
+		for (uint32_t j = 0; j < 4 && i + j < len; j++) {
+			w |= (uint32_t)buf[i + j] << (8 * j);
+		}
+		wr(fp.se, SE_GENI_TX_FIFOn, w);
+	}
+	if (!wait_for(fp.se, SE_GENI_M_IRQ_STATUS, M_CMD_DONE, M_CMD_DONE, FP_POLL_US)) {
+		se_cancel("tx");
+		return -1;
+	}
+	wr(fp.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	return 0;
+}
+
+/* RX-only transfer of len bytes (<= one FIFO). Returns the bytes read, -1 on timeout. */
+static int
+se_rx(uint8_t *buf, uint32_t len, bool last)
+{
+	uint32_t got = 0;
+	wr(fp.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	wr(fp.se, SE_SPI_RX_TRANS_LEN, len);
+	wr(fp.se, SE_GENI_M_CMD0, (SPI_RX_ONLY << 27) | (last ? 0 : FRAGMENTATION));
+	bool done = wait_for(fp.se, SE_GENI_M_IRQ_STATUS, M_CMD_DONE, M_CMD_DONE, FP_POLL_US);
+	uint32_t st = rd(fp.se, SE_GENI_RX_FIFO_STATUS);
+	uint32_t words = st & RX_FIFO_WC_MSK, bytes = words * 4;
+	if ((st & RX_LAST) && RX_LAST_BYTE_VALID(st) && RX_LAST_BYTE_VALID(st) < 4) {
+		bytes -= 4 - RX_LAST_BYTE_VALID(st);
+	}
+	for (uint32_t i = 0; i < words && i < 64; i++) {
+		uint32_t w = rd(fp.se, SE_GENI_RX_FIFOn);
+		for (uint32_t j = 0; j < 4 && got < bytes && got < len; j++) {
+			buf[got++] = (uint8_t)(w >> (8 * j));
+		}
+	}
+	if (!done) {
+		se_cancel("rx");
+		return -1;
+	}
+	wr(fp.se, SE_GENI_M_IRQ_CLEAR, 0xffffffffu);
+	return (int)got;
+}
+
+static void
+hexline(const char *tag, const uint8_t *b, int n)
+{
+	char s[3 * 16 + 1];
+	int k = 0;
+	for (int i = 0; i < n && i < 16; i++) {
+		s[k++] = "0123456789abcdef"[b[i] >> 4];
+		s[k++] = "0123456789abcdef"[b[i] & 15];
+		s[k++] = ' ';
+	}
+	s[k] = 0;
+	printf("NEGRONI FP: %s (%d bytes): %s\n", tag, n, s);
+}
+
+/* {cmd} out, n bytes in, under one chip select. */
+static int
+spi_cmd_read(const uint8_t *cmd, uint32_t clen, uint8_t *in, uint32_t n, const char *tag)
+{
+	int rc = se_cmd_simple(SPI_CS_ASSERT, "cs assert");
+	if (rc == 0) {
+		rc = se_tx(cmd, clen);
+	}
+	int got = -1;
+	if (rc == 0) {
+		got = se_rx(in, n, true);
+	}
+	(void)se_cmd_simple(SPI_CS_DEASSERT, "cs deassert");
+	if (got > 0) {
+		hexline(tag, in, got);
+	} else {
+		printf("NEGRONI FP: %s: no data (rc %d)\n", tag, got);
+	}
+	return got;
+}
+
+/* ---- 0352: Goodix MCU message layer ----
+ *
+ * The G7 module has an MCU in front of the optical sensor (HAL strings "test reset and interrupt
+ * pin between mcu and sensor", "fw_app_version", "fw_bootcode_version", GF_ERROR_SPI_FW_DOWNLOAD_FAILED
+ * [V out/fp/lists/hal-strings.txt]). The public Goodix MCU protocol (goodix-fp-dump goodix.py:56-114
+ * [V out/fp/ref]) frames every command as
+ *   message pack:     A0, len16 LE, sum8(A0, len)            (flags 0xA0 = message protocol)
+ *   message protocol: cmd, (plen+1)16 LE, payload, 0xAA - sum8(cmd .. payload)   (0x88 = no checksum)
+ * The public SPI sensor (5120, protocol.py:159-185) prefixes a write with CC F2 seq16 and reads with
+ * BB F1 00 00 followed by the clocked answer bytes; the IRQ pin tells that an answer is ready.
+ * Whether the G7's MCU speaks this protocol over SPI is not known from any file we own [I]: the TEE
+ * application does the SPI on Android. Step 10 sends the frames and logs the raw answers.
+ */
+#define GX_FLAGS_MSG            0xa0u
+#define GX_CMD_NOP              0x00u
+#define GX_CMD_MCU_GET_IMAGE    0x20u
+#define GX_CMD_READ_SENSOR_REG  0x82u
+#define GX_CMD_READ_OTP         0xa6u
+#define GX_CMD_FW_VERSION       0xa8u
+#define GX_CMD_QUERY_MCU_STATE  0xaeu
+#define GX_CMD_ACK              0xb0u
+#define GX_MAX_FRAME            64u       /* one FIFO fill */
+#define GX_CHUNK                64u       /* 16 FIFO words */
+
+static uint16_t gx_seq;
+static int gx_irqwait_ms = 100;
+static int gx_fingerwait_s = 10;   /* 0354: negronifp_fingerwait */
+
+/* message pack + message protocol around payload; returns the frame length */
+static uint32_t
+gx_encode(uint8_t *out, uint8_t cmd, const uint8_t *pl, uint32_t plen, bool csum)
+{
+	uint32_t n = 0, mlen = plen + 4, s = 0;
+	if (plen + 8 > GX_MAX_FRAME) {
+		return 0;
+	}
+	out[n++] = GX_FLAGS_MSG;
+	out[n++] = (uint8_t)mlen;
+	out[n++] = (uint8_t)(mlen >> 8);
+	out[n++] = (uint8_t)(out[0] + out[1] + out[2]);
+	uint32_t p0 = n;
+	out[n++] = cmd;
+	out[n++] = (uint8_t)(plen + 1);
+	out[n++] = (uint8_t)((plen + 1) >> 8);
+	for (uint32_t i = 0; i < plen; i++) {
+		out[n++] = pl[i];
+	}
+	for (uint32_t i = p0; i < n; i++) {
+		s += out[i];
+	}
+	out[n++] = csum ? (uint8_t)(0xaa - s) : 0x88;
+	return n;
+}
+
+/*
+ * Looks for a message pack in in[0..n): the first A0/B0/B2 flags byte within the first 8 bytes whose
+ * pack checksum holds, then the protocol checksum. 2 = pack and protocol valid, 1 = pack header valid
+ * only, 0 = none. cmd and plen describe the protocol part.
+ */
+static int
+gx_decode(const uint8_t *in, uint32_t n, uint8_t *cmd, uint32_t *plen, uint32_t *at)
+{
+	for (uint32_t i = 0; i + 4 <= n && i < 8; i++) {
+		uint8_t f = in[i];
+		if (f != 0xa0 && f != 0xb0 && f != 0xb2) {
+			continue;
+		}
+		uint32_t len = in[i + 1] | ((uint32_t)in[i + 2] << 8);
+		if ((uint8_t)(in[i] + in[i + 1] + in[i + 2]) != in[i + 3] || len < 4) {
+			continue;
+		}
+		*at = i;
+		if (i + 4 + len > n) {
+			return 1;                               /* cut by our read size */
+		}
+		const uint8_t *m = in + i + 4;
+		uint32_t ml = m[1] | ((uint32_t)m[2] << 8), s = 0;
+		*cmd = m[0];
+		*plen = ml ? ml - 1 : 0;
+		if (ml + 3 > len) {
+			return 1;
+		}
+		for (uint32_t k = 0; k < ml + 2; k++) {
+			s += m[k];
+		}
+		if (m[ml + 2] == (uint8_t)(0xaa - s) || m[ml + 2] == 0x88) {
+			return 2;
+		}
+		return 1;
+	}
+	return 0;
+}
+
+/* TX of n bytes in FIFO-sized pieces, CS kept asserted. 0 ok. */
+static int
+se_tx_long(const uint8_t *buf, uint32_t n)
+{
+	for (uint32_t off = 0; off < n; off += GX_CHUNK) {
+		uint32_t c = n - off < GX_CHUNK ? n - off : GX_CHUNK;
+		if (se_tx(buf + off, c) != 0) {
+			return -1;
+		}
+	}
+	return 0;
+}
+
+/* RX of n bytes in FIFO-sized pieces (the last piece ends the transfer). Returns the bytes read. */
+static int
+se_rx_long(uint8_t *buf, uint32_t n)
+{
+	uint32_t got = 0;
+	while (got < n) {
+		uint32_t c = n - got < GX_CHUNK ? n - got : GX_CHUNK;
+		int r = se_rx(buf + got, c, got + c >= n);
+		if (r < 0) {
+			return got ? (int)got : -1;
+		}
+		got += (uint32_t)r;
+		if ((uint32_t)r < c) {
+			break;
+		}
+	}
+	return (int)got;
+}
+
+/* One frame out: plain, or with the 5120-SPI transport prefix (wrap). 0 ok. */
+static int
+gx_write(const uint8_t *frame, uint32_t n, int wrap)
+{
+	int rc = se_cmd_simple(SPI_CS_ASSERT, "cs assert");
+	if (rc == 0 && wrap) {
+		gx_seq++;
+		uint8_t h[4] = { 0xcc, 0xf2, (uint8_t)gx_seq, (uint8_t)(gx_seq >> 8) };
+		rc = se_tx(h, 4);
+	}
+	if (rc == 0) {
+		rc = se_tx_long(frame, n);
+	}
+	(void)se_cmd_simple(SPI_CS_DEASSERT, "cs deassert");
+	return rc;
+}
+
+/* n answer bytes in: plain clocked bytes, or after the BB F1 00 00 read header (wrap). */
+static int
+gx_read(uint8_t *buf, uint32_t n, int wrap)
+{
+	int rc = se_cmd_simple(SPI_CS_ASSERT, "cs assert");
+	int got = -1;
+	if (rc == 0 && wrap) {
+		static const uint8_t h[4] = { 0xbb, 0xf1, 0x00, 0x00 };
+		rc = se_tx(h, 4);
+	}
+	if (rc == 0) {
+		got = se_rx_long(buf, n);
+	}
+	(void)se_cmd_simple(SPI_CS_DEASSERT, "cs deassert");
+	return got;
+}
+
+/* Watches the IRQ pin for ms; returns the ms of the first level change, -1 when it stays. */
+static int
+irq_wait(int ms, int *level_out)
+{
+	int first = negroni_fp_irq_level(), change = -1;
+	for (int i = 0; i < ms; i++) {
+		IOSleep(1);
+		int now = negroni_fp_irq_level();
+		if (now != first) {
+			change = i + 1;
+			break;
+		}
+	}
+	*level_out = negroni_fp_irq_level();
+	return change;
+}
+
+static bool
+all_same(const uint8_t *b, uint32_t n)
+{
+	for (uint32_t i = 1; i < n; i++) {
+		if (b[i] != b[0]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/*
+ * Sends one command and reads rxn answer bytes. Returns 2 = a valid message pack came back (the
+ * proof that the MCU speaks the public protocol), 1 = bytes on MISO without a pack, 0 = MISO idle,
+ * -1 = SPI error.
+ */
+static int
+gx_probe(const char *name, uint8_t cmd, const uint8_t *pl, uint32_t plen, bool csum, uint32_t rxn, int wrap)
+{
+	uint8_t frame[GX_MAX_FRAME], in[128];
+	char tag[64];
+	uint32_t n = gx_encode(frame, cmd, pl, plen, csum);
+	if (n == 0 || rxn > sizeof(in)) {
+		return -1;
+	}
+	snprintf(tag, sizeof(tag), "%s %s tx", wrap ? "wrap" : "plain", name);
+	hexline(tag, frame, (int)n);
+	if (gx_write(frame, n, wrap) != 0) {
+		printf("NEGRONI FP: %s: tx failed\n", name);
+		return -1;
+	}
+	int level = 0, irq = irq_wait(gx_irqwait_ms, &level);
+	if (irq >= 0) {
+		printf("NEGRONI FP: irq40 changed %d ms after the frame (now %d): the MCU reacts\n", irq, level);
+	}
+	int got = gx_read(in, rxn, wrap);
+	if (got <= 0) {
+		printf("NEGRONI FP: %s: no data (rc %d)\n", name, got);
+		return -1;
+	}
+	snprintf(tag, sizeof(tag), "%s %s rx", wrap ? "wrap" : "plain", name);
+	hexline(tag, in, got > 16 ? 16 : got);
+	if (got > 16) {
+		snprintf(tag, sizeof(tag), "%s %s rx+16", wrap ? "wrap" : "plain", name);
+		hexline(tag, in + 16, got - 16 > 16 ? 16 : got - 16);
+	}
+	if (all_same(in, (uint32_t)got)) {
+		printf("NEGRONI FP: %s: MISO idle (all %02x)\n", name, in[0]);
+		return 0;
+	}
+	uint8_t rcmd = 0;
+	uint32_t rplen = 0, at = 0;
+	int d = gx_decode(in, (uint32_t)got, &rcmd, &rplen, &at);
+	if (d == 2) {
+		printf("NEGRONI FP: %s: VALID message pack at byte %u: cmd %02x payload %u bytes%s\n", name, at, rcmd, rplen,
+		    rcmd == GX_CMD_ACK ? " (ACK)" : "");
+		return 2;
+	}
+	if (d == 1) {
+		printf("NEGRONI FP: %s: pack header at byte %u (cmd %02x, len %u) but the checksum/length does not hold\n",
+		    name, at, rcmd, rplen);
+		return 1;
+	}
+	printf("NEGRONI FP: %s: bytes on MISO, no message pack header\n", name);
+	return 1;
+}
+
+static int gx_best_wrap = -1;   /* the transport that answered (step 10), -1 none */
+
+/* step 10: the public frames over both transports; sets gx_best_wrap */
+static void
+mcu_probe(int wrapsel)
+{
+	static const uint8_t p55[1] = { 0x55 };
+	static const uint8_t p00[2] = { 0x00, 0x00 };
+	static const uint8_t preg0[4] = { 0x00, 0x00, 0x00, 0x04 };   /* read_sensor_register(0, 4): 5110 chip id A2 04 25 00 */
+	static const uint8_t pnop[4] = { 0, 0, 0, 0 };
+	int best = 0;
+	for (int wrap = 0; wrap < 2; wrap++) {
+		if (wrapsel != 2 && wrap != wrapsel) {
+			continue;
+		}
+		int r = 0, t;
+		t = gx_probe("nop (00 x4, no checksum)", GX_CMD_NOP, pnop, 4, false, 16, wrap);
+		r = t > r ? t : r;
+		t = gx_probe("query mcu state (AE 55)", GX_CMD_QUERY_MCU_STATE, p55, 1, true, 32, wrap);
+		r = t > r ? t : r;
+		t = gx_probe("firmware version (A8 00 00)", GX_CMD_FW_VERSION, p00, 2, true, 64, wrap);
+		r = t > r ? t : r;
+		t = gx_probe("read otp (A6 00 00)", GX_CMD_READ_OTP, p00, 2, true, 80, wrap);
+		r = t > r ? t : r;
+		t = gx_probe("read sensor reg 0 (82 00 00 00 04)", GX_CMD_READ_SENSOR_REG, preg0, 4, true, 16, wrap);
+		r = t > r ? t : r;
+		if (r > best) {
+			best = r;
+			gx_best_wrap = wrap;
+		}
+	}
+	printf("NEGRONI FP: MCU probe result: %s%s\n",
+	    best == 2 ? "VALID message pack from the chip: the G7 MCU speaks the public Goodix MCU protocol" :
+	    best == 1 ? "bytes on MISO but no valid message pack: the chip answers, the framing differs" :
+	    "MISO idle: no answer to the public frames (wrong SE, mode, clock, or a different protocol)",
+	    best > 0 ? (gx_best_wrap ? " (CC F2 / BB F1 transport)" : " (plain SPI)") : "");
+}
+
+/* ---- 0353: one raw capture into a buffer + /dev/negroni-fp ---- */
+
+#define FP_IMG_DEFAULT   183456u          /* 364 x 252 x 2: DELMAR_ORIGIN_BUFFER_LEN (public gf_delmar_types.h) */
+#define FP_IMG_MAX       (1u << 20)
+#define FP_IMG_W         364u
+#define FP_IMG_H         252u
+#define FP_HDR_MAGIC     0x4950464eu      /* 'NFPI' little endian */
+
+struct negroni_fp_hdr {
+	uint32_t magic, width, height, len;    /* len = bytes that follow the header */
+	uint32_t mode, wrap, proto, pad;       /* negronifp, transport used, 2/1/0 = step 10 result, 0 */
+};
+
+static struct {
+	vm_offset_t buf;
+	uint32_t cap, len;
+	bool ready;
+	int proto;
+} fp_img;
+
+/* step 11 */
+static void
+fp_capture(uint32_t cap)
+{
+	static const uint8_t p01[2] = { 0x01, 0x00 };   /* mcu_get_image payload of the public 51x0 driver */
+	uint8_t frame[GX_MAX_FRAME];
+	int wrap = gx_best_wrap > 0 ? 1 : 0;
+	bool hbm_on = false;
+
+	if (fp_img.buf == 0) {
+		if (kmem_alloc(kernel_map, &fp_img.buf, cap, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("NEGRONI FP: capture: no buffer of %u bytes\n", cap);
+			return;
+		}
+		fp_img.cap = cap;
+	}
+	/* 0354: the disc and HBM only with a finger on the sensor area (touch driver); wait negronifp_fingerwait s */
+	negroni_fp_capture_window(true);
+	bool finger = negroni_fp_finger_down() != 0;
+	for (int i = 0; i < gx_fingerwait_s * 10 && !finger; i++) {
+		if (i == 0) {
+			printf("NEGRONI FP: capture: put a finger on the sensor area (%d s)\n", gx_fingerwait_s);
+		}
+		IOSleep(100);
+		finger = negroni_fp_finger_down() != 0;
+		if (!finger && (i % 10) == 9) {
+			negroni_fp_capture_window(true);        /* re-arm the 2 s window every 1 s while waiting */
+		}
+	}
+	int hb = 0;
+	if (finger) {
+		negroni_fp_capture_window(true);        /* fresh 2 s window: the disc is drawn now */
+		hb = negroni_fp_hbm(true);
+		hbm_on = (hb == 0);
+		printf("NEGRONI FP: capture: finger on the sensor: panel HBM on rc %d\n", hb);
+	} else {
+		printf("NEGRONI FP: capture: no finger on the sensor area in %d s: no HBM, no disc (the protocol test runs anyway)\n",
+		    gx_fingerwait_s);
+	}
+	int te = negroni_fb_te_wait(2, 100);
+	if (te < 0) {
+		IOSleep(17);            /* 2 frames at 120 Hz; the TE counter needs negronifb_te=1 */
+	}
+	printf("NEGRONI FP: capture: TE wait %d (%s)\n", te,
+	    te >= 0 ? "frames counted" : te == -1 ? "TE counter off (negronifb_te=0): 17 ms timed" : "no TE in 100 ms: timed");
+
+	uint32_t n = gx_encode(frame, GX_CMD_MCU_GET_IMAGE, p01, 2, true);
+	hexline(wrap ? "wrap get image tx" : "plain get image tx", frame, (int)n);
+	if (gx_write(frame, n, wrap) != 0) {
+		printf("NEGRONI FP: capture: tx failed\n");
+		goto done;
+	}
+	int level = 0, irq = irq_wait(gx_irqwait_ms < 100 ? gx_irqwait_ms : 100, &level);
+	printf("NEGRONI FP: capture: irq40 %s (level %d)\n", irq >= 0 ? "changed" : "unchanged", level);
+	/* the exposure is at the frame; the readout needs no light: HBM off before the (long) bulk read */
+	negroni_fp_capture_window(false);       /* 0354: the disc goes away with the exposure */
+	if (hbm_on) {
+		hb = negroni_fp_hbm(false);
+		printf("NEGRONI FP: capture: panel HBM off rc %d\n", hb);
+	}
+	hbm_on = false;
+
+	/* bounded read: FIFO pieces under one chip select; stop after 16 idle pieces when nothing looked like data */
+	{
+		uint8_t *b = (uint8_t *)fp_img.buf;
+		uint32_t got = 0, idle = 0;
+		bool data = false;
+		int rc = se_cmd_simple(SPI_CS_ASSERT, "cs assert");
+		if (rc == 0 && wrap) {
+			static const uint8_t h[4] = { 0xbb, 0xf1, 0x00, 0x00 };
+			rc = se_tx(h, 4);
+		}
+		while (rc == 0 && got < cap) {
+			uint32_t c = cap - got < GX_CHUNK ? cap - got : GX_CHUNK;
+			int r = se_rx(b + got, c, got + c >= cap);
+			if (r <= 0) {
+				break;
+			}
+			if (all_same(b + got, (uint32_t)r)) {
+				idle++;
+			} else {
+				data = true;
+				idle = 0;
+			}
+			got += (uint32_t)r;
+			if (!data && idle >= 16) {
+				break;
+			}
+		}
+		(void)se_cmd_simple(SPI_CS_DEASSERT, "cs deassert");
+		fp_img.len = got;
+		uint32_t z = 0, f = 0, distinct = 0;
+		uint8_t seen[32] = { 0 };
+		for (uint32_t i = 0; i < got; i++) {
+			z += b[i] == 0;
+			f += b[i] == 0xff;
+			seen[b[i] >> 3] |= (uint8_t)(1u << (b[i] & 7));
+		}
+		for (uint32_t i = 0; i < 256; i++) {
+			distinct += (seen[i >> 3] >> (i & 7)) & 1u;
+		}
+		hexline("capture rx", b, got > 16 ? 16 : (int)got);
+		uint8_t rcmd = 0;
+		uint32_t rplen = 0, at = 0;
+		int d = got ? gx_decode(b, got > 64 ? 64 : got, &rcmd, &rplen, &at) : 0;
+		printf("NEGRONI FP: capture: %u bytes read of %u (00: %u, ff: %u, %u distinct values)%s%s\n", got, cap, z, f, distinct,
+		    d == 2 ? ": message pack header, cmd " : d == 1 ? ": pack header without a valid checksum, cmd " : "",
+		    d ? "(see rx line)" : "");
+		if (d) {
+			printf("NEGRONI FP: capture: pack at byte %u cmd %02x payload %u bytes\n", at, rcmd, rplen);
+		}
+		printf("NEGRONI FP: capture: %s\n",
+		    distinct > 16 ? "VARIED DATA: pull /dev/negroni-fp and run scripts/fp/raw-to-png.py" :
+		    got == 0 ? "no bytes" : "idle bytes only: the public get-image frame is not the G7 readout command [I]");
+		fp_img.ready = true;
+	}
+done:
+	negroni_fp_capture_window(false);
+	if (hbm_on) {                   /* the tx-failure path */
+		hb = negroni_fp_hbm(false);
+		printf("NEGRONI FP: capture: panel HBM off rc %d\n", hb);
+	}
+}
+
+/* /dev/negroni-fp: header + the captured bytes */
+static int
+fp_dev_open(dev_t dev, int flags, int devtype, struct proc *p)
+{
+	(void)dev; (void)flags; (void)devtype; (void)p;
+	return 0;
+}
+
+static int
+fp_dev_close(dev_t dev, int flags, int devtype, struct proc *p)
+{
+	(void)dev; (void)flags; (void)devtype; (void)p;
+	return 0;
+}
+
+static int
+fp_dev_read(dev_t dev, struct uio *uio, int ioflag)
+{
+	struct negroni_fp_hdr h = {
+		.magic = FP_HDR_MAGIC, .width = FP_IMG_W, .height = FP_IMG_H, .len = fp_img.ready ? fp_img.len : 0,
+		.mode = (uint32_t)fp.mode, .wrap = (uint32_t)(gx_best_wrap > 0), .proto = (uint32_t)fp_img.proto, .pad = 0,
+	};
+	(void)dev; (void)ioflag;
+	off_t off = uio_offset(uio);
+	uint64_t tot = sizeof(h) + h.len;
+	if (off < 0 || (uint64_t)off >= tot) {
+		return 0;
+	}
+	if (off < (off_t)sizeof(h)) {
+		uint32_t n = (uint32_t)(sizeof(h) - off);
+		if (n > uio_resid(uio)) {
+			n = (uint32_t)uio_resid(uio);
+		}
+		int e = uiomove((caddr_t)&h + off, (int)n, uio);
+		if (e) {
+			return e;
+		}
+		off = uio_offset(uio);
+	}
+	while (uio_resid(uio) > 0 && (uint64_t)off < tot) {
+		uint32_t n = (uint32_t)(tot - off);
+		if (n > uio_resid(uio)) {
+			n = (uint32_t)uio_resid(uio);
+		}
+		int e = uiomove((caddr_t)fp_img.buf + (off - sizeof(h)), (int)n, uio);
+		if (e) {
+			return e;
+		}
+		off = uio_offset(uio);
+	}
+	return 0;
+}
+
+static const struct cdevsw fp_cdevsw = {
+	.d_open = fp_dev_open,
+	.d_close = fp_dev_close,
+	.d_read = fp_dev_read,
+	.d_write = eno_rdwrt,
+	.d_ioctl = eno_ioctl,
+	.d_stop = eno_stop,
+	.d_reset = eno_reset,
+	.d_ttys = NULL,
+	.d_select = eno_select,
+	.d_mmap = eno_mmap,
+	.d_strategy = eno_strat,
+	.d_type = 0,
+};
+
+static void
+fp_dev_init(void)
+{
+	int major = cdevsw_add(-1, &fp_cdevsw);
+	if (major < 0) {
+		printf("NEGRONI FP: cdevsw_add failed\n");
+		return;
+	}
+	devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "negroni-fp");
+}
+
+/*
+ * 0354: kern.negroni_fp_ui: 0 = nothing, 1 = the lock-screen glyph (NegroniFramebuffer.cpp). Written by
+ * userland/fp/negroni-fpd from the SpringBoard notifications com.apple.springboard.lockstate and
+ * com.apple.springboard.hasBlankedScreen (root). Readable by all.
+ */
+static int fp_ui_state;
+
+static int
+sysctl_fp_ui(__unused struct sysctl_oid *oidp, __unused void *arg1, __unused int arg2, struct sysctl_req *req)
+{
+	int v = fp_ui_state, changed = 0, error;
+
+	error = sysctl_io_number(req, v, sizeof(v), &v, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	if (req->p != NULL && proc_suser(req->p) != 0) {
+		return EPERM;
+	}
+	if (v != 0 && v != 1) {
+		return EINVAL;
+	}
+	fp_ui_state = v;
+	negroni_fp_ui_set(v);
+	return 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, negroni_fp_ui, CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_LOCKED | CTLFLAG_ANYBODY,
+    NULL, 0, sysctl_fp_ui, "I", "NEGRONI fingerprint overlay: 0 hidden, 1 lock-screen glyph (root writes)");
+
+/* ---- power and pins ---- */
+
+static void
+pins_spi(bool on)
+{
+	if (on) {
+		pin_cfg(FP_PIN_MISO, TLMM_FUNC(FP_FUNC_QUP10) | TLMM_DRIVE_MA(6) | TLMM_PULL_NONE);
+		pin_cfg(FP_PIN_MOSI, TLMM_FUNC(FP_FUNC_QUP10) | TLMM_DRIVE_MA(6) | TLMM_PULL_NONE);
+		pin_cfg(FP_PIN_CLK, TLMM_FUNC(FP_FUNC_QUP10) | TLMM_DRIVE_MA(6) | TLMM_PULL_NONE);
+		pin_cfg(FP_PIN_CS, TLMM_FUNC(FP_FUNC_QUP10) | TLMM_DRIVE_MA(6) | TLMM_PULL_NONE);
+	} else {
+		/* live.dts qupv3_se10_spi_sleep: gpio, 6 mA, bias-disable, input */
+		pin_cfg(FP_PIN_MISO, TLMM_FUNC(0) | TLMM_DRIVE_MA(6) | TLMM_PULL_NONE);
+		pin_cfg(FP_PIN_MOSI, TLMM_FUNC(0) | TLMM_DRIVE_MA(6) | TLMM_PULL_NONE);
+		pin_cfg(FP_PIN_CLK, TLMM_FUNC(0) | TLMM_DRIVE_MA(6) | TLMM_PULL_NONE);
+		pin_cfg(FP_PIN_CS, TLMM_FUNC(0) | TLMM_DRIVE_MA(6) | TLMM_PULL_NONE);
+	}
+	fp.pins_spi = on;
+}
+
+static void
+power_down(const char *why)
+{
+	printf("NEGRONI FP: power down (%s): reset low, pins to gpio, SE clock votes back%s\n", why,
+	    fp.ldo_voted ? ", ldoc11 off" : "");
+	if (fp.powered) {
+		pin_out(FP_PIN_RST, 0);
+		fp.powered = false;
+	}
+	if (fp.pins_spi) {
+		pins_spi(false);
+	}
+	gcc_restore();
+	if (fp.ldo_voted) {
+		int rc = negroni_rpmh_vreg_disable("ldoc11");
+		printf("NEGRONI FP: ldoc11 off vote rc %d\n", rc);
+		fp.ldo_voted = false;
+	}
+}
+
+static void
+log_pins(const char *when)
+{
+	printf("NEGRONI FP: pins %s: irq40 ctl %#x in %u, rst41 ctl %#x out %u, id42 ctl %#x in %u, "
+	    "spi36-39 ctl %#x %#x %#x %#x\n", when,
+	    rd(fp.tlmm, FP_PIN(FP_PIN_IRQ)), rd(fp.tlmm, FP_PIN(FP_PIN_IRQ) + 4) & TLMM_IN,
+	    rd(fp.tlmm, FP_PIN(FP_PIN_RST)), (rd(fp.tlmm, FP_PIN(FP_PIN_RST) + 4) & TLMM_OUT) ? 1u : 0u,
+	    rd(fp.tlmm, FP_PIN(FP_PIN_ID)), rd(fp.tlmm, FP_PIN(FP_PIN_ID) + 4) & TLMM_IN,
+	    rd(fp.tlmm, FP_PIN(FP_PIN_MISO)), rd(fp.tlmm, FP_PIN(FP_PIN_MOSI)),
+	    rd(fp.tlmm, FP_PIN(FP_PIN_CLK)), rd(fp.tlmm, FP_PIN(FP_PIN_CS)));
+}
+
+static void
+fp_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	int delay_s = 15, hz = 4800000, mode = 0, ldo = 1, keep = 0, poll_s = 60, wrapsel = 2;
+	uint32_t img = FP_IMG_DEFAULT;
+	(void)PE_parse_boot_argn("negronifp_delay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("negronifp_hz", &hz, sizeof(hz));
+	(void)PE_parse_boot_argn("negronifp_mode", &mode, sizeof(mode));
+	(void)PE_parse_boot_argn("negronifp_ldo", &ldo, sizeof(ldo));
+	(void)PE_parse_boot_argn("negronifp_keep", &keep, sizeof(keep));
+	(void)PE_parse_boot_argn("negronifp_poll", &poll_s, sizeof(poll_s));
+	(void)PE_parse_boot_argn("negronifp_wrap", &wrapsel, sizeof(wrapsel));
+	(void)PE_parse_boot_argn("negronifp_irqwait", &gx_irqwait_ms, sizeof(gx_irqwait_ms));
+	if (wrapsel < 0 || wrapsel > 2) {
+		wrapsel = 2;
+	}
+	if (gx_irqwait_ms < 1 || gx_irqwait_ms > 5000) {
+		gx_irqwait_ms = 100;
+	}
+	(void)PE_parse_boot_argn("negronifp_img", &img, sizeof(img));
+	(void)PE_parse_boot_argn("negronifp_fingerwait", &gx_fingerwait_s, sizeof(gx_fingerwait_s));
+	if (gx_fingerwait_s < 0 || gx_fingerwait_s > 600) {
+		gx_fingerwait_s = 10;
+	}
+	if (img < 64 || img > FP_IMG_MAX) {
+		img = FP_IMG_DEFAULT;
+	}
+	if (hz < 100000 || hz > 19200000) {
+		hz = 4800000;
+	}
+	if (delay_s < 0 || delay_s > 600) {
+		delay_s = 15;
+	}
+	if (poll_s < 1 || poll_s > 3600) {
+		poll_s = 60;
+	}
+	for (int i = 0; i < delay_s; i++) {
+		IOSleep(1000);
+	}
+	printf("NEGRONI FP: start (negronifp=%d, Goodix optical G7 [DT], QUP1 SE2 0xa88000, TLMM 36-42)\n", fp.mode);
+
+	step(1, "map (QUP1 wrapper, SE, GCC pages, TLMM 36-43)");
+	fp.qup = ml_io_map(FP_QUP1_PA, FP_QUP1_LEN);
+	fp.se = ml_io_map(FP_SE_PA, FP_SE_LEN);
+	fp.gcc_vote = ml_io_map(FP_GCC_PA + FP_GCC_VOTE_PAGE, 0x4000);
+	fp.gcc_qup = ml_io_map(FP_GCC_PA + FP_GCC_QUP_PAGE, 0x4000);
+	fp.gcc_core = ml_io_map(FP_GCC_PA + FP_GCC_CORE_PAGE, 0x4000);
+	fp.tlmm = ml_io_map(FP_TLMM_PA, FP_TLMM_LEN);
+	if (!fp.qup || !fp.se || !fp.gcc_vote || !fp.gcc_qup || !fp.gcc_core || !fp.tlmm) {
+		printf("NEGRONI FP: stop: a map failed\n");
+		goto out;
+	}
+	log_pins("at start");
+
+	step(2, "GCC: BCM QUP1 vote, QUP1 AHB/core votes (hw-gated AHB branches not checked), s2 RCG to XO 19.2 MHz, s2 clock");
+	gcc_bcm_vote();
+	fp.vote_before = rd(fp.gcc_vote, GCC_VOTE - FP_GCC_VOTE_PAGE);
+	printf("NEGRONI FP: APCS vote %#x, CBCR m_ahb %#x s_ahb %#x core %#x core2x %#x s2 %#x\n", fp.vote_before,
+	    rd(fp.gcc_qup, GCC_HALT_M_AHB - FP_GCC_QUP_PAGE), rd(fp.gcc_qup, GCC_HALT_S_AHB - FP_GCC_QUP_PAGE),
+	    rd(fp.gcc_core, GCC_HALT_CORE - FP_GCC_CORE_PAGE), rd(fp.gcc_core, GCC_HALT_CORE_2X - FP_GCC_CORE_PAGE),
+	    rd(fp.gcc_qup, GCC_HALT_S2 - FP_GCC_QUP_PAGE));
+	fp.se_clocked = true;
+	if (!gcc_branch_on(GCC_VOTE_M_AHB, fp.gcc_qup, GCC_HALT_M_AHB - FP_GCC_QUP_PAGE, "wrap_1_m_ahb") ||
+	    !gcc_branch_on(GCC_VOTE_S_AHB, fp.gcc_qup, GCC_HALT_S_AHB - FP_GCC_QUP_PAGE, "wrap_1_s_ahb") ||
+	    !gcc_branch_on(GCC_VOTE_CORE_2X, fp.gcc_core, GCC_HALT_CORE_2X - FP_GCC_CORE_PAGE, "wrap1_core_2x") ||
+	    !gcc_branch_on(GCC_VOTE_CORE, fp.gcc_core, GCC_HALT_CORE - FP_GCC_CORE_PAGE, "wrap1_core") ||
+	    !gcc_s2_rcg_xo() ||
+	    !gcc_branch_on(GCC_VOTE_S2, fp.gcc_qup, GCC_HALT_S2 - FP_GCC_QUP_PAGE, "wrap1_s2")) {
+		power_down("clocks");
+		goto out;
+	}
+
+	step(3, "SE probe (first read of 0xac0004 / 0xa88000: may fault if the XPU/TEE owns the SE): QUP HW version, firmware protocol, FIFO");
+	{
+		uint32_t ver = rd(fp.qup, QUP_HW_VER_REG);
+		uint32_t fw = rd(fp.se, GENI_FW_REVISION_RO);
+		uint32_t dis = rd(fp.se, GENI_IF_DISABLE_RO);
+		uint32_t hp0 = rd(fp.se, SE_HW_PARAM_0), hp1 = rd(fp.se, SE_HW_PARAM_1);
+		uint32_t major = ver >> 28, minor = (ver >> 16) & 0xfff;
+		fp.fifo_width = (hp0 >> 24) & 0x3f;
+		fp.fifo_depth = (hp0 >> 16) & ((major > 3 || (major == 3 && minor >= 10)) ? 0xffu : 0x3fu);
+		printf("NEGRONI FP: QUP1 hw %u.%u.%u, SE fw rev %#x (protocol %u: %s), IF_DISABLE %#x, "
+		    "HW_PARAM0 %#x HW_PARAM1 %#x: tx fifo %u words x %u bits, STATUS %#x\n",
+		    major, minor, ver & 0xffff, fw, FW_REV_PROTOCOL(fw),
+		    FW_REV_PROTOCOL(fw) == GENI_SE_SPI ? "SPI" : FW_REV_PROTOCOL(fw) == 0 ? "none" : "other",
+		    dis, hp0, hp1, fp.fifo_depth, fp.fifo_width, rd(fp.se, SE_GENI_STATUS));
+		if (FW_REV_PROTOCOL(fw) != GENI_SE_SPI) {
+			printf("NEGRONI FP: stop: SE2 firmware is not SPI (qupfw loads it per the TZ/XBL config)\n");
+			power_down("protocol");
+			goto out;
+		}
+		if (dis & FIFO_IF_DISABLE) {
+			printf("NEGRONI FP: stop: FIFO interface disabled on this SE (GPI DMA only)\n");
+			power_down("fifo");
+			goto out;
+		}
+		if (fp.fifo_depth < 4 || fp.fifo_width != 32) {
+			printf("NEGRONI FP: stop: unexpected FIFO geometry\n");
+			power_down("fifo geometry");
+			goto out;
+		}
+	}
+
+	step(4, "SE init: FIFO mode, 8-bit packing, SPI mode and clock");
+	se_init_fifo();
+	se_spi_setup((unsigned)hz, (unsigned)mode & 3u);
+
+	step(5, "pins: reset low, irq input pull-down, id input pull-up, SPI pins to qup10");
+	pin_out(FP_PIN_RST, 0);
+	pin_cfg(FP_PIN_RST, TLMM_FUNC(0) | TLMM_DRIVE_MA(2) | TLMM_PULL_NONE | TLMM_OE);
+	pin_cfg(FP_PIN_IRQ, TLMM_FUNC(0) | TLMM_DRIVE_MA(2) | TLMM_PULL_DOWN);
+	pin_cfg(FP_PIN_ID, TLMM_FUNC(0) | TLMM_DRIVE_MA(2) | TLMM_PULL_UP);
+	pins_spi(true);
+	IOSleep(2);
+	printf("NEGRONI FP: fp id (TLMM 42, pull-up) = %u (DT goodix_optical_G7: fp-id 1)\n",
+	    rd(fp.tlmm, FP_PIN(FP_PIN_ID) + 4) & TLMM_IN);
+
+	step(6, "power: RPMh ldoc11 (pm8350c_l11) 3000 mV");
+	if (ldo) {
+		/* 0352: the RPMh voter is shared (Wi-Fi, BT, camera, ADSP): retry while it is busy, as 0330 */
+		int rc = EBUSY;
+		for (unsigned i = 0; i < 40 && rc == EBUSY; i++) {
+			rc = negroni_rpmh_vreg_enable("ldoc11", 3000);
+			if (rc == EBUSY) {
+				IOSleep(50);
+			}
+		}
+		fp.ldo_voted = (rc == 0);
+		printf("NEGRONI FP: ldoc11 vote rc %d\n", rc);
+		if (rc != 0) {
+			printf("NEGRONI FP: stop: the ldoc11 vote failed (errno %d): the sensor is unpowered\n", rc);
+			power_down("ldo vote");
+			goto out;
+		}
+	} else {
+		printf("NEGRONI FP: ldoc11 vote skipped (negronifp_ldo=0)\n");
+	}
+	IOSleep(10);
+
+	step(7, "reset: 41 low 5 ms, high, 20 ms");
+	{
+		int irq_before = negroni_fp_irq_level();
+		pin_out(FP_PIN_RST, 0);
+		IOSleep(5);
+		pin_out(FP_PIN_RST, 1);
+		fp.powered = true;
+		int irq_rise_ms = -1;
+		for (int ms = 0; ms < 20; ms++) {
+			IOSleep(1);
+			if (irq_rise_ms < 0 && negroni_fp_irq_level()) {
+				irq_rise_ms = ms + 1;
+			}
+		}
+		printf("NEGRONI FP: irq40 before reset %d, after reset %d%s\n", irq_before, negroni_fp_irq_level(),
+		    irq_rise_ms >= 0 ? " (rose within 20 ms: the chip answers the reset)" : "");
+		if (irq_rise_ms >= 0) {
+			printf("NEGRONI FP: irq rose %d ms after reset\n", irq_rise_ms);
+		}
+	}
+	log_pins("after reset");
+
+	step(8, "chip ID over SPI (frames [I]: Goodix F1 read of reg 0x0000; then 8 clocked bytes)");
+	{
+		uint8_t in[16];
+		static const uint8_t rd_reg0[3] = { 0xf1, 0x00, 0x00 };
+		static const uint8_t zero[1] = { 0x00 };
+		printf("NEGRONI FP: IOS %#x (bit 1 MISO level)\n", rd(fp.se, SE_GENI_IOS));
+		int a = spi_cmd_read(rd_reg0, 3, in, 8, "F1 00 00 ->");
+		int allsame = 1;
+		for (int i = 1; a > 0 && i < a; i++) {
+			allsame &= in[i] == in[0];
+		}
+		if (a > 0 && !(allsame && (in[0] == 0 || in[0] == 0xff))) {
+			printf("NEGRONI FP: chip answered (bytes differ from 00/ff): candidate chip id %02x%02x\n", in[0], in[1]);
+		} else if (a > 0) {
+			printf("NEGRONI FP: no answer on MISO (all %02x)\n", in[0]);
+		}
+		(void)spi_cmd_read(zero, 1, in, 8, "00 ->");
+		/* a second F1 read after the IRQ settles (some chips need a 'clear irq' first) */
+		IOSleep(10);
+		(void)spi_cmd_read(rd_reg0, 3, in, 8, "F1 00 00 again ->");
+	}
+
+	if (fp.mode >= 3) {
+		step(10, "MCU frames [I]: public Goodix MCU message pack (A0 len sum | cmd len payload 0xAA-sum), plain SPI and the 5120-SPI transport (CC F2 seq / BB F1 00 00)");
+		mcu_probe(wrapsel);
+		fp_img.proto = gx_best_wrap < 0 ? 0 : 2;
+	}
+
+	if (fp.mode >= 4) {
+		step(11, "capture [I]: panel HBM on, 2 TE frames, MCU get image (20 01 00), HBM off, bounded read into the buffer; /dev/negroni-fp");
+		fp_capture(img);
+	}
+
+	if (fp.mode >= 2) {
+		step(9, "IRQ poll (TLMM 40): touch the sensor area");
+		int last = negroni_fp_irq_level(), lines = 0;
+		uint64_t t0;
+		clock_get_uptime(&t0);
+		for (int i = 0; i < poll_s * 200; i++) {
+			IOSleep(5);
+			int now = negroni_fp_irq_level();
+			if (now != last) {
+				uint64_t t, ns;
+				clock_get_uptime(&t);
+				absolutetime_to_nanoseconds(t - t0, &ns);
+				if (lines++ < 32) {
+					printf("NEGRONI FP: irq %d -> %d at %llu ms\n", last, now, ns / 1000000ULL);
+				}
+				last = now;
+			}
+		}
+		printf("NEGRONI FP: irq poll done (%d changes)\n", lines);
+	}
+	if (keep) {
+		printf("NEGRONI FP: done, sensor left powered (negronifp_keep=1)\n");
+	} else {
+		power_down("done");
+	}
+out:
+	printf("NEGRONI FP: end\n");
+	fp.thread = THREAD_NULL;
+	thread_terminate(current_thread());
+}
+
+void
+negroni_fp_init(void)
+{
+	if (fp.started) {
+		return;
+	}
+	fp.started = 1;
+	(void)PE_parse_boot_argn("negronifp", &fp.mode, sizeof(fp.mode));
+	if (fp.mode <= 0) {
+		return;
+	}
+	fp_dev_init();                  /* 0353: /dev/negroni-fp (header only until a capture) */
+	if (kernel_thread_start(fp_thread, NULL, &fp.thread) == KERN_SUCCESS) {
+		thread_deallocate(fp.thread);
+	}
+}
+#endif /* NEGRONI */
diff --git a/bsd/dev/negroni_gpu_blit.c b/bsd/dev/negroni_gpu_blit.c
new file mode 100644
index 0000000..92f6410
--- /dev/null
+++ b/bsd/dev/negroni_gpu_blit.c
@@ -0,0 +1,206 @@
+/*
+ * NEGRONI: the A730's 2D engine copies a BGRA8 rectangle (see negroni_gpu_blit.h).
+ *
+ * The stream is the one Mesa 25.0.7 emits for a sysmem 2D blit on A7XX
+ * (gallium fd6_blitter.cc emit_setup + emit_blit_setup + emit_blit_src/dst +
+ * emit_blit_fini; turnip r2d_setup_common/r2d_run), register offsets and fields
+ * from src/freedreno/registers/adreno/a6xx.xml, events from adreno_pm4.xml
+ * (A7XX names), the sysmem CCU layout of the A730 from freedreno_devices.py
+ * (4 CCUs, 256K depth + 64K color each: depth at 0, color at 1 MiB).
+ *
+ * The destination pitch of the 2D engine is in 64-byte units and its base is
+ * 64-byte aligned; the panel's rows are 4320 bytes (1080 pixels). So the copy
+ * is two blits: the even rows and the odd rows, each as an image of twice the
+ * pitch (8640 = 135 * 64). An odd row starts 32 bytes into a 64-byte line: its
+ * blit starts at that line and at x + 8 pixels. The source gets the same
+ * treatment (twice its pitch: a multiple of 128, which A7XX's
+ * SP_PS_2D_SRC_PITCH asks for when the texture type is 2D).
+ */
+#include "negroni_gpu_blit.h"
+
+#if !defined(KERNEL) || defined(ARM64_BOARD_CONFIG_NEGRONI)
+
+/* PM4 */
+#define CP_WAIT_FOR_IDLE        0x26
+#define CP_BLIT                 0x2c
+#define CP_EVENT_WRITE7         0x46
+#define BLIT_OP_SCALE           3
+
+/* A7XX events */
+#define EV_CCU_INVALIDATE_DEPTH 0x18
+#define EV_CCU_INVALIDATE_COLOR 0x19
+#define EV_CCU_CLEAN_DEPTH      0x20
+#define EV_CCU_CLEAN_COLOR      0x21
+#define EV_CACHE_CLEAN          0x31
+#define EV_CACHE_INVALIDATE7    0x33
+
+/* registers (dwords) */
+#define GRAS_2D_BLIT_CNTL       0x8400
+#define GRAS_2D_SRC_TL_X        0x8401  /* .. SRC_BR_X, SRC_TL_Y, SRC_BR_Y, DST_TL, DST_BR (0x8406) */
+#define RB_WINDOW_OFFSET        0x8890
+#define RB_WINDOW_OFFSET2       0x88d4
+#define RB_CCU_CNTL2            0x88e5  /* A7XX */
+#define RB_2D_BLIT_CNTL         0x8c00
+#define RB_2D_UNKNOWN_8C01      0x8c01
+#define RB_2D_DST_INFO          0x8c17  /* .. RB_2D_DST lo, hi, RB_2D_DST_PITCH (0x8c1a) */
+#define RB_2D_DST_FLAGS         0x8c20  /* .. lo, hi, pitch */
+#define SP_2D_DST_FORMAT        0xa9bf  /* A7XX (0xacc0 is the A6XX one) */
+#define SP_WINDOW_OFFSET        0xab21  /* A7XX */
+#define SP_PS_2D_SRC_INFO       0xb2c0  /* A7XX: .. SIZE, SRC lo, hi, PITCH (0xb2c4) */
+#define SP_PS_2D_SRC_FLAGS      0xb2ca  /* A7XX: .. lo, hi, pitch */
+#define SP_PS_2D_WINDOW_OFFSET  0xb2d1  /* A7XX */
+#define TPL1_2D_SRC_CNTL        0xb2d2  /* A7XX */
+#define SP_TP_WINDOW_OFFSET     0xb307
+
+/* values */
+#define FMT6_8_8_8_8_UNORM      0x30u
+#define SWAP_WZYX               1u      /* B G R A in memory, as the boot ladder's step 22 fill */
+#define R2D_UNORM8              0x10u
+#define TEX_2D                  1u
+#define BLIT_CNTL_COPY          (FMT6_8_8_8_8_UNORM << 8 | 0xfu << 20 | R2D_UNORM8 << 24)
+#define DST_FORMAT_8888         (FMT6_8_8_8_8_UNORM << 3 | 0xfu << 12)
+#define SURF_INFO_BGRA          (FMT6_8_8_8_8_UNORM | SWAP_WZYX << 10)
+#define SRC_INFO_UNK20_UNK22    (1u << 20 | 1u << 22)   /* Mesa sets both for every 2D source */
+#define CCU_CNTL2_A730_SYSMEM   (0x100u << 23)          /* color at 1 MiB (>> 12), depth at 0, full sizes */
+#define MAX_2D                  16384u
+
+static uint32_t
+odd_parity(uint32_t v)
+{
+	return (0x9669 >> (0xf & (v ^ v >> 4 ^ v >> 8 ^ v >> 12 ^ v >> 16 ^ v >> 20 ^ v >> 24 ^ v >> 28))) & 1;
+}
+
+static uint32_t
+pkt7(uint32_t opcode, uint32_t words)
+{
+	return 7u << 28 | words | odd_parity(words) << 15 | opcode << 16 | odd_parity(opcode) << 23;
+}
+
+static uint32_t
+pkt4(uint32_t reg, uint32_t count)
+{
+	return 4u << 28 | count | odd_parity(count) << 7 | reg << 8 | odd_parity(reg) << 27;
+}
+
+struct ib {
+	uint32_t *w;
+	uint32_t n, max;
+};
+
+static void
+put(struct ib *b, uint32_t v)
+{
+	if (b->n < b->max) {
+		b->w[b->n] = v;
+	}
+	b->n++;
+}
+
+static void
+event(struct ib *b, uint32_t e)
+{
+	put(b, pkt7(CP_EVENT_WRITE7, 1));
+	put(b, e);
+}
+
+static void
+reg(struct ib *b, uint32_t r, uint32_t v)
+{
+	put(b, pkt4(r, 1));
+	put(b, v);
+}
+
+uint32_t
+negroni_gpu_copy_ib(const struct negroni_gpu_copy *c, uint32_t *words, uint32_t max_words)
+{
+	struct ib b = { .w = words, .n = 0, .max = max_words };
+	uint32_t blits = 0;
+
+	if (c->w == 0 || c->h == 0 || (c->src & 63) || (c->dst & 63) || (c->src_pitch & 63) ||
+	    (c->dst_pitch & 31) || c->src_pitch == 0 || c->dst_pitch == 0 ||
+	    (uint64_t)c->src_pitch * 2 >= (1u << 21) || (uint64_t)c->dst_pitch * 2 / 64 > 0xffffu ||
+	    (uint64_t)c->sx + c->w > c->src_pitch / 4 || (uint64_t)c->sx + c->w > MAX_2D ||
+	    (uint64_t)c->dx + c->w > c->dst_pitch / 4 || c->h > 2 * MAX_2D) {
+		return 0;
+	}
+
+	/* emit_setup: CCU clean + invalidate, texture cache invalidate (the source was just written) */
+	event(&b, EV_CCU_CLEAN_COLOR);
+	event(&b, EV_CCU_CLEAN_DEPTH);
+	event(&b, EV_CCU_INVALIDATE_COLOR);
+	event(&b, EV_CCU_INVALIDATE_DEPTH);
+	event(&b, EV_CACHE_INVALIDATE7);
+	put(&b, pkt7(CP_WAIT_FOR_IDLE, 0));
+	reg(&b, RB_CCU_CNTL2, CCU_CNTL2_A730_SYSMEM);
+	/* what a user submission may have left from binned (GMEM) rendering */
+	reg(&b, RB_WINDOW_OFFSET, 0);
+	reg(&b, RB_WINDOW_OFFSET2, 0);
+	reg(&b, SP_WINDOW_OFFSET, 0);
+	reg(&b, SP_TP_WINDOW_OFFSET, 0);
+	reg(&b, SP_PS_2D_WINDOW_OFFSET, 0);
+	/* emit_blit_setup */
+	reg(&b, RB_2D_BLIT_CNTL, BLIT_CNTL_COPY);
+	reg(&b, GRAS_2D_BLIT_CNTL, BLIT_CNTL_COPY);
+	reg(&b, TPL1_2D_SRC_CNTL, TEX_2D << 29);
+	reg(&b, SP_2D_DST_FORMAT, DST_FORMAT_8888);
+	reg(&b, RB_2D_UNKNOWN_8C01, 0);
+
+	for (uint32_t parity = 0; parity < 2; parity++) {
+		uint32_t rows = c->h > parity ? (c->h - parity + 1) / 2 : 0;
+		if (rows == 0) {
+			continue;
+		}
+		uint64_t row = c->dst + (uint64_t)(c->dy + parity) * c->dst_pitch;
+		uint64_t dst = row & ~63ull;
+		uint32_t x = c->dx + (uint32_t)(row - dst) / 4;
+		uint32_t dpitch = 2 * c->dst_pitch, spitch = 2 * c->src_pitch;
+		uint64_t src = c->src + (uint64_t)(c->sy + parity) * c->src_pitch;
+		uint32_t width = c->sx + c->w;
+
+		if (x + c->w > MAX_2D || rows > MAX_2D || (uint64_t)x + c->w > dpitch / 4) {
+			return 0;
+		}
+		/* emit_blit_texture: coordinates (source 24.8 fixed point, inclusive) */
+		put(&b, pkt4(GRAS_2D_SRC_TL_X, 6));
+		put(&b, c->sx << 8);
+		put(&b, (c->sx + c->w - 1) << 8);
+		put(&b, 0);
+		put(&b, (rows - 1) << 8);
+		put(&b, x);
+		put(&b, (x + c->w - 1) | (rows - 1) << 16);
+		/* emit_blit_src: linear BGRA8, nearest */
+		put(&b, pkt4(SP_PS_2D_SRC_INFO, 5));
+		put(&b, SURF_INFO_BGRA | SRC_INFO_UNK20_UNK22);
+		put(&b, width | rows << 15);
+		put(&b, (uint32_t)src);
+		put(&b, (uint32_t)(src >> 32));
+		put(&b, spitch << 3);
+		put(&b, pkt4(SP_PS_2D_SRC_FLAGS, 3));
+		put(&b, 0);
+		put(&b, 0);
+		put(&b, 0);
+		/* emit_blit_dst */
+		put(&b, pkt4(RB_2D_DST_INFO, 4));
+		put(&b, SURF_INFO_BGRA);
+		put(&b, (uint32_t)dst);
+		put(&b, (uint32_t)(dst >> 32));
+		put(&b, dpitch >> 6);
+		put(&b, pkt4(RB_2D_DST_FLAGS, 3));
+		put(&b, 0);
+		put(&b, 0);
+		put(&b, 0);
+		/* emit_blit_fini (RB_DBG_ECO_CNTL_blit is 0 on the A730, as RB_DBG_ECO_CNTL) */
+		put(&b, pkt7(CP_WAIT_FOR_IDLE, 0));
+		put(&b, pkt7(CP_BLIT, 1));
+		put(&b, BLIT_OP_SCALE);
+		put(&b, pkt7(CP_WAIT_FOR_IDLE, 0));
+		blits++;
+	}
+	/* the pixels out of the CCU and the caches before the fence */
+	event(&b, EV_CCU_CLEAN_COLOR);
+	event(&b, EV_CACHE_CLEAN);
+	put(&b, pkt7(CP_WAIT_FOR_IDLE, 0));
+	return blits != 0 && b.n <= b.max ? b.n : 0;
+}
+
+#endif /* !KERNEL || ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_gpu_blit.h b/bsd/dev/negroni_gpu_blit.h
new file mode 100644
index 0000000..7b87559
--- /dev/null
+++ b/bsd/dev/negroni_gpu_blit.h
@@ -0,0 +1,43 @@
+/*
+ * NEGRONI: A730 2D-engine copy of a BGRA8 rectangle (the panel present of
+ * iokit/Kernel/arm/NegroniGPU.cpp). Pure C, no kernel headers: the host test
+ * patches/xnu/tests/gpu-blit-ib-test.c (project repo) builds this file as it is.
+ */
+#ifndef _NEGRONI_GPU_BLIT_H
+#define _NEGRONI_GPU_BLIT_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Copy w x h pixels (4 bytes each, B G R A, no conversion) from (sx, sy) of
+ * the source image to (dx, dy) of the destination image. Addresses are GPU
+ * addresses of row 0, pixel 0. The source must be 64-byte aligned with a
+ * pitch that is a multiple of 64; the destination 64-byte aligned with a
+ * pitch that is a multiple of 32 (the panel's 4320 is 32 * 135, not 64 * n).
+ */
+struct negroni_gpu_copy {
+	uint64_t src;
+	uint32_t src_pitch;
+	uint64_t dst;
+	uint32_t dst_pitch;
+	uint32_t sx, sy, dx, dy, w, h;
+};
+
+/* Words the IB of one copy needs at most. */
+#define NEGRONI_GPU_COPY_WORDS  256
+
+/*
+ * Writes the command stream (PM4 type 4/7 packets) into ib and returns its
+ * length in words; 0 when the copy cannot be expressed (alignment, sizes).
+ */
+uint32_t negroni_gpu_copy_ib(const struct negroni_gpu_copy *c, uint32_t *ib, uint32_t max_words);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _NEGRONI_GPU_BLIT_H */
diff --git a/bsd/dev/negroni_haptic.c b/bsd/dev/negroni_haptic.c
new file mode 100644
index 0000000..e5196b1
--- /dev/null
+++ b/bsd/dev/negroni_haptic.c
@@ -0,0 +1,563 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450): vibration motor, PM8350B "HV haptics" (patch 0300).
+ *
+ * Hardware [V live DT qcom,hv-haptics@f000 under qcom,pm8350b@3, status "ok"; no I2C LRA driver
+ * node (no awinic/aw869x/oplus,haptic)]: an LRA (qcom,vibrator-type 8151 = SLA0815 in the OnePlus
+ * driver) on the PM8350B haptics block, SPMI bus 0 SID 3:
+ *   HAP_CFG 0xf000, HAP_PTN 0xf100, HAP_BOOST 0xf200 (DT reg = <0xf000 0xf100 0xf200>)
+ *   hap_cfg SDAM: PMK8350 SID 0 sdam@9d00 (nvmem "hap_cfg_sdam", the hBoost PBS trigger)
+ *   DT: qcom,vmax-mv 1680, qcom,lra-period-us 5882 (170 Hz), qcom,drv-sig-shape 1 (sine)
+ * Direct-play sequence, as Linux drivers/input/misc/qcom-hv-haptics.c (OnePlus kernel source,
+ * out/src/op-kernel) does a constant effect:
+ *   haptics_load_constant_effect (2134): VMAX 0xf048 = mV / 50 (1271), DIRECT_PLAY 0xf126 =
+ *     amplitude (1349), auto-resonance 0xf063 bit 7 off (OPLUS build, 2194)
+ *   haptics_enable_play(true) (1597): FAULT_CLR 0xf066 = 0x07, open-loop config (1540: with no
+ *     hBoost kept on, VSET_CFG 0xf068 bit 0 FORCE_VREG_RDY = 0), SPMI_PLAY 0xf04c =
+ *     PLAY_EN 0x80 | src DIRECT_PLAY 1, then haptics_boost_vreg_enable (1366): SDAM 0x42 = 1 (on),
+ *     SDAM 0xe5 = 1 (PBS trigger)
+ *   haptics_enable_play(false): SPMI_PLAY = src only (PLAY_EN 0); 2 s later SDAM 0x42 = 2 (off),
+ *     0xe5 = 1 (hbst_off_timer, 6054)
+ *   module enable: HAP_CFG EN_CTL 0xf046 bit 7 (2008; Linux probe does not write it, resume does)
+ *   T_LRA open loop: 0xf05c/0xf05d = period / 5 us (2853), x 1024/1000 when CAL_EN 0xf072 bits 3:2 = 1
+ * This file does that sequence with no brake and no FIFO.
+ *
+ * Boot-args:
+ *   negronihap=0  (default) nothing: no PMIC access, negroni_haptic_play() returns -1
+ *   negronihap=1  census + owner log + a 300 ms buzz at boot (the proof), API on
+ *   negronihap=2  census + owner log, API on, no boot buzz
+ *   negronihap_force=1  write also when the owner table gives the haptics APIDs to another EE
+ *   negronihap_mv=N     drive VMAX in mV (default 1680 = DT qcom,vmax-mv, capped at 3600)
+ *   negronihap_pbs=0    never write the hap_cfg SDAM (no hBoost PBS trigger); default 1 when EE 0 owns it
+ * Reads use the shared arbiter mapping (negroni_spmi_arbiter, patch 0270) and sk_read8. Writes
+ * use our own channel windows (4 maps of 0x1000; each map takes one 16 KiB kernel page of io_submap,
+ * 64 KiB in total; made once, never unmapped).
+ * An APID that is not owned by EE 0 reads 0xff and refuses writes [I: battery census, 0272]:
+ * the owners are logged first.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/thread_call.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "negroni_spmi_keys.h"
+#include "negroni_spmi.h"
+#include "negroni_haptic.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern kern_return_t thread_terminate(thread_t);
+void negroni_haptic_init(void);
+void negroni_haptic_ui_init(uint32_t hap_mode);  /* negroni_haptic_ui.c, patch 0302 */
+
+#define NH_CHNLS_PA       0x0c500000u     /* arbiter v7 read/write channels, 0x1000 per APID */
+#define NH_CHNL_STRIDE    0x1000u
+#define NH_CMD            0x00u
+#define NH_STATUS         0x08u
+#define NH_WDATA0         0x10u
+#define NH_DONE           (1u << 0)
+#define NH_ERRORS         0x0eu
+#define NH_WRITE_POLLS    2000u           /* x 1 us */
+
+/* SID 3 PM8350B */
+#define NH_SID            3u
+#define NH_CFG            0xf000u
+#define NH_PTN            0xf100u
+#define NH_HBST           0xf200u
+#define CFG_REVISION2     0x01u
+#define CFG_FAULT_STATUS  0x0cu
+#define CFG_INT_RT_STS    0x10u
+#define CFG_EN_CTL        0x46u           /* bit 7 HAPTICS_EN */
+#define CFG_VMAX          0x48u           /* mV / 50 */
+#define CFG_DRV_WF_SEL    0x49u
+#define CFG_SPMI_PLAY     0x4cu           /* bit 7 PLAY_EN, bit 3 BRAKE_EN, bits 2:0 source */
+#define CFG_BRAKE_MODE    0x50u
+#define CFG_TLRA_OL_HIGH  0x5cu
+#define CFG_TLRA_OL_LOW   0x5du
+#define CFG_AUTORES_CFG   0x63u           /* bit 7 AUTORES_EN */
+#define CFG_FAULT_CLR     0x66u
+#define CFG_VSET_CFG      0x68u           /* bit 0 FORCE_VREG_RDY */
+#define CFG_CAL_EN        0x72u           /* bits 3:2 RC clock calibration, 1 = auto */
+#define PTN_REVISION2     0x01u
+#define PTN_DIRECT_PLAY   0x26u
+#define PTN_BRAKE_AMP     0x70u           /* 8 brake samples (patch 0303) */
+#define BRAKE_EN          0x08u           /* SPMI_PLAY bit 3 */
+#define HBST_STATUS4_BUSY 0x01u           /* BOOST_DTEST1_STATUS */
+#define HBST_FOLLOW_HW_EN 0x80u
+#define HBST_VREG_EN_BIT  0x80u
+#define HBST_REVISION1    0x00u
+#define HBST_REVISION2    0x01u
+#define HBST_STATUS4      0x0bu
+#define HBST_HW_FOLLOW    0x41u
+#define HBST_VREG_EN      0x46u
+#define SRC_DIRECT_PLAY   0x01u
+#define PLAY_EN           0x80u
+/* SID 0 PMK8350 hap_cfg SDAM */
+#define NH_SDAM_SID       0u
+#define NH_SDAM           0x9d00u
+#define SDAM_PBS_ARG      0x42u           /* 1 hBoost on, 2 off */
+#define SDAM_PBS_TRIG     0xe5u           /* 1 = trigger */
+
+#define NH_DT_VMAX_MV     1680u           /* qcom,vmax-mv = <0x690> */
+#define NH_MAX_VMAX_MV    3600u           /* below the OnePlus factory AT test value 3700 */
+#define NH_DT_TLRA_US     5882u           /* qcom,lra-period-us = <0x16fa> */
+#define NH_MAX_MS         10000u
+#define NH_HBST_OFF_MS    2000u           /* Linux BOOST_VREG_OFF_DELAY_SECONDS */
+
+enum { NH_P_CFG, NH_P_PTN, NH_P_HBST, NH_P_SDAM, NH_P_N };
+static const uint16_t nh_ppid[NH_P_N] = { 0x3f0, 0x3f1, 0x3f2, 0x09d };
+static const char *const nh_pname[NH_P_N] = { "HAP_CFG 0xf000", "HAP_PTN 0xf100", "HAP_BOOST 0xf200", "SDAM 0x9d00 (SID 0)" };
+
+static LCK_GRP_DECLARE(nh_grp, "negroni_haptic");
+static LCK_MTX_DECLARE(nh_lock, &nh_grp);
+static struct sk_arbiter nh_arb;
+static vm_offset_t nh_cnfg;
+static int nh_apid[NH_P_N] = { -1, -1, -1, -1 };
+static unsigned nh_owner[NH_P_N] = { 7, 7, 7, 7 };
+static vm_offset_t nh_chn[NH_P_N];
+static bool nh_dead[NH_P_N];
+static bool nh_ready, nh_pbs, nh_playing, nh_hbst_on;
+static uint32_t nh_mode, nh_force, nh_vmax_mv = NH_DT_VMAX_MV, nh_pbs_arg = 1;
+/*
+ * Patch 0303 (docs/audit/2026-10-26-peripherals.md part B): the closed-loop brake of the DT
+ * (qcom,brake-mode 1 = CL_BRAKE, qcom,brake-pattern [ff 3f 1f], qcom,brake-sig-shape 1 = sine,
+ * brake-sine-gain default X1 = 0: live.dts:13110-13113), written as Linux haptics_hw_init (2904)
+ * and haptics_set_brake (1651) do; BRAKE_EN in SPMI_PLAY on play and stop (1622). negronihap_brake=0
+ * leaves it out (the 0300 behaviour).
+ */
+static uint32_t nh_brake_arg = 1;
+static uint8_t nh_brake_en;               /* BRAKE_EN when the brake was written, else 0 */
+static const uint8_t nh_brake_samples[8] = { 0xff, 0x3f, 0x1f, 0, 0, 0, 0, 0 };
+static uint32_t nh_hbst_waits, nh_hbst_timeouts;
+static uint64_t nh_play_gen;      /* bumped by each play: a stale stop call does nothing */
+static uint32_t nh_plays, nh_refused;
+static thread_call_t nh_stop_call, nh_hbst_call;
+
+static uint32_t
+nh_rd32(vm_offset_t base, unsigned off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+nh_wr32(vm_offset_t base, unsigned off, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* As Linux picks an APID: the first mapping, replaced by one this EE (0) owns. */
+static int
+nh_find_apid(unsigned ppid, unsigned *owner)
+{
+	uint32_t n = nh_arb.core[SK_FEATURES / 4u] & SK_FEATURES_APIDS_MASK;
+	int found = -1;
+	unsigned fo = 7;
+	for (uint32_t i = 0; i < n && i < 1024u; ++i) {
+		uint32_t map = nh_arb.core[(SK_APID_MAP + 4u * i) / 4u];
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		unsigned o = nh_rd32(nh_cnfg, 4u * i) & 7u;
+		if (found < 0 || o == 0) {
+			found = (int)i;
+			fo = o;
+		}
+	}
+	*owner = fo;
+	return found;
+}
+
+static int
+nh_part(unsigned sid, unsigned addr)
+{
+	unsigned ppid = (sid << 8) | (addr >> 8);
+	for (int p = 0; p < NH_P_N; ++p) {
+		if (nh_ppid[p] == ppid) {
+			return p;
+		}
+	}
+	return -1;
+}
+
+/* nh_lock held. 0 ok, -1 failed (*v = 0xee). */
+static int
+nh_read(unsigned sid, unsigned addr, uint8_t *v)
+{
+	int p = nh_part(sid, addr);
+	*v = 0xee;
+	if (p < 0 || nh_apid[p] < 0 || nh_dead[p]) {
+		return -1;
+	}
+	int rc = sk_read8(&nh_arb, nh_apid[p], (uint8_t)(addr & 0xffu), v);
+	if (rc == 1) {
+		nh_dead[p] = true;
+		printf("NEGRONI HAPTIC: read timeout sid %u %#x (APID %d): not used again\n", sid, addr, nh_apid[p]);
+	}
+	return rc ? -1 : 0;
+}
+
+/* nh_lock held. 0 ok, -1 refused/failed. */
+static int
+nh_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	int p = nh_part(sid, addr);
+	if (p < 0 || !nh_chn[p] || nh_dead[p]) {
+		return -1;
+	}
+	vm_offset_t chn = nh_chn[p];
+	nh_wr32(chn, NH_WDATA0, value);
+	nh_wr32(chn, NH_CMD, (0u << 27) | ((addr & 0xffu) << 4));     /* WRITEL, 1 byte */
+	for (unsigned i = 0; i < NH_WRITE_POLLS; ++i) {
+		uint32_t s = nh_rd32(chn, NH_STATUS);
+		if (s & NH_DONE) {
+			if (s & NH_ERRORS) {
+				if (nh_refused++ < 16) {      /* bounded: negronihap_force=1 can refuse every write */
+					printf("NEGRONI HAPTIC: write sid %u %#x = %#x refused (status %#x)%s\n", sid, addr, value, s,
+					    nh_refused == 16 ? " (no more refusal lines)" : "");
+				}
+				return -1;
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	nh_dead[p] = true;
+	printf("NEGRONI HAPTIC: write timeout sid %u %#x (APID %d): not used again\n", sid, addr, nh_apid[p]);
+	return -1;
+}
+
+static int
+nh_update(unsigned sid, unsigned addr, uint8_t mask, uint8_t bits)
+{
+	uint8_t v;
+	if (nh_read(sid, addr, &v)) {
+		return -1;
+	}
+	return nh_write(sid, addr, (uint8_t)((v & ~mask) | (bits & mask)));
+}
+
+static void
+nh_hbst(bool on)
+{
+	if (!nh_pbs || nh_hbst_on == on) {
+		return;
+	}
+	if (nh_write(NH_SDAM_SID, NH_SDAM + SDAM_PBS_ARG, on ? 1 : 2) == 0 &&
+	    nh_write(NH_SDAM_SID, NH_SDAM + SDAM_PBS_TRIG, 1) == 0) {
+		nh_hbst_on = on;
+	}
+}
+
+static void
+nh_log_state(const char *when)
+{
+	uint8_t en, vmax, play, vset, fault, rt, dp, vreg, st4, follow, ar;
+	nh_read(NH_SID, NH_CFG + CFG_EN_CTL, &en);
+	nh_read(NH_SID, NH_CFG + CFG_VMAX, &vmax);
+	nh_read(NH_SID, NH_CFG + CFG_SPMI_PLAY, &play);
+	nh_read(NH_SID, NH_CFG + CFG_VSET_CFG, &vset);
+	nh_read(NH_SID, NH_CFG + CFG_FAULT_STATUS, &fault);
+	nh_read(NH_SID, NH_CFG + CFG_INT_RT_STS, &rt);
+	nh_read(NH_SID, NH_CFG + CFG_AUTORES_CFG, &ar);
+	nh_read(NH_SID, NH_PTN + PTN_DIRECT_PLAY, &dp);
+	nh_read(NH_SID, NH_HBST + HBST_VREG_EN, &vreg);
+	nh_read(NH_SID, NH_HBST + HBST_STATUS4, &st4);
+	nh_read(NH_SID, NH_HBST + HBST_HW_FOLLOW, &follow);
+	printf("NEGRONI HAPTIC: %s: EN_CTL %#04x VMAX %#04x SPMI_PLAY %#04x VSET %#04x AUTORES %#04x "
+	    "FAULT %#04x RT_STS %#04x DIRECT_PLAY %#04x | HBST VREG_EN %#04x STATUS4 %#04x HW_FOLLOW %#04x\n",
+	    when, en, vmax, play, vset, ar, fault, rt, dp, vreg, st4, follow);
+}
+
+/* Thread context, once. nh_lock held. */
+static bool
+nh_setup(void)
+{
+	if (negroni_spmi_arbiter(&nh_arb, &nh_cnfg) != 0 || !nh_arb.core || !nh_arb.obs || !nh_cnfg) {
+		printf("NEGRONI HAPTIC: no SPMI arbiter mapping\n");
+		return false;
+	}
+	uint32_t ver = nh_arb.core[0];
+	if (ver < SK_VERSION_V7_MIN || ver >= SK_VERSION_V8_MIN) {
+		printf("NEGRONI HAPTIC: SPMI arbiter %#x is not v7\n", ver);
+		return false;
+	}
+	bool owned = true;
+	for (int p = 0; p < NH_P_N; ++p) {
+		nh_apid[p] = nh_find_apid(nh_ppid[p], &nh_owner[p]);
+		printf("NEGRONI HAPTIC: %s PPID %#05x: APID %d, owner EE %u\n", nh_pname[p], nh_ppid[p], nh_apid[p], nh_owner[p]);
+		if (p != NH_P_SDAM && (nh_apid[p] < 0 || nh_owner[p] != 0)) {
+			owned = false;
+		}
+	}
+	uint8_t c1, c2, ct, cs, p2, b1, b2, cal, th, tl, wf, bm;
+	nh_read(NH_SID, NH_CFG + CFG_REVISION2, &c2);
+	nh_read(NH_SID, NH_CFG + 0x00, &c1);
+	nh_read(NH_SID, NH_CFG + 0x04, &ct);
+	nh_read(NH_SID, NH_CFG + 0x05, &cs);
+	nh_read(NH_SID, NH_PTN + PTN_REVISION2, &p2);
+	nh_read(NH_SID, NH_HBST + HBST_REVISION1, &b1);
+	nh_read(NH_SID, NH_HBST + HBST_REVISION2, &b2);
+	nh_read(NH_SID, NH_CFG + CFG_CAL_EN, &cal);
+	nh_read(NH_SID, NH_CFG + CFG_TLRA_OL_HIGH, &th);
+	nh_read(NH_SID, NH_CFG + CFG_TLRA_OL_LOW, &tl);
+	nh_read(NH_SID, NH_CFG + CFG_DRV_WF_SEL, &wf);
+	nh_read(NH_SID, NH_CFG + CFG_BRAKE_MODE, &bm);
+	printf("NEGRONI HAPTIC: HAP_CFG rev %#04x/%#04x type %#04x subtype %#04x, HAP_PTN rev2 %#04x, "
+	    "HAP_BOOST rev %#04x/%#04x; CAL_EN %#04x T_LRA_OL %#x (%u us) DRV_WF %#04x BRAKE %#04x\n",
+	    c1, c2, ct, cs, p2, b1, b2, cal, ((th & 0xfu) << 8) | tl, (((th & 0xfu) << 8) | tl) * 5u, wf, bm);
+	if (!owned && !nh_force) {
+		printf("NEGRONI HAPTIC: the haptics APIDs are not all owned by EE 0: writes stay off "
+		    "(negronihap_force=1 tries anyway)\n");
+		return false;
+	}
+	for (int p = 0; p < NH_P_N; ++p) {
+		if (nh_apid[p] < 0 || (p == NH_P_SDAM && (!nh_pbs_arg || (nh_owner[p] != 0 && !nh_force)))) {
+			continue;
+		}
+		/* one 4 KiB channel window each, kept for the boot (never unmapped: io_submap) */
+		nh_chn[p] = ml_io_map(NH_CHNLS_PA + NH_CHNL_STRIDE * (uint32_t)nh_apid[p], NH_CHNL_STRIDE);
+	}
+	if (!nh_chn[NH_P_CFG] || !nh_chn[NH_P_PTN]) {
+		printf("NEGRONI HAPTIC: channel map failed\n");
+		return false;
+	}
+	nh_pbs = nh_chn[NH_P_SDAM] != 0;
+	printf("NEGRONI HAPTIC: hBoost PBS trigger via SDAM %s\n", nh_pbs ? "on" : "off (not owned, or negronihap_pbs=0)");
+
+	/* T_LRA open loop: program the DT period only when the register is unset (0). */
+	if ((((th & 0xfu) << 8) | tl) == 0) {
+		uint32_t us = NH_DT_TLRA_US;
+		if (((cal >> 2) & 3u) == 1u) {
+			us = us * 1024u / 1000u;
+		}
+		uint32_t t = us / 5u;
+		nh_write(NH_SID, NH_CFG + CFG_TLRA_OL_HIGH, (uint8_t)((t >> 8) & 0xfu));
+		nh_write(NH_SID, NH_CFG + CFG_TLRA_OL_LOW, (uint8_t)(t & 0xffu));
+		printf("NEGRONI HAPTIC: T_LRA_OL was 0: set %#x (%u us)\n", t, NH_DT_TLRA_US);
+	}
+	/* drive waveform: sine (qcom,drv-sig-shape = 1), bits 1:0 of DRV_WF_SEL */
+	nh_update(NH_SID, NH_CFG + CFG_DRV_WF_SEL, 0x03, 0x01);
+	/* patch 0303: closed-loop brake: BRAKE_MODE_CFG mode 1 <<6 | sine gain X1 (0) <<2 | sine wf 1 */
+	if (nh_brake_arg) {
+		int brc = nh_update(NH_SID, NH_CFG + CFG_BRAKE_MODE, 0xcf, (uint8_t)((1u << 6) | (0u << 2) | 1u));
+		for (unsigned i = 0; i < sizeof(nh_brake_samples) && brc == 0; i++) {
+			brc = nh_write(NH_SID, NH_PTN + PTN_BRAKE_AMP + i, nh_brake_samples[i]);
+		}
+		nh_brake_en = brc == 0 ? BRAKE_EN : 0;
+		printf("NEGRONI HAPTIC: closed-loop brake (pattern ff 3f 1f): %s\n", brc == 0 ? "on" : "write failed, off");
+	}
+	nh_log_state("init");
+	return true;
+}
+
+/* nh_lock held */
+static void
+nh_stop_locked(void)
+{
+	if (!nh_playing) {
+		return;
+	}
+	nh_write(NH_SID, NH_CFG + CFG_SPMI_PLAY, (uint8_t)(nh_brake_en | SRC_DIRECT_PLAY));      /* PLAY_EN 0 (+ brake) */
+	nh_playing = false;
+	if (nh_pbs) {
+		uint64_t deadline;
+		clock_interval_to_deadline(NH_HBST_OFF_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(nh_hbst_call, deadline);
+	}
+}
+
+static void
+nh_stop_fn(thread_call_param_t p0, thread_call_param_t gen)
+{
+	(void)p0;
+	lck_mtx_lock(&nh_lock);
+	if ((uint64_t)(uintptr_t)gen == nh_play_gen) {
+		nh_stop_locked();
+	}
+	lck_mtx_unlock(&nh_lock);
+}
+
+static void
+nh_hbst_fn(thread_call_param_t p0, thread_call_param_t p1)
+{
+	(void)p0; (void)p1;
+	lck_mtx_lock(&nh_lock);
+	if (!nh_playing) {
+		nh_hbst(false);
+	}
+	lck_mtx_unlock(&nh_lock);
+}
+
+int
+negroni_haptic_play(uint32_t ms, uint32_t strength)
+{
+	if (!nh_ready || ml_at_interrupt_context()) {
+		return -1;
+	}
+	if (ms > NH_MAX_MS) {
+		ms = NH_MAX_MS;
+	}
+	if (strength > 255) {
+		strength = 255;
+	}
+	lck_mtx_lock(&nh_lock);
+	if (ms == 0 || strength == 0) {
+		nh_play_gen++;
+		nh_stop_locked();
+		lck_mtx_unlock(&nh_lock);
+		return 0;
+	}
+	int rc = 0;
+	thread_call_cancel(nh_hbst_call);
+	if (!nh_playing && !nh_hbst_on) {
+		/*
+		 * patch 0303: Linux haptics_wait_hboost_ready (1436-1490): with hBoost not kept on, wait
+		 * up to 100 x 200 us while it is busy (VREG_EN set, or STATUS4 bit 0 set); ready at once
+		 * in open loop (HW_FOLLOW bit 7 clear and VREG_EN set). Linux goes on after the timeout.
+		 */
+		unsigned i;
+		for (i = 0; i < 100u; i++) {
+			uint8_t fol, vreg, st4;
+			if (nh_read(NH_SID, NH_HBST + HBST_HW_FOLLOW, &fol) == 0 && !(fol & HBST_FOLLOW_HW_EN) &&
+			    nh_read(NH_SID, NH_HBST + HBST_VREG_EN, &vreg) == 0 && (vreg & HBST_VREG_EN_BIT)) {
+				break;          /* open loop: always ready */
+			}
+			if (nh_read(NH_SID, NH_HBST + HBST_VREG_EN, &vreg) == 0 && !(vreg & HBST_VREG_EN_BIT) &&
+			    nh_read(NH_SID, NH_HBST + HBST_STATUS4, &st4) == 0 && !(st4 & HBST_STATUS4_BUSY)) {
+				break;          /* standby: ready */
+			}
+			delay(200);
+		}
+		if (i > 0) {
+			nh_hbst_waits++;
+		}
+		if (i == 100u && nh_hbst_timeouts++ < 4) {
+			printf("NEGRONI HAPTIC: hBoost not ready after 20 ms: plays anyway (as Linux)\n");
+		}
+	}
+	if (!nh_playing) {
+		uint8_t en;
+		if (nh_read(NH_SID, NH_CFG + CFG_EN_CTL, &en) == 0 && !(en & 0x80)) {
+			rc |= nh_write(NH_SID, NH_CFG + CFG_EN_CTL, 0x80);       /* module enable */
+		}
+		rc |= nh_write(NH_SID, NH_CFG + CFG_VMAX, (uint8_t)(nh_vmax_mv / 50u));
+		rc |= nh_write(NH_SID, NH_PTN + PTN_DIRECT_PLAY, (uint8_t)strength);
+		rc |= nh_update(NH_SID, NH_CFG + CFG_AUTORES_CFG, 0x80, 0x00);  /* OPLUS: no auto-resonance */
+		rc |= nh_write(NH_SID, NH_CFG + CFG_FAULT_CLR, 0x07);
+		/* open-loop drive config (Linux 1540): FORCE_VREG_RDY only while hBoost is kept on */
+		rc |= nh_update(NH_SID, NH_CFG + CFG_VSET_CFG, 0x01, nh_hbst_on ? 0x01 : 0x00);
+		if (nh_hbst_on) {
+			/*
+			 * patch 0302: Linux 1555-1575 toggles the RC clock calibration (CAL_EN bits 3:2,
+			 * auto 1 -> disabled 0 -> auto 1) when it forces VREG_RDY. UI haptics play many
+			 * short taps within the 2 s hBoost hold, so this path is now the common one.
+			 */
+			uint8_t cal;
+			if (nh_read(NH_SID, NH_CFG + CFG_CAL_EN, &cal) == 0 && ((cal >> 2) & 3u) == 1u) {
+				rc |= nh_write(NH_SID, NH_CFG + CFG_CAL_EN, (uint8_t)(cal & ~0x0cu));
+				rc |= nh_write(NH_SID, NH_CFG + CFG_CAL_EN, cal);
+			}
+		}
+		/*
+		 * PLAY_EN only when the whole setup chain succeeded; nh_playing follows the SPMI_PLAY
+		 * write alone, so the stop timer is armed whenever PLAY_EN may be set.
+		 */
+		if (rc == 0) {
+			if (nh_write(NH_SID, NH_CFG + CFG_SPMI_PLAY, (uint8_t)(PLAY_EN | nh_brake_en | SRC_DIRECT_PLAY)) == 0) {
+				nh_playing = true;
+				nh_hbst(true);
+			} else {
+				rc = -1;
+				(void)nh_write(NH_SID, NH_CFG + CFG_SPMI_PLAY, SRC_DIRECT_PLAY);  /* make sure PLAY_EN is 0 */
+			}
+		}
+	} else {
+		rc |= nh_write(NH_SID, NH_PTN + PTN_DIRECT_PLAY, (uint8_t)strength);
+	}
+	uint64_t gen = ++nh_play_gen;
+	if (nh_playing) {
+		uint64_t deadline;
+		clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+		thread_call_enter1_delayed(nh_stop_call, (thread_call_param_t)(uintptr_t)gen, deadline);
+	}
+	if (nh_plays++ < 8) {
+		printf("NEGRONI HAPTIC: play %u ms strength %u: rc %d (hBoost waits %u)\n", ms, strength, rc, nh_hbst_waits);
+	}
+	lck_mtx_unlock(&nh_lock);
+	return rc ? -1 : 0;
+}
+
+bool
+negroni_haptic_ready(void)
+{
+	return nh_ready;
+}
+
+static void
+nh_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline((event_t)&nh_plays, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+nh_thread(void *arg, wait_result_t wr)
+{
+	(void)arg; (void)wr;
+	lck_mtx_lock(&nh_lock);
+	bool ok = nh_setup();
+	lck_mtx_unlock(&nh_lock);
+	nh_ready = ok;
+	printf("NEGRONI HAPTIC: %s (negronihap=%u, vmax %u mV)\n", ok ? "ready" : "not available", nh_mode, nh_vmax_mv);
+	if (ok && nh_mode == 1) {
+		printf("NEGRONI HAPTIC: proof: 300 ms direct-play buzz, strength 255\n");
+		negroni_haptic_play(300, 255);
+		nh_sleep_ms(100);
+		lck_mtx_lock(&nh_lock);
+		nh_log_state("playing +100 ms");
+		lck_mtx_unlock(&nh_lock);
+		nh_sleep_ms(400);
+		lck_mtx_lock(&nh_lock);
+		nh_log_state("stopped +500 ms");
+		lck_mtx_unlock(&nh_lock);
+		nh_sleep_ms(2200);
+		lck_mtx_lock(&nh_lock);
+		nh_log_state("hBoost off +2.7 s");
+		lck_mtx_unlock(&nh_lock);
+	}
+	(void)thread_terminate(current_thread());
+}
+
+void
+negroni_haptic_init(void)
+{
+	thread_t thread;
+	(void)PE_parse_boot_argn("negronihap", &nh_mode, sizeof(nh_mode));
+	if (nh_mode == 0) {
+		return;
+	}
+	(void)PE_parse_boot_argn("negronihap_force", &nh_force, sizeof(nh_force));
+	(void)PE_parse_boot_argn("negronihap_pbs", &nh_pbs_arg, sizeof(nh_pbs_arg));
+	(void)PE_parse_boot_argn("negronihap_mv", &nh_vmax_mv, sizeof(nh_vmax_mv));
+	(void)PE_parse_boot_argn("negronihap_brake", &nh_brake_arg, sizeof(nh_brake_arg));
+	if (nh_vmax_mv < 500u || nh_vmax_mv > NH_MAX_VMAX_MV) {
+		nh_vmax_mv = NH_DT_VMAX_MV;
+	}
+	nh_stop_call = thread_call_allocate_with_options(nh_stop_fn, NULL, THREAD_CALL_PRIORITY_KERNEL, 0);
+	nh_hbst_call = thread_call_allocate_with_options(nh_hbst_fn, NULL, THREAD_CALL_PRIORITY_LOW, 0);
+	if (kernel_thread_start(nh_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	negroni_haptic_ui_init(nh_mode);        /* patch 0302: negronihap_ui=1, /dev/negroni-haptic */
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_haptic.h b/bsd/dev/negroni_haptic.h
new file mode 100644
index 0000000..dd6c8da
--- /dev/null
+++ b/bsd/dev/negroni_haptic.h
@@ -0,0 +1,21 @@
+/* Vibration motor API (bsd/dev/negroni_haptic.c, patch 0300). C and C++. */
+#ifndef NEGRONI_HAPTIC_H
+#define NEGRONI_HAPTIC_H
+#include <stdint.h>
+#include <stdbool.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/*
+ * Starts (or extends) a direct-play buzz: ms 1..10000, strength 0..255 (the DIRECT_PLAY
+ * amplitude); ms 0 or strength 0 stops. Returns at once: a thread call stops the motor after
+ * ms. Thread context only (it takes a mutex). 0 ok, -1 not available (negronihap=0, the
+ * haptics APIDs are not owned by EE 0, or an SPMI write failed).
+ */
+int negroni_haptic_play(uint32_t ms, uint32_t strength);
+/* True after the boot-time setup succeeded (negronihap=1 or 2). */
+bool negroni_haptic_ready(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/negroni_haptic_ui.c b/bsd/dev/negroni_haptic_ui.c
new file mode 100644
index 0000000..3e17866
--- /dev/null
+++ b/bsd/dev/negroni_haptic_ui.c
@@ -0,0 +1,321 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450): iOS UI haptics on the PM8350B LRA (patch 0302).
+ *
+ * Why [V 20H392 shared cache, unslid addresses; docs/haptics-plan.md section 8]:
+ *   UIKit -[UIDevice _feedbackSupportLevel] block 0x189255318: level 2 when
+ *   +[CHHapticEngine supports1stPartyHaptics] (0x1af54fd4c) -> +[AVHapticPlayer supportsHaptics]
+ *   (0x1af58e924) -> PlatformUtilities_iOS::ProductSupportsClosedLoopHaptics (0x1af56cbb0) =
+ *   MGGetBoolAnswer("gqDnklGQnpv5ilgh5uHckw" = DeviceSupportsClosedLoopHaptics). libMobileGestalt
+ *   answers that key (handler 0x19c564a9c) from "IODeviceTree:/product/haptics" property
+ *   "closed-loop". Impact/selection/notification feedback (keyboard taps) needs level 2
+ *   (-[_UIImpactFeedbackGeneratorConfiguration requiredSupportLevel] 0x1890dd1e4 returns 2).
+ *   Level 2 plays through CoreHaptics -> mediaserverd AVHapticServer ("com.apple.audio.hapticd")
+ *   -> the HAL device VirtualAudioDevice_Actuator (VirtualAudio.plugin) -> the physical HAL
+ *   device "Actuator" (NegroniAudio.driver). With closed-loop, FigVibrator also takes the unified
+ *   haptic engine (VibeSynthEngineHasHardwareSupport, haptics-plan section 4): ringtone and
+ *   alert vibration go the same way.
+ *
+ * So with negronihap_ui=1 (needs negronihap=1|2, patch 0300):
+ *   1. NegroniVibrator.cpp (0301 + this patch) adds IODeviceTree:/product/haptics with
+ *      closed-loop = 1 and supports-3rd-party-haptics = 1, the values of the D22 ADT.
+ *   2. This file makes /dev/negroni-haptic. NegroniAudio.driver writes there what iOS plays on
+ *      its "Actuator" output: S16LE mono, NH_UI_RATE frames/s (userland/audio/negroni_haptic.h,
+ *      the same numbers). write() never blocks and never fails on data.
+ *   3. A kernel thread turns the samples into the direct-play amplitude of patch 0300: the
+ *      peak of each NH_UI_BLOCK_MS block, held over NH_UI_WINDOW blocks (one LRA period: a sine
+ *      at the Taptic resonance crosses zero inside a block), mapped to a strength
+ *      (floor .. 255, HackiOS gain_for(): proportional strengths were not felt), played in real
+ *      time from the moment the samples arrive. An onset plays at least negronihap_tapms
+ *      (default 20 ms, about 3 LRA periods at 170 Hz). A continuous play stops after
+ *      NH_UI_MAX_MS and rests NH_UI_REST_MS.
+ *   Model: HackiOS bsd/dev/redwood_haptic.c (external/hackios-xnu-kernel, MIT, Copyright (c)
+ *   2026 OOSEX GANG): /dev/redwood-haptic fed by the same HAL "Actuator" device; there a tap
+ *   peak was 1000..33000 of 32768 and a vibration about 17000 [V their source comment].
+ *   Not FIFO mode: direct play only (docs/haptics-plan.md section 8, "Why not FIFO").
+ *
+ * Boot-args (all need negronihap >= 1):
+ *   negronihap_ui=1        this path (default 0: no /dev node, no DT node)
+ *   negronihap_tapms=N     shortest play of an onset, 5..200 ms (default 20)
+ *   negronihap_uifloor=N   strength of the softest audible sample, 1..255 (default 160)
+ *   negronihap_uilog=N     log the first N plays (default 24)
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/errno.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "negroni_haptic.h"
+
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+
+/* userland/audio/negroni_haptic.h has the same numbers */
+#define NH_UI_RATE        48000u          /* frames/s, S16LE mono */
+#define NH_UI_NODE        "negroni-haptic"
+
+#define NH_UI_BLOCK_MS    2u
+#define NH_UI_BLOCK       (NH_UI_RATE / 1000u * NH_UI_BLOCK_MS)  /* 96 frames */
+#define NH_UI_WINDOW      4u              /* blocks: 8 ms, more than one 170-230 Hz period */
+#define NH_UI_QUEUE       256u            /* blocks (512 ms), power of two */
+#define NH_UI_LAG         48u             /* blocks: more queued than 96 ms and the oldest go */
+#define NH_UI_STARVE      6u              /* blocks with no data while playing (12 ms) count as silence */
+#define NH_UI_SILENT      256u            /* of 32768: smaller peaks are silence (HackiOS SILENT_BELOW) */
+#define NH_UI_FULL        (32767u / 3u)   /* from a third of full scale up: strength 255 */
+#define NH_UI_REFRESH_MS  16u             /* a play is renewed at least this often ... */
+#define NH_UI_GUARD_MS    40u             /* ... for this long: a stalled thread stops the motor */
+#define NH_UI_MAX_MS      5000u           /* a continuous play is cut here ... */
+#define NH_UI_REST_MS     1000u           /* ... and the motor rests this long */
+#define NH_UI_STEP_DELTA  8u              /* a smaller strength change is not written */
+_Static_assert((NH_UI_QUEUE & (NH_UI_QUEUE - 1u)) == 0, "queue size must be a power of two");
+
+static LCK_GRP_DECLARE(nhu_grp, "negroni_haptic_ui");
+static LCK_MTX_DECLARE(nhu_lock, &nhu_grp);
+static uint16_t nhu_q[NH_UI_QUEUE];       /* block peaks; nhu_lock */
+static uint32_t nhu_head, nhu_tail;       /* nhu_lock; both only grow */
+static uint32_t nhu_part_frames, nhu_part_peak;   /* the block being filled; nhu_lock */
+static uint64_t nhu_frames_in, nhu_blocks_dropped, nhu_writes;
+static uint32_t nhu_tap_ms = 20, nhu_floor = 160, nhu_log = 24;
+static int nhu_major = -1;
+static bool nhu_on;
+
+static void
+nhu_push_locked(uint32_t peak)
+{
+	if (nhu_head - nhu_tail >= NH_UI_LAG) {
+		nhu_tail = nhu_head - (NH_UI_LAG - 1u);   /* keep the newest: latency stays bounded */
+		nhu_blocks_dropped++;
+	}
+	nhu_q[nhu_head % NH_UI_QUEUE] = (uint16_t)(peak > 32768u ? 32768u : peak);
+	nhu_head++;
+}
+
+/* The writer is NegroniAudio.driver's haptic thread (not the HAL I/O thread): a mutex is fine. */
+static int
+nhu_write(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	int16_t s[256];
+	int error = 0;
+	bool loud = false;
+
+	while (uio_resid(uio) >= 2) {
+		user_ssize_t n = uio_resid(uio);
+		if (n > (user_ssize_t)sizeof(s)) {
+			n = sizeof(s);
+		}
+		n &= ~(user_ssize_t)1;
+		if ((error = uiomove((caddr_t)s, (int)n, uio)) != 0) {
+			break;
+		}
+		lck_mtx_lock(&nhu_lock);
+		for (unsigned i = 0; i < (unsigned)n / 2u; i++) {
+			uint32_t v = s[i] < 0 ? (uint32_t)(-(int32_t)s[i]) : (uint32_t)s[i];
+			if (v > nhu_part_peak) {
+				nhu_part_peak = v;
+			}
+			if (++nhu_part_frames == NH_UI_BLOCK) {
+				loud |= nhu_part_peak > NH_UI_SILENT;
+				nhu_push_locked(nhu_part_peak);
+				nhu_part_frames = 0;
+				nhu_part_peak = 0;
+			}
+		}
+		nhu_frames_in += (uint64_t)n / 2u;
+		lck_mtx_unlock(&nhu_lock);
+	}
+	nhu_writes++;
+	if (loud) {
+		thread_wakeup((event_t)&nhu_head);
+	}
+	return error;
+}
+
+static int
+nhu_open(__unused dev_t dev, __unused int flags, __unused int type, __unused struct proc *p)
+{
+	return 0;
+}
+
+static const struct cdevsw nhu_cdevsw = {
+	.d_open = nhu_open,
+	.d_close = nhu_open,
+	.d_read = eno_rdwrt,
+	.d_write = nhu_write,
+	.d_ioctl = eno_ioctl,
+	.d_stop = eno_stop,
+	.d_reset = eno_reset,
+	.d_ttys = NULL,
+	.d_select = eno_select,
+	.d_mmap = eno_mmap,
+	.d_strategy = eno_strat,
+	.d_type = 0,
+};
+
+/* HackiOS gain_for(), on the 0..255 direct-play scale: the floor for the softest, 255 from a third up */
+static uint32_t
+nhu_strength(uint32_t peak)
+{
+	if (peak <= NH_UI_SILENT) {
+		return 0;
+	}
+	if (peak >= NH_UI_FULL) {
+		return 255;
+	}
+	return nhu_floor + (255u - nhu_floor) * (peak - NH_UI_SILENT) / (NH_UI_FULL - NH_UI_SILENT);
+}
+
+static uint64_t
+nhu_ms_to_abs(uint32_t ms)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &t);
+	return t;
+}
+
+__attribute__((noreturn)) static void
+nhu_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	const uint64_t step = nhu_ms_to_abs(NH_UI_BLOCK_MS);
+	uint16_t win[NH_UI_WINDOW] = { 0 };
+	unsigned wi = 0, starve = 0;
+	bool playing = false;
+	uint32_t strength = 0, written = 0, peak_max = 0, plays = 0;
+	uint64_t next = 0, onset = 0, refreshed = 0, rest_until = 0;
+
+	printf("NEGRONI HAPTIC UI: /dev/%s ready: S16LE mono %u Hz, %u ms blocks, tap >= %u ms, floor %u, "
+	    "cut at %u ms\n", NH_UI_NODE, NH_UI_RATE, NH_UI_BLOCK_MS, nhu_tap_ms, nhu_floor, NH_UI_MAX_MS);
+	for (;;) {
+		uint32_t peak = 0;
+		bool have = false;
+
+		lck_mtx_lock(&nhu_lock);
+		if (nhu_head != nhu_tail) {
+			peak = nhu_q[nhu_tail % NH_UI_QUEUE];
+			nhu_tail++;
+			have = true;
+		}
+		lck_mtx_unlock(&nhu_lock);
+
+		uint64_t now = mach_absolute_time();
+		if (!playing && !have) {
+			/* idle: sleep until a write brings a block that is not silence */
+			for (unsigned i = 0; i < NH_UI_WINDOW; i++) {
+				win[i] = 0;
+			}
+			starve = 0;
+			assert_wait((event_t)&nhu_head, THREAD_UNINT);
+			lck_mtx_lock(&nhu_lock);
+			bool more = nhu_head != nhu_tail;
+			lck_mtx_unlock(&nhu_lock);
+			if (more) {
+				clear_wait(current_thread(), THREAD_AWAKENED);
+			} else {
+				(void)thread_block(THREAD_CONTINUE_NULL);
+			}
+			next = mach_absolute_time();
+			continue;
+		}
+		if (have) {
+			starve = 0;
+		} else if (++starve <= NH_UI_STARVE) {
+			peak = win[(wi + NH_UI_WINDOW - 1u) % NH_UI_WINDOW];      /* a late write: hold */
+		}
+		win[wi] = (uint16_t)peak;
+		wi = (wi + 1u) % NH_UI_WINDOW;
+		uint32_t env = 0;
+		for (unsigned i = 0; i < NH_UI_WINDOW; i++) {
+			env = win[i] > env ? win[i] : env;
+		}
+		uint32_t want = rest_until > now ? 0 : nhu_strength(env);
+
+		if (want && !playing) {
+			playing = true;
+			onset = refreshed = next = now;
+			strength = want;
+			written = want;
+			peak_max = env;
+			(void)negroni_haptic_play(NH_UI_GUARD_MS, want);
+		} else if (playing) {
+			bool tap_held = now - onset < nhu_ms_to_abs(nhu_tap_ms);
+			bool cut = now - onset >= nhu_ms_to_abs(NH_UI_MAX_MS);
+			if (want == 0 && tap_held && !cut) {
+				want = written;         /* the shortest play of an onset */
+			}
+			peak_max = env > peak_max ? env : peak_max;
+			if (want == 0 || cut) {
+				(void)negroni_haptic_play(0, 0);
+				playing = false;
+				plays++;
+				if (cut) {
+					rest_until = now + nhu_ms_to_abs(NH_UI_REST_MS);
+				}
+				if (plays <= nhu_log) {
+					uint64_t ns;
+					absolutetime_to_nanoseconds(now - onset, &ns);
+					printf("NEGRONI HAPTIC UI: play %u: %llu ms, peak %u of 32768, strength %u (last %u)%s; "
+					    "%llu frames in, %llu blocks dropped\n", plays, ns / NSEC_PER_MSEC, peak_max, strength, written,
+					    cut ? " (CUT: rests 1 s)" : "", nhu_frames_in, nhu_blocks_dropped);
+				}
+			} else if (want + NH_UI_STEP_DELTA <= written || want >= written + NH_UI_STEP_DELTA ||
+			    now - refreshed >= nhu_ms_to_abs(NH_UI_REFRESH_MS)) {
+				(void)negroni_haptic_play(NH_UI_GUARD_MS, want);
+				written = want;
+				refreshed = now;
+			}
+		}
+		if (!playing) {
+			continue;               /* silent blocks drain at once; then the idle wait */
+		}
+		/* real time: one block per NH_UI_BLOCK_MS from the last wake, resync after a stall */
+		next += step;
+		if (next + 10u * step < mach_absolute_time()) {
+			next = mach_absolute_time() + step;
+		}
+		assert_wait_deadline((event_t)&nhu_tap_ms, THREAD_UNINT, next);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void negroni_haptic_ui_init(uint32_t hap_mode);
+
+/* From negroni_haptic_init (patch 0300), after its own boot-args; hap_mode = negronihap. */
+void
+negroni_haptic_ui_init(uint32_t hap_mode)
+{
+	uint32_t ui = 0;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("negronihap_ui", &ui, sizeof(ui));
+	if (hap_mode == 0 || ui == 0 || nhu_on) {
+		return;
+	}
+	(void)PE_parse_boot_argn("negronihap_tapms", &nhu_tap_ms, sizeof(nhu_tap_ms));
+	(void)PE_parse_boot_argn("negronihap_uifloor", &nhu_floor, sizeof(nhu_floor));
+	(void)PE_parse_boot_argn("negronihap_uilog", &nhu_log, sizeof(nhu_log));
+	if (nhu_tap_ms < 5u || nhu_tap_ms > 200u) {
+		nhu_tap_ms = 20;
+	}
+	if (nhu_floor < 1u || nhu_floor > 255u) {
+		nhu_floor = 160;
+	}
+	nhu_major = cdevsw_add(-1, &nhu_cdevsw);
+	if (nhu_major < 0) {
+		printf("NEGRONI HAPTIC UI: cdevsw_add failed\n");
+		return;
+	}
+	if (devfs_make_node(makedev(nhu_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, NH_UI_NODE) == NULL) {
+		printf("NEGRONI HAPTIC UI: /dev/%s cannot be made\n", NH_UI_NODE);
+		return;
+	}
+	nhu_on = true;
+	if (kernel_thread_start(nhu_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_keys.c b/bsd/dev/negroni_keys.c
new file mode 100644
index 0000000..b524ff2
--- /dev/null
+++ b/bsd/dev/negroni_keys.c
@@ -0,0 +1,248 @@
+/*
+ * Polled NEGRONI keys (OnePlus 10 Pro 5G, SM8450). Call once after the scheduler is running.
+ * SPMI PMIC arbiter v7, read through the observer channel of EE 0 (negroni_spmi_keys.h, shared with
+ * the Mu-Silicium NegroniKeyInputDxe):
+ *   power       PMK8350 (SID 0) PON PID 0x13, RT_STS bit 7 (KPDPWR)
+ *   volume up   same register, bit 6 (RESIN)
+ *   volume down PM8350 (SID 1) GPIO6, RT_STS bit 0, active low
+ * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an observer channel.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "negroni_spmi_keys.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void negroni_hid_key(int key, int down);
+void negroni_keys_init(void);
+
+#define KEYS_CORE_PA     0x0c400000u     /* arbiter core (APID map at +0x2000) */
+#define KEYS_CORE_SIZE   0x3000u
+#define KEYS_OBS_PA      0x0c440000u     /* observer channels, EE 0 first */
+#define KEYS_OBS_SIZE    0x8000u
+
+static struct sk_arbiter keys_arb;
+static struct sk_keys keys_apid;
+static bool keys_started;
+static int keys_sleep_chan;
+
+/*
+ * 0382 (README-power-idle.md): 20 ms; with the display asleep and no key down negronikeys_dark_ms
+ * (default 40; 20 = as before). A press lasts 80 ms or more, so 40 ms still sees every press.
+ */
+extern int negroni_display_asleep;      /* NegroniFramebuffer.cpp */
+static uint32_t keys_dark_ms = 40;
+
+static void
+keys_wait(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* negronikeyslog=1: print every press/release */
+static int keys_log;
+
+/*
+ * 0377 (negroni_charge.c): the power key as the key thread last read it: 1 pressed, 0 released,
+ * -1 not known (no read yet, or 5 read errors in a row). keys_running: the thread owns the
+ * observer channel (nobody else samples it then).
+ */
+static volatile int keys_power = -1;
+static volatile bool keys_running;
+int negroni_keys_power(void);
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	/* negroni_hid_key: 0 power, 1 volume up, 2 volume down */
+	static const uint8_t bit[3] = { SK_KEY_POWER, SK_KEY_VOLUP, SK_KEY_VOLDOWN };
+	int state[3] = {0, 0, 0};
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint8_t pressed = 0;
+		int rc = sk_sample(&keys_arb, &keys_apid, &pressed);
+		if (rc) {
+			if ((errors++ % 250u) == 0) {
+				printf("NEGRONI KEYS: read error %d\n", rc);
+			}
+			if (errors >= 5) {
+				keys_power = -1;        /* 0377 */
+			}
+		} else {
+			errors = 0;
+			keys_power = (pressed & SK_KEY_POWER) ? 1 : 0;  /* 0377 */
+			for (int k = 0; k < 3; ++k) {
+				int now = !!(pressed & bit[k]);
+				if (now != state[k]) {
+					state[k] = now;
+					if (keys_log) {
+						printf("NEGRONI KEYS: key=%d down=%d\n", k, now);
+					}
+					negroni_hid_key(k, now);
+				}
+			}
+		}
+		bool down = state[0] || state[1] || state[2];
+		keys_wait(!down && __atomic_load_n(&negroni_display_asleep, __ATOMIC_ACQUIRE) ? keys_dark_ms : 20);
+	}
+}
+
+static int keys_opened = -1;
+
+static int
+keys_open(void)
+{
+	if (keys_opened >= 0) {
+		return keys_opened;
+	}
+	keys_arb.core = (volatile uint32_t *)ml_io_map(KEYS_CORE_PA, KEYS_CORE_SIZE);
+	keys_arb.obs = (volatile uint32_t *)ml_io_map(KEYS_OBS_PA, KEYS_OBS_SIZE);
+	keys_arb.ee = 0;
+	if (!keys_arb.core || !keys_arb.obs) {
+		printf("NEGRONI KEYS: MMIO mapping failed\n");
+		return keys_opened = 1;
+	}
+	int rc = sk_open(&keys_arb, &keys_apid);
+	printf("NEGRONI KEYS: arb=%#x pon-apid=%d gpio6-apid=%d open=%d\n",
+	    keys_arb.core[0], keys_apid.pon, keys_apid.gpio, rc);
+	if (rc) {
+		printf("NEGRONI KEYS: arbiter or PON not found, keys off\n");
+	}
+	return keys_opened = rc ? 1 : 0;
+}
+
+/*
+ * Probe menu, before the key thread starts (one reader of the observer channel at a time):
+ * hold Volume Up during the prompt to open it. Volume Up raises the selected count,
+ * Volume Down selects the other one, Power runs. The counts replace negroniadreno /
+ * negroniwifi for this boot (negroni_adreno.c, negroni_wifi.c read negroni_probe_*).
+ */
+uint32_t negroni_probe_gpu = ~0u, negroni_probe_wifi = ~0u;
+void negroni_probe_menu(void);
+
+#define PROBE_GPU_MAX   22
+#define PROBE_WIFI_MAX  4
+
+static uint8_t
+keys_now(void)
+{
+	uint8_t pressed = 0;
+	return sk_sample(&keys_arb, &keys_apid, &pressed) ? 0 : pressed;
+}
+
+void
+negroni_probe_menu(void)
+{
+	uint32_t value[2] = { 0, 0 }, field = 0, menu = 1;
+	uint8_t was;
+
+	(void)PE_parse_boot_argn("negronimenu", &menu, sizeof(menu));
+	if (!menu || keys_open()) {
+		return;
+	}
+	(void)PE_parse_boot_argn("negroniadreno", &value[0], sizeof(value[0]));
+	(void)PE_parse_boot_argn("negroniwifi", &value[1], sizeof(value[1]));
+	printf("\nNEGRONI PROBE MENU: hold VOLUME UP now to open it (2 s)\n");
+	bool open = false;
+	for (int i = 0; i < 100 && !open; i++) {
+		open = (keys_now() & SK_KEY_VOLUP) != 0;
+		delay(20000);
+	}
+	if (!open) {
+		return;
+	}
+	printf("NEGRONI PROBE MENU: VOL+ = +1, VOL- = switch GPU/WIFI, POWER = run (60 s timeout)\n");
+	while (keys_now() & SK_KEY_VOLUP) {
+		delay(20000);
+	}
+	was = 0;
+	for (int ticks = 0; ticks < 3000; ticks++) {
+		uint8_t now = keys_now(), edge = now & ~was;
+		was = now;
+		if (ticks == 0 || edge) {
+			if (edge & SK_KEY_VOLUP) {
+				uint32_t max = field ? PROBE_WIFI_MAX : PROBE_GPU_MAX;
+				value[field] = value[field] >= max ? 0 : value[field] + 1;
+			}
+			if (edge & SK_KEY_VOLDOWN) {
+				field ^= 1;
+			}
+			if (edge & SK_KEY_POWER) {
+				break;
+			}
+			printf("NEGRONI PROBE MENU: %sGPU steps %u%s   %sWIFI steps %u%s\n",
+			    field ? " " : "[", value[0], field ? " " : "]",
+			    field ? "[" : " ", value[1], field ? "]" : " ");
+			ticks = 0;
+		}
+		delay(20000);
+	}
+	negroni_probe_gpu = value[0];
+	negroni_probe_wifi = value[1];
+	printf("NEGRONI PROBE MENU: running GPU steps 1..%u, WIFI steps 1..%u\n", value[0], value[1]);
+	while (keys_now() & SK_KEY_POWER) {
+		delay(20000);
+	}
+}
+
+void
+negroni_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("negronikeys", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("negronikeyslog", &keys_log, sizeof(keys_log));
+	(void)PE_parse_boot_argn("negronikeys_dark_ms", &keys_dark_ms, sizeof(keys_dark_ms));
+	if (keys_dark_ms < 20 || keys_dark_ms > 60) {
+		keys_dark_ms = keys_dark_ms < 20 ? 20 : 60;     /* 0382: a short tap is about 80 ms */
+	}
+	if (!enabled) {
+		printf("NEGRONI KEYS: disabled (negronikeys=0)\n");
+		return;
+	}
+	if (keys_open()) {
+		return;
+	}
+	keys_running = true;    /* 0377: before the thread runs, so negroni_keys_power() never samples beside it */
+	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		keys_running = false;
+		printf("NEGRONI KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+
+/*
+ * 0377: the power key for the charge-only mode. With the key thread: its last reading. Without
+ * it (negronikeys=0, or not started): one read of its own (thread context; the probe menu is over
+ * by then, so there is no other reader of the PON channel).
+ */
+int
+negroni_keys_power(void)
+{
+	uint8_t pressed = 0;
+
+	if (keys_running) {
+		return keys_power;
+	}
+	if (keys_open() != 0 || sk_sample(&keys_arb, &keys_apid, &pressed) != 0) {
+		return -1;
+	}
+	return (pressed & SK_KEY_POWER) ? 1 : 0;
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_mmio.h b/bsd/dev/negroni_mmio.h
new file mode 100644
index 0000000..da9aa9f
--- /dev/null
+++ b/bsd/dev/negroni_mmio.h
@@ -0,0 +1,46 @@
+/*
+ * NEGRONI (SM8450): 32-bit MMIO accessors for register spaces that the hypervisor traps (patch 0255).
+ *
+ * The apps SMMU global space (0x15000000, global pages 0 and 1) is trapped and emulated by the Gunyah
+ * hypervisor (QHEE). Gunyah emulates only accesses that the CPU reports with a valid syndrome (ESR ISV=1):
+ * one 32-bit register, a plain load or store, no base-register writeback. A post-index or pre-index load
+ * ("ldr w, [x], #4"), a pair (ldp/stp), a 64-bit access or a store of WZR gets a synchronous external
+ * abort (ESR 0x96000010) injected. Proof: the first boot of out/ios16-everything (docs/notes.md section 27)
+ * panicked at "ldr w12, [x9], #0x4" in the SMR scan of wlan_dma_path, after plain reads of sCR0/IDR0/IDR1
+ * worked. Linux uses readl/writel ("ldr %w0, [%1]" / "str %w0, [%1]"); the OnePlus sm8450 arm-smmu.c
+ * (lines 62-67) notes the WZR store problem.
+ *
+ * So the access is one inline-asm instruction with a plain base register: the compiler cannot merge two
+ * accesses into a pair, add writeback, or widen it. The value operand is "r", not "rZ": a zero is moved
+ * into a register first and is never stored from WZR. Barriers stay with the caller.
+ */
+#ifndef _NEGRONI_MMIO_H_
+#define _NEGRONI_MMIO_H_
+
+#include <stdint.h>
+#include <mach/vm_types.h>
+
+static inline uint32_t
+negroni_mmio_rd32(vm_offset_t a)
+{
+	uint32_t v;
+	__asm__ volatile ("ldr %w0, [%1]" : "=r" (v) : "r" (a) : "memory");
+	return v;
+}
+
+static inline void
+negroni_mmio_wr32(vm_offset_t a, uint32_t v)
+{
+	__asm__ volatile ("str %w0, [%1]" : : "r" (v), "r" (a) : "memory");
+}
+
+/*
+ * 0297 (osfmk/arm64/sleh.c): the same single ldr/str, but an access that the hypervisor refuses with a
+ * synchronous external abort returns -1 instead of a panic (CONFIG_XNUPOST kernels: DEVELOPMENT/DEBUG;
+ * -2 and no access otherwise). 0 = done. For probes and for writes that may be refused (apps-SMMU CBAR).
+ */
+extern int negroni_mmio_try_rd32(vm_offset_t a, uint32_t *v);
+extern int negroni_mmio_try_wr32(vm_offset_t a, uint32_t v);
+extern uint32_t negroni_mmio_try_faults;
+
+#endif /* _NEGRONI_MMIO_H_ */
diff --git a/bsd/dev/negroni_reboot.c b/bsd/dev/negroni_reboot.c
new file mode 100644
index 0000000..a6c67fb
--- /dev/null
+++ b/bsd/dev/negroni_reboot.c
@@ -0,0 +1,969 @@
+/*
+ * NEGRONI: restart with a reboot reason, power off (OnePlus 10 Pro 5G, SM8450).
+ *
+ * ABL reads the reboot reason from the PMK8350 SDAM: the Android DT's
+ * `qcom,reboot-reason` nvmem cell is SID 0, SDAM block 0x7100, byte 0x48,
+ * bits 7:1 (value << 1, bit 0 is kept). Values: 1 = recovery,
+ * 2 = bootloader (fastboot), 0 = normal. The reason is written with one
+ * read-modify-write of register 0x7148, then a PSCI SYSTEM_RESET follows.
+ * (The IMEM restart_reason at 0x146aa65c does not select a mode here.)
+ *
+ * Power off (0214). On this phone PSCI SYSTEM_OFF alone is a reset
+ * [V 2026-10-26: the phone was back in iOS 49 s after SYSTEM_OFF, the same
+ * time as after SYSTEM_RESET]: TZ drops PS_HOLD, and the PMIC does what
+ * its PS_HOLD reset type says. The bootloader leaves that type at a reset.
+ * Android (msm-poweroff.c do_msm_poweroff) first sets the type to
+ * SHUTDOWN (qpnp_pon_system_pwr_off), then drops PS_HOLD; do_msm_restart
+ * sets HARD_RESET (WARM_RESET only for a dump) before every reset.
+ * The kernel does the same: the PS_HOLD reset type of the PMK8350 PON_PBS
+ * block (SID 0, 0x0800; DT pon_pbs@800 "qcom,system-reset") is set to
+ * SHUTDOWN, then PSCI SYSTEM_OFF (if it returns: SYSTEM_RESET, which also
+ * drops PS_HOLD). Before a restart a SHUTDOWN type is set to HARD_RESET.
+ * Boot-arg negronipoweroff (default 0):
+ *   0  PS_HOLD type SHUTDOWN, then SYSTEM_OFF (SYSTEM_RESET if it returns)
+ *   1  SYSTEM_OFF only (the 0211 behavior, for comparison)
+ *   2  PS_HOLD type SHUTDOWN, then SYSTEM_RESET
+ * Registers, downstream qpnp-power-on.c (OnePlus sm8450 kernel): PON GEN3
+ * (subtype 0x08 PBS / 0x09 HLOS) has PS_HOLD_RST_CTL at +0x52 (bits 3:0
+ * type: 1 WARM_RESET, 4 SHUTDOWN, 7 HARD_RESET) and PS_HOLD_RST_CTL2 at
+ * +0x53 (bit 7 enable; cleared during the change, then 500 us); GEN1/GEN2
+ * use +0x5a/+0x5b (0211 wrote these on GEN3: the wrong registers). The
+ * write is refused unless 0x0804/0x0805 read type 0x01 (PON) and subtype
+ * 0x08 (GEN3 PBS). GEN3 has no PON/POFF reason registers; the PMIC PBS
+ * writes a PON log into SDAM 0x7400 (DT pmic-pon-log, downstream
+ * pmic-pon-log.c: +0x45 SDAM count, +0x46 push pointer, +0x47 push SDAM,
+ * FIFO of 4-byte entries {state, event, data1, data0} at +0x4b..+0xbf).
+ * negroni_reboot_prepare() prints the PS_HOLD type and the PON log at
+ * boot ("NEGRONI PON LOG:" lines: the last PON trigger, reset trigger and
+ * reset type tell why the phone started).
+ *
+ * The PMIC is reached through the SPMI PMIC arbiter, version 7 (Linux
+ * drivers/spmi/spmi-pmic-arb.c; NE2211 DT qcom,spmi@c42d000, qcom,ee = <0>):
+ *   core   0x0c400000  version at +0, APID count at +4 bits 10:0,
+ *                      APID map at +0x2000 + 4*apid (bits 19:8 = PPID)
+ *   chnls  0x0c500000  read/write channel of an APID at 0x1000*apid
+ *   obsrvr 0x0c440000  observer (read) channel at 0x8000*ee + 0x20*apid
+ *   cnfg   0x0c42d000  owner table, 4*apid, bits 2:0 = EE that may write
+ * Channel registers: CMD +0x00, STATUS +0x08 (bit 0 done, bits 3:1
+ * failed/denied/dropped), WDATA0 +0x10, RDATA0 +0x18. Command word:
+ * opcode << 27 | register byte << 4 | (byte count - 1); EXT_WRITEL = 0,
+ * EXT_READL = 1. Like Linux, a write is only issued when the owner table
+ * gives the APID to EE 0; otherwise the reason is not set and the reset is
+ * a plain one. The keys driver (negroni_keys.c) reads this arbiter the same
+ * way (core + observer) on this hardware.
+ *
+ * Adapted from slop unixnu-negroni/package/BootResetCore.h + BootReset.c
+ * (SM8550 "sheng", same arbiter layout and SDAM cell).
+ *
+ * negroni_reboot_prepare() maps everything early (NegroniPlatformExpert
+ * start), so the panic path needs no allocation. Callers: one at a time
+ * (the USB command server, the halt/restart path, the panic path).
+ *
+ * Reboot mode (0213): the string sysctl kern.negroni_reboot_mode
+ * (normal | bootloader | fastboot | recovery, default normal; write: root
+ * only) selects the reason of the next restart, negroni_restart() (the
+ * kPERestartCPU path of reboot(RB_AUTOBOOT)). Reasons as the 0210 UDP
+ * commands: normal 0, recovery 1, bootloader and fastboot 2.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/sysctl.h>
+#include <os/atomic_private.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+void negroni_reboot_prepare(void);
+int negroni_reboot_set_reason(unsigned reason);
+void negroni_reboot_reset(void);
+void negroni_reboot(unsigned reason);
+void negroni_restart(void);
+void negroni_power_off(void);
+void negroni_panic_restart(void);
+void negroni_reboot_settle(unsigned ms);
+/* 0367: boot log end mark (negroni_ufs.c): kind 3 halt, 4 restart; | 0x10 = from the panic hold loop */
+extern void negroni_bootlog_end(unsigned kind, const char *why);
+
+/*
+ * Panic hold (patch 0360, README-panic.md). In negroni_panic_restart()
+ * interrupts are off and the other CPUs are halted: printf becomes
+ * kdb_printf (console only, no os_log), delays spin on the counter (no
+ * WFE, no thread block).
+ */
+extern int kdb_printf(const char *format, ...) __printflike(1, 2);
+extern bool negroni_usb_panic_begin(void);
+extern int negroni_usb_panic_service(bool busy);
+#define NEGRONI_PANIC_ACT_POWEROFF 0x100        /* as in negroni_usb.c */
+static volatile bool nr_in_panic;
+#define printf(...) (nr_in_panic ? kdb_printf(__VA_ARGS__) : printf(__VA_ARGS__))
+
+/* Busy wait on the counter: works with interrupts off and needs no timer event (WFE). */
+static void
+nr_udelay(uint32_t us)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &abs);
+	uint64_t end = mach_absolute_time() + abs;
+	while (mach_absolute_time() < end) {
+	}
+}
+
+#define NR_CORE_PA              0x0c400000u
+#define NR_CORE_SIZE            0x3000u
+#define NR_CHNLS_PA             0x0c500000u
+#define NR_OBS_PA               0x0c440000u
+#define NR_CNFG_PA              0x0c42d000u
+#define NR_EE                   0u
+
+#define NR_VERSION_V7_MIN       0x70000000u
+#define NR_VERSION_V8_MIN       0x80000000u
+#define NR_FEATURES             0x04u
+#define NR_APID_MAP             0x2000u
+#define NR_MAX_APIDS            1024u
+#define NR_CHNL_STRIDE          0x1000u
+#define NR_OBS_EE_STRIDE        0x8000u
+#define NR_OBS_APID_STRIDE      0x20u
+
+#define NR_CMD                  0x00u
+#define NR_STATUS               0x08u
+#define NR_WDATA0               0x10u
+#define NR_RDATA0               0x18u
+#define NR_OP_EXT_WRITEL        0u
+#define NR_OP_EXT_READL         1u
+#define NR_STATUS_DONE          (1u << 0)
+#define NR_STATUS_ERRORS        0x0eu
+
+#define NR_SDAM_PPID            0x071u          /* SID 0, peripheral 0x71 (0x7100) */
+#define NR_REASON_REG           0x48u           /* 0x7148 */
+#define NR_REASON_MASK          0xfeu
+#define NR_REASON_SHIFT         1
+
+#define NR_PON_PPID             0x008u          /* SID 0, PON_PBS (0x0800) */
+#define NR_PON_TYPE             0x04u
+#define NR_PON_SUBTYPE          0x05u
+#define NR_PON_TYPE_PON         0x01u
+#define NR_PON_SUBTYPE_GEN3_PBS 0x08u
+#define NR_PON_SUBTYPE_GEN3_HLOS 0x09u
+#define NR_PON_PS_HOLD_RST_CTL  0x5au           /* GEN1/GEN2 */
+#define NR_PON_PS_HOLD_RST_CTL2 0x5bu
+#define NR_PON3_PS_HOLD_RST_CTL 0x52u           /* GEN3 */
+#define NR_PON3_PS_HOLD_RST_CTL2 0x53u
+#define NR_PON_RESET_EN         0x80u
+#define NR_PON_TYPE_MASK        0x0fu
+#define NR_PON_TYPE_WARM_RESET  0x01u
+#define NR_PON_TYPE_SHUTDOWN    0x04u
+#define NR_PON_TYPE_DVDD_SHUTDOWN 0x05u
+#define NR_PON_TYPE_HARD_RESET  0x07u
+#define NR_PON_TYPE_DVDD_HARD_RESET 0x08u
+
+#define NR_PONLOG_PPID          0x074u          /* SID 0, SDAM 0x7400: the PMIC PON log */
+#define NR_PONLOG_SDAM_COUNT    0x45u
+#define NR_PONLOG_PUSH_PTR      0x46u
+#define NR_PONLOG_PUSH_SDAM     0x47u
+#define NR_PONLOG_FIFO_START    0x4bu
+#define NR_PONLOG_FIFO_END      0xbfu
+#define NR_PONLOG_FIFO_SIZE     (NR_PONLOG_FIFO_END - NR_PONLOG_FIFO_START + 1)
+/*
+ * 0377: the log read failed at random offsets on the phone ("FIFO read failed at +0x4b", +0x9c;
+ * bootlogs 10 and 13). [I] Another reader uses the same EE 0 observer channel of APID 60 at that
+ * time (the NegroniBattery census reads type/subtype/rt_sts of every APID just before), so a
+ * command can fail or (worse) return the other reader's byte. Now: each byte is tried up to
+ * NR_PONLOG_TRIES times, and the whole log (header + FIFO) is read until two passes in a row
+ * agree, at most NR_PONLOG_PASSES passes.
+ */
+#define NR_PONLOG_TRIES         4u
+#define NR_PONLOG_PASSES        4u
+#define NR_PONLOG_HDR           3u              /* +0x45 count, +0x46 push pointer, +0x47 push SDAM */
+
+#define PSCI_SYSTEM_OFF         0x84000008ull
+#define PSCI_SYSTEM_RESET       0x84000009ull
+
+struct nr_chan {
+	const char *name;
+	uint32_t    ppid;
+	bool        readonly;   /* observer reads only: no owner check, no write channel */
+	bool        attempted, ready;
+	vm_offset_t obs, chn;   /* this APID's observer / read-write channel */
+};
+
+static struct nr_chan nr_sdam = { .name = "SDAM 0x7100", .ppid = NR_SDAM_PPID };
+static struct nr_chan nr_pon = { .name = "PON_PBS 0x0800", .ppid = NR_PON_PPID };
+static struct nr_chan nr_ponlog = { .name = "PON LOG SDAM 0x7400", .ppid = NR_PONLOG_PPID, .readonly = true };
+static uint8_t nr_pon_subtype;                  /* 0 = not checked yet / not PON */
+static vm_offset_t nr_core, nr_cnfg;
+static uint32_t nr_arb, nr_apids;
+static bool nr_arb_attempted, nr_arb_ready;
+static int nr_poweroff_mode;                    /* boot-arg negronipoweroff */
+static int nr_panic_secs;                       /* boot-arg negronipanic (0 = stay) */
+static int nr_panic_reason;                     /* boot-arg negronipanicreason */
+static bool nr_prepared;
+
+static uint32_t
+nr_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+nr_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static uint32_t
+nr_cmd(uint32_t op, uint32_t reg)
+{
+	return (op << 27) | ((reg & 0xffu) << 4);     /* byte count 1 */
+}
+
+/* 0 done, 1 timeout, 2 the arbiter reported an error */
+static int
+nr_wait(vm_offset_t ch)
+{
+	for (unsigned i = 0; i < 2000; i++) {
+		uint32_t s = nr_rd(ch, NR_STATUS);
+		if (s & NR_STATUS_DONE) {
+			return (s & NR_STATUS_ERRORS) ? 2 : 0;
+		}
+		nr_udelay(1);                   /* 0360: was delay(1) (WFE wait) */
+	}
+	return 1;
+}
+
+static bool
+nr_arb_open(void)
+{
+	if (nr_arb_attempted) {
+		return nr_arb_ready;
+	}
+	nr_arb_attempted = true;
+	nr_core = ml_io_map(NR_CORE_PA, NR_CORE_SIZE);
+	nr_cnfg = ml_io_map(NR_CNFG_PA, 0x1000);
+	if (nr_core == 0 || nr_cnfg == 0) {
+		printf("NEGRONI REBOOT: SPMI map failed\n");
+		return false;
+	}
+	nr_arb = nr_rd(nr_core, 0);
+	nr_apids = nr_rd(nr_core, NR_FEATURES) & 0x7ffu;
+	if (nr_arb < NR_VERSION_V7_MIN || nr_arb >= NR_VERSION_V8_MIN || nr_apids == 0 || nr_apids > NR_MAX_APIDS) {
+		printf("NEGRONI REBOOT: unknown SPMI arbiter %#x (%u APIDs)\n", nr_arb, nr_apids);
+		return false;
+	}
+	nr_arb_ready = true;
+	return true;
+}
+
+/* Finds the APID of c->ppid, checks that EE 0 may write it and maps its channels. */
+static bool
+nr_open(struct nr_chan *c)
+{
+	if (c->attempted) {
+		return c->ready;
+	}
+	c->attempted = true;
+	if (!nr_arb_open()) {
+		return false;
+	}
+	/* As Linux picks it: the first mapping, replaced by one this EE owns. */
+	int apid = -1;
+	unsigned owner = 0;
+	for (uint32_t i = 0; i < nr_apids; i++) {
+		uint32_t map = nr_rd(nr_core, NR_APID_MAP + 4 * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != c->ppid) {
+			continue;
+		}
+		unsigned o = nr_rd(nr_cnfg, 4 * i) & 7u;
+		if (apid < 0 || o == NR_EE) {
+			apid = (int)i;
+			owner = o;
+		}
+	}
+	if (apid < 0) {
+		printf("NEGRONI REBOOT: %s not in the SPMI APID map\n", c->name);
+		return false;
+	}
+	if (owner != NR_EE && !c->readonly) {
+		printf("NEGRONI REBOOT: %s APID %d is owned by EE %u, not EE %u: no write\n",
+		    c->name, apid, owner, NR_EE);
+		return false;
+	}
+	uint32_t obs_off = NR_OBS_EE_STRIDE * NR_EE + NR_OBS_APID_STRIDE * (uint32_t)apid;
+	vm_offset_t obs_page = ml_io_map(NR_OBS_PA + (obs_off & ~0xfffu), 0x1000);
+	c->chn = c->readonly ? 0 : ml_io_map(NR_CHNLS_PA + NR_CHNL_STRIDE * (uint32_t)apid, NR_CHNL_STRIDE);
+	if (obs_page == 0 || (c->chn == 0 && !c->readonly)) {
+		printf("NEGRONI REBOOT: SPMI channel map failed\n");
+		return false;
+	}
+	c->obs = obs_page + (obs_off & 0xfffu);
+	c->ready = true;
+	printf("NEGRONI REBOOT: SPMI arbiter %#x, %s APID %d (EE %u)\n", nr_arb, c->name, apid, owner);
+	return true;
+}
+
+static int
+nr_read(const struct nr_chan *c, uint32_t reg, uint8_t *value)
+{
+	nr_wr(c->obs, NR_CMD, nr_cmd(NR_OP_EXT_READL, reg));
+	int rc = nr_wait(c->obs);
+	if (rc == 0) {
+		*value = (uint8_t)nr_rd(c->obs, NR_RDATA0);
+	}
+	return rc;
+}
+
+static int
+nr_write(const struct nr_chan *c, uint32_t reg, uint8_t value)
+{
+	if (c->chn == 0) {
+		return -1;
+	}
+	nr_wr(c->chn, NR_WDATA0, value);
+	nr_wr(c->chn, NR_CMD, nr_cmd(NR_OP_EXT_WRITEL, reg));
+	return nr_wait(c->chn);
+}
+
+/* reg = (reg & ~mask) | (bits & mask), read back. 0 = done, -1 = failed (logged). */
+static int
+nr_update(const struct nr_chan *c, uint32_t reg, uint8_t mask, uint8_t bits)
+{
+	uint8_t before = 0, after = 0;
+	int rc = nr_read(c, reg, &before);
+	if (rc) {
+		printf("NEGRONI REBOOT: %s read of +%#x failed (%d)\n", c->name, reg, rc);
+		return -1;
+	}
+	uint8_t next = (uint8_t)((before & ~mask) | (bits & mask));
+	if (next == before) {
+		return 0;
+	}
+	rc = nr_write(c, reg, next);
+	if (rc == 0) {
+		rc = nr_read(c, reg, &after);
+	}
+	if (rc || after != next) {
+		printf("NEGRONI REBOOT: %s write of +%#x %#04x -> %#04x failed (rc %d, read back %#04x)\n",
+		    c->name, reg, before, next, rc, after);
+		return -1;
+	}
+	printf("NEGRONI REBOOT: %s +%#x %#04x -> %#04x\n", c->name, reg, before, after);
+	return 0;
+}
+
+static int64_t
+nr_psci(uint64_t function)
+{
+	register uint64_t x0 __asm__("x0") = function;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	return (int64_t)x0;
+}
+
+/* Sleeps ms if this thread may block (other threads, the USB log, still run); else returns at once. */
+void
+negroni_reboot_settle(unsigned ms)
+{
+	if (!preemption_enabled() || ml_at_interrupt_context()) {
+		return;
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline((event_t)&nr_prepared, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/*
+ * PON_PBS: type 0x01 (PON) and GEN3 PBS subtype 0x08 required (the DT's
+ * qcom,system-reset device). Gives the PS_HOLD_RST_CTL/CTL2 offsets of the
+ * generation. 0 = usable, -1 = not (logged once).
+ */
+static int
+nr_pon_check(uint32_t *ctl, uint32_t *ctl2)
+{
+	uint8_t type = 0, subtype = 0;
+
+	if (!nr_open(&nr_pon)) {
+		return -1;
+	}
+	if (nr_pon_subtype == 0) {
+		if (nr_read(&nr_pon, NR_PON_TYPE, &type) || nr_read(&nr_pon, NR_PON_SUBTYPE, &subtype) ||
+		    type != NR_PON_TYPE_PON || subtype != NR_PON_SUBTYPE_GEN3_PBS) {
+			printf("NEGRONI REBOOT: PON_PBS type %#04x subtype %#04x, not PON GEN3 PBS: no PS_HOLD config\n",
+			    type, subtype);
+			return -1;
+		}
+		nr_pon_subtype = subtype;
+	}
+	bool gen3 = nr_pon_subtype == NR_PON_SUBTYPE_GEN3_PBS || nr_pon_subtype == NR_PON_SUBTYPE_GEN3_HLOS;
+	*ctl = gen3 ? NR_PON3_PS_HOLD_RST_CTL : NR_PON_PS_HOLD_RST_CTL;
+	*ctl2 = gen3 ? NR_PON3_PS_HOLD_RST_CTL2 : NR_PON_PS_HOLD_RST_CTL2;
+	return 0;
+}
+
+static const char *
+nr_pon_type_name(uint8_t type)
+{
+	switch (type & NR_PON_TYPE_MASK) {
+	case NR_PON_TYPE_WARM_RESET:        return "WARM_RESET";
+	case NR_PON_TYPE_SHUTDOWN:          return "SHUTDOWN";
+	case NR_PON_TYPE_DVDD_SHUTDOWN:     return "DVDD_SHUTDOWN";
+	case NR_PON_TYPE_HARD_RESET:        return "HARD_RESET";
+	case NR_PON_TYPE_DVDD_HARD_RESET:   return "DVDD_HARD_RESET";
+	default:                            return "unknown";
+	}
+}
+
+/* The PS_HOLD reset type (bits 3:0 of PS_HOLD_RST_CTL). 0 = read, -1 = not. */
+static int
+nr_pon_type_get(uint8_t *type)
+{
+	uint32_t ctl, ctl2;
+	uint8_t v = 0;
+
+	if (nr_pon_check(&ctl, &ctl2) != 0 || nr_read(&nr_pon, ctl, &v) != 0) {
+		return -1;
+	}
+	*type = v & NR_PON_TYPE_MASK;
+	return 0;
+}
+
+/* Boot-time status line: the PS_HOLD reset type the bootloader left. */
+static void
+nr_pon_status(void)
+{
+	uint32_t ctl, ctl2;
+	uint8_t v = 0, en = 0;
+
+	if (nr_pon_check(&ctl, &ctl2) != 0) {
+		return;
+	}
+	if (nr_read(&nr_pon, ctl, &v) || nr_read(&nr_pon, ctl2, &en)) {
+		printf("NEGRONI REBOOT: PON_PBS PS_HOLD_RST_CTL read failed\n");
+		return;
+	}
+	printf("NEGRONI REBOOT: PON_PBS subtype %#04x: PS_HOLD_RST_CTL +%#x = %#04x (%s), CTL2 +%#x = %#04x (%s)\n",
+	    nr_pon_subtype, ctl, v, nr_pon_type_name(v), ctl2, en, (en & NR_PON_RESET_EN) ? "enabled" : "disabled");
+}
+
+/*
+ * PS_HOLD reset type = type, like qpnp_pon_reset_config(): disable, 500 us
+ * (10 sleep clock cycles), type, enable. 0 = set, -1 = not set (logged).
+ */
+static int
+nr_pon_set_type(uint8_t type)
+{
+	uint32_t ctl, ctl2;
+
+	if (nr_pon_check(&ctl, &ctl2) != 0) {
+		return -1;
+	}
+	if (nr_update(&nr_pon, ctl2, NR_PON_RESET_EN, 0) != 0) {
+		return -1;
+	}
+	if (nr_in_panic) {
+		nr_udelay(500);
+	} else {
+		delay(500);
+	}
+	int rc = nr_update(&nr_pon, ctl, NR_PON_TYPE_MASK, type);
+	/* Enable again also after a failed type write: the reset must still work. */
+	if (nr_update(&nr_pon, ctl2, NR_PON_RESET_EN, NR_PON_RESET_EN) != 0 || rc != 0) {
+		return -1;
+	}
+	printf("NEGRONI REBOOT: PS_HOLD reset type = %s\n", nr_pon_type_name(type));
+	return 0;
+}
+
+static const char *
+nr_pon_log_event_name(uint8_t event)
+{
+	switch (event) {
+	case 0x01: return "PON_TRIGGER";
+	case 0x02: return "OTP_COPY_COMPLETE";
+	case 0x03: return "TRIM_COMPLETE";
+	case 0x04: return "XVLO_CHECK_COMPLETE";
+	case 0x05: return "PMIC_CHECK_COMPLETE";
+	case 0x06: return "RESET_TRIGGER";
+	case 0x07: return "RESET_TYPE";
+	case 0x08: return "WARM_RESET_COUNT";
+	case 0x09: return "FAULT_REASON_1_2";
+	case 0x0a: return "FAULT_REASON_3";
+	case 0x0b: return "PBS_PC_DURING_FAULT";
+	case 0x0c: return "FUNDAMENTAL_RESET";
+	case 0x0d: return "PON_SEQ_START";
+	case 0x0e: return "PON_SUCCESS";
+	case 0x0f: return "WAITING_ON_PSHOLD";
+	case 0x20: return "VREG_READY_CHECK";
+	default:   return event >= 0x10 && event <= 0x1c ? "PMIC_SIDn_FAULT" : "event";
+	}
+}
+
+/* Trigger codes of pmic-pon-log.c (PON triggers and reset triggers share the small codes). */
+static const char *
+nr_pon_log_trigger_name(uint8_t event, uint16_t code)
+{
+	if (event == 0x01) {
+		switch (code) {
+		case 0x0084: return "PS_HOLD";
+		case 0x0085: return "HARD_RESET";
+		case 0x0086: return "RESIN_N";
+		case 0x0087: return "KPDPWR_N";
+		case 0x0621: return "RTC_ALARM";
+		case 0x0640: return "SMPL";
+		case 0x31c2: return "USB_CHARGER";
+		case 0x8732: return "USB_CHARGER";
+		default:     return NULL;
+		}
+	}
+	switch (code) {
+	case 0x0080: return "KPDPWR_N_S2";
+	case 0x0081: return "RESIN_N_S2";
+	case 0x0082: return "KPDPWR_N_AND_RESIN_N_S2";
+	case 0x0083: return "PMIC_WATCHDOG_S2";
+	case 0x0084: return "PS_HOLD";
+	case 0x0085: return "SW_RESET";
+	case 0x0086: return "RESIN_N_DEBOUNCE";
+	case 0x0087: return "KPDPWR_N_DEBOUNCE";
+	default:     return NULL;
+	}
+}
+
+/*
+ * 0367: one line for the boot log header (negroni_ufs.c): the last PON
+ * trigger, reset trigger, reset type, warm reset count and fault reasons of
+ * the PON log. They tell why this power-on happened, so why the previous
+ * boot ended: RESET_TRIGGER PS_HOLD = the SoC dropped PS_HOLD (PSCI reset,
+ * TZ after an APSS watchdog bite), PMIC_WATCHDOG_S2 = PMIC watchdog,
+ * KPDPWR_N_S2 = power key held; PON_TRIGGER KPDPWR_N alone = power on by key
+ * after a power off. Empty until negroni_reboot_prepare() ran.
+ */
+static char nr_pon_summary[200];
+/* 0377: the decoded fields for the charge-only mode (negroni_charge.c); -1 = none */
+static bool nr_pon_decoded;
+static int nr_pon_last_trigger = -1, nr_pon_last_rst = -1, nr_pon_last_type = -1, nr_pon_reset_after;
+
+const char *negroni_reboot_pon_summary(void);
+
+const char *
+negroni_reboot_pon_summary(void)
+{
+	return nr_pon_summary;
+}
+
+/*
+ * The PMIC PON log (SDAM 0x7400, downstream pmic-pon-log.c), oldest entry
+ * first. Only the first SDAM of the FIFO is decoded (the NE2211 DT lists
+ * one). Read only (observer channel); nothing is written.
+ */
+static void
+nr_pon_log_dump(void)
+{
+	static const char *const states[8] = {
+		"FAULT", "PON", "POFF", "ON", "RESET", "OFF", "FAULT", "WARM_RESET"
+	};
+	uint8_t count = 0, ptr = 0, sdam = 0;
+	uint8_t fifo[NR_PONLOG_FIFO_SIZE];
+
+	if (!nr_open(&nr_ponlog)) {
+		return;
+	}
+	/* 0377: header + FIFO in one buffer, read until two passes agree (see NR_PONLOG_TRIES) */
+	static uint8_t pass[2][NR_PONLOG_HDR + NR_PONLOG_FIFO_SIZE];
+	unsigned retries = 0, passes = 0;
+	bool stable = false;
+	for (unsigned n = 0; n < NR_PONLOG_PASSES && !stable; n++) {
+		uint8_t *b = pass[n & 1];
+		for (unsigned i = 0; i < NR_PONLOG_HDR + NR_PONLOG_FIFO_SIZE; i++) {
+			uint32_t reg = i < NR_PONLOG_HDR ? NR_PONLOG_SDAM_COUNT + i : NR_PONLOG_FIFO_START + (i - NR_PONLOG_HDR);
+			int rc = -1;
+			for (unsigned t = 0; t < NR_PONLOG_TRIES && rc != 0; t++) {
+				if (t > 0) {
+					retries++;
+					nr_udelay(20);
+				}
+				rc = nr_read(&nr_ponlog, reg, &b[i]);
+			}
+			if (rc != 0) {
+				printf("NEGRONI PON LOG: %s read failed at +%#x (%u tries, rc %d)\n",
+				    i < NR_PONLOG_HDR ? "header" : "FIFO", reg, NR_PONLOG_TRIES, rc);
+				return;
+			}
+		}
+		passes = n + 1;
+		stable = n > 0 && memcmp(pass[0], pass[1], sizeof(pass[0])) == 0;
+	}
+	if (!stable) {
+		printf("NEGRONI PON LOG: not decoded (no two equal reads in %u passes, %u retries)\n", passes, retries);
+		return;
+	}
+	if (retries > 0 || passes > 2) {
+		printf("NEGRONI PON LOG: read needed %u retries and %u passes\n", retries, passes);
+	}
+	count = pass[0][0];
+	ptr = pass[0][1];
+	sdam = pass[0][2];
+	memcpy(fifo, &pass[0][NR_PONLOG_HDR], sizeof(fifo));
+	printf("NEGRONI PON LOG: SDAM 0x7400: %u SDAM(s), push pointer +%#x in SDAM %u\n", count, ptr, sdam);
+	if (ptr < NR_PONLOG_FIFO_START || ptr > NR_PONLOG_FIFO_END || sdam != 0) {
+		printf("NEGRONI PON LOG: not decoded (pointer outside the FIFO, or in another SDAM)\n");
+		return;
+	}
+	const unsigned entries = NR_PONLOG_FIFO_SIZE / 4;
+	/*
+	 * 0367: for nr_pon_summary, the reset entries logged before the LAST
+	 * PON trigger (w_*: since the previous PON trigger; copied to last_* at
+	 * each PON trigger, so a reset of an older cycle is not reported).
+	 */
+	int last_pon = -1, last_rst = -1, last_type = -1, last_warm = -1, last_f12 = -1, last_f3 = -1;
+	int w_rst = -1, w_type = -1, w_warm = -1, w_f12 = -1, w_f3 = -1;
+	int start = (int)(ptr - NR_PONLOG_FIFO_START) - (int)(entries * 4);
+	if (start < 0) {
+		start += NR_PONLOG_FIFO_SIZE;
+	}
+	for (unsigned i = 0; i < entries; i++) {
+		unsigned idx = ((unsigned)start + i * 4) % NR_PONLOG_FIFO_SIZE;
+		uint8_t state = fifo[idx], event = fifo[(idx + 1) % NR_PONLOG_FIFO_SIZE];
+		uint8_t data1 = fifo[(idx + 2) % NR_PONLOG_FIFO_SIZE], data0 = fifo[(idx + 3) % NR_PONLOG_FIFO_SIZE];
+		if (state == 0 && event == 0 && data1 == 0 && data0 == 0) {
+			continue;
+		}
+		uint16_t data = (uint16_t)((data1 << 8) | data0);
+		const char *extra = NULL;
+		if (event == 0x01 || event == 0x06) {
+			extra = nr_pon_log_trigger_name(event, data);
+		} else if (event == 0x07) {
+			extra = nr_pon_type_name(data0);
+		}
+		printf("NEGRONI PON LOG: %-10s %-20s data %#06x%s%s\n", states[state & 7],
+		    nr_pon_log_event_name(event), data, extra ? " " : "", extra ? extra : "");
+		switch (event) {
+		case 0x01:
+			last_pon = data;
+			last_rst = w_rst; last_type = w_type; last_warm = w_warm; last_f12 = w_f12; last_f3 = w_f3;
+			w_rst = w_type = w_warm = w_f12 = w_f3 = -1;
+			break;
+		case 0x06: w_rst = data; break;
+		case 0x07: w_type = data0; break;
+		case 0x08: w_warm = data; break;
+		case 0x09: w_f12 = data; break;
+		case 0x0a: w_f3 = data; break;
+		default: break;
+		}
+	}
+	/* 0367: the summary line ("pon=PS_HOLD reset=PS_HOLD type=HARD_RESET warm=0x0001 ...") */
+	char *o = nr_pon_summary;
+	size_t left = sizeof(nr_pon_summary);
+	int w;
+	const char *nm;
+#define NR_SUM(...) do { w = snprintf(o, left, __VA_ARGS__); if (w > 0 && (size_t)w < left) { o += w; left -= (size_t)w; } } while (0)
+	if (last_pon >= 0) {
+		nm = nr_pon_log_trigger_name(0x01, (uint16_t)last_pon);
+		if (nm) {
+			NR_SUM("pon=%s ", nm);
+		} else {
+			NR_SUM("pon=%#06x ", last_pon);
+		}
+	}
+	if (last_rst >= 0) {
+		nm = nr_pon_log_trigger_name(0x06, (uint16_t)last_rst);
+		if (nm) {
+			NR_SUM("reset=%s ", nm);
+		} else {
+			NR_SUM("reset=%#06x ", last_rst);
+		}
+	}
+	if (last_type >= 0) {
+		NR_SUM("type=%s ", nr_pon_type_name((uint8_t)last_type));
+	}
+	if (last_warm >= 0) {
+		NR_SUM("warm=%#06x ", last_warm);
+	}
+	if (last_f12 > 0) {
+		NR_SUM("fault12=%#06x ", last_f12);
+	}
+	if (last_f3 > 0) {
+		NR_SUM("fault3=%#06x ", last_f3);
+	}
+	/* 0377: a reset logged after the last PON trigger = a warm reset without a new power-on */
+	if (w_rst >= 0 || w_type >= 0) {
+		NR_SUM("after=%s ", w_type >= 0 ? nr_pon_type_name((uint8_t)w_type) : "reset");
+	}
+#undef NR_SUM
+	if (o > nr_pon_summary && o[-1] == ' ') {
+		o[-1] = 0;
+	}
+	nr_pon_last_trigger = last_pon;
+	nr_pon_last_rst = last_rst;
+	nr_pon_last_type = last_type;
+	nr_pon_reset_after = (w_rst >= 0 || w_type >= 0) ? 1 : 0;
+	nr_pon_decoded = true;
+	printf("NEGRONI PON LOG: summary: %s\n", nr_pon_summary[0] ? nr_pon_summary : "(no entries)");
+}
+
+/* Boot-args and the SPMI mappings, once, in thread context (before any panic needs them). */
+void
+negroni_reboot_prepare(void)
+{
+	if (nr_prepared) {
+		return;
+	}
+	nr_prepared = true;
+	PE_parse_boot_argn("negronipoweroff", &nr_poweroff_mode, sizeof(nr_poweroff_mode));
+	PE_parse_boot_argn("negronipanic", &nr_panic_secs, sizeof(nr_panic_secs));
+	PE_parse_boot_argn("negronipanicreason", &nr_panic_reason, sizeof(nr_panic_reason));
+	(void)nr_open(&nr_sdam);
+	nr_pon_status();
+	nr_pon_log_dump();
+	printf("NEGRONI REBOOT: power off = %s, panic = %s %d s (reason %d)\n",
+	    nr_poweroff_mode == 0 ? "PS_HOLD SHUTDOWN + PSCI SYSTEM_OFF" :
+	    nr_poweroff_mode == 1 ? "PSCI SYSTEM_OFF only" : "PS_HOLD SHUTDOWN + PSCI SYSTEM_RESET",
+	    nr_panic_secs > 0 ? "reset after" : "stay", nr_panic_secs, nr_panic_reason);
+}
+
+/*
+ * 0377 (negroni_charge.c): the last PON trigger of the log (-1 none), the reset type logged before
+ * it (-1 none), and 1 in *reset_after when a reset entry follows it (a warm reset keeps the old
+ * trigger). Reads the log again once when the boot read did not decode it. 0 = decoded, -1 = not.
+ * Thread context, after negroni_reboot_prepare().
+ */
+int negroni_reboot_pon_info(int *trigger, int *type_before, int *reset_after);
+
+int
+negroni_reboot_pon_info(int *trigger, int *type_before, int *reset_after)
+{
+	static bool reread;
+
+	if (!nr_pon_decoded && nr_prepared && !reread) {
+		reread = true;
+		printf("NEGRONI PON LOG: read again (the boot read was not decoded)\n");
+		nr_pon_log_dump();
+	}
+	if (!nr_pon_decoded) {
+		return -1;
+	}
+	*trigger = nr_pon_last_trigger;
+	*type_before = nr_pon_last_type;
+	*reset_after = nr_pon_reset_after;
+	return 0;
+}
+
+/*
+ * 0377: PS_HOLD reset type HARD_RESET before a restart, whatever the bootloader left (WARM_RESET on
+ * this phone): the PMIC then logs a new PON trigger (HARD_RESET), so the next boot does not see the
+ * old USB_CHARGER trigger again. 0 = set, -1 = not (logged).
+ */
+int negroni_reboot_hard_type(void);
+
+int
+negroni_reboot_hard_type(void)
+{
+	return nr_pon_set_type(NR_PON_TYPE_HARD_RESET);
+}
+
+/*
+ * Reboot reason field of 0x7148 = reason (0 normal, 1 recovery,
+ * 2 bootloader); bit 0 is kept. 0 = set and read back, -1 = not set.
+ */
+int
+negroni_reboot_set_reason(unsigned reason)
+{
+	if (reason > 0x7f || !nr_open(&nr_sdam)) {
+		return -1;
+	}
+	if (nr_update(&nr_sdam, NR_REASON_REG, NR_REASON_MASK, (uint8_t)(reason << NR_REASON_SHIFT)) != 0) {
+		return -1;
+	}
+	printf("NEGRONI REBOOT: reboot reason %u\n", reason);
+	return 0;
+}
+
+/* PSCI SYSTEM_RESET (SMC conduit, as NegroniCPU's CPU_ON). Returns only if PSCI refused. */
+void
+negroni_reboot_reset(void)
+{
+	int64_t rc = nr_psci(PSCI_SYSTEM_RESET);
+	printf("NEGRONI REBOOT: PSCI SYSTEM_RESET returned %lld\n", (long long)rc);
+}
+
+/* Reason (best effort: a reason that cannot be set gives a plain reset), then reset. */
+void
+negroni_reboot(unsigned reason)
+{
+	uint8_t type = 0;
+
+	if (negroni_reboot_set_reason(reason) != 0) {
+		printf("NEGRONI REBOOT: reason %u not set, plain reset\n", reason);
+	}
+	/* A SHUTDOWN type (left by a power off) would make this reset a power off. */
+	if (nr_pon_type_get(&type) == 0 && (type == NR_PON_TYPE_SHUTDOWN || type == NR_PON_TYPE_DVDD_SHUTDOWN)) {
+		printf("NEGRONI REBOOT: PS_HOLD reset type %#x is a shutdown: setting HARD_RESET\n", type);
+		if (nr_pon_set_type(NR_PON_TYPE_HARD_RESET) != 0) {
+			printf("NEGRONI REBOOT: PS_HOLD reset type not set: this reset may power off\n");
+		}
+	}
+	negroni_reboot_reset();
+}
+
+/* kern.negroni_reboot_mode: the reason of the next restart (the same numbers as the 0210 commands). */
+static const struct {
+	const char *name;
+	unsigned    reason;
+} nr_modes[] = {
+	{ "normal", 0 },
+	{ "bootloader", 2 },
+	{ "fastboot", 2 },
+	{ "recovery", 1 },
+};
+static unsigned nr_mode;                        /* index into nr_modes, 0 = normal */
+
+static int
+nr_sysctl_reboot_mode(struct sysctl_oid *oidp __unused, void *arg1 __unused, int arg2 __unused,
+    struct sysctl_req *req)
+{
+	char buf[16];
+	int changed = 0;
+
+	/* sysctl_root() already refuses a write without CTLFLAG_ANYBODY from non-root; check again here. */
+	if (req->newptr != USER_ADDR_NULL && req->p != NULL && proc_suser(req->p) != 0) {
+		return EPERM;
+	}
+	strlcpy(buf, nr_modes[os_atomic_load(&nr_mode, relaxed)].name, sizeof(buf));
+	int error = sysctl_io_string(req, buf, sizeof(buf), 0, &changed);
+	if (error || !changed) {
+		return error;
+	}
+	/* "bootloader", "bootloader\n" (echo), with or without the NUL */
+	size_t n = strlen(buf);
+	while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\r' || buf[n - 1] == ' ' || buf[n - 1] == '\t')) {
+		buf[--n] = '\0';
+	}
+	for (unsigned i = 0; i < sizeof(nr_modes) / sizeof(nr_modes[0]); i++) {
+		if (strcmp(buf, nr_modes[i].name) == 0) {
+			os_atomic_store(&nr_mode, i, relaxed);
+			printf("NEGRONI REBOOT: reboot mode %s (reason %u) for the next restart\n",
+			    nr_modes[i].name, nr_modes[i].reason);
+			return 0;
+		}
+	}
+	return EINVAL;                          /* unknown word: the mode does not change */
+}
+
+SYSCTL_PROC(_kern, OID_AUTO, negroni_reboot_mode, CTLTYPE_STRING | CTLFLAG_RW | CTLFLAG_LOCKED,
+    NULL, 0, nr_sysctl_reboot_mode, "A", "NEGRONI reboot mode: normal | bootloader | fastboot | recovery");
+
+/* Restart (kPERestartCPU): the reason of kern.negroni_reboot_mode (default normal = 0), then reset. */
+void
+negroni_restart(void)
+{
+	unsigned i = os_atomic_load(&nr_mode, relaxed);
+	printf("NEGRONI REBOOT: reason %s\n", nr_modes[i].name);
+	negroni_reboot(nr_modes[i].reason);
+}
+
+/* Power off. Returns only if every enabled method failed (all logged). */
+void
+negroni_power_off(void)
+{
+	if (nr_poweroff_mode != 1) {
+		printf("NEGRONI REBOOT: PMIC power off: PS_HOLD reset type SHUTDOWN\n");
+		if (nr_pon_set_type(NR_PON_TYPE_SHUTDOWN) != 0) {
+			printf("NEGRONI REBOOT: PS_HOLD reset type not set: the power off may be a reset\n");
+		}
+	}
+	if (nr_poweroff_mode != 2) {
+		printf("NEGRONI REBOOT: PSCI SYSTEM_OFF\n");
+		int64_t rc = nr_psci(PSCI_SYSTEM_OFF);
+		printf("NEGRONI REBOOT: PSCI SYSTEM_OFF returned %lld\n", (long long)rc);
+		if (nr_poweroff_mode == 1) {
+			printf("NEGRONI REBOOT: no power off (negronipoweroff=1: SYSTEM_OFF only)\n");
+			return;
+		}
+	}
+	printf("NEGRONI REBOOT: PSCI SYSTEM_RESET drops PS_HOLD (type SHUTDOWN)\n");
+	(void)negroni_reboot_set_reason(0);
+	negroni_reboot_reset();
+}
+
+/*
+ * Panic hold (0211, rewritten by 0360). Entered from the platform expert's
+ * halt/restart hook at kPEPanicDiagnosticsDone (the panic log is complete;
+ * with debug=0x4 (DB_NMI) xnu never sends kPEPanicRestartCPU, it spins in
+ * panic_spin_forever()), or at kPEPanicRestartCPU. Never returns.
+ *   - The panic text stays on the screen. negronipanic=N > 0: after N s
+ *     (busy wait on mach_absolute_time, no timer, no WFE) reset with reason
+ *     negronipanicreason. negronipanic=0 (default): no timed reset.
+ *   - USB (negroni_usb.c): the console ring with the panic log goes to
+ *     the host (UDP 5140) and the command server answers on UDP 5141:
+ *     ping, log, reboot, bootloader, recovery, poweroff. A command runs
+ *     500 ms after it arrived, so its reply and the last lines go out.
+ * A nested entry (a panic inside this loop or the USB code) skips USB and
+ * keeps only the timed reset.
+ */
+void
+negroni_panic_restart(void)
+{
+	static int entries;
+	bool first = entries++ == 0;
+	uint64_t sec, half, now, reset_at = UINT64_MAX, act_at = 0;
+	int pending = -1;
+
+	nr_in_panic = true;
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sec);
+	nanoseconds_to_absolutetime(500 * NSEC_PER_MSEC, &half);
+	now = mach_absolute_time();
+	if (nr_panic_secs > 0) {
+		reset_at = now + (uint64_t)nr_panic_secs * sec;
+	}
+	bool usb = first && negroni_usb_panic_begin();
+	if (nr_panic_secs > 0) {
+		kdb_printf("NEGRONI PANIC: reset in %d s (boot-arg negronipanic), reason %d%s\n",
+		    nr_panic_secs, nr_panic_reason, first ? "" : " (nested panic: no USB)");
+	} else {
+		kdb_printf("NEGRONI PANIC: staying on the panic screen (negronipanic=0)%s\n",
+		    usb ? "; reset with: op10tool ctl bootloader" : (first ? "" : " (nested panic: no USB)"));
+	}
+	for (;;) {
+		now = mach_absolute_time();
+		if (usb) {
+			int a = negroni_usb_panic_service(pending >= 0);
+			if (a >= 0 && pending < 0) {
+				pending = a;
+				act_at = now + half;
+			}
+		}
+		if (pending >= 0 && now >= act_at) {
+			int a = pending;
+			pending = -1;
+			if (a == NEGRONI_PANIC_ACT_POWEROFF) {
+				kdb_printf("NEGRONI PANIC: power off (USB command)\n");
+				negroni_bootlog_end(0x10 | 3, "power off (USB command in panic mode)");
+				negroni_power_off();
+				kdb_printf("NEGRONI PANIC: power off failed\n");
+			} else {
+				kdb_printf("NEGRONI PANIC: reset, reason %d (USB command)\n", a);
+				negroni_bootlog_end(0x10 | 4, a == 2 ? "reset to fastboot (USB command in panic mode)" :
+				    "reset (USB command in panic mode)");
+				negroni_reboot((unsigned)a);
+				kdb_printf("NEGRONI PANIC: reset failed\n");
+			}
+		}
+		if (now >= reset_at) {
+			reset_at = UINT64_MAX;
+			kdb_printf("NEGRONI PANIC: %d s over: reset, reason %d\n", nr_panic_secs, nr_panic_reason);
+			negroni_bootlog_end(0x10 | 4, "timed reset (negronipanic)");
+			negroni_reboot((unsigned)nr_panic_reason);
+			kdb_printf("NEGRONI PANIC: reset failed\n");
+		}
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_rpmh.c b/bsd/dev/negroni_rpmh.c
new file mode 100644
index 0000000..25c410d
--- /dev/null
+++ b/bsd/dev/negroni_rpmh.c
@@ -0,0 +1,1052 @@
+/*
+ * NEGRONI SM8450 apps-DRV2 regulator votes (touch and QCA6490 supplies).
+ * Sole XNU apps-DRV owner, called from thread context with deep idle disabled.
+ * No sleep/wake programming, SPMI writes, GIC handler, or timeout recovery.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int negroni_rpmh_vreg_enable(const char *res, unsigned mv);
+int negroni_rpmh_wifi_enable(const char *res, unsigned mv);
+int negroni_rpmh_arc_vote(const char *res, unsigned level);
+
+/* Live downstream DT has two positional reg entries, no reg-names. */
+/* SM8450 apps_rsc drv-2 (sm8450.dtsi rsc@17a00000: tcs-offset 0xd00, ACTIVE 3, SLEEP 2, WAKE 2, CONTROL 0) */
+#define RH_RSC_PA       0x17a20000u
+#define RH_TCS_PA       0x17a20d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DB_PA        0x80860000u     /* aop_cmd_db_mem, reserved memory */
+#define RH_DB_SIZE      0x20000u
+#define RH_DRV          2u
+#define RH_ACTIVE_N     3u
+#define RH_NORMAL_N     7u
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   0x14u
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT         0x10u
+#define RH_CONTROL      0x14u
+#define RH_STATUS       0x18u
+#define RH_ENABLE       0x1cu
+#define RH_MSGID        0x30u
+#define RH_ADDR         0x34u
+#define RH_DATA         0x38u
+#define RH_CMD_STATUS   0x3cu
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+#define RH_ISSUED       (1u << 8)
+#define RH_COMPLETE     (1u << 16)
+#define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC     0x0c0330dbu
+#define RH_DB_HEADER    144u
+#define RH_DB_ENTRY     24u
+#define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
+#define RH_VRM          4u
+#define RH_ARC          3u
+#define RH_MODE_ARC     (-2)    /* rh_send: one ARC command, data = level index (hlvl) */
+#define RH_MODE_OFF     (-3)    /* rh_send: one VRM command, enable (+4) = 0 (0311 camera power-down) */
+#define RH_BCM          5u      /* cmd-db slave type BCM (Linux cmd-db.c CMD_DB_HW_BCM) */
+#define RH_MODE_BCM     (-4)    /* rh_send: one BCM command, data = the BCM_TCS_CMD word (0312 camera NoC votes) */
+#define RH_TIMEOUT_US   100000u
+
+static vm_offset_t rh_rsc, rh_tcs, rh_db;
+static uint32_t rh_db_size;
+static unsigned rh_ncpt;
+static unsigned rh_lock;
+static bool rh_poisoned;
+
+/*
+ * 0383: SLEEP and WAKE sets of this DRV (boot-arg negronirpmh_sleep, default 0 = never written). Forward
+ * declarations; the code is at the end of this file.
+ */
+#include <pexpert/pexpert.h>
+static void rh_sleep_init(void);
+static void rh_note_vote(uint32_t address, const uint32_t *offsets, const uint32_t *values, unsigned ncmd, int mode);
+static bool rh_keepalive;       /* negroni_rpmh_qup_bcm: this BCM vote is the keepalive minimum (Linux: sleep 0) */
+
+static uint32_t
+rh_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v;
+	__asm__ volatile("ldr %w0, [%1]" : "=r" (v) : "r" (base + off) : "memory");
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+rh_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	__asm__ volatile("str %w0, [%1]" : : "r" (value), "r" (base + off) : "memory");
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+rh_sync(uint32_t off, uint32_t value)
+{
+	rh_write(rh_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (rh_read(rh_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("NEGRONI RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, rh_read(rh_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+rh_db16(uint32_t off)
+{
+	uint32_t v = rh_read(rh_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+rh_range(uint32_t off, uint32_t size)
+{
+	return off <= rh_db_size && size <= rh_db_size - off;
+}
+
+static int
+rh_map(void)
+{
+	if (!rh_rsc) {
+		rh_rsc = ml_io_map(RH_RSC_PA, 0x100);
+	}
+	if (!rh_tcs) {
+		rh_tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	}
+	if (!rh_rsc || !rh_tcs) {
+		printf("NEGRONI RPMH: RSC/locator mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = rh_read(rh_rsc, 0);
+	uint32_t solver = rh_read(rh_rsc, 4);
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	rh_ncpt = (config >> 27) & 0x1fu;
+	printf("NEGRONI RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, rh_ncpt);
+	/* This client implements the pre-v3 layout only; do not guess v3 offsets. */
+	if ((major != 1 && major != 2) || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < RH_NORMAL_N ||
+	    count > RH_TCS_SIZE / RH_TCS_STRIDE || rh_ncpt < 3 || rh_ncpt > 16) {
+		printf("NEGRONI RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	if (!rh_db) {
+		rh_db = ml_io_map(RH_DB_PA, RH_DB_SIZE);
+		if (!rh_db) {
+			return ENOMEM;
+		}
+		rh_db_size = RH_DB_SIZE;
+	}
+	uint32_t db_version = rh_read(rh_db, 0);
+	uint32_t magic = rh_read(rh_db, 4);
+	uint32_t flags = rh_read(rh_db, 140);
+	printf("NEGRONI RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, rh_read(rh_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("NEGRONI RPMH: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	rh_sleep_init();        /* 0383: once: read-only TCS dump, sleep/wake set mode */
+	return 0;
+}
+
+static int
+rh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			printf("NEGRONI RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			if (slave != RH_VRM || (addr >> 16) != RH_VRM || (addr & 15u) ||
+			    !rh_range(aux + rh_db16(e + 22), rh_db16(e + 20))) {
+				printf("NEGRONI RPMH: invalid VRM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("NEGRONI RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, rh_db16(h + 8),
+			    rh_read(rh_db, e + 8), rh_read(rh_db, e + 12));
+		}
+	}
+	if (matches != 1) {
+		printf("NEGRONI RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static bool
+rh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	uint32_t idle = rh_read(rh_tcs, b + RH_STATUS);
+	uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+	if (!idle || idle == 0xffffffffu || (rh_read(rh_tcs, b + RH_CONTROL) & RH_TRIGGER) ||
+	    (enabled & ~((1u << rh_ncpt) - 1u))) {
+		return false;
+	}
+	/* UEFI retains completed ACTIVE commands. Never reuse pending requests. */
+	for (unsigned c = 0; c < rh_ncpt; ++c) {
+		if (enabled & (1u << c)) {
+			uint32_t status = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			if (status == 0xffffffffu || (status & (RH_ISSUED | RH_COMPLETE)) != (RH_ISSUED | RH_COMPLETE)) {
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+static int
+rh_send(uint32_t address, unsigned mv, int mode)
+{
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = rh_read(rh_tcs, b + RH_ENABLE);
+		printf("NEGRONI RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL),
+		    enabled, rh_read(rh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << rh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < rh_ncpt; ++c) {
+			if (!rh_free(t) && (enabled & (1u << c)) &&
+			    (rh_read(rh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				printf("NEGRONI RPMH: conflicting inherited request for %#x in TCS%u\n", address, t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && rh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("NEGRONI RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = rh_read(rh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !rh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!rh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		rh_poisoned = true;
+		return EIO;
+	}
+	if (!rh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			rh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	rh_poisoned = true;
+	/* Consume only our proven-idle slot's inherited completion before reuse. */
+	if (!rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit);
+	if (rh_read(rh_tcs, RH_IRQ_STATUS) & bit) {
+		return EIO;
+	}
+	/* voltage, optional mode, enable last (VRM: +0 voltage mV, +4 enable, +8 mode) */
+	uint32_t offsets[3] = {0, 8, 4}, values[3] = {mv, (uint32_t)mode, 1};
+	unsigned ncmd = 3;
+	if (mode == RH_MODE_ARC) {
+		ncmd = 1;               /* ARC (rpmhpd): +0 = level index */
+	} else if (mode == RH_MODE_BCM) {
+		ncmd = 1;               /* BCM: +0 = commit | valid | vote_x | vote_y (tcs.h BCM_TCS_CMD) */
+	} else if (mode == RH_MODE_OFF) {
+		offsets[0] = 4;         /* VRM enable = 0: drops only this DRV's enable vote */
+		values[0] = 0;
+		ncmd = 1;
+	} else if (mode < 0) {
+		offsets[1] = 4;
+		values[1] = 1;
+		ncmd = 2;
+	}
+	uint32_t cmdmask = (1u << ncmd) - 1u;
+	printf("NEGRONI RPMH: TCS%u ACTIVE %u mV mode=%d enable=%u irq-enable=%#x\n", t, mv, mode,
+	    mode == RH_MODE_OFF ? 0u : 1u, irq_en);
+	for (unsigned c = 0; c < ncmd; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!rh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !rh_sync(cmd + RH_ADDR, address + offsets[c]) ||
+		    !rh_sync(cmd + RH_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!rh_sync(b + RH_WAIT, cmdmask) || !rh_sync(b + RH_ENABLE, cmdmask) ||
+	    !rh_sync(b + RH_CONTROL, 0) || !rh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = rh_read(rh_tcs, RH_IRQ_STATUS);
+		idle = rh_read(rh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < ncmd; ++c) {
+			status[c] = rh_read(rh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("NEGRONI RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, rh_read(rh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("NEGRONI RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!rh_sync(b + RH_CONTROL, RH_AMC_EN) || !rh_sync(b + RH_CONTROL, 0) ||
+	    !rh_sync(b + RH_ENABLE, 0) || !rh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	rh_write(rh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((rh_read(rh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !rh_sync(RH_IRQ_EN, (rh_read(rh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	rh_poisoned = false;
+	printf("NEGRONI RPMH: ACTIVE vote for %#x complete\n", address);
+	rh_note_vote(address, offsets, values, ncmd, mode);     /* 0383: cache + SLEEP/WAKE sets */
+	return 0;
+}
+
+static int
+rh_vreg_enable(const char *res, unsigned mv, int mode)
+{
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (rh_poisoned) {
+		printf("NEGRONI RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, &address);
+	}
+	if (!error) {
+		error = rh_send(address, mv, mode);
+	}
+out:
+	if (error) {
+		printf("NEGRONI RPMH: enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+int
+negroni_rpmh_vreg_enable(const char *res, unsigned mv)
+{
+	if (!res || strcmp(res, "ldoc11") || mv < 2950 || mv > 3400) {
+		return EINVAL;
+	}
+	return rh_vreg_enable(res, mv, 7);
+}
+
+/* 0350: the off vote for the same rail (one VRM command, enable = 0). */
+int negroni_rpmh_vreg_disable(const char *res);
+int
+negroni_rpmh_vreg_disable(const char *res)
+{
+	if (!res || strcmp(res, "ldoc11")) {
+		return EINVAL;
+	}
+	return rh_vreg_enable(res, 0, RH_MODE_OFF);
+}
+
+/*
+ * 0372: APPS (DRV 2) ACTIVE votes for the USB PHY supply rails, as Linux does: the rpmh-regulator
+ * probe sends qcom,init-voltage / qcom,init-mode (HPM) for every rail with qcom,set = 3, and the
+ * HS PHY driver enables vdd / vdda18 / vdda33 (live.dts hsphy@88e3000: vdd-supply = pm8350_l5,
+ * vdda18-supply = pm8350c_l1, vdda33-supply = pm8350_l2; ssphy core-supply = pm8350_l6). The
+ * ADSP votes the same four rails from its own DRV (adsp.b14 "/pm/ldob2/en", "/pm/ldob5/mode", ...)
+ * for its BC1.2/APSD detection; with no APPS vote the aggregate is the ADSP's vote alone.
+ * Values from live.dts (init-voltage). Mode 7 = PMIC5 LDO HPM (the ldoc11 vote above uses it too).
+ * Returns a mask of the rails whose vote failed (bit i = rail i), 0 = all four voted.
+ */
+int negroni_rpmh_usb_rails(void);
+int
+negroni_rpmh_usb_rails(void)
+{
+	static const struct { const char *res; unsigned mv; } rails[] = {
+		{ "ldob5", 880 },       /* pm8350_l5: hsphy vdd */
+		{ "ldoc1", 1800 },      /* pm8350c_l1: hsphy vdda18 */
+		{ "ldob2", 3072 },      /* pm8350_l2: hsphy vdda33 */
+		{ "ldob6", 1200 },      /* pm8350_l6: ssphy core */
+	};
+	int failed = 0;
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); ++i) {
+		int error = EBUSY;
+		/* rh_lock is a try-lock: another rail user (camera, Wi-Fi, fingerprint) may hold it briefly */
+		for (unsigned t = 0; t < 20 && error == EBUSY; ++t) {
+			error = rh_vreg_enable(rails[i].res, rails[i].mv, 7);
+			if (error == EBUSY) {
+				delay(2000);
+			}
+		}
+		printf("NEGRONI RPMH: 0372 USB PHY rail %s %u mV HPM on: %s (errno %d)\n", rails[i].res, rails[i].mv,
+		    error ? "FAILED" : "voted", error);
+		if (error) {
+			failed |= 1 << i;
+		}
+	}
+	return failed;
+}
+
+int
+negroni_rpmh_wifi_enable(const char *res, unsigned mv)
+{
+	/* Downstream QCA6490 supply voltages, also inside mainline board ranges.
+	 * SMPS votes must not inherit the touch LDO's raw high-power mode. */
+	static const struct { const char *name; unsigned mv; } rails[] = {
+		{ "smpe2", 1012 }, { "smpb11", 966 }, { "smpb10", 1800 },
+		{ "smpc1", 1900 }, { "smpb12", 1350 },
+	};
+	for (unsigned i = 0; res && i < sizeof(rails) / sizeof(rails[0]); i++) {
+		if (!strcmp(res, rails[i].name) && mv == rails[i].mv) {
+			return rh_vreg_enable(res, mv, -1);
+		}
+	}
+	return EINVAL;
+}
+
+/*
+ * 0311 (iOSPlus10): camera sensor rails of slot 0 (IMX789; bsd/dev/negroni_cam.c has the live DT lines).
+ * Only these resources, each with its one DT voltage and mode, are accepted: on = voltage (+ mode) +
+ * enable; off = enable 0 only (any voltage/mode argument is ignored).
+ */
+int negroni_rpmh_cam_rail(const char *res, unsigned mv, int mode, bool on);
+
+int
+negroni_rpmh_cam_rail(const char *res, unsigned mv, int mode, bool on)
+{
+	static const struct { const char *name; unsigned mv; int mode; } rails[] = {
+		{ "ldoi3", 2800, -1 },  /* cam_vana pm8010i_l3, no modes */
+		{ "ldoi1", 1104, 7 },   /* cam_vdig pm8010i_l1, HPM */
+		{ "ldoc2", 1800, 7 },   /* cam_vio pm8350c_l2, HPM */
+		{ "ldoi7", 2800, -1 },  /* cam_vaf pm8010i_l7, no modes */
+		{ "ldoi5", 1800, 7 },   /* cam_v_custom1 pm8010i_l5, HPM */
+	};
+	for (unsigned i = 0; res && i < sizeof(rails) / sizeof(rails[0]); i++) {
+		if (strcmp(res, rails[i].name)) {
+			continue;
+		}
+		if (!on) {
+			return rh_vreg_enable(res, 0, RH_MODE_OFF);
+		}
+		if (mv == rails[i].mv && mode == rails[i].mode) {
+			return rh_vreg_enable(res, mv, mode);
+		}
+		printf("NEGRONI RPMH: camera rail %s: %u mV mode %d refused (allowed %u mV mode %d)\n", res, mv, mode,
+		    rails[i].mv, rails[i].mode);
+		return EINVAL;
+	}
+	return EINVAL;
+}
+
+/*
+ * ARC (rpmhpd) resource: address and the level index (hlvl) of the first cmd-db
+ * level >= `level` (Linux rpmhpd_update_level_mapping / rpmhpd_aggregate_corner).
+ */
+static int
+rh_lookup_arc(const char *res, unsigned level, uint32_t *address, unsigned *hlvl)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave != RH_ARC || (entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			continue;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			uint32_t data = aux + rh_db16(e + 22), len = rh_db16(e + 20);
+			if ((addr >> 16) != RH_ARC || (addr & 15u) || len < 2 || len > 32 || !rh_range(data, len)) {
+				printf("NEGRONI RPMH: invalid ARC entry for %s\n", res);
+				return EINVAL;
+			}
+			for (unsigned l = 0; l < len / 2; ++l) {
+				unsigned v = rh_db16(data + 2 * l);
+				printf("NEGRONI RPMH: %s addr=%#x hlvl %u = vlvl %u\n", res, addr, l, v);
+				if (v >= level) {
+					*address = addr;
+					*hlvl = l;
+					return 0;
+				}
+				if (l > 0 && v == 0) {
+					break;
+				}
+			}
+			printf("NEGRONI RPMH: %s has no level >= %u\n", res, level);
+			return ERANGE;
+		}
+	}
+	printf("NEGRONI RPMH: no ARC resource %s\n", res);
+	return ENODEV;
+}
+
+/*
+ * Level vote on an LPASS rail for the audio DSP start (negroni_adsp.c; Linux
+ * qcom_q6v5_pas proxy votes on the lcx/lmx power domains). level 0 drops the vote.
+ * 0312 (iOSPlus10, negroni_cam.c): also mmcx.lvl up to NOM (256) for the camcc titan GDSC (its parent
+ * pm8350c_s2_mmcx_voter_level, live DT) and mxc.lvl up to NOM (256) for the camcc PLL calibration.
+ */
+int
+negroni_rpmh_arc_vote(const char *res, unsigned level)
+{
+	if (!res || (strcmp(res, "lcx.lvl") && strcmp(res, "lmx.lvl") && strcmp(res, "mmcx.lvl") && strcmp(res, "mxc.lvl")) ||
+	    level > 416 || (strcmp(res, "mmcx.lvl") == 0 && level > 256) || (strcmp(res, "mxc.lvl") == 0 && level > 256)) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	unsigned hlvl = 0;
+	if (rh_poisoned) {
+		printf("NEGRONI RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_arc(res, level, &address, &hlvl);
+	}
+	if (!error) {
+		printf("NEGRONI RPMH: ARC %s level %u -> hlvl %u\n", res, level, hlvl);
+		error = rh_send(address, hlvl, RH_MODE_ARC);
+	}
+out:
+	if (error) {
+		printf("NEGRONI RPMH: ARC vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * 0312 (iOSPlus10): bus (BCM) votes of the camera paths, as Linux icc-rpmh/bcm-voter.c computes them for
+ * one node per BCM: vote_x = avg * width / (buswidth * channels) * 1000 / unit, vote_y = peak * width /
+ * buswidth * 1000 / unit (kBps; width and unit from the cmd-db aux data {u32 unit, u16 width, u8 vcd}),
+ * clamped to 14 bits; a BCM with an enable_mask (CN0, MM1) gets x = 0, y = 1 (:99-101). One AMC command, commit set.
+ * Only the five BCMs of the camera paths, at most 3,000,000 kBps (the DT camnoc-axi-min-ib-bw 3e9 B/s).
+ */
+int negroni_rpmh_cam_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uint32_t buswidth, uint32_t channels,
+    bool enable_mask, uint32_t *data_out);
+
+static int
+rh_lookup_bcm(const char *res, uint32_t *address, uint32_t *unit, uint32_t *width)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave != RH_BCM || (entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			continue;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16), data = aux + rh_db16(e + 22), len = rh_db16(e + 20);
+			if ((addr >> 16) != RH_BCM || (addr & 3u) || len < 8 || !rh_range(data, len)) {
+				printf("NEGRONI RPMH: invalid BCM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			*unit = rh_db16(data) | (uint32_t)rh_db16(data + 2) << 16;
+			*width = rh_db16(data + 4);
+			printf("NEGRONI RPMH: BCM %s addr=%#x unit=%u width=%u\n", res, addr, *unit, *width);
+			return (*unit == 0 || *width == 0) ? EINVAL : 0;
+		}
+	}
+	printf("NEGRONI RPMH: no BCM %s in cmd-db\n", res);
+	return ENODEV;
+}
+
+int
+negroni_rpmh_cam_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uint32_t buswidth, uint32_t channels,
+    bool enable_mask, uint32_t *data_out)
+{
+	if (!res || (strcmp(res, "CN0") && strcmp(res, "MM1") && strcmp(res, "MM0") && strcmp(res, "SH0") &&
+	    strcmp(res, "MC0")) || avg_kbps > 3000000u || peak_kbps > 3000000u || buswidth == 0 || channels == 0) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, unit = 0, width = 0;
+	if (rh_poisoned) {
+		printf("NEGRONI RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_bcm(res, &address, &unit, &width);
+	}
+	if (!error) {
+		uint64_t x = 0, y = 1;
+		if (!enable_mask) {
+			x = (uint64_t)avg_kbps * width / ((uint64_t)buswidth * channels) * 1000u / unit;
+			y = (uint64_t)peak_kbps * width / buswidth * 1000u / unit;
+		}
+		x = MIN(x, 0x3fffull);
+		y = MIN(y, 0x3fffull);
+		uint32_t data = 1u << 30 | 1u << 29 | (uint32_t)x << 14 | (uint32_t)y;
+		printf("NEGRONI RPMH: BCM %s avg %u peak %u kBps -> x %llu y %llu, data %#x\n", res, avg_kbps, peak_kbps, x, y, data);
+		if (data_out) {
+			*data_out = data;
+		}
+		error = rh_send(address, data, RH_MODE_BCM);
+	}
+out:
+	if (error) {
+		printf("NEGRONI RPMH: BCM vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/* Read-only cmd-db lookup of a VRM resource address (Wi-Fi survey, negroni_wifi.c). */
+int negroni_rpmh_lookup(const char *res, uint32_t *address);
+
+int
+negroni_rpmh_lookup(const char *res, uint32_t *address)
+{
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, address);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+/*
+ * QCA6490 Bluetooth supplies (negroni_bt.c, patch 0330): live DT bt_qca6490 qcom,bt-vdd-*-supply and
+ * -config (min = max voltage): aon/dig pm8350_s11, rfa1 pm8350c_s1, rfa2 pm8350_s12, asd pmr735a_l7.
+ * Voltage + enable only (no mode), as the Wi-Fi SMPS votes. Never voted off (shared rails).
+ */
+int negroni_rpmh_bt_enable(const char *res, unsigned mv);
+
+int
+negroni_rpmh_bt_enable(const char *res, unsigned mv)
+{
+	static const struct { const char *name; unsigned mv; } rails[] = {
+		{ "smpb11", 966 }, { "smpc1", 1900 }, { "smpb12", 1350 }, { "ldoe7", 2800 },
+	};
+	for (unsigned i = 0; res && i < sizeof(rails) / sizeof(rails[0]); i++) {
+		if (!strcmp(res, rails[i].name) && mv == rails[i].mv) {
+			return rh_vreg_enable(res, mv, -1);
+		}
+	}
+	return EINVAL;
+}
+
+/*
+ * 0334 (iOSPlus10): the QUP core BCM vote of a GENI serial engine (negroni_bt.c step 4). Linux: the SE's
+ * "qup-core" icc path qupN_core_master -> qupN_core_slave (drivers/interconnect/qcom/sm8450.c: clk_virt,
+ * bcm_qupN "QUPN", keepalive, vote_scale 1, slave buswidth 4, 1 channel), set by geni_icc_enable. Vote as
+ * bcm-voter.c bcm_aggregate: x = div(avg * width, buswidth * channels) * vote_scale / unit, y = div(peak *
+ * width, buswidth) * vote_scale / unit, a non-zero value below 1 rounds up to 1 (bcm_div), 14-bit clamp;
+ * keepalive: never 0. Width and unit come from the cmd-db aux data. One AMC command, commit set.
+ * The AMC vote of this DRV only adds to the other voters (the BCM takes the max), so it never lowers the
+ * QUP clock. Never voted off.
+ */
+int negroni_rpmh_qup_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uint32_t *data_out);
+
+static uint64_t
+rh_bcm_div(uint64_t num, uint64_t base)
+{
+	if (!num) {
+		return 0;
+	}
+	if (num < base) {
+		return 1;
+	}
+	return num / base;
+}
+
+int
+negroni_rpmh_qup_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uint32_t *data_out)
+{
+	if (!res || (strcmp(res, "QUP0") && strcmp(res, "QUP1") && strcmp(res, "QUP2")) || avg_kbps > 100000u ||
+	    peak_kbps > 100000u) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, unit = 0, width = 0;
+	if (rh_poisoned) {
+		printf("NEGRONI RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_bcm(res, &address, &unit, &width);
+	}
+	if (!error) {
+		const uint64_t buswidth = 4, channels = 1, vote_scale = 1;
+		uint64_t x = rh_bcm_div(rh_bcm_div((uint64_t)avg_kbps * width, buswidth * channels) * vote_scale, unit);
+		uint64_t y = rh_bcm_div(rh_bcm_div((uint64_t)peak_kbps * width, buswidth) * vote_scale, unit);
+		if (x == 0 && y == 0) {
+			x = y = 1;      /* keepalive */
+			rh_keepalive = true;    /* 0383: Linux bcm-voter keepalive is AMC + WAKE only: sleep 0 */
+		}
+		x = MIN(x, 0x3fffull);
+		y = MIN(y, 0x3fffull);
+		uint32_t data = 1u << 30 | 1u << 29 | (uint32_t)x << 14 | (uint32_t)y;
+		printf("NEGRONI RPMH: BCM %s avg %u peak %u kBps (unit %u width %u) -> x %llu y %llu, data %#x\n", res,
+		    avg_kbps, peak_kbps, unit, width, x, y, data);
+		if (data_out) {
+			*data_out = data;
+		}
+		error = rh_send(address, data, RH_MODE_BCM);
+	}
+out:
+	rh_keepalive = false;
+	if (error) {
+		printf("NEGRONI RPMH: BCM %s vote failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * 0383 (iOSPlus10): SLEEP and WAKE sets of the apps DRV 2, as Linux drivers/soc/qcom/rpmh.c (cache_rpm_request,
+ * _rpmh_flush, is_req_valid) and rpmh-rsc.c (rpmh_probe_tcs_config, tcs_invalidate, find_slots, __tcs_buffer_write).
+ *
+ * The RSC of this DRV has no HW solver (DRV_SOLVER_CONFIG bit 24 = 0: solver=0x4010100 on the phone), so the
+ * hardware sends the SLEEP TCS commands when the APSS goes to its deepest state (the cluster collapse) and the WAKE
+ * TCS commands when it comes back, before a CPU runs. Linux writes them at the cluster power-domain PRE_OFF
+ * (rpmh_rsc_pd_cb, live.dts rsc@17a00000 power-domains = cluster-pd). Here they are written at once in thread
+ * context, after every ACTIVE vote that changes the cache (under rh_lock; the APSS is awake then, so the hardware
+ * does not run them while we write). The idle path only asks negroni_rpmh_sleep_ready() (no MMIO writes).
+ *
+ * TCS layout: live.dts qcom,tcs-config = <2 3> <0 2> <1 2> <3 0> <4 1> = ACTIVE 3, SLEEP 2, WAKE 2, CONTROL 0,
+ * FAST_PATH 1, numbered in that order: TCS 0-2 ACTIVE, 3-4 SLEEP, 5-6 WAKE, 7 FAST_PATH; 16 commands per TCS.
+ *
+ * Linux puts a request into the sets only when its sleep value differs from its wake value (is_req_valid). Our votes:
+ *   VRM rails (touch, Wi-Fi, BT, USB PHY, camera): Linux qcom,set = 3 = the same value in both sets -> not written.
+ *   ARC levels (lcx/lmx/mmcx/mxc), BCM bandwidth: rpmhpd non-AO / icc tag ALWAYS = the same value -> not written,
+ *     except negronirpmh_sleep=2 (ours, not Linux): sleep = level 0 / bandwidth 0.
+ *   BCM keepalive-only vote (QUP x = y = 1 for 0 kBps): bcm-voter keepalive covers AMC + WAKE only -> sleep 0.
+ * WAKE = the ACTIVE value. Sleep commands are fire-and-forget, wake commands need a response (Linux send_single).
+ *
+ * Boot-arg negronirpmh_sleep: 0 (default) = the sets are never written (as before 0383); 1 = Linux rules above;
+ * 2 = + ARC level 0 and BCM 0 in sleep for every ARC/BCM vote of this DRV.
+ */
+#define RH_TCS_COUNT    8u
+#define RH_SLEEP_TCS0   3u
+#define RH_WAKE_TCS0    5u
+#define RH_FAST_TCS     7u
+#define RH_SW_N         2u              /* TCS per set */
+#define RH_CACHE_MAX    48u
+#define RH_MSG_FIRE     (8u | (1u << 16))               /* CMD_MSGID_LEN | CMD_MSGID_WRITE */
+#define RH_MSG_RESP     (8u | (1u << 8) | (1u << 16))   /* + CMD_MSGID_RESP_REQ */
+#define RH_BCM_SLEEP0   (1u << 30)                      /* BCM_TCS_CMD(commit, !valid, 0, 0): bcm-voter tcs_cmd_gen */
+
+enum { RH_K_SAME = 0, RH_K_ARC, RH_K_BCM, RH_K_KEEPALIVE };
+
+struct rh_entry {
+	uint32_t addr, wake;
+	uint8_t kind;
+};
+
+static struct rh_entry rh_cache[RH_CACHE_MAX];
+static unsigned rh_ncache;
+static uint32_t rh_sleep_mode;
+static bool rh_sleep_inited, rh_sw_ok, rh_sw_broken, rh_dirty;
+static uint32_t rh_flushes, rh_flush_fail, rh_nsleep, rh_cache_full, rh_busy_idle;
+
+bool negroni_rpmh_sleep_ready(void);
+void negroni_rpmh_sleep_log(void);
+
+static uint32_t
+rh_sleep_value(const struct rh_entry *e)
+{
+	switch (e->kind) {
+	case RH_K_KEEPALIVE:
+		return RH_BCM_SLEEP0;
+	case RH_K_BCM:
+		return rh_sleep_mode >= 2 ? RH_BCM_SLEEP0 : e->wake;
+	case RH_K_ARC:
+		return rh_sleep_mode >= 2 ? 0u : e->wake;
+	default:
+		return e->wake;
+	}
+}
+
+/* Once, under rh_lock, after the first good rh_map(): a read-only dump of all 8 TCS and the mode. */
+static void
+rh_sleep_init(void)
+{
+	if (rh_sleep_inited) {
+		return;
+	}
+	rh_sleep_inited = true;
+	(void)PE_parse_boot_argn("negronirpmh_sleep", &rh_sleep_mode, sizeof(rh_sleep_mode));
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	bool inherited = false;
+	for (unsigned t = 0; t < RH_TCS_COUNT && t < count; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE, en = rh_read(rh_tcs, b + RH_ENABLE);
+		const char *kind = t < RH_ACTIVE_N ? "ACTIVE" : t < RH_WAKE_TCS0 ? "SLEEP" : t < RH_FAST_TCS ? "WAKE" : "FAST";
+		printf("NEGRONI RPMH: 0383 TCS%u %s status %#x control %#x enable %#x wait %#x\n", t, kind,
+		    rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL), en, rh_read(rh_tcs, b + RH_WAIT));
+		for (unsigned c = 0; c < rh_ncpt && c < 16; ++c) {
+			if (!(en & (1u << c))) {
+				continue;
+			}
+			uint32_t cb = b + c * RH_CMD_STRIDE;
+			printf("NEGRONI RPMH: 0383 TCS%u cmd%u msgid %#x addr %#x data %#x status %#x\n", t, c,
+			    rh_read(rh_tcs, cb + RH_MSGID), rh_read(rh_tcs, cb + RH_ADDR), rh_read(rh_tcs, cb + RH_DATA),
+			    rh_read(rh_tcs, cb + RH_CMD_STATUS));
+			if (t >= RH_SLEEP_TCS0 && t < RH_FAST_TCS) {
+				inherited = true;
+			}
+		}
+	}
+	const char *why = NULL;
+	if (rh_sleep_mode == 0) {
+		why = "negronirpmh_sleep=0 (default)";
+	} else if (count != RH_TCS_COUNT || rh_ncpt != 16) {
+		why = "TCS geometry is not the live DT one (8 TCS, 16 commands)";
+	} else if (inherited) {
+		why = "the boot chain left SLEEP/WAKE commands: not touched";
+	}
+	rh_sw_ok = why == NULL;
+	printf("NEGRONI RPMH: 0383 sleep/wake sets %s (mode %u%s%s)\n", rh_sw_ok ? "ON" : "off", rh_sleep_mode,
+	    why ? ": " : "", why ? why : "");
+}
+
+static bool
+rh_sw_cmd(unsigned t, unsigned c, uint32_t msgid, uint32_t addr, uint32_t data)
+{
+	uint32_t cb = t * RH_TCS_STRIDE + c * RH_CMD_STRIDE;
+	return rh_sync(cb + RH_MSGID, msgid) && rh_sync(cb + RH_ADDR, addr) && rh_sync(cb + RH_DATA, data);
+}
+
+/*
+ * Under rh_lock, thread context: rewrite both sets from the cache (Linux _rpmh_flush: invalidate, then every valid
+ * request as one sleep + one wake command). WAKE commands and enables go in first, SLEEP last, so a partial write
+ * never leaves a sleep value without its wake value. On a failure the SLEEP and then the WAKE enables are cleared (empty
+ * sets change nothing); if even that fails, the cluster states stay off for this boot (negroni_rpmh_sleep_ready).
+ */
+static void
+rh_flush_sets(void)
+{
+	uint32_t wen[RH_SW_N] = { 0 }, sen[RH_SW_N] = { 0 };
+	unsigned n = 0;
+	bool ok = true;
+
+	for (unsigned i = 0; i < RH_SW_N && ok; ++i) {
+		uint32_t bs = (RH_SLEEP_TCS0 + i) * RH_TCS_STRIDE, bw = (RH_WAKE_TCS0 + i) * RH_TCS_STRIDE;
+		ok = rh_sync(bs + RH_ENABLE, 0) && rh_sync(bs + RH_WAIT, 0) && rh_sync(bw + RH_ENABLE, 0) &&
+		    rh_sync(bw + RH_WAIT, 0);
+	}
+	for (unsigned i = 0; i < rh_ncache && ok; ++i) {
+		const struct rh_entry *e = &rh_cache[i];
+		uint32_t sleep = rh_sleep_value(e);
+		if (sleep == e->wake) {
+			continue;
+		}
+		if (n >= RH_SW_N * rh_ncpt) {
+			rh_cache_full++;
+			break;
+		}
+		unsigned t = n / rh_ncpt, c = n % rh_ncpt;
+		ok = rh_sw_cmd(RH_WAKE_TCS0 + t, c, RH_MSG_RESP, e->addr, e->wake) &&
+		    rh_sw_cmd(RH_SLEEP_TCS0 + t, c, RH_MSG_FIRE, e->addr, sleep);
+		wen[t] |= 1u << c;
+		sen[t] |= 1u << c;
+		n++;
+	}
+	for (unsigned t = 0; t < RH_SW_N && ok; ++t) {
+		ok = rh_sync((RH_WAKE_TCS0 + t) * RH_TCS_STRIDE + RH_ENABLE, wen[t]);
+	}
+	for (unsigned t = 0; t < RH_SW_N && ok; ++t) {
+		ok = rh_sync((RH_SLEEP_TCS0 + t) * RH_TCS_STRIDE + RH_ENABLE, sen[t]);
+	}
+	rh_flushes++;
+	if (ok) {
+		rh_nsleep = n;
+		rh_dirty = false;
+		return;
+	}
+	rh_flush_fail++;
+	rh_sw_ok = false;
+	/*
+	 * SLEEP first, then WAKE: the sets are not rewritten after this, so a WAKE command left enabled would send a
+	 * stale value at every APSS wake and undo a later ACTIVE vote for the same resource.
+	 */
+	bool cleared = true;
+	for (unsigned t = 0; t < RH_SW_N; ++t) {
+		cleared &= rh_sync((RH_SLEEP_TCS0 + t) * RH_TCS_STRIDE + RH_ENABLE, 0);
+	}
+	for (unsigned t = 0; t < RH_SW_N; ++t) {
+		cleared &= rh_sync((RH_WAKE_TCS0 + t) * RH_TCS_STRIDE + RH_ENABLE, 0);
+	}
+	rh_sw_broken = !cleared;
+	rh_dirty = false;
+	rh_nsleep = 0;
+	printf("NEGRONI RPMH: 0383 sleep/wake set write failed: sets off for this boot, sets %s\n",
+	    cleared ? "emptied" : "NOT emptied (cluster states stay off)");
+}
+
+/* Under rh_lock after a completed ACTIVE vote: cache each command (WAKE = ACTIVE value), then rewrite the sets. */
+static void
+rh_note_vote(uint32_t address, const uint32_t *offsets, const uint32_t *values, unsigned ncmd, int mode)
+{
+	uint8_t kind = mode == RH_MODE_ARC ? RH_K_ARC : mode == RH_MODE_BCM ? (rh_keepalive ? RH_K_KEEPALIVE : RH_K_BCM) :
+	    RH_K_SAME;
+	bool changed = false;
+
+	for (unsigned c = 0; c < ncmd; ++c) {
+		uint32_t a = address + offsets[c];
+		unsigned i = 0;
+		while (i < rh_ncache && rh_cache[i].addr != a) {
+			i++;
+		}
+		if (i == rh_ncache) {
+			if (rh_ncache >= RH_CACHE_MAX) {
+				rh_cache_full++;
+				continue;
+			}
+			rh_ncache++;
+			rh_cache[i].addr = a;
+			rh_cache[i].wake = ~values[c];
+		}
+		struct rh_entry old = rh_cache[i];
+		rh_cache[i].wake = values[c];
+		rh_cache[i].kind = kind;
+		changed |= old.wake != values[c] || old.kind != kind;
+	}
+	if (!rh_sw_ok || !changed) {
+		return;
+	}
+	rh_dirty = true;
+	rh_flush_sets();
+}
+
+/*
+ * The CPU idle path (osfmk/arm64/negroni_cpuidle.c, interrupts masked), before a cluster state: false when an RPMh
+ * transaction of this DRV may be in flight or the sets are not current (Linux rpmh_rsc_ctrlr_is_busy + a failed
+ * flush = NOTIFY_BAD). Reads only; never waits.
+ */
+bool
+negroni_rpmh_sleep_ready(void)
+{
+	if (__atomic_load_n(&rh_lock, __ATOMIC_ACQUIRE) || rh_sw_broken || (rh_sw_ok && rh_dirty)) {
+		__atomic_fetch_add(&rh_busy_idle, 1, __ATOMIC_RELAXED);
+		return false;
+	}
+	vm_offset_t tcs = rh_tcs;
+	if (tcs != 0) {
+		for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+			if (rh_read(tcs, t * RH_TCS_STRIDE + RH_STATUS) == 0) {
+				__atomic_fetch_add(&rh_busy_idle, 1, __ATOMIC_RELAXED);
+				return false;
+			}
+		}
+		if (rh_read(tcs, RH_FAST_TCS * RH_TCS_STRIDE + RH_STATUS) == 0) {
+			__atomic_fetch_add(&rh_busy_idle, 1, __ATOMIC_RELAXED);
+			return false;
+		}
+	}
+	return true;
+}
+
+/* One status line (the 60 s line of negroni_cpuidle.c). */
+void
+negroni_rpmh_sleep_log(void)
+{
+	printf("NEGRONI RPMH: 0383 sleep/wake sets %s, mode %u, %u cached votes, %u sleep+wake pairs written, flushes %u "
+	    "(failed %u), cache full %u, busy at idle %u\n", rh_sw_broken ? "BROKEN" : rh_sw_ok ? "on" : "off", rh_sleep_mode,
+	    rh_ncache, rh_nsleep, rh_flushes, rh_flush_fail, rh_cache_full, rh_busy_idle);
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_rtc.c b/bsd/dev/negroni_rtc.c
new file mode 100644
index 0000000..bf14630
--- /dev/null
+++ b/bsd/dev/negroni_rtc.c
@@ -0,0 +1,563 @@
+/*
+ * NEGRONI: calendar (wall-clock) time (OnePlus 10 Pro 5G, SM8450, PMK8350).
+ *
+ * Before this file the platform expert had no getUTCTimeOfDay(): the
+ * IOPlatformExpert default returns 0, clock_initialize_calendar() then
+ * moved the "UTC" time up to the uptime, and userland saw
+ * 1969-12-31 16:xx (Pacific) = the epoch + the uptime.
+ *
+ * Sources, in this order:
+ *  1. The PMK8350 RTC (SPMI SID 0, RTC_RW peripheral 0x61, DT rtc@6100
+ *     "qcom,pmk8350-rtc"; Linux rtc-pm8xxx.c pmk8350_regs: ctrl 0x6146
+ *     bit 7 = enabled, 32-bit little-endian seconds at 0x6148..0x614b).
+ *     Read like pm8xxx_rtc_read_raw(): the 4 bytes, then byte 0 again; a
+ *     smaller byte 0 means a carry during the read, so read once more.
+ *     The DT has no "allow-set-time": like Linux and Android (time_daemon)
+ *     this code never writes the RTC. Wall time = RTC + an offset:
+ *       - boot-arg negronirtcoff=<seconds> (wins over the saved offset), or
+ *       - the offset saved in /private/var/db/negroni_rtc (below).
+ *     Boot-arg negronirtc=0: no PMIC access at all.
+ *  2. A floor: the kernel build date (00:00 UTC of __DATE__, minus one day
+ *     for the build host's time zone), or the last saved wall time if that
+ *     is later. The calendar never starts below the floor, so it is sane
+ *     even with no RTC and no offset.
+ *  3. A set from outside: settimeofday() (iOS timed, date(1)), or the host
+ *     over USB (UDP 5141 "settime", patch 0212). Both end in
+ *     clock_set_calendar_microtime() -> PESetUTCTimeOfDay() ->
+ *     negroni_rtc_set(): the new offset = time - RTC is kept in memory and
+ *     written (thread call, off the caller's thread) to
+ *     /private/var/db/negroni_rtc as text ("offset", "rtc", "wall"). At the
+ *     next boot negroni_rtc_load_saved() (bsd_init, after the root mount,
+ *     before launchd) applies it. If the RTC went backwards (counter reset)
+ *     the offset is not used; the saved wall time is a floor then.
+ *     The root is read-only until launchd remounts it: a failed write is
+ *     tried again every 30 s, 60 times.
+ * Without a readable RTC the clock is the floor + the uptime, and a set
+ * moves it (also kept in the file as the next floor).
+ *
+ * Log prefix "NEGRONI RTC:".
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/mount.h>
+#include <sys/vnode.h>
+#include <sys/vnode_if.h>
+#include <sys/kauth.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread_call.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "negroni_spmi_keys.h"
+#include "negroni_spmi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+void negroni_rtc_get(clock_sec_t *secs, clock_nsec_t *nsecs);
+void negroni_rtc_set(clock_sec_t secs, clock_nsec_t nsecs);
+void negroni_rtc_load_saved(void);
+int negroni_calendar_settime(uint64_t secs, uint32_t usecs, char *reply, size_t size);
+void negroni_calendar_describe(char *reply, size_t size);
+
+#define NC_CORE_PA      0x0c400000u     /* SPMI arbiter v7 core (APID map at +0x2000) */
+#define NC_CORE_SIZE    0x3000u
+#define NC_OBS_PA       0x0c440000u     /* observer channels, EE 0 first */
+#define NC_OBS_SIZE     0x8000u
+#define NC_CNFG_PA      0x0c42d000u     /* owner table, 4 * APID, bits 2:0 = owner EE */
+#define NC_RTC_PPID     0x061u          /* SID 0, RTC_RW 0x6100 */
+#define NC_RTC_CTRL     0x46u           /* 0x6146, bit 7 = RTC enabled */
+#define NC_RTC_READ     0x48u           /* 0x6148..0x614b, seconds, little endian */
+#define NC_RTC_ENABLE   0x80u
+
+#define NC_FILE         "/private/var/db/negroni_rtc"
+#define NC_MIN_TIME     1577836800ull   /* 2020-01-01: smaller "settime" values are refused */
+#define NC_MAX_TIME     4102444800ull   /* 2100-01-01 */
+#define NC_RETRY_S      30
+#define NC_RETRIES      60
+
+static LCK_GRP_DECLARE(nc_grp, "negroni_rtc");
+static LCK_MTX_DECLARE(nc_lock, &nc_grp);
+
+static struct {
+	bool        inited;
+	bool        rtc_ok;          /* the RTC is mapped, enabled and was read once */
+	int         apid;
+	struct sk_arbiter arb;
+	uint64_t    floor;           /* seconds */
+	bool        bootarg_off_set;
+	int64_t     bootarg_off;
+	int64_t     offset;          /* wall = RTC + offset (rtc_ok) */
+	const char *source;          /* where the current time came from (log, "time" command) */
+	uint64_t    soft_wall_ns;    /* wall time at soft_abs: the clock without the RTC */
+	uint64_t    soft_abs;
+	bool        set_this_boot;   /* settimeofday / USB settime / saved file applied */
+	bool        root_ready;      /* negroni_rtc_load_saved() ran: the file may be written */
+	bool        dirty;           /* the file does not hold the current offset */
+	unsigned    retries;
+	bool        saved_valid;     /* the file's contents (last read or written) */
+	int64_t     saved_offset;
+	uint64_t    saved_wall;
+	uint32_t    saved_rtc;
+	bool        saved_has_rtc;
+	thread_call_t persist_call;
+} nc;
+
+/* __DATE__ ("Oct 25 2026") as days since 1970-01-01; -1 if it does not parse. */
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdate-time"
+static const char nc_build_date[] = __DATE__;
+#pragma clang diagnostic pop
+
+static int64_t
+nc_days_from_civil(int64_t y, int m, int d)
+{
+	/* H. Hinnant's days_from_civil */
+	y -= m <= 2;
+	int64_t era = (y >= 0 ? y : y - 399) / 400;
+	int64_t yoe = y - era * 400;
+	int64_t doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+	int64_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	return era * 146097 + doe - 719468;
+}
+
+static int64_t
+nc_build_days(void)
+{
+	static const char months[] = "JanFebMarAprMayJunJulAugSepOctNovDec";
+	const char *s = nc_build_date;
+	int m = 0, d = 0, y = 0;
+
+	for (int i = 0; i < 12; i++) {
+		if (strncmp(s, months + 3 * i, 3) == 0) {
+			m = i + 1;
+		}
+	}
+	for (int i = 4; i < 6; i++) {
+		if (s[i] >= '0' && s[i] <= '9') {
+			d = d * 10 + (s[i] - '0');
+		}
+	}
+	for (int i = 7; i < 11; i++) {
+		if (s[i] < '0' || s[i] > '9') {
+			return -1;
+		}
+		y = y * 10 + (s[i] - '0');
+	}
+	if (m == 0 || d < 1 || d > 31 || y < 2024) {
+		return -1;
+	}
+	return nc_days_from_civil(y, m, d);
+}
+
+/* One register byte of the RTC_RW peripheral. 0 = done. */
+static int
+nc_read8(uint8_t reg, uint8_t *v)
+{
+	return sk_read8(&nc.arb, nc.apid, reg, v);
+}
+
+/* The 32-bit seconds counter, as pm8xxx_rtc_read_raw(). 0 = done. Caller holds nc_lock. */
+static int
+nc_rtc_raw(uint32_t *secs)
+{
+	uint8_t b[4], again;
+
+	for (int tries = 0; tries < 2; tries++) {
+		for (unsigned i = 0; i < 4; i++) {
+			if (nc_read8((uint8_t)(NC_RTC_READ + i), &b[i]) != 0) {
+				return -1;
+			}
+		}
+		if (nc_read8(NC_RTC_READ, &again) != 0) {
+			return -1;
+		}
+		if (again >= b[0]) {
+			*secs = (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static uint64_t
+nc_abs_ns(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns;
+}
+
+/* The clock without the RTC: soft base + the time since it was set. Caller holds nc_lock. */
+static uint64_t
+nc_soft_now_ns(void)
+{
+	return nc.soft_wall_ns + nc_abs_ns(mach_absolute_time() - nc.soft_abs);
+}
+
+static void
+nc_soft_set(uint64_t wall_ns)
+{
+	nc.soft_wall_ns = wall_ns;
+	nc.soft_abs = mach_absolute_time();
+}
+
+static void nc_persist(thread_call_param_t p0, thread_call_param_t p1);
+
+/* Once, in thread context, under nc_lock: boot-args, floor, SPMI mapping, first RTC read. */
+static void
+nc_init(void)
+{
+	int enabled = 1;
+	uint8_t ctrl = 0;
+	uint32_t raw = 0;
+
+	if (nc.inited) {
+		return;
+	}
+	nc.inited = true;
+	nc.apid = -1;
+	nc.persist_call = thread_call_allocate_with_options(nc_persist, NULL, THREAD_CALL_PRIORITY_LOW, 0);
+
+	int64_t days = nc_build_days();
+	nc.floor = days > 0 ? (uint64_t)(days - 1) * 86400ull : 1729000000ull;
+	(void)PE_parse_boot_argn("negronirtc", &enabled, sizeof(enabled));
+	nc.bootarg_off_set = PE_parse_boot_argn("negronirtcoff", &nc.bootarg_off, sizeof(nc.bootarg_off));
+
+	if (!enabled) {
+		printf("NEGRONI RTC: PMIC RTC off (negronirtc=0)\n");
+	} else {
+		/* one arbiter mapping for the RTC and the battery (bsd/dev/negroni_spmi.c, patch 0270) */
+		vm_offset_t cnfg = 0;
+		(void)negroni_spmi_arbiter(&nc.arb, &cnfg);
+		int rc = (nc.arb.core && nc.arb.obs) ? sk_find_apid(&nc.arb, NC_RTC_PPID, &nc.apid) : -1;
+		if (rc != 0) {
+			printf("NEGRONI RTC: RTC_RW 0x6100 not found on SPMI (arbiter %#x, rc %d)\n",
+			    nc.arb.core ? nc.arb.core[0] : 0, rc);
+		} else if (nc_read8(NC_RTC_CTRL, &ctrl) != 0 || nc_rtc_raw(&raw) != 0) {
+			printf("NEGRONI RTC: RTC_RW APID %d read failed\n", nc.apid);
+		} else {
+			unsigned owner = cnfg ? (*(volatile uint32_t *)(cnfg + 4u * (uint32_t)nc.apid) & 7u) : 9u;
+			printf("NEGRONI RTC: PMK8350 RTC APID %d (write owner EE %u), ctrl %#04x (%s), counter %u s\n",
+			    nc.apid, owner, ctrl, (ctrl & NC_RTC_ENABLE) ? "enabled" : "NOT enabled", raw);
+			nc.rtc_ok = (ctrl & NC_RTC_ENABLE) != 0;
+		}
+	}
+
+	uint64_t t;
+	if (nc.rtc_ok) {
+		int64_t off = nc.bootarg_off_set ? nc.bootarg_off : 0;
+		t = (uint64_t)((int64_t)raw + off);
+		nc.source = nc.bootarg_off_set ? "RTC + boot-arg negronirtcoff" : "RTC counter (no offset yet)";
+		if ((int64_t)raw + off < 0 || t < nc.floor) {
+			t = nc.floor;
+			nc.source = nc.bootarg_off_set ? "build-date floor (RTC + negronirtcoff below it)" :
+			    "build-date floor (RTC counter below it)";
+		}
+		nc.offset = (int64_t)t - (int64_t)raw;
+	} else {
+		t = nc.floor;
+		nc.source = "build-date floor (no RTC)";
+	}
+	nc_soft_set(t * NSEC_PER_SEC);
+	printf("NEGRONI RTC: boot calendar %llu s from the %s; floor %llu (build %s), offset %lld\n",
+	    t, nc.source, nc.floor, nc_build_date, nc.rtc_ok ? nc.offset : 0);
+}
+
+/* NegroniPlatformExpert::getUTCTimeOfDay(): thread context. */
+void
+negroni_rtc_get(clock_sec_t *secs, clock_nsec_t *nsecs)
+{
+	uint32_t raw;
+	uint64_t ns;
+
+	if (!preemption_enabled() || ml_at_interrupt_context()) {
+		/* cannot block (no caller does this today): the last value + the uptime, unlocked */
+		ns = nc.inited ? nc_soft_now_ns() : 0;
+		*secs = (clock_sec_t)(ns / NSEC_PER_SEC);
+		*nsecs = (clock_nsec_t)(ns % NSEC_PER_SEC);
+		return;
+	}
+	lck_mtx_lock(&nc_lock);
+	nc_init();
+	if (nc.rtc_ok && nc_rtc_raw(&raw) == 0) {
+		ns = (uint64_t)((int64_t)raw + nc.offset) * NSEC_PER_SEC;
+		nc_soft_set(ns);
+	} else {
+		ns = nc_soft_now_ns();
+	}
+	lck_mtx_unlock(&nc_lock);
+	*secs = (clock_sec_t)(ns / NSEC_PER_SEC);
+	*nsecs = (clock_nsec_t)(ns % NSEC_PER_SEC);
+}
+
+/* NegroniPlatformExpert::setUTCTimeOfDay(), from clock_set_calendar_microtime(): may block. */
+void
+negroni_rtc_set(clock_sec_t secs, clock_nsec_t nsecs)
+{
+	uint32_t raw;
+	bool schedule;
+
+	lck_mtx_lock(&nc_lock);
+	nc_init();
+	int64_t before = nc.offset;
+	nc_soft_set((uint64_t)secs * NSEC_PER_SEC + nsecs);
+	if (nc.rtc_ok && nc_rtc_raw(&raw) == 0) {
+		nc.offset = (int64_t)secs - (int64_t)raw;
+		if (nc.offset - before > 1 || before - nc.offset > 1) {
+			printf("NEGRONI RTC: time set to %lu s: RTC %u, offset %lld (was %lld)\n",
+			    (unsigned long)secs, raw, nc.offset, before);
+		}
+	} else {
+		printf("NEGRONI RTC: time set to %lu s (no RTC: clock from the uptime)\n", (unsigned long)secs);
+	}
+	nc.source = "set (settimeofday or USB settime)";
+	nc.set_this_boot = true;
+	nc.dirty = true;
+	nc.retries = 0;
+	schedule = nc.root_ready && nc.persist_call != NULL;
+	lck_mtx_unlock(&nc_lock);
+	if (schedule) {
+		thread_call_enter(nc.persist_call);
+	}
+}
+
+/* Parses "key value" lines of the file. */
+static void
+nc_parse(char *text)
+{
+	char *p = text;
+
+	nc.saved_valid = false;
+	nc.saved_has_rtc = false;
+	nc.saved_wall = 0;
+	nc.saved_offset = 0;
+	if (strncmp(p, "negroni-rtc 1\n", 14) != 0) {
+		return;
+	}
+	while (*p != 0) {
+		char *key = p;
+		while (*p != 0 && *p != ' ' && *p != '\n') {
+			p++;
+		}
+		if (*p != ' ') {
+			if (*p == '\n') {
+				p++;
+			}
+			continue;
+		}
+		*p++ = 0;
+		bool neg = *p == '-';
+		if (neg) {
+			p++;
+		}
+		uint64_t v = 0;
+		while (*p >= '0' && *p <= '9') {
+			v = v * 10 + (uint64_t)(*p++ - '0');
+		}
+		if (strcmp(key, "offset") == 0) {
+			nc.saved_offset = neg ? -(int64_t)v : (int64_t)v;
+			nc.saved_valid = true;
+		} else if (strcmp(key, "rtc") == 0) {
+			nc.saved_rtc = (uint32_t)v;
+			nc.saved_has_rtc = true;
+		} else if (strcmp(key, "wall") == 0) {
+			nc.saved_wall = v;
+		}
+		while (*p != 0 && *p != '\n') {
+			p++;
+		}
+		if (*p == '\n') {
+			p++;
+		}
+	}
+}
+
+/*
+ * bsd_init, after the root mount and before launchd: the saved offset
+ * (or the saved wall time as a floor), then file writes are allowed.
+ */
+void
+negroni_rtc_load_saved(void)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	char buf[160];
+	int resid = 0, error;
+	uint64_t apply = 0;
+	uint32_t raw = 0;
+	bool schedule;
+
+	bzero(buf, sizeof(buf));
+	error = vnode_open(NC_FILE, FREAD, 0, 0, &vp, ctx);
+	if (error == 0) {
+		error = vn_rdwr(UIO_READ, vp, buf, sizeof(buf) - 1, 0, UIO_SYSSPACE, IO_NODELOCKED,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		(void)vnode_close(vp, FREAD, ctx);
+	}
+
+	lck_mtx_lock(&nc_lock);
+	nc_init();
+	nc.root_ready = true;
+	if (error == 0) {
+		nc_parse(buf);
+	}
+	clock_sec_t now_s;
+	clock_usec_t now_us;
+	clock_get_calendar_microtime(&now_s, &now_us);
+	const char *what;
+	if (error != 0) {
+		what = error == ENOENT ? "no saved offset yet (" NC_FILE ")" : "saved offset not readable";
+	} else if (!nc.saved_valid) {
+		what = "saved file not understood: ignored";
+	} else if (nc.set_this_boot) {
+		what = "time already set this boot: saved offset not used";
+	} else if (nc.bootarg_off_set) {
+		what = "boot-arg negronirtcoff given: saved offset not used";
+	} else if (nc.rtc_ok && nc_rtc_raw(&raw) == 0 && (!nc.saved_has_rtc || raw >= nc.saved_rtc) &&
+	    (int64_t)raw + nc.saved_offset > 0) {
+		apply = (uint64_t)((int64_t)raw + nc.saved_offset);
+		what = "RTC + saved offset";
+		if (apply < nc.saved_wall || apply < nc.floor) {
+			apply = MAX(nc.saved_wall, nc.floor);
+			what = "saved wall time (RTC + saved offset below it)";
+		}
+	} else if (nc.saved_wall > (uint64_t)now_s) {
+		apply = nc.saved_wall;
+		what = nc.rtc_ok ? "saved wall time as floor (RTC went backwards: offset not used)" :
+		    "saved wall time as floor (no RTC)";
+	} else {
+		what = "saved wall time is not later than the clock: not used";
+	}
+	if (apply != 0 && apply <= (uint64_t)now_s + 1 && apply + 1 >= (uint64_t)now_s) {
+		apply = 0;      /* already right */
+	}
+	printf("NEGRONI RTC: %s: %s (calendar %lu s%s%llu)\n", NC_FILE, what, (unsigned long)now_s,
+	    apply ? " -> " : "", apply ? apply : 0ull);
+	schedule = nc.dirty && nc.persist_call != NULL;
+	lck_mtx_unlock(&nc_lock);
+
+	if (apply != 0) {
+		clock_set_calendar_microtime((clock_sec_t)apply, 0);   /* -> negroni_rtc_set() */
+		lck_mtx_lock(&nc_lock);
+		nc.source = "saved offset (" NC_FILE ")";
+		/* the file already holds this offset: no rewrite */
+		nc.dirty = !(nc.saved_valid && nc.offset == nc.saved_offset);
+		schedule = nc.dirty;
+		lck_mtx_unlock(&nc_lock);
+	}
+	if (schedule) {
+		thread_call_enter(nc.persist_call);
+	}
+}
+
+/* Thread call: write the offset file (dirty only), try again later on an error (read-only root). */
+static void
+nc_persist(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	char text[160];
+	uint32_t raw = 0;
+	int resid = 0;
+
+	lck_mtx_lock(&nc_lock);
+	if (!nc.dirty) {
+		lck_mtx_unlock(&nc_lock);
+		return;
+	}
+	bool has_rtc = nc.rtc_ok && nc_rtc_raw(&raw) == 0;
+	int64_t offset = nc.offset;
+	uint64_t wall = has_rtc ? (uint64_t)((int64_t)raw + offset) : nc_soft_now_ns() / NSEC_PER_SEC;
+	if (has_rtc) {
+		snprintf(text, sizeof(text), "negroni-rtc 1\noffset %lld\nrtc %u\nwall %llu\n", offset, raw, wall);
+	} else {
+		snprintf(text, sizeof(text), "negroni-rtc 1\noffset 0\nwall %llu\n", wall);
+	}
+	nc.dirty = false;
+	lck_mtx_unlock(&nc_lock);
+
+	int error = vnode_open(NC_FILE, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, S_IRUSR | S_IWUSR,
+	    VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (error == 0) {
+		error = vn_rdwr(UIO_WRITE, vp, text, (int)strlen(text), 0, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (error == 0 && resid != 0) {
+			error = EIO;
+		}
+		if (error == 0) {
+			error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+		}
+		(void)vnode_close(vp, FWRITE, ctx);
+	}
+
+	lck_mtx_lock(&nc_lock);
+	if (error == 0) {
+		nc.saved_valid = true;
+		nc.saved_offset = offset;
+		nc.saved_wall = wall;
+		nc.saved_rtc = raw;
+		nc.saved_has_rtc = has_rtc;
+		printf("NEGRONI RTC: saved offset %lld (wall %llu) to %s\n", has_rtc ? offset : 0ll, wall, NC_FILE);
+	} else if (!nc.dirty) {
+		nc.dirty = true;
+		if (nc.retries++ < NC_RETRIES) {
+			if (nc.retries == 1) {
+				printf("NEGRONI RTC: %s not written (error %d): again every %d s\n", NC_FILE, error, NC_RETRY_S);
+			}
+			uint64_t deadline;
+			clock_interval_to_deadline(NC_RETRY_S, NSEC_PER_SEC, &deadline);
+			thread_call_enter_delayed(nc.persist_call, deadline);
+		} else {
+			printf("NEGRONI RTC: %s not written (error %d): giving up until the next set\n", NC_FILE, error);
+		}
+	}
+	lck_mtx_unlock(&nc_lock);
+}
+
+/* USB "settime <secs>[.<usecs>]" (patch 0212). 0 = set; the reply text goes into reply. */
+int
+negroni_calendar_settime(uint64_t secs, uint32_t usecs, char *reply, size_t size)
+{
+	clock_sec_t old_s;
+	clock_usec_t old_us;
+
+	if (secs < NC_MIN_TIME || secs >= NC_MAX_TIME || usecs >= USEC_PER_SEC) {
+		snprintf(reply, size, "error: time %llu out of range", secs);
+		return -1;
+	}
+	clock_get_calendar_microtime(&old_s, &old_us);
+	clock_set_calendar_microtime((clock_sec_t)secs, (clock_usec_t)usecs);
+	lck_mtx_lock(&nc_lock);
+	nc.source = "USB settime";
+	snprintf(reply, size, "ok settime %llu (was %lu, %s offset %lld)", secs, (unsigned long)old_s,
+	    nc.rtc_ok ? "RTC" : "no RTC,", nc.rtc_ok ? nc.offset : 0ll);
+	lck_mtx_unlock(&nc_lock);
+	printf("NEGRONI RTC: USB settime %llu.%06u (calendar was %lu.%06u)\n", secs, usecs,
+	    (unsigned long)old_s, old_us);
+	return 0;
+}
+
+/* USB "time": the calendar and its source. */
+void
+negroni_calendar_describe(char *reply, size_t size)
+{
+	clock_sec_t s;
+	clock_usec_t us;
+	uint32_t raw = 0;
+
+	clock_get_calendar_microtime(&s, &us);
+	lck_mtx_lock(&nc_lock);
+	nc_init();
+	bool has_rtc = nc.rtc_ok && nc_rtc_raw(&raw) == 0;
+	if (has_rtc) {
+		snprintf(reply, size, "time %lu rtc %u offset %lld source %s", (unsigned long)s, raw, nc.offset, nc.source);
+	} else {
+		snprintf(reply, size, "time %lu rtc none source %s", (unsigned long)s, nc.source);
+	}
+	lck_mtx_unlock(&nc_lock);
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_sample.c b/bsd/dev/negroni_sample.c
new file mode 100644
index 0000000..8c58b44
--- /dev/null
+++ b/bsd/dev/negroni_sample.c
@@ -0,0 +1,88 @@
+/*
+ * NEGRONI process sampler: where is a daemon stuck?
+ *
+ * The phone has no debugger and daemons log nowhere readable. Every
+ * interval a kernel thread prints, for each process named in boot-arg
+ * negronisample (comma separated, default "SpringBoard,backboardd"; "-" = off)
+ * and for each of its threads, the user pc/lr/sp and a frame-pointer
+ * backtrace as "SMP name[pid] tN pc ... lr ... bt ..." (header line with the
+ * shared region slide and the main binary's mach header, to symbolicate
+ * with tools/negroni-crash.py). A thread blocked in a syscall shows the
+ * syscall stub in pc and its caller in lr/bt.
+ *
+ * First sample 90 s after start, then every 120 s, 40 samples at most.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern task_t proc_task(proc_t);
+extern int hz;
+extern void negroni_sample_start(void);
+
+static char negroni_sample_names[128];
+
+static bool
+negroni_sample_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = negroni_sample_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+extern void negroni_sample_task(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
+
+static int
+negroni_sample_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (negroni_sample_wanted(name)) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			negroni_sample_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+negroni_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	if (!PE_parse_boot_argn("negronisample", negroni_sample_names, sizeof(negroni_sample_names))) {
+		strlcpy(negroni_sample_names, "SpringBoard,backboardd", sizeof(negroni_sample_names));
+	}
+	if (negroni_sample_names[0] == '-') {
+		return;
+	}
+	(void)tsleep(&chan, PZERO, "negronismp", 90 * hz);
+	for (int i = 0; i < 40; i++) {
+		printf("SMP --- sample %d\n", i);
+		proc_iterate(PROC_ALLPROCLIST, negroni_sample_proc, NULL, NULL, NULL);
+		(void)tsleep(&chan, PZERO, "negronismp", 120 * hz);
+	}
+}
+
+void
+negroni_sample_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(negroni_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
diff --git a/bsd/dev/negroni_slpi.c b/bsd/dev/negroni_slpi.c
new file mode 100644
index 0000000..85ea94c
--- /dev/null
+++ b/bsd/dev/negroni_slpi.c
@@ -0,0 +1,2027 @@
+/*
+ * NEGRONI (SM8450) sensor DSP (SLPI, the Hexagon of the SSC block) start, phase 1 of the iOSPlus10
+ * sensors plan (docs/sensors-plan.md, patches/xnu/README-sensors.md). Patch 0376. UNTESTED ON HARDWARE.
+ *
+ * Off by default. Boot-arg negronislpi=N runs the steps on a kernel thread of its own:
+ *   1  steps 1..8: load the SLPI image and start it with PAS (id 12), wait for "ready"
+ *   2  + step 9:   the GLINK SMEM edge "dsps" (version, then every channel the SLPI opens is logged and
+ *                  left unanswered)
+ *   3  + step 10:  the IPCRTR channel is ours: QRTR HELLO, every NEW_SERVER of the SLPI is logged
+ *                  (expect QMI service 400 = sns_client)
+ * negronislpi_step=N stops after step N (lower than the level only). Every line starts "NEGRONI SLPI:".
+ *
+ * The steps are those of negroni_adsp.c (patch 0240, proven on the ADSP: "THE ADSP IS UP") with the
+ * SLPI values of the live DT and Linux qcom_q6v5_pas.c sdm845_slpi_resource_init (used for
+ * qcom,sm8450-slpi-pas): PAS id 12, crash reason item 424, AOP load_state "slpi", proxy votes lcx/lmx,
+ * no minidump id. Live DT: remoteproc-slpi@02400000, slpi_region 0x87f00000 + 0x1a00000,
+ * qcom,smp2p-dsps (items in 481 / out 430, remote pid 3, IPCC client 4 signal 2, outbound entries
+ * "master-kernel" and "sleepstate"), glink-edge "dsps" (remote pid 3, IPCC client 4 signal 0).
+ *
+ *   0  waits   for the ADSP thread (negroniadsp) to end: the AOSS QMP mailbox and TCSR mutex 3 (SMEM
+ *              allocation) have no lock between the two threads (the hardware mutex is per CPU
+ *              cluster, not per thread)
+ *   1  reads   SMEM: the apps<->SLPI partition (hosts 0 and 3); the SLPI's SMP2P item 481 (if present
+ *              the SLPI has run since the reset: stop, it is not started twice), its last words (424)
+ *   2  reads   the ADSP firmware area, entry "slpi.pak" (scripts/sensors/mkslpipak.py): its table,
+ *              slpi.mdt, the SHA-256 of each slpi.bNN, the load span fits the carveout
+ *   3  writes  RPMh: lcx.lvl and lmx.lvl at level 384 (the SLPI's proxy votes)
+ *   4  writes  AOSS QMP: "{class: image, res: load_state, name: slpi, val: on}"
+ *   5  asks    TrustZone: PAS init image (id 12), PAS mem setup (0x87f00000, span)
+ *   6  writes  the carveout 0x87f00000 + 0x1a00000 only: zero, PT_LOAD segments, read back (SHA-256)
+ *   7  writes  SMEM: our SMP2P item 430 (master-kernel = 0, sleepstate = bit 12 "APPS awake", as the
+ *              Linux smp2p_sleepstate driver sets it), IPCC ring (client 4, signal 2)
+ *   8  asks    TrustZone: PAS auth and reset (id 12); polls item 481 "slave-kernel" for ready (bit 1),
+ *              handover (bit 2), fatal (bit 0) for negronislpi_wait s (default 10). Ready: "THE SLPI IS UP"
+ *   9  writes  SMEM: GLINK items 478 + 479 in the 0/3 partition; version 1; logs each OPEN of the SLPI
+ *  10  sends   QRTR over IPCRTR: HELLO; logs HELLO, NEW_SERVER, DEL_SERVER, BYE, NEW_LOOKUP of the SLPI
+ *
+ * After the steps the thread stays as the crash watch (as 0248 for the ADSP): every 200 ms it reads
+ * "slave-kernel" for FATAL and (levels 2/3) polls GLINK. On FATAL: last words, our "stop" bit, up to
+ * 5 s for STOP-ACK, PAS shutdown; no restart in this boot.
+ *
+ * Not touched: USB, the charger, the ADSP edge (other SMEM partition, other IPCC client, other
+ * items), the ADSP carveout. Writes: SMEM items 430/478/479 of the 0/3 partition, the SLPI carveout,
+ * QMP mailbox, IPCC doorbells, the RPMh votes. More boot-args: negronislpi_wait=S, negronislpi_listen=S
+ * (GLINK/QRTR log window after step 9/10, default 15), negronislpi_unvote=0 (keep the rail votes after
+ * handover), negronislpi_sleepstate=0 (no "sleepstate" entry), negronislpi_pause=MS (before each
+ * write step), negronislpi_adspwait=S (default 240), negronislpi_steptimeout=MS (default 15000).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include <arm/caches_internal.h>
+#include <libkern/crypto/sha2.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern uint64_t kvtophys(vm_offset_t va);
+extern kern_return_t thread_terminate(thread_t);
+extern void IOSleep(unsigned int milliseconds);
+extern int negroni_ufs_adsp_area_read(uint64_t at, void *dst, uint32_t count);
+extern int negroni_rpmh_arc_vote(const char *res, unsigned level);
+extern int negroni_adsp_phase(void);            /* 0376 (negroni_adsp.c): 0 not asked, 1 running, 2 done */
+extern bool negroni_adsp_rails_held(void);      /* 0376 (negroni_adsp.c): the ADSP keeps lcx/lmx at 384 */
+void negroni_slpi_init(void);
+
+#define SL_WIMG_WCOMB           0x6u            /* VM_WIMG_WCOMB, as negroni_adsp.c */
+
+/* ---- addresses (live DT) ---- */
+#define SMEM_PHYS               0x80900000UL
+#define SMEM_SIZE               0x00200000u
+#define SLPI_MEM_PHYS           0x87f00000UL    /* slpi_region@87F00000 { reg = <0 0x87f00000 0 0x1a00000> } */
+#define SLPI_MEM_SIZE           0x01a00000u
+_Static_assert((SLPI_MEM_SIZE & 0x3fffu) == 0, "ml_io_unmap needs a 16 KiB page multiple");
+#define IPCC_PHYS               0x0ed18000UL
+#define AOSS_PHYS               0x0c300000UL
+#define AOSS_SIZE               0x400u
+#define TCSR_MUTEX_PHYS         0x01f43000UL    /* smem hwlocks = <&tcsr_mutex 3> */
+
+/* ---- SCM / PAS ---- */
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(svc, cmd)      ((uint64_t)(svc) << 8 | (cmd))
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_MEM_SETUP       SCM_CALL(2, 2)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_PAS_IS_SUPPORTED    SCM_CALL(2, 7)
+#define SCM_ONE_VALUE           1
+#define SCM_THREE_VALUES        3
+#define SCM_VALUE_AND_BUFFER    (2 | 2 << 6)
+#define SCM_INTERRUPTED         1
+#define PAS_SLPI                12              /* qcom_q6v5_pas.c sdm845_slpi_resource_init .pas_id */
+
+/* ---- SMEM ---- */
+#define SMEM_APPS               0
+#define SMEM_SLPI               3               /* qcom,remote-pid of smp2p-dsps and the glink-edge */
+#define SMEM_GLOBAL             0xfffe
+#define SMEM_CANARY             0xa5a5
+#define ITEM_CRASH_REASON       424
+#define ITEM_SMP2P_OURS         430             /* qcom,smem = <0x1e1 0x1ae> = <481 430>: inbound, outbound */
+#define ITEM_SMP2P_THEIRS       481
+#define ITEM_GLINK_DESC         478
+#define ITEM_GLINK_FIFO0        479
+#define ITEM_GLINK_FIFO1        480
+
+/* ---- SMP2P ---- */
+#define SMP2P_MAGIC             0x504d5324      /* "$SMP" */
+#define SMP2P_VERSION           1
+#define SMP2P_FEATURE_SSR_ACK   1u
+#define SMP2P_ENTRIES           16
+#define SMP2P_ITEM_SIZE         (20 + 20 * SMP2P_ENTRIES)
+#define DSP_FATAL               (1u << 0)
+#define DSP_READY               (1u << 1)
+#define DSP_HANDOVER            (1u << 2)
+#define DSP_STOP_ACK            (1u << 3)
+#define SLEEPSTATE_AWAKE        (1u << 12)      /* smp2p_sleepstate.c PROC_AWAKE_ID 12 */
+
+/* ---- IPCC ---- */
+#define IPCC_SEND_ID            0x0c
+#define IPCC_CLIENT_AOP         0u
+#define IPCC_CLIENT_SLPI        4u              /* mboxes = <&ipcc 4 ...> */
+#define IPCC_SIGNAL_GLINK       0u
+#define IPCC_SIGNAL_SMP2P       2u
+
+/* ---- AOSS QMP (qcom_aoss.c) ---- */
+#define QMP_MAGIC               0x00
+#define QMP_MAGIC_VALUE         0x4d41494c
+#define QMP_VERSION             0x04
+#define QMP_UCORE_LINK          0x0c
+#define QMP_UCORE_LINK_ACK      0x10
+#define QMP_UCORE_CH            0x14
+#define QMP_UCORE_CH_ACK        0x18
+#define QMP_MCORE_LINK          0x24
+#define QMP_MCORE_LINK_ACK      0x28
+#define QMP_MCORE_CH            0x2c
+#define QMP_MCORE_CH_ACK        0x30
+#define QMP_MCORE_MBOX_SIZE     0x34
+#define QMP_MCORE_MBOX_OFFSET   0x38
+#define QMP_UP                  0x0000ffffu
+#define QMP_MSG_LEN             64u
+
+/* ---- ADSP firmware area (mkadsparea.py) and the SLPI pack inside it (mkslpipak.py) ---- */
+#define AREA_MAGIC              "NEGRADSP"
+#define AREA_MAX                64
+#define AREA_HEADER             8192u
+#define AREA_SIZE               (32u << 20)
+#define PAK_NAME                "slpi.pak"
+#define PAK_MAGIC               "NEGRSLPI"
+#define PAK_MAX                 32
+#define PAK_HEADER              4096u
+#define PAK_SIZE_MAX            (12u << 20)
+#define CHUNK                   (1u << 20)
+
+struct area_entry {
+	char name[48];
+	uint32_t offset, size;
+	uint8_t sha256[32];
+};
+struct area_header {
+	char magic[8];
+	uint32_t version, count;
+	struct area_entry entry[AREA_MAX];
+};
+struct pak_header {
+	char magic[8];
+	uint32_t version, count;
+	struct area_entry entry[PAK_MAX];
+};
+_Static_assert(sizeof(struct area_header) <= AREA_HEADER, "area table fits its header");
+_Static_assert(sizeof(struct pak_header) <= PAK_HEADER, "pack table fits its header");
+
+/* ---- MDT ---- */
+#define PT_LOAD                 1
+#define MDT_TYPE(flags)         (((flags) >> 24) & 7)
+#define MDT_TYPE_HASH           2
+#define MDT_RELOCATABLE         (1u << 27)
+#define MAX_SEGMENTS            48
+
+struct seg {
+	uint32_t type, offset, paddr, filesz, memsz, flags;
+};
+
+#define STEPS                   10
+static uint32_t level, step, last_step, pause_ms, wait_s = 10, unvote = 1, sleepstate = 1, listen_s = 15;
+static uint32_t adsp_wait_s = 240, step_budget_ms = 15000;
+static vm_offset_t smem, ipcc, aoss, tcsr;
+static struct pak_header *pak;                  /* kmem, PAK_HEADER bytes */
+static uint32_t pak_base, pak_size;             /* the pack inside the ADSP area */
+static uint8_t *mdt;
+static uint32_t mdt_size, nseg, min_pa, max_pa;
+static struct seg segs[MAX_SEGMENTS];
+static bool relocatable, rails_on, slpi_running, pas_inited;
+static uint32_t our_item;
+static char fail_why[192];
+static const char *const step_names[STEPS + 1] = {
+	"wait for the ADSP", "SMEM survey", "firmware", "rails", "AOP QMP", "PAS init", "load", "SMP2P", "start",
+	"GLINK", "QRTR",
+};
+
+#define say(fmt, ...) printf("NEGRONI SLPI: %u " fmt "\n", step, ##__VA_ARGS__)
+#define FAIL(fmt, ...) do { snprintf(fail_why, sizeof(fail_why), fmt, ##__VA_ARGS__); say("stop: %s", fail_why); } while (0)
+
+static void
+announce(const char *what)
+{
+	say("about to: %s", what);
+	if (pause_ms) {
+		IOSleep(pause_ms);
+	}
+}
+
+static uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb osh" ::: "memory");
+	return v;
+}
+
+static void
+wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb osh" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+/* The SCM call of negroni_adsp.c (0240 with the resume bound): resume while interrupted, retry busy. */
+static int32_t
+scm(const char *what, uint64_t function, uint64_t args, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t *answer)
+{
+	uint64_t t0 = mach_absolute_time(), ns;
+
+	say("SCM %s: smc %#llx (%#llx, %#llx, %#llx)", what, function, a0, a1, a2);
+	for (int busy = 0; busy <= 20; busy++) {
+		uint64_t session = 0;
+		int i;
+		for (i = 0; i < 2000000; i++) {
+			register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+			register uint64_t x1 __asm__("x1") = args;
+			register uint64_t x2 __asm__("x2") = a0;
+			register uint64_t x3 __asm__("x3") = a1;
+			register uint64_t x4 __asm__("x4") = a2;
+			register uint64_t x5 __asm__("x5") = 0;
+			register uint64_t x6 __asm__("x6") = session;
+			register uint64_t x7 __asm__("x7") = 0;
+
+			__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+			    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+			session = x6;
+			if (x0 == SCM_INTERRUPTED) {
+				continue;
+			}
+			absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+			if ((int32_t)x0 == -12 && busy < 20) {
+				say("SCM %s: TrustZone busy (-12), retry %d in 30 ms", what, busy + 1);
+				IOSleep(30);
+				break;
+			}
+			if (x0 == 2) {
+				say("SCM %s: WAITQ_SLEEP after %d resumes, %llu ms: not supported", what, i, ns / 1000000);
+				return -1;
+			}
+			say("SCM %s -> %d, answer %#llx (%d resumes, %llu ms)", what, (int32_t)x0, x1, i, ns / 1000000);
+			*answer = x1;
+			return (int32_t)x0;
+		}
+		if (i == 2000000) {
+			break;
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	say("SCM %s keeps returning interrupted or busy (%llu ms)", what, ns / 1000000);
+	return -1;
+}
+
+/* ---- SMEM (smem.c layouts; the same walkers as negroni_adsp.c, hosts 0/3) ---- */
+
+static uint32_t
+smem_partition(uint16_t a, uint16_t b, uint32_t *size, uint32_t *cacheline)
+{
+	uint32_t toc = SMEM_SIZE - 0x1000;
+
+	if (rd32(smem, toc) != 0x434f5424 /* "$TOC" */ || rd32(smem, toc + 4) != 1) {
+		return 0;
+	}
+	uint32_t count = rd32(smem, toc + 8);
+	for (uint32_t i = 0; i < count && i < 64; i++) {
+		uint32_t e = toc + 32 + 48 * i;
+		uint32_t off = rd32(smem, e), sz = rd32(smem, e + 4), hosts = rd32(smem, e + 12);
+		uint16_t h0 = (uint16_t)hosts, h1 = (uint16_t)(hosts >> 16);
+		if (off == 0 || sz == 0 || !((h0 == a && h1 == b) || (h0 == b && h1 == a))) {
+			continue;
+		}
+		if ((uint64_t)off + sz > toc || rd32(smem, off) != 0x54525024 /* "$PRT" */ || rd32(smem, off + 8) != sz) {
+			return 0;
+		}
+		*size = sz;
+		*cacheline = rd32(smem, e + 16);
+		return off;
+	}
+	return 0;
+}
+
+static uint32_t
+smem_find_in(uint32_t p, uint32_t psize, uint32_t cacheline, uint32_t item, uint32_t *size)
+{
+	uint32_t free_uncached = rd32(smem, p + 12), free_cached = rd32(smem, p + 16);
+
+	if (free_uncached > psize || free_cached > psize) {
+		return 0;
+	}
+	for (uint32_t at = 32; at + 16 <= free_uncached;) {
+		uint32_t w0 = rd32(smem, p + at), sz = rd32(smem, p + at + 4), pad = rd32(smem, p + at + 8);
+		/* untrusted (the DSP writes SMEM too): the item and its padding stay inside the uncached area */
+		if ((w0 & 0xffff) != SMEM_CANARY || sz > psize || (pad & 0xffff) > sz ||
+		    (uint64_t)at + 16 + (pad >> 16) + sz > free_uncached) {
+			break;
+		}
+		if ((w0 >> 16) == item) {
+			*size = sz - (pad & 0xffff);
+			return p + at + 16 + (pad >> 16);
+		}
+		at += 16 + (pad >> 16) + sz;
+	}
+	if (cacheline == 0 || (cacheline & (cacheline - 1))) {
+		return 0;
+	}
+	uint32_t back = (16 + cacheline - 1) & ~(cacheline - 1);
+	for (uint32_t at = psize - back; at > free_cached && at < psize;) {
+		uint32_t w0 = rd32(smem, p + at), sz = rd32(smem, p + at + 4), pad = rd32(smem, p + at + 8);
+		if ((w0 & 0xffff) != SMEM_CANARY || sz > at || at - sz < free_cached || (pad & 0xffff) > sz) {
+			break;
+		}
+		if ((w0 >> 16) == item) {
+			*size = sz - (pad & 0xffff);
+			return p + at - sz;
+		}
+		if (sz + back > at) {
+			break;
+		}
+		at -= sz + back;
+	}
+	return 0;
+}
+
+/*
+ * Item lookup. The SLPI's own items (430, 478-481) live only in the 0/3 partition: Linux qcom_smem_get(host)
+ * does not fall back to the global partition when the host partition exists, and a global item of the same
+ * number belongs to someone else (review F1). Only the crash reason (424, HOST_ANY) may come from global.
+ */
+static uint32_t
+smem_item_in(uint32_t item, uint32_t *size, unsigned nhosts)
+{
+	static const uint16_t hosts[2][2] = { { SMEM_APPS, SMEM_SLPI }, { SMEM_GLOBAL, SMEM_GLOBAL } };
+
+	for (unsigned h = 0; h < nhosts; h++) {
+		uint32_t psize = 0, cacheline = 0, p = smem_partition(hosts[h][0], hosts[h][1], &psize, &cacheline);
+		uint32_t at = p ? smem_find_in(p, psize, cacheline, item, size) : 0;
+		if (at) {
+			return at;
+		}
+	}
+	return 0;
+}
+
+#define smem_item(item, size)   smem_item_in((item), (size), 1)     /* 0/3 partition only */
+#define smem_item_any(item, size) smem_item_in((item), (size), 2)   /* 0/3, then global */
+
+static void
+last_words(void)
+{
+	char text[81];
+	uint32_t size = 0, at = smem_item_any(ITEM_CRASH_REASON, &size);
+
+	if (at == 0 || size == 0) {
+		say("item %u (last words): not there", ITEM_CRASH_REASON);
+		return;
+	}
+	bzero(text, sizeof(text));
+	for (uint32_t i = 0; i < MIN(size, (uint32_t)sizeof(text) - 1) / 4; i++) {
+		uint32_t w = rd32(smem, at + 4 * i);
+		memcpy(text + 4 * i, &w, 4);
+	}
+	say("SLPI LAST WORDS (item %u, %u bytes): \"%s\"", ITEM_CRASH_REASON, size, text);
+}
+
+static bool
+smp2p_value(uint32_t at, const char *name, uint32_t *value)
+{
+	if (rd32(smem, at) != SMP2P_MAGIC) {
+		return false;
+	}
+	uint32_t valid = rd32(smem, at + 12) >> 16;
+	for (uint32_t i = 0; i < valid && i < SMP2P_ENTRIES; i++) {
+		char n[17];
+		for (uint32_t w = 0; w < 4; w++) {
+			uint32_t v = rd32(smem, at + 20 + 20 * i + 4 * w);
+			memcpy(n + 4 * w, &v, 4);
+		}
+		n[16] = 0;
+		if (strncmp(n, name, 16) == 0) {
+			*value = rd32(smem, at + 36 + 20 * i);
+			return true;
+		}
+	}
+	return false;
+}
+
+/* ---- step 0: the ADSP thread first ---- */
+
+static bool
+step_wait_adsp(void)
+{
+	uint32_t s;
+
+	if (negroni_adsp_phase() == 0) {        /* 0376 negroni_adsp.c: acquire load */
+		say("no ADSP thread (negroniadsp=0): nothing to wait for");
+		return true;
+	}
+	for (s = 0; s < adsp_wait_s && negroni_adsp_phase() != 2; s++) {
+		if (s % 30 == 0) {
+			say("the ADSP thread runs: waiting (%u s so far, at most %u s)", s, adsp_wait_s);
+		}
+		IOSleep(1000);
+	}
+	if (negroni_adsp_phase() != 2) {
+		FAIL("the ADSP thread still runs after %u s: no SLPI start (shared QMP mailbox and TCSR mutex)", s);
+		return false;
+	}
+	say("the ADSP thread is done after %u s; ADSP rail votes %s", s, negroni_adsp_rails_held() ? "held (384)" : "not held");
+	return true;
+}
+
+/* ---- step 1 ---- */
+
+static bool
+step_survey(void)
+{
+	uint32_t psize = 0, cacheline = 0, size = 0, p, at, value = 0;
+	uint64_t answer = 0;
+
+	if (smem == 0) {
+		smem = ml_io_map_unmappable(SMEM_PHYS, SMEM_SIZE, SL_WIMG_WCOMB);
+	}
+	if (smem == 0) {
+		FAIL("no mapping of SMEM %#lx + %#x", SMEM_PHYS, SMEM_SIZE);
+		return false;
+	}
+	p = smem_partition(SMEM_APPS, SMEM_SLPI, &psize, &cacheline);
+	if (p == 0) {
+		FAIL("no SMEM partition for hosts 0/3 ($TOC %#x)", rd32(smem, SMEM_SIZE - 0x1000));
+		return false;
+	}
+	say("SMEM partition 0/3 at %#lx, %#x bytes, cacheline %u, free uncached %#x cached %#x", SMEM_PHYS + p, psize,
+	    cacheline, rd32(smem, p + 12), rd32(smem, p + 16));
+	at = smem_item(ITEM_SMP2P_THEIRS, &size);
+	if (at != 0) {
+		bool have = smp2p_value(at, "slave-kernel", &value);
+		FAIL("SLPI SMP2P item %u is there (slave-kernel %s %#x): the SLPI has run since the reset; not started twice",
+		    ITEM_SMP2P_THEIRS, have ? "=" : "missing", value);
+		last_words();
+		return false;
+	}
+	say("no SLPI SMP2P item %u: the SLPI has not run since the reset", ITEM_SMP2P_THEIRS);
+	at = smem_item(ITEM_SMP2P_OURS, &size);
+	say("our SMP2P item %u: %s", ITEM_SMP2P_OURS, at ? "present (an earlier kernel made it)" : "absent");
+	for (uint32_t item = ITEM_GLINK_DESC; item <= ITEM_GLINK_FIFO1; item++) {
+		at = smem_item(item, &size);
+		say("GLINK SMEM item %u (0/3): %s", item, at ? "present" : "absent");
+	}
+	/* logged, not obeyed (0241: TrustZone answers 0 for the ADSP too, and the ADSP starts) */
+	scm("PAS is supported (slpi)", SCM_64 | SCM_SIP | SCM_PAS_IS_SUPPORTED, SCM_ONE_VALUE, PAS_SLPI, 0, 0, &answer);
+	say("PAS is supported (id %u): answer %#llx (logged only)", PAS_SLPI, answer);
+	return true;
+}
+
+/* ---- step 2: the pack in the ADSP area ---- */
+
+static const struct area_entry *
+pak_file(const char *name)
+{
+	for (uint32_t i = 0; pak && i < pak->count; i++) {
+		if (strncmp(pak->entry[i].name, name, sizeof(pak->entry[i].name)) == 0) {
+			return &pak->entry[i];
+		}
+	}
+	return NULL;
+}
+
+/* Read n bytes of the pack at off (both checked against the pack). */
+static int
+pak_read(uint32_t off, void *dst, uint32_t n)
+{
+	if (off > pak_size || n > pak_size - off) {
+		return EINVAL;
+	}
+	return negroni_ufs_adsp_area_read((uint64_t)pak_base + off, dst, n);
+}
+
+static bool
+pak_check(const struct area_entry *e, uint8_t *buf)
+{
+	SHA256_CTX ctx;
+	uint8_t digest[32];
+
+	SHA256_Init(&ctx);
+	for (uint32_t at = 0; at < e->size; at += CHUNK) {
+		uint32_t n = MIN(CHUNK, e->size - at);
+		if (pak_read(e->offset + at, buf, n) != 0) {
+			return false;
+		}
+		SHA256_Update(&ctx, buf, n);
+	}
+	SHA256_Final(digest, &ctx);
+	return memcmp(digest, e->sha256, 32) == 0;
+}
+
+static bool
+step_firmware(void)
+{
+	vm_offset_t a = 0, b = 0, m = 0, k = 0;
+	struct area_header *area;
+	const struct area_entry *e = NULL;
+	uint32_t phoff, phnum, bytes = 0;
+	bool ok = false;
+
+	if (kmem_alloc(kernel_map, &a, AREA_HEADER, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, &k, PAK_HEADER, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, &b, CHUNK, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		FAIL("no memory");
+		goto out;
+	}
+	area = (struct area_header *)a;
+	if (negroni_ufs_adsp_area_read(0, area, AREA_HEADER) != 0 || memcmp(area->magic, AREA_MAGIC, 8) != 0 ||
+	    area->version != 1 || area->count == 0 || area->count > AREA_MAX) {
+		FAIL("no ADSP firmware area (scripts/fw/build-areas.sh + write-areas.sh; magic %.8s)", area->magic);
+		goto out;
+	}
+	for (uint32_t i = 0; i < area->count; i++) {
+		area->entry[i].name[47] = 0;
+		if (strcmp(area->entry[i].name, PAK_NAME) == 0) {
+			e = &area->entry[i];
+		}
+	}
+	if (e == NULL) {
+		FAIL("the ADSP area (%u files) has no %s (scripts/sensors/extract-slpi-fw.sh, then build-areas.sh)", area->count,
+		    PAK_NAME);
+		goto out;
+	}
+	if (e->offset < AREA_HEADER || e->offset > AREA_SIZE || e->size > AREA_SIZE - e->offset || e->size < PAK_HEADER ||
+	    e->size > PAK_SIZE_MAX) {
+		FAIL("%s at %#x size %#x out of range", PAK_NAME, e->offset, e->size);
+		goto out;
+	}
+	pak_base = e->offset;
+	pak_size = e->size;
+	pak = (struct pak_header *)k;
+	if (pak_read(0, pak, PAK_HEADER) != 0 || memcmp(pak->magic, PAK_MAGIC, 8) != 0 || pak->version != 1 ||
+	    pak->count == 0 || pak->count > PAK_MAX) {
+		FAIL("%s: bad table (magic %.8s, count %u)", PAK_NAME, pak->magic, pak->count);
+		pak = NULL;
+		goto out;
+	}
+	for (uint32_t i = 0; i < pak->count; i++) {
+		struct area_entry *x = &pak->entry[i];
+		x->name[47] = 0;
+		if (x->offset < PAK_HEADER || x->offset > pak_size || x->size > pak_size - x->offset) {
+			FAIL("pack entry %u (%s) out of range", i, x->name);
+			pak = NULL;
+			goto out;
+		}
+	}
+	say("%s: %u files, %u KiB, at area offset %#x", PAK_NAME, pak->count, pak_size >> 10, pak_base);
+	e = pak_file("slpi.mdt");
+	if (e == NULL || e->size < 52 || e->size > PAGE_SIZE || !pak_check(e, (uint8_t *)b)) {
+		FAIL("slpi.mdt missing, too big for one page, or SHA-256 mismatch");
+		goto out;
+	}
+	if (kmem_alloc(kernel_map, &m, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    pak_read(e->offset, (void *)m, e->size) != 0) {
+		FAIL("slpi.mdt not readable");
+		goto out;
+	}
+	mdt = (uint8_t *)m;
+	mdt_size = e->size;
+	memcpy(&phoff, mdt + 28, 4);
+	phnum = (uint32_t)(mdt[44] | mdt[45] << 8);
+	if (memcmp(mdt, "\177ELF\1\1", 6) != 0 || phnum == 0 || phnum > MAX_SEGMENTS || phoff > mdt_size ||
+	    32 * phnum > mdt_size - phoff) {
+		FAIL("slpi.mdt is not an ELF32 LE header with <= %u program headers", MAX_SEGMENTS);
+		goto out;
+	}
+	nseg = phnum;
+	min_pa = ~0u;
+	max_pa = 0;
+	for (uint32_t i = 0; i < nseg; i++) {
+		uint32_t ph[8];
+		memcpy(ph, mdt + phoff + 32 * i, sizeof(ph));
+		segs[i] = (struct seg){ ph[0], ph[1], ph[3], ph[4], ph[5], ph[6] };
+		if (segs[i].type != PT_LOAD || segs[i].memsz == 0 || MDT_TYPE(segs[i].flags) == MDT_TYPE_HASH) {
+			continue;
+		}
+		if ((uint64_t)segs[i].paddr + segs[i].memsz > 0xffffffffull) {
+			FAIL("segment %u wraps (%#x + %#x)", i, segs[i].paddr, segs[i].memsz);
+			goto out;
+		}
+		relocatable |= (segs[i].flags & MDT_RELOCATABLE) != 0;
+		min_pa = MIN(min_pa, segs[i].paddr);
+		max_pa = MAX(max_pa, segs[i].paddr + segs[i].memsz);
+		if (segs[i].filesz == 0) {
+			continue;
+		}
+		char name[16];
+		snprintf(name, sizeof(name), "slpi.b%02u", i);
+		const struct area_entry *f = pak_file(name);
+		if (f == NULL || f->size != segs[i].filesz || segs[i].filesz > segs[i].memsz) {
+			FAIL("%s missing or not %u bytes", name, segs[i].filesz);
+			goto out;
+		}
+		if (!pak_check(f, (uint8_t *)b)) {
+			FAIL("%s SHA-256 mismatch", name);
+			goto out;
+		}
+		bytes += f->size;
+	}
+	max_pa = (max_pa + 0xfff) & ~0xfffu;
+	say("slpi.mdt: %u program headers, load %#x..%#x (%u KiB), %u KiB of segments, %s", nseg, min_pa, max_pa,
+	    (max_pa - min_pa) >> 10, bytes >> 10, relocatable ? "relocatable" : "fixed");
+	if (min_pa == ~0u || max_pa - min_pa > SLPI_MEM_SIZE || (!relocatable && (min_pa < SLPI_MEM_PHYS ||
+	    max_pa > SLPI_MEM_PHYS + SLPI_MEM_SIZE))) {
+		FAIL("the image does not fit the carveout %#lx + %#x", SLPI_MEM_PHYS, SLPI_MEM_SIZE);
+		goto out;
+	}
+	ok = true;
+out:
+	if (b) {
+		kmem_free(kernel_map, b, CHUNK);
+	}
+	if (a) {
+		kmem_free(kernel_map, a, AREA_HEADER);
+	}
+	if (pak == NULL && k) {
+		kmem_free(kernel_map, k, PAK_HEADER);
+	}
+	/* k (the pack table) and m (slpi.mdt) stay: steps 5 and 6 read them */
+	return ok;
+}
+
+/* ---- step 3: rails ---- */
+
+static int
+rail_vote(const char *res, unsigned level_)
+{
+	int error = EBUSY;
+
+	for (int i = 0; i < 200 && error == EBUSY; i++) {
+		error = negroni_rpmh_arc_vote(res, level_);
+		if (error == EBUSY) {
+			IOSleep(5);
+		}
+	}
+	if (error != 0) {
+		say("RPMh vote %s level %u failed: errno %d", res, level_, error);
+	}
+	return error;
+}
+
+/*
+ * lcx/lmx are one APPS vote for both DSPs. Drop it only if the ADSP does not keep it (an ADSP without
+ * handover keeps level 384; dropping it here would cut the ADSP's proxy vote).
+ */
+static void
+rails_drop(const char *why)
+{
+	if (!rails_on) {
+		return;
+	}
+	rails_on = false;
+	if (negroni_adsp_rails_held()) {
+		say("proxy rail votes kept (%s): the ADSP still holds lcx/lmx at 384", why);
+		return;
+	}
+	(void)rail_vote("lcx.lvl", 0);
+	(void)rail_vote("lmx.lvl", 0);
+	say("proxy rail votes dropped (%s)", why);
+}
+
+static bool
+step_rails(void)
+{
+	announce("vote RPMh lcx.lvl and lmx.lvl to level 384 (SLPI proxy votes)");
+	rails_on = true;
+	if (rail_vote("lcx.lvl", 384) != 0 || rail_vote("lmx.lvl", 384) != 0) {
+		FAIL("rail vote failed");
+		return false;
+	}
+	return true;
+}
+
+/* ---- step 4: AOP ---- */
+
+static void
+kick(uint32_t client, uint32_t signal)
+{
+	wr32(ipcc, IPCC_SEND_ID, client << 16 | signal);
+}
+
+static bool
+qmp_wait(uint32_t off, uint32_t want, uint32_t ms)
+{
+	for (uint32_t i = 0; i < ms; i++) {
+		if (rd32(aoss, off) == want) {
+			return true;
+		}
+		IOSleep(1);
+	}
+	return rd32(aoss, off) == want;
+}
+
+static bool
+step_aop(void)
+{
+	static const char text[] = "{class: image, res: load_state, name: slpi, val: on}";
+	uint32_t words[QMP_MSG_LEN / 4] = { 0 }, box, boxsize;
+
+	_Static_assert(sizeof(text) <= QMP_MSG_LEN, "QMP message fits");
+	if (ipcc == 0) {
+		ipcc = ml_io_map(IPCC_PHYS, 0x1000);
+	}
+	if (aoss == 0) {
+		aoss = ml_io_map(AOSS_PHYS, AOSS_SIZE);
+	}
+	if (ipcc == 0 || aoss == 0) {
+		FAIL("no IPCC/AOSS mapping");
+		return false;
+	}
+	if (rd32(aoss, QMP_MAGIC) != QMP_MAGIC_VALUE || rd32(aoss, QMP_VERSION) != 1) {
+		FAIL("AOSS QMP magic %#x version %u", rd32(aoss, QMP_MAGIC), rd32(aoss, QMP_VERSION));
+		return false;
+	}
+	box = rd32(aoss, QMP_MCORE_MBOX_OFFSET);
+	boxsize = rd32(aoss, QMP_MCORE_MBOX_SIZE);
+	if ((box & 3) || box < 0x3c || boxsize < QMP_MSG_LEN + 4 || (uint64_t)box + boxsize > AOSS_SIZE) {
+		FAIL("QMP mailbox at %#x size %#x does not fit", box, boxsize);
+		return false;
+	}
+	if (rd32(aoss, QMP_MCORE_LINK) == QMP_UP && rd32(aoss, QMP_MCORE_LINK_ACK) == QMP_UP &&
+	    rd32(aoss, QMP_MCORE_CH) == QMP_UP && rd32(aoss, QMP_UCORE_CH) == QMP_UP && rd32(aoss, QMP_MCORE_CH_ACK) == QMP_UP) {
+		say("QMP link and channel are already up");
+	} else {
+		announce("open the QMP link and channel to the AOP (qmp_open)");
+		wr32(aoss, QMP_UCORE_LINK_ACK, rd32(aoss, QMP_UCORE_LINK));
+		wr32(aoss, QMP_MCORE_LINK, QMP_UP);
+		kick(IPCC_CLIENT_AOP, 0);
+		if (!qmp_wait(QMP_MCORE_LINK_ACK, QMP_UP, 1000)) {
+			FAIL("AOP does not ack our QMP link");
+			return false;
+		}
+		wr32(aoss, QMP_MCORE_CH, QMP_UP);
+		kick(IPCC_CLIENT_AOP, 0);
+		if (!qmp_wait(QMP_UCORE_CH, QMP_UP, 1000)) {
+			FAIL("AOP does not open its QMP channel");
+			return false;
+		}
+		wr32(aoss, QMP_UCORE_CH_ACK, QMP_UP);
+		kick(IPCC_CLIENT_AOP, 0);
+		if (!qmp_wait(QMP_MCORE_CH_ACK, QMP_UP, 1000)) {
+			FAIL("AOP does not ack our QMP channel");
+			return false;
+		}
+		say("QMP OPEN");
+	}
+	/* the previous message (the ADSP's, or another QMP user's) must be taken first: wait up to 1 s */
+	if (!qmp_wait(box, 0, 1000)) {
+		FAIL("QMP mailbox still holds %u bytes", rd32(aoss, box));
+		return false;
+	}
+	memcpy(words, text, sizeof(text));
+	announce("send the AOP \"slpi load_state on\"");
+	for (uint32_t i = 0; i < QMP_MSG_LEN / 4; i++) {
+		wr32(aoss, box + 4 + 4 * i, words[i]);
+	}
+	wr32(aoss, box, QMP_MSG_LEN);
+	kick(IPCC_CLIENT_AOP, 0);
+	if (!qmp_wait(box, 0, 1000)) {
+		wr32(aoss, box, 0);
+		FAIL("AOP does not take the QMP message");
+		return false;
+	}
+	say("AOP took \"%s\"", text);
+	return true;
+}
+
+/* ---- step 5: PAS init ---- */
+
+static bool
+step_pas_init(void)
+{
+	vm_offset_t page = 0;
+	uint64_t answer = ~0ull;
+	uint32_t ehdr = segs[0].filesz, hash = ~0u;
+
+	for (uint32_t i = 0; i < nseg; i++) {
+		if (MDT_TYPE(segs[i].flags) == MDT_TYPE_HASH) {
+			hash = i;
+			break;
+		}
+	}
+	if (segs[0].type == PT_LOAD || hash == ~0u || ehdr == 0 || ehdr > mdt_size ||
+	    (uint64_t)ehdr + segs[hash].filesz > PAGE_SIZE) {
+		FAIL("no usable ELF-header/hash segments (hash segment %u)", hash);
+		return false;
+	}
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		FAIL("no memory");
+		return false;
+	}
+	memcpy((void *)page, mdt, ehdr);
+	if (ehdr + segs[hash].filesz == mdt_size) {
+		memcpy((void *)(page + ehdr), mdt + ehdr, segs[hash].filesz);
+	} else if ((uint64_t)segs[hash].offset + segs[hash].filesz <= mdt_size) {
+		memcpy((void *)(page + ehdr), mdt + segs[hash].offset, segs[hash].filesz);
+	} else {
+		char name[16];
+		snprintf(name, sizeof(name), "slpi.b%02u", hash);
+		const struct area_entry *f = pak_file(name);
+		if (f == NULL || f->size != segs[hash].filesz || pak_read(f->offset, (void *)(page + ehdr), f->size) != 0) {
+			FAIL("hash segment %s not readable", name);
+			return false;
+		}
+	}
+	clean_dcache((vm_offset_t)page, PAGE_SIZE, FALSE);
+	/* page stays allocated: TrustZone may read it until auth and reset */
+	announce("hand the SLPI metadata to TrustZone (PAS init image, id 12)");
+	if (scm("PAS init image (slpi)", SCM_64 | SCM_SIP | SCM_PAS_INIT_IMAGE, SCM_VALUE_AND_BUFFER, PAS_SLPI,
+	    kvtophys(page), 0, &answer) != 0 || answer != 0) {
+		FAIL("TrustZone refuses the SLPI metadata (%#llx)", answer);
+		return false;
+	}
+	pas_inited = true;
+	say("TRUSTZONE ACCEPTS THE SLPI SIGNATURE");
+	if (relocatable) {
+		answer = ~0ull;
+		if (scm("PAS mem setup (slpi)", SCM_64 | SCM_SIP | SCM_PAS_MEM_SETUP, SCM_THREE_VALUES, PAS_SLPI, SLPI_MEM_PHYS,
+		    max_pa - min_pa, &answer) != 0 || answer != 0) {
+			FAIL("TrustZone refuses the carveout (%#llx)", answer);
+			return false;
+		}
+		say("TrustZone takes the carveout %#lx + %#x", SLPI_MEM_PHYS, max_pa - min_pa);
+	}
+	return true;
+}
+
+static void
+pas_shutdown(const char *why)
+{
+	uint64_t answer = ~0ull;
+
+	say("PAS shutdown: %s", why);
+	scm("PAS shutdown (slpi)", SCM_64 | SCM_SIP | SCM_PAS_SHUTDOWN, SCM_ONE_VALUE, PAS_SLPI, 0, 0, &answer);
+}
+
+/* ---- step 6: load (writes only inside 0x87f00000 + 0x1a00000) ---- */
+
+static bool
+step_load(void)
+{
+	vm_offset_t buf = 0;
+	volatile uint64_t *mem;
+	bool ok = false;
+
+	if (kmem_alloc(kernel_map, &buf, CHUNK, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		FAIL("no memory");
+		return false;
+	}
+	announce("zero the carveout 0x87f00000 + 26 MiB and write the PT_LOAD segments");
+	mem = (volatile uint64_t *)ml_io_map_unmappable(SLPI_MEM_PHYS, SLPI_MEM_SIZE, SL_WIMG_WCOMB);
+	if (mem == NULL) {
+		FAIL("no mapping of the carveout %#lx + %#x", SLPI_MEM_PHYS, SLPI_MEM_SIZE);
+		kmem_free(kernel_map, buf, CHUNK);
+		return false;
+	}
+	for (uint32_t i = 0; i < SLPI_MEM_SIZE / 8; i++) {
+		mem[i] = 0;
+	}
+	for (uint32_t i = 0; i < nseg; i++) {
+		struct seg *s = &segs[i];
+		if (s->type != PT_LOAD || s->memsz == 0 || MDT_TYPE(s->flags) == MDT_TYPE_HASH || s->filesz == 0) {
+			continue;
+		}
+		char name[16];
+		snprintf(name, sizeof(name), "slpi.b%02u", i);
+		const struct area_entry *f = pak_file(name);
+		uint64_t base = (relocatable ? 0 : (uint64_t)(min_pa - SLPI_MEM_PHYS)) + (s->paddr - min_pa);
+		SHA256_CTX ctx;
+		uint8_t digest[32];
+
+		/* bounds again, here where the writes happen: never outside the carveout */
+		if (f == NULL || (base & 7) || base > SLPI_MEM_SIZE || f->size > SLPI_MEM_SIZE - base) {
+			FAIL("%s missing, not 8-byte aligned or outside the carveout (+%#llx, %u bytes)", name, base,
+			    f ? f->size : 0);
+			goto out;
+		}
+		for (uint32_t at = 0; at < f->size; at += CHUNK) {
+			uint32_t n = MIN(CHUNK, f->size - at);
+			if (pak_read(f->offset + at, (void *)buf, n) != 0) {
+				FAIL("read error in %s", name);
+				goto out;
+			}
+			uint32_t words = n / 8;
+			const uint64_t *src = (const uint64_t *)buf;
+			for (uint32_t w = 0; w < words; w++) {
+				mem[(base + at) / 8 + w] = src[w];
+			}
+			for (uint32_t t = words * 8; t < n; t++) {
+				((volatile uint8_t *)mem)[base + at + t] = ((const uint8_t *)buf)[t];
+			}
+		}
+		SHA256_Init(&ctx);
+		for (uint32_t at = 0; at < f->size; at += CHUNK) {
+			uint32_t n = MIN(CHUNK, f->size - at);
+			for (uint32_t t = 0; t < n; t++) {
+				((uint8_t *)buf)[t] = ((volatile uint8_t *)mem)[base + at + t];
+			}
+			SHA256_Update(&ctx, (const void *)buf, n);
+		}
+		SHA256_Final(digest, &ctx);
+		if (memcmp(digest, f->sha256, 32) != 0) {
+			FAIL("%s does not read back from the carveout (+%#llx)", name, base);
+			goto out;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	say("segments written at %#lx and read back OK", SLPI_MEM_PHYS);
+	ok = true;
+out:
+	ml_io_unmap((vm_offset_t)mem, SLPI_MEM_SIZE);
+	kmem_free(kernel_map, buf, CHUNK);
+	return ok;
+}
+
+/* ---- step 7: our SMP2P item (and the SMEM allocator for step 9) ---- */
+
+static bool
+smem_alloc(uint32_t item, uint32_t bytes)
+{
+	uint32_t psize = 0, cacheline = 0, p = smem_partition(SMEM_APPS, SMEM_SLPI, &psize, &cacheline);
+	uint32_t size = (bytes + 7) & ~7u, owner = ~0u, at, have = 0;
+	bool made = false;
+
+	if (p == 0) {
+		FAIL("no SMEM partition 0/3 for item %u", item);
+		return false;
+	}
+	if (smem_item(item, &have) != 0) {
+		say("SMEM item %u is there already (%u bytes)", item, have);
+		return true;
+	}
+	if (tcsr == 0) {
+		tcsr = ml_io_map(TCSR_MUTEX_PHYS, 0x1000);
+	}
+	if (tcsr == 0) {
+		FAIL("no TCSR mutex mapping");
+		return false;
+	}
+	for (uint32_t ms = 0; ms <= 1000; ms++) {
+		wr32(tcsr, 0, 1);               /* QCOM_MUTEX_APPS_PROC_ID */
+		owner = rd32(tcsr, 0);
+		if (owner == 1) {
+			break;
+		}
+		IOSleep(1);
+	}
+	if (owner != 1) {
+		FAIL("SMEM hwlock 3 held by %u (item %u)", owner, item);
+		return false;
+	}
+	uint32_t free_uncached = rd32(smem, p + 12), free_cached = rd32(smem, p + 16);
+	for (at = 32; at < free_uncached;) {
+		uint32_t w0 = rd32(smem, p + at), sz = rd32(smem, p + at + 4), pad = rd32(smem, p + at + 8);
+		if ((w0 & 0xffff) != SMEM_CANARY || (w0 >> 16) == item || sz > psize) {
+			break;
+		}
+		at += 16 + (pad >> 16) + sz;
+	}
+	if (at != free_uncached || free_uncached > free_cached || at + 16 + size > free_cached) {
+		FAIL("SMEM partition walk for item %u ends at +%#x, free uncached +%#x cached +%#x: nothing written", item, at,
+		    free_uncached, free_cached);
+		goto out;
+	}
+	wr32(smem, p + at, SMEM_CANARY | item << 16);
+	wr32(smem, p + at + 4, size);
+	wr32(smem, p + at + 8, size - bytes);
+	wr32(smem, p + at + 12, 0);
+	wr32(smem, p + 12, at + 16 + size);
+	say("SMEM item %u: %u bytes at %#lx", item, bytes, SMEM_PHYS + p + at + 16);
+	made = true;
+out:
+	wr32(tcsr, 0, 0);
+	return made;
+}
+
+static void
+smp2p_entry(uint32_t i, const char *name, uint32_t value)
+{
+	char n[16];
+	uint32_t w[4];
+
+	bzero(n, sizeof(n));
+	strlcpy(n, name, sizeof(n));
+	memcpy(w, n, sizeof(w));
+	for (uint32_t k = 0; k < 4; k++) {
+		wr32(smem, our_item + 20 + 20 * i + 4 * k, w[k]);
+	}
+	wr32(smem, our_item + 36 + 20 * i, value);
+}
+
+static bool
+step_smp2p(void)
+{
+	uint32_t size = 0, valid = sleepstate ? 2 : 1;
+
+	announce("create/fill our SMP2P item 430 (0/3 partition, TCSR mutex 3) and ring the SLPI (IPCC 4/2)");
+	our_item = smem_item(ITEM_SMP2P_OURS, &size);
+	if (our_item == 0) {
+		if (!smem_alloc(ITEM_SMP2P_OURS, SMP2P_ITEM_SIZE)) {
+			return false;
+		}
+		our_item = smem_item(ITEM_SMP2P_OURS, &size);
+	}
+	if (our_item == 0 || size < SMP2P_ITEM_SIZE) {
+		FAIL("our item %u not found after allocation (%u bytes)", ITEM_SMP2P_OURS, size);
+		our_item = 0;
+		return false;
+	}
+	for (uint32_t at = 0; at < SMP2P_ITEM_SIZE; at += 4) {
+		wr32(smem, our_item + at, 0);
+	}
+	wr32(smem, our_item, SMP2P_MAGIC);
+	wr32(smem, our_item + 8, SMEM_APPS | SMEM_SLPI << 16);
+	smp2p_entry(0, "master-kernel", 0);
+	if (sleepstate) {
+		smp2p_entry(1, "sleepstate", SLEEPSTATE_AWAKE);
+	}
+	wr32(smem, our_item + 12, SMP2P_ENTRIES | valid << 16);
+	wr32(smem, our_item + 4, SMP2P_FEATURE_SSR_ACK << 8);
+	wr32(smem, our_item + 4, SMP2P_FEATURE_SSR_ACK << 8 | SMP2P_VERSION);
+	kick(IPCC_CLIENT_SLPI, IPCC_SIGNAL_SMP2P);
+	say("our SMP2P item at %#lx: magic %#x version %#x pids %#x counts %#x (master-kernel 0%s)", SMEM_PHYS + our_item,
+	    rd32(smem, our_item), rd32(smem, our_item + 4), rd32(smem, our_item + 8), rd32(smem, our_item + 12),
+	    sleepstate ? ", sleepstate 0x1000" : "");
+	return true;
+}
+
+/* ---- step 8: start ---- */
+
+static bool
+step_start(void)
+{
+	uint64_t answer = ~0ull;
+	uint32_t theirs = 0, size = 0, value = 0, last = ~0u, ms;
+	bool ready = false, fatal = false;
+
+	announce("ask TrustZone to authenticate and start the SLPI (PAS auth and reset, id 12)");
+	if (scm("PAS auth and reset (slpi)", SCM_64 | SCM_SIP | SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_SLPI, 0, 0,
+	    &answer) != 0 || answer != 0) {
+		FAIL("TrustZone does not start the SLPI (%#llx)", answer);
+		return false;               /* the thread does the PAS shutdown */
+	}
+	say("TRUSTZONE HAS RELEASED THE SLPI FROM RESET; waiting %u s for ready", wait_s);
+	for (ms = 0; ms < wait_s * 1000; ms++) {
+		if (theirs == 0) {
+			theirs = smem_item(ITEM_SMP2P_THEIRS, &size);
+			if (theirs) {
+				say("+%u ms: SLPI SMP2P item %u appears (%u bytes, version %#x)", ms, ITEM_SMP2P_THEIRS, size,
+				    rd32(smem, theirs + 4));
+			}
+		}
+		if (theirs && smp2p_value(theirs, "slave-kernel", &value) && value != last) {
+			say("+%u ms: slave-kernel = %#x%s%s%s%s", ms, value, value & DSP_FATAL ? " FATAL" : "",
+			    value & DSP_READY ? " READY" : "", value & DSP_HANDOVER ? " HANDOVER" : "",
+			    value & DSP_STOP_ACK ? " STOP-ACK" : "");
+			last = value;
+			if ((value & DSP_HANDOVER) && unvote) {
+				rails_drop("handover");
+			}
+			if (value & DSP_FATAL) {
+				fatal = true;
+				break;
+			}
+			if (value & DSP_READY) {
+				ready = true;
+				break;
+			}
+		}
+		IOSleep(1);
+	}
+	if (!ready) {
+		FAIL("%s after %u ms", fatal ? "SLPI REPORTS FATAL" : "NO READY FROM THE SLPI", ms);
+		last_words();
+		return false;               /* the thread does the PAS shutdown */
+	}
+	say("THE SLPI IS UP after %u ms", ms);
+	slpi_running = true;
+	for (uint32_t t = 0; t < 2000 && rails_on && unvote; t++) {
+		if (smp2p_value(theirs, "slave-kernel", &value) && (value & DSP_HANDOVER)) {
+			say("+%u ms: handover (slave-kernel = %#x)", ms + t, value);
+			rails_drop("handover");
+			break;
+		}
+		IOSleep(1);
+	}
+	if (rails_on) {
+		say("no handover seen: the rail votes stay at level 384");
+	}
+	if (theirs && smp2p_value(theirs, "sleepstate_see", &value)) {
+		say("SLPI entry sleepstate_see = %#x", value);
+	}
+	for (uint32_t item = ITEM_GLINK_DESC; item <= ITEM_GLINK_FIFO1; item++) {
+		uint32_t at = smem_item(item, &size);
+		say("GLINK SMEM item %u: %s (%u bytes)", item, at ? "present" : "absent", at ? size : 0);
+	}
+	return true;
+}
+
+static void qrtr_rx(const uint8_t *data, uint32_t len);
+
+/* ---- step 9: GLINK over SMEM, edge "dsps" (the protocol of negroni_adsp.c 0242, one channel of ours) ---- */
+
+#define GLINK_FIFO_SIZE         0x4000u
+#define GLINK_RESERVE           16u
+#define GL_VERSION              0
+#define GL_VERSION_ACK          1
+#define GL_OPEN                 2
+#define GL_CLOSE                3
+#define GL_OPEN_ACK             4
+#define GL_INTENT               5
+#define GL_RX_DONE              6
+#define GL_RX_INTENT_REQ        7
+#define GL_RX_INTENT_REQ_ACK    8
+#define GL_TX_DATA              9
+#define GL_CLOSE_ACK            11
+#define GL_TX_DATA_CONT         12
+#define GL_READ_NOTIF           13
+#define GL_RX_DONE_W_REUSE      14
+#define GL_SIGNALS              15
+#define GL_FEATURE_INTENT_REUSE 1u
+#define GL_OURS                 12
+#define GL_THEIRS               32
+#define GL_INTENT_SIZE          4096u
+#define GL_INTENT_MAX           0x4400u         /* live DT IPCRTR intents: 5 x 0x800, 3 x 0x2000, 2 x 0x4400 */
+#define GL_MSG_MAX              (GL_INTENT_MAX + 16)
+#define GL_LOG_MAX              8
+#define GL_SEEN_MAX             8
+
+struct gl_intent {
+	uint32_t id, size;
+	bool used;
+};
+
+struct gl_channel {
+	const char *name;
+	uint16_t lcid, rcid;
+	bool open_sent, remote_open, open_acked;
+	int32_t req_result;
+	struct gl_intent ours[GL_OURS];
+	uint8_t *buf[GL_OURS];
+	uint32_t fill[GL_OURS];
+	uint32_t nours;
+	struct gl_intent theirs[GL_THEIRS];
+	void (*rx)(const uint8_t *data, uint32_t len);
+	uint64_t rx_count, tx_count;
+};
+
+/* Only IPCRTR, and only at level 3. Everything else the SLPI opens is logged and left unanswered. */
+static struct gl_channel gl_ipcrtr = { .name = "IPCRTR", .lcid = 1 };
+static uint32_t gl_desc, gl_tx, gl_rx, gl_rx_len, gl_features = GL_FEATURE_INTENT_REUSE, gl_next_liid = 1;
+static bool gl_version_ok, gl_dead, gl_notified, gl_started;
+static uint8_t gl_msg[GL_MSG_MAX];
+static uint32_t gl_complaints, gl_nseen;
+static char gl_seen[GL_SEEN_MAX][33];
+static uint32_t gl_seen_rcid[GL_SEEN_MAX];
+#define gl_complain(fmt, ...) do { if (gl_complaints < GL_LOG_MAX) { gl_complaints++; say(fmt, ##__VA_ARGS__); } } while (0)
+
+static uint32_t
+gl_mod(uint32_t v, uint32_t len)
+{
+	return v >= len ? v - len : v;
+}
+
+static uint32_t
+gl_tx_avail(void)
+{
+	uint32_t tail = rd32(smem, gl_desc + 0), head = rd32(smem, gl_desc + 4);
+	uint32_t avail;
+
+	if (tail >= GLINK_FIFO_SIZE || head >= GLINK_FIFO_SIZE) {
+		gl_complain("GLINK: TX tail %#x / head %#x outside the FIFO: GLINK stopped", tail, head);
+		gl_dead = true;
+		return 0;
+	}
+	avail = tail <= head ? GLINK_FIFO_SIZE - head + tail : tail - head;
+	return avail < GLINK_RESERVE ? 0 : avail - GLINK_RESERVE;
+}
+
+static int
+gl_write(const void *msg, uint32_t len)
+{
+	const uint32_t *w = msg;
+	uint32_t head;
+
+	if (gl_dead || (len & 7) || len >= GLINK_FIFO_SIZE - GLINK_RESERVE) {
+		return EINVAL;
+	}
+	for (uint32_t ms = 0; gl_tx_avail() < len; ms++) {
+		if (gl_dead) {
+			return EIO;
+		}
+		if (ms == 200) {
+			gl_complain("GLINK: our TX FIFO stays full (tail %#x head %#x)", rd32(smem, gl_desc), rd32(smem, gl_desc + 4));
+			return ETIMEDOUT;
+		}
+		if (!gl_notified) {
+			gl_notified = true;
+			head = rd32(smem, gl_desc + 4);
+			uint32_t tl = rd32(smem, gl_desc + 0);
+			uint32_t raw = tl <= head ? GLINK_FIFO_SIZE - head + tl : tl - head;
+			if (raw > 8) {
+				wr32(smem, gl_tx + head, GL_READ_NOTIF);
+				wr32(smem, gl_tx + head + 4, 0);
+				wr32(smem, gl_desc + 4, gl_mod(head + 8, GLINK_FIFO_SIZE));
+				kick(IPCC_CLIENT_SLPI, IPCC_SIGNAL_GLINK);
+			}
+		}
+		IOSleep(1);
+	}
+	gl_notified = false;
+	head = rd32(smem, gl_desc + 4);
+	for (uint32_t i = 0; i < len / 4; i++) {
+		wr32(smem, gl_tx + head, w[i]);
+		head = gl_mod(head + 4, GLINK_FIFO_SIZE);
+	}
+	wr32(smem, gl_desc + 4, head);
+	kick(IPCC_CLIENT_SLPI, IPCC_SIGNAL_GLINK);
+	return 0;
+}
+
+static int
+gl_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	uint32_t m[2] = { cmd | (uint32_t)p1 << 16, p2 };
+	return gl_write(m, sizeof(m));
+}
+
+static uint32_t
+gl_rx_avail(void)
+{
+	uint32_t size = 0;
+
+	if (gl_rx == 0) {
+		gl_rx = smem_item(ITEM_GLINK_FIFO1, &size);
+		if (gl_rx == 0) {
+			return 0;
+		}
+		gl_rx_len = size & ~7u;
+		say("GLINK: the SLPI's FIFO (item %u) is there: %#x bytes", ITEM_GLINK_FIFO1, size);
+		if (gl_rx_len < 64 || gl_rx_len > 0x100000) {
+			say("GLINK: FIFO size %#x is not usable: GLINK stopped", size);
+			gl_dead = true;
+			gl_rx = 0;
+			return 0;
+		}
+	}
+	uint32_t tail = rd32(smem, gl_desc + 8), head = rd32(smem, gl_desc + 12);
+	if (head >= gl_rx_len || tail >= gl_rx_len) {
+		say("GLINK: RX head %#x / tail %#x outside the FIFO (%#x): GLINK stopped", head, tail, gl_rx_len);
+		gl_dead = true;
+		return 0;
+	}
+	return head >= tail ? head - tail : gl_rx_len - tail + head;
+}
+
+static void
+gl_peek(uint32_t off, void *dst, uint32_t len)
+{
+	uint32_t *w = dst, at = gl_mod(rd32(smem, gl_desc + 8) + off, gl_rx_len);
+
+	for (uint32_t i = 0; i < (len + 3) / 4; i++) {
+		w[i] = rd32(smem, gl_rx + at);
+		at = gl_mod(at + 4, gl_rx_len);
+	}
+}
+
+static void
+gl_advance(uint32_t len)
+{
+	wr32(smem, gl_desc + 8, gl_mod(rd32(smem, gl_desc + 8) + ((len + 7) & ~7u), gl_rx_len));
+}
+
+static bool
+gl_up(void)
+{
+	return !gl_dead && gl_ipcrtr.remote_open && gl_ipcrtr.open_acked;
+}
+
+static int
+gl_send_open(struct gl_channel *ch)
+{
+	uint32_t m[2 + 8] = { 0 }, n = (uint32_t)strlen(ch->name) + 1;
+
+	m[0] = GL_OPEN | (uint32_t)ch->lcid << 16;
+	m[1] = n;
+	memcpy(&m[2], ch->name, n);
+	ch->open_sent = true;
+	return gl_write(m, (8 + n + 7) & ~7u);
+}
+
+static int
+gl_advertise(struct gl_channel *ch, unsigned i)
+{
+	uint32_t m[4] = { GL_INTENT | (uint32_t)ch->lcid << 16, 1, ch->ours[i].size, ch->ours[i].id };
+
+	return gl_write(m, sizeof(m));
+}
+
+static bool
+gl_add_intent(struct gl_channel *ch, uint32_t size)
+{
+	vm_offset_t b = 0;
+	uint32_t bytes = MAX(size, GL_INTENT_SIZE);
+
+	if (ch->nours >= GL_OURS || size > GL_INTENT_MAX ||
+	    kmem_alloc(kernel_map, &b, round_page(bytes), KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	unsigned i = ch->nours++;
+	ch->buf[i] = (uint8_t *)b;
+	ch->ours[i] = (struct gl_intent){ gl_next_liid++, bytes, false };
+	ch->fill[i] = 0;
+	return gl_advertise(ch, i) == 0;
+}
+
+static void
+gl_rx_data(struct gl_channel *ch, uint32_t liid, const uint8_t *data, uint32_t chunk, uint32_t left)
+{
+	unsigned i;
+
+	for (i = 0; i < ch->nours && ch->ours[i].id != liid; i++) {
+	}
+	if (i == ch->nours) {
+		gl_complain("GLINK: %s: data for an intent %u we never gave", ch->name, liid);
+		return;
+	}
+	if (ch->fill[i] + chunk > ch->ours[i].size) {
+		gl_complain("GLINK: %s: %u + %u bytes do not fit intent %u: dropped", ch->name, ch->fill[i], chunk, liid);
+		ch->fill[i] = 0;
+		return;
+	}
+	memcpy(ch->buf[i] + ch->fill[i], data, chunk);
+	ch->fill[i] += chunk;
+	if (left) {
+		return;
+	}
+	uint32_t whole = ch->fill[i];
+	ch->fill[i] = 0;
+	ch->rx_count++;
+	if (ch->rx) {
+		ch->rx(ch->buf[i], whole);
+	}
+	if (gl_features & GL_FEATURE_INTENT_REUSE) {
+		(void)gl_cmd(GL_RX_DONE_W_REUSE, ch->lcid, liid);
+	} else {
+		(void)gl_cmd(GL_RX_DONE, ch->lcid, liid);
+		ch->ours[i].id = gl_next_liid++;
+		(void)gl_advertise(ch, i);
+	}
+}
+
+static struct gl_channel *
+gl_by_rcid(uint32_t rcid)
+{
+	return gl_ipcrtr.remote_open && gl_ipcrtr.rcid == rcid ? &gl_ipcrtr : NULL;
+}
+
+static void
+gl_note_open(const char *name, uint32_t rcid, bool ours)
+{
+	for (uint32_t i = 0; i < gl_nseen; i++) {
+		if (strcmp(gl_seen[i], name) == 0) {
+			gl_complain("GLINK: the SLPI opens \"%s\" again (rcid %u)", name, rcid);
+			return;
+		}
+	}
+	if (gl_nseen < GL_SEEN_MAX) {
+		strlcpy(gl_seen[gl_nseen], name, sizeof(gl_seen[0]));
+		gl_seen_rcid[gl_nseen] = rcid;
+		gl_nseen++;
+	}
+	say("GLINK: the SLPI opens \"%s\" (rcid %u): %s", name, rcid, ours ? "ours, answered" : "not ours, left unanswered");
+}
+
+static void
+gl_poll(void)
+{
+	for (int n = 0; n < 256 && !gl_dead; n++) {
+		uint32_t avail = gl_rx_avail(), hdr[4], cmd, p1, p2, need = 8;
+		struct gl_channel *ch;
+
+		if (avail < 8) {
+			return;
+		}
+		gl_peek(0, hdr, 8);
+		cmd = hdr[0] & 0xffff;
+		p1 = hdr[0] >> 16;
+		p2 = hdr[1];
+		switch (cmd) {
+		case GL_VERSION:
+			if (p1 == 1) {
+				gl_features &= p2;
+			}
+			gl_advance(8);
+			if (p1 != 0) {
+				(void)gl_cmd(GL_VERSION_ACK, 1, gl_features);
+				if (!gl_version_ok) {
+					say("GLINK: the SLPI offers version %u features %#x: version 1 ok (features %#x)", p1, p2, gl_features);
+				}
+				gl_version_ok = true;
+			}
+			break;
+		case GL_VERSION_ACK:
+			gl_advance(8);
+			if (p1 == 0) {
+				say("GLINK: the SLPI refuses version 1: GLINK stopped");
+				gl_dead = true;
+			} else if (p1 == 1 && p2 != gl_features) {
+				gl_features &= p2;
+				(void)gl_cmd(GL_VERSION, 1, gl_features);
+			} else {
+				if (!gl_version_ok) {
+					say("GLINK: version 1 ok (features %#x)", gl_features);
+				}
+				gl_version_ok = true;
+			}
+			break;
+		case GL_OPEN: {
+			char name[33];
+			uint32_t len = p2 & 0xffff, w[10];
+
+			need = 8 + len;
+			if (len > GL_INTENT_MAX || need > gl_rx_len - 8) {
+				say("GLINK: OPEN with a %u-byte name: GLINK stopped", len);
+				gl_dead = true;
+				return;
+			}
+			if (avail < need) {
+				return;
+			}
+			bzero(name, sizeof(name));
+			gl_peek(0, w, 8 + MIN(len, 32u));
+			memcpy(name, (uint8_t *)w + 8, MIN(len, 32u));
+			name[32] = 0;
+			gl_advance(need);
+			if (level >= 3 && strcmp(name, gl_ipcrtr.name) == 0) {
+				gl_ipcrtr.rcid = (uint16_t)p1;
+				gl_ipcrtr.remote_open = true;
+				gl_note_open(name, p1, true);
+				(void)gl_cmd(GL_OPEN_ACK, gl_ipcrtr.rcid, 0);
+				if (!gl_ipcrtr.open_sent) {
+					(void)gl_send_open(&gl_ipcrtr);
+				}
+			} else {
+				gl_note_open(name, p1, false);
+			}
+			break;
+		}
+		case GL_CLOSE:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			say("GLINK: the SLPI closes rcid %u (%s)", p1, ch ? ch->name : "not ours");
+			if (ch) {
+				(void)gl_cmd(GL_CLOSE_ACK, (uint16_t)p1, 0);
+				ch->remote_open = false;
+			}
+			break;
+		case GL_CLOSE_ACK:
+			gl_advance(8);
+			break;
+		case GL_OPEN_ACK:
+			gl_advance(8);
+			if (gl_ipcrtr.lcid == p1 && gl_ipcrtr.open_sent) {
+				gl_ipcrtr.open_acked = true;
+				say("GLINK: the SLPI acks our open of %s", gl_ipcrtr.name);
+			}
+			break;
+		case GL_INTENT: {
+			uint32_t pair[2];
+
+			need = 8 + 8 * p2;
+			if (p2 > 64 || need > gl_rx_len - 8) {
+				say("GLINK: INTENT with %u entries: GLINK stopped", p2);
+				gl_dead = true;
+				return;
+			}
+			if (avail < need) {
+				return;
+			}
+			ch = gl_by_rcid(p1);
+			for (uint32_t i = 0; ch && i < p2; i++) {
+				gl_peek(8 + 8 * i, pair, 8);
+				for (unsigned k = 0; k < GL_THEIRS; k++) {
+					if (ch->theirs[k].size == 0) {
+						ch->theirs[k] = (struct gl_intent){ pair[1], pair[0], false };
+						break;
+					}
+				}
+			}
+			gl_advance(need);
+			break;
+		}
+		case GL_RX_DONE:
+		case GL_RX_DONE_W_REUSE:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			for (unsigned k = 0; ch && k < GL_THEIRS; k++) {
+				if (ch->theirs[k].size && ch->theirs[k].id == p2) {
+					if (cmd == GL_RX_DONE) {
+						ch->theirs[k].size = 0;
+					}
+					ch->theirs[k].used = false;
+				}
+			}
+			break;
+		case GL_RX_INTENT_REQ:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			if (ch) {
+				bool granted = gl_add_intent(ch, p2);
+				(void)gl_cmd(GL_RX_INTENT_REQ_ACK, ch->lcid, granted);
+				if (!granted) {
+					gl_complain("GLINK: %s: the SLPI asks for an intent of %u bytes: refused", ch->name, p2);
+				}
+			} else {
+				gl_complain("GLINK: the SLPI asks for an intent of %u bytes on rcid %u (not ours): no answer", p2, p1);
+			}
+			break;
+		case GL_RX_INTENT_REQ_ACK:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			if (ch) {
+				ch->req_result = (int32_t)p2;
+			}
+			break;
+		case GL_TX_DATA:
+		case GL_TX_DATA_CONT: {
+			uint32_t chunk, left;
+
+			if (avail < 16) {
+				return;
+			}
+			gl_peek(0, hdr, 16);
+			chunk = hdr[2];
+			left = hdr[3];
+			need = 16 + chunk;
+			if (chunk > GL_INTENT_MAX || need > gl_rx_len - 8) {
+				say("GLINK: a %u-byte chunk is bigger than any intent of ours: GLINK stopped", chunk);
+				gl_dead = true;
+				return;
+			}
+			if (avail < need) {
+				return;
+			}
+			gl_peek(16, gl_msg, chunk);
+			gl_advance(need);
+			ch = gl_by_rcid(p1);
+			if (ch) {
+				gl_rx_data(ch, p2, gl_msg, chunk, left);
+			} else {
+				gl_complain("GLINK: %u bytes on rcid %u (not ours): dropped", chunk, p1);
+			}
+			break;
+		}
+		case GL_READ_NOTIF:
+			gl_advance(8);
+			kick(IPCC_CLIENT_SLPI, IPCC_SIGNAL_GLINK);
+			break;
+		case GL_SIGNALS:
+			gl_advance(8);
+			break;
+		default:
+			say("GLINK: unknown command %u (%#x %#x): GLINK stopped", cmd, hdr[0], hdr[1]);
+			gl_dead = true;
+			return;
+		}
+	}
+}
+
+/* One message on IPCRTR: needs a remote intent (asks with RX_INTENT_REQ, waits up to 1 s). */
+static int
+gl_send(const void *data, uint32_t len)
+{
+	struct gl_channel *ch = &gl_ipcrtr;
+	struct gl_intent *best = NULL;
+	static uint32_t m[(16 + GL_INTENT_SIZE + 7) / 4];
+
+	if (len == 0 || len > GL_INTENT_SIZE) {
+		return EINVAL;
+	}
+	if (!gl_up()) {
+		return ENOTCONN;
+	}
+	for (int round = 0; round < 2 && best == NULL; round++) {
+		for (unsigned k = 0; k < GL_THEIRS; k++) {
+			struct gl_intent *t = &ch->theirs[k];
+			if (t->size >= len && !t->used && (best == NULL || t->size < best->size)) {
+				best = t;
+			}
+		}
+		if (best == NULL && round == 0) {
+			ch->req_result = -1;
+			if (gl_cmd(GL_RX_INTENT_REQ, ch->lcid, len) != 0) {
+				return EIO;
+			}
+			for (uint32_t ms = 0; ms < 1000 && ch->req_result < 0 && !gl_dead; ms++) {
+				gl_poll();
+				if (ch->req_result < 0) {
+					IOSleep(1);
+				}
+			}
+			gl_poll();
+			if (ch->req_result <= 0) {
+				gl_complain("GLINK: %s: the SLPI gives no intent for %u bytes (answer %d)", ch->name, len, ch->req_result);
+				return EAGAIN;
+			}
+		}
+	}
+	if (best == NULL) {
+		return EAGAIN;
+	}
+	best->used = true;
+	m[0] = GL_TX_DATA | (uint32_t)ch->lcid << 16;
+	m[1] = best->id;
+	m[2] = len;
+	m[3] = 0;
+	memcpy(&m[4], data, len);
+	bzero((uint8_t *)&m[4] + len, ((len + 7) & ~7u) - len);
+	if (gl_write(m, 16 + ((len + 7) & ~7u)) != 0) {
+		best->used = false;
+		return EIO;
+	}
+	ch->tx_count++;
+	return 0;
+}
+
+static void
+gl_summary(void)
+{
+	char list[GL_SEEN_MAX * 40];
+
+	list[0] = 0;
+	for (uint32_t i = 0; i < gl_nseen; i++) {
+		char one[48];
+		snprintf(one, sizeof(one), "%s%s (rcid %u)", i ? ", " : "", gl_seen[i], gl_seen_rcid[i]);
+		strlcat(list, one, sizeof(list));
+	}
+	say("GLINK: version %s, the SLPI opened %u channel(s): %s%s", gl_version_ok ? "ok" : "no answer", gl_nseen,
+	    gl_nseen ? list : "none", gl_dead ? "; GLINK stopped" : "");
+}
+
+static bool
+step_glink(void)
+{
+	uint32_t size = 0, ms;
+	uint32_t window = MIN(listen_s, 120u) * 1000;
+
+	announce("GLINK dsps: allocate SMEM items 478 (descriptors) and 479 (our TX FIFO) in 0/3, say version 1");
+	if (!smem_alloc(ITEM_GLINK_DESC, 32) || !smem_alloc(ITEM_GLINK_FIFO0, GLINK_FIFO_SIZE)) {
+		return false;
+	}
+	gl_desc = smem_item(ITEM_GLINK_DESC, &size);
+	if (gl_desc == 0 || size != 32) {
+		FAIL("GLINK descriptor item %u: %s (%u bytes)", ITEM_GLINK_DESC, gl_desc ? "wrong size" : "absent", size);
+		gl_desc = 0;
+		return false;
+	}
+	gl_tx = smem_item(ITEM_GLINK_FIFO0, &size);
+	if (gl_tx == 0 || size < GLINK_FIFO_SIZE) {
+		FAIL("GLINK TX FIFO item %u: %s (%u bytes)", ITEM_GLINK_FIFO0, gl_tx ? "too small" : "absent", size);
+		gl_tx = 0;
+		return false;
+	}
+	wr32(smem, gl_desc + 8, 0);             /* our RX tail */
+	wr32(smem, gl_desc + 4, 0);             /* our TX head */
+	gl_started = true;
+	say("GLINK: descriptors at %#lx, TX FIFO at %#lx (%#x bytes)", SMEM_PHYS + gl_desc, SMEM_PHYS + gl_tx, size);
+	if (gl_cmd(GL_VERSION, 1, gl_features) != 0) {
+		FAIL("GLINK: VERSION does not go out");
+		return false;
+	}
+	/* level 2: only listen. level 3: open IPCRTR as soon as the version is agreed. */
+	for (ms = 0; ms < window && !gl_dead; ms++) {
+		gl_poll();
+		if (level >= 3 && gl_version_ok && !gl_ipcrtr.open_sent) {
+			gl_ipcrtr.rx = qrtr_rx;         /* review F5: no QRTR packet is lost during step 9 */
+			say("GLINK: open %s (lcid %u)", gl_ipcrtr.name, gl_ipcrtr.lcid);
+			(void)gl_send_open(&gl_ipcrtr);
+		}
+		if (level >= 3 && gl_up()) {
+			break;
+		}
+		IOSleep(1);
+	}
+	gl_summary();
+	if (gl_dead || !gl_version_ok) {
+		FAIL("GLINK: %s after %u ms (FIFO 480 %s)", gl_dead ? "stopped" : "no version answer", ms, gl_rx ? "there" : "missing");
+		return false;
+	}
+	if (level < 3) {
+		say("GLINK UP (listen only) after %u ms", ms);
+		return true;
+	}
+	if (!gl_up()) {
+		FAIL("GLINK: IPCRTR not up after %u ms (remote open %u, ack %u)", ms, gl_ipcrtr.remote_open, gl_ipcrtr.open_acked);
+		return false;
+	}
+	/* up to 8, leaves 4 slots for RX_INTENT_REQ (the SLPI may have asked for some already: review F8) */
+	for (unsigned i = 0; gl_ipcrtr.nours + 4 < GL_OURS && i < 8; i++) {
+		if (!gl_add_intent(&gl_ipcrtr, GL_INTENT_SIZE)) {
+			FAIL("GLINK: IPCRTR: intent %u not given", i);
+			return false;
+		}
+	}
+	gl_poll();
+	say("GLINK UP after %u ms: IPCRTR open (lcid %u rcid %u), %u intents of %u bytes given", ms, gl_ipcrtr.lcid,
+	    gl_ipcrtr.rcid, gl_ipcrtr.nours, GL_INTENT_SIZE);
+	return true;
+}
+
+/* ---- step 10: QRTR on IPCRTR (as negroni_audio.c step 10; log only, no server of ours) ---- */
+
+struct qrtr_hdr {
+	uint32_t version, type, src_node, src_port, confirm_rx, size, dst_node, dst_port;
+} __attribute__((packed));
+#define QRTR_CTRL_BYTES         20u
+#define QRTR_VER                1u
+#define QRTR_TYPE_DATA          1u
+#define QRTR_TYPE_HELLO         2u
+#define QRTR_TYPE_BYE           3u
+#define QRTR_TYPE_NEW_SERVER    4u
+#define QRTR_TYPE_DEL_SERVER    5u
+#define QRTR_TYPE_DEL_CLIENT    6u
+#define QRTR_TYPE_RESUME_TX     7u
+#define QRTR_TYPE_EXIT          8u
+#define QRTR_TYPE_PING          9u
+#define QRTR_TYPE_NEW_LOOKUP    10u
+#define QRTR_TYPE_DEL_LOOKUP    11u
+#define QRTR_PORT_CTRL          0xfffffffeu
+#define QRTR_NODE_BCAST         0xffffffffu
+#define QRTR_LOCAL_NODE         1u
+#define QRTR_LOG_MAX            64
+#define SNS_CLIENT_SERVICE      400u            /* 0x190: live DT qcom,no-wake-svc; SEE sns_client */
+
+static uint32_t qrtr_node = ~0u, qrtr_servers, qrtr_lines, qrtr_other, qrtr_data, qrtr_hellos;
+static uint32_t sns_node = ~0u, sns_port, sns_instance;
+#define qrtr_say(fmt, ...) do { if (qrtr_lines < QRTR_LOG_MAX) { qrtr_lines++; say(fmt, ##__VA_ARGS__); } } while (0)
+
+static void
+qrtr_send_ctrl(uint32_t cmd, uint32_t dst_node)
+{
+	uint32_t pkt[(sizeof(struct qrtr_hdr) + QRTR_CTRL_BYTES) / 4];
+	struct qrtr_hdr h = {
+		.version = QRTR_VER, .type = cmd, .src_node = QRTR_LOCAL_NODE, .src_port = QRTR_PORT_CTRL,
+		.confirm_rx = 0, .size = QRTR_CTRL_BYTES, .dst_node = dst_node, .dst_port = QRTR_PORT_CTRL,
+	};
+	int error;
+
+	bzero(pkt, sizeof(pkt));
+	memcpy(pkt, &h, sizeof(h));
+	pkt[sizeof(h) / 4] = cmd;
+	error = gl_send(pkt, sizeof(pkt));
+	if (error) {
+		qrtr_say("QRTR: control %u to node %#x does not go out (errno %d)", cmd, dst_node, error);
+	}
+}
+
+static const char *
+qrtr_service_name(uint32_t service)
+{
+	switch (service) {
+	case 0x10: return "TFTP";
+	case 0x2b: return "SSCTL";
+	case 0x40: return "servreg locator";
+	case 0x42: return "servreg notifier";
+	case 0x1a: return "TMD";
+	case SNS_CLIENT_SERVICE: return "SNS client (sns_client, SEE)";
+	default: return "";
+	}
+}
+
+static void
+qrtr_rx(const uint8_t *data, uint32_t len)
+{
+	struct qrtr_hdr h;
+	uint32_t b[5];
+
+	if (len < sizeof(h)) {
+		qrtr_say("QRTR: %u-byte packet without a header", len);
+		return;
+	}
+	memcpy(&h, data, sizeof(h));
+	if (h.version != QRTR_VER) {
+		qrtr_say("QRTR: version %u packet (type %u): ignored", h.version, h.type);
+		return;
+	}
+	bzero(b, sizeof(b));
+	memcpy(b, data + sizeof(h), MIN(len - (uint32_t)sizeof(h), (uint32_t)sizeof(b)));
+	if (h.type != QRTR_TYPE_DATA) {
+		qrtr_node = h.src_node;
+	}
+	switch (h.type) {
+	case QRTR_TYPE_HELLO:
+		qrtr_say("QRTR: HELLO from node %u", h.src_node);
+		if (qrtr_hellos++ < 4) {
+			qrtr_send_ctrl(QRTR_TYPE_HELLO, h.src_node);    /* answer, as the Linux core does */
+		}
+		break;
+	case QRTR_TYPE_NEW_SERVER:
+		if (len < sizeof(h) + QRTR_CTRL_BYTES) {
+			break;
+		}
+		qrtr_servers++;
+		/* b[1] service, b[2] instance (version | instance << 8), b[3] node, b[4] port */
+		qrtr_say("QRTR: NEW_SERVER service %u (%#x) version %u instance %u node %u port %#x %s", b[1], b[1], b[2] & 0xff,
+		    b[2] >> 8, b[3], b[4], qrtr_service_name(b[1]));
+		if (b[1] == SNS_CLIENT_SERVICE) {
+			sns_node = b[3];
+			sns_port = b[4];
+			sns_instance = b[2];
+		}
+		break;
+	case QRTR_TYPE_DEL_SERVER:
+		qrtr_say("QRTR: DEL_SERVER service %u instance %#x node %u port %#x", b[1], b[2], b[3], b[4]);
+		break;
+	case QRTR_TYPE_NEW_LOOKUP:
+		qrtr_say("QRTR: the SLPI looks up service %u (%#x) instance %#x %s", b[1], b[1], b[2], qrtr_service_name(b[1]));
+		break;
+	case QRTR_TYPE_BYE:
+		qrtr_say("QRTR: BYE from node %u", h.src_node);
+		break;
+	case QRTR_TYPE_DATA:
+		qrtr_data++;
+		qrtr_say("QRTR: DATA %u bytes from %u:%#x to %u:%#x (no server of ours: dropped)", h.size, h.src_node, h.src_port,
+		    h.dst_node, h.dst_port);
+		break;
+	default:
+		qrtr_other++;
+		qrtr_say("QRTR: control type %u from node %u (%#x %#x %#x %#x)", h.type, h.src_node, b[1], b[2], b[3], b[4]);
+		break;
+	}
+}
+
+static bool
+step_qrtr(void)
+{
+	uint32_t window = MIN(listen_s, 120u) * 1000;
+
+	announce("QRTR: say HELLO on the SLPI IPCRTR, log the SLPI's servers");
+	if (!gl_up()) {
+		FAIL("GLINK channel IPCRTR is not up");
+		return false;
+	}
+	gl_ipcrtr.rx = qrtr_rx;
+	qrtr_send_ctrl(QRTR_TYPE_HELLO, QRTR_NODE_BCAST);
+	for (uint32_t ms = 0; ms < window && !gl_dead; ms++) {
+		gl_poll();
+		IOSleep(1);
+	}
+	say("QRTR: SLPI node %s%u, %u NEW_SERVER, %u DATA, %u other packets in %u s", qrtr_node == ~0u ? "unknown " : "",
+	    qrtr_node == ~0u ? 0 : qrtr_node, qrtr_servers, qrtr_data, qrtr_other, window / 1000);
+	if (sns_node != ~0u) {
+		say("SNS CLIENT SERVICE 400 IS THERE: node %u port %#x version %u instance %u", sns_node, sns_port,
+		    sns_instance & 0xff, sns_instance >> 8);
+	} else {
+		say("no service 400 (sns_client) announced (phase 2: the sensor PD may wait for the servreg locator)");
+	}
+	gl_summary();
+	if (gl_dead) {
+		FAIL("GLINK stopped during the QRTR window");
+		return false;
+	}
+	return true;
+}
+
+/* ---- thread ---- */
+
+static bool (*const steps[STEPS + 1])(void) = {
+	step_wait_adsp, step_survey, step_firmware, step_rails, step_aop, step_pas_init, step_load, step_smp2p,
+	step_start, step_glink, step_qrtr,
+};
+
+/*
+ * The crash watch (0248 for the ADSP): every 200 ms FATAL in "slave-kernel"; GLINK polled when step 9
+ * ran (the SLPI must not find our RX FIFO full). FATAL: last words, our "stop" bit + up to 5 s for
+ * STOP-ACK, PAS shutdown. No restart in this boot.
+ */
+static void
+slpi_watch(void)
+{
+	uint32_t size = 0, value = 0, last = ~0u, theirs = 0;
+
+	say("watch: polling slave-kernel every 200 ms for FATAL%s", gl_started && !gl_dead ? ", GLINK too" : "");
+	for (;;) {
+		IOSleep(200);
+		if (gl_started && !gl_dead) {
+			gl_poll();
+		}
+		if (theirs == 0) {
+			theirs = smem_item(ITEM_SMP2P_THEIRS, &size);
+		}
+		if (theirs == 0 || !smp2p_value(theirs, "slave-kernel", &value) || value == last) {
+			continue;
+		}
+		say("watch: slave-kernel = %#x%s%s", value, value & DSP_FATAL ? " FATAL" : "", value & DSP_STOP_ACK ? " STOP-ACK" : "");
+		last = value;
+		if (value & DSP_FATAL) {
+			break;
+		}
+	}
+	say("SLPI FATAL AFTER START: stop, PAS shutdown (no restart in this boot)");
+	last_words();
+	gl_dead = true;
+	if (our_item) {
+		wr32(smem, our_item + 36, rd32(smem, our_item + 36) | 1u);     /* master-kernel: "stop" */
+		kick(IPCC_CLIENT_SLPI, IPCC_SIGNAL_SMP2P);
+		for (uint32_t ms = 0; ms < 5000; ms += 10) {
+			if (smp2p_value(theirs, "slave-kernel", &value) && (value & DSP_STOP_ACK)) {
+				say("watch: STOP-ACK after %u ms", ms);
+				break;
+			}
+			IOSleep(10);
+		}
+		wr32(smem, our_item + 36, rd32(smem, our_item + 36) & ~1u);
+		kick(IPCC_CLIENT_SLPI, IPCC_SIGNAL_SMP2P);
+	}
+	pas_shutdown("SLPI fatal after start");
+	slpi_running = false;
+}
+
+static void
+slpi_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	bool failed = false;
+
+	for (step = 0; step <= last_step; step++) {
+		uint64_t t0 = mach_absolute_time(), ns = 0;
+		bool ok;
+
+		fail_why[0] = 0;
+		ok = steps[step]();
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		if (!ok) {
+			printf("NEGRONI SLPI: step %u (%s) failed: %s (after %llu ms)\n", step, step_names[step],
+			    fail_why[0] ? fail_why : "no reason logged", ns / 1000000);
+			failed = true;
+			break;
+		}
+		printf("NEGRONI SLPI: step %u (%s) ok in %llu ms%s\n", step, step_names[step], ns / 1000000,
+		    step >= 1 && ns / 1000000 > step_budget_ms ? " (OVER the step time limit)" : "");
+	}
+	/* PAS init done but no running SLPI (steps 5..8 failed): give the image back to TrustZone */
+	if (failed && pas_inited && !slpi_running) {
+		pas_shutdown("a step after PAS init failed");
+	}
+	if (failed && !slpi_running) {
+		rails_drop("start failed");
+	}
+	printf("NEGRONI SLPI: done (level %u, asked 0..%u, %s at %u)%s\n", level, last_step, failed ? "stopped" : "complete",
+	    MIN(step, last_step), slpi_running ? "; the SLPI runs" : "");
+	if (slpi_running) {
+		slpi_watch();
+	}
+	(void)thread_terminate(current_thread());
+}
+
+void
+negroni_slpi_init(void)
+{
+	uint32_t want = 0;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("negronislpi", &level, sizeof(level));
+	if (level == 0) {
+		return;
+	}
+	level = MIN(level, 3u);
+	last_step = 7 + level;                  /* 1 -> 8, 2 -> 9, 3 -> 10 */
+	if (PE_parse_boot_argn("negronislpi_step", &want, sizeof(want))) {
+		last_step = MIN(last_step, MAX(want, 1u));
+	}
+	(void)PE_parse_boot_argn("negronislpi_pause", &pause_ms, sizeof(pause_ms));
+	(void)PE_parse_boot_argn("negronislpi_wait", &wait_s, sizeof(wait_s));
+	(void)PE_parse_boot_argn("negronislpi_unvote", &unvote, sizeof(unvote));
+	(void)PE_parse_boot_argn("negronislpi_sleepstate", &sleepstate, sizeof(sleepstate));
+	(void)PE_parse_boot_argn("negronislpi_listen", &listen_s, sizeof(listen_s));
+	(void)PE_parse_boot_argn("negronislpi_adspwait", &adsp_wait_s, sizeof(adsp_wait_s));
+	(void)PE_parse_boot_argn("negronislpi_steptimeout", &step_budget_ms, sizeof(step_budget_ms));
+	wait_s = MIN(MAX(wait_s, 1u), 60u);
+	listen_s = MIN(MAX(listen_s, 1u), 120u);
+	adsp_wait_s = MIN(adsp_wait_s, 600u);
+	step_budget_ms = MIN(MAX(step_budget_ms, 1000u), 120000u);
+	pause_ms = MIN(pause_ms, 10000u);
+	printf("NEGRONI SLPI: level %u, steps 0..%u (UNTESTED: PAS id %u, carveout %#lx + %#x)\n", level, last_step, PAS_SLPI,
+	    SLPI_MEM_PHYS, SLPI_MEM_SIZE);
+	if (kernel_thread_start(slpi_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("NEGRONI SLPI: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_smmu_s1.c b/bsd/dev/negroni_smmu_s1.c
new file mode 100644
index 0000000..5da5c50
--- /dev/null
+++ b/bsd/dev/negroni_smmu_s1.c
@@ -0,0 +1,937 @@
+/*
+ * NEGRONI (SM8450): apps-SMMU stage-1 contexts of our own (patch 0249). See negroni_smmu_s1.h for why
+ * and for the rules that keep this file and the Wi-Fi copy (0324 negroni_wlan_smmu.c) apart.
+ *
+ * Order (Linux arm-smmu.c arm_smmu_write_context_bank / arm_smmu_write_sme, io-pgtable-arm.c; the same
+ * values as negroni_adreno.c (0233) and negroni_wlan_smmu.c (0324) on this SoC): context bank off,
+ * CBA2R (VA64), CBAR (stage 1, stage 2 bypass), TCR2/TCR (39-bit input, 36-bit output, 4 KiB granule),
+ * TTBR0 (+ ASID = context index), MAIR0, fault status clear, TLB invalidate + sync, SCTLR on; then per
+ * stream S2CR (translate, context index) and only then the SMR valid bit. Every global write is read
+ * back; a refused write stops before any DMA; stream entries are put back, CBAR/CBA2R never (see below).
+ * 0379: "read back" = the fields we own (TCR2_OWN etc., the 0325 rule); other bits are printed and accepted.
+ * Hardware: live.dts:15350-15370 apps-smmu@15000000 (qcom,qsmmu-v500, qcom,skip-init,
+ * qcom,num-smr-override 0x78, qcom,num-context-banks-override 0x4e). The first version panicked on hardware
+ * (2026-10-27, below); this version is not yet run on hardware.
+ *
+ * 2026-10-27 rework, after the panic of the first boot with 0249 (Kernel data abort, ESR 0x96000010, FAR
+ * offset 0x128 of global page 1 = CBAR(74), pc at the CBAR restore in undo(): Gunyah refused the write
+ * of the old CBAR (type S2_TRANS) with an SEA):
+ *   - every global/context access of setup, teardown and probe goes through negroni_mmio_try_rd32/wr32
+ *     (0297): a refused access is an error, not a panic; a kernel without that hook (no CONFIG_XNUPOST)
+ *     gets no stage-1 context at all (ENOTSUP);
+ *   - teardown is Linux's: arm_smmu_destroy_domain_context -> arm_smmu_write_context_bank(cfg NULL) writes
+ *     SCTLR = 0 only (OnePlus sm8450 arm-smmu.c:1168-1171, 1779-1833). CBAR and CBA2R are never written
+ *     back (HakiOS hakios.wifi.c/sound.c/camera.c do the same and ran on SM7325); the bank goes on a
+ *     "released by us" list and is reused by the next negroni_s1_on;
+ *   - context banks from the bottom up, from IDR1.NUMS2CB (Linux arm_smmu_init_domain_context: stage-1
+ *     start = num_s2_context_banks, arm-smmu.c:1572-1574; HakiOS used contexts 7/8); a bank whose claim
+ *     write (CBA2R/CBAR) is refused or not kept is skipped (no restore write), up to 8 candidates;
+ *   - TLB sync: TLBIASID, TLBSYNC, TLBSTATUS polled up to 500 ms with a doubling delay (Linux
+ *     __arm_smmu_tlb_sync, TLB_LOOP_TIMEOUT 500000 us; was 10 ms); a time-out prints the TBU sync/inv
+ *     ack state (IMPL_DEF5 + 0x5dc) and GR0 + 0x2670 (qsmmuv500_tlb_sync_timeout);
+ *   - negronismmu_probe=1|2 (default 0): one survey of all banks at boot: reads plus a same-value CBAR write
+ *     (see negroni_smmu_probe); result again in the log after negronismmu_probe_again s (default 60) and in
+ *     sysctl kern.negroni_smmu_probe (root).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <stdarg.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/startup.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/sysctl.h>
+#include <sys/kauth.h>
+#include <kern/thread_call.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include "negroni_mmio.h"
+#include "negroni_smmu_s1.h"
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern uint64_t kvtophys(vm_offset_t va);
+extern vm_map_address_t phystokv(uint64_t pa);
+
+#define APPS_SMMU_PHYS          0x15000000ull
+#define APPS_SMMU_SIZE          0x100000ull     /* live.dts:15352 */
+#define S1_WIMG_IO              0x7u
+#define MAX_CTX                 0x4eu           /* qcom,num-context-banks-override */
+#define MAX_SMR                 0x78u           /* qcom,num-smr-override */
+#define G0_PAGES                8u              /* global pages 0-7: GR0, GR1, ..., IMPL_DEF5 (page 7) */
+#define MAX_TRIES               8u              /* context banks tried per negroni_s1_on */
+
+#define SMMU_SCR0               0x000
+#define SMMU_SCR0_EXIDENABLE    (1u << 3)
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_IDR2               0x028
+#define SMMU_SGFSR              0x048
+#define SMMU_SGFSYNR1           0x054
+#define SMMU_STLBGSTATUS        0x074
+#define SMMU_SMR(n)             (0x800u + 4u * (n))
+#define SMMU_S2CR(n)            (0xc00u + 4u * (n))
+#define SMMU_SMR_VALID          (1u << 31)
+#define SMMU_CBAR(n)            (4u * (n))              /* global page 1 */
+#define SMMU_CBFRSYNRA(n)       (0x400u + 4u * (n))     /* global page 1: the faulting stream ID */
+#define SMMU_CBA2R(n)           (0x800u + 4u * (n))     /* global page 1 */
+#define QSMMU_WAIT_CNTR         0x2670u                 /* GR0: bit 20 TCU sync, bit 16 TCU inv in progress */
+#define QSMMU_TBU_ACK           0x5dcu                  /* IMPL_DEF5 (page 7): SYNC_ACK 31:17, SYNC_REQ 16, INV_ACK 15:1, INV_REQ 0 */
+#define CB_SCTLR                0x00
+#define CB_TCR2                 0x10
+#define CB_TTBR0                0x20
+#define CB_TTBR1                0x28
+#define CB_TCR                  0x30
+#define CB_MAIR0                0x38
+#define CB_MAIR1                0x3c
+#define CB_FSR                  0x58
+#define CB_FAR                  0x60
+#define CB_FSYNR0               0x68
+#define CB_TLBIASID             0x610
+#define CB_TLBSYNC              0x7f0
+#define CB_TLBSTATUS            0x7f4
+#define CBAR_S1                 (1u << 16 | 3u << 8 | 0xfu << 12)       /* 0x1f300, Linux's stage-1 CBAR */
+#define CBAR_KEEP_MASK          0x300ffu                /* TYPE and VMID: what must read back as written */
+#define CBAR_TYPE(v)            (((v) >> 16) & 3u)
+#define SCTLR_ON                (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 12)
+#define TCR_39                  (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define TCR2_36                 (1u | 1u << 4 | 7u << 15)
+/*
+ * Readback rule (0379, the 0325 Wi-Fi sr_put rule): a write must read back in the fields we own; other bits may
+ * differ, the difference is printed and kept. Phone 2026-10-27: every bank (Wi-Fi 6, camera 7, Adreno 13/19) reads
+ * TCR2 0x38071 after 0x38011: bits 5/6 = TBI0/TBI1 (SMMUv2 TCR2 = TCR_EL1[63:32]: PASIZE 2:0, AS 4, TBI0 5, TBI1 6,
+ * SEP 17:15) are set by the SMMU or by Gunyah, not by us; our IOVAs have a zero top byte, so TBI changes nothing.
+ * Wi-Fi bank 6 also reads SCTLR 0x107 after 0x1107 (ASIDPNE not kept). TCR, TTBR0, MAIR0, S2CR, SMR read back exactly.
+ */
+#define TCR2_OWN                (0xfu | 1u << 4 | 7u << 15)     /* PASIZE (+ reserved bit 3), AS, SEP; not TBI0/TBI1 */
+#define TCR_OWN                 (0x3fu | 1u << 7 | 0xffu << 8 | 1u << 22 | 1u << 23)   /* T0SZ EPD0 IRGN0 ORGN0 SH0 TG0 A1 EPD1 */
+#define MAIR0_OWN               0xffu           /* attribute 0: the only index our PTEs use */
+#define SCTLR_OWN               1u              /* M */
+#define S2CR_OWN                0x300ffu        /* TYPE, CBNDX (0325) */
+#define MAIR0                   0xf404ff44u     /* index 0 = Normal non-cacheable; the CPU cleans/invalidates */
+#define FSR_ALL                 0xc00001feu
+#define PTE_VALID               3ull
+#define PTE_ATTR                ((1ull << 10) | (2ull << 8) | (1ull << 6) | (1ull << 11))   /* AF, SH outer, AP unpriv RW, nG */
+#define PTE_ADDR                0x0000fffffffff000ull
+#define S2CR_TYPE(v)            (((v) >> 16) & 3u)
+#define TLB_SYNC_US             500000u         /* Linux TLB_LOOP_TIMEOUT */
+
+/*
+ * The claim lock (exported, negroni_smmu_s1.h): held from the free-entry scan to the last SMR/S2CR/CBAR write in
+ * negroni_s1_on, over the whole teardown and over the probe. Any other apps-SMMU user that claims entries (Wi-Fi
+ * 0325) must take it too; until it does, it is outside this protection (the re-reads remain).
+ */
+static LCK_GRP_DECLARE(negroni_smmu_claim_grp, "negroni_smmu_claim");
+LCK_MTX_DECLARE(negroni_smmu_claim_lock, &negroni_smmu_claim_grp);
+static uint32_t snap_smr[128], snap_s2cr[128];  /* under negroni_smmu_claim_lock */
+int8_t negroni_smmu_cb_verdict[128];            /* NEGRONI_CB_*, filled by the probe and by negroni_s1_on */
+static bool cb_released[128];                   /* ours once, SCTLR 0 now, CBAR left at CBAR_S1: reusable */
+
+#define G0R(s, o)       negroni_mmio_rd32((s)->g0 + (o))
+#define CBR(s, c, o)    negroni_mmio_rd32((s)->cbva + (vm_offset_t)(c) * (s)->page + (o))
+#define CBW(s, c, o, v) negroni_mmio_wr32((s)->cbva + (vm_offset_t)(c) * (s)->page + (o), (v))
+
+static void
+dsb(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* refusable accesses (0297): 0 done, else the access aborted (or cannot be guarded) */
+static int
+grd(struct negroni_s1 *s, uint32_t off, uint32_t *v)
+{
+	return negroni_mmio_try_rd32(s->g0 + off, v) ? EFAULT : 0;
+}
+
+static int
+gwr(struct negroni_s1 *s, uint32_t off, uint32_t v)
+{
+	return negroni_mmio_try_wr32(s->g0 + off, v) ? EFAULT : 0;
+}
+
+static int
+crd(struct negroni_s1 *s, uint32_t c, uint32_t off, uint32_t *v)
+{
+	return negroni_mmio_try_rd32(s->cbva + (vm_offset_t)c * s->page + off, v) ? EFAULT : 0;
+}
+
+static int
+cwr(struct negroni_s1 *s, uint32_t c, uint32_t off, uint32_t v)
+{
+	return negroni_mmio_try_wr32(s->cbva + (vm_offset_t)c * s->page + off, v) ? EFAULT : 0;
+}
+
+/* a page-aligned uncached mapping of [pa, pa + size): map and msize for the unmap, the return value at pa */
+static vm_offset_t
+io_map(uint64_t pa, vm_size_t size, vm_offset_t *map, vm_size_t *msize)
+{
+	uint64_t base = pa & ~(uint64_t)PAGE_MASK;
+	vm_size_t len = round_page(size + (vm_size_t)(pa - base));
+	vm_offset_t va = ml_io_map_unmappable((vm_offset_t)base, len, S1_WIMG_IO);
+
+	*map = va;
+	*msize = len;
+	return va ? va + (vm_offset_t)(pa - base) : 0;
+}
+
+/* a global write, read back; mask: the bits that must read back as written */
+static int
+g_put(struct negroni_s1 *s, const char *what, uint32_t off, uint32_t v, uint32_t mask)
+{
+	uint32_t got = 0;
+
+	if (gwr(s, off, v)) {
+		printf("%s: SMMU %s write %#x REFUSED (synchronous external abort, caught)\n", s->name, what, v);
+		return EPERM;
+	}
+	dsb();
+	if (grd(s, off, &got)) {
+		printf("%s: SMMU %s read-back aborted after writing %#x\n", s->name, what, v);
+		return EPERM;
+	}
+	if ((got & mask) != (v & mask)) {
+		printf("%s: SMMU %s reads %#x after writing %#x (the hypervisor did not keep it)\n", s->name, what, got, v);
+		return EPERM;
+	}
+	if (got != v) {
+		printf("%s: SMMU %s reads %#x after writing %#x: bits %#x differ outside the fields we own %#x; accepted\n",
+		    s->name, what, got, v, got ^ v, mask);
+	}
+	return 0;
+}
+
+static int
+cb_put(struct negroni_s1 *s, const char *what, uint32_t off, uint32_t v, uint32_t own)
+{
+	uint32_t got = 0;
+
+	int bad = cwr(s, s->cb, off, v);
+	dsb();
+	if (bad || crd(s, s->cb, off, &got)) {
+		printf("%s: SMMU context %u %s write %#x aborted (caught)\n", s->name, s->cb, what, v);
+		return EPERM;
+	}
+	if ((got ^ v) & own) {
+		printf("%s: SMMU context %u %s reads %#x after writing %#x (bits %#x of the fields we own %#x not kept)\n",
+		    s->name, s->cb, what, got, v, (got ^ v) & own, own);
+		return EPERM;
+	}
+	if (got != v) {
+		printf("%s: SMMU context %u %s reads %#x after writing %#x: bits %#x differ outside the fields we own %#x; "
+		    "accepted\n", s->name, s->cb, what, got, v, got ^ v, own);
+	}
+	return 0;
+}
+
+/* what the TCU and the TBUs say when a sync does not finish (qsmmuv500_tlb_sync_timeout; reads only) */
+static void
+sync_diag(struct negroni_s1 *s, uint32_t status)
+{
+	uint32_t ack = ~0u, cntr = ~0u, gst = ~0u;
+	int e1 = grd(s, 7u * s->page + QSMMU_TBU_ACK, &ack), e2 = grd(s, QSMMU_WAIT_CNTR, &cntr);
+	int e3 = grd(s, SMMU_STLBGSTATUS, &gst);
+
+	printf("%s: SMMU context %u TLB sync NOT finished after %u ms: TLBSTATUS %#x; TBU ack %#x%s (sync req %u ack %#x, "
+	    "inv req %u ack %#x); TCU %#x%s (sync %s, inv %s); sTLBGSTATUS %#x%s\n", s->name, s->cb, TLB_SYNC_US / 1000, status,
+	    ack, e1 ? " (read aborted)" : "", (ack >> 16) & 1, ack >> 17, ack & 1, (ack >> 1) & 0x7fff, cntr,
+	    e2 ? " (read aborted)" : "", (cntr >> 20) & 1 ? "in progress" : "idle", (cntr >> 16) & 1 ? "in progress" : "idle",
+	    gst, e3 ? " (read aborted)" : "");
+}
+
+/* invalidate the context's TLB (ASID = context index, as TTBR0) and wait (500 ms at most); false on a time-out */
+static bool
+tlb_sync(struct negroni_s1 *s)
+{
+	uint32_t st = 1;
+
+	if (cwr(s, s->cb, CB_TLBIASID, s->cb) || cwr(s, s->cb, CB_TLBSYNC, ~0u)) {      /* Linux writes QCOM_DUMMY_VAL */
+		printf("%s: SMMU context %u TLBIASID/TLBSYNC write aborted (caught)\n", s->name, s->cb);
+		return false;
+	}
+	for (uint32_t waited = 0, d = 1; waited <= TLB_SYNC_US; waited += d, d = MIN(d * 2, 1000u)) {
+		if (crd(s, s->cb, CB_TLBSTATUS, &st)) {
+			printf("%s: SMMU context %u TLBSTATUS read aborted (caught)\n", s->name, s->cb);
+			return false;
+		}
+		if ((st & 1) == 0) {
+			return true;
+		}
+		delay(d);
+	}
+	sync_diag(s, st);
+	return false;
+}
+
+static void
+tbl_flush(const void *p, size_t n)
+{
+	for (vm_offset_t a = (vm_offset_t)p & ~(vm_offset_t)63; a < (vm_offset_t)p + n; a += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (a));
+	}
+	dsb();
+}
+
+static uint64_t *
+tbl_new(struct negroni_s1 *s, uint64_t *pa_out)
+{
+	if (s->tleft == 0) {
+		if (s->tpages == NEGRONI_S1_TABLE_PAGES || kmem_alloc(kernel_map, &s->tpage[s->tpages], PAGE_SIZE,
+		    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		s->tpages++;
+		s->tleft = PAGE_SIZE / 4096;
+	}
+	uint64_t *t = (uint64_t *)(s->tpage[s->tpages - 1] + PAGE_SIZE - 4096 * s->tleft--);
+	tbl_flush(t, 4096);
+	*pa_out = kvtophys((vm_offset_t)t);
+	return t;
+}
+
+static uint64_t *
+tbl_next(struct negroni_s1 *s, uint64_t *entry)
+{
+	uint64_t pa;
+
+	if (*entry & 1) {
+		return (uint64_t *)phystokv(*entry & PTE_ADDR);
+	}
+	uint64_t *t = tbl_new(s, &pa);
+	if (t) {
+		*entry = pa | PTE_VALID;
+		tbl_flush(entry, sizeof(*entry));
+	}
+	return t;
+}
+
+static bool
+map_page(struct negroni_s1 *s, uint64_t iova, uint64_t pa)
+{
+	uint64_t *l2 = tbl_next(s, &s->root[(iova >> 30) & 0x1ff]);
+	uint64_t *l3 = l2 ? tbl_next(s, &l2[(iova >> 21) & 0x1ff]) : NULL;
+
+	if (!l3 || pa == 0) {
+		return false;
+	}
+	uint64_t *e = &l3[(iova >> 12) & 0x1ff];
+	*e = (pa & PTE_ADDR) | PTE_ATTR | PTE_VALID;
+	tbl_flush(e, sizeof(*e));
+	return true;
+}
+
+int
+negroni_s1_map_kva(struct negroni_s1 *s, uint64_t iova, vm_offset_t kva, uint64_t size)
+{
+	if (!s->on || size == 0 || (iova & 0xfff) || (kva & 0xfff) || iova + size > (1ull << 39)) {
+		return EINVAL;
+	}
+	for (uint64_t o = 0; o < size; o += 4096) {
+		if (!map_page(s, iova + o, kvtophys(kva + (vm_offset_t)o))) {
+			printf("%s: SMMU map of IOVA %#llx failed (no table page or no physical page)\n", s->name, iova + o);
+			return ENOMEM;
+		}
+	}
+	s->mapped_pages += (uint32_t)((size + 4095) / 4096);
+	if (!tlb_sync(s)) {
+		printf("%s: SMMU context %u TLB sync does not finish after the map of IOVA %#llx\n", s->name, s->cb, iova);
+		return ETIMEDOUT;
+	}
+	printf("%s: SMMU context %u: IOVA %#llx-%#llx -> phys %#llx.. (%llu KiB)\n", s->name, s->cb, iova, iova + size - 1,
+	    kvtophys(kva), size >> 10);
+	return 0;
+}
+
+void
+negroni_s1_report(struct negroni_s1 *s, const char *when)
+{
+	if (!s->on) {
+		return;
+	}
+	uint32_t fsr = ~0u, gfsr = ~0u, sid = ~0u, farh = ~0u, farl = ~0u, fsynr0 = ~0u, gsyn = ~0u;
+	int e = crd(s, s->cb, CB_FSR, &fsr);    /* every read refusable (0297): ~0 and "aborted" when refused */
+	e |= grd(s, SMMU_SGFSR, &gfsr) | grd(s, s->page + SMMU_CBFRSYNRA(s->cb), &sid) | crd(s, s->cb, CB_FAR + 4, &farh) |
+	    crd(s, s->cb, CB_FAR, &farl) | crd(s, s->cb, CB_FSYNR0, &fsynr0) | grd(s, SMMU_SGFSYNR1, &gsyn);
+	printf("%s: SMMU context %u %s: FSR %#x%s FAR %#x:%#x FSYNR0 %#x stream %#x; sGFSR %#x sGFSYNR1 %#x; %u pages mapped%s\n",
+	    s->name, s->cb, when, fsr, fsr == ~0u ? "" : (fsr & FSR_ALL) ? " (CONTEXT FAULT)" : " (no fault)", farh, farl, fsynr0,
+	    sid & 0xffffu, gfsr, gsyn, s->mapped_pages, e ? " (a read ABORTED, caught)" : "");
+	if (fsr != ~0u && (fsr & FSR_ALL)) {
+		(void)cwr(s, s->cb, CB_FSR, fsr);       /* write one to clear */
+	}
+}
+
+uint32_t
+negroni_s1_fsr(struct negroni_s1 *s)
+{
+	uint32_t fsr = 0;
+	if (!s->on) {
+		return 0;
+	}
+	return crd(s, s->cb, CB_FSR, &fsr) ? FSR_ALL : fsr & FSR_ALL;        /* a refused read counts as a fault */
+}
+
+static void
+unmap_all(struct negroni_s1 *s)
+{
+	for (uint32_t i = 0; i < s->tpages; i++) {
+		kmem_free(kernel_map, s->tpage[i], PAGE_SIZE);
+	}
+	s->tpages = s->tleft = 0;
+	s->root = NULL;
+	s->mapped_pages = 0;
+	if (s->cb_map) {
+		ml_io_unmap(s->cb_map, s->cb_size);
+		s->cb_map = s->cbva = 0;
+	}
+	if (s->g0_map) {
+		ml_io_unmap(s->g0_map, s->g0_size);
+		s->g0_map = s->g0 = 0;
+	}
+}
+
+/*
+ * The S2CRs and SMRs back as found, then the context off the way Linux frees a domain: SCTLR = 0 and a TLB
+ * invalidate, nothing else. CBAR/CBA2R stay as we wrote them (0x1f300 / 1): writing the old CBAR back (type
+ * S2_TRANS) is what Gunyah refused on 2026-10-27. Every write is refusable (0297); a refusal is logged. (lock held)
+ */
+static void
+undo(struct negroni_s1 *s)
+{
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		if (!s->written[k]) {
+			continue;
+		}
+		uint32_t n = s->smr[k], now = ~0u;
+		int e = 0;
+		if (s->reused[k]) {
+			e |= gwr(s, SMMU_S2CR(n), s->old_s2cr[k]);      /* the SMR stays as it was */
+		} else {
+			e |= gwr(s, SMMU_SMR(n), s->old_smr[k]);        /* invalid first, then the S2CR */
+			dsb();
+			e |= gwr(s, SMMU_S2CR(n), s->old_s2cr[k]);
+		}
+		dsb();
+		(void)grd(s, SMMU_S2CR(n), &now);
+		printf("%s: SMMU SMR%u %s, S2CR%u = %#x%s\n", s->name, n, s->reused[k] ? "kept" : "cleared", n, now,
+		    e ? " (a write was REFUSED: SEA caught)" : "");
+		s->written[k] = false;
+	}
+	if (s->cb != ~0u && s->cbva && s->cb_written) {
+		uint32_t cbar = ~0u;
+		int e = cwr(s, s->cb, CB_SCTLR, 0);
+		dsb();
+		bool synced = e == 0 && tlb_sync(s);
+		e |= grd(s, s->page + SMMU_CBAR(s->cb), &cbar);
+		if (e == 0 && (cbar & CBAR_KEEP_MASK) == (CBAR_S1 & CBAR_KEEP_MASK)) {
+			cb_released[s->cb] = true;
+		}
+		printf("%s: SMMU context %u released: SCTLR 0%s, TLB %s; CBAR left at %#x (as Linux: no CBAR write on free)%s\n",
+		    s->name, s->cb, e ? " (an access ABORTED, caught)" : "", synced ? "synced" : "NOT synced", cbar,
+		    cb_released[s->cb] ? ", reusable" : "");
+		s->cb_written = false;
+	}
+}
+
+void
+negroni_s1_off(struct negroni_s1 *s)
+{
+	lck_mtx_lock(&negroni_smmu_claim_lock);
+	if (s->on) {
+		negroni_s1_report(s, "at teardown");
+	}
+	if (s->g0 && s->cbva) {
+		undo(s);
+	}
+	if (s->on) {
+		printf("%s: SMMU context %u off\n", s->name, s->cb);
+	}
+	s->on = false;
+	unmap_all(s);
+	s->cb = ~0u;
+	lck_mtx_unlock(&negroni_smmu_claim_lock);
+}
+
+/* does SMR value v (valid) match any stream of the (id, mask) set? */
+static bool
+smr_overlaps(uint32_t v, uint32_t id, uint32_t mask)
+{
+	uint32_t vid = v & 0x7fffu, vmask = (v >> 16) & 0x7fffu;
+	return ((vid ^ id) & ~(vmask | mask) & 0x7fffu) == 0;
+}
+
+/* map global pages 0-7 and the context banks; read the layout (lock held). 0 or an errno, the reason printed */
+static int
+map_layout(struct negroni_s1 *s)
+{
+	uint32_t scr0 = 0, idr0, idr1;
+
+	s->g0 = io_map(APPS_SMMU_PHYS, 0x2000, &s->g0_map, &s->g0_size);
+	if (!s->g0) {
+		printf("%s: SMMU map failed\n", s->name);
+		return ENOMEM;
+	}
+	int r = negroni_mmio_try_rd32(s->g0 + SMMU_SCR0, &scr0);
+	if (r == -2) {
+		printf("%s: this kernel cannot catch a refused SMMU access (no CONFIG_XNUPOST): no SMMU writes\n", s->name);
+		return ENOTSUP;
+	}
+	if (r || grd(s, SMMU_IDR0, &idr0) || grd(s, SMMU_IDR1, &idr1)) {
+		printf("%s: SMMU sCR0/IDR0/IDR1 read aborted (caught)\n", s->name);
+		return EFAULT;
+	}
+	s->page = (idr1 >> 31) ? 0x10000u : 0x1000u;
+	s->pages = 2u << ((idr1 >> 28) & 7);
+	s->nctx = MIN(idr1 & 0xffu, MAX_CTX);
+	s->nums2cb = (idr1 >> 16) & 0xffu;
+	s->nsmr = MIN(MIN(idr0 & 0xffu, MAX_SMR), 128u);
+	printf("%s: SMMU S1 setup: sCR0 %#x IDR0 %#x IDR1 %#x: %u SMRs, %u contexts (NUMS2CB %u), %u pages of %#x\n", s->name,
+	    scr0, idr0, idr1, s->nsmr, s->nctx, s->nums2cb, s->pages, s->page);
+	if (scr0 == ~0u || s->nsmr == 0 || s->nctx < 2 || s->pages < G0_PAGES || 2ull * s->pages * s->page > APPS_SMMU_SIZE) {
+		printf("%s: SMMU layout does not fit\n", s->name);
+		return ENXIO;
+	}
+	if (scr0 & SMMU_SCR0_EXIDENABLE) {
+		printf("%s: SMMU uses extended stream IDs; SMR format not handled\n", s->name);
+		return ENOTSUP;
+	}
+	ml_io_unmap(s->g0_map, s->g0_size);     /* again with pages 0-7 (page 1 = CBAR, page 7 = IMPL_DEF5) */
+	s->g0 = io_map(APPS_SMMU_PHYS, (vm_size_t)G0_PAGES * s->page, &s->g0_map, &s->g0_size);
+	if (!s->g0) {
+		return ENOMEM;
+	}
+	s->cbva = io_map(APPS_SMMU_PHYS + (uint64_t)s->pages * s->page, (vm_size_t)s->nctx * s->page, &s->cb_map, &s->cb_size);
+	if (!s->cbva) {
+		return ENOMEM;
+	}
+	/* one snapshot of the stream-match table (each read is a hypervisor trap); re-read before each write */
+	for (uint32_t i = 0; i < s->nsmr; i++) {
+		if (grd(s, SMMU_SMR(i), &snap_smr[i]) || grd(s, SMMU_S2CR(i), &snap_s2cr[i])) {
+			printf("%s: SMMU SMR%u/S2CR%u read aborted (caught)\n", s->name, i, i);
+			return EFAULT;
+		}
+	}
+	return 0;
+}
+
+/* how many valid SMRs translate into context c (snapshot), and the first such SMR value */
+static uint32_t
+cb_refs(struct negroni_s1 *s, uint32_t c, uint32_t *first_smr)
+{
+	uint32_t n = 0;
+	for (uint32_t m = 0; m < s->nsmr; m++) {
+		if ((snap_smr[m] & SMMU_SMR_VALID) && S2CR_TYPE(snap_s2cr[m]) == 0 && (snap_s2cr[m] & 0xffu) == c) {
+			if (n++ == 0 && first_smr) {
+				*first_smr = snap_smr[m];
+			}
+		}
+	}
+	return n;
+}
+
+/*
+ * Is context c free for us? The U-Boot qcom-hyp-smmu.c CBAR rule (S2_TRANS, or S1_TRANS_S2_BYPASS with VMID 0xff),
+ * or a bank we released earlier (CBAR still 0x1f300); SCTLR.M = 0; no valid SMR translates into it; TLBSTATUS idle;
+ * not marked READ_ABORT/CLAIM_REFUSED, nor REWRITE_REFUSED/CHANGED by the probe. Reads only. (lock held)
+ */
+static bool
+cb_free(struct negroni_s1 *s, uint32_t c, uint32_t *cbar_out, uint32_t *cba2r_out, uint32_t *sctlr_out)
+{
+	uint32_t cbar, cba2r, sctlr, st;
+	int8_t v = negroni_smmu_cb_verdict[c];
+
+	/* the probe's REFUSED/CHANGED banks too: a bank whose own CBAR value is not taken back is not ours [I] */
+	if (v == NEGRONI_CB_READ_ABORT || v == NEGRONI_CB_CLAIM_REFUSED || v == NEGRONI_CB_REWRITE_REFUSED ||
+	    v == NEGRONI_CB_REWRITE_CHANGED) {
+		return false;
+	}
+	if (grd(s, s->page + SMMU_CBAR(c), &cbar) || grd(s, s->page + SMMU_CBA2R(c), &cba2r) ||
+	    crd(s, c, CB_SCTLR, &sctlr) || crd(s, c, CB_TLBSTATUS, &st)) {
+		negroni_smmu_cb_verdict[c] = NEGRONI_CB_READ_ABORT;
+		printf("%s: SMMU context %u: a read ABORTED (caught): not ours\n", s->name, c);
+		return false;
+	}
+	uint32_t type = CBAR_TYPE(cbar);
+	bool rule = type == 0 || (type == 1 && (cbar & 0xffu) == 0xffu) ||
+	    (cb_released[c] && (cbar & CBAR_KEEP_MASK) == (CBAR_S1 & CBAR_KEEP_MASK));
+	if (!rule || (sctlr & 1) || (st & 1) || cb_refs(s, c, NULL)) {
+		return false;
+	}
+	*cbar_out = cbar;
+	*cba2r_out = cba2r;
+	*sctlr_out = sctlr;
+	return true;
+}
+
+static int
+s1_on_locked(struct negroni_s1 *s)
+{
+	int error;
+
+	if (s->nstreams == 0 || s->nstreams > NEGRONI_S1_MAX_STREAMS) {
+		return EINVAL;
+	}
+	s->cb = ~0u;
+	if ((error = map_layout(s))) {
+		return error;
+	}
+
+	/* stream-match entries: an SMR equal to ours whose S2CR does not translate is reused; any other valid
+	 * SMR that matches one of our IDs belongs to someone (a double match is a conflict fault): stop */
+	uint32_t taken = 0;     /* bit per stream k: it has an entry */
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		uint32_t id = s->streams[k].id, mask = s->streams[k].mask, want = SMMU_SMR_VALID | mask << 16 | id;
+		for (uint32_t i = 0; i < s->nsmr; i++) {
+			uint32_t v = snap_smr[i];
+			if (!(v & SMMU_SMR_VALID) || !smr_overlaps(v, id, mask)) {
+				continue;
+			}
+			uint32_t s2 = snap_s2cr[i];
+			if (v == want && S2CR_TYPE(s2) != 0) {
+				s->smr[k] = i;
+				s->reused[k] = true;
+				s->old_smr[k] = v;
+				s->old_s2cr[k] = s2;
+				taken |= 1u << k;
+				printf("%s: SMMU stream %#x/%#x: SMR%u already there (S2CR %#x, %s): reused\n", s->name, id, mask, i, s2,
+				    S2CR_TYPE(s2) == 1 ? "bypass" : "fault");
+				break;
+			}
+			printf("%s: SMMU stream %#x/%#x: SMR%u %#x (S2CR %#x) already matches it: somebody's entry, left alone\n",
+			    s->name, id, mask, i, v, s2);
+			return EBUSY;
+		}
+	}
+	/* free SMRs from the top down (0324 takes them from the bottom up) */
+	uint32_t next = s->nsmr;
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		if (taken & (1u << k)) {
+			continue;
+		}
+		while (next > 0 && (snap_smr[next - 1] & SMMU_SMR_VALID)) {
+			next--;
+		}
+		if (next == 0) {
+			printf("%s: SMMU has no free stream-match register\n", s->name);
+			return EBUSY;
+		}
+		next--;
+		s->smr[k] = next;
+		s->reused[k] = false;
+		s->old_smr[k] = snap_smr[next];
+		s->old_s2cr[k] = snap_s2cr[next];
+	}
+
+	/*
+	 * A context bank from the bottom up, from NUMS2CB (Linux: stage-1 banks start at num_s2_context_banks). The
+	 * claim (SCTLR 0, CBA2R 1, CBAR 0x1f300, each read back) is the test: a refused or not-kept write skips the
+	 * bank (no restore write: it may be refused too), at most MAX_TRIES banks.
+	 */
+	uint32_t tries = 0, cbar = 0, cba2r = 0, sctlr = 0;
+	for (uint32_t c = MAX(s->nums2cb, 1u); c < s->nctx && s->cb == ~0u && tries < MAX_TRIES; c++) {
+		if (!cb_free(s, c, &cbar, &cba2r, &sctlr)) {
+			continue;
+		}
+		tries++;
+		s->cb = c;
+		s->old_cbar = cbar;
+		s->old_cba2r = cba2r;
+		printf("%s: SMMU context %u free: CBAR %#x CBA2R %#x; claiming it\n", s->name, c, cbar, cba2r);
+		/* SCTLR (M is 0 already) is written only after the claim and only when not 0: a refused claim leaves
+		 * the bank's own registers untouched (Linux writes the CB registers after CBAR too) */
+		if (g_put(s, "CBA2R", s->page + SMMU_CBA2R(c), 1, 1u) ||                        /* VA64 */
+		    g_put(s, "CBAR", s->page + SMMU_CBAR(c), CBAR_S1, CBAR_KEEP_MASK)) {
+			negroni_smmu_cb_verdict[c] = NEGRONI_CB_CLAIM_REFUSED;
+			printf("%s: SMMU context %u: claim refused or not kept; left as it is now, next bank\n", s->name, c);
+			s->cb = ~0u;
+			continue;
+		}
+		negroni_smmu_cb_verdict[c] = NEGRONI_CB_OURS;
+		cb_released[c] = false;
+		s->cb_written = true;
+		if (sctlr != 0) {
+			int bad = cwr(s, c, CB_SCTLR, 0);
+			dsb();
+			if (bad) {
+				printf("%s: SMMU context %u SCTLR 0 write aborted (caught)\n", s->name, c);
+				return EPERM;
+			}
+		}
+	}
+	if (s->cb == ~0u) {
+		printf("%s: SMMU has no usable context bank (%u tried; U-Boot CBAR rule, SCTLR.M, S2CR targets, claim)\n",
+		    s->name, tries);
+		return EBUSY;
+	}
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		printf("%s: SMMU stream %#x mask %#x: SMR%u (%s, was %#x / S2CR %#x) -> context %u\n", s->name, s->streams[k].id,
+		    s->streams[k].mask, s->smr[k], s->reused[k] ? "reused" : "free", s->old_smr[k], s->old_s2cr[k], s->cb);
+	}
+
+	s->root = tbl_new(s, &s->root_pa);
+	if (!s->root) {
+		return ENOMEM;
+	}
+	uint64_t ttbr = s->root_pa | ((uint64_t)s->cb << 48);
+	if ((error = cb_put(s, "TCR2", CB_TCR2, TCR2_36, TCR2_OWN)) ||
+	    (error = cb_put(s, "TCR", CB_TCR, TCR_39, TCR_OWN)) ||
+	    (error = cb_put(s, "TTBR0 lo", CB_TTBR0, (uint32_t)ttbr, ~0u)) ||
+	    (error = cb_put(s, "TTBR0 hi", CB_TTBR0 + 4, (uint32_t)(ttbr >> 32), ~0u)) ||    /* ASID = bank */
+	    (error = cb_put(s, "MAIR0", CB_MAIR0, MAIR0, MAIR0_OWN))) {
+		return error;
+	}
+	if (cwr(s, s->cb, CB_TTBR1, 0) || cwr(s, s->cb, CB_TTBR1 + 4, 0) || cwr(s, s->cb, CB_MAIR1, 0) ||
+	    cwr(s, s->cb, CB_FSR, FSR_ALL)) {
+		printf("%s: SMMU context %u TTBR1/MAIR1/FSR write aborted (caught)\n", s->name, s->cb);
+		return EPERM;
+	}
+	if (!tlb_sync(s)) {
+		return ETIMEDOUT;
+	}
+	sctlr = 0;
+	int bad = cwr(s, s->cb, CB_SCTLR, SCTLR_ON);
+	dsb();
+	if (bad || crd(s, s->cb, CB_SCTLR, &sctlr) || !(sctlr & SCTLR_OWN)) {
+		printf("%s: SMMU context %u SCTLR does not take M (%#x)\n", s->name, s->cb, sctlr);
+		return EPERM;
+	}
+	if (sctlr != SCTLR_ON) {
+		printf("%s: SMMU context %u SCTLR reads %#x after writing %#x: bits %#x differ outside the fields we own %#x; "
+		    "accepted\n", s->name, s->cb, sctlr, SCTLR_ON, sctlr ^ SCTLR_ON, SCTLR_OWN);
+	}
+	/* the streams: S2CR (translate, context) first, then the SMR; each SMR read again right before */
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		uint32_t n = s->smr[k], want = SMMU_SMR_VALID | (uint32_t)s->streams[k].mask << 16 | s->streams[k].id, now = ~0u;
+		if (grd(s, SMMU_SMR(n), &now) || (s->reused[k] ? now != s->old_smr[k] : (now & SMMU_SMR_VALID) != 0)) {
+			printf("%s: SMMU SMR%u changed under us (%#x): another driver took it\n", s->name, n, now);
+			return EBUSY;
+		}
+		s->written[k] = true;
+		if ((error = g_put(s, "S2CR", SMMU_S2CR(n), s->cb, S2CR_OWN))) {        /* type 0 = translate */
+			return error;
+		}
+		if (!s->reused[k] && (error = g_put(s, "SMR", SMMU_SMR(n), want, ~0u))) {
+			return error;
+		}
+	}
+	s->on = true;
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		uint32_t smr = ~0u, s2cr = ~0u;
+		(void)grd(s, SMMU_SMR(s->smr[k]), &smr);
+		(void)grd(s, SMMU_S2CR(s->smr[k]), &s2cr);
+		printf("%s: SMMU SMR%u = %#x, S2CR%u = %#x\n", s->name, s->smr[k], smr, s->smr[k], s2cr);
+	}
+	uint32_t ttbh = ~0u, ttbl = ~0u;
+	sctlr = ~0u;
+	(void)crd(s, s->cb, CB_SCTLR, &sctlr);
+	(void)crd(s, s->cb, CB_TTBR0 + 4, &ttbh);
+	(void)crd(s, s->cb, CB_TTBR0, &ttbl);
+	printf("%s: SMMU context %u ON: SCTLR %#x TTBR0 %#x:%#x (root %#llx), %u stream entr%s translate through it\n", s->name,
+	    s->cb, sctlr, ttbh, ttbl, s->root_pa, s->nstreams, s->nstreams == 1 ? "y" : "ies");
+	return 0;
+}
+
+int
+negroni_s1_on(struct negroni_s1 *s)
+{
+	lck_mtx_lock(&negroni_smmu_claim_lock);
+	if (s->on) {
+		lck_mtx_unlock(&negroni_smmu_claim_lock);
+		return 0;
+	}
+	bzero(s->written, sizeof(s->written));
+	s->cb_written = false;
+	int error = s1_on_locked(s);
+	if (error) {
+		printf("%s: SMMU S1 context not set up (errno %d); stream entries put back, context released\n", s->name, error);
+		if (s->g0 && s->cbva) {
+			undo(s);
+		}
+		s->on = false;
+		unmap_all(s);
+		s->cb = ~0u;
+	}
+	lck_mtx_unlock(&negroni_smmu_claim_lock);
+	return error;
+}
+
+/*
+ * negronismmu_probe=1|2 (default 0): which apps-SMMU context banks does the hypervisor let us touch? At boot
+ * (STARTUP EARLY_BOOT), under the claim lock, every access refusable (0297). Per bank: CBAR, CBA2R, SCTLR,
+ * TLBSTATUS read; then CBAR written back with the value just read (no value changes) and read again:
+ *   =1 the write only on dormant banks (SCTLR.M 0, no valid SMR translating into it), =2 on every bank.
+ * One line per bank and a summary; the verdicts go to negroni_smmu_cb_verdict[] (negroni_s1_on skips a bank whose
+ * reads abort). Nothing else is written: no SMR, S2CR, SCTLR, TLB operation.
+ */
+static const char *
+verdict_name(int8_t v)
+{
+	switch (v) {
+	case NEGRONI_CB_REWRITE_OK: return "same-value CBAR write OK";
+	case NEGRONI_CB_REWRITE_REFUSED: return "same-value CBAR write REFUSED (SEA caught)";
+	case NEGRONI_CB_REWRITE_CHANGED: return "same-value CBAR write accepted but reads back DIFFERENT";
+	case NEGRONI_CB_READ_ABORT: return "a READ ABORTED (SEA caught): not visible to us";
+	case NEGRONI_CB_NOT_TRIED: return "in use: write not tried (probe=2 tries)";
+	case NEGRONI_CB_CLAIM_REFUSED: return "stage-1 claim refused";
+	case NEGRONI_CB_OURS: return "ours";
+	default: return "?";
+	}
+}
+
+/* the probe's lines: printed now, and kept for kern.negroni_smmu_probe and the later re-print (the EARLY_BOOT
+ * lines come before the USB console and fall out of `op10tool ctl log`) */
+static char probe_txt[16384];
+static size_t probe_len;
+static uint32_t probe_level;
+
+static void ptxt(const char *fmt, ...) __printflike(1, 2);
+static void
+ptxt(const char *fmt, ...)
+{
+	char line[640];
+	va_list ap;
+
+	va_start(ap, fmt);
+	(void)vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	printf("NEGRONI SMMU PROBE: %s", line);
+	if (probe_len + strlen(line) + 1 < sizeof(probe_txt)) {
+		probe_len += strlcpy(probe_txt + probe_len, line, sizeof(probe_txt) - probe_len);
+	}
+}
+
+void
+negroni_smmu_probe(uint32_t level)
+{
+	static struct negroni_s1 p = { .name = "NEGRONI SMMU PROBE" };
+	uint32_t n_ok = 0, n_ref = 0, n_chg = 0, n_rab = 0, n_nt = 0, nvalid = 0;
+	uint32_t f0 = negroni_mmio_try_faults;
+
+	lck_mtx_lock(&negroni_smmu_claim_lock);
+	p.cb = ~0u;
+	probe_len = 0;
+	probe_txt[0] = 0;
+	probe_level = level;
+	if (map_layout(&p) != 0) {
+		ptxt("stopped (see the line above)\n");
+		goto out;
+	}
+	uint32_t idr2 = ~0u, gfsr = ~0u, gst = ~0u, cntr = ~0u, ack = ~0u;
+	(void)grd(&p, SMMU_IDR2, &idr2);
+	(void)grd(&p, SMMU_SGFSR, &gfsr);
+	(void)grd(&p, SMMU_STLBGSTATUS, &gst);
+	(void)grd(&p, QSMMU_WAIT_CNTR, &cntr);
+	(void)grd(&p, 7u * p.page + QSMMU_TBU_ACK, &ack);
+	for (uint32_t i = 0; i < p.nsmr; i++) {
+		nvalid += (snap_smr[i] & SMMU_SMR_VALID) != 0;
+	}
+	ptxt("level %u: %u SMRs, %u contexts, NUMS2CB %u, page %#x; IDR2 %#x sGFSR %#x sTLBGSTATUS %#x TCU %#x TBU-ack %#x; "
+	    "%u of %u SMRs valid\n", level, p.nsmr, p.nctx, p.nums2cb, p.page, idr2, gfsr, gst, cntr, ack, nvalid, p.nsmr);
+	for (uint32_t c = 0; c < p.nctx; c++) {
+		uint32_t cbar = ~0u, cba2r = ~0u, sctlr = ~0u, st = ~0u, first = 0;
+		uint32_t refs = cb_refs(&p, c, &first);
+		int8_t v;
+		if (grd(&p, p.page + SMMU_CBAR(c), &cbar) | grd(&p, p.page + SMMU_CBA2R(c), &cba2r) |
+		    crd(&p, c, CB_SCTLR, &sctlr) | crd(&p, c, CB_TLBSTATUS, &st)) {
+			v = NEGRONI_CB_READ_ABORT;
+		} else if (level < 2 && ((sctlr & 1) || refs)) {
+			v = NEGRONI_CB_NOT_TRIED;
+		} else {
+			uint32_t again = ~0u;
+			int bad = gwr(&p, p.page + SMMU_CBAR(c), cbar);
+			dsb();
+			if (bad) {
+				v = NEGRONI_CB_REWRITE_REFUSED;
+			} else if (grd(&p, p.page + SMMU_CBAR(c), &again) || again != cbar) {
+				v = NEGRONI_CB_REWRITE_CHANGED;
+				ptxt("cb %u CBAR %#x after writing %#x\n", c, again, cbar);
+			} else {
+				v = NEGRONI_CB_REWRITE_OK;
+			}
+		}
+		negroni_smmu_cb_verdict[c] = v;
+		n_ok += v == NEGRONI_CB_REWRITE_OK;
+		n_ref += v == NEGRONI_CB_REWRITE_REFUSED;
+		n_chg += v == NEGRONI_CB_REWRITE_CHANGED;
+		n_rab += v == NEGRONI_CB_READ_ABORT;
+		n_nt += v == NEGRONI_CB_NOT_TRIED;
+		ptxt("cb %2u CBAR %#07x (type %u vmid %#x) CBA2R %#x SCTLR %#x TLBSTATUS %#x refs %u%s%#x%s: %s\n",
+		    c, cbar, CBAR_TYPE(cbar), cbar & 0xffu, cba2r, sctlr, st, refs, refs ? " (SMR " : "", refs ? first : 0u,
+		    refs ? ")" : "", verdict_name(v));
+	}
+	ptxt("summary: %u banks (stage-1 from %u): rewrite OK %u, REFUSED %u, changed %u, read-abort %u, "
+	    "not tried %u; %u aborts caught\n", p.nctx, p.nums2cb, n_ok, n_ref, n_chg, n_rab, n_nt, negroni_mmio_try_faults - f0);
+	for (int8_t want = NEGRONI_CB_REWRITE_REFUSED; want <= NEGRONI_CB_REWRITE_OK; want++) {
+		char line[512];
+		size_t used = 0;
+		line[0] = 0;
+		for (uint32_t c = 0; c < p.nctx && used + 8 < sizeof(line); c++) {
+			if (negroni_smmu_cb_verdict[c] == want) {
+				used += (size_t)snprintf(line + used, sizeof(line) - used, " %u", c);
+			}
+		}
+		if (used) {
+			ptxt("%s:%s\n", verdict_name(want), line);
+		}
+	}
+out:
+	unmap_all(&p);
+	lck_mtx_unlock(&negroni_smmu_claim_lock);
+}
+
+/* the survey again, line by line, once the USB console is up (negronismmu_probe_again seconds, default 60, 0 = off) */
+static void
+negroni_smmu_probe_again(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
+{
+	const char *t = probe_txt;
+
+	printf("NEGRONI SMMU PROBE: again (level %u, from boot):\n", probe_level);
+	while (*t) {
+		const char *nl = strchr(t, '\n');
+		int n = nl ? (int)(nl - t) : (int)strlen(t);
+		printf("NEGRONI SMMU PROBE: %.*s\n", n, t);
+		t += n + (nl != NULL);
+	}
+}
+
+/* sysctl kern.negroni_smmu_probe (root only): the survey text, or why there is none */
+static int
+sysctl_negroni_smmu_probe SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	if (probe_len == 0) {
+		static const char none[] = "no probe this boot (boot-arg negronismmu_probe=1|2)\n";
+		return SYSCTL_OUT(req, none, sizeof(none));
+	}
+	return SYSCTL_OUT(req, probe_txt, probe_len + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, negroni_smmu_probe, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sysctl_negroni_smmu_probe, "A", "NEGRONI apps-SMMU bank probe (negronismmu_probe)");
+
+static void
+negroni_smmu_probe_boot(void)
+{
+	uint32_t level = 0, again = 60;
+
+	if (PE_parse_boot_argn("negronismmu_probe", &level, sizeof(level)) && level != 0) {
+		negroni_smmu_probe(level);
+		(void)PE_parse_boot_argn("negronismmu_probe_again", &again, sizeof(again));
+		if (again != 0) {
+			uint64_t when;
+			thread_call_t tc = thread_call_allocate_with_options(negroni_smmu_probe_again, NULL,
+			    THREAD_CALL_PRIORITY_LOW, THREAD_CALL_OPTIONS_ONCE);
+			clock_interval_to_deadline(again, NSEC_PER_SEC, &when);
+			if (tc) {
+				(void)thread_call_enter_delayed(tc, when);
+			}
+		}
+	}
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, negroni_smmu_probe_boot);
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_smmu_s1.h b/bsd/dev/negroni_smmu_s1.h
new file mode 100644
index 0000000..2612782
--- /dev/null
+++ b/bsd/dev/negroni_smmu_s1.h
@@ -0,0 +1,102 @@
+/*
+ * NEGRONI (SM8450): an apps-SMMU stage-1 translation context of our own for a set of stream IDs
+ * (patch 0249; used by negroni_audio.c for the ADSP stream 0x1801 and by negroni_cam.c (0317) for the
+ * camera IFE and ICP streams).
+ *
+ * Why: XNU's RAM on this port starts at 0x840000000 (ADT --dram 840000000:C0000000), so no buffer of
+ * ours has a 32-bit physical address, and the Gunyah hypervisor turns an S2CR BYPASS entry into FAULT
+ * (README-wifi.md "2026-10-26 panic fix", arm-smmu-qcom.c bypass quirk). A context bank of our own, with
+ * our page tables, is the only DMA path for a 32-bit master: Android does the same (iommu-dma IOVAs from
+ * the DT qcom,iommu-dma-addr-pool / iova-mem-region-* windows).
+ *
+ * The register sequence of patch 0324 (negroni_wlan_smmu.c, the Wi-Fi stream 0x1c01), made generic: one
+ * struct negroni_s1 per user. SCTLR is 0324's (M, TRE, AFE, CFRE, ASIDPNE); the Wi-Fi 0325 rewrite differs there
+ * (HUPCF on, CFRE off, from the DT wlan fault flags): here a context fault aborts the access [I: fine for the
+ * camera and the ADSP, both log and stop on a fault]. TODO: one shared negroni_smmu.c should replace this file and
+ * negroni_wlan_smmu.c (0324) later; until then the two never take the same entries:
+ *   - this file takes free stream-match registers from the TOP index down (0324 from the bottom up); context
+ *     banks from the bottom up from IDR1.NUMS2CB as Linux (since 2026-10-27; 0325 also from the bottom), so the
+ *     CBAR marker below, the re-read and the claim lock keep the two apart;
+ *   - a context bank is free only by the U-Boot qcom-hyp-smmu.c rule (CBAR type S2_TRANS, or S1_TRANS_S2_BYPASS
+ *     with VMID 0xff; the rule 0325 uses too) and with SCTLR.M = 0 and no valid SMR whose S2CR translates into it;
+ *     a taken bank gets CBAR S1_TRANS_S2_BYPASS VMID 0 (0x1f300), so the other user's rule sees it as used;
+ *     teardown writes SCTLR 0 only (Linux) and never a CBAR: a released bank keeps 0x1f300 and only this file
+ *     reuses it (cb_released); every setup/teardown access is refusable (0297 negroni_mmio_try_*);
+ *   - each SMR is read again right before it is written (still invalid, or still the value we reuse);
+ *   - the claim lock negroni_smmu_claim_lock (exported below) is held from the free-entry scan to the last
+ *     SMR/S2CR/CBAR write and over the teardown; the CBAR is read again right before it is written. Wi-Fi
+ *     (0324/0325) is outside the lock until it takes it too.
+ * Every apps-SMMU access is one plain 32-bit ldr/str through negroni_mmio.h (Gunyah traps the global
+ * space and injects an SEA for any other access form).
+ */
+#ifndef _NEGRONI_SMMU_S1_H_
+#define _NEGRONI_SMMU_S1_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+#include <kern/locks.h>
+
+/* 0249: the apps-SMMU claim lock; every driver that claims SMRs/context banks takes it */
+extern lck_mtx_t negroni_smmu_claim_lock;
+
+/*
+ * Per context bank, what this boot learned (negronismmu_probe, negroni_s1_on). Another SMMU user (Wi-Fi 0325)
+ * should skip a bank with READ_ABORT, CLAIM_REFUSED or OURS, and must never write a CBAR back on teardown.
+ */
+enum {
+	NEGRONI_CB_UNKNOWN = 0,
+	NEGRONI_CB_REWRITE_REFUSED = 1,         /* probe: the same CBAR value written back: SEA */
+	NEGRONI_CB_REWRITE_CHANGED = 2,         /* probe: accepted, but CBAR reads back another value */
+	NEGRONI_CB_READ_ABORT = 3,              /* a read of the bank's CBAR/CBA2R/SCTLR/TLBSTATUS aborted */
+	NEGRONI_CB_NOT_TRIED = 4,               /* probe=1: in use (SCTLR.M 1 or an SMR translates into it) */
+	NEGRONI_CB_REWRITE_OK = 5,              /* probe: the same CBAR value written back and kept */
+	NEGRONI_CB_CLAIM_REFUSED = 6,           /* negroni_s1_on: CBA2R/CBAR 0x1f300 refused or not kept */
+	NEGRONI_CB_OURS = 7,                    /* negroni_s1_on: claimed */
+};
+extern int8_t negroni_smmu_cb_verdict[128];
+/* the probe (negronismmu_probe=1|2 at boot): one line per bank; reads, and same-value CBAR writes only */
+void negroni_smmu_probe(uint32_t level);
+
+#define NEGRONI_S1_MAX_STREAMS  6
+#define NEGRONI_S1_TABLE_PAGES  32      /* 16 KiB kernel pages, 4 tables of 4 KiB each: 128 tables */
+
+struct negroni_s1_stream {
+	uint16_t id, mask;              /* one SMR: ID 14:0, MASK 30:16 (live DT iommus = <&apps_smmu id mask>) */
+};
+
+struct negroni_s1 {
+	/* set by the user */
+	const char *name;                       /* log prefix, e.g. "NEGRONI CAM" */
+	const struct negroni_s1_stream *streams;
+	uint32_t nstreams;
+	/* state (zero at start) */
+	bool on;
+	uint32_t cb;                            /* context bank index */
+	uint32_t old_cbar, old_cba2r;           /* as found (logged; never written back since 2026-10-27) */
+	bool cb_written;
+	uint32_t page, pages, nctx, nsmr, nums2cb;
+	vm_offset_t g0, cbva;                   /* global pages 0-1, our context bank page */
+	vm_offset_t g0_map, cb_map;             /* the mappings to free (page aligned) */
+	vm_size_t g0_size, cb_size;
+	uint32_t smr[NEGRONI_S1_MAX_STREAMS], old_smr[NEGRONI_S1_MAX_STREAMS], old_s2cr[NEGRONI_S1_MAX_STREAMS];
+	bool reused[NEGRONI_S1_MAX_STREAMS], written[NEGRONI_S1_MAX_STREAMS];
+	vm_offset_t tpage[NEGRONI_S1_TABLE_PAGES];
+	uint32_t tpages, tleft;
+	uint64_t *root;
+	uint64_t root_pa;
+	uint32_t mapped_pages;
+};
+
+/* Context on for all streams of s. 0 or an errno; the reason is printed. On failure nothing stays written. */
+int negroni_s1_on(struct negroni_s1 *s);
+/* Map `size` bytes of kernel memory at `kva` (any physical layout, 4 KiB pages) at device address `iova`. */
+int negroni_s1_map_kva(struct negroni_s1 *s, uint64_t iova, vm_offset_t kva, uint64_t size);
+/* Print the context's fault registers (FSR, FAR, FSYNR0, the faulting stream) and clear them. */
+void negroni_s1_report(struct negroni_s1 *s, const char *when);
+/* The context's fault status (CB_FSR fault bits), 0 when off or no fault: cheap enough for a frame loop. */
+uint32_t negroni_s1_fsr(struct negroni_s1 *s);
+/* After the masters stopped: the SMRs/S2CRs back as found, the context off, the tables freed. */
+void negroni_s1_off(struct negroni_s1 *s);
+
+#endif /* _NEGRONI_SMMU_S1_H_ */
diff --git a/bsd/dev/negroni_spmi.c b/bsd/dev/negroni_spmi.c
new file mode 100644
index 0000000..7666fc3
--- /dev/null
+++ b/bsd/dev/negroni_spmi.c
@@ -0,0 +1,851 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450): PMIC access for the battery service
+ * (iokit/Kernel/arm/NegroniBattery.cpp), SPMI PMIC arbiter version 7, and the
+ * one arbiter mapping that the RTC (bsd/dev/negroni_rtc.c, patch 0203) and the
+ * battery share.
+ *
+ * Layout (Linux drivers/spmi/spmi-pmic-arb.c v7; live DT qcom,spmi@c42d000,
+ * qcom,ee = <0>; bus 0: PMK8350 SID 0, PM8350 SID 1, PM8350C SID 2, PM8350B SID 3):
+ *   core   0x0c400000  version at +0, bus 0 APID count at +4 bits 10:0,
+ *                      APID map at +0x2000 + 4*apid (bits 19:8 = PPID)
+ *   cnfg   0x0c42d000  owner table, 4*apid, bits 2:0 = EE that may write
+ *   obsrvr 0x0c440000  observer (read) channel at 0x8000*ee + 0x20*apid
+ *   chnls  0x0c500000  read/write channel of an APID at 0x1000*apid
+ * Reads use the observer channel and sk_read8() of negroni_spmi_keys.h, the
+ * same code as the keys and the RTC (a bounded poll: SK_POLLS status reads).
+ * Each user reads only its own APIDs' channels (keys: PON 0x013, GPIO 0x18d;
+ * reboot 0210/0211: SDAM 0x071, PON_PBS 0x008; RTC: 0x061; battery: SID 3 and
+ * SID 0 0x31 below), so two users never share a channel.
+ *
+ * Mappings (ml_io_map takes io_submap space and never gives it back: map
+ * once, small windows, never unmap): core 0x3000, cnfg 0x1000, EE 0 observer
+ * 0x8000 (1024 APIDs), mapped once by negroni_spmi_arbiter() for the RTC and
+ * the battery. The opt-in VADC mode adds one 0x1000 channel window.
+ *
+ * READ ONLY by default. An observer read does not change PMIC state (the MMIO
+ * store is the read command). Read allowlist:
+ *   SID 3 peripheral 0x47  PM8350B BCL (VBAT/IBAT monitor), any register
+ *   SID 0 peripheral 0x31  PMK8350 VADC (ADC7 HLOS user), any register
+ *   SID 3 offsets 0x04/0x05/0x10 of every peripheral: TYPE/SUBTYPE/INT_RT_STS
+ *          (census and plug-event discovery, negronibatt=2/5)
+ *   SID 3 peripherals 0x10-0x16  PM8350B SMB5 charger (CHGR, DCDC, BATIF, USBIN,
+ *          DCIN, TYPEC, MISC): status and config, any register (patch 0272)
+ *   SID 1 peripherals 0x41/0x44/0x45 and SID 2 peripheral 0x40 (PM8350 L2/L5/L6,
+ *          PM8350C L1: the USB PHY rails), offsets 0x08/0x40/0x41/0x45/0x46 only (patch 0372)
+ * Writes are locked. negroni_spmi_vadc_unlock() (opt-in negronibatt=4/5 only)
+ * opens the ADC7 request registers SID 0 0x3140-0x3145 and 0x3147 (APP_SID,
+ * DIG_PARAM, FAST_AVG, CH_SEL, DELAY, CONV_REQ, as Linux adc7_configure), and
+ * only when the owner table gives that APID to EE 0. 0x3146 (EN_CTL1),
+ * fuel gauge, BCL, interrupt and enable registers are never written.
+ * Patch 0272: negroni_spmi_chg_unlock() (boot-arg negronichg_ma > 0, the default)
+ * opens six SMB5 charger registers of SID 3: 0x1042 CHARGING_ENABLE_CMD,
+ * 0x1340 USBIN_CMD_IL (bit 0 suspend), 0x1342 USBIN_CMD_ICL_OVERRIDE,
+ * 0x1365 USBIN_LOAD_CFG, 0x1366 USBIN_ICL_OPTIONS, 0x1370 USBIN_CURRENT_LIMIT_CFG.
+ * The owner of these APIDs is logged; with negronichg_force=0 (default) a
+ * charger APID that another EE owns stays locked.
+ * A command that times out may complete late: its APID is not used again this
+ * boot. Callers: thread context (a mutex serializes the battery's accesses).
+ *
+ * Patch 0273: a second path for the charger blocks only (SID 3 0x10-0x16): the
+ * EE-independent PMIC arbiter DEBUG bus (Linux drivers/spmi/spmi-pmic-arb-debug.c,
+ * live DT qcom,spmi-debug@10b14000: core 0x10b14000 + 0x60, fuse word 0x221c8784,
+ * qcom,fuse-enable-bit = 18, clock = the AOSS QMP "qdss" clock). On OxygenOS the
+ * PM8350B charger belongs to the ADSP charger PD (DT qcom,pmic_glink, protection
+ * domain msm/adsp/charger_pd; oplus_battery_sm8450.c sets the ICL, charge enable and
+ * reads VBUS only through PMIC GLINK), and the HLOS arbiter channel (EE 0) does not
+ * read or write those blocks. negroni_spmi_chg_route() picks the path: normal (0272),
+ * debug, or auto (debug only when the normal path cannot read CHGR or cannot write).
+ * Opening the debug path: (1) the fuse word, bit 18 must be set (else Linux returns
+ * -ENODEV; the path stays closed), (2) the AOP QMP message
+ * "{class: clock, res: qdss, val: 1}" (Linux qcom_aoss.c qmp_qdss_clk_prepare; the
+ * link/channel handshake as patch 0240 step 4), (3) the core page, (4) a check read
+ * of a register that the normal path reads too (BCL 0x4704). The debug bus has no
+ * ownership check: the read allowlist and the same six charger write registers stay
+ * the only limits. A debug command that times out closes the debug path for the boot.
+ *
+ * Patch 0278: (1) negroni_spmi_bcl_monitor_on(): the BCL monitor enable of Linux bcl_pmic5.c
+ * (bcl_configure_bcl_peripheral, :779: MONITOR_EN 0x4746 = BIT(7)), written once and only when the
+ * bit reads clear and EE 0 owns the BCL APID; the one BCL register that is ever written (one write,
+ * then locked again). (2) The AOP QDSS clock vote of 0273 is released ("{class: clock, res: qdss,
+ * val: 0}", Linux qmp_qdss_clk_unprepare, qcom_aoss.c:294-296) on every path where the debug path
+ * ends after the vote: the core map fails, the check read fails, or a later timeout/32 failures
+ * close it. While the debug path is open the vote stays (its reads need the clock).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "negroni_spmi_keys.h"
+#include "negroni_spmi.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void IOSleep(unsigned int milliseconds);
+
+#define SP_CORE_PA        0x0c400000u
+#define SP_CORE_SIZE      0x3000u         /* version, features, APID map 0x2000 + 4 * 1024 */
+#define SP_CNFG_PA        0x0c42d000u
+#define SP_CNFG_SIZE      0x1000u         /* owner table, 4 * 1024 */
+#define SP_OBS_PA         0x0c440000u
+#define SP_OBS_SIZE       0x8000u         /* EE 0 observer channels, 0x20 * 1024 */
+#define SP_CHNLS_PA       0x0c500000u
+#define SP_EE             0u
+
+#define SP_MAX_APIDS      1024u           /* sk_find_apid's limit; PMIC_ARB_MAX_PERIPHS_V7 */
+#define SP_CHNL_STRIDE    0x1000u
+
+#define SP_CMD            0x00u
+#define SP_STATUS         0x08u
+#define SP_WDATA0         0x10u
+#define SP_OP_WRITEL      0u
+#define SP_DONE           (1u << 0)
+#define SP_ERRORS         0x0eu
+#define SP_WRITE_POLLS    2000u           /* x 1 us */
+#define SP_NO_APID        0xffffu
+
+#define SP_VADC_PPID      0x031u          /* SID 0, PMK8350 VADC 0x3100 */
+#define SP_BCL_PPID       0x347u          /* SID 3, PM8350B BCL 0x4700 */
+#define SP_CHGR_PPID      0x310u          /* SID 3, PM8350B SMB5 CHGR 0x1000 (0272) */
+#define SP_USBIN_PPID     0x313u          /* SID 3, PM8350B SMB5 USBIN 0x1300 (0272) */
+
+/* 0273: the debug arbiter (spmi-pmic-arb-debug.c register layout) and what it needs */
+#define SD_CORE_PA        0x10b14000u     /* reg "core" 0x10b14000 0x60 */
+#define SD_FUSE_PA        0x221c8000u     /* page of reg "fuse" 0x221c8784 */
+#define SD_FUSE_OFF       0x784u
+#define SD_FUSE_BIT       18u             /* qcom,fuse-enable-bit = <0x12> */
+#define SD_CMD0           0x00u           /* opcode << 1: starts the transaction */
+#define SD_CMD1           0x04u           /* byte count - 1 << 4 | SID */
+#define SD_CMD2           0x08u           /* peripheral */
+#define SD_CMD3           0x0cu           /* register offset */
+#define SD_STATUS         0x14u
+#define SD_WDATA0         0x18u
+#define SD_RDATA0         0x38u
+#define SD_OP_EXT_WRITEL  0u
+#define SD_OP_EXT_READL   1u
+#define SD_DONE           (1u << 0)
+#define SD_FAILURE        (1u << 1)
+#define SD_DENIED         (1u << 2)
+#define SD_DROPPED        (1u << 3)
+#define SD_POLLS          200u            /* x 1 us (Linux PMIC_ARB_TIMEOUT_US = 100) */
+#define SD_FAIL_LOG       8u              /* status-error lines logged per boot */
+#define SD_FAIL_CLOSE     32u             /* consecutive status errors that close the path */
+/* AOSS QMP (patch 0240 step 4, Linux qcom_aoss.c) and its IPCC doorbell (client 0 = AOP, signal 0) */
+#define QM_AOSS_PA        0x0c300000u
+#define QM_AOSS_SIZE      0x400u
+#define QM_IPCC_PA        0x0ed18000u
+#define QM_IPCC_SEND_ID   0x0cu
+#define QM_MAGIC          0x00u
+#define QM_MAGIC_VALUE    0x4d41494cu     /* "LIAM" */
+#define QM_VERSION        0x04u
+#define QM_UCORE_LINK     0x0cu
+#define QM_UCORE_LINK_ACK 0x10u
+#define QM_UCORE_CH       0x14u
+#define QM_UCORE_CH_ACK   0x18u
+#define QM_MCORE_LINK     0x24u
+#define QM_MCORE_LINK_ACK 0x28u
+#define QM_MCORE_CH       0x2cu
+#define QM_MCORE_CH_ACK   0x30u
+#define QM_MBOX_SIZE      0x34u
+#define QM_MBOX_OFFSET    0x38u
+#define QM_UP             0x0000ffffu
+#define QM_MSG_LEN        64u
+
+static LCK_GRP_DECLARE(sp_grp, "negroni_spmi");
+static LCK_MTX_DECLARE(sp_map_lock, &sp_grp);   /* the shared mapping */
+static LCK_MTX_DECLARE(sp_lock, &sp_grp);       /* the battery's accesses */
+
+/* The shared arbiter mapping (negroni_spmi_arbiter) */
+static struct sk_arbiter sp_arb;
+static vm_offset_t sp_cnfg;
+static bool sp_map_tried;
+static int sp_map_rc = -1;
+
+/* The battery's state */
+static vm_offset_t sp_vadc_chn;
+static unsigned sp_count;
+static bool sp_attempted, sp_ready;
+static uint16_t sp_vadc_apid = SP_NO_APID, sp_bcl_apid = SP_NO_APID;
+static bool sp_vadc_unlocked;
+static bool sp_poisoned[SP_MAX_APIDS];
+/* 0272: the charger's two channel windows, [0] CHGR, [1] USBIN */
+static vm_offset_t sp_chg_chn[2];
+static uint16_t sp_chg_apid[2] = { SP_NO_APID, SP_NO_APID };
+static bool sp_chg_unlocked;
+/* 0273: the charger route (0 normal, 1 debug) and the debug path's state */
+static int sp_chg_route;
+static int sd_state;                    /* 0 not tried, 1 open, -1 closed */
+static vm_offset_t sd_core;
+static unsigned sd_fail_logged, sd_fail_run;   /* status-error lines so far, consecutive status errors */
+/* 0278: the QDSS vote is held / must be released (set under sp_lock, released without it: QMP sleeps) */
+static bool sd_voted, sd_release_pending;
+/* 0278: the BCL MONITOR_EN write window (one write) */
+static vm_offset_t sp_bcl_chn;
+static bool sp_bcl_unlocked;
+
+int
+negroni_spmi_arbiter(struct sk_arbiter *arb, vm_offset_t *cnfg)
+{
+	lck_mtx_lock(&sp_map_lock);
+	if (!sp_map_tried) {
+		sp_map_tried = true;
+		sp_arb.core = (volatile uint32_t *)ml_io_map(SP_CORE_PA, SP_CORE_SIZE);
+		sp_arb.obs = (volatile uint32_t *)ml_io_map(SP_OBS_PA, SP_OBS_SIZE);
+		sp_arb.ee = SP_EE;
+		sp_cnfg = ml_io_map(SP_CNFG_PA, SP_CNFG_SIZE);
+		sp_map_rc = (sp_arb.core && sp_arb.obs && sp_cnfg) ? 0 : -1;
+		if (sp_map_rc) {
+			printf("NEGRONI SPMI: arbiter mapping failed (core %d, observer %d, cnfg %d)\n",
+			    sp_arb.core != NULL, sp_arb.obs != NULL, sp_cnfg != 0);
+		}
+	}
+	lck_mtx_unlock(&sp_map_lock);
+	if (arb) {
+		*arb = sp_arb;
+	}
+	if (cnfg) {
+		*cnfg = sp_cnfg;
+	}
+	return sp_map_rc;
+}
+
+static uint32_t
+sp_rd(vm_offset_t base, unsigned off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+sp_wr(vm_offset_t base, unsigned off, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static unsigned
+sp_owner(unsigned apid)
+{
+	return sp_rd(sp_cnfg, 4u * apid) & 7u;
+}
+
+/* As Linux picks it: the first mapping, replaced by one this EE owns. */
+static uint16_t
+sp_find_apid(unsigned ppid, unsigned *owner)
+{
+	uint16_t found = SP_NO_APID;
+	unsigned found_owner = 7;
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_arb.core[(SK_APID_MAP + 4u * i) / 4u];
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		unsigned o = sp_owner(i);
+		if (found == SP_NO_APID || o == SP_EE) {
+			found = (uint16_t)i;
+			found_owner = o;
+		}
+	}
+	if (owner) {
+		*owner = found_owner;
+	}
+	return found;
+}
+
+int
+negroni_spmi_init(void)
+{
+	lck_mtx_lock(&sp_lock);
+	if (sp_attempted) {
+		lck_mtx_unlock(&sp_lock);
+		return sp_ready ? 0 : -1;
+	}
+	sp_attempted = true;
+	if (negroni_spmi_arbiter(NULL, NULL) != 0) {
+		lck_mtx_unlock(&sp_lock);
+		printf("NEGRONI BATTERY: no SPMI arbiter mapping\n");
+		return -1;
+	}
+	uint32_t arb_version = sp_arb.core[0];
+	sp_count = sp_arb.core[SK_FEATURES / 4u] & SK_FEATURES_APIDS_MASK;
+	if (arb_version < SK_VERSION_V7_MIN || arb_version >= SK_VERSION_V8_MIN || !sp_count || sp_count > SP_MAX_APIDS) {
+		lck_mtx_unlock(&sp_lock);
+		printf("NEGRONI BATTERY: unsupported SPMI arbiter %#x (%u APIDs)\n", arb_version, sp_count);
+		return -1;
+	}
+	unsigned vadc_owner = 7, bcl_owner = 7;
+	sp_vadc_apid = sp_find_apid(SP_VADC_PPID, &vadc_owner);
+	sp_bcl_apid = sp_find_apid(SP_BCL_PPID, &bcl_owner);
+	sp_ready = true;
+	lck_mtx_unlock(&sp_lock);
+	printf("NEGRONI BATTERY: SPMI arbiter %#x, %u APIDs; PM8350B BCL 0x4700 APID %d (EE %u); "
+	    "PMK8350 VADC 0x3100 APID %d (EE %u); writes locked\n", arb_version, sp_count,
+	    sp_bcl_apid == SP_NO_APID ? -1 : (int)sp_bcl_apid, bcl_owner,
+	    sp_vadc_apid == SP_NO_APID ? -1 : (int)sp_vadc_apid, vadc_owner);
+	return 0;
+}
+
+int
+negroni_spmi_apid(unsigned sid, unsigned peripheral, unsigned *owner)
+{
+	unsigned o = 7;
+	int apid = -1;
+	if (sp_ready && sid <= 0xf && peripheral <= 0xff) {
+		uint16_t a = sp_find_apid((sid << 8) | peripheral, &o);
+		apid = a == SP_NO_APID ? -1 : (int)a;
+	}
+	if (owner) {
+		*owner = o;
+	}
+	return apid;
+}
+
+bool
+negroni_spmi_vadc_unlock(void)
+{
+	bool ok = false;
+	lck_mtx_lock(&sp_lock);
+	if (!sp_ready || sp_vadc_apid == SP_NO_APID) {
+		/* nothing to unlock */
+	} else if (sp_vadc_unlocked) {
+		ok = true;
+	} else if (sp_owner(sp_vadc_apid) != SP_EE) {
+		printf("NEGRONI BATTERY: VADC APID %u is not owned by EE 0: writes stay locked\n", sp_vadc_apid);
+	} else {
+		/* one 4 KiB channel window, kept for the boot (never unmapped) */
+		sp_vadc_chn = ml_io_map(SP_CHNLS_PA + SP_CHNL_STRIDE * sp_vadc_apid, SP_CHNL_STRIDE);
+		sp_vadc_unlocked = ok = sp_vadc_chn != 0;
+		printf("NEGRONI BATTERY: VADC APID %u: ADC7 conversion requests %s\n", sp_vadc_apid,
+		    ok ? "unlocked (0x3140-0x3145, 0x3147)" : "not possible (map failed)");
+	}
+	lck_mtx_unlock(&sp_lock);
+	return ok;
+}
+
+/* ---- 0273: the AOP QMP message for the QDSS clock (patch 0240 step 4, Linux qcom_aoss.c) ---- */
+
+static bool
+qm_wait(vm_offset_t aoss, unsigned off, uint32_t want, unsigned ms)
+{
+	for (unsigned i = 0; i < ms; i++) {
+		if (sp_rd(aoss, off) == want) {
+			return true;
+		}
+		IOSleep(1);
+	}
+	return sp_rd(aoss, off) == want;
+}
+
+/* Thread context, sleeps; not under sp_lock (QMP is not SPMI). 0 when the AOP took the message. */
+static int
+qm_send(const char *text, char *why, size_t len)
+{
+	static vm_offset_t aoss, ipcc;
+	uint32_t words[QM_MSG_LEN / 4] = { 0 }, box, boxsize;
+	size_t n = strlen(text);
+	if (n >= QM_MSG_LEN) {
+		snprintf(why, len, "message too long");
+		return -1;
+	}
+	if (!aoss) {
+		aoss = ml_io_map(QM_AOSS_PA, QM_AOSS_SIZE);
+	}
+	if (!ipcc) {
+		ipcc = ml_io_map(QM_IPCC_PA, 0x1000);
+	}
+	if (!aoss || !ipcc) {
+		snprintf(why, len, "AOSS/IPCC map failed");
+		return -1;
+	}
+	if (sp_rd(aoss, QM_MAGIC) != QM_MAGIC_VALUE || sp_rd(aoss, QM_VERSION) != 1) {
+		snprintf(why, len, "AOSS QMP magic %#x version %u", sp_rd(aoss, QM_MAGIC), sp_rd(aoss, QM_VERSION));
+		return -1;
+	}
+	box = sp_rd(aoss, QM_MBOX_OFFSET);
+	boxsize = sp_rd(aoss, QM_MBOX_SIZE);
+	if ((box & 3) || box < 0x3c || boxsize < QM_MSG_LEN + 4 || box + boxsize > QM_AOSS_SIZE) {
+		snprintf(why, len, "QMP mailbox at %#x size %#x does not fit", box, boxsize);
+		return -1;
+	}
+	if (!(sp_rd(aoss, QM_MCORE_LINK) == QM_UP && sp_rd(aoss, QM_MCORE_LINK_ACK) == QM_UP &&
+	    sp_rd(aoss, QM_MCORE_CH) == QM_UP && sp_rd(aoss, QM_UCORE_CH) == QM_UP && sp_rd(aoss, QM_MCORE_CH_ACK) == QM_UP)) {
+		printf("NEGRONI BATTERY: debug arbiter: opening the QMP link and channel to the AOP\n");
+		sp_wr(aoss, QM_UCORE_LINK_ACK, sp_rd(aoss, QM_UCORE_LINK));
+		sp_wr(aoss, QM_MCORE_LINK, QM_UP);
+		sp_wr(ipcc, QM_IPCC_SEND_ID, 0);
+		if (!qm_wait(aoss, QM_MCORE_LINK_ACK, QM_UP, 1000)) {
+			snprintf(why, len, "AOP does not ack our QMP link");
+			return -1;
+		}
+		sp_wr(aoss, QM_MCORE_CH, QM_UP);
+		sp_wr(ipcc, QM_IPCC_SEND_ID, 0);
+		if (!qm_wait(aoss, QM_UCORE_CH, QM_UP, 1000)) {
+			snprintf(why, len, "AOP does not open its QMP channel");
+			return -1;
+		}
+		sp_wr(aoss, QM_UCORE_CH_ACK, QM_UP);
+		sp_wr(ipcc, QM_IPCC_SEND_ID, 0);
+		if (!qm_wait(aoss, QM_MCORE_CH_ACK, QM_UP, 1000)) {
+			snprintf(why, len, "AOP does not ack our QMP channel");
+			return -1;
+		}
+	}
+	/* another sender (patch 0240) may be in the middle of a message: wait up to 1 s for an empty box */
+	if (!qm_wait(aoss, box, 0, 1000)) {
+		snprintf(why, len, "QMP mailbox still holds %u bytes", sp_rd(aoss, box));
+		return -1;
+	}
+	memcpy(words, text, n + 1);
+	for (unsigned i = 0; i < QM_MSG_LEN / 4; i++) {
+		sp_wr(aoss, box + 4 + 4 * i, words[i]);
+	}
+	sp_wr(aoss, box, QM_MSG_LEN);
+	sp_wr(ipcc, QM_IPCC_SEND_ID, 0);
+	if (!qm_wait(aoss, box, 0, 1000)) {
+		sp_wr(aoss, box, 0);
+		snprintf(why, len, "AOP does not take the QMP message");
+		return -1;
+	}
+	return 0;
+}
+
+/* ---- 0273: the debug arbiter ---- */
+
+static bool
+sp_chg_block(unsigned sid, unsigned addr)
+{
+	return sid == 3 && (addr >> 8) >= 0x10 && (addr >> 8) <= 0x16;
+}
+
+/* sp_lock held, sd_state > 0. One byte. 0 ok, 1 timeout (closes the debug path), 2 failure/denied/dropped. */
+static int
+sd_xfer(unsigned op, unsigned sid, unsigned addr, uint8_t *value)
+{
+	if (op == SD_OP_EXT_WRITEL) {
+		sp_wr(sd_core, SD_WDATA0, *value);
+	}
+	sp_wr(sd_core, SD_CMD3, addr & 0xffu);
+	sp_wr(sd_core, SD_CMD2, (addr >> 8) & 0xffu);
+	sp_wr(sd_core, SD_CMD1, (0u << 4) | (sid & 0xfu));          /* 1 byte */
+	sp_wr(sd_core, SD_CMD0, op << 1);
+	uint32_t st = 0;
+	for (unsigned i = 0; i < SD_POLLS; ++i) {
+		st = sp_rd(sd_core, SD_STATUS);
+		if (st & SD_DONE) {
+			if (st & (SD_FAILURE | SD_DENIED | SD_DROPPED)) {
+				if (sd_fail_logged < SD_FAIL_LOG) {
+					sd_fail_logged++;
+					printf("NEGRONI BATTERY: debug arbiter %s sid=%u addr=%#x: status %#x (%s)%s\n",
+					    op == SD_OP_EXT_WRITEL ? "write" : "read", sid, addr, st,
+					    (st & SD_DENIED) ? "denied" : (st & SD_DROPPED) ? "dropped" : "failed",
+					    sd_fail_logged == SD_FAIL_LOG ? " (last such line)" : "");
+				}
+				if (++sd_fail_run >= SD_FAIL_CLOSE) {
+					sd_state = -1;
+					sd_release_pending = sd_voted;          /* 0278 */
+					printf("NEGRONI BATTERY: debug arbiter: debug path closed: %u failures\n", sd_fail_run);
+				}
+				return 2;
+			}
+			sd_fail_run = 0;
+			if (op == SD_OP_EXT_READL) {
+				*value = (uint8_t)sp_rd(sd_core, SD_RDATA0);
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	sd_state = -1;
+	sd_release_pending = sd_voted;                          /* 0278 */
+	printf("NEGRONI BATTERY: debug arbiter %s sid=%u addr=%#x: timeout (status %#x): debug path closed\n",
+	    op == SD_OP_EXT_WRITEL ? "write" : "read", sid, addr, st);
+	return 1;
+}
+
+/* 0278: drop the QDSS clock vote once the debug path is closed. Thread context, sp_lock NOT held. */
+static void
+sd_vote_release(const char *why_closed)
+{
+	char why[96] = "";
+	bool go;
+
+	lck_mtx_lock(&sp_lock);
+	go = sd_voted;
+	sd_voted = sd_release_pending = false;
+	lck_mtx_unlock(&sp_lock);
+	if (!go) {
+		return;
+	}
+	if (qm_send("{class: clock, res: qdss, val: 0}", why, sizeof(why))) {
+		printf("NEGRONI BATTERY: debug arbiter: %s: QDSS clock vote release failed (%s)\n", why_closed, why);
+	} else {
+		printf("NEGRONI BATTERY: debug arbiter: %s: QDSS clock vote released (AOP QMP \"{class: clock, res: qdss, val: 0}\")\n",
+		    why_closed);
+	}
+}
+
+/* Once per boot (thread context, sleeps). True when the debug path is open. */
+static bool
+sd_open(bool check_fuse, bool qdss)
+{
+	if (sd_state) {
+		return sd_state > 0;
+	}
+	sd_state = -1;
+	vm_offset_t fuse = ml_io_map(SD_FUSE_PA, 0x1000);
+	uint32_t f = 0;
+	if (fuse) {
+		/* also a first access (QFPROM): the line reaches the USB log before it */
+		printf("NEGRONI BATTERY: debug arbiter: reading fuse 0x221c8784\n");
+		IOSleep(200);
+		f = sp_rd(fuse, SD_FUSE_OFF);
+	}
+	bool enabled = (f >> SD_FUSE_BIT) & 1u;
+	printf("NEGRONI BATTERY: debug arbiter: fuse 0x221c8784 = %#x%s, bit 18 %s%s\n", f, fuse ? "" : " (map failed)",
+	    enabled ? "set: debug bus enabled" : "clear: debug bus disabled by fuse",
+	    check_fuse ? "" : " (negronichg_dbgfuse=0: ignored)");
+	if (!fuse || (check_fuse && !enabled)) {
+		return false;
+	}
+	unsigned adsp = 0, slpi = 0;
+	(void)PE_parse_boot_argn("negroniadsp", &adsp, sizeof(adsp));
+	(void)PE_parse_boot_argn("negronislpi", &slpi, sizeof(slpi));   /* 0376: the SLPI start uses QMP too */
+	if (qdss && (adsp || slpi)) {
+		/* patch 0240 (negroniadsp) uses the same QMP mailbox with no shared lock: no vote, no debug path */
+		printf("NEGRONI BATTERY: debug arbiter: QDSS vote skipped: negroniadsp=%u negronislpi=%u share the QMP mailbox; "
+		    "debug path closed (negronichg_qdss=0 opens it without the vote)\n", adsp, slpi);
+		return false;
+	}
+	if (qdss) {
+		char why[96] = "";
+		printf("NEGRONI BATTERY: debug arbiter: AOP QMP \"{class: clock, res: qdss, val: 1}\"\n");
+		if (qm_send("{class: clock, res: qdss, val: 1}", why, sizeof(why))) {
+			printf("NEGRONI BATTERY: debug arbiter: QDSS clock vote failed (%s): debug path closed "
+			    "(negronichg_qdss=0 skips the vote)\n", why);
+			return false;
+		}
+		printf("NEGRONI BATTERY: debug arbiter: the AOP took the QDSS clock vote\n");
+		lck_mtx_lock(&sp_lock);
+		sd_voted = true;                /* 0278 */
+		lck_mtx_unlock(&sp_lock);
+	}
+	sd_core = ml_io_map(SD_CORE_PA, 0x1000);
+	if (!sd_core) {
+		printf("NEGRONI BATTERY: debug arbiter: core map failed\n");
+		sd_vote_release("core map failed");     /* 0278 */
+		return false;
+	}
+	printf("NEGRONI BATTERY: debug arbiter: first access of 0x10b14000 (a hang here: the bus has no clock)\n");
+	IOSleep(500);                   /* the line reaches the USB log before the access */
+	uint8_t dbg = 0xff, nrm = 0xff;
+	int nrc = -1;
+	lck_mtx_lock(&sp_lock);
+	sd_state = 1;
+	int rc = sd_xfer(SD_OP_EXT_READL, 3, 0x4704, &dbg);   /* PM8350B BCL TYPE */
+	if (sp_bcl_apid != SP_NO_APID && !sp_poisoned[sp_bcl_apid]) {
+		nrc = sk_read8(&sp_arb, sp_bcl_apid, 0x04, &nrm);
+	}
+	if (rc != 0 || (nrc == 0 && dbg != nrm)) {
+		sd_state = -1;
+	}
+	lck_mtx_unlock(&sp_lock);
+	printf("NEGRONI BATTERY: debug arbiter: check read SID 3 0x4704 = %02x (rc %d), normal path %02x (rc %d): %s\n",
+	    dbg, rc, nrm, nrc, sd_state > 0 ? "debug path OPEN" : "debug path closed");
+	if (sd_state <= 0) {
+		sd_vote_release("check read failed");   /* 0278 */
+	}
+	return sd_state > 0;
+}
+
+int
+negroni_spmi_chg_route(int arb, bool want_write, bool check_fuse, bool qdss)
+{
+	static const char *const arbName[] = { "auto", "normal", "debug" };
+	if (!sp_ready || arb < 0 || arb > 2) {
+		return -1;
+	}
+	uint8_t type = 0xff;
+	int nrc = negroni_spmi_read_rc(3, 0x1004, &type);      /* CHGR TYPE through the current route */
+	unsigned chgrOwner = 7, usbinOwner = 7;
+	int chgr = negroni_spmi_apid(3, 0x10, &chgrOwner), usbin = negroni_spmi_apid(3, 0x13, &usbinOwner);
+	bool normalReads = sp_chg_route == 0 && nrc == 0;
+	bool normalWrites = chgr >= 0 && usbin >= 0 && chgrOwner == SP_EE && usbinOwner == SP_EE;
+	bool debug = arb == 2 || (arb == 0 && (!normalReads || (want_write && !normalWrites)));
+	printf("NEGRONI BATTERY: charger route (negronichg_arb=%s): normal path read CHGR 0x1004 rc %d, CHGR APID %d EE %u, "
+	    "USBIN APID %d EE %u -> %s\n", arbName[arb], nrc, chgr, chgrOwner, usbin, usbinOwner,
+	    debug ? "try the debug arbiter" : "normal arbiter");
+	if (debug && sd_open(check_fuse, qdss)) {
+		lck_mtx_lock(&sp_lock);
+		if (sp_chg_route != 1) {
+			sp_chg_route = 1;
+			sp_chg_unlocked = false;        /* negroni_spmi_chg_unlock() decides again */
+		}
+		lck_mtx_unlock(&sp_lock);
+	}
+	return sp_chg_route;
+}
+
+bool
+negroni_spmi_chg_unlock(bool force)
+{
+	static const uint16_t ppid[2] = { SP_CHGR_PPID, SP_USBIN_PPID };
+	static const char *const name[2] = { "CHGR 0x1000", "USBIN 0x1300" };
+	bool ok = false;
+	lck_mtx_lock(&sp_lock);
+	if (!sp_ready) {
+		/* nothing to unlock */
+	} else if (sp_chg_unlocked) {
+		ok = true;
+	} else if (sp_chg_route == 1) {
+		/* 0273: the debug bus has no owner check; the six registers stay the only writable ones */
+		ok = sp_chg_unlocked = sd_state > 0;
+		printf("NEGRONI BATTERY: charger writes %s through the debug arbiter (0x1042 0x1340 0x1342 0x1365 0x1366 0x1370)\n",
+		    ok ? "unlocked" : "locked (debug path closed)");
+	} else {
+		ok = true;
+		for (unsigned i = 0; i < 2; ++i) {
+			unsigned owner = 7;
+			sp_chg_apid[i] = sp_find_apid(ppid[i], &owner);
+			if (sp_chg_apid[i] == SP_NO_APID) {
+				printf("NEGRONI BATTERY: charger %s: no APID: writes stay locked\n", name[i]);
+				ok = false;
+				continue;
+			}
+			if (owner != SP_EE && !force) {
+				printf("NEGRONI BATTERY: charger %s APID %u is owned by EE %u: writes stay locked "
+				    "(negronichg_force=1 tries anyway)\n", name[i], sp_chg_apid[i], owner);
+				ok = false;
+				continue;
+			}
+			/* one 4 KiB channel window each, kept for the boot (never unmapped) */
+			if (!sp_chg_chn[i]) {
+				sp_chg_chn[i] = ml_io_map(SP_CHNLS_PA + SP_CHNL_STRIDE * sp_chg_apid[i], SP_CHNL_STRIDE);
+			}
+			printf("NEGRONI BATTERY: charger %s APID %u (EE %u): %s\n", name[i], sp_chg_apid[i], owner,
+			    sp_chg_chn[i] ? "writes unlocked" : "channel map failed");
+			if (!sp_chg_chn[i]) {
+				ok = false;
+			}
+		}
+		sp_chg_unlocked = ok;
+	}
+	lck_mtx_unlock(&sp_lock);
+	return ok;
+}
+
+static bool
+sp_read_allowed(unsigned sid, unsigned addr)
+{
+	unsigned peripheral = addr >> 8, reg = addr & 0xffu;
+	if ((sid == 3 && peripheral == 0x47) || (sid == 0 && peripheral == 0x31)) {
+		return true;
+	}
+	if (sid == 3 && peripheral >= 0x10 && peripheral <= 0x16) {
+		return true;            /* 0272: SMB5 charger blocks */
+	}
+	if (((sid == 1 && (peripheral == 0x41 || peripheral == 0x44 || peripheral == 0x45)) || (sid == 2 && peripheral == 0x40)) &&
+	    (reg == 0x08 || reg == 0x40 || reg == 0x41 || reg == 0x45 || reg == 0x46)) {
+		return true;            /* 0372: USB PHY LDOs (PM8350 L2/L5/L6, PM8350C L1): STATUS1, VSET, MODE, EN_CTL */
+	}
+	return sid == 3 && (reg == 0x04 || reg == 0x05 || reg == 0x10);
+}
+
+int
+negroni_spmi_read_rc(unsigned sid, unsigned addr, uint8_t *out)
+{
+	if (!sp_ready || !out || sid > 0xf || addr > 0xffffu || !sp_read_allowed(sid, addr)) {
+		return 3;
+	}
+	unsigned ppid = (sid << 8) | (addr >> 8);
+	lck_mtx_lock(&sp_lock);
+	if (sp_chg_route == 1 && sp_chg_block(sid, addr)) {
+		/* 0273: the charger blocks through the debug arbiter; 6 = debug path closed */
+		uint8_t d = 0;
+		int drc = sd_state > 0 ? sd_xfer(SD_OP_EXT_READL, sid, addr, &d) : 6;
+		if (drc == 0) {
+			*out = d;
+		}
+		bool rel = sd_release_pending;
+		lck_mtx_unlock(&sp_lock);
+		if (rel) {
+			sd_vote_release("debug path closed");   /* 0278 */
+		}
+		return drc;
+	}
+	uint16_t apid = ppid == SP_BCL_PPID ? sp_bcl_apid : ppid == SP_VADC_PPID ? sp_vadc_apid :
+	    sp_find_apid(ppid, NULL);
+	if (apid == SP_NO_APID) {
+		lck_mtx_unlock(&sp_lock);
+		return 4;
+	}
+	if (sp_poisoned[apid]) {
+		lck_mtx_unlock(&sp_lock);
+		return 5;
+	}
+	uint8_t v = 0;
+	int rc = sk_read8(&sp_arb, apid, (uint8_t)(addr & 0xffu), &v);  /* 0 ok, 1 timeout, 2 arbiter error */
+	if (rc == 0) {
+		*out = v;
+	} else if (rc == 1) {
+		sp_poisoned[apid] = true;
+		printf("NEGRONI BATTERY: SPMI read timeout sid=%u addr=%#x APID=%u: APID not used again\n", sid, addr, apid);
+	}
+	lck_mtx_unlock(&sp_lock);
+	return rc;
+}
+
+int
+negroni_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	return negroni_spmi_read_rc(sid, addr, out) ? -1 : 0;
+}
+
+/* The channel window of a writable register (sp_lock held): the VADC request registers after the
+ * VADC unlock, the six SMB5 charger registers after the charger unlock (0272). */
+static bool
+sp_write_target(unsigned sid, unsigned addr, vm_offset_t *chn, uint16_t *apid)
+{
+	/* ADC7 user registers of the PMK8350 VADC; 0x3146 (EN_CTL1) is not written */
+	if (sid == 0 && addr >= 0x3140 && addr <= 0x3147 && addr != 0x3146) {
+		*chn = sp_vadc_chn;
+		*apid = sp_vadc_apid;
+		return sp_vadc_unlocked;
+	}
+	/* 0278: BCL MONITOR_EN, only inside negroni_spmi_bcl_monitor_on() */
+	if (sid == 3 && addr == 0x4746 && sp_bcl_unlocked && sp_bcl_chn && sp_bcl_apid != SP_NO_APID) {
+		*chn = sp_bcl_chn;
+		*apid = sp_bcl_apid;
+		return true;
+	}
+	if (sid == 3 && sp_chg_unlocked) {
+		if (addr == 0x1042) {
+			*chn = sp_chg_chn[0];
+			*apid = sp_chg_apid[0];
+			return *chn != 0;
+		}
+		if (addr == 0x1340 || addr == 0x1342 || addr == 0x1365 || addr == 0x1366 || addr == 0x1370) {
+			*chn = sp_chg_chn[1];
+			*apid = sp_chg_apid[1];
+			return *chn != 0;
+		}
+	}
+	return false;
+}
+
+int
+negroni_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	vm_offset_t chn = 0;
+	uint16_t apid = SP_NO_APID;
+	if (!sp_ready) {
+		return -1;
+	}
+	lck_mtx_lock(&sp_lock);
+	if (sp_chg_route == 1 && sp_chg_block(sid, addr)) {
+		/* 0273: debug arbiter; only the six charger registers, only after the charger unlock */
+		uint8_t v = value;
+		int drc = -1;
+		if (sp_chg_unlocked && sd_state > 0 && (addr == 0x1042 || addr == 0x1340 || addr == 0x1342 ||
+		    addr == 0x1365 || addr == 0x1366 || addr == 0x1370)) {
+			drc = sd_xfer(SD_OP_EXT_WRITEL, sid, addr, &v);
+		}
+		bool rel = sd_release_pending;
+		lck_mtx_unlock(&sp_lock);
+		if (rel) {
+			sd_vote_release("debug path closed");   /* 0278 */
+		}
+		return drc ? -1 : 0;
+	}
+	if (!sp_write_target(sid, addr, &chn, &apid) || sp_poisoned[apid]) {
+		lck_mtx_unlock(&sp_lock);
+		return -1;
+	}
+	sp_wr(chn, SP_WDATA0, value);
+	sp_wr(chn, SP_CMD, (SP_OP_WRITEL << 27) | ((addr & 0xffu) << 4));
+	int rc = -2;
+	for (unsigned i = 0; i < SP_WRITE_POLLS; ++i) {
+		uint32_t s = sp_rd(chn, SP_STATUS);
+		if (s & SP_DONE) {
+			rc = (s & SP_ERRORS) ? -1 : 0;
+			if (rc) {
+				printf("NEGRONI BATTERY: SPMI write sid=%u addr=%#x APID=%u refused (status %#x)\n", sid, addr, apid, s);
+			}
+			break;
+		}
+		delay(1);
+	}
+	if (rc == -2) {
+		sp_poisoned[apid] = true;
+		printf("NEGRONI BATTERY: SPMI write timeout sid=%u addr=%#x APID=%u: APID not used again\n", sid, addr, apid);
+	}
+	lck_mtx_unlock(&sp_lock);
+	return rc ? -1 : 0;
+}
+
+/*
+ * 0278: the BCL monitor on, as Linux bcl_configure_bcl_peripheral() (bcl_pmic5.c:777-780) does at probe.
+ * Returns 0 when MONITOR_EN bit 7 already reads set (XBL/ABL left it on: no write), 1 when this call set
+ * it (read back), -1 on failure (no APID, another EE owns it, write or read back failed).
+ */
+int
+negroni_spmi_bcl_monitor_on(void)
+{
+	uint8_t v = 0, back = 0;
+	unsigned owner = 7;
+	int rc;
+
+	if (!sp_ready || sp_bcl_apid == SP_NO_APID || negroni_spmi_read(3, 0x4746, &v)) {
+		return -1;
+	}
+	if (v & 0x80u) {
+		return 0;
+	}
+	lck_mtx_lock(&sp_lock);
+	(void)sp_find_apid(SP_BCL_PPID, &owner);
+	if (owner == SP_EE && !sp_poisoned[sp_bcl_apid]) {
+		if (!sp_bcl_chn) {
+			sp_bcl_chn = ml_io_map(SP_CHNLS_PA + SP_CHNL_STRIDE * sp_bcl_apid, SP_CHNL_STRIDE);
+		}
+		sp_bcl_unlocked = sp_bcl_chn != 0;
+	}
+	lck_mtx_unlock(&sp_lock);
+	if (!sp_bcl_unlocked) {
+		printf("NEGRONI BATTERY: BCL MONITOR_EN 0x4746 = %#x (off): not written (APID %u owner EE %u%s)\n", v,
+		    sp_bcl_apid, owner, sp_bcl_chn ? "" : ", no channel window");
+		return -1;
+	}
+	rc = negroni_spmi_write(3, 0x4746, 0x80);
+	lck_mtx_lock(&sp_lock);
+	sp_bcl_unlocked = false;                /* one write, locked again */
+	lck_mtx_unlock(&sp_lock);
+	if (rc == 0) {
+		IOSleep(2);
+		rc = negroni_spmi_read(3, 0x4746, &back);
+	}
+	printf("NEGRONI BATTERY: BCL MONITOR_EN 0x4746 was %#x: wrote 0x80 (bcl_pmic5.c:779): %s, reads %#x\n", v,
+	    rc == 0 && (back & 0x80u) ? "monitor ON" : "FAILED", back);
+	return rc == 0 && (back & 0x80u) ? 1 : -1;
+}
+
+unsigned
+negroni_spmi_ppids(uint16_t *ppids, uint8_t *owners, unsigned max)
+{
+	unsigned n = 0;
+	if (!sp_ready) {
+		return 0;
+	}
+	for (unsigned i = 0; i < sp_count && n < max; ++i) {
+		uint32_t map = sp_arb.core[(SK_APID_MAP + 4u * i) / 4u];
+		if (!map) {
+			continue;
+		}
+		ppids[n] = (uint16_t)((map >> 8) & 0xfffu);
+		owners[n] = (uint8_t)sp_owner(i);
+		n++;
+	}
+	return n;
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_spmi.h b/bsd/dev/negroni_spmi.h
new file mode 100644
index 0000000..f1fe91f
--- /dev/null
+++ b/bsd/dev/negroni_spmi.h
@@ -0,0 +1,54 @@
+/* Shared C/C++ interface (bsd/dev/negroni_spmi.c). Init once, on the NegroniBattery start thread. */
+#ifndef NEGRONI_BATTERY_SPMI_H
+#define NEGRONI_BATTERY_SPMI_H
+#include <stdint.h>
+#include <stdbool.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+struct sk_arbiter;
+/*
+ * The SPMI arbiter v7 mapping (core 0x3000, EE 0 observer 0x8000, owner table 0x1000), made once
+ * for every caller (the RTC, patch 0203, and the battery). Thread context. 0 when all three are
+ * mapped. *arb / *cnfg get the mapping (NULL pointers when it failed); either may be NULL.
+ */
+int negroni_spmi_arbiter(struct sk_arbiter *arb, vm_offset_t *cnfg);   /* needs vm_offset_t (mach types) */
+/* Finds the battery's APIDs on the shared mapping. No PMIC access. 0 success, -1 failure. */
+int negroni_spmi_init(void);
+/* Thread context only; 0 success, -1 failure; *out unchanged on failure. Allowlisted registers only. */
+int negroni_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+/* 0272: the same read with the reason: 0 ok, 1 timeout, 2 arbiter error, 3 not allowed, 4 no APID, 5 APID poisoned,
+ * 6 debug path closed (0273) */
+int negroni_spmi_read_rc(unsigned sid, unsigned addr, uint8_t *out);
+/* APID of SID/peripheral (-1 = not in the APID map) and its owner EE (7 if not mapped). */
+int negroni_spmi_apid(unsigned sid, unsigned peripheral, unsigned *owner);
+/*
+ * PMIC writes are locked after init: negroni_spmi_write fails until this call unlocks it. The call
+ * succeeds only if EE 0 owns the PMK8350 VADC APID. Only the opt-in VADC mode (negronibatt=4/5) calls it.
+ */
+bool negroni_spmi_vadc_unlock(void);
+/*
+ * 0272: opens the PM8350B SMB5 charger registers for writes (SID 3: 0x1042, 0x1340, 0x1342, 0x1365,
+ * 0x1366, 0x1370). force: also when EE 0 does not own the CHGR/USBIN APIDs. True when unlocked.
+ */
+bool negroni_spmi_chg_unlock(bool force);
+/*
+ * 0273: the path of the charger blocks (SID 3 0x10-0x16). arb 0 auto (the debug arbiter when the normal
+ * path cannot read CHGR 0x1004, or cannot write and want_write), 1 normal (0272), 2 debug. check_fuse:
+ * keep the path closed when fuse bit 18 is clear; qdss: send the AOP the QDSS clock vote first.
+ * Thread context, sleeps (QMP). Returns the route now in use: 0 normal, 1 debug; -1 before init.
+ * A switch to the debug route locks the charger writes again: call negroni_spmi_chg_unlock() after it.
+ */
+int negroni_spmi_chg_route(int arb, bool want_write, bool check_fuse, bool qdss);
+/* PMK8350 VADC ADC7 request registers (SID 0 0x3140-0x3145, 0x3147) after the VADC unlock, the six
+ * charger registers after the charger unlock; everything else fails. */
+int negroni_spmi_write(unsigned sid, unsigned addr, uint8_t value);
+/* 0278: BCL MONITOR_EN (0x4746 bit 7) on when it reads off and EE 0 owns the BCL APID (bcl_pmic5.c:779).
+ * 0 already on (no write), 1 set by this call, -1 failure. Thread context. */
+int negroni_spmi_bcl_monitor_on(void);
+/* The arbiter's APID map (PPID = SID << 8 | peripheral) and owner EEs; returns the count. */
+unsigned negroni_spmi_ppids(uint16_t *ppids, uint8_t *owners, unsigned max);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/negroni_spmi_keys.h b/bsd/dev/negroni_spmi_keys.h
new file mode 100755
index 0000000..5c57bae
--- /dev/null
+++ b/bsd/dev/negroni_spmi_keys.h
@@ -0,0 +1,119 @@
+/** @file
+  Hardware keys of the OnePlus 10 Pro 5G (negroni, SM8450) through the SPMI PMIC arbiter, as pure register-pointer code (host-testable).
+
+  Facts, all from the board devicetree and mainline Linux (drivers/input/misc/pm8941-pwrkey.c, drivers/pinctrl/qcom/pinctrl-spmi-gpio.c):
+    power key   PMIC SID 0, PON peripheral PID 0x13 (reg 0x1300), PON_RT_STS at +0x10, PON_GEN3_KPDPWR_N_SET = bit 7, set = pressed
+    volume down PMIC SID 0, same register, PON_GEN3_RESIN_N_SET = bit 6, set = pressed (the board's linux,code 114)
+    volume up   PM8550 (SID 1) GPIO6, peripheral PID 0x88 + 5 = 0x8d, RT_STS at +0x10 bit 0; gpio-keys flags 1 = active low
+  The arbiter layout (version 7, "core" 0xc400000, "cnfg" 0xc42d000, "obsrvr" 0xc440000, EE 0) is the one the kernel side already reads
+  on this hardware (BootResetCore.h): an APID is found by its PPID (SID << 8 | PID) in the APID map, and a register byte is read with an
+  extended-read command on the observer channel of that APID.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+#ifndef NEGRONI_SPMI_KEYS_H_
+#define NEGRONI_SPMI_KEYS_H_
+
+#include <stdint.h>
+
+enum {
+  SK_VERSION_V7_MIN = 0x70000000u, SK_VERSION_V8_MIN = 0x80000000u,
+  SK_FEATURES = 0x04, SK_FEATURES_APIDS_MASK = 0x7ffu,
+  SK_APID_MAP = 0x2000,
+  SK_OBS_EE_STRIDE = 0x8000, SK_OBS_APID_STRIDE = 0x20,
+  SK_CMD = 0x00, SK_STATUS = 0x08, SK_RDATA0 = 0x18,
+  SK_OP_EXT_READL = 1,
+  SK_STATUS_DONE = 1u << 0, SK_STATUS_ERRORS = 0xeu,
+  SK_POLLS = 100000,
+  SK_PPID_PON = 0x013, SK_PPID_GPIO6 = 0x18d, SK_REG_RT_STS = 0x10,
+  SK_PON_RESIN = 1u << 6, SK_PON_KPDPWR = 1u << 7,
+  SK_KEY_POWER = 1u << 0, SK_KEY_VOLDOWN = 1u << 1, SK_KEY_VOLUP = 1u << 2
+};
+
+struct sk_arbiter {
+  volatile uint32_t *core;   // 0x3000 bytes
+  volatile uint32_t *obs;    // observer channels of this EE and above (EE 0 starts at the base)
+  uint8_t ee;
+};
+
+// 0 and *apid on success. 1 unknown layout, 2 no APIDs, 3 PPID not mapped.
+static inline int sk_find_apid (const struct sk_arbiter *a, uint32_t ppid, int *apid)
+{
+  uint32_t version = a->core[0], apids = a->core[SK_FEATURES / 4] & SK_FEATURES_APIDS_MASK;
+  *apid = -1;
+  if (version < SK_VERSION_V7_MIN || version >= SK_VERSION_V8_MIN) return 1;
+  if (!apids || apids > 1024) return 2;
+  for (uint32_t i = 0; i < apids; ++i) {
+    uint32_t map = a->core[(SK_APID_MAP + 4 * i) / 4];
+    if (map && ((map >> 8) & 0xfff) == ppid) { *apid = (int) i; break; }
+  }
+  return *apid < 0 ? 3 : 0;
+}
+
+// One register byte through the observer channel. 0 ok, 1 timeout, 2 the arbiter reported an error.
+static inline int sk_read8 (const struct sk_arbiter *a, int apid, uint8_t reg, uint8_t *value)
+{
+  volatile uint32_t *ch = a->obs + (SK_OBS_EE_STRIDE * a->ee + SK_OBS_APID_STRIDE * (uint32_t) apid) / 4;
+  ch[SK_CMD / 4] = ((uint32_t) SK_OP_EXT_READL << 27) | ((uint32_t) reg << 4);
+  for (unsigned n = 0; n < SK_POLLS; ++n) {
+    uint32_t s = ch[SK_STATUS / 4];
+    if (s & SK_STATUS_DONE) {
+      if (s & SK_STATUS_ERRORS) return 2;
+      *value = (uint8_t) ch[SK_RDATA0 / 4];
+      return 0;
+    }
+  }
+  return 1;
+}
+
+struct sk_keys { int pon, gpio; };   // APIDs, -1 = not available
+
+static inline int sk_open (const struct sk_arbiter *a, struct sk_keys *k)
+{
+  int rc = sk_find_apid (a, SK_PPID_PON, &k->pon);
+  if (rc) return rc;
+  if (sk_find_apid (a, SK_PPID_GPIO6, &k->gpio)) k->gpio = -1;   // the power and volume-down keys still work without it
+  return 0;
+}
+
+// Pressed keys as SK_KEY_* bits. 0 ok; non-zero when a read failed (nothing is reported pressed then).
+static inline int sk_sample (const struct sk_arbiter *a, const struct sk_keys *k, uint8_t *pressed)
+{
+  uint8_t v = 0;
+  *pressed = 0;
+  int rc = sk_read8 (a, k->pon, SK_REG_RT_STS, &v);
+  if (rc) return rc;
+  if (v & SK_PON_KPDPWR) *pressed |= SK_KEY_POWER;
+  if (v & SK_PON_RESIN) *pressed |= SK_KEY_VOLUP;       // negroni: resin = volume up (mainline negroni DT)
+  if (k->gpio >= 0) {
+    rc = sk_read8 (a, k->gpio, SK_REG_RT_STS, &v);
+    if (rc) { *pressed = 0; return rc; }
+    if (!(v & 1)) *pressed |= SK_KEY_VOLDOWN;     // negroni: PM8350 (SID 1) GPIO6 = volume down, active low
+  }
+  return 0;
+}
+
+// Debounce and auto-repeat. A key counts as pressed after two identical samples. Volume keys repeat while held: first after
+// `delay` polls, then every `period` polls. step() returns the keys to report now (new presses plus repeats).
+struct sk_filter { uint8_t last, stable; uint16_t held[3]; };
+
+static inline uint8_t sk_step (struct sk_filter *f, uint8_t sample, uint16_t delay, uint16_t period)
+{
+  uint8_t out = 0;
+  if (sample == f->last) {
+    uint8_t fresh = (uint8_t) (sample & ~f->stable);
+    f->stable = sample;
+    out = fresh;
+    for (unsigned i = 0; i < 3; ++i) {
+      uint8_t bit = (uint8_t) (1u << i);
+      if (!(sample & bit)) { f->held[i] = 0; continue; }
+      if (fresh & bit) { f->held[i] = 0; continue; }
+      ++f->held[i];
+      if (bit != SK_KEY_POWER && f->held[i] >= delay && (f->held[i] - delay) % period == 0) out |= bit;
+    }
+  }
+  f->last = sample;
+  return out;
+}
+
+#endif
diff --git a/bsd/dev/negroni_tfa.c b/bsd/dev/negroni_tfa.c
new file mode 100644
index 0000000..59a866a
--- /dev/null
+++ b/bsd/dev/negroni_tfa.c
@@ -0,0 +1,834 @@
+/*
+ * NEGRONI (SM8450) speaker/earpiece amplifiers: 2x NXP TFA9874 (iOSPlus10 patch 0244, docs/audio-plan.md
+ * stage (c)). UNTESTED ON HARDWARE. Off by default: boot-arg negroniaudio_amp=1.
+ *
+ * Hardware (live DT i2c@a94000, tfa98xx@34/@35; odm resourcemanager.xml; mixer_paths.xml):
+ *   I2C     QUP SE13 pins GPIO48 SDA / GPIO49 SCL. We bit-bang them (the touch driver's tlmm_i2c.h,
+ *           ~100 kHz, internal pull-ups as the DT's qupv3_se13_i2c_active); no GENI programming.
+ *   amps    0x34 (tfa_channel 0, reset GPIO50) and 0x35 (channel 1, reset GPIO51), VDD pm8350_s10
+ *           1.8 V (always on). Reset is active-high: 1, 5 ms, 0, 5 ms (tfa98xx_v6.c tfa98xx_ext_reset).
+ *   data    I2S slave on TERT MI2S (SD1 = GPIO124), 48 kHz, 32-bit slots: 0x34 plays slot 0 (left),
+ *           0x35 slot 1 (right) (container TDMSPKS 0 / 1).
+ *   routes  speaker  = both amps, profile "speaker" (mixer path "speaker": TFA_CHIP_SELECTOR 3)
+ *           earpiece = 0x34 only, profile "receiver" (mixer path "handset": TFA_CHIP_SELECTOR 1 =
+ *                      CHIP_SELECTOR_LEFT = channel 0 = 0x34)
+ *
+ * The TFA9874 has no DSP ("non-DSP TFA", is_probus_device). Register writes alone start it. The
+ * sequence is the vendor driver's cold start (tfa98xx-v6: tfa_dev_start -> tfaRunSpeakerBoost_v6 ->
+ * tfaRunStartup_v6 -> tfa98xx_init_v6 + tfa9874_specific, tfaContWriteRegsDev, tfaContWriteRegsProf,
+ * tfa_dev_set_state INIT_CF, tfaRunStartDSP_v6, tfa_dev_set_state OPERATING), read for the
+ * register values; our own code:
+ *   1 read AUDFS (0x02[3:0]) and FRACTDEL (0x02[10:5])
+ *   2 I2CR: reg 0x00 = 0x0002 (all registers to POR); RST (reg 0x90 bit 0) = 1
+ *   3 keys: 0x0F = 0x5A6B, read 0xFB, 0xA0 = 0xFB ^ 0x005A; key2: 0x0F = 0x5A6B, 0xA1 = 0x005A, 0x0F = 0
+ *   4 the revision table (0x0a74, 0x0b74, 0x0c74; tfa_init_v6.c tfa9874_specific)
+ *   5 AUDFS, FRACTDEL back
+ *   6 the container's device items, then the profile items up to its "default" marker
+ *     (tfa-init.bin, made by scripts/audio/tfa-cnt.py from odm/firmware/tfa98xx.cnt; read from the
+ *     ADSP firmware area, SHA-256 checked; vendor data, not in git)
+ *   7 INIT_CF: MANSCONF (0x01 bit 2) = 1, PWDN (0x00 bit 0) = 0, wait CLKS (0x11 bit 7)
+ *   8 RST = 0 (tfaRunStartDSP_v6; the container's patch "9874_dummy.patch" has no writes)
+ *   9 SWPROFIL (0xEE) = profile + 1, SWVSTEP (0xEF) = 1
+ *  10 OPERATING: PWDN 0, MANSCONF 1, AMPE (0x00 bit 3) = 1
+ * Stop (tfa_dev_stop): PWDN 1, AMPE 0, wait MANSTATE (0x14[6:3]) = 0.
+ * Deviations [I]: the vendor also writes DSP memory (XMEM 512 = 0 through regs 0x90-0x92) in
+ * tfaRunStartDSP_v6; the TFA9874 has no DSP and no such registers in its field map: left out.
+ *
+ * SAFETY (speaker damage). Android runs NXP's protection algorithm in the ADSP (module 0x1700B911,
+ * libtfadsp_rx.so, with V/I feedback on TERT MI2S TX); we do not. What protects the speakers here:
+ *   - TDMSPKG (0x61[9:6]) is an ATTENUATION: gain = 21 dB - TDMSPKG (TFA9874B/TFA9875 data sheet:
+ *     G(TDM-VO) 6..21 dB, 1 dB per code; INPLEV = "TDM output attenuation"). It is held at or ABOVE a
+ *     floor: route speaker at negroniaudio_spkg (default 9 = 12 dB; the container has 7 = 14 dB on 0x34,
+ *     5 = 16 dB on 0x35), route receiver at negroniaudio_rcvg (default 15 = 6 dB, with INPLEV 1 about
+ *     0 dB; the container has 13 = 8 dB, INPLEV 1). Never below the container value (never louder than
+ *     the vendor); read back before AMPE, else no start;
+ *   - the kernel guard in negroni_audio.c (gain cap -20 dBFS by default, high-pass, power and peak
+ *     limiter, silence timer, fault stop);
+ *   - the status registers (vendor check, tfa98xx_v6.c check_err_tfa9874): 0x10 bit 2 = 0 over-
+ *     temperature, bit 3 = 1 over-current, bit 4 = 0 VBAT low, bit 7 = 1 no clock; 0x13 bit 8 = 0 VBAT
+ *     high, bit 9 = 1 clipping. A fault stops the amps and blocks a restart for 10 s;
+ *   - panic/halt: AMPE 0 + PWDN 1, then both reset pins held high (negroni_tfa_panic);
+ *   - MTP (0xF0..0xFF, the factory calibration) is read only; the table loader refuses writes to it.
+ * Log prefix "NEGRONI TFA:".
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include <libkern/crypto/sha2.h>
+#include "negroni_touch/tlmm_i2c.h"
+#include "negroni_tfa.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void IOSleep(unsigned int ms);
+extern int negroni_ufs_adsp_area_read(uint64_t at, void *dst, uint32_t count);
+
+#define TFA_TLMM_PHYS           0x0f100000UL     /* GPIO n control at + n * 0x1000 (pinctrl-sm8450.c) */
+#define TFA_PIN_FIRST           48u              /* 48 SDA, 49 SCL, 50 reset 0x34, 51 reset 0x35: one 16 KiB page */
+#define TFA_PIN_OFF(n)          (((n) - TFA_PIN_FIRST) * 0x1000u)
+
+/* bitfields: address << 8 | pos << 4 | (len - 1) (tfa9874_tfafieldnames.h) */
+#define BF_PWDN                 0x0000u
+#define BF_I2CR                 0x0010u
+#define BF_AMPE                 0x0030u
+#define BF_MANSCONF             0x0120u
+#define BF_AUDFS                0x0203u
+#define BF_FRACTDEL             0x0255u
+#define BF_CLKS                 0x1170u
+#define BF_MANSTATE             0x1433u
+#define BF_TDMSPKG              0x6163u
+#define BF_INPLEV               0x0240u
+#define BF_RST                  0x9000u          /* TFA2 family RST: the vendor sets it for every family-2 chip */
+#define REG_SWPROFIL            0xEEu
+#define REG_SWVSTEP             0xEFu
+
+/* tfa-init.bin (scripts/audio/tfa-cnt.py) */
+#define TBL_NAME                "tfa-init.bin"
+#define TBL_MAX                 16384u
+#define TBL_MAX_PROF            8u
+struct tbl_rec {
+	uint8_t i2c, prof, kind, reg;
+	uint16_t field, value, mask, pad;
+} __attribute__((packed));
+#define REC_DEVICE              0xffu
+#define KIND_BF                 1u
+#define KIND_REG                2u
+
+/* the ADSP firmware area header (scripts/audio/mkadsparea.py, negroni_adsp.c) */
+#define AREA_HEADER             8192u
+#define AREA_MAX                64u
+struct area_entry {
+	char name[48];
+	uint32_t offset, size;
+	uint8_t sha256[32];
+};
+
+struct amp {
+	uint8_t addr, rst_pin;
+	const char *where;
+	bool present, playing;
+	uint16_t rev;
+	uint16_t spkg_container[TBL_MAX_PROF];  /* TDMSPKG the container sets per profile (0xffff: none) */
+};
+static struct amp amps[2] = {
+	{ .addr = 0x34, .rst_pin = 50, .where = "top (earpiece, left)" },
+	{ .addr = 0x35, .rst_pin = 51, .where = "bottom (right)" },
+};
+
+static uint32_t amp_on, spkg_floor = 9, rcvg_floor = 15, verbose_starts = 1;
+#define SPKG_DB(v)              (21 - (int)(v))  /* TDMSPKG -> amplifier gain in dB (data sheet) */
+static vm_offset_t pins;                         /* GPIO48 control register */
+static struct tlmm_i2c line;
+static struct gpio_i2c bus;
+static uint8_t *tbl;                            /* tfa-init.bin */
+static uint32_t tbl_nprof, tbl_nrec;
+static const struct tbl_rec *recs;
+static char prof_names[TBL_MAX_PROF][16];
+static int prof_speaker = -1, prof_receiver = -1;
+static bool probed;
+static uint32_t cur_route;
+static uint64_t fault_until;                    /* mach_absolute_time: no restart before */
+static uint32_t starts, faults;
+static bool logging;                            /* this start logs every write */
+
+static LCK_GRP_DECLARE(negroni_tfa_grp, "negroni_tfa");
+static LCK_MTX_DECLARE(negroni_tfa_lock, &negroni_tfa_grp);
+
+#define say(fmt, ...) printf("NEGRONI TFA: " fmt "\n", ##__VA_ARGS__)
+
+static void
+tfa_udelay(unsigned us)
+{
+	delay((int)us);
+}
+
+/* ==== I2C (8-bit register, 16-bit value, MSB first; reads with a repeated start, as regmap) ==== */
+
+static int
+i2c_wr(uint8_t a, uint8_t reg, uint16_t v)
+{
+	uint8_t b[3] = { reg, (uint8_t)(v >> 8), (uint8_t)v };
+	int rc = -1;
+
+	for (int t = 0; t < 3 && rc != 0; t++) {        /* I2C_RETRIES 3 in tfa98xx_v6.c */
+		rc = gpio_i2c_write(&bus, a, b, 3);
+		if (rc != 0) {
+			IOSleep(1);
+		}
+	}
+	return rc;
+}
+
+static int
+i2c_rd_once(uint8_t a, uint8_t reg, uint16_t *v)
+{
+	uint8_t b[2] = { 0, 0 };
+	int rc = gi_start(&bus, a, 0);
+
+	if (rc == 0) {
+		rc = gi_byte(&bus, reg);
+	}
+	if (rc == 0) {
+		rc = gi_start(&bus, a, 1);              /* repeated start */
+	}
+	for (uint32_t i = 0; rc == 0 && i < 2; i++) {
+		uint8_t x = 0;
+		bus.sda(bus.ctx, 1);
+		for (unsigned bit = 0; bit < 8; bit++) {
+			rc = gi_high(&bus);
+			if (rc) {
+				break;
+			}
+			x = (uint8_t)((x << 1) | !!bus.get_sda(bus.ctx));
+			gi_low(&bus);
+		}
+		if (rc) {
+			break;
+		}
+		b[i] = x;
+		bus.sda(bus.ctx, i == 1);               /* ACK the first byte, NACK the last */
+		bus.delay(5);
+		rc = gi_high(&bus);
+		gi_low(&bus);
+		bus.sda(bus.ctx, 1);
+	}
+	int stop = gi_stop(&bus);
+	if (rc == 0) {
+		rc = stop;
+	}
+	*v = (uint16_t)(b[0] << 8 | b[1]);
+	return rc;
+}
+
+static int
+i2c_rd(uint8_t a, uint8_t reg, uint16_t *v)
+{
+	int rc = -1;
+
+	for (int t = 0; t < 3 && rc != 0; t++) {
+		rc = i2c_rd_once(a, reg, v);
+		if (rc != 0) {
+			IOSleep(1);
+		}
+	}
+	return rc;
+}
+
+static int writes_logged;
+
+static int
+reg_wr(struct amp *m, uint8_t reg, uint16_t v, const char *what)
+{
+	int rc = i2c_wr(m->addr, reg, v);
+
+	if (logging || rc) {
+		if (writes_logged++ < 400 || rc) {
+			say("%#x W %#04x = %#06x (%s)%s", m->addr, reg, v, what, rc ? " FAILED" : "");
+		}
+	}
+	return rc;
+}
+
+static int
+bf_get(struct amp *m, uint16_t bf, uint16_t *v)
+{
+	uint16_t r;
+	uint32_t pos = (bf >> 4) & 15u, len = (bf & 15u) + 1;
+	int rc = i2c_rd(m->addr, (uint8_t)(bf >> 8), &r);
+
+	*v = rc ? 0 : (uint16_t)((r >> pos) & ((1u << len) - 1));
+	return rc;
+}
+
+/* tfa_set_bf_v6: read, change the field, write when different */
+static int
+bf_set(struct amp *m, uint16_t bf, uint16_t value, const char *what)
+{
+	uint16_t r, n, msk;
+	uint32_t pos = (bf >> 4) & 15u, len = (bf & 15u) + 1;
+	int rc = i2c_rd(m->addr, (uint8_t)(bf >> 8), &r);
+
+	if (rc) {
+		say("%#x read %#04x for %s FAILED (%d)", m->addr, bf >> 8, what, rc);
+		return rc;
+	}
+	msk = (uint16_t)(((1u << len) - 1) << pos);
+	n = (uint16_t)((r & ~msk) | ((uint32_t)value << pos & msk));
+	return n == r ? 0 : reg_wr(m, (uint8_t)(bf >> 8), n, what);
+}
+
+/* ==== pins ==== */
+
+static void
+pin_out(unsigned pin, int high)
+{
+	volatile uint8_t *p = (volatile uint8_t *)pins;
+
+	*(volatile uint32_t *)(p + TFA_PIN_OFF(pin) + 4) = high ? TLMM_OUT : 0;
+	*(volatile uint32_t *)(p + TFA_PIN_OFF(pin)) = TLMM_FUNC(0) | TLMM_DRIVE_MA(2) | TLMM_PULL_NONE | TLMM_OE;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* ==== the container table ==== */
+
+static int
+table_load(void)
+{
+	vm_offset_t h = 0, t = 0;
+	const struct area_entry *e = NULL;
+	uint32_t count;
+	SHA256_CTX ctx;
+	uint8_t digest[32];
+	int err = ENOENT;
+
+	if (kmem_alloc(kernel_map, &h, AREA_HEADER, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	if (negroni_ufs_adsp_area_read(0, (void *)h, AREA_HEADER) != 0 || memcmp((void *)h, "NEGRADSP", 8) != 0) {
+		say("no ADSP firmware area (scripts/audio/mkadsparea.py + dd)");
+		goto out;
+	}
+	memcpy(&count, (uint8_t *)h + 12, 4);
+	for (uint32_t i = 0; i < MIN(count, AREA_MAX); i++) {
+		const struct area_entry *x = (const struct area_entry *)(h + 16 + i * sizeof(struct area_entry));
+		if (strncmp(x->name, TBL_NAME, sizeof(x->name)) == 0) {
+			e = x;
+		}
+	}
+	if (e == NULL || e->size < 16 || e->size > TBL_MAX) {
+		say("no %s in the ADSP area (scripts/audio/tfa-cnt.py bin, then mkadsparea.py)", TBL_NAME);
+		goto out;
+	}
+	if (kmem_alloc(kernel_map, &t, TBL_MAX, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		err = ENOMEM;
+		goto out;
+	}
+	if (negroni_ufs_adsp_area_read(e->offset, (void *)t, e->size) != 0) {
+		say("%s: read failed", TBL_NAME);
+		err = EIO;
+		goto out;
+	}
+	SHA256_Init(&ctx);
+	SHA256_Update(&ctx, (void *)t, e->size);
+	SHA256_Final(digest, &ctx);
+	if (memcmp(digest, e->sha256, 32) != 0) {
+		say("%s: SHA-256 mismatch", TBL_NAME);
+		err = EIO;
+		goto out;
+	}
+	{
+		const uint8_t *b = (const uint8_t *)t;
+		uint32_t ver, np, nr;
+		memcpy(&ver, b + 4, 4);
+		memcpy(&np, b + 8, 4);
+		memcpy(&nr, b + 12, 4);
+		if (memcmp(b, "NTFA", 4) != 0 || ver != 1 || np == 0 || np > TBL_MAX_PROF ||
+		    16 + np * 16 + (uint64_t)nr * sizeof(struct tbl_rec) > e->size) {
+			say("%s: bad header (version %u, %u profiles, %u records)", TBL_NAME, ver, np, nr);
+			err = EINVAL;
+			goto out;
+		}
+		for (uint32_t i = 0; i < np; i++) {
+			memcpy(prof_names[i], b + 16 + i * 16, 16);
+			prof_names[i][15] = 0;
+			if (strcmp(prof_names[i], "speaker") == 0) {
+				prof_speaker = (int)i;
+			} else if (strcmp(prof_names[i], "receiver") == 0) {
+				prof_receiver = (int)i;
+			}
+		}
+		recs = (const struct tbl_rec *)(b + 16 + np * 16);
+		for (uint32_t i = 0; i < nr; i++) {
+			const struct tbl_rec *r = &recs[i];
+			uint8_t reg = r->kind == KIND_BF ? (uint8_t)(r->field >> 8) : r->reg;
+			if ((r->i2c != 0x34 && r->i2c != 0x35) || (r->prof != REC_DEVICE && r->prof >= np) ||
+			    (r->kind != KIND_BF && r->kind != KIND_REG) || reg >= 0xF0 ||
+			    (r->kind == KIND_BF && (r->field == BF_PWDN || r->field == BF_AMPE || r->field == BF_I2CR))) {
+				/* no MTP writes; power state stays ours (only "calibrate.cal" sets AMPE: never used) */
+				if (r->prof == (uint8_t)prof_speaker || r->prof == (uint8_t)prof_receiver || r->prof == REC_DEVICE) {
+					say("%s: record %u (i2c %#x, profile %u, kind %u, reg %#x) refused", TBL_NAME, i, r->i2c,
+					    r->prof, r->kind, reg);
+					err = EINVAL;
+					goto out;
+				}
+			}
+			if (r->kind == KIND_BF && r->field == BF_TDMSPKG && r->prof != REC_DEVICE) {
+				amps[r->i2c - 0x34].spkg_container[r->prof] = r->value;
+			}
+		}
+		/* the device-level TDMSPKG is the profile's value when the profile has none before "default" */
+		for (uint32_t i = 0; i < nr; i++) {
+			const struct tbl_rec *r = &recs[i];
+			if (r->kind == KIND_BF && r->field == BF_TDMSPKG && r->prof == REC_DEVICE) {
+				for (uint32_t p = 0; p < np; p++) {
+					if (amps[r->i2c - 0x34].spkg_container[p] == 0xffff) {
+						amps[r->i2c - 0x34].spkg_container[p] = r->value;
+					}
+				}
+			}
+		}
+		tbl_nprof = np;
+		tbl_nrec = nr;
+	}
+	tbl = (uint8_t *)t;
+	t = 0;
+	err = 0;
+	say("%s: %u profiles, %u register writes; speaker profile %d, receiver profile %d", TBL_NAME, tbl_nprof,
+	    tbl_nrec, prof_speaker, prof_receiver);
+out:
+	if (t) {
+		kmem_free(kernel_map, t, TBL_MAX);
+	}
+	kmem_free(kernel_map, h, AREA_HEADER);
+	return err;
+}
+
+/* ==== probe ==== */
+
+bool
+negroni_tfa_wanted(void)
+{
+	static bool parsed;
+	if (!parsed) {
+		parsed = true;
+		(void)PE_parse_boot_argn("negroniaudio_amp", &amp_on, sizeof(amp_on));
+		(void)PE_parse_boot_argn("negroniaudio_spkg", &spkg_floor, sizeof(spkg_floor));
+		(void)PE_parse_boot_argn("negroniaudio_rcvg", &rcvg_floor, sizeof(rcvg_floor));
+		(void)PE_parse_boot_argn("negroniaudio_amplog", &verbose_starts, sizeof(verbose_starts));
+		/* a floor below the container value is refused at start (the container value is kept, logged) */
+		spkg_floor = MIN(spkg_floor, 15u);
+		rcvg_floor = MIN(rcvg_floor, 15u);
+	}
+	return amp_on != 0;
+}
+
+static const char *
+rev_name(uint16_t rev)
+{
+	switch (rev) {
+	case 0x0a74: return "0x0a74 (initial, table V25)";
+	case 0x0b74: return "0x0b74 (table V1.6)";
+	case 0x0c74: return "0x0c74";
+	default: return "unknown";
+	}
+}
+
+int
+negroni_tfa_probe(void)
+{
+	int found = 0;
+
+	if (!negroni_tfa_wanted()) {
+		return ENODEV;
+	}
+	lck_mtx_lock(&negroni_tfa_lock);
+	if (probed) {
+		lck_mtx_unlock(&negroni_tfa_lock);
+		return 0;
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		for (unsigned p = 0; p < TBL_MAX_PROF; p++) {
+			amps[i].spkg_container[p] = 0xffff;
+		}
+	}
+	say("probe (UNTESTED): pins 48..51 at %#lx, TDMSPKG floors (attenuation) speaker >= %u (%d dB), receiver >= %u "
+	    "(%d dB)", TFA_TLMM_PHYS + TFA_PIN_FIRST * 0x1000, spkg_floor, SPKG_DB(spkg_floor), rcvg_floor, SPKG_DB(rcvg_floor));
+	if (pins == 0) {
+		pins = ml_io_map(TFA_TLMM_PHYS + TFA_PIN_FIRST * 0x1000, 0x4000);      /* one 16 KiB page */
+	}
+	if (pins == 0) {
+		say("no TLMM mapping");
+		lck_mtx_unlock(&negroni_tfa_lock);
+		return ENOMEM;
+	}
+	if (table_load() != 0) {
+		lck_mtx_unlock(&negroni_tfa_lock);
+		return ENOENT;
+	}
+	line.pins = (volatile uint8_t *)pins;            /* SDA = GPIO48 (offset 0), SCL = GPIO49 (0x1000) */
+	tlmm_i2c_init(&bus, &line, tfa_udelay);
+	/* reset pulse on both amps (active-high), as the vendor probe */
+	pin_out(50, 1);
+	pin_out(51, 1);
+	IOSleep(5);
+	pin_out(50, 0);
+	pin_out(51, 0);
+	IOSleep(5);
+	say("reset pulse on GPIO50/51 done; SDA %d SCL %d (1 = released, pull-up)", ti_get_sda(&line) ? 1 : 0,
+	    ti_get_scl(&line) ? 1 : 0);
+	for (unsigned i = 0; i < 2; i++) {
+		struct amp *m = &amps[i];
+		uint16_t rev = 0, r10 = 0, r13 = 0, r14 = 0, mtp = 0, r25 = 0;
+		int rc = -1;
+		for (int t = 0; t < 5 && rc != 0; t++) {   /* the vendor retries the revision read, 2 ms apart */
+			rc = i2c_rd(m->addr, 0x03, &rev);
+			if (rc != 0 || (rev & 0xff) != 0x74) {
+				rc = rc ? rc : -5;
+				IOSleep(2);
+			}
+		}
+		if (rc != 0) {
+			say("%#x %s: no TFA9874 (rc %d, reg 0x03 = %#06x)", m->addr, m->where, rc, rev);
+			continue;
+		}
+		m->rev = rev;
+		(void)i2c_rd(m->addr, 0x10, &r10);
+		(void)i2c_rd(m->addr, 0x13, &r13);
+		(void)i2c_rd(m->addr, 0x14, &r14);
+		(void)i2c_rd(m->addr, 0xF0, &mtp);
+		(void)i2c_rd(m->addr, 0xF5, &r25);
+		say("%#x %s: TFA9874 revision %s; status 0x10 %#06x 0x13 %#06x 0x14 %#06x; MTP 0xF0 %#06x (MTPEX %u), "
+		    "R25C 0xF5 = %u mOhm (DT window 5000..8000) [read only]", m->addr, m->where, rev_name(rev), r10, r13,
+		    r14, mtp, (mtp >> 1) & 1, r25);
+		if (rev != 0x0a74 && rev != 0x0b74 && rev != 0x0c74) {
+			say("%#x: revision %#06x has no vendor init table: this amp will NOT be started", m->addr, rev);
+			continue;
+		}
+		m->present = true;
+		found++;
+	}
+	probed = true;
+	lck_mtx_unlock(&negroni_tfa_lock);
+	say("probe done: %d of 2 amps usable; amps stay in power-down until audio plays", found);
+	return found ? 0 : ENXIO;
+}
+
+/* ==== start / stop ==== */
+
+static int
+rev_table(struct amp *m)
+{
+	static const uint8_t ra[] = { 0x02, 0x51, 0x52, 0x58, 0x61, 0x66, 0x6f, 0x70, 0x73, 0x74, 0x75, 0x83, 0x84, 0x85, 0x88, 0xc4 };
+	static const uint16_t va74[] = { 0x22a8, 0x0020, 0x57dc, 0x16a4, 0x0110, 0x0701, 0x00a3, 0x07f8, 0x0007, 0x5068, 0x0d28, 0x0594, 0x0001, 0x0001, 0x0000, 0x2001 };
+	static const uint16_t vb74[] = { 0x22a8, 0x0020, 0x57dc, 0x16a4, 0x0110, 0x0701, 0x00a3, 0x07f8, 0x0047, 0x5068, 0x0d28, 0x0595, 0x0001, 0x0001, 0x0000, 0x2001 };
+	static const uint8_t rc_[] = { 0x02, 0x52, 0x53, 0x56, 0x61, 0x6f, 0x70, 0x73, 0x74, 0x75, 0x80, 0x83, 0x84 };
+	static const uint16_t vc74[] = { 0x22c8, 0x57dc, 0x003e, 0x0400, 0x0110, 0x00a5, 0x07f8, 0x0047, 0x5098, 0x8d28, 0x0000, 0x0799, 0x0081 };
+	int rc = 0;
+
+	if (m->rev == 0x0a74 || m->rev == 0x0b74) {
+		const uint16_t *v = m->rev == 0x0a74 ? va74 : vb74;
+		for (unsigned i = 0; i < sizeof(ra) && rc == 0; i++) {
+			rc = reg_wr(m, ra[i], v[i], "revision table");
+		}
+	} else {
+		for (unsigned i = 0; i < sizeof(rc_) && rc == 0; i++) {
+			rc = reg_wr(m, rc_[i], vc74[i], "revision table");
+		}
+	}
+	return rc;
+}
+
+/* one container record; TDMSPKG (an attenuation) is held at or above the floor */
+static int
+apply_rec(struct amp *m, const struct tbl_rec *r, uint32_t spkg_min)
+{
+	if (r->kind == KIND_REG) {
+		uint16_t v;
+		int rc = i2c_rd(m->addr, r->reg, &v);
+		if (rc) {
+			return rc;
+		}
+		return reg_wr(m, r->reg, (uint16_t)((v & ~r->mask) | (r->value & r->mask)), "container register");
+	}
+	if (r->field == BF_TDMSPKG && r->value < spkg_min) {
+		if (logging) {
+			say("%#x TDMSPKG %u (%d dB) from the container raised to the floor %u (%d dB)", m->addr, r->value,
+			    SPKG_DB(r->value), spkg_min, SPKG_DB(spkg_min));
+		}
+		return bf_set(m, BF_TDMSPKG, (uint16_t)spkg_min, "TDMSPKG (floor)");
+	}
+	return bf_set(m, r->field, r->value, "container bitfield");
+}
+
+static void
+amp_off(struct amp *m)
+{
+	uint16_t st = 0;
+
+	(void)bf_set(m, BF_PWDN, 1, "PWDN 1 (stop)");
+	(void)bf_set(m, BF_AMPE, 0, "AMPE 0 (stop)");
+	for (int i = 0; i < 20; i++) {                  /* 20 x 5 ms, as the vendor's tfa_dev_stop */
+		if (bf_get(m, BF_MANSTATE, &st) != 0 || st == 0) {
+			break;
+		}
+		IOSleep(5);
+	}
+	m->playing = false;
+}
+
+static int
+amp_start(struct amp *m, int prof, uint32_t spkg_min)
+{
+	uint16_t audfs = 8, fractdel = 0, v, clks = 0, spkg = 0xffff, inplev = 0;
+	int rc;
+	uint32_t n = 0;
+
+	/* 1 */
+	(void)bf_get(m, BF_AUDFS, &audfs);
+	(void)bf_get(m, BF_FRACTDEL, &fractdel);
+	/* 2: I2CR (written without a read: the vendor's TFA_SET_BF_VALUE + TFA_WRITE_REG) */
+	if ((rc = reg_wr(m, 0x00, 1u << 1, "I2CR: registers to POR")) != 0) {
+		return rc;
+	}
+	IOSleep(1);
+	(void)bf_set(m, BF_RST, 1, "RST 1 (tfa98xx_dsp_reset)");
+	/* 3: keys */
+	if ((rc = reg_wr(m, 0x0F, 0x5A6B, "unlock key 1")) != 0 || (rc = i2c_rd(m->addr, 0xFB, &v)) != 0 ||
+	    (rc = reg_wr(m, 0xA0, (uint16_t)(v ^ 0x005A), "key 1 = 0xFB ^ 0x5A")) != 0 ||
+	    (rc = reg_wr(m, 0x0F, 0x5A6B, "key2: unhide")) != 0 || (rc = reg_wr(m, 0xA1, 0x005A, "key2: MTPK unlock")) != 0 ||
+	    (rc = reg_wr(m, 0x0F, 0x0000, "key2: hide")) != 0) {
+		return rc ? rc : EIO;
+	}
+	/* 4 */
+	if ((rc = rev_table(m)) != 0) {
+		return rc;
+	}
+	/* 5 */
+	(void)bf_set(m, BF_AUDFS, audfs, "AUDFS back");
+	(void)bf_set(m, BF_FRACTDEL, fractdel, "FRACTDEL back");
+	/* 6: device items, then the profile items (the table holds only what comes before "default") */
+	for (uint32_t i = 0; i < tbl_nrec; i++) {
+		if (recs[i].i2c == m->addr && recs[i].prof == REC_DEVICE) {
+			if ((rc = apply_rec(m, &recs[i], spkg_min)) != 0) {
+				return rc;
+			}
+			n++;
+		}
+	}
+	for (uint32_t i = 0; i < tbl_nrec; i++) {
+		if (recs[i].i2c == m->addr && recs[i].prof == (uint8_t)prof) {
+			if ((rc = apply_rec(m, &recs[i], spkg_min)) != 0) {
+				return rc;
+			}
+			n++;
+		}
+	}
+	/* the floor also holds when no record sets TDMSPKG (POR value unknown) */
+	if (bf_get(m, BF_TDMSPKG, &spkg) == 0 && spkg < spkg_min) {
+		(void)bf_set(m, BF_TDMSPKG, (uint16_t)spkg_min, "TDMSPKG floor (POR value below it)");
+	}
+	/* 7: INIT_CF */
+	(void)bf_set(m, BF_MANSCONF, 1, "MANSCONF 1 (INIT_CF)");
+	(void)bf_set(m, BF_PWDN, 0, "PWDN 0 (INIT_CF)");
+	for (int i = 0; i < 100; i++) {
+		if (bf_get(m, BF_CLKS, &clks) == 0 && clks) {
+			break;
+		}
+		IOSleep(1);
+	}
+	if (!clks) {
+		say("%#x: no CLKS after 100 ms: no I2S clock reaches the amp (TERT MI2S BCLK/WS on GPIO121/123?)", m->addr);
+		return ENXIO;
+	}
+	/* 8, 9 */
+	(void)bf_set(m, BF_RST, 0, "RST 0 (tfaRunStartDSP)");
+	(void)reg_wr(m, REG_SWPROFIL, (uint16_t)(prof + 1), "SWPROFIL = profile + 1");
+	(void)reg_wr(m, REG_SWVSTEP, 1, "SWVSTEP = vstep 0 + 1");
+	/* the floor, read back, before the amplifier is enabled */
+	if (bf_get(m, BF_TDMSPKG, &spkg) != 0 || spkg < spkg_min) {
+		say("%#x: TDMSPKG read back %u < floor %u (louder than allowed): NOT enabling the amplifier", m->addr, spkg,
+		    spkg_min);
+		return EIO;
+	}
+	(void)bf_get(m, BF_INPLEV, &inplev);
+	/* 10: OPERATING */
+	(void)bf_set(m, BF_PWDN, 0, "PWDN 0 (OPERATING)");
+	(void)bf_set(m, BF_MANSCONF, 1, "MANSCONF 1 (OPERATING)");
+	if ((rc = bf_set(m, BF_AMPE, 1, "AMPE 1 (OPERATING)")) != 0) {
+		return rc;
+	}
+	m->playing = true;
+	{
+		uint16_t r10 = 0, r13 = 0, st = 0;
+		IOSleep(10);
+		(void)i2c_rd(m->addr, 0x10, &r10);       /* the first read clears the sticky bits of the power-up */
+		(void)i2c_rd(m->addr, 0x13, &r13);
+		(void)bf_get(m, BF_MANSTATE, &st);
+		say("%#x %s: AMPE 1, profile \"%s\", %u container writes, TDMSPKG %u = %d dB (container %u, floor %u), INPLEV %u, "
+		    "MANSTATE %u (9 = operating), 0x10 %#06x 0x13 %#06x (normal: 0x0016 / 0x850F)", m->addr, m->where,
+		    prof_names[prof], n, spkg, SPKG_DB(spkg), m->spkg_container[prof], spkg_min, inplev, st, r10, r13);
+	}
+	return 0;
+}
+
+static bool
+fault_latched(void)
+{
+	return fault_until != 0 && mach_absolute_time() < fault_until;
+}
+
+int
+negroni_tfa_start(uint32_t route)
+{
+	int prof, rc = 0;
+	uint32_t spkg_min;
+	bool any = false;
+
+	if (!probed || tbl == NULL) {
+		return ENXIO;
+	}
+	if (route != NEGRONI_TFA_ROUTE_SPEAKER && route != NEGRONI_TFA_ROUTE_RECEIVER) {
+		return EINVAL;
+	}
+	prof = route == NEGRONI_TFA_ROUTE_SPEAKER ? prof_speaker : prof_receiver;
+	spkg_min = route == NEGRONI_TFA_ROUTE_SPEAKER ? spkg_floor : rcvg_floor;
+	if (prof < 0) {
+		say("start: the table has no %s profile", route == NEGRONI_TFA_ROUTE_SPEAKER ? "speaker" : "receiver");
+		return ENOENT;
+	}
+	lck_mtx_lock(&negroni_tfa_lock);
+	if (fault_latched()) {
+		lck_mtx_unlock(&negroni_tfa_lock);
+		return EBUSY;
+	}
+	logging = starts < verbose_starts;
+	writes_logged = 0;
+	starts++;
+	for (unsigned i = 0; i < 2; i++) {
+		struct amp *m = &amps[i];
+		bool wanted = m->present && (route == NEGRONI_TFA_ROUTE_SPEAKER || m->addr == 0x34);
+		uint32_t c = spkg_min;
+		if (m->spkg_container[prof] != 0xffff && c < m->spkg_container[prof]) {
+			if (logging) {
+				say("%#x: TDMSPKG floor %u is below the container's %u: the container value is kept (never louder "
+				    "than the vendor)", m->addr, c, m->spkg_container[prof]);
+			}
+			c = m->spkg_container[prof];                        /* never below the vendor's attenuation */
+		}
+		if (!wanted) {
+			if (m->playing) {
+				amp_off(m);
+			}
+			continue;
+		}
+		say("start %#x %s: route %s, profile \"%s\", TDMSPKG floor %u = %d dB (start %u)", m->addr, m->where,
+		    route == NEGRONI_TFA_ROUTE_SPEAKER ? "speaker" : "earpiece", prof_names[prof], c, SPKG_DB(c), starts);
+		rc = amp_start(m, prof, c);
+		if (rc != 0) {
+			say("start %#x failed (%d): both amps off", m->addr, rc);
+			break;
+		}
+		any = true;
+	}
+	if (rc != 0 || !any) {
+		for (unsigned i = 0; i < 2; i++) {
+			if (amps[i].present) {
+				amp_off(&amps[i]);
+			}
+		}
+		cur_route = NEGRONI_TFA_ROUTE_OFF;
+		rc = rc ? rc : ENXIO;
+	} else {
+		cur_route = route;
+	}
+	logging = false;
+	lck_mtx_unlock(&negroni_tfa_lock);
+	return rc;
+}
+
+void
+negroni_tfa_stop(const char *why)
+{
+	bool was = false;
+
+	if (!probed) {
+		return;
+	}
+	lck_mtx_lock(&negroni_tfa_lock);
+	for (unsigned i = 0; i < 2; i++) {
+		if (amps[i].present && amps[i].playing) {
+			amp_off(&amps[i]);
+			was = true;
+		}
+	}
+	cur_route = NEGRONI_TFA_ROUTE_OFF;
+	lck_mtx_unlock(&negroni_tfa_lock);
+	if (was) {
+		say("amps off: %s", why ? why : "");
+	}
+}
+
+int
+negroni_tfa_check(int log)
+{
+	int bad = 0;
+	char why[96];
+
+	if (!probed) {
+		return 0;
+	}
+	why[0] = 0;
+	lck_mtx_lock(&negroni_tfa_lock);
+	for (unsigned i = 0; i < 2; i++) {
+		struct amp *m = &amps[i];
+		uint16_t r10 = 0, r13 = 0;
+		if (!m->playing) {
+			continue;
+		}
+		if (i2c_rd(m->addr, 0x10, &r10) != 0 || i2c_rd(m->addr, 0x13, &r13) != 0) {
+			snprintf(why, sizeof(why), "%#x: status read failed", m->addr);
+			bad = EIO;
+			break;
+		}
+		if (log) {
+			say("%#x status 0x10 %#06x 0x13 %#06x", m->addr, r10, r13);
+		}
+		if (!(r10 & 1u << 2) || (r10 & 1u << 3) || !(r10 & 1u << 4) || (r10 & 1u << 7) || !(r13 & 1u << 8)) {
+			snprintf(why, sizeof(why), "%#x fault: 0x10 %#06x 0x13 %#06x:%s%s%s%s%s", m->addr, r10, r13,
+			    !(r10 & 1u << 2) ? " OverTemperature" : "", (r10 & 1u << 3) ? " CurrentHigh" : "",
+			    !(r10 & 1u << 4) ? " VbatLow" : "", (r10 & 1u << 7) ? " NoClock" : "",
+			    !(r13 & 1u << 8) ? " VbatHigh" : "");
+			bad = EIO;
+			break;
+		}
+		if (r13 & 1u << 9) {
+			bad = EAGAIN;                   /* clipping: the guard turns down by 1 dB */
+		}
+	}
+	lck_mtx_unlock(&negroni_tfa_lock);
+	if (bad == EIO) {
+		uint64_t ten;
+		faults++;
+		nanoseconds_to_absolutetime(10ull * NSEC_PER_SEC, &ten);
+		fault_until = mach_absolute_time() + ten;
+		say("FAULT %u: %s: amps off, no restart for 10 s", faults, why);
+		negroni_tfa_stop("fault");
+	}
+	return bad;
+}
+
+bool
+negroni_tfa_playing(void)
+{
+	return cur_route != NEGRONI_TFA_ROUTE_OFF;
+}
+
+bool
+negroni_tfa_ready(void)
+{
+	return probed && tbl != NULL && (amps[0].present || amps[1].present) && !fault_latched();
+}
+
+/* panic/halt: other CPUs are stopped; no lock, no sleep. */
+void
+negroni_tfa_panic(void)
+{
+	if (!probed || pins == 0) {
+		return;
+	}
+	for (unsigned i = 0; i < 2; i++) {
+		if (amps[i].present) {
+			(void)gi_stop(&bus);            /* end a transfer that the panic cut */
+			(void)gpio_i2c_write(&bus, amps[i].addr, (const uint8_t[3]){ 0x00, 0x00, 0x01 }, 3);  /* PWDN 1, AMPE 0 */
+		}
+	}
+	pin_out(50, 1);                                 /* reset held: the amps stay off until the next boot */
+	pin_out(51, 1);
+	cur_route = NEGRONI_TFA_ROUTE_OFF;
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_tfa.h b/bsd/dev/negroni_tfa.h
new file mode 100644
index 0000000..7853fcc
--- /dev/null
+++ b/bsd/dev/negroni_tfa.h
@@ -0,0 +1,31 @@
+/*
+ * NEGRONI (SM8450) speaker/earpiece amplifiers: 2x NXP TFA9874 on QUP SE13 (I2C 0x34 = top, the
+ * earpiece/receiver and the left speaker channel; 0x35 = bottom, the right speaker channel), I2S
+ * data on TERT MI2S (negroni_audio.c). iOSPlus10 patch 0244, docs/audio-plan.md stage (c).
+ * UNTESTED ON HARDWARE. Off by default (boot-arg negroniaudio_amp=1).
+ */
+#ifndef _NEGRONI_TFA_H_
+#define _NEGRONI_TFA_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define NEGRONI_TFA_ROUTE_OFF           0u
+#define NEGRONI_TFA_ROUTE_SPEAKER       1u      /* both amps, container profile "speaker" */
+#define NEGRONI_TFA_ROUTE_RECEIVER      2u      /* 0x34 only, container profile "receiver" (the earpiece) */
+
+bool negroni_tfa_wanted(void);                  /* boot-arg negroniaudio_amp=1 */
+/* Pins, the container table (tfa-init.bin in the ADSP area), reset pulse, revision. Amps stay off. */
+int negroni_tfa_probe(void);
+/* Cold start of the route's amps (the I2S clock must run). 0 = playing; amps are off on an error. */
+int negroni_tfa_start(uint32_t route);
+void negroni_tfa_stop(const char *why);         /* AMPE 0, PWDN 1 on every started amp */
+/* Status registers; a fault (over-temperature, over-current, under-voltage, alarm) stops the amps
+ * and blocks a restart for 10 s. 0 = fine or off. log != 0: one line per amp. */
+int negroni_tfa_check(int log);
+bool negroni_tfa_playing(void);
+bool negroni_tfa_ready(void);                   /* probe passed, no fault latch */
+/* Panic/halt: no locks, best effort: AMPE 0 + PWDN 1 over I2C, then the reset pins held high. */
+void negroni_tfa_panic(void);
+
+#endif
diff --git a/bsd/dev/negroni_thermal.c b/bsd/dev/negroni_thermal.c
new file mode 100644
index 0000000..70418bd
--- /dev/null
+++ b/bsd/dev/negroni_thermal.c
@@ -0,0 +1,415 @@
+/*
+ * NEGRONI (SM8450) die temperatures and a simple thermal policy (patch 0280).
+ *
+ * Two TSENS v2 controllers (live DT thermal-sensor@c263000 "tsens0" and @c265000 "tsens1",
+ * compatible "qcom,tsens-v2", 16 sensors each; reg = TM 0x1ff, SROT 0x1ff). Read only: the
+ * sensors run since XBL (SROT CTRL bit 0). TM Sn_STATUS at 0xa0 + 4 * n: bits 11:0 the last
+ * temperature in tenths of a degree C (two's complement), bit 21 valid (Linux
+ * drivers/thermal/qcom/tsens-v2.c, tsens_hw_to_mC). Sensor names from the DT thermal zones.
+ *
+ * A thread samples every second. Once a minute (and on every policy step) it prints
+ *   NEGRONI THERMAL: cpu N C gpu N C ddr N C max N C (name) | gpu cap L cpu cap M MHz
+ * Policy, every 10 s: hottest sensor above negronithermal_hot (70 C): the GPU vote cap goes down
+ * one perf level (patch 0281 reads it, floor level 4 = 350 MHz) and the CPU cap one step
+ * (3200 -> 2400 -> 1800 -> 1400 MHz, negroni_cpufreq_cap, never below the row ABL left);
+ * below negronithermal_cool (60 C): one step back up each. Boot-arg negronithermal=0 turns the
+ * thread off (no readings, no caps).
+ *
+ * Patch 0283 (thermal parity with the DT trips; README-thermal.md "0283"). negronithermal=1 (default)
+ * replaces the one 70/60 C rule with per-zone trips of out/live.dts (thermal-zones), checked every second:
+ *   cpu-110C  any cpu-0-x/cpu-1-x core sensor >= 110 C (cpu4-emerg0-cfg :8042, cpu0-emerg-cfg :8509,
+ *             hysteresis 10 C): Android pauses the core (thermal-pause); we cannot, so the CPU cap goes to
+ *             the deepest row (negroni_cpufreq_cap(0): the ABL row, or the LUT minimum with 0291's
+ *             negronicpufreq_floor=lut).
+ *   gpu-95C   gpuss-0/1 >= 95 C (tj_cfg :8404/:8446, hysteresis 5 C) -> kgsl cooling 0..max (gpu0_cdev
+ *             :8414): the GPU cap goes down one level per second while above, up one per second below 90 C.
+ *   ipa-53C   the OPLUS IPA zone (oplus_thermal_ipa ipa-control-temp 53 C, hysteresis 2 C, :10275) ->
+ *             cpufreq cooling of the three clusters. Its sensor is an OPLUS virtual shell sensor (userspace
+ *             in Android); the proxy here is the skin thermistor pm8350_hot_pocket_therm (0x146) that the
+ *             battery service measures (modes 4/5) [I]. One CPU cap step per 10 s while above, back below 51 C.
+ *   xo-78C / xo-80C  xo-therm (pmk8350_xo_therm, :10087/:10094, hysteresis 8/10 C) -> cpu4/cpu7 freq
+ *             cooling, apc1 pause, gpu state 7 (:10132-10152); 80 C pauses cpu5-7: here both = the deepest CPU
+ *             row and GPU level 5 (421 MHz).
+ *   ddr-90C   ddr sensor >= 90 C (ddr0-config :8812, hysteresis 5 C) -> gold/gold-plus cpufreq cooling
+ *             (:8828): one CPU cap step per 10 s.
+ *   bcl-lvl0/1/2  PM8350B BCL status 0x4708 bits 0/1/2 (bcl_pmic5.c:27,41-43,495-507; the
+ *             pm8350b-bcl-lvlN zones :9602-9764): GPU state 2/4/7 -> level 10/8/5 (734/599/421 MHz),
+ *             cpu5 / cpu6+7 pause -> CPU cap 2400 / 1800 MHz [I: no pause here]; kept 10 s after the bit clears.
+ * The kgsl state k is DT pwrlevel k (818 MHz at 0 ... 220 MHz at 11, live.dts gpu-pwrlevels) = our level
+ * 12 - k (negroni_adreno.c gpu_khz). The GPU floor stays level 4 (350 MHz). The CPU cap is the deepest of
+ * all active trips (3200/2400/1800/1400/deepest). The charger FCC level of 0277 (qcom,thermal-mitigation
+ * 3000/1500/1000/500 mA, :6647; no DT zone uses it: the Android thermal HAL does) is set here [I design]:
+ * skin >= 45 C -> level 3 (1000 mA), ipa-53C or xo-78C -> level 4 (500 mA), back with 2 C hysteresis.
+ * negronithermal=2: the 0280 rule (hottest sensor 70/60 C). negronithermal=0: off (the fallback).
+ * The log line ends with the active trips: "| trip gpu-95C,bcl-lvl0" (or "| trip none").
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <string.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include "negroni_chg_glink.h"     /* 0283: the power hub (skin/XO temperatures) and the charger FCC level */
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void negroni_cpufreq_cap(uint32_t mhz);
+extern int negroni_spmi_read(unsigned sid, unsigned addr, uint8_t *out);       /* 0283: BCL status */
+void negroni_thermal_init(void);
+uint32_t negroni_thermal_gpu_cap(void);
+int negroni_thermal_max_c(void);
+void negroni_thermal_line(char *buf, size_t size);
+
+#define TSENS_N                 2
+#define TSENS_SENSORS           16
+#define TSENS_TM_STATUS         0xa0
+#define TSENS_STATUS_VALID      (1u << 21)
+#define TSENS_SROT_CTRL         0x4
+#define GPU_LEVEL_TOP           12      /* perf-table index of 818 MHz (negroni_adreno.c gpu_khz) */
+#define GPU_LEVEL_FLOOR         4       /* 350 MHz */
+
+static const vm_offset_t tm_phys[TSENS_N] = { 0x0c263000, 0x0c265000 };
+static const vm_offset_t srot_phys[TSENS_N] = { 0x0c222000, 0x0c223000 };
+static const char *const sensor_name[TSENS_N][TSENS_SENSORS] = {
+	{ "aoss-0", "cpuss-0", "cpuss-1", "cpuss-2", "cpuss-3", "cpu-1-0", "cpu-1-1", "cpu-1-2", "cpu-1-3",
+	  "cpu-1-4", "cpu-1-5", "cpu-1-6", "cpu-1-7", "cpu-1-8", "gpuss-0", "gpuss-1" },
+	{ "aoss-1", "cpu-0-0", "cpu-0-1", "cpu-0-2", "cpu-0-3", "nspss-0", "nspss-1", "nspss-2", "video",
+	  "ddr", "mdmss-0", "mdmss-1", "mdmss-2", "mdmss-3", "camera-0", "camera-1" },
+};
+/* 0283: 0 = the deepest row negroni_cpufreq_cap allows (ABL row, or the LUT minimum with 0291 lut) */
+static const uint32_t cpu_steps_mhz[] = { 3200, 2400, 1800, 1400, 0 };
+#define CPU_STEPS_LEGACY        4       /* the 0280 rule uses the first four */
+#define CPU_STEP_DEEPEST        4
+
+static vm_offset_t tm_base[TSENS_N];
+static uint32_t hot_c = 70, cool_c = 60, mode = 1;
+static volatile uint32_t gpu_cap = GPU_LEVEL_TOP;
+static volatile int max_c_now = -1000;
+static unsigned cpu_step;               /* index into cpu_steps_mhz */
+static char line[256];
+
+/* 0283: the DT trips (names for the log) */
+enum { T_CPU110, T_GPU95, T_IPA53, T_XO78, T_XO80, T_DDR90, T_BCL0, T_BCL1, T_BCL2, T_N };
+static const char *const trip_name[T_N] = { "cpu-110C", "gpu-95C", "ipa-53C", "xo-78C", "xo-80C", "ddr-90C",
+	                                    "bcl-lvl0", "bcl-lvl1", "bcl-lvl2" };
+static bool trip_on[T_N];
+static uint32_t gpu95_level = GPU_LEVEL_TOP;    /* the stepping cap of gpu-95C */
+static unsigned ipa_step, ddr_step;             /* CPU cap steps of ipa-53C / ddr-90C (0..CPU_STEP_DEEPEST) */
+static uint32_t bcl_clear_tick[3];              /* tick when the BCL bit went clear (hold 10 s) */
+static unsigned chg_level;                      /* the charger FCC level sent to 0277 */
+static bool chg_skin_on;
+#define BCL_STATUS_ADDR         0x4708u /* PM8350B BCL 0x4700 + BCL_IRQ_STATUS 0x08 (bcl_pmic5.c:27) */
+#define BCL_HOLD_S              10
+#define GPU_LEVEL_XO            5       /* kgsl state 7 (live.dts:10152) = 12 - 7 */
+static const uint32_t gpu_level_bcl[3] = { 10, 8, 5 };  /* kgsl state 2/4/7 (:9656, :9717, :9758) */
+static const unsigned cpu_step_bcl[3] = { 1, 2, 2 };    /* 2400 / 1800 / 1800 MHz [I: Android pauses cpu5, cpu6-7] */
+
+/* tenths of a degree C, or -10000 when the sensor has no valid value */
+static int
+read_sensor(unsigned t, unsigned n)
+{
+	uint32_t s = *(volatile uint32_t *)(tm_base[t] + TSENS_TM_STATUS + 4 * n);
+	if (!(s & TSENS_STATUS_VALID)) {
+		return -10000;
+	}
+	int v = (int)(s & 0xfff);
+	return v & 0x800 ? v - 0x1000 : v;
+}
+
+uint32_t
+negroni_thermal_gpu_cap(void)
+{
+	return gpu_cap;
+}
+
+int
+negroni_thermal_max_c(void)
+{
+	return max_c_now;
+}
+
+void
+negroni_thermal_line(char *buf, size_t size)
+{
+	strlcpy(buf, line, size);
+}
+
+/* 0283: one trip with hysteresis (tenths or hundredths, the caller's unit). True on a change. */
+static bool
+trip_set(unsigned i, bool known, int v, int on_at, int off_below)
+{
+	bool was = trip_on[i];
+	if (!known) {
+		trip_on[i] = false;
+	} else if (v >= on_at) {
+		trip_on[i] = true;
+	} else if (v < off_below) {
+		trip_on[i] = false;
+	}
+	if (trip_on[i] != was) {
+		printf("NEGRONI THERMAL: trip %s %s (value %d, on at %d, off below %d)\n", trip_name[i], trip_on[i] ? "ON" : "off", v,
+		    on_at, off_below);
+		return true;
+	}
+	return false;
+}
+
+/* 0283: the per-zone policy, every second. cpu/gpu/ddr in tenths of a degree (-10000 = none). True on a change. */
+static bool
+policy_0283(uint32_t tick, int cpu, int gpu, int ddr)
+{
+	bool changed = false;
+	int32_t skin = 0, xo = 0;
+	bool skinOk = negroni_pwr_temp_get(NEGRONI_PWR_T_SKIN, &skin, 60000);
+	bool xoOk = negroni_pwr_temp_get(NEGRONI_PWR_T_XO, &xo, 60000);
+
+	changed |= trip_set(T_CPU110, cpu != -10000, cpu, 1100, 1000);
+	changed |= trip_set(T_GPU95, gpu != -10000, gpu, 950, 900);
+	changed |= trip_set(T_IPA53, skinOk, skin, 5300, 5100);
+	changed |= trip_set(T_XO78, xoOk, xo, 7800, 7000);
+	changed |= trip_set(T_XO80, xoOk, xo, 8000, 7000);
+	changed |= trip_set(T_DDR90, ddr != -10000, ddr, 900, 850);
+	/* BCL levels: the status bits, kept BCL_HOLD_S after they clear */
+	uint8_t bcl = 0;
+	bool bclOk = negroni_spmi_read(3, BCL_STATUS_ADDR, &bcl) == 0;
+	for (unsigned k = 0; k < 3; k++) {
+		bool bit = bclOk && (bcl & (1u << k));
+		bool was = trip_on[T_BCL0 + k];
+		if (bit) {
+			trip_on[T_BCL0 + k] = true;
+			bcl_clear_tick[k] = 0;
+		} else if (was) {
+			if (bcl_clear_tick[k] == 0) {
+				bcl_clear_tick[k] = tick;
+			} else if (tick - bcl_clear_tick[k] >= BCL_HOLD_S) {
+				trip_on[T_BCL0 + k] = false;
+				bcl_clear_tick[k] = 0;
+			}
+		}
+		if (trip_on[T_BCL0 + k] != was) {
+			printf("NEGRONI THERMAL: trip %s %s (BCL status 0x4708 = %#x)\n", trip_name[T_BCL0 + k],
+			    trip_on[T_BCL0 + k] ? "ON" : "off", bcl);
+			changed = true;
+		}
+	}
+	/* gpu-95C: step_wise, one level a second */
+	if (trip_on[T_GPU95]) {
+		if (gpu95_level > GPU_LEVEL_FLOOR) {
+			gpu95_level--;
+		}
+	} else if (gpu < 900 && gpu95_level < GPU_LEVEL_TOP) {
+		gpu95_level++;
+	}
+	/* ipa-53C and ddr-90C: one CPU cap step per 10 s */
+	if (tick % 10 == 0) {
+		if (trip_on[T_IPA53]) {
+			ipa_step += ipa_step < CPU_STEP_DEEPEST;
+		} else if (ipa_step) {
+			ipa_step--;
+		}
+		if (trip_on[T_DDR90]) {
+			ddr_step += ddr_step < CPU_STEP_DEEPEST;
+		} else if (ddr_step) {
+			ddr_step--;
+		}
+	}
+	/* the caps: the deepest of all */
+	uint32_t g = gpu95_level;
+	unsigned c = ipa_step > ddr_step ? ipa_step : ddr_step;
+	if (trip_on[T_XO78] || trip_on[T_XO80]) {
+		g = MIN(g, GPU_LEVEL_XO);
+		c = CPU_STEP_DEEPEST;
+	}
+	if (trip_on[T_CPU110]) {
+		c = CPU_STEP_DEEPEST;
+	}
+	for (unsigned k = 0; k < 3; k++) {
+		if (trip_on[T_BCL0 + k]) {
+			g = MIN(g, gpu_level_bcl[k]);
+			c = MAX(c, cpu_step_bcl[k]);
+		}
+	}
+	if (g < GPU_LEVEL_FLOOR) {
+		g = GPU_LEVEL_FLOOR;
+	}
+	if (g != gpu_cap) {
+		gpu_cap = g;
+		changed = true;
+	}
+	if (c != cpu_step) {
+		cpu_step = c;
+		negroni_cpufreq_cap(cpu_steps_mhz[cpu_step]);
+		changed = true;
+	}
+	/* the charger FCC level (0277) [I design]: skin 45 C -> 1000 mA, ipa-53C or xo-78C -> 500 mA */
+	if (skinOk && skin >= 4500) {
+		chg_skin_on = true;
+	} else if (!skinOk || skin < 4300) {
+		chg_skin_on = false;
+	}
+	unsigned lvl = (trip_on[T_IPA53] || trip_on[T_XO78] || trip_on[T_XO80]) ? 4 : chg_skin_on ? 3 : 0;
+	if (lvl != chg_level) {
+		chg_level = lvl;
+		negroni_chg_glink_set_thermal_level(lvl);
+		changed = true;
+	}
+	return changed;
+}
+
+__attribute__((noreturn)) static void
+thermal_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t tick = 0;
+
+	for (;;) {
+		assert_wait_timeout((event_t)&tick, THREAD_UNINT, 1000, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		tick++;
+		int cpu = -10000, gpu = -10000, ddr = -10000, max = -10000, cpuss = -10000;
+		const char *max_name = "none";
+		unsigned valid = 0;
+		for (unsigned t = 0; t < TSENS_N; t++) {
+			if (!tm_base[t]) {
+				continue;       /* 0283: a controller that is not mapped or not enabled has no sensors */
+			}
+			for (unsigned n = 0; n < TSENS_SENSORS; n++) {
+				int v = read_sensor(t, n);
+				if (v == -10000) {
+					continue;
+				}
+				valid++;
+				const char *name = sensor_name[t][n];
+				if (strncmp(name, "cpu-", 4) == 0 && v > cpu) {
+					cpu = v;        /* 0283: the core sensors only (cpu-0-x, cpu-1-x) */
+				} else if (strncmp(name, "cpuss", 5) == 0 && v > cpuss) {
+					cpuss = v;
+				} else if (strncmp(name, "gpuss", 5) == 0 && v > gpu) {
+					gpu = v;
+				} else if (strcmp(name, "ddr") == 0) {
+					ddr = v;
+				}
+				if (v > max) {
+					max = v;
+					max_name = name;
+				}
+			}
+		}
+		max_c_now = max == -10000 ? -1000 : max / 10;
+		bool step = false;
+		if (mode == 1) {
+			step = policy_0283(tick, cpu, gpu, ddr);
+		} else if (tick % 10 == 0 && max != -10000) {
+			if (max >= (int)hot_c * 10) {
+				if (gpu_cap > GPU_LEVEL_FLOOR) {
+					gpu_cap--;
+					step = true;
+				}
+				if (cpu_step + 1 < CPU_STEPS_LEGACY) {
+					cpu_step++;
+					negroni_cpufreq_cap(cpu_steps_mhz[cpu_step]);
+					step = true;
+				}
+			} else if (max < (int)cool_c * 10) {
+				if (gpu_cap < GPU_LEVEL_TOP) {
+					gpu_cap++;
+					step = true;
+				}
+				if (cpu_step > 0) {
+					cpu_step--;
+					negroni_cpufreq_cap(cpu_steps_mhz[cpu_step]);
+					step = true;
+				}
+			}
+		}
+		/* 0283: + cpuss, skin and xo, the charger level and the active trips */
+		char trips[96];
+		size_t ta = 0;
+		trips[0] = 0;
+		for (unsigned i = 0; i < T_N && mode == 1; i++) {
+			if (trip_on[i]) {
+				ta += snprintf(trips + ta, sizeof(trips) - ta, "%s%s", ta ? "," : "", trip_name[i]);
+			}
+		}
+		int32_t skin = 0, xo = 0;
+		bool skinOk = negroni_pwr_temp_get(NEGRONI_PWR_T_SKIN, &skin, 60000), xoOk = negroni_pwr_temp_get(NEGRONI_PWR_T_XO, &xo, 60000);
+		char cap[16];
+		if (cpu_steps_mhz[cpu_step]) {
+			snprintf(cap, sizeof(cap), "%u MHz", cpu_steps_mhz[cpu_step]);
+		} else {
+			snprintf(cap, sizeof(cap), "deepest");
+		}
+		snprintf(line, sizeof(line), "cpu %d C cpuss %d C gpu %d C ddr %d C skin %s%d C xo %s%d C max %d C (%s) | gpu cap %u "
+		    "cpu cap %s chg lvl %u | trip %s",
+		    cpu / 10, cpuss / 10, gpu / 10, ddr / 10, skinOk ? "" : "?", skin / 100, xoOk ? "" : "?", xo / 100, max / 10,
+		    max_name, gpu_cap, cap, chg_level, mode != 1 ? "legacy-70C" : ta ? trips : "none");
+		if (tick == 1 || tick % 60 == 0 || step) {
+			printf("NEGRONI THERMAL: %s%s (%u of 32 sensors valid)\n", line, step ? " [step]" : "", valid);
+		}
+		if (tick == 1) {
+			/* the full list once, for the record */
+			for (unsigned t = 0; t < TSENS_N; t++) {
+				char all[256];
+				size_t at = 0;
+				if (!tm_base[t]) {
+					continue;       /* 0283 */
+				}
+				for (unsigned n = 0; n < TSENS_SENSORS && at < sizeof(all) - 16; n++) {
+					int v = read_sensor(t, n);
+					at += snprintf(all + at, sizeof(all) - at, " %s=%d", sensor_name[t][n], v == -10000 ? -999 : v / 10);
+				}
+				printf("NEGRONI THERMAL: tsens%u:%s\n", t, all);
+			}
+		}
+	}
+}
+
+void
+negroni_thermal_init(void)
+{
+	uint32_t enabled = 1;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("negronithermal", &enabled, sizeof(enabled));
+	mode = enabled == 2 ? 2 : 1;            /* 0283: 1 = the DT trips, 2 = the 0280 70/60 C rule */
+	(void)PE_parse_boot_argn("negronithermal_hot", &hot_c, sizeof(hot_c));
+	(void)PE_parse_boot_argn("negronithermal_cool", &cool_c, sizeof(cool_c));
+	if (!enabled) {
+		printf("NEGRONI THERMAL: off (negronithermal=0)\n");
+		return;
+	}
+	if (cool_c >= hot_c) {
+		cool_c = hot_c > 10 ? hot_c - 10 : 0;
+	}
+	for (unsigned t = 0; t < TSENS_N; t++) {
+		vm_offset_t srot = ml_io_map(srot_phys[t], 0x1000);
+		tm_base[t] = ml_io_map(tm_phys[t], 0x1000);
+		if (!tm_base[t] || !srot) {
+			printf("NEGRONI THERMAL: tsens%u not mapped\n", t);
+			tm_base[t] = 0;
+			continue;
+		}
+		uint32_t ver = *(volatile uint32_t *)srot, ctrl = *(volatile uint32_t *)(srot + TSENS_SROT_CTRL);
+		printf("NEGRONI THERMAL: tsens%u TM %#lx: SROT version %#x ctrl %#x (%s)\n", t, (unsigned long)tm_phys[t],
+		    ver, ctrl, (ctrl & 1) ? "enabled" : "DISABLED: no readings");
+		if (!(ctrl & 1)) {
+			tm_base[t] = 0;
+		}
+	}
+	if (!tm_base[0] && !tm_base[1]) {
+		return;
+	}
+	if (mode == 1) {
+		printf("NEGRONI THERMAL: policy DT trips (0283): cpu-110C, gpu-95C, ipa-53C (skin proxy), xo-78C/80C, ddr-90C, "
+		    "bcl-lvl0..2; GPU cap levels %u..%u, CPU caps 3200/2400/1800/1400 MHz/deepest; charger FCC levels 3/4 "
+		    "(negronithermal=2: the 0280 rule)\n", GPU_LEVEL_FLOOR, GPU_LEVEL_TOP);
+	} else {
+		printf("NEGRONI THERMAL: policy hot %u C cool %u C, GPU cap levels %u..%u, CPU caps 3200/2400/1800/1400 MHz "
+		    "(negronithermal=2: the 0280 rule)\n", hot_c, cool_c, GPU_LEVEL_FLOOR, GPU_LEVEL_TOP);
+	}
+	if (kernel_thread_start(thermal_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_touch.c b/bsd/dev/negroni_touch.c
new file mode 100644
index 0000000..6c1f52b
--- /dev/null
+++ b/bsd/dev/negroni_touch.c
@@ -0,0 +1,243 @@
+/*
+ * NEGRONI Synaptics S3908 (TouchComm, I2C 0x4b) touch.
+ * QUP0 SE4 has its FIFO disabled (GPI only, DMA block secure-locked), so the
+ * bus is open-drain GPIO16/17 I2C, the same code as Mu's NegroniTouchDxe
+ * (bsd/dev/negroni_touch/ = ios-sweet drivers/negroni-touch). Mu powers the
+ * panel (L6C, L3C, 1.8 V switch) and leaves it on; this thread polls ATTN
+ * (GPIO21, active low) every 10 ms and reports fingers to NegroniHIDTouch.
+ * Call once after the scheduler is running.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+#include "negroni_touch/tlmm_i2c.h"
+#include "negroni_touch/syna_tcm.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern void IOSleep(unsigned int milliseconds);
+extern void negroni_hid_touch(int finger, int down, int x, int y);
+extern void negroni_fp_touch(int finger, int down, int x, int y);   /* 0354: NegroniFramebuffer.cpp, fingerprint overlay */
+void negroni_touch_init(void);
+
+/* TLMM pages of GPIO16..23: SDA 16, SCL 17, reset 20, ATTN 21 */
+#define TOUCH_PINS_PA   (TLMM_BASE + TLMM_CTL(NT_PIN_I2C_SDA))
+#define TOUCH_PINS_LEN  0x8000u
+#define TOUCH_PIN(n)    ((uint32_t)((n) - NT_PIN_I2C_SDA) * 0x1000u)
+#define S3908_ADDR      0x4b
+/* panel (5760x12864, touchpanel,panel-coords) to display pixels */
+#define TOUCH_W         1080
+#define TOUCH_H         2412
+
+static struct {
+	bool started;
+	int log;
+	vm_offset_t pins;
+	struct tlmm_i2c line;
+	struct gpio_i2c bus;
+	struct tcm tcm;
+	uint32_t active;
+	int x[TCM_MAX_OBJECTS], y[TCM_MAX_OBJECTS];
+} st;
+
+static void
+touch_udelay(unsigned us)
+{
+	delay((int)us);
+}
+
+static void
+touch_wait_1ms(void)
+{
+	IOSleep(1);
+}
+
+static int
+touch_attn(void)
+{
+	return (int)(*(volatile uint32_t *)(st.pins + TOUCH_PIN(NT_PIN_IRQ) + 4) & TLMM_IN);
+}
+
+static int
+touch_i2c_read(void *ctx, uint8_t *buf, uint32_t len)
+{
+	return gpio_i2c_read(ctx, S3908_ADDR, buf, len);
+}
+
+static int
+touch_i2c_write(void *ctx, const uint8_t *buf, uint32_t len)
+{
+	return gpio_i2c_write(ctx, S3908_ADDR, buf, len);
+}
+
+static void
+touch_report(void)
+{
+	uint32_t mask = 0;
+
+	for (unsigned id = 0; id < TCM_MAX_OBJECTS; ++id) {
+		const struct tcm_object *o = &st.tcm.obj[id];
+		uint32_t bit = 1u << id;
+
+		if (o->status == 0) {
+			continue;
+		}
+		int x = (int)((uint64_t)MIN(o->x, TCM_PANEL_MAX_X - 1) * TOUCH_W / TCM_PANEL_MAX_X);
+		int y = (int)((uint64_t)MIN(o->y, TCM_PANEL_MAX_Y - 1) * TOUCH_H / TCM_PANEL_MAX_Y);
+		mask |= bit;
+		if (!(st.active & bit) || x != st.x[id] || y != st.y[id]) {
+			negroni_hid_touch((int)id, 1, x, y);
+			negroni_fp_touch((int)id, 1, x, y);
+			if (st.log && !(st.active & bit)) {
+				printf("NEGRONI TOUCH: finger %u down %d,%d\n", id, x, y);
+			}
+		}
+		st.x[id] = x;
+		st.y[id] = y;
+	}
+	for (unsigned id = 0; id < TCM_MAX_OBJECTS; ++id) {
+		uint32_t bit = 1u << id;
+		if ((st.active & bit) && !(mask & bit)) {
+			negroni_hid_touch((int)id, 0, st.x[id], st.y[id]);
+			negroni_fp_touch((int)id, 0, st.x[id], st.y[id]);
+		}
+	}
+	st.active = mask;
+}
+
+static void
+touch_release_all(void)
+{
+	for (unsigned id = 0; id < TCM_MAX_OBJECTS; ++id) {
+		st.tcm.obj[id].status = 0;
+	}
+	touch_report();
+}
+
+/* Drain pending messages (identify after reset, stale reports), then read the report config. */
+static int
+touch_setup(void)
+{
+	int rc = 1;
+
+	for (int i = 0; i < 50 && !touch_attn(); i++) {
+		rc = tcm_read_message(&st.tcm);
+		if (rc < 0) {
+			break;
+		}
+	}
+	printf("NEGRONI TOUCH: drain rc=%d code=%#x hdr %02x %02x %02x %02x bus=%d attn=%d\n",
+	    rc, st.tcm.code, st.tcm.header[0], st.tcm.header[1], st.tcm.header[2],
+	    st.tcm.header[3], st.tcm.transport_error, touch_attn());
+	rc = tcm_get_report_config(&st.tcm, touch_wait_1ms);
+	printf("NEGRONI TOUCH: report config rc=%d len=%u bus=%d\n",
+	    rc, st.tcm.config_len, st.tcm.transport_error);
+	return rc;
+}
+
+/*
+ * 0382 (README-power-idle.md): the ATTN poll is 10 ms; with the display asleep and no finger down it is
+ * negronitouch_dark_ms (default 50; 10 = as before). ATTN is a level (low until the report is read),
+ * so a slower poll only delays a report, it does not lose one.
+ */
+extern int negroni_display_asleep;      /* NegroniFramebuffer.cpp */
+static uint32_t touch_dark_ms = 50;
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 5;
+	(void)arg;
+	(void)result;
+
+	(void)PE_parse_boot_argn("negronitouchdelay", &delay_s, sizeof(delay_s));
+	printf("NEGRONI TOUCH: S3908 over GPIO I2C, starting in %u s\n", delay_s);
+	IOSleep(delay_s * 1000u);
+	st.pins = ml_io_map(TOUCH_PINS_PA, TOUCH_PINS_LEN);
+	if (!st.pins) {
+		printf("NEGRONI TOUCH: TLMM mapping failed\n");
+		goto out;
+	}
+	st.line.pins = (volatile uint8_t *)st.pins;
+	tlmm_i2c_init(&st.bus, &st.line, touch_udelay);
+	st.tcm.io.ctx = &st.bus;
+	st.tcm.io.read = touch_i2c_read;
+	st.tcm.io.write = touch_i2c_write;
+	printf("NEGRONI TOUCH: reset=%d attn=%d sda=%d scl=%d (Mu leaves the panel powered)\n",
+	    (int)((*(volatile uint32_t *)(st.pins + TOUCH_PIN(NT_PIN_RESET) + 4) >> 1) & 1),
+	    touch_attn(), ti_get_sda(&st.line), ti_get_scl(&st.line));
+
+	if (touch_setup()) {
+		/* Reset the IC (reset low 10 ms, firmware boot 200 ms) and try once more. */
+		volatile uint32_t *rst = (volatile uint32_t *)(st.pins + TOUCH_PIN(NT_PIN_RESET) + 4);
+		*rst = 0;
+		IOSleep(10);
+		*rst = TLMM_OUT;
+		IOSleep(200);
+		if (touch_setup()) {
+			printf("NEGRONI TOUCH: no report config; stopping\n");
+			goto out;
+		}
+	}
+	printf("NEGRONI TOUCH: running, %ux%u -> %ux%u, poll 10 ms on ATTN\n",
+	    TCM_PANEL_MAX_X, TCM_PANEL_MAX_Y, TOUCH_W, TOUCH_H);
+
+	unsigned errors = 0;
+	for (;;) {
+		for (int n = 0; n < 4 && !touch_attn(); n++) {
+			int rc = tcm_read_message(&st.tcm);
+			if (rc < 0) {
+				if ((errors++ % 100u) == 0) {
+					printf("NEGRONI TOUCH: read rc=%d bus=%d\n", rc, st.tcm.transport_error);
+				}
+				if (errors == 10) {
+					touch_release_all();
+				}
+				break;
+			}
+			errors = 0;
+			if (rc == 0 && st.tcm.code == TCM_REPORT_TOUCH && tcm_parse_touch(&st.tcm) == 0) {
+				touch_report();
+			}
+		}
+		IOSleep(st.active == 0 && __atomic_load_n(&negroni_display_asleep, __ATOMIC_ACQUIRE) ? touch_dark_ms : 10);
+	}
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+negroni_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (st.started) {
+		return;
+	}
+	st.started = true;
+	(void)PE_parse_boot_argn("negronitouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("negronitouchlog", &st.log, sizeof(st.log));
+	(void)PE_parse_boot_argn("negronitouch_dark_ms", &touch_dark_ms, sizeof(touch_dark_ms));
+	if (touch_dark_ms < 10 || touch_dark_ms > 200) {
+		touch_dark_ms = touch_dark_ms < 10 ? 10 : 200;
+	}
+	if (!enabled) {
+		printf("NEGRONI TOUCH: disabled (negronitouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("NEGRONI TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_touch/gpio_i2c.h b/bsd/dev/negroni_touch/gpio_i2c.h
new file mode 100755
index 0000000..5fc2528
--- /dev/null
+++ b/bsd/dev/negroni_touch/gpio_i2c.h
@@ -0,0 +1,100 @@
+/* Polled open-drain I2C fallback; 5 us half-period, bounded clock stretching.
+ * Line callbacks release the pin for 1 and drive only LOW for 0.
+ * Caller owns the bus and serializes transfers. No GENI/GPI accesses.
+ */
+#ifndef NEGRONI_GPIO_I2C_H
+#define NEGRONI_GPIO_I2C_H
+#include <stdint.h>
+struct gpio_i2c {
+    void *ctx;
+    void (*sda)(void *, int);
+    void (*scl)(void *, int);
+    int (*get_sda)(void *);
+    int (*get_scl)(void *);
+    void (*delay)(unsigned);
+};
+/* Same transport codes as geni_i2c: -2 NACK, -3 bus busy, -4 timeout. */
+static inline int gi_high(struct gpio_i2c *g)
+{
+    g->scl(g->ctx, 1);
+    for (unsigned n = 0; n < 1000; n++) {
+        if (g->get_scl(g->ctx)) { g->delay(5); return 0; }
+        g->delay(1);
+    }
+    return -4;
+}
+static inline void gi_low(struct gpio_i2c *g)
+{
+    g->scl(g->ctx, 0);
+    g->delay(5);
+}
+static inline int gi_stop(struct gpio_i2c *g)
+{
+    gi_low(g);
+    g->sda(g->ctx, 0);
+    g->delay(5);
+    int rc = gi_high(g);
+    g->sda(g->ctx, 1);
+    g->delay(5);
+    return rc;
+}
+static inline int gi_byte(struct gpio_i2c *g, uint8_t v)
+{
+    for (unsigned i = 0; i < 8; i++) {
+        g->sda(g->ctx, (v & 0x80) != 0);
+        g->delay(5);
+        int rc = gi_high(g);
+        if (rc) return rc;
+        gi_low(g);
+        v <<= 1;
+    }
+    g->sda(g->ctx, 1);
+    g->delay(5);
+    int rc = gi_high(g);
+    if (rc) return rc;
+    int nack = g->get_sda(g->ctx);
+    gi_low(g);
+    return nack ? -2 : 0;
+}
+static inline int gi_start(struct gpio_i2c *g, uint8_t addr, int read)
+{
+    g->sda(g->ctx, 1);
+    int rc = gi_high(g);
+    if (rc) return rc;
+    if (!g->get_sda(g->ctx)) return -3;
+    g->sda(g->ctx, 0);
+    g->delay(5);
+    gi_low(g);
+    return gi_byte(g, (uint8_t)((addr << 1) | read));
+}
+static inline int gpio_i2c_write(struct gpio_i2c *g, uint8_t addr, const uint8_t *buf, uint32_t len)
+{
+    int rc = gi_start(g, addr, 0);
+    for (uint32_t i = 0; !rc && i < len; i++) rc = gi_byte(g, buf[i]);
+    int stop = gi_stop(g);
+    return rc ? rc : stop;
+}
+static inline int gpio_i2c_read(struct gpio_i2c *g, uint8_t addr, uint8_t *buf, uint32_t len)
+{
+    int rc = gi_start(g, addr, 1);
+    for (uint32_t i = 0; !rc && i < len; i++) {
+        uint8_t v = 0;
+        g->sda(g->ctx, 1);
+        for (unsigned bit = 0; bit < 8; bit++) {
+            rc = gi_high(g);
+            if (rc) break;
+            v = (uint8_t)((v << 1) | !!g->get_sda(g->ctx));
+            gi_low(g);
+        }
+        if (rc) break;
+        buf[i] = v;
+        g->sda(g->ctx, i + 1 == len); /* ACK each byte except the last. */
+        g->delay(5);
+        rc = gi_high(g);
+        gi_low(g);
+        g->sda(g->ctx, 1);
+    }
+    int stop = gi_stop(g);
+    return rc ? rc : stop;
+}
+#endif
diff --git a/bsd/dev/negroni_touch/syna_tcm.h b/bsd/dev/negroni_touch/syna_tcm.h
new file mode 100755
index 0000000..27ca6a3
--- /dev/null
+++ b/bsd/dev/negroni_touch/syna_tcm.h
@@ -0,0 +1,262 @@
+/*
+ * Synaptics TouchComm (TCM v1) host side for the negroni S3908, OS independent.
+ *
+ * From the OPLUS driver in the XEC negroni tree (476a4a8,
+ * drivers/input/touchscreen/synaptics_tcm_oncell.{c,h}):
+ *   read:  4-byte header {0xA5, code, len_lo, len_hi}; when len > 0 a second
+ *          read of len + 3 bytes {0xA5, 0x03 (continued read), payload, 0x5A}
+ *   write: {command, len_lo, len_hi, payload...}
+ *   touch report 0x11 is a bit stream described by the touch report config
+ *   (command 0x25), parsed like syna_parse_report().
+ *
+ * The transport is the caller's: tcm_io.read/write move whole I2C messages.
+ */
+#ifndef NEGRONI_SYNA_TCM_H
+#define NEGRONI_SYNA_TCM_H
+
+#include <stdint.h>
+
+#define TCM_MARKER			0xA5
+#define TCM_PADDING			0x5A
+#define TCM_STATUS_IDLE			0x00
+#define TCM_STATUS_OK			0x01
+#define TCM_STATUS_BUSY			0x02
+#define TCM_STATUS_CONTINUED_READ	0x03
+#define TCM_REPORT_IDENTIFY		0x10
+#define TCM_REPORT_TOUCH		0x11
+#define TCM_CMD_GET_TOUCH_REPORT_CONFIG	0x25
+
+#define TCM_MAX_OBJECTS			10
+#define TCM_MAX_PAYLOAD			512
+#define TCM_MAX_CONFIG			256
+
+/* touch report config codes (enum touch_report_code) */
+enum {
+	TCM_TOUCH_END = 0,
+	TCM_TOUCH_FOREACH_ACTIVE_OBJECT,
+	TCM_TOUCH_FOREACH_OBJECT,
+	TCM_TOUCH_FOREACH_END,
+	TCM_TOUCH_PAD_TO_NEXT_BYTE,
+	TCM_TOUCH_TIMESTAMP,
+	TCM_TOUCH_OBJECT_N_INDEX,
+	TCM_TOUCH_OBJECT_N_CLASSIFICATION,
+	TCM_TOUCH_OBJECT_N_X_POSITION,
+	TCM_TOUCH_OBJECT_N_Y_POSITION,
+	TCM_TOUCH_OBJECT_N_Z,
+	TCM_TOUCH_NUM_OF_ACTIVE_OBJECTS = 24,
+};
+
+/* negroni DT: touchpanel,panel-coords = <5760 12864>, display-coords = <1440 3216> */
+#define TCM_PANEL_MAX_X			5760
+#define TCM_PANEL_MAX_Y			12864
+
+struct tcm_io {
+	void *ctx;
+	int (*read)(void *ctx, uint8_t *buf, uint32_t len);		/* 0 = ok */
+	int (*write)(void *ctx, const uint8_t *buf, uint32_t len);
+};
+
+struct tcm_object {
+	uint8_t status;		/* classification: 0 none, 1 finger, others glove/palm/hover */
+	uint32_t x, y, z;
+};
+
+struct tcm {
+	struct tcm_io io;
+	uint8_t config[TCM_MAX_CONFIG];
+	uint32_t config_len;
+	uint8_t payload[TCM_MAX_PAYLOAD];
+	uint32_t payload_len;
+	uint8_t code;
+	uint8_t header[4];	/* last wire header, for diagnostics */
+	int transport_error;	/* preserve the bus driver's failure code */
+	struct tcm_object obj[TCM_MAX_OBJECTS];
+};
+
+/*
+ * Read one message. 0: message in t->code / t->payload; 1: nothing pending
+ * (no marker, the controller has no data); <0: transport or framing error.
+ */
+static inline int tcm_read_message(struct tcm *t)
+{
+	uint8_t *hdr = t->header;
+	uint8_t buf[TCM_MAX_PAYLOAD + 3];
+	uint32_t len;
+
+	t->code = 0;
+	t->payload_len = 0;
+	for (uint32_t i = 0; i < 4; i++)
+		hdr[i] = 0;
+	t->transport_error = t->io.read(t->io.ctx, hdr, 4);
+	if (t->transport_error)
+		return -1;
+	if (hdr[0] != TCM_MARKER)
+		return 1;
+	t->code = hdr[1];
+	/* Idle/busy have no payload, even if their length bytes contain filler. */
+	if (t->code == TCM_STATUS_IDLE || t->code == TCM_STATUS_BUSY)
+		return 1;
+	if (t->code == TCM_STATUS_CONTINUED_READ)
+		return -3;	/* a previous reader consumed the message header */
+	len = hdr[2] | ((uint32_t)hdr[3] << 8);
+	t->payload_len = 0;
+	if (!len)
+		return 0;
+	if (len > TCM_MAX_PAYLOAD)
+		return -2;
+	t->transport_error = t->io.read(t->io.ctx, buf, len + 3);
+	if (t->transport_error)
+		return -1;
+	if (buf[0] != TCM_MARKER || buf[1] != TCM_STATUS_CONTINUED_READ || buf[len + 2] != TCM_PADDING)
+		return -3;
+	for (uint32_t i = 0; i < len; i++)
+		t->payload[i] = buf[2 + i];
+	t->payload_len = len;
+	return 0;
+}
+
+static inline int tcm_write_command(struct tcm *t, uint8_t cmd, const uint8_t *payload, uint32_t len)
+{
+	uint8_t buf[3 + 32];
+
+	if (len > 32)
+		return -2;
+	buf[0] = cmd;
+	buf[1] = (uint8_t)len;
+	buf[2] = (uint8_t)(len >> 8);
+	for (uint32_t i = 0; i < len; i++)
+		buf[3 + i] = payload[i];
+	t->transport_error = t->io.write(t->io.ctx, buf, 3 + len);
+	return t->transport_error ? -1 : 0;
+}
+
+/*
+ * Send a command and wait for its response; reports that arrive in between are
+ * dropped. wait() is the caller's delay (about 1 ms) between polls.
+ */
+static inline int tcm_command(struct tcm *t, uint8_t cmd, const uint8_t *payload, uint32_t len,
+			      void (*wait)(void), uint32_t tries)
+{
+	if (tcm_write_command(t, cmd, payload, len))
+		return -1;
+	while (tries--) {
+		int rc = tcm_read_message(t);
+
+		if (rc < 0)
+			return rc;
+		if (rc == 0 && t->code < TCM_REPORT_IDENTIFY)
+			return t->code == TCM_STATUS_OK ? 0 : -4;
+		wait();
+	}
+	return -5;
+}
+
+/* Fetch the touch report config (needed by tcm_parse_touch). */
+static inline int tcm_get_report_config(struct tcm *t, void (*wait)(void))
+{
+	int rc = tcm_command(t, TCM_CMD_GET_TOUCH_REPORT_CONFIG, 0, 0, wait, 200);
+
+	if (rc)
+		return rc;
+	if (t->payload_len > TCM_MAX_CONFIG)
+		return -2;
+	for (uint32_t i = 0; i < t->payload_len; i++)
+		t->config[i] = t->payload[i];
+	t->config_len = t->payload_len;
+	return 0;
+}
+
+/* syna_get_report_data(): bits (<= 32) at bit offset, LSB first. */
+static inline uint32_t tcm_bits(const struct tcm *t, uint32_t offset, uint32_t bits)
+{
+	uint32_t out = 0, done = 0;
+
+	if (!bits || bits > 32 || offset + bits > t->payload_len * 8)
+		return 0;
+	while (done < bits) {
+		uint32_t byte = offset / 8, shift = offset % 8;
+		uint32_t take = 8 - shift < bits - done ? 8 - shift : bits - done;
+		uint32_t v = ((uint32_t)t->payload[byte] >> shift) & (0xffu >> (8 - take));
+
+		out |= v << done;
+		done += take;
+		offset += take;
+	}
+	return out;
+}
+
+/* Parse a touch report (t->code == TCM_REPORT_TOUCH) into t->obj[]. 0 or <0. */
+static inline int tcm_parse_touch(struct tcm *t)
+{
+	uint32_t idx = 0, offset = 0, obj = 0, next = 0, objects = 0, active = 0;
+	int active_only = 0, have_active = 0;
+
+	for (int i = 0; i < TCM_MAX_OBJECTS; i++)
+		t->obj[i].status = 0;
+	while (idx < t->config_len) {
+		uint8_t code = t->config[idx++];
+		uint32_t bits, v;
+
+		switch (code) {
+		case TCM_TOUCH_END:
+			return 0;
+		case TCM_TOUCH_FOREACH_ACTIVE_OBJECT:
+		case TCM_TOUCH_FOREACH_OBJECT:
+			obj = 0;
+			next = idx;
+			active_only = code == TCM_TOUCH_FOREACH_ACTIVE_OBJECT;
+			break;
+		case TCM_TOUCH_FOREACH_END:
+			if (active_only) {
+				if (have_active) {
+					if (++objects < active)
+						idx = next;
+				} else if (offset < t->payload_len * 8) {
+					idx = next;
+				}
+			} else if (++obj < TCM_MAX_OBJECTS) {
+				idx = next;
+			}
+			break;
+		case TCM_TOUCH_PAD_TO_NEXT_BYTE:
+			offset = (offset + 7) & ~7u;
+			break;
+		default:
+			if (idx >= t->config_len)
+				return -1;
+			bits = t->config[idx++];
+			v = tcm_bits(t, offset, bits);
+			offset += bits;
+			switch (code) {
+			case TCM_TOUCH_OBJECT_N_INDEX:
+				if (v >= TCM_MAX_OBJECTS)
+					return -1;
+				obj = v;
+				break;
+			case TCM_TOUCH_OBJECT_N_CLASSIFICATION:
+				t->obj[obj].status = (uint8_t)v;
+				break;
+			case TCM_TOUCH_OBJECT_N_X_POSITION:
+				t->obj[obj].x = v;
+				break;
+			case TCM_TOUCH_OBJECT_N_Y_POSITION:
+				t->obj[obj].y = v;
+				break;
+			case TCM_TOUCH_OBJECT_N_Z:
+				t->obj[obj].z = v;
+				break;
+			case TCM_TOUCH_NUM_OF_ACTIVE_OBJECTS:
+				active = v;
+				have_active = 1;
+				if (!active)
+					return 0;
+				break;
+			default:	/* timestamp, widths, gestures, grip: skipped */
+				break;
+			}
+		}
+	}
+	return 0;
+}
+
+#endif
diff --git a/bsd/dev/negroni_touch/tlmm.h b/bsd/dev/negroni_touch/tlmm.h
new file mode 100755
index 0000000..84ee57a
--- /dev/null
+++ b/bsd/dev/negroni_touch/tlmm.h
@@ -0,0 +1,93 @@
+/*
+ * SM8450 TLMM pin control, MMIO only (Linux drivers/pinctrl/qcom/pinctrl-msm.c
+ * layout, pinctrl-sm8450.c: REG_SIZE 0x1000, ctl at n * 0x1000, io at +4).
+ * TLMM base 0x0F100000 (sm8450.dtsi tlmm: pinctrl@f100000).
+ */
+#ifndef NEGRONI_TLMM_H
+#define NEGRONI_TLMM_H
+
+#include <stdint.h>
+
+#define TLMM_BASE		0x0F100000u
+#define TLMM_CTL(n)		((uint32_t)(n) * 0x1000u)
+#define TLMM_IO(n)		((uint32_t)(n) * 0x1000u + 4u)
+
+#define TLMM_PULL_NONE		0u
+#define TLMM_PULL_DOWN		1u
+#define TLMM_PULL_UP		3u
+#define TLMM_FUNC(f)		((uint32_t)(f) << 2)		/* 0 = gpio */
+#define TLMM_DRIVE_MA(ma)	((uint32_t)((ma) / 2 - 1) << 6)
+#define TLMM_OE			(1u << 9)
+#define TLMM_IN			(1u << 0)
+#define TLMM_OUT		(1u << 1)
+
+/* negroni touch pins (sm8450.dtsi qup_i2c4_data_clk, negroni.dts ts_*_active, synaptics20031@4b) */
+#define NT_PIN_I2C_SDA		16	/* function qup4 = 1 */
+#define NT_PIN_I2C_SCL		17
+#define NT_PIN_RESET		20	/* active low */
+#define NT_PIN_IRQ		21	/* ATTN, active low */
+#define NT_PIN_1V8_EN		186	/* enable1v8_gpio: driven high to enable (oplus touchpanel uses the raw gpio number, the DT flag is not applied) */
+#define NT_FUNC_QUP4		1
+
+static inline void tlmm_cfg(volatile uint8_t *tlmm, unsigned pin, uint32_t cfg)
+{
+	*(volatile uint32_t *)(tlmm + TLMM_CTL(pin)) = cfg;
+}
+
+static inline void tlmm_out(volatile uint8_t *tlmm, unsigned pin, int high)
+{
+	*(volatile uint32_t *)(tlmm + TLMM_IO(pin)) = high ? TLMM_OUT : 0;
+}
+
+static inline int tlmm_in(volatile uint8_t *tlmm, unsigned pin)
+{
+	return (int)(*(volatile uint32_t *)(tlmm + TLMM_IO(pin)) & TLMM_IN);
+}
+
+/* I2C pins to qup4 with pull-ups, ATTN input, reset and 1.8 V enable as outputs (reset held). */
+/* SDA/SCL on qup4 with pull-ups */
+static inline void nt_pins_setup_i2c(volatile uint8_t *tlmm)
+{
+	tlmm_cfg(tlmm, NT_PIN_I2C_SDA, TLMM_FUNC(NT_FUNC_QUP4) | TLMM_DRIVE_MA(2) | TLMM_PULL_UP);
+	tlmm_cfg(tlmm, NT_PIN_I2C_SCL, TLMM_FUNC(NT_FUNC_QUP4) | TLMM_DRIVE_MA(2) | TLMM_PULL_UP);
+}
+
+static inline void nt_pins_setup(volatile uint8_t *tlmm)
+{
+	nt_pins_setup_i2c(tlmm);
+	tlmm_cfg(tlmm, NT_PIN_IRQ, TLMM_FUNC(0) | TLMM_DRIVE_MA(8) | TLMM_PULL_NONE);
+	tlmm_out(tlmm, NT_PIN_RESET, 0);
+	tlmm_cfg(tlmm, NT_PIN_RESET, TLMM_FUNC(0) | TLMM_DRIVE_MA(8) | TLMM_PULL_NONE | TLMM_OE);
+	tlmm_out(tlmm, NT_PIN_1V8_EN, 1);	/* 1.8 V load switch on */
+	tlmm_cfg(tlmm, NT_PIN_1V8_EN, TLMM_FUNC(0) | TLMM_DRIVE_MA(2) | TLMM_PULL_NONE | TLMM_OE);
+}
+
+/*
+ * I2C bus recovery (i2c_generic_scl_recovery): SDA held low by a target that was cut off mid-byte.
+ * Pins as GPIO, open drain emulated with OE: up to 9 SCL pulses until SDA is released, then STOP.
+ * Returns the SDA level afterwards (1 = bus free). The caller puts the pins back on qup4.
+ */
+static inline int nt_i2c_recover(volatile uint8_t *tlmm, void (*udelay)(unsigned))
+{
+	uint32_t in = TLMM_FUNC(0) | TLMM_DRIVE_MA(2) | TLMM_PULL_UP;
+
+	tlmm_cfg(tlmm, NT_PIN_I2C_SDA, in);
+	tlmm_cfg(tlmm, NT_PIN_I2C_SCL, in);
+	udelay(10);
+	for (int i = 0; i < 9 && !tlmm_in(tlmm, NT_PIN_I2C_SDA); i++) {
+		tlmm_out(tlmm, NT_PIN_I2C_SCL, 0);
+		tlmm_cfg(tlmm, NT_PIN_I2C_SCL, in | TLMM_OE);		/* drive SCL low */
+		udelay(5);
+		tlmm_cfg(tlmm, NT_PIN_I2C_SCL, in);			/* release: pulled high */
+		udelay(5);
+	}
+	/* STOP: SDA low -> high while SCL is high */
+	tlmm_out(tlmm, NT_PIN_I2C_SDA, 0);
+	tlmm_cfg(tlmm, NT_PIN_I2C_SDA, in | TLMM_OE);
+	udelay(5);
+	tlmm_cfg(tlmm, NT_PIN_I2C_SDA, in);
+	udelay(5);
+	return tlmm_in(tlmm, NT_PIN_I2C_SDA);
+}
+
+#endif
diff --git a/bsd/dev/negroni_touch/tlmm_i2c.h b/bsd/dev/negroni_touch/tlmm_i2c.h
new file mode 100755
index 0000000..6252742
--- /dev/null
+++ b/bsd/dev/negroni_touch/tlmm_i2c.h
@@ -0,0 +1,26 @@
+/* Map only GPIO16/17 pages (0xf110000, length 0x2000). */
+#ifndef NEGRONI_TLMM_I2C_H
+#define NEGRONI_TLMM_I2C_H
+#include "gpio_i2c.h"
+#include "tlmm.h"
+struct tlmm_i2c { volatile uint8_t *pins; };
+static inline void ti_line(void *ctx, unsigned off, int release)
+{
+    struct tlmm_i2c *p = ctx;
+    /* Never drive a high level: latch zero, switch output enable only. */
+    *(volatile uint32_t *)(p->pins + off + 4) = 0;
+    *(volatile uint32_t *)(p->pins + off) = TLMM_FUNC(0) | TLMM_DRIVE_MA(2) |
+        TLMM_PULL_UP | (release ? 0 : TLMM_OE);
+    (void)*(volatile uint32_t *)(p->pins + off); /* complete configuration write */
+}
+static inline void ti_sda(void *p, int r) { ti_line(p, 0, r); }
+static inline void ti_scl(void *p, int r) { ti_line(p, 0x1000, r); }
+static inline int ti_get_sda(void *p) { return *(volatile uint32_t *)(((struct tlmm_i2c *)p)->pins + 4) & 1; }
+static inline int ti_get_scl(void *p) { return *(volatile uint32_t *)(((struct tlmm_i2c *)p)->pins + 0x1004) & 1; }
+static inline void tlmm_i2c_init(struct gpio_i2c *g, struct tlmm_i2c *pins, void (*delay)(unsigned))
+{
+    g->ctx = pins; g->sda = ti_sda; g->scl = ti_scl;
+    g->get_sda = ti_get_sda; g->get_scl = ti_get_scl; g->delay = delay;
+    ti_sda(pins, 1); ti_scl(pins, 1); delay(5);
+}
+#endif
diff --git a/bsd/dev/negroni_ufs.c b/bsd/dev/negroni_ufs.c
new file mode 100644
index 0000000..2b43589
--- /dev/null
+++ b/bsd/dev/negroni_ufs.c
@@ -0,0 +1,1834 @@
+/*
+ * NEGRONI internal UFS root device.
+ *
+ * The Qualcomm UFS host (UFSHCI 2.1) is left enabled with the link up by the
+ * bootloader, which loaded our boot image from it. This driver reuses that
+ * state: it points the transfer request list at its own memory (verifying the
+ * host took it before ringing any doorbell) and issues polled SCSI commands,
+ * one at a time, to LUN 0. It finds one GPT partition by name (boot-arg
+ * ufsroot=, default "userdata") and exposes it as the BSD disk ufsroot0
+ * (rufsroot0), with 512-byte logical sectors over the device's 4 KiB blocks.
+ * Root on it with rd=ufsroot0.
+ *
+ * All DMA goes through one physically contiguous allocation (descriptors and
+ * a 1 MiB bounce buffer); the host is not cache coherent, so caches are
+ * cleaned/invalidated around each command.
+ *
+ * Writes are refused unless boot-arg ufsrw=1 is set. Every write is checked
+ * against the partition bounds again right before it is issued, so nothing
+ * outside the named partition can be written.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>          /* 0367: proc_iterate (SpringBoard mark) */
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <arm/caches_internal.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+#include <libkern/crypto/sha2.h>
+#include "negroni_bootlog_core.h"            /* 0367: the gate / HFS+ / CRC checks (host-tested) */
+
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+/* osfmk/arm/cpu_data.h, not exported to the BSD layer */
+extern int get_preemption_level(void);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+static void negroni_log_start(void);
+extern void negroni_sample_start(void);
+extern void negroni_keys_init(void);
+extern void negroni_touch_init(void);
+extern void negroni_cpufreq_init(void);
+extern void negroni_thermal_init(void);
+extern void negroni_haptic_init(void);   /* patch 0300: vibration motor (negronihap) */
+extern void negroni_cam_init(void);      /* patch 0310: camera bring-up (negronicam) */
+extern void negroni_adreno_init(void);
+extern void negroni_wifi_init(void);
+extern void negroni_adsp_init(void);
+extern void negroni_slpi_init(void);    /* patch 0376: SLPI (sensor DSP) start (negronislpi) */
+extern void negroni_bt_init(void);      /* patch 0330: QCA6490 Bluetooth (negronibt) */
+extern void negroni_fp_init(void);      /* patch 0350: fingerprint sensor stage A (negronifp) */
+extern void negroni_probe_menu(void);
+extern void negroni_usb_probe(void);
+
+#define REG_CAP         0x00
+#define REG_IS          0x20
+#define REG_IE          0x24
+#define REG_HCS         0x30
+#define REG_HCE         0x34
+#define REG_UTRLBA      0x50
+#define REG_UTRLBAU     0x54
+#define REG_UTRLDBR     0x58
+#define REG_UTRLCLR     0x5c
+#define REG_UTRLRSR     0x60
+
+#define HCS_DP          (1u << 0)
+#define HCS_UTRLRDY     (1u << 1)
+#define CAP_64AS        (1u << 24)              /* 64-bit DMA addressing */
+
+#define UFS_BLOCK       4096u
+#define BOUNCE_SIZE     (1u << 20)
+#define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
+#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
+#define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
+#define CMD_SPIN_NS     (50ull * NSEC_PER_USEC)
+#define CMD_SLEEP_NS    (200ull * NSEC_PER_USEC)
+
+struct utrd {
+	uint32_t dw0, dw1, dw2, dw3;
+	uint32_t ucdba, ucdbau;
+	uint32_t resp;          /* [31:16] response UPIU offset, [15:0] length, DWORDs */
+	uint32_t prdt;          /* [31:16] PRDT offset (DWORDs), [15:0] entries */
+};
+
+struct ucd {
+	uint8_t cmd[512];
+	uint8_t resp[512];
+	struct {
+		uint32_t addr_lo, addr_hi, rsvd, dbc;
+	} prdt[PRDT_MAX];
+};
+
+/* Layout of the contiguous DMA allocation. */
+#define DMA_UTRL        0x0000                  /* 1 KiB aligned */
+#define DMA_UCD         0x1000                  /* 128 byte aligned */
+#define DMA_BOUNCE      0x4000
+#define DMA_SIZE        (DMA_BOUNCE + BOUNCE_SIZE)
+
+static struct {
+	vm_offset_t regs;
+	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
+	uint64_t dma_pa;
+	uint8_t lun;
+	uint8_t tag;
+	uint64_t first_block, nblocks;          /* partition, in 4 KiB device blocks */
+	uint32_t secsize;                       /* logical sector size for the BSD layer */
+	bool writable;                          /* boot-arg ufsrw=1 */
+	bool cache;                             /* boot-arg ufscache=1 */
+	bool wait;                              /* boot-arg ufswait=1 */
+	int bmajor, cmajor;
+	dev_t bdev;
+	bool ready;
+} su;
+
+static LCK_GRP_DECLARE(negroni_ufs_grp, "negroni_ufs");
+static LCK_MTX_DECLARE(negroni_ufs_lock, &negroni_ufs_grp);
+static void negroni_fw_load(void);
+
+static inline uint32_t
+ufs_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(su.regs + off);
+}
+
+static inline void
+ufs_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(su.regs + off) = v;
+}
+
+static void
+dma_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+static void
+dma_clean(uint32_t off, uint32_t len)
+{
+	clean_dcache64((addr64_t)(su.dma_pa + off), len, TRUE);
+}
+
+/*
+ * One SCSI command in slot 0, data (if any) to/from the bounce buffer
+ * (to the device when write is set). Returns 0 or an errno.
+ */
+/* Sense key of the last failed command (0xff: no sense data). */
+static uint8_t ufs_last_sense;
+
+/*
+ * 0367: set by the panic path of the boot log (negroni_log_panic): commands
+ * spin on the counter (no delay(): it waits with WFE in panic context, see
+ * README-panic.md) and print nothing (printf may take locks).
+ */
+static volatile bool ufs_polled_only;
+
+static void
+ufs_spin_us(uint32_t us)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &abs);
+	uint64_t end = mach_absolute_time() + abs;
+	while (mach_absolute_time() < end) {
+	}
+}
+
+static int
+ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
+
+	assert(len <= BOUNCE_SIZE);
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x01;                     /* COMMAND UPIU */
+	ucd->cmd[1] = len ? (write ? 0x20 : 0x40) : 0x00;      /* W: data out, R: data in */
+	ucd->cmd[2] = su.lun;
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[12] = (uint8_t)(len >> 24);
+	ucd->cmd[13] = (uint8_t)(len >> 16);
+	ucd->cmd[14] = (uint8_t)(len >> 8);
+	ucd->cmd[15] = (uint8_t)len;
+	memcpy(&ucd->cmd[16], cdb, cdb_len);
+
+	/* DD: 1 = memory to device, 2 = device to memory. */
+	utrd->dw0 = (1u << 28) | ((len ? (write ? 1u : 2u) : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	if (len) {
+		uint32_t n = 0;
+		for (uint32_t done = 0; done < len; done += PRDT_CHUNK, n++) {
+			uint32_t chunk = MIN(PRDT_CHUNK, len - done);
+			ucd->prdt[n].addr_lo = (uint32_t)(bounce_pa + done);
+			ucd->prdt[n].addr_hi = (uint32_t)((bounce_pa + done) >> 32);
+			ucd->prdt[n].dbc = chunk - 1;
+		}
+		utrd->prdt = (1024u / 4) << 16 | n;
+	}
+
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 16 + cdb_len);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+		if (len) {
+			dma_clean(DMA_UCD + offsetof(struct ucd, prdt),
+			    (utrd->prdt & 0xffff) * sizeof(ucd->prdt[0]));
+		}
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	if (len) {
+		if (su.cache && write) {
+			dma_clean(DMA_BOUNCE, len);
+		} else {
+			dma_sync(DMA_BOUNCE, len);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	uint64_t deadline;
+	/* 0367: 1 s in the panic path (a dead host must not hold the panic USB mode back for long) */
+	nanoseconds_to_absolutetime(ufs_polled_only ? NSEC_PER_SEC : CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	bool sleepable = su.wait && su.ready && ml_get_interrupts_enabled() &&
+	    !ml_at_interrupt_context() && get_preemption_level() == 0;
+	uint64_t spin_until = 0, sleep_interval = 0;
+	if (sleepable) {
+		nanoseconds_to_absolutetime(CMD_SPIN_NS, &spin_until);
+		spin_until += mach_absolute_time();
+		nanoseconds_to_absolutetime(CMD_SLEEP_NS, &sleep_interval);
+	}
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		uint64_t now = mach_absolute_time();
+		if (now > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			if (!ufs_polled_only) {
+				printf("NEGRONI UFS: command 0x%02x timed out\n", cdb[0]);
+			}
+			return ETIMEDOUT;
+		}
+		if (sleepable && now >= spin_until) {
+			uint64_t wake = now + MIN(sleep_interval, deadline - now);
+			/* Keep the mutex: slot 0 and the bounce buffer are still owned. */
+			if (assert_wait_deadline_with_leeway((event_t)&su.wait, THREAD_UNINT,
+			    TIMEOUT_URGENCY_SYS_CRITICAL, wake, 0) == THREAD_WAITING) {
+				thread_block(THREAD_CONTINUE_NULL);
+			}
+		} else if (ufs_polled_only) {
+			ufs_spin_us(1);
+		} else {
+			delay(1);
+		}
+	}
+	__builtin_arm_dsb(0xf);
+	ufs_wr(REG_IS, ufs_rd(REG_IS));         /* acknowledge completion status */
+
+	dma_sync(DMA_UTRL, sizeof(*utrd));
+	if (su.cache) {
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+	} else {
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	if (len && !(su.cache && write)) {
+		dma_sync(DMA_BOUNCE, len);
+	}
+
+	uint32_t ocs = utrd->dw2 & 0xff;
+	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
+		/* Response UPIU: sense length at 32, fixed-format sense data from 34. */
+		const uint8_t *sense = &ucd->resp[34];
+		ufs_last_sense = (ucd->resp[33] || ucd->resp[32]) ? sense[2] & 0x0f : 0xff;
+		if (ufs_polled_only) {
+			return EIO;
+		}
+		printf("NEGRONI UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x"
+		    " sense len %u key 0x%x asc 0x%02x ascq 0x%02x\n",
+		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7],
+		    (ucd->resp[32] << 8) | ucd->resp[33], sense[2] & 0x0f, sense[12], sense[13]);
+		return EIO;
+	}
+	return 0;
+}
+
+/* READ(10) of count device blocks at lba into the bounce buffer. */
+static int
+ufs_read_blocks(uint64_t lba, uint32_t count)
+{
+	if (lba > UINT32_MAX || count > BOUNCE_SIZE / UFS_BLOCK) {
+		return EINVAL;
+	}
+	uint8_t cdb[10] = {
+		0x28, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, false);
+}
+
+/*
+ * WRITE(10) of count device blocks from the bounce buffer to lba. The range
+ * must lie inside the partition: this is the only place data goes out.
+ */
+/*
+ * 0367: the boot log area [ufs_log_lo, ufs_log_hi) (absolute device blocks;
+ * 0 = none). It is set only after the HFS+ volume end was checked to lie
+ * below it (nbl_setup). The log writes there with ufs_log_write_blocks(),
+ * also without ufsrw=1; nothing else uses this exception.
+ */
+static uint64_t ufs_log_lo, ufs_log_hi;
+
+static int
+ufs_write_checked(uint64_t lba, uint32_t count, bool allowed)
+{
+	if (!allowed || !nbl_core_in_partition(su.first_block, su.nblocks, lba, count, BOUNCE_SIZE / UFS_BLOCK)) {
+		if (!ufs_polled_only) {
+			printf("NEGRONI UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
+		}
+		return EPERM;
+	}
+	uint8_t cdb[10] = {
+		0x2a, 0,
+		(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+		0, (uint8_t)(count >> 8), (uint8_t)count, 0
+	};
+	return ufs_scsi(cdb, sizeof(cdb), count * UFS_BLOCK, true);
+}
+
+static int
+ufs_write_blocks(uint64_t lba, uint32_t count)
+{
+	return ufs_write_checked(lba, count, su.writable);
+}
+
+/* 0367: a write of the boot log: only inside its area, whatever ufsrw says. */
+static int
+ufs_log_write_blocks(uint64_t lba, uint32_t count)
+{
+	return ufs_write_checked(lba, count, nbl_core_in_window(ufs_log_lo, ufs_log_hi, lba, count));
+}
+
+static int
+ufs_sync_cache(void)
+{
+	static const uint8_t cdb[10] = { 0x35 };       /* SYNCHRONIZE CACHE(10), whole LUN */
+	return ufs_scsi(cdb, sizeof(cdb), 0, false);
+}
+
+static int
+ufs_find_partition(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	int error = ufs_read_blocks(1, 1);
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		printf("NEGRONI UFS: LUN %u has no GPT\n", su.lun);
+		return ENXIO;
+	}
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent * esz > BOUNCE_SIZE) {
+		printf("NEGRONI UFS: unsupported GPT entries %u x %u\n", nent, esz);
+		return ENXIO;
+	}
+	error = ufs_read_blocks(entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		uint64_t first, last;
+		memcpy(&first, e + 32, 8);
+		memcpy(&last, e + 40, 8);
+		if (last < first) {
+			return ENXIO;
+		}
+		su.first_block = first;
+		su.nblocks = last - first + 1;
+		return 0;
+	}
+	printf("NEGRONI UFS: no GPT partition named \"%s\"\n", want);
+	return ENOENT;
+}
+
+/*
+ * negroni (SM8450): Mu's Qualcomm UFS driver can leave the UFS power domain or its clocks off at
+ * ExitBootServices, and a host register read with the AXI/AHB clocks gated stalls the bus (the CPU
+ * hangs, nothing is printed). Check and, if needed, switch on the GDSC and the branches first.
+ * GCC offsets from Linux drivers/clk/qcom/gcc-sm8450.c (GDSC bit31 PWR_ON, bit0 SW_COLLAPSE; CBCR
+ * bit31 CLK_OFF, bit0 CLK_ENABLE).
+ */
+#define GCC_UFS_PA         0x00187000u
+#define GCC_UFS_GDSCR      0x004u
+static const struct { const char *name; uint32_t off; } ufs_gcc_branches[] = {
+	{ "axi", 0x018 }, { "ahb", 0x020 }, { "tx_sym0", 0x024 }, { "rx_sym0", 0x028 },
+	{ "unipro", 0x064 }, { "ice", 0x06c }, { "phy_aux", 0x0a4 }, { "rx_sym1", 0x0c0 }, { "aggre_axi", 0x0d4 },
+};
+
+static int
+ufs_power_check(void)
+{
+	vm_offset_t gcc = ml_io_map(GCC_UFS_PA, 0x1000);
+	if (!gcc) {
+		printf("NEGRONI UFS: GCC map failed\n");
+		return ENOMEM;
+	}
+	volatile uint32_t *gdsc = (volatile uint32_t *)(gcc + GCC_UFS_GDSCR);
+	uint32_t g = *gdsc;
+	printf("NEGRONI UFS: GDSC 0x%08x (%s)\n", g, (g & 0x80000000u) ? "on" : "OFF");
+	if (!(g & 0x80000000u)) {
+		*gdsc = g & ~1u;	/* SW_COLLAPSE = 0 */
+		for (int i = 0; i < 1000 && !(*gdsc & 0x80000000u); i++) {
+			delay(10);
+		}
+		printf("NEGRONI UFS: GDSC now 0x%08x\n", *gdsc);
+		if (!(*gdsc & 0x80000000u)) {
+			return ENXIO;
+		}
+	}
+	for (size_t i = 0; i < sizeof(ufs_gcc_branches) / sizeof(ufs_gcc_branches[0]); i++) {
+		volatile uint32_t *cbcr = (volatile uint32_t *)(gcc + ufs_gcc_branches[i].off);
+		uint32_t c = *cbcr;
+		if (c & 0x80000000u) {
+			*cbcr = c | 1u;
+			for (int n = 0; n < 1000 && (*cbcr & 0x80000000u); n++) {
+				delay(10);
+			}
+		}
+		printf("NEGRONI UFS: clk %s 0x%08x -> 0x%08x\n", ufs_gcc_branches[i].name, c, *cbcr);
+	}
+	return 0;
+}
+
+static int
+ufs_take_over_host(void)
+{
+	uint32_t hce = ufs_rd(REG_HCE), hcs = ufs_rd(REG_HCS);
+	if (!(hce & 1) || !(hcs & HCS_DP) || !(hcs & HCS_UTRLRDY)) {
+		printf("NEGRONI UFS: host not ready (hce 0x%x hcs 0x%x)\n", hce, hcs);
+		return ENXIO;
+	}
+	if (ufs_rd(REG_UTRLDBR)) {
+		printf("NEGRONI UFS: requests outstanding from the bootloader\n");
+		return EBUSY;
+	}
+	/* With RAM above 4 GiB (mkadt.py --highmem) the DMA memory can be there too. */
+	if (((su.dma_pa + DMA_SIZE - 1) >> 32) && !(ufs_rd(REG_CAP) & CAP_64AS)) {
+		printf("NEGRONI UFS: DMA memory at 0x%llx but the host has no 64-bit addressing\n",
+		    su.dma_pa);
+		return ENXIO;
+	}
+	ufs_wr(REG_IE, 0);                      /* polled operation */
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+	ufs_wr(REG_UTRLRSR, 0);
+	uint64_t list = su.dma_pa + DMA_UTRL;
+	ufs_wr(REG_UTRLBA, (uint32_t)list);
+	ufs_wr(REG_UTRLBAU, (uint32_t)(list >> 32));
+	ufs_wr(REG_UTRLRSR, 1);
+	/* Never ring a doorbell unless the host uses our list. */
+	if (ufs_rd(REG_UTRLBA) != (uint32_t)list || ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(ufs_rd(REG_UTRLRSR) & 1)) {
+		printf("NEGRONI UFS: host did not take our request list\n");
+		return EIO;
+	}
+	return 0;
+}
+
+static int
+negroni_ufs_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (!su.ready) {
+		return ENXIO;
+	}
+	return ((flags & FWRITE) && !su.writable) ? EROFS : 0;
+}
+
+static int
+negroni_ufs_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static void
+negroni_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = su.nblocks * UFS_BLOCK;
+
+	bool rd = buf_flags(bp) & B_READ;
+
+	buf_setresid(bp, count);
+	if (!rd && !su.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+
+	lck_mtx_lock(&negroni_ufs_lock);
+	for (uint32_t done = 0; done < count;) {
+		uint64_t pos = off + done;
+		uint64_t lba = pos / UFS_BLOCK;
+		uint32_t skip = (uint32_t)(pos % UFS_BLOCK);
+		uint32_t want = MIN(count - done, BOUNCE_SIZE - skip);
+		uint32_t blocks = (skip + want + UFS_BLOCK - 1) / UFS_BLOCK;
+		void *bounce = (void *)(su.dma + DMA_BOUNCE);
+		if (rd) {
+			error = ufs_read_blocks(su.first_block + lba, blocks);
+			if (!error) {
+				memcpy(vaddr + done, (const char *)bounce + skip, want);
+			}
+		} else {
+			/* Partial device blocks at either end: read, merge, write back. */
+			if (skip || (want % UFS_BLOCK)) {
+				error = ufs_read_blocks(su.first_block + lba, blocks);
+			}
+			if (!error) {
+				memcpy((char *)bounce + skip, vaddr + done, want);
+				error = ufs_write_blocks(su.first_block + lba, blocks);
+			}
+		}
+		if (error) {
+			break;
+		}
+		done += want;
+		buf_setresid(bp, count - done);
+	}
+	lck_mtx_unlock(&negroni_ufs_lock);
+	buf_unmap(bp);
+
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+negroni_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p, int is_char)
+{
+	uint32_t *f = (uint32_t *)data;
+	uint64_t *o = (uint64_t *)data;
+
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*f = su.secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE:
+		if (is_char) {
+			return ENODEV;
+		}
+		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
+			return EINVAL;
+		}
+		su.secsize = *f;
+		return 0;
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*f = UFS_BLOCK;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*o = su.nblocks * UFS_BLOCK / su.secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*f = su.writable;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE: {
+		if (!su.writable) {
+			return 0;
+		}
+		lck_mtx_lock(&negroni_ufs_lock);
+		int error = ufs_sync_cache();
+		lck_mtx_unlock(&negroni_ufs_lock);
+		return error;
+	}
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*o = BOUNCE_SIZE / su.secsize;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*o = su.writable ? BOUNCE_SIZE / su.secsize : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*o = 1;
+		return 0;
+	case DKIOCISSOLIDSTATE: {
+		/*
+		 * UFS is flash. Without this HFS treats the root as a hard disk
+		 * (no HFS_SSD): it relocates ("defragments") fragmented files on
+		 * open and runs hot-file clustering, both through hfs_relocate()
+		 * -> hfs_clonefile(), which failed with ERANGE on this 16 KiB-page
+		 * kernel (patch 0204). Boot-arg negroniclone bit 0 (default on).
+		 */
+		static bool logged;
+		int clone = 3;
+		PE_parse_boot_argn("negroniclone", &clone, sizeof(clone));
+		if (!(clone & 1)) {
+			return ENOTTY;
+		}
+		if (!logged) {
+			logged = true;
+			printf("NEGRONI UFS: solid state (HFS: no file relocation, no hot files; negroniclone bit 0)\n");
+		}
+		*f = 1;
+		return 0;
+	}
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+negroni_ufs_bioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return negroni_ufs_ioctl(dev, cmd, data, flag, p, 0);
+}
+
+static int
+negroni_ufs_cioctl(dev_t dev, u_long cmd, caddr_t data, int flag, struct proc *p)
+{
+	return negroni_ufs_ioctl(dev, cmd, data, flag, p, 1);
+}
+
+static int
+negroni_ufs_psize(__unused dev_t dev)
+{
+	return su.ready ? (int)MIN(su.nblocks * UFS_BLOCK / su.secsize, INT_MAX) : -1;
+}
+
+static int
+negroni_ufs_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(negroni_ufs_strategy, NULL, dev, B_READ, minphys, uio, (int)su.secsize);
+}
+
+static int
+negroni_ufs_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	if (!su.writable) {
+		return EROFS;
+	}
+	return physio(negroni_ufs_strategy, NULL, dev, B_WRITE, minphys, uio, (int)su.secsize);
+}
+
+static const struct bdevsw negroni_ufs_bdevsw = {
+	.d_open     = negroni_ufs_open,
+	.d_close    = negroni_ufs_close,
+	.d_strategy = negroni_ufs_strategy,
+	.d_ioctl    = negroni_ufs_bioctl,
+	.d_dump     = eno_dump,
+	.d_psize    = negroni_ufs_psize,
+	.d_type     = D_DISK,
+};
+
+static const struct cdevsw negroni_ufs_cdevsw = {
+	.d_open       = negroni_ufs_open,
+	.d_close      = negroni_ufs_close,
+	.d_read       = negroni_ufs_read,
+	.d_write      = negroni_ufs_write,
+	.d_ioctl      = negroni_ufs_cioctl,
+	.d_stop       = eno_stop,
+	.d_reset      = eno_reset,
+	.d_ttys       = NULL,
+	.d_select     = eno_select,
+	.d_mmap       = eno_mmap,
+	.d_strategy   = eno_strat,
+	.d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc,
+	.d_type       = D_DISK,
+};
+
+static int
+negroni_ufs_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	char want[64] = "userdata";
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/negroni-ufs", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t)) {
+		printf("NEGRONI UFS: no /negroni-ufs node in the device tree\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("ufsroot", want, sizeof(want));
+	uint32_t rw = 0;
+	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
+	uint32_t cache = 0, wait = 0;
+	PE_parse_boot_argn("ufscache", &cache, sizeof(cache));
+	PE_parse_boot_argn("ufswait", &wait, sizeof(wait));
+	su.cache = (cache == 1);
+	su.wait = (wait == 1);
+
+	error = ufs_power_check();
+	if (error) {
+		printf("NEGRONI UFS: UFS power/clocks unavailable (%d), not touching the host\n", error);
+		return error;
+	}
+	su.regs = ml_io_map(reg[0], reg[1]);
+	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("NEGRONI UFS: no contiguous DMA memory\n");
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)su.dma);
+	if (!pn) {
+		return ENOMEM;
+	}
+	su.dma_pa = ptoa_64(pn);
+	su.lun = 0;
+	su.secsize = DEV_BSIZE;
+
+	lck_mtx_lock(&negroni_ufs_lock);
+	error = ufs_take_over_host();
+	if (!error) {
+		static const uint8_t tur[6] = { 0x00 };
+		/* UFS START STOP UNIT: POWER CONDITION = active (1), sent to the UFS Device W-LUN (0xd0). */
+		static const uint8_t start[6] = { 0x1b, 0, 0, 0, 0x10, 0 };
+		/*
+		 * The first commands after the bootloader report unit attentions;
+		 * a stopped (not ready) device needs START STOP UNIT.
+		 */
+		for (int i = 0; i < 20 && (error = ufs_scsi(tur, sizeof(tur), 0, false)); i++) {
+			if (ufs_last_sense == 0x2) {
+				su.lun = 0xd0;
+				int rc = ufs_scsi(start, sizeof(start), 0, false);
+				su.lun = 0;
+				printf("NEGRONI UFS: device power mode active: %d\n", rc);
+			}
+			delay(10000);
+		}
+	}
+	if (!error) {
+		error = ufs_find_partition(want);
+	}
+	lck_mtx_unlock(&negroni_ufs_lock);
+	if (error) {
+		return error;
+	}
+
+	su.bmajor = bdevsw_add(-1, &negroni_ufs_bdevsw);
+	if (su.bmajor < 0) {
+		return ENXIO;
+	}
+	su.cmajor = cdevsw_add_with_bdev(-1, &negroni_ufs_cdevsw, su.bmajor);
+	if (su.cmajor < 0) {
+		return ENXIO;
+	}
+	su.bdev = makedev(su.bmajor, 0);
+	devfs_make_node(su.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "ufsroot0");
+	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
+	/* Only now, with the partition bounds known, can writes be allowed. */
+	su.writable = (rw != 0);
+	su.ready = true;
+	printf("NEGRONI UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
+	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
+	    su.writable ? "read-write" : "read-only", su.dma_pa);
+	negroni_log_start();
+	negroni_fw_load();
+	negroni_sample_start();
+	/* Input drivers (HID services in iokit/Kernel/arm/hid/NegroniHID.cpp). */
+	negroni_cpufreq_init();
+	negroni_thermal_init();         /* patch 0280: TSENS readings + thermal caps */
+	negroni_haptic_init();          /* patch 0300: negronihap=1 buzzes 300 ms */
+	negroni_cam_init();             /* patch 0310/0311: negronicam=1|2, own thread, default off */
+	negroni_probe_menu();
+	negroni_adreno_init();
+	negroni_wifi_init();
+	negroni_adsp_init();            /* boot-arg negroniadsp=1 (default off): own thread */
+	negroni_slpi_init();            /* patch 0376: negronislpi=1|2|3 (default off): own thread, after the ADSP thread */
+	negroni_bt_init();              /* patch 0330: negronibt=1|2 (default off): own thread */
+	negroni_fp_init();              /* patch 0350: negronifp=1|2 (default off): own thread */
+	negroni_keys_init();
+	negroni_touch_init();
+	negroni_usb_probe();
+	return 0;
+}
+
+/*
+ * Persistent console log ("negronilog"). Filming the phone screen is the only
+ * other way to see the console, so every character that reaches the
+ * console (kernel printf and /dev/console writes of daemons, both through
+ * _cnputs) is also kept in a 4 MiB ring. Since 0367 the ring goes into one
+ * slot of the boot log area per boot (see "Boot log" below) every
+ * ufslogsecs seconds (default 1); the old single area (the last 4 MiB +
+ * 4 KiB of the partition, header "SWEETLOG") is no longer written.
+ * Disabled with boot-arg negronilog=0.
+ */
+#define NEGRONI_LOG_SIZE          (4u << 20)
+#define NEGRONI_LOG_BLOCKS        (1 + NEGRONI_LOG_SIZE / UFS_BLOCK)
+#define NEGRONI_LOG_SECS          1u            /* 0367: was 10 */
+
+static char negroni_log_ring[NEGRONI_LOG_SIZE];
+static uint64_t _Atomic negroni_log_total;
+static int negroni_log_chan;
+static uint32_t negroni_log_secs = NEGRONI_LOG_SECS;
+
+/* Called for all console output, any context: never blocks. */
+void negroni_log_append(const char *c, int size);
+
+void
+negroni_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	uint64_t at = os_atomic_add_orig(&negroni_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		negroni_log_ring[(at + (uint64_t)i) % NEGRONI_LOG_SIZE] = c[i];
+	}
+}
+
+/*
+ * Copy console bytes [*pos, total) (at most max) for live log streaming
+ * (negroni_usb.c). A reader that fell more than the ring behind skips ahead.
+ * Returns the byte count; *pos advances.
+ */
+uint32_t negroni_log_copy(uint64_t *pos, char *out, uint32_t max);
+
+uint32_t
+negroni_log_copy(uint64_t *pos, char *out, uint32_t max)
+{
+	uint64_t total = os_atomic_load(&negroni_log_total, relaxed);
+	if (total - *pos > NEGRONI_LOG_SIZE) {
+		*pos = total - NEGRONI_LOG_SIZE;
+	}
+	uint32_t n = (uint32_t)MIN((uint64_t)max, total - *pos);
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = negroni_log_ring[(*pos + i) % NEGRONI_LOG_SIZE];
+	}
+	*pos += n;
+	return n;
+}
+
+uint64_t negroni_log_position(void);
+
+uint64_t
+negroni_log_position(void)
+{
+	return os_atomic_load(&negroni_log_total, relaxed);
+}
+
+
+/*
+ * Firmware area: NEGRONI_FW_SIZE right before the log area, written from a
+ * recovery with dd (negroni-ios/tools/mkfwarea.py builds it; vendor firmware
+ * never goes into git or the boot image). Block 0:
+ *   "NEGRONFW" | u32 version 1 | u32 count | count x { char name[48] |
+ *   u32 offset (bytes from the area start) | u32 size | u8 sha256[32] }
+ * Loaded once into kernel memory after the partition is known; every file's
+ * SHA-256 is checked. negroni_fw_get() hands out a file by name.
+ */
+#define NEGRONI_FW_SIZE           (8u << 20)
+#define NEGRONI_FW_BLOCKS         (NEGRONI_FW_SIZE / UFS_BLOCK)
+#define NEGRONI_FW_MAX            16
+
+struct negroni_fw_entry {
+	char name[48];
+	uint32_t offset, size;
+	uint8_t sha256[32];
+};
+struct negroni_fw_header {
+	char magic[8];
+	uint32_t version, count;
+	struct negroni_fw_entry entry[NEGRONI_FW_MAX];
+};
+
+static uint8_t *negroni_fw_data;
+static struct negroni_fw_header negroni_fw_hdr;
+static uint32_t negroni_fw_ok;          /* bit i: entry i verified */
+
+const void *negroni_fw_get(const char *name, uint32_t *size);
+
+const void *
+negroni_fw_get(const char *name, uint32_t *size)
+{
+	for (uint32_t i = 0; negroni_fw_data && i < negroni_fw_hdr.count; i++) {
+		if ((negroni_fw_ok & (1u << i)) && strncmp(negroni_fw_hdr.entry[i].name, name, 48) == 0) {
+			*size = negroni_fw_hdr.entry[i].size;
+			return negroni_fw_data + negroni_fw_hdr.entry[i].offset;
+		}
+	}
+	return NULL;
+}
+
+static void
+negroni_fw_load(void)
+{
+	uint64_t base = su.first_block + su.nblocks - NEGRONI_LOG_BLOCKS - NEGRONI_FW_BLOCKS;
+	const uint8_t *bounce = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	vm_offset_t buf = 0;
+	uint32_t want;
+	int error;
+
+	if (su.nblocks < 4 * (NEGRONI_LOG_BLOCKS + NEGRONI_FW_BLOCKS)) {
+		return;
+	}
+	lck_mtx_lock(&negroni_ufs_lock);
+	error = ufs_read_blocks(base, 1);
+	if (!error) {
+		memcpy(&negroni_fw_hdr, bounce, sizeof(negroni_fw_hdr));
+	}
+	lck_mtx_unlock(&negroni_ufs_lock);
+	if (error || memcmp(negroni_fw_hdr.magic, "NEGRONFW", 8) != 0 || negroni_fw_hdr.version != 1 ||
+	    negroni_fw_hdr.count == 0 || negroni_fw_hdr.count > NEGRONI_FW_MAX) {
+		printf("NEGRONI FW: no firmware area at block 0x%llx (error %d)\n", base, error);
+		return;
+	}
+	want = 0;
+	for (uint32_t i = 0; i < negroni_fw_hdr.count; i++) {
+		struct negroni_fw_entry *e = &negroni_fw_hdr.entry[i];
+		if (e->offset < UFS_BLOCK || e->offset > NEGRONI_FW_SIZE || e->size > NEGRONI_FW_SIZE - e->offset) {
+			printf("NEGRONI FW: entry %u out of range\n", i);
+			return;
+		}
+		want = MAX(want, e->offset + e->size);
+	}
+	want = (want + UFS_BLOCK - 1) & ~(UFS_BLOCK - 1);
+	if (kmem_alloc(kernel_map, &buf, want, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("NEGRONI FW: no memory for %u bytes\n", want);
+		return;
+	}
+	for (uint32_t at = 0; at < want; at += BOUNCE_SIZE) {
+		uint32_t n = MIN(BOUNCE_SIZE, want - at);
+		lck_mtx_lock(&negroni_ufs_lock);
+		error = ufs_read_blocks(base + at / UFS_BLOCK, n / UFS_BLOCK);
+		if (!error) {
+			memcpy((void *)(buf + at), bounce, n);
+		}
+		lck_mtx_unlock(&negroni_ufs_lock);
+		if (error) {
+			printf("NEGRONI FW: read error %d at +%#x\n", error, at);
+			kmem_free(kernel_map, buf, want);
+			return;
+		}
+	}
+	negroni_fw_data = (uint8_t *)buf;
+	for (uint32_t i = 0; i < negroni_fw_hdr.count; i++) {
+		struct negroni_fw_entry *e = &negroni_fw_hdr.entry[i];
+		uint8_t digest[32];
+		SHA256_CTX ctx;
+
+		e->name[47] = 0;
+		SHA256_Init(&ctx);
+		SHA256_Update(&ctx, negroni_fw_data + e->offset, e->size);
+		SHA256_Final(digest, &ctx);
+		bool ok = memcmp(digest, e->sha256, 32) == 0;
+		if (ok) {
+			negroni_fw_ok |= 1u << i;
+		}
+		printf("NEGRONI FW: %s %u bytes %s\n", e->name, e->size, ok ? "OK" : "SHA-256 MISMATCH");
+	}
+}
+
+/*
+ * Audio DSP firmware area (bsd/dev/negroni_adsp.c, scripts/audio/mkadsparea.py in iOSPlus10):
+ * NEGRONI_ADSP_AREA_SIZE right before the GPU firmware area, written with dd like it. The ADSP
+ * image (adsp.mdt + 25 segments, 18 MiB) does not fit the 8 MiB / 16-entry GPU area.
+ * Read-only: copies `count` bytes at byte `at` of the area to `dst` (kernel memory).
+ */
+#define NEGRONI_ADSP_AREA_SIZE    (32u << 20)
+#define NEGRONI_ADSP_AREA_BLOCKS  (NEGRONI_ADSP_AREA_SIZE / UFS_BLOCK)
+
+int negroni_ufs_adsp_area_read(uint64_t at, void *dst, uint32_t count);
+
+int
+negroni_ufs_adsp_area_read(uint64_t at, void *dst, uint32_t count)
+{
+	const uint8_t *bounce = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint8_t *to = (uint8_t *)dst;
+
+	if (!su.ready || su.nblocks < 4 * (NEGRONI_LOG_BLOCKS + NEGRONI_FW_BLOCKS + NEGRONI_ADSP_AREA_BLOCKS) ||
+	    at > NEGRONI_ADSP_AREA_SIZE || count > NEGRONI_ADSP_AREA_SIZE - at) {
+		return EINVAL;
+	}
+	uint64_t base = su.first_block + su.nblocks - NEGRONI_LOG_BLOCKS - NEGRONI_FW_BLOCKS - NEGRONI_ADSP_AREA_BLOCKS;
+	while (count > 0) {
+		uint32_t skip = (uint32_t)(at % UFS_BLOCK);
+		uint32_t n = MIN(count, BOUNCE_SIZE - skip);
+		uint32_t nblk = (skip + n + UFS_BLOCK - 1) / UFS_BLOCK;
+		int error;
+
+		lck_mtx_lock(&negroni_ufs_lock);
+		error = ufs_read_blocks(base + at / UFS_BLOCK, nblk);
+		if (!error) {
+			memcpy(to, bounce + skip, n);
+		}
+		lck_mtx_unlock(&negroni_ufs_lock);
+		if (error) {
+			return error;
+		}
+		to += n;
+		at += n;
+		count -= n;
+	}
+	return 0;
+}
+
+/*
+ * WLAN firmware area (bsd/dev/negroni_wlan.c, scripts/wifi/mkwlanarea.py in iOSPlus10):
+ * NEGRONI_WLAN_AREA_SIZE right before the ADSP area, written with dd like it (amss*.bin, m3.bin,
+ * regdb.bin, the board files: 22 MiB). Read-only: copies `count` bytes at byte `at` of the area
+ * to `dst` (kernel memory, also a non-cacheable mapping).
+ */
+#define NEGRONI_WLAN_AREA_SIZE    (32u << 20)
+#define NEGRONI_WLAN_AREA_BLOCKS  (NEGRONI_WLAN_AREA_SIZE / UFS_BLOCK)
+
+int negroni_ufs_wlan_area_read(uint64_t at, void *dst, uint32_t count);
+
+int
+negroni_ufs_wlan_area_read(uint64_t at, void *dst, uint32_t count)
+{
+	const uint8_t *bounce = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint8_t *to = (uint8_t *)dst;
+
+	if (!su.ready || su.nblocks < 4 * (NEGRONI_LOG_BLOCKS + NEGRONI_FW_BLOCKS + NEGRONI_ADSP_AREA_BLOCKS +
+	    NEGRONI_WLAN_AREA_BLOCKS) || at > NEGRONI_WLAN_AREA_SIZE || count > NEGRONI_WLAN_AREA_SIZE - at) {
+		return EINVAL;
+	}
+	uint64_t base = su.first_block + su.nblocks - NEGRONI_LOG_BLOCKS - NEGRONI_FW_BLOCKS - NEGRONI_ADSP_AREA_BLOCKS -
+	    NEGRONI_WLAN_AREA_BLOCKS;
+	while (count > 0) {
+		uint32_t skip = (uint32_t)(at % UFS_BLOCK);
+		uint32_t n = MIN(count, BOUNCE_SIZE - skip);
+		uint32_t nblk = (skip + n + UFS_BLOCK - 1) / UFS_BLOCK;
+		int error;
+
+		lck_mtx_lock(&negroni_ufs_lock);
+		error = ufs_read_blocks(base + at / UFS_BLOCK, nblk);
+		if (!error) {
+			memcpy(to, bounce + skip, n);
+		}
+		lck_mtx_unlock(&negroni_ufs_lock);
+		if (error) {
+			return error;
+		}
+		to += n;
+		at += n;
+		count -= n;
+	}
+	return 0;
+}
+
+/*
+ * Boot log (patch 0367, patches/xnu/README-bootlog.md). The console ring of
+ * each boot goes into one slot of a reserved area of the partition, so a
+ * boot that loses the USB link, hangs or resets can be read on the next good
+ * boot. Always on (boot-arg negronilog=0 turns it off); it does not need
+ * ufsrw=1: ufs_log_write_blocks() writes only inside the area.
+ *
+ * Area: NBL_AREA_BLOCKS device blocks right below the WLAN firmware area
+ * (relative to the partition end N: blocks N-28673 .. N-19458; NE2211
+ * userdata N = 58672399). Before any write the HFS+ volume header (byte 1024
+ * of the partition) is read: the volume must end at or below the area.
+ *   area block 0                      superblock (struct nbl_super, "NEGRBLOG")
+ *   area block 1 + i*NBL_SLOT_BLOCKS  slot i: header block (struct nbl_slot,
+ *                                     "NEGRBOOT"), then the 4 MiB console ring
+ *                                     (byte n of the boot at ring offset n % 4 MiB)
+ * The rest of the area (1015 blocks) is reserved. The slot of a boot is the
+ * one after the slot with the highest boot counter. Header fields: boot
+ * counter, state (running / panic / halt / restart), flags (SpringBoard seen,
+ * panic log written), bytes written, flush count, calendar and uptime of
+ * the start, the last flush, SpringBoard and the end, kernel UUID and
+ * version, boot-args, the PMIC PON log summary of this power-on (why the
+ * previous boot ended) and the end text (panic first line / halt / restart).
+ * CRC-32 (IEEE) over the header without the crc field.
+ *
+ * Flushes: every ufslogsecs seconds (default 1) when the console has new
+ * text, else a header heartbeat every NBL_HEARTBEAT_SECS; each with
+ * SYNCHRONIZE CACHE. The panic path (negroni_log_panic) writes once more
+ * without the lock, polled; halt and restart write the end state.
+ * Read back: /dev/negronibootlog (root, read-only: the area as a file) and
+ * the USB command server ("bootlog", "bootlog read A C": negroni_usb.c);
+ * host: op10tool bootlog.
+ */
+#define NBL_AREA_BLOCKS     9216u                       /* 36 MiB */
+#define NBL_FROM_END        (NEGRONI_LOG_BLOCKS + NEGRONI_FW_BLOCKS + NEGRONI_ADSP_AREA_BLOCKS + \
+	                     NEGRONI_WLAN_AREA_BLOCKS + NBL_AREA_BLOCKS)   /* 28673 */
+#define NBL_SLOTS           8u
+#define NBL_SLOT_BLOCKS     NEGRONI_LOG_BLOCKS          /* 1 header + 1024 ring blocks */
+#define NBL_VERSION         1u
+#define NBL_HEARTBEAT_SECS  30u     /* header only, when the console is quiet (review F1: was 5) */
+#define NBL_EARLY_SECS      300u    /* flush every ufslogsecs (1 s) only in the first 5 min of uptime ... */
+#define NBL_LATE_SECS       5u      /* ... then at most every 5 s */
+#define NBL_BUDGET_BYTES    (256u << 10)    /* more than this flushed in NBL_BUDGET_SECS: */
+#define NBL_BUDGET_SECS     10u
+#define NBL_SLOW_SECS       10u     /* flush every 10 s until a quiet window */
+
+enum { NBL_RUNNING = 1, NBL_PANIC = 2, NBL_HALT = 3, NBL_RESTART = 4 };
+#define NBL_F_SPRINGBOARD   0x1u
+#define NBL_F_PANICLOG      0x2u
+
+struct nbl_super {
+	char magic[8];                  /* "NEGRBLOG" */
+	uint32_t version;               /* 1 */
+	uint32_t slots;                 /* 8 */
+	uint32_t slot_blocks;           /* 1025 */
+	uint32_t area_blocks;           /* 9216 */
+	uint32_t ring_size;             /* 4 MiB */
+	uint32_t from_end;              /* 28673: area start = partition end - from_end */
+	uint32_t crc;                   /* CRC-32 of the bytes before it */
+} __attribute__((packed));
+
+struct nbl_slot {
+	char magic[8];                  /*    0 "NEGRBOOT" */
+	uint32_t version;               /*    8 1 */
+	uint32_t hdr_size;              /*   12 sizeof(struct nbl_slot) */
+	uint64_t boot;                  /*   16 boot counter (1, 2, ...) */
+	uint32_t state;                 /*   24 NBL_RUNNING ... */
+	uint32_t flags;                 /*   28 NBL_F_* */
+	uint32_t ring_size;             /*   32 */
+	uint32_t flush_secs;            /*   36 */
+	uint64_t total;                 /*   40 console bytes of this boot */
+	uint64_t seq;                   /*   48 flush count */
+	uint64_t start_cal;             /*   56 calendar seconds at the slot start (may be the RTC's wrong time) */
+	uint64_t last_cal;              /*   64 calendar seconds at the last flush (not updated in a panic) */
+	uint64_t last_up_ms;            /*   72 uptime at the last flush */
+	uint64_t sb_up_ms;              /*   80 uptime when SpringBoard ran (0: never) */
+	uint64_t end_up_ms;             /*   88 uptime of the end (panic/halt/restart) */
+	char uuid[40];                  /*   96 kernel UUID */
+	char kversion[256];             /*  136 kernel version string */
+	char bootargs[1024];            /*  392 */
+	char pon[256];                  /* 1416 PMIC PON log at this power-on (negroni_reboot.c) */
+	char end[256];                  /* 1672 end text */
+	uint32_t crc;                   /* 1928 CRC-32 of bytes 0..1927 */
+} __attribute__((packed));
+_Static_assert(sizeof(struct nbl_slot) == 1932, "nbl_slot layout (op10tool bootlog)");
+_Static_assert(sizeof(struct nbl_super) == 36, "nbl_super layout (op10tool bootlog)");
+/* F4: op10tool bootlog, root-simg.sh, write-areas.sh and bootlog-ssh.sh hard-code 28673 / 9216 / 8201 */
+_Static_assert(NBL_FROM_END == 28673 && NBL_FROM_END == NBL_CORE_FROM_END, "boot log area start (host tools)");
+_Static_assert(NBL_AREA_BLOCKS == NBL_CORE_AREA_BLOCKS, "boot log area size (host tools)");
+_Static_assert(1 + NBL_SLOTS * NBL_SLOT_BLOCKS == 8201 && 1 + NBL_SLOTS * NBL_SLOT_BLOCKS <= NBL_AREA_BLOCKS,
+    "boot log slots (bootlog-ssh.sh reads 8201 blocks)");
+
+static struct {
+	bool ok;                        /* area checked, slot chosen: the log runs */
+	volatile bool panic;            /* the panic path owns the host now */
+	uint64_t lo;                    /* absolute device block of area block 0 */
+	uint64_t hfs_end;               /* HFS+ volume end, device blocks from the partition start */
+	uint32_t slot;
+	uint64_t last_write;            /* mach time of the last flush */
+	struct nbl_slot hdr;            /* this boot's header (under negroni_ufs_lock) */
+} nbl;
+
+extern char kernel_uuid_string[];
+extern const char *negroni_reboot_pon_summary(void);   /* negroni_reboot.c (0367) */
+extern int kdb_printf(const char *format, ...) __printflike(1, 2);
+
+#define nbl_crc32 nbl_core_crc32
+
+static uint64_t
+nbl_uptime_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+static uint64_t
+nbl_slot_base(uint32_t slot)
+{
+	return nbl.lo + 1 + (uint64_t)slot * NBL_SLOT_BLOCKS;
+}
+
+static bool
+nbl_slot_valid(const struct nbl_slot *h)
+{
+	return memcmp(h->magic, "NEGRBOOT", 8) == 0 && h->version == NBL_VERSION &&
+	       h->hdr_size == sizeof(*h) && h->crc == nbl_crc32(h, offsetof(struct nbl_slot, crc));
+}
+
+static const char *
+nbl_state_name(uint32_t state)
+{
+	switch (state) {
+	case NBL_RUNNING: return "running";
+	case NBL_PANIC:   return "panic";
+	case NBL_HALT:    return "halt";
+	case NBL_RESTART: return "restart";
+	default:          return "?";
+	}
+}
+
+/*
+ * The ring from `flushed` to `total`, then this boot's header, then
+ * SYNCHRONIZE CACHE. With negroni_ufs_lock held, or in the panic path.
+ */
+static int
+negroni_log_write(uint64_t flushed, uint64_t total)
+{
+	uint64_t base = nbl_slot_base(nbl.slot);
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint64_t pos = total - flushed >= NEGRONI_LOG_SIZE ? total - NEGRONI_LOG_SIZE : flushed;
+	int error = 0;
+
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % NEGRONI_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(NEGRONI_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, negroni_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_log_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		nbl.hdr.total = total;
+		nbl.hdr.seq++;
+		nbl.hdr.last_up_ms = nbl_uptime_ms();
+		if (!nbl.panic) {
+			clock_sec_t s;
+			clock_usec_t us;
+			clock_get_calendar_microtime(&s, &us);
+			nbl.hdr.last_cal = (uint64_t)s;
+		}
+		if (nbl.hdr.pon[0] == 0 && negroni_reboot_pon_summary() != NULL) {
+			strlcpy(nbl.hdr.pon, negroni_reboot_pon_summary(), sizeof(nbl.hdr.pon));
+		}
+		nbl.hdr.crc = nbl_crc32(&nbl.hdr, offsetof(struct nbl_slot, crc));
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &nbl.hdr, sizeof(nbl.hdr));
+		error = ufs_log_write_blocks(base, 1);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	nbl.last_write = mach_absolute_time();
+	return error;
+}
+
+static bool negroni_log_running;
+static uint64_t negroni_log_flushed;
+
+/* SpringBoard marker: proc_iterate callback (the same name lookup as negroni_sample.c). */
+static int
+nbl_find_springboard(proc_t p, void *arg)
+{
+	char name[MAXCOMLEN + 1];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, "SpringBoard") == 0) {
+		*(int *)arg = proc_pid(p);
+		return PROC_RETURNED_DONE;
+	}
+	return PROC_RETURNED;
+}
+
+static void
+negroni_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t heartbeat, sec, win_start = 0, win_bytes = 0, slow_until = 0;
+	bool first = true;
+
+	nanoseconds_to_absolutetime((uint64_t)NBL_HEARTBEAT_SECS * NSEC_PER_SEC, &heartbeat);
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sec);
+	negroni_log_running = true;
+	for (;;) {
+		(void)tsleep(&negroni_log_chan, PZERO, "negronilog", hz * (int)negroni_log_secs);
+		if (!(nbl.hdr.flags & NBL_F_SPRINGBOARD)) {
+			int pid = 0;
+			proc_iterate(PROC_ALLPROCLIST, nbl_find_springboard, &pid, NULL, NULL);
+			if (pid > 0) {
+				uint64_t ms = nbl_uptime_ms();
+				lck_mtx_lock(&negroni_ufs_lock);
+				nbl.hdr.flags |= NBL_F_SPRINGBOARD;
+				nbl.hdr.sb_up_ms = ms;
+				lck_mtx_unlock(&negroni_ufs_lock);
+				printf("NEGRONI BOOTLOG: boot %llu reached SpringBoard (pid %d) %llu.%03llu s after start\n",
+				    nbl.hdr.boot, pid, ms / 1000, ms % 1000);
+			}
+		}
+		/*
+		 * Wear budget (review F1): new text is flushed every ufslogsecs (1 s) in the
+		 * first NBL_EARLY_SECS of uptime, then at most every NBL_LATE_SECS; after a
+		 * flush window with more than NBL_BUDGET_BYTES in NBL_BUDGET_SECS, every
+		 * NBL_SLOW_SECS for the next 2 windows. A quiet console: header only, every
+		 * NBL_HEARTBEAT_SECS. The first flush (the backlog since kernel start) does not count.
+		 */
+		uint64_t now = mach_absolute_time();
+		uint64_t total = os_atomic_load(&negroni_log_total, relaxed);
+		uint32_t every = negroni_log_secs;
+		if (nbl_uptime_ms() >= (uint64_t)NBL_EARLY_SECS * 1000 && every < NBL_LATE_SECS) {
+			every = NBL_LATE_SECS;
+		}
+		if (now < slow_until && every < NBL_SLOW_SECS) {
+			every = NBL_SLOW_SECS;
+		}
+		uint64_t since = now - nbl.last_write;
+		if (total == negroni_log_flushed ? since < heartbeat : since < (uint64_t)every * sec) {
+			continue;
+		}
+		lck_mtx_lock(&negroni_ufs_lock);
+		uint64_t before = negroni_log_flushed;
+		int error = nbl.panic ? EBUSY : negroni_log_write(negroni_log_flushed, total);
+		if (!error) {
+			negroni_log_flushed = total;
+		}
+		lck_mtx_unlock(&negroni_ufs_lock);
+		if (!error && !first) {
+			if (now - win_start >= (uint64_t)NBL_BUDGET_SECS * sec) {
+				win_start = now;
+				win_bytes = 0;
+			}
+			win_bytes += total - before;
+			if (win_bytes > NBL_BUDGET_BYTES) {
+				if (now >= slow_until) {
+					printf("NEGRONI BOOTLOG: %llu KiB in %u s: flushes every %u s for a while\n",
+					    win_bytes >> 10, NBL_BUDGET_SECS, NBL_SLOW_SECS);
+				}
+				slow_until = now + 2ull * NBL_BUDGET_SECS * sec;
+				win_bytes = 0;
+				win_start = now;
+			}
+		}
+		first = false;
+		if (error) {
+			printf("NEGRONI BOOTLOG: write failed (%d), flush thread stops\n", error);
+			negroni_log_running = false;
+			return;
+		}
+	}
+}
+
+/* First line of the panic text (skips leading blank lines) into dst. */
+static void
+nbl_first_line(char *dst, size_t size, const char *text, size_t length)
+{
+	size_t i = 0, n = 0;
+	while (i < length && (text[i] == '\n' || text[i] == '\r' || text[i] == ' ')) {
+		i++;
+	}
+	while (i < length && text[i] != '\n' && text[i] != 0 && n + 1 < size) {
+		dst[n++] = (text[i] >= 0x20 && text[i] < 0x7f) ? text[i] : '?';
+		i++;
+	}
+	dst[n] = 0;
+}
+
+/*
+ * The panic path: wait (polled, at most 200 ms) for a command that the
+ * flush thread or the block device had in slot 0 when the other CPUs were
+ * stopped; clear the slot if it never completes. The halted thread never
+ * touches the bounce buffer again.
+ */
+static void
+nbl_panic_take_host(void)
+{
+	uint64_t limit;
+	nanoseconds_to_absolutetime(200 * NSEC_PER_MSEC, &limit);
+	uint64_t end = mach_absolute_time() + limit;
+	while ((ufs_rd(REG_UTRLDBR) & 1) && mach_absolute_time() < end) {
+	}
+	if (ufs_rd(REG_UTRLDBR) & 1) {
+		ufs_wr(REG_UTRLCLR, ~1u);
+		ufs_spin_us(1000);
+	}
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+}
+
+/*
+ * Review F5: the panic path uses the host only if negroni_ufs_lock is free
+ * (tried once; it stays taken, the system does not run on), or if it is
+ * held while root writes are off (no ufsrw=1: the holder only reads or is
+ * our own flush). A holder on a CPU that was not stopped could be in the
+ * middle of a root write with the shared bounce buffer, UTRD and UCD: then
+ * no panic write (the USB panic mode still sends the log). false = skip.
+ */
+static bool
+nbl_panic_enter(void)
+{
+	static int result = -1;
+
+	if (result >= 0) {
+		return result == 1;
+	}
+	if (!lck_mtx_try_lock(&negroni_ufs_lock) && su.writable) {
+		kdb_printf("NEGRONI BOOTLOG: UFS busy at the panic (ufsrw=1): no panic write to the disk\n");
+		result = 0;
+		return false;
+	}
+	nbl.panic = true;
+	ufs_polled_only = true;
+	nbl_panic_take_host();
+	result = 1;
+	return true;
+}
+
+/*
+ * From the panic path (osfmk/arm/model_dep.c, after the backtraces): the panic log (XNU writes it
+ * to its panic buffer, not the console) into the ring, and (0367) the ring plus a panic header into
+ * this boot's slot: interrupts are off and the other CPUs are stopped, so no lock is taken and the
+ * commands spin on the counter (ufs_polled_only).
+ */
+void negroni_log_panic(const char *text, size_t length);
+
+void
+negroni_log_panic(const char *text, size_t length)
+{
+	static bool done;
+
+	if (done) {
+		return;
+	}
+	done = true;
+	/*
+	 * 0360: the ring copy is made also without the partition log: the USB
+	 * panic flush (negroni_usb.c, negroni_usb_panic_service()) sends the
+	 * ring, and the register dump and backtrace are only in this text.
+	 */
+	negroni_log_append("\nNEGRONI LOG: panic log follows\n", 32);
+	for (size_t i = 0; i < length; i += 512) {
+		negroni_log_append(text + i, (int)MIN((size_t)512, length - i));
+	}
+	negroni_log_append("\nNEGRONI LOG: end of panic log\n", 31);
+	if (!nbl.ok || !su.ready || !nbl_panic_enter()) {
+		return;
+	}
+	nbl.hdr.state = NBL_PANIC;
+	nbl.hdr.flags |= NBL_F_PANICLOG;
+	nbl.hdr.end_up_ms = nbl_uptime_ms();
+	nbl_first_line(nbl.hdr.end, sizeof(nbl.hdr.end), text, length);
+	int error = negroni_log_write(negroni_log_flushed, os_atomic_load(&negroni_log_total, relaxed));
+	kdb_printf("NEGRONI BOOTLOG: panic log of boot %llu written to slot %u: %s\n", nbl.hdr.boot, nbl.slot,
+	    error ? "FAILED" : "ok");
+}
+
+/*
+ * The end of this boot (0367): kind NBL_HALT or NBL_RESTART, why = a short
+ * text. Called from the halt/restart hook (NegroniPlatformExpert.cpp), the
+ * USB command server (reset/power off commands) and the panic hold loop
+ * (after a panic the state stays "panic"; the text gets " / then: why").
+ * Blocks only where it may; otherwise the lock is tried for 200 ms, and in
+ * the panic path no lock is used.
+ */
+void negroni_bootlog_end(unsigned kind, const char *why);
+
+#define NBL_END_IN_PANIC    0x10u       /* kind flag: called from the panic hold loop (negroni_reboot.c) */
+
+void
+negroni_bootlog_end(unsigned kind, const char *why)
+{
+	bool locked = false;
+
+	if (!nbl.ok || !su.ready) {
+		return;
+	}
+	if ((kind & NBL_END_IN_PANIC) && !nbl.panic) {
+		/* a panic that did not pass negroni_log_panic(): take the host here (F5 rule), polled */
+		if (!nbl_panic_enter()) {
+			return;
+		}
+		nbl.hdr.state = NBL_PANIC;
+		nbl.hdr.end_up_ms = nbl_uptime_ms();
+		strlcpy(nbl.hdr.end, "panic (no panic log from model_dep.c)", sizeof(nbl.hdr.end));
+	}
+	kind &= ~NBL_END_IN_PANIC;
+	if (!nbl.panic && ml_at_interrupt_context()) {
+		return;                 /* no caller does this; never wait for the lock from an interrupt */
+	}
+	if (!nbl.panic) {
+		/*
+		 * Callers: kPEHaltCPU/kPERestartCPU (thread context, preemption on: the
+		 * lock path) and ud_ctl_poll (ud_thread, preemption on). The try-lock
+		 * loop is only a guard for a caller with preemption or interrupts off.
+		 */
+		if (preemption_enabled() && ml_get_interrupts_enabled()) {
+			lck_mtx_lock(&negroni_ufs_lock);
+			locked = true;
+		} else {
+			uint64_t limit;
+			nanoseconds_to_absolutetime(200 * NSEC_PER_MSEC, &limit);
+			uint64_t end = mach_absolute_time() + limit;
+			while (!(locked = lck_mtx_try_lock(&negroni_ufs_lock)) && mach_absolute_time() < end) {
+			}
+			if (!locked) {
+				return;
+			}
+		}
+	}
+	if (nbl.hdr.state == NBL_PANIC) {
+		strlcat(nbl.hdr.end, " / then: ", sizeof(nbl.hdr.end));
+		strlcat(nbl.hdr.end, why, sizeof(nbl.hdr.end));
+	} else {
+		nbl.hdr.state = kind == NBL_HALT ? NBL_HALT : NBL_RESTART;
+		strlcpy(nbl.hdr.end, why, sizeof(nbl.hdr.end));
+		nbl.hdr.end_up_ms = nbl_uptime_ms();
+		if (!nbl.panic) {
+			printf("NEGRONI BOOTLOG: boot %llu ends: %s (%s)\n", nbl.hdr.boot, nbl_state_name(nbl.hdr.state), why);
+		}
+	}
+	uint64_t total = os_atomic_load(&negroni_log_total, relaxed);
+	if (negroni_log_write(negroni_log_flushed, total) == 0) {
+		negroni_log_flushed = total;
+	}
+	if (locked) {
+		lck_mtx_unlock(&negroni_ufs_lock);
+	}
+}
+
+/* Area blocks [blk, blk + count) into dst (count <= 4). 0 or an errno. Thread context. */
+int negroni_bootlog_read(uint32_t blk, uint32_t count, void *dst);
+
+int
+negroni_bootlog_read(uint32_t blk, uint32_t count, void *dst)
+{
+	if (!nbl.ok || count == 0 || count > 4 || blk >= NBL_AREA_BLOCKS || count > NBL_AREA_BLOCKS - blk) {
+		return EINVAL;
+	}
+	if (nbl.panic) {
+		return EBUSY;
+	}
+	lck_mtx_lock(&negroni_ufs_lock);
+	int error = ufs_read_blocks(nbl.lo + blk, count);
+	if (!error) {
+		memcpy(dst, (const void *)(su.dma + DMA_BOUNCE), count * UFS_BLOCK);
+	}
+	lck_mtx_unlock(&negroni_ufs_lock);
+	return error;
+}
+
+/* One line for the "bootlog" command: the area and this boot. */
+void negroni_bootlog_info(char *buf, size_t size);
+
+void
+negroni_bootlog_info(char *buf, size_t size)
+{
+	if (!nbl.ok) {
+		snprintf(buf, size, "error: no boot log on this boot (see NEGRONI BOOTLOG lines)");
+		return;
+	}
+	snprintf(buf, size, "bootlog v%u area %llu blocks %u slots %u slotblocks %u boot %llu slot %u state %s "
+	    "secs %u hfsend %llu running %d",
+	    NBL_VERSION, nbl.lo - su.first_block, NBL_AREA_BLOCKS, NBL_SLOTS, NBL_SLOT_BLOCKS, nbl.hdr.boot,
+	    nbl.slot, nbl_state_name(nbl.hdr.state), negroni_log_secs, nbl.hfs_end, negroni_log_running ? 1 : 0);
+}
+
+/* /dev/negronibootlog: the area as a read-only file (root only), for dd over SSH. */
+static int
+nbl_dev_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (flags & FWRITE) {
+		return EPERM;
+	}
+	return nbl.ok ? 0 : ENXIO;
+}
+
+static int
+nbl_dev_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+nbl_dev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint8_t *buf = kalloc_data(UFS_BLOCK, Z_WAITOK);
+	int error = 0;
+
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	while (uio_resid(uio) > 0 && !error) {
+		off_t off = uio_offset(uio);
+		if (off < 0) {
+			error = EINVAL;
+			break;
+		}
+		if (off >= (off_t)NBL_AREA_BLOCKS * UFS_BLOCK) {
+			break;
+		}
+		uint32_t in = (uint32_t)(off % UFS_BLOCK);
+		error = negroni_bootlog_read((uint32_t)(off / UFS_BLOCK), 1, buf);
+		if (!error) {
+			error = uiomove((const char *)buf + in, (int)MIN((user_ssize_t)(UFS_BLOCK - in), uio_resid(uio)), uio);
+		}
+	}
+	kfree_data(buf, UFS_BLOCK);
+	return error;
+}
+
+static const struct cdevsw nbl_cdevsw = {
+	.d_open = nbl_dev_open, .d_close = nbl_dev_close, .d_read = nbl_dev_read,
+	.d_write = eno_rdwrt, .d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset,
+	.d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap, .d_strategy = eno_strat,
+	.d_reserved_1 = eno_getc, .d_reserved_2 = eno_putc, .d_type = 0,
+};
+
+/*
+ * Checks the area and picks this boot's slot (with negroni_ufs_lock held).
+ * The write gate (ufs_log_lo/hi) opens only after all checks:
+ *  1. HFS+ volume header (partition byte 1024): the volume ends at or below
+ *     the area start (nbl_core_hfs_end / nbl_core_area_rel).
+ *  2. Layout anchor (review F2): the block right after the area (N-19457) is
+ *     the WLAN firmware area header "NEGRWLAN", or the area already holds our
+ *     superblock (written by an earlier boot that passed this check, or by
+ *     AREAS=1 root-simg.sh at N-28673). So N and the area layout are the ones
+ *     the firmware areas were written with.
+ * The caller closes the gate again on any error (review F3).
+ */
+static int
+nbl_setup_locked(void)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	static struct nbl_slot prev[NBL_SLOTS];
+	bool valid[NBL_SLOTS] = { false };
+	uint64_t rel = 0;
+	int error;
+
+	if ((error = ufs_read_blocks(su.first_block, 1)) != 0) {
+		return error;
+	}
+	if (nbl_core_hfs_end(b + 1024, &nbl.hfs_end) != 0) {
+		printf("NEGRONI BOOTLOG: no HFS+ volume header at the partition start (sig %#x): off\n",
+		    (unsigned)(b[1024] << 8 | b[1025]));
+		return ENOENT;
+	}
+	switch (nbl_core_area_rel(su.nblocks, nbl.hfs_end, &rel)) {
+	case 0:
+		break;
+	case -1:
+		printf("NEGRONI BOOTLOG: partition too small (%llu blocks): off\n", su.nblocks);
+		return ENOSPC;
+	default:
+		printf("NEGRONI BOOTLOG: HFS+ volume ends at block %llu, past the area at block %llu: off\n",
+		    nbl.hfs_end, rel);
+		return EEXIST;
+	}
+	nbl.lo = su.first_block + rel;
+
+	struct nbl_super sb = {
+		.magic = { 'N', 'E', 'G', 'R', 'B', 'L', 'O', 'G' }, .version = NBL_VERSION, .slots = NBL_SLOTS,
+		.slot_blocks = NBL_SLOT_BLOCKS, .area_blocks = NBL_AREA_BLOCKS, .ring_size = NEGRONI_LOG_SIZE,
+		.from_end = NBL_FROM_END,
+	};
+	sb.crc = nbl_crc32(&sb, offsetof(struct nbl_super, crc));
+	if ((error = ufs_read_blocks(nbl.lo, 1)) != 0) {
+		return error;
+	}
+	bool fresh = memcmp(b, &sb, sizeof(sb)) != 0;
+	if ((error = ufs_read_blocks(nbl.lo + NBL_AREA_BLOCKS, 1)) != 0) {
+		return error;
+	}
+	bool wlan = memcmp(b, "NEGRWLAN", 8) == 0;
+	if (fresh && !wlan) {
+		printf("NEGRONI BOOTLOG: no WLAN area header (NEGRWLAN) at block %llu and no boot log superblock at %llu: "
+		    "layout not proven, off (write the firmware areas: AREAS=1 root-simg.sh)\n",
+		    rel + NBL_AREA_BLOCKS, rel);
+		return ENOENT;
+	}
+
+	/* every check passed: open the write gate for the area only */
+	ufs_log_lo = nbl.lo;
+	ufs_log_hi = nbl.lo + NBL_AREA_BLOCKS;
+
+	if (fresh) {
+		/* new superblock, and all 8 slot headers zeroed (no stale header from an older layout) */
+		bzero((void *)(su.dma + DMA_BOUNCE), UFS_BLOCK);
+		for (uint32_t i = 0; i < NBL_SLOTS && !error; i++) {
+			error = ufs_log_write_blocks(nbl_slot_base(i), 1);
+		}
+		if (!error) {
+			memcpy((void *)(su.dma + DMA_BOUNCE), &sb, sizeof(sb));
+			error = ufs_log_write_blocks(nbl.lo, 1);
+		}
+		if (error) {
+			return error;
+		}
+	}
+
+	/* slot headers; the next slot after the highest boot counter */
+	uint64_t max_boot = 0;
+	uint32_t max_slot = NBL_SLOTS - 1;
+	for (uint32_t i = 0; i < NBL_SLOTS && !fresh; i++) {
+		if ((error = ufs_read_blocks(nbl_slot_base(i), 1)) != 0) {
+			return error;
+		}
+		memcpy(&prev[i], b, sizeof(prev[i]));
+		valid[i] = nbl_slot_valid(&prev[i]);
+		/* review F7: the strings come from the disk; terminate them before any printf */
+		prev[i].uuid[sizeof(prev[i].uuid) - 1] = 0;
+		prev[i].kversion[sizeof(prev[i].kversion) - 1] = 0;
+		prev[i].bootargs[sizeof(prev[i].bootargs) - 1] = 0;
+		prev[i].pon[sizeof(prev[i].pon) - 1] = 0;
+		prev[i].end[sizeof(prev[i].end) - 1] = 0;
+		if (valid[i] && prev[i].boot > max_boot) {
+			max_boot = prev[i].boot;
+			max_slot = i;
+		}
+	}
+	nbl.slot = (max_slot + 1) % NBL_SLOTS;
+
+	bzero(&nbl.hdr, sizeof(nbl.hdr));
+	memcpy(nbl.hdr.magic, "NEGRBOOT", 8);
+	nbl.hdr.version = NBL_VERSION;
+	nbl.hdr.hdr_size = sizeof(nbl.hdr);
+	nbl.hdr.boot = max_boot + 1;
+	nbl.hdr.state = NBL_RUNNING;
+	nbl.hdr.ring_size = NEGRONI_LOG_SIZE;
+	nbl.hdr.flush_secs = negroni_log_secs;
+	clock_sec_t s;
+	clock_usec_t us;
+	clock_get_calendar_microtime(&s, &us);
+	nbl.hdr.start_cal = nbl.hdr.last_cal = (uint64_t)s;
+	strlcpy(nbl.hdr.uuid, kernel_uuid_string, sizeof(nbl.hdr.uuid));
+	strlcpy(nbl.hdr.kversion, version, sizeof(nbl.hdr.kversion));
+	strlcpy(nbl.hdr.bootargs, PE_boot_args(), sizeof(nbl.hdr.bootargs));
+	nbl.ok = true;
+
+	printf("NEGRONI BOOTLOG: area at block %llu (%u blocks, HFS+ ends at %llu, anchor %s)%s; boot %llu -> slot %u\n",
+	    rel, NBL_AREA_BLOCKS, nbl.hfs_end, wlan ? "NEGRWLAN" : "superblock", fresh ? ", new superblock" : "",
+	    nbl.hdr.boot, nbl.slot);
+	for (uint32_t k = 1; k <= NBL_SLOTS && !fresh; k++) {
+		uint32_t i = (max_slot + NBL_SLOTS + 1 - k) % NBL_SLOTS;  /* newest first */
+		if (!valid[i] || k > 3) {
+			continue;
+		}
+		const struct nbl_slot *h = &prev[i];
+		printf("NEGRONI BOOTLOG: earlier boot %llu (slot %u): %s, last flush %llu s, %llu bytes, SpringBoard %s; %s\n",
+		    h->boot, i, h->state == NBL_RUNNING ? "no end mark (reset, hang or power loss)" : nbl_state_name(h->state),
+		    h->last_up_ms / 1000, h->total,
+		    (h->flags & NBL_F_SPRINGBOARD) ? "yes" : "no", h->end[0] ? h->end : "-");
+	}
+	return negroni_log_write(0, 0);
+}
+
+static void
+negroni_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("negronilog", &on, sizeof(on));
+	if (!on) {
+		printf("NEGRONI BOOTLOG: off (negronilog=0)\n");
+		return;
+	}
+	PE_parse_boot_argn("ufslogsecs", &negroni_log_secs, sizeof(negroni_log_secs));
+	if (negroni_log_secs == 0 || negroni_log_secs > 60) {
+		negroni_log_secs = NEGRONI_LOG_SECS;
+	}
+	lck_mtx_lock(&negroni_ufs_lock);
+	int error = nbl_setup_locked();
+	if (error || !nbl.ok) {
+		/* review F3: every failed setup closes the write gate */
+		ufs_log_lo = ufs_log_hi = 0;
+		nbl.ok = false;
+	}
+	lck_mtx_unlock(&negroni_ufs_lock);
+	if (error || !nbl.ok) {
+		printf("NEGRONI BOOTLOG: not started (%d)\n", error);
+		return;
+	}
+	int major = cdevsw_add(-1, &nbl_cdevsw);
+	if (major >= 0) {
+		devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0400, "negronibootlog");
+	}
+	if (kernel_thread_start(negroni_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("NEGRONI BOOTLOG: no thread: only the panic and end writes\n");
+		negroni_log_running = false;
+	}
+}
+
+/* Root device for rd=ufsroot0 (IOFindBSDRoot). */
+int negroni_ufs_rootdev(dev_t *dev);
+
+int
+negroni_ufs_rootdev(dev_t *dev)
+{
+	if (!su.ready) {
+		int error = negroni_ufs_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = su.bdev;
+	return 0;
+}
