+/*
+ * ---- patch 0285: GPU power between frames (IFPC) and after 2 s idle (slumber) ----
+ *
+ * Before 0285 the GMU started once, OOB GPU_SET stayed set from step 18 for the whole boot, so GX was
+ * powered all the time (0281 only lowered its clock). References: the OnePlus KGSL gen7 driver
+ * (out/src/op-kernel/drivers/gpu/msm). Three modes, chosen in gpu_keep (pm_start):
+ *
+ * PM_IFPC (negronigpu_ifpc=1, default, and the GMU acked FEATURE_CTRL IFPC at step 17): the CP has its
+ *   power-up list (step 20), OOB GPU_SET is cleared after step 22 (KGSL gen7_gpu_boot clears it once the
+ *   GPU runs), and the GMU collapses GX by itself 300 us after the CP passed the ring's "IFPC enable"
+ *   marker (every submission is already bracketed by SET_MARKER 0x101/0x100, as gen7_ringbuffer.c). The
+ *   CPU must not touch a collapsed GX: CP_RB_WPTR is a fenced write (adreno_gen7.c gen7_fenced_write:
+ *   write, GMU_AHB_FENCE_STATUS bit 0 = dropped, 10 us, again, up to 200 times; the dropped write makes
+ *   the GMU bring GX back), the ring room comes from the fences in memory (no CP_RB_RPTR read), and the
+ *   few GX reads left (watch line, report, table switch) hold GX with OOB PERFCNTR (gen7_gmu_oob_set:
+ *   set BIT(30 - 2 * 1), ack BIT(31 - 1), clear BIT(31 - 2 * 1)). KGSL has no OOB per submission.
+ * PM_SLUMBER (IFPC refused or off, negronigpu_slumber=1, default): after PM_SLUMBER_MS with no work,
+ *   KGSL gen7_power_off + gen7_gmu_power_off without the clock/CX-off part: OOB GPU_SET clear,
+ *   PREPARE_SLUMBER (H2F 33), wait for the GMU idle (GPU_CX_BUSY_STATUS bit 30) and GX off, RSC sleep
+ *   (gen7_rscc_sleep_sequence: CM3 into reset, RSCC_CONTROL_REQ bit 0, RSC_STATUS0 bit 16). The GMU then
+ *   does not run, so the wake is KGSL's warm boot (gen7_gmu_boot + gen7_gpu_boot): RSC wake
+ *   (gen7_rscc_wakeup_sequence), steps 14-18 again (firmware, start, HFI, tables, OOB GPU_SET), step 20
+ *   (registers, SQE, ME_INIT) and CP_SET_SECURE_MODE 0 (adreno_gen7.c gen7_rb_start: the zap shader is
+ *   loaded once). The submission that finds the GPU asleep does the wake and logs its time.
+ * PM_OFF: the 0281 behaviour (negronigpu_ifpc=0 negronigpu_slumber=0).
+ * IFPC acked but GX never collapsed in 10 s of idle: back to OOB GPU_SET and PM_SLUMBER (if allowed).
+ * One mutex (gpu_pm_lock) orders the submissions, the watch thread's HFI votes and the sleep/wake.
+ */
+#define PM_OFF                  0
+#define PM_IFPC                 1
+#define PM_SLUMBER              2
+#define PM_SLUMBER_MS           2000
+#define PM_IDLE_TICK_MS         250
+#define PM_NEVER_COLLAPSED_MS   10000
+#define GMU_OOB_PERF_SET        28
+#define GMU_OOB_PERF_ACK        30
+#define GMU_OOB_PERF_CLEAR      29
+#define GMU_INTR_MASK           0x1f993
+#define GMU_GFX_PWR_CLK_STATUS  0x1f8d0         /* bit 0 GX GDSC off, bit 1 GX clock off (gen7_gmu_gx_is_on) */
+#define GMU_RPMH_POWER_STATE    0x1f8ec         /* 0 active, 3 IFPC, 0xf slumber (kgsl_gmu_core.h GPU_HW_*) */
+#define GMU_AHB_FENCE_STATUS    0x23b13
+#define GMU_CX_BUSY_STATUS      0x23b0c         /* GPU_GMU_AO_GPU_CX_BUSY_STATUS, bit 30 CXGXCPUBUSYIGNAHB */
+#define GMU_RSCC_CONTROL_REQ    0x23b07
+#define PM_FENCE_RETRIES        200             /* GMU_CORE_LONG_WAKEUP_RETRY_LIMIT, 10 us each */
+
+static LCK_GRP_DECLARE(gpu_pm_grp, "negroni_gpu_pm");
+static LCK_MTX_DECLARE(gpu_pm_lock, &gpu_pm_grp);
+static uint32_t pm_mode;
+static bool pm_asleep, pm_dead, pm_revote, pm_watch_idle, pm_seen_collapse;
+static uint32_t fence_pos[256];         /* IFPC: ring position after each fence's write (fence & 255) */
+static uint64_t pm_last_submit, pm_asleep_at;
+static uint32_t pm_sleeps, pm_wakes, pm_wake_us, pm_wake_max_us, pm_sleep_failed, pm_hold_failed;
+static uint32_t pm_fence_waits, pm_fence_max_us, pm_fence_fails;
+static uint32_t pm_samples, pm_collapsed, pm_gmu_off;  /* watch samples since the last WATCH line */
+#define K_GBIF_HALT_ACK         0x3c46          /* 0298: GEN7_GBIF_HALT_ACK */
+static uint32_t pm_gbif_logged, pm_ifpc_sleeps, pm_ifpc_skips, pm_lowest_missed;   /* 0384: + lowest-idle misses */
+static uint32_t pm_wake_retries;                /* 0384: failed slumber wakes that got a reset + retry (max 8 a boot) */
+static void rec_reset(uint32_t n, bool collapse);
+bool negroni_gpu_done(uint32_t fence);
+static uint64_t busy_last_xo, busy_last_ao, busy_acc_xo, busy_acc_ao;   /* 0298: GMU busy counter */
+static bool busy_counter_ok = true;
+static uint32_t busy_zero_ticks;
+
+static bool
+pm_gx_on(void)
+{
+	return (rd(gpucc + GPUCC_GX_GDSCR) & GDSC_PWR_ON) != 0;
+}
+
+static uint32_t
+pm_us_since(uint64_t t0)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	return (uint32_t)MIN(ns / 1000, 0xffffffffull);
+}
+
+static const char *
+pm_name(void)
+{
+	return pm_mode == PM_IFPC ? (pm_asleep ? "ifpc (asleep)" : "ifpc") : pm_mode == PM_SLUMBER ? (pm_asleep ? "slumber (asleep)" : "slumber") : "off";
+}
+
+/* GX may be read by the CPU until gx_release(). PM_IFPC: OOB PERFCNTR; the other modes hold GX already. */
+static bool
+gx_hold(void)
+{
+	if (pm_mode != PM_IFPC) {
+		return !pm_asleep;
+	}
+	if (pm_asleep) {
+		return false;           /* 0298: IFPC mode slumbers too: the CM3 is in reset, no OOB answer */
+	}
+	wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << GMU_OOB_PERF_SET);
+	bool acked = wait_for(gmu + GMU_REG(GMU_GMU2HOST_INTR_INFO), 1u << GMU_OOB_PERF_ACK, 1u << GMU_OOB_PERF_ACK, 20);
+	wr(gmu + GMU_REG(GMU_GMU2HOST_INTR_CLR), 1u << GMU_OOB_PERF_ACK);
+	if (acked && pm_gx_on()) {
+		return true;
+	}
+	wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << GMU_OOB_PERF_CLEAR);
+	if (pm_hold_failed++ < 4) {
+		printf("NEGRONI GPU PM: OOB PERFCNTR %s, GX GDSC %#x: no GX register read\n", acked ? "acked" : "NOT ACKED",
+		    rd(gpucc + GPUCC_GX_GDSCR));
+	}
+	return false;
+}
+
+static void
+gx_release(void)
+{
+	if (pm_mode == PM_IFPC) {
+		wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << GMU_OOB_PERF_CLEAR);
+	}
+}
+
+/* OOB GPU_SET (step 18's request): true when acked and GX reads powered */
+static bool
+pm_gpu_set(void)
+{
+	wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << OOB_GPU_SET_REQUEST);
+	bool acked = wait_for(gmu + GMU_REG(GMU_GMU2HOST_INTR_INFO), 1u << OOB_GPU_SET_ACK, 1u << OOB_GPU_SET_ACK, 100);
+	wr(gmu + GMU_REG(GMU_GMU2HOST_INTR_CLR), 1u << OOB_GPU_SET_ACK);
+	return acked && pm_gx_on();
+}
+
+static void
+pm_gpu_clear(void)
+{
+	wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << OOB_GPU_SET_ACK);       /* gen7_gmu_oob_clear: BIT(31 - 2 * 0) */
+}
+
+/*
+ * ---- patch 0384: the fence interrupt ----
+ * KGSL (out/src/op-kernel/drivers/gpu/msm): the ring's last CP_EVENT_WRITE is CACHE_CLEAN | BIT(31) (IRQ) | BIT(27)
+ * (adreno_gen7_ringbuffer.c:372-379); RBBM_INT_0_MASK (0x38) holds GEN7_INT_MASK with RB_DONE_TS 17 and
+ * CACHE_CLEAN_TS 20 (adreno_gen7.h:193-206, gen7_reg.h:24-25, 607-608), written once per GPU boot
+ * (adreno_gen7_gmu.c:2578; not in the IFPC lists); gen7_irq_handler (adreno_gen7.c:1194-1222): GMU
+ * PWR_COL_KEEPALIVE (0x1f8c3) = 1, AHB fence must read ALLOW (gen7_irq_poll_fence: 100 x 1 us), RBBM_INT_0_STATUS
+ * read, RBBM_INT_CLEAR_CMD (0x37) = status, keepalive 0; bit 20 -> gen7_cp_callback (retire). The line is
+ * kgsl_3d0_irq, GIC SPI 0x12c level (out/live.dts:21063). Here the handler wakes every fence waiter
+ * (negroni_gpu_fence_sleep); the waiters keep a timed look (negronigpu_irq_poll_us) as the polled fallback.
+ * Armed only while GX is reachable: disarmed (and masked at the GIC) before a slumber, a recovery reset and a
+ * warm boot; armed again with GX held at their end. A storm (> GPU_IRQ_STORM a second) turns it off for the boot.
+ */
+#define REG_RBBM_INT_CLEAR_CMD  0x0037
+#define REG_RBBM_INT_0_MASK     0x0038
+#define GPU_INT_RB_DONE_TS      (1u << 17)
+#define GPU_INT_CACHE_CLEAN_TS  (1u << 20)
+#define GMU_PWR_COL_KEEPALIVE   0x1f8c3
+#define EVENT_WRITE_IRQ         (1u << 31)
+#define GPU_IRQ_STORM           20000
+
+extern int negroni_spi_register(uint32_t intid, bool edge, void (*fn)(void *, uint32_t), void *arg);
+extern void negroni_spi_enable(uint32_t intid, bool on);
+
+static bool gpu_irq_registered, gpu_irq_off;
+static bool gpu_irq_armed, gpu_irq_live, gpu_irq_masked;       /* atomics */
+static uint32_t gpu_irq_busy;                                   /* atomic: handlers running now */
+static uint32_t gpu_irq_count, gpu_irq_fences, gpu_irq_other, gpu_irq_unarmed, gpu_irq_gx_off, gpu_irq_fence_held;
+static uint32_t gpu_irq_status_or, gpu_irq_woken, gpu_irq_missed, gpu_irq_polled;
+static uint32_t gpu_fence_event;                                /* the waiters sleep on its address */
+
+/* GIC SPI handler, interrupt context, one CPU (the SPI is routed to the CPU that registered it) */
+static void
+gpu_irq(void *arg __unused, uint32_t intid)
+{
+	__atomic_fetch_add(&gpu_irq_busy, 1, __ATOMIC_SEQ_CST);
+	__atomic_fetch_add(&gpu_irq_count, 1, __ATOMIC_RELAXED);
+	if (!__atomic_load_n(&gpu_irq_armed, __ATOMIC_SEQ_CST)) {
+		/* a level line we must not clear now (GX in a transition): masked until the watch arms it again */
+		negroni_spi_enable(intid, false);
+		__atomic_store_n(&gpu_irq_masked, true, __ATOMIC_SEQ_CST);
+		gpu_irq_unarmed++;
+	} else {
+		wr(gmu + GMU_REG(GMU_PWR_COL_KEEPALIVE), 1);
+		__asm__ volatile ("dsb sy");
+		uint32_t i;
+		for (i = 0; i < 100 && rd(gmu + GMU_REG(GMU_AO_AHB_FENCE_CTRL)) != 0; i++) {
+			delay(1);
+		}
+		if (i == 100) {
+			/* gen7_irq_poll_fence: the status and clear registers are not reachable; the watch unmasks */
+			negroni_spi_enable(intid, false);
+			__atomic_store_n(&gpu_irq_masked, true, __ATOMIC_SEQ_CST);
+			gpu_irq_fence_held++;
+		} else if (!(rd(gpucc + GPUCC_GX_GDSCR) & GDSC_PWR_ON)) {
+			/* GX already collapsed: no RBBM register to read (the level went with GX) */
+			negroni_spi_enable(intid, false);
+			__atomic_store_n(&gpu_irq_masked, true, __ATOMIC_SEQ_CST);
+			gpu_irq_gx_off++;
+		} else {
+			uint32_t status = rd(gpu_regs + GPU_WORD(REG_RBBM_INT_0_STATUS));
+			wr(gpu_regs + GPU_WORD(REG_RBBM_INT_CLEAR_CMD), status);
+			__asm__ volatile ("dsb sy");
+			gpu_irq_status_or |= status;
+			if (status & (GPU_INT_CACHE_CLEAN_TS | GPU_INT_RB_DONE_TS)) {
+				gpu_irq_fences++;
+				__atomic_store_n(&gpu_irq_live, true, __ATOMIC_RELAXED);
+			} else {
+				gpu_irq_other++;
+			}
+		}
+		wr(gmu + GMU_REG(GMU_PWR_COL_KEEPALIVE), 0);
+	}
+	__atomic_fetch_sub(&gpu_irq_busy, 1, __ATOMIC_SEQ_CST);
+	thread_wakeup((event_t)&gpu_fence_event);
+}
+
+/* Before GX goes away (slumber, recovery reset, warm boot): no handler reads GX after this returns. */
+static void
+gpu_irq_disarm(void)
+{
+	if (!gpu_irq_registered) {
+		return;
+	}
+	__atomic_store_n(&gpu_irq_armed, false, __ATOMIC_SEQ_CST);
+	negroni_spi_enable(k_irq_intid, false);
+	__atomic_store_n(&gpu_irq_masked, true, __ATOMIC_SEQ_CST);
+	while (__atomic_load_n(&gpu_irq_busy, __ATOMIC_SEQ_CST) != 0) {
+		;
+	}
+}
+
+/* GX held (OOB GPU_SET or PM off): KGSL adreno_irqctrl(1) after each GPU boot, then the line on. */
+static void
+gpu_irq_arm(void)
+{
+	if (!gpu_irq_registered || gpu_irq_off) {
+		return;
+	}
+	wr(gpu_regs + GPU_WORD(REG_RBBM_INT_CLEAR_CMD), ~0u);
+	wr(gpu_regs + GPU_WORD(REG_RBBM_INT_0_MASK), GPU_INT_CACHE_CLEAN_TS | GPU_INT_RB_DONE_TS);
+	__asm__ volatile ("dsb sy");
+	__atomic_store_n(&gpu_irq_armed, true, __ATOMIC_SEQ_CST);
+	__atomic_store_n(&gpu_irq_masked, false, __ATOMIC_SEQ_CST);
+	negroni_spi_enable(k_irq_intid, true);
+	thread_wakeup((event_t)&gpu_fence_event);       /* waiters of fences the reset or the wake made done */
+}
+
+/* pm_start, GX held: register the SPI (thread context) and arm it */
+static void
+gpu_irq_start(void)
+{
+	if (!k_irq) {
+		printf("NEGRONI GPU IRQ: off (negronigpu_irq=0): fence waiters poll every 200 us\n");
+		return;
+	}
+	if (negroni_spi_register(k_irq_intid, false, gpu_irq, NULL) != 0) {
+		printf("NEGRONI GPU IRQ: INTID %u not registered (no GIC distributor or no free slot): fence waiters poll\n", k_irq_intid);
+		return;
+	}
+	gpu_irq_registered = true;
+	gpu_irq_arm();
+	printf("NEGRONI GPU IRQ: on: INTID %u (SPI %u, level), RBBM_INT_0_MASK %#x (CACHE_CLEAN_TS, RB_DONE_TS), the last fence "
+	    "of each submission raises it; waiters look again every %u us as the fallback\n", k_irq_intid, k_irq_intid - 32,
+	    GPU_INT_CACHE_CLEAN_TS | GPU_INT_RB_DONE_TS, k_irq_poll_us);
+}
+
+/*
+ * RedwoodGPU's wait between two looks at a fence (it holds no lock here): until the fence interrupt or the poll
+ * time. poll_us: the caller's polled interval (200 us); with the interrupt live, negronigpu_irq_poll_us.
+ */
+void negroni_gpu_fence_sleep(uint32_t fence, uint32_t poll_us);
+void
+negroni_gpu_fence_sleep(uint32_t fence, uint32_t poll_us)
+{
+	bool irq = __atomic_load_n(&gpu_irq_live, __ATOMIC_RELAXED) && __atomic_load_n(&gpu_irq_armed, __ATOMIC_RELAXED) &&
+	    !__atomic_load_n(&gpu_irq_masked, __ATOMIC_RELAXED);
+	uint32_t us = irq ? MAX(poll_us, k_irq_poll_us) : poll_us;
+
+	wait_result_t w = assert_wait_timeout((event_t)&gpu_fence_event, THREAD_UNINT, us, NSEC_PER_USEC);
+	if (w != THREAD_WAITING) {
+		return;
+	}
+	if (negroni_gpu_done(fence)) {
+		clear_wait(current_thread(), THREAD_AWAKENED);
+		return;
+	}
+	w = thread_block(THREAD_CONTINUE_NULL);
+	if (!irq) {
+		__atomic_fetch_add(&gpu_irq_polled, 1, __ATOMIC_RELAXED);
+	} else if (w == THREAD_AWAKENED) {
+		__atomic_fetch_add(&gpu_irq_woken, 1, __ATOMIC_RELAXED);
+	} else if (negroni_gpu_done(fence)) {
+		__atomic_fetch_add(&gpu_irq_missed, 1, __ATOMIC_RELAXED);      /* done, but no interrupt woke us */
+	}
+}
+
+/*
+ * The watch, once a second: unmask a line the handler masked (GX was off or the fence held), the storm guard, and
+ * the WATCH line's irq part. A second with many misses and no fence interrupt drops "live": the waiters poll at
+ * 200 us again until the next fence interrupt.
+ */
+static uint32_t gpu_irq_sec_count, gpu_irq_sec_fences, gpu_irq_sec_woken, gpu_irq_sec_missed;
+static void
+gpu_irq_second(char *buf, size_t size)
+{
+	uint32_t c = gpu_irq_count, f = gpu_irq_fences, wk = gpu_irq_woken, ms = gpu_irq_missed;
+	uint32_t dc = c - gpu_irq_sec_count, df = f - gpu_irq_sec_fences, dw = wk - gpu_irq_sec_woken, dm = ms - gpu_irq_sec_missed;
+
+	gpu_irq_sec_count = c;
+	gpu_irq_sec_fences = f;
+	gpu_irq_sec_woken = wk;
+	gpu_irq_sec_missed = ms;
+	if (!gpu_irq_registered) {
+		snprintf(buf, size, "irq off (polled %u)", gpu_irq_polled);
+		return;
+	}
+	if (!gpu_irq_off && dc > GPU_IRQ_STORM) {
+		gpu_irq_off = true;
+		gpu_irq_disarm();
+		__atomic_store_n(&gpu_irq_live, false, __ATOMIC_RELAXED);
+		printf("NEGRONI GPU IRQ: %u interrupts in a second (status bits %#x): off for this boot, fence waiters poll\n", dc,
+		    gpu_irq_status_or);
+	}
+	if (!gpu_irq_off && df == 0 && dm > 50) {
+		__atomic_store_n(&gpu_irq_live, false, __ATOMIC_RELAXED);
+	}
+	/*
+	 * gpu_pm_lock held: a slumber attempt that stopped early (lowest idle not reached, PREPARE_SLUMBER refused, GX not
+	 * back) can leave the line disarmed with the GPU awake. RBBM_INT_0_MASK lives on over IFPC (KGSL writes it once per
+	 * GPU boot), so arming needs no register write here.
+	 */
+	if (!gpu_irq_off && !__atomic_load_n(&gpu_irq_armed, __ATOMIC_SEQ_CST) && !pm_asleep && !pm_dead && !pm_rewaking &&
+	    !rec_active && gpu_kept) {
+		__atomic_store_n(&gpu_irq_armed, true, __ATOMIC_SEQ_CST);
+		__atomic_store_n(&gpu_irq_masked, true, __ATOMIC_SEQ_CST);     /* the next lines unmask it */
+	}
+	if (!gpu_irq_off && __atomic_load_n(&gpu_irq_armed, __ATOMIC_SEQ_CST) && __atomic_load_n(&gpu_irq_masked, __ATOMIC_SEQ_CST)) {
+		__atomic_store_n(&gpu_irq_masked, false, __ATOMIC_SEQ_CST);
+		negroni_spi_enable(k_irq_intid, true);
+	}
+	snprintf(buf, size, "irq %s %u/s fence %u/s woke %u missed %u | all %u fence %u gx-off %u held %u unarmed %u other %u bits %#x",
+	    gpu_irq_off ? "OFF" : __atomic_load_n(&gpu_irq_live, __ATOMIC_RELAXED) ? "live" : "armed", dc, df, dw, dm, c, f,
+	    gpu_irq_gx_off, gpu_irq_fence_held, gpu_irq_unarmed, gpu_irq_other, gpu_irq_status_or);
+}
+
+/* NegroniFramebuffer: backboardd's display power request (0258); 0384: governor min level, slumber with it off */
+static bool gpu_display_off;
+void negroni_gpu_display(bool on);
+void
+negroni_gpu_display(bool on)
+{
+	__atomic_store_n(&gpu_display_off, !on, __ATOMIC_RELAXED);
+	if (!on) {
+		thread_wakeup((event_t)&gpu_kept);      /* the watch drops the level now, not at its next tick */
+	}
+}
+uint32_t negroni_gpu_late_frames;               /* NegroniFramebuffer.cpp: one per "gpu-wait skip" (atomic) */
+
+/* PM_IFPC: where the CP has read the ring to at least, from the newest fence it wrote (no GX read) */
+static uint32_t
+pm_rptr_estimate(void)
+{
+	uint32_t done = negroni_gpu_completed();
+
+	if (k_rptr_shadow) {
+		/* 0298: the CP's own copy (RB_CNTL without BIT(27), CP_RB_RPTR_ADDR = scratch +0x80), as KGSL adreno_get_rptr */
+		volatile uint32_t *shadow = (volatile uint32_t *)(core_scratch.memory + 0x80);
+		to_memory((vm_offset_t)shadow, 4);
+		return *shadow % RING_WORDS;
+	}
+	if (gpu_fence - done >= 256) {
+		return (ring_at + 1) % RING_WORDS;      /* not known: no room */
+	}
+	return fence_pos[done & 255];
+}
+
+/* CP_RB_RPTR where it can be read; a collapsed or sleeping GX has read the ring to its end */
+static uint32_t
+pm_rptr_now(bool held)
+{
+	if (pm_mode == PM_OFF || (pm_mode == PM_SLUMBER && !pm_asleep) || (pm_mode == PM_IFPC && held)) {
+		return rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR));
+	}
+	return pm_gx_on() ? ~0u : ring_at;
+}
+
+/* CP_RB_WPTR; PM_IFPC: KGSL gen7_fenced_write, then OOB GPU_SET as the last try. false: not written. */
+static bool
+pm_wptr(uint32_t value)
+{
+	vm_offset_t reg = gpu_regs + GPU_WORD(REG_CP_RB_WPTR);
+	uint32_t i;
+
+	if (pm_mode != PM_IFPC) {
+		wr(reg, value);
+		return true;
+	}
+	uint64_t t0 = mach_absolute_time();
+	wr(reg, value);
+	for (i = 0; i < PM_FENCE_RETRIES; i++) {
+		__asm__ volatile ("dsb sy");
+		if (!(rd(gmu + GMU_REG(GMU_AHB_FENCE_STATUS)) & 1)) {
+			break;
+		}
+		delay(10);
+		wr(reg, value);
+	}
+	if (i > 0 && i < PM_FENCE_RETRIES) {
+		uint32_t us = pm_us_since(t0);
+		pm_fence_waits++;
+		pm_fence_max_us = MAX(pm_fence_max_us, us);
+		if (pm_fence_waits <= 8) {
+			printf("NEGRONI GPU PM: WPTR write dropped %u times (GX collapsed), taken after %u us\n", i, us);
+		}
+	}
+	if (i < PM_FENCE_RETRIES) {
+		return true;
+	}
+	pm_fence_fails++;
+	bool set = pm_gpu_set();
+	wr(reg, value);
+	__asm__ volatile ("dsb sy");
+	bool ok = set && !(rd(gmu + GMU_REG(GMU_AHB_FENCE_STATUS)) & 1);
+	pm_gpu_clear();
+	printf("NEGRONI GPU PM: WPTR write still dropped after %u us (%u tries): OOB GPU_SET %s, write %s, GX GDSC %#x, power state %#x\n",
+	    pm_us_since(t0), PM_FENCE_RETRIES, set ? "acked" : "NOT ACKED", ok ? "taken" : "LOST",
+	    rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)));
+	return ok;
+}
+
+/* PM_SLUMBER, the lock held, awake (GX held by OOB GPU_SET). false: not idle, or the GMU said no. */
+static bool
+pm_sleep(void)
+{
+	uint64_t t0 = mach_absolute_time();
+	uint32_t rptr = rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR)), status = rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS));
+
+	if (negroni_gpu_completed() != gpu_fence || rptr != ring_at || (status & ~1u)) {
+		return false;
+	}
+	/*
+	 * 0384: KGSL's order (gen7_power_off -> gen7_gmu_power_off -> gen7_gmu_notify_slumber, adreno_gen7_gmu.c:2795-2833,
+	 * 2513-2535, 1424-1450): interrupts off, OOB GPU_SET clear, wait for the lowest idle level (IFPC: power state 3 and
+	 * the GX clock off, gen7_gmu_wait_for_lowest_idle :696-760, 100 ms), the GMU power counter OFF ("so that the GMU is
+	 * not busy"; 0298 turned it on, and every 0298 boot got "PREPARE_SLUMBER ack, error 1002"), then PREPARE_SLUMBER
+	 * {bw, freq} of the DT's initial-pwrlevel 10 (285 MHz: perf index 13 - 10 - 1 = 2, bus-freq 2), not {0, 0}.
+	 */
+	gpu_irq_disarm();
+	pm_gpu_clear();
+	bool lowest = true;
+	if (pm_mode == PM_IFPC) {
+		lowest = false;
+		for (uint32_t i = 0; i < 1000 && !lowest; i++) {
+			lowest = rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)) == 3 && (rd(gmu + GMU_REG(GMU_GFX_PWR_CLK_STATUS)) & 3) != 0;
+			if (!lowest) {
+				delay(100);
+			}
+		}
+		if (!lowest && ++pm_lowest_missed <= 3) {
+			/* KGSL: gen7_gmu_power_off stops here (no slumber now); after 3 misses we send it anyway */
+			uint32_t ps = rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)), clk = rd(gmu + GMU_REG(GMU_GFX_PWR_CLK_STATUS));
+			bool back = pm_gpu_set();
+			if (back) {
+				gpu_irq_arm();
+			}
+			printf("NEGRONI GPU PM: no slumber now: lowest idle not reached in 100 ms (power state %#x, GFX_PWR_CLK_STATUS %#x, "
+			    "miss %u of 3); GX %s\n", ps, clk, pm_lowest_missed, back ? "held again" : "NOT BACK");
+			return false;
+		}
+	}
+	wr(gmu + GMU_REG(K_POWER_COUNTER_ENABLE), 0);
+	uint32_t slumber[3] = { 0, 2 /* bw: bus-freq of pwrlevel 10 */, 2 /* freq: perf index of 285 MHz */ };
+	hfi_quiet = true;
+	bool ok = hfi_send("PREPARE_SLUMBER", 33, slumber, sizeof(slumber));
+	hfi_quiet = false;
+	wr(gmu + GMU_REG(GMU_AO_AHB_FENCE_CTRL), 0);                    /* gen7_gmu_notify_slumber: fence to allow */
+	if (!ok) {
+		bool back = pm_gpu_set();
+		if (k_busy_pct) {
+			wr(gmu + GMU_REG(K_POWER_COUNTER_ENABLE), 1);
+		}
+		if (back) {
+			gpu_irq_arm();
+		}
+		pm_sleep_failed++;
+		printf("NEGRONI GPU PM: PREPARE_SLUMBER not acked (%u; lowest idle %s, ack word 2 = %u); GX %s\n", pm_sleep_failed,
+		    lowest ? "reached" : "NOT reached", hfi_ack[2], back ? "held again" : "NOT BACK");
+		if (pm_mode == PM_IFPC) {
+			/*
+			 * 0384: before, the third failure set PM_OFF with OOB GPU_SET held: GX never collapsed again for the boot
+			 * (every 0298 boot: "slumber off for this boot", then "pm off" in every WATCH line). Now only the IFPC-mode
+			 * slumber stops; IFPC goes on (pm_tick gives OOB GPU_SET back to the GMU).
+			 */
+			if (pm_sleep_failed >= 3) {
+				k_ifpc_slumber_ms = 0;
+				printf("NEGRONI GPU PM: IFPC-mode slumber off for this boot; IFPC stays on\n");
+			}
+		} else if (pm_sleep_failed >= 3 || !back) {
+			pm_mode = PM_OFF;
+			printf("NEGRONI GPU PM: slumber off for this boot\n");
+		}
+		return false;
+	}
+	bool idle = wait_for(gmu + GMU_REG(GMU_CX_BUSY_STATUS), 1u << 30, 0, 100);
+	bool gx_off = wait_for(gpucc + GPUCC_GX_GDSCR, GDSC_PWR_ON, 0, 100);
+	wr(gmu + GMU_REG(GMU_INTR_MASK), ~0u);
+	wr(gmu + GMU_REG(GMU_CM3_SYSRESET), 1);
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 1);
+	bool rsc = wait_for(rscc + RSCC_STATUS0, 1u << 16, 1u << 16, 100);
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 0);
+	/* 0298: gen7_halt_gbif (adreno_gen7_gmu.c:2492-2511): client halt, ARB halt, de-assert */
+	wr(gpu_regs + GPU_WORD(REG_GBIF_HALT), 1);
+	bool halt = wait_for(gpu_regs + GPU_WORD(K_GBIF_HALT_ACK), 1, 1, 100);
+	wr(gpu_regs + GPU_WORD(REG_GBIF_HALT), 2);
+	halt = wait_for(gpu_regs + GPU_WORD(K_GBIF_HALT_ACK), 2, 2, 100) && halt;
+	wr(gpu_regs + GPU_WORD(REG_GBIF_HALT), 0);
+	if (!halt && pm_gbif_logged++ < 4) {
+		printf("NEGRONI GPU PM: GBIF halt NOT ACKED at slumber (ack %#x)\n", rd(gpu_regs + GPU_WORD(K_GBIF_HALT_ACK)));
+	}
+	pm_asleep = true;
+	pm_asleep_at = mach_absolute_time();
+	gx_on = false;
+	pm_sleeps++;
+	if (pm_sleeps <= 8 || pm_sleeps % 100 == 0) {
+		printf("NEGRONI GPU PM: slumber %u in %u us: GMU %s, GX %s (GDSC %#x), RSC %s (%#x)\n", pm_sleeps, pm_us_since(t0),
+		    idle ? "idle" : "STILL BUSY", gx_off ? "off" : "STILL ON", rd(gpucc + GPUCC_GX_GDSCR), rsc ? "asleep" : "DID NOT SLEEP",
+		    rd(rscc + RSCC_STATUS0));
+	}
+	return true;
+}
+
+/*
+ * The lock held, the RSC asleep and the CM3 in reset: KGSL's warm boot (gen7_gmu_boot + gen7_gpu_boot):
+ * RSC wake, steps 14-18, the ring back to word 0, step 20, CP_SET_SECURE_MODE 0. OOB GPU_SET is held
+ * after it. Used by the slumber wake (0285) and the hang recovery (0287). loud: the steps log their lines.
+ */
+static bool
+gpu_warm_boot(bool loud, bool *rsc_awake)
+{
+	uint32_t pause = pause_ms;
+
+	if (!loud) {
+		adreno_quiet_thread = current_thread();
+	}
+	pause_ms = 0;
+	pm_rewaking = true;
+	gpu_irq_disarm();               /* 0384: no handler reads GX while the GMU and the core start again */
+	/*
+	 * 0298: KGSL gen7_gmu_boot flushes the SMMU TLB before each boot because CX may not have gone down
+	 * (adreno_gen7_gmu.c:1887-1892; here CX never goes down), and a fault recorded while asleep must not
+	 * fail step 20 (ring_run checks the FSR): print it, then clear it (write-1-to-clear).
+	 */
+	const struct gpu_space *spaces[2] = { &core_space, &gmu_space };
+	for (unsigned i = 0; i < 2; i++) {
+		uint32_t cb = smmu_cb(spaces[i]);
+		(void)space_faulted(spaces[i]);
+		wr(smmu + cb + SMMU_CB_FSR, rd(smmu + cb + SMMU_CB_FSR));
+		wr(smmu + cb + SMMU_CB_TLBIASID, spaces[i]->context);
+		wr(smmu + cb + SMMU_CB_TLBSYNC, 1);
+		(void)wait_for(smmu + cb + SMMU_CB_TLBSTATUS, 1, 0, 10);
+	}
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 1u << 1);
+	bool rsc = wait_for(gmu + GMU_REG(GMU_RSCC_CONTROL_ACK), 1u << 1, 1u << 1, 100) &&
+	    wait_for(rscc + RSCC_SEQ_BUSY_DRV0, ~0u, 0, 100);
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 0);
+	bool ok = rsc && step_gmu_firmware() && step_gmu_start() && step_hfi_start() && step_hfi_messages() &&
+	    step_core_power();
+	if (ok) {
+		ring_at = ring_sent = 0;        /* the CP starts at the ring's base again */
+		ok = step_core_start();
+	}
+	if (ok) {
+		ring_command(CP_SET_SECURE_MODE, 1);
+		ring(0);
+		ok = ring_run("leave secure mode (wake)");
+	}
+	if (ok) {
+		gpu_irq_arm();          /* 0384: KGSL adreno_irqctrl(1) at the end of each GPU boot; OOB GPU_SET is held here */
+	}
+	pm_rewaking = false;
+	pause_ms = pause;
+	adreno_quiet_thread = NULL;
+	*rsc_awake = rsc;
+	return ok;
+}
+
+/* PM_SLUMBER, the lock held, asleep: KGSL's warm boot. false: the GPU stays off for this boot (pm_dead). */
+static bool
+pm_wake(void)
+{
+	uint64_t t0 = mach_absolute_time();
+	uint32_t asleep_ms = pm_us_since(pm_asleep_at) / 1000;
+	bool loud = pm_wakes == 0, rsc;
+
+	if (loud) {
+		printf("NEGRONI GPU PM: first wake: steps 14-21 again with their lines (later wakes are quiet)\n");
+	}
+	bool ok = gpu_warm_boot(loud, &rsc);
+	if (!ok && pm_wake_retries < 8) {
+		/*
+		 * 0384: the slumber wake ran on the phone never before (0298 slumber always failed). One more try from the 0287
+		 * reset state (CM3 in reset, GBIF halts, RSC asleep), as KGSL's gen7_gmu_reset does before gen7_boot, before
+		 * the GPU is given up (pm_dead) for the boot.
+		 */
+		pm_wake_retries++;
+		printf("NEGRONI GPU PM: wake %u FAILED after %u us (RSC %s, GX GDSC %#x, FW_INIT_RESULT %#x): reset and one more try\n",
+		    pm_wakes + 1, pm_us_since(t0), rsc ? "awake" : "NOT AWAKE", rd(gpucc + GPUCC_GX_GDSCR),
+		    rd(gmu + GMU_REG(GMU_CM3_FW_INIT_RESULT)));
+		rec_reset(0, false);
+		ok = gpu_warm_boot(true, &rsc);
+	}
+	uint32_t us = pm_us_since(t0);
+	if (!ok) {
+		pm_dead = true;
+		printf("NEGRONI GPU PM: WAKE FAILED after %u us (RSC %s, GX GDSC %#x, FW_INIT_RESULT %#x): the GPU stays off\n", us,
+		    rsc ? "awake" : "NOT AWAKE", rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_CM3_FW_INIT_RESULT)));
+		return false;
+	}
+	pm_asleep = false;
+	if (pm_mode == PM_IFPC) {
+		/* 0298: woken from an IFPC-mode slumber: as pm_start, OOB GPU_SET back to the GMU */
+		if (pm_ifpc_ok) {
+			pm_gpu_clear();
+		} else {
+			pm_mode = pm_slumber_arg ? PM_SLUMBER : PM_OFF;
+			printf("NEGRONI GPU PM: the GMU refused IFPC after a wake: %s\n", pm_name());
+		}
+	}
+	pm_wakes++;
+	pm_wake_us = us;
+	pm_wake_max_us = MAX(pm_wake_max_us, us);
+	pm_revote = true;
+	gpu_invalidate_next = true;
+	if (pm_wakes <= 8 || pm_wakes % 100 == 0) {
+		printf("NEGRONI GPU PM: wake %u in %u us (asleep %u ms), GX GDSC %#x\n", pm_wakes, us, asleep_ms,
+		    rd(gpucc + GPUCC_GX_GDSCR));
+	}
+	return true;
+}
+
+/* After step 22 (gpu_keep): the mode, before the watch and the service start */
+static void
+pm_start(void)
+{
+	(void)PE_parse_boot_argn("negronigpu_slumber", &pm_slumber_arg, sizeof(pm_slumber_arg));
+	for (unsigned i = 0; i < 256; i++) {
+		fence_pos[i] = ring_at;
+	}
+	pm_last_submit = mach_absolute_time();
+	k_args();
+	hfi_runtime = true;             /* 0298: KGSL's HFI timeout from now on */
+	lck_mtx_lock(&gpu_pm_lock);
+	gpu_irq_start();                /* 0384: OOB GPU_SET is still held from step 18: RBBM_INT_0_MASK can be written */
+	lck_mtx_unlock(&gpu_pm_lock);
+	if (pm_ifpc_ok) {
+		printf("NEGRONI GPU PM: IFPC mode slumbers after %u ms idle%s (negronigpu_ifpc_slumber; 0 = never); HFI timeout %u ms\n",
+		    k_ifpc_slumber_ms, k_dispoff_slumber ? " with the display off (0384, negronigpu_dispoff_slumber=0: also on)" : "",
+		    k_hfi_ms);
+		lck_mtx_lock(&gpu_pm_lock);
+		pm_mode = PM_IFPC;
+		pm_gpu_clear();         /* KGSL gen7_gpu_boot: oob_clear(oob_gpu) once the GPU runs */
+		lck_mtx_unlock(&gpu_pm_lock);
+		printf("NEGRONI GPU PM: IFPC on: OOB GPU_SET released, the GMU collapses GX 300 us after the work; WPTR "
+		    "writes fenced; GX GDSC %#x, power state %#x\n", rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)));
+	} else if (pm_slumber_arg) {
+		pm_mode = PM_SLUMBER;
+		printf("NEGRONI GPU PM: IFPC %s: slumber after %u ms idle, warm GMU restart on the next submission\n",
+		    pm_ifpc_arg ? "refused by the GMU" : "off (negronigpu_ifpc=0)", PM_SLUMBER_MS);
+	} else {
+		printf("NEGRONI GPU PM: off (IFPC %s, negronigpu_slumber=0): GX stays powered\n",
+		    pm_ifpc_arg ? "refused" : "off");
+	}
+}
+
+/* One watch tick, the lock held: the collapse sample, the slumber decision, the never-collapses check */
+static void
+pm_tick(uint32_t idle_for_ms, bool gx, bool late_done)
+{
+	if (pm_mode == PM_OFF) {
+		return;
+	}
+	pm_samples++;
+	pm_collapsed += !gx;
+	pm_gmu_off += (rd(gmu + GMU_REG(GMU_GFX_PWR_CLK_STATUS)) & 1) != 0;
+	if (pm_mode == PM_IFPC) {
+		if (!gx) {
+			pm_seen_collapse = true;
+		} else if (!pm_seen_collapse && idle_for_ms >= PM_NEVER_COLLAPSED_MS) {
+			pm_seen_collapse = true;
+			bool held = pm_slumber_arg && pm_gpu_set();
+			printf("NEGRONI GPU PM: IFPC acked, but GX never collapsed in %u ms of idle (power state %#x): %s\n",
+			    idle_for_ms, rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)),
+			    !pm_slumber_arg ? "kept (negronigpu_slumber=0)" : held ? "OOB GPU_SET again, slumber instead" : "OOB GPU_SET NOT ACKED, IFPC kept");
+			if (held) {
+				pm_mode = PM_SLUMBER;
+			}
+		}
+		/*
+		 * 0298: KGSL slumbers from IFPC after its idle timer too (gmu_idle_check -> gen7_power_off ->
+		 * gen7_gmu_power_off, adreno_gen7_gmu.c:2870-2913, 2795-2868, 2513-2560): OOB GPU_SET, then the
+		 * slumber sequence of pm_sleep (it checks the ring is idle, PREPARE_SLUMBER, RSC sleep, GBIF halt).
+		 */
+		if (pm_mode == PM_IFPC && k_ifpc_slumber_ms && !pm_asleep && late_done && idle_for_ms >= k_ifpc_slumber_ms &&
+		    (!k_dispoff_slumber || __atomic_load_n(&gpu_display_off, __ATOMIC_RELAXED))) {
+			if (!pm_gpu_set()) {
+				pm_gpu_clear();
+				if (pm_ifpc_skips++ < 4) {
+					printf("NEGRONI GPU PM: IFPC slumber skipped: OOB GPU_SET not acked (GX GDSC %#x)\n", rd(gpucc + GPUCC_GX_GDSCR));
+				}
+			} else if (pm_sleep()) {
+				pm_ifpc_sleeps++;
+			} else if (pm_mode == PM_IFPC) {
+				pm_gpu_clear();         /* not idle (or the GMU said no): back to IFPC */
+			}
+		}
+		return;
+	}
+	if (!pm_asleep && late_done && idle_for_ms >= PM_SLUMBER_MS) {
+		(void)pm_sleep();
+	}
+}
+
+/* The WATCH line's power part; starts the next sample window */
+static void
+pm_line(char *buf, size_t size)
+{
+	uint32_t pct = pm_samples ? pm_collapsed * 100 / pm_samples : 0, gpct = pm_samples ? pm_gmu_off * 100 / pm_samples : 0;
+
+	if (pm_mode == PM_IFPC) {
+		snprintf(buf, size, "pm %s GX collapsed %u%% gmu %u%% pwr %#x fenced %u max %uus fail %u slumbers %u wakes %u busy %u%%",
+		    pm_name(), pct, gpct, rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)), pm_fence_waits, pm_fence_max_us, pm_fence_fails,
+		    pm_ifpc_sleeps, pm_wakes, busy_acc_ao ? (uint32_t)(busy_acc_xo * 100 / busy_acc_ao) : 0);
+		busy_acc_xo = busy_acc_ao = 0;
+	} else if (pm_mode == PM_SLUMBER) {
+		snprintf(buf, size, "pm %s GX collapsed %u%% sleeps %u wakes %u last %uus max %uus", pm_name(), pct, pm_sleeps,
+		    pm_wakes, pm_wake_us, pm_wake_max_us);
+	} else {
+		snprintf(buf, size, "pm off");
+	}
+	pm_samples = pm_collapsed = pm_gmu_off = 0;
+}
+
+bool
+negroni_gpu_ready(void)
+{
+	return gpu_kept;
+}
+
+/* msm GET_PARAM (Linux adreno_get_param for the A730; numbers from msm_drm.h) */
+bool
+negroni_gpu_parameter(uint32_t which, uint64_t *value)
+{
+	switch (which) {
+	case 0x01:                      /* GPU_ID: none, CHIP_ID says it */
+	case 0x06:                      /* GMEM_BASE */
+	case 0x08:                      /* PP_PGTABLE */
+	case 0x09:                      /* FAULTS */
+	case 0x0a:                      /* SUSPENDS */
+	case 0x11:                      /* RAYTRACING */
+		*value = 0;
+		return true;
+	case 0x02:                      /* GMEM_SIZE (adreno_device.c: A730 SZ_2M) */
+		*value = 2u << 20;
+		return true;
+	case 0x03:                      /* CHIP_ID */
+		*value = GPU_CHIP_ID;
+		return true;
+	case 0x04:                      /* MAX_FREQ */
+		*value = 818000000ull;
+		return true;
+	case 0x05:                      /* TIMESTAMP */
+		*value = mach_absolute_time();
+		return true;
+	case 0x07:                      /* PRIORITIES */
+		*value = 1;
+		return true;
+	case 0x10:                      /* HIGHEST_BANK_BIT (step 20: hbb 16) */
+		*value = 16;
+		return true;
+	case 0x12:                      /* UBWC_SWIZZLE */
+		*value = 6;
+		return true;
+	case 0x13:                      /* MACROTILE_MODE */
+		*value = 1;
+		return true;
+	default:
+		return false;
+	}
+}
+
+static uint64_t
+gpu_address_span(uint64_t size)
+{
+	return (size + (GPU_ADDRESS_GRANULE - 1)) & ~(GPU_ADDRESS_GRANULE - 1);
+}
+
+/* First fit out of a free list; the address is the caller's until heap_free(). 0: none left. */
+static uint64_t
+heap_alloc(struct gpu_heap *heap, uint64_t size)
+{
+	struct gpu_range *f = heap->free;
+
+	size = gpu_address_span(size);
+	for (unsigned i = 0; i < heap->count; i++) {
+		if (f[i].size >= size) {
+			uint64_t address = f[i].start;
+
+			f[i].start += size;
+			f[i].size -= size;
+			if (f[i].size == 0) {
+				memmove(&f[i], &f[i + 1], (--heap->count - i) * sizeof(f[0]));
+			}
+			return address;
+		}
+	}
+	return 0;
+}
+
+static void
+heap_free(struct gpu_heap *heap, uint64_t address, uint64_t size)
+{
+	struct gpu_range *f = heap->free;
+	unsigned at;
+
+	size = gpu_address_span(size);
+	for (at = 0; at < heap->count && f[at].start < address; at++) {
+	}
+	if (at > 0 && f[at - 1].start + f[at - 1].size == address) {
+		f[at - 1].size += size;
+		if (at < heap->count && address + size == f[at].start) {
+			f[at - 1].size += f[at].size;
+			memmove(&f[at], &f[at + 1], (--heap->count - at) * sizeof(f[0]));
+		}
+	} else if (at < heap->count && address + size == f[at].start) {
+		f[at].start = address;
+		f[at].size += size;
+	} else if (heap->count < heap->cap) {
+		memmove(&f[at + 1], &f[at], (heap->count++ - at) * sizeof(f[0]));
+		f[at].start = address;
+		f[at].size = size;
+	}
+}
+
+/* The kernel's GPU addresses (every client's too with negronigpu_pt=0). 0: none left. */
+uint64_t
+negroni_gpu_address(uint64_t size)
+{
+	return heap_alloc(&gpu_heap, size);
+}
+
+void
+negroni_gpu_address_free(uint64_t address, uint64_t size)
+{
+	heap_free(&gpu_heap, address, size);
+}
+
+bool
+negroni_gpu_map(uint64_t address, uint64_t phys, bool read_only)
+{
+	return space_map(&core_space, address, phys, PTE_GMU | PTE_UNPRIVILEGED | (read_only ? PTE_READ_ONLY : 0));
+}
+
+/* The SMMU's TLB for the 3D core's context forgotten (space_map already put every entry in memory). */
+void
+negroni_gpu_mapped(void)
+{
+	uint32_t cb = smmu_cb(&core_space);
+
+	__asm__ volatile ("dsb sy");
+	wr(smmu + cb + SMMU_CB_TLBIASID, core_space.context);
+	wr(smmu + cb + SMMU_CB_TLBSYNC, 1);
+	for (int i = 0; i < 1000 && (rd(smmu + cb + SMMU_CB_TLBSTATUS) & 1); i++) {
+	}
+}
+
+void
+negroni_gpu_unmap(uint64_t address, uint64_t size)
+{
+	for (uint64_t offset = 0; offset < size; offset += 4096) {
+		space_map(&core_space, address + offset, 0, 0);
+	}
+	negroni_gpu_mapped();
+}
+
+void
+negroni_gpu_to_memory(void *start, uint64_t size)
+{
+	if (start == NULL) {
+		__asm__ volatile ("dsb sy");
+		return;
+	}
+	to_memory((vm_offset_t)start, size);
+}
+
+bool
+negroni_gpu_done(uint32_t fence)
+{
+	volatile uint32_t *word = (volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT);
+
+	to_memory((vm_offset_t)word, 4);
+	return (int32_t)(*word - fence) >= 0;
+}
+
+uint32_t
+negroni_gpu_last(void)
+{
+	return gpu_fence;
+}
+
+/* The fence the 3D core wrote last (submissions up to it are done). */
+uint32_t
+negroni_gpu_completed(void)
+{
+	volatile uint32_t *word = (volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT);
+
+	to_memory((vm_offset_t)word, 4);
+	return *word;
+}
+
+/* 0 (nothing to wait for) or a fence some submission has been given; not one still to come. */
+bool
+negroni_gpu_fence_valid(uint32_t fence)
+{
+	return fence == 0 || (int32_t)(fence - gpu_fence) <= 0;
+}
+
+/*
+ * Whether the boot-args ask for the kept GPU and its service (negroniadreno >= 22,
+ * negroniadreno_keep=1, negroniadreno_service not 0). Only boot-args: callable before the ladder
+ * has run (IOKit matching on the framebuffer runs before the root device is found).
+ */
+bool
+negroni_gpu_expected(void)
+{
+	uint32_t last = 0, keep = 0, service = 1;
+
+	(void)PE_parse_boot_argn("negroniadreno", &last, sizeof(last));
+	(void)PE_parse_boot_argn("negroniadreno_keep", &keep, sizeof(keep));
+	(void)PE_parse_boot_argn("negroniadreno_service", &service, sizeof(service));
+	return last >= 22 && keep != 0 && service != 0;
+}
+
+/* ---- per-client tables (negronigpu_pt=1) ---- */
+
+bool
+negroni_gpu_per_client(void)
+{
+	return gpu_per_client;
+}
+
+/* A zeroed 4K table of vm's (tables come four to a PAGE_SIZE page, given back with the vm). */
+static uint64_t *
+vm_new_table(struct negroni_gpu_vm *vm)
+{
+	uint64_t *table;
+
+	if (vm->tables_left == 0) {
+		vm_offset_t page = 0;
+		if (vm->page_count == GPU_VM_PAGES ||
+		    kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		vm->pages[vm->page_count++] = page;
+		vm->tables_left = PAGE_SIZE / 4096;
+	}
+	table = (uint64_t *)(vm->pages[vm->page_count - 1] + PAGE_SIZE - 4096 * vm->tables_left--);
+	to_memory((vm_offset_t)table, 4096);    /* zeroed: the walker must not see old lines */
+	return table;
+}
+
+/* The level-3 entry for address in vm's tables (made on the way when make is set), or NULL. */
+static uint64_t *
+vm_entry(struct negroni_gpu_vm *vm, uint64_t address, bool make)
+{
+	uint64_t *table = vm->root;
+
+	for (unsigned shift = 30; shift >= 21; shift -= 9) {
+		uint64_t *entry = &table[(address >> shift) & 0x1ff];
+		if (*entry & 1) {
+			table = (uint64_t *)phystokv(*entry & PTE_ADDRESS);
+			continue;
+		}
+		if (!make || (table = vm_new_table(vm)) == NULL) {
+			return NULL;
+		}
+		*entry = kvtophys((vm_offset_t)table) | PTE_TABLE;
+		to_memory((vm_offset_t)entry, sizeof(*entry));
+	}
+	return &table[(address >> 12) & 0x1ff];
+}
+
+/*
+ * A client's tables: a root whose kernel entries are the kernel's (the same level-2 tables, made
+ * at gpu_keep), its own address list. NULL when negronigpu_pt is 0 or there is no memory.
+ * gGPULock held (NegroniGPU.cpp), as for every negroni_gpu_vm_* call.
+ */
+struct negroni_gpu_vm *
+negroni_gpu_vm_create(void)
+{
+	struct negroni_gpu_vm *vm = NULL;
+
+	if (!gpu_per_client || !gpu_kept || core_space.root == NULL ||
+	    kmem_alloc(kernel_map, (vm_offset_t *)&vm, round_page(sizeof(*vm)), KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return NULL;
+	}
+	vm->root = vm_new_table(vm);
+	if (vm->root == NULL) {
+		(void)negroni_gpu_vm_destroy(vm);
+		return NULL;
+	}
+	for (unsigned i = 0; i < GPU_KERNEL_ROOTS; i++) {
+		vm->root[i] = core_space.root[i];
+	}
+	to_memory((vm_offset_t)vm->root, 4096);
+	vm->root_phys = kvtophys((vm_offset_t)vm->root);
+	vm->heap.free = vm->ranges;
+	vm->heap.cap = sizeof(vm->ranges) / sizeof(vm->ranges[0]);
+	vm->ranges[0].start = GPU_VM_HEAP_START;
+	vm->ranges[0].size = GPU_VM_HEAP_SIZE;
+	vm->heap.count = 1;
+	return vm;
+}
+
+/*
+ * Its tables given back. The 3D core must not be able to walk them: when they are the context's
+ * now, the context goes back to the kernel's tables first (the caller waited for the GPU); if that
+ * cannot be done, everything stays allocated (false: leaked on purpose).
+ */
+bool
+negroni_gpu_vm_destroy(struct negroni_gpu_vm *vm)
+{
+	if (vm == NULL) {
+		return true;
+	}
+	if (vm->root_phys != 0 && gpu_root_current == vm->root_phys && !negroni_gpu_vm_switch(NULL)) {
+		printf("NEGRONI GPU: a client's tables are still the GPU's: kept\n");
+		return false;
+	}
+	for (unsigned i = 0; i < vm->page_count; i++) {
+		kmem_free(kernel_map, vm->pages[i], PAGE_SIZE);
+	}
+	kmem_free(kernel_map, (vm_offset_t)vm, round_page(sizeof(*vm)));
+	return true;
+}
+
+/* vm NULL: the kernel's addresses. */
+uint64_t
+negroni_gpu_vm_address(struct negroni_gpu_vm *vm, uint64_t size)
+{
+	return vm == NULL ? negroni_gpu_address(size) : heap_alloc(&vm->heap, size);
+}
+
+void
+negroni_gpu_vm_address_free(struct negroni_gpu_vm *vm, uint64_t address, uint64_t size)
+{
+	if (vm == NULL) {
+		negroni_gpu_address_free(address, size);
+	} else {
+		heap_free(&vm->heap, address, size);
+	}
+}
+
+/* One 4K page at a client address (never in the kernel's part); vm NULL: the kernel's tables. */
+bool
+negroni_gpu_vm_map(struct negroni_gpu_vm *vm, uint64_t address, uint64_t phys, bool read_only)
+{
+	uint64_t *entry;
+
+	if (vm == NULL) {
+		return negroni_gpu_map(address, phys, read_only);
+	}
+	if ((address >> 39) || (address >> 30) < GPU_KERNEL_ROOTS || phys == 0 ||
+	    (entry = vm_entry(vm, address, true)) == NULL) {
+		return false;
+	}
+	*entry = phys | PTE_GMU | PTE_UNPRIVILEGED | (read_only ? PTE_READ_ONLY : 0) | PTE_PAGE;
+	to_memory((vm_offset_t)entry, sizeof(*entry));
+	return true;
+}
+
+void
+negroni_gpu_vm_unmap(struct negroni_gpu_vm *vm, uint64_t address, uint64_t size)
+{
+	if (vm == NULL) {
+		negroni_gpu_unmap(address, size);
+		return;
+	}
+	for (uint64_t offset = 0; offset < size; offset += 4096) {
+		uint64_t a = address + offset, *entry;
+		if (!(a >> 39) && (a >> 30) >= GPU_KERNEL_ROOTS && (entry = vm_entry(vm, a, false)) != NULL) {
+			*entry = 0;
+			to_memory((vm_offset_t)entry, sizeof(*entry));
+		}
+	}
+	negroni_gpu_vm_mapped(vm);
+}
+
+/* After map/unmap: the TLB forgotten if these are the context's tables now (the next switch flushes it otherwise). */
+void
+negroni_gpu_vm_mapped(struct negroni_gpu_vm *vm)
+{
+	if (vm == NULL || gpu_root_current == vm->root_phys) {
+		negroni_gpu_mapped();
+	}
+}
+
+/* vm's tables (NULL: the kernel's) are the 3D core's context's now. */
+bool
+negroni_gpu_vm_current(const struct negroni_gpu_vm *vm)
+{
+	return gpu_root_current == (vm != NULL ? vm->root_phys : core_space.tables[0].phys);
+}
+
+/*
+ * The 3D core's context to vm's tables (NULL: the kernel's). Only while the core is idle: every
+ * submission's fence done (the caller waits for negroni_gpu_last() first) and the ring read to its
+ * end. false: not idle, or the context did not take the new TTBR0.
+ */
+bool
+negroni_gpu_vm_switch(struct negroni_gpu_vm *vm)
+{
+	static unsigned logged;
+	uint64_t root = vm != NULL ? vm->root_phys : core_space.tables[0].phys;
+	uint64_t ttbr = root | (uint64_t)core_space.context << 48;
+	uint32_t cb = smmu_cb(&core_space), rptr = ~0u;
+
+	if (!gpu_kept || root == 0) {
+		return false;
+	}
+	if (root == gpu_root_current) {
+		return true;
+	}
+	if (!negroni_gpu_done(gpu_fence)) {
+		return false;
+	}
+	lck_mtx_lock(&gpu_pm_lock);     /* patch 0285 */
+	bool held = pm_mode == PM_IFPC && pm_gx_on() && gx_hold();
+	for (unsigned i = 0; i < GPU_IDLE_US / 10 && (rptr = pm_rptr_now(held)) != ring_at; i++) {
+		delay(10);
+	}
+	if (held) {
+		gx_release();
+	}
+	lck_mtx_unlock(&gpu_pm_lock);
+	if (rptr != ring_at) {
+		printf("NEGRONI GPU: no table switch: the ring is read to %u of %u\n", rptr, ring_at);
+		return false;
+	}
+	__asm__ volatile ("dsb sy");
+	wr(smmu + cb + SMMU_CB_TTBR0, (uint32_t)ttbr);
+	wr(smmu + cb + SMMU_CB_TTBR0 + 4, (uint32_t)(ttbr >> 32));
+	__asm__ volatile ("dsb sy");
+	gpu_root_current = root;                /* whatever the read-back says: the TLB goes either way */
+	negroni_gpu_mapped();
+	gpu_invalidate_next = true;
+	if (rd(smmu + cb + SMMU_CB_TTBR0) != (uint32_t)ttbr || rd(smmu + cb + SMMU_CB_TTBR0 + 4) != (uint32_t)(ttbr >> 32)) {
+		printf("NEGRONI GPU: the SMMU context did not take TTBR0 %#llx (reads %#x:%#x): per-client tables off\n",
+		    ttbr, rd(smmu + cb + SMMU_CB_TTBR0 + 4), rd(smmu + cb + SMMU_CB_TTBR0));
+		return false;
+	}
+	if (logged < 8) {
+		logged++;
+		printf("NEGRONI GPU: the 3D core's tables are now %s (root %#llx)\n", vm != NULL ? "a client's" : "the kernel's",
+		    root);
+	}
+	return true;
+}
+
+/* A client's own window (MSM_PARAM_VA_START/VA_SIZE) with negronigpu_pt=1: the same place in every client's tables. */
+uint64_t
+negroni_gpu_vm_window(uint64_t *size)
+{
+	*size = GPU_VM_WINDOW_SIZE;
+	return GPU_VM_WINDOW_START;
+}
+
+static void
+ring_fence(uint32_t event, uint32_t at, uint32_t fence)
+{
+	ring_command(CP_EVENT_WRITE7, 4);
+	/* 0384: the last fence of a submission raises CACHE_CLEAN_TS (KGSL: CACHE_CLEAN | BIT(31) | BIT(27)) */
+	ring(event | EVENT_WRITE_ENABLED | (at == GPU_FENCE_AT && gpu_irq_registered ? EVENT_WRITE_IRQ : 0));
+	ring(CORE_SCRATCH_ADDRESS + at);
+	ring(0);
+	ring(fence);
+}
+
+/* Command buffers, in order (an address and a count of words each), as Linux's a7xx_submit. 0: the ring stays full. */
+uint32_t
+negroni_gpu_submit(const uint64_t *addresses, const uint32_t *words, uint32_t count)
+{
+	uint32_t wanted = 50 + 4 * count, room = 0;
+
+	/* patch 0285: one lock with the watch's votes and the slumber; a sleeping GPU is woken first */
+	lck_mtx_lock(&gpu_pm_lock);
+	if (pm_dead || (pm_asleep && !pm_wake())) {        /* 0298: a slumber from IFPC mode wakes the same way */
+		lck_mtx_unlock(&gpu_pm_lock);
+		return 0;
+	}
+	for (int i = 0; i < 20000; i++) {
+		uint32_t rptr = pm_mode == PM_IFPC ? pm_rptr_estimate() : rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR));
+		room = (rptr + RING_WORDS - ring_at - 1) % RING_WORDS;
+		if (room >= wanted) {
+			break;
+		}
+		delay(100);
+	}
+	if (room < wanted) {
+		lck_mtx_unlock(&gpu_pm_lock);
+		return 0;
+	}
+	if (++gpu_fence == 0) {
+		gpu_fence = 1;
+	}
+	ring_command(CP_THREAD_CONTROL, 1);
+	ring(CP_SYNC_THREADS | CP_SET_THREAD_BR);
+	ring_command(CP_THREAD_CONTROL, 1);
+	ring(CP_SET_THREAD_BOTH);
+	if (gpu_invalidate_next) {
+		/* new tables since the last submission: nothing the GPU cached under the old ones stays */
+		ring_command(CP_EVENT_WRITE7, 1);
+		ring(EVENT_CACHE_INVALIDATE7);
+		gpu_invalidate_next = false;
+	}
+	ring_command(CP_SET_MARKER, 1);
+	ring(0x101);                    /* IFPC disable */
+	ring_command(CP_SET_MARKER, 1);
+	ring(0x00d);                    /* IB1LIST start */
+	for (uint32_t i = 0; i < count; i++) {
+		ring_command(CP_INDIRECT_BUFFER_PFE, 3);
+		ring((uint32_t)addresses[i]);
+		ring((uint32_t)(addresses[i] >> 32));
+		ring(words[i]);
+	}
+	ring_command(CP_SET_MARKER, 1);
+	ring(0x00e);                    /* IB1LIST end */
+	ring_register(REG_CP_SCRATCH_REG2, gpu_fence);
+	ring_command(CP_THREAD_CONTROL, 1);
+	ring(CP_SET_THREAD_BR);
+	ring_command(CP_EVENT_WRITE7, 1);
+	ring(EVENT_CCU_INVALIDATE_DEPTH);
+	ring_command(CP_EVENT_WRITE7, 1);
+	ring(EVENT_CCU_INVALIDATE_COLOR);
+	ring_command(CP_THREAD_CONTROL, 1);
+	ring(CP_SET_THREAD_BV);
+	ring_fence(EVENT_CACHE_CLEAN, GPU_BV_FENCE_AT, gpu_fence);
+	ring_command(CP_THREAD_CONTROL, 1);
+	ring(CP_SET_THREAD_BR);
+	ring_command(CP_WAIT_TIMESTAMP, 4);
+	ring(0);
+	ring(CORE_SCRATCH_ADDRESS + GPU_BV_FENCE_AT);
+	ring(0);
+	ring(gpu_fence);
+	ring_fence(EVENT_CACHE_CLEAN, GPU_FENCE_AT, gpu_fence);
+	fence_pos[gpu_fence & 255] = ring_at;   /* 0285: read to here at least once this fence is written */
+	ring_command(CP_THREAD_CONTROL, 1);
+	ring(CP_SET_THREAD_BOTH);
+	ring_command(CP_SET_MARKER, 1);
+	ring(0x100);                    /* IFPC enable */
+	if (ring_at >= ring_sent) {
+		to_memory(core_ring.memory + 4 * ring_sent, 4 * (ring_at - ring_sent));
+	} else {
+		to_memory(core_ring.memory + 4 * ring_sent, 4 * (RING_WORDS - ring_sent));
+		to_memory(core_ring.memory, 4 * ring_at);
+	}
+	ring_sent = ring_at;
+	bool written = pm_wptr(ring_at);
+	pm_last_submit = mach_absolute_time();
+	bool wake_watch = pm_watch_idle;
+	lck_mtx_unlock(&gpu_pm_lock);
+	if (wake_watch) {
+		thread_wakeup((event_t)&gpu_kept);      /* the watch leaves its 250 ms idle ticks */
+	}
+	return written ? gpu_fence : 0;
+}
+
+/* A submission that does not come back: what the core and its SMMU context say. */
+void
+negroni_gpu_report(const char *why)
+{
+	lck_mtx_lock(&gpu_pm_lock);     /* patch 0285 */
+	bool held = (pm_mode != PM_IFPC || pm_gx_on()) && gx_hold();
+	if (held) {
+		printf("NEGRONI GPU: %s: fence %u of %u, rptr %u wptr %u, RBBM_STATUS %#x, CP_HW_FAULT %#x, CP_INT %#x, scratch2 %u (pm %s)\n",
+		    why, *(volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT), gpu_fence,
+		    rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR)), ring_at, rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_HW_FAULT)), rd(gpu_regs + GPU_WORD(REG_CP_INTERRUPT_STATUS)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_SCRATCH_REG2)), pm_name());
+		gx_release();
+	} else {
+		printf("NEGRONI GPU: %s: fence %u of %u, wptr %u, pm %s, GX GDSC %#x, power state %#x: GX not read\n", why,
+		    *(volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT), gpu_fence, ring_at, pm_name(),
+		    rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)));
+	}
+	lck_mtx_unlock(&gpu_pm_lock);
+	if (gpu_per_client) {
+		uint32_t cb = smmu_cb(&core_space);
+		printf("NEGRONI GPU: tables %#llx (kernel's %#llx), TTBR0 %#x:%#x\n", gpu_root_current, core_space.tables[0].phys,
+		    rd(smmu + cb + SMMU_CB_TTBR0 + 4), rd(smmu + cb + SMMU_CB_TTBR0));
+	}
+	space_faulted(&core_space);
+}
+
+/*
+ * ---- patch 0287: GPU hang detection and recovery ----
+ *
+ * Before 0287 a lost WPTR write, a full ring or 2 s without a fence set gGPUStopped (NegroniGPU.cpp)
+ * for the rest of the boot: every fence then read done, and the display went on with CPU copies.
+ * Reference: the OnePlus KGSL (out/src/op-kernel/drivers/gpu/msm). The A730 is gen7_0_0 with the
+ * non-hwsched dispatcher (adreno-gpulist.h:2045-2073, .gpudev = adreno_gen7_gmu_gpudev); its reset is
+ * gen7_gmu_reset (adreno_gen7.c:1507-1517, adreno_gen7_gmu.c:3127-3146):
+ *   detect   adreno_dispatch.c: drawobj timeout 2000 ms (:50, _adreno_dispatch_check_timeout :2315-2344),
+ *            fault interrupts (adreno_gen7.c:1123-1156: MISHANGDETECT 23, CP_HW_ERROR 9, GPC_ERR 7, UCHE OOB 24),
+ *            GMU AO interrupts (adreno_gen7_gmu.c:1693-1725: watchdog bite bit 0), SMMU page faults;
+ *   log      dispatcher_do_fault (adreno_dispatch.c:1964-2148): RBBM_STATUS/STATUS3, CP_RB_BASE, CP_IB1_BASE,
+ *            snapshot (GMU log);
+ *   reset    gen7_gmu_reset: GPU/GMU interrupts off, HFI stop, gen7_gmu_suspend -> gen7_gmu_pwrctrl_suspend
+ *            (adreno_gen7_gmu.c:1354-1410): AHB fence ALLOW, CM3_SYSRESET 1, GBIF GX halt (if GX on), GBIF CX
+ *            halt, RBBM_SW_RESET_CMD 1 (if GX on), 100 us, GX GDSC off from the CPU; clocks and CX off;
+ *            then gen7_boot (warm boot, the 0285 wake path here);
+ *   fences   the hung ring's timestamps are written as retired (adreno_dispatch.c:2109-2121), the waiters
+ *            see them; Turnip sees MSM_PARAM_FAULTS change (device lost);
+ *   bound    _fault_throttle 3 per 3000 ms per context (adreno_dispatch.c:34-35); here REC_MAX per 60 s for
+ *            the whole GPU, then the GPU stays stopped as before 0287.
+ * Differences: no IRQ (the watch thread polls once a second); CX and the GMU clocks stay on (the RSC sleep
+ * sequence of 0285 instead of CX off); the GX GDSC is collapsed from the CPU only with negronigpu_recover=2.
+ * Boot-args: negronigpu_recover (default 1; 0 = the old stop for good), negronigpu_recover_max (default 3,
+ * 1..16, per 60 s), negronigpu_recover_watch (default 1: the watch thread detects too).
+ */
+#define REC_WINDOW_MS           60000
+#define REC_STALL_MS            2000            /* = RedwoodGPU's GPU_HUNG_MS and KGSL's adreno_drawobj_timeout */
+#define REC_HISTORY             16
+#define REG_RBBM_STATUS3        0x0213
+#define REG_RBBM_SW_RESET_CMD   0x0043
+#define REG_RBBM_GBIF_HALT_ACK  0x0017
+#define REG_GBIF_HALT_ACK       0x3c46
+#define REG_CP_PROTECT_STATUS   0x0824
+#define REG_CP_IB1_BASE         0x0928
+#define REG_CP_IB1_REM_SIZE     0x092a
+#define REG_CP_IB2_BASE         0x092b
+#define REG_CP_IB2_REM_SIZE     0x092d
+#define GMU_AO_HOST_INTERRUPT_CLR    0x23b04
+#define GMU_AO_HOST_INTERRUPT_STATUS 0x23b05
+#define GMU_AHB_FENCE_STATUS_CLR     0x23b14
+#define GMU_AO_INT_WDOG_BITE    (1u << 0)
+
+extern void NegroniGPUWatchFault(const char *why, uint32_t completed);  /* NegroniGPU.cpp (0287) */
+uint32_t negroni_gpu_recoveries(void);
+bool negroni_gpu_fence_failed(uint32_t fence);
+uint32_t negroni_gpu_recovery_lo(uint32_t n);
+bool negroni_gpu_recover(const char *why);
+
+static uint32_t rec_arg = 1, rec_max = 3, rec_watch = 1;
+static bool rec_args_read;
+static uint32_t rec_count, rec_tries;
+static uint64_t rec_times[REC_HISTORY];
+static uint32_t rec_lo[REC_HISTORY], rec_hi[REC_HISTORY];
+
+static void
+rec_args(void)
+{
+	if (rec_args_read) {
+		return;
+	}
+	rec_args_read = true;
+	(void)PE_parse_boot_argn("negronigpu_recover", &rec_arg, sizeof(rec_arg));
+	(void)PE_parse_boot_argn("negronigpu_recover_max", &rec_max, sizeof(rec_max));
+	(void)PE_parse_boot_argn("negronigpu_recover_watch", &rec_watch, sizeof(rec_watch));
+	rec_max = rec_max < 1 ? 1 : rec_max > REC_HISTORY ? REC_HISTORY : rec_max;
+}
+
+/* How many recoveries passed (each one fails a range of fences). */
+uint32_t
+negroni_gpu_recoveries(void)
+{
+	return rec_count;
+}
+
+/* A fence a recovery cut off (it reads done, but its work did not run to its end). */
+bool
+negroni_gpu_fence_failed(uint32_t fence)
+{
+	for (uint32_t i = rec_count > REC_HISTORY ? rec_count - REC_HISTORY : 0; fence != 0 && i < rec_count; i++) {
+		uint32_t lo = rec_lo[i % REC_HISTORY], hi = rec_hi[i % REC_HISTORY];
+		if ((int32_t)(fence - lo) >= 0 && (int32_t)(hi - fence) >= 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* The first fence recovery n failed (0: n is too old to know; the caller counts it as a fault). */
+uint32_t
+negroni_gpu_recovery_lo(uint32_t n)
+{
+	return n < rec_count && rec_count - n <= REC_HISTORY ? rec_lo[n % REC_HISTORY] : 0;
+}
+
+/* The lock held: what the GPU says at the fault (dispatcher_do_fault's header; no snapshot) */
+static void
+rec_report(uint32_t n, const char *why)
+{
+	volatile uint32_t *scratch = (volatile uint32_t *)core_scratch.memory;
+	uint32_t ccb = smmu_cb(&core_space), gcb = smmu_cb(&gmu_space);
+	bool asleep = pm_asleep;
+
+	to_memory(core_scratch.memory, 4096);
+	printf("NEGRONI GPU RECOVERY: %u: %s: fence %u (bv %u) of %u, wptr %u, pm %s, GX GDSC %#x, power state %#x, GMU AO_INT %#x "
+	    "FW_INIT_RESULT %#x\n", n, why, scratch[GPU_FENCE_AT / 4], scratch[GPU_BV_FENCE_AT / 4], gpu_fence, ring_at, pm_name(),
+	    rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)),
+	    asleep ? 0 : rd(gmu + GMU_REG(GMU_AO_HOST_INTERRUPT_STATUS)), rd(gmu + GMU_REG(GMU_CM3_FW_INIT_RESULT)));
+	bool held = !asleep && pm_gx_on() && gx_hold();
+	if (held) {
+		printf("NEGRONI GPU RECOVERY: %u: RBBM_STATUS %#x STATUS3 %#x INT_0 %#x | CP rptr %u HW_FAULT %#x INT %#x PROTECT %#x | "
+		    "IB1 %#x:%08x rem %u | IB2 %#x:%08x rem %u | scratch2 %u\n", n,
+		    rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS)), rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS3)),
+		    rd(gpu_regs + GPU_WORD(REG_RBBM_INT_0_STATUS)), rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_HW_FAULT)), rd(gpu_regs + GPU_WORD(REG_CP_INTERRUPT_STATUS)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_PROTECT_STATUS)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_IB1_BASE + 1)), rd(gpu_regs + GPU_WORD(REG_CP_IB1_BASE)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_IB1_REM_SIZE)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_IB2_BASE + 1)), rd(gpu_regs + GPU_WORD(REG_CP_IB2_BASE)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_IB2_REM_SIZE)), rd(gpu_regs + GPU_WORD(REG_CP_SCRATCH_REG2)));
+		gx_release();
+	} else {
+		printf("NEGRONI GPU RECOVERY: %u: GX registers not read (GX off, asleep, or the GMU did not hold it)\n", n);
+	}
+	/* the 0233 SMMU fault registers of both contexts, read whether or not a fault bit is set */
+	printf("NEGRONI GPU RECOVERY: %u: SMMU SGFSR %#x | core FSR %#x FAR %#x:%#x FSYNR0 %#x | gmu FSR %#x FAR %#x:%#x\n", n,
+	    rd(smmu + SMMU_SGFSR), rd(smmu + ccb + SMMU_CB_FSR), rd(smmu + ccb + SMMU_CB_FAR + 4), rd(smmu + ccb + SMMU_CB_FAR),
+	    rd(smmu + ccb + SMMU_CB_FSYNR0), rd(smmu + gcb + SMMU_CB_FSR), rd(smmu + gcb + SMMU_CB_FAR + 4), rd(smmu + gcb + SMMU_CB_FAR));
+	to_memory(gmu_log.memory, 64);
+	const volatile uint32_t *l = (const volatile uint32_t *)gmu_log.memory;
+	printf("NEGRONI GPU RECOVERY: %u: GMU log head %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+	    n, l[0], l[1], l[2], l[3], l[4], l[5], l[6], l[7], l[8], l[9], l[10], l[11], l[12], l[13], l[14], l[15]);
+}
+
+/*
+ * The lock held: gen7_gmu_pwrctrl_suspend without clocks/CX off, then the 0285 RSC sleep (the warm boot
+ * expects the CM3 in reset and the RSC asleep). The GX registers are touched only while the GX GDSC is
+ * on; with the CM3 in reset nothing collapses GX any more, so that check stays true.
+ */
+static void
+rec_reset(uint32_t n, bool collapse)
+{
+	uint64_t t0 = mach_absolute_time();
+
+	gpu_irq_disarm();               /* 0384: no handler reads GX from here to the end of the warm boot */
+	wr(gmu + GMU_REG(GMU_INTR_MASK), ~0u);
+	wr(gmu + GMU_REG(GMU_AO_HOST_INTERRUPT_CLR), ~0u);
+	wr(gmu + GMU_REG(GMU_AHB_FENCE_STATUS_CLR), 7);
+	wr(gmu + GMU_REG(GMU_AO_AHB_FENCE_CTRL), 0);
+	__asm__ volatile ("dsb sy");
+	wr(gmu + GMU_REG(GMU_CM3_SYSRESET), 1);
+	__asm__ volatile ("dsb sy");
+	bool gx = pm_gx_on(), gx_halt = false, cx_halt, off;
+	if (gx) {
+		wr(gpu_regs + GPU_WORD(REG_RBBM_GBIF_HALT), 1);
+		gx_halt = wait_for(gpu_regs + GPU_WORD(REG_RBBM_GBIF_HALT_ACK), 1, 1, 100);
+	}
+	wr(gpu_regs + GPU_WORD(REG_GBIF_HALT), 2);
+	cx_halt = wait_for(gpu_regs + GPU_WORD(REG_GBIF_HALT_ACK), 2, 2, 100);
+	if (gx) {
+		wr(gpu_regs + GPU_WORD(REG_RBBM_SW_RESET_CMD), 1);
+		(void)rd(gpu_regs + GPU_WORD(REG_RBBM_SW_RESET_CMD));
+		delay(100);
+		wr(gpu_regs + GPU_WORD(REG_RBBM_SW_RESET_CMD), 0);
+	}
+	if (collapse && pm_gx_on()) {
+		/* negronigpu_recover=2: KGSL's regulator_enable + regulator_disable of the GX GDSC = SW_COLLAPSE from the CPU */
+		wr(gpucc + GPUCC_GX_GDSCR, rd(gpucc + GPUCC_GX_GDSCR) | GDSC_SW_COLLAPSE);
+		(void)wait_for(gpucc + GPUCC_GX_GDSCR, GDSC_PWR_ON, 0, 100);
+	}
+	off = !pm_gx_on();
+	/* the halts end before the GMU boots through the same bus (step 20 writes both 0 again) */
+	if (!off) {
+		wr(gpu_regs + GPU_WORD(REG_RBBM_GBIF_HALT), 0);
+	}
+	wr(gpu_regs + GPU_WORD(REG_GBIF_HALT), 0);
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 1);
+	bool rsc = wait_for(rscc + RSCC_STATUS0, 1u << 16, 1u << 16, 100);
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 0);
+	/* FSR is write-1-to-clear; the contexts terminate faulting accesses (SCTLR CFCFG 0): nothing to resume */
+	uint32_t ccb = smmu_cb(&core_space), gcb = smmu_cb(&gmu_space);
+	wr(smmu + ccb + SMMU_CB_FSR, rd(smmu + ccb + SMMU_CB_FSR));
+	wr(smmu + gcb + SMMU_CB_FSR, rd(smmu + gcb + SMMU_CB_FSR));
+	gx_on = false;
+	printf("NEGRONI GPU RECOVERY: %u: reset in %u us: CM3 in reset, GX GBIF halt %s, CX GBIF halt %s, RBBM SW reset %s, GX %s "
+	    "(GDSC %#x%s), RSC %s (%#x)\n", n, pm_us_since(t0), !gx ? "skipped (GX off)" : gx_halt ? "acked" : "NOT ACKED",
+	    cx_halt ? "acked" : "NOT ACKED", gx ? "done" : "skipped", off ? "off" : "on", rd(gpucc + GPUCC_GX_GDSCR),
+	    collapse ? ", collapsed by the CPU" : "", rsc ? "asleep" : "DID NOT SLEEP", rd(rscc + RSCC_STATUS0));
+}
+
+/*
+ * Called with RedwoodGPU's gGPULock held (no submission runs meanwhile), not with gpu_pm_lock.
+ * true: the GPU runs again, every fence up to negroni_gpu_last() reads done, the cut-off ones are
+ * failed (negroni_gpu_fence_failed). false: the GPU stays stopped (the caller sets gGPUStopped).
+ */
+bool
+negroni_gpu_recover(const char *why)
+{
+	rec_args();
+	lck_mtx_lock(&gpu_pm_lock);
+	uint32_t n = ++rec_tries;
+	uint64_t now = mach_absolute_time();
+	uint32_t recent = 0;
+
+	rec_report(n, why);
+	for (uint32_t i = rec_count > REC_HISTORY ? rec_count - REC_HISTORY : 0; i < rec_count; i++) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(now - rec_times[i % REC_HISTORY], &ns);
+		recent += ns < (uint64_t)REC_WINDOW_MS * NSEC_PER_MSEC;
+	}
+	const char *no = !gpu_kept ? "the GPU is not kept" : pm_dead ? "the GPU is off for good (a wake failed)" :
+	    rec_arg == 0 ? "negronigpu_recover=0" : recent >= rec_max ? "too many recoveries in 60 s" : NULL;
+	if (no != NULL) {
+		printf("NEGRONI GPU RECOVERY: %u: no recovery (%s; %u in the last 60 s, max %u): the GPU stays stopped for this boot\n",
+		    n, no, recent, rec_max);
+		lck_mtx_unlock(&gpu_pm_lock);
+		return false;
+	}
+	uint32_t done = negroni_gpu_completed(), last = gpu_fence;
+	rec_reset(n, rec_arg >= 2);
+	bool rsc;
+	rec_active = true;
+	bool ok = gpu_warm_boot(n <= 2, &rsc);  /* the first two recoveries log every step */
+	rec_active = false;
+	uint32_t us = pm_us_since(now);
+	if (!ok) {
+		pm_dead = true;
+		printf("NEGRONI GPU RECOVERY: %u: FAILED after %u us (RSC %s, GX GDSC %#x, FW_INIT_RESULT %#x): the GPU stays stopped "
+		    "for this boot\n", n, us, rsc ? "awake" : "NOT AWAKE", rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_CM3_FW_INIT_RESULT)));
+		lck_mtx_unlock(&gpu_pm_lock);
+		return false;
+	}
+	/* KGSL writes the hung ring's timestamps as retired; here the fence words take the newest fence */
+	*(volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT) = last;
+	*(volatile uint32_t *)(core_scratch.memory + GPU_BV_FENCE_AT) = last;
+	to_memory(core_scratch.memory, 4096);
+	for (unsigned i = 0; i < 256; i++) {
+		fence_pos[i] = ring_at;
+	}
+	rec_lo[rec_count % REC_HISTORY] = done + 1 == 0 ? 1 : done + 1;
+	rec_hi[rec_count % REC_HISTORY] = last;
+	rec_times[rec_count % REC_HISTORY] = now;
+	rec_count++;
+	pm_asleep = false;
+	pm_revote = true;               /* the watch's DCVS takes the level step 17 voted */
+	pm_seen_collapse = false;
+	gpu_invalidate_next = true;
+	pm_last_submit = mach_absolute_time();
+	if (pm_mode == PM_IFPC) {
+		if (pm_ifpc_ok) {
+			pm_gpu_clear();         /* as pm_start: the GMU collapses GX again */
+		} else {
+			pm_mode = pm_slumber_arg ? PM_SLUMBER : PM_OFF;
+		}
+	}
+	snprintf(negroni_gpu_badge, sizeof(negroni_gpu_badge), "GPU RESET %u", rec_count);
+	printf("NEGRONI GPU RECOVERY: %u: done in %u us: fences %u..%u failed (%u), ring at %u, pm %s, GX GDSC %#x; %u recoveries "
+	    "this boot, %u in the last 60 s (max %u)\n", n, us, done + 1, last, last - done, ring_at, pm_name(),
+	    rd(gpucc + GPUCC_GX_GDSCR), rec_count, recent + 1, rec_max);
+	lck_mtx_unlock(&gpu_pm_lock);
+	return true;
+}
+
+/*
+ * Keep mode, watched (boot-arg negroniadreno_watch, default 1 with negroniadreno_keep=1): once a
+ * second, what the GPU block left running does by itself -- the GMU's always-on counter, the CX and
+ * GX power domains, the GPU RSC, the GMU's queue to us (q[1]) and its log's first word, the 3D
+ * core's ring pointers, status and faults (read only while GX has power: its registers are in GX),
+ * and the SMMU's global and two context fault registers. A line whenever one of them changes, and
+ * one every ten seconds regardless, so the log shows the last state before anything goes wrong.
+ */
+/*
+ * Patch 0236, once from the watch at 5 s (the USB console attaches only at step 21, so the step-17/18
+ * lines are not on USB): the clock dump again, the cached step-17/18 facts, the HFI queues and the F2H
+ * messages seen, then (negronigpu_revote) the vote a third time with the CP running.
+ */
+static const char *
+vote_word(int32_t r)
+{
+	return r < 0 ? "not sent" : r == 0 ? "acked, error 0" : "NOT ACKED or error";
+}
+
+static void
+clock_late_report(void)
+{
+	struct hfi_queue_header *q = (struct hfi_queue_header *)(gmu_hfi.memory + sizeof(struct hfi_table_header));
+
+	if (clk_dump) {
+		clock_dump("from the watch (late copy)");
+		for (uint32_t i = 0; i < MIN(level_line_count, 3); i++) {
+			printf("NEGRONI ADRENO: late 17 %s\n", level_lines[i]);
+		}
+		printf("NEGRONI ADRENO: late 17 vote {0, 1, %u, %u} (negronigpu_level %u, %u MHz): %s; 18 revote (%s): %s\n",
+		    vote_level, vote_bw, vote_arg, gpu_khz[vote_level] / 1000, vote_word(vote_result),
+		    clk_revote ? "on" : "off", vote_word(revote_result));
+		to_memory(gmu_hfi.memory, 4 * 4096);
+		for (uint32_t i = 0; i < 3; i++) {
+			printf("NEGRONI ADRENO: late HFI queue %u: status %u size %u read %u write %u dropped %u\n", i,
+			    q[i].status, q[i].size, q[i].read_index, q[i].write_index, q[i].dropped);
+		}
+		/* the debug queue (2, +12K): the first 32 dwords up to its write index */
+		const volatile uint32_t *dq = (const volatile uint32_t *)(gmu_hfi.memory + 3 * 4096);
+		for (uint32_t at = 0; at < MIN(q[2].write_index, 32); at += 8) {
+			printf("NEGRONI ADRENO: late HFI debug queue[%u] = %08x %08x %08x %08x %08x %08x %08x %08x\n", at,
+			    dq[at], dq[at + 1], dq[at + 2], dq[at + 3], dq[at + 4], dq[at + 5], dq[at + 6], dq[at + 7]);
+		}
+		printf("NEGRONI ADRENO: late HFI F2H messages read: %u (last 16 below: header, words 1-3; id 100 = F2H_MSG_ERROR)\n",
+		    f2h_count);
+		for (uint32_t i = f2h_count > 16 ? f2h_count - 16 : 0; i < f2h_count; i++) {
+			const uint32_t *w = f2h_seen[i % 16];
+			printf("NEGRONI ADRENO: late F2H %u: id %u hdr %#x %#x %#x %#x\n", i, w[0] & 0xff, w[0], w[1], w[2], w[3]);
+		}
+	}
+	if (clk_revote) {
+		uint32_t vote[4] = { 0, 1 /* blocking ack */, vote_level, vote_bw };
+		printf("NEGRONI ADRENO: late GX_BW_PERF_VOTE a third time (CP running): level %u (%u MHz), bw level %u\n",
+		    vote_level, gpu_khz[vote_level] / 1000, vote_bw);
+		bool ok = hfi_send("GX_BW_PERF_VOTE", 30, vote, sizeof(vote));
+		printf("NEGRONI ADRENO: late third vote %s\n", ok ? "acked, error 0" : "NOT ACKED or error");
+		delay(100000);
+		clock_measure("100 ms after the third vote");
+		if (clk_dump) {
+			clock_dump("after the third vote");
+		}
+	}
+}
+
+/*
+ * Patch 0281: a busy-based GPU DCVS governor instead of the one fixed vote. Runs on the watch
+ * thread (the only HFI sender once the GPU is kept), every DCVS_TICK_MS:
+ *   busy  = RBBM_STATUS GPU_BUSY_IGN_AHB (bit 23) or a submitted fence the core has not written
+ *   idle for DCVS_IDLE_MS            -> level DCVS_FLOOR (350 MHz)
+ *   busy in both of the last 2 ticks -> one level up per DCVS_UP_MS, up to the max
+ *   max = negronigpu_level (the start level; 0 = the table top), lowered by the thermal cap
+ *   (patch 0280 negroni_thermal_gpu_cap: one level per 10 s above 70 C, back below 60 C)
+ * The bw level follows the GX level (bw_level_num - 1 at the top, DCVS_BW_FLOOR at the floor).
+ * Boot-arg negronigpu_dcvs (default 1); 0 keeps the fixed vote of 0235. The WATCH line gets
+ * "dcvs L busy N%" and the thermal line; every vote change is logged (at most one line per second).
+ */
+#define DCVS_TICK_MS            100
+#define DCVS_IDLE_MS            500
+#define DCVS_UP_MS              200
+#define DCVS_FLOOR              4
+#define DCVS_BW_FLOOR           3
+#define REG_RBBM_STATUS_GPU_BUSY (1u << 23)
+extern uint32_t negroni_thermal_gpu_cap(void);
+extern void negroni_thermal_line(char *buf, size_t size);
+extern void negroni_cpufreq_mhz_line(char *buf, size_t size);    /* 0284 */
+
+static uint32_t dcvs_on = 1, dcvs_level, dcvs_max, dcvs_busy_pct, dcvs_votes, dcvs_failed;
+
+/*
+ * Patch 0286: a UI floor for the governor. The busy rule above samples a pending fence every
+ * 100 ms; CoreAnimation at 40-80 frames/s keeps the GPU 30-40 % busy (each frame 10-24 ms from
+ * commit to completion at 350-421 MHz), so it rarely sees two busy samples in a row and the GPU
+ * stays at levels 4-5 while the UI misses its 8.3 ms frames (log 2026-10-26 13:18-13:31: dcvs 4-5,
+ * busy 20-50 %). The framebuffer counts swaps (negroni_gpu_ui_swaps, NegroniFramebuffer.cpp
+ * swap()); at negronigpu_uifps swaps/s or more the level is at least negronigpu_uifloor for
+ * negronigpu_uihold ms after the last such tick, and a single busy tick (100 ms) moves one level
+ * up. The thermal cap (0280) still wins. negronigpu_uifloor=0 turns it off.
+ */
+#define DCVS_UI_FLOOR           9       /* 640 MHz */
+#define DCVS_UI_FPS             30
+#define DCVS_UI_HOLD_MS         1000
+uint32_t negroni_gpu_ui_swaps;          /* NegroniFramebuffer.cpp: one per SwapEnd (atomic) */
+static uint32_t dcvs_ui_floor = DCVS_UI_FLOOR, dcvs_ui_fps = DCVS_UI_FPS, dcvs_ui_hold = DCVS_UI_HOLD_MS;
+static uint32_t dcvs_ui_left, dcvs_ui_rate, dcvs_ui_ms, dcvs_ui_count, dcvs_ui_boosts;
+
+static uint32_t
+dcvs_bw_for(uint32_t level, uint32_t top)
+{
+	uint32_t bw_top = 11;           /* bw_level_num - 1 (a730_build_bw_table) */
+	/*
+	 * 0298: the DT bus-freq of each level (out/live.dts:21096..21205: 818 11, 791 11, 734 10, 640 10, 599 8, 545 8,
+	 * 492 6, 421 6, 350 3, 317 2, 285 2, 220 2), index = our perf-table level (0 = off, 1 = 220 .. 12 = 818 MHz)
+	 */
+	static const uint8_t dt_bus[13] = { 0, 2, 2, 2, 3, 6, 6, 8, 8, 10, 10, 11, 11 };
+	if (k_bwdt) {
+		return level < 13 ? dt_bus[level] : bw_top;
+	}
+	if (level >= top) {
+		return bw_top;
+	}
+	uint32_t bw = DCVS_BW_FLOOR + (bw_top - DCVS_BW_FLOOR) * (level - DCVS_FLOOR) / (top > DCVS_FLOOR ? top - DCVS_FLOOR : 1);
+	return bw < DCVS_BW_FLOOR ? DCVS_BW_FLOOR : bw > bw_top ? bw_top : bw;
+}
+
+/*
+ * 0298: share (%) of the last tick the GPU was busy, from GMU power counter 0 (XOCLK_0: 19.2 MHz ticks while busy,
+ * enabled at step 20) over the GMU always-on counter; both CX side, no GX hold. ~0u: not used (off, asleep, or
+ * the counter never moves while fences are pending: then the fence rule stays, logged once).
+ */
+static uint32_t
+busy_counter_pct(bool pending)
+{
+	if (!k_busy_pct || !busy_counter_ok || pm_asleep) {
+		busy_last_ao = 0;
+		return ~0u;
+	}
+	uint64_t xo = rd64(gmu + GMU_REG(K_POWER_COUNTER_XOCLK_0)), ao = ao_now();
+	if (busy_last_ao == 0 || ao <= busy_last_ao || xo < busy_last_xo) {
+		busy_last_xo = xo;
+		busy_last_ao = ao;
+		return ~0u;             /* first sample, or the counters restarted (a wake or a recovery) */
+	}
+	uint64_t dxo = xo - busy_last_xo, dao = ao - busy_last_ao;
+	busy_last_xo = xo;
+	busy_last_ao = ao;
+	busy_acc_xo += dxo;
+	busy_acc_ao += dao;
+	if (dxo == 0 && pending) {
+		if (++busy_zero_ticks >= 50) {
+			busy_counter_ok = false;
+			printf("NEGRONI GPU DCVS: the GMU busy counter did not move in 50 ticks with work queued: the fence rule stays\n");
+		}
+	} else if (dxo != 0) {
+		busy_zero_ticks = 0;
+	}
+	return (uint32_t)MIN(dxo * 100 / dao, 100ull);
+}
+
+/* One governor tick; returns true when it voted. */
+/*
+ * 0384: Linux's simple_ondemand (drivers/devfreq/governor_simpleondemand.c) over the DT OPP table (out/live.dts:21087-21210,
+ * our perf levels 1..12 = 220..818 MHz, each with its DT bus-freq: dcvs_bw_for): busy share (GMU busy counter, KGSL
+ * gen7_power_stats) over the tick > upthreshold -> the top allowed level; > upthreshold - downdifferential -> stay;
+ * else the lowest level >= cur_freq * busy / (upthreshold - downdifferential / 2). No work queued -> busy 0 -> the
+ * lowest level (and its bus vote). Display off -> the lowest level. A frame the display held for the GPU
+ * (negroni_gpu_late_frames) with busy >= negronigpu_late_pct -> one level up.
+ */
+static uint32_t gov_pct_acc, gov_pct_ms, gov_pct_last, gov_late_boosts, gov_late_seen, gov_tops;
+static uint32_t
+gov_want(uint32_t cur, uint32_t pct, uint32_t min, uint32_t max)
+{
+	uint32_t want;
+
+	if (pct > k_up) {
+		want = max;
+		gov_tops++;
+	} else if (pct > k_up - k_down) {
+		want = cur;
+	} else {
+		uint64_t target = (uint64_t)gpu_khz[cur] * pct / (k_up - k_down / 2);
+		for (want = min; want < max && gpu_khz[want] < target; want++) {
+		}
+	}
+	uint32_t late = __atomic_exchange_n(&negroni_gpu_late_frames, 0, __ATOMIC_RELAXED);
+	gov_late_seen += late;
+	if (late && k_late_pct && pct >= k_late_pct && want <= cur && cur < max) {
+		want = cur + 1;
+		gov_late_boosts++;
+	}
+	return want;
+}
+
+static bool
+dcvs_tick(bool gx, bool busy, uint32_t cpct, uint32_t ms, uint32_t *idle_ms, uint32_t *busy_ms, uint32_t *busy_ticks, uint32_t *ticks)
+{
+	uint32_t top = sizeof(gpu_khz) / sizeof(gpu_khz[0]) - 1;
+	uint32_t cap = negroni_thermal_gpu_cap(), max = dcvs_max;
+
+	/* patch 0285: busy comes from the watch (no GX read with power management); ticks are ms long, not 100 */
+	if (cap >= DCVS_FLOOR && cap < max) {
+		max = cap;
+	}
+	*ticks += ms;
+	if (busy) {
+		*busy_ticks += ms;
+		*busy_ms += ms;
+		*idle_ms = 0;
+	} else {
+		*idle_ms += ms;
+		*busy_ms = 0;
+	}
+	if (*ticks >= 1000) {
+		dcvs_busy_pct = *busy_ticks * 100 / *ticks;
+		*ticks = *busy_ticks = 0;
+	}
+	/* 0286: the swap rate over at least 100 ms */
+	dcvs_ui_count += __atomic_exchange_n(&negroni_gpu_ui_swaps, 0, __ATOMIC_RELAXED);
+	dcvs_ui_ms += ms;
+	if (dcvs_ui_ms >= DCVS_TICK_MS) {
+		dcvs_ui_rate = dcvs_ui_count * 1000 / dcvs_ui_ms;
+		if (dcvs_ui_floor != 0 && dcvs_ui_rate >= dcvs_ui_fps) {
+			if (dcvs_ui_left == 0) {
+				dcvs_ui_boosts++;
+			}
+			dcvs_ui_left = dcvs_ui_hold;
+		} else {
+			dcvs_ui_left = dcvs_ui_left > dcvs_ui_ms ? dcvs_ui_left - dcvs_ui_ms : 0;
+		}
+		dcvs_ui_count = dcvs_ui_ms = 0;
+	}
+	bool ui = dcvs_ui_left != 0;
+	uint32_t want = dcvs_level;
+	uint32_t floor = k_gov ? k_minlevel : DCVS_FLOOR;
+	if (floor > max) {
+		floor = max;            /* the thermal cap (or negronigpu_maxlevel) wins over the floor */
+	}
+	bool dark = __atomic_load_n(&gpu_display_off, __ATOMIC_RELAXED);
+	if (k_gov) {
+		/*
+		 * 0384: the counter's share; without the counter (off, or given up), a tick with work queued counts as 100 %
+		 * (the fence rule). With the counter on, a tick without a sample (its first one after a wake or a recovery)
+		 * keeps the level: no jump to the top level.
+		 */
+		uint32_t pct = cpct != ~0u ? cpct : busy ? 100 : 0;
+		if (cpct == ~0u && k_busy_pct && busy_counter_ok) {
+			want = dcvs_level;
+		} else {
+			gov_pct_acc += pct * ms;
+			gov_pct_ms += ms;
+			gov_pct_last = pct;
+			want = gov_want(dcvs_level, pct, floor, max < top ? max : top);
+		}
+		if (dark) {
+			want = floor;
+		}
+	} else if (*idle_ms >= DCVS_IDLE_MS) {
+		want = DCVS_FLOOR;
+	} else if (*busy_ms >= (ui ? DCVS_TICK_MS : DCVS_UP_MS)) {
+		want = dcvs_level + 1;
+		*busy_ms = 0;
+	}
+	if (ui && !dark && want < dcvs_ui_floor) {
+		want = dcvs_ui_floor;
+	}
+	if (want > max) {
+		want = max;
+	}
+	if (want < floor) {
+		want = floor;
+	}
+	if (want > top) {
+		want = top;
+	}
+	if (want == dcvs_level || !gx) {
+		return false;
+	}
+	uint32_t vote[4] = { 0, 1 /* blocking ack */, want, dcvs_bw_for(want, top) };
+	hfi_quiet = true;
+	bool ok = hfi_send("GX_BW_PERF_VOTE", 30, vote, sizeof(vote));
+	hfi_quiet = false;
+	dcvs_votes++;
+	if (!ok) {
+		dcvs_failed++;
+		if (dcvs_failed <= 3) {
+			printf("NEGRONI GPU DCVS: vote level %u FAILED (%u of %u)\n", want, dcvs_failed, dcvs_votes);
+		}
+		return false;
+	}
+	dcvs_level = want;
+	vote_level = want;
+	vote_bw = vote[3];
+	return true;
+}
+
+static void
+gpu_watch(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t last[14] = { 0 };
+	bool first = true;
+	uint64_t clk_cycles = 0, clk_ao = 0;    /* patch 0236: the last print's samples */
+	bool late_done = false;
+	uint32_t idle_ms = 0, busy_ms = 0, busy_ticks = 0, ticks = 0, changes = 0, from = 0;
+	uint32_t top = sizeof(gpu_khz) / sizeof(gpu_khz[0]) - 1;
+	uint32_t rec_seen = 0;                  /* patch 0287: the completed fence the watch saw last, and since when */
+	uint64_t rec_moved = mach_absolute_time();
+	uint32_t rec_ao_base = ~0u, rec_init_base = ~0u, rec_count_seen = 0;
+
+	(void)PE_parse_boot_argn("negronigpu_dcvs", &dcvs_on, sizeof(dcvs_on));
+	k_args();
+	/* 0384: the governor has no UI floor unless negronigpu_uifloor asks for one (KGSL has none; at level 9 the
+	 * 0286 floor held 640 MHz and its DT bus vote 10 for hours with the busy counter at 0 %) */
+	if (k_gov) {
+		dcvs_ui_floor = 0;
+	}
+	(void)PE_parse_boot_argn("negronigpu_uifloor", &dcvs_ui_floor, sizeof(dcvs_ui_floor));
+	(void)PE_parse_boot_argn("negronigpu_uifps", &dcvs_ui_fps, sizeof(dcvs_ui_fps));
+	(void)PE_parse_boot_argn("negronigpu_uihold", &dcvs_ui_hold, sizeof(dcvs_ui_hold));
+	if (dcvs_ui_floor > top) {
+		dcvs_ui_floor = top;
+	}
+	if (dcvs_ui_fps == 0) {
+		dcvs_ui_fps = 1;
+	}
+	dcvs_max = k_gov ? MIN(k_maxlevel, top) : vote_arg ? vote_arg : top;
+	dcvs_level = vote_level;
+	from = dcvs_level;
+	if (vote_arg && dcvs_on) {
+		/* 0384: negronigpu_level=N is a fixed level (the step-17 vote); the governor runs only without it */
+		dcvs_on = 0;
+		printf("NEGRONI GPU DCVS: off: fixed level %u (%u MHz, bw %u) from negronigpu_level\n", vote_level,
+		    gpu_khz[vote_level] / 1000, vote_bw);
+	}
+	if (dcvs_on && k_gov) {
+		printf("NEGRONI GPU DCVS: on (0384 simple_ondemand): start level %u (%u MHz), levels %u..%u (%u..%u MHz), up %u%% "
+		    "down %u%%, busy from the GMU counter (fence rule without it), bus vote = DT bus-freq of the level, lowest level "
+		    "with the display off, late-frame step at busy >= %u%%, tick %u ms\n", dcvs_level, gpu_khz[dcvs_level] / 1000,
+		    k_minlevel, dcvs_max, gpu_khz[k_minlevel] / 1000, gpu_khz[dcvs_max] / 1000, k_up, k_down, k_late_pct, DCVS_TICK_MS);
+	} else if (dcvs_on) {
+		printf("NEGRONI GPU DCVS: on: start level %u (%u MHz), max %u, floor %u, tick %u ms, idle %u ms, up %u ms\n",
+		    dcvs_level, gpu_khz[dcvs_level] / 1000, dcvs_max, DCVS_FLOOR, DCVS_TICK_MS, DCVS_IDLE_MS, DCVS_UP_MS);
+		if (dcvs_ui_floor != 0) {
+			printf("NEGRONI GPU DCVS: UI floor level %u (%u MHz) at %u swaps/s or more, held %u ms (0286)\n",
+			    dcvs_ui_floor, gpu_khz[dcvs_ui_floor] / 1000, dcvs_ui_fps, dcvs_ui_hold);
+		} else {
+			printf("NEGRONI GPU DCVS: UI floor off (negronigpu_uifloor=0)\n");
+		}
+	}
+	for (uint32_t second = 1;; second++) {
+		uint32_t now[14];
+		struct hfi_queue_header *q = (struct hfi_queue_header *)(gmu_hfi.memory + sizeof(struct hfi_table_header));
+		bool gx;
+
+		/*
+		 * Patch 0285: ticks until a watch second has passed: 100 ms while the GPU works or DCVS has not
+		 * reached its idle time, 250 ms when idle (a submission wakes the thread), 1000 ms with neither DCVS
+		 * nor power management (the 0236 watch). With power management no GX register is read here.
+		 */
+		for (uint32_t elapsed = 0; elapsed < 1000;) {
+			bool pending = negroni_gpu_completed() != gpu_fence;
+			uint32_t idle_for = pending ? 0 : pm_us_since(pm_last_submit) / 1000;
+			uint32_t tick = !dcvs_on && pm_mode == PM_OFF ? 1000 :
+			    (pending || idle_for < DCVS_IDLE_MS) ? DCVS_TICK_MS : PM_IDLE_TICK_MS;
+			uint64_t t0 = mach_absolute_time();
+
+			pm_watch_idle = tick == PM_IDLE_TICK_MS;
+			assert_wait_timeout((event_t)&gpu_kept, THREAD_UNINT, tick, NSEC_PER_MSEC);
+			thread_block(THREAD_CONTINUE_NULL);
+			uint32_t ms = MAX(pm_us_since(t0) / 1000, 1u);
+			elapsed += ms;
+			if (tick == 1000) {
+				continue;
+			}
+			lck_mtx_lock(&gpu_pm_lock);
+			bool on = pm_gx_on();
+			pending = negroni_gpu_completed() != gpu_fence;
+			if (dcvs_on && late_done) {
+				if (pm_revote) {
+					dcvs_level = vote_level;        /* the wake's step 17 voted that */
+					pm_revote = false;
+				}
+				uint32_t rbbm = pm_mode == PM_OFF && on ? rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS)) : 0;
+				bool busy = pm_mode == PM_OFF ? on && ((rbbm & REG_RBBM_STATUS_GPU_BUSY) != 0 || pending) : pending;
+				uint32_t cpct = busy_counter_pct(pending);  /* 0298: KGSL gen7_power_stats (adreno_gen7.c:1392-1405) */
+				if (cpct != ~0u) {
+					busy = cpct >= k_busy_pct;
+				}
+				bool may_vote = !pm_asleep && (pm_mode != PM_OFF || on);   /* 0298: never to a sleeping GMU */
+				if (dcvs_tick(may_vote, busy, cpct, ms, &idle_ms, &busy_ms, &busy_ticks, &ticks)) {
+					changes++;
+				}
+			}
+			pm_tick(pending ? 0 : pm_us_since(pm_last_submit) / 1000, on, late_done);
+			lck_mtx_unlock(&gpu_pm_lock);
+		}
+		pm_watch_idle = false;
+		if (changes && k_gov) {
+			/* 0384: busy = the time-weighted counter share of the second (what the governor saw) */
+			printf("NEGRONI GPU DCVS: level %u -> %u (%u MHz, bw %u), %u changes this second, busy %u%% (%s, last tick %u%%), "
+			    "cap %u, display %s, late frames %u (%u steps), top jumps %u, ui %u swaps/s%s\n", from, dcvs_level,
+			    gpu_khz[dcvs_level] / 1000, vote_bw, changes, gov_pct_ms ? gov_pct_acc / gov_pct_ms : 0,
+			    busy_counter_ok && k_busy_pct ? "GMU counter" : "fence rule", gov_pct_last, negroni_thermal_gpu_cap(),
+			    __atomic_load_n(&gpu_display_off, __ATOMIC_RELAXED) ? "off" : "on", gov_late_seen, gov_late_boosts, gov_tops,
+			    dcvs_ui_rate, dcvs_ui_left != 0 ? " floor on" : "");
+		} else if (changes) {
+			printf("NEGRONI GPU DCVS: level %u -> %u (%u MHz, bw %u), %u changes this second, busy %u%%, cap %u, ui %u swaps/s%s (%u boosts)\n",
+			    from, dcvs_level, gpu_khz[dcvs_level] / 1000, vote_bw, changes, dcvs_busy_pct, negroni_thermal_gpu_cap(),
+			    dcvs_ui_rate, dcvs_ui_left != 0 ? " floor on" : "", dcvs_ui_boosts);
+		}
+		if (changes) {
+			changes = 0;
+			from = dcvs_level;
+		}
+		uint32_t gov_avg = gov_pct_ms ? gov_pct_acc / gov_pct_ms : 0;   /* 0384: for the WATCH line */
+		gov_pct_acc = gov_pct_ms = 0;
+		char iline[200];
+		lck_mtx_lock(&gpu_pm_lock);
+		gpu_irq_second(iline, sizeof(iline));                          /* 0384: re-arm, unmask, storm guard, counts */
+		if (!late_done && second >= 5) {
+			late_done = true;
+			bool held = gx_hold();
+			uint32_t probe = clk_probe;
+			if (!held) {
+				clk_probe = 0;
+			}
+			clock_late_report();
+			clk_probe = probe;
+			if (held) {
+				gx_release();
+			}
+		}
+		to_memory(gmu_hfi.memory, 4096);
+		to_memory(gmu_log.memory, 64);
+		now[0] = rd(gpucc + GPUCC_CX_GDSCR);
+		now[1] = rd(gpucc + GPUCC_GX_GDSCR);
+		gx = (now[1] & GDSC_PWR_ON) != 0;
+		now[2] = rd(rscc + RSCC_STATUS0);
+		now[3] = q[1].write_index;
+		now[4] = *(volatile uint32_t *)gmu_log.memory;
+		now[9] = rd(smmu + SMMU_SGFSR);
+		now[10] = rd(smmu + smmu_cb(&core_space) + SMMU_CB_FSR);
+		now[11] = rd(smmu + smmu_cb(&gmu_space) + SMMU_CB_FSR);
+		now[12] = pm_asleep ? 0 : rd(gmu + GMU_REG(GMU_HFI_CTRL_STATUS));
+		now[13] = *(volatile uint32_t *)(core_scratch.memory + 0x80);  /* the core's copy of its ring rptr */
+		/* 0285: with power management GX and the GMU log change with every collapse: only the CX words count
+		 * as a change, and GX is read (held) only for a line that is printed */
+		bool changed;
+		if (pm_mode == PM_OFF) {
+			now[5] = gx ? rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR)) : ~0u;
+			now[6] = gx ? rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS)) : ~0u;
+			now[7] = gx ? rd(gpu_regs + GPU_WORD(REG_CP_HW_FAULT)) : ~0u;
+			now[8] = gx ? rd(gpu_regs + GPU_WORD(REG_RBBM_INT_0_STATUS)) : ~0u;
+			changed = memcmp(now, last, sizeof(now)) != 0;
+		} else {
+			changed = now[0] != last[0] || now[2] != last[2] || now[3] != last[3] ||
+			    memcmp(&now[9], &last[9], 5 * sizeof(now[0])) != 0;
+		}
+		bool held = gx && pm_mode == PM_OFF;
+		if (pm_mode != PM_OFF && (first || changed || second % 10 == 0)) {
+			held = gx && gx_hold();
+			now[5] = held ? rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR)) : ~0u;
+			now[6] = held ? rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS)) : ~0u;
+			now[7] = held ? rd(gpu_regs + GPU_WORD(REG_CP_HW_FAULT)) : ~0u;
+			now[8] = held ? rd(gpu_regs + GPU_WORD(REG_RBBM_INT_0_STATUS)) : ~0u;
+		}
+		if (first || changed || second % 10 == 0) {
+			/* gxclk: CP cycles over AO ticks since the last line; 0: GX off, first line, or the counter reset */
+			uint32_t gxclk = 0;
+			if (clk_probe && held) {
+				uint64_t c = gx_cycles(), a = ao_now();
+				if (clk_ao && c >= clk_cycles && a > clk_ao) {
+					gxclk = clk_mhz(c - clk_cycles, a - clk_ao);
+				}
+				clk_cycles = c;
+				clk_ao = a;
+			} else {
+				clk_ao = 0;
+			}
+			char pline[176];         /* 0298: + slumbers, wakes, busy */
+			pm_line(pline, sizeof(pline));          /* patch 0285 */
+			char tline[160];
+			negroni_thermal_line(tline, sizeof(tline));
+			char cline[40];
+			negroni_cpufreq_mhz_line(cline, sizeof(cline));
+			printf("NEGRONI GPU WATCH %u s: AO %#x CX %#x GX %#x RSC %#x q1w %u log0 %#x | rptr %#x RBBM %#x "
+			    "HW_FAULT %#x INT0 %#x | SGFSR %#x FSR core %#x gmu %#x | HFI %#x rptr-copy %#x | gxclk %u MHz | "
+			    "dcvs %u busy %u%% gov %u%% | %s | %s | %s\n", second,
+			    rd(gmu + GMU_REG(GMU_AO_COUNTER_L)), now[0], now[1], now[2], now[3], now[4], now[5], now[6],
+			    now[7], now[8], now[9], now[10], now[11], now[12], now[13], gxclk, dcvs_level, dcvs_busy_pct, gov_avg, pline,
+			    tline, cline);
+			printf("NEGRONI GPU IRQ: %s\n", iline);         /* 0384: own line (the WATCH line is near the USB line limit) */
+			if (now[10] & SMMU_FSR_ALL) {
+				space_faulted(&core_space);
+			}
+			if (now[11] & SMMU_FSR_ALL) {
+				space_faulted(&gmu_space);
+			}
+			memcpy(last, now, sizeof(now));
+			first = false;
+		}
+		/*
+		 * Patch 0287: fault detection, once a watch second (KGSL: the dispatcher's 2000 ms drawobj timeout and
+		 * its fault interrupts; here polled): no fence written for GPU_STALL_MS with work queued, an SMMU fault
+		 * in the 3D core's context, CP_HW_FAULT, the GMU watchdog bite or a GMU firmware fault.
+		 */
+		const char *fault = NULL;
+		uint32_t done = negroni_gpu_completed();
+		if (done == gpu_fence || done != rec_seen) {
+			rec_seen = done;
+			rec_moved = mach_absolute_time();
+		} else if (pm_us_since(rec_moved) / 1000 >= REC_STALL_MS) {
+			fault = "no fence written for 2 s with work queued (watch)";
+		}
+		if (done != gpu_fence && fault == NULL) {
+			uint32_t ao = pm_asleep ? 0 : rd(gmu + GMU_REG(GMU_AO_HOST_INTERRUPT_STATUS));
+			uint32_t init = pm_asleep ? 0 : rd(gmu + GMU_REG(GMU_CM3_FW_INIT_RESULT));
+			if (now[10] & SMMU_FSR_ALL) {
+				fault = "SMMU fault in the 3D core's context (watch)";
+			} else if (held && now[7] != 0 && now[7] != ~0u) {
+				fault = "CP_HW_FAULT set (watch)";
+			} else if (ao & ~rec_ao_base & GMU_AO_INT_WDOG_BITE) {
+				fault = "GMU watchdog bite (watch)";
+			} else if (init & ~rec_init_base & 0xe00) {
+				fault = "GMU firmware fault, FW_INIT_RESULT bits 9-11 (watch)";
+			}
+		}
+		if (rec_count != rec_count_seen) {
+			rec_count_seen = rec_count;     /* a recovery restarted the GMU: sample again */
+			rec_ao_base = rec_init_base = ~0u;
+		}
+		if (rec_ao_base == ~0u && !pm_asleep) {
+			/* only bits that come up after the first sample count (a value left from the boot is not a fault) */
+			rec_ao_base = rd(gmu + GMU_REG(GMU_AO_HOST_INTERRUPT_STATUS)) & GMU_AO_INT_WDOG_BITE;
+			rec_init_base = rd(gmu + GMU_REG(GMU_CM3_FW_INIT_RESULT)) & 0xe00;
+		}
+		if (held && pm_mode != PM_OFF) {
+			gx_release();
+		}
+		lck_mtx_unlock(&gpu_pm_lock);
+		if (fault != NULL && rec_watch) {
+			NegroniGPUWatchFault(fault, done);
+			rec_seen = negroni_gpu_completed();
+			rec_moved = mach_absolute_time();
+		}
+	}
+}
+
+/* After step 22 with negroniadreno_keep=1: the fences start at 0 and the service is made. */
+static void
+gpu_keep(void)
+{
+	*(volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT) = 0;
+	*(volatile uint32_t *)(core_scratch.memory + GPU_BV_FENCE_AT) = 0;
+	to_memory(core_scratch.memory, 4096);
+	gpu_fence = 0;
+	gpu_free[0].start = GPU_ADDRESSES_START;
+	gpu_free[0].size = GPU_ADDRESSES_SIZE;
+	gpu_heap.count = 1;
+	gpu_root_current = core_space.tables[0].phys;
+	uint32_t pt = 0;
+
+	(void)PE_parse_boot_argn("negronigpu_pt", &pt, sizeof(pt));
+	if (pt != 0) {
+		/* the kernel's part of every table: its level-2 tables exist from now on and never move */
+		bool made = core_space.root != NULL;
+		for (unsigned i = 0; made && i < GPU_KERNEL_ROOTS; i++) {
+			made = space_next(&core_space, &core_space.root[i], true) != NULL;
+		}
+		if (made) {
+			gpu_per_client = true;
+			gpu_free[0].start = GPU_KERNEL_HEAP_START;
+			gpu_free[0].size = GPU_KERNEL_HEAP_END - GPU_KERNEL_HEAP_START;
+		}
+		printf("NEGRONI GPU: per-client GPU tables %s\n", made ? "on (negronigpu_pt=1)" : "OFF: no kernel tables");
+	}
+	gpu_kept = true;
+	pm_start();                     /* patch 0285 */
+	snprintf(negroni_gpu_badge, sizeof(negroni_gpu_badge), "GPU KEPT");
+	printf("NEGRONI GPU: the 3D core stays on; RedwoodGPU for programs\n");
+	uint32_t watch = 1;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("negroniadreno_watch", &watch, sizeof(watch));
+	if (watch && kernel_thread_start(gpu_watch, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	uint32_t service = 1;
+
+	(void)PE_parse_boot_argn("negroniadreno_service", &service, sizeof(service));
+	if (service) {
+		NegroniGPUStart();
+	} else {
+		printf("NEGRONI GPU: no RedwoodGPU service (negroniadreno_service=0)\n");
+	}
+}
+
+void
+negroni_adreno_init(void)
+{
+	uint32_t last = 0;
+
+	(void)PE_parse_boot_argn("negroniadreno", &last, sizeof(last));
+	if (negroni_probe_gpu != ~0u) {
+		last = negroni_probe_gpu;       /* probe menu (negroni_keys.c) */
+	}
+	(void)PE_parse_boot_argn("negroniadreno_pause", &pause_ms, sizeof(pause_ms));
+	if (last == 0) {
+		return;
+	}
+	last = MIN(last, (uint32_t)(sizeof(steps) / sizeof(steps[0])));
+	printf("NEGRONI ADRENO: steps 1..%u\n", last);
+	gcc = ml_io_map_unmappable(GCC_PHYS, GCC_SIZE, ADRENO_WIMG_IO);
+	gpucc = ml_io_map(GPUCC_PHYS, GPUCC_SIZE);
+	gmu = ml_io_map(GMU_PHYS, GMU_SIZE);
+	rscc = ml_io_map(RSCC_PHYS, RSCC_SIZE);
+	smmu = ml_io_map(SMMU_PHYS, SMMU_SIZE);
+	bool failed = false;
+	for (step = 1; step <= last; step++) {
+		snprintf(negroni_gpu_badge, sizeof(negroni_gpu_badge), "GPU %u", step);
+		negroni_gpu_badge_color = 0x00d0a000;
+		if (step >= 2 && !cfg_ahb_running()) {
+			printf("NEGRONI ADRENO: %u stop: GCC_GPU_CFG_AHB_CLK is off\n", step);
+			failed = true;
+			break;
+		}
+		if (!steps[step - 1]()) {
+			failed = true;
+			break;
+		}
+	}
+	if (failed) {
+		snprintf(negroni_gpu_badge, sizeof(negroni_gpu_badge), "GPU STOP %u", step);
+		negroni_gpu_badge_color = 0x00c00000;
+	} else if (gmu_counts) {
+		snprintf(negroni_gpu_badge, sizeof(negroni_gpu_badge), last >= 22 ? "GPU DRAWS %u" : "GPU ON %u", last);
+		negroni_gpu_badge_color = 0x0000a000;
+	} else {
+		snprintf(negroni_gpu_badge, sizeof(negroni_gpu_badge), "GPU %u OK", last);
+		negroni_gpu_badge_color = 0x00d0a000;
+	}
+	printf("NEGRONI ADRENO: done (asked %u, reached %u)\n", last, MIN(step, last));
+	uint32_t keep = 0;
+	(void)PE_parse_boot_argn("negroniadreno_keep", &keep, sizeof(keep));
+	if (!keep && last >= 4) {
+		gpu_stop();
+	} else if (keep && !failed && last >= 22) {
+		gpu_keep();
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_adsp.c b/bsd/dev/negroni_adsp.c
new file mode 100644
index 0000000..9899909
--- /dev/null
+++ b/bsd/dev/negroni_adsp.c
@@ -0,0 +1,1921 @@
+/*
+ * NEGRONI (SM8450) audio DSP (ADSP, the Hexagon in LPASS) start: stage (a) of the iOSPlus10
+ * audio plan (docs/audio-plan.md). UNTESTED ON HARDWARE.
+ *
+ * Off by default. Boot-arg negroniadsp=1 runs the steps on a kernel thread of its own;
+ * negroniadsp_step=N stops after step N (default 9: the ADSP up with GLINK). Every line starts "NEGRONI ADSP:".
+ *
+ *   1  reads   SMEM (0x80900000, 2 MiB): $TOC, the apps<->ADSP partition (hosts 0 and 2), its
+ *              items; the ADSP's SMP2P item 443 (if present the ADSP has run since the reset:
+ *              stop, it is not started twice), its last words (item 423)
+ *   2  reads   the ADSP firmware area (negroni_ufs_adsp_area_read: 32 MiB right before the GPU
+ *              firmware area; scripts/audio/mkadsparea.py): header, adsp.mdt (ELF32, Qualcomm
+ *              MDT: program header segment, PT_LOAD segments in adsp.bNN, hash segment), the
+ *              SHA-256 of each file, the load span fits the carveout
+ *   3  writes  RPMh: lcx.lvl and lmx.lvl at level 384 (negroni_rpmh_arc_vote; the live DT cx/mx
+ *              supplies; Linux qcom_q6v5_pas proxy votes. hackios redwood_adsp.c: without them the
+ *              DSP died with "SFR Init: wdog or kernel error suspected.")
+ *   4  writes  AOSS QMP (0xc300000; Linux qcom_aoss.c): link and channel up if they are not, then
+ *              "{class: image, res: load_state, name: adsp, val: on}"
+ *   5  asks    TrustZone: PAS init image (PAS id 1, metadata = ELF header + program headers +
+ *              hash segment, Linux qcom_mdt_read_metadata), then PAS mem setup (carveout, span)
+ *   6  writes  the carveout 0x85700000 + 0x2800000 (live DT adsp_region; the Mu memory map
+ *              keeps it reserved in "PIL Reserved"): zero, each PT_LOAD at p_paddr - min p_paddr
+ *              (relocatable image), read back and compared by SHA-256
+ *   7  writes  SMEM: our SMP2P item 429 (allocated under TCSR mutex 3 like qcom_smem_alloc),
+ *              entry "master-kernel" = 0, features SSR-ACK; IPCC ring (client 3 LPASS, signal 2)
+ *   8  asks    TrustZone: PAS auth and reset (id 1); polls item 443 entry "slave-kernel" for
+ *              ready (bit 1), handover (bit 2), fatal (bit 0) for negroniadsp_wait seconds
+ *              (default 10). Handover: the rail votes are dropped (as Linux does). No ready or
+ *              fatal: last words, PAS shutdown. Ready: the ADSP stays up; the GLINK SMEM items
+ *              (478/479/480) are reported.
+ *   9  writes  SMEM: GLINK items 478 (descriptors) and 479 (our TX FIFO); waits for the ADSP's
+ *              FIFO 480, version 1, opens IPCRTR and adsp_apps, gives RX intents (patch 0242)
+ *
+ * Patch 0242: every step runs under a time limit (negroniadsp_steptimeout=MS, default 15000)
+ * and a failed step ends with one line "NEGRONI ADSP: step N (name) failed: reason".
+ *
+ * More boot-args: negroniadsp_pause=MS before each write step (default 0; >0 helps to see the
+ * last line in the USB log before a hang), negroniadsp_unvote=0 keeps the rail votes after
+ * handover.
+ *
+ * Addresses: the phone's live DT (out/live.dts: remoteproc-adsp@03000000, qcom,smp2p-adsp,
+ * qcom,ipcc@ed18000, power-controller@c300000, hwlock / syscon@1f40000, adsp_region), layouts
+ * from Linux (qcom_q6v5_pas.c, mdt_loader.c, smem.c, smp2p.c, qcom_aoss.c, qcom_hwspinlock.c)
+ * and the SM7325 template hackios-xnu-kernel bsd/dev/redwood_adsp.c (APSL 2.0).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern_xnu.h>  /* 12377: kmem_alloc/KMA_* moved here from vm_kern.h */
+#include <arm/caches_internal.h>
+#include <libkern/crypto/sha2.h>
+#include "negroni_adsp.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern uint64_t kvtophys(vm_offset_t va);
+extern kern_return_t thread_terminate(thread_t);
+extern void IOSleep(unsigned int milliseconds);
+extern int negroni_ufs_adsp_area_read(uint64_t at, void *dst, uint32_t count);
+extern int negroni_rpmh_arc_vote(const char *res, unsigned level);
+void negroni_adsp_init(void);
+void negroni_usb_adsp_event(int what);  /* 0368: negroni_usb.c (USB PHY watch) */
+
+#define STEPS                   15      /* 1..8 ADSP start, 9 GLINK, 10..15 stage (b): negroni_audio.c */
+
+/*
+ * Mappings. ml_io_map and ml_io_map_wcomb take their VA from io_submap: 8 MiB for the whole
+ * kernel (osfmk/arm/io_map.c IO_MAP_SIZE), permanent entries, KMA_NOFAIL. With the GPU ladder
+ * on, the other drivers use most of it, and the 2 MiB SMEM map panicked there ("kmem_alloc(...,
+ * 2097152, ...): failed with 3", photo 2026-10-25). ml_io_unmap of an io_submap address also
+ * panics (vm_map_delete: permanent entry, vm_map.c:8188). So the large RAM views (SMEM 2 MiB,
+ * the 40 MiB carveout) use ml_io_map_unmappable: VA from kernel_map, removable by ml_io_unmap.
+ * Only the small register pages (IPCC, AOSS, TCSR mutex) stay on ml_io_map.
+ * VM_WIMG_WCOMB (osfmk/arm/memory_types.h, not exported to bsd/) = 0x6, Normal non-cacheable,
+ * the same type ml_io_map_wcomb used (Linux maps SMEM and the carveout write-combined too).
+ */
+#define ADSP_WIMG_WCOMB         0x6u
+
+/* ---- addresses (live DT) ---- */
+#define SMEM_PHYS               0x80900000UL
+#define SMEM_SIZE               0x00200000u
+#define ADSP_MEM_PHYS           0x85700000UL    /* adsp_region@85e00000 { reg = <0 0x85700000 0 0x2800000> } */
+#define ADSP_MEM_SIZE           0x02800000u
+_Static_assert((ADSP_MEM_SIZE & 0x3fffu) == 0, "ml_io_unmap needs a 16 KiB page multiple (pmap_remove asserts)");
+#define IPCC_PHYS               0x0ed18000UL
+#define AOSS_PHYS               0x0c300000UL
+#define AOSS_SIZE               0x400u
+#define TCSR_MUTEX_PHYS         0x01f43000UL    /* syscon@1f40000, stride 0x1000, smem hwlocks = <&tcsr_mutex 3> */
+
+/* ---- SCM / PAS (same encoding as negroni_adreno.c) ---- */
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(svc, cmd)      ((uint64_t)(svc) << 8 | (cmd))
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_MEM_SETUP       SCM_CALL(2, 2)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_PAS_IS_SUPPORTED    SCM_CALL(2, 7)
+#define SCM_ONE_VALUE           1
+#define SCM_THREE_VALUES        3
+#define SCM_VALUE_AND_BUFFER    (2 | 2 << 6)
+#define SCM_INTERRUPTED         1
+#define PAS_ADSP                1
+
+/* ---- SMEM (smem.c) ---- */
+#define SMEM_APPS               0
+#define SMEM_ADSP               2               /* qcom,remote-pid */
+#define SMEM_GLOBAL             0xfffe
+#define SMEM_CANARY             0xa5a5
+#define ITEM_CRASH_REASON       423
+#define ITEM_SMP2P_OURS         429             /* qcom,smem = <443 429>: inbound, outbound */
+#define ITEM_SMP2P_THEIRS       443
+#define ITEM_GLINK_DESC         478
+#define ITEM_GLINK_FIFO0        479
+#define ITEM_GLINK_FIFO1        480
+
+/* ---- SMP2P (smp2p.c) ---- */
+#define SMP2P_MAGIC             0x504d5324      /* "$SMP" */
+#define SMP2P_VERSION           1
+#define SMP2P_FEATURE_SSR_ACK   1u
+#define SMP2P_ENTRIES           16
+#define SMP2P_ITEM_SIZE         (20 + 20 * SMP2P_ENTRIES)
+#define DSP_FATAL               (1u << 0)       /* slave-kernel bits: remoteproc interrupts-extended */
+#define DSP_READY               (1u << 1)
+#define DSP_HANDOVER            (1u << 2)
+#define DSP_STOP_ACK            (1u << 3)
+
+/* ---- IPCC (qcom-ipcc.c) ---- */
+#define IPCC_SEND_ID            0x0c
+#define IPCC_CLIENT_AOP         0u
+#define IPCC_CLIENT_LPASS       3u
+#define IPCC_SIGNAL_SMP2P       2u
+
+/* ---- AOSS QMP (qcom_aoss.c) ---- */
+#define QMP_MAGIC               0x00
+#define QMP_MAGIC_VALUE         0x4d41494c      /* "LIAM" */
+#define QMP_VERSION             0x04
+#define QMP_UCORE_LINK          0x0c
+#define QMP_UCORE_LINK_ACK      0x10
+#define QMP_UCORE_CH            0x14
+#define QMP_UCORE_CH_ACK        0x18
+#define QMP_MCORE_LINK          0x24
+#define QMP_MCORE_LINK_ACK      0x28
+#define QMP_MCORE_CH            0x2c
+#define QMP_MCORE_CH_ACK        0x30
+#define QMP_MCORE_MBOX_SIZE     0x34
+#define QMP_MCORE_MBOX_OFFSET   0x38
+#define QMP_UP                  0x0000ffffu
+#define QMP_MSG_LEN             64u
+
+/* ---- firmware area (scripts/audio/mkadsparea.py) ---- */
+#define AREA_MAGIC              "NEGRADSP"
+#define AREA_MAX                64
+#define AREA_HEADER             8192u
+#define AREA_SIZE               (32u << 20)
+#define CHUNK                   (1u << 20)
+
+struct area_entry {
+	char name[48];
+	uint32_t offset, size;
+	uint8_t sha256[32];
+};
+struct area_header {
+	char magic[8];
+	uint32_t version, count;
+	struct area_entry entry[AREA_MAX];
+};
+
+/* ---- MDT (mdt_loader.c) ---- */
+#define PT_LOAD                 1
+#define MDT_TYPE(flags)         (((flags) >> 24) & 7)
+#define MDT_TYPE_HASH           2
+#define MDT_RELOCATABLE         (1u << 27)
+#define MAX_SEGMENTS            48
+
+struct seg {
+	uint32_t type, offset, paddr, filesz, memsz, flags;
+};
+
+static uint32_t step, last_step = 9 /* GLINK up, no audio: steps 10..15 only when asked */, pause_ms, wait_s = 10, unvote = 1;
+static vm_offset_t smem, ipcc, aoss, tcsr;
+static struct area_header *area;                /* kmem, AREA_HEADER bytes */
+static uint8_t *mdt;                            /* kmem copy of adsp.mdt */
+static uint32_t mdt_size, nseg, min_pa, max_pa;
+static struct seg segs[MAX_SEGMENTS];
+static bool relocatable, rails_on;
+static uint32_t our_item;
+static bool adsp_running;                       /* 0248: step 8 saw READY, no fatal since */
+static uint32_t step_budget_ms = 15000;         /* negroniadsp_steptimeout */
+static char fail_why[192];                           /* reason of the failed step */
+static const char *const step_names[] = {
+	"SMEM survey", "firmware area", "rails", "AOP QMP", "PAS init", "load", "SMP2P", "start", "GLINK",
+};
+static char stage_b_why[192];
+static int adsp_phase;                       /* 0376: 0 not asked, 1 the thread runs, 2 the thread is done */
+
+/* 0376 (negroni_slpi.c): the SLPI thread waits for this thread (QMP mailbox, TCSR mutex 3: no lock) */
+int negroni_adsp_phase(void);
+bool negroni_adsp_rails_held(void);
+int
+negroni_adsp_phase(void)
