+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450) patch 0274: a client of the ADSP charger PD over GLINK
+ * channel PMIC_RTR_ADSP_APPS (live DT qcom,pmic_glink: qcom,pmic-glink-channel, subsys lpass,
+ * protection domain msm/adsp/charger_pd). iOSPlus10 docs/charger-glink-plan.md.
+ *
+ * Why: the HLOS cannot reach the PM8350B charger (no APID for EE 0, the SPMI debug arbiter is
+ * fused off: patch 0273). The ADSP charger PD owns it; OxygenOS sets the input limit and charging
+ * enable only through pmic_glink messages (OnePlus oplus_battery_sm8450.c write_property_id).
+ *
+ * Protocol (read from OnePlus oplus_battery_sm8450.[ch] and Linux qcom_battmgr.c / pmic_glink.c;
+ * our own code): every message starts with {u32 owner = 32778 (MSG_OWNER_BC), u32 type (1 request/
+ * response, 2 notify), u32 opcode}. Property get/set: opcode 0x30/0x31 battery, 0x32/0x33 USB,
+ * body {u32 battery_id 0, u32 property_id, u32 value} (24 bytes); answer {hdr, property_id, value,
+ * ret_code} (24 bytes, ret_code 0 = ok). OEM read buffer: opcode 0x10000 {hdr, u32 data_size 512}
+ * (16 bytes); answer {hdr, u32 data[128], u32 data_size} (528 bytes): data[0] temperature 0.1 C,
+ * [1] current uA, [2] voltage uV, [3] SoC in hundredths of a percent (the external gauge; OxygenOS
+ * uses it because qcom,voocphy_support = 1 = ADSP_VOOCPHY).
+ *
+ * "Ready": the downstream pmic_glink.c tells its clients STATE_UP once the GLINK channel is open
+ * (pmic_glink_init_work after the rpmsg probe), not from the PDR notifier. This client writes
+ * nothing until the channel is open AND a property read came back with ret_code 0.
+ *
+ * Boot-args: negronichg_glink=1 (default 0; needs negroniadsp=1 and step 9, GLINK), negronichg_ma
+ * (USB input current limit, default 1500, cap 2000, 0 = read only), negronichg_glink_poll (seconds,
+ * default 20). Runs on its own kernel thread (started by NegroniBattery::start); it waits up to 10 min
+ * for GLINK (ADSP step 9). GLINK has one recursive lock (0242): this thread, the audio writer and the
+ * ADSP thread may all send; after the ADSP steps this thread is the one that polls GLINK.
+ * Log prefix "NEGRONI BATTERY: glink:".
+ *
+ * Patch 0277: the HLOS charge loop of OxygenOS (oplus_charger.c: every OPLUS_CHG_UPDATE_INTERVAL_SEC = 5 s,
+ * :110, oplus_chg_update_work :14580 -> oplus_chg_protection_check :10583 -> oplus_chg_check_tbatt_is_good
+ * :7950, which writes FV + FCC on a band change, :8028-8029; this loop re-sends them every 5 s). After READY and with USB in, every negronichg_loop_s (5) s: read BATT_TEMP, pick the JEITA
+ * band of the DT (kBand: out/live.dts qcom,battery_charger :6681-6718, the decision order of
+ * oplus_charger.c:8041-8059, 2.0 C hysteresis back toward normal :7849), then write the float voltage
+ * BATT_VOLT_MAX (id 8, mV: smbchg_float_voltage_set, oplus_battery_sm8450.c:8194-8226; OxygenOS writes the
+ * per-cell value x qcom,vbatt_num 2, oplus_charger.c:7252, live.dts:6749) and the charge current
+ * BATT_CHG_CTRL_LIM (id 10, uA: smbchg_set_fastchg_current_raw :7624-7646), each read back. The FCC is
+ * min(band, thermal level of 0283: qcom,thermal-mitigation 3000/1500/1000/500 mA, live.dts:6647). Bands
+ * "hot" (> 53.0 C), "low" and "removed" stop charging with BATT_CHG_EN = 0 (smbchg_charging_disable :9136);
+ * the loop writes BATT_CHG_EN = 1 again when the band is good. Safety: every FV is <= 4435 mV per cell
+ * (live.dts:6709) and every FCC <= 1100 mA (live.dts:6708, the non-PD value; this client does no PD/QC
+ * negotiation); a table value above them turns the loop off (bands_ok). The FV unit comes from the PD's
+ * own BATT_VOLT_MAX: 6000-9000 = pack mV (x2), 3000-4600 = cell mV (x1), anything else = no FV write.
+ * Writes are logged only on a change or a failure; 5 failed writes in a row stop that write for the plug.
+ * Boot-args: negronichg_loop=1 (default; 0 = off: the 0274 behaviour), negronichg_loop_s (2..60, 5).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include "negroni_adsp.h"
+#include "negroni_chg_glink.h"
+
+extern void IOSleep(unsigned int ms);
+extern kern_return_t thread_terminate(thread_t);
+
+#define BC_OWNER                32778u
+#define BC_TYPE_REQ             1u
+#define BC_TYPE_NOTIFY          2u
+#define BC_SET_NOTIFY_REQ       0x04u
+#define BC_NOTIFY_IND           0x07u
+#define BC_BATTERY_GET          0x30u
+#define BC_BATTERY_SET          0x31u
+#define BC_USB_GET              0x32u
+#define BC_USB_SET              0x33u
+#define BC_OEM_READ_BUFFER      0x10000u
+#define OEM_WORDS               128u
+
+/* battery_property_id (OnePlus enum: the Qualcomm ids 0..23, then the OPLUS ids) */
+#define BATT_STATUS             0u
+#define BATT_CAPACITY           4u
+#define BATT_VOLT_NOW           7u
+#define BATT_CURR_NOW           9u
+#define BATT_VOLT_MAX           8u      /* 0277: FV, mV (smbchg_float_voltage_set, oplus_battery_sm8450.c:8218) */
+#define BATT_CHG_CTRL_LIM       10u     /* FCC, uA */
+#define BATT_TEMP               12u
+#define BATT_CHG_EN             24u     /* OPLUS: smbchg_charging_enable() */
+/* usb_property_id (OnePlus enum) */
+#define USB_ONLINE              0u
+#define USB_VOLT_NOW            1u
+#define USB_CURR_NOW            3u
+#define USB_INPUT_CURR_LIMIT    5u      /* uA (oplus_chg_set_input_current: current_ma * 1000) */
+#define USB_ADAP_TYPE           7u
+#define USB_SUSPEND_PMIC        26u     /* OPLUS */
+#define USB_IN_STATUS           47u     /* OPLUS: plug status, low byte */
+
+#define CHG_DEFAULT_MA          1500u
+#define CHG_MAX_MA              2000u   /* live.dts:6652-6654 input_current_charger/pd/qc_ma = 2000 */
+#define ICL_STEP_MA             500u
+#define CHG_TRIES               5u      /* ICL ramps per plug */
+#define REPLY_MS                1500u   /* OnePlus waits 2500 ms (BC_WAIT_TIME_MS) */
+#define OPEN_WAIT_MS            30000u  /* first wait for the charger PD's OPEN */
+#define LOG_ERR_MAX             40u
+
+struct bc_hdr {
+	uint32_t owner, type, opcode;
+};
+struct bc_req {
+	struct bc_hdr hdr;
+	uint32_t battery_id, property_id, value;
+};
+struct bc_resp {
+	struct bc_hdr hdr;
+	uint32_t property_id, value, ret_code;
+};
+struct bc_notify_req {
+	struct bc_hdr hdr;
+	uint32_t battery_id, power_state, low_capacity, high_capacity;
+};
+struct bc_oem_req {
+	struct bc_hdr hdr;
+	uint32_t data_size;
+};
+_Static_assert(sizeof(struct bc_req) == 24 && sizeof(struct bc_resp) == 24, "pmic_glink property messages");
+_Static_assert(sizeof(struct bc_notify_req) == 28 && sizeof(struct bc_oem_req) == 16, "pmic_glink messages");
+
+static LCK_GRP_DECLARE(negroni_chg_grp, "negroni_chg_glink");
+static LCK_MTX_DECLARE(negroni_chg_lock, &negroni_chg_grp);
+static struct negroni_chg_glink_status st_pub;          /* under negroni_chg_lock */
+static struct negroni_chg_glink_status st;              /* the ADSP thread's copy */
+static bool chg_wanted_parsed, chg_wanted;
+static uint32_t chg_ma = CHG_DEFAULT_MA, poll_s = 20;
+static uint32_t icl_want;                               /* 0370: the input limit for this adapter type, mA */
+static bool loop_on;                                    /* 0277 */
+static uint32_t loop_s = 5;                             /* 0277: OPLUS_CHG_UPDATE_INTERVAL_SEC, oplus_charger.c:110 */
+
+/*
+ * The last answer. chg_rx runs inside negroni_glink_poll() of any thread (under the GLINK lock), so
+ * rx_* are under rx_mtx; transact() moves an answer to ans_* (this client's thread only).
+ * Lock order: the GLINK lock, then rx_mtx; never the GLINK lock while rx_mtx is held.
+ */
+static LCK_MTX_DECLARE(rx_mtx, &negroni_chg_grp);
+static uint8_t rx_buf[OEM_WORDS * 4 + 32], ans_buf[OEM_WORDS * 4 + 32];
+static uint32_t rx_len, ans_len;
+static bool rx_have;
+static uint32_t notify_count, notify_last, stray_count, err_lines;
+static bool notify_usb;
+
+/* 0369: VOOC (the block before idle()) */
+static uint32_t vooc_mode;                      /* boot-arg negronichg_vooc: 0 = VOOC off (default), 1 = allowed */
+/* 0370 */
+static uint32_t wr_mask = 0x7f, wr_delay_s, wr_skip_logged;
+static bool wr_safety;                  /* review N3: VOOC safety writes (park, ENABLE=0, un-park) bypass the mask and delay */
+static bool force_off_proactive;        /* vooc_force_off(): its ENABLE=0 is the bisect target (class 0x10), not a safety write */
+static bool delay_end_done;
+static bool notify_sent;                /* review N3: BC_SET_NOTIFY_REQ sent (deferred while the write delay runs) */
+static uint64_t start_ns;
+static uint32_t icl_bytype = 1;         /* boot-arg negronichg_icl_bytype: ICL per adapter type as stock (default) */
+static void vooc_note(uint32_t n);
+static void vooc_events(void);
+static bool vooc_policy(int32_t dc);
+static void vooc_unplugged(void);
+static void vooc_force_off(const char *why);
+static void vooc_reset(const char *why);
+static void vooc_status(uint32_t v, const char *src);
+#define VOOC_OWNS()     (vc.parked || vc.park_pending)  /* the PMIC charger must stay off */
+static struct {
+	bool parked, ongoing, suspend_req, pd_svooc, in_events, off_done;
+	int32_t saved_icl_ma;           /* review N2: the ICL read before the park (mA), restored at the un-park; 0 = none */
+	bool park_pending;              /* review B2: a 0x52 came, the park writes are not acked yet (retried) */
+	uint64_t park_retry_ns;
+	int32_t enable;                 /* USB_VOOCPHY_ENABLE read back, -1 unknown */
+	uint64_t park_ns;
+	uint32_t code, adapter, sub, mw, statuses, recoveries, lines;
+} vc = { .enable = -1 };
+
+/*
+ * 0374: the Type-C port role (README-usb.md "0374"). Boot-arg negronichg_typec (default 0 = off), bits:
+ * 1 = sink only: USB_TYPEC_MODE (usb id 19) = TYPEC_PORT_ROLE_SNK (1) at the first answer after the open,
+ * and again when the phone is the Type-C source (read 1 or BC_OTG_ENABLE 0x50); 2 = USB_OTG_SWITCH (15) = 0
+ * at the first answer (stock OTG switch off); 4 = watch only (reads and log lines, no write). Any value
+ * logs the role. With negronichg_glink=0 a non-zero value runs a typec-only client (no charger writes).
+ */
+#define TC_SINK                 0x1u
+#define TC_OTGSW                0x2u
+#define TC_WATCH                0x4u
+static uint32_t typec_arg;                      /* boot-arg negronichg_typec */
+static bool typec_only;                         /* negronichg_typec != 0 with negronichg_glink=0 */
+static bool tc_ev, tc_otg_req;                  /* under rx_mtx: set by chg_rx (0x50/0x51/0x53/0x55/0x57; 0x50) */
+static uint32_t tc_ev_last;
+
+
+#define LOG(fmt, ...) printf("NEGRONI BATTERY: glink: " fmt "\n", ##__VA_ARGS__)
+#define LOG_ERR(fmt, ...) do { \
+	if (err_lines < LOG_ERR_MAX || err_lines % 100 == 0) { LOG(fmt, ##__VA_ARGS__); } \
+	err_lines++; \
+} while (0)
+
+bool
+negroni_chg_glink_wanted(void)
+{
+	if (!chg_wanted_parsed) {
+		uint32_t on = 0, adsp = 0, ma = CHG_DEFAULT_MA, ps = 20, lp = 1, ls = 5;
+		chg_wanted_parsed = true;
+		(void)PE_parse_boot_argn("negronichg_glink", &on, sizeof(on));
+		(void)PE_parse_boot_argn("negroniadsp", &adsp, sizeof(adsp));
+		(void)PE_parse_boot_argn("negronichg_ma", &ma, sizeof(ma));
+		(void)PE_parse_boot_argn("negronichg_glink_poll", &ps, sizeof(ps));
+		(void)PE_parse_boot_argn("negronichg_loop", &lp, sizeof(lp));
+		(void)PE_parse_boot_argn("negronichg_loop_s", &ls, sizeof(ls));
+		(void)PE_parse_boot_argn("negronichg_vooc", &vooc_mode, sizeof(vooc_mode));    /* 0369 */
+		(void)PE_parse_boot_argn("negronichg_wr", &wr_mask, sizeof(wr_mask));           /* 0370 */
+		(void)PE_parse_boot_argn("negronichg_wr_delay_s", &wr_delay_s, sizeof(wr_delay_s));
+		(void)PE_parse_boot_argn("negronichg_icl_bytype", &icl_bytype, sizeof(icl_bytype));
+		(void)PE_parse_boot_argn("negronichg_typec", &typec_arg, sizeof(typec_arg));    /* 0374 */
+		typec_arg &= TC_SINK | TC_OTGSW | TC_WATCH;
+		if (typec_arg & TC_WATCH) {
+			typec_arg = TC_WATCH;           /* watch only: no write bit counts */
+		}
+		typec_only = typec_arg != 0 && on == 0 && adsp != 0;
+		wr_delay_s = MIN(wr_delay_s, 3600u);
+		vooc_mode = vooc_mode ? 1u : 0u;
+		chg_wanted = on != 0 && adsp != 0;
+		chg_ma = MIN(ma, CHG_MAX_MA);
+		poll_s = MIN(MAX(ps, 5u), 600u);
+		loop_on = chg_wanted && lp != 0;
+		loop_s = MIN(MAX(ls, 2u), 60u);
+	}
+	return chg_wanted;
+}
+
+/* 0374: the ADSP's PMIC_RTR_ADSP_APPS OPEN is answered (negroni_adsp.c) for the full client or the typec-only one */
+bool
+negroni_chg_pmic_wanted(void)
+{
+	return negroni_chg_glink_wanted() || typec_only;
+}
+
+bool
+negroni_chg_glink_get(struct negroni_chg_glink_status *out)
+{
+	if (!negroni_chg_glink_wanted() || out == NULL) {
+		return false;
+	}
+	lck_mtx_lock(&negroni_chg_lock);
+	*out = st_pub;
+	lck_mtx_unlock(&negroni_chg_lock);
+	out->wanted = true;
+	return true;
+}
+
+static void
+publish(void)
+{
+	lck_mtx_lock(&negroni_chg_lock);
+	st_pub = st;
+	lck_mtx_unlock(&negroni_chg_lock);
+}
+
+static uint64_t
+now_ns(void)
+{
+	uint64_t t, ns;
+	clock_get_uptime(&t);
+	absolutetime_to_nanoseconds(t, &ns);
+	return ns;
+}
+
+/* ---- 0277: the power hub (temperatures for the thermal policy) and the thermal FCC level ---- */
+static LCK_MTX_DECLARE(hub_mtx, &negroni_chg_grp);
+static int32_t hub_t[NEGRONI_PWR_T_N];
+static uint64_t hub_ns[NEGRONI_PWR_T_N];
+static volatile uint32_t therm_level_req;
+
+void
+negroni_pwr_temp_set(unsigned which, int32_t centi_c)
+{
+	if (which >= NEGRONI_PWR_T_N) {
+		return;
+	}
+	lck_mtx_lock(&hub_mtx);
+	hub_t[which] = centi_c;
+	hub_ns[which] = now_ns();
+	lck_mtx_unlock(&hub_mtx);
+}
+
+bool
+negroni_pwr_temp_get(unsigned which, int32_t *centi_c, uint32_t max_age_ms)
+{
+	bool ok = false;
+	uint64_t t = now_ns();
+
+	if (which >= NEGRONI_PWR_T_N || centi_c == NULL) {
+		return false;
+	}
+	lck_mtx_lock(&hub_mtx);
+	if (hub_ns[which] != 0 && t >= hub_ns[which] && t - hub_ns[which] <= (uint64_t)max_age_ms * 1000000ull) {
+		*centi_c = hub_t[which];
+		ok = true;
+	}
+	lck_mtx_unlock(&hub_mtx);
+	return ok;
+}
+
+void
+negroni_chg_glink_set_thermal_level(unsigned level)
+{
+	therm_level_req = level > 4 ? 4 : level;
+}
+
+/*
+ * 0368: every message on PMIC_RTR_ADSP_APPS during the first 10 s after the first one (the ADSP
+ * start; also the answers to our requests), then notifications and other owners (UCSI 32779,
+ * USBC_PAN 32780 altmode) up to 200 lines: owner, type, opcode, length and the first 5 body words.
+ * Runs under the GLINK lock (printf only).
+ */
+#define RX_LOG_WINDOW_NS        (10ull * NSEC_PER_SEC)
+#define RX_LOG_MAX              200u
+static uint64_t rx_first_ns;
+static uint32_t rx_lines, rx_seen;
+
+static void
+rx_log(const uint8_t *data, uint32_t len)
+{
+	uint32_t w[8] = { 0 };
+	uint64_t t = now_ns();
+
+	if (rx_first_ns == 0) {
+		rx_first_ns = t;
+	}
+	rx_seen++;
+	memcpy(w, data, MIN(len, (uint32_t)sizeof(w)));
+	bool early = t - rx_first_ns < RX_LOG_WINDOW_NS;
+	bool notable = len < sizeof(struct bc_hdr) || w[0] != BC_OWNER || w[2] == BC_NOTIFY_IND;
+	if (!early && !(notable && rx_lines < RX_LOG_MAX)) {
+		return;
+	}
+	rx_lines++;
+	LOG("rx #%u +%llu ms: owner %u type %u opcode 0x%x len %u: %08x %08x %08x %08x %08x%s", rx_seen,
+	    (t - rx_first_ns) / NSEC_PER_MSEC, w[0], w[1], w[2], len, w[3], w[4], w[5], w[6], w[7],
+	    w[0] == BC_OWNER && w[2] == BC_NOTIFY_IND ? " (BC_NOTIFY_IND)" : w[0] != BC_OWNER ? " (not battery_charger)" : "");
+}
+
+static void
+chg_rx(const uint8_t *data, uint32_t len)
+{
+	struct bc_hdr h;
+
+	rx_log(data, len);                      /* 0368 */
+	if (len < sizeof(h)) {
+		stray_count++;
+		return;
+	}
+	memcpy(&h, data, sizeof(h));
+	if (h.owner != BC_OWNER) {
+		stray_count++;
+		return;
+	}
+	lck_mtx_lock(&rx_mtx);
+	if (h.opcode == BC_NOTIFY_IND) {
+		uint32_t n = 0;
+		if (len >= sizeof(h) + 4) {
+			memcpy(&n, data + sizeof(h), 4);
+		}
+		notify_count++;
+		notify_last = n;
+		vooc_note(n);                   /* 0369 */
+		if (n == 0x50 || n == 0x51 || n == 0x53 || n == 0x55 || n == 0x57) {
+			tc_ev = true;               /* 0374: OTG on/off, CID, Type-C state, plug-in */
+			tc_ev_last = n;
+			if (n == 0x50) {
+				tc_otg_req = true;      /* BC_OTG_ENABLE: the PD wants to source VBUS */
+			}
+		}
+		if (n == BC_USB_GET) {
+			notify_usb = true;          /* a plug event: the next cycle comes early */
+		}
+	} else {
+		if (rx_have) {
+			stray_count++;              /* an answer nobody took (a late one) */
+		}
+		rx_len = MIN(len, (uint32_t)sizeof(rx_buf));
+		memcpy(rx_buf, data, rx_len);
+		rx_have = true;
+	}
+	lck_mtx_unlock(&rx_mtx);
+}
+
+/* Take the answer that chg_rx stored, if any, into ans_buf. */
+static bool
+take_answer(void)
+{
+	bool have;
+
+	lck_mtx_lock(&rx_mtx);
+	have = rx_have;
+	if (have) {
+		ans_len = rx_len;
+		memcpy(ans_buf, rx_buf, rx_len);
+		rx_have = false;
+	}
+	lck_mtx_unlock(&rx_mtx);
+	return have;
+}
+
+/* Send one message and wait for the answer with this opcode (and property, for 24-byte answers). */
+static int
+transact(const void *msg, uint32_t len, uint32_t opcode, int64_t prop)
+{
+	int rc;
+
+	(void)take_answer();                    /* drop a late answer of an earlier request */
+	rc = negroni_glink_send(NEGRONI_GLINK_PMIC, msg, len);
+	if (rc != 0) {
+		return rc;
+	}
+	for (uint32_t ms = 0; ms < REPLY_MS; ms++) {
+		negroni_glink_poll();
+		if (take_answer()) {
+			struct bc_hdr h;
+			memcpy(&h, ans_buf, sizeof(h));
+			if (h.opcode == opcode) {
+				if (prop < 0 || ans_len != sizeof(struct bc_resp) ||
+				    ((const struct bc_resp *)(const void *)ans_buf)->property_id == (uint32_t)prop) {
+					return 0;
+				}
+			}
+			stray_count++;
+		}
+		if (!negroni_glink_up(NEGRONI_GLINK_PMIC)) {
+			return ENOTCONN;
+		}
+		IOSleep(1);
+	}
+	return ETIMEDOUT;
+}
+
+/* Property get/set. 0: answered (ret_code in *ret, value in *val); else a transport error. */
+static int
+prop_io(uint32_t opcode, uint32_t prop, uint32_t value, uint32_t *val, uint32_t *ret)
+{
+	struct bc_req r = { { BC_OWNER, BC_TYPE_REQ, opcode }, 0, prop, value };
+	int rc = transact(&r, sizeof(r), opcode, prop);
+
+	if (rc != 0) {
+		return rc;
+	}
+	if (ans_len != sizeof(struct bc_resp)) {
+		*ret = 0xffffffffu;
+		*val = 0;
+		return 0;
+	}
+	*val = ((const struct bc_resp *)(const void *)ans_buf)->value;
+	*ret = ((const struct bc_resp *)(const void *)ans_buf)->ret_code;
+	return 0;
+}
+
+/* A read for the poll: true when ret_code 0. Logs a transport error (bounded). */
+static unsigned good_reads, bad_reads, lost_reads;
+static bool
+get(uint32_t opcode, uint32_t prop, uint32_t *val)
+{
+	uint32_t ret = 0;
+	int rc;
+
+	if (lost_reads >= 3) {
+		return false;                   /* 3 lost in this cycle: the rest waits for the next cycle */
+	}
+	rc = prop_io(opcode, prop, 0, val, &ret);
+	if (rc != 0) {
+		lost_reads++;
+		LOG_ERR("read %s %u: no answer (%s)", opcode == BC_USB_GET ? "usb" : "battery", prop,
+		    rc == ETIMEDOUT ? "timeout" : rc == ENOTCONN ? "channel down" : rc == EAGAIN ? "no remote intent" : "send error");
+		return false;
+	}
+	if (ret != 0) {
+		bad_reads++;
+		return false;
+	}
+	good_reads++;
+	return true;
+}
+
+/* 0277: log = false logs only a failure (bounded): the loop re-sends the same values every 5 s. */
+/*
+ * 0370: write classes for bisecting (boot-arg negronichg_wr, bit set = allowed; default 0x7f all) and a delay
+ * after the client start before any write (negronichg_wr_delay_s, default 0). Every write logs +ms since start.
+ */
+#define WR_ICL          0x01u   /* USB_INPUT_CURR_LIMIT (5) */
+#define WR_SUSPEND      0x02u   /* USB_SUSPEND_PMIC (26) */
+#define WR_CHG_EN       0x04u   /* BATT_CHG_EN (24) */
+#define WR_FV_FCC       0x08u   /* BATT_VOLT_MAX (8), BATT_CHG_CTRL_LIM (10) */
+#define WR_VOOC         0x10u   /* USB 13, 25; BATT 28, 29, 37 (0369) */
+#define WR_NOTIFY       0x20u   /* BC_SET_NOTIFY_REQ */
+#define WR_OTHER        0x40u
+
+static uint32_t
+wr_class(uint32_t opcode, uint32_t prop)
+{
+	if (opcode == BC_USB_SET) {
+		return prop == USB_INPUT_CURR_LIMIT ? WR_ICL : prop == USB_SUSPEND_PMIC ? WR_SUSPEND :
+		       (prop == 13u || prop == 25u) ? WR_VOOC : WR_OTHER;
+	}
+	if (opcode == BC_BATTERY_SET) {
+		return prop == BATT_CHG_EN ? WR_CHG_EN : (prop == BATT_VOLT_MAX || prop == BATT_CHG_CTRL_LIM) ? WR_FV_FCC :
+		       (prop == 28u || prop == 29u || prop == 37u) ? WR_VOOC : WR_OTHER;
+	}
+	return WR_OTHER;
+}
+
+/* false: this write class is off (negronichg_wr) or the start delay runs (logged once per class) */
+static bool
+wr_allowed(uint32_t cls, const char *what)
+{
+	bool delay = wr_delay_s && now_ns() - start_ns < (uint64_t)wr_delay_s * NSEC_PER_SEC;
+	if (wr_safety || ((wr_mask & cls) && !delay)) {
+		return true;
+	}
+	if (!(wr_skip_logged & cls) || delay) {
+		if (!(wr_skip_logged & cls)) {
+			LOG("write %s skipped: %s (class %#x)", what, delay ? "negronichg_wr_delay_s runs" : "off by negronichg_wr", cls);
+		}
+		wr_skip_logged |= cls;
+	}
+	return false;
+}
+
+static bool
+put_log(uint32_t opcode, uint32_t prop, uint32_t value, const char *what, bool log)
+{
+	uint32_t val = 0, ret = 0;
+	int rc;
+
+	if (!st.ready) {
+		return false;                   /* never a write before the PD answered a read */
+	}
+	if (!wr_allowed(wr_class(opcode, prop), what)) {
+		return false;                   /* 0370 */
+	}
+	rc = prop_io(opcode, prop, value, &val, &ret);
+	if (log) {
+		LOG("write %s = %u: %s (ret_code %#x) +%llu ms", what, value, rc ? "no answer" : ret ? "REFUSED" : "ok", rc ? 0 : ret,
+		    (now_ns() - start_ns) / NSEC_PER_MSEC);
+	} else if (rc != 0 || ret != 0) {
+		LOG_ERR("write %s = %u: %s (ret_code %#x)", what, value, rc ? "no answer" : "REFUSED", rc ? 0 : ret);
+	}
+	return rc == 0 && ret == 0;
+}
+
+static bool
+put(uint32_t opcode, uint32_t prop, uint32_t value, const char *what)
+{
+	return put_log(opcode, prop, value, what, true);
+}
+
+static void
+dump_props_once(void)
+{
+	static bool done;
+	char line[300];
+	size_t at = 0;
+	uint32_t v, ret;
+
+	if (done) {
+		return;
+	}
+	done = true;
+	for (unsigned pass = 0; pass < 2; pass++) {
+		uint32_t opcode = pass ? BC_USB_GET : BC_BATTERY_GET;
+		unsigned n = pass ? 12 : 25;
+		at = 0;
+		at += snprintf(line + at, sizeof(line) - at, "%s properties (id=value/ret):", pass ? "usb" : "battery");
+		for (unsigned i = 0; i < n && at < sizeof(line) - 24; i++) {
+			if (prop_io(opcode, i, 0, &v, &ret) != 0) {
+				at += snprintf(line + at, sizeof(line) - at, " %u=?", i);
+			} else if (ret) {
+				at += snprintf(line + at, sizeof(line) - at, " %u=/%x", i, ret);
+			} else {
+				at += snprintf(line + at, sizeof(line) - at, " %u=%d", i, (int)v);
+			}
+		}
+		LOG("%s", line);
+	}
+}
+
+/* OEM read buffer: the external gauge numbers OxygenOS shows. true when it answered with data. */
+static bool
+read_oem(int32_t w[4])
+{
+	struct bc_oem_req r = { { BC_OWNER, BC_TYPE_REQ, BC_OEM_READ_BUFFER }, OEM_WORDS * 4 };
+	uint32_t size;
+
+	if (lost_reads >= 3) {
+		return false;
+	}
+	if (transact(&r, sizeof(r), BC_OEM_READ_BUFFER, -1) != 0 || ans_len < sizeof(struct bc_hdr) + OEM_WORDS * 4 + 4) {
+		return false;
+	}
+	memcpy(&size, ans_buf + sizeof(struct bc_hdr) + OEM_WORDS * 4, 4);
+	if (size < 16 || size > OEM_WORDS * 4) {
+		return false;
+	}
+	memcpy(w, ans_buf + sizeof(struct bc_hdr), 16);
+	return true;
+}
+
+static bool was_online;
+static unsigned tries, en_tries, susp_tries, cycles;
+static uint32_t last_key = 0xffffffffu;
+
+/* oplus_chg_set_input_current, simplified: 500 mA steps up to the target; back one step when VBUS
+ * falls under the AICL point (4500 mV, 4550 mV above 4100 mV per cell). */
+static void
+icl_ramp(int32_t cell_mv)
+{
+	uint32_t aicl = cell_mv > 4100 ? 4550 : 4500, ma = MIN(ICL_STEP_MA, icl_want), good = 0, v = 0;
+
+	for (;;) {
+		char what[48];
+		snprintf(what, sizeof(what), "USB_INPUT_CURR_LIMIT %u mA (uA)", ma);
+		if (!put(BC_USB_SET, USB_INPUT_CURR_LIMIT, ma * 1000u, what)) {
+			break;
+		}
+		for (int i = 0; i < 100; i++) {         /* ~100 ms for VBUS to settle (OnePlus: 90 ms) */
+			negroni_glink_poll();
+			IOSleep(1);
+		}
+		if (get(BC_USB_GET, USB_VOLT_NOW, &v) && v / 1000 < aicl && good) {
+			LOG("ICL %u mA: VBUS %u mV under the AICL point %u mV: back to %u mA", ma, v / 1000, aicl, good);
+			(void)put(BC_USB_SET, USB_INPUT_CURR_LIMIT, good * 1000u, "USB_INPUT_CURR_LIMIT (back one step)");
+			break;
+		}
+		good = ma;
+		if (ma >= icl_want) {
+			break;
+		}
+		ma = MIN(ma + ICL_STEP_MA, icl_want);
+	}
+	st.icl_set = good != 0;
+}
+
+/*
+ * ---- 0277: the charge loop ----
+ * JEITA bands of the DT (out/live.dts qcom,battery_charger), per cell, in the decision order of
+ * oplus_chg_check_tbatt_status (oplus_charger.c:8041-8059). The lower bounds are in 0.1 C; the DT
+ * cold/removed values are negated by the parser (oplus_charger.c:5446, :5463). FCC: the plain (non-PD,
+ * non-QC) values: this client negotiates no PD/QC voltage (5 V, ICL <= 2000 mA). vbatt > 4180 mV has
+ * _low/_high variants in the DT that are equal here (:6687-6696). fv 0 / fcc 0 = no charging
+ * (oplus_chg_set_charging_current returns for HIGH/LOW/REMOVED, oplus_charger.c:6890-6894).
+ */
+#define FV_DT_MV        4435u   /* live.dts:6709 temp_normal_vfloat_mv 0x1153: the highest band FV */
+#define FCC_DT_MA       1100u   /* live.dts:6708 temp_normal_fastchg_current_ma 0x44c: the highest plain FCC */
+#define VBATT_NUM       2u      /* live.dts:6749 qcom,vbatt_num; oplus_charger.c:7252 flv * vbatt_num */
+#define HYST_DC         20      /* oplus_charger.c:7849 HYSTERISIS_DECIDEGC */
+#define BAND_NORMAL     6
+#define LOOP_FAILS      5u
+struct chg_band {
+	const char *name;
+	int32_t lo_dc;                  /* lower bound, 0.1 C, inclusive */
+	uint32_t fv_mv;                 /* per cell; 0 = stop */
+	uint32_t fcc_ma;                /* 0 = stop */
+};
+static const struct chg_band kBand[] = {
+	{ "removed", INT32_MIN, 0, 0 },     /* <= -19.0 C (removed_bat_decidegc 0xbe :6681) */
+	{ "low", -189, 0, 0 },              /* -19.0 .. -10.1 C: LOW_TEMP (:8055) */
+	{ "cold", -100, 4435, 600 },        /* cold_bat_decidegc 0x64 :6682; FV 0x1153 :6683; FCC 0x258 :6684 */
+	{ "little_cold", 0, 4435, 1100 },   /* :6685; FV :6686; FCC 0x44c :6687/:6689 */
+	{ "cool", 50, 4435, 1100 },         /* :6694; FV :6695; FCC 0x44c :6696 */
+	{ "little_cool", 120, 4435, 1100 }, /* :6702; FV :6703; FCC 0x44c :6704 */
+	{ "normal", 160, 4435, 1100 },      /* :6707; FCC 0x44c :6708; FV 0x1153 :6709 */
+	{ "warm", 450, 4130, 500 },         /* :6712; FV 0x1022 :6713; FCC 0x1f4 :6717 (screen-on value; 0x44c :6714 screen off) */
+	{ "hot", 531, 0, 0 },               /* > 53.0 C: HIGH_TEMP (hot_bat_decidegc 0x212 :6718; ">" at :8041) */
+};
+#define NBANDS ((int)(sizeof(kBand) / sizeof(kBand[0])))
+static const uint32_t kThermMa[5] = { 0, 3000, 1500, 1000, 500 };      /* live.dts:6647 qcom,thermal-mitigation (uA / 1000) */
+static uint32_t fv_scale;               /* 0 unknown, 1 cell mV, 2 pack mV */
+static unsigned fv_fails, fcc_fails, en_fails, loop_runs, mismatch_lines;
+static bool notemp_logged, fvunit_logged;
+
+/* Every table value at or below the DT maximum, else the loop stays off. */
+static bool
+bands_ok(void)
+{
+	for (int i = 0; i < NBANDS; i++) {
+		if (kBand[i].fv_mv > FV_DT_MV || kBand[i].fcc_ma > FCC_DT_MA) {
+			LOG("loop: band %s FV %u mV / FCC %u mA above the DT maximum %u mV / %u mA: REFUSED, loop off",
+			    kBand[i].name, kBand[i].fv_mv, kBand[i].fcc_ma, FV_DT_MV, FCC_DT_MA);
+			return false;
+		}
+	}
+	return true;
+}
+
+static int
+band_of(int32_t dc)
+{
+	for (int i = NBANDS - 1; i > 0; i--) {
+		if (dc >= kBand[i].lo_dc) {
+			return i;
+		}
+	}
+	return 0;
+}
+
+/* A new plug (or USB out): the next loop writes everything again. chg_stopped stays: a hot battery
+ * is not enabled by a re-plug; the loop restarts it when the band is good. */
+static void
+loop_reset(void)
+{
+	st.band = -1;
+	st.fv_set_mv = st.fcc_set_ma = 0;
+	fv_fails = fcc_fails = en_fails = 0;
+}
+
+static void
+cycle(void)
+{
+	uint32_t v;
+	int32_t oem[4];
+	bool any = false;
+	uint64_t t = now_ns();
+
+	good_reads = bad_reads = lost_reads = 0;
+	cycles++;
+	/* battery */
+	st.bstatus = get(BC_BATTERY_GET, BATT_STATUS, &v) ? (int32_t)v : -1;
+	int32_t soc = -1;
+	uint8_t src = 0;
+	if (read_oem(oem) && oem[3] >= 0 && oem[3] <= 10000) {
+		soc = oem[3];
+		src = 1;
+	}
+	uint32_t cap = 0;
+	bool capOk = get(BC_BATTERY_GET, BATT_CAPACITY, &cap) && cap <= 10000;
+	if (soc < 0 && capOk) {
+		soc = (int32_t)cap;
+		src = 2;
+	}
+	st.vbat_mv = get(BC_BATTERY_GET, BATT_VOLT_NOW, &v) ? (int32_t)(v / 1000) : 0;
+	st.ibat_ma = get(BC_BATTERY_GET, BATT_CURR_NOW, &v) ? (int32_t)v / 1000 : INT32_MIN;
+	st.temp_centi = get(BC_BATTERY_GET, BATT_TEMP, &v) ? (int32_t)v : INT32_MIN;
+	if (st.temp_centi != INT32_MIN && st.temp_centi >= -4000 && st.temp_centi <= 10000) {
+		negroni_pwr_temp_set(NEGRONI_PWR_T_BATT, st.temp_centi);       /* 0277: for 0278/0283 */
+	}
+	uint32_t fcc = 0;
+	bool fccOk = get(BC_BATTERY_GET, BATT_CHG_CTRL_LIM, &fcc);
+	st.fcc_ma = fccOk ? (int32_t)(fcc / 1000) : -1;
+	uint32_t fvr = 0;
+	bool fvOk = get(BC_BATTERY_GET, BATT_VOLT_MAX, &fvr);                 /* 0277: read back */
+	st.fv_mv = fvOk ? (int32_t)fvr : -1;
+	/* USB */
+	st.usb_online = get(BC_USB_GET, USB_ONLINE, &v) ? (int32_t)v : -1;
+	st.usb_mv = get(BC_USB_GET, USB_VOLT_NOW, &v) ? (int32_t)(v / 1000) : -1;
+	st.usb_ma = get(BC_USB_GET, USB_CURR_NOW, &v) ? (int32_t)v / 1000 : INT32_MIN;
+	st.icl_ma = get(BC_USB_GET, USB_INPUT_CURR_LIMIT, &v) ? (int32_t)(v / 1000) : -1;
+	uint32_t adap = 0, insts = 0, susp = 0;
+	bool adapOk = get(BC_USB_GET, USB_ADAP_TYPE, &adap);
+	bool instsOk = get(BC_USB_GET, USB_IN_STATUS, &insts);
+	bool suspOk = get(BC_USB_GET, USB_SUSPEND_PMIC, &susp);
+	st.usb_type = adapOk ? (int32_t)adap : -1;                          /* 0365: AdapterDetails FamilyCode */
+
+	any = good_reads > 0;
+	if (any && !st.ready) {
+		struct bc_notify_req n = { { BC_OWNER, BC_TYPE_NOTIFY, BC_SET_NOTIFY_REQ }, 0, 0, 0, 0 };
+		st.ready = true;
+		LOG("the charger PD answers (%u reads ok, %u refused, %u lost): READY", good_reads, bad_reads, lost_reads);
+		if (wr_allowed(WR_NOTIFY, "BC_SET_NOTIFY_REQ")) {
+			notify_sent = true;
+			LOG("subscribe to notifications (BC_SET_NOTIFY_REQ): %s +%llu ms",
+			    transact(&n, sizeof(n), BC_SET_NOTIFY_REQ, -1) == 0 ? "acked" : "no ack", (now_ns() - start_ns) / NSEC_PER_MSEC);
+		}
+		dump_props_once();
+		vooc_force_off("READY");        /* 0369 review F6 */
+		/* review N1: after a lost-read reset the ADSP may still run VOOC: read its status before any PMIC write */
+		if (get(BC_USB_GET, 12u /* USB_VOOCPHY_STATUS */, &v) && (v & 0xff) == 2) {
+			vooc_status(v, "READY check");
+		}
+	}
+	/* review N3: when negronichg_wr_delay_s ends: the deferred subscribe and the VOOC-off write */
+	if (st.ready && wr_delay_s && !delay_end_done && now_ns() - start_ns >= (uint64_t)wr_delay_s * NSEC_PER_SEC) {
+		struct bc_notify_req n2 = { { BC_OWNER, BC_TYPE_NOTIFY, BC_SET_NOTIFY_REQ }, 0, 0, 0, 0 };
+		delay_end_done = true;
+		LOG("the write delay (%u s) ended +%llu ms", wr_delay_s, (now_ns() - start_ns) / NSEC_PER_MSEC);
+		if (!notify_sent && wr_allowed(WR_NOTIFY, "BC_SET_NOTIFY_REQ")) {
+			notify_sent = true;
+			LOG("subscribe to notifications (BC_SET_NOTIFY_REQ): %s +%llu ms",
+			    transact(&n2, sizeof(n2), BC_SET_NOTIFY_REQ, -1) == 0 ? "acked" : "no ack", (now_ns() - start_ns) / NSEC_PER_MSEC);
+		}
+		vooc_force_off("write delay ended");
+	}
+	if (!any && st.ready && lost_reads > 0) {
+		st.ready = false;               /* no writes again until a read works */
+		vooc_reset("the PD stopped answering");         /* 0369 review F7 */
+		LOG_ERR("no read answered in this cycle (%u lost): not ready, writes stop", lost_reads);
+	}
+	if (soc >= 0) {
+		if (soc != st.soc_centi) {
+			st.soc_change_ns = t;
+		}
+		st.soc_centi = soc;
+		st.soc_src = src;
+		st.soc_ns = t;
+	}
+
+	/* plug: USB_ONLINE, the OPLUS USB_IN_STATUS, or VBUS */
+	/* the plug edge only when a USB read answered; a lost cycle keeps the last state */
+	bool usbKnown = st.usb_online >= 0 || instsOk || st.usb_mv >= 0;
+	bool online = usbKnown ? (st.usb_online == 1 || (instsOk && (insts & 0xff) != 0) || st.usb_mv >= 4000) : was_online;
+	if (online && !was_online) {
+		tries = en_tries = susp_tries = 0;
+		st.icl_set = st.chg_en_set = false;
+		loop_reset();
+		LOG("USB in (online %d in_status %#x VBUS %d mV adapter type %u)", st.usb_online, insts, st.usb_mv, adap);
+		vooc_force_off("USB in");       /* 0369 review F6 */
+	} else if (!online && was_online) {
+		LOG("USB out");
+		st.icl_set = st.chg_en_set = false;
+		loop_reset();
+		vooc_unplugged();               /* 0369 */
+	}
+	was_online = online;
+
+	/*
+	 * 0370: the input limit per adapter type as stock oplus_chg_set_input_current (oplus_charger.c:7031-7046, DT):
+	 * SDP 500 mA (qcom,input_current_usb_ma), CDP 1500 (input_current_cdp_ma), DCP/PD chg_ma (<= 2000);
+	 * unknown type: no write. negronichg_icl_bytype=0: chg_ma for every type (0274).
+	 */
+	icl_want = chg_ma;
+	if (icl_bytype) {
+		icl_want = st.usb_type == 1 ? MIN(chg_ma, 500u) : st.usb_type == 3 ? MIN(chg_ma, 1500u) :
+		    (st.usb_type == 2 || st.usb_type >= 5) ? chg_ma : 0;
+		/* review B3: unknown type (0, ACA 4, failed read -1) and the ICL near 0 (e.g. after a recovery): 500 mA floor */
+		if (icl_want == 0 && chg_ma > 0 && !VOOC_OWNS() && st.icl_ma >= 0 && st.icl_ma < 100) {
+			icl_want = MIN(chg_ma, 500u);
+		}
+	}
+	if (online && st.ready && icl_want > 0 && !VOOC_OWNS()) {   /* 0369: not while VOOC owns the path */
+		bool iclWrong = st.icl_ma < 0 || (uint32_t)(st.icl_ma + 100) < icl_want || (uint32_t)st.icl_ma > icl_want + 100;
+		if ((!st.icl_set || iclWrong) && tries < CHG_TRIES) {
+			tries++;
+			LOG("set the input limit (try %u of %u): now %d mA, want %u mA (adapter type %d%s)", tries, CHG_TRIES, st.icl_ma,
+			    icl_want, st.usb_type, icl_bytype ? ", per type" : "");
+			icl_ramp(st.vbat_mv > 5000 ? st.vbat_mv / 2 : st.vbat_mv);
+			st.icl_ma = get(BC_USB_GET, USB_INPUT_CURR_LIMIT, &v) ? (int32_t)(v / 1000) : -1;
+			LOG("input limit read back: %d mA", st.icl_ma);
+		}
+		if (suspOk && susp != 0 && susp_tries < CHG_TRIES) {
+			susp_tries++;
+			(void)put(BC_USB_SET, USB_SUSPEND_PMIC, 0, "USB_SUSPEND_PMIC (un-suspend)");
+		}
+		if (!st.chg_en_set && !st.chg_stopped && en_tries < CHG_TRIES) {      /* 0277: not while the loop stops it */
+			en_tries++;
+			st.chg_en_set = put(BC_BATTERY_SET, BATT_CHG_EN, 1, "BATT_CHG_EN");
+		}
+	}
+
+	st.gen++;
+	publish();
+
+	/* one line when a value moves, else every 15 cycles (5 min at 20 s) */
+	uint32_t key = (uint32_t)(st.soc_centi / 100) | (uint32_t)(st.bstatus & 0xf) << 8 | (uint32_t)online << 12 |
+	    (uint32_t)((st.icl_ma / 100) & 0xff) << 16 | (uint32_t)st.ready << 24 | (uint32_t)(st.band & 0xf) << 25 |
+	    (uint32_t)st.chg_stopped << 29;
+	if (key != last_key || cycles % 15 == 1) {
+		last_key = key;
+		LOG("soc %d.%02d%% (%s; capacity %s%u) vbat %d mV ibat %d mA temp %d status %d fcc %s%u uA | usb online %d "
+		    "in_status %s%#x vbus %d mV ibus %d mA icl %d mA type %s%u suspend %s%u | ready %d reads %u/%u/%u notify %u (last %#x) "
+		    "stray %u | fv %s%u loop %s band %s fv %d fcc %d lvl %u%s",
+		    st.soc_centi / 100, st.soc_centi < 0 ? 0 : st.soc_centi % 100, src == 1 ? "oem gauge" : src == 2 ? "capacity" : "none",
+		    capOk ? "" : "?", cap, st.vbat_mv, st.ibat_ma == INT32_MIN ? 0 : st.ibat_ma,
+		    st.temp_centi == INT32_MIN ? 0 : st.temp_centi, st.bstatus, fccOk ? "" : "?", fcc, st.usb_online,
+		    instsOk ? "" : "?", insts, st.usb_mv, st.usb_ma == INT32_MIN ? 0 : st.usb_ma, st.icl_ma, adapOk ? "" : "?", adap,
+		    suspOk ? "" : "?", susp, st.ready, good_reads, bad_reads, lost_reads, notify_count, notify_last, stray_count,
+		    fvOk ? "" : "?", fvr, loop_on ? "on" : "off", st.band >= 0 ? kBand[st.band].name : "-", st.fv_set_mv,
+		    st.fcc_set_ma, st.therm_level, st.chg_stopped ? " STOPPED" : "");
+	}
+}
+
+/*
+ * 0277: one run of the charge loop (OxygenOS oplus_chg_update_work every 5 s, oplus_charger.c:110, :14580;
+ * FV + FCC on a band change :8028-8029): battery temperature -> band -> FV -> FCC, each written and read back.
+ * USB in and READY only.
+ */
+static void
+charge_loop(void)
+{
+	uint32_t v = 0;
+
+	if (!loop_on || !st.ready || !was_online) {
+		return;
+	}
+	loop_runs++;
+	lost_reads = 0;
+	/* 1. the cell temperature (BATT_TEMP, hundredths of a degree: oplus_battery_sm8450.c:3060 divides by 10) */
+	int32_t centi = INT32_MIN;
+	if (get(BC_BATTERY_GET, BATT_TEMP, &v) && (int32_t)v >= -4000 && (int32_t)v <= 10000) {
+		centi = (int32_t)v;
+		st.temp_centi = centi;
+		negroni_pwr_temp_set(NEGRONI_PWR_T_BATT, centi);
+	}
+	if (centi == INT32_MIN) {
+		(void)vooc_policy(INT32_MIN);   /* 0369: no temperature = no VOOC */
+		if (!notemp_logged) {
+			notemp_logged = true;
+			LOG("loop: no battery temperature (BATT_TEMP): FV/FCC stay as the PD has them");
+		}
+		return;
+	}
+	notemp_logged = false;
+	/* 2. the band; back toward normal only 2.0 C inside the new band (oplus anti-shake, :7849) */
+	int32_t dc = centi / 10;
+	int nb = band_of(dc), cur = st.band;
+	if (cur >= 0 && nb != cur) {
+		bool recover = (cur > BAND_NORMAL && nb < cur) || (cur < BAND_NORMAL && nb > cur);
+		if (recover && band_of(cur > BAND_NORMAL ? dc + HYST_DC : dc - HYST_DC) != nb) {
+			nb = cur;
+		}
+	}
+	const struct chg_band *b = &kBand[nb];
+	if (nb != cur) {
+		LOG("loop: battery %s%d.%d C: band %s (FV %u mV/cell, FCC %u mA)%s", dc < 0 ? "-" : "", (dc < 0 ? -dc : dc) / 10,
+		    (dc < 0 ? -dc : dc) % 10, b->name,
+		    b->fv_mv, b->fcc_ma, b->fcc_ma ? "" : ": charging stops (BATT_CHG_EN = 0)");
+		st.band = (int8_t)nb;
+	}
+	/* 0369: VOOC policy (temperature to the ADSP, enable/disable); while VOOC feeds the battery, no PMIC writes */
+	if (vooc_policy(dc) && b->fv_mv != 0 && b->fcc_ma != 0) {
+		publish();
+		return;
+	}
+	/* 3. stop and restart */
+	if (b->fv_mv == 0 || b->fcc_ma == 0) {
+		bool first = !st.chg_stopped;
+		st.chg_stopped = true;          /* also when refused: cycle() must not enable it */
+		st.chg_en_set = false;
+		(void)put_log(BC_BATTERY_SET, BATT_CHG_EN, 0, "BATT_CHG_EN (stop: battery temperature)", first);
+		publish();
+		return;
+	}
+	if (st.chg_stopped) {
+		/* logged while en_fails < LOOP_FAILS (a refusing PD would else log every 5 s for ever) */
+		if (!put_log(BC_BATTERY_SET, BATT_CHG_EN, 1, "BATT_CHG_EN (restart: band ok)", en_fails < LOOP_FAILS)) {
+			if (++en_fails == LOOP_FAILS) {
+				LOG("loop: %u BATT_CHG_EN = 1 writes failed in a row: further failures are not logged", LOOP_FAILS);
+			}
+			publish();
+			return;                 /* stays stopped; the next loop tries again */
+		}
+		st.chg_stopped = false;
+		st.chg_en_set = true;
+		en_fails = 0;
+	}
+	/* 4. the FV unit from the PD's own value */
+	bool fvOk = get(BC_BATTERY_GET, BATT_VOLT_MAX, &v);
+	st.fv_mv = fvOk ? (int32_t)v : -1;
+	if (fv_scale == 0 && fvOk) {
+		fv_scale = (v >= 6000 && v <= 9000) ? VBATT_NUM : (v >= 3000 && v <= 4600) ? 1 : 0;
+		if (fv_scale || !fvunit_logged) {
+			fvunit_logged = true;
+			LOG("loop: the PD's BATT_VOLT_MAX reads %u: %s", v, fv_scale == VBATT_NUM ? "pack mV (x2, as oplus_charger.c:7252)" :
+			    fv_scale == 1 ? "cell mV (x1)" : "unknown unit: NO FV write");
+		}
+	}
+	/* 5. FV, then FCC (the order of oplus_charger.c:7557-7558) */
+	uint32_t fv = b->fv_mv * fv_scale;
+	if (fv_scale != 0 && fv <= FV_DT_MV * fv_scale && fv_fails < LOOP_FAILS) {
+		char what[64];
+		snprintf(what, sizeof(what), "BATT_VOLT_MAX (FV, mV; %u mV/cell)", b->fv_mv);
+		if (put_log(BC_BATTERY_SET, BATT_VOLT_MAX, fv, what, (int32_t)fv != st.fv_set_mv)) {
+			st.fv_set_mv = (int32_t)fv;
+			fv_fails = 0;
+		} else if (++fv_fails == LOOP_FAILS) {
+			LOG("loop: %u FV writes failed in a row: no FV write until the next plug", LOOP_FAILS);
+		}
+	}
+	uint32_t lvl = therm_level_req > 4 ? 4 : therm_level_req, ma = b->fcc_ma;
+	if (lvl != 0 && kThermMa[lvl] < ma) {
+		ma = kThermMa[lvl];
+	}
+	if (lvl != st.therm_level) {
+		LOG("loop: thermal FCC level %u -> %u (%u mA; band %u mA: FCC %u mA)", st.therm_level, lvl, kThermMa[lvl], b->fcc_ma, ma);
+		st.therm_level = (uint8_t)lvl;
+	}
+	if (ma <= FCC_DT_MA && fcc_fails < LOOP_FAILS) {
+		char what[64];
+		snprintf(what, sizeof(what), "BATT_CHG_CTRL_LIM (FCC, uA; %u mA)", ma);
+		if (put_log(BC_BATTERY_SET, BATT_CHG_CTRL_LIM, ma * 1000u, what, (int32_t)ma != st.fcc_set_ma)) {
+			st.fcc_set_ma = (int32_t)ma;
+			fcc_fails = 0;
+		} else if (++fcc_fails == LOOP_FAILS) {
+			LOG("loop: %u FCC writes failed in a row: no FCC write until the next plug", LOOP_FAILS);
+		}
+	}
+	/* 6. read back; a difference is logged (bounded: the first 20, then every 100th) */
+	int32_t fvBack = get(BC_BATTERY_GET, BATT_VOLT_MAX, &v) ? (int32_t)v : -1;
+	int32_t fccBack = get(BC_BATTERY_GET, BATT_CHG_CTRL_LIM, &v) ? (int32_t)(v / 1000) : -1;
+	st.fv_mv = fvBack;
+	st.fcc_ma = fccBack;
+	if ((st.fv_set_mv && fvBack >= 0 && fvBack != st.fv_set_mv) || (st.fcc_set_ma && fccBack >= 0 && fccBack != st.fcc_set_ma)) {
+		if (mismatch_lines < 20 || mismatch_lines % 100 == 0) {
+			LOG("loop: read back FV %d (wrote %d) FCC %d mA (wrote %d)", fvBack, st.fv_set_mv, fccBack, st.fcc_set_ma);
+		}
+		mismatch_lines++;
+	}
+	st.gen++;
+	publish();
+}
+
+/* Wait `s` seconds; GLINK stays polled (notifications). A USB notification ends it after 2 s (true). */
+/*
+ * ---- 0369: VOOC / SuperVOOC with the ADSP VOOC PHY (README-battery.md section 15) ----
+ * live.dts qcom,voocphy_support = <1> (ADSP_VOOCPHY), qcom,vooc_project = <7> (DUAL_BATT_80W, 80000 mW).
+ * The ADSP runs the VOOC protocol and the charge pumps. The HLOS side (oplus_battery_sm8450.c,
+ * voocphy/oplus_adsp_voocphy.c, oplus_charger.c) only: keeps USB_VOOCPHY_ENABLE (usb id 13) at 1 for a DCP,
+ * sends the battery temperature (BATT_SET_MATCH_TEMP, battery id 29, 0.1 C) and a cool-down level
+ * (BATT_SET_COOL_DOWN 28, 0 = no limit), parks the PMIC charger when the ADSP starts the handshake
+ * (notify 0x52: BATT_CHG_EN 0 + USB_INPUT_CURR_LIMIT 0, :2181-2192, :1373-1383), decodes the status word
+ * (notify 0x48 -> USB_VOOCPHY_STATUS 12: code bits 0-7, adapter id bits 8-14, sub-reason bits 16-23),
+ * answers BC_CHG_STATUS_GET 0x59 with BATT_SEND_CHG_STATUS 37 (:8417-8444), and recovers after 8.5 s
+ * without ONGOING (:8513-8535: ICL 0, 1 s, un-park, USB_VOOCPHY_RESET_AGAIN 25 = 1).
+ * Ours is stricter: VOOC only with negronichg_vooc=1, an adapter type DCP, the battery between 12.0 and
+ * 43.0 C (stock: the ADSP decides up to its 45 C warm band), no thermal FCC level (0283) and charging not
+ * stopped by the 0277 loop; else USB_VOOCPHY_ENABLE = 0 and plain charging. Default negronichg_vooc=0
+ * writes USB_VOOCPHY_ENABLE = 0 (the stock "off" path, oplus_voocphy.c:8640) and only logs.
+ */
+#define USB_VOOCPHY_STATUS      12u
+#define USB_VOOCPHY_ENABLE      13u
+#define USB_VOOC_FAST_CHG_TYPE  23u
+#define USB_VOOCPHY_RESET_AGAIN 25u
+#define BATT_SET_COOL_DOWN      28u
+#define BATT_SET_MATCH_TEMP     29u
+#define BATT_SEND_CHG_STATUS    37u
+#define USB_TYPE_DCP            2u      /* POWER_SUPPLY_USB_TYPE_DCP */
+#define VOOC_MIN_DC             120     /* 12.0 C */
+#define VOOC_MAX_DC             430     /* 43.0 C (stock warm band starts at 45.0 C) */
+#define VOOC_HS_TIMEOUT_NS      (8500ull * NSEC_PER_MSEC)
+#define EV_VBUS_ADC             (1u << 0)       /* 0x52 BC_VOOC_VBUS_ADC_ENABLE: handshake starts */
+#define EV_STATUS               (1u << 1)       /* 0x48 BC_VOOC_STATUS_GET */
+#define EV_CHG_STATUS_GET       (1u << 2)       /* 0x59 */
+#define EV_CHG_STATUS_SET       (1u << 3)       /* 0x60 */
+#define EV_SUSPEND_REQ          (1u << 4)       /* 0x61 BC_ADSP_NOTIFY_AP_SUSPEND_CHG */
+#define EV_PD_SVOOC             (1u << 5)       /* 0x56 */
+#define EV_ABNORMAL             (1u << 6)       /* 0x67 BC_ABNORMAL_PD_SVOOC_ADAPTER */
+#define EV_PLUG                 (1u << 7)       /* 0x55/0x57/0x58 type-C / plug-in / APSD done */
+static volatile uint32_t vooc_ev;               /* under rx_mtx */
+
+static const char *const kVoocCode[] = { "unknown", "PRESENT", "ONGOING", "ABSENT", "FULL", "BAD_CONNECTED",
+	"BATT_TEMP_OVER", "BTB_TEMP_OVER", "DUMMY_START", "ADAPTER_COPYCAT", "ERR_COMMU", "SWITCH_TEMP_RANGE",
+	"COMMU_TIME_OUT", "COMMU_CLK_ERR", "COMMU_SEND_ERR", "HW_VBATT_HIGH", "HW_TBATT_HIGH" };
+
+/* oplus_vooc.c:134-176 adapter_id_table: id range -> SVOOC watts (or VOOC watts when 0); capped at the project's 80 W */
+static uint32_t
+vooc_adapter_mw(uint32_t id)
+{
+	static const struct { uint8_t lo, hi, vooc_w, svooc_w; } t[] = {
+		{ 0x01, 0x01, 20, 0 }, { 0x11, 0x12, 30, 50 }, { 0x13, 0x13, 20, 0 }, { 0x14, 0x14, 30, 65 },
+		{ 0x15, 0x16, 20, 0 }, { 0x17, 0x19, 30, 0 }, { 0x1a, 0x1b, 15, 33 }, { 0x1c, 0x1c, 22, 45 },
+		{ 0x1d, 0x1e, 22, 44 }, { 0x21, 0x21, 30, 50 }, { 0x22, 0x22, 22, 44 }, { 0x23, 0x23, 30, 50 },
+		{ 0x24, 0x27, 30, 55 }, { 0x28, 0x28, 30, 65 }, { 0x29, 0x29, 30, 0 }, { 0x2a, 0x2a, 30, 65 },
+		{ 0x2b, 0x2b, 30, 66 }, { 0x2c, 0x2e, 30, 67 }, { 0x31, 0x31, 30, 50 }, { 0x32, 0x32, 30, 120 },
+		{ 0x33, 0x33, 30, 50 }, { 0x34, 0x34, 20, 20 }, { 0x35, 0x35, 30, 65 }, { 0x36, 0x36, 30, 66 },
+		{ 0x37, 0x3a, 30, 88 }, { 0x3b, 0x3e, 30, 100 }, { 0x41, 0x44, 30, 0 }, { 0x45, 0x45, 20, 0 },
+		{ 0x46, 0x46, 30, 0 }, { 0x47, 0x48, 30, 120 }, { 0x49, 0x4a, 15, 33 }, { 0x4b, 0x4e, 30, 80 },
+		{ 0x51, 0x51, 30, 125 }, { 0x61, 0x61, 15, 33 }, { 0x62, 0x62, 30, 50 }, { 0x63, 0x63, 30, 65 },
+		{ 0x64, 0x64, 30, 66 }, { 0x65, 0x65, 30, 80 }, { 0x66, 0x66, 30, 65 }, { 0x67, 0x68, 30, 125 },
+		{ 0x69, 0x6a, 30, 100 }, { 0x6b, 0x6b, 30, 120 }, { 0x6c, 0x6d, 30, 67 }, { 0x6e, 0x6e, 30, 65 },
+	};
+	for (unsigned i = 0; i < sizeof(t) / sizeof(t[0]); i++) {
+		if (id >= t[i].lo && id <= t[i].hi) {
+			uint32_t w = t[i].svooc_w ? t[i].svooc_w : t[i].vooc_w;
+			return MIN(w, 80u) * 1000u;     /* oplus_configfs.c:3114-3136: min(adapter, project power) */
+		}
+	}
+	return 0;
+}
+
+/* The notification ids that 0369 handles (chg_rx, under rx_mtx). */
+static void
+vooc_note(uint32_t n)
+{
+	switch (n) {
+	case 0x52: vooc_ev |= EV_VBUS_ADC; break;
+	case 0x48: vooc_ev |= EV_STATUS; break;
+	case 0x59: vooc_ev |= EV_CHG_STATUS_GET; break;
+	case 0x60: vooc_ev |= EV_CHG_STATUS_SET; break;
+	case 0x61: vooc_ev |= EV_SUSPEND_REQ; break;
+	case 0x56: vooc_ev |= EV_PD_SVOOC; break;
+	case 0x67: vooc_ev |= EV_ABNORMAL; break;
+	case 0x55: case 0x57: case 0x58: vooc_ev |= EV_PLUG; break;
+	default: break;
+	}
+}
+
+static void
+vooc_publish(void)
+{
+	st.vooc_mode = (uint8_t)vooc_mode;
+	st.vooc_enable = vooc_mode ? vc.enable : 0;
+	st.vooc_active = vc.ongoing;
+	st.vooc_code = (uint8_t)vc.code;
+	st.vooc_adapter = (uint8_t)vc.adapter;
+	st.vooc_mw = vc.mw;
+	publish();
+}
+
+static bool vooc_set_enable(uint32_t want, const char *why);
+
+/* PMIC charger off while the ADSP's VOOC path feeds the battery (stock order: BATT_CHG_EN 0, then ICL 0). */
+static void
+vooc_park(const char *why)
+{
+	bool saved = wr_safety;
+	wr_safety = true;                       /* review N3: safety writes bypass negronichg_wr / _delay_s */
+	bool a = put(BC_BATTERY_SET, BATT_CHG_EN, 0, "BATT_CHG_EN (VOOC: PMIC charger off)");
+	bool b = put(BC_USB_SET, USB_INPUT_CURR_LIMIT, 0, "USB_INPUT_CURR_LIMIT 0 (VOOC: PMIC input parked)");
+	wr_safety = saved;
+	if (!VOOC_OWNS()) {
+		vc.park_ns = now_ns();          /* the 8.5 s recovery timer starts at the first try */
+		vc.ongoing = false;
+		vc.saved_icl_ma = st.icl_ma >= 100 ? st.icl_ma : 0;     /* review N2 (st.icl_ma: this cycle's read) */
+	}
+	st.chg_en_set = st.icl_set = false;
+	vc.park_retry_ns = now_ns();
+	if (a && b) {
+		vc.parked = true;
+		vc.park_pending = false;
+	} else {
+		/* review B2: not parked until both writes are acked; meanwhile VOOC off, retried every 1 s (vooc_events) */
+		vc.park_pending = true;
+		vc.parked = false;
+		(void)vooc_set_enable(0, "the PMIC park writes failed");
+	}
+	LOG("vooc: %s: PMIC charger %s (%s/%s), %llu ms for ONGOING", why, vc.parked ? "parked" : "NOT parked yet (retry)",
+	    a ? "ok" : "FAILED", b ? "ok" : "FAILED", VOOC_HS_TIMEOUT_NS / NSEC_PER_MSEC);
+}
+
+/* Back to the PMIC charger (plain charging): our ICL (not stock's 0xFFFFFFFF), BATT_CHG_EN 1 unless 0277 stopped it. */
+static void
+vooc_unpark(const char *why)
+{
+	bool was = VOOC_OWNS();
+	vc.parked = vc.ongoing = vc.park_pending = false;
+	vc.park_ns = 0;
+	if (!was) {
+		return;
+	}
+	/*
+	 * review N2 + 0370 B3: never leave the ICL at the park's 0: the limit for this adapter type, else the ICL
+	 * from before the park, else 500 mA (unknown type, ACA, failed type read, negronichg_ma=0).
+	 */
+	uint32_t ma = icl_want > 0 ? icl_want : vc.saved_icl_ma > 0 ? (uint32_t)vc.saved_icl_ma : 500u;
+	bool saved = wr_safety;
+	wr_safety = true;                       /* review N3: the restore is a safety write */
+	st.icl_set = put(BC_USB_SET, USB_INPUT_CURR_LIMIT, ma * 1000u, "USB_INPUT_CURR_LIMIT (VOOC end)");
+	if (!st.chg_stopped) {
+		st.chg_en_set = put(BC_BATTERY_SET, BATT_CHG_EN, 1, "BATT_CHG_EN (VOOC end)");
+	}
+	wr_safety = saved;
+	tries = en_tries = susp_tries = 0;      /* review N2: a fresh write budget after each VOOC episode */
+	LOG("vooc: %s: PMIC charger back (ICL %u mA%s)", why, ma, st.chg_stopped ? ", charging stopped by the loop" : "");
+}
+
+static bool
+vooc_set_enable(uint32_t want, const char *why)
+{
+	uint32_t v = 0;
+	bool ok = false;
+	bool saved = wr_safety;
+	if (want == 0 && !force_off_proactive) {
+		wr_safety = true;               /* review N3: a reactive VOOC-off is a safety write */
+	}
+	for (unsigned i = 0; i < 3 && !ok; i++) {       /* stock retries the 0 write up to 10 times */
+		ok = put_log(BC_USB_SET, USB_VOOCPHY_ENABLE, want, want ? "USB_VOOCPHY_ENABLE (VOOC allowed)" :
+		    "USB_VOOCPHY_ENABLE (VOOC off)", i == 0);
+	}
+	wr_safety = saved;
+	vc.enable = get(BC_USB_GET, USB_VOOCPHY_ENABLE, &v) ? (int32_t)v : -1;
+	LOG("vooc: enable %u (%s): read back %d", want, why, vc.enable);
+	return ok && vc.enable == (int32_t)want;
+}
+
+/* One USB_VOOCPHY_STATUS word (from 0x48, the recovery check or the loop's check while ONGOING). */
+static void
+vooc_status(uint32_t v, const char *src)
+{
+	uint32_t code = v & 0xff, id = (v >> 8) & 0x7f, sub = (v >> 16) & 0xff;
+
+	vc.code = code;
+	vc.sub = sub;
+	if ((code == 1 || code == 8) && id != 0) {
+		vc.adapter = id;
+		vc.mw = vooc_adapter_mw(id);
+	}
+	if (code != 2 || !vc.ongoing || src[0] == '0') {
+		LOG("vooc: status %#x (%s): %s (code %u) adapter id %#x (%u W class) sub-reason %u", v, src,
+		    code < sizeof(kVoocCode) / sizeof(kVoocCode[0]) ? kVoocCode[code] : "?", code, vc.adapter, vc.mw / 1000, sub);
+	}
+	if (code == 1 || code == 2) {
+		if (code == 2) {
+			if (!VOOC_OWNS()) {
+				vooc_park("ONGOING without the 0x52 handshake");
+			}
+			vc.ongoing = true;
+			vc.park_ns = 0;                 /* the recovery timer ends here */
+			if (vc.adapter == 0 && get(BC_USB_GET, USB_VOOC_FAST_CHG_TYPE, &v)) {
+				vc.adapter = v & 0x7f;
+				vc.mw = vooc_adapter_mw(vc.adapter);
+			}
+		}
+		(void)put_log(BC_BATTERY_SET, BATT_SET_COOL_DOWN, 0, "BATT_SET_COOL_DOWN 0 (no limit)", src[0] == '0');
+		if (!vooc_mode) {
+			LOG("vooc: fast charge reported although negronichg_vooc=0: VOOC off again");
+			(void)vooc_set_enable(0, "negronichg_vooc=0");
+		}
+	} else {
+		vooc_unpark(code == 4 ? "full" : "fast charge ended or not possible");
+		if (code == 10 || code == 13) {
+			vc.adapter = 0;
+			vc.mw = 0;
+		}
+		notify_usb = true;
+	}
+}
+
+/* Notifications (thread context, from idle() every 50 ms). */
+static void
+vooc_events(void)
+{
+	uint32_t ev, v = 0;
+
+	if (vc.in_events || !st.ready) {
+		return;
+	}
+	lck_mtx_lock(&rx_mtx);
+	ev = vooc_ev;
+	vooc_ev = 0;
+	lck_mtx_unlock(&rx_mtx);
+	vc.in_events = true;
+	if (ev & EV_PD_SVOOC) {
+		vc.pd_svooc = true;
+		LOG("vooc: the ADSP reports a PD adapter that can do SVOOC (0x56)");
+	}
+	if (ev & EV_ABNORMAL) {
+		LOG("vooc: the ADSP reports an abnormal PD SVOOC adapter (0x67)");
+	}
+	if (ev & EV_SUSPEND_REQ) {
+		vc.suspend_req = true;
+		LOG("vooc: the ADSP asks the AP to suspend charging (0x61)");
+	}
+	if (ev & EV_PLUG) {
+		LOG("vooc: plug / type-C / APSD notification: the next cycle comes early");
+		notify_usb = true;
+	}
+	if (ev & EV_VBUS_ADC) {
+		/* always park, also with negronichg_vooc=0: if the ADSP starts VOOC, the PMIC must not feed in parallel */
+		vooc_park(vooc_mode ? "handshake starts (0x52)" : "handshake starts (0x52) although negronichg_vooc=0");
+		if (!vooc_mode) {
+			(void)vooc_set_enable(0, "negronichg_vooc=0");
+		}
+	}
+	if (ev & EV_STATUS) {
+		vc.statuses++;
+		if (!get(BC_USB_GET, USB_VOOCPHY_STATUS, &v)) {
+			LOG_ERR("vooc: status notification, USB_VOOCPHY_STATUS read failed");
+		} else {
+			vooc_status(v, "0x48");
+		}
+	}
+	if (ev & EV_CHG_STATUS_GET) {
+		uint32_t on = (!vc.suspend_req && !st.chg_stopped && !VOOC_OWNS()) ? 1u : 0u;
+		(void)put(BC_BATTERY_SET, BATT_SEND_CHG_STATUS, on, "BATT_SEND_CHG_STATUS (answer to 0x59)");
+		LOG("vooc: 0x59 answered: charging %s", on ? "enabled" : "disabled/suspended");
+	}
+	if (ev & EV_CHG_STATUS_SET) {
+		vooc_unpark("the ADSP asks to un-suspend (0x60)");
+	}
+	/* review B2: park writes not acked yet: try again every 1 s */
+	if (vc.park_pending && now_ns() - vc.park_retry_ns >= NSEC_PER_SEC) {
+		vooc_park("retry");
+	}
+	/* recovery: no ONGOING 8.5 s after the handshake (stock adsp_voocphy_err_work) */
+	if (VOOC_OWNS() && !vc.ongoing && vc.park_ns != 0 && now_ns() - vc.park_ns > VOOC_HS_TIMEOUT_NS &&
+	    get(BC_USB_GET, USB_VOOCPHY_STATUS, &v) && (v & 0xff) == 2) {
+		vooc_status(v, "recovery check");       /* review F5: it is ONGOING: no un-park */
+	}
+	if (VOOC_OWNS() && !vc.ongoing && vc.park_ns != 0 && now_ns() - vc.park_ns > VOOC_HS_TIMEOUT_NS) {
+		vc.recoveries++;
+		LOG("vooc: no ONGOING %llu ms after the handshake (recovery #%u): un-park, USB_VOOCPHY_RESET_AGAIN",
+		    VOOC_HS_TIMEOUT_NS / NSEC_PER_MSEC, vc.recoveries);
+		wr_safety = true;
+		(void)put(BC_USB_SET, USB_INPUT_CURR_LIMIT, 0, "USB_INPUT_CURR_LIMIT 0 (recovery)");
+		wr_safety = false;
+		vc.in_events = false;
+		IOSleep(1000);
+		vc.in_events = true;
+		vooc_unpark("recovery");
+		if (vooc_mode) {
+			(void)put(BC_USB_SET, USB_VOOCPHY_RESET_AGAIN, 1, "USB_VOOCPHY_RESET_AGAIN");
+		}
+	}
+	vc.in_events = false;
+	if (ev) {
+		vooc_publish();
+	}
+}
+
+/* USB out: forget the adapter and the requests (stock: unplug clears the state and the timer). */
+static void
+vooc_unplugged(void)
+{
+	vc.parked = vc.ongoing = vc.suspend_req = vc.pd_svooc = vc.off_done = vc.park_pending = false;
+	vc.park_ns = 0;
+	vc.enable = -1;
+	vc.code = vc.adapter = vc.sub = vc.mw = 0;
+	vooc_publish();
+}
+
+/*
+ * Policy, from charge_loop() every negronichg_loop_s with USB in and READY, after the temperature read
+ * (dc = 0.1 C; INT32_MIN = unknown). true: VOOC owns the battery path (charge_loop skips FV/FCC/CHG_EN).
+ */
+static bool
+vooc_policy(int32_t dc)
+{
+	uint32_t v = 0;
+
+	/* review F8: the temperature goes to the ADSP whenever its VOOC path runs (any mode) and with VOOC allowed */
+	if (dc != INT32_MIN && (vooc_mode || vc.ongoing)) {
+		(void)put_log(BC_BATTERY_SET, BATT_SET_MATCH_TEMP, (uint32_t)dc, "BATT_SET_MATCH_TEMP (0.1 C)", vc.lines < 3);
+	}
+	/* review F7: while ONGOING, check the status each loop (a missed 0x48 must not leave the PMIC parked) */
+	if (vc.ongoing && get(BC_USB_GET, USB_VOOCPHY_STATUS, &v)) {
+		vooc_status(v, "loop check");
+	}
+	if (vooc_mode == 0) {
+		/* the ENABLE = 0 write itself: vooc_force_off() at READY and USB in (review F6) */
+		vooc_publish();
+		return VOOC_OWNS();
+	}
+	const char *no = NULL;
+	if (dc == INT32_MIN) {
+		no = "no battery temperature";
+	} else if (dc < VOOC_MIN_DC || dc > VOOC_MAX_DC) {
+		no = "battery temperature outside 12.0-43.0 C";
+	} else if (st.chg_stopped) {
+		no = "the charge loop stopped charging";
+	} else if (st.therm_level != 0) {
+		no = "thermal FCC level in force";
+	} else if (vc.suspend_req) {
+		no = "the ADSP asked to suspend charging";
+	} else if (st.usb_type != (int32_t)USB_TYPE_DCP && !vc.parked) {
+		no = "adapter type is not DCP";
+	}
+	uint32_t want = no == NULL ? 1u : 0u;
+	if (vc.enable < 0 || (uint32_t)vc.enable != want) {
+		vc.enable = get(BC_USB_GET, USB_VOOCPHY_ENABLE, &v) ? (int32_t)v : -1;
+	}
+	if (vc.enable != (int32_t)want) {
+		(void)vooc_set_enable(want, no ? no : "DCP, battery 12-43 C, no thermal limit");
+	}
+	/* review B1: off while ONGOING: stay parked until a status that is not ONGOING (vooc_status un-parks) */
+	if (!want && VOOC_OWNS()) {
+		if (!vc.ongoing && vc.enable == 0) {
+			vooc_unpark(no);
+		} else if (vc.ongoing) {
+			LOG_ERR("vooc: VOOC off requested (%s) while ONGOING: PMIC stays parked until the ADSP reports the end", no);
+		}
+	}
+	if (vc.ongoing && (vc.lines++ % 6) == 0) {      /* every 30 s at 5 s */
+		uint32_t mv = 0, ma = 0, bmv = 0, bma = 0;
+		bool a = get(BC_USB_GET, USB_VOLT_NOW, &mv), b = get(BC_USB_GET, USB_CURR_NOW, &ma);
+		bool c = get(BC_BATTERY_GET, BATT_VOLT_NOW, &bmv), d = get(BC_BATTERY_GET, BATT_CURR_NOW, &bma);
+		int64_t mw = (a && b) ? (int64_t)(mv / 1000) * ((int32_t)ma / 1000) / 1000 : -1;
+		LOG("vooc: ONGOING adapter %#x (%u W class) | VBUS %d mV IBUS %d mA = %lld mW | battery %d mV %d mA | %d.%d C",
+		    vc.adapter, vc.mw / 1000, a ? (int32_t)(mv / 1000) : -1, b ? (int32_t)ma / 1000 : INT32_MIN, mw,
+		    c ? (int32_t)(bmv / 1000) : -1, d ? (int32_t)bma / 1000 : INT32_MIN, dc / 10, (dc < 0 ? -dc : dc) % 10);
+	}
+	vooc_publish();
+	return VOOC_OWNS();
+}
+
+/* review F6: negronichg_vooc=0: USB_VOOCPHY_ENABLE = 0 at READY and at each USB in (also with negronichg_loop=0). */
+static void
+vooc_force_off(const char *why)
+{
+	uint32_t v = 0;
+
+	if (vooc_mode != 0 || !st.ready) {
+		return;
+	}
+	vc.enable = get(BC_USB_GET, USB_VOOCPHY_ENABLE, &v) ? (int32_t)v : -1;
+	if (vc.enable != 0) {
+		force_off_proactive = true;     /* review N3: this one obeys negronichg_wr / _delay_s (bisect class 0x10) */
+		(void)vooc_set_enable(0, why);
+		force_off_proactive = false;
+	} else {
+		LOG("vooc: USB_VOOCPHY_ENABLE reads 0 (%s, negronichg_vooc=0): plain charging", why);
+	}
+	vooc_publish();
+}
+
+/* review F7: the ADSP restarted or stopped answering: its VOOC state is gone; ours too, and the PMIC writes run again. */
+static void
+vooc_reset(const char *why)
+{
+	if (VOOC_OWNS() || vc.adapter != 0) {
+		LOG("vooc: state reset (%s)", why);
+	}
+	vooc_unplugged();
+	st.icl_set = st.chg_en_set = false;
+}
+
+/*
+ * 0374: keep the phone a Type-C sink (README-usb.md "0374").
+ * [V] logs/bootlog-9.txt (t19, NEGRONI ULOG = the charger PD's own log): ~2.1 s after ADSP up the PD starts its
+ * TCPC/TCPM (PmicTccPlatform_Init, pmic_glink_open); 10 ms later the Type-C partner is gone (GetSnkSrcMode 0,
+ * bPlugIn 0, VBUS 5 mV); PmSchgTypec_GetPortRole = 0 (DRP); 620 ms later the CC interrupt finds Rd on CC2,
+ * ROLE_CONTROL 0x07 (CC2 = Rp), ConnectPartnerType 2 (UFP), PowerDirection 1 (provider), OTG_ENABLE_REQ, VBUS
+ * sourced by the phone, PD header DataRole 1 PowerRole 1 (DFP + source), Source_Capabilities without GoodCRC.
+ * The Mac port (DRP) became the sink/UFP: no USB host for our gadget until a reboot.
+ * Stock (out/src/op-modules/.../oplus_battery_sm8450.c): oplus_ccdetect_disable() writes USB_TYPEC_MODE =
+ * TYPEC_PORT_ROLE_SNK (1) (:1060; PM_TYPEC_PORT_ROLE_TYPE DRP 0, SNK 1, SRC 2, DISABLE 3, .h:143-150); a read of
+ * USB_TYPEC_MODE gives 0 = sink, other = source (oplus_check_cc_mode :10081-10092; == 1 = OTG online :8988).
+ * USB_OTG_SWITCH (15) = 0 is the stock "OTG off" write (:8887). The PD logs "set typec_mode[%d]" on our write.
+ * Not gated by negronichg_wr (its own boot-arg). Costs OTG (a USB stick on the phone) while it is on.
+ */
+#define USB_OTG_SWITCH          15u
+#define USB_TYPEC_CC_ORIENT     17u
+#define USB_CID_STATUS          18u
+#define USB_TYPEC_MODE          19u
+#define TYPEC_PORT_ROLE_SNK     1u
+#define TC_REASSERT_MAX         6u
+#define TC_REASSERT_GAP_NS      (3000ull * NSEC_PER_MSEC)
+#define TC_FAST_NS              (60ull * NSEC_PER_SEC)  /* read every 500 ms for 60 s after the open, then 5 s */
+#define TC_LINES_MAX            80u
+static struct {
+	bool ready;                     /* a USB_TYPEC_MODE read answered with ret_code 0 since the open */
+	bool busy;
+	bool one_is_role;               /* review: the read gave 1 right after our SNK write (read = the set role, not "source") */
+	int32_t last;                   /* last role read, -2 = none */
+	uint32_t asserts, writes_ok, lines, reads, bad, notes;
+	uint64_t open_ns, last_wr_ns, next_ns;
+} tc = { .last = -2 };
+
+#define TC_LOG(fmt, ...) do { \
+	if (tc.lines < TC_LINES_MAX) { tc.lines++; LOG("typec: " fmt, ##__VA_ARGS__); } \
+} while (0)
+
+static uint64_t
+tc_ms(void)
+{
+	return tc.open_ns ? (now_ns() - tc.open_ns) / NSEC_PER_MSEC : 0;
+}
+
+static bool
+tc_write(uint32_t prop, uint32_t value, const char *what, const char *why)
+{
+	uint32_t v = 0, ret = 0;
+	int rc = prop_io(BC_USB_SET, prop, value, &v, &ret);
+
+	TC_LOG("write %s = %u (%s): %s (ret_code %#x) +%llu ms after the open", what, value, why,
+	    rc ? (rc == ETIMEDOUT ? "no answer" : "channel down") : ret ? "REFUSED" : "ok", rc ? 0 : ret, tc_ms());
+	return rc == 0 && ret == 0;
+}
+
+static void
+tc_sink(const char *why)
+{
+	tc.last_wr_ns = now_ns();
+	if (tc_write(USB_TYPEC_MODE, TYPEC_PORT_ROLE_SNK, "USB_TYPEC_MODE (TYPEC_PORT_ROLE_SNK, sink only)", why)) {
+		tc.writes_ok++;
+	}
+}
+
+/* One read of the role; the first answer after the open does the writes. */
+static void
+typec_check(const char *why)
+{
+	uint32_t v = 0, ret = 0;
+	int rc;
+
+	if (typec_arg == 0 || tc.busy || !negroni_glink_up(NEGRONI_GLINK_PMIC)) {
+		return;
+	}
+	tc.busy = true;
+	tc.reads++;
+	rc = prop_io(BC_USB_GET, USB_TYPEC_MODE, 0, &v, &ret);
+	if (rc != 0 || ret != 0) {
+		tc.bad++;
+		if (tc.bad <= 5 || tc.bad % 100 == 0) {
+			TC_LOG("read USB_TYPEC_MODE (%s): %s (ret_code %#x) +%llu ms after the open (%u bad)", why,
+			    rc ? (rc == ETIMEDOUT ? "no answer" : "channel down") : "refused", rc ? 0 : ret, tc_ms(), tc.bad);
+		}
+		tc.busy = false;
+		return;
+	}
+	int32_t role = (int32_t)v;
+	if (!tc.ready) {
+		uint32_t cid = 0, sw = 0, cc = 0, r1 = 1, r2 = 1, r3 = 1;
+		bool cidOk = prop_io(BC_USB_GET, USB_CID_STATUS, 0, &cid, &r1) == 0 && r1 == 0;
+		bool swOk = prop_io(BC_USB_GET, USB_OTG_SWITCH, 0, &sw, &r2) == 0 && r2 == 0;
+		bool ccOk = prop_io(BC_USB_GET, USB_TYPEC_CC_ORIENT, 0, &cc, &r3) == 0 && r3 == 0;
+		tc.ready = true;
+		TC_LOG("first answer +%llu ms after the open (%s): USB_TYPEC_MODE %d (stock: 0 sink, other source/OTG), CID %s%u, "
+		    "OTG switch %s%u, CC orientation %s%u; negronichg_typec %#x (%s)", tc_ms(), why, role, cidOk ? "" : "?", cid,
+		    swOk ? "" : "?", sw, ccOk ? "" : "?", cc, typec_arg,
+		    typec_arg & TC_WATCH ? "watch only" : typec_arg == TC_OTGSW ? "OTG switch off only" : "sink only");
+		if (typec_only) {
+			struct bc_notify_req n = { { BC_OWNER, BC_TYPE_NOTIFY, BC_SET_NOTIFY_REQ }, 0, 0, 0, 0 };
+			TC_LOG("subscribe to notifications (BC_SET_NOTIFY_REQ, for BC_OTG_ENABLE 0x50): %s",
+			    transact(&n, sizeof(n), BC_SET_NOTIFY_REQ, -1) == 0 ? "acked" : "no ack");
+		}
+		if (typec_arg & TC_OTGSW) {
+			(void)tc_write(USB_OTG_SWITCH, 0, "USB_OTG_SWITCH (OTG off)", "first answer");
+		}
+		if (typec_arg & TC_SINK) {
+			uint32_t v2 = 0, r4 = 1;
+			tc_sink("first answer");
+			/* review: learn the read semantics. A sink-only write cannot make the phone a source: 0 before and 1 after = the read gives the set role. */
+			if (role != 1 && prop_io(BC_USB_GET, USB_TYPEC_MODE, 0, &v2, &r4) == 0 && r4 == 0 && v2 == TYPEC_PORT_ROLE_SNK) {
+				tc.one_is_role = true;
+				TC_LOG("USB_TYPEC_MODE reads %d before and 1 after the SNK write: the read is the set role (0 DRP, 1 SNK); sink only again "
+				    "on a read of 0 (DRP) or BC_OTG_ENABLE", role);
+				role = (int32_t)v2;
+			}
+		}
+	} else if (role != tc.last) {
+		TC_LOG("USB_TYPEC_MODE %d -> %d (%s) +%llu ms after the open", tc.last, role, why, tc_ms());
+	}
+	tc.last = role;
+
+	bool otg;
+	lck_mtx_lock(&rx_mtx);
+	otg = tc_otg_req;
+	tc_otg_req = false;
+	lck_mtx_unlock(&rx_mtx);
+	if (otg) {
+		TC_LOG("the PD asks for OTG VBUS (BC_OTG_ENABLE 0x50): the phone is the Type-C source +%llu ms after the open", tc_ms());
+	}
+	bool src = otg || (tc.one_is_role ? role == 0 : role == 1);
+	if ((typec_arg & TC_SINK) && src) {
+		if (tc.asserts >= TC_REASSERT_MAX) {
+			if (tc.asserts == TC_REASSERT_MAX) {
+				tc.asserts++;
+				TC_LOG("still the source after %u sink-only writes: no more (negronichg_typec)", TC_REASSERT_MAX);
+			}
+		} else if (now_ns() - tc.last_wr_ns >= TC_REASSERT_GAP_NS) {
+			tc.asserts++;
+			TC_LOG("the phone is the Type-C source or DRP (role %d%s%s): sink only again (#%u of %u)", role,
+			    tc.one_is_role ? " = set role" : "", otg ? ", BC_OTG_ENABLE" : "", tc.asserts, TC_REASSERT_MAX);
+			tc_sink("source seen");
+		} else {
+			lck_mtx_lock(&rx_mtx);
+			tc_otg_req = tc_otg_req || otg;         /* retry after the gap */
+			lck_mtx_unlock(&rx_mtx);
+		}
+	}
+	tc.busy = false;
+}
+
+/* From idle() every 50 ms: a notification or the read period. */
+static void
+typec_tick(void)
+{
+	bool ev;
+	uint32_t n;
+	uint64_t t;
+
+	if (typec_arg == 0 || tc.open_ns == 0 || tc.busy) {
+		return;
+	}
+	lck_mtx_lock(&rx_mtx);
+	ev = tc_ev;
+	n = tc_ev_last;
+	tc_ev = false;
+	lck_mtx_unlock(&rx_mtx);
+	t = now_ns();
+	if (ev) {
+		if (++tc.notes <= 20) {
+			TC_LOG("notification 0x%x +%llu ms after the open", n, tc_ms());   /* review: max 20, the write lines keep their budget */
+		}
+		typec_check("notification");
+	} else if (t >= tc.next_ns) {
+		typec_check("poll");
+	} else {
+		return;
+	}
+	tc.next_ns = now_ns() + (now_ns() - tc.open_ns < TC_FAST_NS ? 500ull * NSEC_PER_MSEC : 5000ull * NSEC_PER_MSEC);
+}
+
+static void
+typec_open(void)
+{
+	tc.open_ns = now_ns();
+	tc.ready = false;
+	tc.one_is_role = false;
+	tc.last = -2;
+	tc.next_ns = 0;
+	typec_check("open");
+	tc.next_ns = now_ns() + 500ull * NSEC_PER_MSEC;
+}
+
+static void
+typec_closed(void)
+{
+	tc.open_ns = 0;
+	tc.ready = false;
+}
+
+static bool
+idle(uint32_t s)
+{
+	bool early = false;
+
+	for (uint32_t ms = 0; ms < s * 1000; ms += 50) {
+		negroni_glink_poll();
+		vooc_events();                  /* 0369 */
+		typec_tick();                   /* 0374 */
+		if (notify_usb && ms >= 2000) {
+			early = true;
+			break;
+		}
+		IOSleep(50);
+	}
+	notify_usb = false;
+	return early;
+}
+
+/* 0277: the poll period in loop_s pieces, with a charge loop run between them (USB in and READY only). */
+static void
+idle_loop(uint32_t s)
+{
+	for (uint32_t done = 0; done < s;) {
+		uint32_t chunk = (loop_on && was_online && st.ready) ? MIN(loop_s, s - done) : s - done;
+		if (idle(chunk)) {
+			return;
+		}
+		done += chunk;
+		if (done < s) {
+			charge_loop();
+		}
+	}
+}
+
+#define GLINK_WAIT_S            600u    /* ADSP steps 1..9 must end within this */
+
+static void
+chg_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	unsigned opens = 0, s;
+	int rc;
+
+	for (s = 0; s < GLINK_WAIT_S && !negroni_glink_up(NEGRONI_GLINK_IPCRTR); s++) {
+		IOSleep(1000);
+	}
+	if (!negroni_glink_up(NEGRONI_GLINK_IPCRTR)) {
+		LOG("off: GLINK is not up after %u s (ADSP step 9 did not run or failed)", GLINK_WAIT_S);
+		(void)thread_terminate(current_thread());
+		return;
+	}
+	LOG("GLINK is up after %u s", s);
+
+	st.wanted = true;
+	st.soc_centi = -1;
+	st.bstatus = st.usb_online = st.usb_mv = st.icl_ma = -1;
+	st.usb_type = -1;                                                      /* 0365 */
+	st.ibat_ma = st.usb_ma = st.temp_centi = INT32_MIN;
+	st.band = -1;
+	st.fv_mv = st.fcc_ma = -1;
+	if (loop_on && !bands_ok()) {
+		loop_on = false;
+	}
+	st.loop_on = loop_on;
+	publish();
+	start_ns = now_ns();                                    /* 0370 */
+	LOG("writes: class mask %#x (negronichg_wr: 1 ICL, 2 USB_SUSPEND_PMIC, 4 BATT_CHG_EN, 8 FV/FCC, 0x10 VOOC, 0x20 notify, "
+	    "0x40 other), delay %u s, ICL per adapter type %s", wr_mask, wr_delay_s, icl_bytype ? "on" : "off");
+	negroni_glink_set_rx(NEGRONI_GLINK_PMIC, chg_rx);    /* before the open: a notification can come at once */
+	if (typec_only) {
+		LOG("start (typec only, negronichg_glink=0): channel PMIC_RTR_ADSP_APPS, negronichg_typec %#x, no charger writes",
+		    typec_arg);
+	} else {
+		LOG("start: channel PMIC_RTR_ADSP_APPS, input limit %u mA%s, poll %u s, charge loop %s (every %u s, FV <= %u mV/cell, "
+		    "FCC <= %u mA), negronichg_typec %#x", chg_ma, chg_ma ? "" : " (read only)", poll_s, loop_on ? "on" : "off", loop_s,
+		    FV_DT_MV, FCC_DT_MA, typec_arg);
+	}
+	for (;;) {
+		if (!negroni_glink_up(NEGRONI_GLINK_IPCRTR)) {
+			LOG("GLINK stopped: the charger client ends");
+			st.up = st.ready = false;
+			publish();
+			(void)thread_terminate(current_thread());
+			return;
+		}
+		if (!negroni_glink_up(NEGRONI_GLINK_PMIC)) {
+			if (st.up) {
+				LOG_ERR("the ADSP closed PMIC_RTR_ADSP_APPS");
+				typec_closed();                                 /* 0374 */
+				st.up = st.ready = false;
+				vooc_reset("PMIC_RTR_ADSP_APPS closed");        /* 0369 review F7 */
+				publish();
+			}
+			opens++;
+			rc = negroni_glink_open(NEGRONI_GLINK_PMIC, 4, opens == 1 ? OPEN_WAIT_MS : 2000);
+			if (rc != 0) {
+				if (opens <= 5 || opens % 30 == 0) {
+					LOG("PMIC_RTR_ADSP_APPS not open (try %u: %s): the charger PD may not run", opens,
+					    rc == ETIMEDOUT ? "no OPEN from the ADSP" : rc == ENOMEM ? "no memory for intents" : "GLINK down");
+				}
+				(void)idle(poll_s);
+				continue;
+			}
+			st.up = true;
+			LOG("PMIC_RTR_ADSP_APPS is open (try %u)", opens);
+			typec_open();           /* 0374: before the first cycle: the PD's role decision comes ~0.6 s after its OPEN */
+		}
+		if (typec_only) {
+			(void)idle(1);          /* 0374: typec_tick() only; no charger reads or writes */
+			continue;
+		}
+		cycle();
+		charge_loop();          /* 0277 */
+		idle_loop(poll_s);
+	}
+}
+/*
+ * Patch 0373: the charger PD's own log (ulog) over GLINK channel PMIC_LOGS_ADSP_APPS (live.dts
+ * qcom,pmic_glink_log, qcom,charger_ulog_glink). Protocol: Linux drivers/soc/qcom/pmic_pdcharger_ulog.c
+ * (v6.12): request {u32 owner 32778, u32 type 1, u32 opcode 0x18 GET_CHG_ULOG_REQ, u32 log_size 8192}
+ * (16 bytes); answer {same header, u8 buf[8192]} (8204 bytes; the ADSP asks for an intent of that
+ * size, 0274 grants up to 0x4400). Linux asks again 1 s after each answer and prints every non-empty
+ * line. Here: the same every negronichg_ulog_ms (default 1000) for 120 s after the channel opens, then
+ * every 5 s; each line as "NEGRONI ULOG: <text>" (kernel log, live USB log and the 0367 boot log), at
+ * most negronichg_ulog_lines (default 3000) lines per boot, then the thread ends.
+ * Why (README-usb.md "0373"): the ADSP's port detection (APSD rerun, Type-C/PD state, its PHY and rail
+ * votes) runs when the USB link to the Mac dies; its log is the direct record of what it does.
+ * Read only: the request asks for log text, nothing else. Default off (negronichg_ulog=0).
+ */
+#define ULOG_OPCODE             0x18u
+#define ULOG_SIZE               8192u
+static bool ulog_parsed, ulog_on;
+static uint32_t ulog_ms = 1000, ulog_max_lines = 3000;
+static char ulog_buf[ULOG_SIZE + 1];
+static volatile uint32_t ulog_len;              /* > 0: an answer waits in ulog_buf (written by rx, cleared by the thread) */
+static volatile uint32_t ulog_answers, ulog_dropped, ulog_bad;
+
+bool
+negroni_chg_ulog_wanted(void)
+{
+	if (!ulog_parsed) {
+		uint32_t on = 0, adsp = 0;
+		(void)PE_parse_boot_argn("negronichg_ulog", &on, sizeof(on));
+		(void)PE_parse_boot_argn("negroniadsp", &adsp, sizeof(adsp));
+		(void)PE_parse_boot_argn("negronichg_ulog_ms", &ulog_ms, sizeof(ulog_ms));
+		(void)PE_parse_boot_argn("negronichg_ulog_lines", &ulog_max_lines, sizeof(ulog_max_lines));
+		ulog_ms = MIN(MAX(ulog_ms, 200u), 60000u);
+		ulog_max_lines = MIN(MAX(ulog_max_lines, 10u), 100000u);
+		ulog_on = on != 0 && adsp != 0;
+		__atomic_store_n(&ulog_parsed, true, __ATOMIC_RELEASE);  /* after ulog_on: a racing gl_poll never sees a false "off" */
+	}
+	return ulog_on;
+}
+
+/* Inside negroni_glink_poll() of any thread (GLINK lock held): copy only; the ulog thread prints. */
+static void
+ulog_rx(const uint8_t *data, uint32_t len)
+{
+	uint32_t hdr[3];
+
+	if (len < 12) {
+		ulog_bad++;
+		return;
+	}
+	memcpy(hdr, data, sizeof(hdr));
+	if (hdr[0] != BC_OWNER || hdr[2] != ULOG_OPCODE) {
+		ulog_bad++;
+		return;
+	}
+	if (__atomic_load_n(&ulog_len, __ATOMIC_ACQUIRE) != 0) {
+		ulog_dropped++;
+		return;
+	}
+	uint32_t n = MIN(len - 12, ULOG_SIZE);
+	memcpy(ulog_buf, data + 12, n);
+	ulog_buf[n] = 0;
+	ulog_answers++;
+	__atomic_store_n(&ulog_len, n ? n : 1, __ATOMIC_RELEASE);
+}
+
+/* Print the waiting answer line by line; returns the lines printed. */
+static uint32_t
+ulog_print(uint32_t room)
+{
+	uint32_t n = __atomic_load_n(&ulog_len, __ATOMIC_ACQUIRE), lines = 0;
+	char *p = ulog_buf, *end;
+
+	if (n == 0) {
+		return 0;
+	}
+	ulog_buf[MIN(n, ULOG_SIZE)] = 0;
+	while (*p && lines < room) {
+		end = strchr(p, '\n');
+		if (end) {
+			*end = 0;
+		}
+		size_t l = strlen(p);
+		while (l > 0 && (p[l - 1] == '\r' || p[l - 1] == ' ')) {
+			p[--l] = 0;
+		}
+		if (l > 0) {
+			printf("NEGRONI ULOG: %s\n", p);
+			lines++;
+		}
+		if (!end) {
+			break;
+		}
+		p = end + 1;
+	}
+	__atomic_store_n(&ulog_len, 0, __ATOMIC_RELEASE);
+	return lines;
+}
+
+static void
+ulog_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	const uint32_t req[4] = { BC_OWNER, BC_TYPE_REQ, ULOG_OPCODE, ULOG_SIZE };
+	uint32_t s, lines = 0, opens = 0, sent = 0, fails = 0;
+	uint64_t open_ns = 0;
+
+	for (s = 0; s < GLINK_WAIT_S && !negroni_glink_up(NEGRONI_GLINK_IPCRTR); s++) {
+		IOSleep(1000);
+	}
+	if (!negroni_glink_up(NEGRONI_GLINK_IPCRTR)) {
+		printf("NEGRONI ULOG: off: GLINK is not up after %u s\n", GLINK_WAIT_S);
+		(void)thread_terminate(current_thread());
+		return;
+	}
+	negroni_glink_set_rx(NEGRONI_GLINK_ULOG, ulog_rx);
+	printf("NEGRONI ULOG: start: channel PMIC_LOGS_ADSP_APPS, request every %u ms for 120 s after the open, then every 5 s, "
+	    "at most %u lines (negronichg_ulog_ms, negronichg_ulog_lines)\n", ulog_ms, ulog_max_lines);
+	while (lines < ulog_max_lines) {
+		if (!negroni_glink_up(NEGRONI_GLINK_IPCRTR)) {
+			printf("NEGRONI ULOG: GLINK stopped after %u lines: end\n", lines);
+			break;
+		}
+		if (!negroni_glink_up(NEGRONI_GLINK_ULOG)) {
+			opens++;
+			int rc = negroni_glink_open(NEGRONI_GLINK_ULOG, 2, opens == 1 ? OPEN_WAIT_MS : 5000);
+			if (rc != 0) {
+				if (opens <= 5 || opens % 30 == 0) {
+					printf("NEGRONI ULOG: PMIC_LOGS_ADSP_APPS not open (try %u, rc %d)\n", opens, rc);
+				}
+				if (opens >= 40) {
+					printf("NEGRONI ULOG: PMIC_LOGS_ADSP_APPS did not open in %u tries: end\n", opens);
+					break;
+				}
+				/*
+				 * EIO/ENOMEM/ENOTCONN return at once; ETIMEDOUT has polled GLINK every 1 ms for 5 s.
+				 * Rest between tries (no 1 kHz poll for the whole boot): an OPEN of the ADSP that comes
+				 * meanwhile waits in the RX FIFO (or another poller answers it); the next try sees it.
+				 */
+				IOSleep(rc == ETIMEDOUT ? 25000 : 5000);
+				continue;
+			}
+			open_ns = now_ns();
+			printf("NEGRONI ULOG: PMIC_LOGS_ADSP_APPS is open (try %u)\n", opens);
+		}
+		int rc = negroni_glink_send(NEGRONI_GLINK_ULOG, req, sizeof(req));
+		sent++;
+		if (rc != 0) {
+			if (++fails <= 5 || fails % 50 == 0) {
+				printf("NEGRONI ULOG: request #%u failed (rc %d)\n", sent, rc);
+			}
+		} else {
+			for (uint32_t ms = 0; ms < 1500 && __atomic_load_n(&ulog_len, __ATOMIC_ACQUIRE) == 0; ms += 5) {
+				negroni_glink_poll();
+				IOSleep(5);
+			}
+			if (__atomic_load_n(&ulog_len, __ATOMIC_ACQUIRE) == 0) {
+				if (++fails <= 5 || fails % 50 == 0) {
+					printf("NEGRONI ULOG: no answer to request #%u in 1.5 s\n", sent);
+				}
+			}
+		}
+		lines += ulog_print(ulog_max_lines - lines);
+		bool fast = open_ns != 0 && now_ns() - open_ns < 120ull * NSEC_PER_SEC;
+		for (uint32_t ms = 0; ms < (fast ? ulog_ms : 5000u); ms += 20) {
+			negroni_glink_poll();
+			lines += ulog_print(ulog_max_lines - lines);
+			IOSleep(20);
+		}
+	}
+	printf("NEGRONI ULOG: end: %u lines, %u requests, %u answers, %u dropped, %u foreign/short, %u failures\n", lines, sent,
+	    ulog_answers, ulog_dropped, ulog_bad, fails);
+	(void)thread_terminate(current_thread());
+}
+
+static void
+negroni_chg_ulog_start(void)
+{
+	static bool started;
+	thread_t thread;
+
+	if (!negroni_chg_ulog_wanted() || started) {
+		return;
+	}
+	started = true;
+	if (kernel_thread_start(ulog_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("NEGRONI ULOG: kernel_thread_start failed: off\n");
+	}
+}
+
+void
+negroni_chg_glink_start(void)
+{
+	static bool started;
+	thread_t thread;
+
+	negroni_chg_ulog_start();       /* 0373: independent of negronichg_glink */
+	if (!negroni_chg_pmic_wanted() || started) {    /* 0374: or the typec-only client */
+		return;
+	}
+	started = true;
+	if (kernel_thread_start(chg_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		LOG("kernel_thread_start failed: off");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_chg_glink.h b/bsd/dev/negroni_chg_glink.h
new file mode 100644
index 0000000..dcf3c05
--- /dev/null
+++ b/bsd/dev/negroni_chg_glink.h
@@ -0,0 +1,77 @@
+/*
+ * NEGRONI (SM8450) patch 0274: what the ADSP charger PD reports over GLINK PMIC_RTR_ADSP_APPS
+ * (bsd/dev/negroni_chg_glink.c), read by iokit/Kernel/arm/NegroniBattery.cpp. C and C++.
+ * iOSPlus10 docs/charger-glink-plan.md.
+ */
+#ifndef _NEGRONI_CHG_GLINK_H_
+#define _NEGRONI_CHG_GLINK_H_
+#include <stdint.h>
+#include <stdbool.h>
+
+struct negroni_chg_glink_status {
+	uint32_t gen;           /* +1 for each completed poll cycle */
+	bool wanted;            /* negronichg_glink=1 and negroniadsp set */
+	bool up;                /* the channel is open both ways */
+	bool ready;             /* the PD answered a property read with ret_code 0 */
+	bool icl_set;           /* our ICL write was accepted for this plug */
+	bool chg_en_set;        /* our BATT_CHG_EN = 1 was accepted for this plug */
+	int32_t soc_centi;      /* hundredths of a percent; -1 = unknown */
+	uint8_t soc_src;        /* 1 = OEM read buffer (the external gauge), 2 = BATT_CAPACITY */
+	int32_t vbat_mv;        /* as the PD reports it (pack or cell: see the plan) ; 0 = unknown */
+	int32_t ibat_ma;        /* as the PD reports it; INT32_MIN = unknown */
+	int32_t temp_centi;     /* hundredths of a degree C; INT32_MIN = unknown */
+	int32_t bstatus;        /* BATT_STATUS: 1 charging 2 discharging 3 not charging 4 full; -1 = unknown */
+	int32_t usb_online;     /* USB_ONLINE; -1 = unknown */
+	int32_t usb_mv;         /* USB_VOLT_NOW in mV; -1 = unknown */
+	int32_t usb_ma;         /* USB_CURR_NOW in mA; INT32_MIN = unknown */
+	int32_t icl_ma;         /* USB_INPUT_CURR_LIMIT read back, mA; -1 = unknown */
+	uint64_t soc_ns;        /* uptime (ns) of the last good SoC read */
+	uint64_t soc_change_ns; /* uptime (ns) when the SoC value last changed */
+	/* 0277: the charge loop (FV/FCC per the DT JEITA bands, re-sent every negronichg_loop_s) */
+	bool loop_on;           /* negronichg_loop=1 (default with negronichg_glink=1) */
+	bool chg_stopped;       /* the loop wrote BATT_CHG_EN = 0 (battery too hot/cold) */
+	int8_t band;            /* JEITA band index (see negroni_chg_glink.c kBand), -1 = none yet */
+	uint8_t therm_level;    /* thermal FCC level 0..4 in force (0283) */
+	int32_t fv_mv;          /* BATT_VOLT_MAX read back, mV as the PD reports it; -1 = unknown */
+	int32_t fv_set_mv;      /* the FV we wrote last (PD units); 0 = none */
+	int32_t fcc_set_ma;     /* the FCC we wrote last, mA; 0 = none */
+	int32_t fcc_ma;         /* BATT_CHG_CTRL_LIM read back, mA; -1 = unknown */
+	/* 0365: the adapter type for the iOS AdapterDetails FamilyCode */
+	int32_t usb_type;       /* USB_ADAP_TYPE (id 7; POWER_SUPPLY_PROP_USB_TYPE in oplus_battery_sm8450.c:231):
+	                         * Linux POWER_SUPPLY_USB_TYPE_* (1 SDP 2 DCP 3 CDP 4 ACA 5 C 6 PD 7 PD_DRP 8 PD_PPS
+	                         * 9 BrickID), 0x80.. QTI HVDCP; -1 = unknown */
+	/* 0369: VOOC / SuperVOOC (ADSP VOOC PHY) */
+	uint8_t vooc_mode;      /* negronichg_vooc: 0 off (default), 1 allowed */
+	int32_t vooc_enable;    /* USB_VOOCPHY_ENABLE read back; -1 unknown */
+	bool vooc_active;       /* status ONGOING: the ADSP's VOOC path charges, the PMIC charger is parked */
+	uint8_t vooc_code;      /* last USB_VOOCPHY_STATUS code (0 unknown, 1 PRESENT, 2 ONGOING, 3 ABSENT, 4 FULL, ...) */
+	uint8_t vooc_adapter;   /* adapter id (oplus_vooc.c adapter_id_table); 0 none */
+	uint32_t vooc_mw;       /* the adapter's power class, mW, capped at the project's 80000; 0 none */
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* A copy of the last status. false: no 0274 client (negronichg_glink=0 or no ADSP). */
+bool negroni_chg_glink_get(struct negroni_chg_glink_status *out);
+/* Start the client thread (once; nothing without negronichg_glink=1 and negroniadsp). */
+void negroni_chg_glink_start(void);
+/*
+ * 0277: the thermal FCC level for the charge loop, any thread. 0 = none; 1..4 = the DT
+ * qcom,thermal-mitigation table 3000/1500/1000/500 mA (out/live.dts:6647). The thermal policy
+ * (0283) sets it; the loop takes min(band FCC, level FCC) at its next run.
+ */
+void negroni_chg_glink_set_thermal_level(unsigned level);
+/*
+ * 0277: a small power hub. Temperatures that one part measures and another part uses (the
+ * battery service measures the skin/XO thermistors and gets the cell temperature from the PD;
+ * the thermal policy 0283 reads them). Hundredths of a degree C. Thread context. get: false when
+ * the value is unknown or older than max_age_ms.
+ */
+enum { NEGRONI_PWR_T_SKIN = 0, NEGRONI_PWR_T_XO = 1, NEGRONI_PWR_T_BATT = 2, NEGRONI_PWR_T_N = 3 };
+void negroni_pwr_temp_set(unsigned which, int32_t centi_c);
+bool negroni_pwr_temp_get(unsigned which, int32_t *centi_c, uint32_t max_age_ms);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/negroni_cpufreq.c b/bsd/dev/negroni_cpufreq.c
new file mode 100644
index 0000000..393cd71
--- /dev/null
+++ b/bsd/dev/negroni_cpufreq.c
@@ -0,0 +1,516 @@
+/*
+ * NEGRONI (SM8450) CPU clock speed. ABL leaves each cluster at a modest
+ * frequency and expects the OS to ask for more; on this SoC that is one
+ * register write per frequency domain: the EPSS has a table of rows and
+ * switches clock source and voltage itself when told which row is wanted.
+ * The hardware limits management (LMh) still throttles on its own when the
+ * die gets hot. Layout: Linux drivers/cpufreq/qcom-cpufreq-hw.c (epss),
+ * addresses: sm8450.dtsi cpufreq@17d91000. Ported for negroni from the
+ * Linux qcom-cpufreq-hw EPSS layout.
+ *
+ * Patch 0291: negronicpufreq_floor=abl|lut (default abl = the 0098 rule). With lut the lowest row of
+ * d1 (A710) and d2 (X2) is row 0 of their EPSS LUT (the table that 0284 prints at boot) instead of the
+ * row ABL left (d1 17, d2 20 = their top rows at boot 0097/0100), so the governor can idle the big
+ * cores at their lowest row and the thermal cap (0280/0283, negroni_cpufreq_cap(0) = the deepest row)
+ * can really lower them. d0 (A510, the boot cluster) keeps its ABL row as the floor in both modes.
+ * Evidence (README-cpufreq.md "Before 0284"): boot 0097 ran d1 row 15 (2342 MHz) and d2 row 14
+ * (2400 MHz), both below their ABL rows, through SpringBoard and Safari without a fault. No boot has
+ * run d1/d2 at their LUT minimum yet: lut is the owner's decision per test image, abl stays the default.
+ * The three checks of 0284 (floor, cap, wr_perf_state) now use dom_min_row[] (ABL row, or 0 with lut). *
+ * Boot args: negronicpufreq=0 leaves the clocks alone; negronicpufreq_mhz=N
+ * caps each domain at the highest row not above N MHz (default 3200,
+ * above every row: the top of each table); a domain is never set below
+ * the row ABL left it at.
+ * Patch 0280: negroni_cpufreq_cap(mhz) changes the cap at run time (the thermal
+ * policy); the same rule: never below the row ABL left.
+ *
+ * Patch 0284: a governor. A kernel thread wakes every 100 ms, reads the
+ * per-CPU tick counters of the running kernel (processor_cpu_load_info() in
+ * osfmk/kern/processor.c: user/system/idle ticks of hz_tick_interval = 10 ms
+ * from processor->pr_recount, the numbers host_statistics(HOST_CPU_LOAD_INFO)
+ * returns as cpu_ticks[]) and steps the EPSS PERF_STATE row of each domain.
+ * busy % = (user + system + nice ticks) * 100 / all ticks over the last
+ * 300 ms (3 samples: a 10 ms tick is coarse against a 100 ms window);
+ * a domain's busy is its busiest core.
+ *   busy > negronicpufreq_hi (70 %)                 -> +1 row (per 100 ms tick) up to the cap
+ *   busy < negronicpufreq_lo (30 %) for 3 ticks     -> -1 row down to the floor
+ * The cap is the smaller of negronicpufreq_mhz and the thermal cap (0280).
+ * The floor of every domain is the row ABL left (0098 rule: never below it).
+ * negronicpufreq_floor_mhz=N raises the floor to the highest row not above
+ * N MHz; it never puts the floor below the ABL row. Three checks keep the row
+ * at or above the ABL row: the floor (gov_start), the cap (raise_domain and
+ * negroni_cpufreq_cap never go below the ABL row), and wr_perf_state(), the one
+ * place that writes PERF_STATE after boot, which raises a lower row to the ABL row.
+ * negronicpufreq_gov=0 keeps the one-shot raise of 0096/0098 (no thread).
+ * The log line also shows the LMh limit of each domain (DOMAIN_STATE [7:0] * 19.2
+ * MHz, qcom-cpufreq-hw.c line 143: the hardware throttle when the die is hot).
+ * Register check against the OnePlus kernel (out/src/op-kernel/drivers/cpufreq/
+ * qcom-cpufreq-hw.c, cpufreq_qcom_epss_std_offsets lines 104-110): FREQ_LUT 0x100,
+ * VOLT_LUT 0x200, PERF_STATE 0x320, CYCLE_CNTR 0x3c4, DOMAIN_STATE 0x020; row decode
+ * lines 495-506: src = [31:30], lval = [7:0], src ? xo * lval : alternate / 2;
+ * the table ends at the first repeated frequency (line 516). Domain bases and
+ * qcom,lut-row-size = 4: out/live.dts qcom,cpufreq-hw (reg 0x17d91000/92000/93000).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <string.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <kern/processor.h>
+#include <mach/machine.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* osfmk/kern/processor.c (MACH_KERNEL_PRIVATE in the header): the HOST_CPU_LOAD_INFO counters of one CPU */
+extern void processor_cpu_load_info(processor_t processor, natural_t ticks[CPU_STATE_MAX]);
+void negroni_cpufreq_init(void);
+void negroni_cpufreq_cap(uint32_t mhz);
+void negroni_cpufreq_line(char *buf, size_t size);
+void negroni_cpufreq_mhz_line(char *buf, size_t size);
+
+#define EPSS_PHYS               0x17d91000UL    /* domain 0: A510 0-3, 1: A710 4-6, 2: X2 7 */
+#define EPSS_DOMAIN_SIZE        0x1000UL
+#define EPSS_DOMAINS            3
+#define EPSS_FREQ_TABLE         0x100           /* a word per row: [31:30] source, [7:0] multiple of 19.2 MHz */
+#define EPSS_TABLE_ROWS         40
+#define EPSS_PERF_STATE         0x320           /* the wanted row */
+#define EPSS_DOMAIN_STATE       0x020           /* [7:0]: the LMh limit, a multiple of 19.2 MHz */
+#define XO_KHZ                  19200
+#define ALTERNATE_KHZ           300000          /* source 0: GPLL0 300 MHz */
+
+#define GOV_TICK_MS             100
+#define GOV_LOW_TICKS           3               /* 300 ms below the low mark before -1 row */
+#define GOV_WINDOW              3               /* busy % over the last 3 samples (300 ms) */
+#define GOV_LOG_TICKS           600             /* a line a minute */
+#define GOV_CHANGE_TICKS        10              /* at most one change line a second */
+#define GOV_MAX_CPUS            16
+
+static vm_offset_t dom_base[EPSS_DOMAINS];
+static uint32_t dom_abl_row[EPSS_DOMAINS], dom_cores[EPSS_DOMAINS];
+static bool dom_known;
+/* 0291: the lowest row any path may write: the ABL row (abl) or LUT row 0 for d1/d2 (lut) */
+static uint32_t dom_min_row[EPSS_DOMAINS];
+static bool floor_lut;
+
+/* 0284: the table of each domain (rows that go up; the EPSS table ends by repeating a row) */
+static uint32_t dom_khz[EPSS_DOMAINS][EPSS_TABLE_ROWS];
+static uint32_t dom_rows[EPSS_DOMAINS];         /* rows in use: 0..dom_rows-1 */
+static uint32_t dom_cap_row[EPSS_DOMAINS];      /* upper bound: negronicpufreq_mhz and the thermal cap */
+static uint32_t dom_floor_row[EPSS_DOMAINS];    /* lower bound now: min(cfg_floor_row, dom_cap_row) */
+static uint32_t cfg_floor_row[EPSS_DOMAINS];    /* the configured floor (ABL row or negronicpufreq_floor_mhz) */
+static uint32_t dom_row[EPSS_DOMAINS];          /* the row we asked for last */
+static uint32_t dom_busy[EPSS_DOMAINS];         /* busiest core of the domain, %, last tick */
+static uint32_t dom_low_ticks[EPSS_DOMAINS];
+static uint32_t gov_on = 1, gov_hi = 70, gov_lo = 30, cap_mhz_now = 3200;
+static uint32_t cpu_busy_last[GOV_MAX_CPUS], cpu_all_last[GOV_MAX_CPUS];
+static uint32_t cpu_busy_d[GOV_MAX_CPUS][GOV_WINDOW], cpu_all_d[GOV_MAX_CPUS][GOV_WINDOW];
+static uint32_t win_at;
+static bool sampled;                            /* the first sample only sets the base */
+static char gov_line[128];
+/* the governor thread and the thermal thread (0280) both move the rows */
+static LCK_GRP_DECLARE(cpufreq_grp, "negroni_cpufreq");
+static LCK_MTX_DECLARE(cpufreq_lock, &cpufreq_grp);
+
+static uint32_t
+domain_of(uint32_t phys_id)
+{
+	uint32_t core = (phys_id & 0xff00) ? (phys_id >> 8) & 0xff : phys_id & 0xff;
+
+	return core < 4 ? 0 : core < 7 ? 1 : 2;
+}
+
+static inline uint32_t
+rd_perf_state(uint32_t domain)
+{
+	return *(volatile uint32_t *)(dom_base[domain] + EPSS_PERF_STATE);
+}
+
+/* The one writer of PERF_STATE after boot. Never below the minimum row (0098: the ABL row; 0291 lut: row 0 for d1/d2). */
+static inline void
+wr_perf_state(uint32_t domain, uint32_t row)
+{
+	if (row < dom_min_row[domain]) {
+		row = dom_min_row[domain];
+	}
+	*(volatile uint32_t *)(dom_base[domain] + EPSS_PERF_STATE) = row;
+	dom_row[domain] = row;
+}
+
+/* Read the table of a domain once: rows that go up, until the table repeats itself. */
+static void
+read_table(uint32_t domain, vm_offset_t base)
+{
+	uint32_t n = 0, last = 0;
+
+	for (uint32_t row = 0; row < EPSS_TABLE_ROWS; row++) {
+		uint32_t entry = *(volatile uint32_t *)(base + EPSS_FREQ_TABLE + 4 * row);
+		uint32_t khz = (entry >> 30) ? XO_KHZ * (entry & 0xff) : ALTERNATE_KHZ;
+
+		if (row > 0 && khz <= last) {
+			break;
+		}
+		dom_khz[domain][n++] = khz;
+		last = khz;
+	}
+	dom_rows[domain] = n;
+}
+
+/* The highest row of the domain whose clock is not above khz (row 0 when every row is above). */
+static uint32_t
+row_for_khz(uint32_t domain, uint32_t khz)
+{
+	uint32_t top = 0;
+
+	for (uint32_t row = 0; row < dom_rows[domain]; row++) {
+		if (dom_khz[domain][row] > khz) {
+			break;
+		}
+		top = row;
+	}
+	return top;
+}
+
+static inline uint32_t
+row_mhz(uint32_t domain, uint32_t row)
+{
+	return row < dom_rows[domain] ? dom_khz[domain][row] / 1000 : 0;
+}
+
+static void
+raise_domain(uint32_t domain, uint32_t cores, uint32_t cap_khz)
+{
+	uint32_t top, top_khz, was;
+	vm_offset_t base = ml_io_map(EPSS_PHYS + domain * EPSS_DOMAIN_SIZE, EPSS_DOMAIN_SIZE);
+
+	if (!base) {
+		printf("NEGRONI CPUFREQ: domain %u not mapped\n", domain);
+		return;
+	}
+	read_table(domain, base);
+	top = row_for_khz(domain, cap_khz);
+	top_khz = dom_khz[domain][top];
+	was = *(volatile uint32_t *)(base + EPSS_PERF_STATE);
+	dom_base[domain] = base;
+	dom_abl_row[domain] = was;
+	dom_min_row[domain] = (floor_lut && domain != 0) ? 0 : was;    /* 0291 */
+	dom_cores[domain] = cores;
+	dom_cap_row[domain] = top > dom_min_row[domain] ? top : dom_min_row[domain];   /* the cap is never below the minimum row */
+	dom_row[domain] = was;
+	if (was >= top) {
+		/* ABL already asked for as much or more: never slow a domain down */
+		printf("NEGRONI CPUFREQ: domain %u (%u cores): keeping row %u (cap row %u, %u MHz)\n",
+		    domain, cores, was, top, top_khz / 1000);
+		return;
+	}
+	*(volatile uint32_t *)(base + EPSS_PERF_STATE) = top;
+	dom_row[domain] = top;
+	delay(20000);
+	printf("NEGRONI CPUFREQ: domain %u (%u cores): row %u -> %u, %u MHz\n",
+	    domain, cores, was, top, top_khz / 1000);
+}
+
+/*
+ * The busy share of every CPU over the last GOV_WINDOW ticks, from the kernel's
+ * own counters: processor_cpu_load_info() (osfmk/kern/processor.c) adds the
+ * user/system/idle ticks of the CPU (processor->pr_recount through
+ * recount_processor_usage(), divided by hz_tick_interval = 10 ms) into ticks[].
+ * The same function fills HOST_CPU_LOAD_INFO cpu_ticks[]. Per domain: the busiest core.
+ */
+static void
+sample_busy(void)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+
+	for (uint32_t d = 0; d < EPSS_DOMAINS; d++) {
+		dom_busy[d] = 0;
+	}
+	for (unsigned int i = 0; i < topology->num_cpus && i < GOV_MAX_CPUS; i++) {
+		uint32_t d = domain_of(topology->cpus[i].phys_id);
+		processor_t p = cpu_to_processor((int)topology->cpus[i].cpu_id);
+		natural_t ticks[CPU_STATE_MAX] = { 0 };
+		uint32_t busy, all, busy_w = 0, all_w = 0, pct;
+
+		if (p == PROCESSOR_NULL) {
+			continue;
+		}
+		processor_cpu_load_info(p, ticks);
+		busy = ticks[CPU_STATE_USER] + ticks[CPU_STATE_SYSTEM] + ticks[CPU_STATE_NICE];
+		all = busy + ticks[CPU_STATE_IDLE];
+		/* the counters count from boot: the first sample is only the base of the deltas */
+		cpu_busy_d[i][win_at] = sampled ? busy - cpu_busy_last[i] : 0;
+		cpu_all_d[i][win_at] = sampled ? all - cpu_all_last[i] : 0;
+		cpu_busy_last[i] = busy;
+		cpu_all_last[i] = all;
+		for (uint32_t w = 0; w < GOV_WINDOW; w++) {
+			busy_w += cpu_busy_d[i][w];
+			all_w += cpu_all_d[i][w];
+		}
+		pct = all_w ? busy_w * 100 / all_w : 0;
+		if (pct > 100) {
+			pct = 100;
+		}
+		if (pct > dom_busy[d]) {
+			dom_busy[d] = pct;
+		}
+	}
+	win_at = (win_at + 1) % GOV_WINDOW;
+	sampled = true;
+}
+
+static inline uint32_t
+lmh_mhz(uint32_t domain)
+{
+	return (*(volatile uint32_t *)(dom_base[domain] + EPSS_DOMAIN_STATE) & 0xff) * XO_KHZ / 1000;
+}
+
+static void
+format_line(void)
+{
+	size_t at = 0;
+
+	gov_line[0] = 0;
+	for (uint32_t d = 0; d < EPSS_DOMAINS; d++) {
+		if (!dom_base[d]) {
+			continue;
+		}
+		at += snprintf(gov_line + at, sizeof(gov_line) - at, "%sd%u %u MHz busy %u%% lmh %u",
+		    at ? " | " : "", d, row_mhz(d, dom_row[d]), dom_busy[d], lmh_mhz(d));
+		if (at >= sizeof(gov_line)) {
+			break;
+		}
+	}
+}
+
+/* 0284: one tick of the policy. Returns true when a row changed. */
+static bool
+gov_step(void)
+{
+	bool changed = false;
+
+	lck_mtx_lock(&cpufreq_lock);
+	for (uint32_t d = 0; d < EPSS_DOMAINS; d++) {
+		uint32_t row, want;
+
+		if (!dom_base[d]) {
+			continue;
+		}
+		row = want = dom_row[d];
+		if (dom_busy[d] > gov_hi) {
+			dom_low_ticks[d] = 0;
+			if (want < dom_cap_row[d]) {
+				want++;
+			}
+		} else if (dom_busy[d] < gov_lo) {
+			if (++dom_low_ticks[d] >= GOV_LOW_TICKS) {
+				dom_low_ticks[d] = 0;
+				if (want > dom_floor_row[d]) {
+					want--;
+				}
+			}
+		} else {
+			dom_low_ticks[d] = 0;
+		}
+		/* the bounds hold whatever happened above (a cap that moved under us) */
+		if (want > dom_cap_row[d]) {
+			want = dom_cap_row[d];
+		}
+		if (want < dom_floor_row[d]) {
+			want = dom_floor_row[d];
+		}
+		if (want != row) {
+			wr_perf_state(d, want);
+			changed = true;
+		}
+	}
+	lck_mtx_unlock(&cpufreq_lock);
+	return changed;
+}
+
+__attribute__((noreturn)) static void
+gov_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t tick = 0, printed = 0;
+	bool pending = false;   /* a row changed since the last line */
+
+	sample_busy();          /* the first delta starts here */
+	for (;;) {
+		assert_wait_timeout((event_t)&tick, THREAD_UNINT, GOV_TICK_MS, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		tick++;
+		sample_busy();
+		if (gov_step()) {
+			pending = true;
+		}
+		format_line();
+		/* change lines: at most one a second (the state then, not each step); the minute line always */
+		if ((pending && tick - printed >= GOV_CHANGE_TICKS) || tick % GOV_LOG_TICKS == 0) {
+			printf("NEGRONI CPUFREQ: %s\n", gov_line);
+			printed = tick;
+			pending = false;
+		}
+	}
+}
+
+/* 0284: the state for another log line (the GPU WATCH line can append it). */
+void
+negroni_cpufreq_line(char *buf, size_t size)
+{
+	strlcpy(buf, gov_line, size);
+}
+
+/* 0284: "cpu 1785/2496/2995 MHz", the rows asked for now, for the GPU WATCH line. */
+void
+negroni_cpufreq_mhz_line(char *buf, size_t size)
+{
+	if (!dom_known) {
+		snprintf(buf, size, "cpu off");
+		return;
+	}
+	snprintf(buf, size, "cpu %u/%u/%u MHz", dom_base[0] ? row_mhz(0, dom_row[0]) : 0,
+	    dom_base[1] ? row_mhz(1, dom_row[1]) : 0, dom_base[2] ? row_mhz(2, dom_row[2]) : 0);
+}
+
+static void
+gov_start(void)
+{
+	uint32_t floor_mhz = 0;
+	thread_t thread;
+	char rows[128];
+	size_t at = 0;
+
+	(void)PE_parse_boot_argn("negronicpufreq_floor_mhz", &floor_mhz, sizeof(floor_mhz));
+	(void)PE_parse_boot_argn("negronicpufreq_hi", &gov_hi, sizeof(gov_hi));
+	(void)PE_parse_boot_argn("negronicpufreq_lo", &gov_lo, sizeof(gov_lo));
+	if (gov_hi > 100) {
+		gov_hi = 100;
+	}
+	if (gov_hi == 0) {
+		gov_hi = 1;
+	}
+	if (gov_lo > gov_hi - 1) {
+		gov_lo = gov_hi - 1;
+	}
+	for (uint32_t d = 0; d < EPSS_DOMAINS; d++) {
+		if (!dom_base[d]) {
+			continue;
+		}
+		/* the table, once, for the record: the rows the policy can use */
+		char tab[200];
+		size_t t = 0;
+		for (uint32_t r = 0; r < dom_rows[d] && t < sizeof(tab) - 8; r++) {
+			t += snprintf(tab + t, sizeof(tab) - t, "%s%u", r ? "," : "", dom_khz[d][r] / 1000);
+		}
+		printf("NEGRONI CPUFREQ: d%u table (%u rows, MHz): %s; ABL row %u; floor row %u (%s)\n", d, dom_rows[d], tab,
+		    dom_abl_row[d], dom_min_row[d], dom_min_row[d] < dom_abl_row[d] ? "negronicpufreq_floor=lut: LUT minimum" : "ABL row");
+		/* the floor: the minimum row (0098 ABL row; 0291 lut: row 0 for d1/d2); negronicpufreq_floor_mhz can only raise it */
+		dom_floor_row[d] = dom_min_row[d];
+		if (floor_mhz) {
+			uint32_t want = row_for_khz(d, floor_mhz * 1000);
+
+			if (want > dom_floor_row[d]) {
+				dom_floor_row[d] = want;
+			} else if (want < dom_min_row[d]) {
+				printf("NEGRONI CPUFREQ: d%u negronicpufreq_floor_mhz=%u is row %u, below the minimum row %u: floor stays %u\n",
+				    d, floor_mhz, want, dom_min_row[d], dom_min_row[d]);
+			}
+		}
+		cfg_floor_row[d] = dom_floor_row[d];
+		if (dom_floor_row[d] > dom_cap_row[d]) {
+			dom_floor_row[d] = dom_cap_row[d];     /* the cap is never below the minimum row */
+		}
+		if (dom_row[d] != rd_perf_state(d)) {
+			dom_row[d] = rd_perf_state(d);
+		}
+		at += snprintf(rows + at, sizeof(rows) - at, "%sd%u rows %u..%u (%u..%u MHz)", at ? ", " : "",
+		    d, dom_floor_row[d], dom_cap_row[d], row_mhz(d, dom_floor_row[d]), row_mhz(d, dom_cap_row[d]));
+	}
+	printf("NEGRONI CPUFREQ: governor on (%s; up > %u%%, down < %u%% for %u ms, tick %u ms)\n",
+	    rows, gov_hi, gov_lo, GOV_LOW_TICKS * GOV_TICK_MS, GOV_TICK_MS);
+	if (kernel_thread_start(gov_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("NEGRONI CPUFREQ: governor thread did not start\n");
+	}
+}
+
+void
+negroni_cpufreq_init(void)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint32_t enabled = 1, cap_mhz = 3200, cores[EPSS_DOMAINS] = { 0 };
+
+	(void)PE_parse_boot_argn("negronicpufreq", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("negronicpufreq_mhz", &cap_mhz, sizeof(cap_mhz));
+	(void)PE_parse_boot_argn("negronicpufreq_gov", &gov_on, sizeof(gov_on));
+	/* 0291: negronicpufreq_floor=abl (default) | lut (or 0 | 1) */
+	char fl[8] = "abl";
+	(void)PE_parse_boot_arg_str("negronicpufreq_floor", fl, sizeof(fl));
+	floor_lut = strcmp(fl, "lut") == 0 || strcmp(fl, "1") == 0;
+	if (!enabled) {
+		printf("NEGRONI CPUFREQ: disabled (negronicpufreq=0)\n");
+		return;
+	}
+	cap_mhz_now = cap_mhz;
+	for (unsigned int i = 0; i < topology->num_cpus; i++) {
+		cores[domain_of(topology->cpus[i].phys_id)]++;
+	}
+	for (uint32_t domain = 0; domain < EPSS_DOMAINS; domain++) {
+		if (cores[domain] != 0) {
+			raise_domain(domain, cores[domain], cap_mhz * 1000);
+		}
+	}
+	dom_known = true;
+	printf("NEGRONI CPUFREQ: floor %s (negronicpufreq_floor=%s): d0 row %u, d1 row %u, d2 row %u (ABL rows %u/%u/%u)\n",
+	    floor_lut ? "lut" : "abl", fl, dom_min_row[0], dom_min_row[1], dom_min_row[2], dom_abl_row[0], dom_abl_row[1],
+	    dom_abl_row[2]);
+	if (gov_on) {
+		gov_start();
+	} else {
+		printf("NEGRONI CPUFREQ: governor off (negronicpufreq_gov=0): the rows stay\n");
+	}
+}
+
+/*
+ * Patch 0280: a new cap for every domain (thermal policy). Not below the row ABL left.
+ * 0284: with the governor the cap is the upper bound of the policy (negronicpufreq_mhz
+ * stays a bound too); a row above the new cap is lowered at once.
+ */
+void
+negroni_cpufreq_cap(uint32_t mhz)
+{
+	if (!dom_known) {
+		return;
+	}
+	if (mhz > cap_mhz_now) {
+		mhz = cap_mhz_now;
+	}
+	lck_mtx_lock(&cpufreq_lock);
+	for (uint32_t domain = 0; domain < EPSS_DOMAINS; domain++) {
+		uint32_t top, was;
+
+		if (!dom_base[domain]) {
+			continue;
+		}
+		top = row_for_khz(domain, mhz * 1000);
+		if (top < dom_min_row[domain]) {
+			top = dom_min_row[domain];      /* 0291: the ABL row, or row 0 with lut (mhz 0 = the deepest row) */
+		}
+		dom_cap_row[domain] = top;
+		if (gov_on) {
+			/* the configured floor comes back when the cap goes up again */
+			dom_floor_row[domain] = cfg_floor_row[domain] < top ? cfg_floor_row[domain] : top;
+		}
+		was = rd_perf_state(domain);
+		if (gov_on ? was <= top : was == top) {
+			continue;
+		}
+		wr_perf_state(domain, top);
+		printf("NEGRONI CPUFREQ: domain %u (%u cores): row %u -> %u (cap %u MHz)\n", domain, dom_cores[domain], was, top, mhz);
+	}
+	lck_mtx_unlock(&cpufreq_lock);
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_dpu.c b/bsd/dev/negroni_dpu.c
new file mode 100644
index 0000000..e3ebb4e
--- /dev/null
+++ b/bsd/dev/negroni_dpu.c
@@ -0,0 +1,660 @@
+/*
+ * NEGRONI display engine (SM8450 DPU / SDE 8.x, INTF_1 = DSI0) work that the UEFI's setup does
+ * not cover (0294-0296). Register layout: display-drivers msm/sde (sde_hw_intf.c, sde_hw_ctl.c,
+ * sde_hw_interrupts.c, sde_hwio.h); addresses: out/live.dts qcom,mdss_mdp@ae00000 (MDSS 0x0ae00000,
+ * qcom,sde-intf-off[1] 0x36000, qcom,sde-intf-tear-irq-off[1] 0x36800).
+ *
+ * 0294: the tearcheck vsync_count follows the panel rate (sde_encoder_phys_cmd.c:1240-1259:
+ * vsync_count = vsync_clk / (vtotal * vrefresh), vsync_clk 19.2 MHz, vtotal 2424 = 2412 + 2 + 8 + 2
+ * in every FHD timing, live.dts 35640/35729/35818): 120 Hz 66, 90 Hz 88, 60 Hz 132.
+ * sde_hw_intf.c:622-666 writes SYNC_CONFIG_VSYNC (bit 20 TE pin, bit 19 counter enable,
+ * [18:0] vsync_count) and the other tearcheck registers; only vsync_count changes here (written
+ * with the counter off, then the counter on, as :646-658), the other registers keep the UEFI's
+ * values (height 0xfff0, init = start = 2412).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <stdbool.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+#define NDPU_INTF_TEAR_SYNC_CONFIG_VSYNC        0x288
+#define NDPU_TE_VSYNC_CLK_HZ                    19200000u
+#define NDPU_VTOTAL                             2424u
+
+uint32_t negroni_dpu_te_rate(uintptr_t intf, uint32_t fps);
+
+static int ndpu_tcfg = -1;              /* negronifb_tcfg (default 1) */
+static uint32_t ndpu_boot_count;        /* vsync_count as the UEFI left it (120 Hz) */
+
+static inline uint32_t
+ndpu_rd(uintptr_t a)
+{
+	return *(volatile uint32_t *)a;
+}
+
+static inline void
+ndpu_wr(uintptr_t a, uint32_t v)
+{
+	*(volatile uint32_t *)a = v;
+}
+
+/*
+ * 0294, from 0259's vrrSetRate (mode 2 switch, work loop / thread call): program vsync_count for
+ * fps. Returns the new line time in ns (0: not changed). negronifb_tcfg=0 turns it off.
+ */
+uint32_t
+negroni_dpu_te_rate(uintptr_t intf, uint32_t fps)
+{
+	if (ndpu_tcfg < 0) {
+		uint32_t on = 1;
+		PE_parse_boot_argn("negronifb_tcfg", &on, sizeof(on));
+		ndpu_tcfg = on != 0;
+	}
+	if (!ndpu_tcfg || intf == 0 || fps == 0 || fps > 240) {
+		return 0;
+	}
+	uint32_t cfg = ndpu_rd(intf + NDPU_INTF_TEAR_SYNC_CONFIG_VSYNC);
+	if (ndpu_boot_count == 0) {
+		ndpu_boot_count = cfg & 0x7ffffu;
+	}
+	/* Android's formula when the UEFI value is the 120 Hz one of vtotal 2424, else scale it */
+	uint32_t count = ndpu_boot_count == NDPU_TE_VSYNC_CLK_HZ / (NDPU_VTOTAL * 120u) ?
+	    NDPU_TE_VSYNC_CLK_HZ / (NDPU_VTOTAL * fps) : ndpu_boot_count * 120u / fps;
+	if (count == 0 || count > 0x7ffffu) {
+		return 0;
+	}
+	if ((cfg & 0x7ffffu) != count) {
+		/*
+		 * sde_hw_intf_setup_te_config (sde_hw_intf.c:646-658): the new count with the vsync
+		 * counter off (bit 19), then the counter on again; the TE pin bit 20 stays as it is
+		 */
+		uint32_t nc = (cfg & ~0x7ffffu & ~(1u << 19)) | count;
+		ndpu_wr(intf + NDPU_INTF_TEAR_SYNC_CONFIG_VSYNC, nc);
+		__builtin_arm_dsb(0xf);
+		ndpu_wr(intf + NDPU_INTF_TEAR_SYNC_CONFIG_VSYNC, nc | (cfg & (1u << 19)));
+		__builtin_arm_dsb(0xf);
+		printf("NEGRONI DPU: tearcheck vsync_count %u -> %u for %u Hz (sync_cfg 0x%08x -> 0x%08x)\n",
+		    cfg & 0x7ffffu, count, fps, cfg, ndpu_rd(intf + NDPU_INTF_TEAR_SYNC_CONFIG_VSYNC));
+	}
+	return (uint32_t)((uint64_t)count * 1000000000ull / NDPU_TE_VSYNC_CLK_HZ);
+}
+
+/* ---------------------------------------------------------------------- */
+/* 0295: the TE as an interrupt (INTF_1 tear rd_ptr)                       */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * Android's vsync is the rd_ptr interrupt of the INTF tearcheck (sde_encoder_phys_cmd.c:313-424
+ * sde_encoder_phys_cmd_te_rd_ptr_irq, a ktime stamp per TE). Path: INTF_1 tear interrupt block
+ * (MDSS + 0x36800: EN +0x0, STATUS +0x4, CLEAR +0x8, sde_hw_interrupts.c:24-26; bits 0 autorefresh
+ * done, 1 wr_ptr, 2 rd_ptr, 3 TE detected, 4 tear detected, :184-188) -> the MDSS interrupt
+ * (HW_INTR_STATUS MDSS + 0x10, :20; bit 0 MDP, bit 4 DSI0 per live.dts dsi_ctrl0 interrupts <4>)
+ * -> GIC SPI 83 = INTID 115, level high (live.dts mdss_mdp interrupts <0 0x53 4>). The line
+ * fires at RD_PTR_IRQ (Android: vdisplay + 1 = VSYNC_INIT_VAL + 1, sde_encoder_phys_cmd.c:1268).
+ * Like Android's sde_core_irq_preinstall, the other MDP top / INTF_1 interrupt enables are cleared
+ * (nothing handles them). The DSI0 interrupt enables are not touched (0250 polls their status):
+ * when the line comes from a non-tear source the handler masks the SPI, and the next vsync tick
+ * unmasks it (at most one tick without the TE interrupt).
+ *
+ * negronifb_teirq=1 (default 0; needs the 0234 DPU mapping, negronifb_dpuprobe=1 default):
+ * each TE is stamped at the interrupt (the rd_ptr time minus the lines the counter is past
+ * VSYNC_INIT_VAL), and 0259's TE lock (negronifb_te) takes its phase from that stamp instead of
+ * the counter sample. The vsync tick itself stays the 0254 timer (a TE interrupt cannot touch an
+ * IOTimerEventSource); its deadline moves by the lock as before. negronifb_teirq_intid=N
+ * overrides 115. Per second (with the STAT lines): `NEGRONI DPU TE IRQ: ...`. A storm (more than
+ * 1000 interrupts in a second) turns it off for the boot.
+ */
+#define NDPU_MDSS_HW_INTR_STATUS        0x0010
+#define NDPU_MDP_INTR2_EN               0x1008
+#define NDPU_MDP_INTR_EN                0x1010
+#define NDPU_MDP_INTR_STATUS            0x1014
+#define NDPU_MDP_INTR_CLEAR             0x1018
+#define NDPU_MDP_INTR2_STATUS           0x100c
+#define NDPU_MDP_INTR2_CLEAR            0x102c
+#define NDPU_INTF1                      0x36000
+#define NDPU_INTF1_INTR_EN              (NDPU_INTF1 + 0x1c0)
+#define NDPU_INTF1_INTR_STATUS          (NDPU_INTF1 + 0x1c4)
+#define NDPU_INTF1_INTR_CLEAR           (NDPU_INTF1 + 0x1c8)
+#define NDPU_INTF_TEAR_VSYNC_INIT_VAL   0x294
+#define NDPU_INTF_TEAR_INT_COUNT_VAL    0x298
+#define NDPU_INTF_TEAR_RD_PTR_IRQ       0x2a4
+#define NDPU_INTF_TEAR_LINE_COUNT       0x2b0
+#define NDPU_INTF_TEAR_AUTOREFRESH      0x2b4
+#define NDPU_TEAR_INTR_EN               0x36800
+#define NDPU_TEAR_INTR_STATUS           0x36804
+#define NDPU_TEAR_INTR_CLEAR            0x36808
+#define NDPU_TEAR_RD_PTR                (1u << 2)
+#define NDPU_TEAR_ALL                   0x1fu
+#define NDPU_MDSS_INTID_DEFAULT         115     /* SPI 83 */
+#define NDPU_IRQ_STORM                  1000
+
+extern int negroni_spi_register(uint32_t intid, bool edge, void (*fn)(void *, uint32_t), void *arg);
+extern void negroni_spi_enable(uint32_t intid, bool on);
+extern volatile uint32_t *negroni_dsi_base(void);     /* NegroniBacklight.cpp (0292) */
+
+void negroni_dpu_start(uintptr_t mdss, uint32_t ctlOff);
+bool negroni_dpu_te_since(uint64_t now, uint64_t *sinceNs);
+void negroni_dpu_tick(uint64_t now, uint64_t lastSwapAbs, uint32_t presentedID, bool frameDone, bool powerOff);
+
+static uintptr_t ndpu_mdss;             /* 0234's MDSS mapping (0x84000) */
+static uint32_t ndpu_ctl;               /* CTL block offset driving INTF_1 (0234 probe) */
+static uint32_t ndpu_intid;
+static bool ndpu_irq_on, ndpu_irq_dead;
+static volatile bool ndpu_irq_masked;
+static uint32_t ndpu_te_init, ndpu_line_ns;
+static uint64_t ndpu_line_abs;          /* one tearcheck line in mach ticks x 1024 */
+static volatile uint64_t ndpu_te_abs;   /* the last TE, from the rd_ptr interrupt */
+static volatile uint32_t ndpu_irqs, ndpu_rdptr, ndpu_foreign, ndpu_masks;
+static uint32_t ndpu_irqs_sec;
+static uint64_t ndpu_sec_t0, ndpu_sec_abs, ndpu_stale_abs;
+static volatile uint64_t ndpu_lat_sum_abs, ndpu_lat_max_abs;
+
+/* Interrupt context (sleh_irq -> negroni_spi_dispatch). */
+static void
+ndpu_mdss_irq(__unused void *arg, uint32_t intid)
+{
+	uint64_t now = mach_absolute_time();
+	uint32_t st = ndpu_rd(ndpu_mdss + NDPU_TEAR_INTR_STATUS);
+
+	ndpu_irqs++;
+	if (st != 0) {
+		ndpu_wr(ndpu_mdss + NDPU_TEAR_INTR_CLEAR, st);
+		__builtin_arm_dsb(0xf);
+	}
+	if (st & NDPU_TEAR_RD_PTR) {
+		/* the TE was (line - init) lines before now */
+		uint32_t v = ndpu_rd(ndpu_mdss + NDPU_INTF1 + NDPU_INTF_TEAR_INT_COUNT_VAL);
+		uint32_t line = v & 0xffffu, lines = line >= ndpu_te_init ? line - ndpu_te_init : 0;
+		uint64_t back = (uint64_t)lines * ndpu_line_abs / 1024;
+		ndpu_te_abs = now - back;
+		ndpu_rdptr++;
+		ndpu_lat_sum_abs += back;
+		if (back > ndpu_lat_max_abs) {
+			ndpu_lat_max_abs = back;
+		}
+	} else {
+		/* not ours (DSI0 command done while 0250 polls, or another MDP source): mask until the next tick */
+		ndpu_foreign++;
+		ndpu_masks++;
+		ndpu_irq_masked = true;
+		negroni_spi_enable(intid, false);
+	}
+}
+
+/* 0259 teTick (work loop): the time since the last TE from the interrupt, if it is fresh. */
+bool
+negroni_dpu_te_since(uint64_t now, uint64_t *sinceNs)
+{
+	uint64_t te = ndpu_te_abs;
+
+	if (!ndpu_irq_on || te == 0 || now < te || now - te > ndpu_stale_abs) {
+		return false;
+	}
+	absolutetime_to_nanoseconds(now - te, sinceNs);
+	return true;
+}
+
+static void
+ndpu_teirq_init(void)
+{
+	uint32_t on = 0, intid = NDPU_MDSS_INTID_DEFAULT;
+
+	PE_parse_boot_argn("negronifb_teirq", &on, sizeof(on));
+	PE_parse_boot_argn("negronifb_teirq_intid", &intid, sizeof(intid));
+	if (!on) {
+		return;
+	}
+	if (ndpu_mdss == 0) {
+		printf("NEGRONI DPU TE IRQ: no DPU mapping (0234 probe off: negronifb_dpuprobe=0): off\n");
+		return;
+	}
+	uintptr_t intf = ndpu_mdss + NDPU_INTF1;
+	uint32_t cfg = ndpu_rd(intf + NDPU_INTF_TEAR_SYNC_CONFIG_VSYNC);
+	uint32_t count = cfg & 0x7ffffu;
+	ndpu_te_init = ndpu_rd(intf + NDPU_INTF_TEAR_VSYNC_INIT_VAL) & 0xffffu;
+	ndpu_line_ns = (uint32_t)((uint64_t)count * 1000000000ull / NDPU_TE_VSYNC_CLK_HZ);
+	uint64_t abs1000;
+	nanoseconds_to_absolutetime((uint64_t)ndpu_line_ns * 1024, &abs1000);
+	ndpu_line_abs = abs1000;
+	nanoseconds_to_absolutetime(25 * NSEC_PER_MSEC, &ndpu_stale_abs);   /* > 2 periods at 90 Hz */
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &ndpu_sec_abs);
+	volatile uint32_t *dsi = negroni_dsi_base();
+	uint32_t rdptr = ndpu_rd(intf + NDPU_INTF_TEAR_RD_PTR_IRQ) & 0xffffu;
+	printf("NEGRONI DPU TE IRQ: before: mdss intr 0x%08x, top en 0x%08x/0x%08x status 0x%08x/0x%08x, intf1 en 0x%08x "
+	    "status 0x%08x, tear en 0x%08x status 0x%08x, rd_ptr_irq %u init %u vsync_count %u, dsi0 int_ctrl 0x%08x\n",
+	    ndpu_rd(ndpu_mdss + NDPU_MDSS_HW_INTR_STATUS), ndpu_rd(ndpu_mdss + NDPU_MDP_INTR_EN),
+	    ndpu_rd(ndpu_mdss + NDPU_MDP_INTR2_EN), ndpu_rd(ndpu_mdss + NDPU_MDP_INTR_STATUS),
+	    ndpu_rd(ndpu_mdss + NDPU_MDP_INTR2_STATUS), ndpu_rd(ndpu_mdss + NDPU_INTF1_INTR_EN),
+	    ndpu_rd(ndpu_mdss + NDPU_INTF1_INTR_STATUS), ndpu_rd(ndpu_mdss + NDPU_TEAR_INTR_EN),
+	    ndpu_rd(ndpu_mdss + NDPU_TEAR_INTR_STATUS), rdptr, ndpu_te_init, count, dsi != NULL ? dsi[0x110 / 4] : 0);
+	if (count == 0 || ndpu_te_init == 0) {
+		printf("NEGRONI DPU TE IRQ: tearcheck not set up (vsync_count %u, init %u): off\n", count, ndpu_te_init);
+		return;
+	}
+	/* sde_core_irq_preinstall: everything off and cleared, then only the rd_ptr */
+	ndpu_wr(ndpu_mdss + NDPU_MDP_INTR_EN, 0);
+	ndpu_wr(ndpu_mdss + NDPU_MDP_INTR2_EN, 0);
+	ndpu_wr(ndpu_mdss + NDPU_INTF1_INTR_EN, 0);
+	ndpu_wr(ndpu_mdss + NDPU_MDP_INTR_CLEAR, 0xffffffffu);
+	ndpu_wr(ndpu_mdss + NDPU_MDP_INTR2_CLEAR, 0xffffffffu);
+	ndpu_wr(ndpu_mdss + NDPU_INTF1_INTR_CLEAR, 0xffffffffu);
+	ndpu_wr(ndpu_mdss + NDPU_TEAR_INTR_EN, 0);
+	ndpu_wr(ndpu_mdss + NDPU_TEAR_INTR_CLEAR, NDPU_TEAR_ALL);
+	if (rdptr != ndpu_te_init + 1) {
+		ndpu_wr(intf + NDPU_INTF_TEAR_RD_PTR_IRQ, ndpu_te_init + 1);     /* Android: vdisplay + 1 */
+	}
+	__builtin_arm_dsb(0xf);
+	ndpu_intid = intid;
+	if (negroni_spi_register(intid, false, ndpu_mdss_irq, NULL) != 0) {
+		printf("NEGRONI DPU TE IRQ: INTID %u not registered (no GIC distributor or no slot): off\n", intid);
+		return;
+	}
+	ndpu_irq_on = true;
+	ndpu_wr(ndpu_mdss + NDPU_TEAR_INTR_EN, NDPU_TEAR_RD_PTR);
+	__builtin_arm_dsb(0xf);
+	printf("NEGRONI DPU TE IRQ: on: INTID %u (SPI %u, level), INTF_1 tear rd_ptr at line %u (was %u), %u ns/line; "
+	    "0259's TE lock takes its phase from it\n", intid, intid - 32, ndpu_te_init + 1, rdptr, ndpu_line_ns);
+}
+
+/*
+ * 0382 (README-power-idle.md): while the display is asleep (negroni_display_asleep, NegroniFramebuffer.cpp)
+ * the TE line is masked (nothing uses a TE while dark: teTick is skipped then) and the per-second line
+ * prints only when interrupts came, or once a minute. Unmasked on the first tick after the wake.
+ */
+extern int negroni_display_asleep;
+static bool ndpu_dark_masked;
+static uint64_t ndpu_print_at;
+
+/* Work loop, each tick: unmask after a foreign interrupt, the per-second line, the storm guard. */
+static void
+ndpu_teirq_tick(uint64_t now)
+{
+	if (!ndpu_irq_on) {
+		return;
+	}
+	bool dark = __atomic_load_n(&negroni_display_asleep, __ATOMIC_ACQUIRE) != 0;
+	if (dark != ndpu_dark_masked) {
+		ndpu_dark_masked = dark;
+		negroni_spi_enable(ndpu_intid, !dark);  /* 0382 */
+		if (!dark) {
+			ndpu_irq_masked = false;
+		}
+	}
+	if (ndpu_irq_masked && !dark) {
+		ndpu_irq_masked = false;
+		negroni_spi_enable(ndpu_intid, true);
+	}
+	if (ndpu_sec_t0 == 0) {
+		ndpu_sec_t0 = now;
+		return;
+	}
+	if (now - ndpu_sec_t0 < ndpu_sec_abs) {
+		return;
+	}
+	uint32_t irqs = ndpu_irqs - ndpu_irqs_sec, rd = ndpu_rdptr, fo = ndpu_foreign, ma = ndpu_masks;
+	ndpu_irqs_sec = ndpu_irqs;
+	ndpu_rdptr = ndpu_foreign = ndpu_masks = 0;
+	uint64_t lat = ndpu_lat_sum_abs, latMax = ndpu_lat_max_abs, ns, nsMax;
+	ndpu_lat_sum_abs = ndpu_lat_max_abs = 0;
+	absolutetime_to_nanoseconds(rd != 0 ? lat / rd : 0, &ns);
+	absolutetime_to_nanoseconds(latMax, &nsMax);
+	ndpu_sec_t0 = now;
+	if (dark && irqs == 0 && now - ndpu_print_at < 60 * ndpu_sec_abs) {
+		return;                 /* 0382: dark and quiet */
+	}
+	ndpu_print_at = now;
+	printf("NEGRONI DPU TE IRQ: irqs/s %u rd_ptr %u foreign %u (masked %u) TE-to-handler us avg/max %llu/%llu\n",
+	    irqs, rd, fo, ma, ns / 1000, nsMax / 1000);
+	if (irqs > NDPU_IRQ_STORM) {
+		ndpu_irq_on = false;
+		ndpu_irq_dead = true;
+		negroni_spi_enable(ndpu_intid, false);
+		ndpu_wr(ndpu_mdss + NDPU_TEAR_INTR_EN, 0);
+		printf("NEGRONI DPU TE IRQ: %u interrupts in a second: off for this boot (the timer path stays)\n", irqs);
+	}
+}
+
+/* ---------------------------------------------------------------------- */
+/* 0296: DPU/DSI power: what the UEFI left on, and the no-transfer idle     */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * Android (display-drivers): per frame sde_core_perf_crtc_update (sde_core_perf.c:984: core clock
+ * and bandwidth votes); per DSI command dsi_ctrl_transfer_prepare (dsi_ctrl.c:3560-3605: all DSI
+ * clocks on, command engine on); after IDLE_POWERCOLLAPSE_DURATION (66 - 8 = 58 ms,
+ * sde_encoder.h:55) without a commit _sde_encoder_rc_idle (sde_encoder.c:2207-2262): IRQs off,
+ * DSI clocks off, pm_runtime_put (MDSS GDSC), bandwidth released (sde_core_perf.c:786).
+ * Android has no auto-refresh in normal use: no commit = no transfer, the panel shows its RAM.
+ *
+ * Registers read by negronifb_pwrprobe=1 (read-only, mapped and unmapped again):
+ *   DISP_CC 0x0af00000 (live.dts clock-controller@af00000; offsets Linux dispcc-sm8450.c):
+ *   GDSC mdss 0x9000 (live.dts gdsc@af09000), mdss_int2 0xb000 (gdsc@af0b000): bit 31 PWR_ON,
+ *   bit 1 HW_CONTROL, bit 0 SW_COLLAPSE. Branch CBCRs (bit 31 CLK_OFF, bit 0 CLK_ENABLE):
+ *   the MDP clock list of live.dts mdss_mdp (gcc_iface/gcc_bus/gcc_nrt_bus, iface = ahb 0x80a4,
+ *   branch = mdp 0x800c, core = mdp_clk_src, vsync 0x8024, lut 0x801c, rot 0x8014), the DSI0
+ *   list of live.dts dsi_ctrl0 (byte0 0x8028, byte0_intf 0x802c, pclk0 0x8004, esc0 0x8038),
+ *   plus non_gdsc_ahb 0xc004, rscc_ahb 0xc00c, rscc_vsync 0xc008, mdp1 0xa004, ahb1 0xa020.
+ *   RCGs (CMD_RCGR bit 31 ROOT_OFF; CFG_RCGR = CMD + 4: [10:8] source, [4:0] 2 x divider - 1):
+ *   mdp 0x80ec, byte0 0x8134, pclk0 0x80bc, esc0 0x816c, vsync 0x811c.
+ *   GCC 0x00100000 (Linux gcc-sm8450.c / out op-kernel gcc-waipio.c): disp_ahb 0x37004,
+ *   disp_hf_axi 0x3700c, disp_sf_axi 0x37014, disp_xo 0x3701c.
+ *   The bandwidth votes (RPMh BCMs MM0/SH0 via the interconnects of live.dts mdss_mdp) are not
+ *   readable from here [I: XBL's display driver votes them and leaves them].
+ *
+ * negronifb_idle=2 (default 0): Android's no-transfer idle. After negronifb_idle_ms (default 58)
+ * without a swap, the auto-refresh goes off with Android's sequence 1
+ * (_sde_encoder_autorefresh_disable_seq1, sde_encoder_phys_cmd.c:2015-2046: TE disconnected
+ * (SYNC_CONFIG_VSYNC bit 20), AUTOREFRESH_CONFIG bit 31 cleared, poll until no transfer runs
+ * (_sde_encoder_phys_cmd_is_ongoing_pptx :798-830: INTF_TEAR_LINE_COUNT between 1 and vdisplay
+ * - 1), TE connected). From then on every new frame is sent once: at the tick after the frame
+ * is in the panel memory (and its GPU copy done) the CTL of INTF_1 gets CTL_START
+ * (sde_encoder_phys_cmd_trigger_start :2161-2182, sde_hw_ctl.c:327-334, CTL + 0x1c); the
+ * hardware starts the transfer at the next TE (tearcheck). The next kick waits until that
+ * transfer is over (the "pp_done" of Android, here: one TE passed, more than 200 lines past it,
+ * no transfer running; at most 50 ms). With no new frame nothing goes over the link and the DPU
+ * fetches nothing: the panel self-refreshes from its RAM. The display going off turns the
+ * auto-refresh back on (the 0275 black frame and the 0258 sleep need no kick); after the wake
+ * the idle delay starts again. Refused with negronifb_vrr=1 or 3 (they own AUTOREFRESH_CONFIG),
+ * with negronifb_dbuf (0269) or negronifb_zerocopy (0234) (their flips are taken by the next
+ * auto-refresh frame) and without the 0234 DPU mapping. 0268's wake pauses and resumes the
+ * auto-refresh itself; the display is in the auto-refresh state then (display off restored it). No clock is gated: see the probe lines and
+ * README-gpu-kernel.md section 26 for what may be dropped in this state.
+ */
+#define NDPU_DISPCC_PA                  0x0af00000ul
+#define NDPU_DISPCC_LEN                 0x10000ul
+#define NDPU_GCC_DISP_PA                0x00134000ul    /* 16 KiB page with GCC 0x137004..0x13701c */
+#define NDPU_GCC_DISP_LEN               0x4000ul
+#define NDPU_CTL_START                  0x01c
+#define NDPU_INTF_FRAME_COUNT           0x0ac   /* sde_hw_intf.c get_vsync_info: frames the INTF sent */
+#define NDPU_SYNC_TE_PIN                (1u << 20)
+#define NDPU_AR_ENABLE                  (1u << 31)
+#define NDPU_VDISPLAY                   2412u
+#define NDPU_KICK_TIMEOUT_MS            50
+#define NDPU_PPTX_POLL_US               200
+#define NDPU_PPTX_TIMEOUT_US            20000
+
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, unsigned int flags);
+
+enum { kNdpuAuto = 0, kNdpuKick };
+static uint32_t ndpu_idle_mode, ndpu_idle_state, ndpu_kicked_id, ndpu_kick_frame, ndpu_ar_saved;
+static bool ndpu_inflight, ndpu_fc_works;
+static uint32_t ndpu_kick_fc, ndpu_dead_kicks;
+static uint64_t ndpu_idle_abs, ndpu_kick_abs, ndpu_kick_timeout_abs, ndpu_idle_sec_t0;
+static uint32_t ndpu_kicks, ndpu_kick_busy, ndpu_kick_timeouts, ndpu_entries, ndpu_wakes;
+static uint64_t ndpu_kick_total;
+
+static void
+ndpu_power_probe(void)
+{
+	static const struct { const char *name; uint32_t off; } br[] = {
+		{ "ahb", 0x80a4 }, { "mdp", 0x800c }, { "vsync", 0x8024 }, { "lut", 0x801c }, { "rot", 0x8014 },
+		{ "byte0", 0x8028 }, { "byte0_intf", 0x802c }, { "pclk0", 0x8004 }, { "esc0", 0x8038 },
+		{ "non_gdsc_ahb", 0xc004 }, { "rscc_ahb", 0xc00c }, { "rscc_vsync", 0xc008 }, { "mdp1", 0xa004 },
+		{ "ahb1", 0xa020 }, { "byte1", 0x8030 }, { "pclk1", 0x8008 }, { "esc1", 0x803c },
+	};
+	static const struct { const char *name; uint32_t off; } rcg[] = {
+		{ "mdp", 0x80ec }, { "byte0", 0x8134 }, { "pclk0", 0x80bc }, { "esc0", 0x816c }, { "vsync", 0x811c },
+	};
+	static const struct { const char *name; uint32_t off; } gcc[] = {
+		{ "disp_ahb", 0x37004 }, { "disp_hf_axi", 0x3700c }, { "disp_sf_axi", 0x37014 }, { "disp_xo", 0x3701c },
+	};
+	char line[640];
+	int n;
+	vm_offset_t cc = ml_io_map_unmappable(NDPU_DISPCC_PA, NDPU_DISPCC_LEN, 0x7);
+	if (cc == 0) {
+		printf("NEGRONI DPU PWR: DISP_CC not mapped\n");
+		return;
+	}
+	uint32_t g0 = ndpu_rd(cc + 0x9000), g1 = ndpu_rd(cc + 0xb000);
+	printf("NEGRONI DPU PWR: GDSC mdss 0x%08x (%s, hw_ctrl %u, sw_collapse %u) mdss_int2 0x%08x (%s, hw_ctrl %u, sw_collapse %u)\n",
+	    g0, (g0 >> 31) ? "on" : "OFF", (g0 >> 1) & 1u, g0 & 1u, g1, (g1 >> 31) ? "on" : "OFF", (g1 >> 1) & 1u, g1 & 1u);
+	n = snprintf(line, sizeof(line), "NEGRONI DPU PWR: DISP_CC branches");
+	for (uint32_t i = 0; i < sizeof(br) / sizeof(br[0]) && n < (int)sizeof(line); i++) {
+		uint32_t v = ndpu_rd(cc + br[i].off);
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %s 0x%08x %s", br[i].name, v, (v >> 31) ? "off" : "ON");
+	}
+	printf("%s\n", line);
+	n = snprintf(line, sizeof(line), "NEGRONI DPU PWR: DISP_CC RCGs (cmd/cfg)");
+	for (uint32_t i = 0; i < sizeof(rcg) / sizeof(rcg[0]) && n < (int)sizeof(line); i++) {
+		uint32_t c = ndpu_rd(cc + rcg[i].off), f = ndpu_rd(cc + rcg[i].off + 4);
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %s 0x%08x/0x%08x (%s src %u div %u.%u)", rcg[i].name, c, f,
+		    (c >> 31) ? "root off" : "on", (f >> 8) & 7u, ((f & 0x1fu) + 1) / 2, ((f & 0x1fu) + 1) % 2 ? 5 : 0);
+	}
+	printf("%s\n", line);
+	ml_io_unmap(cc, NDPU_DISPCC_LEN);
+	vm_offset_t g = ml_io_map_unmappable(NDPU_GCC_DISP_PA, NDPU_GCC_DISP_LEN, 0x7);
+	if (g != 0) {
+		n = snprintf(line, sizeof(line), "NEGRONI DPU PWR: GCC");
+		for (uint32_t i = 0; i < sizeof(gcc) / sizeof(gcc[0]); i++) {
+			uint32_t v = ndpu_rd(g + gcc[i].off - (NDPU_GCC_DISP_PA - 0x100000ul));
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " %s 0x%08x %s", gcc[i].name, v, (v >> 31) ? "off" : "ON");
+		}
+		printf("%s\n", line);
+		ml_io_unmap(g, NDPU_GCC_DISP_LEN);
+	}
+	volatile uint32_t *dsi = negroni_dsi_base();
+	if (dsi != NULL) {
+		printf("NEGRONI DPU PWR: DSI0 ctrl 0x%08x status 0x%08x clk_ctrl 0x%08x clk_status 0x%08x lane_status 0x%08x "
+		    "lane_ctrl 0x%08x int_ctrl 0x%08x\n", dsi[0x004 / 4], dsi[0x008 / 4], dsi[0x11c / 4], dsi[0x120 / 4],
+		    dsi[0x0a8 / 4], dsi[0x0ac / 4], dsi[0x110 / 4]);
+	}
+	if (ndpu_mdss != 0) {
+		printf("NEGRONI DPU PWR: INTF_1 autorefresh 0x%08x sync_cfg 0x%08x, CTL 0x%x flush 0x%08x\n",
+		    ndpu_rd(ndpu_mdss + NDPU_INTF1 + NDPU_INTF_TEAR_AUTOREFRESH),
+		    ndpu_rd(ndpu_mdss + NDPU_INTF1 + NDPU_INTF_TEAR_SYNC_CONFIG_VSYNC), ndpu_ctl,
+		    ndpu_ctl != 0 ? ndpu_rd(ndpu_mdss + ndpu_ctl + 0x18) : 0);
+	}
+}
+
+static bool
+ndpu_pptx_ongoing(uintptr_t intf)
+{
+	uint32_t wr = ndpu_rd(intf + NDPU_INTF_TEAR_LINE_COUNT) & 0xffffu;
+	return wr > 0 && wr < NDPU_VDISPLAY;
+}
+
+static void
+ndpu_idle_init(void)
+{
+	uint32_t mode = 0, ms = 58, probe = 0, vrr = 0, dbuf = 0, zc = 0;
+
+	PE_parse_boot_argn("negronifb_idle", &mode, sizeof(mode));
+	PE_parse_boot_argn("negronifb_idle_ms", &ms, sizeof(ms));
+	PE_parse_boot_argn("negronifb_pwrprobe", &probe, sizeof(probe));
+	PE_parse_boot_argn("negronifb_vrr", &vrr, sizeof(vrr));
+	PE_parse_boot_argn("negronifb_dbuf", &dbuf, sizeof(dbuf));
+	PE_parse_boot_argn("negronifb_zerocopy", &zc, sizeof(zc));
+	if (probe != 0 || mode != 0) {
+		ndpu_power_probe();
+	}
+	if (mode == 0) {
+		return;
+	}
+	if (mode != 2) {
+		printf("NEGRONI DPU IDLE: negronifb_idle=%u unknown (2 = no-transfer idle): off\n", mode);
+		return;
+	}
+	if (ndpu_mdss == 0 || ndpu_ctl == 0) {
+		printf("NEGRONI DPU IDLE: no DPU mapping or CTL (0234 probe off): off\n");
+		return;
+	}
+	if (vrr == 1 || vrr == 3) {
+		printf("NEGRONI DPU IDLE: negronifb_vrr=%u owns the auto-refresh: off\n", vrr);
+		return;
+	}
+	if (dbuf != 0 || zc != 0) {
+		/* 0269 / 0234 flips wait for an auto-refresh frame to take their CTL_FLUSH */
+		printf("NEGRONI DPU IDLE: negronifb_dbuf=%u / negronifb_zerocopy=%u flip under the auto-refresh: off\n", dbuf, zc);
+		return;
+	}
+	uint32_t ar = ndpu_rd(ndpu_mdss + NDPU_INTF1 + NDPU_INTF_TEAR_AUTOREFRESH);
+	if (!(ar & NDPU_AR_ENABLE)) {
+		printf("NEGRONI DPU IDLE: auto-refresh 0x%08x is off already (not the UEFI state): off\n", ar);
+		return;
+	}
+	ndpu_ar_saved = ar;
+	/* does the INTF frame counter count the auto-refresh frames? then it proves each kick sent one */
+	uint32_t fc0 = ndpu_rd(ndpu_mdss + NDPU_INTF1 + NDPU_INTF_FRAME_COUNT);
+	delay(30000);
+	uint32_t fc1 = ndpu_rd(ndpu_mdss + NDPU_INTF1 + NDPU_INTF_FRAME_COUNT);
+	ndpu_fc_works = fc1 != fc0;
+	ms = ms < 20 ? 20 : ms;
+	nanoseconds_to_absolutetime((uint64_t)ms * NSEC_PER_MSEC, &ndpu_idle_abs);
+	nanoseconds_to_absolutetime((uint64_t)NDPU_KICK_TIMEOUT_MS * NSEC_PER_MSEC, &ndpu_kick_timeout_abs);
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &ndpu_sec_abs);
+	ndpu_idle_mode = 2;
+	printf("NEGRONI DPU IDLE: mode 2: after %u ms without a swap the auto-refresh (0x%08x) goes off and each new frame "
+	    "gets one CTL_START (CTL 0x%x); display off = auto-refresh on; INTF frame count %u -> %u in 30 ms (%s)\n", ms, ar,
+	    ndpu_ctl, fc0, fc1, ndpu_fc_works ? "kicks are checked" : "no kick check");
+}
+
+/* Android's _sde_encoder_autorefresh_disable_seq1. */
+static void
+ndpu_idle_enter(uint32_t presentedID)
+{
+	uintptr_t intf = ndpu_mdss + NDPU_INTF1;
+	uint32_t cfg = ndpu_rd(intf + NDPU_INTF_TEAR_SYNC_CONFIG_VSYNC);
+	uint32_t ar = ndpu_rd(intf + NDPU_INTF_TEAR_AUTOREFRESH), us = 0;
+
+	ndpu_wr(intf + NDPU_INTF_TEAR_SYNC_CONFIG_VSYNC, cfg & ~NDPU_SYNC_TE_PIN);
+	ndpu_wr(intf + NDPU_INTF_TEAR_AUTOREFRESH, ar & ~NDPU_AR_ENABLE);
+	__builtin_arm_dsb(0xf);
+	do {
+		delay(NDPU_PPTX_POLL_US);
+		us += NDPU_PPTX_POLL_US;
+	} while (ndpu_pptx_ongoing(intf) && us < NDPU_PPTX_TIMEOUT_US);
+	ndpu_wr(intf + NDPU_INTF_TEAR_SYNC_CONFIG_VSYNC, cfg);
+	__builtin_arm_dsb(0xf);
+	ndpu_idle_state = kNdpuKick;
+	ndpu_kicked_id = presentedID;   /* the auto-refresh has sent it */
+	ndpu_inflight = false;
+	ndpu_entries++;
+	if (ndpu_entries <= 4 || us >= NDPU_PPTX_TIMEOUT_US) {
+		printf("NEGRONI DPU IDLE: auto-refresh off (0x%08x -> 0x%08x), transfer over after %u us%s (entry %u)\n", ar,
+		    ndpu_rd(intf + NDPU_INTF_TEAR_AUTOREFRESH), us, us >= NDPU_PPTX_TIMEOUT_US ? " (TIMEOUT)" : "", ndpu_entries);
+	}
+}
+
+static void
+ndpu_idle_tick(uint64_t now, uint64_t lastSwapAbs, uint32_t presentedID, bool frameDone, bool powerOff)
+{
+	uintptr_t intf = ndpu_mdss + NDPU_INTF1;
+
+	if (ndpu_idle_mode != 2) {
+		return;
+	}
+	if (powerOff) {
+		if (ndpu_idle_state == kNdpuKick) {
+			ndpu_wr(intf + NDPU_INTF_TEAR_AUTOREFRESH, ndpu_ar_saved);
+			__builtin_arm_dsb(0xf);
+			ndpu_idle_state = kNdpuAuto;
+			ndpu_wakes++;
+			if (ndpu_wakes <= 4) {
+				printf("NEGRONI DPU IDLE: display off: auto-refresh on again (0x%08x)\n", ndpu_ar_saved);
+			}
+		}
+		return;
+	}
+	if (ndpu_idle_state == kNdpuAuto) {
+		if (lastSwapAbs != 0 && now > lastSwapAbs && now - lastSwapAbs >= ndpu_idle_abs) {
+			ndpu_idle_enter(presentedID);
+		}
+		return;
+	}
+	if (ndpu_rd(intf + NDPU_INTF_TEAR_AUTOREFRESH) & NDPU_AR_ENABLE) {
+		/* someone turned the auto-refresh on again (0268's re-init wake): back to that state */
+		ndpu_idle_state = kNdpuAuto;
+		ndpu_inflight = false;
+		return;
+	}
+	uint32_t v = ndpu_rd(intf + NDPU_INTF_TEAR_INT_COUNT_VAL);
+	uint32_t frame = v >> 16, line = v & 0xffffu;
+	if (ndpu_inflight) {
+		bool teSince = frame != ndpu_kick_frame;
+		bool past = line >= ndpu_te_init + 200 || (ndpu_te_init == 0 && line > 200);
+		bool over = teSince && past && !ndpu_pptx_ongoing(intf);
+		if (over || now - ndpu_kick_abs > ndpu_kick_timeout_abs) {
+			ndpu_inflight = false;
+			ndpu_kick_timeouts += !over;
+			if (ndpu_fc_works && ndpu_rd(intf + NDPU_INTF_FRAME_COUNT) == ndpu_kick_fc) {
+				if (++ndpu_dead_kicks >= 3) {
+					/* CTL_START sent nothing three times: the screen would freeze; back to the UEFI state */
+					ndpu_wr(intf + NDPU_INTF_TEAR_AUTOREFRESH, ndpu_ar_saved);
+					__builtin_arm_dsb(0xf);
+					ndpu_idle_state = kNdpuAuto;
+					ndpu_idle_mode = 0;
+					printf("NEGRONI DPU IDLE: 3 kicks sent no frame (INTF frame count %u): auto-refresh on, idle mode off\n",
+					    ndpu_kick_fc);
+					return;
+				}
+			} else {
+				ndpu_dead_kicks = 0;
+			}
+		} else {
+			if (presentedID != ndpu_kicked_id) {
+				ndpu_kick_busy++;       /* a new frame waits for the transfer of the one before */
+			}
+			return;
+		}
+	}
+	if (presentedID != ndpu_kicked_id && frameDone) {
+		ndpu_kick_fc = ndpu_rd(intf + NDPU_INTF_FRAME_COUNT);
+		ndpu_wr(ndpu_mdss + ndpu_ctl + NDPU_CTL_START, 1);
+		__builtin_arm_dsb(0xf);
+		ndpu_kicked_id = presentedID;
+		ndpu_kick_frame = frame;
+		ndpu_kick_abs = now;
+		ndpu_inflight = true;
+		ndpu_kicks++;
+		ndpu_kick_total++;
+	}
+}
+
+static void
+ndpu_idle_log(uint64_t now)
+{
+	if (ndpu_idle_mode != 2) {
+		return;
+	}
+	if (ndpu_idle_sec_t0 == 0) {
+		ndpu_idle_sec_t0 = now;
+		return;
+	}
+	if (now - ndpu_idle_sec_t0 < ndpu_sec_abs) {
+		return;
+	}
+	ndpu_idle_sec_t0 = now;
+	printf("NEGRONI DPU IDLE: %s, kicks/s %u (busy %u, timeouts %u), %llu kicks, %u idle entries, auto-refresh 0x%08x\n",
+	    ndpu_idle_state == kNdpuKick ? "no auto-refresh (kick per frame)" : "auto-refresh", ndpu_kicks, ndpu_kick_busy,
+	    ndpu_kick_timeouts, ndpu_kick_total, ndpu_entries, ndpu_rd(ndpu_mdss + NDPU_INTF1 + NDPU_INTF_TEAR_AUTOREFRESH));
+	ndpu_kicks = ndpu_kick_busy = ndpu_kick_timeouts = 0;
+}
+
+/* NegroniFramebuffer.cpp AppleCLCD::start: mdss = 0234's MDSS mapping (0: none), ctlOff = its CTL. */
+void
+negroni_dpu_start(uintptr_t mdss, uint32_t ctlOff)
+{
+	ndpu_mdss = mdss;
+	ndpu_ctl = ctlOff;
+	if (ndpu_te_init == 0 && mdss != 0) {
+		ndpu_te_init = ndpu_rd(mdss + NDPU_INTF1 + NDPU_INTF_TEAR_VSYNC_INIT_VAL) & 0xffffu;
+	}
+	ndpu_teirq_init();
+	ndpu_idle_init();
+}
+
+/*
+ * NegroniFramebuffer.cpp vsyncFired, each tick, before the frame is taken (no fLock).
+ * lastSwapAbs: the last SwapEnd; presentedID: the last swap id written to the panel memory;
+ * frameDone: that frame's GPU copy is done; powerOff: RequestPowerChange(0).
+ */
+void
+negroni_dpu_tick(uint64_t now, uint64_t lastSwapAbs, uint32_t presentedID, bool frameDone, bool powerOff)
+{
+	ndpu_teirq_tick(now);
+	ndpu_idle_tick(now, lastSwapAbs, presentedID, frameDone, powerOff);
+	ndpu_idle_log(now);
+}
diff --git a/bsd/dev/negroni_dsi.c b/bsd/dev/negroni_dsi.c
new file mode 100644
index 0000000..e341a30
--- /dev/null
+++ b/bsd/dev/negroni_dsi.c
@@ -0,0 +1,797 @@
+/*
+ * DSI0 command path of the NEGRONI panel (OnePlus 10 Pro, Samsung AMB670YF08 / S6E3HC3, DSI
+ * command mode), done the way Android's display driver does it (0292).
+ *
+ * Android (out/src/op-modules/vendor/qcom/opensource/display-drivers):
+ *   dsi_display.c:820-858  dsi_display_set_cmd_tx_ctrl_flags: default DSI_CTRL_CMD_FETCH_MEMORY;
+ *                          a packet without MIPI_DSI_MSG_BATCH_COMMAND (DT flags byte 0x40) gets
+ *                          DSI_CTRL_CMD_LAST_COMMAND; FIFO only in secure mode.
+ *   dsi_display.c:598-694  the command buffer: one 4 KiB MSM_BO_UNCACHED buffer (SZ_4K).
+ *   dsi_ctrl.c:1615-1752   dsi_message_tx: each packet is copied and padded into the buffer
+ *                          (dsi_ctrl_copy_and_pad_cmd :1245-1290: header bytes {data0, data1,
+ *                          DI, flags}, flags bit 7 last, bit 6 long, bit 5 BTA for reads, payload
+ *                          padded to 4 bytes with 0xff); without LAST the function returns and the
+ *                          next packet is appended; with LAST the whole buffer goes out in one DMA.
+ *   dsi_ctrl.c:1475-1578   dsi_kickoff_msg_tx, dsi_ctrl_hw_cmn.c:870-918 kickoff_command:
+ *                          COMMAND_MODE_DMA_CTRL (31 broadcast, 30 master cleared, 26 low power,
+ *                          28 embedded, 24 and 29 cleared), DMA_FIFO_CTRL |= bit 20 | bit 16,
+ *                          DMA_CMD_OFFSET = buffer IOVA, DMA_CMD_LENGTH, SW trigger; completion =
+ *                          CMD_DMA_DONE (INT_CTRL bit 0, dsi_ctrl.c:390 wait, 200 ms); then
+ *                          reset_cmd_fifo (dsi_ctrl_hw_cmn.c:990-997).
+ * Android does not wait for the MDP stream before a command (only dsi_display.c:8959, the
+ * dynamic-clock path); the controller queues the DMA behind the stream. 0250 waits for the MDP
+ * stream before every packet; this path waits once per set.
+ *
+ * negronifb_dsidma (boot-arg, default 0):
+ *   0  everything as 0250/0259 (one FIFO DMA per packet, MDP wait per packet).
+ *   1  negroni_dsi_dcs_set (the device-tree sets of 0259 and later) goes through the memory DMA:
+ *      the packets up to the next one without the batch flag (or with a wait) in one DMA.
+ *   2  1, and single DCS writes (brightness, sleep) too.
+ * The buffer: 0268's command buffer (the last 16 KiB of the UEFI splash region, 0xbaafc000,
+ * write-combined = Normal non-cacheable like MSM_BO_UNCACHED; the DSI DMA reads it by physical
+ * address through the display SMMU context like the pipes' fetch of the panel memory); the first
+ * 4 KiB are used (Android's SZ_4K). It is shared with 0268's long packets under the DSI lock.
+ * A DMA that does not finish turns the memory DMA off for the boot (this path and 0268's long
+ * packets) and the rest of the set goes through 0250/0268's per-packet path ("memory DMA off").
+ * The whole set runs inside 0268's set lock (negroni_dsi_dcs_set_ex), so sets never interleave.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <stdbool.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include <arm/caches_internal.h>
+#include <libkern/libkern.h>
+
+/* NegroniBacklight.cpp (0250 + 0292 accessors) */
+extern volatile uint32_t *negroni_dsi_base(void);
+extern bool negroni_dsi_enter(void);
+extern void negroni_dsi_leave(void);
+extern bool negroni_dsi_in_panic(void);
+extern volatile uint8_t *negroni_dsi_cmdbuf(uint64_t *pa);      /* 0268's buffer, NULL: none or failed */
+extern void negroni_dsi_cmdbuf_failed(void);
+extern void IOSleep(unsigned int milliseconds);
+
+#define NEGRONI_DSI_DMA_NOT_USED        (-100)  /* the caller uses the FIFO path */
+
+int negroni_dsi_dma_mode(void);
+bool negroni_dsi_dma_ready(void);
+int negroni_dsi_dma_kick_locked(uint32_t len, bool lp, bool mdpWait);
+bool negroni_dsi_dma_append_locked(uint32_t *pos, uint8_t type, const uint8_t *payload, uint32_t plen, bool last, bool bta);
+int negroni_dsi_dma_set(const uint8_t *set, uint32_t len, bool lp, uint32_t *sent, uint32_t *resume);
+int negroni_dsi_dma_write(const uint8_t *buf, uint32_t len, bool lp);
+
+/* DSI 2.x registers: display-drivers msm/dsi/dsi_ctrl_reg.h */
+#define NDSI_STATUS                     0x008   /* bit 1 CMD_DMA_BUSY, bit 2 CMD_MDP_BUSY */
+#define NDSI_CMD_DMA_CTRL               0x03c
+#define NDSI_DMA_CMD_OFFSET             0x048
+#define NDSI_DMA_CMD_LENGTH             0x04c
+#define NDSI_DMA_FIFO_CTRL              0x050
+#define NDSI_ACK_ERR_STATUS             0x068
+#define NDSI_TRIG_CTRL                  0x084
+#define NDSI_CMD_DMA_SW_TRIGGER         0x090
+#define NDSI_INT_CTRL                   0x110
+#define NDSI_TPG_CTRL                   0x15c
+#define NDSI_TPG_DMA_FIFO_RESET         0x1ec
+
+#define NDSI_STATUS_DMA_BUSY            (1u << 1)
+#define NDSI_STATUS_MDP_BUSY            (1u << 2)
+#define NDSI_INT_DMA_DONE               (1u << 0)
+#define NDSI_INT_ENABLE_BITS            0xaaaaaaaau
+#define NDSI_DMA_TRIGGER_SW             4u
+#define NDSI_BUF_MAX                    4096u   /* Android's SZ_4K command buffer */
+#define NDSI_DMA_DONE_US                50000u  /* Android: 200 ms (DSI_CTRL_TX_TO_MS) */
+
+static int ndsi_dma_mode = -1;          /* negronifb_dsidma */
+static bool ndsi_dma_off;               /* a DMA failed: FIFO for the rest of the boot */
+static volatile uint8_t *ndsi_buf;      /* 0268's command buffer (write-combined) */
+static uint64_t ndsi_buf_pa;
+static bool ndsi_buf_logged;
+static uint32_t ndsi_sets_logged, ndsi_mdp_waits_logged;
+uint64_t negroni_dsi_dma_kicks, negroni_dsi_dma_packets, negroni_dsi_dma_sets;      /* stats (0296 log) */
+
+static inline uint32_t
+ndsi_rd(volatile uint32_t *d, uint32_t off)
+{
+	return d[off / 4];
+}
+
+static inline void
+ndsi_wr(volatile uint32_t *d, uint32_t off, uint32_t v)
+{
+	d[off / 4] = v;
+}
+
+int
+negroni_dsi_dma_mode(void)
+{
+	if (ndsi_dma_mode < 0) {
+		uint32_t m = 0;
+		PE_parse_boot_argn("negronifb_dsidma", &m, sizeof(m));
+		ndsi_dma_mode = m > 2 ? 2 : (int)m;
+	}
+	return ndsi_dma_mode;
+}
+
+/* The command buffer (0268, NegroniBacklight.cpp); false when it is missing or failed. */
+static bool
+ndsi_buf_init(void)
+{
+	ndsi_buf = negroni_dsi_cmdbuf(&ndsi_buf_pa);
+	if (ndsi_buf == NULL || ndsi_buf_pa + NDSI_BUF_MAX > 0x100000000ull) {
+		ndsi_buf = NULL;
+		return false;
+	}
+	if (!ndsi_buf_logged) {
+		ndsi_buf_logged = true;
+		printf("NEGRONI DSI: memory DMA (negronifb_dsidma=%d): command sets from 0x%llx (0268's buffer), up to %u bytes per DMA\n",
+		    negroni_dsi_dma_mode(), ndsi_buf_pa, NDSI_BUF_MAX);
+	}
+	return true;
+}
+
+static bool
+ndsi_dma_usable(void)
+{
+	return negroni_dsi_dma_mode() != 0 && !ndsi_dma_off && !negroni_dsi_in_panic() &&
+	       negroni_dsi_base() != NULL && ndsi_buf_init();
+}
+
+/* The DMA path is on and usable (0293 uses it for reads). */
+bool
+negroni_dsi_dma_ready(void)
+{
+	return ndsi_dma_usable();
+}
+
+/*
+ * Lock held. Send len bytes of the command buffer (one or more packets, the last one with the
+ * last bit) in one memory DMA. mdpWait: wait up to 20 ms for the MDP stream first (once per set).
+ * 0 = CMD_DMA_DONE, -2 = an older DMA never finished (nothing touched), -3 = no CMD_DMA_DONE.
+ */
+int
+negroni_dsi_dma_kick_locked(uint32_t len, bool lp, bool mdpWait)
+{
+	volatile uint32_t *d = negroni_dsi_base();
+	uint32_t i;
+
+	for (i = 0; i < 250 && (ndsi_rd(d, NDSI_STATUS) & NDSI_STATUS_DMA_BUSY); i++) {
+		delay(20);
+	}
+	if (ndsi_rd(d, NDSI_STATUS) & NDSI_STATUS_DMA_BUSY) {
+		return -2;
+	}
+	if (mdpWait) {
+		for (i = 0; i < 1000 && (ndsi_rd(d, NDSI_STATUS) & NDSI_STATUS_MDP_BUSY); i++) {
+			delay(20);
+		}
+		if (i == 1000 && ndsi_mdp_waits_logged++ < 4) {
+			printf("NEGRONI DSI: MDP stream busy for 20 ms; sending the set anyway\n");
+		}
+	}
+	uint32_t tpg = ndsi_rd(d, NDSI_TPG_CTRL);
+	uint32_t dma = ndsi_rd(d, NDSI_CMD_DMA_CTRL);
+	uint32_t trig = ndsi_rd(d, NDSI_TRIG_CTRL);
+	uint32_t fifo = ndsi_rd(d, NDSI_DMA_FIFO_CTRL);
+	if ((trig & 0xfu) != NDSI_DMA_TRIGGER_SW) {
+		ndsi_wr(d, NDSI_TRIG_CTRL, (trig & ~0xfu) | NDSI_DMA_TRIGGER_SW);
+	}
+	if (tpg != 0) {
+		ndsi_wr(d, NDSI_TPG_CTRL, 0);   /* no TPG FIFO: the DMA reads memory */
+	}
+	ndsi_wr(d, NDSI_INT_CTRL, (ndsi_rd(d, NDSI_INT_CTRL) & NDSI_INT_ENABLE_BITS) | NDSI_INT_DMA_DONE);
+	/* kickoff_command: broadcast/master off, LPM, embedded mode, packet type and WC_SEL 0 */
+	uint32_t nd = dma & ~(1u << 31 | 1u << 30 | 1u << 29 | 1u << 26 | 1u << 24);
+	nd |= 1u << 28 | (lp ? 1u << 26 : 0u);
+	ndsi_wr(d, NDSI_CMD_DMA_CTRL, nd);
+	ndsi_wr(d, NDSI_DMA_FIFO_CTRL, fifo | 1u << 20 | 1u << 16);
+	ndsi_wr(d, NDSI_DMA_CMD_OFFSET, (uint32_t)ndsi_buf_pa);
+	ndsi_wr(d, NDSI_DMA_CMD_LENGTH, len & 0xffffffu);
+	__builtin_arm_dsb(0xf);         /* the buffer (non-cacheable) and the registers before the trigger */
+	ndsi_wr(d, NDSI_CMD_DMA_SW_TRIGGER, 1);
+	__builtin_arm_dsb(0xf);
+	bool done = false;
+	for (i = 0; i < NDSI_DMA_DONE_US / 10 && !done; i++) {
+		done = (ndsi_rd(d, NDSI_INT_CTRL) & NDSI_INT_DMA_DONE) != 0;
+		if (!done) {
+			delay(10);
+		}
+	}
+	ndsi_wr(d, NDSI_INT_CTRL, (ndsi_rd(d, NDSI_INT_CTRL) & NDSI_INT_ENABLE_BITS) | NDSI_INT_DMA_DONE);
+	/* reset_cmd_fifo (Android does it after every command), then the registers as found */
+	ndsi_wr(d, NDSI_TPG_CTRL, 0);
+	ndsi_wr(d, NDSI_TPG_DMA_FIFO_RESET, 1);
+	__builtin_arm_dsb(0xf);
+	delay(1);
+	ndsi_wr(d, NDSI_TPG_DMA_FIFO_RESET, 0);
+	ndsi_wr(d, NDSI_TPG_CTRL, tpg);
+	ndsi_wr(d, NDSI_CMD_DMA_CTRL, dma);
+	ndsi_wr(d, NDSI_DMA_FIFO_CTRL, fifo);
+	if ((trig & 0xfu) != NDSI_DMA_TRIGGER_SW) {
+		ndsi_wr(d, NDSI_TRIG_CTRL, trig);
+	}
+	__builtin_arm_dsb(0xf);
+	negroni_dsi_dma_kicks++;
+	return done ? 0 : -3;
+}
+
+/* Lock held. Append one packet (DT header fields) at *pos; false if it does not fit. */
+bool
+negroni_dsi_dma_append_locked(uint32_t *pos, uint8_t type, const uint8_t *payload, uint32_t plen, bool last, bool bta)
+{
+	uint32_t p = *pos;
+	bool lng = !(type == 0x05 || type == 0x15 || type == 0x03 || type == 0x13 || type == 0x23 ||
+	    type == 0x06 || type == 0x04 || type == 0x14 || type == 0x24 || type == 0x37);
+	uint32_t size = lng ? 4 + ((plen + 3) & ~3u) : 4;
+	if ((!lng && plen > 2) || plen > 0xffff || p + size > NDSI_BUF_MAX) {
+		return false;
+	}
+	/* dsi_ctrl_copy_and_pad_cmd: {data0 or WC lo, data1 or WC hi, DI, flags} */
+	ndsi_buf[p + 0] = lng ? (uint8_t)plen : (plen > 0 ? payload[0] : 0);
+	ndsi_buf[p + 1] = lng ? (uint8_t)(plen >> 8) : (plen > 1 ? payload[1] : 0);
+	ndsi_buf[p + 2] = type & 0x3f;  /* virtual channel 0 */
+	ndsi_buf[p + 3] = (uint8_t)((last ? 0x80 : 0) | (lng ? 0x40 : 0) | (bta ? 0x20 : 0));
+	if (lng) {
+		for (uint32_t i = 0; i < size - 4; i++) {
+			ndsi_buf[p + 4 + i] = i < plen ? payload[i] : 0xff;
+		}
+	}
+	*pos = p + size;
+	return true;
+}
+
+static bool
+ndsi_type_ok(uint8_t type)
+{
+	/* writes only: DCS short/long, generic short/long; reads go through 0293 */
+	return type == 0x05 || type == 0x15 || type == 0x39 || type == 0x03 || type == 0x13 || type == 0x23 ||
+	       type == 0x29 || type == 0x0a;
+}
+
+/*
+ * 0292: a command set in the device-tree format (7-byte header {type, last, vc, flags, wait ms,
+ * len hi, len lo}, payload) as Android sends it. NEGRONI_DSI_DMA_NOT_USED: the caller sends the
+ * packets from byte offset *resume on itself (0268's per-packet path; *sent packets went out
+ * before). Thread context only, inside 0268's set lock.
+ */
+static int
+ndsi_set(const uint8_t *set, uint32_t len, bool lp, uint32_t *sent, uint32_t *resume, bool log)
+{
+	uint32_t i, n = 0;
+
+	*sent = 0;
+	*resume = 0;
+
+	if (!ndsi_dma_usable()) {
+		return NEGRONI_DSI_DMA_NOT_USED;
+	}
+	for (i = 0; i + 7 <= len;) {
+		uint32_t plen = (uint32_t)set[i + 5] << 8 | set[i + 6];
+		if (!ndsi_type_ok(set[i]) || i + 7 + plen > len || plen + 8 > NDSI_BUF_MAX) {
+			return NEGRONI_DSI_DMA_NOT_USED;       /* the FIFO path reports it */
+		}
+		i += 7 + plen;
+	}
+	if (i != len) {
+		return NEGRONI_DSI_DMA_NOT_USED;
+	}
+	uint64_t t0 = mach_absolute_time();
+	uint32_t kicks = 0, bytes = 0;
+	bool first = true;
+	int rc = 0;
+	i = 0;
+	while (i < len && rc == 0) {
+		uint32_t start = i, pos = 0, inBatch = 0;
+		uint8_t wait = 0;
+		if (!negroni_dsi_enter()) {
+			rc = -1;
+			break;
+		}
+		/* fill: up to a packet without the batch flag (0x40), with a wait, or the buffer's end */
+		for (;;) {
+			uint8_t type = set[i], flags = set[i + 3];
+			uint32_t plen = (uint32_t)set[i + 5] << 8 | set[i + 6];
+			uint32_t next = i + 7 + plen;
+			wait = set[i + 4];
+			bool last = !(flags & 0x40) || wait != 0 || next >= len;
+			if (!last) {
+				/* the next packet must fit too, else this one ends the batch */
+				uint32_t nlen = (uint32_t)set[next + 5] << 8 | set[next + 6];
+				last = pos + 4 + ((plen + 3) & ~3u) + 4 + ((nlen + 3) & ~3u) > NDSI_BUF_MAX;
+			}
+			if (!negroni_dsi_dma_append_locked(&pos, type, set + i + 7, plen, last, false)) {
+				rc = -4;
+				break;
+			}
+			inBatch++;
+			i = next;
+			if (last) {
+				break;
+			}
+		}
+		if (rc == 0) {
+			rc = negroni_dsi_dma_kick_locked(pos, lp, first);
+		}
+		negroni_dsi_leave();
+		first = false;
+		if (rc == 0) {
+			n += inBatch;
+			kicks++;
+			bytes += pos;
+			if (wait != 0) {
+				IOSleep(wait);
+			}
+		} else if (rc == -3) {
+			volatile uint32_t *d = negroni_dsi_base();
+			ndsi_dma_off = true;
+			negroni_dsi_cmdbuf_failed();
+			printf("NEGRONI DSI: memory DMA of %u bytes (%u packets) not done in %u ms: status 0x%08x int 0x%08x "
+			    "ack_err 0x%08x; memory DMA off for this boot, the rest of the set goes packet by packet\n",
+			    pos, inBatch, NDSI_DMA_DONE_US / 1000, ndsi_rd(d, NDSI_STATUS), ndsi_rd(d, NDSI_INT_CTRL),
+			    ndsi_rd(d, NDSI_ACK_ERR_STATUS));
+			*resume = start;
+			*sent = n;
+			negroni_dsi_dma_packets += n;
+			return NEGRONI_DSI_DMA_NOT_USED;
+		}
+	}
+	negroni_dsi_dma_packets += n;
+	negroni_dsi_dma_sets++;
+	*sent = n;
+	if ((log && ndsi_sets_logged < 6) || rc != 0) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		ndsi_sets_logged += log;
+		printf("NEGRONI DSI: set of %u bytes: %u packets in %u memory DMAs (%u bytes), %s, %llu us, rc %d\n",
+		    len, n, kicks, bytes, lp ? "LP" : "HS", ns / 1000, rc);
+	}
+	return rc;
+}
+
+int
+negroni_dsi_dma_set(const uint8_t *set, uint32_t len, bool lp, uint32_t *sent, uint32_t *resume)
+{
+	*sent = 0;
+	*resume = 0;
+	return ndsi_set(set, len, lp, sent, resume, true);
+}
+
+/* 0292, negronifb_dsidma=2: one DCS write (0250 types: 0x05/0x15/0x39 by length) as a one-packet set. */
+int
+negroni_dsi_dma_write(const uint8_t *buf, uint32_t len, bool lp)
+{
+	uint8_t set[7 + 64];
+
+	if (negroni_dsi_dma_mode() < 2 || len == 0 || len > 64 || !ndsi_dma_usable()) {
+		return NEGRONI_DSI_DMA_NOT_USED;
+	}
+	set[0] = len == 1 ? 0x05 : (len == 2 ? 0x15 : 0x39);
+	set[1] = 1;
+	set[2] = 0;
+	set[3] = 0;
+	set[4] = 0;
+	set[5] = 0;
+	set[6] = (uint8_t)len;
+	memcpy(set + 7, buf, len);
+	uint32_t sent = 0, resume = 0;
+	return ndsi_set(set, 7 + len, lp, &sent, &resume, false);   /* failed: NOT_USED, the caller sends it */   /* single writes are not logged (brightness fades) */
+}
+
+/* ---------------------------------------------------------------------- */
+/* 0293: DCS reads, the ESD status check and the panel ID                  */
+/* ---------------------------------------------------------------------- */
+
+/*
+ * Android: dsi_ctrl.c:1754-1777 dsi_set_max_return_size (type 0x37, batched before the read),
+ * :1820-1965 dsi_message_rx (first pass up to 10 bytes, then +14 per pass, CRC removed, the
+ * response type at buff[header_offset]), dsi_ctrl_hw_cmn.c:1037-1043 clear_rdbk_reg,
+ * :1045-1119 get_cmd_read_data (RDBK_DATA_CTRL >> 16 = bytes received, RDBK_DATA3..0 = the last
+ * 16 bytes, big-endian words), dsi_ctrl.c:1279-1285 (embedded BTA bit 5 of the flags byte for a
+ * read). ESD (live.dts 35594-35599): qcom,mdss-dsi-panel-status-command 06 01 00 01 00 01 0a
+ * (DCS read 0x0a, 1 byte), -read-length 1, -value <0x9d 0x9f>, -command-state "dsi_lp_mode",
+ * -check-mode "reg_read"; every 5 s (sde_kms.h:143 STATUS_CHECK_INTERVAL_MS, sde_connector.c:794).
+ * Panel serial: oplus,dsi-serial-number-reg 0xa1, -read-count 11, -index 4 (live.dts 35558-35561,
+ * oplus_display_private_api.c:754-806: year/month at [4], day [5], hour [6], minute [7], second [8]).
+ *
+ * negronifb_esd (boot-arg, default 0): 1 = the panel ID once (0xda/0xdb/0xdc, 0x0a, 0x0e, 0xa1 x 11)
+ * and the 0x0a check every 5 s while the display is on; 2 = the panel ID only. A wrong value twice
+ * in a row calls the re-init NegroniBacklight.cpp registered (negroni_dsi_set_reinit: off-command,
+ * then 0268's wake with the full on-command and PPS; rc -1 and only a log with negronifb_wake=0);
+ * after 3 re-inits a third wrong pair stops the check for the boot. A read holds 0268's set lock,
+ * so it never lands inside a command set. Three failed reads in a row stop the check for the boot (a broken read
+ * path must never trigger a re-init).
+ */
+#define NDSI_RDBK_DATA0                 0x06c
+#define NDSI_RDBK_DATA_CTRL             0x1d4
+#define NDSI_TPG_CMD_DMA_INIT_VAL       0x17c
+#define NDSI_INT_BTA_DONE               (1u << 20)
+#define NDSI_ESD_PERIOD_MS              5000
+#define NDSI_READ_MAX                   24
+#define NDSI_ESD_REINIT_MAX             3       /* re-inits per boot, then the check stops */
+
+extern bool negroni_backlight_panel_ready(bool *lp);    /* NegroniBacklight.cpp (0259) */
+extern void negroni_dsi_set_enter(void);                /* NegroniBacklight.cpp: 0268's set lock */
+extern void negroni_dsi_set_leave(void);
+int negroni_dsi_dcs_read(uint8_t cmd, uint8_t *out, uint32_t rlen, bool lp);
+void negroni_dsi_set_reinit(int (*fn)(void));
+void negroni_dsi_esd_start(void);
+
+static int (*ndsi_reinit)(void);
+static thread_call_t ndsi_esd_call;
+static uint32_t ndsi_esd_mode;
+static bool ndsi_id_done, ndsi_esd_stopped;
+static uint32_t ndsi_esd_checks, ndsi_esd_ok, ndsi_esd_bad, ndsi_esd_rderr, ndsi_esd_badrow, ndsi_esd_errrow;
+static uint32_t ndsi_esd_reinits, ndsi_read_fifo, ndsi_read_dma;
+static uint8_t ndsi_esd_last;
+
+/* 0268 (full panel re-init) registers its entry here; the ESD check calls it from a thread call. */
+void
+negroni_dsi_set_reinit(int (*fn)(void))
+{
+	ndsi_reinit = fn;
+}
+
+/* Lock held: one FIFO DMA of n words (0250's register sequence), for the read packets. */
+static int
+ndsi_fifo_kick_locked(const uint32_t *words, uint32_t n, bool lp)
+{
+	volatile uint32_t *d = negroni_dsi_base();
+	uint32_t i;
+
+	for (i = 0; i < 250 && (ndsi_rd(d, NDSI_STATUS) & NDSI_STATUS_DMA_BUSY); i++) {
+		delay(20);
+	}
+	if (ndsi_rd(d, NDSI_STATUS) & NDSI_STATUS_DMA_BUSY) {
+		return -2;
+	}
+	uint32_t tpg = ndsi_rd(d, NDSI_TPG_CTRL);
+	uint32_t dma = ndsi_rd(d, NDSI_CMD_DMA_CTRL);
+	uint32_t trig = ndsi_rd(d, NDSI_TRIG_CTRL);
+	if ((trig & 0xfu) != NDSI_DMA_TRIGGER_SW) {
+		ndsi_wr(d, NDSI_TRIG_CTRL, (trig & ~0xfu) | NDSI_DMA_TRIGGER_SW);
+	}
+	ndsi_wr(d, NDSI_INT_CTRL, (ndsi_rd(d, NDSI_INT_CTRL) & NDSI_INT_ENABLE_BITS) | NDSI_INT_DMA_DONE);
+	ndsi_wr(d, NDSI_TPG_CTRL, 3u << 16 | 1u << 2 | 1u << 1);
+	for (i = 0; i < n; i++) {
+		ndsi_wr(d, NDSI_TPG_CMD_DMA_INIT_VAL, words[i]);
+	}
+	if (n & 1u) {
+		ndsi_wr(d, NDSI_TPG_CMD_DMA_INIT_VAL, 0);     /* an even number of words */
+	}
+	ndsi_wr(d, NDSI_CMD_DMA_CTRL, (dma & ~(1u << 31 | 1u << 30 | 1u << 26)) | 1u << 28 | (lp ? 1u << 26 : 0u));
+	ndsi_wr(d, NDSI_DMA_CMD_LENGTH, n * 4);
+	__builtin_arm_dsb(0xf);
+	ndsi_wr(d, NDSI_CMD_DMA_SW_TRIGGER, 1);
+	__builtin_arm_dsb(0xf);
+	bool done = false;
+	for (i = 0; i < 2500 && !done; i++) {
+		done = (ndsi_rd(d, NDSI_INT_CTRL) & NDSI_INT_DMA_DONE) != 0;
+		if (!done) {
+			delay(10);
+		}
+	}
+	ndsi_wr(d, NDSI_INT_CTRL, (ndsi_rd(d, NDSI_INT_CTRL) & NDSI_INT_ENABLE_BITS) | NDSI_INT_DMA_DONE);
+	ndsi_wr(d, NDSI_TPG_CTRL, 0);
+	ndsi_wr(d, NDSI_TPG_DMA_FIFO_RESET, 1);
+	__builtin_arm_dsb(0xf);
+	delay(1);
+	ndsi_wr(d, NDSI_TPG_DMA_FIFO_RESET, 0);
+	ndsi_wr(d, NDSI_TPG_CTRL, tpg);
+	ndsi_wr(d, NDSI_CMD_DMA_CTRL, dma);
+	if ((trig & 0xfu) != NDSI_DMA_TRIGGER_SW) {
+		ndsi_wr(d, NDSI_TRIG_CTRL, trig);
+	}
+	__builtin_arm_dsb(0xf);
+	return done ? 0 : -3;
+}
+
+/* get_cmd_read_data (dsi_ctrl_hw_cmn.c:1045-1119), ported as is. */
+static uint32_t
+ndsi_read_data(volatile uint32_t *d, uint8_t *rd_buf, uint32_t read_offset, uint32_t rx_byte, uint32_t pkt_size,
+    uint32_t *hw_read_cnt)
+{
+	uint8_t reg[16] = { 0 };
+	uint32_t cnt = (rx_byte + 3) >> 2, read_cnt, repeated = 0, i, j = 0;
+	bool ack_err;
+
+	cnt = cnt > 4 ? 4 : cnt;
+	read_cnt = ndsi_rd(d, NDSI_RDBK_DATA_CTRL) >> 16;
+	ack_err = rx_byte == 4 ? read_cnt == 8 : (read_cnt - 4) == (pkt_size + 6);
+	if (ack_err) {
+		read_cnt -= 4;
+	}
+	if (read_cnt == 0) {
+		return 0;
+	}
+	if (rx_byte == 4 && read_cnt > 4) {
+		read_cnt = rx_byte;
+	} else if (rx_byte == 16 && read_cnt > pkt_size + 6) {
+		read_cnt = pkt_size + 6;
+	}
+	if (read_cnt > 16) {
+		int bytes_shifted = (int)read_cnt - (int)rx_byte, data_lost = 0, rem_header = 0;
+		if (bytes_shifted >= 4) {
+			data_lost = bytes_shifted - 4;
+		} else {
+			rem_header = 4 - bytes_shifted;
+		}
+		repeated = (uint32_t)((int)(read_offset - 4) - data_lost + rem_header);
+	}
+	uint32_t off = NDSI_RDBK_DATA0 + (cnt - 1) * 4, k = 0;
+	for (i = 0; i < cnt; i++, off -= 4) {
+		uint32_t w = __builtin_bswap32(ndsi_rd(d, off));   /* ntohl */
+		uint8_t *dst = repeated ? reg + 4 * i : rd_buf + 4 * k++;
+		memcpy(dst, &w, 4);
+	}
+	if (repeated) {
+		for (i = repeated; i < 16; i++) {
+			rd_buf[j++] = reg[i];
+		}
+	}
+	*hw_read_cnt = read_cnt;
+	return rx_byte;
+}
+
+/*
+ * Lock held: one pass = max return packet size (0x37, batched) + the DCS read (0x06, last, BTA)
+ * through the memory DMA when it is on, else as two FIFO DMAs (Android forces "last" on FIFO
+ * packets). Then the BTA (INT_CTRL bit 20, at most 10 ms) brings the panel's answer to RDBK.
+ */
+static int
+ndsi_read_pass_locked(uint8_t cmd, uint32_t pkt, bool lp)
+{
+	volatile uint32_t *d = negroni_dsi_base();
+	uint8_t mrs[2] = { (uint8_t)pkt, (uint8_t)(pkt >> 8) }, rd[2] = { cmd, 0 };
+	int rc;
+
+	ndsi_wr(d, NDSI_RDBK_DATA_CTRL, 1);
+	__builtin_arm_dsb(0xf);
+	ndsi_wr(d, NDSI_RDBK_DATA_CTRL, 0);
+	__builtin_arm_dsb(0xf);
+	if (ndsi_dma_usable()) {
+		uint32_t pos = 0;
+		(void)negroni_dsi_dma_append_locked(&pos, 0x37, mrs, 2, false, false);
+		(void)negroni_dsi_dma_append_locked(&pos, 0x06, rd, 1, true, true);
+		rc = negroni_dsi_dma_kick_locked(pos, lp, false);
+		ndsi_read_dma++;
+	} else {
+		uint32_t w1 = 1u << 31 | 0x37u << 16 | (uint32_t)mrs[1] << 8 | mrs[0];
+		uint32_t w2 = 1u << 31 | 1u << 29 | 0x06u << 16 | cmd;
+		rc = ndsi_fifo_kick_locked(&w1, 1, lp);
+		if (rc == 0) {
+			rc = ndsi_fifo_kick_locked(&w2, 1, lp);
+		}
+		ndsi_read_fifo++;
+	}
+	if (rc != 0) {
+		return rc;
+	}
+	uint32_t i;
+	for (i = 0; i < 1000 && !(ndsi_rd(d, NDSI_INT_CTRL) & NDSI_INT_BTA_DONE); i++) {
+		delay(10);
+	}
+	ndsi_wr(d, NDSI_INT_CTRL, (ndsi_rd(d, NDSI_INT_CTRL) & NDSI_INT_ENABLE_BITS) | NDSI_INT_BTA_DONE);
+	return 0;
+}
+
+/*
+ * 0293: DCS read of rlen bytes (1..NDSI_READ_MAX) of register cmd. Returns the bytes read
+ * (0: the panel sent an ACK/error report or nothing), < 0: DSI error. Thread context.
+ */
+int
+negroni_dsi_dcs_read(uint8_t cmd, uint8_t *out, uint32_t rlen, bool lp)
+{
+	uint8_t buf[48] = { 0 };
+	uint32_t rd_pkt, total_read_len, current_read_len = 0, total_bytes = 0, hw_cnt = 0, rlenLeft = rlen;
+	bool shortResp = rlen <= 2, done = false;
+	uint8_t *buff = buf;
+	int rc = 0;
+
+	if (rlen == 0 || rlen > NDSI_READ_MAX || negroni_dsi_in_panic()) {
+		return -1;
+	}
+	if (negroni_dsi_dma_mode() != 0) {
+		(void)ndsi_dma_usable();        /* the buffer, outside the lock */
+	}
+	if (shortResp) {
+		rd_pkt = rlen;
+		total_read_len = 4;
+	} else {
+		current_read_len = 10;
+		rd_pkt = rlen < current_read_len ? rlen : current_read_len;
+		total_read_len = current_read_len + 6;
+	}
+	/* the set lock first: a read never lands between the batches of a 0259 VRR set or the 0268 wake */
+	negroni_dsi_set_enter();
+	if (!negroni_dsi_enter()) {
+		negroni_dsi_set_leave();
+		return -1;
+	}
+	volatile uint32_t *d = negroni_dsi_base();
+	while (!done) {
+		rc = ndsi_read_pass_locked(cmd, rd_pkt, lp);
+		if (rc != 0) {
+			break;
+		}
+		uint32_t dlen = ndsi_read_data(d, buff, total_bytes, total_read_len, rd_pkt, &hw_cnt);
+		if (dlen == 0) {
+			rc = 0;
+			break;
+		}
+		if (shortResp) {
+			rc = 1;
+			break;
+		}
+		uint32_t diff;
+		if (rlenLeft <= current_read_len) {
+			diff = current_read_len - rlenLeft;
+			done = true;
+		} else {
+			diff = 0;
+			rlenLeft -= current_read_len;
+		}
+		dlen -= 2 + diff;
+		buff += dlen;
+		total_bytes += dlen;
+		if (!done) {
+			current_read_len = 14;
+			rd_pkt += rlenLeft < current_read_len ? rlenLeft : current_read_len;
+		}
+		if (buff + 16 > buf + sizeof(buf)) {
+			rc = -4;
+			break;
+		}
+		rc = 1;
+	}
+	uint32_t ack = ndsi_rd(d, NDSI_ACK_ERR_STATUS);
+	negroni_dsi_leave();
+	negroni_dsi_set_leave();
+	if (rc <= 0) {
+		return rc;
+	}
+	uint32_t ho = (!shortResp && hw_cnt < 16) ? 16 - hw_cnt : 0;
+	uint8_t type = buf[ho];
+	switch (type) {
+	case 0x21: case 0x11:           /* DCS / generic short read response, 1 byte */
+		out[0] = buf[ho + 1];
+		return 1;
+	case 0x22: case 0x12:           /* 2 bytes */
+		out[0] = buf[ho + 1];
+		if (rlen > 1) {
+			out[1] = buf[ho + 2];
+		}
+		return rlen > 1 ? 2 : 1;
+	case 0x1c: case 0x1a:           /* DCS / generic long read response */
+		memcpy(out, buf + ho + 4, rlen);
+		return (int)rlen;
+	case 0x02:
+		printf("NEGRONI DSI: read 0x%02x: ACK/error report 0x%02x%02x (ack_err 0x%08x)\n", cmd, buf[ho + 2],
+		    buf[ho + 1], ack);
+		return 0;
+	default:
+		printf("NEGRONI DSI: read 0x%02x: unknown response 0x%02x (bytes %u, ack_err 0x%08x)\n", cmd, type, hw_cnt, ack);
+		return 0;
+	}
+}
+
+/* Once: the panel's identity (log only; the serial stays on the phone). */
+static void
+ndsi_read_id(void)
+{
+	static const uint8_t regs[] = { 0xda, 0xdb, 0xdc, 0x0a, 0x0e };
+	uint8_t v[sizeof(regs)] = { 0 }, sn[11] = { 0 };
+	int r[sizeof(regs)];
+
+	for (uint32_t i = 0; i < sizeof(regs); i++) {
+		r[i] = negroni_dsi_dcs_read(regs[i], &v[i], 1, true);
+	}
+	int rs = negroni_dsi_dcs_read(0xa1, sn, sizeof(sn), true);
+	printf("NEGRONI DSI: panel ID da/db/dc %02x %02x %02x (rc %d %d %d), power mode 0a %02x (rc %d), signal 0e %02x (rc %d), "
+	    "a1 x 11 rc %d: made %u-%02u-%02u %02u:%02u:%02u (reads via %s)\n",
+	    v[0], v[1], v[2], r[0], r[1], r[2], v[3], r[3], v[4], r[4], rs, 2011u + (sn[4] >> 4), sn[4] & 0x0f, sn[5] & 0x1f, sn[6] & 0x1f, sn[7] & 0x3f, sn[8] & 0x3f,
+	    ndsi_read_dma != 0 ? "memory DMA" : "FIFO");
+}
+
+static void
+ndsi_esd_work(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	bool lp = true;
+
+	if (!negroni_backlight_panel_ready(&lp)) {
+		goto again;             /* display off or no DSI: nothing to check */
+	}
+	if (!ndsi_id_done) {
+		ndsi_id_done = true;
+		ndsi_read_id();
+	}
+	if (ndsi_esd_mode != 1 || ndsi_esd_stopped) {
+		return;
+	}
+	uint8_t v = 0;
+	int rc = negroni_dsi_dcs_read(0x0a, &v, 1, true);  /* status-command-state "dsi_lp_mode" */
+	if (!negroni_backlight_panel_ready(NULL)) {
+		goto again;             /* went off meanwhile: the answer of a sleeping panel means nothing */
+	}
+	ndsi_esd_checks++;
+	if (rc != 1) {
+		ndsi_esd_rderr++;
+		if (++ndsi_esd_errrow >= 3) {
+			ndsi_esd_stopped = true;
+			printf("NEGRONI DSI ESD: 3 reads of 0x0a failed in a row (rc %d): ESD check off for this boot\n", rc);
+			return;
+		}
+	} else if (v == 0x9d || v == 0x9f) {
+		ndsi_esd_ok++;
+		ndsi_esd_errrow = 0;
+		ndsi_esd_badrow = 0;
+		ndsi_esd_last = v;
+		if (ndsi_esd_ok == 1) {
+			printf("NEGRONI DSI ESD: power mode 0x%02x ok (expect 0x9d/0x9f), check every %u ms\n", v, NDSI_ESD_PERIOD_MS);
+		}
+	} else {
+		ndsi_esd_bad++;
+		ndsi_esd_errrow = 0;
+		ndsi_esd_last = v;
+		ndsi_esd_badrow++;
+		if (ndsi_esd_bad <= 4 || (ndsi_esd_bad % 60) == 0) {
+			printf("NEGRONI DSI ESD: power mode 0x%02x, expected 0x9d/0x9f (%u in a row, %u in all)\n", v,
+			    ndsi_esd_badrow, ndsi_esd_bad);
+		}
+		if (ndsi_esd_badrow >= 2) {
+			ndsi_esd_badrow = 0;
+			if (ndsi_reinit != NULL && ndsi_esd_reinits >= NDSI_ESD_REINIT_MAX) {
+				/* a panel that stays wrong after 3 re-inits: no off + full wake every 10 s all boot */
+				ndsi_esd_stopped = true;
+				printf("NEGRONI DSI ESD: still 0x%02x after %u re-inits: ESD check off for this boot\n", v,
+				    ndsi_esd_reinits);
+				return;
+			}
+			if (ndsi_reinit != NULL) {
+				int r = ndsi_reinit();
+				ndsi_esd_reinits++;
+				printf("NEGRONI DSI ESD: panel re-init (off-command + 0268 wake) queued, rc %d (%u re-inits)\n", r,
+				    ndsi_esd_reinits);
+			} else if (ndsi_esd_bad <= 4) {
+				printf("NEGRONI DSI ESD: no panel re-init registered (0268 not in this kernel): logged only\n");
+			}
+		}
+	}
+	if ((ndsi_esd_checks % 60) == 0) {
+		printf("NEGRONI DSI ESD: %u checks, ok %u, wrong %u, read errors %u, re-inits %u, last 0x%02x\n",
+		    ndsi_esd_checks, ndsi_esd_ok, ndsi_esd_bad, ndsi_esd_rderr, ndsi_esd_reinits, ndsi_esd_last);
+	}
+again:
+	if (ndsi_esd_mode == 1 || !ndsi_id_done) {
+		uint64_t deadline;
+		clock_interval_to_deadline(NDSI_ESD_PERIOD_MS, NSEC_PER_MSEC, &deadline);
+		thread_call_enter_delayed(ndsi_esd_call, deadline);
+	}
+}
+
+/* NegroniFramebuffer.cpp AppleCLCD::start, after the backlight attached: negronifb_esd. */
+void
+negroni_dsi_esd_start(void)
+{
+	uint32_t m = 0;
+
+	PE_parse_boot_argn("negronifb_esd", &m, sizeof(m));
+	if (m == 0 || ndsi_esd_call != NULL || negroni_dsi_base() == NULL) {
+		return;
+	}
+	ndsi_esd_mode = m > 2 ? 2 : m;
+	ndsi_esd_call = thread_call_allocate_with_options(ndsi_esd_work, NULL, THREAD_CALL_PRIORITY_KERNEL, 0);
+	if (ndsi_esd_call == NULL) {
+		return;
+	}
+	printf("NEGRONI DSI ESD: negronifb_esd=%u: panel ID once%s; re-init %s\n", ndsi_esd_mode,
+	    ndsi_esd_mode == 1 ? ", DCS 0x0a every 5 s while the display is on" : "",
+	    ndsi_reinit != NULL ? "registered" : "not registered (log only)");
+	uint64_t deadline;
+	clock_interval_to_deadline(NDSI_ESD_PERIOD_MS, NSEC_PER_MSEC, &deadline);
+	thread_call_enter_delayed(ndsi_esd_call, deadline);
+}
diff --git a/bsd/dev/negroni_fp.c b/bsd/dev/negroni_fp.c
new file mode 100644
index 0000000..ccfe7fd
--- /dev/null
+++ b/bsd/dev/negroni_fp.c
@@ -0,0 +1,1385 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450): under-display optical fingerprint sensor, stage A
+ * (patch 0350): power, reset, a chip-ID read over GENI SPI, and the IRQ pin.
+ *
+ * Hardware [V out/live.dts]:
+ *   goodix_fp (36711): compatible "goodix,goodix_fp", ldo-supply pm8350c_l11 (phandle 0x347 =
+ *     RPMh "ldoc11", 11257), ldo-config <3000000 3000000 150000> = 3.0 V 150 mA,
+ *     goodix,gpio_irq = TLMM 40 (pull-down input, pinctrl 5563), goodix,gpio_reset = TLMM 41,
+ *     interrupts <40 0>. No SPI bus node: the sensor's SPI is driven by the TEE on Android.
+ *   oplus_fp_common (36695): fp id = TLMM 42 (pull-up input); goodix_optical_G7, fp-id 1.
+ *   SPI serial engine [I: the only QUP SE whose pins are not used by any HLOS node and that
+ *     sits next to the FP GPIOs]: QUP1 SE2 = spi@a88000 (14795, "disabled" in HLOS; clocks
+ *     <GCC 108 = GCC_QUPV3_WRAP1_S2_CLK, 136 M_AHB, 137 S_AHB>), pins qupv3_se10 TLMM 36 MISO,
+ *     37 MOSI, 38 CLK, 39 CS (live.dts 2314: function "qup10", 6 mA, no bias; mainline
+ *     pinctrl-sm8450.c 1460: qup10 = function 1).
+ *   GCC [V out/src/op-kernel/drivers/clk/qcom/gcc-waipio.c]: votes in APCS 0x62008:
+ *     bit 24 wrap1_s2_clk (halt 0x28274), bit 20 wrap_1_m_ahb (0x28004), bit 21 wrap_1_s_ahb
+ *     (0x28008), bit 19 wrap1_core (0x33140), bit 18 wrap1_core_2x (0x3314c);
+ *     RCG wrap1_s2_clk_src cmd_rcgr 0x2827c (parent map 0: XO = src 0; 19.2 MHz = div 1).
+ *   GENI registers: Linux include/linux/soc/qcom/geni-se.h and drivers/spi/spi-geni-qcom.c (v6.1).
+ *
+ * Boot-args:
+ *   negronifp=0        (default) nothing is touched
+ *   negronifp=1        steps 1-9: clocks, SE probe, LDO vote, reset, chip-ID frames over SPI
+ *   negronifp=2        = 1, then polls the IRQ pin (TLMM 40) for negronifp_poll s (default 60),
+ *                      logs each level change (the first 32)
+ *   negronifp_delay=S  start S s after boot (default 15: after the USB console)
+ *   negronifp_hz=N     SPI clock (default 4800000; the SE clock is 19.2 MHz, div = ceil)
+ *   negronifp_mode=N   SPI mode 0..3 (CPOL bit 1, CPHA bit 0; default 0)
+ *   negronifp_ldo=0    no RPMh vote for ldoc11 (default 1: 3000 mV; there is no "off" vote)
+ *   negronifp_keep=1   leave the sensor powered and the SE clocks on after the steps (default 0:
+ *                      reverse order power-down incl. the ldoc11 off vote when we voted it on)
+ *   negronifp=3        = 2, then (0352) step 10: the public Goodix MCU message frames (query MCU
+ *                      state, firmware version, OTP, sensor register 0) over plain SPI and with the
+ *                      5120-SPI transport wrapper; the raw answers are logged and decoded
+ *   negronifp_wrap=N   0352: 0 = plain frames only, 1 = CC F2 wrapper only, 2 = both (default 2)
+ *   negronifp_irqwait=MS  0352: how long to watch the IRQ pin after each frame (default 100 ms)
+ *   negronifp=4        = 3, then (0353) step 11: one raw capture: panel HBM on (0351's DCS set), wait
+ *                      2 TE frames (oplus,ofp-hbm-on-period) or 17 ms, MCU get-image frame (20 01 00)
+ *                      over the transport that answered in step 10 (plain when none), HBM off right
+ *                      after the frame + IRQ wait (<= 100 ms), bounded read into a buffer.
+ *                      /dev/negroni-fp (0600) returns a 32-byte header + the bytes
+ *                      (scripts/fp/raw-to-png.py). The G7 readout command is NOT known [I]: this is
+ *                      the public MCU command; an answer of idle bytes means the protocol differs.
+ *   negronifp_img=N    0353: capture buffer size (default 183456 = 364 x 252 x 2, the Delmar origin
+ *                      frame of the public HAL header gf_delmar_types.h DELMAR_ORIGIN_BUFFER_LEN)
+ * 0352 also retries the ldoc11 vote while the RPMh voter is busy (EBUSY, 40 x 50 ms as 0330) and
+ * stops when the vote fails (the sensor would be unpowered).
+ * Log: "NEGRONI FP: step N NAME ...". The chip-ID frames [I]: Goodix's public SPI drivers
+ * (gf_spi.c, GF3xxx/GF5xxx) read a register with {0xF1, addr_hi, addr_lo} then the data bytes;
+ * the optical G7 protocol lives in the TEE application and is not in any kernel source we have.
+ * Both frames are sent and the raw bytes are logged; all-0x00 or all-0xFF means no answer.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
