+/*
+ * Command server on 192.168.7.2:5141 (UDP), in the receive path above: a
+ * frame for this port is handled here and never reaches the network stack,
+ * so the commands need no socket or userland and still work while either
+ * hangs, as long as ud_thread runs. Only unfragmented IPv4/UDP from
+ * 192.168.7.1 to 192.168.7.2 is accepted. One ASCII command per datagram
+ * (trailing white space ignored), each logged as "NEGRONI CTL:":
+ *   ping        reply "pong"
+ *   reboot      PSCI SYSTEM_RESET (a reboot reason left in the PMIC is cleared)
+ *   bootloader  reboot reason 2 (ABL fastboot), then the reset
+ *   recovery    reboot reason 1 (recovery), then the reset
+ *   poweroff    PSCI SYSTEM_OFF (negroni_power_off(), boot-arg negronipoweroff)
+ *   panic       panic("requested over USB"), so the panic log path runs
+ *   settime S[.U]  set the calendar to S seconds (+U us) since 1970 UTC
+ *               (bsd/dev/negroni_rtc.c keeps the RTC offset); reply
+ *               "ok settime S (was ..., RTC offset N)" (patch 0212)
+ *   time        reply "time S rtc R offset N source ..." (no change)
+ * The last five reply "ok <command>" and act UD_CTL_DELAY_MS later, so the
+ * reply and the console log still reach the host. The reason is written
+ * at once (negroni_reboot.c); if it cannot be set the reply says so and
+ * the reset is a plain one. Replies go straight back to the sender's MAC
+ * and port (no ARP, no socket). Boot-arg negronictl=0 disables the server.
+ * Host side: op10tool ctl <command>.
+ */
+#define UD_CTL_PORT     5141
+#define UD_IP_PHONE     0xc0a80702u     /* 192.168.7.2 */
+#define UD_IP_HOST      0xc0a80701u     /* 192.168.7.1 */
+#define UD_CTL_DELAY_MS 500
+
+enum { UD_CTL_NONE, UD_CTL_RESET, UD_CTL_POWEROFF, UD_CTL_PANIC, UD_CTL_WATCHDOG /* 0375: ud_idle_thread resets */ };
+
+extern int negroni_reboot_set_reason(unsigned reason);
+extern void negroni_reboot_reset(void);
+extern void negroni_power_off(void);
+extern int negroni_calendar_settime(uint64_t secs, uint32_t usecs, char *reply, size_t size);
+extern void negroni_calendar_describe(char *reply, size_t size);
+/* 0367: boot log (negroni_ufs.c) */
+extern void negroni_bootlog_info(char *buf, size_t size);
+extern int negroni_bootlog_read(uint32_t blk, uint32_t count, void *dst);
+extern void negroni_bootlog_end(unsigned kind, const char *why);
+static char ud_ctl_why[48];             /* 0367: end text of the pending reset/power off */
+
+static const struct {
+	const char *name;
+	unsigned    reason;         /* PMIC reboot reason: 0 normal, 1 recovery, 2 bootloader */
+} ud_ctl_resets[] = {
+	{ "reboot", 0 },
+	{ "recovery", 1 },
+	{ "bootloader", 2 },
+};
+
+static uint16_t
+ud_be16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] << 8 | p[1]);
+}
+
+static uint32_t
+ud_be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static void
+ud_put16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)(v >> 8);
+	p[1] = (uint8_t)v;
+}
+
+static void
+ud_put32(uint8_t *p, uint32_t v)
+{
+	ud_put16(p, (uint16_t)(v >> 16));
+	ud_put16(p + 2, (uint16_t)v);
+}
+
+/* Internet checksum (RFC 1071): add 16-bit big-endian words, an odd last byte padded with 0. */
+static uint32_t
+ud_sum_add(uint32_t sum, const uint8_t *p, unsigned len)
+{
+	for (unsigned i = 0; i < len; i += 2) {
+		sum += (uint32_t)p[i] << 8 | (i + 1 < len ? p[i + 1] : 0u);
+	}
+	return sum;
+}
+
+static uint16_t
+ud_sum_fold(uint32_t sum)
+{
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return (uint16_t)~sum;
+}
+
+/*
+ * Ethernet + IPv4 + UDP frame from 192.168.7.2:sport into f; returns the
+ * frame length. data may already be at f + 42 (the panic path builds in
+ * the TX buffer): then it is not copied.
+ */
+static uint32_t
+ud_udp_build(uint8_t *f, const uint8_t *dst_mac, const uint8_t *dst_ip, uint16_t sport, uint16_t dport,
+    const void *data, uint32_t n)
+{
+	uint32_t len = ETHER_HDR_LEN + 20 + 8 + n;
+
+	bzero(f, ETHER_HDR_LEN + 20 + 8);
+	memcpy(f, dst_mac, ETHER_ADDR_LEN);
+	memcpy(f + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+	ud_put16(f + 12, ETHERTYPE_IP);
+	uint8_t *ip = f + ETHER_HDR_LEN;
+	ip[0] = 0x45;                   /* IPv4, 20-byte header */
+	ud_put16(ip + 2, (uint16_t)(20 + 8 + n));
+	ud_put16(ip + 4, ud.ctl_ip_id++);
+	ud_put16(ip + 6, 0x4000);       /* don't fragment */
+	ip[8] = 64;                     /* TTL */
+	ip[9] = IPPROTO_UDP;
+	ud_put32(ip + 12, UD_IP_PHONE);
+	memcpy(ip + 16, dst_ip, 4);
+	ud_put16(ip + 10, ud_sum_fold(ud_sum_add(0, ip, 20)));
+	uint8_t *udp = ip + 20;
+	ud_put16(udp, sport);
+	ud_put16(udp + 2, dport);
+	ud_put16(udp + 4, (uint16_t)(8 + n));
+	if (data != udp + 8) {
+		memcpy(udp + 8, data, n);
+	}
+	/* UDP checksum over the pseudo header (addresses, protocol, length) and the datagram */
+	uint32_t sum = ud_sum_add(0, ip + 12, 8) + IPPROTO_UDP + 8 + n;
+	uint16_t csum = ud_sum_fold(ud_sum_add(sum, udp, 8 + n));
+	ud_put16(udp + 6, csum ? csum : 0xffff);
+	return len;
+}
+
+/*
+ * One UDP datagram from 192.168.7.2:sport, built here and put on the TX
+ * ring (no socket, no ARP, no route: works while ue0 is down). Does not
+ * print (the log thread uses it). false = no mbuf.
+ */
+static bool
+ud_udp_send(const uint8_t *dst_mac, const uint8_t *dst_ip, uint16_t sport, uint16_t dport,
+    const void *data, uint32_t n)
+{
+	uint32_t len = ETHER_HDR_LEN + 20 + 8 + n;
+	mbuf_t m = NULL;
+
+	if (ud.ifp == NULL || mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    !(mbuf_flags(m) & MBUF_EXT) || mbuf_maxlen(m) < len) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		return false;
+	}
+	(void)ud_udp_build(mbuf_data(m), dst_mac, dst_ip, sport, dport, data, n);
+	mbuf_setlen(m, len);
+	mbuf_pkthdr_setlen(m, len);
+	(void)ud_if_output(ud.ifp, m);
+	return true;
+}
+
+/*
+ * 0381: an ARP request for 192.168.7.2 on the OUT path (normal mode; the panic mode has its own
+ * answer in ud_panic_rx). Counted while negroniusb_datafix != 0; with bit 2 answered here as a raw
+ * frame (192.168.7.2 is at 02:00:5e:77:ee:02), so the host reaches the command server also when
+ * the stack does not answer (no address on ue0, stack stuck). The frame still goes to the stack:
+ * a second answer from it does no harm.
+ */
+static void
+ud_arp_answer(const uint8_t *f, uint32_t len)
+{
+	const uint8_t *a = f + ETHER_HDR_LEN;
+	uint32_t flen = ETHER_HDR_LEN + 28;
+	mbuf_t m = NULL;
+
+	if (len < flen || ud_be16(f + 12) != ETHERTYPE_ARP || ud_be16(a) != 1 || ud_be16(a + 2) != ETHERTYPE_IP ||
+	    a[4] != ETHER_ADDR_LEN || a[5] != 4 || ud_be16(a + 6) != 1 || ud_be32(a + 24) != UD_IP_PHONE ||
+	    (a[8] & 1) != 0) {          /* review: no answer to a group (multicast/broadcast) sender MAC */
+		return;
+	}
+	ud.arp_req++;
+	if (!(ud_datafix & UD_DF_RAW) || ud.ifp == NULL) {
+		return;
+	}
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 || mbuf_maxlen(m) < flen) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		return;
+	}
+	uint8_t *r = mbuf_data(m);
+	bzero(r, flen);
+	memcpy(r, a + 8, ETHER_ADDR_LEN);               /* to the sender's MAC */
+	memcpy(r + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+	ud_put16(r + 12, ETHERTYPE_ARP);
+	uint8_t *ra = r + ETHER_HDR_LEN;
+	ud_put16(ra, 1);
+	ud_put16(ra + 2, ETHERTYPE_IP);
+	ra[4] = ETHER_ADDR_LEN;
+	ra[5] = 4;
+	ud_put16(ra + 6, 2);                            /* reply */
+	memcpy(ra + 8, ud_phone_mac, ETHER_ADDR_LEN);
+	ud_put32(ra + 14, UD_IP_PHONE);
+	memcpy(ra + 18, a + 8, ETHER_ADDR_LEN);         /* target: the sender's MAC and IP */
+	memcpy(ra + 24, a + 14, 4);
+	mbuf_setlen(m, flen);
+	mbuf_pkthdr_setlen(m, flen);
+	(void)ud_if_output(ud.ifp, m);
+}
+
+/* UDP datagram from 192.168.7.2:5141 back to the sender of req (a frame ud_ctl_input accepted). */
+static void
+ud_ctl_reply(const uint8_t *req, const char *text)
+{
+	const uint8_t *rip = req + ETHER_HDR_LEN;
+	const uint8_t *rudp = rip + (rip[0] & 0xfu) * 4;
+
+	/* to the sender's MAC, address and port */
+	if (!ud_udp_send(req + ETHER_ADDR_LEN, rip + 12, UD_CTL_PORT, ud_be16(rudp), text, (uint32_t)strlen(text))) {
+		printf("NEGRONI CTL: no mbuf for the reply\n");
+	}
+}
+
+static void
+ud_ctl_schedule(int action)
+{
+	int none = UD_CTL_NONE;
+
+	clock_interval_to_deadline(UD_CTL_DELAY_MS, NSEC_PER_MSEC, &ud.ctl_deadline);
+	if (!__atomic_compare_exchange_n(&ud.ctl_action, &none, action, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+		printf("NEGRONI CTL: action %d not scheduled: the 0375 idle watchdog resets now\n", action);
+	}
+}
+
+/*
+ * 0367: boot log commands (negroni_ufs.c, README-bootlog.md).
+ *   bootlog          one text line: area, slots, this boot (negroni_bootlog_info)
+ *   bootlog read A C area blocks A .. A+C-1 (C 1..4): 4 datagrams per block,
+ *                    each a 16-byte header "NBLD" | u32 block | u32 byte offset
+ *                    in the block | u32 length (little endian) and 1024 data bytes
+ * The read runs here in ud_thread (UFS lock, one READ command); datagrams the
+ * TX queue drops are asked for again by the host (op10tool bootlog).
+ */
+#define UD_BOOTLOG_CHUNK 1024u
+
+#include "negroni_bootlog_core.h"            /* nbl_core_parse_u32 (host-tested: tools/bootlog-core-test) */
+
+static void
+ud_ctl_bootlog(const uint8_t *f, const char *cmd)
+{
+	static uint8_t blocks[4 * 4096];
+	static uint8_t dgram[16 + UD_BOOTLOG_CHUNK];
+	char reply[256];
+
+	if (cmd[7] == 0) {
+		negroni_bootlog_info(reply, sizeof(reply));
+		ud_ctl_reply(f, reply);
+		return;
+	}
+	const char *q = cmd + 13;
+	bool ok = true;
+	uint32_t blk = nbl_core_parse_u32(&q, &ok);
+	if (*q == ' ') {
+		q++;
+	} else {
+		ok = false;
+	}
+	uint32_t count = nbl_core_parse_u32(&q, &ok);
+	if (!ok || *q != 0 || count == 0 || count > 4) {
+		ud_ctl_reply(f, "error: bootlog read <area block> <count 1..4>");
+		return;
+	}
+	int error = negroni_bootlog_read(blk, count, blocks);
+	if (error) {
+		snprintf(reply, sizeof(reply), "error: bootlog read %u %u: %d", blk, count, error);
+		ud_ctl_reply(f, reply);
+		return;
+	}
+	const uint8_t *rip = f + ETHER_HDR_LEN;
+	const uint8_t *rudp = rip + (rip[0] & 0xfu) * 4;
+	for (uint32_t i = 0; i < count; i++) {
+		for (uint32_t off = 0; off < 4096; off += UD_BOOTLOG_CHUNK) {
+			uint32_t b = blk + i, n = UD_BOOTLOG_CHUNK;
+			memcpy(dgram, "NBLD", 4);
+			memcpy(dgram + 4, &b, 4);
+			memcpy(dgram + 8, &off, 4);
+			memcpy(dgram + 12, &n, 4);
+			memcpy(dgram + 16, blocks + i * 4096 + off, n);
+			(void)ud_udp_send(f + ETHER_ADDR_LEN, rip + 12, UD_CTL_PORT, ud_be16(rudp), dgram, 16 + n);
+		}
+	}
+}
+
+/* One received frame (Ethernet header first). true = it was for the command server. */
+static bool
+ud_ctl_input(const uint8_t *f, uint32_t len)
+{
+	char cmd[32], reply[80];
+
+	if (!ud.ctl_enabled || len < ETHER_HDR_LEN + 20 + 8 || ud_be16(f + 12) != ETHERTYPE_IP) {
+		return false;
+	}
+	const uint8_t *ip = f + ETHER_HDR_LEN;
+	uint32_t ihl = (ip[0] & 0xfu) * 4, tot = ud_be16(ip + 2);
+	if ((ip[0] >> 4) != 4 || ihl < 20 || ip[9] != IPPROTO_UDP || tot < ihl + 8 ||
+	    ETHER_HDR_LEN + tot > len || (ud_be16(ip + 6) & 0x3fff) != 0) {
+		return false;           /* not one whole IPv4/UDP datagram: for the stack */
+	}
+	const uint8_t *udp = ip + ihl;
+	if (ud_be32(ip + 16) != UD_IP_PHONE || ud_be16(udp + 2) != UD_CTL_PORT) {
+		return false;
+	}
+	/* From here on the frame is the command server's: it never reaches the stack. */
+	if (ud_be32(ip + 12) != UD_IP_HOST) {
+		printf("NEGRONI CTL: datagram from %u.%u.%u.%u ignored (only 192.168.7.1)\n",
+		    ip[12], ip[13], ip[14], ip[15]);
+		return true;
+	}
+	uint32_t ulen = ud_be16(udp + 4);
+	if (ud_sum_fold(ud_sum_add(0, ip, ihl)) != 0 || ulen < 8 || ulen > tot - ihl) {
+		printf("NEGRONI CTL: malformed datagram ignored\n");
+		return true;
+	}
+	uint32_t n = ulen - 8;
+	const uint8_t *p = udp + 8;
+	while (n > 0 && (p[n - 1] == '\n' || p[n - 1] == '\r' || p[n - 1] == ' ' ||
+	    p[n - 1] == '\t' || p[n - 1] == 0)) {
+		n--;
+	}
+	if (n >= sizeof(cmd)) {
+		printf("NEGRONI CTL: %u-byte command ignored\n", n);
+		ud_ctl_reply(f, "error: unknown command");
+		return true;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		cmd[i] = (p[i] >= 0x20 && p[i] < 0x7f) ? (char)p[i] : '?';
+	}
+	cmd[n] = 0;
+	printf("NEGRONI CTL: \"%s\" from 192.168.7.1:%u\n", cmd, ud_be16(udp));
+
+	if (strcmp(cmd, "ping") == 0) {
+		ud_ctl_reply(f, "pong");
+		return true;
+	}
+	if (strcmp(cmd, "time") == 0 || strncmp(cmd, "settime ", 8) == 0) {
+		/* calendar commands (0212): no reset, so also allowed while one is pending */
+		char treply[160];
+		if (cmd[0] == 't') {
+			negroni_calendar_describe(treply, sizeof(treply));
+		} else {
+			const char *q = cmd + 8;
+			uint64_t secs = 0;
+			uint32_t usecs = 0, digits = 0;
+			bool ok = *q >= '0' && *q <= '9';
+			while (*q >= '0' && *q <= '9' && secs < 100000000000ull) {
+				secs = secs * 10 + (uint64_t)(*q++ - '0');
+			}
+			if (*q == '.') {
+				for (q++; *q >= '0' && *q <= '9'; q++) {
+					if (digits < 6) {
+						usecs = usecs * 10 + (uint32_t)(*q - '0');
+						digits++;
+					}
+				}
+				for (; digits < 6; digits++) {
+					usecs *= 10;
+				}
+			}
+			if (!ok || *q != 0) {
+				snprintf(treply, sizeof(treply), "error: settime needs <unix seconds>[.<fraction>]");
+			} else {
+				(void)negroni_calendar_settime(secs, usecs, treply, sizeof(treply));
+			}
+		}
+		printf("NEGRONI CTL: %s\n", treply);
+		ud_ctl_reply(f, treply);
+		return true;
+	}
+	if (strcmp(cmd, "usbstats") == 0) {
+		/* 0361: the gadget's own counters (no reset, no state change) */
+		char sreply[200];
+		snprintf(sreply, sizeof(sreply), "usb rx %llu frames %llu bytes, tx %llu frames %llu bytes, "
+		    "tx drops %llu, rx max %u/poll, tx max %u/batch, ring %d, poll %d us",
+		    ud.rx_frames, ud.rx_bytes, ud.tx_frames, ud.tx_bytes, ud.tx_drops, ud.rx_max_poll,
+		    ud.tx_max_batch, ud_ring, ud_poll_us);
+		ud_ctl_reply(f, sreply);
+		return true;
+	}
+	if (strcmp(cmd, "log") == 0) {
+		ud_log_rewind = true;   /* 0360: ud_log_thread sends the last 64 KiB of the console again */
+		ud_ctl_reply(f, "ok log");
+		return true;
+	}
+	if (strcmp(cmd, "bootlog") == 0 || strncmp(cmd, "bootlog read ", 13) == 0) {
+		ud_ctl_bootlog(f, cmd);
+		return true;
+	}
+	if (ud.ctl_action != UD_CTL_NONE) {
+		printf("NEGRONI CTL: busy (a reset or panic is pending)\n");
+		ud_ctl_reply(f, "error: busy");
+		return true;
+	}
+	if (strcmp(cmd, "panic") == 0) {
+		printf("NEGRONI CTL: panic in %u ms\n", UD_CTL_DELAY_MS);
+		ud_ctl_reply(f, "ok panic");
+		ud_ctl_schedule(UD_CTL_PANIC);
+		return true;
+	}
+	if (strcmp(cmd, "poweroff") == 0) {
+		strlcpy(ud_ctl_why, "power off (USB command)", sizeof(ud_ctl_why));
+		printf("NEGRONI CTL: power off in %u ms\n", UD_CTL_DELAY_MS);
+		ud_ctl_reply(f, "ok poweroff");
+		ud_ctl_schedule(UD_CTL_POWEROFF);
+		return true;
+	}
+	for (unsigned i = 0; i < sizeof(ud_ctl_resets) / sizeof(ud_ctl_resets[0]); i++) {
+		if (strcmp(cmd, ud_ctl_resets[i].name) != 0) {
+			continue;
+		}
+		unsigned reason = ud_ctl_resets[i].reason;
+		bool set = negroni_reboot_set_reason(reason) == 0;
+		snprintf(reply, sizeof(reply), "ok %s%s", cmd,
+		    (set || reason == 0) ? "" : " (reason not set: plain reset)");
+		printf("NEGRONI CTL: %s: reason %u %s, reset in %u ms\n", cmd, reason,
+		    set ? "set" : "NOT set", UD_CTL_DELAY_MS);
+		ud_ctl_reply(f, reply);
+		snprintf(ud_ctl_why, sizeof(ud_ctl_why), "reset (USB command %s)", cmd);
+		ud_ctl_schedule(UD_CTL_RESET);
+		return true;
+	}
+	printf("NEGRONI CTL: unknown command\n");
+	ud_ctl_reply(f, "error: unknown command");
+	return true;
+}
+
+/* ud_thread, every tick: run a scheduled reset or panic once its delay is over. */
+static void
+ud_ctl_poll(void)
+{
+	if (ud.ctl_action == UD_CTL_NONE || ud.ctl_action == UD_CTL_WATCHDOG || mach_absolute_time() < ud.ctl_deadline) {
+		return;                 /* 0375: UD_CTL_WATCHDOG = ud_idle_thread does the reset itself */
+	}
+	int action = ud.ctl_action;
+	if (!__atomic_compare_exchange_n(&ud.ctl_action, &action, UD_CTL_NONE, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+		return;                 /* 0375: ud_idle_thread took over just now */
+	}
+	if (action == UD_CTL_PANIC) {
+		panic("requested over USB");
+	}
+	if (action == UD_CTL_POWEROFF) {
+		negroni_bootlog_end(3, ud_ctl_why);     /* 0367 */
+		negroni_power_off();    /* returns only if every method failed (logged there) */
+		return;
+	}
+	negroni_bootlog_end(4, ud_ctl_why);             /* 0367 */
+	printf("NEGRONI CTL: PSCI SYSTEM_RESET\n");
+	negroni_reboot_reset();         /* returns only if PSCI refused (logged there) */
+}
+
+/*
+ * Link state for configd (KernelEventMonitor reads SIOCGIFMEDIA and the
+ * KEV_DL_LINK_ON/OFF events; IPMonitor does not route through a service
+ * whose interface has no active link).
+ */
+static void
+ud_link_event(bool up)
+{
+	if (ud.ifp != NULL && !ud_in_panic) {   /* 0360: dlil_post_msg allocates and locks */
+		uint32_t was = ud.where;
+		ud.where = UD_AT_LINKEVENT;     /* 0375 */
+		dlil_post_msg(ud.ifp, KEV_DL_SUBCLASS, up ? KEV_DL_LINK_ON : KEV_DL_LINK_OFF, NULL, 0, FALSE);
+		ud.where = was;
+	}
+}
+
+static errno_t
+ud_if_ioctl(ifnet_t ifp, unsigned long cmd, void *data)
+{
+	switch (cmd) {
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64: {
+		struct ifmediareq *ifmr = (struct ifmediareq *)data;
+		user_addr_t list = (cmd == SIOCGIFMEDIA64) ?
+		    ((struct ifmediareq64 *)ifmr)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)ifmr)->ifmu_ulist);
+		int media = IFM_ETHER | IFM_AUTO;
+		ifmr->ifm_current = media;
+		ifmr->ifm_active = ud.configured ? (IFM_ETHER | IFM_1000_T | IFM_FDX) : media;
+		ifmr->ifm_mask = 0;
+		ifmr->ifm_status = IFM_AVALID | (ud.configured ? IFM_ACTIVE : 0);
+		if (list != USER_ADDR_NULL && ifmr->ifm_count > 0) {
+			ifmr->ifm_count = 1;
+			return copyout(&media, list, sizeof(media));
+		}
+		ifmr->ifm_count = 1;
+		return 0;
+	}
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
