+static bool
+sp_read_allowed(unsigned sid, unsigned addr)
+{
+	unsigned peripheral = addr >> 8, reg = addr & 0xffu;
+	if (sid == 0 && peripheral == 0x31) {
+		return true;
+	}
+	return (sid == 1 || sid == 3) && (reg == 0x04 || reg == 0x05);
