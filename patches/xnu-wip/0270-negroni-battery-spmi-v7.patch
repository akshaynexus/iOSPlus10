+static uint16_t
+sp_apid(unsigned ppid)
+{
+	for (unsigned i = 0; i < sp_cached; ++i) {
+		if (sp_cache[i].ppid == ppid) {
+			return sp_cache[i].apid;
+		}
+	}
+	uint16_t apid = sp_find_apid(ppid, NULL);
+	if (sp_cached < sizeof(sp_cache) / sizeof(sp_cache[0])) {
+		sp_cache[sp_cached].ppid = (uint16_t)ppid;
+		sp_cache[sp_cached].apid = apid;
+		sp_cached++;
+	}
+	return apid;
+}
+
+/* 0 done, -1 error/denied, -2 timeout (the lane is poisoned) */
+static int
+sp_wait(vm_offset_t ch, uint16_t apid)
+{
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t s = sp_rd(ch, SP_STATUS);
+		if (s & SP_DONE) {
+			return (s & SP_ERRORS) ? -1 : 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	return -2;
+}
