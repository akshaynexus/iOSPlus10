+int
+negroni_spmi_write(unsigned sid, unsigned addr, uint8_t value)
+{
+	/* ADC7 user registers of the PMK8350 VADC only; 0x3146 (EN_CTL1) is not written */
+	if (!sp_ready || !sp_vadc_writable || sid != 0 || addr < 0x3140 || addr > 0x3147 || addr == 0x3146 ||
+	    sp_poisoned[sp_vadc_apid]) {
+		return -1;
