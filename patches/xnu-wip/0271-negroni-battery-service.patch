+/* Absolute channel: the pre-scaled quantity in micro-units (uV, or uA for the current channels). */
+bool
+NegroniBattery::adcMicro(const nb_chan &c, int64_t *value)
+{
+	uint16_t code;
+	if (adcCode(c, &code)) {
+		return false;
+	}
+	int64_t uv = code > 0x7fff ? 0 : (int64_t)code * 1875 * 1000 / ADC_FULL_SCALE;
+	*value = uv * c.den / c.num;
+	return true;
+}
