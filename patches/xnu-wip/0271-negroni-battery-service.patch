+/* Ratiometric 100 k NTC channel -> hundredths of a degree C (Linux qcom_vadc7_scale_hw_calib_therm). */
+bool
+NegroniBattery::adcTemp(const nb_chan &c, int *centiC)
+{
+	uint16_t code;
+	if (adcCode(c, &code) || code == 0 || code >= ADC_RATIO_MAX) {
+		return false;
+	}
+	int64_t r = (int64_t)code * 100000 / (ADC_RATIO_MAX - code);
+	const unsigned n = sizeof(kNtc) / sizeof(kNtc[0]);
+	if (r >= kNtc[0].r || r <= kNtc[n - 1].r) {
+		return false;                                     /* outside -20..82 C: not trusted */
+	}
