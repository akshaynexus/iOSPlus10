Stock clang 16+ makes -Wincompatible-pointer-types an error. topaz 0002 (UIO_STACKBUF backport)
declares uio_buf as uint64_t[]; nfsrv_readlink takes a char * from it. Apple clang 15 only warns.
Same code, explicit cast. Linux build only (scripts/laurel/kernel-linux.sh).
--- a/bsd/nfs/nfs_serv.c
+++ b/bsd/nfs/nfs_serv.c
@@ -770,7 +770,7 @@
 	mbuf_t mpath, mp;
 	uio_t auio = NULL;
 	UIO_STACKBUF(uio_buf, 4);
-	char *uio_bufp = &uio_buf[0];
+	char *uio_bufp = (char *)&uio_buf[0];
 	int uio_buflen = UIO_SIZEOF(4);
 
 	error = 0;
@@ -886,7 +886,7 @@
 	if (mpath) {
 		mbuf_freem(mpath);
 	}
-	if (uio_bufp != &uio_buf[0]) {
+	if (uio_bufp != (char *)&uio_buf[0]) {
 		kfree_data(uio_bufp, uio_buflen);
 	}
 	if (error) {
