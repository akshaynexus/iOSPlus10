@@ -24,13 +24,16 @@ gMemoryDescriptor[] = {
   {"Info Blk",          0x5FFFF000, 0x00001000, AddMem, SYS_MEM, SYS_MEM_CAP, RtData, WRITE_BACK_XN},
   {"WtShareMem",        0x62000000, 0x00100000, AddMem, SYS_MEM, SYS_MEM_CAP, Reserv, WRITE_THROUGH_XN},
   {"DXE Heap",          0x62100000, 0x03C00000, AddMem, SYS_MEM, SYS_MEM_CAP, Conv,   WRITE_BACK},
-  // iOSPlus10 laurel-sprout: conventional RAM for the DarwinBoot window (XNU): 0x80000000-0xC0000000 is above every
-  // fixed carve-out of this map, below 4 GiB (GPU buffers) and the range the topaz-shim boots ran XNU in. The region
-  // starts 16 MiB in (0x81000000, as negroni's 0x841000000): DarwinBoot puts the window at region + (kernel VA &
-  // 0x1FFFFF) = 0x81004000, so __TEXT (VA 0xFFFFFFF007004000) lands at the shim's PA 0x81004000 and the VA-PA delta
-  // stays a 32 MiB multiple. UEFI's own allocations go top-down from 0xC0000000; the ADT darwinboot-memory-size
-  // (768 MiB, window end 0xB1004000) leaves 240 MiB headroom.
-  {"Kernel RAM",        0x81000000, 0x3F000000, AddMem, SYS_MEM, SYS_MEM_CAP, Conv,   WRITE_BACK_XN},
+  // iOSPlus10 laurel-sprout, LATE layout (laurel mu late/0101, scripts/laurel/mu-build.sh MU_RAM_LAYOUT=late): the fallback
+  // when the static "Kernel RAM" 0xE1000000-0x1C0000000 (mu 0101) kills Mu (a Qualcomm DXE that cannot use RAM above 4 GiB).
+  // Early UEFI allocations stay below 4 GiB, in "UEFI RAM" 0x81000000-0x90000000 (240 MiB, the highest conventional RAM
+  // until RamManagerDxe runs). The device pools (GPU 0xC0000000 + 512 MiB, modem 0xE0000000 + 16 MiB) stay reserved.
+  // RamManagerDxe adds the bank C hole 0xE1000000-0x1C0000000 late, as one run: the DarwinBoot window 0xE1004000 +
+  // 3264 MiB, UEFI's later allocations top-down from 0x1C0000000. NegroniBootMemoryDxe adds DT holes only below
+  // 0xE1000000 (dsc NEGRONIMEM_ADD_BELOW), so it does not add 0xE1000000-0x100000000 early. Works on any RAM size.
+  {"Pool RAM Guard",    0x80000000, 0x01000000, AddMem, SYS_MEM, SYS_MEM_CAP, Reserv, WRITE_BACK_XN},
+  {"UEFI RAM",          0x81000000, 0x0F000000, AddMem, SYS_MEM, SYS_MEM_CAP, Conv,   WRITE_BACK_XN},
+  {"Pool RAM",          0x90000000, 0x51000000, AddMem, SYS_MEM, SYS_MEM_CAP, Reserv, WRITE_BACK_XN},
 
   // Other Memory Regions
   {"AOP_SS_MSG_RAM",    0x045F0000, 0x00007000, NoHob,  MMAP_IO, INITIALIZED, Conv,   NS_DEVICE},
