@@ -13,7 +13,11 @@
 #define MAX_RANGES        64
 #define MIN_PIECE_SIZE    SIZE_16MB
 #define ADD_LIMIT         SIZE_1GB
+#ifdef NEGRONIMEM_ADD_BELOW
+#define ADD_BELOW         NEGRONIMEM_ADD_BELOW   /* iOSPlus10 laurel mu late/0101: platform DSC limit */
+#else
 #define ADD_BELOW         SIZE_4GB
+#endif
 
 typedef struct {
   UINT64  Base;
