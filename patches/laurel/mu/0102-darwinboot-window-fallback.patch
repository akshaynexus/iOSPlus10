index ddb1fa8..b6d9121 100644
--- a/DarwinBootPkg/Driver/DarwinBoot.c
+++ b/DarwinBootPkg/Driver/DarwinBoot.c
@@ -396,10 +396,35 @@ DiagDraw (CONST CHAR16 *Text, UINTN Row)
   }
 }
 
+// iOSPlus10 laurel mu 0102. Two platform options (C defines from the platform DSC; without them DarwinBoot
+// behaves as before):
+//   DARWINBOOT_MAX_WINDOW  cap of the window (the kernel's bootstrap page tables map all of it);
+//   DARWINBOOT_LOW4G_MIN   a run is used only when the window starts below 4 GiB with at least this much of
+//                          it below 4 GiB (devices with 32-bit DMA need kernel RAM there).
+// When no run holds the asked window, the biggest window a usable run holds (2 MiB multiple, at least the
+// DarwinWindowSizeValid minimum) is taken and its size goes to the kernel (boot_args memSize): one line
+// "WINDOW <size> OF <asked> @ <base>" on the screen and the log. No usable run: "NO WINDOW" + the FREE list.
+#define DARWINBOOT_4G  0x100000000ULL
+
+STATIC
+BOOLEAN
+WindowRunUsable (UINT64 Candidate, UINT64 End)
+{
+  if (End <= Candidate) { return FALSE; }
+#ifdef DARWINBOOT_LOW4G_MIN
+  if (Candidate >= DARWINBOOT_4G) { return FALSE; }
+  if (MIN (End, DARWINBOOT_4G) - Candidate < DARWINBOOT_LOW4G_MIN) { return FALSE; }
+#endif
+  return TRUE;
+}
+
