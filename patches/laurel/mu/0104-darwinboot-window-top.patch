+    //
+    Top = DarwinWindowTop ((CONST UINT8 *)Map, MapSize, Stride, Address + WindowSize, TopMax);
+    Args->MemorySize = WindowSize + Top;
+    Args->MemorySizeActual = WindowSize + Top;
