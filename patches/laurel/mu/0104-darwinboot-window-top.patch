diff --git a/DarwinBootPkg/Driver/WindowTop.h b/DarwinBootPkg/Driver/WindowTop.h
--- a/DarwinBootPkg/Driver/WindowTop.h
+++ b/DarwinBootPkg/Driver/WindowTop.h
@@ -0,0 +1,67 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+// iOSPlus10 laurel mu 0104: the RAM right above the window that UEFI itself holds when boot services end.
+//
+// UEFI allocates top-down from the end of "Kernel RAM" (Mu laurel 0101): its loaded images, the DXE pool pages, the
+// page tables and DarwinBoot's own image sit above the window the ADT asks for (176 MiB on the Mi A3), and the ADT
+// planner left that room on purpose. After ExitBootServices every page of type EfiLoaderCode/Data,
+// EfiBootServicesCode/Data and EfiConventionalMemory is free (UEFI 2.10, 7.2 "Memory Allocation Services"): the kernel
+// may own it. DarwinEnter (Entry.S) turns the MMU off before the branch, so the firmware's page tables are not used
+// after it; the kernel builds its own. Runtime-services pages, reserved, ACPI, MMIO, persistent or unaccepted memory
+// and any descriptor with EFI_MEMORY_RUNTIME end the run: they are not taken.
+//
+// DarwinWindowTop walks the final memory map (the one ExitBootServices takes) from the window end and returns the
+// bytes of such memory contiguous with it, a 2 MiB multiple (the window is one), at most Max. No hardware access: the
+// host test (iOSPlus10 tools/darwinboot-top-test) runs this same text on fake maps.
+#ifndef DARWINBOOT_WINDOW_TOP_H
+#define DARWINBOOT_WINDOW_TOP_H
+
+#define DARWINBOOT_TOP_PAGE   0x1000ULL
+#define DARWINBOOT_TOP_BLOCK  0x200000ULL
+#define DARWINBOOT_TOP_RUNTIME (1ULL << 63)   /* EFI_MEMORY_RUNTIME */
+
+// EFI_MEMORY_DESCRIPTOR, read by offset: Type +0 (UINT32), PhysicalStart +8, VirtualStart +16, NumberOfPages +24, Attribute +32.
+static inline unsigned long long
+DarwinTopRead64 (const unsigned char *P)
+{
+  unsigned long long V = 0;
+  for (unsigned I = 0; I < 8; I++) { V |= (unsigned long long)P[I] << (8 * I); }
+  return V;
+}
+
+static inline int
+DarwinTopTypeFree (unsigned long long Type)
+{
+  // EfiLoaderCode 1, EfiLoaderData 2, EfiBootServicesCode 3, EfiBootServicesData 4, EfiConventionalMemory 7
+  return Type == 1 || Type == 2 || Type == 3 || Type == 4 || Type == 7;
+}
+
+static inline unsigned long long
+DarwinWindowTop (const unsigned char *Map, unsigned long long Size, unsigned long long Stride, unsigned long long End, unsigned long long Max)
+{
+  unsigned long long Start = End;
+  unsigned long long Count = (Stride >= 40 && Stride <= 4096 && Map != 0) ? Size / Stride : 0;
+  unsigned long long Steps;
+
+  if ((End & (DARWINBOOT_TOP_PAGE - 1)) != 0) { return 0; }
+  for (Steps = 0; Steps <= Count; Steps++) {
+    unsigned long long I;
+    int Grew = 0;
+    for (I = 0; I < Count; I++) {
+      const unsigned char *D = Map + I * Stride;
+      unsigned long long Type = DarwinTopRead64 (D) & 0xffffffffULL;
+      unsigned long long Phys = DarwinTopRead64 (D + 8);
+      unsigned long long Pages = DarwinTopRead64 (D + 24);
+      unsigned long long Attr = DarwinTopRead64 (D + 32);
+      if ((Phys != End) || (Pages == 0) || (Pages >= (~0ULL - End) / DARWINBOOT_TOP_PAGE)) { continue; }
+      if (!DarwinTopTypeFree (Type) || ((Attr & DARWINBOOT_TOP_RUNTIME) != 0)) { break; }
+      End += Pages * DARWINBOOT_TOP_PAGE;
+      Grew = 1;
+      break;
+    }
+    if (!Grew) { break; }
+  }
+  End -= (End - Start) & (DARWINBOOT_TOP_BLOCK - 1);
+  if (End - Start > Max) { End = Start + (Max & ~(DARWINBOOT_TOP_BLOCK - 1)); }
+  return End - Start;
+}
+#endif
