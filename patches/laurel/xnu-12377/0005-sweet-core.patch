diff --git a/osfmk/vm/vm_map_store.c b/osfmk/vm/vm_map_store.c
index a55d833..44a2919 100644
--- a/osfmk/vm/vm_map_store.c
+++ b/osfmk/vm/vm_map_store.c
@@ -711,15 +711,56 @@ vms_path_update_holes_eagerly(vms_path_t path, uint32_t pos, uint32_t mask)
  * This is done during EARLY_BOOT as it needs the corecrypto module to be
  * set up.
  */
+#if defined(SWEET)
+/*
+ * topaz 0013 on 12377 (the guard-object random moved here from vm_kern.c): no corecrypto kext registers
+ * g_crypto_funcs on SWEET. The contract permits a non-cryptographic generator and needs lock-free generation:
+ * per-CPU SplitMix64 (Sebastiano Vigna, 2015, public domain), seeded from the built-in early HMAC-SHA256 DRBG.
+ */
+struct sweet_kmem_rng {
+	uint64_t state;
+};
+
+static uint64_t
+sweet_kmem_random64(struct sweet_kmem_rng *rng)
+{
+	uint64_t value = (rng->state += 0x9e3779b97f4a7c15ULL);
+	value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ULL;
+	value = (value ^ (value >> 27)) * 0x94d049bb133111ebULL;
+	return value ^ (value >> 31);
+}
+
+static uint64_t
+sweet_kmem_uniform(struct sweet_kmem_rng *rng, uint64_t bound)
+{
+	assert(bound != 0);
+	/* Reject the incomplete residue interval to avoid modulo bias. */
+	const uint64_t threshold = -bound % bound;
+	uint64_t value;
+	do {
+		value = sweet_kmem_random64(rng);
+	} while (value < threshold);
+	return value % bound;
+}
+#endif /* SWEET */
+
 __startup_func
 static void
 vm_map_store_crypto_init(void)
 {
+#if defined(SWEET)
+	vm_size_t ctx_size = sizeof(struct sweet_kmem_rng);
+#else
 	vm_size_t ctx_size = crypto_random_kmem_ctx_size();
+#endif
 
 	ks_rng_ctx = zalloc_percpu_permanent(ctx_size, ZALIGN_PTR);
 	zpercpu_foreach(ctx, ks_rng_ctx) {
+#if defined(SWEET)
+		((struct sweet_kmem_rng *)ctx)->state = early_random();
+#else
 		crypto_random_kmem_init(ctx);
+#endif
 	}
 }
 STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, vm_map_store_crypto_init);
@@ -1115,7 +1156,11 @@ vmgo_chunk_select_random_slot(vm_guard_object_chunk_t chunk)
 		n = kmem_get_random16((uint16_t)free - 1);
 	} else {
 		disable_preemption();
+#if defined(SWEET)
+		n = sweet_kmem_uniform((struct sweet_kmem_rng *)zpercpu_get(ks_rng_ctx), free);
+#else
 		crypto_random_uniform(zpercpu_get(ks_rng_ctx), free, &n);
+#endif
 		enable_preemption();
 	}
 
