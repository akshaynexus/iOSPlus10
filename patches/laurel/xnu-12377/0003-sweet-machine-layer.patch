+#if defined(SWEET)
+/* Bring-up observer: the self-SGI clears SIGPdisabled after IRQs unmask. */
+boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
+boolean_t
+sweet_cpu_signal_is_enabled(unsigned int cpu)
+{
+	if (cpu >= MAX_CPUS) {
+		return FALSE;
+	}
+	cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
+	return cdp != NULL && !(os_atomic_load(&cdp->cpu_signal, acquire) & SIGPdisabled);
+}
+
+/*
+ * laurel: a secondary that never came up stays in PROCESSOR_START forever
+ * (processor_startup only marks OFF_LINE on x86). Put it back OFF_LINE so the
+ * scheduler never counts it, and end the state transition it began.
+ */
+void sweet_cpu_mark_offline(unsigned int cpu);
+void
+sweet_cpu_mark_offline(unsigned int cpu)
+{
+	processor_t processor = cpu >= MAX_CPUS ? PROCESSOR_NULL : processor_array[cpu];
+	if (processor == PROCESSOR_NULL || processor->processor_set == PROCESSOR_SET_NULL) {
+		return;
+	}
+	processor_set_t pset = processor->processor_set;
+	spl_t s = splsched();
+	pset_lock(pset);
+	if (processor->state == PROCESSOR_START) {
+		pset_update_processor_state(pset, processor, PROCESSOR_OFF_LINE);
+	}
+	pset_unlock(pset);
+	splx(s);
+	/*
+	 * laurel 2006: a core that began to run (cpu_running from cpu_init) but
+	 * never unmasked IRQs would still be a target of cpu_broadcast_xcall and
+	 * hang the caller for ever. Take it out of the IPI set as well.
+	 */
+	cpu_data_t *cdp = CpuDataEntries[cpu].cpu_data_vaddr;
+	if (cdp != NULL) {
+		cdp->cpu_running = FALSE;
+		os_atomic_or(&cdp->cpu_signal, SIGPdisabled, relaxed);
+	}
+	ml_cpu_end_state_transition(cpu);
+}
+#endif
