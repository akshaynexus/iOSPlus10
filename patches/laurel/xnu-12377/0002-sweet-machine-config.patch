diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 0dc88a6..e88b333 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -29,7 +29,7 @@ SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else ifneq ($(findstring _host,$(RC_ProjectName)),)
 SUPPORTED_ARM64_MACHINE_CONFIGS = NONE
 else
-SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE
+SUPPORTED_ARM64_MACHINE_CONFIGS = T6000 T6020 T6030 T6031 T6041 T6050 T8101 T8103 T8112 T8122 T8132 T8142 VMAPPLE SWEET
 
 SPTM_ENABLED_SOCS_MacOSX = t6000 t8112 t6020 t8122 t6030 t6031 t6041 t6050 t8132 t8142
 EXCLAVES_ENABLED_SOCS_MacOSX = t8142 t6050
@@ -93,6 +93,9 @@ MACHINE_FLAGS_ARM64_T8132 = -DARM64_BOARD_CONFIG_T8132			-mcpu=apple-m4
 MACHINE_FLAGS_ARM64_T8142 = -DARM64_BOARD_CONFIG_T8142 			-mcpu=apple-m4+memtag+predres2
 
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a+sme2
+# topaz: Cortex-A53/A73 are ARMv8.0 (no LSE atomics, RCpc, PAN or FP16). An explicit
+# -mcpu: -arch arm64 otherwise keeps clang's apple-m1 default and its LSE/RCpc features
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a53 $(if $(filter 1,$(TOPAZ_4K)),-DTOPAZ_4K=1)
 
 
 #
@@ -370,8 +373,11 @@ ifeq ($(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG),)
 # Without embdedded device map, use a default arch string
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := $(shell echo $(CURRENT_ARCH_CONFIG) | tr A-Z a-z)
 ifneq ($(filter arm64,$(ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG)),)
+# sweet's Cortex-A76/A55 have no pointer authentication: stay plain arm64
+ifneq ($(CURRENT_MACHINE_CONFIG),SWEET)
 export ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG := arm64e
 endif
+endif
 
 endif
 
@@ -446,6 +452,16 @@ ARM64_PLKSEG_ADDR  = 0xfffffe0004004000
 ARM64_LINK_ADDR    = 0xfffffe0007004000
 endif
 
+# topaz: TOPAZ_4K=1 in the environment builds SWEET with 4 KiB pages (the
+# Cortex-A53 silver cluster has no 16 KiB granule). TTBR1 then spans 39 bits:
+# the ARM_LARGE_MEMORY link address at -2 TiB is outside it, so use the
+# compact iOS kernel VA layout.
+ifeq ($(CURRENT_MACHINE_CONFIG)$(TOPAZ_4K),SWEET1)
+ARM64_LARGE_MEMORY = 0
+ARM64_PLKSEG_ADDR  = 0xfffffff004004000
+ARM64_LINK_ADDR    = 0xfffffff007004000
+endif
+
 
 ifeq ($(ARM64_LARGE_MEMORY),1)
 	ARM64_EXTRA_BUILD_FLAGS += -DARM_LARGE_MEMORY=1
