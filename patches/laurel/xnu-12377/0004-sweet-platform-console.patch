+/*****************************************************************************/
+
+/*
+ * sweet: framebuffer "serial" for boards with no usable UART (the Redmi Note
+ * 10 Pro's debug UART engine runs in SPI mode). kprintf output is drawn onto
+ * the boot framebuffer described by the ADT node "sweet-fbcon":
+ *   reg    = <phys size>       absolute physical address, not arm-io relative
+ *   width, height              pixels
+ *   stride                     bytes per line, 32bpp
+ * Lines wrap back to the top instead of scrolling; the line after the cursor
+ * is kept blank so the newest output is easy to find.
+ */
+
+extern unsigned char iso_font[256 * 16];
+
+#define FBCON_SCALE     2
+#define FBCON_FG        0xffffffffu
+#define FBCON_BG        0xff000000u
+
+static volatile uint32_t *fbcon_base;
+static uint32_t fbcon_width, fbcon_height, fbcon_stride;
+static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
+
+/*
+ * laurel 2870 (fbcon off the panel): with serial=3 (the laurel boot-args) this fbcon IS the kernel console
+ * (arm_init: serialmode output + a serial device -> cons_ops = serial; the video console gets no text), and it
+ * drew every printf/IOLog line straight into the boot framebuffer 0x5c000000. That buffer is AppleCLCD's
+ * surface 1: backboardd's GL copies every other frame into it and the MDP scans it directly (2104), so each
+ * kernel line was drawn into a frame on the panel (white text on black, 2x font): "the kernel log flashes over
+ * the UI when anything moves". AppleCLCD moves the fbcon into its console shadow at start (laurel_fbcon_retarget,
+ * a cached buffer that only the boot console frames and a panic show) and mutes it at the first iOS frame if it
+ * could not move it. A panic always draws and asks AppleCLCD to show the buffer (laurel_fbcon_show_hook).
+ */
+#define LAUREL_FBCON_REGISTERED 1
+#define LAUREL_FBCON_SHADOW     2
+#define LAUREL_FBCON_MUTED      4
+#define LAUREL_FBCON_CONSOLE    8
+static volatile int fbcon_dirty;        /* drawn since AppleCLCD last copied the shadow */
+static int fbcon_shadow;                /* draws into AppleCLCD's console shadow (cached) */
+static int fbcon_muted;                 /* no drawing (a panic draws) */
+void (*laurel_fbcon_show_hook)(void);
+extern void sweet_dcache_clean(vm_offset_t addr, unsigned length);     /* osfmk/arm/caches.c */
+extern boolean_t console_is_serial(void);
+int laurel_fbcon_retarget(vm_offset_t va, uint32_t width, uint32_t height, uint32_t stride);
+int laurel_fbcon_state(void);
+int laurel_fbcon_take_dirty(void);
+void laurel_fbcon_mute(void);
+
+/* a panic: the text must be in memory (the shadow is cached) and on the panel */
+static void
+fbcon_panic_show(uint32_t row)
+{
+	if (fbcon_shadow && row < fbcon_rows) {
+		sweet_dcache_clean((vm_offset_t)(uintptr_t)(fbcon_base + row * 16 * FBCON_SCALE * (fbcon_stride / 4)),
+		    16 * FBCON_SCALE * fbcon_stride);
+	}
+	if (laurel_fbcon_show_hook != NULL) {
+		laurel_fbcon_show_hook();
+	}
+}
+
+static void
+fbcon_clear_row(uint32_t row)
+{
+	for (uint32_t y = row * 16 * FBCON_SCALE; y < (row + 1) * 16 * FBCON_SCALE; y++) {
+		volatile uint32_t *line = fbcon_base + y * (fbcon_stride / 4);
+		for (uint32_t x = 0; x < fbcon_width; x++) {
+			line[x] = FBCON_BG;
+		}
+	}
+}
+
+static void
+fbcon_newline(void)
+{
+	fbcon_col = 0;
+	fbcon_row = (fbcon_row + 1) % fbcon_rows;
+	fbcon_clear_row(fbcon_row);
+	fbcon_clear_row((fbcon_row + 1) % fbcon_rows);
+	if (panic_active()) {
+		fbcon_panic_show(fbcon_row);
+		fbcon_panic_show((fbcon_row + 1) % fbcon_rows);
+	}
+}
+
+static void
+fbcon_init(void)
+{
+	fbcon_cols = fbcon_width / (8 * FBCON_SCALE);
+	fbcon_rows = fbcon_height / (16 * FBCON_SCALE);
+	fbcon_col = fbcon_row = 0;
+	for (uint32_t r = 0; r < fbcon_rows; r++) {
+		fbcon_clear_row(r);
+	}
+}
+
+static unsigned int
+fbcon_transmit_ready(void)
+{
+	return 1;
+}
+
+static void
+fbcon_transmit_data(uint8_t c)
+{
+	if (fbcon_muted && !panic_active()) {
+		return;                         /* laurel 2870: the text is in the USB log only */
+	}
+	fbcon_dirty = 1;
+	if (c == '\r') {
+		fbcon_col = 0;
+		return;
+	}
+	if (c == '\n') {
+		fbcon_newline();
+		return;
+	}
+	if (fbcon_col >= fbcon_cols) {
+		fbcon_newline();
+	}
+	const unsigned char *glyph = iso_font + c * 16;
+	uint32_t x0 = fbcon_col * 8 * FBCON_SCALE, y0 = fbcon_row * 16 * FBCON_SCALE;
+	for (uint32_t gy = 0; gy < 16; gy++) {
+		for (uint32_t sy = 0; sy < FBCON_SCALE; sy++) {
+			volatile uint32_t *line = fbcon_base + (y0 + gy * FBCON_SCALE + sy) * (fbcon_stride / 4) + x0;
+			for (uint32_t gx = 0; gx < 8; gx++) {
+				uint32_t px = (glyph[gy] & (1u << gx)) ? FBCON_FG : FBCON_BG;
+				for (uint32_t sx = 0; sx < FBCON_SCALE; sx++) {
+					line[gx * FBCON_SCALE + sx] = px;
+				}
+			}
+		}
+	}
+	fbcon_col++;
+	if (panic_active()) {
+		fbcon_panic_show(fbcon_row);
+	}
+}
+
+/*
+ * laurel 2870: AppleCLCD start. Draw from now on into va (its console shadow, same panel geometry), which already
+ * holds a copy of the boot framebuffer. Returns 0 when there is no fbcon.
+ */
+int
+laurel_fbcon_retarget(vm_offset_t va, uint32_t width, uint32_t height, uint32_t stride)
+{
+	if (fbcon_base == NULL || va == 0 || width < 8 * FBCON_SCALE || height < 2 * 16 * FBCON_SCALE ||
+	    stride < width * 4) {
+		return 0;
+	}
+	uint32_t rows = height / (16 * FBCON_SCALE), cols = width / (8 * FBCON_SCALE);
+	fbcon_width = width;
+	fbcon_height = height;
+	fbcon_stride = stride;
+	fbcon_cols = cols;
+	fbcon_rows = rows;
+	if (fbcon_row >= rows) {
+		fbcon_row = 0;
+	}
+	if (fbcon_col >= cols) {
+		fbcon_col = 0;
+	}
+	__asm__ volatile ("dmb ish" ::: "memory");
+	fbcon_base = (volatile uint32_t *)va;
+	fbcon_shadow = 1;
+	fbcon_dirty = 1;
+	return 1;
+}
+
+int
+laurel_fbcon_state(void)
+{
+	return (fbcon_base != NULL ? LAUREL_FBCON_REGISTERED : 0) | (fbcon_shadow ? LAUREL_FBCON_SHADOW : 0) |
+	       (fbcon_muted ? LAUREL_FBCON_MUTED : 0) |
+	       (fbcon_base != NULL && console_is_serial() ? LAUREL_FBCON_CONSOLE : 0);
+}
+
+/* AppleCLCD's vsync while the console frames are on the panel: anything drawn since the last call? */
+int
+laurel_fbcon_take_dirty(void)
+{
+	int d = fbcon_dirty;
+	fbcon_dirty = 0;
+	return d;
+}
+
+void
+laurel_fbcon_mute(void)
+{
+	fbcon_muted = 1;
+}
+
+static unsigned int
+fbcon_receive_ready(void)
+{
+	return 0;
+}
+
+static uint8_t
+fbcon_receive_data(void)
+{
+	return 0;
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) sweet_fbcon_serial_functions =
+{
+	.init = fbcon_init,
+	.transmit_ready = fbcon_transmit_ready,
+	.transmit_data = fbcon_transmit_data,
+	.receive_ready = fbcon_receive_ready,
+	.receive_data = fbcon_receive_data,
+	.device = SERIAL_SWEET_FBCON
+};
+
+static void
+fbcon_probe(void)
+{
+	DTEntry entry;
+	uint64_t const *reg;
+	uint32_t const *val;
+	unsigned int size;
+
+	if (SecureDTFindEntry("name", "sweet-fbcon", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "reg", (void const **)&reg, &size) != kSuccess || size < 16) {
+		return;
+	}
+	if (SecureDTGetProperty(entry, "width", (void const **)&val, &size) == kSuccess) {
+		fbcon_width = *val;
+	}
+	if (SecureDTGetProperty(entry, "height", (void const **)&val, &size) == kSuccess) {
+		fbcon_height = *val;
+	}
+	if (SecureDTGetProperty(entry, "stride", (void const **)&val, &size) == kSuccess) {
+		fbcon_stride = *val;
+	}
+	if (!fbcon_width || !fbcon_height || fbcon_stride < fbcon_width * 4) {
+		return;
+	}
+	sweet_early_mark(17, "fbcon config read; mapping");
+	fbcon_base = (volatile uint32_t *)ml_io_map_wcomb(reg[0], reg[1]);
+	sweet_early_mark(18, "fbcon mapping returned");
+	if (fbcon_base != NULL) {
+		register_serial_functions(&sweet_fbcon_serial_functions);
+	}
+}
+
