laurel 9027 (iOS 26): the sched_clutch.c hunks of laurel 3071 (LAUREL SCHED PLACE): the per-bucket preferred pset at sched_clutch_bucket_group_init, the E -> P edge with the weighted spill, and laurel_sched_place_start() at the end of sched_edge_cpu_init_completed (the line, the thread groups that exist); the base (0005) owns sched_clutch.c.

diff --git a/osfmk/kern/sched_clutch.c b/osfmk/kern/sched_clutch.c
index d046687..1f1cc2a 100644
--- a/osfmk/kern/sched_clutch.c
+++ b/osfmk/kern/sched_clutch.c
@@ -57,6 +57,19 @@
 
 #if CONFIG_SCHED_EDGE
 #include <kern/sched_amp_common.h>
+#include <kern/laurel_sched_place.h>   /* laurel 3071: LAUREL SCHED PLACE: the pset a QoS bucket prefers (host test scripts/laurel/test-sched-place.sh) */
+
+/*
+ * laurel 3071: LAUREL SCHED PLACE. Without CLPC every thread group prefers the boot pset (gold, 4 x A73) for every QoS bucket, and the
+ * E -> P edge forbids migration: silver (4 x A53) runs only what gold spills (weight 64 us) or what it steals. In the boot storm gold
+ * was 76 % busy with daemons while the UI's threads queued behind them (usblog 2026-11-07 05:21, `LAUREL CPU TOP` 367 s of 480).
+ * Here, as CLPC does on an iPhone: the utility and background buckets prefer the efficiency pset; fixed-priority, foreground,
+ * user-initiated and default keep gold. Both edges carry the weighted spill (64 us), so an idle cluster still takes the other's
+ * excess: no job and no QoS is limited to a cluster (owner 2026-11-03: use all cores fully). Set once in sched_edge_cpu_init_completed
+ * (every CPU registered, before launchd); thread groups made later take it at sched_clutch_bucket_group_init. Kill switch laurelschedplace=0.
+ */
+static pset_id_t laurel_place_bucket_pset[TH_BUCKET_SCHED_MAX];
+static bool laurel_place_set;
 #endif /* CONFIG_SCHED_EDGE */
 
 #if CONFIG_SCHED_CLUTCH
@@ -1401,7 +1414,8 @@ sched_clutch_bucket_group_init(
 
 	os_atomic_store(&clutch_bucket_group->scbg_timeshare_tick, 0, relaxed);
 	os_atomic_store(&clutch_bucket_group->scbg_pri_shift, INT8_MAX, relaxed);
-	os_atomic_store(&clutch_bucket_group->scbg_preferred_pset, sched_boot_pset->pset_id, relaxed);
+	os_atomic_store(&clutch_bucket_group->scbg_preferred_pset,
+	    laurel_place_set ? laurel_place_bucket_pset[bucket] : sched_boot_pset->pset_id, relaxed);     /* laurel 3071 */
 	/*
 	 * All thread groups should be initialized to be interactive; this allows the newly launched
 	 * thread groups to fairly compete with already running thread groups.
@@ -6341,6 +6355,37 @@ sched_edge_pset_made_schedulable(
  * Callback routine from the platform layer once all CPUs/psets have been initialized. This
  * provides an opportunity for the edge scheduler to initialize all the edge parameters.
  */
+/* laurel 3071: the per-bucket preference for every thread group that exists, and for the ones made later; one line */
+static void
+laurel_sched_place_tg(void *arg __unused, int i __unused, struct thread_group *tg)
+{
+	sched_edge_tg_preferred_pset_change(tg, laurel_place_bucket_pset,
+	    SCHED_PERFCONTROL_PREFERRED_PSET_MIGRATE_RUNNING | SCHED_PERFCONTROL_PREFERRED_PSET_MIGRATE_RUNNABLE);
+}
+
+static void
+laurel_sched_place_start(uint32_t arg, pset_id_t e_pset)
+{
+	pset_id_t p_pset = sched_boot_pset->pset_id;
+
+	if (arg == 0) {
+		printf("LAUREL SCHED PLACE: off: laurelschedplace=0 (every bucket prefers the boot pset %u, E -> P no spill)\n", p_pset);
+		return;
+	}
+	if (e_pset == p_pset) {
+		printf("LAUREL SCHED PLACE: off: no efficiency pset beside the boot pset %u (type %u, %d psets)\n", p_pset, sched_boot_pset->pset_type, sched_num_psets);
+		return;
+	}
+	for (sched_bucket_t b = 0; b < TH_BUCKET_SCHED_MAX; b++) {
+		laurel_place_bucket_pset[b] = (pset_id_t)lsp_pset_for_bucket(b, TH_BUCKET_SHARE_UT, TH_BUCKET_SHARE_BG, p_pset, e_pset);
+	}
+	laurel_place_set = true;
+	(void)thread_group_iterate_stackshot(laurel_sched_place_tg, NULL);
+	printf("LAUREL SCHED PLACE: on: utility and background threads prefer pset %u (%u CPUs), fixed-priority, foreground, user-initiated and default "
+	    "threads pset %u (%u CPUs); an idle cluster takes the other's excess (spill weight %u us both ways); %u thread groups set (kill switch laurelschedplace=0)\n",
+	    e_pset, pset_for_id(e_pset)->cpu_set_count, p_pset, sched_boot_pset->cpu_set_count, 64u, thread_group_count());
+}
+
 static void
 sched_edge_cpu_init_completed(void)
 {
@@ -6366,6 +6411,21 @@ sched_edge_cpu_init_completed(void)
 	edge_config_defaults[PSET_AMP_P][PSET_AMP_E] = weighted_spill;
 	/* E -> P */
 	edge_config_defaults[PSET_AMP_E][PSET_AMP_P] = no_spill;
+	/* laurel 3071: silver-preferred buckets spill to an idle gold as gold spills to silver */
+	pset_id_t laurel_place_e = sched_boot_pset->pset_id;
+	uint32_t laurel_place_arg = 1;
+	(void)PE_parse_boot_argn("laurelschedplace", &laurel_place_arg, sizeof(laurel_place_arg));
+	if (laurel_place_arg != 0 && sched_boot_pset->pset_type == PSET_AMP_P) {
+		for (pset_id_t id = 0; id < sched_num_psets; id++) {
+			if (pset_for_id(id)->pset_type == PSET_AMP_E) {
+				laurel_place_e = id;
+				break;
+			}
+		}
+	}
+	if (laurel_place_e != sched_boot_pset->pset_id) {
+		edge_config_defaults[PSET_AMP_E][PSET_AMP_P] = weighted_spill;
+	}
 #if HAS_MCORE
 	/* M -> M */
 	edge_config_defaults[PSET_AMP_M][PSET_AMP_M] = free_spill;
@@ -6467,6 +6527,7 @@ sched_edge_cpu_init_completed(void)
 	assert(sched_edge_config_verify());
 #endif /* DEVELOPMENT || DEBUG */
 	splx(s);
+	laurel_sched_place_start(laurel_place_arg, laurel_place_e);
 }
 
 static bool
