laurel 9026 (iOS 26): the laurel_abi.c hunks of laurel 3070 (LAUREL EMU SITES): les_note() on every served word, the sites line after the counts line, the on/off line and the kill switch laurelemusites=0; post/9000 makes laurel_abi.c.

diff --git a/osfmk/arm64/laurel_abi.c b/osfmk/arm64/laurel_abi.c
index 178316c..4cc99d1 100644
--- a/osfmk/arm64/laurel_abi.c
+++ b/osfmk/arm64/laurel_abi.c
@@ -58,7 +58,11 @@ static const char *const laurel_emu_names[A64E_NCLASS] = {
 	"pac", "lse", "casp", "rcpc", "fp16", "fcma", "dotprod", "jscvt", "fhm", "sha3", "rdm", "sysreg"
 };
 
+#include "laurel_emu_sites.h"  /* laurel 3070: LAUREL EMU SITES: the served words by site (host test scripts/laurel/test-emu-sites.sh) */
+
 static bool laurel_emu_on;
+static bool laurel_emu_sites_on = true;         /* laurel 3070 */
+static struct les_table laurel_emu_sites __attribute__((aligned(64)));
 static uint32_t laurel_emu_off;
 static uint64_t laurel_emu_count[A64E_NCLASS] __attribute__((aligned(64)));
 static uint64_t laurel_emu_unknown, laurel_emu_faults, laurel_emu_retries;
@@ -91,6 +95,16 @@ laurel_abi_init(void)
 	nanoseconds_to_absolutetime(LAUREL_EMU_REPORT_S * NSEC_PER_SEC, &laurel_emu_interval);
 	laurel_emu_on = true;
 	printf("LAUREL EMU: on: classes off 0x%x, %d classes, report every %d s\n", laurel_emu_off, A64E_NCLASS, LAUREL_EMU_REPORT_S);
+	/* laurel 3070 */
+	uint32_t sites = 1;
+	(void) PE_parse_boot_argn("laurelemusites", &sites, sizeof(sites));
+	laurel_emu_sites_on = sites != 0;
+	if (laurel_emu_sites_on) {
+		printf("LAUREL EMU SITES: on: the %u hottest served words of each minute, by process, user pc, pc with the dyld slide off, word and class; "
+		    "%u slots, %u tried per pc (kill switch laurelemusites=0)\n", LES_TOP, LES_N, LES_PROBE);
+	} else {
+		printf("LAUREL EMU SITES: off: laurelemusites=0 (the counts line stays)\n");
+	}
 }
 STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, laurel_abi_init);
 
@@ -107,6 +121,20 @@ laurel_emu_report(void)
 	    laurel_emu_count[A64E_FP16], laurel_emu_count[A64E_FCMA], laurel_emu_count[A64E_DOTPROD], laurel_emu_count[A64E_JSCVT],
 	    laurel_emu_count[A64E_FHM], laurel_emu_count[A64E_SHA3], laurel_emu_count[A64E_RDM], laurel_emu_count[A64E_SYSREG],
 	    laurel_emu_unknown, laurel_emu_faults, laurel_emu_retries);
+	if (laurel_emu_sites_on) {
+		/* laurel 3070: the hottest sites of the minute; the pc with the slide off is the cache address the tools read (scripts/laurel/ios26-emu-sites.py) */
+		unsigned top[LES_TOP], used = 0;
+		uint64_t delta[LES_TOP];
+		unsigned n = les_top(&laurel_emu_sites, top, delta, &used);
+		char line[400];
+		int at = 0;
+		for (unsigned i = 0; i < n && at < (int)sizeof(line) - 80; i++) {
+			const struct les_site *s = &laurel_emu_sites.s[top[i]];
+			at += scnprintf(line + at, sizeof(line) - at, "%s%s %llu %s pc 0x%llx unslid 0x%llx word 0x%08x", i ? "; " : "",
+			    s->cls < A64E_NCLASS ? laurel_emu_names[s->cls] : "?", delta[i], s->comm[0] ? s->comm : "?", s->pc, s->unslid, s->word);
+		}
+		printf("LAUREL EMU: sites: %s; other %llu; %u of %u slots\n", n ? line : "none", laurel_emu_sites.other, used, LES_N);
+	}
 }
 
 /* Returns only if the word should run again. */
@@ -163,6 +191,12 @@ laurel_abi_trap(arm_saved_state_t *state, uint32_t word)
 		/* the kernel's exclusive pair is over; no monitor state goes back to EL0 (no clrex in locore.s, this path says it itself) */
 		__asm__ volatile ("clrex");
 		os_atomic_inc(&laurel_emu_count[o.cls], relaxed);
+		if (laurel_emu_sites_on) {
+			/* laurel 3070: the site; the name and the cache slide of the task are stored when its slot is first claimed */
+			task_t task = current_task();
+			les_note(&laurel_emu_sites, get_saved_state_pc(state), word, (uint8_t)o.cls, proc_name_address(get_bsdtask_info(task)),
+			    task->task_shared_region_slide);
+		}
 		laurel_emu_report();
 		return true;
 	case A64EMU_UNKNOWN:
