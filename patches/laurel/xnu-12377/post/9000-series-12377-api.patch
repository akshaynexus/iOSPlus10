 extern "C" {
+/*
+ * LAUREL CE: CoreEntitlements V2 DER blobs (CSSLOT_DER_ENTITLEMENTS), for signatures with no XML blob. xnu-12377 asks the closed
+ * CoreEntitlements library (libCoreEntitlements) only under CODE_SIGNING_MONITOR and PMAP_CS, both off here, so the queries of this
+ * kernel all reach this object: a DER blob becomes the same OSDictionary as an XML blob.
+ * Format: [APPLICATION 16] { INTEGER 1, [CONTEXT 16] { SEQUENCE { UTF8String key, value } ... } };
+ * value = BOOLEAN | INTEGER | UTF8String | SEQUENCE (array) | [CONTEXT 16] (dictionary). One line at the first DER blob;
+ * kill switch laurelce=0: DER-only signatures get no entitlements, as before.
+ */
+#define LAUREL_DER_DEPTH 8
+
+static bool
+laurel_der_tlv(const uint8_t **p, const uint8_t *end, uint8_t *tag, const uint8_t **val, size_t *len)
+{
+	const uint8_t *q = *p;
+	if (end - q < 2) {
+		return false;
+	}
+	*tag = *q++;
+	size_t n = *q++;
+	if (n & 0x80) {
+		unsigned k = n & 0x7F;
+		if (k == 0 || k > 4 || (size_t)(end - q) < k) {
+			return false;
+		}
+		n = 0;
+		while (k--) {
+			n = (n << 8) | *q++;
+		}
+	}
+	if ((size_t)(end - q) < n) {
+		return false;
+	}
+	*val = q;
+	*len = n;
+	*p = q + n;
+	return true;
+}
+
+static OSObject *laurel_der_value(uint8_t tag, const uint8_t *v, size_t n, int depth);
+
+static OSDictionary *
+laurel_der_dict(const uint8_t *v, size_t n, int depth)
+{
+	OSDictionary *d = OSDictionary::withCapacity(8);
+	const uint8_t *p = v, *end = v + n;
+	while (d != NULL && p < end) {
+		uint8_t tag, ktag, vtag;
+		const uint8_t *seq, *key, *val;
+		size_t slen, klen, vlen;
+		if (!laurel_der_tlv(&p, end, &tag, &seq, &slen) || tag != 0x30) {
+			OSSafeReleaseNULL(d);
+			break;
+		}
+		const uint8_t *q = seq, *qend = seq + slen;
+		if (!laurel_der_tlv(&q, qend, &ktag, &key, &klen) || ktag != 0x0C || klen == 0 || klen > 1024 ||
+		    !laurel_der_tlv(&q, qend, &vtag, &val, &vlen)) {
+			OSSafeReleaseNULL(d);
+			break;
+		}
+		OSObject *o = laurel_der_value(vtag, val, vlen, depth + 1);
+		char *name = (char *)kalloc_data(klen + 1, Z_WAITOK);
+		if (o == NULL || name == NULL) {
+			OSSafeReleaseNULL(o);
+			if (name != NULL) {
+				kfree_data(name, klen + 1);
+			}
+			OSSafeReleaseNULL(d);
+			break;
+		}
+		memcpy(name, key, klen);
+		name[klen] = '\0';
+		d->setObject(name, o);
+		o->release();
+		kfree_data(name, klen + 1);
+	}
+	return d;
+}
+
+static OSObject *
+laurel_der_value(uint8_t tag, const uint8_t *v, size_t n, int depth)
+{
+	if (depth > LAUREL_DER_DEPTH) {
+		return NULL;
+	}
+	switch (tag) {
+	case 0x01:
+		if (n != 1) {
+			return NULL;
+		}
+		return v[0] ? kOSBooleanTrue : kOSBooleanFalse;
+	case 0x02: {
+		if (n == 0 || n > 8) {
+			return NULL;
+		}
+		int64_t x = (v[0] & 0x80) ? -1 : 0;
+		for (size_t i = 0; i < n; i++) {
+			x = (int64_t)(((uint64_t)x << 8) | v[i]);
+		}
+		return OSNumber::withNumber((unsigned long long)x, 64);
+	}
+	case 0x0C: {
+		char *s = (char *)kalloc_data(n + 1, Z_WAITOK);
+		if (s == NULL) {
+			return NULL;
+		}
+		memcpy(s, v, n);
+		s[n] = '\0';
+		OSString *str = OSString::withCString(s);
+		kfree_data(s, n + 1);
+		return str;
+	}
+	case 0x30: {
+		OSArray *a = OSArray::withCapacity(4);
+		const uint8_t *p = v, *end = v + n;
+		while (a != NULL && p < end) {
+			uint8_t t;
+			const uint8_t *e;
+			size_t l;
+			if (!laurel_der_tlv(&p, end, &t, &e, &l)) {
+				OSSafeReleaseNULL(a);
+				break;
+			}
+			OSObject *o = laurel_der_value(t, e, l, depth + 1);
+			if (o == NULL) {
+				OSSafeReleaseNULL(a);
+				break;
+			}
+			a->setObject(o);
+			o->release();
+		}
+		return a;
+	}
+	case 0xB0:
+		return laurel_der_dict(v, n, depth);
+	default:
+		return NULL;
+	}
+}
+
+static OSDictionary *
+laurel_der_entitlements(const uint8_t *v, size_t n)
+{
+	const uint8_t *p = v, *end = v + n, *top, *q, *ver, *dict;
+	uint8_t tag;
+	size_t toplen, verlen, dictlen;
+	if (!laurel_der_tlv(&p, end, &tag, &top, &toplen) || tag != 0x70) {
+		return NULL;
+	}
+	q = top;
+	if (!laurel_der_tlv(&q, top + toplen, &tag, &ver, &verlen) || tag != 0x02 || verlen != 1 || ver[0] != 1) {
+		return NULL;
+	}
+	if (!laurel_der_tlv(&q, top + toplen, &tag, &dict, &dictlen) || tag != 0xB0) {
+		return NULL;
+	}
+	return laurel_der_dict(dict, dictlen, 0);
+}
+
+/* -1: not checked, 0: off, 1: on. Self-check: a known blob { "a" = true, "b" = "c" } gives the right dictionary. */
+static int laurel_ce_state = -1;
+
+static bool
+laurel_ce_ready(void)
+{
+	if (laurel_ce_state >= 0) {
+		return laurel_ce_state == 1;
+	}
+	uint32_t on = 1;
+	(void) PE_parse_boot_argn("laurelce", &on, sizeof(on));
+	if (!on) {
+		printf("LAUREL CE: off: boot-arg laurelce=0: DER-only signatures get no entitlements\n");
+		laurel_ce_state = 0;
+		return false;
+	}
+	static const uint8_t good[] = {
+		0x70, 0x15, 0x02, 0x01, 0x01, 0xB0, 0x10,
+		0x30, 0x06, 0x0C, 0x01, 'a', 0x01, 0x01, 0xFF,
+		0x30, 0x06, 0x0C, 0x01, 'b', 0x0C, 0x01, 'c',
+	};
+	OSDictionary *d = laurel_der_entitlements(good, sizeof(good));
+	bool ok = d != NULL && d->getObject("a") == kOSBooleanTrue;
+	if (ok) {
+		OSString *s = OSDynamicCast(OSString, d->getObject("b"));
+		ok = s != NULL && s->isEqualTo("c");
+	}
+	OSSafeReleaseNULL(d);
+	laurel_ce_state = ok ? 1 : 0;
+	printf("LAUREL CE: %s: DER entitlements for signatures with no XML blob\n", ok ? "on" : "off: parser self-check failed");
+	return ok;
+}
+
 /* Parsed entitlements for one XML blob (header included), or NULL. Retained. */
+/* Parsed entitlements for one DER blob (header included), or NULL. Retained. No XML: csops gives the DER blob itself. */
+extern "C" void *
+laurel_entitlements_create_der(const CS_GenericBlob *blob, size_t blob_len)
+{
+	if (blob == NULL || blob_len <= sizeof(CS_GenericBlob) ||
+	    ntohl(blob->magic) != CSMAGIC_EMBEDDED_DER_ENTITLEMENTS || ntohl(blob->length) != blob_len || !laurel_ce_ready()) {
+		return NULL;
+	}
+	OSDictionary *dict = laurel_der_entitlements((const uint8_t *)blob->data, blob_len - sizeof(CS_GenericBlob));
+	if (dict == NULL) {
+		return NULL;
+	}
+	SweetEntitlements *ent = OSTypeAlloc(SweetEntitlements);
+	if (ent == NULL || !ent->init()) {
+		OSSafeReleaseNULL(ent);
+		dict->release();
+		return NULL;
+	}
+	ent->dict = dict;
+	ent->xml = NULL;
+	ent->xml_len = 0;
+	return ent;
+}
+
