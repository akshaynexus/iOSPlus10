+ * laurel_abi.c: the Mi A3 kernel (Kryo 260, ARMv8.0, no PAC) runs the arm64e-derived iOS 26 userland.
+ *
+ * LAUREL PACEMU: the userland lowering (scripts of the userland port) rewrites most PAC instructions; hint-space ones
+ * (PACIBSP, AUTIBSP, XPACLRI ...) are NOPs on this CPU anyway. An instruction outside the hint space that is left in a
+ * binary traps as undefined. handle_uncategorized (sleh.c) calls laurel_abi_emulate() for a user trap: it runs the
+ * instruction without the authentication, as all user pointers are plain here (the shared region slide, vm_shared_region.c,
+ * writes auth rebases as plain pointers). Also LDAPUR and STLUR (A13 code, ARMv8.4); LSE and LDAPR stay with topaz 0081.
+ * One line at the first use; kill switch laurelpacemu=0: the trap goes on as EXC_BAD_INSTRUCTION.
+ */
+#include <pexpert/pexpert.h>
+#include <arm64/proc_reg.h>
+#include <kern/debug.h>
+#include <kern/misc_protos.h>
+#include <libkern/OSAtomic.h>
+#include <mach/arm/thread_status.h>
+#include <arm/thread.h>
+#include <machine/atomic.h>
+#include <sys/errno.h>
+
+bool laurel_abi_emulate(arm_saved_state_t *state, uint32_t instr);
+
+enum { LP_UNKNOWN = 0, LP_RET, LP_BR, LP_BLR, LP_LDRA, LP_NOP_REG, LP_XPAC, LP_PACGA, LP_LDAPUR, LP_STLUR };
+
+/* What the encoding is; a pure function, so the first use can check itself. */
+static int
+laurel_abi_classify(uint32_t i)
+{
+	if (i == 0xD65F0BFF || i == 0xD65F0FFF) {
+		return LP_RET;          /* RETAA RETAB */
+	}
+	if ((i & 0xFFFFFBE0) == 0xD71F0800 || (i & 0xFFFFFBE0) == 0xD61F0800) {
+		return LP_BR;           /* BRAA BRAB BRAAZ BRABZ: Rm in bits 0-4 (31 for the Z form) */
+	}
+	if ((i & 0xFFFFFBE0) == 0xD73F0800 || (i & 0xFFFFFBE0) == 0xD63F0800) {
+		return LP_BLR;
+	}
+	if ((i & 0xFFFFFC00) == 0xD71F0800 || (i & 0xFFFFFC00) == 0xD61F0800) {
+		return LP_BR;
+	}
+	if ((i & 0xFFFFFC00) == 0xD73F0800 || (i & 0xFFFFFC00) == 0xD63F0800) {
+		return LP_BLR;
+	}
+	if ((i & 0xFF200400) == 0xF8200400) {
+		return LP_LDRA;         /* LDRAA LDRAB, with or without writeback */
+	}
+	if ((i & 0xFFFFC000) == 0xDAC10000) {
+		return LP_NOP_REG;      /* PACIA...AUTDB, PACIZA...AUTDZB: the pointer stays as it is */
+	}
+	if ((i & 0xFFFFFBE0) == 0xDAC143E0) {
+		return LP_XPAC;         /* XPACI XPACD: a plain pointer has no signature to strip */
+	}
+	if ((i & 0xFFE0FC00) == 0x9AC03000) {
+		return LP_PACGA;
+	}
+	if ((i & 0x3FE00C00) == 0x19400000) {
+		return LP_LDAPUR;
+	}
+	if ((i & 0x3FE00C00) == 0x19000000) {
+		return LP_STLUR;
+	}
+	return LP_UNKNOWN;
+}
+
+/* -1: not checked yet, 0: off, 1: on */
+static int laurel_abi_state = -1;
+
+static bool
+laurel_abi_ready(void)
+{
+	if (__probable(laurel_abi_state >= 0)) {
+		return laurel_abi_state == 1;
+	}
+	uint32_t on = 1;
+	(void) PE_parse_boot_argn("laurelpacemu", &on, sizeof(on));
+	if (!on) {
+		printf("LAUREL PACEMU: off: boot-arg laurelpacemu=0\n");
+		laurel_abi_state = 0;
+		return false;
+	}
+	/* self-check: the decoder gives the architecture's encodings the right class; a plain ADD stays unknown */
+	static const struct {
+		uint32_t i;
+		int c;
+	} t[] = {
+		{0xD65F0FFF, LP_RET}, {0xD71F0C41, LP_BR}, {0xD63F081F, LP_BLR}, {0xF8200420, LP_LDRA},
+		{0xDAC10020, LP_NOP_REG}, {0xDAC133E0, LP_NOP_REG}, {0xDAC143E0, LP_XPAC}, {0x9AC23020, LP_PACGA},
+		{0xD9400020, LP_LDAPUR}, {0xD9000020, LP_STLUR}, {0x8B000000, LP_UNKNOWN},
+	};
+	for (unsigned k = 0; k < sizeof(t) / sizeof(t[0]); k++) {
+		if (laurel_abi_classify(t[k].i) != t[k].c) {
+			printf("LAUREL PACEMU: off: decoder self-check failed at 0x%08x\n", t[k].i);
+			laurel_abi_state = 0;
+			return false;
+		}
+	}
+	printf("LAUREL PACEMU: on: PAC, LDAPUR and STLUR from user code run without authentication\n");
+	laurel_abi_state = 1;
+	return true;
+}
+
+static uint64_t
+laurel_reg(arm_saved_state_t *state, uint32_t r, bool sp31)
+{
+	if (r == 31) {
+		return sp31 ? get_saved_state_sp(state) : 0;
+	}
+	return get_saved_state_reg(state, r);
+}
+
+bool
+laurel_abi_emulate(arm_saved_state_t *state, uint32_t i)
+{
+	int c = laurel_abi_classify(i);
+	uint32_t rn = (i >> 5) & 31, rd = i & 31, rm = (i >> 16) & 31;
+	uint64_t pc = get_saved_state_pc(state);
+
+	if (c == LP_UNKNOWN || !laurel_abi_ready()) {
+		return false;
+	}
+	switch (c) {
+	case LP_RET:
+		set_saved_state_pc(state, get_saved_state_lr(state));
+		return true;
+	case LP_BLR:
+		set_saved_state_lr(state, pc + 4);
+		OS_FALLTHROUGH;
+	case LP_BR:
+		set_saved_state_pc(state, laurel_reg(state, rn, false));
+		return true;
+	case LP_LDRA: {
+		/* S:imm9 scaled by 8 */
+		int64_t off = (int64_t)(((uint64_t)((i >> 22) & 1) << 9) | ((i >> 12) & 0x1FF));
+		if (off & 0x200) {
+			off -= 0x400;
+		}
+		off *= 8;
+		uint64_t ea = laurel_reg(state, rn, true) + (uint64_t)off, v = 0;
+		if (copyin((user_addr_t)ea, &v, 8) != 0) {
+			return false;
+		}
+		if (i & (1u << 11)) {   /* W: writeback, before the load result */
+			if (rn == 31) {
+				set_saved_state_sp(state, ea);
+			} else {
+				set_saved_state_reg(state, rn, ea);
+			}
+		}
+		if (rd != 31) {
+			set_saved_state_reg(state, rd, v);
+		}
+		break;
+	}
+	case LP_NOP_REG:
+	case LP_XPAC:
+		break;
+	case LP_PACGA:
+		/* a stable hash for a compare inside the same process: bits 32-63 of Xn ^ Xm */
+		if (rd != 31) {
+			set_saved_state_reg(state, rd,
+			    (laurel_reg(state, rn, false) ^ laurel_reg(state, rm, true) ^ 0x5A5A5A5A00000000ULL) & 0xFFFFFFFF00000000ULL);
+		}
+		break;
+	case LP_LDAPUR:
+	case LP_STLUR: {
+		uint32_t size = 1u << (i >> 30);
+		int64_t off = (int64_t)((i >> 12) & 0x1FF);
+		if (off & 0x100) {
+			off -= 0x200;
+		}
+		uint64_t ea = laurel_reg(state, rn, true) + (uint64_t)off, v = 0;
+		__builtin_arm_dmb(DMB_ISH);
+		if (c == LP_LDAPUR) {
+			if (copyin((user_addr_t)ea, &v, size) != 0) {
+				return false;
+			}
+			if (rd != 31) {
+				set_saved_state_reg(state, rd, v);
+			}
+		} else {
+			v = laurel_reg(state, rd, false);
+			if (copyout(&v, (user_addr_t)ea, size) != 0) {
+				return false;
+			}
+		}
+		__builtin_arm_dmb(DMB_ISH);
+		break;
+	}
+	default:
+		return false;
+	}
+	add_saved_state_pc(state, 4);
+	return true;
+}
