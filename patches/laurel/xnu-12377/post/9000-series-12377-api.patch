+#if defined(TOPAZ_4K)
+/*
+ * LAUREL SLIDE: slide info v5 has 16 KiB slide pages; this kernel has 4 KiB VM pages. A pointer chain starts at the slide page start and runs over all of it, so one
+ * 4 KiB page cannot slide alone. Read the whole slide page (each 4 KiB page through the normal fault path, with its signature state), slide the copy,
+ * keep the requested page. The same slide page gives the same bytes, so a request for its other pages reuses the copy.
+ */
+#define LAUREL_SLIDE_SUB    (PAGE_SIZE_FOR_SR_SLIDE_16KB / PAGE_SIZE)
+
+static kern_return_t
+laurel_slide_read_sub(
+	shared_region_pager_t pager,
+	vm_object_t src_top_object,
+	vm_object_offset_t backing_offset,
+	char *dst,
+	struct vm_object_fault_info *fault_info,
+	int interruptible,
+	int *validated,
+	int *tainted,
+	int *nx)
+{
+	vm_fault_return_t vmfr;
+	kern_return_t error_code;
+	vm_prot_t prot;
+	vm_page_t src_page, top_page;
+	vm_object_t src_page_object;
+
+	(void)pager;
+retry:
+	vm_page_grab_prime();
+	vm_object_lock(src_top_object);
+	vm_object_paging_begin(src_top_object);
+	error_code = 0;
+	prot = VM_PROT_READ;
+	src_page = VM_PAGE_NULL;
+	vmfr = vm_fault_page(src_top_object, backing_offset, VM_PROT_READ, FALSE, FALSE,
+	    &prot, &src_page, &top_page, NULL, &error_code, FALSE, fault_info, NULL);
+	switch (vmfr) {
+	case VM_FAULT_SUCCESS:
+		break;
+	case VM_FAULT_RETRY:
+		goto retry;
+	case VM_FAULT_MEMORY_SHORTAGE:
+		if (vm_page_wait(interruptible)) {
+			goto retry;
+		}
+		OS_FALLTHROUGH;
+	case VM_FAULT_INTERRUPTED:
+		return MACH_SEND_INTERRUPTED;
+	case VM_FAULT_SUCCESS_NO_VM_PAGE:
+		vm_object_paging_end(src_top_object);
+		vm_object_unlock(src_top_object);
+		OS_FALLTHROUGH;
+	case VM_FAULT_MEMORY_ERROR:
+		return error_code ? error_code : KERN_MEMORY_ERROR;
+	case VM_FAULT_BUSY:
+		return KERN_ALREADY_WAITING;
+	}
+	assert(src_page != VM_PAGE_NULL);
+	src_page_object = VM_PAGE_OBJECT(src_page);
+	if (src_page->vmp_q_state != VM_PAGE_ON_SPECULATIVE_Q) {
+		vm_page_lockspin_queues();
+		if (src_page->vmp_q_state != VM_PAGE_ON_SPECULATIVE_Q) {
+			vm_page_speculate(src_page, FALSE);
+		}
+		vm_page_unlock_queues();
+	}
+	vm_offset_t src_vaddr = (vm_offset_t)phystokv((pmap_paddr_t)VM_PAGE_GET_PHYS_PAGE(src_page) << PAGE_SHIFT);
+	if (src_page_object->code_signed) {
+		vm_page_validate_cs_mapped(src_page, PAGE_SIZE, 0, (const void *)src_vaddr);
+	}
+	*validated = src_page->vmp_cs_validated;
+	*tainted = src_page->vmp_cs_tainted;
+	*nx = src_page->vmp_cs_nx;
+	vm_object_unlock(src_page_object);
+	bcopy((const char *)src_vaddr, dst, PAGE_SIZE);
+	vm_object_lock(src_page_object);
+	vm_page_wakeup_done(src_page_object, src_page);
+	vm_object_paging_end(src_page_object);
+	vm_object_unlock(src_page_object);
+	if (top_page != VM_PAGE_NULL) {
+		vm_object_lock(src_top_object);
+		VM_PAGE_FREE(top_page);
+		vm_object_paging_end(src_top_object);
+		vm_object_unlock(src_top_object);
+	}
+	return KERN_SUCCESS;
+}
