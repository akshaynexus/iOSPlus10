diff --git a/osfmk/arm64/laurel_abi.c b/osfmk/arm64/laurel_abi.c
new file mode 100644
index 0000000..178316c
--- /dev/null
+++ b/osfmk/arm64/laurel_abi.c
@@ -0,0 +1,198 @@
+/*
+ * laurel_abi.c: the Mi A3 kernel (Kryo 260, ARMv8.0, no PAC) runs the arm64e-derived iOS 26 userland.
+ *
+ * LAUREL EMU: EL0 words newer than ARMv8.0 trap as undefined. handle_uncategorized (sleh.c) calls laurel_abi_trap() for a user trap; the work
+ * is in laurel_a64emu.c, one file with the host test (scripts/laurel/test-a64emu.sh). What the lowering (op10tool a64-lower) leaves reaches this
+ * code: JIT output, unproven words, the 5,462 + 10 LSE words without free space, every FP16, FCMA, DotProd, JSCVT, FHM, SHA3 word.
+ *
+ * Runs with interrupts on and preemption on, on the thread's kernel stack, from an EL0 exception: the saved state is the thread's PCB.
+ *   - A user access runs in laurel_a64emu_asm.h under the copyio recovery table: a fault goes through the normal kernel abort path. The fault path
+ *     runs vm_fault for the user map; if that fails, the access returns EFAULT. No panic.
+ *   - The failed access gets a second vm_fault here, for the real result. Success: the word runs again. Else EXC_BAD_ACCESS with the real code and
+ *     address, with the PC on the word and no register changed: a signal handler sees what the CPU would show.
+ *   - No lock, no state between words: preemption or migration during the LL/SC loop only makes the store-exclusive fail.
+ *   - One step of a debugger: a64emu_run clears the saved SS; the step exception comes at the next instruction.
+ *   - Unknown words, AMX, SME: the normal path, EXC_BAD_INSTRUCTION, one log line with the word.
+ *
+ * Boot: one line. A class whose known answers fail turns off alone. Kill switches: laurelemu=0 (all; the older topaz 0081 LSE path stays), laurelpacemu=0 (PAC class).
+ * Reach counts: one line each LAUREL_EMU_REPORT_S seconds, only when a word trapped.
+ */
+#include <pexpert/pexpert.h>
+#include <arm64/proc_reg.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/thread.h>
+#include <kern/debug.h>
+#include <kern/clock.h>
+#include <kern/misc_protos.h>
+#include <kern/restartable.h>
+#include <kern/startup.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <mach/arm/thread_status.h>
+#include <mach/exception.h>
+#include <mach/exception_types.h>
+#include <machine/atomic.h>
+#include <sys/errno.h>
+#include <vm/vm_fault.h>
+#include <vm/vm_map_xnu.h>
+#include <arm64/laurel_a64emu.h>
+
+#include <kern/exc_resource.h>
+#include <kern/exception.h>
+
+extern char *proc_name_address(void *p);
+
+bool laurel_abi_trap(arm_saved_state_t *state, uint32_t word);
+
+_Static_assert(offsetof(arm_saved_state64_t, x) == offsetof(struct a64emu_regs, x), "saved state layout");
+_Static_assert(offsetof(arm_saved_state64_t, lr) == 30 * 8, "saved state layout");
+_Static_assert(offsetof(arm_saved_state64_t, sp) == offsetof(struct a64emu_regs, sp), "saved state layout");
+_Static_assert(offsetof(arm_saved_state64_t, pc) == offsetof(struct a64emu_regs, pc), "saved state layout");
+_Static_assert(offsetof(arm_saved_state64_t, cpsr) == offsetof(struct a64emu_regs, pstate), "saved state layout");
+_Static_assert(offsetof(arm_neon_saved_state64_t, v) == 0 && sizeof(((arm_neon_saved_state64_t *)0)->v) == 32 * 16, "neon state layout");
+
+#define LAUREL_EMU_REPORT_S     60
+#define LAUREL_EMU_UNKNOWN_LOG  64      /* lines per boot */
+
+static const char *const laurel_emu_names[A64E_NCLASS] = {
+	"pac", "lse", "casp", "rcpc", "fp16", "fcma", "dotprod", "jscvt", "fhm", "sha3", "rdm", "sysreg"
+};
+
+static bool laurel_emu_on;
+static uint32_t laurel_emu_off;
+static uint64_t laurel_emu_count[A64E_NCLASS] __attribute__((aligned(64)));
+static uint64_t laurel_emu_unknown, laurel_emu_faults, laurel_emu_retries;
+static uint64_t laurel_emu_next_report;
+static uint64_t laurel_emu_interval;
+
+__startup_func
+static void
+laurel_abi_init(void)
+{
+	uint32_t on = 1, pac = 1;
+
+	(void) PE_parse_boot_argn("laurelemu", &on, sizeof(on));
+	if (!on) {
+		printf("LAUREL EMU: off: boot-arg laurelemu=0\n");
+		return;
+	}
+	(void) PE_parse_boot_argn("laurelpacemu", &pac, sizeof(pac));
+	if (!pac) {
+		laurel_emu_off |= 1u << A64E_PAC;
+		printf("LAUREL EMU: class pac off: boot-arg laurelpacemu=0\n");
+	}
+	for (int c = 0; c < A64E_NCLASS; c++) {
+		int e = a64emu_selfcheck(c);
+		if (e != 0) {
+			laurel_emu_off |= 1u << c;
+			printf("LAUREL EMU: class %s off: known answer %d failed\n", laurel_emu_names[c], e);
+		}
+	}
+	nanoseconds_to_absolutetime(LAUREL_EMU_REPORT_S * NSEC_PER_SEC, &laurel_emu_interval);
+	laurel_emu_on = true;
+	printf("LAUREL EMU: on: classes off 0x%x, %d classes, report every %d s\n", laurel_emu_off, A64E_NCLASS, LAUREL_EMU_REPORT_S);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, laurel_abi_init);
+
+static void
+laurel_emu_report(void)
+{
+	uint64_t now = mach_absolute_time(), next = os_atomic_load(&laurel_emu_next_report, relaxed);
+
+	if (now < next || !os_atomic_cmpxchg(&laurel_emu_next_report, next, now + laurel_emu_interval, relaxed)) {
+		return;
+	}
+	printf("LAUREL EMU: counts pac=%llu lse=%llu casp=%llu rcpc=%llu fp16=%llu fcma=%llu dotprod=%llu jscvt=%llu fhm=%llu sha3=%llu rdm=%llu sysreg=%llu unknown=%llu fault=%llu retry=%llu\n",
+	    laurel_emu_count[A64E_PAC], laurel_emu_count[A64E_LSE], laurel_emu_count[A64E_CASP], laurel_emu_count[A64E_RCPC],
+	    laurel_emu_count[A64E_FP16], laurel_emu_count[A64E_FCMA], laurel_emu_count[A64E_DOTPROD], laurel_emu_count[A64E_JSCVT],
+	    laurel_emu_count[A64E_FHM], laurel_emu_count[A64E_SHA3], laurel_emu_count[A64E_RDM], laurel_emu_count[A64E_SYSREG],
+	    laurel_emu_unknown, laurel_emu_faults, laurel_emu_retries);
+}
+
+/* Returns only if the word should run again. */
+static void
+laurel_emu_fault(arm_saved_state_t *state, const struct a64emu_out *o)
+{
+	mach_exception_data_type_t codes[2];
+	uint64_t a = o->addr & 0x00FFFFFFFFFFFFFFULL;
+	vm_map_t map = current_map();
+	kern_return_t kr = KERN_INVALID_ADDRESS;
+
+	if (a < vm_map_max(map) && !(o->addr & (1ULL << 55))) {
+		/*
+		 * The kernel abort path gave EFAULT for this access: ask once more for the reason. A success means the map changed in between,
+		 * and the word runs again. KERN_ABORTED: a signal is pending; back to EL0, the word traps again after it.
+		 */
+		kr = vm_fault(map, vm_map_trunc_page(a, PAGE_MASK), o->write ? (VM_PROT_READ | VM_PROT_WRITE) : VM_PROT_READ,
+		    FALSE, VM_KERN_MEMORY_NONE, THREAD_ABORTSAFE, NULL, 0);
+		if (kr == KERN_SUCCESS || kr == KERN_ABORTED) {
+			return;
+		}
+	}
+	thread_reset_pcs_will_fault(current_thread());
+	set_saved_state_far(state, o->addr);
+	codes[0] = kr;
+	codes[1] = (mach_exception_data_type_t)o->addr;
+	exception_triage(EXC_BAD_ACCESS, codes, 2);
+	__builtin_unreachable();
+}
+
+bool
+laurel_abi_trap(arm_saved_state_t *state, uint32_t word)
+{
+	if (!laurel_emu_on) {
+		return false;
+	}
+
+	thread_t thread = current_thread();
+	arm_neon_saved_state64_t *ns = &thread->machine.uNeon->ns_64;
+	struct a64emu_cpu c = {
+		.r = (struct a64emu_regs *)(void *)saved_state64(state),
+		.v = (uint64_t (*)[2])(void *)&ns->v,
+		.fpsr = &ns->fpsr,
+		.fpcr = &ns->fpcr,
+		.limit = vm_map_max(current_map()),
+		.off = laurel_emu_off,
+		.kernel_va = false,
+	};
+	struct a64emu_out o;
+	mach_exception_data_type_t codes[2];
+
+	switch (a64emu_run(&c, word, &o)) {
+	case A64EMU_OK:
+		/* the kernel's exclusive pair is over; no monitor state goes back to EL0 (no clrex in locore.s, this path says it itself) */
+		__asm__ volatile ("clrex");
+		os_atomic_inc(&laurel_emu_count[o.cls], relaxed);
+		laurel_emu_report();
+		return true;
+	case A64EMU_UNKNOWN:
+		if (os_atomic_inc_orig(&laurel_emu_unknown, relaxed) < LAUREL_EMU_UNKNOWN_LOG) {
+			printf("LAUREL EMU: unknown word 0x%08x at 0x%llx in %s\n", word, get_saved_state_pc(state),
+			    proc_name_address(get_bsdtask_info(current_task())) ?: "?");
+		}
+		return false;
+	case A64EMU_FAULT:
+		os_atomic_inc(&laurel_emu_faults, relaxed);
+		laurel_emu_fault(state, &o);
+		return true;
+	case A64EMU_ALIGN:
+		os_atomic_inc(&laurel_emu_faults, relaxed);
+		thread_reset_pcs_will_fault(thread);
+		set_saved_state_far(state, o.addr);
+		codes[0] = EXC_ARM_DA_ALIGN;
+		codes[1] = (mach_exception_data_type_t)o.addr;
+		exception_triage(EXC_BAD_ACCESS, codes, 2);
+		__builtin_unreachable();
+	case A64EMU_SP_ALIGN:
+		os_atomic_inc(&laurel_emu_faults, relaxed);
+		thread_reset_pcs_will_fault(thread);
+		codes[0] = EXC_ARM_SP_ALIGN;
+		codes[1] = (mach_exception_data_type_t)get_saved_state_sp(state);
+		exception_triage(EXC_BAD_ACCESS, codes, 2);
+		__builtin_unreachable();
+	case A64EMU_RETRY:
+		os_atomic_inc(&laurel_emu_retries, relaxed);
+		return true;
+	}
+	return false;
+}
