+	     * A signature with CS_ENFORCEMENT + CS_KILL (UserEventAgent 23F84, flags 0x3202) was killed at the start of dyld.
+	     */
+	    && laurel_cs_no_page_hash()
+#endif /* TOPAZ_4K */
