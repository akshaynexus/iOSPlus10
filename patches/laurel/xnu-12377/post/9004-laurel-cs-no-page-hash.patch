 /*
  * Check if the page being entered into the pmap violates code signing.
  */
+#if defined(TOPAZ_4K)
+/* Always false: see the caller. One line at the first time, so the state of a boot can be read. */
+static bool
+laurel_cs_no_page_hash(void)
+{
+	static bool said;
+
+	if (!said) {
+		said = true;
+		printf("LAUREL CS: off: no page hash check on 4 KiB pages: CS_ENFORCEMENT does not stop an unvalidated code page, first %s\n",
+		    current_proc() ? proc_best_name(current_proc()) : "?");
+	}
+	return false;
+}
+#endif /* TOPAZ_4K */
