+extern "C" int laurel_haptic_start(void);
+extern "C" int laurel_haptic_vib(uint32_t ms);
+extern "C" int laurel_haptic_publish_closed_loop(void);
+extern "C" void laurel_vibrator_key(int key, int down);  /* bsd/dev/sweet_keys.c, keys thread */
