+	.d_type = 0,
+};
+
+static bool
+lh_exists(const char *path)
+{
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(path, 0, &vp, vfs_context_kernel()) != 0) {
+		return false;
+	}
+	vnode_put(vp);
+	return true;
+}
+
+#define LH_PLUGIN   "/System/Library/Audio/Plug-Ins/HAL/RedwoodAudio.driver"
+#define LH_VIRTUAL  "/Library/Audio/Plug-Ins/HAL/VirtualAudio.plugin"
+
+/* after the root mount (devfs is up then): the node, then the closed-loop self-check */
+static void
+lh_root_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	unsigned waited = 0;
+	while (rootvnode == NULLVP && waited < 600u * 1000u) {
+		delay_for_interval(20, NSEC_PER_MSEC);
+		waited += 20;
+	}
+	int major = cdevsw_add(-1, &lh_cdevsw);
+	void *node = major < 0 ? NULL :
+	    devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "redwood-haptic");
+	printf("LAUREL HAPTIC: /dev/redwood-haptic %s (S16LE mono %u Hz, 2 ms blocks, >%u of 32768 = on)\n",
+	    node ? "ready" : "not made (devfs)", LH_RATE, LH_SILENT);
+	if (rootvnode == NULLVP) {
+		printf("LAUREL HAPTIC UI: off: no root file system after %u s\n", waited / 1000u);
+	} else if (lh_ui == 0) {
+		printf("LAUREL HAPTIC UI: off: laurel_haptic_ui=0\n");
+	} else if (!node) {
+		printf("LAUREL HAPTIC UI: off: no /dev/redwood-haptic\n");
+	} else if (!lh_exists(LH_PLUGIN)) {
+		printf("LAUREL HAPTIC UI: off: no %s in the root: iOS vibrates through the \"vibrator\" service "
+		    "(ringtones, alerts; no UI/keyboard taps)\n", LH_PLUGIN);
+	} else if (!lh_exists(LH_VIRTUAL)) {
+		printf("LAUREL HAPTIC UI: off: no %s (disabled in the root): no Actuator route; \"vibrator\" service only\n",
+		    LH_VIRTUAL);
+	} else if (laurel_haptic_publish_closed_loop() != 0) {
+		printf("LAUREL HAPTIC UI: off: IODeviceTree:/product/haptics not published\n");
+	} else {
+		printf("LAUREL HAPTIC UI: on: /product/haptics closed-loop = 1 (CoreHaptics, UI and keyboard taps, "
+		    "ringtones -> Actuator -> /dev/redwood-haptic)\n");
+	}
+	(void)thread_terminate(current_thread());
+}
+
+/* ---- start (LaurelVibrator::start, IOKit matching thread) --------------------------------------- */
+
+int
+laurel_haptic_start(void)
+{
+	static bool tried;
+	uint32_t on = 1;
+	thread_t th;
+
+	if (tried) {
+		return lh_ready ? 0 : -1;
+	}
+	tried = true;
+	(void)PE_parse_boot_argn("laurel_haptic", &on, sizeof(on));
+	(void)PE_parse_boot_argn("laurel_haptic_od", &lh_od, sizeof(lh_od));
+	(void)PE_parse_boot_argn("laurel_haptic_ui", &lh_ui, sizeof(lh_ui));
+	if (on == 0) {
+		printf("LAUREL HAPTIC: off: laurel_haptic=0\n");
+		return -1;
+	}
+	vm_offset_t core = lh_map(LH_CORE_PA, 0x2000), cfg = lh_map(LH_CFG_PA, 0x1000);
+	if (!core || !cfg) {
+		printf("LAUREL HAPTIC: off: SPMI arbiter not mapped\n");
+		return -1;
+	}
+	uint32_t ver = lh_rd32(core), count = lh_rd32(core + 4u) & 0x7ffu;
+	if (ver < 0x50000000u || ver >= 0x70000000u || count == 0 || count > 512u) {
+		printf("LAUREL HAPTIC: off: SPMI arbiter %#x with %u APIDs is not v5\n", ver, count);
+		return -1;
+	}
+	unsigned owner = 8;
+	for (unsigned i = 0; i < count; i++) {
+		uint32_t map = lh_rd32(core + 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != LH_PPID) {
+			continue;
+		}
+		unsigned o = lh_rd32(cfg + 0x700u + 4u * i) & 7u;
+		if (lh_apid == LH_NO_APID || o == 0) {
+			lh_apid = (uint16_t)i;
+			owner = o;
+		}
+	}
+	if (lh_apid == LH_NO_APID) {
+		printf("LAUREL HAPTIC: off: no SPMI APID for PMI632 SID3 0x5700 (PPID 0x%03x)\n", LH_PPID);
+		return -1;
+	}
+	if (owner != 0) {
+		printf("LAUREL HAPTIC: off: APID %u (SID3 0x5700) is owned by EE %u, not the apps EE 0\n", lh_apid, owner);
+		return -1;
+	}
+	lh_obs = lh_map(LH_OBS_PA + 0x80u * lh_apid, 0x80);
+	lh_rw = lh_map(LH_RW_PA + 0x10000u * lh_apid, 0x100);
+	uint8_t id[2] = { 0, 0 }, vs[2] = { 0, 0 }, en = 0, st = 0, back[2] = { 0, 0 };
+	if (!lh_obs || !lh_rw || lh_read(LH_REG_TYPE, id, 2) != 0 || lh_read(LH_REG_VSET_LB, vs, 2) != 0 ||
+	    lh_read(LH_REG_EN_CTL, &en, 1) != 0 || lh_read(LH_REG_STATUS1, &st, 1) != 0) {
+		printf("LAUREL HAPTIC: off: SPMI read of SID3 0x5700 failed (APID %u)\n", lh_apid);
+		lh_obs = lh_rw = 0;
+		return -1;
+	}
+	if (id[0] == 0xffu || (id[0] == 0 && id[1] == 0)) {
+		printf("LAUREL HAPTIC: off: SID3 0x5700 type 0x%02x subtype 0x%02x: no peripheral\n", id[0], id[1]);
+		lh_obs = lh_rw = 0;
+		return -1;
+	}
+	if ((en & LH_EN) && lh_enable(false) != 0) {    /* the boot chain left it on */
+		printf("LAUREL HAPTIC: off: the boot chain left the LDO on and the disable failed\n");
+		lh_obs = lh_rw = 0;
+		return -1;
+	}
+	lh_hw_on = false;
+	/* the handshake: write the nominal voltage, read it back (the LDO is off: nothing moves) */
+	if (lh_vset(LH_NOMINAL_MV) != 0 || lh_read(LH_REG_VSET_LB, back, 2) != 0 ||
+	    (uint32_t)(back[0] | (back[1] << 8)) != LH_NOMINAL_MV) {
+		printf("LAUREL HAPTIC: off: VSET write did not read back (0x%02x%02x, was 0x%02x%02x)\n",
+		    back[1], back[0], vs[1], vs[0]);
+		lh_obs = lh_rw = 0;
+		return -1;
+	}
+	lh_wdog = thread_call_allocate(lh_wdog_fire, NULL);
+	if (lh_wdog == NULL || kernel_thread_start(lh_thread, NULL, &th) != KERN_SUCCESS) {
+		printf("LAUREL HAPTIC: off: no motor thread\n");
+		lh_obs = lh_rw = 0;
+		return -1;
+	}
+	thread_deallocate(th);
+	lh_ready = true;
+	printf("LAUREL HAPTIC: on: PMI632 LDO vib SID3 0x5700 %u mV (APID %u, type 0x%02x/0x%02x, VSET was %u mV, "
+	    "EN_CTL 0x%02x, STATUS1 0x%02x; overdrive %s, tap >= %u ms, duty <= %u %%, cut at %u ms of heat)\n",
+	    LH_NOMINAL_MV, lh_apid, id[0], id[1], (uint32_t)(vs[0] | (vs[1] << 8)), en, st,
+	    lh_od ? "3544 mV 30 ms" : "off (laurel_haptic_od=0)", lh_od ? LH_MIN_OD_MS : LH_MIN_MS, LH_DUTY,
+	    LH_HEAT_MAX_MS);
+	if (kernel_thread_start(lh_root_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		printf("LAUREL HAPTIC UI: off: no root-wait thread (no /dev/redwood-haptic)\n");
+	}
+	return 0;
+}
