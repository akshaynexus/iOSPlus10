-		memcpy(args, again, sizeof(args));
+	memcpy(in, args, sizeof(in));
+	IOLockLock(lazy_lock(&scm_lock_p));
+	for (;;) {
+		memcpy(args, in, sizeof(in));
 		smc(args);
+		/* long calls return INTERRUPTED (1): resume with x0 = 1 and the session from x6 */
+		for (n = 0; args[0] == SCM_INTERRUPTED && n < 100000; n++) {
+			uint64_t again[8] = { SCM_INTERRUPTED, in[1], in[2], in[3], in[4], in[5], args[6], 0 };
+			memcpy(args, again, sizeof(again));
+			smc(args);
+		}
+		if (args[0] != SCM_V2_EBUSY || ++busy > SCM_EBUSY_TRIES) {
+			break;
+		}
+		IOLockUnlock(scm_lock_p);               /* let the other caller finish */
+		IOSleep(SCM_EBUSY_WAIT_MS);
+		IOLockLock(scm_lock_p);
 	}
 	scm_resumes = n;
+	IOLockUnlock(scm_lock_p);
+	if (busy != 0) {
+		LOG("SCM %llx: TrustZone busy %u time(s)%s", in[0], busy, args[0] == SCM_V2_EBUSY ? ", gave up" : "");
+	}
+	return args[0];
+}
