+#define SCM_EBUSY_WAIT_MS   30
+#define SCM_EBUSY_TRIES     100
+
+static IOLock *
+lazy_lock(IOLock **lp)
+{
+	if (*lp == NULL) {
+		IOLock *l = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, l, (void * volatile *)lp)) {
+			IOLockFree(l);
+		}
+	}
+	return *lp;
+}
