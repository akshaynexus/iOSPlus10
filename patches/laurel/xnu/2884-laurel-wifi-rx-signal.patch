-	return 0;
+	return lw_signal_pick(&lw_sig_beacon, lw_ms() - lw_sig_beacon_ms, &lw_sig_data, heard);
+}
+
+/*
+ * laurel 2884: rate and signal of this station's own data: multicast at 6 Mbps and frames of other kinds are no sign of
+ * either (log: "rx legacy mcs 0 6.0 Mbps" between "VHT mcs 9 433 Mbps"). The frame is the descriptor's payload.
+ */
+static void
+lw_rx_sample(const uint8_t *b, uint32_t mlen)
+{
+	const uint8_t *pp = b + 4 * OFF_PPDU_START;
+
+	lw_rx_bytes += mlen;
+	if ((lw_get32(b + 4 * OFF_ATTENTION) & 1) == 0) {
+		return;                                 /* not the first MPDU: no PPDU fields */
+	}
+	if (s_state != S_UP || !lw_is_unicast_data(b + 4 * OFF_MSDU_PAYLOAD, mlen, s_bssid)) {
+		return;
+	}
+	if (pp[16] != 0x80 && pp[16] != 0) {        /* rssi_comb, above the noise floor */
+		lw_ewma_add(&lw_sig_data, -95 + pp[16], 6);
+	}
+	lw_rate_decode(lw_get32(pp + 20), lw_get32(pp + 24), lw_get32(pp + 28), &lw_rx_rate);
+}
+
+/* laurel 2884: beacons and probe responses of the access point joined (WMI MGMT_RX: about 9 a second while joined, log) */
+static void
+lw_beacon_sample(const uint8_t *bssid, int rssi)
+{
+	if (s_state == S_UP && memcmp(bssid, s_bssid, 6) == 0) {
+		lw_ewma_add(&lw_sig_beacon, rssi, 3);
+		lw_sig_beacon_ms = lw_ms();
+	}
+}
+
+/* what iOS is told, every few seconds, when it has changed */
+extern "C" int
+topaz_wlan_signal_now(void)
+{
+	return s_state == S_UP ? lw_rssi_now() : 0;
 }
 
