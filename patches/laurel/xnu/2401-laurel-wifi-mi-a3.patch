+ * boots (icnss powers the chip at probe). A refused vote turns the radio off (one LAUREL WIFI
+ * line); the modem still boots (the rest of the modem services do not need the chip).
+ */
+extern "C" bool topaz_rpm_write(uint32_t set, uint32_t type, uint32_t id, uint32_t key, uint32_t value);
+#define RPM_LDOA            0x616F646Cu         /* "ldoa" */
+#define RPM_KEY_UV          0x00007675u         /* "uv" */
+#define RPM_KEY_SWEN        0x6E657773u         /* "swen" */
+
+static bool
+wlan_supplies_on(char *refused, size_t rlen)
+{
+	static const struct { uint32_t ldo, uv; } sup[] = { { 8, 640000 }, { 16, 1800000 }, { 17, 1304000 }, { 23, 3000000 } };
+	unsigned ok = 0;
+
+	refused[0] = 0;
+	for (unsigned i = 0; i < sizeof(sup) / sizeof(sup[0]); i++) {
+		bool r = true;
+		for (uint32_t set = 0; set <= 1; set++) {
+			r &= topaz_rpm_write(set, RPM_LDOA, sup[i].ldo, RPM_KEY_UV, sup[i].uv);
+			r &= topaz_rpm_write(set, RPM_LDOA, sup[i].ldo, RPM_KEY_SWEN, 1);
+		}
+		ok += r;
+		LOG("wlan: RPM L%uA %u uV on: %s", sup[i].ldo, sup[i].uv, r ? "OK" : "refused");
+		if (!r) {
+			size_t l = strlen(refused);
+			snprintf(refused + l, rlen - l, "%sL%uA", l != 0 ? " " : "", sup[i].ldo);
+		}
+	}
+	return ok == sizeof(sup) / sizeof(sup[0]);
+}
