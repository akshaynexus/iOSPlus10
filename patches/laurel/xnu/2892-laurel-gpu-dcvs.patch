+/* laurel 2892: what LaurelGpuDcvs.cpp needs from here; hw_lock around all of it */
+extern "C" bool laurel_gpu_core_div(uint32_t div);
+extern "C" bool laurel_gpu_counters(uint64_t *busy, uint64_t *ticks, uint64_t *cycles);
+extern "C" bool laurel_gpu_fence_check(uint64_t *us);
+
+bool
+laurel_gpu_core_div(uint32_t div)
+{
+	if (!ready || hw_lock == NULL) {
+		return false;
+	}
+	IOLockLock(hw_lock);
+	bool ok = rcg_set(0x101c, SRC_GPLL0, div);
+	IOLockUnlock(hw_lock);
+	return ok;
+}
+
+bool
+laurel_gpu_counters(uint64_t *busy, uint64_t *ticks, uint64_t *cycles)
+{
+	if (!ready || hw_lock == NULL) {
+		return false;
+	}
+	IOLockLock(hw_lock);
+	ts_account();
+	*busy = ts_busy;
+	*cycles = (uint64_t)gpu_rd(0x401) << 32 | gpu_rd(0x400);
+	*ticks = (uint64_t)gpu_rd(0x981) << 32 | gpu_rd(0x980);
+	IOLockUnlock(hw_lock);
+	return true;
+}
+
+/* one CP fence into a word of the fence page that nothing else reads; only with an idle ring (else no test: true, us = 0) */
+bool
+laurel_gpu_fence_check(uint64_t *us)
+{
+	bool ok = true;
+
+	*us = 0;
+	if (!ready || hw_lock == NULL || mem.va == NULL) {
+		return false;
+	}
+	IOLockLock(hw_lock);
+	if (gpu_rd(0x806) == wptr % RB_DWORDS) {
+		ok = cp_fence((volatile uint32_t *)(mem.va + 0x3c0), mem.iova + 0x3c0, 0x51a6e600, us);
+	}
+	IOLockUnlock(hw_lock);
+	return ok;
+}
