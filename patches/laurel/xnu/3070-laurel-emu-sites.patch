laurel 3070: LAUREL EMU SITES: the EL0 emulator (LAUREL EMU) keeps the words it serves by site (process, user pc, pc with the dyld cache slide off, word, class, count) and names the 4 hottest sites of each minute in a line after the counts line: the input for a lowering of those words in the root (as the PAC/LSE lowering) or a feature that steers the library to its ARMv8.0 path. Before: 900,000 FP16 words a minute in the boot storm with no site. Pure table in osfmk/arm64/laurel_emu_sites.h (host test scripts/laurel/test-emu-sites.sh); the laurel_abi.c hunks are post/9026 (the file exists only on xnu-12377). Kill switch laurelemusites=0. docs/laurel_sprout/cpu-efficiency.md.

diff --git a/osfmk/arm64/laurel_emu_sites.h b/osfmk/arm64/laurel_emu_sites.h
new file mode 100644
index 0000000..06c8209
--- /dev/null
+++ b/osfmk/arm64/laurel_emu_sites.h
@@ -0,0 +1,124 @@
+/*
+ * laurel 3070: LAUREL EMU SITES. The EL0 emulator (LAUREL EMU, laurel_abi.c) serves words this CPU has not: PAC, LSE, FP16, ...
+ * A served word costs about 2 us; 900,000 FP16 words a minute were seen in the boot storm (usblog 2026-11-07 05:21), and the
+ * counts alone do not say where they come from. This table keeps every site the emulator serves, by user pc: the process, the word,
+ * its class, the pc with the dyld cache slide taken off (so it names the cache address the tools read), and a count. The minute
+ * line (`LAUREL EMU: sites: ...`) names the LES_TOP hottest sites of that minute. The answer is the input for a lowering of those
+ * words in the root (as the PAC and LSE lowering), or a feature that steers the library to its ARMv8.0 path.
+ * Pure: no kernel types. The host test scripts/laurel/test-emu-sites.sh runs exactly this code. Relaxed atomics: a lost count is
+ * one count; a slot is claimed by one compare-and-swap; a reader of a slot that was just claimed may see an empty name once.
+ * Cost per served word: one hash, up to LES_PROBE loads, one add. Kill switch laurelemusites=0 (laurel_abi.c).
+ */
+#ifndef LAUREL_EMU_SITES_H
+#define LAUREL_EMU_SITES_H
+#include <stdint.h>
+#include <stdbool.h>
+
+#define LES_N      128u     /* slots: the cache has 177 FP16 sites in all, a boot touches far fewer */
+#define LES_PROBE  4u       /* slots tried for one pc */
+#define LES_COMM   16u      /* MAXCOMLEN */
+#define LES_TOP    4u       /* sites named a minute */
+
+struct les_site {
+	uint64_t pc;            /* 0 = free; claimed once by compare-and-swap, never freed */
+	uint64_t count;
+	uint64_t reported;      /* count at the last line: the line shows the minute's delta */
+	uint64_t unslid;        /* pc - the dyld cache slide of the task at the first hit; 0 when the task has no slide or pc is below it */
+	uint32_t word;
+	uint8_t cls;
+	char comm[LES_COMM + 1];
+};
+
+struct les_table {
+	struct les_site s[LES_N];
+	uint64_t other;         /* served words that found no slot (LES_PROBE slots full) */
+};
+
+static inline unsigned
+les_hash(uint64_t pc)
+{
+	uint64_t h = (pc >> 2) * 0x9E3779B97F4A7C15ULL;
+
+	return (unsigned)(h >> 32) % LES_N;
+}
+
+static inline void
+les_copy_comm(char *dst, const char *src)
+{
+	unsigned i = 0;
+
+	if (src != NULL) {
+		for (; i < LES_COMM && src[i] != '\0'; i++) {
+			dst[i] = src[i];
+		}
+	}
+	dst[i] = '\0';
+}
+
+/* One served word at pc. comm and slide describe the task that ran it; they are stored when the pc's slot is claimed. */
+static inline void
+les_note(struct les_table *t, uint64_t pc, uint32_t word, uint8_t cls, const char *comm, uint64_t slide)
+{
+	unsigned h = les_hash(pc);
+
+	for (unsigned i = 0; i < LES_PROBE; i++) {
+		struct les_site *s = &t->s[(h + i) % LES_N];
+		uint64_t have = __atomic_load_n(&s->pc, __ATOMIC_RELAXED);
+
+		if (have == 0) {
+			uint64_t zero = 0;
+			if (__atomic_compare_exchange_n(&s->pc, &zero, pc, false, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+				s->word = word;
+				s->cls = cls;
+				s->unslid = (slide != 0 && pc >= slide) ? pc - slide : 0;
+				les_copy_comm(s->comm, comm);
+				have = pc;
+			} else {
+				have = zero;    /* the pc another CPU claimed meanwhile */
+			}
+		}
+		if (have == pc) {
+			__atomic_fetch_add(&s->count, 1, __ATOMIC_RELAXED);
+			return;
+		}
+	}
+	__atomic_fetch_add(&t->other, 1, __ATOMIC_RELAXED);
+}
+
+/* The LES_TOP sites with the most served words since the last call, hottest first: slot indexes in out[], the deltas in delta[]. Returns how many. */
+static inline unsigned
+les_top(struct les_table *t, unsigned out[LES_TOP], uint64_t delta[LES_TOP], unsigned *used)
+{
+	unsigned n = 0, slots = 0;
+
+	for (unsigned i = 0; i < LES_N; i++) {
+		struct les_site *s = &t->s[i];
+		if (__atomic_load_n(&s->pc, __ATOMIC_RELAXED) == 0) {
+			continue;
+		}
+		slots++;
+		uint64_t c = __atomic_load_n(&s->count, __ATOMIC_RELAXED), d = c - s->reported;
+		s->reported = c;
+		if (d == 0) {
+			continue;
+		}
+		if (n < LES_TOP) {
+			n++;
+		} else if (d <= delta[LES_TOP - 1]) {
+			continue;
+		}
+		unsigned j = n - 1;
+		while (j > 0 && delta[j - 1] < d) {
+			delta[j] = delta[j - 1];
+			out[j] = out[j - 1];
+			j--;
+		}
+		delta[j] = d;
+		out[j] = i;
+	}
+	if (used != NULL) {
+		*used = slots;
+	}
+	return n;
+}
+#endif /* LAUREL_EMU_SITES_H */
