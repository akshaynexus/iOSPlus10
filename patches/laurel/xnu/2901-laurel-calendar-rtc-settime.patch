+/* laurel 2901: "settime S[.U]" -> microseconds since 1970. false = malformed. */
+static bool
+ud_parse_settime(const char *cmd, uint64_t *us)
+{
+	const char *q = cmd + 8;
+	uint64_t secs = 0;
+	uint32_t usecs = 0, digits = 0;
+	bool ok = *q >= '0' && *q <= '9';
+	while (*q >= '0' && *q <= '9' && secs < 100000000000ull) {
+		secs = secs * 10 + (uint64_t)(*q++ - '0');
+	}
+	if (*q == '.') {
+		for (q++; *q >= '0' && *q <= '9'; q++) {
+			if (digits < 6) {
+				usecs = usecs * 10 + (uint32_t)(*q - '0');
+				digits++;
+			}
+		}
+		for (; digits < 6; digits++) {
+			usecs *= 10;
+		}
+	}
+	*us = secs * USEC_PER_SEC + usecs;
+	return ok && *q == 0;
+}
+
+/* laurel 2901: a settime kept in raw mode, from a thread (ud_attach_thread). */
+static void
+ud_settime_apply_pending(void)
+{
+	char treply[160];
+	uint64_t ns;
+
+	if (!ud_settime_pending) {
+		return;
+	}
+	ud_settime_pending = false;
+	absolutetime_to_nanoseconds(mach_absolute_time() - ud_settime_at, &ns);
+	uint64_t us = ud_settime_us + ns / NSEC_PER_USEC;
+	(void)laurel_calendar_settime(us / USEC_PER_SEC, (uint32_t)(us % USEC_PER_SEC), treply, sizeof(treply));
+	printf("LAUREL CTL: settime from raw mode: %s\n", treply);
+}
