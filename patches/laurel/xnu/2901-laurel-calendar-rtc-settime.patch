+/*
+ * laurel 2901: calendar (wall-clock) time on the Mi A3 (SM6125, PM6125 RTC).
+ * Port of negroni 0203 (bsd/dev/negroni_rtc.c) and 0212 (USB settime).
+ *
+ * Before this file SweetPlatformExpert had no getUTCTimeOfDay(): the
+ * IOPlatformExpert default returns 0, clock_initialize_calendar() moved the
+ * "UTC" time up to the uptime, and userland saw 1970 until timed/NTP ran.
+ *
+ * Sources, in this order:
+ *  1. The PM6125 RTC (SPMI SID 0, RTC_RW peripheral 0x60, DT
+ *     qcom,pm6125_rtc_rw@6000 "qcom,qpnp-rtc"; qpnp-rtc.c: ctrl 0x6046 bit 7
+ *     = enabled, 32-bit little-endian seconds at 0x6048..0x604b). Read like
+ *     qpnp_read_wrapper(): the 4 bytes, then byte 0 again; a smaller byte 0
+ *     means a carry during the read, so read once more. The DT has
+ *     qcom,qpnp-rtc-write = <0>: like Linux and Android (time_daemon) this
+ *     code never writes the RTC. Wall time = RTC + an offset:
+ *       - boot-arg laurelrtcoff=<seconds> (wins over the saved offset), or
+ *       - the offset saved in /private/var/db/laurel_rtc (below).
+ *     The read uses the SPMI arbiter v5 observer channel of the RTC APID
+ *     (trinket: core 0x1c40000, observer 0x3e00000, config 0x1c0a000, as
+ *     sweet_spmi.c after laurel 2018), mapped here: the RTC lane is used by
+ *     nobody else.
+ *  2. A floor: the kernel build date (00:00 UTC of __DATE__, minus one day
+ *     for the build host's time zone), or the last saved wall time if that
+ *     is later. The calendar never starts below the floor.
+ *  3. A set from outside: settimeofday() (timed, date(1)), or the host over
+ *     USB (UDP 5141 "settime", sweet_usb.c). Both end in
+ *     clock_set_calendar_microtime() -> PESetUTCTimeOfDay() ->
+ *     laurel_rtc_set(): the new offset = time - RTC is kept in memory and
+ *     written (thread call) to /private/var/db/laurel_rtc as text. At the
+ *     next boot laurel_rtc_load_saved() (bsd_init, after the root mount,
+ *     before launchd) applies it. If the RTC went backwards (counter reset)
+ *     the offset is not used; the saved wall time is a floor then. A failed
+ *     write (read-only root) is tried again every 30 s, 60 times.
+ * Self-check: the RTC APID is found, the ctrl register reads with bit 7 set
+ * and the counter reads twice. One line: "LAUREL CALENDAR: on: ..." or
+ * "LAUREL CALENDAR: off: <reason> (build-date floor + uptime)". Kill switch:
+ * boot-arg laurelrtc=0 (no PMIC access; the floor and settime still work).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/mount.h>
+#include <sys/vnode.h>
+#include <sys/vnode_if.h>
+#include <sys/kauth.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread_call.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+void laurel_rtc_get(clock_sec_t *secs, clock_nsec_t *nsecs);
+void laurel_rtc_set(clock_sec_t secs, clock_nsec_t nsecs);
+void laurel_rtc_load_saved(void);
+int laurel_calendar_settime(uint64_t secs, uint32_t usecs, char *reply, size_t size);
+void laurel_calendar_describe(char *reply, size_t size);
+
+#define LC_CORE_PA      0x01c40000u     /* SPMI arbiter v5 core: version at 0, APID count at 4, map at 0x900 */
+#define LC_OBS_PA       0x03e00000u     /* observer channels, EE 0, 0x80 per APID */
+#define LC_CFG_PA       0x01c0a000u     /* owner table at 0x700, 4 * APID, bits 2:0 = owner EE */
+#define LC_RTC_PPID     0x060u          /* SID 0, RTC_RW 0x6000 */
+#define LC_RTC_CTRL     0x46u           /* 0x6046, bit 7 = RTC enabled */
+#define LC_RTC_READ     0x48u           /* 0x6048..0x604b, seconds, little endian */
+#define LC_RTC_ENABLE   0x80u
+#define LC_NO_APID      0xffffu
+
+#define LC_FILE         "/private/var/db/laurel_rtc"
+#define LC_MIN_TIME     1577836800ull   /* 2020-01-01: smaller "settime" values are refused */
+#define LC_MAX_TIME     4102444800ull   /* 2100-01-01 */
+#define LC_RETRY_S      30
+#define LC_RETRIES      60
+
+static LCK_GRP_DECLARE(lc_grp, "laurel_rtc");
+static LCK_MTX_DECLARE(lc_lock, &lc_grp);
+
+static struct {
+	bool        inited;
+	bool        rtc_ok;          /* the RTC is mapped, enabled and was read */
+	bool        lane_dead;       /* a command timed out: never use the lane again */
+	vm_offset_t core, obs, cfg;
+	uint32_t    apid;
+	uint64_t    floor;           /* seconds */
+	bool        bootarg_off_set;
+	int64_t     bootarg_off;
+	int64_t     offset;          /* wall = RTC + offset (rtc_ok) */
+	const char *source;          /* where the current time came from */
+	uint64_t    soft_wall_ns;    /* wall time at soft_abs: the clock without the RTC */
+	uint64_t    soft_abs;
+	bool        set_this_boot;
+	bool        root_ready;      /* laurel_rtc_load_saved() ran: the file may be written */
+	bool        dirty;           /* the file does not hold the current offset */
+	unsigned    retries;
+	bool        saved_valid;
+	int64_t     saved_offset;
+	uint64_t    saved_wall;
+	uint32_t    saved_rtc;
+	bool        saved_has_rtc;
+	thread_call_t persist_call;
+} lc = { .apid = LC_NO_APID };
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdate-time"
+static const char lc_build_date[] = __DATE__;
+#pragma clang diagnostic pop
+
+static int64_t
+lc_days_from_civil(int64_t y, int m, int d)
+{
+	/* H. Hinnant's days_from_civil */
+	y -= m <= 2;
+	int64_t era = (y >= 0 ? y : y - 399) / 400;
+	int64_t yoe = y - era * 400;
+	int64_t doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+	int64_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	return era * 146097 + doe - 719468;
+}
+
+/* __DATE__ ("Nov  1 2026") as days since 1970-01-01; -1 if it does not parse. */
+static int64_t
+lc_build_days(void)
+{
+	static const char months[] = "JanFebMarAprMayJunJulAugSepOctNovDec";
+	const char *s = lc_build_date;
+	int m = 0, d = 0, y = 0;
+
+	for (int i = 0; i < 12; i++) {
+		if (strncmp(s, months + 3 * i, 3) == 0) {
+			m = i + 1;
+		}
+	}
+	for (int i = 4; i < 6; i++) {
+		if (s[i] >= '0' && s[i] <= '9') {
+			d = d * 10 + (s[i] - '0');
+		}
+	}
+	for (int i = 7; i < 11; i++) {
+		if (s[i] < '0' || s[i] > '9') {
+			return -1;
+		}
+		y = y * 10 + (s[i] - '0');
+	}
+	if (m == 0 || d < 1 || d > 31 || y < 2024) {
+		return -1;
+	}
+	return lc_days_from_civil(y, m, d);
+}
+
+static uint32_t
+lc_rd(vm_offset_t base, unsigned off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* One RTC_RW register byte over the observer channel (EXT_READL, 1 byte). 0 = done. */
+static int
+lc_read8(uint8_t reg, uint8_t *v)
+{
+	if (lc.lane_dead || lc.apid == LC_NO_APID) {
+		return -1;
+	}
+	unsigned off = 0x80u * lc.apid;
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(lc.obs + off) = (1u << 27) | ((uint32_t)reg << 4);
+	__asm__ volatile ("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t st = lc_rd(lc.obs, off + 0x08u);
+		if (st & 1u) {
+			if (st & 0x0eu) {
+				return -1;
+			}
+			*v = (uint8_t)lc_rd(lc.obs, off + 0x18u);
+			return 0;
+		}
+		delay(1);
+	}
+	lc.lane_dead = true;
+	printf("LAUREL CALENDAR: SPMI read of 0x60%02x timed out: RTC lane off for this boot\n", reg);
+	return -1;
+}
+
+/* The 32-bit seconds counter, as qpnp-rtc.c. 0 = done. Caller holds lc_lock. */
+static int
+lc_rtc_raw(uint32_t *secs)
+{
+	uint8_t b[4], again;
+
+	for (int tries = 0; tries < 2; tries++) {
+		for (unsigned i = 0; i < 4; i++) {
+			if (lc_read8((uint8_t)(LC_RTC_READ + i), &b[i]) != 0) {
+				return -1;
+			}
+		}
+		if (lc_read8(LC_RTC_READ, &again) != 0) {
+			return -1;
+		}
+		if (again >= b[0]) {
+			*secs = (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16 | (uint32_t)b[3] << 24;
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static uint64_t
+lc_abs_ns(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns;
+}
+
+static uint64_t
+lc_soft_now_ns(void)
+{
+	return lc.soft_wall_ns + lc_abs_ns(mach_absolute_time() - lc.soft_abs);
+}
+
+static void
+lc_soft_set(uint64_t wall_ns)
+{
+	lc.soft_wall_ns = wall_ns;
+	lc.soft_abs = mach_absolute_time();
+}
+
+/* The RTC_RW APID: the map entry with this PPID, owner EE 0 preferred. Returns the reason or NULL. */
+static const char *
+lc_map(void)
+{
+	lc.core = ml_io_map(LC_CORE_PA, 0x2000);
+	lc.cfg = ml_io_map(LC_CFG_PA, 0x1000);
+	lc.obs = ml_io_map(LC_OBS_PA, 0x10000);
+	if (!lc.core || !lc.cfg || !lc.obs) {
+		return "SPMI mapping failed";
+	}
+	uint32_t ver = lc_rd(lc.core, 0), count = lc_rd(lc.core, 4) & 0x7ffu;
+	if (ver < 0x50000000u || ver >= 0x70000000u || count == 0 || count > 512) {
+		return "SPMI arbiter is not v5";
+	}
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t map = lc_rd(lc.core, 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != LC_RTC_PPID) {
+			continue;
+		}
+		if (lc.apid == LC_NO_APID || (lc_rd(lc.cfg, 0x700u + 4u * i) & 7u) == 0) {
+			lc.apid = i;
+		}
+	}
+	return lc.apid == LC_NO_APID ? "RTC_RW 0x6000 not in the SPMI APID map" : NULL;
+}
+
+static void lc_persist(thread_call_param_t p0, thread_call_param_t p1);
+
+/* Once, in thread context, under lc_lock: boot-args, floor, SPMI mapping, first RTC read. */
+static void
+lc_init(void)
+{
+	int enabled = 1;
+	uint8_t ctrl = 0;
+	uint32_t raw = 0;
+	char why[96] = "";
+
+	if (lc.inited) {
+		return;
+	}
+	lc.inited = true;
+	lc.persist_call = thread_call_allocate_with_options(lc_persist, NULL, THREAD_CALL_PRIORITY_LOW, 0);
+
+	int64_t days = lc_build_days();
+	lc.floor = days > 0 ? (uint64_t)(days - 1) * 86400ull : 1761955200ull;   /* 2025-11-01 */
+	(void)PE_parse_boot_argn("laurelrtc", &enabled, sizeof(enabled));
+	lc.bootarg_off_set = PE_parse_boot_argn("laurelrtcoff", &lc.bootarg_off, sizeof(lc.bootarg_off));
+
+	if (!enabled) {
+		strlcpy(why, "laurelrtc=0", sizeof(why));
+	} else {
+		const char *e = lc_map();
+		if (e != NULL) {
+			strlcpy(why, e, sizeof(why));
+		} else if (lc_read8(LC_RTC_CTRL, &ctrl) != 0 || lc_rtc_raw(&raw) != 0) {
+			snprintf(why, sizeof(why), "RTC_RW APID %u not readable", lc.apid);
+		} else if (!(ctrl & LC_RTC_ENABLE)) {
+			snprintf(why, sizeof(why), "RTC not enabled (ctrl 0x%02x)", ctrl);
+		} else {
+			lc.rtc_ok = true;
+		}
+	}
+
+	uint64_t t;
+	if (lc.rtc_ok) {
+		int64_t off = lc.bootarg_off_set ? lc.bootarg_off : 0;
+		t = (uint64_t)((int64_t)raw + off);
+		lc.source = lc.bootarg_off_set ? "RTC + boot-arg laurelrtcoff" : "RTC counter (no offset yet)";
+		if ((int64_t)raw + off < 0 || t < lc.floor) {
+			t = lc.floor;
+			lc.source = lc.bootarg_off_set ? "build-date floor (RTC + laurelrtcoff below it)" :
+			    "build-date floor (RTC counter below it)";
+		}
+		lc.offset = (int64_t)t - (int64_t)raw;
+		printf("LAUREL CALENDAR: on: PM6125 RTC APID %u, ctrl 0x%02x, counter %u s; boot calendar %llu s from the %s, "
+		    "offset %lld; floor %llu (build %s)\n", lc.apid, ctrl, raw, t, lc.source, lc.offset, lc.floor, lc_build_date);
+	} else {
+		t = lc.floor;
+		lc.source = "build-date floor (no RTC)";
+		printf("LAUREL CALENDAR: off: %s (calendar = build-date floor %llu + uptime until settime/timed)\n", why, t);
+	}
+	lc_soft_set(t * NSEC_PER_SEC);
+}
+
+/* SweetPlatformExpert::getUTCTimeOfDay(): thread context. */
+void
+laurel_rtc_get(clock_sec_t *secs, clock_nsec_t *nsecs)
+{
+	uint32_t raw;
+	uint64_t ns;
+
+	if (!preemption_enabled() || ml_at_interrupt_context()) {
+		/* cannot block: the last value + the uptime, unlocked */
+		ns = lc.inited ? lc_soft_now_ns() : 0;
+		*secs = (clock_sec_t)(ns / NSEC_PER_SEC);
+		*nsecs = (clock_nsec_t)(ns % NSEC_PER_SEC);
+		return;
+	}
+	lck_mtx_lock(&lc_lock);
+	lc_init();
+	if (lc.rtc_ok && lc_rtc_raw(&raw) == 0) {
+		ns = (uint64_t)((int64_t)raw + lc.offset) * NSEC_PER_SEC;
+		lc_soft_set(ns);
+	} else {
+		ns = lc_soft_now_ns();
+	}
+	lck_mtx_unlock(&lc_lock);
+	*secs = (clock_sec_t)(ns / NSEC_PER_SEC);
+	*nsecs = (clock_nsec_t)(ns % NSEC_PER_SEC);
+}
+
+/* SweetPlatformExpert::setUTCTimeOfDay(), from clock_set_calendar_microtime(): may block. */
+void
+laurel_rtc_set(clock_sec_t secs, clock_nsec_t nsecs)
+{
+	uint32_t raw;
+	bool schedule;
+
+	if (!preemption_enabled() || ml_at_interrupt_context()) {
+		return;
+	}
+	lck_mtx_lock(&lc_lock);
+	lc_init();
+	int64_t before = lc.offset;
+	lc_soft_set((uint64_t)secs * NSEC_PER_SEC + nsecs);
+	if (lc.rtc_ok && lc_rtc_raw(&raw) == 0) {
+		lc.offset = (int64_t)secs - (int64_t)raw;
+		if (lc.offset - before > 1 || before - lc.offset > 1) {
+			printf("LAUREL CALENDAR: time set to %lu s: RTC %u, offset %lld (was %lld)\n",
+			    (unsigned long)secs, raw, lc.offset, before);
+		}
+	} else {
+		printf("LAUREL CALENDAR: time set to %lu s (no RTC: clock from the uptime)\n", (unsigned long)secs);
+	}
+	lc.source = "set (settimeofday or USB settime)";
+	lc.set_this_boot = true;
+	lc.dirty = true;
+	lc.retries = 0;
+	schedule = lc.root_ready && lc.persist_call != NULL;
+	lck_mtx_unlock(&lc_lock);
+	if (schedule) {
+		thread_call_enter(lc.persist_call);
+	}
+}
+
+/* "key value" lines of the file. */
+static void
+lc_parse(char *text)
+{
+	char *p = text;
+
+	lc.saved_valid = false;
+	lc.saved_has_rtc = false;
+	lc.saved_wall = 0;
+	lc.saved_offset = 0;
+	if (strncmp(p, "laurel-rtc 1\n", 13) != 0) {
+		return;
+	}
+	while (*p != 0) {
+		char *key = p;
+		while (*p != 0 && *p != ' ' && *p != '\n') {
+			p++;
+		}
+		if (*p != ' ') {
+			if (*p == '\n') {
+				p++;
+			}
+			continue;
+		}
+		*p++ = 0;
+		bool neg = *p == '-';
+		if (neg) {
+			p++;
+		}
+		uint64_t v = 0;
+		while (*p >= '0' && *p <= '9') {
+			v = v * 10 + (uint64_t)(*p++ - '0');
+		}
+		if (strcmp(key, "offset") == 0) {
+			lc.saved_offset = neg ? -(int64_t)v : (int64_t)v;
+			lc.saved_valid = true;
+		} else if (strcmp(key, "rtc") == 0) {
+			lc.saved_rtc = (uint32_t)v;
+			lc.saved_has_rtc = true;
+		} else if (strcmp(key, "wall") == 0) {
+			lc.saved_wall = v;
+		}
+		while (*p != 0 && *p != '\n') {
+			p++;
+		}
+		if (*p == '\n') {
+			p++;
+		}
+	}
+}
+
+/* bsd_init, after the root mount and before launchd: the saved offset (or wall time as a floor). */
+void
+laurel_rtc_load_saved(void)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	char buf[160];
+	int resid = 0, error;
+	uint64_t apply = 0;
+	uint32_t raw = 0;
+	bool schedule;
+
+	bzero(buf, sizeof(buf));
+	error = vnode_open(LC_FILE, FREAD, 0, 0, &vp, ctx);
+	if (error == 0) {
+		error = vn_rdwr(UIO_READ, vp, buf, sizeof(buf) - 1, 0, UIO_SYSSPACE, IO_NODELOCKED,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		(void)vnode_close(vp, FREAD, ctx);
+	}
+
+	lck_mtx_lock(&lc_lock);
+	lc_init();
+	lc.root_ready = true;
+	if (error == 0) {
+		lc_parse(buf);
+	}
+	clock_sec_t now_s;
+	clock_usec_t now_us;
+	clock_get_calendar_microtime(&now_s, &now_us);
+	const char *what;
+	if (error != 0) {
+		what = error == ENOENT ? "no saved offset yet (" LC_FILE ")" : "saved offset not readable";
+	} else if (!lc.saved_valid) {
+		what = "saved file not understood: ignored";
+	} else if (lc.set_this_boot) {
+		what = "time already set this boot: saved offset not used";
+	} else if (lc.bootarg_off_set) {
+		what = "boot-arg laurelrtcoff given: saved offset not used";
+	} else if (lc.rtc_ok && lc_rtc_raw(&raw) == 0 && (!lc.saved_has_rtc || raw >= lc.saved_rtc) &&
+	    (int64_t)raw + lc.saved_offset > 0) {
+		apply = (uint64_t)((int64_t)raw + lc.saved_offset);
+		what = "RTC + saved offset";
+		if (apply < lc.saved_wall || apply < lc.floor) {
+			apply = MAX(lc.saved_wall, lc.floor);
+			what = "saved wall time (RTC + saved offset below it)";
+		}
+	} else if (lc.saved_wall > (uint64_t)now_s) {
+		apply = lc.saved_wall;
+		what = lc.rtc_ok ? "saved wall time as floor (RTC went backwards: offset not used)" :
+		    "saved wall time as floor (no RTC)";
+	} else {
+		what = "saved wall time is not later than the clock: not used";
+	}
+	if (apply != 0 && apply <= (uint64_t)now_s + 1 && apply + 1 >= (uint64_t)now_s) {
+		apply = 0;      /* already right */
+	}
+	printf("LAUREL CALENDAR: %s: %s (calendar %lu s%s%llu)\n", LC_FILE, what, (unsigned long)now_s,
+	    apply ? " -> " : "", apply ? apply : 0ull);
+	schedule = lc.dirty && lc.persist_call != NULL;
+	lck_mtx_unlock(&lc_lock);
+
+	if (apply != 0) {
+		clock_set_calendar_microtime((clock_sec_t)apply, 0);   /* -> laurel_rtc_set() */
+		lck_mtx_lock(&lc_lock);
+		lc.source = "saved offset (" LC_FILE ")";
+		lc.dirty = !(lc.saved_valid && lc.offset == lc.saved_offset);
+		schedule = lc.dirty;
+		lck_mtx_unlock(&lc_lock);
+	}
+	if (schedule) {
+		thread_call_enter(lc.persist_call);
+	}
+}
+
+/* Thread call: write the offset file (dirty only), try again later on an error (read-only root). */
+static void
+lc_persist(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	char text[160];
+	uint32_t raw = 0;
+	int resid = 0;
+
+	lck_mtx_lock(&lc_lock);
+	if (!lc.dirty) {
+		lck_mtx_unlock(&lc_lock);
+		return;
+	}
+	bool has_rtc = lc.rtc_ok && lc_rtc_raw(&raw) == 0;
+	int64_t offset = lc.offset;
+	uint64_t wall = has_rtc ? (uint64_t)((int64_t)raw + offset) : lc_soft_now_ns() / NSEC_PER_SEC;
+	if (has_rtc) {
+		snprintf(text, sizeof(text), "laurel-rtc 1\noffset %lld\nrtc %u\nwall %llu\n", offset, raw, wall);
+	} else {
+		snprintf(text, sizeof(text), "laurel-rtc 1\noffset 0\nwall %llu\n", wall);
+	}
+	lc.dirty = false;
+	lck_mtx_unlock(&lc_lock);
+
+	int error = vnode_open(LC_FILE, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, S_IRUSR | S_IWUSR,
+	    VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (error == 0) {
+		error = vn_rdwr(UIO_WRITE, vp, text, (int)strlen(text), 0, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (error == 0 && resid != 0) {
+			error = EIO;
+		}
+		if (error == 0) {
+			error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+		}
+		(void)vnode_close(vp, FWRITE, ctx);
+	}
+
+	lck_mtx_lock(&lc_lock);
+	if (error == 0) {
+		lc.saved_valid = true;
+		lc.saved_offset = offset;
+		lc.saved_wall = wall;
+		lc.saved_rtc = raw;
+		lc.saved_has_rtc = has_rtc;
+		printf("LAUREL CALENDAR: saved offset %lld (wall %llu) to %s\n", has_rtc ? offset : 0ll, wall, LC_FILE);
+	} else if (!lc.dirty) {
+		lc.dirty = true;
+		if (lc.retries++ < LC_RETRIES) {
+			if (lc.retries == 1) {
+				printf("LAUREL CALENDAR: %s not written (error %d): again every %d s\n", LC_FILE, error, LC_RETRY_S);
+			}
+			uint64_t deadline;
+			clock_interval_to_deadline(LC_RETRY_S, NSEC_PER_SEC, &deadline);
+			thread_call_enter_delayed(lc.persist_call, deadline);
+		} else {
+			printf("LAUREL CALENDAR: %s not written (error %d): giving up until the next set\n", LC_FILE, error);
+		}
+	}
+	lck_mtx_unlock(&lc_lock);
+}
+
+/* USB "settime <secs>[.<usecs>]". 0 = set; the reply text goes into reply. Thread context. */
+int
+laurel_calendar_settime(uint64_t secs, uint32_t usecs, char *reply, size_t size)
+{
+	clock_sec_t old_s;
+	clock_usec_t old_us;
+
+	if (secs < LC_MIN_TIME || secs >= LC_MAX_TIME || usecs >= USEC_PER_SEC) {
+		snprintf(reply, size, "error: time %llu out of range", secs);
+		return -1;
+	}
+	clock_get_calendar_microtime(&old_s, &old_us);
+	clock_set_calendar_microtime((clock_sec_t)secs, (clock_usec_t)usecs);
+	lck_mtx_lock(&lc_lock);
+	lc.source = "USB settime";
+	snprintf(reply, size, "ok settime %llu (was %lu, %s offset %lld)", secs, (unsigned long)old_s,
+	    lc.rtc_ok ? "RTC" : "no RTC,", lc.rtc_ok ? lc.offset : 0ll);
+	lck_mtx_unlock(&lc_lock);
+	printf("LAUREL CALENDAR: USB settime %llu.%06u (calendar was %lu.%06u)\n", secs, usecs,
+	    (unsigned long)old_s, old_us);
+	return 0;
+}
+
+/* USB "time": the calendar and its source. Thread context. */
+void
+laurel_calendar_describe(char *reply, size_t size)
+{
+	clock_sec_t s;
+	clock_usec_t us;
+	uint32_t raw = 0;
+
+	clock_get_calendar_microtime(&s, &us);
+	lck_mtx_lock(&lc_lock);
+	lc_init();
+	bool has_rtc = lc.rtc_ok && lc_rtc_raw(&raw) == 0;
+	if (has_rtc) {
+		snprintf(reply, size, "time %lu rtc %u offset %lld source %s", (unsigned long)s, raw, lc.offset, lc.source);
+	} else {
+		snprintf(reply, size, "time %lu rtc none source %s", (unsigned long)s, lc.source);
+	}
+	lck_mtx_unlock(&lc_lock);
+}
