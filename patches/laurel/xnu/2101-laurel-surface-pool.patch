+		lo = pa < lo ? pa : lo;
+		hi = pa + LAUREL_SPOOL_SIZE > hi ? pa + LAUREL_SPOOL_SIZE : hi;
+	}
+	laurel_spool_count = n;
+	if (n == 0) {
