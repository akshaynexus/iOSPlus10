+static void
+laurel_spool_fill(void)
+{
+	uint32_t on = 1;
+	uint64_t lo = ~0ull, hi = 0;
+	unsigned n = 0;
+
+	PE_parse_boot_argn("laurelspool", &on, sizeof(on));
+	if (on == 0) {
+		snprintf(laurel_spool_line, sizeof(laurel_spool_line), "LAUREL SPOOL: off: kill switch laurelspool=0");
+		IOLog("%s\n", laurel_spool_line);
+		return;
+	}
+	for (; n < LAUREL_SPOOL_COUNT; n++) {
