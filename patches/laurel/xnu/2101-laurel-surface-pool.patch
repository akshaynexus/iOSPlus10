+		    LAUREL_SPOOL_SIZE >> 20, laurel_ram_free_below_4g() >> 20);
+	} else {
+		snprintf(laurel_spool_line, sizeof(laurel_spool_line),
+		    "LAUREL SPOOL: on: %u x %u MiB contiguous below 4 GiB at 0x%llx-0x%llx for screen surfaces%s; below-4G free %llu MiB",
+		    n, LAUREL_SPOOL_SIZE >> 20, lo, hi, n < LAUREL_SPOOL_COUNT ? " (fewer than asked)" : "",
+		    laurel_ram_free_below_4g() >> 20);
+	}
