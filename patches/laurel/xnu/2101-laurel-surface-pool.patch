+
+/* A pool buffer (one more reference, for the surface) for size bytes, or NULL. */
+static IOBufferMemoryDescriptor *
+laurel_spool_take(uint64_t size)
+{
+	IOBufferMemoryDescriptor *mem = NULL;
+
+	if (laurel_spool_count == 0 || size > LAUREL_SPOOL_SIZE) {
+		return NULL;
+	}
+	IOLockLock(sweet_surface_lock);
+	for (unsigned i = 0; i < laurel_spool_count && mem == NULL; i++) {
+		/* free, and nobody holds it: only the pool's reference is left */
+		if (!laurel_spool_busy[i] && laurel_spool[i]->getRetainCount() == 1) {
+			laurel_spool_busy[i] = true;
+			mem = laurel_spool[i];
+			mem->retain();
+		}
+	}
+	if (mem != NULL) {
+		laurel_spool_takes++;
+	} else {
+		laurel_spool_misses++;
+	}
+	unsigned misses = laurel_spool_misses;
+	IOLockUnlock(sweet_surface_lock);
+	if (mem != NULL) {
+		bzero(mem->getBytesNoCopy(), LAUREL_SPOOL_SIZE);  /* (the surface clears its own part again) */
+	} else if (misses <= 4) {
+		IOLog("LAUREL SPOOL: all %u buffers in use (surface of %llu bytes): wired pages for this one (copy path)\n",
+		    laurel_spool_count, size);
+	}
+	return mem;
+}
+
+/* The surface lets go of md: true when it is a pool buffer (the caller still drops its reference). */
+static bool
+laurel_spool_give(IOMemoryDescriptor *md)
+{
+	bool mine = false;
+
+	if (laurel_spool_count == 0 || md == NULL) {
+		return false;
+	}
+	IOLockLock(sweet_surface_lock);
+	for (unsigned i = 0; i < laurel_spool_count && !mine; i++) {
+		if (laurel_spool[i] == md) {
+			laurel_spool_busy[i] = false;
+			mine = true;
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+	return mine;
+}
