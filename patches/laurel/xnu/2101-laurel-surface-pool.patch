+		if (mem != NULL) {
+			IOLog("LAUREL SURF: on: surfaces from wired pages (no contiguous RAM needed), first %llu bytes\n", size);
+		} else {
+			/* the first one failed: the feature is off, the contiguous path stays */
+			laurel_surf_on = 0;
+			IOLog("LAUREL SURF: off: a pageable buffer of %llu bytes could not be wired (0x%x)\n", size, ret);
+		}
+	}
+	return mem;
+}
