 static volatile uint32_t *lr_reason;      /* NULL: no IMEM reason (self-check failed) */
+/*
+ * laurel 2956: a panic ends in a reset on every path, and leaves a word for the boot menu. The IMEM restart word is ours already (qcom,msm-imem restart_reason@65c; Linux writes it too, nothing
+ * in ABL reads it [V ABL source, no 0x776655 there]). Mu reads it (tools/laurel-slot, LS_PANIC_WORD) and skips the retries refill, so ABL's count goes on. The next start of this kernel writes it back.
+ */
+#define LR_PANIC_WORD    0x4C504E43u
+static volatile int lr_in_panic;
 static unsigned lr_mode;                   /* index in lr_modes */
 static int lr_on;
 
