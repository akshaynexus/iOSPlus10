 }
 
+/* laurel 2956: from kPEPanicBegin on. Before laurel_reboot_prepare there is no mapping: no word, and the menu's gate still needs a key. */
+void laurel_panic_mark(void);
+void
+laurel_panic_mark(void)
+{
+	lr_in_panic = 1;
+	if (lr_reason != NULL) {
+		*lr_reason = LR_PANIC_WORD;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
+
+/*
+ * laurel 2956: the last stop of a panic. laurel_usb_panic_hold returns when USB is not running, and with debug=0xc (DB_NMI, panicDebugging) XNU never sends kPEPanicRestartCPU: it
+ * spins. Called from kPEPanicDiagnosticsDone after the hold and from panic_spin_forever (osfmk/kern/debug.c), so it also works before SweetPlatformExpert::start, when PE_halt_restart is not set.
+ * laurelpanic=N: wait N s (the panel shows the panic), then reset. Not set or 0: returns, XNU spins as before. Counts the system counter directly: the timebase may not be set yet.
+ * A nested panic on this CPU resets at once. Another CPU spins: this one resets.
+ */
+void laurel_panic_final(void);
+void
+laurel_panic_final(void)
+{
+	static volatile int entries;
+	static volatile int cpu = -1;
+	int secs = 0;
+
+	laurel_panic_mark();
+	if (entries++ != 0) {
+		if (cpu == cpu_number()) {
+			(void)lr_psci(PSCI_SYSTEM_RESET);
+		}
+		return;
+	}
+	cpu = cpu_number();
+	PE_parse_boot_argn("laurelpanic", &secs, sizeof(secs));
+	if (secs <= 0) {
+		entries = 0;            /* no timed reset: the nested rule above must not reset either */
+		return;
+	}
+	kdb_printf("LAUREL PANIC: reset in %d s\n", secs);
+	uint64_t freq = __builtin_arm_rsr64("CNTFRQ_EL0");
+	uint64_t start = __builtin_arm_rsr64("CNTVCT_EL0");
+	while (__builtin_arm_rsr64("CNTVCT_EL0") - start < (uint64_t)secs * freq) {
+	}
+	if (lr_on) {
+		laurel_restart();
+	}
+	(void)lr_psci(PSCI_SYSTEM_RESET);
+}
+
