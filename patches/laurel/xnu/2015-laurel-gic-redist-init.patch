+#if defined(SWEET)
+/*
+ * laurel 2015: per-CPU GIC redistributor init with read-back.
+ * SGI/PPI frame registers (GICv3 spec, GIC-600 TRM for PWRR).
+ */
+#define GICR_CTLR_REG     0x00
+#define GICR_IIDR         0x04
+#define GICR_PWRR         0x24      /* GIC-600 only: RDPD bit 0, RDAG 1, RDGPD 2, RDGPO 3 */
+#ifndef GICR_ISPENDR0
+#define GICR_ISPENDR0     0x10200
+#endif
+#ifndef GICR_ISACTIVER0
+#define GICR_ISACTIVER0   0x10300
+#endif
+#define GICR_ICENABLER0   0x10180
+#define GICR_ICPENDR0     0x10280
+#define GICR_ICACTIVER0   0x10380
+#define GICR_ICFGR1       0x10C04
+#define GICR_IGRPMODR0    0x10D00
+#define LAUREL_PTIMER_INTID 18      /* Qualcomm: NS physical timer = PPI 2 (Mu's timer) */
+
+struct laurel_gic_cpu {
+	uint32_t mpidr;
+	uint32_t frame;          /* index of the GICR frame used; bit 31 = fallback match (TYPER read 0) */
+	uint32_t typer_lo, typer_hi, iidr, pwrr, waker;
+	uint32_t en_before, en_after, want;
+	uint32_t grp, grpmod, pend, active, cfg1, prio16;
+	uint32_t tries;          /* 1 = first write stuck, 2 = after the retry, 0 = the timer PPI never enabled */
+};
+static struct laurel_gic_cpu laurel_gic_boot;           /* the boot CPU's record for the LOCKDOWN report */
+static bool laurel_gic_boot_recorded;
+static uint32_t laurel_gic_cpus_ok, laurel_gic_cpus_bad; /* every CPU after the boot CPU */
+
+static inline uint32_t
+laurel_gicr_want(void)
+{
+	return (1U << sweet_vtimer_intid) | (1U << LAUREL_PTIMER_INTID) | (1U << SWEET_IPI_SGI);
+}
+
+static void
+laurel_gicr_program(vm_offset_t gicr_pe_base, uint32_t want)
+{
+	/* nothing is in service on this CPU here: disable, deactivate, clear pending */
+	gicr_write32(GICR_ICENABLER0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 100000 && (gicr_read32(GICR_CTLR_REG) & 0x8); i++) {
+		; /* GICR_CTLR.RWP */
+	}
+	gicr_write32(GICR_ICACTIVER0, 0xFFFFFFFF);
+	gicr_write32(GICR_ICPENDR0, 0xFFFFFFFF);
+	gicr_write32(GICR_IGROUPR0, 0xFFFFFFFF);        /* Group 1 (NS view: NS Group 1) */
+	gicr_write32(GICR_IGRPMODR0, 0);                /* not Secure Group 1 */
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0); /* below PMR */
+	}
+	gicr_write32(GICR_ISENABLER0, want);
+	__builtin_arm_dsb(DSB_SY);
+}
+
+static void
+laurel_gicr_setup(vm_offset_t gicr_pe_base)
+{
+	struct laurel_gic_cpu st;
+	uint64_t typer = gicr_read64(GICR_TYPER);
+
+	bzero(&st, sizeof(st));
+	st.mpidr = (uint32_t)(__builtin_arm_rsr64("MPIDR_EL1") & 0xFFFFFF);
+	st.frame = (uint32_t)((gicr_pe_base - gicr_base) / GICR_PE_SIZE) | (laurel_gicr_fallback_match ? 0x80000000u : 0);
+	st.typer_lo = (uint32_t)typer;
+	st.typer_hi = (uint32_t)(typer >> 32);
+	st.iidr = gicr_read32(GICR_IIDR);
+	st.pwrr = gicr_read32(GICR_PWRR);
+	st.en_before = gicr_read32(GICR_ISENABLER0);
+	st.want = laurel_gicr_want();
+
+	for (uint32_t t = 1; t <= 2; t++) {
+		if (t == 2 && (gicr_read32(GICR_PWRR) & 0x1)) {
+			/* GIC-600: a powered-down redistributor ignores writes. NS may not own PWRR; try. */
+			gicr_write32(GICR_PWRR, 0);
+			for (unsigned int i = 0; i < 100000 && (gicr_read32(GICR_PWRR) & 0x1); i++) {
+				;
+			}
+		}
+		laurel_gicr_program(gicr_pe_base, st.want);
+		st.en_after = gicr_read32(GICR_ISENABLER0);
+		if (st.en_after & (1U << sweet_vtimer_intid)) {
+			st.tries = t;
+			break;
+		}
+	}
+	st.waker = gicr_read32(GICR_WAKER);
+	st.grp = gicr_read32(GICR_IGROUPR0);
+	st.grpmod = gicr_read32(GICR_IGRPMODR0);
+	st.pend = gicr_read32(GICR_ISPENDR0);
+	st.active = gicr_read32(GICR_ISACTIVER0);
+	st.cfg1 = gicr_read32(GICR_ICFGR1);
+	st.prio16 = gicr_read32(GICR_IPRIORITYR0 + 16);
+	st.pwrr = gicr_read32(GICR_PWRR);
+
+	if (!laurel_gic_boot_recorded) {
+		laurel_gic_boot = st;
+		laurel_gic_boot_recorded = true;
+		return;
+	}
+	if (st.tries) {
+		os_atomic_inc(&laurel_gic_cpus_ok, relaxed);
+	} else {
+		os_atomic_inc(&laurel_gic_cpus_bad, relaxed);
+	}
+	/* ring only (laurel 2014): the USB log carries it */
+	kprintf("LAUREL GIC: %s: cpu mpidr=0x%x gicr frame %u TYPER 0x%08x%08x IIDR 0x%08x PWRR 0x%x "
+	    "ISENABLER0 0x%08x (was 0x%08x, want 0x%08x, try %u) WAKER 0x%x pend 0x%08x act 0x%08x\n",
+	    st.tries ? "on" : "off", st.mpidr, st.frame & 0x7FFFFFFF, st.typer_hi, st.typer_lo, st.iidr, st.pwrr,
+	    st.en_after, st.en_before, st.want, st.tries, st.waker, st.pend, st.active);
+}
+
+/* Panel report at STARTUP(LOCKDOWN), before the USB timer-service check (same rank order: FIRST here, SECOND there). */
+static void
+laurel_gic_report(void)
+{
+	struct laurel_gic_cpu *s = &laurel_gic_boot;
+	if (!laurel_gic_boot_recorded) {
+		printf("LAUREL GIC: off: no redistributor init ran on the boot CPU\n");
+		return;
+	}
+	printf("LAUREL GIC: %s: boot cpu mpidr=0x%x gicr frame %u%s TYPER 0x%08x%08x IIDR 0x%08x PWRR 0x%x "
+	    "ISENABLER0 0x%08x (was 0x%08x, want 0x%08x, try %u)\n",
+	    s->tries ? "on" : "off", s->mpidr, s->frame & 0x7FFFFFFF, (s->frame & 0x80000000) ? " (fallback)" : "",
+	    s->typer_hi, s->typer_lo, s->iidr, s->pwrr, s->en_after, s->en_before, s->want, s->tries);
+	printf("LAUREL GIC: IGROUPR0 0x%08x IGRPMODR0 0x%08x ISPENDR0 0x%08x ISACTIVER0 0x%08x ICFGR1 0x%08x "
+	    "prio16 0x%08x WAKER 0x%x GICD_CTLR 0x%08x%s\n",
+	    s->grp, s->grpmod, s->pend, s->active, s->cfg1, s->prio16, s->waker, gicd_read32(GICD_CTLR),
+	    s->tries ? "" : " | timer PPI not enableable from EL1 NS on this frame");
+}
+STARTUP(LOCKDOWN, STARTUP_RANK_FIRST, laurel_gic_report);
+#endif /* SWEET */
