+/* laurel 2409: only these channels (count 0: all of ours), so many ms on each (0: ours). One caller at a time. */
+int
+topaz_wlan_scan_on(const uint16_t *freqs, unsigned count, unsigned dwell_ms)
+{
+	uint32_t n = 0;
+
+	for (unsigned i = 0; i < count; i++) {
+		for (uint32_t k = 0; k < NFREQ && n < NFREQ; k++) {
+			if (scan_freqs[k] == freqs[i]) {
+				lw_ask_freqs[n++] = freqs[i];
+				break;
+			}
+		}
+	}
+	lw_ask_n = n;
+	lw_ask_dwell = dwell_ms > 150 ? 150 : dwell_ms;
+	return topaz_wlan_scan();
+}
