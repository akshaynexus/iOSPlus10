+/*
+ * laurel 2872: the wake's self-check: one DCS 0x0A with the light still out (a disturbed frame cannot be seen). Bits 7, 4, 3, 2
+ * (booster, sleep out, normal, display on) must be set; bits 1, 0 are reserved in DCS and vendor-defined here (boot 19:34: 0x9f
+ * before the first real sleep, 0x9d after it). A panel found off gets the sleep-out sequence once and one more read.
+ * No answer 3 times: no more reads. Nothing here turns off the display path. Called with fPwrLock held, fBlHold set.
+ */
+void
+AppleCLCD::panelWakeCheck(void)
+{
+	uint8_t power = 0;
+	if (!fRdOn) {
+		return;
+	}
+	if (dsiDcsRead(0x0a, &power, 1) != 1) {
+		if (++fRdFails >= 3) {
+			fRdOn = false;
+			IOLog("LAUREL PANEL: wake check off: 3 reads without an answer (the display path goes on)\n");
+		}
+		return;
+	}
+	fRdFails = 0;
+	uint32_t n = ++fWakeChecks;
+	if ((power & LAUREL_POWER_ON) == LAUREL_POWER_ON) {
+		if (n <= 8 || power != fPanelPowerLast) {
+			IOLog("LAUREL PANEL: wake %u: panel power %#x (start %#x)\n", n, power, fPanelPower0);
+		}
+		fPanelPowerLast = power;
+		return;
+	}
+	bool done = panelWakeSeq();
+	uint8_t after = 0;
+	bool read = dsiDcsRead(0x0a, &after, 1) == 1;
+	fPanelPowerLast = after;
+	IOLog("LAUREL PANEL: wake %u: panel power %#x (start %#x): the panel is off: sleep out + display on once: %s, power now %#x%s\n",
+	    n, power, fPanelPower0, done ? "done" : "NO DONE", after, read ? "" : " (no answer)");
+}
