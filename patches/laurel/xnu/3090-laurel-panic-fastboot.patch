+/*
+ * laurel 3090: where a panic lands. Before: the timed reset of a panic (laurelpanic=N, or 20 s after a bark) booted normally, and
+ * ABL's retries of slot b ran out after 6 such boots: the phone ended on Android, or looped, and the owner's keys were the way back.
+ * Now every reset that a panic starts (the timed one of the USB hold, the one of a panic with no USB, a nested panic in the hold)
+ * selects the mode "bootloader": ABL's fastboot, where the host (scripts/laurel/phone-guardian.sh) flashes or reboots with no key.
+ * A USB command in the hold (ctl reboot|bootloader|recovery|poweroff) keeps its own mode. laurelpanicfb=0: a normal boot, as before.
+ * laurelpanic=N: the hold waits N s for a host command first; not given: 30 s; 0: for ever (bring-up: the text stays, op10tool ctl ends it).
+ */
+#define LR_PANIC_SECS_DEFAULT  30
+static int lr_panic_fb = 1;
+int laurel_panic_secs(void);
+int
+laurel_panic_secs(void)
+{
+	int secs = 0;
+	if (!PE_parse_boot_argn("laurelpanic", &secs, sizeof(secs))) {
+		return LR_PANIC_SECS_DEFAULT;
+	}
+	return secs > 0 ? secs : 0;
+}
+const char *laurel_panic_mode(void);
+const char *
+laurel_panic_mode(void)
+{
+	return lr_panic_fb ? "bootloader" : "normal";
+}
+
