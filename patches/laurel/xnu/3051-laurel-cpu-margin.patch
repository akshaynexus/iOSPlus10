diff --git a/bsd/dev/laurel_gov_core.h b/bsd/dev/laurel_gov_core.h
--- a/bsd/dev/laurel_gov_core.h
+++ b/bsd/dev/laurel_gov_core.h
@@ -74,4 +74,13 @@
 	}
 	return want > cap ? cap : want;
 }
+/* laurel 3051 (LAUREL CPU MARGIN): the highest row in use: the last row of a table of `rows`, less `margin` rows, never below row 1 */
+static inline unsigned
+lgov_top_row(unsigned rows, unsigned margin)
+{
+	unsigned top = rows ? rows - 1 : 0;
+
+	return top > margin ? top - margin : (top ? 1 : 0);
+}
