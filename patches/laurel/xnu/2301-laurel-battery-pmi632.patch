+static void lp_charger_failsafe(const char *why);
+static uint64_t now_ns(void);
+static int jeita_hw_check(unsigned *hot, unsigned *cold);
+static volatile int lp_init_busy;
+
+/* SweetBattery::start (IOKit) and load_init_program (init thread) may both call it: one runs it */
+int
+laurel_pmi632_init(void)
+{
+	while (!__sync_bool_compare_and_swap(&lp_init_busy, 0, 1)) {
+		IOSleep(1);
+	}
+	int rc = lp_state >= 0 ? (lp_state ? 0 : -1) : lp_init_locked();
+	__sync_lock_release(&lp_init_busy);
+	return rc;
+}
+
+static int
+lp_init_locked(void)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("laurelbatt", &on, sizeof(on));
+	if (!on) {
+		lp_state = 0;
+		printf("LAUREL BATTERY: off: laurelbatt=0\n");
+		return -1;
+	}
+	if (sweet_spmi_init() != 0) {
+		lp_state = 0;
+		printf("LAUREL BATTERY: off: SPMI arbiter not ready\n");
+		return -1;
+	}
+	lp_lock = IOLockAlloc();
+	if (!lp_lock) {
+		lp_state = 0;
+		printf("LAUREL BATTERY: off: no lock\n");
+		return -1;
+	}
+	uint8_t type = 0, sub = 0, st1 = 0;
+	uint16_t v = 0;
+	if (rd(QG + 0x04, &type) || type != 0x0d) {
+		lp_state = 0;
+		printf("LAUREL BATTERY: off: PMI632 QG type 0x%02x (want 0x0d)\n", type);
+		lp_charger_failsafe("battery gauge off");
+		return -1;
+	}
+	if (rd(QG + 0x05, &sub) || rd(QG + 0x08, &st1) || !(st1 & 1u)) {
+		lp_state = 0;
+		printf("LAUREL BATTERY: off: no battery (QG status1 0x%02x)\n", st1);
+		lp_charger_failsafe("battery gauge off");
+		return -1;
+	}
+	unsigned mv = (rd16(QG + 0xc0, &v) == 0) ? (unsigned)(((uint64_t)v * 194637u) / 1000000u) : 0;
+	if (mv < 2800 || mv > 4600) {
+		lp_state = 0;
+		printf("LAUREL BATTERY: off: implausible vbat %u mV\n", mv);
+		lp_charger_failsafe("battery gauge off");
+		return -1;
+	}
+	lp_ilsb_nua = sub == 4 ? 305176u : 152588u;
+	read_pon();
+
+	/* learned capacity and cycle count of the Linux QG (SDAM) */
+	uint16_t cap = 0;
+	if (rd16(SDAM + 0x68, &cap) == 0 && cap >= 3000 && cap <= 4600) {
+		lp_cap_mah = cap;
+	}
+	uint32_t sum = 0;
+	bool cyc_ok = true;
+	for (unsigned i = 0; i < 8; i++) {
+		uint16_t c;
+		if (rd16(SDAM + 0x58 + 2 * i, &c)) {
+			cyc_ok = false;
+			break;
+		}
+		sum += c;
+	}
+	if (cyc_ok && sum / 8 < 5000) {
+		lp_cycles = (int)(sum / 8);
+	}
+
+	/* start SoC */
+	uint16_t ocvr = 0;
+	unsigned ocv = (rd16(QG + 0x70, &ocvr) == 0) ? (unsigned)(((uint64_t)ocvr * 194637u) / 1000000u) : 0;
+	bool ocv_ok = ocv >= 3000 && ocv <= 4500;
+	int saved = load_record();
+	const char *saved_src = "sdam";
+	if (saved < 0) {
+		uint8_t valid = 0, s = 0;
+		if (rd(SDAM + 0x46, &valid) == 0 && valid == 1 && rd(SDAM + 0x47, &s) == 0 && s <= 100) {
+			saved = s * 100;
+			saved_src = "qg-sdam";
+		}
+	}
+	bool warm = lp_pon_known && lp_pon_warm != 0;
+	int ocv_cent = ocv_ok ? (int)ocv_soc_cent(ocv) : -1;
+	if (saved >= 0 && (warm || !ocv_ok || (saved - ocv_cent <= 1000 && ocv_cent - saved <= 1000))) {
+		lp_soc_cent = saved;
+		lp_soc_src = saved_src;
+	} else if (ocv_ok) {
+		lp_soc_cent = ocv_cent;
+		lp_soc_src = "pon-ocv";
+	} else {
+		lp_soc_cent = (int)ocv_soc_cent(mv);
+		lp_soc_src = "vbat";
+	}
+	lp_soc_uah = (int64_t)lp_soc_cent * lp_cap_mah / 10;   /* 0.01 % * mAh * 1000 / 10000 = uAh */
+	lp_saved_pct = saved >= 0 ? saved / 100 : -1;
+	lp_last_ns = 0;
+
+	int t = 0;
+	lp_temp_on = sweet_spmi_owner(PMI_SID, 0x31) == 0 && read_temp(&t) == 0;
+	if (lp_temp_on) {
+		lp_last_temp = t;
+	}
+	lp_save_on = sweet_spmi_owner(PMI_SID, 0xb1) == 0;
+
+	int chg = 1;
+	(void)PE_parse_boot_argn("laurelchg", &chg, sizeof(chg));
+	int oc = sweet_spmi_owner(PMI_SID, 0x10), ou = sweet_spmi_owner(PMI_SID, 0x13);
+	uint8_t fcc = 0, fv = 0;
+	uint8_t jen = 0;
+	unsigned hot = 0, cold = 0;
+	int jh = -1;
+	if (ou == 0) {
+		lp_release_left_suspend();
+	}
+	bool safe_needed = false;
+	if (!chg) {
+		printf("LAUREL CHARGER: off: laurelchg=0\n");
+	} else if (!lp_temp_on) {
+		safe_needed = true;
+		printf("LAUREL CHARGER: off: no battery NTC (ADC5 BAT_THERM_PU2 not readable; hardware limits only)\n");
+	} else if (oc != 0 || ou != 0) {
+		printf("LAUREL CHARGER: off: SMB5 CHGR/USBIN owned by EE %d/%d, not 0 (reads only)\n", oc, ou);
+	} else if (rd(CHGR + 0x61, &fcc) || rd(CHGR + 0x70, &fv) || wr(CHGR + 0x70, fv) || rd(CHGR + 0x90, &jen)) {
+		safe_needed = true;
+		printf("LAUREL CHARGER: off: SMB5 write check failed\n");
+	} else if ((jh = jeita_hw_check(&hot, &cold)) < 0) {
+		safe_needed = true;
+		printf("LAUREL CHARGER: off: hardware JEITA hard limits hot 0x%04x cold 0x%04x not at 60/0 C and not writable\n",
+		    hot, cold);
+	} else if (!lp_guard_tc && !(lp_guard_tc = thread_call_allocate(lp_guard_fire, NULL))) {
+		safe_needed = true;
+		printf("LAUREL CHARGER: off: no NTC watchdog timer\n");
+	} else {
+		lp_boot_fcc = fcc;
+		lp_boot_fv = fv;
+		lp_temp_ok_ns = now_ns();
+		lp_chg_on = true;
+		printf("LAUREL CHARGER: on: SMB5 owner EE 0, boot FCC %u mA FV %u mV; hard JEITA hot 0x%04x cold 0x%04x%s "
+		    "(JEITA_EN_CFG 0x%02x); software JEITA zones on the NTC, ICL from APSD\n",
+		    fcc * 50u, 3600u + fv * 10u, hot, cold, jh ? " -> Linux 0x15aa/0x6894" : "", jen);
+		lp_guard_arm();
+	}
+	/* control cannot run (no NTC, bad hard limits, no timer) but the charger is ours: 500 mA / 4100 mV */
+	if (safe_needed && oc == 0 && ou == 0) {
+		IOLockLock(lp_lock);
+		int rc = lp_write_safe();
+		IOLockUnlock(lp_lock);
+		printf("LAUREL CHARGER: safe limits FCC %u mA FV %u mV without software JEITA (%s)\n", SAFE_FCC_MA, SAFE_FV_MV,
+		    rc ? "a write failed: retried every 10 s" : "written");
+		if (rc) {
+			lp_guard_start();
+		}
+	}
+	lp_state = 1;
+	printf("LAUREL BATTERY: on: PMI632 QG soc %d%% (%s; pon-ocv %u mV) vbat %u mV temp %s%d.%d C cap %u mAh cycles %d; "
+	    "pon 0x%02x warm 0x%02x pmi 0x%02x; save %s\n",
+	    lp_soc_cent / 100, lp_soc_src, ocv, mv, lp_temp_on ? "" : "(fixed) ", lp_last_temp / 10,
+	    (lp_last_temp < 0 ? -lp_last_temp : lp_last_temp) % 10, lp_cap_mah, lp_cycles, lp_pon_reason, lp_pon_warm,
+	    lp_pmi_reason, lp_save_on ? "on" : "off (SDAM not EE 0)");
+	return 0;
+}
+
+/* write FCC/FV in the safe order (FV down before, up after) */
+static int
+set_fcc_fv(uint8_t fcc, uint8_t fv)
+{
+	uint8_t cur = 0;
+	if (rd(CHGR + 0x70, &cur) != 0) {
+		/* FV unknown: write FV, then FCC, both read back (a failure is retried by the caller) */
+		return wr(CHGR + 0x70, fv) | wr(CHGR + 0x61, fcc);
+	}
+	int rc = 0;
+	if (fv < cur) {
+		rc |= wr(CHGR + 0x70, fv);
+	}
+	rc |= wr(CHGR + 0x61, fcc);
+	if (fv > cur) {
+		rc |= wr(CHGR + 0x70, fv);
+	}
+	return rc;
+}
+
+/* USB input un-suspended and the ICL back to HW_AUTO (smblib_icl_override: no override after APSD) */
+static int
+input_auto(void)
+{
+	int rc = 0;
+	uint8_t v = 0;
+	if (lp_usb_susp) {
+		if (rd(USBIN + 0x40, &v) == 0) {
+			rc |= wr(USBIN + 0x40, (uint8_t)(v & ~0x01u));
+			lp_usb_cmd = (uint8_t)(v & ~0x01u);
+		} else {
+			rc = -1;
+		}
+		lp_usb_susp = false;
+	}
+	if (rd(USBIN + 0x65, &v) == 0) {
+		if (v & 0x10u) {
+			rc |= wr(USBIN + 0x65, (uint8_t)(v & ~0x10u));
+		}
+	} else {
+		rc = -1;
+	}
+	return rc;
+}
+
+/*
+ * charger control off: always 500 mA at 4100 mV first (software JEITA is off from here on); the boot
+ * limits come back only when they are not above that (no 3000 mA / 4400 mV without our JEITA).
+ */
+static void
+chg_off(const char *why)
+{
+	uint8_t sfcc = (uint8_t)(SAFE_FCC_MA / 50u), sfv = (uint8_t)((SAFE_FV_MV - 3600u) / 10u);
+	int rc = lp_write_safe();               /* failure: lp_safe_pending, retried by the guard timer */
+	bool boot = rc == 0 && lp_boot_fcc <= sfcc && lp_boot_fv <= sfv && (lp_boot_fcc != sfcc || lp_boot_fv != sfv);
+	if (boot) {
+		rc |= set_fcc_fv(lp_boot_fcc, lp_boot_fv);
+	}
+	lp_chg_on = false;
+	lp_zone = LP_ZONES;
+	printf("LAUREL CHARGER: off: %s; FCC %u mA FV %u mV%s (%s)\n", why,
+	    (boot ? lp_boot_fcc : sfcc) * 50u, 3600u + (boot ? lp_boot_fv : sfv) * 10u, boot ? " (boot limits)" : " (safe)",
+	    rc ? "a write failed: retried every 10 s" : "written");
+	if (rc) {
+		lp_guard_start();
+	}
+}
+
+/*
+ * Hardware JEITA hard limits (charger stops by itself): CHGR_JEITA_THRESHOLD_BASE_REG(JEITA_HARD) 0x1098,
+ * hot code at 0x98/0x99 (MSB first), cold at 0x9a/0x9b; Linux writes qcom,jeita-hard-thresholds
+ * <0x6894 0x15aa> (cold 0 C, hot 60 C) in smblib_update_jeita (smb5-lib.c:4841, 7904). Not near those
+ * codes: write them and read back. 0 = as Linux, 1 = written now, -1 = not usable.
+ */
+static int
+jeita_hw_check(unsigned *hot, unsigned *cold)
+{
+	uint8_t r[4];
+	for (unsigned i = 0; i < 4; i++) {
+		if (rd(CHGR + 0x98 + i, &r[i])) {
+			return -1;
+		}
+	}
+	*hot = (unsigned)(r[0] << 8 | r[1]);
+	*cold = (unsigned)(r[2] << 8 | r[3]);
+	/* only the safe side: a lower code is hotter, so hot >= 0x15aa trips at <= 60 C, cold <= 0x6894 at >= 0 C */
+	bool hot_ok = *hot >= 0x15aau && *hot <= 0x15aau + 0x200u;
+	bool cold_ok = *cold <= 0x6894u && *cold >= 0x6894u - 0x400u;
+	if (hot_ok && cold_ok) {
+		return 0;
+	}
+	static const uint8_t lin[4] = { 0x15, 0xaa, 0x68, 0x94 };
+	for (unsigned i = 0; i < 4; i++) {
+		if (wr(CHGR + 0x98 + i, lin[i])) {
+			return -1;
+		}
+	}
+	return 1;
+}
+
+static unsigned
+jeita_zone(int dC)
+{
+	unsigned z = 0;
+	while (z + 1 < LP_ZONES && dC >= lp_jeita[z + 1].min_dC) {
+		z++;
+	}
+	return z;
+}
+
+static unsigned
+family_code(uint8_t apsd, uint8_t snk)
+{
+	if (apsd & 0x60u) {
+		return 0xe0004004u;                     /* QC 2.0/3.0 (HVDCP): dedicated port */
+	}
+	if (apsd & 0x08u) {
+		return 0xe0004004u;                     /* DCP: kIOPSFamilyCodeUSBChargingPortDedicated */
+	}
+	if (apsd & 0x04u) {
+		return 0xe0004005u;                     /* CDP: kIOPSFamilyCodeUSBChargingPortDownstream */
+	}
+	if (apsd & 0x01u) {
+		return (snk & 0x06u) ? 0xe0004009u : 0xe0004000u;      /* Type-C current, else USB host */
+	}
+	return 0xe0004007u;                             /* float / unknown */
+}
+
+/* input limit for the APSD result; 0 = leave it to the hardware */
+static unsigned
+want_icl(uint8_t apsd, uint8_t snk)
+{
+	if (apsd & 0x68u) {
+		return 2000;    /* QC, DCP */
+	}
+	if (apsd & 0x10u) {
+		return 1000;    /* float */
+	}
+	if (apsd & 0x04u) {
+		return 1500;    /* CDP */
+	}
+	if (apsd & 0x01u) {
+		return (snk & 0x02u) ? 2000 : (snk & 0x04u) ? 1500 : 0;   /* SDP with Rp 3.0 / 1.5 A */
+	}
+	return 0;
+}
+
+static void
+charger_step(struct laurel_batt *b, uint8_t apsd, uint8_t snk, bool external, unsigned mv, uint64_t ns)
+{
+	if (!lp_chg_on) {
+		return;
+	}
+	if (!external) {
+		/* unplug: ICL back to HW_AUTO, input un-suspended, a safe FCC for the next plug-in (until the next step) */
+		if (lp_was_ext) {
+			lp_was_ext = false;
+			lp_zone = LP_ZONES;
+			uint8_t fcc = 0;
+			int rc = input_auto();
+			if (rd(CHGR + 0x61, &fcc) == 0 && fcc > SAFE_FCC_MA / 50u) {
+				rc |= wr(CHGR + 0x61, (uint8_t)(SAFE_FCC_MA / 50u));
+			}
+			if (rc) {
+				chg_off("SMB5 write failed at unplug");
+			}
+		}
+		return;
+	}
+	lp_was_ext = true;
+	(void)ns;       /* the NTC watchdog runs in lp_guard_locked before every step */
+	int dC = lp_last_temp;
+	unsigned z = jeita_zone(dC);
+	if (lp_zone < LP_ZONES && z != lp_zone && lp_jeita[z].fcc_ma >= lp_jeita[lp_zone].fcc_ma &&
+	    (jeita_zone(dC - 15) != z || jeita_zone(dC + 15) != z)) {
+		z = lp_zone;
+	}
+	unsigned icl = want_icl(apsd, snk);
+	uint8_t fcc = 0, fv = 0, icfg = 0, opt = 0, ovr = 0, load = 0, cmd = 0;
+	if (rd(CHGR + 0x61, &fcc) || rd(CHGR + 0x70, &fv) || rd(USBIN + 0x70, &icfg) || rd(USBIN + 0x66, &opt) ||
+	    rd(USBIN + 0x42, &ovr) || rd(USBIN + 0x65, &load) || rd(USBIN + 0x40, &cmd)) {
+		return;
+	}
+	uint8_t wfcc = (uint8_t)(lp_jeita[z].fcc_ma / 50u), wfv = (uint8_t)((lp_jeita[z].fv_mv - 3600u) / 10u);
+	int rc = 0;
+	bool changed = wfcc != fcc || wfv != fv;
+	if (changed) {
+		rc |= set_fcc_fv(wfcc, wfv);
+	}
+	if (icl) {
+		uint8_t wicfg = (uint8_t)(icl / 50u);
+		if (wicfg != icfg) {
+			rc |= wr(USBIN + 0x70, wicfg);
+			changed = true;
+		}
+		if (!(opt & 0x01u)) {
+			rc |= wr(USBIN + 0x66, (uint8_t)(opt | 0x01u));      /* USBIN_MODE_CHG: high-current mode */
+			changed = true;
+		}
+		if (ovr & 0x01u) {
+			rc |= wr(USBIN + 0x42, (uint8_t)(ovr & ~0x01u));     /* no USB51 ICL override */
+			changed = true;
+		}
+		if (!(load & 0x10u)) {
+			rc |= wr(USBIN + 0x65, (uint8_t)(load | 0x10u));     /* ICL_OVERRIDE_AFTER_APSD */
+			changed = true;
+		}
+	} else if (load & 0x10u) {
+		rc |= wr(USBIN + 0x65, (uint8_t)(load & ~0x10u));            /* HW_AUTO: the hardware's ICL */
+		changed = true;
+	}
+	/*
+	 * Warm zone (FV 4100 mV): a cell above FV + 50 mV cannot come down by charging at the lower FV;
+	 * suspend the USB input until it is below FV - 50 mV (Linux step-chg-jeita.c handle_jeita,
+	 * JEITA_SUSPEND_HYST_UV; USBIN_CMD_IL 0x1340 bit 0).
+	 */
+	unsigned zfv = lp_jeita[z].fv_mv;
+	bool susp = lp_usb_susp;
+	if (zfv < FV_MV && !susp && mv && mv > zfv + 50u) {
+		susp = true;
+	} else if (susp && (zfv >= FV_MV || (mv && mv + 50u < zfv))) {
+		susp = false;
+	}
+	if (susp != lp_usb_susp) {
+		lp_usb_cmd = (uint8_t)(cmd & ~0x01u);
+		rc |= wr(USBIN + 0x40, (uint8_t)(susp ? (cmd | 0x01u) : (cmd & ~0x01u)));
+		lp_usb_susp = susp;
+		changed = true;
+	}
+	if (rc) {
+		chg_off("SMB5 write failed");
+		return;
+	}
+	if (changed || z != lp_zone) {
+		printf("LAUREL CHARGER: on: SMB5 usbin apsd 0x%02x rp 0x%02x, %d.%d C zone %u: ICL %u mA, FCC %u mA, FV %u mV, %s\n",
+		    apsd, snk, dC / 10, (dC < 0 ? -dC : dC) % 10, z, icl ? icl : 50u * icfg, lp_jeita[z].fcc_ma,
+		    zfv, lp_usb_susp ? "input suspended (vbat above the warm FV)" :
+		    lp_jeita[z].fcc_ma ? "charging" : "NOT charging (temperature)");
+	}
+	lp_zone = z;
+	b->fcc_ma = lp_jeita[z].fcc_ma;
+	b->fv_mv = zfv;
+}
+
+/* the inputs of one charger step */
+struct lp_in {
+	uint8_t usbrt, path, apsd_st, apsd, snk;
+	bool external, temp_ok;
+};
+
+/*
+ * Locked. A fresh NTC sample, the NTC watchdog (no good sample for 30 s: 500 mA / 4100 mV and control
+ * off, whatever else fails) and one charger step. Runs first in every laurel_pmi632_sample (before any
+ * gauge read can return early) and from the GUARD_S timer, which does not depend on SweetBattery.
+ */
+static void
+lp_guard_locked(uint64_t ns, struct lp_in *in, struct laurel_batt *b)
+{
+	bzero(in, sizeof(*in));
+	int t = 0;
+	in->temp_ok = lp_temp_on && read_temp(&t) == 0;
+	if (in->temp_ok) {
+		lp_last_temp = t;
+		lp_temp_ok_ns = ns;
+	}
+	if (lp_chg_on && ns - lp_temp_ok_ns > NTC_STALE_NS) {
+		chg_off("no battery NTC sample for 30 s");
+	}
+	bool ok = rd(USBIN + 0x10, &in->usbrt) == 0 && rd(DCDC + 0x0b, &in->path) == 0;
+	(void)rd(USBIN + 0x07, &in->apsd_st);
+	(void)rd(USBIN + 0x08, &in->apsd);
+	(void)rd(TYPEC + 0x06, &in->snk);
+	/* a suspended input (our warm-zone suspend) has no valid power path but is still plugged in */
+	in->external = ok && (in->usbrt & 0x10u) && ((in->path & 0x01u) || lp_usb_susp);
+	uint16_t vr = 0;
+	unsigned mv = rd16(QG + 0xc0, &vr) == 0 ? (unsigned)(((uint64_t)vr * 194637u) / 1000000u) : 0;
+	if (mv < 2800 || mv > 4600) {
+		mv = 0;         /* unknown: the warm-zone suspend keeps its state */
+	}
+	if (ok) {
+		charger_step(b, (in->apsd_st & 1u) ? in->apsd : 0, in->snk, in->external, mv, ns);
+	}
+}
+
+static void
+lp_guard_fire(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
+{
+	struct lp_in in;
+	struct laurel_batt scratch;
+	IOLockLock(lp_lock);
+	if (lp_safe_pending) {
+		if (lp_write_safe() == 0) {
+			printf("LAUREL CHARGER: safe limits FCC %u mA FV %u mV written after %u retries\n", SAFE_FCC_MA, SAFE_FV_MV,
+			    lp_safe_tries);
+		}
+	}
+	if (lp_chg_on) {
+		bzero(&scratch, sizeof(scratch));
+		lp_guard_locked(now_ns(), &in, &scratch);
+	}
+	bool again = lp_chg_on || lp_safe_pending;      /* never stop while a safe write is pending */
+	IOLockUnlock(lp_lock);
+	if (again) {
+		lp_guard_arm();
+	}
+}
+
+static void
+lp_guard_arm(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(GUARD_S, NSEC_PER_SEC, &deadline);
+	(void)thread_call_enter_delayed(lp_guard_tc, deadline);
+}
+
+/* allocate (once) and arm the guard timer */
+static void
+lp_guard_start(void)
+{
+	if (!lp_guard_tc) {
+		lp_guard_tc = thread_call_allocate(lp_guard_fire, NULL);
+	}
+	if (lp_guard_tc) {
+		lp_guard_arm();
+	} else {
+		printf("LAUREL CHARGER: no guard timer: a failed safe write is not retried\n");
+	}
+}
+
+/* 500 mA / 4100 mV, ICL HW_AUTO, input un-suspended, all read back; sets/clears lp_safe_pending */
+static int
+lp_write_safe(void)
+{
+	int rc = input_auto();
+	rc |= set_fcc_fv((uint8_t)(SAFE_FCC_MA / 50u), (uint8_t)((SAFE_FV_MV - 3600u) / 10u));
+	if (rc) {
+		lp_safe_pending = true;
+		lp_safe_tries++;
+	} else {
+		lp_safe_pending = false;
+	}
+	return rc;
+}
+
+/* a USB input suspend left by an earlier boot (our warm-zone suspend; the PMIC keeps it): release it */
+static void
+lp_release_left_suspend(void)
+{
+	uint8_t cmd = 0;
+	if (rd(USBIN + 0x40, &cmd) == 0) {
+		lp_usb_cmd = (uint8_t)(cmd & ~0x01u);
+		if (cmd & 0x01u) {
+			int w = wr(USBIN + 0x40, lp_usb_cmd);
+			printf("LAUREL CHARGER: USB input suspend of an earlier boot released (USBIN_CMD_IL 0x%02x, %s)\n", cmd,
+			    w ? "write failed" : "written");
+		}
+	}
+	(void)sweet_spmi_usbin_lane_init();
+}
+
+/*
+ * Battery self-check failed after the SPMI start (QG type, no battery, implausible vbat): no gauge and no
+ * software JEITA, so with SMB5 ours: input suspend released, 500 mA / 4100 mV (retried every 10 s until
+ * read back). laurelchg=0 (kill switch) or SMB5 not EE 0: no writes.
+ */
+static void
+lp_charger_failsafe(const char *why)
+{
+	int chg = 1;
+	(void)PE_parse_boot_argn("laurelchg", &chg, sizeof(chg));
+	if (!chg) {
+		printf("LAUREL CHARGER: off: %s, laurelchg=0: no writes (the previous limits stay)\n", why);
+		return;
+	}
+	int oc = sweet_spmi_owner(PMI_SID, 0x10), ou = sweet_spmi_owner(PMI_SID, 0x13);
+	if (oc != 0 || ou != 0) {
+		printf("LAUREL CHARGER: off: %s, SMB5 owned by EE %d/%d: no writes\n", why, oc, ou);
+		return;
+	}
+	IOLockLock(lp_lock);
+	lp_release_left_suspend();
+	int rc = lp_write_safe();
+	IOLockUnlock(lp_lock);
+	printf("LAUREL CHARGER: off: %s; safe limits FCC %u mA FV %u mV without software JEITA (%s)\n", why, SAFE_FCC_MA,
+	    SAFE_FV_MV, rc ? "a write failed: retried every 10 s" : "written");
+	if (rc) {
+		lp_guard_start();
+	}
+}
+
+/*
+ * System sleep (IOPMrootDomain will-sleep, from SweetBattery): the guard timer and the poll do not run
+ * while asleep (absolute time stops), so the charger gets 500 mA / 4100 mV before; the next charger step
+ * after wake writes the zone limits again. Locked. [U] whether this kernel ever sleeps (no CPU suspend path
+ * in topaz/SweetPlatformExpert).
+ */
+void
+laurel_pmi632_will_sleep(void)
+{
+	if (lp_state != 1 || !lp_lock) {
+		return;
+	}
+	IOLockLock(lp_lock);
+	if (lp_chg_on || lp_safe_pending) {
+		int rc = lp_write_safe();
+		lp_zone = LP_ZONES;
+		printf("LAUREL CHARGER: system sleep: safe limits FCC %u mA FV %u mV (%s)\n", SAFE_FCC_MA, SAFE_FV_MV,
+		    rc ? "a write failed" : "written");
+	}
+	IOLockUnlock(lp_lock);
+}
+
+/* laurel 2301: power off / restart path (panic hold, timer call): no lock, kdb_printf only */
+void
+laurel_pmi632_release_input(void)
+{
+	if (!lp_usb_susp) {
+		return;
+	}
+	int w = sweet_spmi_usbin_lane_write(0x40, lp_usb_cmd);
+	lp_usb_susp = false;
+	kdb_printf("LAUREL CHARGER: USB input suspend released before the reset (USBIN_CMD_IL 0x%02x, write %d)\n",
+	    lp_usb_cmd, w);
+}
+
+static uint64_t
+now_ns(void)
+{
+	uint64_t now, ns;
+	clock_get_uptime(&now);
+	absolutetime_to_nanoseconds(now, &ns);
+	return ns;
+}
+
+int
+laurel_pmi632_sample(struct laurel_batt *b)
+{
+	if (lp_state != 1 || !b) {
+		return -1;
+	}
+	bzero(b, sizeof(*b));
+	IOLockLock(lp_lock);
+	uint64_t ns = now_ns();
+	struct lp_in in;
+	lp_guard_locked(ns, &in, b);    /* NTC watchdog + charger step, before any early return below */
+	uint16_t vr = 0, ir = 0;
+	uint8_t st1 = 0;
+	if (rd16(QG + 0xc0, &vr) || rd16(QG + 0xc6, &ir) || rd(QG + 0x08, &st1)) {
+		IOLockUnlock(lp_lock);
+		return -1;
+	}
+	unsigned mv = (unsigned)(((uint64_t)vr * 194637u) / 1000000u);
+	if (mv < 2800 || mv > 4600 || !(st1 & 1u)) {
+		IOLockUnlock(lp_lock);
+		return -1;
+	}
+	/* Linux: + = discharge; iOS: + = into the battery */
+	int ma = (int)(-((int64_t)(int16_t)ir * lp_ilsb_nua) / 1000000);
+	bool temp_ok = in.temp_ok;
+
+	uint8_t cs1 = 0, cs2 = 0, cs7 = 0, icl_st = 0, fvr = 0;
+	uint8_t apsd_st = in.apsd_st, apsd = in.apsd, snk = in.snk;
+	bool chg_ok = rd(CHGR + 0x06, &cs1) == 0 && rd(CHGR + 0x07, &cs2) == 0 && rd(CHGR + 0x0d, &cs7) == 0;
+	(void)rd(DCDC + 0x07, &icl_st);
+	bool fv_ok = rd(CHGR + 0x70, &fvr) == 0;
+	bool external = chg_ok && in.external;
+	unsigned state = cs1 & 7u;
+	bool charging = external && !lp_usb_susp && state >= 1 && state <= 4 && !(cs2 & 2u) && !(cs7 & 0x0cu);
+	/* "terminated" is full only at the full FV (4400 mV), not at the warm 4100 mV */
+	bool terminated = external && state == 5 && fv_ok && 3600u + 10u * fvr >= FV_MV - 10u;
+
+	/* coulomb count: lp_soc_uah is the master value */
+	if (lp_last_ns && ns > lp_last_ns) {
+		uint64_t dt_ms = (ns - lp_last_ns) / 1000000u;
+		if (dt_ms > 600000u) {
+			dt_ms = 600000u;        /* a long gap (sleep): count at most 10 min of the last current */
+		}
+		lp_soc_uah += (int64_t)ma * (int64_t)dt_ms / 3600;     /* mA * ms / 3600 = uAh */
+	}
+	lp_last_ns = ns;
+	int64_t full_uah = (int64_t)lp_cap_mah * 1000;
+	if (lp_soc_uah > full_uah) {
+		lp_soc_uah = full_uah;
+	}
+	if (lp_soc_uah < 0) {
+		lp_soc_uah = 0;
+	}
+	int cent = (int)(lp_soc_uah * 10000 / full_uah);
+	int adj = cent;
+
+	/* at rest for 30 s on battery: pull a drift of more than 5 % back toward the OCV SoC, 1 % per sample */
+	int a = ma < 0 ? -ma : ma;
+	lp_rest_since = (a < 30) ? (lp_rest_since ? lp_rest_since : ns) : 0;
+	if (lp_rest_since && ns - lp_rest_since >= LP_30S_NS && !external) {
+		int ocv_c = (int)ocv_soc_cent(mv);
+		if (ocv_c - cent > 500) {
+			adj = cent + 100;
+		} else if (cent - ocv_c > 500) {
+			adj = cent - 100;
+		}
+	}
+	/* charger terminated at the full FV: 100 %, held while plugged (qcom,hold-soc-while-full) */
+	if (terminated) {
+		lp_held_full = true;
+	}
+	if (!external) {
+		lp_held_full = false;
+	}
+	if (lp_held_full) {
+		adj = 10000;
+	} else if (adj >= 9950 && charging) {
+		adj = 9949;                     /* 100 % only when the charger says so */
+	}
+	/* empty: below 3300 mV on battery for 30 s; until then never below 1 % */
+	lp_low_since = (!external && mv < 3300) ? (lp_low_since ? lp_low_since : ns) : 0;
+	bool empty = lp_low_since && ns - lp_low_since >= LP_30S_NS;
+	if (empty) {
+		adj = 0;
+	} else if (adj < 100) {
+		adj = 100;
+	}
+	if (adj != cent) {
+		lp_soc_uah = (int64_t)adj * lp_cap_mah / 10;   /* only a correction or a clamp writes back */
+	}
+	lp_soc_cent = adj;
+	int pct = (adj + 50) / 100;
+	if (pct > 100) {
+		pct = 100;
+	}
+
+	if (lp_save_on && pct != lp_saved_pct && (ns - lp_saved_ns >= SAVE_NS || lp_saved_ns == 0)) {
+		save_record(pct, lp_last_temp);
+		lp_saved_ns = ns;
+	}
+
+	b->valid = 1;
+	b->soc = (unsigned)pct;
+	b->mv = mv;
+	b->ma = ma;
+	b->temp_dC = lp_last_temp;
+	b->temp_valid = temp_ok;
+	b->cycles = lp_cycles;
+	b->full_mah = lp_cap_mah;
+	b->design_mah = DESIGN_MAH;
+	b->external = external;
+	b->charging = charging;
+	b->full = lp_held_full;
+	b->critical = empty;
+	b->icl_ma = 50u * icl_st;
+	b->family = external ? family_code((apsd_st & 1u) ? apsd : 0, snk) : 0;
+	b->adapter_mv = 5000;
+	b->adapter_ma = b->icl_ma ? b->icl_ma : 500;
+	b->soc_src = lp_soc_src;
+	unsigned left = (unsigned)(lp_soc_uah / 1000);
+	b->ttf_min = (charging && ma > 50) ? (int)((lp_cap_mah - left) * 60u / (unsigned)ma) : 0xffff;
+	b->tte_min = (!external && ma < -50) ? (int)(left * 60u / (unsigned)(-ma)) : 0xffff;
+	if (b->ttf_min > 0xfffe && b->ttf_min != 0xffff) {
+		b->ttf_min = 0xfffe;
+	}
+	if (b->tte_min > 0xfffe && b->tte_min != 0xffff) {
+		b->tte_min = 0xfffe;
+	}
+	if (ns - lp_log_ns >= 300000000000ull || lp_log_ns == 0) {   /* a line every 5 min */
+		lp_log_ns = ns;
+		printf("LAUREL BATTERY: on: PMI632 QG soc %d%% vbat %u mV ibat %d mA temp %d.%d C%s; usbin %s chg state %u icl %u mA%s\n",
+		    pct, mv, ma, lp_last_temp / 10, (lp_last_temp < 0 ? -lp_last_temp : lp_last_temp) % 10,
+		    temp_ok ? "" : " (stale)", external ? "in" : "out", state, b->icl_ma,
+		    charging ? " charging" : lp_held_full ? " full" : lp_usb_susp ? " input suspended" : "");
+	}
+	IOLockUnlock(lp_lock);
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
