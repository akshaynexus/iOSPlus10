+static int
+rd(unsigned addr, uint8_t *v)
+{
+	for (unsigned t = 0; t < 2; t++) {
+		if (sweet_spmi_read(PMI_SID, addr, v) == 0) {
+			return 0;
+		}
+	}
+	return -1;
+}
+
+/* two matching whole words: rejects most torn samples without the QG hold bit */
+static int
+rd16(unsigned addr, uint16_t *v)
+{
+	uint16_t prev = 0;
+	for (unsigned a = 0; a < 4; a++) {
+		uint8_t lo, hi;
+		if (rd(addr, &lo) || rd(addr + 1, &hi)) {
+			return -1;
+		}
+		uint16_t next = (uint16_t)(lo | (hi << 8));
+		if (a && next == prev) {
+			*v = next;
+			return 0;
+		}
+		prev = next;
+	}
+	return -1;
+}
+
+/* write and read back; 0 ok */
+static int
+wr(unsigned addr, uint8_t v)
+{
+	uint8_t back = 0;
+	if (sweet_spmi_write(PMI_SID, addr, v) != 0 || rd(addr, &back) != 0) {
+		return -1;
+	}
+	return back == v ? 0 : -1;
+}
+
+static unsigned
+ocv_soc_cent(unsigned mv)
+{
+	unsigned t = mv * 10u;
+	unsigned n = sizeof(lp_ocv) / sizeof(lp_ocv[0]);
+	if (t >= lp_ocv[0][0]) {
+		return 10000;
+	}
+	for (unsigned i = 1; i < n; i++) {
+		if (t >= lp_ocv[i][0]) {
+			unsigned v0 = lp_ocv[i][0], v1 = lp_ocv[i - 1][0];
+			unsigned s0 = lp_ocv[i][1], s1 = lp_ocv[i - 1][1];
+			return s0 + (t - v0) * (s1 - s0) / (v1 - v0);
+		}
+	}
+	return 0;
+}
+
+static int
+ntc_dC(unsigned mv)
+{
+	unsigned n = sizeof(lp_ntc) / sizeof(lp_ntc[0]);
+	if ((int)mv >= lp_ntc[0][0]) {
+		return lp_ntc[0][1];
+	}
+	for (unsigned i = 1; i < n; i++) {
+		if ((int)mv >= lp_ntc[i][0]) {
+			int v0 = lp_ntc[i][0], v1 = lp_ntc[i - 1][0], t0 = lp_ntc[i][1], t1 = lp_ntc[i - 1][1];
+			return t0 + ((int)mv - v0) * (t1 - t0) / (v1 - v0);
+		}
+	}
+	return lp_ntc[n - 1][1];
+}
