+/* ADC5 user conversion of BAT_THERM_PU2 (qcom-spmi-adc5.c adc_configure, poll EOC); deci-C */
+static int
+read_temp(int *dC)
+{
+	uint8_t dig, avg, dly, en, st = 0, lo, hi;
+	if (rd(VADC + 0x42, &dig) || rd(VADC + 0x43, &avg) || rd(VADC + 0x45, &dly) || rd(VADC + 0x46, &en)) {
+		return -1;
+	}
+	dig = (uint8_t)((dig & ~0x7cu) | (1u << 4) | (2u << 2));   /* ratiometric cal, decimation 2, timer cal */
+	avg = (uint8_t)(avg & ~0x07u);                               /* 1 sample */
+	dly = (uint8_t)((dly & ~0x0fu) | 2u);                        /* 200 us settle */
+	if (sweet_spmi_write(PMI_SID, VADC + 0x42, dig) || sweet_spmi_write(PMI_SID, VADC + 0x43, avg) ||
+	    sweet_spmi_write(PMI_SID, VADC + 0x44, 0x4a) || sweet_spmi_write(PMI_SID, VADC + 0x45, dly) ||
+	    sweet_spmi_write(PMI_SID, VADC + 0x46, (uint8_t)(en | 0x80u))) {
+		return -1;
+	}
+	uint8_t ch = 0;
+	if (rd(VADC + 0x44, &ch) || ch != 0x4a) {       /* PMI632: adc_channel_check */
+		if (sweet_spmi_write(PMI_SID, VADC + 0x44, 0x4a) || rd(VADC + 0x44, &ch) || ch != 0x4a) {
+			return -1;
+		}
+	}
+	if (sweet_spmi_write(PMI_SID, VADC + 0x47, 0x80)) {
+		return -1;
+	}
+	for (unsigned i = 0; i < 40; i++) {
+		delay(500);
+		if (rd(VADC + 0x08, &st) == 0 && (st & 3u) == 1u) {
+			if (rd(VADC + 0x50, &lo) || rd(VADC + 0x51, &hi)) {
+				return -1;
+			}
+			unsigned code = (unsigned)(lo | (hi << 8));
+			if (code > 0x7fffu) {
+				code = 0;
+			}
+			unsigned mv = code * 1875u / 0x70e4u;
+			if (mv < 100 || mv > 1850) {
+				return -1;     /* open or shorted NTC */
+			}
+			*dC = ntc_dC(mv);
+			return 0;
+		}
+	}
+	return -1;
+}
+
+static void
+save_record(int pct, int dC)
+{
+	uint8_t r[7] = { REC_MAGIC0, REC_MAGIC1, (uint8_t)pct, (uint8_t)(lp_soc_cent % 100),
+		         (uint8_t)(dC & 0xff), (uint8_t)((dC >> 8) & 0xff), 0 };
+	uint8_t x = 0x5a;
+	for (unsigned i = 0; i < 6; i++) {
+		x ^= r[i];
+	}
+	r[6] = x;
+	for (unsigned i = 0; i < 7; i++) {
+		if (sweet_spmi_write(PMI_SID, SDAM + REC_OFF + i, r[i]) != 0) {
+			lp_save_on = false;
+			printf("LAUREL BATTERY: save off: SDAM write failed at +%u\n", i);
+			return;
+		}
+	}
+	lp_saved_pct = pct;
+}
+
+static int
+load_record(void)
+{
+	uint8_t r[7];
+	for (unsigned i = 0; i < 7; i++) {
+		if (rd(SDAM + REC_OFF + i, &r[i])) {
+			return -1;
+		}
+	}
+	uint8_t x = 0x5a;
+	for (unsigned i = 0; i < 6; i++) {
+		x ^= r[i];
+	}
+	if (r[0] != REC_MAGIC0 || r[1] != REC_MAGIC1 || r[6] != x || r[2] > 100 || r[3] > 99) {
+		return -1;
+	}
+	return r[2] * 100 + (r[2] < 100 ? r[3] : 0);
+}
+
+/* PM6125 PON reason (GEN2: PON_REASON1 0x8c0, WARM_RESET_REASON1 0x8c2) and the PMI632's */
+static void
+read_pon(void)
+{
+	uint8_t sub = 0, a = 0, b = 0, a2 = 0, b2 = 0, ps = 0, pr = 0;
+	if (sweet_spmi_pon_read(0x805, &sub) || sub < 4) {
+		return;
+	}
+	/* the keys thread polls the same APID: take two agreeing reads */
+	for (unsigned t = 0; t < 4; t++) {
+		if (sweet_spmi_pon_read(0x8c0, &a) || sweet_spmi_pon_read(0x8c2, &b) ||
+		    sweet_spmi_pon_read(0x8c0, &a2) || sweet_spmi_pon_read(0x8c2, &b2)) {
+			continue;
+		}
+		if (a == a2 && b == b2) {
+			lp_pon_reason = a;
+			lp_pon_warm = b;
+			lp_pon_known = true;
+			break;
+		}
+	}
+	if (rd(0x805, &ps) == 0) {
+		unsigned off = ps >= 4 ? 0xc0u : 0x08u;
+		if (rd(0x800 + off, &pr) == 0) {
+			lp_pmi_reason = pr;
+		}
+	}
+}
+
+int
+laurel_pmi632_pon(uint8_t *reason, uint8_t *warm, uint8_t *pmi)
+{
+	if (!lp_pon_known) {
+		return -1;
+	}
+	*reason = lp_pon_reason;
+	*warm = lp_pon_warm;
+	*pmi = lp_pmi_reason;
+	return 0;
+}
