+#ifndef LAUREL_PMI632_H
+#define LAUREL_PMI632_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+struct laurel_batt {
+	int valid;              /* 1: a full gauge sample */
+	unsigned soc;           /* 0..100 % */
+	unsigned mv;            /* battery voltage */
+	int ma;                 /* battery current, + = into the battery */
+	int temp_dC;            /* NTC, 0.1 C (25.0 C fixed when temp_valid = 0) */
