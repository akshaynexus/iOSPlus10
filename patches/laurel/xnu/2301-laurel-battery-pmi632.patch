-		if (v >= (int16_t)topaz_ntc[i]) {
-			int hi = (int16_t)topaz_ntc[i - 1], lo = (int16_t)topaz_ntc[i];
-			return (i - 1) * 10 - 200 + (hi - v) * 10 / (hi - lo);
-		}
-	}
-	return 800;
-}
