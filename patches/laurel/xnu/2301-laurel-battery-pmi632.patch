+	int external, charging, full, critical;
+	unsigned icl_ma;        /* input current limit now (AICL result) */
+	unsigned fcc_ma, fv_mv; /* our charger limits (0 when not set) */
+	unsigned family;        /* IOPS family code, 0 = no adapter */
+	unsigned adapter_mv, adapter_ma;
+	int ttf_min, tte_min;   /* 0xffff = unknown */
+	const char *soc_src;
+};
+/* Thread context. 0 = on (self-check passed), -1 = off (one "LAUREL BATTERY: off:" line). Idempotent. */
+int laurel_pmi632_init(void);
+/* Thread context. A gauge sample + one charger step. 0 ok, -1 no sample. */
+int laurel_pmi632_sample(struct laurel_batt *b);
+/* PON reasons read at init: PM6125 PON_REASON1, WARM_RESET_REASON1, PMI632 PON_REASON1. -1 unknown. */
+int laurel_pmi632_pon(uint8_t *reason, uint8_t *warm, uint8_t *pmi);
+/* Power off / restart path, any context (no lock): release our USB input suspend. */
+void laurel_pmi632_release_input(void);
+/* IOPMrootDomain will-sleep (SweetBattery): safe charger limits before the system sleeps. Thread context. */
+void laurel_pmi632_will_sleep(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
