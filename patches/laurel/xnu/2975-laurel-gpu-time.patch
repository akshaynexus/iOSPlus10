diff --git a/iokit/Kernel/arm/laurel_gpu_time_core.h b/iokit/Kernel/arm/laurel_gpu_time_core.h
new file mode 100644
index 0000000..2dca185
--- /dev/null
+++ b/iokit/Kernel/arm/laurel_gpu_time_core.h
@@ -0,0 +1,68 @@
+/*
+ * laurel 2975: LAUREL GPU TIME: the window server's time in RedwoodGPU per request, plain C, so that a host test builds exactly this file
+ * (scripts/laurel/gpu-push-test.sh, tools/gpu-push-test/). Log 2026-11-03 02:54:49-02:55:16: 2.5 to 4.2 s of 5 s in requests, and the log did not say which.
+ * A kernel log line ends after 255 bytes (laurel 2892), so the text goes in the existing line, largest time first, as many as fit.
+ */
+#ifndef LAUREL_GPU_TIME_CORE_H
+#define LAUREL_GPU_TIME_CORE_H
+
+#define LGT_SLOTS       20
+#define LGT_TEXT        100     /* with the rest of the line: under 255 bytes, host test */
+
+static const char * const lgt_names[LGT_SLOTS] = {
+	"close", "getparam", "setparam", "new", "info", "prep", "fini", "submit", "fence", "madvise",
+	"userptr", "qnew", "qclose", "qquery", "who", "plane", "drawn", "surface", "show", "other",
+};
+
+/* the numbers of RedwoodGPU.cpp's request enum */
+static inline unsigned
+lgt_slot(uint32_t selector)
+{
+	if (selector == 0x09) {
+		return 0;
+	}
+	if (selector >= 0x40 && selector <= 0x4c) {
+		return selector - 0x40 + 1;     /* 0x40-0x48: getparam ... madvise; 0x49 userptr; 0x4a-0x4c: the queues */
+	}
+	if (selector >= 0x7b && selector <= 0x7f) {
+		return selector - 0x7b + 14;    /* who, plane, drawn, surface, show */
+	}
+	return LGT_SLOTS - 1;
+}
+
+/* "name calls/ms" of the largest times into s (always ended): whole entries only. The number of entries. */
+static inline unsigned
+lgt_text(char *s, size_t n, const uint64_t *microseconds, const uint32_t *calls)
+{
+	bool used[LGT_SLOTS];
+	size_t at = 0;
+	unsigned count = 0;
+
+	memset(used, 0, sizeof(used));
+	s[0] = '\0';
+	for (;;) {
+		int best = -1;
+		char one[40];
+		int len;
+
+		for (unsigned i = 0; i < LGT_SLOTS; i++) {
+			if (!used[i] && calls[i] != 0 && (best < 0 || microseconds[i] > microseconds[best])) {
+				best = (int)i;
+			}
+		}
+		if (best < 0) {
+			return count;
+		}
+		used[best] = true;
+		len = snprintf(one, sizeof(one), "%s%s %u/%llu", count != 0 ? ", " : "", lgt_names[best], calls[best],
+		    (unsigned long long)(microseconds[best] / 1000));
+		if (len < 0 || (size_t)len >= sizeof(one) || at + (size_t)len + 1 > n) {
+			return count;
+		}
+		memcpy(s + at, one, (size_t)len + 1);
+		at += (size_t)len;
+		count++;
+	}
+}
+
+#endif /* LAUREL_GPU_TIME_CORE_H */
