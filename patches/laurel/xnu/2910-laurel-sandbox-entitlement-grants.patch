+	{ PRIV_SKYWALK_REGISTER_KERNEL_PIPE, "com.apple.private.skywalk.register-kernel-pipe" }, /* laurel 2910 */
+	{ PRIV_SYSTEM_OVERRIDE, "com.apple.private.kernel.system-override" },                    /* laurel 2910 */
 };
