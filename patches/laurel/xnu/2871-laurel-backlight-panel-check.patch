+/*
+ * laurel 2871, the backlight's self-check: does the panel hold what we send? Boots 07:20 and 18:40: every write DONE, 0 failed
+ * [V log], the panel did not follow [V owner], in LP without a DMA line and in HS with it. DONE says only that the DSI sent
+ * something; nothing has ever proved that a packet arrived with the right bytes.
+ *  1. Who answers DCS 0x0A (power mode): the memory DMA in LP, in HS, or the FIFO (no bus master: bad DMA data cannot explain it).
+ *     The first that answers stays. None: writes go on as before, one line says so.
+ *  2. In which way does 0x52 follow two written levels? (Two: the boot chain's level could be ours by chance.) That way stays.
+ * The Samsung panel answers reads in video mode under Linux [V dsi_display_white_reg_read]. laurelbl_read=0: no reads.
+ */
+void
+AppleCLCD::dsiReadCheck(uint32_t level, char *how, size_t size)
+{
+	static const struct { bool fifo, hs; const char *name; } paths[] = {
+		{ false, false, "memory DMA, reads in LP" }, { false, true, "memory DMA, reads in HS" }, { true, false, "FIFO, reads in LP" },
+	};
+	uint32_t on = 1, way0 = fDsiWay, seen = 0;
+	uint8_t power = 0, control = 0;
+	char start[80];
+	strlcpy(start, how, sizeof(start));
+	(void)setPanelBctrl();                                  /* the wake sends it too; the boot chain may not have */
+	(void)PE_parse_boot_argn("laurelbl_read", &on, sizeof(on));
+	if (on == 0) {
+		snprintf(how, size, "%s, no panel reads (laurelbl_read=0)", start);
+		return;
+	}
+	const char *path = NULL;
+	for (unsigned i = 0; i < sizeof(paths) / sizeof(paths[0]) && path == NULL; i++) {
+		fDsiFifo = paths[i].fifo;
+		fDsiReadHs = paths[i].hs;
+		if (dsiDcsRead(0x0a, &power, 1) == 1) {
+			path = paths[i].name;
+		}
+	}
+	if (path == NULL) {
+		fDsiFifo = false;
+		fDsiReadHs = false;
+		snprintf(how, size, "%s, PANEL DOES NOT ANSWER READS (0x0A; memory DMA and FIFO): writes are blind", start);
+		return;
+	}
+	fRdOn = true;
+	(void)dsiDcsRead(0x54, &control, 1);
+	for (uint32_t i = 0; i < 4 && !fRd52; i++) {
+		uint32_t way = (way0 + i) & 3, a = 0, b = 0;
+		dsiWay(way);
+		(void)setPanelBctrl();
+		if (setPanelLevel(level + 16) && panelDbv(&a) && setPanelLevel(level) && panelDbv(&b)) {
+			seen = b;
+			fRd52 = a == level + 16 && b == level;
+		}
+	}
+	if (!fRd52) {
+		dsiWay(way0);
+		(void)setPanelBctrl();
+		(void)setPanelLevel(level);
+	}
+	snprintf(how, size, "%s, %s; panel power %#x, control %#x, DBV %s (%s)", start, path, power, control,
+	    fRd52 ? "follows the writes" : "DOES NOT FOLLOW the writes", dsiWayName(fDsiWay));
+	if (!fRd52) {
+		IOLog("LAUREL BACKLIGHT: panel 0x52 reads %#x after writing %#x in every way: the slider may not reach the panel\n", seen, level);
+	}
+}
