+/*
+ * laurel 2871: DCS read as dsi_message_rx + get_cmd_read_data (1..2 bytes: short response): max return size + the read with
+ * a bus turnaround in one send, always at the DMA line of the blanking. The answer is 1 word: type, data, data, ECC.
+ * Returns the bytes (0: no answer or an error report; the DSI's error bits are cleared, as dsi_ctrl_handle_error_status).
+ */
+uint32_t
+AppleCLCD::dsiDcsRead(uint8_t cmd, uint8_t *out, uint32_t n)
+{
+	uint8_t size[4] = { (uint8_t)n, 0, 0x37, 0x00 };        /* set max return packet size: not the last packet */
+	uint8_t read[4] = { cmd, 0, 0x06, 0xa0 };               /* DCS read: last, BTA */
+	uint32_t got = 0;
+	IOLockLock(fBlLock);
+	dsi_wr(fDsi, 0x1d4, 1);                                 /* clear RDBK_DATA */
+	IODelay(1);
+	dsi_wr(fDsi, 0x1d4, 0);
+	fDsiHsNow = fDsiReadHs;
+	fDsiBta = true;
+	bool done = dsiSend(size, read, sizeof(read));
+	fDsiBta = false;
+	uint32_t count = dsi_rd(fDsi, 0x1d4) >> 16;
+	uint32_t word = dsi_rd(fDsi, 0x06c);                    /* RDBK_DATA0, high byte first (ntohl in get_cmd_read_data) */
+	if (done && fDsiBtaDone && count != 0) {
+		uint8_t type = (uint8_t)(word >> 24);
+		if (type == 0x21 || type == 0x11) {
+			got = 1;
+		} else if (type == 0x22 || type == 0x12) {
+			got = n >= 2 ? 2 : 1;
+		}
+		if (got >= 1) {
+			out[0] = (uint8_t)(word >> 16);
+		}
+		if (got >= 2) {
+			out[1] = (uint8_t)(word >> 8);
+		}
+	}
+	dsi_wr(fDsi, 0x068, dsi_rd(fDsi, 0x068));               /* ack, lane 0, timeout status: write 1 to clear */
+	dsi_wr(fDsi, 0x0b4, dsi_rd(fDsi, 0x0b4));
+	dsi_wr(fDsi, 0x0c0, dsi_rd(fDsi, 0x0c0));
+	IOLockUnlock(fBlLock);
+	return got;
+}
+
+/* the panel's brightness register (DCS 0x52), high byte first as 0x51 writes it; false: no answer */
+bool
+AppleCLCD::panelDbv(uint32_t *dbv)
+{
+	uint8_t b[2] = { 0, 0 };
+	uint32_t n = dsiDcsRead(0x52, b, 2);
+	*dbv = n == 2 ? ((uint32_t)b[0] << 8 | b[1]) : b[0];
+	return n != 0;
+}
+
+bool
+AppleCLCD::setPanelBctrl(void)
+{
+	uint8_t bctrl[4] = { 0x53, 0x20, 0x15, 0x80 };          /* qcom,mdss-dsi-dimming-brightness-command: brightness control on */
+	IOLockLock(fBlLock);
+	fDsiHsNow = fBlHs;
+	bool done = dsiSend(bctrl, NULL, 0);
+	IOLockUnlock(fBlLock);
+	return done;
+}
+
+/* way 0 = as the panel's DT and Linux; 1 = the other mode; 2, 3 = both without the DMA line */
+void
+AppleCLCD::dsiWay(uint32_t way)
+{
+	fDsiWay = way & 3;
+	bool flip = (fDsiWay & 1) != 0;
+	fBlHs = fDsiDtHs != flip;
+	fOnHs = fDsiDtOnHs != flip;
+	fOffHs = fDsiDtOffHs != flip;
+	fDsiSchedLine = (fDsiWay & 2) ? 0 : fDsiLine;
+}
+
+const char *
+AppleCLCD::dsiWayName(uint32_t way)
+{
+	static const char * const names[4] = { "DT mode, DMA line", "other mode, DMA line", "DT mode, no DMA line", "other mode, no DMA line" };
+	return names[way & 3];
+}
