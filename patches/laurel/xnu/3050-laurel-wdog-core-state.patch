+/*
+ * laurel 3050: the OSM's cycle counter of one core (clk-cpu-osm.c OSM_CYCLE_COUNTER_STATUS_REG: 0x9c0 + 4 * core of the cluster's
+ * frame). It counts while the core's clock runs, from any CPU, with no side effect: the watchdog report reads it twice for a silent
+ * core, so a core that executes (or spins in another world) and a core whose clock is stopped (WFI, WFE, power collapse) tell apart.
+ * False: no table mapped yet, or not a core of the two clusters.
+ */
+#define OSM_CYCLES      0x9c0u
+bool laurel_osm_core_cycles(uint32_t mpidr, uint32_t *cycles);
+bool
+laurel_osm_core_cycles(uint32_t mpidr, uint32_t *cycles)
+{
+	unsigned c = (mpidr >> 8) & 0xffu, core = mpidr & 0xffu;
+
+	if (c >= CL_N || core >= 4u || cl_base[c] == 0) {
+		return false;
+	}
+	*cycles = *(volatile uint32_t *)(cl_base[c] + OSM_CYCLES + 4u * core);
+	return true;
+}
