+/*
+ * laurel 3050: does the silent core's clock run? The OSM keeps a cycle counter per core (bsd/dev/laurel_thermal.c, laurel_osm_core_cycles):
+ * two reads 10 ms apart, for the silent core and for a core of the same cluster that answers (the reference says the counter works at all).
+ * A count near the cluster's MHz x 10000: the core executes, or spins in a world above EL1 (EL2 vectors, TrustZone), or waits on the bus with
+ * its clock on. A count of 0: the clock is stopped: WFI/WFE with no wake, or the core is off. GICR_WAKER: ProcessorSleep (bit 1) set means the
+ * redistributor forwards nothing to it. Reads only; a 10 ms wait on this CPU, also with interrupts off (the bark). Nothing is written.
+ */
+extern bool laurel_osm_core_cycles(uint32_t mpidr, uint32_t *cycles);
+static void
+lwd_core_state_line(const char *prefix, int cpu, uint32_t mpidr, bool have_waker, uint32_t waker)
+{
+	uint32_t c0 = 0, c1 = 0, r0 = 0, r1 = 0, rm = 0;
+	int ref = -1;
+	bool have = laurel_osm_core_cycles(mpidr, &c0), have_ref = false;
+
+	for (unsigned i = 0; i < LWD_CPUS && have; i++) {
+		cpu_data_t *rd = (cpu_data_t *)CpuDataEntries[i].cpu_data_vaddr;
+
+		if ((int)i == cpu || rd == NULL || lwd_cpu[i].online == 0 || lwd_cpu[i].silent_ms >= 1000u) {
+			continue;
+		}
+		rm = (uint32_t)rd->cpu_phys_id;
+		if (((rm ^ mpidr) & 0xff00u) == 0 && laurel_osm_core_cycles(rm, &r0)) {
+			ref = (int)i;
+			have_ref = true;
+			break;
+		}
+	}
+	if (have) {
+		uint64_t until = mach_absolute_time() + 10ull * (lwd_ms ? lwd_ms : 19200);
+
+		while (mach_absolute_time() < until) {
+			;
+		}
+		(void)laurel_osm_core_cycles(mpidr, &c1);
+		if (have_ref) {
+			(void)laurel_osm_core_cycles(rm, &r1);
+		}
+	}
+	if (!have) {
+		kprintf("%s cpu %d core state: OSM cycle counter not readable; GICR WAKER %s0x%x\n", prefix, cpu, have_waker ? "" : "unread ", waker);
+		return;
+	}
+	kprintf("%s cpu %d core state: OSM cycles in 10 ms: %u (%u MHz: %s); reference cpu %d of the same cluster: %u (%u MHz); GICR WAKER %s0x%x%s\n",
+	    prefix, cpu, c1 - c0, (c1 - c0) / 10000u, (c1 - c0) == 0 ? "its clock is stopped: WFI/WFE with no wake, or off" : "it runs, or spins above EL1, or waits on the bus",
+	    ref, have_ref ? r1 - r0 : 0, have_ref ? (r1 - r0) / 10000u : 0, have_waker ? "" : "unread ", waker,
+	    (have_waker && (waker & 2u)) ? " (ProcessorSleep: the redistributor forwards nothing)" : "");
+}
