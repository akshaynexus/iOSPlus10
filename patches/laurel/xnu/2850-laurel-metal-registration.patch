From: iOSPlus10 laurel <laurel@local>
Subject: [PATCH] laurel 2850: Metal plug-in names on IOAcceleratorES after a self-check (Adreno 610)

topaz 0138 publishes an empty IOAcceleratorES, so Metal.framework finds no device. Now a thread holds the
service back until the check is done: root mounted (<= 60 s), NegroniMetal.bundle files in the root (checked at
once), the GPU wanted and not failed (topaz_gpu_wanted / topaz_gpu_failed: AREA B 2150 provides them; weak
stand-ins here), RedwoodGPU ready and in the registry (100 ms poll, <= 20 s after the root only while the bring-up
neither ends nor fails), CHIP_ID 0x0601xxxx (Adreno 610, Turnip FD610), GMEM. Then it sets MetalPluginName =
NegroniMetal, MetalPluginClassName = NegroniMTLDevice, RedwoodMaxBuffer (64 MiB - 64 KiB, if the GPU driver has
not set it) on RedwoodGPU, and registers the service; on any failure it registers it empty, as 0138 did.
CoreAnimation polls for IOAcceleratorES (300 x 100 ms), so even backboardd sees the names.
One line: "LAUREL METAL: on: Turnip a610 (...)" or "LAUREL METAL: off: <reason>". Kill switch: laurelmetal=0.
Design: docs/laurel_sprout/metal.md.

diff --git a/iokit/Kernel/arm/LaurelMetal.cpp b/iokit/Kernel/arm/LaurelMetal.cpp
new file mode 100644
index 0000000..10b0215
--- /dev/null
+++ b/iokit/Kernel/arm/LaurelMetal.cpp
@@ -0,0 +1,247 @@
+/*
+ * laurel 2850: Metal device registration on the Mi A3 (Adreno 610). docs/laurel_sprout/metal.md.
+ *
+ * Metal.framework (_MTLRegisterDevices, iOS 16.7.16 20H392) looks at every IOAcceleratorES service and loads
+ * /System/Library/Extensions/<MetalPluginName>.bundle, class <MetalPluginClassName> (docs/metal-design.md section 2).
+ * topaz 0138 publishes that service without the two properties, so Metal finds no device. This feature names the
+ * NegroniMetal plug-in (Metal -> metal2vulkan -> Turnip, userland; built by scripts/laurel/metal-build.sh) on it, but
+ * only when the plug-in can work:
+ *   1. the root has the bundle and its Turnip (scripts/laurel/root-add-metal.sh): checked right after the root mount,
+ *   2. the GPU is wanted (not gpu=0) and has not failed: checked before and while waiting, every 100 ms,
+ *   3. RedwoodGPU runs (redwood_gpu_ready() and the service is in the registry),
+ *   4. the GPU is an Adreno 610 (CHIP_ID 0x0601xxxx, Mesa 25.0.7 Turnip table entry FD610) and has GMEM.
+ * If one check fails, the service is registered empty (as topaz 0138 does; CoreAnimation keeps the renderer it has)
+ * and one line tells why. Kill switch: boot-arg laurelmetal=0. Log: "LAUREL METAL: on: ..." / "LAUREL METAL: off: <reason>".
+ *
+ * Timing: topaz starts the GPU only after the root mount (TopazAdreno.cpp topaz_adreno_thread: root, 0.5 s, hw_start),
+ * long after AppleCLCD::start. Metal registers its devices once per process, so a backboardd that looked before the
+ * names were there would stay without Metal. So this feature takes over the publication of the service: it is
+ * registered when the check is done. CoreAnimation polls for IOAcceleratorES (300 x 100 ms, topaz 0138) and finds it
+ * then. A GPU that is off or fails ends the wait at once (topaz_gpu_wanted / topaz_gpu_failed, AREA B 2150); only a GPU
+ * bring-up that neither ends nor fails is waited for, at most LAUREL_METAL_GPU_WAIT_S after the root mount.
+ *
+ * Also publishes RedwoodMaxBuffer (bytes) on RedwoodGPU when the GPU driver has not: the largest buffer one GEM_NEW can
+ * give with the pass-through SMMU (one contiguous run of a GPU pool chunk). Turnip caps maxMemoryAllocationSize and
+ * maxBufferSize at it (userland/laurel/metal/turnip-patches/0101), so Metal's maxBufferLength tells apps the truth.
+ */
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOService.h>
+#include <kern/thread.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+
+struct vnode;
+struct vfs_context;
+
+extern "C" {
+bool redwood_gpu_ready(void);
+bool redwood_gpu_parameter(uint32_t which, uint64_t * value);
+int topaz_root_mounted(void);
+/* AREA B (laurel 2150) owns these in TopazAdreno.cpp; the weak ones below stand in for a kernel without them */
+bool topaz_gpu_wanted(void);
+bool topaz_gpu_failed(void);
+/* bsd/vfs (KPI) */
+int vnode_lookup(const char * path, int flags, struct vnode ** vpp, struct vfs_context * ctx);
+int vnode_put(struct vnode * vp);
+int vnode_vtype(struct vnode * vp);
+struct vfs_context * vfs_context_kernel(void);
+}
+
+/*
+ * Weak stand-ins, replaced at link time by AREA B's strong definitions (laurel 2150: topaz_gpu_wanted = not killed by
+ * gpu=0 and not failed). Without B: the topaz rule (the GPU starts only with boot-arg gpu=1) and "no failure known"
+ * (base topaz keeps its `failed` flag private; the 100 ms poll then ends at LAUREL_METAL_GPU_WAIT_S).
+ */
+extern "C" __attribute__((weak)) bool
+topaz_gpu_wanted(void)
+{
+	uint32_t on = 0;
+	return PE_parse_boot_argn("gpu", &on, sizeof(on)) && on != 0;
+}
+
+extern "C" __attribute__((weak)) bool
+topaz_gpu_failed(void)
+{
+	return false;
+}
+
+bool laurel_metal_publish(IOService * accel);
+
+#define LAUREL_METAL_PLUGIN     "NegroniMetal"          /* scripts/metal/env.sh PLUGIN_NAME */
+#define LAUREL_METAL_CLASS      "NegroniMTLDevice"      /* scripts/metal/env.sh PLUGIN_CLASS */
+#define LAUREL_METAL_BUNDLE     "/System/Library/Extensions/" LAUREL_METAL_PLUGIN ".bundle"
+#define LAUREL_METAL_ROOT_WAIT_S 60                     /* as topaz_adreno_thread waits for the root */
+#define LAUREL_METAL_GPU_WAIT_S 20                      /* after the root mount: 0.5 s + hw_start (zap, SQE, ring) */
+#define LAUREL_METAL_POLL_MS    100
+/* topaz TopazAdreno.cpp GPU_POOL_CHUNK - GPU_POOL_UNIT: the largest contiguous run of one pool chunk */
+#define LAUREL_METAL_MAX_BUFFER (0x4000000ull - 0x10000ull)
+
+#define MSM_PARAM_GMEM_SIZE     0x02
+#define MSM_PARAM_CHIP_ID       0x03
+#define MSM_PARAM_MAX_FREQ      0x04
+#define LAUREL_VREG             1                       /* enum vtype VREG (sys/vnode.h) */
+
+static IOService * gLaurelAccel;
+
+static void
+laurel_metal_off(const char * why)
+{
+	IOLog("LAUREL METAL: off: %s\n", why);
+}
+
+/* 0 = a regular file at `path` in the root file system, else an errno */
+static int
+laurel_metal_root_has(const char * path)
+{
+	struct vnode * vp = NULL;
+	int err = vnode_lookup(path, 0, &vp, vfs_context_kernel());
+
+	if (err == 0) {
+		if (vnode_vtype(vp) != LAUREL_VREG) {
+			err = EFTYPE;
+		}
+		vnode_put(vp);
+	}
+	return err;
+}
+
+/* The RedwoodGPU service, retained, if it is in the registry now (no wait); NULL if not */
+static IOService *
+laurel_metal_gpu_service(void)
+{
+	OSDictionary * match = IOService::serviceMatching("RedwoodGPU");
+	IOService * s = match != NULL ? IOService::copyMatchingService(match) : NULL;
+
+	OSSafeReleaseNULL(match);
+	return s;
+}
+
+static void
+laurel_metal_thread(void *, wait_result_t)
+{
+	IOService * accel = gLaurelAccel;
+	IOService * gpu = NULL;
+	char why[160];
+	uint64_t chip = 0, gmem = 0, freq = 0;
+	int waited_ms = 0;
+
+	/* 1. the root, then the plug-in in it (cheap, and it needs no GPU) */
+	for (int i = 0; !topaz_root_mounted() && i < LAUREL_METAL_ROOT_WAIT_S * 1000 / LAUREL_METAL_POLL_MS; i++) {
+		IOSleep(LAUREL_METAL_POLL_MS);
+	}
+	if (!topaz_root_mounted()) {
+		laurel_metal_off("root file system not mounted");
+		goto out;
+	}
+	{
+		static const char * const files[] = {
+			LAUREL_METAL_BUNDLE "/" LAUREL_METAL_PLUGIN,
+			LAUREL_METAL_BUNDLE "/libvulkan_freedreno.dylib",
+			LAUREL_METAL_BUNDLE "/Info.plist",
+		};
+		for (unsigned i = 0; i < sizeof(files) / sizeof(files[0]); i++) {
+			int e = laurel_metal_root_has(files[i]);
+			if (e != 0) {
+				snprintf(why, sizeof(why), "%s missing (errno %d): root without scripts/laurel/root-add-metal.sh",
+				    files[i], e);
+				laurel_metal_off(why);
+				goto out;
+			}
+		}
+	}
+
+	/* 2. + 3. the GPU: stop at once when it is not wanted or failed; else poll until RedwoodGPU is up */
+	for (;;) {
+		if (!topaz_gpu_wanted() || topaz_gpu_failed()) {
+			laurel_metal_off(topaz_gpu_failed() ? "the GPU bring-up failed (LAUREL GPU line above)" :
+			    "the GPU is off (boot-arg gpu=0, or its bring-up failed)");
+			goto out;
+		}
+		if (redwood_gpu_ready() && (gpu = laurel_metal_gpu_service()) != NULL) {
+			break;
+		}
+		if (waited_ms >= LAUREL_METAL_GPU_WAIT_S * 1000) {
+			snprintf(why, sizeof(why), "no RedwoodGPU %d s after the root mount (the Adreno 610 neither started nor failed)",
+			    LAUREL_METAL_GPU_WAIT_S);
+			laurel_metal_off(why);
+			goto out;
+		}
+		IOSleep(LAUREL_METAL_POLL_MS);
+		waited_ms += LAUREL_METAL_POLL_MS;
+	}
+
+	/* 4. the chip: Turnip's device table has the A610 as FD610 (chip id 0x060100ff, patch id wildcard) */
+	if (!redwood_gpu_parameter(MSM_PARAM_CHIP_ID, &chip) || (chip >> 8) != 0x060100) {
+		snprintf(why, sizeof(why), "GPU chip id %#llx is not an Adreno 610 (no Turnip table entry here)",
+		    (unsigned long long)chip);
+		laurel_metal_off(why);
+		goto out;
+	}
+	if (!redwood_gpu_parameter(MSM_PARAM_GMEM_SIZE, &gmem) || gmem == 0) {
+		laurel_metal_off("GPU reports no GMEM size (Turnip needs MSM_PARAM_GMEM_SIZE)");
+		goto out;
+	}
+	(void)redwood_gpu_parameter(MSM_PARAM_MAX_FREQ, &freq);
+	if (gpu->getProperty("RedwoodMaxBuffer") == NULL) {
+		gpu->setProperty("RedwoodMaxBuffer", LAUREL_METAL_MAX_BUFFER, 64);
+	}
+
+	accel->setProperty("MetalPluginName", LAUREL_METAL_PLUGIN);
+	accel->setProperty("MetalPluginClassName", LAUREL_METAL_CLASS);
+	accel->setProperty("IOGLBundleName", LAUREL_METAL_PLUGIN);   /* not read by Metal; flame and negroni set it too */
+	IOLog("LAUREL METAL: on: Turnip a610 (chip %#llx, GMEM %llu KiB, %llu MHz, buffers < 64 MiB), metal2vulkan plug-in "
+	    LAUREL_METAL_PLUGIN ".bundle class " LAUREL_METAL_CLASS " on IOAcceleratorES, GPU up %d ms after the root\n",
+	    (unsigned long long)chip, (unsigned long long)gmem >> 10, (unsigned long long)freq / 1000000, waited_ms);
+out:
+	OSSafeReleaseNULL(gpu);
+	accel->registerService();                       /* with the names (on) or empty (off), as topaz 0138 did at once */
+	gLaurelAccel = NULL;
+	accel->release();
+	thread_terminate(current_thread());
+}
+
+/*
+ * AppleCLCD::start (topaz 0138) calls this with the attached, not yet registered IOAcceleratorES. true: the check
+ * registers it later; false: the caller registers it now (empty, as topaz 0138 does).
+ */
+bool
+laurel_metal_publish(IOService * accel)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	if (PE_parse_boot_argn("laurelmetal", &on, sizeof(on)) && on == 0) {
+		laurel_metal_off("laurelmetal=0");
+		return false;
+	}
+	if (accel == NULL || gLaurelAccel != NULL) {
+		return false;
+	}
+	accel->retain();
+	gLaurelAccel = accel;
+	if (kernel_thread_start(laurel_metal_thread, NULL, &thread) != KERN_SUCCESS) {
+		gLaurelAccel = NULL;
+		accel->release();
+		laurel_metal_off("no thread for the check");
+		return false;
+	}
+	thread_deallocate(thread);
+	return true;
+}
+
+#else /* !ARM64_BOARD_CONFIG_SWEET */
+
+#include <IOKit/IOService.h>
+bool laurel_metal_publish(IOService * accel);
+
+bool
+laurel_metal_publish(IOService *)
+{
+	return false;
+}
+
+#endif
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 4eb5d3d..4978f1f 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -679,8 +679,12 @@ AppleCLCD::start(IOService *provider)
 	if (accel != NULL && accel->init()) {
 		accel->setName("sgx");
 		if (accel->attach(this)) {
-			accel->registerService();
-			IOLog("SWEET FB: empty IOAcceleratorES published (no 30 s wait in CAMetalContextCreate)\n");
+			/* laurel 2850: the Metal check registers it when it is done (with or without the plug-in names) */
+			extern bool laurel_metal_publish(IOService *accel);
+			if (!laurel_metal_publish(accel)) {
+				accel->registerService();
+				IOLog("SWEET FB: empty IOAcceleratorES published (no 30 s wait in CAMetalContextCreate)\n");
+			}
 		}
 	}
 	OSSafeReleaseNULL(accel);
