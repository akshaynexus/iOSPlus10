+/*
+ * laurel 3031: the hold's data path from a known state. The thread (or the timer call) the panic stopped may have been anywhere: after reading the
+ * frame and before re-arming the one RX TRB (then the hold never receives: 17:56:16, "holding" went out, no pong for 44 min), inside an endpoint command,
+ * between the ack and the handling of an event. ENDTRANSFER with FORCERM on the RX endpoint when it has a transfer, then a fresh RX TRB. TX: the 2 s
+ * timeout of the hold sends again by itself. ep0: a SETUP that was consumed and not re-armed gets its TRB back.
+ */
+static void
+ud_panic_rearm(const char *why)
+{
+	if (!ud.configured) {
+		return;
+	}
+	if (ud.ep_busy[EP_RX]) {
+		(void)ud_epcmd(EP_RX, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | (ud.ep_rsc[EP_RX] << 16), 0, 0, 0);
+		ud.ep_busy[EP_RX] = false;
+		ud_udelay(1000);
+	}
+	ud_rx_arm();
+	ud_panic_rearms++;
+	ud_panic_rx_at = mach_absolute_time();
+	ud_panic_log("LAUREL PANIC: USB hold: RX re-armed (%s), %u in all\n", why, ud_panic_rearms);
+}
+
+/* laurel 3031: the event ring, read against the mark ud_service_events left (its comment has the stages). Returns true when the data path needs ud_panic_rearm. */
+static bool
+ud_panic_resync(void)
+{
+	uint32_t stage = ud.evt_stage;
+	ud.evt_stage = 0;
+	switch (stage) {
+	case 0:
+	case 1:
+		return false;                   /* evt_pos still names the event: the hold reads it */
+	case 2:
+		ud.evt_pos = (ud.evt_pos + UD_EVT_SIZE - 4) % UD_EVT_SIZE;     /* not acked: the count still holds it: read it again */
+		ud_panic_log("LAUREL PANIC: USB hold: event 0x%08x read again (stage 2)\n", ud.evt_cur);
+		return false;
+	case 3:
+		ud_panic_log("LAUREL PANIC: USB hold: event 0x%08x acked, not handled: handled now (stage 3)\n", ud.evt_cur);
+		ud_event(ud.evt_cur);
+		return false;
+	default:
+		ud_panic_log("LAUREL PANIC: USB hold: the CPU stopped inside the handling of event 0x%08x (stage %u)\n", ud.evt_cur, stage);
+		if (ud.state == EP0_SETUP) {
+			volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_OUT);
+			ud_sync(UD_TRB_OUT, 16);
+			if ((t[3] & TRB_HWO) == 0) {
+				ud_start_setup();       /* a consumed SETUP with no TRB behind it: the host could not enumerate again */
+			}
+		}
+		return true;
+	}
+}
