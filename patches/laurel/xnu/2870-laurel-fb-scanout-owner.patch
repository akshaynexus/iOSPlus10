+
+/*
+ * laurel 2870: AppleCLCD start. Draw from now on into va (its console shadow, same panel geometry), which already
+ * holds a copy of the boot framebuffer. Returns 0 when there is no fbcon.
+ */
+int
+laurel_fbcon_retarget(vm_offset_t va, uint32_t width, uint32_t height, uint32_t stride)
+{
+	if (fbcon_base == NULL || va == 0 || width < 8 * FBCON_SCALE || height < 2 * 16 * FBCON_SCALE ||
+	    stride < width * 4) {
+		return 0;
+	}
+	uint32_t rows = height / (16 * FBCON_SCALE), cols = width / (8 * FBCON_SCALE);
+	fbcon_width = width;
+	fbcon_height = height;
+	fbcon_stride = stride;
+	fbcon_cols = cols;
+	fbcon_rows = rows;
+	if (fbcon_row >= rows) {
+		fbcon_row = 0;
+	}
+	if (fbcon_col >= cols) {
+		fbcon_col = 0;
+	}
+	__asm__ volatile ("dmb ish" ::: "memory");
+	fbcon_base = (volatile uint32_t *)va;
+	fbcon_shadow = 1;
+	fbcon_dirty = 1;
+	return 1;
+}
+
+int
+laurel_fbcon_state(void)
+{
+	return (fbcon_base != NULL ? LAUREL_FBCON_REGISTERED : 0) | (fbcon_shadow ? LAUREL_FBCON_SHADOW : 0) |
+	       (fbcon_muted ? LAUREL_FBCON_MUTED : 0) |
+	       (fbcon_base != NULL && console_is_serial() ? LAUREL_FBCON_CONSOLE : 0);
+}
+
+/* AppleCLCD's vsync while the console frames are on the panel: anything drawn since the last call? */
+int
+laurel_fbcon_take_dirty(void)
+{
+	int d = fbcon_dirty;
+	fbcon_dirty = 0;
+	return d;
+}
+
+void
+laurel_fbcon_mute(void)
+{
+	fbcon_muted = 1;
 }
 
