+/* the SGI bits of those words. Pending: the signal got there and the CPU has not taken it. Active: taken, in its handler */
+static bool
+lwd_sgi_state(uint32_t mpidr, bool *pending, bool *active)
+{
+	uint32_t p = 0, a = 0;
