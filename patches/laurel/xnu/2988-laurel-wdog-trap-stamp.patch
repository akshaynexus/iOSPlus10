+void laurel_wdog_trap_in(uint64_t esr, uint64_t far, uint64_t pc);
+void
+laurel_wdog_trap_in(uint64_t esr, uint64_t far, uint64_t pc)
+{
+	unsigned int cpu = cpu_number();
+
+	if (cpu >= LWD_CPUS) {
+		return;
+	}
+	struct lwd_cpu *c = &lwd_cpu[cpu];
