+/*
+ * Bars 0-4 (an iPhone X shows at most 4). Thresholds of Android's CellSignalStrength classes [I, as read in AOSP, not in this repo]: LTE and NR RSRP
+ * -115 -105 -95 -85 dBm, GSM and WCDMA RSSI -107 -103 -97 -89 dBm. No reading = 0 bars: only the kernel's own reading, never a guess.
+ */
+static int
+reg_bars(const struct reg *r)
+{
+	if (r->state != 1 || !r->sig) {
+		return 0;
+	}
+	if (r->rsrp != 0) {
+		return r->rsrp >= -85 ? 4 : r->rsrp >= -95 ? 3 : r->rsrp >= -105 ? 2 : r->rsrp >= -115 ? 1 : 0;
+	}
+	if (r->rssi != 0) {
+		return r->rssi >= -89 ? 4 : r->rssi >= -97 ? 3 : r->rssi >= -103 ? 2 : r->rssi >= -107 ? 1 : 0;
+	}
+	return 0;
+}
