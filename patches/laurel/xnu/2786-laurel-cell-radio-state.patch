+/* key=value lines for the SpringBoard bridge (kern.laurel_cell_state). No ICCID, IMSI, IMEI, phone number. */
+static const char *
+sim_key(const struct slot *k)
+{
+	if (!k->known) {
+		return "unknown";
+	}
+	if (k->card == 0) {
+		return "absent";
+	}
+	if (k->card != 1) {
+		return "error";
+	}
+	if (!k->app) {
+		return "noapp";
+	}
+	switch (k->app_state) {
+	case 2: return "pin";
+	case 3: return "puk";
+	case 5: return "blocked";
+	case 6: return "illegal";
+	case 7: return "ready";
+	default: return "starting";     /* detected, personalization check: the modem goes on by itself */
+	}
+}
