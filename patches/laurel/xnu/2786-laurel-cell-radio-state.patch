+/* a present card that no session holds yet: slot of the subscription's view, -1 none */
+static int
+sub_view_slot(int sub)
+{
+	int s = sub_slot(sub), other = sub_slot(!sub), seen = 0;
+
+	if (s >= 0) {
+		return s;
+	}
+	for (int i = 0; i < SLOTS; i++) {
+		if (sim_present(i) && i != other) {
+			if (other >= 0 || seen == sub) {
+				return i;
+			}
+			seen++;
+		}
 	}
