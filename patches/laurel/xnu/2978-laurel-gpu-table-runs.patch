diff --git a/iokit/Kernel/arm/laurel_gpu_table_core.h b/iokit/Kernel/arm/laurel_gpu_table_core.h
new file mode 100644
index 0000000..f4ed841
--- /dev/null
+++ b/iokit/Kernel/arm/laurel_gpu_table_core.h
@@ -0,0 +1,66 @@
+/*
+ * laurel 2978: small rules of RedwoodGPU's cost, plain C, for the host test (scripts/laurel/gpu-push-test.sh, tools/gpu-push-test/).
+ * (1) GPU table entries: the SMMU walks with no cache (TCR NC walks), so each written entry must reach memory before the GPU may use it. sweet_dcache_clean is
+ *     dsb + dc cvac + dsb: per entry, 2048 barriers x 2 for an 8 MiB buffer, under gGPULock, at each buffer made and freed. Adjacent entries of a run are cleaned as one range.
+ *     lgt_run_add says what to clean now; the last range at lgt_run_end. Every entry is in exactly one cleaned range, before redwood_gpu_mapped's barrier.
+ * (2) A client's surface buffers in a short list of handles: "is this surface a buffer here" looked through all 8192 places under gGPULock (surfaceBuffer, surfaceDrawn).
+ */
+#ifndef LAUREL_GPU_TABLE_CORE_H
+#define LAUREL_GPU_TABLE_CORE_H
+
+struct lgt_run {
+	uint64_t start, end;    /* start == end: empty */
+};
+
+/* An entry of `len` bytes at address: true: clean [*from, *to) first (it does not join the run) */
+static inline bool
+lgt_run_add(struct lgt_run *r, uint64_t address, uint64_t len, uint64_t *from, uint64_t *to)
+{
+	bool out = false;
+
+	if (r->start != r->end && address == r->end) {
+		r->end = address + len;
+		return false;
+	}
+	if (r->start != r->end) {
+		*from = r->start;
+		*to = r->end;
+		out = true;
+	}
+	r->start = address;
+	r->end = address + len;
+	return out;
+}
+
+/* true: clean [*from, *to); the run is empty after it */
+static inline bool
+lgt_run_end(struct lgt_run *r, uint64_t *from, uint64_t *to)
+{
+	if (r->start == r->end) {
+		return false;
+	}
+	*from = r->start;
+	*to = r->end;
+	r->start = r->end = 0;
+	return true;
+}
+
+/* handles[count]: unordered; at[handle - 1]: the place of that handle in the list */
+static inline void
+lgt_list_add(uint16_t *handles, uint16_t *at, uint32_t *count, uint32_t handle)
+{
+	handles[*count] = (uint16_t)handle;
+	at[handle - 1] = (uint16_t)*count;
+	(*count)++;
+}
+
+static inline void
+lgt_list_remove(uint16_t *handles, uint16_t *at, uint32_t *count, uint32_t handle)
+{
+	uint32_t place = at[handle - 1], last = --(*count);
+
+	handles[place] = handles[last];
+	at[handles[place] - 1] = (uint16_t)place;
+}
+
+#endif /* LAUREL_GPU_TABLE_CORE_H */
