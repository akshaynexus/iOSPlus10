--- /dev/null
+++ b/osfmk/arm64/laurel_wdog_core.h
@@ -0,0 +1,61 @@
+/*
+ * laurel 2986: the rules of the APSS watchdog, with no kernel types, so that a host test runs exactly this code (scripts/laurel/wdog-test.sh).
+ * Times: docs/laurel_sprout/watchdog.md. The hardware counts at 32765 Hz in 20 bits: at most 32 s (msm watchdog_v2.c: WDT_HZ, WDT0_STS bits 1-20).
+ */
+#ifndef LAUREL_WDOG_CORE_H
+#define LAUREL_WDOG_CORE_H
+
+#define LWD_HZ          32765u
+#define LWD_COUNT_MAX   0xFFFFFu
+#define LWD_BARK_S      12u     /* no pet for 12 s: interrupt, if a CPU can take it. Stock trinket: 11 s */
+#define LWD_BITE_S      20u     /* no pet for 20 s: reset, with no CPU. Stock: bark + 3 s. Here 8 s, so that the panic of the bark can run */
+#define LWD_PET_MS      1000u   /* a round: a signal to each CPU, one pet if all answered. Stock: 9360 ms */
+#define LWD_SILENT_MS   8000u   /* a CPU silent this long stops the pet: bark 20 s, bite 28 s after that CPU stopped */
+#define LWD_PANIC_S     30u     /* a panic in progress: one last bite, if the panic itself hangs before its hold */
+#define LWD_LATE_THREAD_MS 3000u /* the pet thread this late: the USB thread names it */
+
+static const unsigned lwd_line_ms[3] = { 2000u, 5000u, 10000u };        /* a line at each of these silences */
+
+static inline unsigned
+lwd_ticks(unsigned seconds)
+{
+	unsigned long long t = (unsigned long long)seconds * LWD_HZ;
+
+	return t > LWD_COUNT_MAX ? LWD_COUNT_MAX : (unsigned)t;
+}
+
+/* a pet is right only if every CPU in use answered: silent[i] in ms, used[i] != 0 for a CPU in use */
+static inline int
+lwd_pet_ok(const unsigned *silent_ms, const unsigned char *used, unsigned n)
+{
+	for (unsigned i = 0; i < n; i++) {
+		if (used[i] && silent_ms[i] >= LWD_SILENT_MS) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/*
+ * The next line for one CPU. level: lines already given for this silence, kept by the caller. 1: give a line now. -1: the CPU answers again after a silence with a line:
+ * give one line with the time. 0: nothing.
+ */
+static inline int
+lwd_line(unsigned silent_ms, unsigned *level)
+{
+	if (silent_ms < lwd_line_ms[0]) {
+		int back = *level != 0;
+
+		*level = 0;
+		return back ? -1 : 0;
+	}
+	if (*level < 3 && silent_ms >= lwd_line_ms[*level]) {
+		while (*level < 3 && silent_ms >= lwd_line_ms[*level]) {
+			(*level)++;
+		}
+		return 1;
+	}
+	return 0;
+}
+
+#endif /* LAUREL_WDOG_CORE_H */
