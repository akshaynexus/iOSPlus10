+/*
+ * laurel 2881: the output queue's thread. The stack queues frames in the interface's class queue (FQ-CoDel: one queue per
+ * flow, so a bulk download's ACKs do not delay a DNS question or a SYN) and returns to TCP "the queue is full" (EQFULL, flow
+ * control), not a lost frame. This thread gives frames to the radio's short queue. When that is full it waits here: frames
+ * stay in the class queue, which stops the sender. Log 2026-11-01: 13715 frames lost at that point (dropped out = tx_drop).
+ */
+static void
+net_start(ifnet_t ifp)
+{
+	mbuf_t packet;
+
+	while (ifnet_dequeue(ifp, &packet) == 0) {
+		size_t length = mbuf_pkthdr_len(packet);
+		int result = length > REDWOOD_NET_FRAME_MAX ? REDWOOD_TX_BAD : net_link_up ? REDWOOD_TX_SENT : REDWOOD_TX_DOWN;
+
+		if (result == REDWOOD_TX_SENT) {
+			net_tx_note(ifp, packet, length);
+			while ((result = net_link->transmit(packet, length)) == REDWOOD_TX_FULL && net_link_up) {
+				net_count.tx_waits++;
+				delay_for_interval(200, NSEC_PER_USEC);
+			}
+			if (result == REDWOOD_TX_FULL) {
+				result = REDWOOD_TX_DOWN;
+			}
+		}
+		net_tx_done(ifp, packet, length, result);
+	}
+}
