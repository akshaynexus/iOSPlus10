+{
+	uint64_t res = 0, st = scm(SCM_FN(0x01, 0x0a), 2, 0, 0, 0, &res);
+
+	IOLog("TopazGPU: zap resume: %llx/%llx\n", st, res);
+	return st == 0;
+}
