+/*
+ * laurel 2104: console handoff at the first iOS frame. From now on the kernel console never draws
+ * onto the panel; a panic still does (sweet_cons_show / _cnputs with panic_active). Self-check: the
+ * console must draw into its shadow frame (sweet_console_retarget, which nothing scans after this
+ * frame). It does not (no shadow: the console still draws into the boot framebuffer, which is
+ * surface 1 and may be on the panel): console text stops being drawn (sweet_console_muted; it
+ * still reaches the USB log, and a panic draws). Kill switch fbhandoff=0: topaz behaviour.
+ */
+extern "C" int sweet_console_on_shadow(void);       /* osfmk/console/video_console.c */
+
+void
+AppleCLCD::consoleHandoff(void)
+{
+	if (fHandoff == 0) {
+		IOLog("LAUREL FB HANDOFF: off: fbhandoff=0 (kernel console frames may show on the panel)\n");
+		return;
+	}
+	if (sweet_console_on_shadow()) {
+		IOLog("LAUREL FB HANDOFF: on: first iOS frame owns the panel; kernel console only in its shadow %#llx "
+		    "(not scanned, shown again only by a panic); surface 1 = boot framebuffer %#llx, scanned directly\n",
+		    fConsPhys, fPhys);
+	} else {
+		sweet_console_muted = 1;
+		IOLog("LAUREL FB HANDOFF: on: first iOS frame owns the panel; no console shadow (console drew into the "
+		    "boot framebuffer): console text off the panel (USB log keeps it, a panic draws)\n");
+	}
+}
