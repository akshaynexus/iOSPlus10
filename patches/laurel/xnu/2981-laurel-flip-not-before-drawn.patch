+/* laurel 2981: an older swap never replaces a newer one on the panel (the timer's copy path waits on its own thread, the presenter can pass it) */
+bool
+AppleCLCD::flipOlder(const uint8_t *rec)
+{
+	uint32_t id = get32(rec, 0x50);
+
+	if (!fFlipRule || !lfl_swap_older(id, fShownSwap)) {
+		return false;
+	}
+	lf.older++;
+	if (laurel_flip_tell()) {
+		IOLog("LAUREL FLIP: swap %u came after swap %u: not shown\n", id, fShownSwap);
+	}
+	return true;
+}
+
+void
+AppleCLCD::flipNote(const uint8_t *rec, SweetSurface *s)
+{
+	uint32_t id = get32(rec, 0x50);
+
+	if (id != 0) {
+		fShownSwap = id;
+	}
+	if (s != NULL) {
+		s->shownFence = s->drawn;
+	}
+}
