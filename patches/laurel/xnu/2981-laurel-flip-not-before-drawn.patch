diff --git a/iokit/Kernel/arm/laurel_flip_core.h b/iokit/Kernel/arm/laurel_flip_core.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/laurel_flip_core.h
@@ -0,0 +1,39 @@
+/*
+ * laurel 2981: what may go to the panel. Pure rules, built as they are by the host test (scripts/laurel/flip-test.sh).
+ * Swap ids grow from SwapBegin; 0 is "no id". A surface's `drawn` is the last submission of the window server that names it.
+ */
+#ifndef LAUREL_FLIP_CORE_H
+#define LAUREL_FLIP_CORE_H
+
+#define LFL_WAIT_PRESENTER_MS   900u    /* under the 1000 ms of gpuWait that report a dead GPU, under the watchdog's 1500 ms. [V log] windows average 430 ms a submission */
+#define LFL_WAIT_TICK_MS        100u    /* the timer's thread: the old limit, this thread also sends vsync */
+#define LFL_QUEUE_MS            2000u   /* SwapEnd with a full queue: two frames at the presenter's limit, and some */
+#define LFL_QUEUE_OLD_MS        200u
+#define LFL_EVENT_LINES         8u
+
+/* A swap older than the one on the panel: only the timer's copy path can come late (its wait is on another thread). */
+static inline bool
+lfl_swap_older(uint32_t id, uint32_t shown)
+{
+	return id != 0 && shown != 0 && (int32_t)(id - shown) < 0;
+}
+
+/*
+ * The surface was on the panel before and no submission named it since, so it holds what it held then: an older picture comes back.
+ * A surface on the panel now is no change. Limit: every submission of the window server names all its surfaces, so an unrelated
+ * submission in between hides a case; a hit is always real.
+ */
+static inline bool
+lfl_shown_again(uint32_t drawn, uint32_t shown_fence, bool on_panel)
+{
+	return !on_panel && shown_fence != 0 && drawn == shown_fence;
+}
+
+/* Does this flip go ahead after the wait for the GPU? Only the presenter may refuse: the timer's flip has no later try. A kill switch restores the old rule. */
+static inline bool
+lfl_refuse_not_drawn(bool drawn, bool rule, bool on_presenter)
+{
+	return !drawn && rule && on_presenter;
+}
+
+#endif /* LAUREL_FLIP_CORE_H */
