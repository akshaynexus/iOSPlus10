laurel 2405: Wi-Fi: LaurelWifiPhy.h: firmware caps, AP elements, our HT/VHT/WMM elements (pure code, host test scripts/laurel/wifi-phy-test.sh).

diff --git a/iokit/Kernel/arm/LaurelWifiPhy.h b/iokit/Kernel/arm/LaurelWifiPhy.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/LaurelWifiPhy.h
@@ -0,0 +1,218 @@
+/*
+ * laurel 2405: what the WCN3990 and an access point can do together (HT, VHT, QoS, width), and the
+ * bytes that follow from it. Pure code: no kernel call, no state; scripts/laurel/wifi-phy-test.sh
+ * runs it on the host. Values: ath10k mac.c (ath10k_get_ht_cap, ath10k_create_vht_cap,
+ * ath10k_peer_assoc_h_ht/_vht/_phymode), wmi.h, htt_rx.c (ath10k_htt_rx_h_rates).
+ */
+#ifndef LAUREL_WIFI_PHY_H
+#define LAUREL_WIFI_PHY_H
+
+enum { LW_11A = 0, LW_11G = 1, LW_HT20_5G = 4, LW_HT20_2G = 5, LW_HT40_5G = 6, LW_VHT20 = 8, LW_VHT40 = 9, LW_VHT80 = 10 };
+
+#define LW_FW_HT_ENABLED    0x0001u
+#define LW_FW_HT_SGI20      0x0002u
+#define LW_FW_HT_TX_STBC    0x0008u
+#define LW_FW_HT_RX_STBC    0x0030u
+#define LW_FW_HT_LDPC       0x0040u
+#define LW_FW_HT_LSIG       0x0080u
+#define LW_FW_HT_SGI40      0x0800u
+#define LW_CAP_LDPC         0x0001u
+#define LW_CAP_40           0x0002u
+#define LW_CAP_SMPS_OFF     0x000Cu
+#define LW_CAP_SGI20        0x0020u
+#define LW_CAP_SGI40        0x0040u
+#define LW_CAP_TX_STBC      0x0080u
+#define LW_CAP_RX_STBC      0x0300u
+#define LW_CAP_AMSDU        0x0800u
+#define LW_CAP_DSSS40       0x1000u
+#define LW_CAP_LSIG         0x8000u
+#define LW_VHT_RXLDPC       0x00000010u
+#define LW_VHT_WIDTH        0x0000000Cu
+#define LW_VHT_SGI80        0x00000020u
+#define LW_VHT_SGI160       0x00000040u
+#define LW_VHT_TXSTBC       0x00000080u
+#define LW_VHT_RXSTBC       0x00000700u
+#define LW_VHT_BF           0x001FF800u     /* SU/MU beamformer/beamformee, STS, sounding: not enabled by us */
+#define LW_VHT_AS_IS        0x3FE00010u     /* mac80211 ieee80211_vht_cap_ie_to_sta_vht_cap: taken from the AP */
+#define LW_PEER_QOS         0x00000002u
+#define LW_PEER_HT          0x00001000u
+#define LW_PEER_40          0x00002000u
+#define LW_PEER_STBC        0x00008000u
+#define LW_PEER_LDPC        0x00010000u
+#define LW_PEER_VHT         0x02000000u
+#define LW_PEER_80          0x04000000u
+#define LW_RC_CW40          0x02u
+#define LW_RC_SGI           0x04u
+#define LW_RC_HT            0x08u
+#define LW_RC_TX_STBC       0x20u
+
+/* from WMI SERVICE_READY + HAL_REG_CAPABILITIES */
+struct lw_fw {
+	bool valid, reg_valid;
+	uint32_t phy, rf_chains, ht, vht, vht_mcs, rd, low5, high5;
+};
+
+/* what the beacon says */
+struct lw_ap {
+	bool ht, vht, wmm, wmm_params, ht_40, ht_below;
+	uint16_t ht_cap, vht_rx, vht_rx_max, vht_tx, vht_tx_max;
+	uint8_t ampdu, ht_mcs[10], vht_width, vht_seg0;
+	uint32_t vht_cap;
+	uint8_t ac[4][4];                           /* WMM parameter records, by ACI: BE, BK, VI, VO */
+};
+
+/* what the join uses */
+struct lw_link {
+	bool qos, ht, vht;
+	uint8_t nss, ht_rates[16], ht_rate_count;
+	uint16_t width;
+	uint32_t freq, center, mode, peer_flags, ht_caps, max_mpdu, density, rate_caps, vht_caps;
+	uint32_t vht_rx_max, vht_rx_mcs, vht_tx_max, vht_tx_mcs;
+};
+
+/* one received PPDU's rate */
+struct lw_rate {
+	uint32_t mbps10;                            /* 0: not known */
+	uint8_t kind, mcs, nss, sgi;                /* kind: 0 legacy, 1 HT, 2 VHT */
+	uint16_t width;
+};
+
+static inline uint32_t
+lw_nss_own(const struct lw_fw *fw)
+{
+	return fw->rf_chains >= 2 ? 2 : 1;
+}
+
+static inline uint32_t
+lw_get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline uint16_t
+lw_get16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | p[1] << 8);
+}
+
+static inline void
+lw_parse_ap(const uint8_t *ie, uint32_t len, struct lw_ap *ap)
+{
+	memset(ap, 0, sizeof(*ap));
+	for (uint32_t o = 0; o + 2 <= len && o + 2 + ie[o + 1] <= len; o += 2 + ie[o + 1]) {
+		const uint8_t *v = ie + o + 2;
+		uint32_t l = ie[o + 1];
+
+		if (ie[o] == 45 && l >= 26) {           /* HT capabilities */
+			ap->ht = true;
+			ap->ht_cap = lw_get16(v);
+			ap->ampdu = v[2];
+			memcpy(ap->ht_mcs, v + 3, sizeof(ap->ht_mcs));
+		} else if (ie[o] == 61 && l >= 22) {    /* HT operation: secondary channel + width bit */
+			ap->ht_40 = (v[1] & 4) != 0 && ((v[1] & 3) == 1 || (v[1] & 3) == 3);
+			ap->ht_below = (v[1] & 3) == 3;
+		} else if (ie[o] == 191 && l >= 12) {   /* VHT capabilities */
+			ap->vht = true;
+			ap->vht_cap = lw_get32(v);
+			ap->vht_rx = lw_get16(v + 4);
+			ap->vht_rx_max = lw_get16(v + 6) & 0x1FFF;
+			ap->vht_tx = lw_get16(v + 8);
+			ap->vht_tx_max = lw_get16(v + 10) & 0x1FFF;
+		} else if (ie[o] == 192 && l >= 3) {    /* VHT operation */
+			ap->vht_width = v[0];
+			ap->vht_seg0 = v[1];
+		} else if (ie[o] == 221 && l >= 7 && v[0] == 0x00 && v[1] == 0x50 && v[2] == 0xF2 && v[3] == 2) {
+			ap->wmm = v[4] <= 1;
+			if (v[4] == 1 && l >= 24) {     /* parameter element: ver, qos info, reserved, 4 records */
+				for (uint32_t r = 0; r < 4; r++) {
+					uint32_t aci = (v[8 + 4 * r] >> 5) & 3;
+
+					memcpy(ap->ac[aci], v + 8 + 4 * r, 4);
+				}
+				ap->wmm_params = true;
+			}
+		}
+	}
+}
+
+static inline uint32_t
+lw_density(uint32_t code)                       /* ath10k_parse_mpdudensity */
+{
+	return code == 0 ? 0 : code <= 3 ? 1 : code == 4 ? 2 : code == 5 ? 4 : code == 6 ? 8 : 16;
+}
+
+/* our HT capability info; `wide`: we offer 40 MHz (5 GHz only: stations stay at 20 MHz on 2.4 GHz) */
+static inline uint16_t
+lw_ht_cap_own(const struct lw_fw *fw, bool wide)
+{
+	uint32_t c = LW_CAP_SMPS_OFF;
+
+	c |= wide ? LW_CAP_40 | LW_CAP_DSSS40 : 0;
+	c |= fw->ht & LW_FW_HT_SGI20 ? LW_CAP_SGI20 : 0;
+	c |= wide && (fw->ht & LW_FW_HT_SGI40) ? LW_CAP_SGI40 : 0;
+	c |= (fw->ht & LW_FW_HT_TX_STBC) && lw_nss_own(fw) > 1 ? LW_CAP_TX_STBC : 0;
+	c |= ((fw->ht & LW_FW_HT_RX_STBC) >> 4) << 8;
+	c |= fw->ht & LW_FW_HT_LDPC ? LW_CAP_LDPC : 0;
+	c |= fw->ht & LW_FW_HT_LSIG ? LW_CAP_LSIG : 0;
+	c |= fw->vht & 3 ? LW_CAP_AMSDU : 0;
+	return (uint16_t)c;
+}
+
+static inline uint32_t
+lw_vht_cap_own(const struct lw_fw *fw)
+{
+	uint32_t c = fw->vht & ~(LW_VHT_WIDTH | LW_VHT_SGI160 | LW_VHT_BF);
+
+	return lw_nss_own(fw) > 1 ? c : c & ~LW_VHT_TXSTBC;
+}
+
+/* the element bytes, for the association request; each returns the end */
+static inline uint8_t *
+lw_put_ht_cap(uint8_t *p, const struct lw_fw *fw, bool wide)
+{
+	uint16_t c = lw_ht_cap_own(fw, wide);
+
+	memset(p, 0, 28);
+	p[0] = 45;
+	p[1] = 26;
+	p[2] = (uint8_t)c;
+	p[3] = (uint8_t)(c >> 8);
+	p[4] = 3 | 6 << 2;                          /* 64 KiB A-MPDU, 8 us density (ath10k_get_ht_cap) */
+	for (uint32_t i = 0; i < lw_nss_own(fw); i++) {
+		p[5 + i] = 0xFF;
+	}
+	p[5 + 12] = 1;                              /* the Tx MCS set is defined */
+	return p + 28;
+}
+
+static inline uint8_t *
+lw_put_vht_cap(uint8_t *p, const struct lw_fw *fw)
+{
+	uint32_t c = lw_vht_cap_own(fw);
+	uint16_t map = lw_nss_own(fw) > 1 ? 0xFFFA : 0xFFFE;    /* MCS 0-9 on each chain */
+
+	p[0] = 191;
+	p[1] = 12;
+	p[2] = (uint8_t)c;
+	p[3] = (uint8_t)(c >> 8);
+	p[4] = (uint8_t)(c >> 16);
+	p[5] = (uint8_t)(c >> 24);
+	p[6] = (uint8_t)map;
+	p[7] = (uint8_t)(map >> 8);
+	p[8] = p[9] = 0;
+	p[10] = (uint8_t)map;
+	p[11] = (uint8_t)(map >> 8);
+	p[12] = p[13] = 0;
+	return p + 14;
+}
+
+static inline uint8_t *
+lw_put_wmm(uint8_t *p)
+{
+	static const uint8_t wmm[9] = { 221, 7, 0x00, 0x50, 0xF2, 2, 0, 1, 0 };
+
+	memcpy(p, wmm, sizeof(wmm));
+	return p + sizeof(wmm);
+}
+
+#endif /* LAUREL_WIFI_PHY_H */
