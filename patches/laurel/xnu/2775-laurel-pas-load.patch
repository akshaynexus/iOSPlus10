--- a/bsd/dev/topaz_pas.c	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/topaz_pas.c	2026-11-01 08:23:51.368988826 +0530
@@ -0,0 +1,218 @@
+/*
+ * laurel 2775: the shared TrustZone peripheral-image (PAS) loader; interface and sources in topaz_pas.h.
+ * The steps, their order and the log lines are the ones of the GPU zap shader loader of laurel 2153
+ * (TopazAdreno.cpp zap_load), which is now a caller of this file.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include "topaz_pas.h"
+
+extern uint64_t topaz_scm(uint32_t fn, uint64_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *res1);
+extern bool topaz_soc_map(void);
+extern void *topaz_pool_alloc(uint64_t size, uint64_t *pa);
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_dcache_clean(vm_offset_t addr, unsigned length);
+extern void IOLog(const char *format, ...) __printflike(1, 2);
+
+#define SCM_FN(svc, cmd)        (0x42000000u | ((uint32_t)(svc) << 8) | (uint32_t)(cmd))
+#define SCM_SVC_PIL             0x02
+#define PIL_INIT_IMAGE          0x01
+#define PIL_MEM_SETUP           0x02
+#define PIL_AUTH_RESET          0x05
+#define PIL_SHUTDOWN            0x06
+#define PIL_IS_SUPPORTED        0x07
+#define SCM_ARG_RW              2
+
+#define PT_LOAD                 1
+#define MDT_TYPE(flags)         (((flags) >> 24) & 7)
+#define MDT_TYPE_HASH           2
+#define META_MAX                0x10000u
+
+static inline uint32_t g32(const uint8_t *p) { uint32_t v; memcpy(&v, p, 4); return v; }
+static inline uint16_t g16(const uint8_t *p) { uint16_t v; memcpy(&v, p, 2); return v; }
+
+static uint32_t
+ms_since(uint64_t t0)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	return (uint32_t)(ns / 1000000);
+}
+
+/* loadable = PT_LOAD with memsz != 0 and not the hash segment (Linux pil / mdt_loader) */
+static bool
+loadable(const uint8_t *ph)
+{
+	return g32(ph) == PT_LOAD && g32(ph + 20) != 0 && MDT_TYPE(g32(ph + 24)) != MDT_TYPE_HASH;
+}
+
+static bool
+elf_ok(const uint8_t *m, size_t len, uint32_t *phoff, uint32_t *phnum)
+{
+	if (len < 52 || memcmp(m, "\177ELF\001", 5) != 0) {
+		return false;
+	}
+	*phoff = g32(m + 28);
+	*phnum = g16(m + 44);
+	return *phoff < len && *phnum != 0 && *phnum <= (len - *phoff) / 32;
+}
+
+bool
+topaz_pas_span(const uint8_t *m, size_t len, uint32_t *lo, uint32_t *hi)
+{
+	uint32_t phoff, phnum, min_a = 0xffffffffu, max_a = 0;
+
+	if (!elf_ok(m, len, &phoff, &phnum)) {
+		return false;
+	}
+	for (uint32_t i = 0; i < phnum; i++) {
+		const uint8_t *ph = m + phoff + 32 * i;
+		if (!loadable(ph)) {
+			continue;
+		}
+		uint64_t paddr = g32(ph + 12), end = (paddr + g32(ph + 20) + 0xfff) & ~0xfffull;
+		if (end > 0xffffffffull) {
+			return false;
+		}
+		min_a = (uint32_t)paddr < min_a ? (uint32_t)paddr : min_a;
+		max_a = (uint32_t)end > max_a ? (uint32_t)end : max_a;
+	}
+	*lo = min_a;
+	*hi = max_a;
+	return max_a > min_a;
+}
+
+/* the metadata into the modem pool (or the caller's buffer), cleaned to memory for TrustZone */
+static bool
+meta_place(const struct topaz_pas *p, uint64_t *pa, const char **where, char *why, size_t wl)
+{
+	uint8_t *va = NULL;
+
+	*where = "modem pool";
+	if (topaz_soc_map()) {
+		va = (uint8_t *)topaz_pool_alloc(p->mdt_len, pa);
+	}
+	if (va == NULL || *pa + p->mdt_len > 0x100000000ull) {
+		va = NULL;
+		if (p->meta_alt != NULL) {
+			*where = p->meta_alt(p->ctx, p->mdt_len, &va, pa);
+		}
+		if (va == NULL || *where == NULL) {
+			snprintf(why, wl, "no contiguous buffer for %zu bytes of %s metadata", p->mdt_len, p->name);
+			IOLog("%s: %s\n", p->tag, why);
+			return false;
+		}
+	}
+	memcpy(va, p->mdt, p->mdt_len);
+	sweet_dcache_clean((vm_offset_t)va, (unsigned)p->mdt_len);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return true;
+}
+
+/* zero the region, then each loadable segment at its offset from the lowest address */
+static int
+copy_segments(const struct topaz_pas *p, uint32_t lo, uint32_t *nseg, char *why, size_t wl)
+{
+	uint32_t phoff = g32(p->mdt + 28), phnum = g16(p->mdt + 44);
+	volatile uint8_t *dst = (volatile uint8_t *)ml_io_map((vm_offset_t)p->region_pa, p->region_size);
+
+	*nseg = 0;
+	if (dst == NULL) {
+		snprintf(why, wl, "cannot map the %s region %#llx", p->name, p->region_pa);
+		return EIO;
+	}
+	for (uint32_t i = 0; i < p->region_size; i += 4) {
+		*(volatile uint32_t *)(dst + i) = 0;
+	}
+	for (uint32_t i = 0; i < phnum; i++) {
+		const uint8_t *ph = p->mdt + phoff + 32 * i;
+		if (!loadable(ph)) {
+			continue;
+		}
+		uint32_t at = g32(ph + 12) - lo;
+		int e = p->seg(p->ctx, i, dst + at, p->region_size - at, why, wl);
+		if (e != 0) {
+			return e;
+		}
+		(*nseg)++;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return 0;
+}
+
+int
+topaz_pas_load(const struct topaz_pas *p, char *why, size_t wl)
+{
+	uint32_t lo = 0, hi = 0, nseg = 0;
+	uint64_t st, res = 0, meta_pa = 0, t0;
+	const char *where = NULL;
+	int rc;
+
+	if (!topaz_pas_span(p->mdt, p->mdt_len, &lo, &hi) || p->seg == NULL) {
+		snprintf(why, wl, "%s .mdt is no ELF32 image with loadable segments (%zu bytes)", p->name, p->mdt_len);
+		IOLog("%s: %s\n", p->tag, why);
+		return TOPAZ_PAS_ELAYOUT;
+	}
+	if (hi - lo > p->region_size) {
+		snprintf(why, wl, "%s layout %#x-%#x does not fit the %#x-byte carve-out", p->name, lo, hi, p->region_size);
+		IOLog("%s layout %#x-%#x does not fit the %#x-byte carve-out\n", p->tag, lo, hi, p->region_size);
+		return TOPAZ_PAS_ELAYOUT;
+	}
+	if (p->mdt_len > META_MAX) {
+		snprintf(why, wl, "%s metadata of %zu bytes is too large", p->name, p->mdt_len);
+		return TOPAZ_PAS_EMETA;
+	}
+	if (!meta_place(p, &meta_pa, &where, why, wl)) {
+		return TOPAZ_PAS_EMETA;
+	}
+	/*
+	 * Self-check: TrustZone answers the PIL service for this PAS id (fast call). On this TZ x1 is 0 even for
+	 * the modem's PAS 4, which loads (topaz 0116 'PAS id 4 supported: ret=0 res=0'), so only a failed call
+	 * (x0 != 0) stops here. No PAS_SHUTDOWN before init_image (Linux pil-tz and mainline do not either).
+	 */
+	t0 = mach_absolute_time();
+	st = topaz_scm(SCM_FN(SCM_SVC_PIL, PIL_IS_SUPPORTED), 1, p->pas_id, 0, 0, &res);
+	IOLog("%s: PAS %u is_supported %llx/%llx (%u ms), metadata %zu bytes at %#llx (%s)\n", p->tag, p->pas_id, st,
+	    res, ms_since(t0), p->mdt_len, meta_pa, where);
+	if (st != 0) {
+		snprintf(why, wl, "TrustZone has no PIL call for PAS %u: is_supported %llx", p->pas_id, st);
+		return TOPAZ_PAS_ENOSUPPORT;
+	}
+	t0 = mach_absolute_time();
+	st = topaz_scm(SCM_FN(SCM_SVC_PIL, PIL_INIT_IMAGE), 2 | (SCM_ARG_RW << 6), p->pas_id, meta_pa, 0, &res);
+	if (st != 0 || res != 0) {
+		snprintf(why, wl, "TrustZone refused the %s: init_image %llx/%llx", p->name, st, res);
+		IOLog("%s init_image: %llx/%llx\n", p->tag, st, res);
+		return TOPAZ_PAS_EINIT;
+	}
+	st = topaz_scm(SCM_FN(SCM_SVC_PIL, PIL_MEM_SETUP), 3, p->pas_id, p->region_pa, hi - lo, &res);
+	if (st != 0 || res != 0) {
+		snprintf(why, wl, "TrustZone mem_setup of %#llx: %llx/%llx", p->region_pa, st, res);
+		IOLog("%s mem_setup: %llx/%llx\n", p->tag, st, res);
+		rc = TOPAZ_PAS_ESETUP;
+		goto shutdown;
+	}
+	IOLog("%s: init_image and mem_setup ok (%u ms), copying the segment\n", p->tag, ms_since(t0));
+	if (copy_segments(p, lo, &nseg, why, wl) != 0) {
+		rc = TOPAZ_PAS_ECOPY;
+		goto shutdown;
+	}
+	t0 = mach_absolute_time();
+	st = topaz_scm(SCM_FN(SCM_SVC_PIL, PIL_AUTH_RESET), 1, p->pas_id, 0, 0, &res);
+	IOLog("%s auth_and_reset: %llx/%llx (%u ms)\n", p->tag, st, res, ms_since(t0));
+	if (st == 0 && res == 0) {
+		return 0;
+	}
+	snprintf(why, wl, "TrustZone refused the %s: auth_and_reset %llx/%llx", p->name, st, res);
+	rc = TOPAZ_PAS_EAUTH;
+shutdown:
+	/* init_image passed and a later step failed (Linux pil_deinit_image_trusted) */
+	st = topaz_scm(SCM_FN(SCM_SVC_PIL, PIL_SHUTDOWN), 1, p->pas_id, 0, 0, &res);
+	IOLog("%s: PAS %u shutdown after the failure: %llx/%llx\n", p->tag, p->pas_id, st, res);
+	return rc;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
