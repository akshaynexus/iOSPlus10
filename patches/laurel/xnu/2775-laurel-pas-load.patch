+/*
+ * laurel 2775: one TrustZone peripheral-image loader (PAS) for the whole kernel, the sequence of Linux
+ * drivers/soc/qcom/subsys-pil-tz.c + peripheral_loader.c (4.14) and mainline mdt_loader.c / qcom_scm_pas_*:
+ *   PAS_IS_SUPPORTED -> PAS_INIT_IMAGE(metadata) -> PAS_MEM_SETUP(region, span) -> copy the loadable segments
+ *   -> PAS_AUTH_AND_RESET; PAS_SHUTDOWN only when init_image passed and a later step failed.
+ * Every call goes through topaz_scm() (TopazModem: one lock over the call and its resume loop, laurel 2404).
+ * The metadata (the whole .mdt: ELF header + program headers + hash) goes into the TopazModem pool (below
+ * 4 GiB, where TrustZone already read the ADSP and modem metadata); meta_alt gives another buffer when that
+ * pool is off. Users: the GPU zap shader (TopazAdreno.cpp, PAS 13) and the IPA firmware (laurel_ipa_fw.c,
+ * PAS 15). Relocatable images: segment N goes to region + (p_paddr - lowest p_paddr), as mdt_loader.
+ */
+#ifndef TOPAZ_PAS_H
+#define TOPAZ_PAS_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct topaz_pas {
+	const char *tag;                /* log prefix: "TopazGPU: zap", "LaurelIPA: fw" */
+	const char *name;               /* short name for the reason text: "zap", "IPA firmware" */
+	uint32_t pas_id;
+	const uint8_t *mdt;             /* the .mdt file (ELF32) */
+	size_t mdt_len;
+	uint64_t region_pa;             /* carve-out (DT reserved memory) */
+	uint32_t region_size;
+	void *ctx;
+	/*
+	 * Copy loadable segment idx (program header index; file .bNN) to dst, room bytes up to the end of the
+	 * region. The region is zeroed before (bss / memsz > filesz). 0, or an errno with the reason in why.
+	 */
+	int (*seg)(void *ctx, uint32_t idx, volatile uint8_t *dst, uint32_t room, char *why, size_t wl);
+	/* optional: a contiguous buffer below 4 GiB for the metadata when the modem pool is off; the log label */
+	const char *(*meta_alt)(void *ctx, size_t len, uint8_t **va, uint64_t *pa);
+};
+
+/* results: 0 = loaded and started */
+#define TOPAZ_PAS_ELAYOUT       (-1)    /* bad .mdt or the segments do not fit the region (no TrustZone call) */
+#define TOPAZ_PAS_EMETA         (-2)    /* no buffer for the metadata (no TrustZone call) */
+#define TOPAZ_PAS_ENOSUPPORT    (-3)    /* PAS_IS_SUPPORTED failed */
+#define TOPAZ_PAS_EINIT         (-4)    /* init_image refused (metadata / signature) */
+#define TOPAZ_PAS_ESETUP        (-5)    /* mem_setup refused */
+#define TOPAZ_PAS_ECOPY         (-6)    /* region map or segment copy failed */
+#define TOPAZ_PAS_EAUTH         (-7)    /* auth_and_reset refused */
+
+/* Load and start; the reason in why on a failure. Sleeps (SCM busy retry): thread context only. */
+int topaz_pas_load(const struct topaz_pas *p, char *why, size_t wl);
+
+/* lowest p_paddr and page-aligned end of the loadable segments of an ELF32 .mdt; false = none / bad */
+bool topaz_pas_span(const uint8_t *mdt, size_t len, uint32_t *lo, uint32_t *hi);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
