 /*
+ * laurel 2983: touch and keys from the USB command server (bsd/dev/sweet_usb.c, only from 192.168.7.1 on the USB link), for scripts/laurel/ios26-autotest.sh:
+ * "touch F D X Y" (finger, down 0|1, panel pixels), "key K D" (K as sweet_hid_key), "synth" (the answer says if it is on). The events take the same way as those of the
+ * touch IC, also the CPU and GPU clock answer to touch. The command server must not block: it only fills a ring, a thread call empties it. Kill switch laurelsynth=0.
+ */
+#define LAUREL_SYNTH_RING 64
+static struct laurel_synth_event {
+	int8_t kind, a, down;   /* kind: 0 touch, 1 key */
+	int16_t x, y;
+} laurel_synth_ring[LAUREL_SYNTH_RING];
+static volatile uint32_t laurel_synth_head, laurel_synth_tail;  /* one writer (the command server), one reader (the thread call) */
+static thread_call_t laurel_synth_call;
+static int laurel_synth_on = -1;
+extern "C" uint64_t laurel_touch_event_at;      /* bsd/dev/sweet_touch.c */
+extern "C" void sweet_hid_touch(int finger, int down, int x, int y);
+
+static void
+laurel_synth_drain(thread_call_param_t, thread_call_param_t)
+{
+	while (laurel_synth_tail != laurel_synth_head) {
+		const struct laurel_synth_event e = laurel_synth_ring[laurel_synth_tail % LAUREL_SYNTH_RING];
+		OSMemoryBarrier();
+		laurel_synth_tail = laurel_synth_tail + 1;
+		if (e.kind == 0) {
+			sweet_hid_touch(e.a, e.down, e.x, e.y);
+			laurel_touch_event_at = mach_absolute_time();
+		} else {
+			sweet_hid_key(e.a, e.down);
+		}
+	}
+}
+
+static const char *
+laurel_synth_init(void)
+{
+	if (laurel_synth_on >= 0) {
+		return NULL;
+	}
+	uint32_t want = 1;
+	if (PE_parse_boot_argn("laurelsynth", &want, sizeof(want)) && want == 0) {
+		laurel_synth_on = 0;
+		return "laurelsynth=0";
+	}
+	laurel_synth_call = thread_call_allocate_with_priority(laurel_synth_drain, NULL, THREAD_CALL_PRIORITY_HIGH);
+	if (laurel_synth_call == NULL) {
+		laurel_synth_on = 0;
+		return "no thread call";
+	}
+	laurel_synth_on = 1;
+	return NULL;
+}
+
+/* true = the word was for this file; reply holds the answer */
+extern "C" bool
+laurel_synth_ctl(const char *cmd, char *reply, size_t size)
+{
+	int a, b, x = 0, y = 0;
+	struct laurel_synth_event e = {};
+
+	if (strcmp(cmd, "synth") == 0) {
+		snprintf(reply, size, "synth %s", laurel_synth_on == 1 ? "on" : "off");
+		return true;
+	}
+	if (sscanf(cmd, "touch %d %d %d %d", &a, &b, &x, &y) == 4 && a >= 0 && a < SWEET_TOUCH_FINGERS && (b == 0 || b == 1) && x >= 0 && x < 8192 && y >= 0 && y < 8192) {
+		e.kind = 0;
+	} else if (sscanf(cmd, "key %d %d", &a, &b) == 2 && a >= 0 && a <= 3 && (b == 0 || b == 1)) {
+		e.kind = 1;
+	} else {
+		return false;
+	}
+	if (laurel_synth_on != 1) {
+		snprintf(reply, size, "error: synth off");
+		return true;
+	}
+	if (laurel_synth_head - laurel_synth_tail >= LAUREL_SYNTH_RING) {
+		snprintf(reply, size, "error: busy");
+		return true;
+	}
+	e.a = (int8_t)a;
+	e.down = (int8_t)b;
+	e.x = (int16_t)x;
+	e.y = (int16_t)y;
+	laurel_synth_ring[laurel_synth_head % LAUREL_SYNTH_RING] = e;
+	OSMemoryBarrier();
+	laurel_synth_head = laurel_synth_head + 1;
+	thread_call_enter(laurel_synth_call);
+	snprintf(reply, size, "ok");
+	return true;
+}
+
+/*
  * laurel 2200: SweetFramebuffer.cpp tells where the panel sits on the presented display:
  * logical = off + panel * num / den (num = den = 1: the panel 1:1 at an offset, the topaz/laurel crop).
  */
