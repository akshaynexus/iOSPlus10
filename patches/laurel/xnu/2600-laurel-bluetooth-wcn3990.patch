--- a/iokit/Kernel/arm/LaurelBluetooth.cpp	1970-01-01 05:30:00.000000000 +0530
+++ b/iokit/Kernel/arm/LaurelBluetooth.cpp	2026-11-01 05:15:56.552294417 +0530
@@ -0,0 +1,54 @@
+/*
+ * laurel_sprout (Mi A3, SM6125) Bluetooth (laurel 2600): the ADT "bluetooth" nub for iOS bluetoothd.
+ * scripts/laurel/mkadt.py adds /arm-io/bluetooth (local-mac-address, transport-encoding 3 = H4BC, transport-speed
+ * 3000000); SweetPlatformExpert publishes every /arm-io child as a nub, so bluetoothd (20H392) finds a registry
+ * entry named "bluetooth" and reads those properties (negroni 0332, docs/bluetooth-plan.md section 4).
+ *   laurel_bt_adt_publish(addr): local-mac-address = the address the chip uses (display order, 6 bytes).
+ *   laurel_bt_adt_hide(): Bluetooth off: the nub leaves the device-tree plane and is terminated, so bluetoothd
+ *     sees no Bluetooth ("No bluetooth on this device", exit 0, no restart) instead of a transport that fails.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IORegistryEntry.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <libkern/c++/OSData.h>
+
+#define BT_PATH     "/arm-io/bluetooth"
+
+extern "C" void laurel_bt_adt_publish(const uint8_t addr[6]);
+extern "C" void laurel_bt_adt_hide(void);
+
+extern "C" void
+laurel_bt_adt_publish(const uint8_t addr[6])
+{
+	IORegistryEntry *e = IORegistryEntry::fromPath(BT_PATH, gIODTPlane);
+
+	if (e == NULL) {
+		IOLog("LAUREL BT: adt: no IODeviceTree:%s (bluetoothd finds the transport by /dev only)\n", BT_PATH);
+		return;
+	}
+	OSData *d = OSData::withBytes(addr, 6);
+	if (d != NULL) {
+		e->setProperty("local-mac-address", d);
+		d->release();
+	}
+	e->release();
+}
+
+extern "C" void
+laurel_bt_adt_hide(void)
+{
+	IORegistryEntry *e = IORegistryEntry::fromPath(BT_PATH, gIODTPlane);
+
+	if (e == NULL) {
+		return;
+	}
+	IOService *s = OSDynamicCast(IOService, e);
+	e->detachAll(gIODTPlane);
+	if (s != NULL && !s->isInactive()) {
+		s->terminate();
+	}
+	e->release();
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
