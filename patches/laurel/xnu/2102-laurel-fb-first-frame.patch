laurel 2102: one line when the first iOS frame reaches the panel: 'LAUREL FB: first iOS frame on the panel: swap N, L layer(s), surface S WxH fmt F, direct|copy path, T s after boot' (direct = MDP path of a scanout surface, copy = composed into the back buffer).

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 9f802ad..8da3eb2 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -1447,6 +1447,38 @@ AppleCLCD::directPresent(const uint8_t *rec)
 	return ok;
 }
 
+/*
+ * laurel 2102: one line when the first iOS frame reaches the panel (the window server's swap, shown by the
+ * direct path or composed by the copy path), so the boot log tells "no surface", "no swap" and "shown"
+ * apart: "LAUREL FB: first iOS frame on the panel: swap N, L layer(s), surface S WxH fmt F, direct|copy
+ * path, T s after boot".
+ */
+static void
+laurel_fb_first_frame(const uint8_t *rec, const char *path)
+{
+	static bool told;
+	uint32_t mask = get32(rec, 0x104), layers = 0, sid = 0;
+
+	if (told) {
+		return;
+	}
+	told = true;
+	for (uint32_t i = 0; i < SWEET_FB_LAYERS; i++) {
+		uint32_t id = get32(rec, 0x54 + 4 * i);
+		if ((mask & (1u << i)) && id != 0) {
+			layers++;
+			sid = sid != 0 ? sid : id;
+		}
+	}
+	SweetSurface *s = sid != 0 ? sweet_surface_copy(sid) : NULL;
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	IOLog("LAUREL FB: first iOS frame on the panel: swap %u, %u layer(s), surface %u %ux%u fmt 0x%x, %s path, %llu s after boot\n",
+	    get32(rec, 0x50), layers, sid, s ? s->width : 0, s ? s->height : 0, s ? s->pixelFormat : 0, path,
+	    ns / 1000000000ull);
+	OSSafeReleaseNULL(s);
+}
+
 void
 AppleCLCD::present(const uint8_t *rec)
 {
@@ -1464,6 +1496,7 @@ AppleCLCD::present(const uint8_t *rec)
 	}
 	fConsShown = false;
 	if (directPresent(rec)) {
+		laurel_fb_first_frame(rec, "direct");   /* laurel 2102 */
 		if (!fConsolePaused) {
 			int quiet = 0;
 			fConsolePaused = true;
@@ -1576,6 +1609,7 @@ AppleCLCD::present(const uint8_t *rec)
 	if (fFlip[0] != NULL) {
 		flipBack();
 	}
+	laurel_fb_first_frame(rec, "copy");             /* laurel 2102 */
 }
 
