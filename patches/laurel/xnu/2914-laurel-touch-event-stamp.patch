 extern void sweet_hid_touch(int finger, int down, int x, int y);
 void sweet_touch_init(void);
+uint64_t laurel_touch_event_at;         /* laurel 2914: the last finger event not yet followed by a flip (2915 measures touch to panel) */
 
 /*
  * laurel 2200 (Mi A3): two touch vendors (laurel_sprout-trinket-touchscreen.dtsi), detected at the probe:
@@ -471,6 +472,7 @@
 		if (mask & bit) {
 			if (!(st.active & bit) || x[id] != st.x[id] || y[id] != st.y[id]) {
