+	/* laurel 2905: poll period and data transfers (negroni 0361/0366/0382) */
+	uint64_t    last_active;    /* mach time of the last frame, event or queued TX */
+	bool        ep_busy[6];     /* STARTTRANSFER issued, no XferComplete or ENDTRANSFER since */
+	uint32_t    ep_rsc[6];      /* its transfer resource index (ENDTRANSFER) */
 	/* command server (UDP 5141), used by ud_thread only */
 	bool        ctl_enabled;
