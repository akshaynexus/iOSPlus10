+			printf("LAUREL USB: no host yet (%llu s): DSTS 0x%08x link %u speed %u events %u%s, timer ticks %llu\n",
+			    (now - t0) / sec, dsts, (dsts >> 18) & 0xf, dsts & 7, ud.events, ud_early ? ", raw mode" : "", ud_tc_ticks);
+		} else if (ud.configured && now >= next_stat) {
