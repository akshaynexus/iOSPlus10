+		ud.ep_busy[ep] = true;          /* laurel 2905: for the ENDTRANSFER at a bus reset */
+		ud.ep_rsc[ep] = (dwc_rd(DEPCMD(ep)) >> 16) & 0x7f;
+	}
 }
 
