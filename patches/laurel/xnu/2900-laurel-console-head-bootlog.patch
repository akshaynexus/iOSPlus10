+/*
+ * Boot log (laurel 2900, port of negroni 0367, docs/laurel_sprout/usb-debug.md).
+ * The console ring of each boot goes into one slot of a reserved area at the
+ * end of userdata, so a boot that loses the USB link, hangs or resets can be
+ * read later: on the next boot over USB (op10tool bootlog), over SSH
+ * (/dev/laurelbootlog), or with a dd of userdata from any other system.
+ * On by default; it does not need ufsrw=1: ufs_log_write_blocks() writes
+ * only inside the area. Kill switch: laurelbootlog=0 (sweetlog=0 stops every
+ * console log write).
+ *
+ * The layout is the negroni one (op10tool bootlog reads both): area =
+ * NBL_AREA_BLOCKS device blocks at partition block N - 28673 (N = partition
+ * size in 4096-byte blocks; Mi A3 userdata: N = 28288256, HFS+ root image
+ * 16 GiB = 4194304 blocks), far behind the HFS+ volume and below the topaz
+ * area at N - 1025.
+ *   area block 0                      superblock (struct nbl_super, "NEGRBLOG")
+ *   area block 1 + i*NBL_SLOT_BLOCKS  slot i: header block (struct nbl_slot,
+ *                                     "NEGRBOOT"), then the 4 MiB console ring
+ * The rest of the area (1015 blocks) is reserved. The slot of a boot is the
+ * one after the slot with the highest boot counter. Self-check before any
+ * write: the HFS+ volume header (partition byte 1024) is read and the volume
+ * must end at or below the area. On negroni a second anchor (the WLAN area
+ * header) proves the layout; the Mi A3 has no such area, so the HFS+ end
+ * check alone opens the write gate (the area lies past the root volume,
+ * where nothing else writes).
+ *
+ * Flushes: every second in the first 5 min of uptime when the console has
+ * new text, then at most every 5 s (wear budget: more than 256 KiB in 10 s
+ * -> every 10 s for 20 s), else a header heartbeat every 30 s; each with
+ * SYNCHRONIZE CACHE. The panic path (laurel_bootlog_panic, from the platform
+ * expert before the USB panic hold) writes once more, polled, without the
+ * lock; halt, restart and the USB reset commands write the end state.
+ */
+#define NBL_AREA_BLOCKS     9216u                       /* 36 MiB */
+#define NBL_FROM_END        28673u                      /* negroni layout (op10tool bootlog FROM_END) */
+#define NBL_SLOTS           8u
+#define NBL_SLOT_BLOCKS     SWEET_LOG_BLOCKS            /* 1 header + 1024 ring blocks */
+#define NBL_VERSION         1u
+#define NBL_MIN_REL         16u
+#define NBL_HEARTBEAT_SECS  30u
+#define NBL_EARLY_SECS      300u
+#define NBL_LATE_SECS       5u
+#define NBL_BUDGET_BYTES    (256u << 10)
+#define NBL_BUDGET_SECS     10u
+#define NBL_SLOW_SECS       10u
+#define NBL_FLUSH_SECS      1u
+
+enum { NBL_RUNNING = 1, NBL_PANIC = 2, NBL_HALT = 3, NBL_RESTART = 4 };
+#define NBL_F_SPRINGBOARD   0x1u
+#define NBL_F_PANICLOG      0x2u
+
+struct nbl_super {
+	char magic[8];                  /* "NEGRBLOG" */
+	uint32_t version;               /* 1 */
+	uint32_t slots;                 /* 8 */
+	uint32_t slot_blocks;           /* 1025 */
+	uint32_t area_blocks;           /* 9216 */
+	uint32_t ring_size;             /* 4 MiB */
+	uint32_t from_end;              /* 28673: area start = partition end - from_end */
+	uint32_t crc;                   /* CRC-32 of the bytes before it */
+} __attribute__((packed));
+
+struct nbl_slot {
+	char magic[8];                  /*    0 "NEGRBOOT" */
+	uint32_t version;               /*    8 1 */
+	uint32_t hdr_size;              /*   12 sizeof(struct nbl_slot) */
+	uint64_t boot;                  /*   16 boot counter (1, 2, ...) */
+	uint32_t state;                 /*   24 NBL_RUNNING ... */
+	uint32_t flags;                 /*   28 NBL_F_* */
+	uint32_t ring_size;             /*   32 */
+	uint32_t flush_secs;            /*   36 */
+	uint64_t total;                 /*   40 console bytes of this boot */
+	uint64_t seq;                   /*   48 flush count */
+	uint64_t start_cal;             /*   56 calendar seconds at the slot start */
+	uint64_t last_cal;              /*   64 calendar seconds at the last flush (not updated in a panic) */
+	uint64_t last_up_ms;            /*   72 uptime at the last flush */
+	uint64_t sb_up_ms;              /*   80 uptime when SpringBoard ran (0: never) */
+	uint64_t end_up_ms;             /*   88 uptime of the end (panic/halt/restart) */
+	char uuid[40];                  /*   96 kernel UUID */
+	char kversion[256];             /*  136 kernel version string */
+	char bootargs[1024];            /*  392 */
+	char pon[256];                  /* 1416 PM6125 PON reasons at this power-on (why the boot before ended) */
+	char end[256];                  /* 1672 end text */
+	uint32_t crc;                   /* 1928 CRC-32 of bytes 0..1927 */
+} __attribute__((packed));
+_Static_assert(sizeof(struct nbl_slot) == 1932, "nbl_slot layout (op10tool bootlog)");
+_Static_assert(sizeof(struct nbl_super) == 36, "nbl_super layout (op10tool bootlog)");
+_Static_assert(1 + NBL_SLOTS * NBL_SLOT_BLOCKS == 8201 && 1 + NBL_SLOTS * NBL_SLOT_BLOCKS <= NBL_AREA_BLOCKS,
+    "boot log slots (op10tool bootlog)");
+
+static struct {
+	bool ok;                        /* area checked, slot chosen: the log runs */
+	volatile bool panic;            /* the panic path owns the host now */
+	bool running;                   /* the flush thread runs */
+	uint64_t lo;                    /* absolute device block of area block 0 */
+	uint64_t hfs_end;               /* HFS+ volume end, device blocks from the partition start */
+	uint32_t slot;
+	uint64_t flushed;               /* console bytes on the disk */
+	uint64_t last_write;            /* mach time of the last flush */
+	struct nbl_slot hdr;            /* this boot's header (under sweet_ufs_lock) */
+} nbl;
