+/*
+ * PM6125 PON reasons of this power-on (qpnp-power-on.c; GEN2 offsets 0xC0..
+ * when the PON subtype is >= 4, else GEN1 0x08..): they tell why the boot
+ * before this one ended. One line, raw values and the names of the set bits.
+ */
+static void
+nbl_pon_summary(char *buf, size_t size)
+{
+	static const char *const pon_names[8] = { "HARD_RESET", "SMPL", "RTC", "DC", "USB", "PON1", "CBL", "KPD" };
+	static const char *const off_names[16] = {
+		"SOFT", "PS_HOLD", "PMIC_WD", "GP1", "GP2", "KPDPWR_AND_RESIN", "RESIN_N", "KPDPWR_N",
+		NULL, NULL, NULL, "CHARGER", "TFT", "UVLO", "OTST3", "STAGE3",
+	};
+	static const char *const fault_names[16] = {
+		"GP_FAULT0", "GP_FAULT1", "GP_FAULT2", "GP_FAULT3", "MBG_FAULT", "OVLO", "UVLO", "AVDD_RB",
+		NULL, NULL, NULL, "FAULT_N", "PBS_WATCHDOG_TO", "PBS_NACK", "RESTART_PON", "OTST3",
+	};
+	uint8_t sub = 0, r[10] = { 0 };
+	char *o = buf;
+	size_t left = size;
+	int w;
+
+	buf[0] = 0;
+	if (sweet_spmi_init() != 0 || sweet_spmi_pon_read(0x805, &sub) != 0) {
+		snprintf(buf, size, "PON not readable");
+		return;
+	}
+	bool gen2 = sub >= 4;
+	/* 0 pon, 1 warm1, 2 warm2, 3 poff1, 4 poff2, 5 off, 6 fault1, 7 fault2, 8 s3 */
+	static const uint16_t g1[9] = { 0x808, 0x80a, 0x80b, 0x80c, 0x80d, 0, 0, 0, 0 };
+	static const uint16_t g2[9] = { 0x8c0, 0x8c2, 0x8c3, 0x8c5, 0x8c6, 0x8c7, 0x8c8, 0x8c9, 0x8ca };
+	for (int i = 0; i < 9; i++) {
+		uint16_t a = gen2 ? g2[i] : g1[i];
+		if (a != 0 && sweet_spmi_pon_read(a, &r[i]) != 0) {
+			snprintf(buf, size, "PON read of 0x%x failed", a);
+			return;
+		}
+	}
+#define NBL_SUM(...) do { w = snprintf(o, left, __VA_ARGS__); if (w > 0 && (size_t)w < left) { o += w; left -= (size_t)w; } } while (0)
+	NBL_SUM("gen%d pon=0x%02x", gen2 ? 2 : 1, r[0]);
+	bool first_pon = true;
+	for (int b = 0; b < 8; b++) {
+		if (r[0] & (1u << b)) {
+			NBL_SUM("%s%s", first_pon ? "(" : "|", pon_names[b]);
+			first_pon = false;
+		}
+	}
+	if (!first_pon) {
+		NBL_SUM(")");
+	}
+	uint16_t warm = (uint16_t)(r[1] | r[2] << 8), poff = (uint16_t)(r[3] | r[4] << 8);
+	uint16_t fault = (uint16_t)(r[6] | r[7] << 8);
+	const struct { const char *key; uint16_t v; const char *const *names; } f[3] = {
+		{ "warm", warm, off_names }, { "poff", poff, off_names }, { "fault", fault, fault_names },
+	};
+	for (int k = 0; k < 3; k++) {
+		if (k == 2 && !gen2) {
+			break;
+		}
+		NBL_SUM(" %s=0x%04x", f[k].key, f[k].v);
+		bool first = true;
+		for (int b = 0; b < 16; b++) {
+			if ((f[k].v & (1u << b)) && f[k].names[b] != NULL) {
+				NBL_SUM("%s%s", first ? "(" : "|", f[k].names[b]);
+				first = false;
+			}
+		}
+		if (!first) {
+			NBL_SUM(")");
+		}
+	}
+	if (gen2) {
+		NBL_SUM(" off=0x%02x s3=0x%02x", r[5], r[8]);
+	}
+#undef NBL_SUM
+}
+
+/*
+ * The ring from `flushed` to `total`, then this boot's header, then
+ * SYNCHRONIZE CACHE. With sweet_ufs_lock held, or in the panic path.
+ */
+static int
+nbl_write(uint64_t flushed, uint64_t total)
+{
+	uint64_t base = nbl_slot_base(nbl.slot);
+	void *bounce = (void *)(su.dma + DMA_BOUNCE);
+	uint64_t pos = total - flushed >= SWEET_LOG_SIZE ? total - SWEET_LOG_SIZE : flushed;
+	int error = 0;
+
+	while (pos < total && !error) {
+		uint32_t off = (uint32_t)(pos % SWEET_LOG_SIZE);
+		uint32_t blk = off / UFS_BLOCK;
+		uint64_t need = ((uint64_t)off % UFS_BLOCK + (total - pos) + UFS_BLOCK - 1) / UFS_BLOCK;
+		uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(SWEET_LOG_SIZE / UFS_BLOCK - blk)),
+		    (uint64_t)(BOUNCE_SIZE / UFS_BLOCK));
+		memcpy(bounce, sweet_log_ring + (uint64_t)blk * UFS_BLOCK, n * UFS_BLOCK);
+		error = ufs_log_write_blocks(base + 1 + blk, n);
+		pos += (uint64_t)(blk + n) * UFS_BLOCK - off;
+	}
+	if (!error) {
+		nbl.hdr.total = total;
+		nbl.hdr.seq++;
+		nbl.hdr.last_up_ms = nbl_uptime_ms();
+		if (!nbl.panic) {
+			clock_sec_t s;
+			clock_usec_t us;
+			clock_get_calendar_microtime(&s, &us);
+			nbl.hdr.last_cal = (uint64_t)s;
+		}
+		nbl.hdr.crc = nbl_crc32(&nbl.hdr, offsetof(struct nbl_slot, crc));
+		bzero(bounce, UFS_BLOCK);
+		memcpy(bounce, &nbl.hdr, sizeof(nbl.hdr));
+		error = ufs_log_write_blocks(base, 1);
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	nbl.last_write = mach_absolute_time();
+	return error;
+}
+
+/* SpringBoard marker: proc_iterate callback. */
+static int
+nbl_find_springboard(proc_t p, void *arg)
+{
+	char name[MAXCOMLEN + 1];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (strcmp(name, "SpringBoard") == 0) {
+		*(int *)arg = proc_pid(p);
+		return PROC_RETURNED_DONE;
+	}
+	return PROC_RETURNED;
+}
+
+static void
+nbl_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t heartbeat, sec, win_start = 0, win_bytes = 0, slow_until = 0;
+	bool first = true;
+
+	nanoseconds_to_absolutetime((uint64_t)NBL_HEARTBEAT_SECS * NSEC_PER_SEC, &heartbeat);
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sec);
+	nbl.running = true;
+	for (;;) {
+		(void)tsleep(&sweet_log_chan, PZERO, "laurelbootlog", hz * (int)NBL_FLUSH_SECS);
+		if (!(nbl.hdr.flags & NBL_F_SPRINGBOARD)) {
+			int pid = 0;
+			proc_iterate(PROC_ALLPROCLIST, nbl_find_springboard, &pid, NULL, NULL);
+			if (pid > 0) {
+				uint64_t ms = nbl_uptime_ms();
+				lck_mtx_lock(&sweet_ufs_lock);
+				nbl.hdr.flags |= NBL_F_SPRINGBOARD;
+				nbl.hdr.sb_up_ms = ms;
+				lck_mtx_unlock(&sweet_ufs_lock);
+				printf("LAUREL BOOTLOG: boot %llu reached SpringBoard (pid %d) %llu.%03llu s after start\n",
+				    nbl.hdr.boot, pid, ms / 1000, ms % 1000);
+			}
+		}
+		/*
+		 * Wear budget (negroni review F1): new text every second in the first
+		 * NBL_EARLY_SECS of uptime, then at most every NBL_LATE_SECS; more than
+		 * NBL_BUDGET_BYTES in NBL_BUDGET_SECS: every NBL_SLOW_SECS for 2 windows.
+		 * A quiet console: header only, every NBL_HEARTBEAT_SECS. The first
+		 * flush (the backlog since kernel start) does not count.
+		 */
+		uint64_t now = mach_absolute_time();
+		uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+		uint32_t every = NBL_FLUSH_SECS;
+		if (nbl_uptime_ms() >= (uint64_t)NBL_EARLY_SECS * 1000) {
+			every = NBL_LATE_SECS;
+		}
+		if (now < slow_until) {
+			every = NBL_SLOW_SECS;
+		}
+		uint64_t since = now - nbl.last_write;
+		if (total == nbl.flushed ? since < heartbeat : since < (uint64_t)every * sec) {
+			continue;
+		}
+		lck_mtx_lock(&sweet_ufs_lock);
+		uint64_t before = nbl.flushed;
+		int error = nbl.panic ? EBUSY : nbl_write(nbl.flushed, total);
+		if (!error) {
+			nbl.flushed = total;
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		if (!error && !first) {
+			if (now - win_start >= (uint64_t)NBL_BUDGET_SECS * sec) {
+				win_start = now;
+				win_bytes = 0;
+			}
+			win_bytes += total - before;
+			if (win_bytes > NBL_BUDGET_BYTES) {
+				if (now >= slow_until) {
+					printf("LAUREL BOOTLOG: %llu KiB in %u s: flushes every %u s for a while\n",
+					    win_bytes >> 10, NBL_BUDGET_SECS, NBL_SLOW_SECS);
+				}
+				slow_until = now + 2ull * NBL_BUDGET_SECS * sec;
+				win_bytes = 0;
+				win_start = now;
+			}
+		}
+		first = false;
+		if (error) {
+			/* as laurel 2010: keep the thread, complain at most 20 times */
+			static uint32_t fails;
+			if (fails < 20) {
+				fails++;
+				printf("LAUREL BOOTLOG: flush failed (%d) (%s); retry in %u s\n", error,
+				    fails < 20 ? "kept" : "last complaint", NBL_SLOW_SECS);
+			}
+			nbl.last_write = now + (uint64_t)NBL_SLOW_SECS * sec - (uint64_t)every * sec;
+		}
+	}
+}
+
+/*
+ * The panic path: wait (polled, at most 200 ms) for a command that the
+ * flush thread or the block device had in slot 0 when the other CPUs were
+ * stopped; clear the slot if it never completes.
+ */
+static void
+nbl_panic_take_host(void)
+{
+	uint64_t limit;
+	nanoseconds_to_absolutetime(200 * NSEC_PER_MSEC, &limit);
+	uint64_t end = mach_absolute_time() + limit;
+	while ((ufs_rd(REG_UTRLDBR) & 1) && mach_absolute_time() < end) {
+	}
+	if (ufs_rd(REG_UTRLDBR) & 1) {
+		ufs_wr(REG_UTRLCLR, ~1u);
+		ufs_spin_us(1000);
+	}
+	ufs_wr(REG_IS, ufs_rd(REG_IS));
+}
+
+/*
+ * negroni review F5: the panic path uses the host only if sweet_ufs_lock is
+ * free (tried once; it stays taken, the system does not run on), or if it is
+ * held while root writes are off (no ufsrw=1). A holder on a CPU that was
+ * not stopped could be in the middle of a root write with the shared bounce
+ * buffer: then no panic write (the USB panic mode still sends the log).
+ */
+static bool
+nbl_panic_enter(void)
+{
+	static int result = -1;
+
+	if (result >= 0) {
+		return result == 1;
+	}
+	if (!lck_mtx_try_lock(&sweet_ufs_lock) && su.writable) {
+		kdb_printf("LAUREL BOOTLOG: UFS busy at the panic (ufsrw=1): no panic write to the disk\n");
+		result = 0;
+		return false;
+	}
+	nbl.panic = true;
+	ufs_polled_only = true;
+	nbl_panic_take_host();
+	result = 1;
+	return true;
+}
+
+/* The last "panic(" line of the console ring (the panic string) into dst. */
+static void
+nbl_panic_line(char *dst, size_t size)
+{
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	uint64_t from = total > (256u << 10) ? total - (256u << 10) : 0, hit = UINT64_MAX;
+	static const char pat[] = "panic(";
+
+	for (uint64_t p = from; p + sizeof(pat) - 1 <= total; p++) {
+		uint32_t k = 0;
+		while (k < sizeof(pat) - 1 && sweet_log_ring[(p + k) % SWEET_LOG_SIZE] == pat[k]) {
+			k++;
+		}
+		if (k == sizeof(pat) - 1) {
+			hit = p;
+		}
+	}
+	size_t n = 0;
+	if (hit == UINT64_MAX) {
+		strlcpy(dst, "panic (no panic( line in the console ring)", size);
+		return;
+	}
+	for (uint64_t p = hit; p < total && n + 1 < size; p++) {
+		char c = sweet_log_ring[p % SWEET_LOG_SIZE];
+		if (c == '\n' || c == 0) {
+			break;
+		}
+		dst[n++] = (c >= 0x20 && c < 0x7f) ? c : '?';
+	}
+	dst[n] = 0;
+}
+
+/*
+ * From the platform expert at kPEPanicDiagnosticsDone, before the USB panic
+ * hold: the ring plus a panic header into this boot's slot. Interrupts are
+ * off and the other CPUs are stopped: no lock wait, polled commands.
+ */
+void laurel_bootlog_panic(void);
+
+void
+laurel_bootlog_panic(void)
+{
+	static bool done;
+
+	if (done || !nbl.ok || !su.ready) {
+		return;
+	}
+	done = true;
+	if (!nbl_panic_enter()) {
+		return;
+	}
+	nbl.hdr.state = NBL_PANIC;
+	nbl.hdr.flags |= NBL_F_PANICLOG;
+	nbl.hdr.end_up_ms = nbl_uptime_ms();
+	nbl_panic_line(nbl.hdr.end, sizeof(nbl.hdr.end));
+	int error = nbl_write(nbl.flushed, os_atomic_load(&sweet_log_total, relaxed));
+	kdb_printf("LAUREL BOOTLOG: panic log of boot %llu written to slot %u: %s\n", nbl.hdr.boot, nbl.slot,
+	    error ? "FAILED" : "ok");
+}
+
+/*
+ * The end of this boot: kind NBL_HALT (3) or NBL_RESTART (4), why = a short
+ * text. From the halt/restart path (SweetPlatformExpert.cpp) and the USB
+ * reset/power off commands (sweet_usb.c). Never from interrupt context; with
+ * preemption or interrupts off the lock is only tried (200 ms).
+ */
+void laurel_bootlog_end(unsigned kind, const char *why);
+
+void
+laurel_bootlog_end(unsigned kind, const char *why)
+{
+	bool locked = false;
+
+	if (!nbl.ok || !su.ready || nbl.panic || ml_at_interrupt_context()) {
+		return;
+	}
+	if (preemption_enabled() && ml_get_interrupts_enabled()) {
+		lck_mtx_lock(&sweet_ufs_lock);
+		locked = true;
+	} else {
+		uint64_t limit;
+		nanoseconds_to_absolutetime(200 * NSEC_PER_MSEC, &limit);
+		uint64_t end = mach_absolute_time() + limit;
+		while (!(locked = lck_mtx_try_lock(&sweet_ufs_lock)) && mach_absolute_time() < end) {
+		}
+		if (!locked) {
+			return;
+		}
+	}
+	nbl.hdr.state = kind == NBL_HALT ? NBL_HALT : NBL_RESTART;
+	strlcpy(nbl.hdr.end, why, sizeof(nbl.hdr.end));
+	nbl.hdr.end_up_ms = nbl_uptime_ms();
+	printf("LAUREL BOOTLOG: boot %llu ends: %s (%s)\n", nbl.hdr.boot, nbl_state_name(nbl.hdr.state), why);
+	uint64_t total = os_atomic_load(&sweet_log_total, relaxed);
+	if (nbl_write(nbl.flushed, total) == 0) {
+		nbl.flushed = total;
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
+
+/* Area blocks [blk, blk + count) into dst (count <= 4). 0 or an errno. Thread context. */
+int laurel_bootlog_read(uint32_t blk, uint32_t count, void *dst);
+
+int
+laurel_bootlog_read(uint32_t blk, uint32_t count, void *dst)
+{
+	if (!nbl.ok || count == 0 || count > 4 || blk >= NBL_AREA_BLOCKS || count > NBL_AREA_BLOCKS - blk) {
+		return EINVAL;
+	}
+	if (nbl.panic || ml_at_interrupt_context()) {
+		return EBUSY;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	int error = ufs_read_blocks(nbl.lo + blk, count);
+	if (!error) {
+		memcpy(dst, (const void *)(su.dma + DMA_BOUNCE), count * UFS_BLOCK);
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
+
+/* One line for the USB "bootlog" command (keys as negroni: op10tool bootlog parses boot and slot). */
+void laurel_bootlog_info(char *buf, size_t size);
+
+void
+laurel_bootlog_info(char *buf, size_t size)
+{
+	if (!nbl.ok) {
+		snprintf(buf, size, "error: no boot log on this boot (see the LAUREL BOOTLOG line)");
+		return;
+	}
+	snprintf(buf, size, "bootlog v%u area %llu blocks %u slots %u slotblocks %u boot %llu slot %u state %s "
+	    "secs %u hfsend %llu running %d",
+	    NBL_VERSION, nbl.lo - su.first_block, NBL_AREA_BLOCKS, NBL_SLOTS, NBL_SLOT_BLOCKS, nbl.hdr.boot,
+	    nbl.slot, nbl_state_name(nbl.hdr.state), NBL_FLUSH_SECS, nbl.hfs_end, nbl.running ? 1 : 0);
+}
+
+/* /dev/laurelbootlog: the area as a read-only file (root only), for dd over SSH. */
+static int
+nbl_dev_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	if (flags & FWRITE) {
+		return EPERM;
+	}
+	return nbl.ok ? 0 : ENXIO;
+}
+
+static int
+nbl_dev_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static int
+nbl_dev_read(__unused dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	uint8_t *buf = kalloc_data(UFS_BLOCK, Z_WAITOK);
+	int error = 0;
+
+	if (buf == NULL) {
+		return ENOMEM;
+	}
+	while (uio_resid(uio) > 0 && !error) {
+		off_t off = uio_offset(uio);
+		if (off < 0) {
+			error = EINVAL;
+			break;
+		}
+		if (off >= (off_t)NBL_AREA_BLOCKS * UFS_BLOCK) {
+			break;
+		}
+		uint32_t in = (uint32_t)(off % UFS_BLOCK);
+		error = laurel_bootlog_read((uint32_t)(off / UFS_BLOCK), 1, buf);
+		if (!error) {
+			error = uiomove((const char *)buf + in, (int)MIN((user_ssize_t)(UFS_BLOCK - in), uio_resid(uio)), uio);
+		}
+	}
+	kfree_data(buf, UFS_BLOCK);
+	return error;
+}
+
+static const struct cdevsw nbl_cdevsw = {
+	.d_open = nbl_dev_open, .d_close = nbl_dev_close, .d_read = nbl_dev_read,
+	.d_write = eno_rdwrt, .d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset,
+	.d_ttys = NULL, .d_select = eno_select, .d_mmap = eno_mmap, .d_strategy = eno_strat,
+	.d_reserved_1 = eno_getc, .d_reserved_2 = eno_putc, .d_type = 0,
+};
+
+/*
+ * HFS+ / HFSX volume end in device blocks from the partition start. vh = the
+ * volume header (partition byte 1024): signature at 0 ("H+" / "HX"), block
+ * size at 40, total blocks at 44, big endian. 0 = ok, -1 = not HFS+.
+ */
+static int
+nbl_hfs_end(const uint8_t *vh, uint64_t *end)
+{
+	uint32_t sig = (uint32_t)vh[0] << 8 | vh[1];
+	uint32_t bsize = (uint32_t)vh[40] << 24 | (uint32_t)vh[41] << 16 | (uint32_t)vh[42] << 8 | vh[43];
+	uint32_t nblk = (uint32_t)vh[44] << 24 | (uint32_t)vh[45] << 16 | (uint32_t)vh[46] << 8 | vh[47];
+	if ((sig != 0x482b && sig != 0x4858) || bsize < 512 || (bsize & (bsize - 1)) != 0 || nblk == 0) {
+		return -1;
+	}
+	*end = ((uint64_t)bsize * nblk + UFS_BLOCK - 1) / UFS_BLOCK;
+	return 0;
+}
+
+/*
+ * Checks the area and picks this boot's slot (with sweet_ufs_lock held). The
+ * write gate (ufs_log_lo/hi) opens only after the HFS+ check; the caller
+ * closes it again on any error.
+ */
+static int
+nbl_setup_locked(void)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	static struct nbl_slot prev[NBL_SLOTS];
+	bool valid[NBL_SLOTS] = { false };
+	int error;
+
+	if (su.nblocks < (uint64_t)NBL_FROM_END + NBL_MIN_REL) {
+		printf("LAUREL BOOTLOG: off: partition too small (%llu blocks)\n", su.nblocks);
+		return ENOSPC;
+	}
+	uint64_t rel = su.nblocks - NBL_FROM_END;
+	if ((error = ufs_read_blocks(su.first_block, 1)) != 0) {
+		printf("LAUREL BOOTLOG: off: partition block 0 not readable (%d)\n", error);
+		return error;
+	}
+	if (nbl_hfs_end(b + 1024, &nbl.hfs_end) != 0) {
+		printf("LAUREL BOOTLOG: off: no HFS+ volume header at the partition start (sig %#x)\n",
+		    (unsigned)(b[1024] << 8 | b[1025]));
+		return ENOENT;
+	}
+	if (nbl.hfs_end > rel) {
+		printf("LAUREL BOOTLOG: off: HFS+ volume ends at block %llu, past the area at block %llu\n",
+		    nbl.hfs_end, rel);
+		return EEXIST;
+	}
+	nbl.lo = su.first_block + rel;
+
+	struct nbl_super sb = {
+		.magic = { 'N', 'E', 'G', 'R', 'B', 'L', 'O', 'G' }, .version = NBL_VERSION, .slots = NBL_SLOTS,
+		.slot_blocks = NBL_SLOT_BLOCKS, .area_blocks = NBL_AREA_BLOCKS, .ring_size = SWEET_LOG_SIZE,
+		.from_end = NBL_FROM_END,
+	};
+	sb.crc = nbl_crc32(&sb, offsetof(struct nbl_super, crc));
+	if ((error = ufs_read_blocks(nbl.lo, 1)) != 0) {
+		printf("LAUREL BOOTLOG: off: area block 0 not readable (%d)\n", error);
+		return error;
+	}
+	bool fresh = memcmp(b, &sb, sizeof(sb)) != 0;
+
+	/* the check passed: open the write gate for the area only */
+	ufs_log_lo = nbl.lo;
+	ufs_log_hi = nbl.lo + NBL_AREA_BLOCKS;
+	if (fresh) {
+		/* new superblock, and all 8 slot headers zeroed (no stale header from older contents) */
+		bzero((void *)(su.dma + DMA_BOUNCE), UFS_BLOCK);
+		for (uint32_t i = 0; i < NBL_SLOTS && !error; i++) {
+			error = ufs_log_write_blocks(nbl_slot_base(i), 1);
+		}
+		if (!error) {
+			memcpy((void *)(su.dma + DMA_BOUNCE), &sb, sizeof(sb));
+			error = ufs_log_write_blocks(nbl.lo, 1);
+		}
+		if (error) {
+			printf("LAUREL BOOTLOG: off: superblock write failed (%d)\n", error);
+			return error;
+		}
+	}
+
+	uint64_t max_boot = 0;
+	uint32_t max_slot = NBL_SLOTS - 1;
+	for (uint32_t i = 0; i < NBL_SLOTS && !fresh; i++) {
+		if ((error = ufs_read_blocks(nbl_slot_base(i), 1)) != 0) {
+			printf("LAUREL BOOTLOG: off: slot %u header not readable (%d)\n", i, error);
+			return error;
+		}
+		memcpy(&prev[i], b, sizeof(prev[i]));
+		valid[i] = nbl_slot_valid(&prev[i]);
+		/* the strings come from the disk: terminate them before any printf */
+		prev[i].uuid[sizeof(prev[i].uuid) - 1] = 0;
+		prev[i].kversion[sizeof(prev[i].kversion) - 1] = 0;
+		prev[i].bootargs[sizeof(prev[i].bootargs) - 1] = 0;
+		prev[i].pon[sizeof(prev[i].pon) - 1] = 0;
+		prev[i].end[sizeof(prev[i].end) - 1] = 0;
+		if (valid[i] && prev[i].boot > max_boot) {
+			max_boot = prev[i].boot;
+			max_slot = i;
+		}
+	}
+	nbl.slot = (max_slot + 1) % NBL_SLOTS;
+
+	bzero(&nbl.hdr, sizeof(nbl.hdr));
+	memcpy(nbl.hdr.magic, "NEGRBOOT", 8);
+	nbl.hdr.version = NBL_VERSION;
+	nbl.hdr.hdr_size = sizeof(nbl.hdr);
+	nbl.hdr.boot = max_boot + 1;
+	nbl.hdr.state = NBL_RUNNING;
+	nbl.hdr.ring_size = SWEET_LOG_SIZE;
+	nbl.hdr.flush_secs = NBL_FLUSH_SECS;
+	clock_sec_t s;
+	clock_usec_t us;
+	clock_get_calendar_microtime(&s, &us);
+	nbl.hdr.start_cal = nbl.hdr.last_cal = (uint64_t)s;
+	strlcpy(nbl.hdr.uuid, kernel_uuid_string, sizeof(nbl.hdr.uuid));
+	strlcpy(nbl.hdr.kversion, version, sizeof(nbl.hdr.kversion));
+	strlcpy(nbl.hdr.bootargs, PE_boot_args(), sizeof(nbl.hdr.bootargs));
+	nbl_pon_summary(nbl.hdr.pon, sizeof(nbl.hdr.pon));
+	nbl.ok = true;
+
