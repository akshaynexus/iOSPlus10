+extern char kernel_uuid_string[];
+/* version[]: <sys/systm.h> */
+extern int kdb_printf(const char *format, ...) __printflike(1, 2);
+
+/* CRC-32 (IEEE 802.3, the zlib / crc32fast value). */
+static uint32_t
+nbl_crc32(const void *buf, size_t n)
+{
+	const uint8_t *b = (const uint8_t *)buf;
+	uint32_t c = 0xffffffffu;
+	while (n--) {
+		c ^= *b++;
+		for (int k = 0; k < 8; k++) {
+			c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1u)));
+		}
+	}
+	return ~c;
+}
+
+static uint64_t
+nbl_uptime_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+static uint64_t
+nbl_slot_base(uint32_t slot)
+{
+	return nbl.lo + 1 + (uint64_t)slot * NBL_SLOT_BLOCKS;
+}
+
+static bool
+nbl_slot_valid(const struct nbl_slot *h)
+{
+	return memcmp(h->magic, "NEGRBOOT", 8) == 0 && h->version == NBL_VERSION &&
+	       h->hdr_size == sizeof(*h) && h->crc == nbl_crc32(h, offsetof(struct nbl_slot, crc));
+}
+
+static const char *
+nbl_state_name(uint32_t state)
+{
+	switch (state) {
+	case NBL_RUNNING: return "running";
+	case NBL_PANIC:   return "panic";
+	case NBL_HALT:    return "halt";
+	case NBL_RESTART: return "restart";
+	default:          return "?";
+	}
+}
