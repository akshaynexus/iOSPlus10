laurel 2997: LAUREL TOUCH FAST: a touch sample every 4 ms at priority 92 (HakiOS 66b8e63, Scion 357b437); both kernels. docs/laurel_sprout/ios26-touch.md.

Before: the touch thread polled every 10 ms at the default priority (31). 10 ms beats against the 16.7 ms frame: some frames got two samples
and some one, and a dragged page moved unevenly [V HakiOS touch_lat=1: a quarter of the frames a refresh late at 8 ms]. 4 ms: a sample in
every frame; 250 reads a second keep the 400 kHz bus under 35 % busy. Priority 92, as the display's presenter: the read happens when its
4 ms come. The IRQ latch of 2200 is unchanged. Kill switch laureltouchfast=0: 10 ms, the default priority. One line.

diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 9a05f0d..21d9577 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -152,6 +152,9 @@ touch_wr(vm_offset_t base, uint32_t off, uint32_t val)
 	__asm__ volatile("dsb osh" ::: "memory");
 }
 
+static unsigned touch_poll_ms = 10;     /* laurel 2997 */
+extern kern_return_t kernel_thread_start_priority(thread_continue_t continuation, void *parameter, integer_t priority, thread_t *new_thread);
+
 static void
 touch_wait(unsigned ms)
 {
@@ -922,7 +925,7 @@ touch_thread(void *arg, wait_result_t result)
 				errors = 0;
 			}
 		}
-		touch_wait(10);
+		touch_wait(touch_poll_ms);      /* laurel 2997 */
 	}
 	touch_report(0, st.x, st.y);
 out:
@@ -954,7 +957,19 @@ sweet_touch_init(void)
 		printf("SWEET TOUCH: disabled (sweettouch=0)\n");
 		return;
 	}
-	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
+	/*
+	 * laurel 2997 (HakiOS 66b8e63, Scion 357b437): a sample every 4 ms at priority 92. Before: every 10 ms at the default priority (31).
+	 * 10 ms beats against the 16.7 ms frame: some frames got two samples and some one, and a page dragged by the finger moved unevenly;
+	 * 4 ms puts a sample in every frame (4 per frame, 250 reads a second: one 16-byte read of the 400 kHz bus is under 0.5 ms, 63 bytes 1.4 ms,
+	 * so the bus stays under 35 % busy; 8 ms would still beat, 2 then 1 sample a frame). Priority 92 (BASEPRI_PREEMPT, as the display's
+	 * presenter): the sample is read when its 4 ms come, not after the UI's own threads. Kill switch laureltouchfast=0: 10 ms, priority 31.
+	 */
+	uint32_t fast = 1;
+	(void)PE_parse_boot_argn("laureltouchfast", &fast, sizeof(fast));
+	touch_poll_ms = fast ? 4 : 10;
+	printf("LAUREL TOUCH FAST: %s: a sample every %u ms at priority %d (kill switch laureltouchfast=0: 10 ms, the default priority)\n",
+	    fast ? "on" : "off", touch_poll_ms, fast ? 92 : 31);
+	kern_return_t kr = fast ? kernel_thread_start_priority(touch_thread, NULL, 92, &thread) : kernel_thread_start(touch_thread, NULL, &thread);
 	if (kr == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	} else {
