+/* delay() waits with WFE (or blocks the thread); in panic mode spin on the counter instead. */
+static void
+ud_udelay(uint32_t us)
+{
+	if (!ud_in_panic) {
+		delay(us);
+		return;
+	}
+	uint64_t abs;
+	nanoseconds_to_absolutetime((uint64_t)us * NSEC_PER_USEC, &abs);
+	uint64_t end = mach_absolute_time() + abs;
+	while (mach_absolute_time() < end) {
+	}
+}
