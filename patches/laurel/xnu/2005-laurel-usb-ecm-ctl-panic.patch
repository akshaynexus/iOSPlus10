+/*
+ * Command server on 192.168.7.2:5141 (UDP), in the receive path above (port
+ * of negroni 0210/0360): a frame for this port is handled here and never
+ * reaches the network stack, so the commands need no socket or userland
+ * and still work while either hangs, as long as ud_thread runs. Only
+ * unfragmented IPv4/UDP from 192.168.7.1 to 192.168.7.2 is accepted. One
+ * ASCII command per datagram (trailing white space ignored), each logged
+ * as "LAUREL CTL:":
+ *   ping        reply "pong"
+ *   log         the live log sends the last 64 KiB of the console again
+ *   reboot      IMEM reason normal, PSCI SYSTEM_RESET (laurel_reboot.c)
+ *   bootloader  IMEM reason bootloader (ABL fastboot), then the reset
+ *   recovery    IMEM reason recovery, then the reset
+ *   poweroff    PSCI SYSTEM_OFF
+ *   panic       panic("requested over USB"), so the panic path runs
+ * The resets reply "ok <command>" and act UD_CTL_DELAY_MS later, so the
+ * reply and the console log still reach the host. Replies go straight
+ * back to the sender's MAC and port (no ARP, no socket). Boot-arg
+ * laurelctl=0 disables the server. Host side: op10tool ctl <command>.
+ */
+#define UD_CTL_PORT     5141
+#define UD_LOG_PORT     5140
+#define UD_IP_PHONE     0xc0a80702u     /* 192.168.7.2 */
+#define UD_IP_HOST      0xc0a80701u     /* 192.168.7.1 */
+#define UD_CTL_DELAY_MS 500
+
+enum { UD_CTL_NONE = 0, UD_CTL_RESET, UD_CTL_PANIC, UD_CTL_POWEROFF };
+
+static const struct {
+	const char *name;
+	const char *mode;           /* kern.laurel_reboot_mode value */
+} ud_ctl_resets[] = {
+	{ "reboot", "normal" },
+	{ "recovery", "recovery" },
+	{ "bootloader", "bootloader" },
+};
+
+static uint16_t
+ud_be16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] << 8 | p[1]);
+}
+
+static uint32_t
+ud_be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static void
+ud_put16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)(v >> 8);
+	p[1] = (uint8_t)v;
+}
+
+static void
+ud_put32(uint8_t *p, uint32_t v)
+{
+	ud_put16(p, (uint16_t)(v >> 16));
+	ud_put16(p + 2, (uint16_t)v);
+}
+
+/* Internet checksum (RFC 1071): add 16-bit big-endian words, an odd last byte padded with 0. */
+static uint32_t
+ud_sum_add(uint32_t sum, const uint8_t *p, unsigned len)
+{
+	for (unsigned i = 0; i < len; i += 2) {
+		sum += (uint32_t)p[i] << 8 | (i + 1 < len ? p[i + 1] : 0u);
+	}
+	return sum;
+}
+
+static uint16_t
+ud_sum_fold(uint32_t sum)
+{
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return (uint16_t)~sum;
+}
+
+/*
+ * Ethernet + IPv4 + UDP frame from 192.168.7.2:sport into f; returns the
+ * frame length. data may already be at f + 42 (the panic path builds in
+ * the TX buffer): then it is not copied.
+ */
+static uint32_t
+ud_udp_build(uint8_t *f, const uint8_t *dst_mac, const uint8_t *dst_ip, uint16_t sport, uint16_t dport,
+    const void *data, uint32_t n)
+{
+	uint32_t len = ETHER_HDR_LEN + 20 + 8 + n;
+
+	bzero(f, ETHER_HDR_LEN + 20 + 8);
+	memcpy(f, dst_mac, ETHER_ADDR_LEN);
+	memcpy(f + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+	ud_put16(f + 12, ETHERTYPE_IP);
+	uint8_t *ip = f + ETHER_HDR_LEN;
+	ip[0] = 0x45;                   /* IPv4, 20-byte header */
+	ud_put16(ip + 2, (uint16_t)(20 + 8 + n));
+	ud_put16(ip + 4, ud.ctl_ip_id++);
+	ud_put16(ip + 6, 0x4000);       /* don't fragment */
+	ip[8] = 64;                     /* TTL */
+	ip[9] = IPPROTO_UDP;
+	ud_put32(ip + 12, UD_IP_PHONE);
+	memcpy(ip + 16, dst_ip, 4);
+	ud_put16(ip + 10, ud_sum_fold(ud_sum_add(0, ip, 20)));
+	uint8_t *udp = ip + 20;
+	ud_put16(udp, sport);
+	ud_put16(udp + 2, dport);
+	ud_put16(udp + 4, (uint16_t)(8 + n));
+	if (data != udp + 8) {
+		memcpy(udp + 8, data, n);
+	}
+	/* UDP checksum over the pseudo header (addresses, protocol, length) and the datagram */
+	uint32_t sum = ud_sum_add(0, ip + 12, 8) + IPPROTO_UDP + 8 + n;
+	uint16_t csum = ud_sum_fold(ud_sum_add(sum, udp, 8 + n));
+	ud_put16(udp + 6, csum ? csum : 0xffff);
+	return len;
+}
+
+/* UDP datagram from 192.168.7.2:5141 back to the sender of req (a frame ud_ctl_input accepted). */
+static void
+ud_ctl_reply(const uint8_t *req, const char *text)
+{
+	const uint8_t *rip = req + ETHER_HDR_LEN;
+	const uint8_t *rudp = rip + (rip[0] & 0xfu) * 4;
+	uint32_t n = (uint32_t)strlen(text);
+	uint32_t len = ETHER_HDR_LEN + 20 + 8 + n;
+	mbuf_t m = NULL;
+
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    !(mbuf_flags(m) & MBUF_EXT) || mbuf_maxlen(m) < len) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		printf("LAUREL CTL: no mbuf for the reply\n");
+		return;
+	}
+	(void)ud_udp_build(mbuf_data(m), req + ETHER_ADDR_LEN, rip + 12, UD_CTL_PORT, ud_be16(rudp), text, n);
+	mbuf_setlen(m, len);
+	mbuf_pkthdr_setlen(m, len);
+	(void)ud_if_output(ud.ifp, m);
+}
+
+static void
+ud_ctl_schedule(int action)
+{
+	clock_interval_to_deadline(UD_CTL_DELAY_MS, NSEC_PER_MSEC, &ud.ctl_deadline);
+	ud.ctl_action = action;
+}
+
+/* The UDP payload of an accepted 5141 datagram as a clean command word in cmd. true = usable. */
+static bool
+ud_ctl_word(const uint8_t *udp, uint32_t ulen, char *cmd, size_t size)
+{
+	uint32_t n = ulen - 8;
+	const uint8_t *p = udp + 8;
+	while (n > 0 && (p[n - 1] == '\n' || p[n - 1] == '\r' || p[n - 1] == ' ' ||
+	    p[n - 1] == '\t' || p[n - 1] == 0)) {
+		n--;
+	}
+	if (n >= size) {
+		cmd[0] = 0;
+		return false;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		cmd[i] = (p[i] >= 0x20 && p[i] < 0x7f) ? (char)p[i] : '?';
+	}
+	cmd[n] = 0;
+	return true;
+}
+
+/* One received frame (Ethernet header first). true = it was for the command server. */
+static bool
+ud_ctl_input(const uint8_t *f, uint32_t len)
+{
+	char cmd[32], reply[80];
+
+	if (!ud.ctl_enabled || len < ETHER_HDR_LEN + 20 + 8 || ud_be16(f + 12) != ETHERTYPE_IP) {
+		return false;
+	}
+	const uint8_t *ip = f + ETHER_HDR_LEN;
+	uint32_t ihl = (ip[0] & 0xfu) * 4, tot = ud_be16(ip + 2);
+	if ((ip[0] >> 4) != 4 || ihl < 20 || ip[9] != IPPROTO_UDP || tot < ihl + 8 ||
+	    ETHER_HDR_LEN + tot > len || (ud_be16(ip + 6) & 0x3fff) != 0) {
+		return false;           /* not one whole IPv4/UDP datagram: for the stack */
+	}
+	const uint8_t *udp = ip + ihl;
+	if (ud_be32(ip + 16) != UD_IP_PHONE || ud_be16(udp + 2) != UD_CTL_PORT) {
+		return false;
+	}
+	/* From here on the frame is the command server's: it never reaches the stack. */
+	if (ud_be32(ip + 12) != UD_IP_HOST) {
+		printf("LAUREL CTL: datagram from %u.%u.%u.%u ignored (only 192.168.7.1)\n",
+		    ip[12], ip[13], ip[14], ip[15]);
+		return true;
+	}
+	uint32_t ulen = ud_be16(udp + 4);
+	if (ud_sum_fold(ud_sum_add(0, ip, ihl)) != 0 || ulen < 8 || ulen > tot - ihl) {
+		printf("LAUREL CTL: malformed datagram ignored\n");
+		return true;
+	}
+	if (!ud_ctl_word(udp, ulen, cmd, sizeof(cmd))) {
+		printf("LAUREL CTL: %u-byte command ignored\n", ulen - 8);
+		ud_ctl_reply(f, "error: unknown command");
+		return true;
+	}
+	printf("LAUREL CTL: \"%s\" from 192.168.7.1:%u\n", cmd, ud_be16(udp));
+
+	if (strcmp(cmd, "ping") == 0) {
+		ud_ctl_reply(f, "pong");
+		return true;
+	}
+	if (strcmp(cmd, "log") == 0) {
+		ud_log_rewind = true;
+		ud_ctl_reply(f, "ok log");
+		return true;
+	}
+	if (ud.ctl_action != UD_CTL_NONE) {
+		printf("LAUREL CTL: busy (a reset or panic is pending)\n");
+		ud_ctl_reply(f, "error: busy");
+		return true;
+	}
+	if (strcmp(cmd, "panic") == 0) {
+		printf("LAUREL CTL: panic in %u ms\n", UD_CTL_DELAY_MS);
+		ud_ctl_reply(f, "ok panic");
+		ud_ctl_schedule(UD_CTL_PANIC);
+		return true;
+	}
+	if (strcmp(cmd, "poweroff") == 0) {
+		printf("LAUREL CTL: power off in %u ms\n", UD_CTL_DELAY_MS);
+		ud_ctl_reply(f, "ok poweroff");
+		ud_ctl_schedule(UD_CTL_POWEROFF);
+		return true;
+	}
+	for (unsigned i = 0; i < sizeof(ud_ctl_resets) / sizeof(ud_ctl_resets[0]); i++) {
+		if (strcmp(cmd, ud_ctl_resets[i].name) != 0) {
+			continue;
+		}
+		bool set = laurel_reboot_set_mode(ud_ctl_resets[i].mode) == 0;
+		snprintf(reply, sizeof(reply), "ok %s%s", cmd, set ? "" : " (reason not set: plain reset)");
+		printf("LAUREL CTL: %s: mode %s %s, reset in %u ms\n", cmd, ud_ctl_resets[i].mode,
+		    set ? "set" : "NOT set", UD_CTL_DELAY_MS);
+		ud_ctl_reply(f, reply);
+		ud_ctl_schedule(UD_CTL_RESET);
+		return true;
+	}
+	printf("LAUREL CTL: unknown command\n");
+	ud_ctl_reply(f, "error: unknown command");
+	return true;
+}
+
+/* ud_thread, every tick: run a scheduled reset, power off or panic once its delay is over. */
+static void
+ud_ctl_poll(void)
+{
+	if (ud.ctl_action == UD_CTL_NONE || mach_absolute_time() < ud.ctl_deadline) {
+		return;
+	}
+	int action = ud.ctl_action;
+	ud.ctl_action = UD_CTL_NONE;
+	if (action == UD_CTL_PANIC) {
+		panic("requested over USB");
+	}
+	if (action == UD_CTL_POWEROFF) {
+		laurel_power_off();             /* returns only if PSCI refused (logged there) */
+		return;
+	}
+	printf("LAUREL CTL: PSCI SYSTEM_RESET\n");
+	laurel_restart();
+}
+
+/*
+ * ---- panic mode (port of negroni 0360) ----
+ *
+ * laurel_usb_panic_hold() (called from the platform expert's halt/restart
+ * hook at kPEPanicDiagnosticsDone / kPEPanicRestartCPU) keeps the panic on
+ * the screen and runs laurel_usb_panic_service() in a busy loop. Each call:
+ *   - handles the DWC3 events (polled; ep0 enumeration works, so a host
+ *     that connects after the panic still gets the link),
+ *   - answers ARP for 192.168.7.2 (the stack is dead),
+ *   - takes commands on UDP 5141 (ping, log, reboot, bootloader, recovery,
+ *     poweroff) and runs them 500 ms later,
+ *   - sends one frame when the IN endpoint is free: command replies, then
+ *     the log frames still on the TX ring, then the console ring (panic
+ *     text, registers, backtrace) from where ud_log_thread stopped, as UDP
+ *     192.168.7.2:5140 -> 192.168.7.1:5140 like the live log.
+ * A frame that the host does not take in 2 s is ended and sent again.
+ * Boot-arg laurelpanicusb=0 disables all of this (the panic then behaves
+ * as before: XNU's own hold or restart).
+ */
+#define UD_PANIC_REPLIES        4
+#define UD_PANIC_RING_MAX       (1u << 20)      /* at most the last 1 MiB of console text */
+#define UD_PANIC_CHUNK          1400
+#define DEPCMD_ENDTRANSFER      8
+#define DEPCMD_FORCERM          (1u << 11)
+#define UD_PANIC_ACT_POWEROFF   0x100
+
+enum { UD_PREPLY_UDP = 1, UD_PREPLY_ARP = 2 };
+static struct {
+	uint8_t     kind;
+	uint8_t     mac[ETHER_ADDR_LEN];
+	uint8_t     ip[4];
+	uint16_t    port;
+	char        text[64];
+} ud_preply[UD_PANIC_REPLIES];
+static unsigned ud_preply_head, ud_preply_count;
+static bool     ud_panic_ok, ud_panic_busy;
+static int      ud_panic_action = -1;   /* index in ud_ctl_resets, or UD_PANIC_ACT_POWEROFF */
+static uint64_t ud_panic_pos;           /* next console ring byte to send */
+static uint64_t ud_panic_tx_at;         /* start time of the frame on the IN endpoint */
+static uint64_t ud_panic_tx_timeout;    /* 2 s in absolute time units */
+static uint32_t ud_panic_tx_len;        /* its length (sent again after a timeout) */
+static uint32_t ud_panic_tx_rsc;        /* its transfer resource index (for ENDTRANSFER) */
+static unsigned ud_panic_txq_left;      /* frames of ud.txq not looked at yet */
+static uint32_t ud_panic_timeouts;
+static bool     ud_panic_host_seen;     /* a frame from 192.168.7.1 came since the last configuration */
+static bool     ud_panic_was_configured;
+static uint64_t ud_panic_conf_at;       /* time of that configuration */
+static uint64_t ud_panic_host_wait;     /* 10 s: then the ring is sent without a sign of the host */
+static uint64_t ud_panic_gap, ud_panic_last;    /* log frames at most one per 1 ms (1.4 MB/s) */
+static const uint8_t ud_host_ip[4] = { 192, 168, 7, 1 };
+
+static void
+ud_panic_queue(int kind, const uint8_t *mac, const uint8_t *ip, uint16_t port, const char *text)
+{
+	if (ud_preply_count == UD_PANIC_REPLIES) {
+		return;                         /* full: the host asks again */
+	}
+	unsigned i = (ud_preply_head + ud_preply_count) % UD_PANIC_REPLIES;
+	ud_preply[i].kind = (uint8_t)kind;
+	memcpy(ud_preply[i].mac, mac, ETHER_ADDR_LEN);
+	memcpy(ud_preply[i].ip, ip, 4);
+	ud_preply[i].port = port;
+	strlcpy(ud_preply[i].text, text != NULL ? text : "", sizeof(ud_preply[i].text));
+	ud_preply_count++;
+}
+
+/* One received frame in panic mode: ARP for 192.168.7.2, or a command on UDP 5141. */
+static void
+ud_panic_rx(const uint8_t *f, uint32_t len)
+{
+	uint16_t type = ud_be16(f + 12);
+
+	/* Any ARP or IPv4 frame from 192.168.7.1 shows that the host has its address. */
+	if ((type == ETHERTYPE_ARP && len >= ETHER_HDR_LEN + 28 && ud_be32(f + ETHER_HDR_LEN + 14) == UD_IP_HOST) ||
+	    (type == ETHERTYPE_IP && len >= ETHER_HDR_LEN + 20 && ud_be32(f + ETHER_HDR_LEN + 12) == UD_IP_HOST)) {
+		ud_panic_host_seen = true;
+	}
+	if (type == ETHERTYPE_ARP) {
+		const uint8_t *a = f + ETHER_HDR_LEN;
+		if (len >= ETHER_HDR_LEN + 28 && ud_be16(a) == 1 && ud_be16(a + 2) == ETHERTYPE_IP &&
+		    a[4] == ETHER_ADDR_LEN && a[5] == 4 && ud_be16(a + 6) == 1 && ud_be32(a + 24) == UD_IP_PHONE) {
+			ud_panic_queue(UD_PREPLY_ARP, a + 8, a + 14, 0, NULL);  /* sender MAC and IP */
+		}
+		return;
+	}
+	if (!ud.ctl_enabled || type != ETHERTYPE_IP || len < ETHER_HDR_LEN + 20 + 8) {
+		return;
+	}
+	const uint8_t *ip = f + ETHER_HDR_LEN;
+	uint32_t ihl = (ip[0] & 0xfu) * 4, tot = ud_be16(ip + 2);
+	if ((ip[0] >> 4) != 4 || ihl < 20 || ip[9] != IPPROTO_UDP || tot < ihl + 8 ||
+	    ETHER_HDR_LEN + tot > len || (ud_be16(ip + 6) & 0x3fff) != 0) {
+		return;
+	}
+	const uint8_t *udp = ip + ihl;
+	uint32_t ulen = ud_be16(udp + 4);
+	if (ud_be32(ip + 16) != UD_IP_PHONE || ud_be16(udp + 2) != UD_CTL_PORT || ud_be32(ip + 12) != UD_IP_HOST ||
+	    ud_sum_fold(ud_sum_add(0, ip, ihl)) != 0 || ulen < 8 || ulen > tot - ihl) {
+		return;
+	}
+	char cmd[32];
+	(void)ud_ctl_word(udp, ulen, cmd, sizeof(cmd));
+
+	const char *reply;
+	char text[64];
+	int action = -1;
+	if (strcmp(cmd, "ping") == 0) {
+		reply = "pong (panic)";
+	} else if (strcmp(cmd, "log") == 0) {
+		uint64_t end = sweet_log_position();
+		ud_panic_pos = end > 65536 ? end - 65536 : 0;
+		reply = "ok log (panic)";
+	} else if (strcmp(cmd, "reboot") == 0 || strcmp(cmd, "recovery") == 0 ||
+	    strcmp(cmd, "bootloader") == 0 || strcmp(cmd, "poweroff") == 0) {
+		if (ud_panic_busy || ud_panic_action >= 0) {
+			reply = "error: busy";
+		} else {
+			action = cmd[0] == 'p' ? UD_PANIC_ACT_POWEROFF : cmd[2] == 'b' ? 0 : cmd[2] == 'c' ? 1 : 2;
+			snprintf(text, sizeof(text), "ok %s (panic)", cmd);
+			reply = text;
+		}
+	} else if (strcmp(cmd, "panic") == 0) {
+		reply = "error: already in panic";
+	} else {
+		reply = "error: panic mode: ping log reboot bootloader recovery poweroff";
+	}
+	printf("LAUREL PANIC CTL: \"%s\" -> %s\n", cmd, reply);
+	ud_panic_queue(UD_PREPLY_UDP, f + ETHER_ADDR_LEN, ip + 12, ud_be16(udp), reply);
+	if (action >= 0) {
+		ud_panic_action = action;
+	}
+}
+
+/* The frame in the TX buffer (len bytes) goes out on the IN endpoint. */
+static void
+ud_panic_tx_start(uint32_t len)
+{
+	uint8_t *buf = (uint8_t *)(ud.dma + UD_TX);
+
+	if ((len % 512) == 0) {
+		buf[len++] = 0;                 /* as ud_tx_kick_locked: no zero-length packet needed */
+	}
+	ud_panic_tx_len = len;
+	ud.tx_busy = true;
+	ud.tx_frames++;
+	ud_panic_tx_at = mach_absolute_time();
+	ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, len, TRBCTL_NORMAL);
+	ud_panic_tx_rsc = (dwc_rd(DEPCMD(EP_TX)) >> 16) & 0x7f;
+}
+
+/* A log frame from before the panic (UDP to 5140, or a 5141 reply): worth sending. */
+static bool
+ud_panic_is_log_frame(const uint8_t *f, uint32_t len)
+{
+	const uint8_t *ip = f + ETHER_HDR_LEN;
+	if (len < ETHER_HDR_LEN + 20 + 8 || ud_be16(f + 12) != ETHERTYPE_IP || ip[9] != IPPROTO_UDP) {
+		return false;
+	}
+	uint32_t ihl = (ip[0] & 0xfu) * 4;
+	if (ihl < 20 || ETHER_HDR_LEN + ihl + 8 > len) {
+		return false;
+	}
+	const uint8_t *udp = ip + ihl;
+	return ud_be16(udp + 2) == UD_LOG_PORT || ud_be16(udp) == UD_CTL_PORT;
+}
+
+static void
+ud_panic_tx_next(void)
+{
+	uint8_t *f = (uint8_t *)(ud.dma + UD_TX);
+
+	if (ud_preply_count > 0) {
+		unsigned i = ud_preply_head;
+		ud_preply_head = (ud_preply_head + 1) % UD_PANIC_REPLIES;
+		ud_preply_count--;
+		if (ud_preply[i].kind == UD_PREPLY_ARP) {
+			/* ARP reply: 192.168.7.2 is at 02:00:5e:77:ee:02 */
+			bzero(f, ETHER_HDR_LEN + 28);
+			memcpy(f, ud_preply[i].mac, ETHER_ADDR_LEN);
+			memcpy(f + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+			ud_put16(f + 12, ETHERTYPE_ARP);
+			uint8_t *a = f + ETHER_HDR_LEN;
+			ud_put16(a, 1);
+			ud_put16(a + 2, ETHERTYPE_IP);
+			a[4] = ETHER_ADDR_LEN;
+			a[5] = 4;
+			ud_put16(a + 6, 2);
+			memcpy(a + 8, ud_phone_mac, ETHER_ADDR_LEN);
+			ud_put32(a + 14, UD_IP_PHONE);
+			memcpy(a + 18, ud_preply[i].mac, ETHER_ADDR_LEN);
+			memcpy(a + 24, ud_preply[i].ip, 4);
+			ud_panic_tx_start(ETHER_HDR_LEN + 28);
+		} else {
+			ud_panic_tx_start(ud_udp_build(f, ud_preply[i].mac, ud_preply[i].ip, UD_CTL_PORT,
+			    ud_preply[i].port, ud_preply[i].text, (uint32_t)strlen(ud_preply[i].text)));
+		}
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (!ud_panic_host_seen && now - ud_panic_conf_at < ud_panic_host_wait) {
+		return;                         /* the host may not have 192.168.7.1 yet */
+	}
+	if (now - ud_panic_last < ud_panic_gap) {
+		return;                         /* pace: the host's UDP receive buffer is not unlimited */
+	}
+	ud_panic_last = now;
+	while (ud_panic_txq_left > 0 && ud.txq_count > 0) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		ud_panic_txq_left--;
+		/* not freed: no allocator calls in panic context */
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN || mbuf_copydata(m, 0, len, f) != 0 ||
+		    !ud_panic_is_log_frame(f, (uint32_t)len)) {
+			continue;
+		}
+		ud_panic_tx_start((uint32_t)len);
+		return;
+	}
+	uint32_t n = sweet_log_copy(&ud_panic_pos, (char *)f + ETHER_HDR_LEN + 20 + 8, UD_PANIC_CHUNK);
+	if (n > 0) {
+		ud_panic_tx_start(ud_udp_build(f, ud_host_mac, ud_host_ip, UD_LOG_PORT, UD_LOG_PORT,
+		    f + ETHER_HDR_LEN + 20 + 8, n));
+	}
+}
+
+/* Once per panic. false: no USB in this panic (not started, or laurelpanicusb=0). */
+static bool
+ud_panic_begin(void)
+{
+	if (ud_in_panic) {
+		return ud_panic_ok;
+	}
+	if (!ud_panic_enabled || !ud_running || ud.dwc == 0 || ud.dma == 0) {
+		return false;
+	}
+	ud_in_panic = true;
+	nanoseconds_to_absolutetime(2 * NSEC_PER_SEC, &ud_panic_tx_timeout);
+	nanoseconds_to_absolutetime(10 * NSEC_PER_SEC, &ud_panic_host_wait);
+	nanoseconds_to_absolutetime(NSEC_PER_MSEC, &ud_panic_gap);
+	/* the live log reached the host before the panic: no need to wait for it */
+	ud_panic_host_seen = ud.configured && ud.rx_frames > 0;
+	ud_panic_was_configured = ud.configured;
+	ud_panic_conf_at = mach_absolute_time();
+	uint64_t end = sweet_log_position(), from = ud_log_sent;
+	if (from > end || end - from > UD_PANIC_RING_MAX) {
+		from = end > UD_PANIC_RING_MAX ? end - UD_PANIC_RING_MAX : 0;
+	}
+	ud_panic_pos = from;
+	ud_panic_txq_left = ud.txq_count;
+	if (ud.tx_busy) {
+		/* a frame of the normal path is on the endpoint: give it the same 2 s */
+		volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
+		ud_sync(UD_TRB_TX, 16);
+		uint32_t len = t[2] & 0xffffff;
+		ud_panic_tx_len = (len > 0 && len < UD_FRAME_MAX) ? len : 0;
+		ud_panic_tx_rsc = (dwc_rd(DEPCMD(EP_TX)) >> 16) & 0x7f;
+		ud_panic_tx_at = mach_absolute_time();
+	}
+	ud_panic_ok = true;
+	kdb_printf("LAUREL PANIC: USB %s: console ring %llu bytes to send, %u frames queued; "
+	    "commands on udp 192.168.7.2:%u %s\n", ud.configured ? "configured" : "not configured (waiting for the host)",
+	    end - from, ud.txq_count, UD_CTL_PORT, ud.ctl_enabled ? "on" : "off");
+	return true;
+}
+
+/*
+ * One step of the panic loop. busy: the caller still has an action to run
+ * (new reset commands get "error: busy"). Returns -1, an index in
+ * ud_ctl_resets or UD_PANIC_ACT_POWEROFF.
+ */
+static int
+ud_panic_service(bool busy)
+{
+	if (!ud_panic_ok) {
+		return -1;
+	}
+	ud_panic_busy = busy;
+	uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+	if (count > UD_EVT_SIZE) {
+		count = UD_EVT_SIZE;
+	}
+	if (count) {
+		ud_sync(UD_EVT, UD_EVT_SIZE);
+		for (uint32_t done = 0; done + 4 <= count; done += 4) {
+			uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+			ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+			dwc_wr(GEVNTCOUNT, 4);
+			ud_event(ev);
+		}
+	}
+	if (ud.configured != ud_panic_was_configured) {
+		ud_panic_was_configured = ud.configured;
+		if (ud.configured) {            /* (re)enumerated in panic mode: wait for the host's address */
+			ud_panic_host_seen = false;
+			ud_panic_conf_at = mach_absolute_time();
+		}
+	}
+	if (ud.tx_busy && mach_absolute_time() - ud_panic_tx_at > ud_panic_tx_timeout) {
+		/* The host did not take the frame in 2 s: end the transfer and start it again. */
+		(void)ud_epcmd(EP_TX, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | (ud_panic_tx_rsc << 16), 0, 0, 0);
+		ud_udelay(100);
+		ud.tx_busy = false;
+		ud_panic_timeouts++;
+		if (ud.configured && ud_panic_tx_len > 0) {
+			uint32_t len = ud_panic_tx_len;
+			ud.tx_frames--;
+			ud_panic_tx_start(len);
+		}
+	}
+	if (ud.configured && !ud.tx_busy) {
+		ud_panic_tx_next();
+	}
+	int action = ud_panic_action;
+	ud_panic_action = -1;
+	return action;
+}
+
+/*
+ * Panic hold: called by the platform expert at kPEPanicDiagnosticsDone (the
+ * panic log is complete) or kPEPanicRestartCPU. Returns at once when USB is
+ * not usable (the caller then does what it did before); otherwise never:
+ * the panic stays on the screen, the console ring goes to the host, and a
+ * USB command (reboot, bootloader, recovery, poweroff) runs 500 ms later.
+ * laurelpanic=N (seconds, default 0 = for ever): a timed reset (mode
+ * normal) for unattended boots.
+ */
+void laurel_usb_panic_hold(void);
+void
+laurel_usb_panic_hold(void)
+{
+	static int entries;
+	uint64_t sec, half, now, reset_at = UINT64_MAX, act_at = 0;
+	int pending = -1, secs = 0;
+
+	if (entries++ != 0) {
+		return;                         /* nested panic: no USB */
+	}
+	if (!ud_panic_begin()) {
+		return;
+	}
+	PE_parse_boot_argn("laurelpanic", &secs, sizeof(secs));
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &sec);
+	nanoseconds_to_absolutetime(500 * NSEC_PER_MSEC, &half);
+	now = mach_absolute_time();
+	if (secs > 0) {
+		reset_at = now + (uint64_t)secs * sec;
+	}
+	kdb_printf("LAUREL PANIC: holding; reset with: op10tool ctl bootloader%s\n",
+	    secs > 0 ? " (timed reset set by laurelpanic)" : "");
+	for (;;) {
+		now = mach_absolute_time();
+		int a = ud_panic_service(pending >= 0);
+		if (a >= 0 && pending < 0) {
+			pending = a;
+			act_at = now + half;
+		}
+		if (pending >= 0 && now >= act_at) {
+			a = pending;
+			pending = -1;
+			if (a == UD_PANIC_ACT_POWEROFF) {
+				kdb_printf("LAUREL PANIC: power off (USB command)\n");
+				laurel_power_off();
+				kdb_printf("LAUREL PANIC: power off failed\n");
+			} else {
+				kdb_printf("LAUREL PANIC: reset, mode %s (USB command)\n", ud_ctl_resets[a].mode);
+				(void)laurel_reboot_set_mode(ud_ctl_resets[a].mode);
+				laurel_restart();
+				kdb_printf("LAUREL PANIC: reset failed\n");
+			}
+		}
+		if (now >= reset_at) {
+			reset_at = UINT64_MAX;
+			kdb_printf("LAUREL PANIC: %d s over: reset\n", secs);
+			(void)laurel_reboot_set_mode("normal");
+			laurel_restart();
+			kdb_printf("LAUREL PANIC: reset failed\n");
+		}
+	}
+}
