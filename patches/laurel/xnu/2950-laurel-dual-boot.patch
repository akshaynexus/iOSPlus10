 {
-	if (!su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	/* laurel 2950: the fence. It compares with what the self-check found, not with any state above it. */
+	if (!ldb.on || su.lun != 0 || !su.writable || !su.nblocks || count == 0 || count > BOUNCE_SIZE / UFS_BLOCK ||
+	    lba < ldb.first || lba - ldb.first >= ldb.blocks || count > ldb.blocks - (lba - ldb.first) ||
 	    lba < su.first_block || lba - su.first_block >= su.nblocks ||
 	    count > su.nblocks - (lba - su.first_block) || lba + count - 1 > UINT32_MAX ||
 	    lba < 6 || (gpt_alt && lba + count - 1 >= gpt_alt - 4)) {
-		printf("SWEET UFS: refusing write of %u blocks at 0x%llx\n", count, lba);
+		printf("SWEET UFS: refusing write of %u blocks at 0x%llx (dual boot fence)\n", count, lba);
 		return EPERM;
 	}
 	uint8_t cdb[10] = {
@@ -832,13 +851,73 @@
 	return on ? 0 : ENXIO;
 }
 
+/*
+ * laurel 2950: the self-check of the dual boot. Caller holds sweet_ufs_lock; su has iosroot from the GPT of LUN 0, no write is possible yet. Reads only.
+ * Returns NULL (ldb.on set) or the reason.
+ */
+static uint8_t ldb_ph[UFS_BLOCK], ldb_pe[UFS_BLOCK], ldb_bh[UFS_BLOCK], ldb_be[UFS_BLOCK];
+static const char *
+ldb_self_check(void)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t first = 0, blocks = 0;
+	uint32_t on = 1;
+
+	PE_parse_boot_argn("laureldualboot", &on, sizeof(on));
+	if (!on) {
+		return "laureldualboot=0";
+	}
+	if (su.lun != 0) {
+		return "not on LUN 0";
+	}
+	if (ufs_read_blocks(1, 1) != 0) {
+		return "cannot read the GPT";
+	}
+	memcpy(ldb_ph, b, UFS_BLOCK);
+	uint64_t pe_lba = ldb_le64(ldb_ph + 72), alt = ldb_le64(ldb_ph + 32);
+	if (ufs_read_blocks(pe_lba, 1) != 0) {
+		return "cannot read the GPT entries";
+	}
+	memcpy(ldb_pe, b, UFS_BLOCK);
+	if (ufs_read_blocks(alt, 1) != 0) {
+		return "cannot read the backup GPT";
+	}
+	memcpy(ldb_bh, b, UFS_BLOCK);
+	if (ufs_read_blocks(ldb_le64(ldb_bh + 72), 1) != 0) {
+		return "cannot read the backup GPT entries";
+	}
+	memcpy(ldb_be, b, UFS_BLOCK);
+	const char *why = ldb_gpt_layout_check(ldb_ph, ldb_pe, ldb_bh, ldb_be, &first, &blocks);
+	if (why != NULL) {
+		return why;
+	}
+	if (first != su.first_block || blocks != su.nblocks) {
+		return "two reads of the GPT disagree";
+	}
+	if (ufs_read_blocks(first, 1) != 0) {
+		return "cannot read the root volume header";
+	}
+	uint64_t hfs = ldb_hfs_volume_bytes(b);
+	if (hfs == 0) {
+		return "no HFS+ volume in " LDB_ROOT_NAME;
+	}
+	/* the console log (sweet_log_thread) takes the end of the partition */
+	if (blocks < 2u * LDB_LOG_BLOCKS || hfs > (blocks - LDB_LOG_BLOCKS) * UFS_BLOCK) {
+		return "the HFS+ volume is longer than " LDB_ROOT_NAME " minus the console log";
+	}
+	ldb.first = first;
+	ldb.blocks = blocks;
+	ldb.on = true;
+	return NULL;
+}
+
