+			printf("LAUREL DUALBOOT: no root: %s; restart in 30 s (ABL falls back to Android when the retries of this slot end)\n",
+			    ldb.why != NULL ? ldb.why : "UFS error");
+			IOSleep(30000);
+			PEHaltRestart(1 /* kPERestartCPU */);
 			return error;
 		}
