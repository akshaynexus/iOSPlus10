+		if (ldb.hdr.state == LDB_STATE_BOUND && ldb.fp_now[i] != ldb.hdr.fp_hash[i]) {
+			return "Android ran or /data was formatted since the last seal (the file may have moved): run dual-boot.sh switch on Android";
+		}
