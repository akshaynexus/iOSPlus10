 	lck_mtx_unlock(&sweet_ufs_lock);
 	if (error) {
@@ -903,6 +994,10 @@
 	devfs_make_node(makedev(su.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rufsroot0");
 	/* Only now, with the partition bounds known, can writes be allowed. */
 	su.writable = (rw != 0);
+	laurel_dualboot_on = 1;
+	printf("LAUREL DUALBOOT: on: root = " LDB_ROOT_NAME ", LUN 0, first block %llu, %llu blocks (%llu MiB), %s (%s)\n",
+	    ldb.first, ldb.blocks, ldb.blocks * UFS_BLOCK >> 20,
+	    su.writable ? "writes fenced to this partition" : "read-only", laurel_dualboot_marker);
 	su.ready = true;
 	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
@@ -1089,6 +1184,16 @@
 	if (!su.ready) {
 		int error = sweet_ufs_init();
 		if (error) {
+			/*
+			 * laurel 2950: no root on this boot. Android must come back without a computer: restart, so that ABL counts down the retries of this slot and
+			 * falls back to the Android slot. 30 s for the screen and the USB log. No write was done. If the restart does not happen: the panic.
+			 */
+			extern int PEHaltRestart(unsigned int type);
