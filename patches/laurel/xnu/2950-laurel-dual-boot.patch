 	PE_parse_boot_argn("ufsrw", &rw, sizeof(rw));
 	uint32_t cache = 0, wait = 0;
@@ -884,6 +962,19 @@
 	}
 	if (!error) {
 		error = ufs_find_partition(want);
+		if (error) {
+			ldb.why = error == ENOENT ? "no partition " LDB_ROOT_NAME " in the GPT of LUN 0" : "no partition " LDB_ROOT_NAME ": LUN 0 has no GPT or cannot be read";
