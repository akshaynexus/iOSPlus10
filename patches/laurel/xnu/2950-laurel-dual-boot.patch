 } su;
 
+/* laurel 2950. on: the self-check passed; first, blocks: iosroot, set once by it. Not on: no write goes out (ufs_write_blocks). */
+static struct {
+	bool on;
+	uint64_t first, blocks;
+	const char *why;
+} ldb;
+static int laurel_dualboot_on;
+/* uefi-image.sh and android-guard.sh refuse a kernel and a boot image without this text */
+__attribute__((used)) static const char laurel_dualboot_marker[] = LDB_KERNEL_MARKER;
+SYSCTL_INT(_kern, OID_AUTO, laurel_dualboot, CTLFLAG_RD | CTLFLAG_LOCKED, &laurel_dualboot_on, 0,
+    "laurel 2950: 1 = the root is the partition iosroot and writes are fenced to it");
+
 static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
 static LCK_MTX_DECLARE(sweet_ufs_lock, &sweet_ufs_grp);
 
@@ -287,11 +304,13 @@
