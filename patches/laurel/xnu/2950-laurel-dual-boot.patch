+/*
+ * laurel 2950: the self-check of the dual boot. Caller holds sweet_ufs_lock; su has the partition from the GPT, no write is possible yet.
+ * Returns NULL (ldb.on set) or the reason. Reads only. Never parses f2fs.
+ */
+static const char *
+ldb_self_check(const char *want)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t lba = 0;
+	uint32_t run = 0, on = 1;
+
+	PE_parse_boot_argn("laureldualboot", &on, sizeof(on));
+	if (!on) {
+		return "laureldualboot=0";
+	}
+	if (ldb.t == NULL) {
+		return ldb.why;
+	}
+	if (strcmp(want, "userdata") != 0 || su.lun != 0) {
+		return "the table is for userdata on LUN 0";
+	}
+	if (ldb.t->part_first != su.first_block || ldb.t->part_blocks != su.nblocks) {
+		return "the table's userdata is not the GPT's userdata";
+	}
