laurel 2890: CPU governor response (bsd/dev/laurel_thermal.c split into pieces below 300 lines, new laurel_gov_core.h with the decision, host test scripts/laurel/gov-test.sh). Tick 100 -> 40 ms, window 300 -> 120 ms: a load from idle reaches the top row after 120 ms (was 300 ms, host only). Busy = wall - idle (the idle time is current when read; user + system lag behind). Silver floor row 0 ([V] 1305 MHz with 0 % busy for a whole boot; ABL's row is now its UI hold). Touch event: Gold at the cap and Silver at the ABL row for 500 ms, the thread woken at once (SweetHID.cpp). GPU work in the last 100 ms: Gold at 1401 MHz or more. New minute line: time per row. Kill switch as before: laurelcpugov=0.

diff -ruN a/bsd/dev/laurel_gov_core.h b/bsd/dev/laurel_gov_core.h
--- a/bsd/dev/laurel_gov_core.h	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_gov_core.h	2026-11-01 20:09:18.970704311 +0530
@@ -0,0 +1,47 @@
+/*
+ * laurel 2890: the OSM governor's one decision, without kernel types, so that the host test
+ * (scripts/laurel/gov-test.sh) runs exactly this code. One step for one cluster.
+ *   busy  % of the busiest core over the last LGOV_WINDOW ticks (LGOV_TICK_MS each)
+ *   row   the row the cluster runs now; cap the thermal cap; floor the governor's lowest row (the cap wins)
+ *   hold  a row wanted by the UI right now (touch, GPU work); 0 = none
+ *   low   ticks in a row below LGOV_LO (kept by the caller)
+ * Before 2890 [V 2303]: 100 ms tick, 300 ms window, > 90 %: cap, > 70 %: +1 row. A load that starts on an idle core reads
+ * 33 %, 66 %, 100 %: the top row came 300 ms after the load, the first frames of a touch ran at 300 MHz.
+ */
+#ifndef LAUREL_GOV_CORE_H
+#define LAUREL_GOV_CORE_H
+#define LGOV_TICK_MS    40u
+#define LGOV_WINDOW     3u
+#define LGOV_JUMP       85u     /* a core full for 120 ms: the cap at once */
+#define LGOV_HI         60u     /* +2 rows */
+#define LGOV_LO         30u
+#define LGOV_DOWN_TICKS 8u      /* 320 ms below LGOV_LO: -1 row (as before: about 300 ms) */
+
+static inline unsigned
+lgov_next(unsigned busy, unsigned row, unsigned floor, unsigned cap, unsigned hold, unsigned *low)
+{
+	unsigned want = row;
+
+	if (busy > LGOV_JUMP) {
+		want = cap;
+		*low = 0;
+	} else if (busy > LGOV_HI) {
+		want = row + 2;
+		*low = 0;
+	} else if (busy < LGOV_LO) {
+		if (++*low >= LGOV_DOWN_TICKS && row > 0) {
+			want = row - 1;
+			*low = 0;
+		}
+	} else {
+		*low = 0;
+	}
+	if (hold > floor) {
+		floor = hold;
+	}
+	if (want < floor) {
+		want = floor;
+	}
+	return want > cap ? cap : want;
+}
+#endif
diff -ruN a/bsd/dev/laurel_gov_loop.h b/bsd/dev/laurel_gov_loop.h
--- a/bsd/dev/laurel_gov_loop.h	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_gov_loop.h	2026-11-01 20:06:58.996946798 +0530
@@ -0,0 +1,84 @@
+/* laurel 2890 (a piece of laurel_thermal.c): load per core, one governor step, time per row. */
+static void
+sample_busy(void)
+{
+	const ml_topology_info_t *topo = ml_get_topology_info();
+	uint64_t now = mach_absolute_time(), wall = sampled ? now - wall_last : 0, ww = 0;
+
+	wall_last = now;
+	wall_d[win_at] = wall;
+	for (unsigned w = 0; w < GOV_WINDOW; w++) {
+		ww += wall_d[w];
+	}
+	cl_busy[CL_SILVER] = cl_busy[CL_GOLD] = 0;
+	for (unsigned i = 0; i < topo->num_cpus && i < GOV_MAX_CPUS; i++) {
+		unsigned c = ((topo->cpus[i].phys_id & 0xff00u) == 0x100u) ? CL_GOLD : CL_SILVER;
+		processor_t p = cpu_to_processor((int)topo->cpus[i].cpu_id);
+		natural_t ticks[CPU_STATE_MAX] = { 0 };
+		if (p == PROCESSOR_NULL) {
+			continue;
+		}
+		processor_cpu_load_info(p, ticks);
+		uint64_t idle = sampled ? (uint64_t)(ticks[CPU_STATE_IDLE] - cpu_idle_last[i]) * hz_tick_interval : 0, iw = 0;
+		cpu_idle_last[i] = ticks[CPU_STATE_IDLE];
+		cpu_idle_d[i][win_at] = idle;
+		busy_total_abs += wall > idle ? wall - idle : 0;
+		for (unsigned w = 0; w < GOV_WINDOW; w++) {
+			iw += cpu_idle_d[i][w];
+		}
+		uint32_t pct = ww == 0 || iw >= ww ? 0 : (uint32_t)((ww - iw) * 100 / ww);
+		if (pct > cl_busy[c]) {
+			cl_busy[c] = pct;
+		}
+	}
+	win_at = (win_at + 1) % GOV_WINDOW;
+	sampled = true;
+}
+
+static bool
+within_ms(uint64_t then, uint64_t now, uint32_t ms)
+{
+	uint64_t ns = 0;
+
+	if (then == 0) {
+		return false;
+	}
+	absolutetime_to_nanoseconds(now - then, &ns);
+	return ns < (uint64_t)ms * NSEC_PER_MSEC;
+}
+
+static void
+gov_step(void)
+{
+	uint64_t now = mach_absolute_time();
+	bool touch = within_ms(laurel_touch_at, now, TOUCH_HOLD_MS);
+	bool gpu = within_ms(laurel_gpu_last_work, now, GPU_HOLD_MS);
+
+	for (unsigned c = 0; c < CL_N; c++) {
+		/* a touch: Gold at its cap and Silver at ABL's row until the first frames are out; GPU work: Gold at UI_GOLD_KHZ */
+		uint32_t hold = touch ? (c == CL_GOLD ? cl_cap[c] : ui_row[c]) : (gpu && c == CL_GOLD ? ui_row[c] : 0);
+		unsigned low = cl_low[c];
+
+		wr_row(c, lgov_next(cl_busy[c], cl_row[c], lo_row(c), cl_cap[c], hold, &low));
+		cl_low[c] = low;
+	}
+}
+
+/* laurel 2890: the time in each row, a line a minute: the input for "was the CPU at speed while the UI moved" */
+static void
+rows_line(void)
+{
+	for (unsigned c = 0; c < CL_N; c++) {
+		char s[200];
+		int n = 0;
+
+		for (uint32_t r = 0; r < cl_rows[c] && n < (int)sizeof(s) - 24; r++) {
+			if (cl_row_ms[c][r] != 0) {
+				n += snprintf(s + n, sizeof(s) - n, " %u:%llu", cl_khz[c][r] / 1000, cl_row_ms[c][r] / 1000);
+			}
+			cl_row_ms[c][r] = 0;
+		}
+		printf("LAUREL CPUFREQ: on: %s MHz:seconds in the last minute:%s\n", cl_name[c], s);
+	}
+}
+
