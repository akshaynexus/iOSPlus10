+/*
+ * laurel 2987: the panic hold. A panic of any other kind stops the hardware, as before: the text stays for the owner.
+ * A bark means a CPU is stuck, and that CPU can also stop the hold from answering on USB (17:56:16: no pong, only the Power key).
+ * So the count of laurel_wdog_panic_begin runs on: a bite 30 s after the panic. The USB log has the text by then.
+ */
+void laurel_wdog_hold(void);
+void
+laurel_wdog_hold(void)
+{
+	if (lwd_barked != 0 && lwd_on != 0) {
+		kprintf("LAUREL WDOG: on: bark: the phone resets in 30 s by the bite\n");
+		return;
+	}
+	laurel_wdog_stop();
+}
