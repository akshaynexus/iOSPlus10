+/* ---------------------------------------------------------------- firmware (laurel: FAT16 modem partition) */
+
+/*
+ * The Mi A3's ADSP image is image/adsp.mdt + adsp.b00..b27 in the stock modem partition (FAT16,
+ * 4 KiB sectors, NON-HLOS.bin). TopazModem's reader has a file table of the topaz NON-HLOS; this
+ * one reads the volume itself: boot sector, FAT, root directory, the "image" directory, then each
+ * file through its cluster chain. Read-only through sweet_ufs. Slot b first (the Mi A3 boots
+ * slot b), then slot a.
+ */
+extern "C" int sweet_ufs_read_part(const char *want, uint64_t off, void *dst, uint64_t len);
+
+#define FW_MAX_FILES        64
+static const char *const fw_parts[] = { "modem_b", "modem_a" };
+static char fw_part[16];
+static struct { char name[13]; uint32_t cluster, size; } fw_files[FW_MAX_FILES];
+static uint32_t fw_nfiles, fw_fat_entries, fw_cluster_bytes;
+static uint16_t *fw_fat;
+static uint32_t fw_fat_bytes;
+static uint64_t fw_data_off;
+
+static inline uint16_t le16(const uint8_t *p) { return (uint16_t)(p[0] | (p[1] << 8)); }
+static inline uint32_t le32(const uint8_t *p) { return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24); }
+
+static bool
+fat_read(uint64_t off, void *dst, uint64_t n)
+{
+	return sweet_ufs_read_part(fw_part, off, dst, n) == 0;
+}
+
+/* "ADSP    B00" -> "adsp.b00" */
+static void
+fat_name(const uint8_t *e, char *out)
+{
+	uint32_t k = 0;
+
+	for (uint32_t i = 0; i < 8 && e[i] != ' '; i++) {
+		out[k++] = (char)((e[i] >= 'A' && e[i] <= 'Z') ? e[i] + 32 : e[i]);
+	}
+	if (e[8] != ' ') {
+		out[k++] = '.';
+		for (uint32_t i = 8; i < 11 && e[i] != ' '; i++) {
+			out[k++] = (char)((e[i] >= 'A' && e[i] <= 'Z') ? e[i] + 32 : e[i]);
+		}
+	}
+	out[k] = 0;
+}
+
+/* the next cluster of a chain, or 0 at its end / on a bad entry */
+static uint32_t
+fat_next(uint32_t c)
+{
+	if (c < 2 || c >= fw_fat_entries) {
+		return 0;
+	}
+	uint32_t n = fw_fat[c];
+	return (n >= 2 && n < fw_fat_entries) ? n : 0;
+}
+
+/* one directory block of `bytes': the "image" entry (want_dir) or the adsp.* files */
+static bool
+fat_dir_block(const uint8_t *d, uint32_t bytes, bool want_dir, uint32_t *dir_cluster)
+{
+	for (uint32_t o = 0; o + 32 <= bytes; o += 32) {
+		const uint8_t *e = d + o;
+		char name[13];
+
+		if (e[0] == 0) {
+			return false;                   /* end of the directory */
+		}
+		if (e[0] == 0xE5 || e[11] == 0x0F || (e[11] & 0x08) != 0) {
+			continue;                       /* deleted, long-name part, volume label */
+		}
+		fat_name(e, name);
+		if (want_dir) {
+			if ((e[11] & 0x10) != 0 && strcmp(name, "image") == 0) {
+				*dir_cluster = le16(e + 26);
+				return false;
+			}
+		} else if ((e[11] & 0x10) == 0 && strncmp(name, "adsp.", 5) == 0 && fw_nfiles < FW_MAX_FILES) {
+			strlcpy(fw_files[fw_nfiles].name, name, sizeof(fw_files[fw_nfiles].name));
+			fw_files[fw_nfiles].cluster = le16(e + 26);
+			fw_files[fw_nfiles].size = le32(e + 28);
+			fw_nfiles++;
+		}
+	}
+	return true;                            /* more entries may follow */
+}
+
+static bool
+fw_mount_one(const char *partition)
+{
+	uint8_t bs[512], *buf = NULL;
+	uint32_t image = 0, root_bytes, bps, spc, rsv, nfat, nroot, spf, total, clusters, steps;
+	uint64_t fat_off, root_off;
+	bool more;
+
+	strlcpy(fw_part, partition, sizeof(fw_part));
+	fw_nfiles = 0;
+	if (!fat_read(0, bs, sizeof(bs)) || bs[510] != 0x55 || bs[511] != 0xAA) {
+		return false;
+	}
+	bps = le16(bs + 11); spc = bs[13]; rsv = le16(bs + 14); nfat = bs[16]; nroot = le16(bs + 17); spf = le16(bs + 22);
+	total = le16(bs + 19) != 0 ? le16(bs + 19) : le32(bs + 32);
+	if (bps < 512 || bps > 4096 || (bps & (bps - 1)) != 0 || spc == 0 || nfat == 0 || nroot == 0 || spf == 0) {
+		LOG("%s: not a FAT16 volume", fw_part);
+		return false;
+	}
+	fat_off = (uint64_t)rsv * bps;
+	root_off = fat_off + (uint64_t)nfat * spf * bps;
+	root_bytes = nroot * 32;
+	fw_data_off = root_off + (uint64_t)((root_bytes + bps - 1) / bps) * bps;
+	fw_cluster_bytes = bps * spc;
+	clusters = (uint32_t)((total - fw_data_off / bps) / spc);
+	if (clusters < 4085 || clusters >= 65525 || (uint64_t)(clusters + 2) * 2 > (uint64_t)spf * bps) {
+		LOG("%s: %u clusters: not FAT16", fw_part, clusters);
+		return false;
+	}
+	fw_fat_entries = clusters + 2;
+	if (fw_fat != NULL) {
+		IOFree(fw_fat, fw_fat_bytes);
+	}
+	fw_fat_bytes = spf * bps;
+	fw_fat = (uint16_t *)IOMalloc(fw_fat_bytes);
+	buf = (uint8_t *)IOMalloc(MAX(root_bytes, fw_cluster_bytes));
+	if (fw_fat == NULL || buf == NULL || !fat_read(fat_off, fw_fat, fw_fat_bytes) || !fat_read(root_off, buf, root_bytes)) {
+		goto fail;
+	}
+	(void)fat_dir_block(buf, root_bytes, true, &image);
+	more = true;
+	for (steps = 0; image >= 2 && more && steps < 64; steps++) {
+		if (!fat_read(fw_data_off + (uint64_t)(image - 2) * fw_cluster_bytes, buf, fw_cluster_bytes)) {
+			goto fail;
+		}
+		more = fat_dir_block(buf, fw_cluster_bytes, false, NULL);
+		image = fat_next(image);
+	}
+	IOFree(buf, MAX(root_bytes, fw_cluster_bytes));
+	return fw_nfiles != 0;
+fail:
+	if (buf != NULL) {
+		IOFree(buf, MAX(root_bytes, fw_cluster_bytes));
+	}
+	fw_nfiles = 0;
+	return false;
+}
+
+static int
+fw_find(const char *path)
+{
+	if (strncmp(path, "image/", 6) == 0) {
+		path += 6;
+	}
+	for (uint32_t i = 0; i < fw_nfiles; i++) {
+		if (strcmp(fw_files[i].name, path) == 0) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+static bool
+fw_mount(void)
+{
+	for (uint32_t i = 0; i < sizeof(fw_parts) / sizeof(fw_parts[0]); i++) {
+		if (fw_mount_one(fw_parts[i]) && fw_find("adsp.mdt") >= 0) {
+			LOG("firmware: %s, %u adsp files", fw_part, fw_nfiles);
+			return true;
+		}
+	}
+	return false;
+}
+
+static int64_t
+fw_size(const char *path)
+{
+	int i = fw_find(path);
+	return i < 0 ? -1 : (int64_t)fw_files[i].size;
+}
+
+/* bytes off..off+n of a file: runs of contiguous clusters in one read each */
+static bool
+fw_read(const char *path, uint64_t off, void *dst, uint64_t n)
+{
+	int i = fw_find(path);
+	uint8_t *d = (uint8_t *)dst;
+	uint64_t pos = 0;
+	uint32_t c, guard = 0;
+
+	if (i < 0 || off + n > fw_files[i].size) {
+		return false;
+	}
+	c = fw_files[i].cluster;
+	while (n > 0) {
+		uint32_t run = 1;
+		if (c < 2 || c >= fw_fat_entries || ++guard > fw_fat_entries) {
+			return false;
+		}
+		while (run < 1024 && c + run < fw_fat_entries && fw_fat[c + run - 1] == c + run) {
+			run++;
+		}
+		uint64_t run_bytes = (uint64_t)run * fw_cluster_bytes;
+		if (off < pos + run_bytes) {
+			uint64_t skip = off - pos, take = MIN(n, run_bytes - skip);
+			if (!fat_read(fw_data_off + (uint64_t)(c - 2) * fw_cluster_bytes + skip, d, take)) {
+				return false;
+			}
+			d += take;
+			off += take;
+			n -= take;
+		}
+		pos += run_bytes;
+		c = fat_next(c + run - 1);
+		if (n > 0 && c == 0) {
+			return false;
+		}
+	}
+	return true;
+}
