+/*
+ * laurel: 16-bit register addresses, big-endian on the wire (regmap reg_bits 16), for the
+ * MAX98927/MAX98937 speaker amp at 0x3a (iokit/Kernel/arm/TopazAudio.cpp).
+ */
+int
+sweet_i2c1_write16(uint8_t addr, uint16_t reg, uint8_t val)
+{
+	uint8_t tx[3] = { (uint8_t)(reg >> 8), (uint8_t)reg, val };
+
+	if (!i2c1_ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_i2c1_lock);
+	int err = i2c1_msg(addr, tx, 3, NULL, 0, false);
+	lck_mtx_unlock(&sweet_i2c1_lock);
+	return err;
+}
+
+int
+sweet_i2c1_read16(uint8_t addr, uint16_t reg, uint8_t *val)
+{
+	uint8_t tx[2] = { (uint8_t)(reg >> 8), (uint8_t)reg };
+
+	if (!i2c1_ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&sweet_i2c1_lock);
+	int err = i2c1_msg(addr, tx, 2, NULL, 0, true);
+	if (!err) {
+		err = i2c1_msg(addr, NULL, 0, val, 1, false);
+	}
+	lck_mtx_unlock(&sweet_i2c1_lock);
+	return err;
+}
