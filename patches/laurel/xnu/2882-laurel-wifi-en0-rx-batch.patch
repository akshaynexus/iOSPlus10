+/*
+ * laurel 2882: what the traffic is since the last line. TCP's numbers are the whole kernel's (loopback too). dns: UDP port
+ * 53 only (DNS over TLS or HTTPS is TCP); connects: SYN frames out, repeats count. What the status line cannot say itself.
+ */
+void
+redwood_net_path_line(void)
+{
+	static uint32_t tcp_sent, tcp_rexmt, tcp_rto, tcp_dup;
+	static uint64_t v4[2], v6[2], dns[2], connects, waits;
+	uint32_t s = tcpstat.tcps_sndtotal, r = tcpstat.tcps_sndrexmitpack, t = tcpstat.tcps_rexmttimeo, d = tcpstat.tcps_rcvduppack;
+
+	printf("LAUREL WIFI: path | tcp sent %u retrans %u timeouts %u dup in %u | connects %llu | dns asked %llu answers %llu | "
+	    "v4 out %llu in %llu | v6 out %llu in %llu | sender waited %llu times\n", s - tcp_sent, r - tcp_rexmt, t - tcp_rto, d - tcp_dup,
+	    net_count.connects - connects, net_count.dns[1] - dns[1], net_count.dns[0] - dns[0], net_count.v4[1] - v4[1],
+	    net_count.v4[0] - v4[0], net_count.v6[1] - v6[1], net_count.v6[0] - v6[0], net_count.tx_waits - waits);
+	tcp_sent = s;
+	tcp_rexmt = r;
+	tcp_rto = t;
+	tcp_dup = d;
+	memcpy(v4, net_count.v4, sizeof(v4));
+	memcpy(v6, net_count.v6, sizeof(v6));
+	memcpy(dns, net_count.dns, sizeof(dns));
+	connects = net_count.connects;
+	waits = net_count.tx_waits;
+}
