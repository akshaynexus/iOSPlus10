+/* laurel 2882: one frame's kinds, for the status line. way 0: in, 1: out. `have` bytes of it are at `eth`. */
+static void
+path_count(const uint8_t *eth, size_t have, int way)
+{
+	const uint8_t *ip = eth + ETHER_HDR_LEN, *l4;
+	uint16_t type;
+	unsigned proto;
+
+	if (have < ETHER_HDR_LEN + 1) {
+		return;
+	}
+	type = (uint16_t)(eth[12] << 8 | eth[13]);
+	if (type == ETHERTYPE_IP) {
+		net_count.v4[way]++;
+		if (have < ETHER_HDR_LEN + 20) {
+			return;
+		}
+		proto = ip[9];
+		l4 = ip + 4 * (ip[0] & 0xf);
+	} else if (type == ETHERTYPE_IPV6) {
+		net_count.v6[way]++;
+		if (have < ETHER_HDR_LEN + 40) {
+			return;
+		}
+		proto = ip[6];
+		l4 = ip + 40;
+	} else {
+		return;
+	}
+	if (l4 + 14 > eth + have) {
+		return;
+	}
+	if (proto == IPPROTO_UDP && (way != 0 ? l4[2] << 8 | l4[3] : l4[0] << 8 | l4[1]) == 53) {
+		net_count.dns[way]++;
+	} else if (proto == IPPROTO_TCP && way != 0 && (l4[13] & 0x12) == 0x02) {
+		net_count.connects++;
+	}
+}
