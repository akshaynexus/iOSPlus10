+/*
+ * laurel 2153: one CP fence write of `magic` to GPU address `gpu_va`, read back through `cpu` (cache line cleaned and
+ * invalidated around it: the page may be cached kernel memory). With hw_lock held and the ring idle.
+ */
+static bool
+cp_fence(volatile uint32_t *cpu, uint64_t gpu_va, uint32_t magic, uint64_t *us)
+{
+	uint64_t t0 = mach_absolute_time(), ns;
+	bool fenced = false;
+
+	*cpu = 0;
+	sweet_dcache_flush((vm_offset_t)cpu, 64);
+	emit(pkt7(CP_EVENT_WRITE, 4));
+	emit(CACHE_FLUSH_TS);
+	emit((uint32_t)gpu_va);
+	emit((uint32_t)(gpu_va >> 32));
+	emit(magic);
+	kick();
+	for (int i = 0; i < 10000 && !fenced; i++) {
+		sweet_dcache_flush((vm_offset_t)cpu, 64);
+		fenced = *cpu == magic;
+		if (!fenced) {
+			IODelay(10);
+		}
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	*us = ns / 1000;
+	return fenced && ring_idle(100);
