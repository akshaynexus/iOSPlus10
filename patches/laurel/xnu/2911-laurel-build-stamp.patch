+	laurel_build_early();
+#endif
 
 #if CONFIG_DEV_KMEM
 	bsd_init_kprintf("calling dev_kmem_init\n");
@@ -1054,6 +1059,9 @@
 	/* laurel 2720: the saved RTC offset is on the root volume: apply it before launchd (bsd/dev/laurel_rtc.c). */
 	extern void laurel_rtc_load_saved(void);
 	laurel_rtc_load_saved();
+	/* laurel 2911: the boot image and root stamps; again 30 s later, when the host USB log is attached. */
+	extern void laurel_build_root(void);
+	laurel_build_root();
 #endif
 
 	/* Initialize signal state for process 0. */
