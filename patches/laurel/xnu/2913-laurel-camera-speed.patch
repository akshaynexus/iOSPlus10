 /*
+ * laurel 2913: a pool buffer once more, write-back and read-only, for a CPU reader of what a device wrote (the camera's frames, laurel_cam_dev.c): the reader cleans + invalidates before it
+ * reads. Nothing writes through it, so no line is dirty. Kept for good. NULL: no mapping.
+ */
+extern "C" const void *topaz_gpu_pool_map_cached(uint64_t pa, uint64_t size);
+const void *
+topaz_gpu_pool_map_cached(uint64_t pa, uint64_t size)
+{
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(pa, size, kIODirectionIn | (kIOCopybackCache << kIOMemoryBufferCacheShift), TASK_NULL);
+	IOMemoryMap *map = md != NULL ? md->map(kIOMapCopybackCache | kIOMapReadOnly) : NULL;
+
+	if (map == NULL) {
+		OSSafeReleaseNULL(md);
+		return NULL;
+	}
+	return (const void *)map->getVirtualAddress();
+}
+
+/*
  * laurel 2156: zero a buffer that is out, through its chunk's kernel mapping (the one that covers all of it: lgp
  * buffers never cross a chunk). false: [pa, pa + size) is not such a buffer, nothing is written.
  */
