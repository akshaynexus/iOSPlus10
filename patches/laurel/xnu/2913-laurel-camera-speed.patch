+/*
+ * laurel 2913: the reader's copy. Through the Normal NC mapping every load goes to DRAM with no line fill and no prefetcher, one 3.46 MB frame a time. A write-back, read-only mapping of the
+ * same buffer (nothing writes through it, so no line is ever dirty) is read after a clean + invalidate of the frame, which drops what speculation or the last read left of the old frame: the
+ * VFE has finished this buffer and leaves it alone until reading is -1. Self-check on the first frame: the two mappings show the same bytes, or this copy turns off with one line.
+ */
+static void
+ld_clean_invalidate(const uint8_t *p, size_t n)
+{
+	uint64_t ctr;
+	uintptr_t at, end = (uintptr_t)p + n, line;
+
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r" (ctr));
+	line = 4ul << ((ctr >> 16) & 0xf);
+	for (at = (uintptr_t)p & ~(line - 1); at < end; at += line) {
+		__asm__ volatile ("dc civac, %0" :: "r" (at));
+	}
+	__asm__ volatile ("dsb sy\n\tisb" ::: "memory");
+}
+
+static bool
+ld_cached_same(const uint8_t *nc, const uint8_t *wb, size_t n)
+{
+	static uint8_t a[256], b[256];          /* (cached copies: one reader at a time, the first frame only) */
+
+	for (unsigned i = 0; i < 16; i++) {
+		size_t at = (n - sizeof(a)) / 15 * i & ~(size_t)63;
+
+		memcpy(a, nc + at, sizeof(a));
+		memcpy(b, wb + at, sizeof(b));
+		if (memcmp(a, b, sizeof(a)) != 0) {
+			LCAM_SAY("read: cached copy: off: the frame differs at +%#lx between the mappings: reads stay uncached\n", (unsigned long)at);
+			return false;
+		}
+	}
+	LCAM_SAY("read: cached copy: on: the 2 mappings agree on the first frame\n");
+	return true;
+}
