diff -ruN a/bsd/dev/laurel_cam_clk.c b/bsd/dev/laurel_cam_clk.c
--- a/bsd/dev/laurel_cam_clk.c	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_cam_clk.c	2026-11-01 08:34:00.257190623 +0530
@@ -0,0 +1,205 @@
+/*
+ * laurel_sprout (Mi A3, SM6125) camera (laurel 2771): clocks and power of the RDI path (CSIPHY1, CSID1, ISPIF, VFE0).
+ * Numbers [V external/laurel-kernel-los]: gcc-trinket.c (branches, RCGs, frequency tables, PLL offsets and votes),
+ * trinket-gdsc.dtsi (camss_vfe0 0x1454004, camss_vfe1 0x145403c), trinket-camera.dtsi + laurel_sprout-trinket-camera.dtsi
+ * (clock lists and rates). Runs after lcam_hw_on (camss_top GDSC, camera AHB, camss top AHB).
+ * PLLs: the kernel never programs a PLL; it votes (GCC 0x79000) and uses one only when its mode register reports lock.
+ *   GPLL4 locked: CSIPHY timer + csiphy source 268.8 MHz (GPLL4 main / 3, the rate Android ran: settle count of the
+ *                 library unchanged), VFE 403.2 MHz (GPLL4 main / 2);
+ *   else GPLL0 600 MHz: timer + csiphy 200 MHz (/3; settle count scaled), VFE from GPLL8 480, GPLL9 576 or GPLL6 256.
+ *   CSID1 (csi1 source): 200 MHz from GPLL0 / 3 (mainline camss picks 200 MHz for 4 x 800 Mbps).
+ * VFE1 GDSC and clocks are on too: the ISPIF reset covers both VFE interfaces (mainline camss-ispif.c powers both).
+ * Off = every bit this file set goes back (GDSCs, branch enables, RCG configurations, PLL votes).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include "laurel_cam.h"
+#include "laurel_cam_core.h"
+
+#define GPLL_VOTE               0x79000u
+#define GCC_VOTE2               0x79004u        /* gcc_camss_throttle_rt_axi_clk: bit 26, halt 0x560a8 */
+#define THROTTLE_BIT            (1u << 26)
+#define THROTTLE_HALT           0x560a8u
+#define GDSC_VFE0               0x54004u
+#define GDSC_VFE1               0x5403cu
+#define GDSC_SW_COLLAPSE        (1u << 0)
+#define GDSC_PWR_ON             (1u << 31)
+#define CLK_ENABLE              (1u << 0)
+#define CLK_OFF                 (1u << 31)
+#define RCG_CMD_UPDATE          (1u << 0)
+#define RCG_CFG                 0x4u
+#define RCG_CFG_MASK            (0x1fu | 7u << 8 | 3u << 12)
+
+enum { R_TIMER, R_CSIPHY, R_CSI1, R_VFE0, R_VFE1, NRCG };
+static const uint32_t rcg_reg[NRCG] = { 0x53024, 0x55000, 0x5506c, 0x54010, 0x54048 };
+
+/* in the order of the DT clock lists (ISPIF/CSID/CSIPHY/VFE nodes); hwcg = no halt check (hardware gating) */
+static const struct {
+	uint32_t cbcr;
+	bool hwcg;
+	const char *name;
+} br[] = {
+	{ 0x540a4, false, "ispif_ahb" }, { 0x5508c, false, "csi1_ahb" }, { 0x55084, false, "csi1" },
+	{ 0x55094, false, "csi1rdi" }, { 0x5509c, false, "csi1pix" }, { 0x55088, false, "cphy_csid1" },
+	{ 0x5501c, false, "csiphy1" }, { 0x5303c, false, "csi1phytimer" }, { 0x1d004, true, "ahb2phy_csi" },
+	{ 0x54034, false, "vfe0_ahb" }, { 0x5408c, false, "vfe_vbif_ahb" }, { 0x54090, false, "vfe_vbif_axi" },
+	{ 0x54028, false, "vfe0" }, { 0x54030, false, "vfe0_stream" }, { 0x54074, false, "csi_vfe0" },
+	{ 0x5406c, false, "vfe1_ahb" }, { 0x54060, false, "vfe1" }, { 0x54080, false, "csi_vfe1" },
+};
+#define NBR (sizeof(br) / sizeof(br[0]))
+
+/* PLLs: mode register (bit 31 lock detect) and vote bit */
+enum { P_GPLL0, P_GPLL4, P_GPLL6, P_GPLL8, P_GPLL9, NPLL };
+static const struct {
+	uint32_t mode, vote;
+} pll[NPLL] = { { 0x0000, 1u << 0 }, { 0x4000, 1u << 4 }, { 0x6000, 1u << 6 }, { 0x8000, 1u << 8 }, { 0x9000, 1u << 9 } };
+
+static vm_offset_t gcc;
+static struct {
+	bool saved;
+	uint32_t gdsc0, gdsc1, vote, vote2, rcg[NRCG], cbcr[NBR];
+} was;
+
+static inline uint32_t
+rd(uint32_t o)
+{
+	return *(volatile uint32_t *)(gcc + o);
+}
+
+static inline void
+wr(uint32_t o, uint32_t v)
+{
+	*(volatile uint32_t *)(gcc + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+rcg_set(uint32_t rcg, uint32_t cfg)
+{
+	wr(rcg + RCG_CFG, (rd(rcg + RCG_CFG) & ~RCG_CFG_MASK) | cfg);
+	wr(rcg, rd(rcg) | RCG_CMD_UPDATE);
+	return lcam_wait_bits(gcc + rcg, RCG_CMD_UPDATE, false, 500);
+}
+
+/* vote a PLL and wait up to 200 us for its lock */
+static bool
+pll_on(unsigned p)
+{
+	wr(GPLL_VOTE, rd(GPLL_VOTE) | pll[p].vote);
+	return lcam_wait_bits(gcc + pll[p].mode, 1u << 31, true, 200);
+}
+
+static bool
+gdsc_on(uint32_t reg)
+{
+	if (rd(reg) & GDSC_PWR_ON) {
+		return true;
+	}
+	wr(reg, rd(reg) & ~GDSC_SW_COLLAPSE);
+	return lcam_wait_bits(gcc + reg, GDSC_PWR_ON, true, 1000);
+}
+
+int
+lcam_sclk_on(struct lcam_clk_info *ci, const char **why)
+{
+	uint32_t vfe_cfg = 0;
+
+	gcc = lcam_gcc();
+	if (!gcc) {
+		*why = "GCC not mapped";
+		return ENODEV;
+	}
+	was.gdsc0 = rd(GDSC_VFE0);
+	was.gdsc1 = rd(GDSC_VFE1);
+	was.vote = rd(GPLL_VOTE);
+	was.vote2 = rd(GCC_VOTE2);
+	for (unsigned i = 0; i < NRCG; i++) {
+		was.rcg[i] = rd(rcg_reg[i] + RCG_CFG);
+	}
+	for (unsigned i = 0; i < NBR; i++) {
+		was.cbcr[i] = rd(br[i].cbcr);
+	}
+	was.saved = true;
+
+	if (!pll_on(P_GPLL0)) {
+		*why = "GPLL0 not locked";
+		return ENXIO;
+	}
+	if (pll_on(P_GPLL4)) {
+		ci->timer_hz = ci->csiphy_hz = 268800000;       /* GPLL4 main 806.4 MHz / 3: src 5, hid 5 */
+		ci->vfe_hz = 403200000;                         /* / 2: hid 3 */
+		vfe_cfg = 5u << 8 | 3u;
+	} else {
+		ci->timer_hz = ci->csiphy_hz = 200000000;       /* GPLL0 early 600 MHz / 3: src 1, hid 5 */
+		if (pll_on(P_GPLL8)) {
+			ci->vfe_hz = 480000000;                 /* GPLL8 main / 1: src 4 */
+			vfe_cfg = 4u << 8 | 1u;
+		} else if (pll_on(P_GPLL9)) {
+			ci->vfe_hz = 576000000;                 /* GPLL9 main / 1: src 2 */
+			vfe_cfg = 2u << 8 | 1u;
+		} else if (pll_on(P_GPLL6)) {
+			ci->vfe_hz = 256000000;                 /* GPLL6 early / 3: src 3 */
+			vfe_cfg = 3u << 8 | 5u;
+		} else {
+			LCAM_SAY("clk: PLL modes: GPLL4 %#x GPLL6 %#x GPLL8 %#x GPLL9 %#x\n", rd(pll[P_GPLL4].mode),
+			    rd(pll[P_GPLL6].mode), rd(pll[P_GPLL8].mode), rd(pll[P_GPLL9].mode));
+			*why = "no PLL for the VFE clock is locked (GPLL4/6/8/9)";
+			return ENXIO;
+		}
+	}
+	ci->csid_hz = 200000000;
+	uint32_t tcfg = ci->timer_hz == 268800000 ? (5u << 8 | 5u) : (1u << 8 | 5u);
+	if (!rcg_set(rcg_reg[R_TIMER], tcfg) || !rcg_set(rcg_reg[R_CSIPHY], tcfg) || !rcg_set(rcg_reg[R_CSI1], 1u << 8 | 5u) ||
+	    !rcg_set(rcg_reg[R_VFE0], vfe_cfg) || !rcg_set(rcg_reg[R_VFE1], vfe_cfg)) {
+		*why = "a camera clock source does not switch (RCG update stuck)";
+		return ENXIO;
+	}
+	if (!gdsc_on(GDSC_VFE0) || !gdsc_on(GDSC_VFE1)) {
+		LCAM_SAY("clk: VFE GDSCs %#x %#x\n", rd(GDSC_VFE0), rd(GDSC_VFE1));
+		*why = "VFE GDSC does not power on";
+		return ENXIO;
+	}
+	wr(GCC_VOTE2, rd(GCC_VOTE2) | THROTTLE_BIT);
+	for (unsigned i = 0; i < NBR; i++) {
+		wr(br[i].cbcr, rd(br[i].cbcr) | CLK_ENABLE);
+		if (!br[i].hwcg && !lcam_wait_bits(gcc + br[i].cbcr, CLK_OFF, false, 500)) {
+			LCAM_SAY("clk: %s CBCR %#x stays off\n", br[i].name, rd(br[i].cbcr));
+			*why = "a camera branch clock does not run (see the clk: line)";
+			return ENXIO;
+		}
+	}
+	if (!lcam_wait_bits(gcc + THROTTLE_HALT, CLK_OFF, false, 500)) {
+		LCAM_SAY("clk: throttle_rt_axi %#x (voted): goes on without the halt check\n", rd(THROTTLE_HALT));
+	}
+	return 0;
+}
+
+void
+lcam_sclk_off(void)
+{
+	if (!gcc || !was.saved) {
+		return;
+	}
+	for (unsigned i = NBR; i-- > 0;) {
+		wr(br[i].cbcr, (rd(br[i].cbcr) & ~CLK_ENABLE) | (was.cbcr[i] & CLK_ENABLE));
+	}
+	wr(GCC_VOTE2, (rd(GCC_VOTE2) & ~THROTTLE_BIT) | (was.vote2 & THROTTLE_BIT));
+	if (!(was.gdsc1 & GDSC_PWR_ON)) {
+		wr(GDSC_VFE1, rd(GDSC_VFE1) | GDSC_SW_COLLAPSE);
+	}
+	if (!(was.gdsc0 & GDSC_PWR_ON)) {
+		wr(GDSC_VFE0, rd(GDSC_VFE0) | GDSC_SW_COLLAPSE);
+	}
+	for (unsigned i = 0; i < NRCG; i++) {
+		(void)rcg_set(rcg_reg[i], was.rcg[i] & RCG_CFG_MASK);
+	}
+	/* our PLL votes only (GPLL0 stays: the boot voted it, the CCI uses it) */
+	uint32_t ours = (pll[P_GPLL4].vote | pll[P_GPLL6].vote | pll[P_GPLL8].vote | pll[P_GPLL9].vote) & ~was.vote;
+	wr(GPLL_VOTE, rd(GPLL_VOTE) & ~ours);
+	was.saved = false;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN a/bsd/dev/laurel_cam_csi.c b/bsd/dev/laurel_cam_csi.c
--- a/bsd/dev/laurel_cam_csi.c	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_cam_csi.c	2026-11-01 08:40:15.341440038 +0530
@@ -0,0 +1,239 @@
+/*
+ * laurel_sprout (Mi A3, SM6125) camera (laurel 2771): CSIPHY1 (D-PHY) and CSID1 of the rear camera RDI path
+ * (ISPIF: laurel_cam_ispif.c).
+ * Values [V external/laurel-kernel-los camera_v2]: msm_csiphy.c msm_csiphy_2phase_lane_config + msm_csiphy_3_5_hwreg.h
+ * (compatible qcom,csiphy-v3.5, CSI_3PHASE_HW used as D-PHY), msm_csid.c + msm_csid_3_5_hwreg.h (qcom,csid-v5.0),
+ * msm_ispif.c + msm_ispif_hwreg_v3.h; cross-checked with mainline camss-csiphy-3ph-1-0.c / camss-csid-4-7.c /
+ * camss-ispif.c (sdm660). Where the two differ, the downstream value is used (this phone ran it).
+ *   CSIPHY1 0x1629000, its clock mux 0x5c00124 (one per PHY: 0x5c00120 + 4n; low nibble = CSID core 1)
+ *   CSID1 0x5c30400, ISPIF 0x5c31000, ISPIF RDI clock mux 0x5c00028 (VFE0 RDI0 = CSID1: low nibble 1)
+ * CID 0 = VC0 everywhere (CSID LUT byte 0, ISPIF CID mask bit 0, VFE RDI0 M0 select 0).
+ * No interrupt line is used: the CSIPHY/CSID/ISPIF status words are read for the self-check lines.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include "laurel_cam.h"
+#include "laurel_cam_core.h"
+#include "laurel_cam_rdi.h"
+
+#define CAMSS_TOP_PA            0x05c00000u
+#define CSIPHY1_PA              0x01629000u
+#define CSID1_PA                0x05c30400u
+#define TOP_CSIPHY1_MUX         0x124u
+
+static vm_offset_t top, phy, csid;
+static bool tpg_on;
+
+static inline uint32_t
+rd(vm_offset_t b, uint32_t o)
+{
+	return *(volatile uint32_t *)(b + o);
+}
+
+static inline void
+wr(vm_offset_t b, uint32_t o, uint32_t v)
+{
+	*(volatile uint32_t *)(b + o) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static bool
+mapped(void)
+{
+	if (!top) {
+		top = lcam_map(CAMSS_TOP_PA, 0x1000);
+		phy = lcam_map(CSIPHY1_PA, 0x1000);
+		csid = lcam_map(CSID1_PA, 0x400);
+	}
+	return top && phy && csid;
+}
+
+/* ---- CSIPHY1 ---------------------------------------------------------------------------------------------- */
+
+static const uint8_t phy_irq_mask[11] = { 0xff, 0xff, 0xfb, 0xff, 0x7f, 0xff, 0xff, 0xef, 0xff, 0xff, 0xff };
+
+static void
+phy_irq_clear(void)
+{
+	for (uint32_t i = 0; i < 11; i++) {
+		uint32_t s = rd(phy, 0x8b0 + 4 * i);
+		wr(phy, 0x858 + 4 * i, s);
+		wr(phy, 0x858 + 4 * i, 0);
+	}
+	wr(phy, 0x828, 1);
+	wr(phy, 0x828, 0);
+}
+
+int
+lcam_csiphy_on(uint32_t lanes, uint32_t settle, const char **why)
+{
+	uint32_t mask = lcam_csiphy_mask(lanes);
+
+	if (!mapped()) {
+		*why = "CSIPHY/CSID mapping failed";
+		return ENOMEM;
+	}
+	if (mask == 0) {
+		*why = "lane count not 1..4";
+		return EINVAL;
+	}
+	wr(phy, 0x800, 1);                      /* msm_csiphy_3ph_reset: cmn_ctrl0 */
+	lcam_sleep_ms(6);
+	wr(phy, 0x800, 0);
+	wr(top, TOP_CSIPHY1_MUX, (rd(top, TOP_CSIPHY1_MUX) & ~0xfu) | 1u);      /* CSIPHY1 -> CSID1 */
+	wr(phy, 0x814, lcam_csiphy_enable(mask));      /* cmn_ctrl5: lane enable (0xd5 for 4 lanes) */
+	wr(phy, 0x818, 1);                      /* cmn_ctrl6: common power-down off */
+	for (uint32_t i = 0; i < 5; i++) {
+		uint32_t l = lcam_csiphy_lane(i);
+		bool clk = i == 1;
+		if (!(mask & (1u << i))) {
+			continue;
+		}
+		wr(phy, l + 0x30, 0x02);        /* cfg7 */
+		wr(phy, l + 0x2c, 0x01);        /* cfg6 */
+		wr(phy, l + 0x34, 0x01);        /* cfg8 */
+		wr(phy, l + 0x28, clk ? 0x04 : 0x00);   /* misc1 */
+		wr(phy, l + 0x3c, 0xb8);        /* ctrl15 */
+		wr(phy, l + 0x04, 0x08);        /* cfg2 */
+		wr(phy, l + 0x08, settle & 0xffu);      /* cfg3: settle count (clock lane too) */
+		if (clk) {
+			wr(phy, 0x700, 0xc0);   /* lnck_cfg1 */
+			wr(phy, 0x70c, 0xa5);   /* cfg4 */
+		} else {
+			wr(phy, l + 0x00, 0xd7);        /* cfg1 */
+		}
+		wr(phy, l + 0x10, 0x50);        /* cfg5 */
+		wr(phy, l + 0x38, 0x01);        /* cfg9 */
+		wr(phy, l + 0x1c, 0x0a);        /* test_imp */
+	}
+	for (uint32_t i = 0; i < 11; i++) {
+		wr(phy, 0x82c + 4 * i, phy_irq_mask[i]);  /* status bits latch; the GIC line (SPI 73) stays off */
+	}
+	phy_irq_clear();
+	return 0;
+}
+
+void
+lcam_csiphy_off(void)
+{
+	if (!phy) {
+		return;
+	}
+	for (uint32_t i = 0; i < 11; i++) {
+		wr(phy, 0x82c + 4 * i, 0);
+	}
+	phy_irq_clear();
+	wr(phy, 0x814, 0);
+	wr(phy, 0x818, 0);
+	wr(top, TOP_CSIPHY1_MUX, rd(top, TOP_CSIPHY1_MUX) & ~0xfu);
+}
+
+/* ---- CSID1 ------------------------------------------------------------------------------------------------ */
+
+#define CSID_HW_VERSION         0x000u
+#define CSID_CORE_CTRL_0        0x004u
+#define CSID_CORE_CTRL_1        0x008u
+#define CSID_RST_CMD            0x010u
+#define CSID_CID_LUT_VC0        0x014u
+#define CSID_CID0_CFG           0x024u
+#define CSID_IRQ_CLEAR          0x064u
+#define CSID_IRQ_MASK           0x068u
+#define CSID_IRQ_STATUS         0x06cu
+#define CSID_STATS_PKTS         0x098u
+#define CSID_STATS_ECC          0x09cu
+#define CSID_STATS_CRC          0x0a0u
+#define CSID_TG_CTRL            0x0a8u
+#define CSID_TG_VC_CFG          0x0acu
+#define CSID_TG_DT0_CFG_0       0x0b4u
+#define CSID_TG_DT0_CFG_1       0x0b8u
+#define CSID_TG_DT0_CFG_2       0x0bcu
+#define CSID_RST_ALL            0x7ffffu
+#define CSID_RST_DONE           (1u << 11)
+
+static int
+csid_reset(void)
+{
+	wr(csid, CSID_IRQ_CLEAR, rd(csid, CSID_IRQ_STATUS));
+	wr(csid, CSID_RST_CMD, CSID_RST_ALL);
+	bool ok = lcam_wait_bits(csid + CSID_IRQ_STATUS, CSID_RST_DONE, true, 100000);
+	wr(csid, CSID_IRQ_CLEAR, rd(csid, CSID_IRQ_STATUS));
+	return ok ? 0 : ETIMEDOUT;
+}
+
+int
+lcam_csid_on(uint32_t lanes, uint32_t xml_assign, uint8_t dt, uint8_t decode, bool tpg, uint16_t w, uint16_t h,
+    const char **why)
+{
+	uint32_t ctrl0 = lcam_csid_ctrl0(lanes, xml_assign), ver;
+
+	if (!mapped()) {
+		*why = "CSIPHY/CSID mapping failed";
+		return ENOMEM;
+	}
+	if (ctrl0 == 0 || dt < 0x12 || dt > 0x37) {
+		*why = "CSID lane assign or data type out of range";
+		return EINVAL;
+	}
+	ver = rd(csid, CSID_HW_VERSION);
+	if (csid_reset() != 0) {
+		LCAM_SAY("csid: version %#x, reset: no RST_DONE (status %#x)\n", ver, rd(csid, CSID_IRQ_STATUS));
+		*why = "CSID reset does not finish";
+		return ETIMEDOUT;
+	}
+	tpg_on = tpg;
+	if (tpg) {
+		/* test generator (camss-csid-4-7.c): blanking V 0x7f, H 0x3ff; one DT; payload 0 = incrementing */
+		wr(csid, CSID_TG_VC_CFG, 0x7fu << 24 | 0x3ffu << 13);
+		wr(csid, CSID_TG_DT0_CFG_0, (uint32_t)lcam_raw10_stride(w) << 16 | h);
+		wr(csid, CSID_TG_DT0_CFG_1, dt);
+		wr(csid, CSID_TG_DT0_CFG_2, 0);
+	} else {
+		wr(csid, CSID_CORE_CTRL_0, ctrl0 | (ver >= 0x30000000u ? 0 : 0xfu << 10));
+		if (ver >= 0x30000000u) {
+			wr(csid, CSID_CORE_CTRL_1, 1u << 17 | 0xfu);  /* phy_sel = CSIPHY1, error/ECC enables */
+		}
+	}
+	wr(csid, CSID_CID_LUT_VC0, (rd(csid, CSID_CID_LUT_VC0) & ~0xffu) | dt);   /* CID 0 = VC0 + dt */
+	wr(csid, CSID_CID0_CFG, (uint32_t)decode << 4 | 0x3u);         /* decode format, ISPIF + RDI enable */
+	if (tpg) {
+		wr(csid, CSID_TG_CTRL, 0x00a06437u);
+	}
+	return 0;
+}
+
+void
+lcam_csid_off(void)
+{
+	if (!csid) {
+		return;
+	}
+	if (tpg_on) {
+		wr(csid, CSID_TG_CTRL, 0x00a06436u);
+		tpg_on = false;
+	}
+	wr(csid, CSID_IRQ_CLEAR, rd(csid, CSID_IRQ_STATUS));
+	wr(csid, CSID_IRQ_MASK, 0);
+	wr(csid, CSID_RST_CMD, CSID_RST_ALL);
+	(void)lcam_wait_bits(csid + CSID_IRQ_STATUS, CSID_RST_DONE, true, 100000);
+	wr(csid, CSID_IRQ_CLEAR, rd(csid, CSID_IRQ_STATUS));
+}
+
+void
+lcam_csid_counts(uint32_t *pkts, uint32_t *ecc, uint32_t *crc, uint32_t *irq, uint32_t *physt)
+{
+	if (!csid) {
+		*pkts = *ecc = *crc = *irq = *physt = 0;
+		return;
+	}
+	*pkts = rd(csid, CSID_STATS_PKTS);
+	*ecc = rd(csid, CSID_STATS_ECC);
+	*crc = rd(csid, CSID_STATS_CRC);
+	*irq = rd(csid, CSID_IRQ_STATUS);
+	*physt = rd(phy, 0x8b0) | rd(phy, 0x8b4) << 8 | rd(phy, 0x8b8) << 16 | rd(phy, 0x8bc) << 24;
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN a/bsd/dev/laurel_cam_ctl.c b/bsd/dev/laurel_cam_ctl.c
--- a/bsd/dev/laurel_cam_ctl.c	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_cam_ctl.c	2026-11-01 08:39:59.400964308 +0530
@@ -0,0 +1,203 @@
+/*
+ * laurel_sprout (Mi A3, SM6125) camera (laurel 2771): the stream thread and the USB commands of the rear RDI path.
+ * Thread: waits for the root, loads the sensor library, takes 3 buffers from the GPU pool, the SMMU identity of the
+ * VFE streams, runs the 2 s self-check capture (laurel_cam_stream.c), then waits for "camframe" requests.
+ * USB command server (sweet_usb.c, UDP 5141, only from 192.168.7.1; host: op10tool camframe, scripts/laurel/cam-frame.sh):
+ *   camframe     a new capture of 1.5 s; the last frame becomes the kept frame (a new generation)
+ *   caminfo      generation, state (busy/ready/none/off), size, Bayer order, frame count, fps, mean, exposure, gain
+ *   camread G O  up to 1400 bytes of the kept frame of generation G from offset O, behind the 16-byte "LCF1" header
+ * The commands never block: the frame lock is only tried (reply "error: camera busy, retry").
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/thread.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include "laurel_cam.h"
+#include "laurel_cam_core.h"
+#include "laurel_cam_st.h"
+
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern kern_return_t thread_terminate(thread_t);
+extern int topaz_root_mounted(void);
+extern uint64_t topaz_gpu_pool_alloc(uint64_t size, void **va);
+extern bool topaz_smmu_identity(uint32_t sid, uint32_t mask, const char *name);
+
+static int
+prepare(char *line, size_t len)
+{
+	const char *why = "";
+	int mode;
+
+	for (unsigned t = 0; !topaz_root_mounted(); t++) {
+		if (t == 600) {
+			snprintf(line, len, "off: no root after 300 s (sensor tables are read from it)");
+			return ENOENT;
+		}
+		lcam_sleep_ms(500);
+	}
+	if (lcam_sensor_load(st.chip->name, &st.lib, &mode, &why) != 0 || lcam_lib_mode(st.lib, (uint32_t)mode, &st.m)) {
+		snprintf(line, len, "off: %s", why);
+		return ENOENT;
+	}
+	for (unsigned i = 0; i < LST_NBUF; i++) {
+		void *va = NULL;
+		st.pa[i] = topaz_gpu_pool_alloc(LST_BYTES, &va);
+		st.va[i] = va;
+		if (st.pa[i] == 0 || va == NULL || st.pa[i] + LST_BYTES > 0x100000000ull) {
+			snprintf(line, len, "off: no frame buffer below 4 GiB from the GPU pool (gpu=0, or no "
+			    "/chosen laurel-ram-reserved in the ADT)");
+			return ENOMEM;          /* (buffers already taken stay with the camera: no free path needed) */
+		}
+		bzero(va, LST_BYTES);
+	}
+	if (!topaz_smmu_identity(0x420, 0, "camera VFE") || !topaz_smmu_identity(0x421, 2, "camera VFE 2")) {
+		snprintf(line, len, "off: apps SMMU: no identity context for the VFE streams 0x420/0x421");
+		return ENXIO;
+	}
+	return 0;
+}
+
+static void
+stream_thread(void *arg __unused, wait_result_t w __unused)
+{
+	char line[sizeof(st.line)];
+
+	if (prepare(line, sizeof(line)) != 0) {
+		st.off = true;
+		lcam_stream_say(line);
+		(void)thread_terminate(current_thread());
+		return;
+	}
+	(void)lcam_capture(2000, line, sizeof(line));
+	lcam_stream_say(line);
+	st.off = strncmp(line, "off:", 4) == 0 || st.tpg;
+	while (!st.off) {
+		lcam_sleep_ms(50);
+		if (st.request) {
+			st.request = false;
+			(void)lcam_capture(1500, line, sizeof(line));
+			lcam_stream_say(line);
+		}
+	}
+	(void)thread_terminate(current_thread());
+}
+
+void
+lcam_stream_start(const struct lcam_slot *s, const struct lcam_sensor *chip)
+{
+	thread_t th;
+
+	st.slot = s;
+	st.chip = chip;
+	if (kernel_thread_start(stream_thread, NULL, &th) != KERN_SUCCESS) {
+		st.off = true;
+		lcam_stream_say("off: no stream thread");
+		return;
+	}
+	thread_deallocate(th);
+}
+
+/* ---- for laurel_cam_ctl.c ---------------------------------------------------------------------------------- */
+
+bool
+lcam_frame_get(uint32_t *gen, const uint8_t **buf, uint32_t *bytes)
+{
+	if (!lck_mtx_try_lock(&lst_lock)) {
+		return false;
+	}
+	if (st.busy || st.kept < 0) {
+		lck_mtx_unlock(&lst_lock);
+		return false;
+	}
+	*gen = st.gen;
+	*buf = st.va[st.kept];
+	*bytes = LST_BYTES;
+	return true;                            /* locked until lcam_frame_put */
+}
+
+void
+lcam_frame_put(void)
+{
+	lck_mtx_unlock(&lst_lock);
+}
+
+void
+lcam_frame_info(char *s, size_t n)
+{
+	if (!lck_mtx_try_lock(&lst_lock)) {
+		snprintf(s, n, "caminfo state busy");
+		return;
+	}
+	snprintf(s, n, "caminfo gen %u state %s w %u h %u stride %u bytes %u bits 10 bayer %s frame %u fps %u.%u mean %u "
+	    "exposure %u gain %u runs %u", st.gen, st.busy ? "busy" : st.kept < 0 ? (st.off ? "off" : "none") : "ready",
+	    LST_W, LST_H, LST_STRIDE, LST_BYTES, st.tpg ? "TPG" : (st.lib && st.lib->filter == LCAM_BAYER_RGGB) ? "RGGB" : "BGGR",
+	    st.frames, st.fps10 / 10, st.fps10 % 10, st.mean, st.ae.lines, st.ae.gain, st.runs);
+	lck_mtx_unlock(&lst_lock);
+}
+
+bool
+lcam_capture_request(char *reply, size_t n)
+{
+	if (st.slot == NULL || st.off) {
+		snprintf(reply, n, "error: camera off: %s", st.line[0] ? st.line : "no rear sensor or camera=0");
+		return false;
+	}
+	if (st.busy || st.request) {
+		snprintf(reply, n, "ok camframe: capture running (gen %u)", st.gen);
+		return true;
+	}
+	st.request = true;
+	snprintf(reply, n, "ok camframe: capture started (kept frame gen %u goes away; poll caminfo)", st.gen);
+	return true;
+}
+
+/*
+ * sweet_usb.c: a command word of the USB command server. -1: not a camera command; else the reply length in out
+ * (text without NUL, or the binary camread reply). Never blocks, runs in ud_thread.
+ */
+int laurel_cam_ctl(const char *cmd, uint8_t *out, uint32_t max);
+int
+laurel_cam_ctl(const char *cmd, uint8_t *out, uint32_t max)
+{
+	char *text = (char *)out;
+	uint32_t want, gen, off, bytes;
+	const uint8_t *buf;
+
+	if (max < LCAM_READ_HDR + LCAM_READ_MAX || strncmp(cmd, "cam", 3) != 0) {
+		return -1;
+	}
+	if (strcmp(cmd, "camframe") == 0) {
+		(void)lcam_capture_request(text, max);
+		return (int)strlen(text);
+	}
+	if (strcmp(cmd, "caminfo") == 0) {
+		lcam_frame_info(text, max);
+		return (int)strlen(text);
+	}
+	if (strncmp(cmd, "camread", 7) != 0) {
+		return -1;
+	}
+	if (!lcam_parse_read(cmd + 7, &want, &off)) {
+		snprintf(text, max, "error: camread <generation> <offset>");
+		return (int)strlen(text);
+	}
+	if (!lcam_frame_get(&gen, &buf, &bytes)) {
+		snprintf(text, max, "error: camera busy or no kept frame, retry (caminfo)");
+		return (int)strlen(text);
+	}
+	if (want != gen || off >= bytes) {
+		lcam_frame_put();
+		snprintf(text, max, "error: no such frame part (kept generation %u, %u bytes)", gen, bytes);
+		return (int)strlen(text);
+	}
+	uint32_t n = bytes - off < LCAM_READ_MAX ? bytes - off : LCAM_READ_MAX;
+	lcam_read_hdr(out, gen, off, n);
+	memcpy(out + LCAM_READ_HDR, buf + off, n);
+	lcam_frame_put();
+	return (int)(LCAM_READ_HDR + n);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
