+	gpu_pool_base = base;
+	gpu_pool_size = GPU_POOL_TOP - base;
+	if (gpu_pool_size > GPU_POOL_MAX) {
+		gpu_pool_size = GPU_POOL_MAX;
+	}
+	gpu_pool_size &= ~(GPU_POOL_CHUNK - 1);
+	return true;
