+/* laurel: place the pool (see GPU_POOL_LOW); false: no room, the GPU uses kernel memory below 4 GiB */
+static bool
+gpu_pool_place(void)
+{
+	uint64_t kend = (uint64_t)gPhysBase + (uint64_t)gPhysSize;
+	uint64_t base = GPU_POOL_LOW;
+
+	if (gPhysBase < GPU_POOL_TOP && kend > GPU_POOL_LOW) {
+		/* the kernel's RAM reaches into [LOW, TOP): the pool starts after it */
+		base = (kend + GPU_POOL_CHUNK - 1) & ~(GPU_POOL_CHUNK - 1);
+		if (gPhysBase < GPU_POOL_LOW + GPU_POOL_MIN && gPhysBase > GPU_POOL_LOW) {
+			return false;                   /* (a window starting inside the pool's place: no room below it either) */
+		}
+	}
+	if (base < GPU_POOL_LOW || base + GPU_POOL_MIN > GPU_POOL_TOP) {
+		return false;                           /* no 128 MB of DDR left outside the kernel below the modem pool */
