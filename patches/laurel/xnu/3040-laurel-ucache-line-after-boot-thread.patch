+			printf("LAUREL UCACHE: off: %s (CTR_EL0 0x%llx, CLIDR_EL1 0x%llx)\n", laurel_ucache_why, laurel_ucache_ctr, laurel_ucache_clidr);
 		} else {
 			printf("LAUREL UCACHE: on: EL0 cache maintenance by VA is trapped and done with a clean first, so a JIT's new code is what the core fetches: CTR_EL0 0x%llx (IDC 0, DIC %llu), CLIDR_EL1 LoUU %llu LoUIS %llu (kill switch laurelucache=0)\n",
-			    ctr, (ctr >> 29) & 1, (clidr >> 27) & 7, (clidr >> 21) & 7);
+			    laurel_ucache_ctr, (laurel_ucache_ctr >> 29) & 1, (laurel_ucache_clidr >> 27) & 7, (laurel_ucache_clidr >> 21) & 7);
 		}
 	}
 	if (laurel_ucache_on) {
