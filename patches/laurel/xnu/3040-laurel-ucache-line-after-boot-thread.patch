 #if __has_include(<vm/vm_map_xnu.h>)
 #include <vm/vm_map_xnu.h>              /* xnu-12377: current_map(), vm_map_pmap() */
@@ -31,6 +32,9 @@
 uint32_t laurel_ucache_on;              /* EL0 cache maintenance by VA traps on this kernel */
 static int laurel_ucache_mode = -1;     /* -1 undecided, 0 off, 1 on */
 static uint64_t laurel_ucache_ops;      /* instructions done here */
+static const char *laurel_ucache_why;   /* why it is off, for the line */
+static uint64_t laurel_ucache_ctr, laurel_ucache_clidr;
+static int laurel_ucache_said;          /* the line is out */
 
 /* each CPU as it starts and as it wakes (start.s writes SCTLR_EL1_DEFAULT, UCI set, each time) */
 void laurel_ucache_apply(void);
@@ -43,6 +47,7 @@
 		uint32_t on = 1;
 		const char *why = NULL;
 
+		/* PE_parse_boot_argn is good this early: wfe_timeout_configure(), right before the first call, reads the boot line the same way */
 		(void)PE_parse_boot_argn("laurelucache", &on, sizeof(on));
 		if (!on) {
 			why = "kill switch laurelucache=0";
@@ -51,11 +56,26 @@
 		}
 		laurel_ucache_mode = why == NULL ? 1 : 0;
 		laurel_ucache_on = laurel_ucache_mode;
-		if (why != NULL) {
-			printf("LAUREL UCACHE: off: %s (CTR_EL0 0x%llx, CLIDR_EL1 0x%llx)\n", why, ctr, clidr);
+		laurel_ucache_why = why;
+		laurel_ucache_ctr = ctr;
+		laurel_ucache_clidr = clidr;
+	}
+	/*
+	 * laurel 3040: no printf before the boot thread exists. The first call is in arm_init() right after PE_init_platform(FALSE):
+	 * TPIDR_EL1 is still 0 there (start.s clears it; arm_init sets the boot thread after ml_parse_cpu_topology), the console is not
+	 * up, and printf -> os_log -> counter_inc -> current_thread()->machine faults; the exception vector reads TPIDR_EL1 again and
+	 * faults again: a silent hang with no panic text ([V phone 2026-11-07 03:42: "SWEET EARLY 2: PE_init_platform done" was the
+	 * last line; the kill switch did not help, its line printed from the same place). The line waits for the first call after
+	 * kernel_startup_bootstrap() (startup_phase >= STARTUP_SUB_TUNABLES): the second call of arm_init(), right before
+	 * PE_init_platform(TRUE), whose "iBoot version" line is the first printf of a good boot. The SCTLR write below runs at every call.
+	 */
+	if (!laurel_ucache_said && startup_phase >= STARTUP_SUB_TUNABLES) {
+		laurel_ucache_said = 1;
