+/*
+ * laurel 2200: GPIO 88 falling edge latched in TLMM (Linux msm_gpio_irq_set_type for IRQ_TYPE_EDGE_FALLING,
+ * without the enable bit: no summary interrupt). false: the configuration does not read back.
+ */
+static bool
+touch_latch_setup(void)
+{
+	uint32_t off = TOUCH_INTR_CFG(TOUCH_PIN_IRQ);
+	uint32_t v = (touch_rd(st.west, off) & ~TOUCH_INTR_MASK) | TOUCH_INTR_FALL;
+	touch_wr(st.west, off, v);
+	touch_wr(st.west, TOUCH_INTR_STATUS(TOUCH_PIN_IRQ), 0);
+	return (touch_rd(st.west, off) & TOUCH_INTR_MASK) == TOUCH_INTR_FALL;
+}
+
+/* laurel 2200: an edge came since the last call (the latch is cleared) */
+static bool
+touch_latch_take(void)
+{
+	if (!(touch_rd(st.west, TOUCH_INTR_STATUS(TOUCH_PIN_IRQ)) & 1u)) {
+		return false;
+	}
+	touch_wr(st.west, TOUCH_INTR_STATUS(TOUCH_PIN_IRQ), 0);
+	return true;
+}
