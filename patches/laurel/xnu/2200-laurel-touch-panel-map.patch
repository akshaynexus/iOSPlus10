+/*
+ * laurel 2200: raw IC coordinates -> panel pixels. false: outside every known grid (the frame is dropped).
+ * The first value past the DT grid moves the grid once to the vendor's other known one.
+ */
+static bool
+touch_map(unsigned px, unsigned py, int *x, int *y)
+{
+	if ((px >= st.raw_w || py >= st.raw_h) && !st.grown && px < st.alt_w && py < st.alt_h) {
+		printf("LAUREL TOUCH: raw %u,%u outside %ux%u: grid is now %ux%u\n",
+		    px, py, st.raw_w, st.raw_h, st.alt_w, st.alt_h);
+		st.raw_w = st.alt_w;
+		st.raw_h = st.alt_h;
+		st.grown = true;
+	}
+	if (px >= st.raw_w || py >= st.raw_h) {
+		return false;
+	}
+	*x = (int)((px * st.pan_w + st.raw_w / 2u) / st.raw_w);
+	*y = (int)((py * st.pan_h + st.raw_h / 2u) / st.raw_h);
+	*x = *x >= (int)st.pan_w ? (int)st.pan_w - 1 : *x;
+	*y = *y >= (int)st.pan_h ? (int)st.pan_h - 1 : *y;
+	return true;
+}
