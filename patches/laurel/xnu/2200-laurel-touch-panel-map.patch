+/* laurel 2200: handshake of the gtx8 (Normandy) event block */
+static int
+touch_gtx8_ack(void)
+{
+	const uint8_t ack[3] = {GTX8_COORD_REG >> 8, GTX8_COORD_REG & 0xffu, 0};
+	return touch_msg(0x5d, ack, sizeof(ack), NULL, 0, false);
+}
+
+/* laurel 2200: Goodix GT9883 (goodix_gtx8 goodix_touch_handler, IC_TYPE_NORMANDY) */
+static int
+touch_gtx8(void)
+{
+	uint8_t buf[4 + 8 * TOUCH_MAX];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(0x5d, GTX8_COORD_REG, true, buf, 12);
+	if (err) {
+		return err;
+	}
+	if (!(buf[0] & 0x80u)) {
+		return 0;       /* no touch event (requests and gestures are not serviced) */
+	}
+	unsigned n = buf[1] & 15u;
+	if (n > TOUCH_MAX) {
+		(void)touch_gtx8_ack();
+		return EIO;
+	}
+	if (n > 1) {
+		err = touch_read(0x5d, GTX8_COORD_REG + 12u, true, buf + 12, (n - 1u) * 8u);
+		if (err) {
+			(void)touch_gtx8_ack();
+			return err;
+		}
+	}
+	uint8_t sum = 0;
+	for (unsigned i = 0; i < n * 8u + 4u; ++i) {
+		sum = (uint8_t)(sum + buf[i]);
+	}
+	if (sum != 0) {
+		(void)touch_gtx8_ack();
+		return EIO;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + 2 + 8u * i;
+		unsigned id = p[0] & 15u;
+		if (p[0] >= 0x80u) {
+			continue;       /* pen record */
+		}
+		unsigned px = p[1] | ((unsigned)p[2] << 8), py = p[3] | ((unsigned)p[4] << 8);
+		if (id >= TOUCH_MAX || (mask & (1u << id)) || !touch_map(px, py, &x[id], &y[id])) {
+			(void)touch_gtx8_ack();
+			return EIO;
+		}
+		mask |= 1u << id;
+	}
+	err = touch_gtx8_ack();
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
