+static void
+sweet_ufs_strategy(buf_t bp)
+{
+	int error = 0;
+	uint64_t off = (uint64_t)buf_blkno(bp) * su.secsize;
+	uint32_t count = buf_count(bp);
+	uint64_t part_bytes = ldb_bsd_blocks() * UFS_BLOCK;     /* laurel 2950 */
+
+	bool rd = buf_flags(bp) & B_READ;
+
+	buf_setresid(bp, count);
+	if (!rd && !su.writable) {
+		error = EROFS;
+		goto done;
+	}
+	if (off > part_bytes || count > part_bytes - off) {
+		error = EINVAL;
+		goto done;
+	}
+	if (count == 0) {
+		goto done;
+	}
+	if (rd && (buf_flags(bp) & B_ASYNC) && luq_async_put(bp)) {
+		return;
+	}
+	ufs_bp_io(bp);
+	return;
+
