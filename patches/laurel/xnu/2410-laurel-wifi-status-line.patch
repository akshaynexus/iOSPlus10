+/* ---- laurel 2410: one line that says how the link goes; firmware's tx rate by WMI peer stats (self-check: "tx ?") */
+#define CMD_REQUEST_STATS   0x16001
+#define TAG_REQUEST_STATS   0x8F
+#define WMI_EV_UPDATE_STATS 0x1D004
+#define TAG_STATS_EVENT     0x46
+#define WMI_STAT_PEER       1
+
+static void
+lw_stats_event(const uint8_t *t, uint32_t len)
+{
+	const uint8_t *ev = NULL, *data = NULL;
+	uint32_t dl = 0;
+
+	for (uint32_t o = 0; o + 4 <= len;) {
+		uint32_t l = lw_get16(t + o), tag = lw_get16(t + o + 2);
+
+		if (o + 4 + l > len) {
+			break;
+		}
+		if (tag == TAG_STATS_EVENT && l >= 24) {
+			ev = t + o + 4;
+		} else if (tag == TAG_ARRAY_BYTE && data == NULL) {
+			data = t + o + 4;
+			dl = l;
+		}
+		o += 4 + l;
+	}
+	if (ev == NULL || data == NULL || lw_get32(ev + 4) != 0 || lw_get32(ev + 8) != 0) {
+		return;                                 /* we ask for peers only; anything else has another layout */
+	}
+	for (uint32_t i = 0, n = lw_get32(ev + 12); i < n && (i + 1) * 20 <= dl; i++) {
+		const uint8_t *p = data + i * 20;       /* wmi_10x_peer_stats: mac, rssi, tx rate, rx rate */
+
+		if (memcmp(p, s_bssid, 6) == 0) {
+			lw_tx_kbps = lw_get32(p + 12);
+		}
+	}
+}
+
+static int
+lw_rssi_now(void)
+{
+	if (lw_rx_rssi != 0) {
+		return lw_rx_rssi;
+	}
+	for (uint32_t i = 0; i < nbss; i++) {
+		if (memcmp(bss[i].bssid, s_bssid, 6) == 0) {
+			return bss[i].rssi;
+		}
+	}
+	return 0;
+}
+
+static void
+lw_status_poll(void)
+{
+	static uint64_t last_ns, last_rx, last_tx;
+	static const char *const kinds[3] = { "legacy", "HT", "VHT" };
+	uint64_t now = 0;
+
+	if (s_state != S_UP) {
+		last_ns = 0;
+		return;
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now);
+	if (last_ns != 0 && now - last_ns < (lw_busy ? 10 : 60) * NSEC_PER_SEC) {
+		return;
+	}
+	if (last_ns != 0) {
+		uint64_t el = now - last_ns, down = (lw_rx_bytes - last_rx) * 80000 / el, up = (lw_tx_bytes - last_tx) * 80000 / el;
+		const struct lw_rate *r = &lw_rx_rate;
+
+		printf("LAUREL WIFI: link %s GHz ch %u %u MHz, %u MHz %s%s %ux%u | rx %s mcs %u %s%u MHz %u.%u Mbps | tx %u Mbps%s | "
+		    "RSSI %d dBm | down %llu.%llu up %llu.%llu Mbps | frames rx %u tx %u fail %u drop %u nosnap %u | scans %u deferred %u\n",
+		    s_freq >= 4900 ? "5" : "2.4", s_freq >= 4900 ? (s_freq - 5000) / 5 : (s_freq - 2407) / 5, s_freq, s_link.width,
+		    s_link.vht ? "VHT" : s_link.ht ? "HT" : "legacy", s_link.qos ? " QoS" : "", s_link.nss, s_link.nss, kinds[r->kind],
+		    r->mcs, r->sgi ? "sgi " : "", r->width, r->mbps10 / 10, r->mbps10 % 10, lw_tx_kbps / 1000, lw_tx_kbps != 0 ? "" : " ?",
+		    lw_rssi_now(), down / 10, down % 10, up / 10, up % 10, rx_up, tx_sent, tx_fail, tx_drop, lw_nosnap, lw_scans_real, lw_scans_deferred);
+	}
+	last_ns = now;
+	last_rx = lw_rx_bytes;
+	last_tx = lw_tx_bytes;
+	uint8_t m[8], *p = wmi_put_tlv(m, TAG_REQUEST_STATS, 4);
+	w_p32(p, WMI_STAT_PEER);
+	(void)wmi_send(CMD_REQUEST_STATS, m, sizeof(m));
+}
+
+/* what the Apple80211 side answers about the link: its real signal and rate, and the access point joined */
+extern "C" void
+topaz_wlan_link_now(uint8_t bssid[6], int *rssi, unsigned *mbps, int *mcs, unsigned *apple_phy)
+{
+	memcpy(bssid, s_bssid, 6);
+	*rssi = lw_rssi_now();
+	*mbps = lw_tx_kbps != 0 ? lw_tx_kbps / 1000 : lw_rx_rate.mbps10 / 10;
+	*mcs = lw_rx_rate.kind != 0 ? lw_rx_rate.mcs : -1;
+	/* apple80211_var.h: 11a 0x2, 11g 0x8, 11n 0x10, 11ac 0x80 */
+	*apple_phy = s_link.vht ? 0x80 : s_link.ht ? 0x10 : s_freq >= 4900 ? 0x2 : 0x8;
+}
