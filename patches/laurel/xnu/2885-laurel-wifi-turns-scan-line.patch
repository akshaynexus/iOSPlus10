+/*
+ * laurel 2885: Rx and Tx take turns. A turn: at most 16 messages of each copy engine (Tx completions come with the Rx
+ * indications on engine 1), then up to 32 frames of the Tx queue. It was one turn per pass of the loop: 32 Tx frames and 64
+ * free slots per 1 ms sleep plus all the Rx work, whatever came. Until nothing moves; at most 8 turns, 2 ms.
+ */
+#define LW_TURNS 8
+#define LW_TURN_NS (2 * NSEC_PER_MSEC)
+
+static void
+lw_data_turns(void)
+{
+	static uint64_t limit_abs;
+	static uint64_t last_end;
+	uint64_t t0 = mach_absolute_time(), now = t0;
+
+	if (last_end != 0 && t0 - last_end > lw_gap_max_abs) {
+		lw_gap_max_abs = t0 - last_end;
+	}
+	if (limit_abs == 0) {
+		nanoseconds_to_absolutetime(LW_TURN_NS, &limit_abs);
+	}
+	for (int turn = 0; turn < LW_TURNS; turn++) {
+		bool rx = ce_poll();
+		uint32_t tx = api_ready ? w_tx_pump() : 0;
+
+		now = mach_absolute_time();
+		if ((!rx && tx == 0) || now - t0 >= limit_abs) {
+			break;
+		}
+	}
+	last_end = now;
+	lw_work_abs += now - t0;
+	if (now - t0 > lw_pass_max_abs) {
+		lw_pass_max_abs = now - t0;
+	}
+}
