 	{
 		/* laurel 2720: calendar commands (no reset: also while one is pending) */
 		char treply[128];
@@ -1418,6 +1439,13 @@ ud_panic_rx(const uint8_t *f, uint32_t len)
 		ud_panic_pos = end > 65536 ? end - 65536 : 0;
 		snprintf(text, sizeof(text), "ok log%s", sfx);
 		reply = text;
+	} else if (strcmp(cmd, "logall") == 0) {        /* laurel 2951: sweet_log_copy starts at the oldest byte the ring has */
+		ud_panic_pos = 0;
+		snprintf(text, sizeof(text), "ok logall%s", sfx);
+		reply = text;
+	} else if (strcmp(cmd, "state") == 0 || strcmp(cmd, "ps") == 0) {       /* laurel 2951 */
+		snprintf(text, sizeof(text), "state %s\nend\n", ud_in_panic ? "panic: send logall" : "early: no ue0 yet");
+		reply = text;
 	} else if (strcmp(cmd, "reboot") == 0 || strcmp(cmd, "recovery") == 0 ||
 	    strcmp(cmd, "bootloader") == 0 || strcmp(cmd, "poweroff") == 0) {
 		if (busy) {
@@ -2167,11 +2195,16 @@ ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 			uint64_t end = sweet_log_position();
 			pos = end > 65536 ? end - 65536 : 0;
 		}
+		if (ud_log_rewind_all) {        /* laurel 2951: sweet_log_copy starts at the oldest byte the ring has */
+			ud_log_rewind_all = false;
+			pos = 0;
+		}
 		if (so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
 			so = NULL;
 			continue;
 		}
 		uint32_t n;
+		uint64_t before = pos;          /* laurel 2951: a send that fails keeps its bytes: a whole ring is more than the send queue */
 		while ((n = sweet_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
 			struct iovec iov = { .iov_base = chunk, .iov_len = n };
 			struct msghdr msg = {
@@ -2180,8 +2213,10 @@ ud_log_thread(void *arg __unused, wait_result_t wr __unused)
 			};
 			size_t sent = 0;
 			if (sock_send(so, &msg, 0, &sent) != 0) {
+				pos = before;   /* laurel 2951 */
 				break;          /* no route/ARP yet: retry later */
 			}
+			before = pos;
 			ud_log_sent = pos;      /* the panic flush starts here */
 		}
 	}
