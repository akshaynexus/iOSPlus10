diff --git a/bsd/kern/kern_exit.c b/bsd/kern/kern_exit.c
--- a/bsd/kern/kern_exit.c
+++ b/bsd/kern/kern_exit.c
@@ -2028,4 +2028,6 @@ proc_prepareexit(proc_t p, int rv, boolean_t perf_notify)
 	exception_type_t etype;
 
+	extern void laurel_state_exit(const char *, int, int);  /* laurel 2951 */
