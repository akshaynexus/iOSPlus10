 static const char *
 lwd_class_name(uint32_t cls)
@@ -315,6 +405,9 @@ laurel_wdog_report_cpu(int cpu, const char *prefix)
 	    ml_nofault_copy((vm_offset_t)&ro->tro_task, (vm_offset_t)&task, sizeof(task)) == sizeof(task) && task != NULL) {
 		(void)ml_nofault_copy((vm_offset_t)&task->task_shared_region_slide, (vm_offset_t)&dyld_slide, sizeof(dyld_slide));
 	}
+	if (open && th != NULL) {
+		lwd_thread_path(prefix, cpu, th, c);
+	}
 	if (open) {
 		kprintf("%s cpu %d is in the kernel since an EL0 trap %llu ms ago: class 0x%02llx (%s) esr 0x%llx far 0x%llx user pc 0x%llx, %u traps in all; GICR pending 0x%08x active 0x%08x%s; dyld slide 0x%x\n",
 		    prefix, cpu, now > trap_t ? (now - trap_t) / ticks : 0, esr >> 26, lwd_class_name((uint32_t)(esr >> 26)), esr, c->trap_far, c->trap_pc,
