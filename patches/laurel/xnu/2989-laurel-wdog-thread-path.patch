+/*
+ * laurel 2989: the kernel path of the thread on a silent CPU, read from this CPU with copies that cannot fault, nothing written:
+ * the frame chain from the fp its last interrupt found (a spin in a leaf keeps the same callers), every pointer into kernel text on its
+ * kernel stack (deepest first: the newest frames come first), and its saved user registers (x16 is the Unix system call number).
+ * Addresses carry the kernel slide (the `slide` of the line before).
+ */
+static void
+lwd_thread_path(const char *prefix, int cpu, thread_t th, struct lwd_cpu *c)
+{
+	vm_offset_t stack = 0;
+	char line[232];
+	int n;
+
+	(void)ml_nofault_copy((vm_offset_t)&th->kernel_stack, (vm_offset_t)&stack, sizeof(stack));
+	uint64_t lo = stack, hi = stack + kernel_stack_size;
+
+	/* the frame chain at the last interrupt */
+	uint64_t fp = c->fp;
+	n = 0;
+	for (int i = 0; i < 16 && fp >= lo && fp + 16 <= hi && (fp & 7) == 0; i++) {
+		uint64_t frame[2] = { 0, 0 };
+
+		if (ml_nofault_copy((vm_offset_t)fp, (vm_offset_t)frame, sizeof(frame)) != sizeof(frame)) {
+			break;
+		}
+		n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+		if (n >= (int)sizeof(line) - 20) {
+			break;
+		}
+		fp = frame[0];
+	}
+	kprintf("%s cpu %d callers at its last interrupt, fp 0x%llx%s%s\n", prefix, cpu, c->fp, n ? ":" : ": none in its kernel stack", n ? line : "");
+
+	/* the text pointers on its kernel stack */
+	uint64_t stext = vm_kernel_stext, etext = vm_kernel_etext;
+	int found = 0, lines = 0;
+
+	n = 0;
+	for (uint64_t at = lo; stack != 0 && at + 8 <= hi && lines < 4; at += 512) {
+		uint64_t words[64];
+		size_t len = MIN(512, hi - at);
+
+		if (ml_nofault_copy((vm_offset_t)at, (vm_offset_t)words, len) != len) {
+			break;
+		}
+		for (size_t k = 0; k < len / 8; k++) {
+			if (words[k] >= stext && words[k] < etext) {
+				n += snprintf(line + n, sizeof(line) - n, " 0x%llx", words[k]);
+				found++;
+				if (n >= (int)sizeof(line) - 20) {
+					kprintf("%s cpu %d kernel text on its stack, deepest first:%s\n", prefix, cpu, line);
+					n = 0;
+					lines++;
+					if (lines >= 4) {
+						break;
+					}
+				}
+			}
+		}
+	}
+	if (n > 0 || found == 0) {
+		kprintf("%s cpu %d kernel text on its stack%s: %s (stack 0x%llx..0x%llx, %d pointers)\n", prefix, cpu, found ? ", deepest first" : "", n ? line : "none", lo, hi, found);
+	}
+
+	/* its user registers */
+	arm_saved_state_t *pcb = NULL;
+	arm_saved_state_t ss;
+
+	if (ml_nofault_copy((vm_offset_t)&th->machine.upcb, (vm_offset_t)&pcb, sizeof(pcb)) == sizeof(pcb) && pcb != NULL &&
+	    ml_nofault_copy((vm_offset_t)pcb, (vm_offset_t)&ss, sizeof(ss)) == sizeof(ss) && is_saved_state64(&ss)) {
+		arm_saved_state64_t *u = saved_state64(&ss);
+
+		kprintf("%s cpu %d user state: x16 0x%llx (unix syscall %llu) x0 0x%llx x1 0x%llx x2 0x%llx x3 0x%llx sp 0x%llx lr 0x%llx pc 0x%llx\n",
+		    prefix, cpu, u->x[16], u->x[16], u->x[0], u->x[1], u->x[2], u->x[3], u->sp, u->lr, u->pc);
+	} else {
+		kprintf("%s cpu %d user state: not readable\n", prefix, cpu);
+	}
+}
+
