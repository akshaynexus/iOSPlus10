laurel 3020: LAUREL CPU MOTION: a touch or a frame on its way (GPU submission, swap) wakes the OSM governor and holds the rows at once: gold at its cap, silver at its cap (touch) or at the lowest row >= 1400 MHz (motion, 1420 MHz on the Mi A3); held 500 ms after a touch, 150 ms after the last frame; the floor comes back by load when the screen is still. Before (2972): a touch woke the governor, GPU work held only gold and only when the 40 ms tick saw it; a server-side animation (no finger) ran silver at 300 MHz. The thermal cap still wins (lgov_next). Rule in laurel_gov_core.h lgov_hold (host test scripts/laurel/gov-test.sh); the events also wake the GPU governor (laurel 3021). Kill switch laurelcpumotion=0. Both kernels. docs/laurel_sprout/clocks-on-motion.md.

diff --git a/bsd/dev/laurel_gov_core.h b/bsd/dev/laurel_gov_core.h
--- a/bsd/dev/laurel_gov_core.h
+++ b/bsd/dev/laurel_gov_core.h
@@ -20,6 +20,32 @@
 #define LGOV_HI         60u     /* +2 rows */
 #define LGOV_LO         30u
 #define LGOV_DOWN_TICKS 8u      /* 320 ms below LGOV_LO: -1 row (as before: about 300 ms) */
+#define LGOV_TOUCH_MS   500u    /* a touch holds this long after the last event */
+#define LGOV_MOTION_MS  150u    /* laurel 3020: a frame (GPU submission or swap) holds this long after the last one: 9 frames at 60 Hz, 1.5 at 10 */
+#define LGOV_SILVER_MOTION_KHZ 1400000u /* laurel 3020: silver's row while frames move: the lowest row at or above this (1420 MHz on the Mi A3) */
+
+/*
+ * laurel 3020 (owner 2026-11-03: full clock on touch and while frames move): the row a UI event holds, 0 = none. A touch: the cap on
+ * both clusters. Motion (a frame is on its way: a GPU submission or a swap in the last LGOV_MOTION_MS): gold at its cap, silver at the
+ * lowest row at or above LGOV_SILVER_MOTION_KHZ (the cap when no row is that high). The thermal cap is `cap` and wins. The event
+ * wakes the governor, so the hold is written at once, not at the next tick; the floor comes back by load when the screen is still.
+ */
+static inline unsigned
+lgov_hold(unsigned gold, unsigned touch, unsigned motion, const unsigned *khz, unsigned rows, unsigned cap)
+{
+	if (touch || (motion && gold)) {
+		return cap;
+	}
+	if (!motion) {
+		return 0;
+	}
+	for (unsigned r = 0; r < rows; r++) {
+		if (khz[r] >= LGOV_SILVER_MOTION_KHZ) {
+			return r > cap ? cap : r;
+		}
+	}
+	return cap;
+}
 
 static inline unsigned
 lgov_next(unsigned busy, unsigned tick, unsigned row, unsigned floor, unsigned cap, unsigned hold, unsigned *low)
