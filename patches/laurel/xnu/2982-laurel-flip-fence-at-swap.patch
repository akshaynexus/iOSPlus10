+/*
+ * laurel 2982: the fence a queued frame waits for: the surface's last submission at SwapEnd. No submission since the surface was last shown: the frame's
+ * own work has not come by now, or there is none: 0, so that the flip reads the surface's newest, as before. [V log] SwapEnd comes after the submission: a presenter
+ * that takes the frame 200 us after SwapEnd waits 17 of the GPU's 18 ms (05:26:20).
+ */
+static inline uint32_t
+lfl_fence_for_flip(uint32_t drawn_at_swap, uint32_t shown_fence)
+{
+	return drawn_at_swap == shown_fence ? 0 : drawn_at_swap;
+}
