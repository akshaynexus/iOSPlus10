+/* laurel 2772: exposure, gain and frame length (0x0340) in one group hold: the AE of the iOS client can make frames longer */
+int
+lcam_sensor_frame_exposure(uint32_t lines, uint32_t gain_code, uint32_t frame_lines)
+{
+	uint8_t f[4] = { 0x03, 0x40, (uint8_t)(frame_lines >> 8), (uint8_t)frame_lines };
+	uint8_t c[4] = { 0x02, 0x02, (uint8_t)(lines >> 8), (uint8_t)lines };
+	uint8_t g[4] = { 0x02, 0x04, (uint8_t)(gain_code >> 8), (uint8_t)gain_code };
+	int e;
+
+	if (!slot) {
+		return ENODEV;
+	}
+	(void)reg8(0x0104, 1);
+	e = lcam_cci_write(slot->master, sensor->addr, f, 4);
+	e = e ? e : lcam_cci_write(slot->master, sensor->addr, c, 4);
+	e = e ? e : lcam_cci_write(slot->master, sensor->addr, g, 4);
+	(void)reg8(0x0104, 0);
+	return e;
+}
