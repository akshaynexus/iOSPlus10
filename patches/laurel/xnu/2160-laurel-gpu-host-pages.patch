 /*
+ * laurel 2160 (design: negroni 0232): the caller's pages [pointer, pointer + size) as a buffer. The pages stay wired while
+ * the handle lives, so the GPU keeps the pages that were there at import even if the program unmaps the range. With
+ * kUserptrReadOnly they are wired for reading only (read-only memory of the program can be imported) and read-only for
+ * the GPU. Cache rules as for a cached buffer: pushed now (clean + invalidate) and at each submission that names them;
+ * after a GPU write the program invalidates (Turnip's vkInvalidateMappedMemoryRanges: EL0 dc civac). Stage-1 tables only:
+ * in pass-through the GPU cannot reach scattered pages. Only the task that opened the connection.
+ */
+IOReturn
+RedwoodGPUUserClient::hostPages(struct redwood_userptr * request)
+{
+	bool readOnly = (request->flags & kUserptrReadOnly) != 0;
+	IOMemoryDescriptor * memory;
+	struct gpu_buffer * b = NULL;
+	uint64_t size = request->size;
+
+	if (!gGPUHostImport || redwood_gpu_identity()) {
+		return kIOReturnUnsupported;
+	}
+	if ((request->flags & ~kUserptrReadOnly) != 0 || request->pointer == 0 || size == 0 || (request->pointer & PAGE_MASK) ||
+	    (size & PAGE_MASK) || size > GPU_BUFFER_MAX || request->pointer + size < request->pointer) {
+		return kIOReturnBadArgument;
+	}
+	if (current_task() != fTask) {
+		return kIOReturnNotPermitted;
+	}
+	memory = IOMemoryDescriptor::withAddressRange((mach_vm_address_t) request->pointer, (mach_vm_size_t) size,
+	    readOnly ? kIODirectionOut : kIODirectionInOut, fTask);
+	if (memory == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (memory->prepare() != kIOReturnSuccess) {
+		memory->release();
+		return kIOReturnVMError;                /* not mapped, or not writable without kUserptrReadOnly */
+	}
+	memory->performOperation(kIOMemoryIncoherentIOFlush, 0, size);
+	IOLockLock(gGPULock);
+	if (fHostBytes + size <= GPU_CLIENT_HOST_BYTES &&
+	    (b = newBuffer(memory, 0, size, readOnly ? MSM_BO_GPU_READONLY : 0, &request->handle)) != NULL) {
+		b->memory = memory;
+		b->kernel = NULL;
+		b->surface = NULL;
+		b->host = true;
+		fHostBytes += size;
+	}
+	IOLockUnlock(gGPULock);
+	if (b == NULL) {
+		memory->release();                      /* (unwires the pages) */
+		return kIOReturnNoMemory;
+	}
+	return kIOReturnSuccess;
+}
