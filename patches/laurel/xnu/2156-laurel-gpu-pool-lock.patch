index 0000000..f8e872f
--- /dev/null
+++ b/iokit/Kernel/arm/laurel_gpu_pool_core.h
@@ -0,0 +1,171 @@
+/*
+ * laurel 2156: the GPU pool's bookkeeping (TopazAdreno.cpp), plain C, so that a host test builds exactly this
+ * file: scripts/laurel/gpu-pool-test.sh (tools/gpu-pool-test/). The caller holds the pool lock around every call
+ * (TopazAdreno.cpp: laurel_gpu_pool_lock). GPU_POOL_UNIT, GPU_POOL_CHUNK and GPU_POOL_MAX come from the includer.
+ *
+ * The kernel maps the pool chunk by chunk (GPU_POOL_CHUNK each, on first use). A buffer across two chunks has no
+ * kernel mapping past the boundary: gemNew's bzero took a translation fault there (2026-11-01 06:50:38, buffer at
+ * pool offset 0x3f40000 + 0x140000, fault at 0x4000000). Rules, checked on every call (the seeding alone is not
+ * trusted):
+ *   - a buffer is unit aligned, inside the pool, inside one chunk and off the chunk's last unit (the guard);
+ *   - a free must be exactly a buffer that the pool gave out and did not get back yet (start, size); anything else
+ *     is refused and counted, and the free list stays as it is;
+ *   - free ranges merge only inside one chunk.
+ */
+#ifndef LAUREL_GPU_POOL_CORE_H
+#define LAUREL_GPU_POOL_CORE_H
+
+#define LGP_RANGES      2048
+#define LGP_UNITS       (GPU_POOL_MAX / GPU_POOL_UNIT)
+
+struct lgp {
+	uint64_t base, size;                    /* the pool; size 0: none */
+	struct { uint64_t start, size; } range[LGP_RANGES];  /* free ranges, sorted by start, none on a guard unit */
+	unsigned count;
+	uint16_t len[LGP_UNITS];                /* units of the buffer that starts at this unit; 0: none starts here */
+	uint64_t free_bytes;
+	uint32_t refused;                       /* frees refused (not a buffer that is out) */
+	uint32_t lost;                          /* frees taken back but not kept: the free list was full */
+	uint32_t skipped;                       /* free ranges passed over by an allocation: the buffer would cross a chunk */
+};
+
+/* [pa, pa + size) may be a buffer: unit aligned, inside the pool, inside one chunk, off its guard unit */
+static inline bool
+lgp_fits(const struct lgp *p, uint64_t pa, uint64_t size)
+{
+	uint64_t off = pa - p->base;
+
+	return p->size != 0 && pa >= p->base && size != 0 && size <= p->size && off <= p->size - size &&
+	       ((off | size) & (GPU_POOL_UNIT - 1)) == 0 &&
+	       (off & (GPU_POOL_CHUNK - 1)) + size <= GPU_POOL_CHUNK - GPU_POOL_UNIT;
+}
+
+/* the index of the first free range that starts at or after pa */
+static inline unsigned
+lgp_find(const struct lgp *p, uint64_t pa)
+{
+	unsigned lo = 0, hi = p->count;
+
+	while (lo < hi) {
+		unsigned mid = (lo + hi) / 2;
+		if (p->range[mid].start < pa) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	return lo;
+}
+
+/* a checked range into the free list, merged with its neighbours of the same chunk; false: the list is full */
+static inline bool
+lgp_insert(struct lgp *p, uint64_t pa, uint64_t size)
+{
+	unsigned at = lgp_find(p, pa);
+	bool prev = at > 0 && p->range[at - 1].start + p->range[at - 1].size == pa &&
+	    lgp_fits(p, p->range[at - 1].start, p->range[at - 1].size + size);
+	uint64_t start = prev ? p->range[at - 1].start : pa, len = (prev ? p->range[at - 1].size : 0) + size;
+	bool next = at < p->count && pa + size == p->range[at].start && lgp_fits(p, start, len + p->range[at].size);
+
+	if (prev && next) {
+		p->range[at - 1].size = len + p->range[at].size;
+		memmove(&p->range[at], &p->range[at + 1], (p->count - at - 1) * sizeof(p->range[0]));
+		p->count--;
+	} else if (prev) {
+		p->range[at - 1].size = len;
+	} else if (next) {
+		p->range[at].start = pa;
+		p->range[at].size += size;
+	} else if (p->count < LGP_RANGES) {
+		memmove(&p->range[at + 1], &p->range[at], (p->count - at) * sizeof(p->range[0]));
+		p->range[at].start = pa;
+		p->range[at].size = size;
+		p->count++;
+	} else {
+		return false;
+	}
+	p->free_bytes += size;
+	return true;
+}
+
+/* the pool [base, base + size): one free range per whole chunk, its last unit left out (the guard) */
+static inline void
+lgp_init(struct lgp *p, uint64_t base, uint64_t size)
+{
+	memset(p, 0, sizeof(*p));
+	if ((base & (GPU_POOL_CHUNK - 1)) != 0) {
+		return;                         /* (gpu_pool_place takes only chunk-aligned ranges) */
+	}
+	p->base = base;
+	p->size = (size > GPU_POOL_MAX ? GPU_POOL_MAX : size) & ~(uint64_t)(GPU_POOL_CHUNK - 1);
+	for (uint64_t c = 0; c < p->size / GPU_POOL_CHUNK; c++) {
+		(void)lgp_insert(p, base + c * GPU_POOL_CHUNK, GPU_POOL_CHUNK - GPU_POOL_UNIT);
+	}
+}
+
+/* a buffer of size bytes (whole units), first fit: its start, or 0. Never one that lgp_fits refuses. */
+static inline uint64_t
+lgp_alloc(struct lgp *p, uint64_t size)
+{
+	for (unsigned i = 0; i < p->count; i++) {
+		uint64_t pa = p->range[i].start;
+
+		if (p->range[i].size < size) {
+			continue;
+		}
+		if (!lgp_fits(p, pa, size) || p->len[(pa - p->base) / GPU_POOL_UNIT] != 0) {
+			p->skipped++;           /* a bad range (no longer made, see lgp_free): passed over, never handed out */
+			continue;
+		}
+		p->range[i].start += size;
+		p->range[i].size -= size;
+		if (p->range[i].size == 0) {
+			memmove(&p->range[i], &p->range[i + 1], (p->count - i - 1) * sizeof(p->range[0]));
+			p->count--;
+		}
+		p->len[(pa - p->base) / GPU_POOL_UNIT] = (uint16_t)(size / GPU_POOL_UNIT);
+		p->free_bytes -= size;
+		return pa;
+	}
+	return 0;
+}
+
+/* [pa, pa + size) is a buffer that is out (given by lgp_alloc, not back yet) */
+static inline bool
+lgp_is_out(const struct lgp *p, uint64_t pa, uint64_t size)
+{
+	return lgp_fits(p, pa, size) && (uint64_t)p->len[(pa - p->base) / GPU_POOL_UNIT] * GPU_POOL_UNIT == size;
+}
+
+/* a buffer back. NULL: taken back; else why it is refused (counted in p->refused; nothing else changes). */
+static inline const char *
+lgp_free(struct lgp *p, uint64_t pa, uint64_t size)
+{
+	unsigned at;
+
+	if (!lgp_fits(p, pa, size)) {
+		p->refused++;
+		return "not a pool buffer (outside the pool, unaligned, across a chunk or on a guard unit)";
+	}
+	if (p->len[(pa - p->base) / GPU_POOL_UNIT] == 0) {
+		p->refused++;
+		return "not out (given back twice, or not from the pool)";
+	}
+	if (!lgp_is_out(p, pa, size)) {
+		p->refused++;
+		return "not the size it was given out with";
+	}
+	at = lgp_find(p, pa);
+	if ((at > 0 && p->range[at - 1].start + p->range[at - 1].size > pa) ||
+	    (at < p->count && p->range[at].start < pa + size)) {
+		p->refused++;
+		return "overlaps free memory";
+	}
+	p->len[(pa - p->base) / GPU_POOL_UNIT] = 0;
+	if (!lgp_insert(p, pa, size)) {
+		p->lost++;
+	}
+	return NULL;
+}
+
+#endif /* LAUREL_GPU_POOL_CORE_H */
