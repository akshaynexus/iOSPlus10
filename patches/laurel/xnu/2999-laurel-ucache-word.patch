diff --git a/osfmk/arm64/laurel_ucache_core.h b/osfmk/arm64/laurel_ucache_core.h
new file mode 100644
index 0000000..59d6320
--- /dev/null
+++ b/osfmk/arm64/laurel_ucache_core.h
@@ -0,0 +1,39 @@
+/*
+ * laurel 2999: the EL0 cache maintenance instructions that a clear SCTLR_EL1.UCI traps, read from the instruction word itself. No kernel
+ * types: the host test scripts/laurel/test-ucache.sh runs exactly this code. A Cortex-A53 or A73 reports the trap as EC 0 (unknown reason,
+ * no ISS), not EC 0x18 as the ESR_EL1 description says for other cores [V phone 2026-11-07: `dc civac, x8` 0xd50b7e28 reached the
+ * undefined-word path and SpringBoard died of SIGILL]; so the word, which both handlers have, is what is decoded.
+ *   SYS Xt: 1101 0101 0000 1 op1(3) CRn(4) CRm(4) op2(3) Rt(5). The six: op1 3, CRn 7, op2 1, CRm 5 (IC IVAU), 10 (DC CVAC), 11 (DC CVAU),
+ *   12 (DC CVAP), 13 (DC CVADP), 14 (DC CIVAC). DC ZVA (CRm 4) is SCTLR_EL1.DZE's, not UCI's: not here.
+ */
+#ifndef LAUREL_UCACHE_CORE_H
+#define LAUREL_UCACHE_CORE_H
+
+#define LUC_SYS_BASE            0xd5080000u
+#define LUC_SYS_MASK            0xfff80000u
+#define LUC_CACHE_FIXED         (LUC_SYS_BASE | (3u << 16) | (7u << 12) | (1u << 5))    /* op1 3, CRn 7, op2 1 */
+#define LUC_CACHE_FIXED_MASK    0xfffff0e0u                                             /* all but CRm and Rt */
+#define LUC_IC_IVAU             5
+#define LUC_DC_CVAC             10
+#define LUC_DC_CVAU             11
+#define LUC_DC_CVAP             12
+#define LUC_DC_CVADP            13
+#define LUC_DC_CIVAC            14
+
+/* the CRm (5, 10-14) of an EL0 cache maintenance word and its Rt (31 = xzr), or -1 for any other word */
+static inline int
+luc_cache_word(unsigned int instr, unsigned int *rt)
+{
+	unsigned int crm = (instr >> 8) & 0xf;
+
+	if ((instr & LUC_CACHE_FIXED_MASK) != LUC_CACHE_FIXED) {
+		return -1;
+	}
+	if (crm != LUC_IC_IVAU && (crm < LUC_DC_CVAC || crm > LUC_DC_CIVAC)) {
+		return -1;
+	}
+	*rt = instr & 0x1f;
+	return (int)crm;
+}
+
+#endif /* LAUREL_UCACHE_CORE_H */
