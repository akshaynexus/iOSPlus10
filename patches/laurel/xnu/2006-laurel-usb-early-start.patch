+/*
+ * bsd_init, after net_init_run(): ue0 (192.168.7.2/24) on the gadget and the
+ * switch from raw frames to the network stack. Without the gadget (self-check
+ * failed, laurelusb=0) nothing happens.
+ */
+void
+laurel_usb_net_attach(void)
+{
+	thread_t thread;
+
+	if (!ud_running || ud.ifp != NULL) {
+		return;
+	}
+	ud_if_create();
+	if (ud.ifp == NULL) {
+		printf("LAUREL USB: ue0 not attached: raw frames stay on (log and commands still work)\n");
+		return;
+	}
+	lck_mtx_lock(ud.lock);
+	ud_early = false;
+	ud_log_sent = ud_panic_pos;             /* the socket log goes on here */
+	ud_log_from_raw = true;
+	ud_preply_count = 0;                    /* replies not sent yet: the host asks again */
+	lck_mtx_unlock(ud.lock);
+	printf("LAUREL USB: ue0 attached; %llu console bytes went out as raw frames\n", ud_panic_pos);
+	if (ud_livelog && kernel_thread_start(ud_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
 }
