+/*
+ * laurel 2013: GIC state of the calling CPU for the USB timer-service
+ * self-check (bsd/dev/sweet_usb.c): GICD_CTLR, GICR WAKER, ISENABLER0,
+ * ISPENDR0, ISACTIVER0, IGROUPR0, the priority of the timer PPI, its INTID.
+ */
+#ifndef GICR_ISPENDR0
+#define GICR_ISPENDR0   0x10200
+#endif
+#ifndef GICR_ISACTIVER0
+#define GICR_ISACTIVER0 0x10300
+#endif
+void sweet_gic_state(uint32_t out[8]);
+void
+sweet_gic_state(uint32_t out[8])
+{
+	if (!gicd_base || !gicr_base) {
+		for (int i = 0; i < 8; i++) {
+			out[i] = 0;
+		}
+		return;
+	}
+	vm_offset_t gicr_pe_base = find_gicr_pe_base();
+	out[0] = gicd_read32(GICD_CTLR);
+	out[1] = gicr_read32(GICR_WAKER);
+	out[2] = gicr_read32(GICR_ISENABLER0);
+	out[3] = gicr_read32(GICR_ISPENDR0);
+	out[4] = gicr_read32(GICR_ISACTIVER0);
+	out[5] = gicr_read32(GICR_IGROUPR0);
+	out[6] = (gicr_read32(GICR_IPRIORITYR0 + (sweet_vtimer_intid & ~3u)) >> (8 * (sweet_vtimer_intid & 3))) & 0xff;
+	out[7] = sweet_vtimer_intid;
+}
