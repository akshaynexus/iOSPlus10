+/* The pending controller events (polled; the event interrupt is masked). */
+static void
+ud_service_events(void)
+{
+	uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+	if (count > UD_EVT_SIZE) {
+		count = UD_EVT_SIZE;
+	}
+	if (count) {
+		ud_sync(UD_EVT, UD_EVT_SIZE);
+		for (uint32_t done = 0; done + 4 <= count; done += 4) {
+			uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+			ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+			/* ack each event before it is handled: a panic inside ud_event()
+			 * leaves GEVNTCOUNT and evt_pos in step for the panic loop */
+			dwc_wr(GEVNTCOUNT, 4);
+			if (ud.events++ < 200) {
+				printf("SWEET USB: event 0x%08x\n", ev);
+			}
+			ud_event(ev);
+		}
+	}
+}
+
+/*
+ * Patch 2013: one service step from the timer call (interrupt context, on
+ * whatever CPU the timer fires). Everything here is the panic-loop code
+ * path: no locks (ud_nolock()), spin delays, printf into the ring only.
+ */
+static void
+ud_tc_func(timer_call_param_t p0 __unused, timer_call_param_t p1 __unused)
+{
+	if (ud_in_panic || !ud_tc_mode) {
+		return;                         /* the panic CPU or ud_thread owns the controller: no re-arm */
+	}
+	ud_in_tc = true;
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	ud_tc_ticks++;
+	ud_service_events();
+	ud_raw_action(ud_raw_tx_service());
+	ud_ctl_poll();
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	ud_in_tc = false;
+	if (ud_tc_mode && !ud_in_panic) {
+		timer_call_enter(&ud_tc, mach_absolute_time() + ud_tc_period, TIMER_CALL_SYS_CRITICAL | TIMER_CALL_LOCAL);
+	}
+}
+
+static void
+ud_tc_start(void)
+{
+	nanoseconds_to_absolutetime(NSEC_PER_MSEC, &ud_tc_period);
+	timer_call_setup(&ud_tc, ud_tc_func, NULL);
+	ud_tc_mode = true;
+	timer_call_enter(&ud_tc, mach_absolute_time() + ud_tc_period, TIMER_CALL_SYS_CRITICAL | TIMER_CALL_LOCAL);
+}
+
+/* Hand the controller to ud_thread (the ue0 attach): no callback runs after this returns. */
+static void
+ud_tc_stop(void)
+{
+	ud_tc_mode = false;
+	__atomic_thread_fence(__ATOMIC_SEQ_CST);
+	(void)timer_call_cancel(&ud_tc);
+	while (ud_in_tc) {
+		ud_udelay(10);
+	}
+	printf("LAUREL USB: timer service handed to ud_thread after %llu ticks\n", ud_tc_ticks);
+}
+
+/*
+ * Self-check of the timer service, at STARTUP(LOCKDOWN) = right after
+ * "trust caches" in kernel_bootstrap_thread, interrupts enabled, before
+ * PE_lockdown_iokit waits for the CPU bring-up: the first tick must have
+ * come (the controller was started before IOKit matching). If not, the
+ * timer interrupt does not reach this CPU and nothing that sleeps can go
+ * on (SweetCPU::startAll, ud_thread, bsd_init); the line gives the state
+ * that decides where it is lost: CNTV (the timer itself), ICC_* (CPU
+ * interface, running priority), GICR (enable/pending/active/group of this
+ * CPU's PPI), GICD_CTLR, DAIF/ISR (pending at the PE but masked?).
+ */
+extern void sweet_gic_state(uint32_t out[8]);   /* pexpert/arm/pe_fiq.c, laurel 2013 */
+static void laurel_usb_timer_check(void);
+static void
+laurel_usb_timer_check(void)
+{
+	if (!ud_running || !ud_tc_mode) {
+		return;
+	}
+	uint64_t t0 = mach_absolute_time(), limit, ns;
+	nanoseconds_to_absolutetime(50 * NSEC_PER_MSEC, &limit);
+	while (ud_tc_ticks == 0 && mach_absolute_time() - t0 < limit) {
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	if (ud_tc_ticks) {
+		printf("LAUREL USB: timer service: on, first tick after %llu us (timer interrupt and GIC OK)\n", ns / 1000);
+		return;
+	}
+	uint32_t g[8];
+	sweet_gic_state(g);
+	printf("LAUREL USB: timer service: NO tick in %llu ms: the timer interrupt does not reach this CPU: "
+	    "EL%llu DAIF 0x%llx ISR 0x%llx CNTV_CTL 0x%llx TVAL %lld ICC SRE 0x%llx PMR 0x%llx IGRPEN1 %llu RPR 0x%llx "
+	    "CTLR 0x%llx | GICD_CTLR 0x%08x GICR WAKER 0x%08x ISENABLER0 0x%08x ISPENDR0 0x%08x ISACTIVER0 0x%08x "
+	    "IGROUPR0 0x%08x prio 0x%02x intid %u\n", ns / NSEC_PER_MSEC,
+	    __builtin_arm_rsr64("CurrentEL") >> 2, __builtin_arm_rsr64("DAIF"), __builtin_arm_rsr64("ISR_EL1"),
+	    __builtin_arm_rsr64("CNTV_CTL_EL0"), (int64_t)(int32_t)__builtin_arm_rsr64("CNTV_TVAL_EL0"),
+	    __builtin_arm_rsr64("ICC_SRE_EL1"), __builtin_arm_rsr64("ICC_PMR_EL1"), __builtin_arm_rsr64("ICC_IGRPEN1_EL1"),
+	    __builtin_arm_rsr64("ICC_RPR_EL1"), __builtin_arm_rsr64("ICC_CTLR_EL1"),
+	    g[0], g[1], g[2], g[3], g[4], g[5], g[6], g[7]);
+	printf("LAUREL USB: timer service: log and commands wait for the first timer interrupt\n");
+}
+STARTUP(LOCKDOWN, STARTUP_RANK_FIRST, laurel_usb_timer_check);
