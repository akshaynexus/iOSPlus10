+/*
+ * laurel 2974: where the pool goes. Of the reserved ranges res[nr] (base, size): the largest that, cut to at most maxsize and to a whole
+ * number of chunks, is at least minsize, chunk aligned, below 4 GiB, inside one of banks[nb], and outside [kbase, kend) (kernel RAM) and
+ * [mbase, mend) (the modem pool). A range that runs into one of those two is cut in front of it. false: no such range.
+ */
+static inline bool
+lgp_place(const uint64_t (*res)[2], unsigned nr, const uint64_t (*banks)[2], unsigned nb, uint64_t kbase, uint64_t kend, uint64_t mbase,
+    uint64_t mend, uint64_t minsize, uint64_t maxsize, uint64_t *base, uint64_t *size)
+{
+	*base = *size = 0;
+	for (unsigned i = 0; i < nr; i++) {
+		uint64_t b = res[i][0], e = b + (res[i][1] > maxsize ? maxsize : res[i][1]), sz;
+		bool in_bank = false;
+
+		if (b < kbase && kbase < e) {
+			e = kbase;
+		}
+		if (b < mbase && mbase < e) {
+			e = mbase;
+		}
+		sz = (e - b) & ~(uint64_t)(GPU_POOL_CHUNK - 1);
+		e = b + sz;
+		if (sz < minsize || (b & (GPU_POOL_CHUNK - 1)) != 0 || e > (1ull << 32) || (b < kend && kbase < e) || (b < mend && mbase < e)) {
+			continue;
+		}
+		for (unsigned j = 0; j < nb; j++) {
+			in_bank |= b >= banks[j][0] && e <= banks[j][0] + banks[j][1];
+		}
+		if (in_bank && sz > *size) {
+			*base = b;
+			*size = sz;
+		}
+	}
+	return *size != 0;
+}
+
 #endif /* LAUREL_GPU_POOL_CORE_H */
