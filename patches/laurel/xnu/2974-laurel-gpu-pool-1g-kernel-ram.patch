+/*
+ * laurel 2974: a pool buffer; when the pool has none, kept pool buffers go back, the longest kept first, until one fits. all: the window server's
+ * as well (only its own request, or the pass-through path where the pool is the only memory; at most GPU_KEPT_BYTES per client). 0: the pool has
+ * none even so: the caller goes to scattered pages (gemNew; user space sees slower frames, no failure) or fails only in pass-through.
+ * Takes gGPULock: not from under it. The pool's lock is taken inside it, as always (2156). No wait anywhere: a request never sleeps for pool memory.
+ */
+extern "C" uint64_t
+redwood_gpu_pool_take(uint64_t size, void ** va, bool all)
+{
+	static uint32_t times;
+	uint64_t pa = topaz_gpu_pool_alloc(size, va), bytes = 0;
+
+	if (pa != 0 || gGPULock == NULL || topaz_gpu_midmem()) {
+		return pa;
+	}
+	IOLockLock(gGPULock);
+	while (pa == 0) {
+		RedwoodGPUUserClient * who = NULL;
+		struct gpu_kept * k = NULL;
+
+		for (uint32_t i = 0; i < GPU_CLIENTS; i++) {
+			struct gpu_kept * one = gGPUClients[i] != NULL ? gGPUClients[i]->oldestPoolKept(all) : NULL;
+
+			if (one != NULL && (k == NULL || one->since < k->since)) {
+				k = one;
+				who = gGPUClients[i];
+			}
+		}
+		if (k == NULL) {
+			break;
+		}
+		bytes += k->size;
+		who->dropKeptOne(k);
+		pa = topaz_gpu_pool_alloc(size, va);
+	}
+	IOLockUnlock(gGPULock);
+	if (bytes != 0 && (times++ < 4 || (times & 255) == 0)) {
+		IOLog("LAUREL GPU KEPT: the pool is empty: %llu MiB of kept buffers gave way for one of %llu bytes (%s, call %u)\n", bytes >> 20, size,
+		    pa != 0 ? "it fits now" : "still no room", times);
+	}
+	return pa;
+}
