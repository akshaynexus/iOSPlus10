  */
+#include <kern/clock.h>
 #include <kern/thread.h>
 #include <libkern/libkern.h>
 #include <pexpert/pexpert.h>
@@ -35,6 +36,8 @@ extern int topaz_wlan_join_pmk(const uint8_t *ssid, unsigned ssid_len, const uin
 extern int topaz_wlan_leave(void);
