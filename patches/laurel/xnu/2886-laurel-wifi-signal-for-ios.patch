 /* laurel 2883: a place in the radio's queue for one frame (NULL: *why is REDWOOD_TX_FULL or _DOWN), then the frame is in it */
 extern uint8_t *topaz_wlan_tx_reserve(int *why);
 extern void topaz_wlan_tx_commit(size_t length);
@@ -208,12 +211,43 @@ sta_link_changed(bool up)
 	}
 }
 
+/*
+ * laurel 2886: the interface's thread asks every 2 to 10 ms. Every 5 s while joined: iOS is told the signal when it moved
+ * 2 dB or more, and at least every 30 s (real drivers tell it all the time: wifid's LQM). The value is smoothed in the radio.
+ */
+static unsigned
+sta_poll(void)
+{
+	static uint64_t next_ms, told_ms;
+	static int told;
+	uint64_t now_ns = 0, now_ms;
+	int rssi;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &now_ns);
+	now_ms = now_ns / 1000000;
+	if (now_ms < next_ms) {
+		return 0;
+	}
+	next_ms = now_ms + 5000;
+	rssi = topaz_wlan_signal_now();
+	if (rssi == 0) {
+		told = 0;
+		return 0;
+	}
+	if (told == 0 || rssi - told >= 2 || told - rssi >= 2 || now_ms - told_ms >= 30000) {
+		told = rssi;
+		told_ms = now_ms;
+		redwood_apple80211_signal(rssi);
+	}
+	return 0;
+}
+
 static struct redwood_net_link sta_link = {
 	.name = "wcn3988",
 	.wireless = true,
 	.up = false,
 	.transmit = sta_transmit,
-	.poll = NULL,
+	.poll = sta_poll,
 };
 
 /* from the modem thread, once the radio is up: keep it short, the work goes on a thread */
