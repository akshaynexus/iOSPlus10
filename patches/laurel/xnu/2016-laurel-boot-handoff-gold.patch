laurel 2016: hand the boot from the Silver core to Gold 0x100 with PSCI CPU_ON at the kernel entry (UEFI path).

Boot 2026-11-01 03:14 (UEFI chain, patch 2015): the kernel ran on Kryo 260 Silver CPU0 (MPIDR 0x0, the core
ABL/Mu/DarwinBoot ran on) and its redistributor refused the Non-secure enable of the virtual-timer PPI 19:
`ISENABLER0 0x00000000 ISPENDR0 0x08280000 IGROUPR0 0x00000000` after pe_init_fiq had written them,
GICD_CTLR.DS = 0 (two security states). TrustZone keeps the SGIs/PPIs of the firmware's boot core in Group 0
(Secure), so every NS write to IGROUPR0/ISENABLER0 for them is RAZ/WI and no timer tick ever reaches the
kernel: every waiter starves (PE_lockdown_iokit, ud_thread, bsd_init). A core that TrustZone starts with
PSCI CPU_ON gets a redistributor set up for a normal NS OS (the topaz shim path booted this kernel on Gold
0x100 that way and the timer worked).

This patch does what the shim did, at the first instructions of start_first_cpu, MMU and caches off, x0 =
boot_args PA (DarwinBoot's DarwinEnter state): on a Silver core (MPIDR Aff1 == 0) it calls PSCI CPU_ON(0x100,
laurel_handoff_entry PA, boot_args PA). The Gold core arrives at laurel_handoff_entry with the MMU off at EL1
(or EL2: then the EL2 state is set up as sweet_secondary_entry does and it drops to EL1) and continues in
start_first_cpu as the boot CPU. The Silver core records the PSCI result in laurel_handoff_state and turns
itself off with PSCI CPU_OFF (a parked core is ALREADY_ON for a later CPU_ON, shim patch 0002); wfi loop only
as a fallback if CPU_OFF returns. If CPU_ON is refused (rc != 0) the Silver core boots the kernel itself as
before (laurel 2012 accepts MPIDR 0x0 and 0x100) and the report says so. A Gold boot core (shim path) skips
all of it. The ADT lists Gold first again (mkadt --boot gold: cpu0 = 0x100 state running, cluster 0 'P').

Report on the panel from SweetCPU::startAll (replaces the 2012 line):
  LAUREL CPU: boot cpu mpidr=0x100 (Gold; hand-off from Silver 0x0: PSCI CPU_ON rc=0, entered at EL1)
  LAUREL CPU: boot cpu mpidr=0x100 (Gold, no hand-off: shim path)
  LAUREL CPU: boot cpu mpidr=0x0 (Silver; hand-off off: PSCI CPU_ON rc=-N, booting on the UEFI core)
No kill switch: boot-args are not parsed yet at the entry; the feature turns itself off on a PSCI refusal.

laurel_handoff_state (64 bytes, one cache line, written only with the MMU off): [0] attempted, [1] CPU_ON rc,
[2] MPIDR of the core that arrived at laurel_handoff_entry, [3] its CurrentEL.

diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -329,5 +329,62 @@
 Lsweet_secondary_el1:
 	/* x0 is deliberately unused; reset_vector selects CPU data by MPIDR. */
 	msr		SPSel, #1
 	b		EXT(LowResetVectorBase)
+
+#if defined(TOPAZ_4K)
+/* laurel 2016: PSCI CPU_ON entry of the Gold boot core, x0 = boot_args PA
+ * (context_id), MMU/caches off, EL1 or EL2 (then set EL2 up as above and drop
+ * to EL1). Continues in start_first_cpu as the boot CPU.
+ */
+	.align 2
+	.globl EXT(laurel_handoff_entry)
+LEXT(laurel_handoff_entry)
+	msr		DAIFSet, #0xf
+	adrp	x4, EXT(laurel_handoff_state)@page
+	add		x4, x4, EXT(laurel_handoff_state)@pageoff
+	mrs		x1, MPIDR_EL1
+	str		w1, [x4, #8]
+	mrs		x1, CurrentEL
+	str		w1, [x4, #12]
+	dsb		sy
+	cmp		x1, #0x4
+	b.eq	Llaurel_handoff_el1
+	cmp		x1, #0x8
+	b.ne	Llaurel_handoff_bad_el
+	adrp	x1, EXT(LowExceptionVectorBase)@page
+	add		x1, x1, EXT(LowExceptionVectorBase)@pageoff
+	msr		VBAR_EL2, x1
+	mov		x1, #(1 << 31)
+	msr		HCR_EL2, x1
+	msr		VTTBR_EL2, xzr
+	msr		CPTR_EL2, xzr
+	msr		MDCR_EL2, xzr
+	mov		x1, #3
+	msr		CNTHCTL_EL2, x1
+	msr		CNTVOFF_EL2, xzr
+	mrs		x1, ICC_SRE_EL2
+	orr		x1, x1, #1
+	orr		x1, x1, #8
+	msr		ICC_SRE_EL2, x1
+	MOV64	x1, 0x30d00800
+	msr		SCTLR_EL1, x1
+	isb
+	adrp	x1, Llaurel_handoff_el1@page
+	add		x1, x1, Llaurel_handoff_el1@pageoff
+	msr		ELR_EL2, x1
+	mov		x1, #0x3c5
+	msr		SPSR_EL2, x1
+	eret
+Llaurel_handoff_bad_el:
+	b		.
+Llaurel_handoff_el1:
+	b		EXT(start_first_cpu)
+
+	.section __DATA,__data
+	.align	6
+	.globl	EXT(laurel_handoff_state)
+LEXT(laurel_handoff_state)
+	.space	64,0
+	.text
+#endif /* TOPAZ_4K */
 #endif /* SWEET */
@@ -507,19 +507,60 @@
 LEXT(start_first_cpu)
 
 	// Unlock the core for debugging
 	msr		OSLAR_EL1, xzr
 	msr		DAIFSet, #(DAIFSC_ALL)				// Disable all interrupts
 
 	mov		x20, x0
 	mov		x21, #0
 
+#if defined(SWEET) && defined(TOPAZ_4K)
+	/*
+	 * laurel 2016: on a Silver core (MPIDR Aff1 == 0: the core ABL, Mu and
+	 * DarwinBoot ran on) hand the boot to Gold 0x100 with PSCI CPU_ON, as the
+	 * topaz shim did. TrustZone leaves the firmware core's SGIs/PPIs in
+	 * Group 0 (Secure), so this kernel's NS enable of the timer PPI is
+	 * ignored there (boot 2026-11-01 03:14); a CPU_ON core gets a
+	 * redistributor set up for a NS OS. MMU and caches are off here, x20 =
+	 * boot_args PA. The Gold core arrives at laurel_handoff_entry with x0 =
+	 * boot_args and runs start_first_cpu; this core records the result,
+	 * then CPU_OFF (so the kernel can CPU_ON it later). A refusal: boot here.
+	 */
+	mrs		x1, MPIDR_EL1
+	tst		x1, #0xFF00
+	b.ne	Llaurel_boot_core
+	adrp	x4, EXT(laurel_handoff_state)@page
+	add		x4, x4, EXT(laurel_handoff_state)@pageoff
+	ldr		w1, [x4]
+	cbnz	w1, Llaurel_boot_core				// already attempted (never expected)
+	mov		w1, #1
+	str		w1, [x4]
+	dsb		sy
+	MOV64	x0, 0xc4000003						// PSCI_CPU_ON (SMC64)
+	mov		x1, #0x100							// Gold core 0
+	adrp	x2, EXT(laurel_handoff_entry)@page
+	add		x2, x2, EXT(laurel_handoff_entry)@pageoff
+	mov		x3, x20								// context_id = boot_args PA
+	smc		#0
+	str		w0, [x4, #4]						// CPU_ON return code
+	dsb		sy
+	cbnz	w0, Llaurel_handoff_refused
+	MOV64	x0, 0x84000002						// PSCI_CPU_OFF: does not return
+	smc		#0
+Llaurel_handoff_parked:
+	wfi
+	b		Llaurel_handoff_parked
+Llaurel_handoff_refused:
+	mov		x0, x20
+Llaurel_boot_core:
+#endif
+
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
 #if defined(TOPAZ_4K)
 	MOV64	x0, (0x5c000000 + 2368 * 4320)	/* topaz splash framebuffer */
 #else
 	MOV64	x0, (0x9c000000 + 2368 * 4320)
 #endif
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
