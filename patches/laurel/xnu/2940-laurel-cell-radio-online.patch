+/* laurel 2940: mode + why, one line on a change. TLV 0x10 offline reason bits, TLV 0x11 hardware restricted (RF calibration, thermal) */
+static void
+mode_changed(const uint8_t *d, uint32_t len, const uint8_t *v, const char *how)
+{
+	uint16_t l = 0, reason = 0;
+	const uint8_t *r = tlv(d, len, 0x10, &l);
+	bool have_reason = r != NULL && l >= 2;
+	uint8_t hw = 0;
+
+	if (have_reason) {
+		memcpy(&reason, r, 2);
+	}
+	r = tlv(d, len, 0x11, &l);
+	if (r != NULL && l >= 1) {
+		hw = r[0];
+	}
+	if (opmode != v[0]) {
+		LOG("operating mode %s (raw %u%s, offline reason 0x%x, hardware restricted %u)\n", opmode_name(v[0]), v[0], how, reason, hw);
