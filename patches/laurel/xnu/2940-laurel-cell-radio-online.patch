+/*
+ * laurel 2940: boot 22:50:54: DMS said 5 for the whole boot with both USIMs ready and Wi-Fi up, so the modem is not going down [V]: 5 is what it reports
+ * until somebody asks for a mode [I]. So after a grace time the mode no longer blocks: low power first (the mode Android's RIL starts from), then online.
+ * A modem assert here stops Wi-Fi for the boot: only images without ipa=0 reach this (ipa_up). True = a request went out.
+ */
+static bool
+radio_step(uint64_t now)
+{
+	struct qb m;
+	uint8_t mode = 0;
+	bool early = opmode < 0 || opmode == 4 || opmode == 5;
+
+	if (!ipa_up() || sub_slot(0) < 0 || opmode == 0 || now < online_next) {
+		return false;
+	}
+	if (early && now - t_dms < MODE_GRACE_MS) {
+		return false;
+	}
+	if (!lpm_done && online_tries >= ONLINE_TRIES) {
+		return false;
+	}
+	if (!lpm_done) {
+		online_tries++;
+	}
+	/* 1 = low power already; 6, 7 are low power modes that ONLINE leaves */
+	if (!lpm_done && opmode != 1 && opmode != 6 && opmode != 7) {
+		mode = 1;
+		set_is_lpm = true;
+		LOG("radio on: DMS SET_OPERATING_MODE low power (reported %s, round %u)\n", opmode_name(opmode), online_tries);
+	} else {
+		set_is_lpm = false;
+		online_sent = true;
+		LOG("radio on: DMS SET_OPERATING_MODE online (reported %s, round %u)\n", opmode_name(opmode), online_tries);
+	}
+	qb_init(&m, DMS_SET_OPMODE);
+	qb_tlv(&m, 0x01, &mode, 1);
+	qc_send(&qc[C_DMS], &m);
+	return true;
+}
