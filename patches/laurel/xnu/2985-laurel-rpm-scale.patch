+/* Any clock of the GCC debug mux, MHz (debugcc-trinket.c: snoc_clk 0x7, pnoc_clk 0x11, bimc_clk 0x97; no post divider); 0: the counter does not count */
+static uint32_t
+bus_mhz(uint32_t sel)
+{
+	const uint32_t full_ticks = 0x2000;
+
+	WR(gcc, 0x62000, (RD(gcc, 0x62000) & ~0x3ffu) | sel);
+	WR(gcc, 0x30000, RD(gcc, 0x30000) & ~0xfu);
+	WR(gcc, 0x30004, RD(gcc, 0x30004) | 1u);
+	WR(gcc, 0x28008, RD(gcc, 0x28008) | 1u);
+	uint32_t a = count_run(0x1000), b = count_run(full_ticks);
+
+	WR(gcc, 0x28008, RD(gcc, 0x28008) & ~1u);
+	WR(gcc, 0x30004, RD(gcc, 0x30004) & ~1u);
+	if (a == 0 || b == 0 || a == b) {
+		return 0;
+	}
+	return (uint32_t)(((uint64_t)b * 10 + 15) * 4800000 / (full_ticks * 10 + 35) / 1000000);
