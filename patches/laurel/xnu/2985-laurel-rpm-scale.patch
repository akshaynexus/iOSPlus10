diff --git a/iokit/Kernel/arm/laurel_rpm_scale.h b/iokit/Kernel/arm/laurel_rpm_scale.h
new file mode 100644
index 0000000..3199115
--- /dev/null
+++ b/iokit/Kernel/arm/laurel_rpm_scale.h
@@ -0,0 +1,108 @@
+/*
+ * laurel 2985 (a piece of LaurelGpuDcvs.cpp): the stock way to make the RPM follow bus votes on the Mi A3 (SM6125 "trinket"). No hardware access: the kernel
+ * gives the operations in struct rs_ops, and the host test scripts/laurel/test-rpm-scale.sh runs this same text with a fake RPM made from the firmware's rules.
+ *
+ * Why [V rpm.mbn of the stock ROM, docs/laurel_sprout/gpu.md "RPM scaling"]: resource clk0 id 2 is the node /clk/dcvs.ena. While it is 0, each gated bus node (snoc, cnoc,
+ * snoc_periph, snoc_lpass, bimc, ipa, qup) acks a vote and keeps its state. When it goes to 1, the firmware applies at once what the masters asked for. A node that nobody
+ * voted for goes to its lowest level. So stock votes all of them first.
+ * Order [V drivers/clk/qcom/clk-smd-rpm.c rpm_smd_clk_probe, every stock boot]: BIMC INT_MAX in the active set (clk_vote_bimc), then each clock in the order of
+ * trinket_clks with its rate INT_MAX / 1000, active set then sleep set (clk_smd_rpm_prepare), then Enab = 1, sleep set then active set (clk_smd_rpm_enable_scaling).
+ * Not sent, against stock: the XO, QDSS and XO buffer votes of the same loop (branch clocks, key Enab / swen). The /clk/dcvs.ena driver does not read them [V], and stock
+ * drops most of them again at late init, so their state stays as ABL left it, as today. The stock keepalive votes (19.2 MHz) are below the top vote.
+ * The votes are never lowered, only BIMC: stock lowers them by msm_bus clients, which do not exist here, and a lower vote with no client could break a block.
+ */
+#define RS_SET_ACTIVE   0u
+#define RS_SET_SLEEP    1u
+#define RS_CLK0         0x306b6c63u     /* QCOM_SMD_RPM_MISC_CLK "clk0" */
+#define RS_CLK1         0x316b6c63u     /* QCOM_SMD_RPM_BUS_CLK */
+#define RS_CLK2         0x326b6c63u     /* QCOM_SMD_RPM_MEM_CLK */
+#define RS_CE           0x00006563u     /* QCOM_SMD_RPM_CE_CLK */
+#define RS_IPA          0x00617069u     /* QCOM_SMD_RPM_IPA_CLK */
+#define RS_QUP          0x00707571u     /* QCOM_SMD_RPM_QUP_CLK */
+#define RS_MMXI         0x69786d6du     /* QCOM_SMD_RPM_MMXI_CLK */
+#define RS_KEY_KHZ      0x007a484bu     /* QCOM_RPM_SMD_KEY_RATE */
+#define RS_KEY_ENAB     0x62616e45u     /* QCOM_RPM_SMD_KEY_ENABLE */
+#define RS_SCALING_ID   2u              /* QCOM_RPM_SCALING_ENABLE_ID */
+#define RS_BIMC_FIRST   0x7fffffffu     /* clk_vote_bimc(INT_MAX): the raw value */
+#define RS_TOP_KHZ      2147484u        /* to_active_sleep: DIV_ROUND_UP(INT_MAX, 1000) */
+#define RS_IMEM_ARMED   0x4c52504du     /* "LRPM" in the IMEM restart word while an enable is new: laurel_reboot.c */
+#define RS_ARMED_S      30u
+#define RS_READ_MS      200u
+
+struct rs_clock {
+	uint32_t type, id;
+	const char *name;
+};
+
+/* The rate clocks of trinket_clks, in the index order of dt-bindings/clock/qcom,rpmcc.h [V: tools/rpm-scale-test/check-table.py] */
+static const struct rs_clock rs_clocks[] = {
+	{ RS_CLK1, 2, "snoc" },
+	{ RS_CLK2, 0, "bimc" },
+	{ RS_IPA, 0, "ipa" },
+	{ RS_QUP, 0, "qup" },
+	{ RS_MMXI, 1, "mmrt" },
+	{ RS_MMXI, 0, "mmnrt" },
+	{ RS_CLK1, 0, "snoc_periph" },
+	{ RS_CLK1, 5, "snoc_lpass" },
+	{ RS_CLK1, 1, "cnoc" },
+	{ RS_CE, 0, "ce1" },
+};
+#define RS_N            (sizeof(rs_clocks) / sizeof(rs_clocks[0]))
+
+struct rs_ops {
+	bool (*write)(uint32_t set, uint32_t type, uint32_t id, uint32_t key, uint32_t value);  /* false: refused, or no ack */
+	uint32_t (*ddr)(void);                                                                  /* MHz; 0: no read */
+	void (*wait_ms)(uint32_t ms);
+};
+
+/* The stock order. false: *why says where it stopped, and no Enab went out: the RPM's gated nodes did not move. */
+static bool
+rs_enable(const struct rs_ops *ops, const char **why)
+{
+	if (!ops->write(RS_SET_ACTIVE, RS_CLK2, 0, RS_KEY_KHZ, RS_BIMC_FIRST)) {
+		*why = "the first BIMC vote";
+		return false;
+	}
+	for (uint32_t i = 0; i < RS_N; i++) {
+		if (!ops->write(RS_SET_ACTIVE, rs_clocks[i].type, rs_clocks[i].id, RS_KEY_KHZ, RS_TOP_KHZ) ||
+		    !ops->write(RS_SET_SLEEP, rs_clocks[i].type, rs_clocks[i].id, RS_KEY_KHZ, RS_TOP_KHZ)) {
+			*why = rs_clocks[i].name;
+			return false;
+		}
+	}
+	if (!ops->write(RS_SET_SLEEP, RS_CLK0, RS_SCALING_ID, RS_KEY_ENAB, 1)) {
+		*why = "Enab in the sleep set";
+		return false;
+	}
+	if (!ops->write(RS_SET_ACTIVE, RS_CLK0, RS_SCALING_ID, RS_KEY_ENAB, 1)) {
+		*why = "Enab in the active set";
+		return false;
+	}
+	return true;
+}
+
+/* The DDR read after the top vote: at most RS_READ_MS. A rise of 10 % says that the RPM follows; the value it stops at is what the line shows. */
+static uint32_t
+rs_read_rise(const struct rs_ops *ops, uint32_t boot)
+{
+	uint32_t now = 0;
+
+	for (uint32_t ms = 0; ms <= RS_READ_MS; ms += 5) {
+		ops->wait_ms(5);
+		now = ops->ddr();
+		if (now >= boot * 11 / 10) {
+			break;
+		}
+	}
+	return now;
+}
+
+/*
+ * The DDR level for a Gold clock: the stock table with the higher rows, cpu4_cpu_ddr_latmon of trinket.dtsi, ddr4-map (first row with core >= clock [V governor_memlat]). Stock asks a
+ * memory-bound load for this and asks only the row of 2016 MHz with no condition (cpu4_computemon). Here no PMU tells memory-bound load, and the owner asked for full speed.
+ */
+static inline uint32_t
+rs_gold_bus(uint32_t gold_mhz)
+{
+	return gold_mhz > 1804 ? 1804 : gold_mhz > 1401 ? 1555 : gold_mhz > 902 ? 1017 : 451;
+}
