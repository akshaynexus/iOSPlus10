+ * laurel 2976: which kept pool buffers go back, plain C, so that a host test runs exactly this file against the real pool bookkeeping
+ * (scripts/laurel/gpu-push-test.sh, tools/gpu-push-test/). RedwoodGPU.cpp gives the ops; TopazAdreno.cpp holds the pool's lock around lgk_plan_fit.
+ * Rule: a kept buffer goes back only when that helps the request, and only as many as it needs:
+ *   - a request the pool can never hold (over a chunk's room, or no pool): none;
+ *   - room by bytes under the floor (lgk_plan_floor): the oldest, until the free bytes are enough; none at all when all of them would not be enough;
+ *   - no free range that fits (lgk_plan_fit): the cheapest run of adjacent free ranges and kept buffers in one chunk that gives one range of the size.
+ *     None when no such run exists (outside neighbours are live buffers): then a drop would only hurt the next frame.
+ *   - the window server's only for its own request or pass-through, and only when the others' cannot do it.
+ *   - a buffer with a live user mapping is not a candidate: its memory cannot go back (RedwoodGPU.cpp gpuMappedWait).
+ */
+#ifndef LAUREL_GPU_KEPT_CORE_H
+#define LAUREL_GPU_KEPT_CORE_H
+
+#define LGK_ITEMS       512     /* candidates looked at, at most; past it fewer go back (safe: the request goes to scattered pages) */
+
+struct lgk_item {
+	uint64_t pa, len, since;
+	uint16_t client, slot;          /* the caller's: where it is */
+	bool chosen;
+};
+
+/*
+ * A pool buffer with a user mapping waits off the GPU's tables until the mapping has gone: the descriptor's retain count is the only proof the kernel has that no client can still reach
+ * the bytes. retains: count of the descriptor under gGPULock; 1 is the buffer's own reference. Not for own kernel memory (IOBufferMemoryDescriptor): a map of it holds the pages.
+ */
+struct lgk_mapped {
+	struct lgk_mapped *next;
+	void *memory;
+	uint64_t address, span;
+};
+
+static inline bool
+lgk_held_by_map(bool pool_address, bool kernel_memory, int retains)
+{
+	return pool_address && !kernel_memory && retains > 1;
+}
+
+/* What no map holds now: unlinked and passed to give_back, which frees the entry. The number that went back. */
+static inline unsigned
+lgk_mapped_sweep(struct lgk_mapped **head, int (*retains)(void *memory), void (*give_back)(struct lgk_mapped *m))
+{
+	unsigned count = 0;
+
+	while (*head != NULL) {
+		struct lgk_mapped *m = *head;
+
+		if (retains(m->memory) > 1) {
+			head = &m->next;
+			continue;
+		}
+		*head = m->next;
+		give_back(m);
+		count++;
+	}
+	return count;
+}
+
+/* a kept buffer of `size` bytes may stay kept: everything but the pool's room is the caller's */
+static inline bool
+lgk_may_keep(bool keep_on, uint64_t size, uint64_t from, uint64_t most, bool own_memory, bool in_pool, bool midmem, bool pool_room)
+{
+	return keep_on && size >= from && size <= most && own_memory && !(in_pool && !midmem && !pool_room);
+}
+
+struct lgk_slot {
+	bool used;
+	uint64_t size, since;
+};
+
+/*
+ * Where a new kept buffer goes, and which go first (oldest first) so that the bytes stay under `most`. evict[]: slot numbers, *evicts of them.
+ * The result: the free slot. The caller has size <= most.
+ */
+static inline int
+lgk_keep_pick(const struct lgk_slot *slots, unsigned n, uint64_t kept, uint64_t size, uint64_t most, unsigned *evict, unsigned *evicts)
+{
+	bool gone[64] = { false };
+	int place = -1;
+
+	*evicts = 0;
+	for (;;) {
+		int oldest = -1;
+
+		place = -1;
+		for (unsigned i = 0; i < n; i++) {
+			if (!slots[i].used || gone[i]) {
+				place = place >= 0 ? place : (int)i;
+			} else if (oldest < 0 || slots[i].since < slots[oldest].since) {
+				oldest = (int)i;
+			}
+		}
+		if (place >= 0 && kept + size <= most) {
+			return place;
+		}
+		if (oldest < 0) {
+			return place;           /* (size <= most: not reached) */
+		}
+		gone[oldest] = true;
+		kept -= slots[oldest].size;
+		evict[(*evicts)++] = (unsigned)oldest;
+	}
+}
+
+/* `need` bytes: the oldest until they are enough. Nothing when all are not enough. The bytes chosen. */
+static inline uint64_t
+lgk_plan_floor(struct lgk_item *items, unsigned n, uint64_t need)
+{
+	uint64_t all = 0, got = 0;
+
+	for (unsigned i = 0; i < n; i++) {
+		all += items[i].len;
+		items[i].chosen = false;
+	}
+	if (need == 0 || all < need) {
+		return 0;
+	}
+	while (got < need) {
+		struct lgk_item *oldest = NULL;
+
+		for (unsigned i = 0; i < n; i++) {
+			if (!items[i].chosen && (oldest == NULL || items[i].since < oldest->since)) {
+				oldest = &items[i];
+			}
+		}
+		oldest->chosen = true;
+		got += oldest->len;
+	}
+	return got;
+}
+
+#ifdef LAUREL_GPU_POOL_CORE_H
+#define LGK_SEGS        (LGP_RANGES + LGK_ITEMS)
+struct lgk_seg {
+	uint64_t pa, len;
+	int item;                       /* -1: a free range */
+};
+
+/* the pool's whole-unit size of a kept buffer */
+static inline uint64_t
+lgk_units(uint64_t size)
+{
+	return (size + GPU_POOL_UNIT - 1) & ~(uint64_t)(GPU_POOL_UNIT - 1);
+}
+
+/* the pool could ever give `size` bytes as one buffer */
+static inline bool
+lgk_pool_can_hold(uint64_t pool_size, uint64_t size)
+{
+	uint64_t whole = lgk_units(size);
+
+	return pool_size != 0 && size != 0 && whole <= GPU_POOL_CHUNK - GPU_POOL_UNIT && whole <= pool_size;
+}
+
+/*
+ * items[n] are buffers that are out and could go back. Which of them, set `chosen`, leave one free range of `size` bytes in one chunk, with the fewest
+ * kept bytes given up (equal: the older ones)? seg[LGK_SEGS]: room of the caller's. items[] comes back sorted by address. false: no set does it, none chosen.
+ */
+static inline bool
+lgk_plan_fit(const struct lgp *p, uint64_t size, struct lgk_item *items, unsigned n, struct lgk_seg *seg)
+{
+	unsigned count = 0, i = 0, r = 0, l = 0;
+	uint64_t whole = lgk_units(size), have = 0, cost = 0, newest = 0;
+	uint64_t best_cost = 0, best_newest = 0;
+	unsigned best_l = 0, best_r = 0;
+	bool found = false;
+
+	for (unsigned a = 1; a < n; a++) {
+		struct lgk_item it = items[a];
+		unsigned b = a;
+
+		for (; b > 0 && items[b - 1].pa > it.pa; b--) {
+			items[b] = items[b - 1];
+		}
+		items[b] = it;
+	}
+	for (unsigned a = 0; a < n; a++) {
+		items[a].chosen = false;
+	}
+	while ((i < n || r < p->count) && count < LGK_SEGS) {
+		if (r < p->count && (i >= n || p->range[r].start < items[i].pa)) {
+			seg[count].pa = p->range[r].start;
+			seg[count].len = p->range[r].size;
+			seg[count].item = -1;
+			count++;
+			r++;
+		} else {
+			/* (not really out, or not this size: never a candidate) */
+			if (lgp_is_out(p, items[i].pa, lgk_units(items[i].len))) {
+				seg[count].pa = items[i].pa;
+				seg[count].len = lgk_units(items[i].len);
+				seg[count].item = (int)i;
+				count++;
+			}
+			i++;
+		}
+	}
+	/* a window of adjacent segments of one chunk, as short as it can be for its end: the two ends walk up once each */
+	for (unsigned e = 0; e < count; e++) {
+		if (e != 0 && (seg[e - 1].pa + seg[e - 1].len != seg[e].pa ||
+		    (seg[e - 1].pa - p->base) / GPU_POOL_CHUNK != (seg[e].pa - p->base) / GPU_POOL_CHUNK)) {
+			l = e;
+			have = 0;
+			cost = 0;
+		}
+		have += seg[e].len;
+		if (seg[e].item >= 0) {
+			cost += seg[e].len;
+		}
+		while (l < e && have - seg[l].len >= whole) {
+			have -= seg[l].len;
+			if (seg[l].item >= 0) {
+				cost -= seg[l].len;
+			}
+			l++;
+		}
+		if (have >= whole) {
+			newest = 0;
+			for (unsigned w = l; w <= e; w++) {
+				if (seg[w].item >= 0 && items[seg[w].item].since > newest) {
+					newest = items[seg[w].item].since;
+				}
+			}
+			if (!found || cost < best_cost || (cost == best_cost && newest < best_newest)) {
+				found = true;
+				best_cost = cost;
+				best_newest = newest;
+				best_l = l;
+				best_r = e;
+			}
+		}
+	}
+	if (!found) {
+		return false;
+	}
+	for (unsigned w = best_l; w <= best_r; w++) {
+		if (seg[w].item >= 0) {
+			items[seg[w].item].chosen = true;
+		}
+	}
+	return true;
+}
+#endif /* LAUREL_GPU_POOL_CORE_H */
+
+/*
+ * The take itself, the same code on the phone and in the host test. ops->lock is RedwoodGPU's gGPULock. A request that a drop cannot help loses no kept buffer.
+ */
+struct lgk_ops {
+	void *ctx;
+	bool (*can_hold)(void *ctx, uint64_t size);
+	uint64_t (*alloc)(void *ctx, uint64_t size, void **va);
+	void (*lock)(void *ctx);
+	void (*unlock)(void *ctx);
+	unsigned (*collect)(void *ctx, struct lgk_item *items, unsigned most, bool window_server);
+	bool (*plan_fit)(void *ctx, uint64_t size, struct lgk_item *items, unsigned n);
+	uint64_t (*free_bytes)(void *ctx);
+	void (*drop)(void *ctx, const struct lgk_item *item);
+	void (*sweep)(void *ctx);
+};
+
+struct lgk_result {
+	uint64_t bytes;         /* kept bytes given back */
+	bool too_big;           /* the pool can never hold it: nothing given back */
+	bool no_help;           /* no set of kept buffers helps: nothing given back */
+};
+
+static inline uint64_t
+lgk_drop_chosen(const struct lgk_ops *o, const struct lgk_item *items, unsigned n)
+{
+	uint64_t bytes = 0;
+
+	for (unsigned i = 0; i < n; i++) {
+		if (items[i].chosen) {
+			bytes += items[i].len;
+			o->drop(o->ctx, &items[i]);
+		}
+	}
+	return bytes;
+}
+
+/* all: the window server's as well, when the others' cannot do it. items[LGK_ITEMS]: under ops->lock, the caller's room. */
+static inline uint64_t
+lgk_take(const struct lgk_ops *o, struct lgk_item *items, uint64_t size, void **va, bool all, struct lgk_result *res)
+{
+	uint64_t pa;
+
+	res->bytes = 0;
+	res->too_big = false;
+	res->no_help = false;
+	if (!o->can_hold(o->ctx, size)) {
+		res->too_big = true;
+		return 0;
+	}
+	pa = o->alloc(o->ctx, size, va);
+	if (pa != 0) {
+		return pa;
+	}
+	o->lock(o->ctx);
+	o->sweep(o->ctx);                       /* what waited for a user mapping that has gone */
+	pa = o->alloc(o->ctx, size, va);
+	for (unsigned pass = 0; pa == 0 && pass < (all ? 2u : 1u); pass++) {
+		unsigned n = o->collect(o->ctx, items, LGK_ITEMS, pass == 1);
+
+		if (n != 0 && o->plan_fit(o->ctx, size, items, n)) {
+			res->bytes += lgk_drop_chosen(o, items, n);
+			pa = o->alloc(o->ctx, size, va);
+		}
+	}
+	res->no_help = pa == 0 && res->bytes == 0;
+	o->unlock(o->ctx);
+	return pa;
+}
+
+/* the floor (a client that is not the window server, under `floor` free): the others' kept buffers, oldest first, as much as the request needs */
+static inline uint64_t
+lgk_floor(const struct lgk_ops *o, struct lgk_item *items, uint64_t size, uint64_t floor)
+{
+	uint64_t bytes = 0;
+
+	if (!o->can_hold(o->ctx, size)) {
+		return 0;
+	}
+	o->lock(o->ctx);
+	o->sweep(o->ctx);
+	{
+		uint64_t free_now = o->free_bytes(o->ctx), want = size + floor;
+
+		if (free_now < want) {
+			unsigned n = o->collect(o->ctx, items, LGK_ITEMS, false);
+
+			if (lgk_plan_floor(items, n, want - free_now) != 0) {
+				bytes = lgk_drop_chosen(o, items, n);
+			}
+		}
+	}
+	o->unlock(o->ctx);
+	return bytes;
+}
+
+#endif /* LAUREL_GPU_KEPT_CORE_H */
