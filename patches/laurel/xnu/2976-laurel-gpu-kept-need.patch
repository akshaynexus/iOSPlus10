+/*
+ * laurel 2976: a pool buffer goes back to the pool only when no user mapping of it is left. A pool descriptor is memory by address: a user mapping (an
+ * IOMemoryMap, which holds a retain of the descriptor) does not keep the pool from giving these bytes to another client, and then it reads and writes that
+ * client's buffer. Turnip gives its mapping back before GEM close [V tu_drm_bo_finish: redwood_drm_unmap, then GEM_CLOSE], so in normal use the count is 1 here.
+ * No trust in that: a client that closes or exits with the map still there (IOUserClient keeps maps with the connection, or with the task when the
+ * connection has gone: destroyUserReferences). Every retain of the descriptor is taken under gGPULock (clientMemoryForType) or held by a map: count 1 under the
+ * lock means no map, and none can come (the handle is gone). The buffer waits here, off the GPU's tables, until the count is 1; the next submission or a
+ * short pool looks again. Bounded by what the client had mapped; it holds only pool bytes, and a short pool sends others to scattered pages.
+ */
+#define kSamePlaceBase          0x80000000ull
+static struct lgk_mapped * gGPUMapped;          /* under gGPULock */
+static uint32_t gGPUMappedCount;
+static uint64_t gGPUMappedBytes;
+
+static bool
+gpuHeldByMap(IOMemoryDescriptor * memory, uint64_t address)
+{
+	return lgk_held_by_map(address >= kSamePlaceBase || redwood_gpu_identity(), OSDynamicCast(IOBufferMemoryDescriptor, memory) != NULL, memory->getRetainCount());
+}
+
+/* With the lock held; the buffer is off the GPU's tables. Takes over the caller's reference. */
+static void
+gpuMappedWait(IOMemoryDescriptor * memory, uint64_t address, uint64_t span)
+{
+	static uint32_t times;
+	struct lgk_mapped * m = IONew(struct lgk_mapped, 1);
+
+	if (m != NULL) {
+		m->next = gGPUMapped;
+		m->memory = memory;
+		m->address = address;
+		m->span = span;
+		gGPUMapped = m;
+		gGPUMappedCount++;
+		gGPUMappedBytes += span;
+	}                                       /* (no memory for the entry: the bytes stay out of the pool for good, and the descriptor with them) */
+	if (times++ < 8 || (times & 255) == 0) {
+		IOLog("LAUREL GPU POOL: a buffer of %llu bytes at %#llx waits: a user mapping is still there (%u waiting, %llu MiB, case %u)\n", span, address,
+		    gGPUMappedCount, gGPUMappedBytes >> 20, times);
+	}
+}
+
+static int
+gpuMappedRetains(void * memory)
+{
+	return ((IOMemoryDescriptor *) memory)->getRetainCount();
+}
+
+static void
+gpuMappedBack(struct lgk_mapped * m)
+{
+	gGPUMappedCount--;
+	gGPUMappedBytes -= m->span;
+	redwood_gpu_address_free(m->address, m->span);
+	((IOMemoryDescriptor *) m->memory)->release();
+	IODelete(m, struct lgk_mapped, 1);
+}
+
+/* With the lock held: what no user mapping holds now goes back. */
+static void
+gpuMappedSweep(void)
+{
+	(void) lgk_mapped_sweep(&gGPUMapped, gpuMappedRetains, gpuMappedBack);
+}
