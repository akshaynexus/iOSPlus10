diff -ruN a/bsd/dev/laurel_cam_vcm.c b/bsd/dev/laurel_cam_vcm.c
--- a/bsd/dev/laurel_cam_vcm.c
+++ b/bsd/dev/laurel_cam_vcm.c
@@ -0,0 +1,139 @@
+/*
+ * laurel_sprout (Mi A3, SM6125) camera (laurel 2773): the rear lens motor, DW9800W at 7-bit 0x0c on CCI M0 (the sensor's master),
+ * powered with the sensor (VAF, gpio 123). Numbers from the stock actuator library on the root (laurel_cam_mode.h); which library:
+ * the depth camera tells the module set (camera_config.xml: OV02A10 goes with the sunny rear module and libactuator_dw9800, GC2375H
+ * with the qtech one). Used only on the stream thread (the CCI has no lock). A failure turns off focus only: the frames say NO_FOCUS.
+ * Lines: "LAUREL CAMERA: focus: on: ..." or "LAUREL CAMERA: focus: off: <reason>".
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <machine/machine_routines.h>
+#include "laurel_cam.h"
+#include "laurel_cam_core.h"
+#include "laurel_cam_mode.h"
+
+extern int topaz_fw_read(const char *path, void **data, size_t *size);
+
+#define LIB_DIR         "/usr/share/firmware/laurel-camera/"
+#define POS_MIN         48u             /* off the stops: the whole stroke, as the module's calibration is not read */
+#define POS_MAX         960u
+#define LAND_STEP       48u
+
+static struct lcam_vcm_lib vl;
+static bool loaded, running, said_off;
+static unsigned master;
+static uint32_t pos;
+
+void
+lcam_vcm_load(bool sunny)
+{
+	static const char *const files[2] = { "libactuator_laurus_dw9800w_qtech.so", "libactuator_dw9800.so" };
+	char path[128];
+	void *data = NULL;
+	size_t size = 0;
+	int e;
+
+	snprintf(path, sizeof(path), LIB_DIR "%s", files[sunny ? 1 : 0]);
+	if ((e = topaz_fw_read(path, &data, &size)) != 0) {
+		LCAM_SAY("focus: off: no %s (error %d; root step root-camera.sh)\n", path, e);
+		return;
+	}
+	if (lcam_vcm_parse(data, size, &vl) != 0) {
+		LCAM_SAY("focus: off: %s: another layout\n", files[sunny ? 1 : 0]);
+		return;
+	}
+	loaded = true;
+	pos = vl.initial < POS_MIN ? POS_MIN : vl.initial > POS_MAX ? POS_MAX : vl.initial;
+	LCAM_SAY("focus: %s: DW9800 at %#x, init %u writes, initial code %u, %u steps\n", files[sunny ? 1 : 0], vl.addr7, vl.n,
+	    vl.initial, vl.steps);
+}
+
+static int
+put(uint32_t p)
+{
+	uint8_t b[3] = { vl.pos_reg, (uint8_t)(p >> 8), (uint8_t)p };
+
+	return lcam_cci_write(master, vl.addr7, b, 3);
+}
+
+/* after the sensor's power-up: the motor's settings, then the lens where it was at the end of the last session */
+void
+lcam_vcm_on(unsigned m)
+{
+	uint8_t reg = 2, got = 0xff;
+	int e = ENODEV;
+
+	master = m;
+	if (!loaded) {
+		return;
+	}
+	for (unsigned i = 0; i < vl.n; i++) {
+		uint8_t b[2] = { vl.reg[i], vl.val[i] };
+
+		if ((e = lcam_cci_write(m, vl.addr7, b, 2)) != 0) {
+			break;
+		}
+	}
+	e = e ? e : put(pos);
+	if (e != 0) {
+		if (!said_off) {
+			said_off = true;
+			LCAM_SAY("focus: off: no answer at %#x on CCI M%u (error %d): fixed focus\n", vl.addr7, m, e);
+		}
+		return;
+	}
+	running = true;
+	(void)lcam_cci_write_read(m, vl.addr7, &reg, 1, &got, 1);
+	LCAM_SAY("focus: on: DAC %u..%u, at %u, control %#x\n", POS_MIN, POS_MAX, pos, got);
+}
+
+bool
+lcam_vcm_running(void)
+{
+	return running;
+}
+
+uint32_t
+lcam_vcm_pos(void)
+{
+	return pos;
+}
+
+void
+lcam_vcm_range(uint32_t *lo, uint32_t *hi)
+{
+	*lo = POS_MIN;
+	*hi = POS_MAX;
+}
+
+void
+lcam_vcm_move(uint32_t p)
+{
+	if (!running) {
+		return;
+	}
+	p = p < POS_MIN ? POS_MIN : p > POS_MAX ? POS_MAX : p;
+	if (put(p) == 0) {
+		pos = p;
+	}
+}
+
+/* before the sensor's power goes: the lens set down step by step, so that it does not knock against its stop */
+void
+lcam_vcm_off(void)
+{
+	uint32_t p = pos;
+
+	if (!running) {
+		return;
+	}
+	while (p > POS_MIN + LAND_STEP) {
+		p -= LAND_STEP;
+		(void)put(p);
+		lcam_sleep_ms(2);
+	}
+	running = false;                        /* (pos stays: the next session starts there) */
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
