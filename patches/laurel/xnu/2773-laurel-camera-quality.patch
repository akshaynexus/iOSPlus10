+/*
+ * laurel_sprout (Mi A3, SM6125) camera (laurel 2773): the session modes on the hardware: which mode the next bring-up or switch uses,
+ * the size self-check of a mode, the receive path (VFE, ISPIF, CSID, CSIPHY) of one mode on and off without a sensor power-down.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <machine/machine_routines.h>
+#include "laurel_cam.h"
+#include "laurel_cam_core.h"
+#include "laurel_cam_st.h"
+
+/* laurel 2773: which session mode the next bring-up or switch uses: the sizes (LST_*) and st.m follow it */
+void
+lcam_mode_select(unsigned which)
+{
+	const struct lcam_smode *sm = &st.sm[which];
+
+	st.cur = which;
+	(void)lcam_lib_mode(st.lib, (uint32_t)sm->k, &st.m);
+	st.m.frame = (uint16_t)sm->frame;
+	st.m.w = sm->w;
+	st.m.h = sm->h;
+}
+
+/*
+ * laurel 2773: the self-check of a mode's size. The write master stops only at the frame's end: the last line of a frame of the right
+ * size is written (black is 64, never 0), and the line after it is not. Frames shorter or longer are the sensor's answer to a window
+ * it does not take. The buffers are larger than any frame by LST_SLACK.
+ */
+void
+lcam_tail_clear(void)
+{
+	uint32_t tail = LST_BYTES - LST_STRIDE, n = 2 * LST_STRIDE;
+
+	for (unsigned i = 0; i < LST_NBUF; i++) {
+		if (tail + n <= st.cap) {
+			bzero(st.va[i] + tail, n);
+		}
+	}
+}
+
+bool
+lcam_tail_check(const uint8_t *buf)
+{
+	uint32_t tail = LST_BYTES - LST_STRIDE, seen = 0, past = 0;
+
+	if (tail + 2 * LST_STRIDE > st.cap) {
+		return true;                    /* (no room past it: the stock mode, the buffer is exactly its size) */
+	}
+	for (uint32_t i = 0; i < LST_STRIDE; i += 64) {
+		seen += buf[tail + i] != 0;
+		past += buf[tail + LST_STRIDE + i] != 0;
+	}
+	return seen * 2 > LST_STRIDE / 64 && past == 0;
+}
+
+/* laurel 2773: the receive path of one mode (VFE, ISPIF, CSID, CSIPHY) on and off; also for a switch without a sensor power-down */
+int
+lcam_stream_path_on(unsigned *up, uint32_t settle, const char **why)
+{
+	int e;
+
+	if ((e = lcam_vfe_on((uint32_t)st.pa[0], (uint32_t)st.pa[1], why)) != 0) {
+		return e;
+	}
+	*up |= S_VFE;
+	if ((e = lcam_ispif_on(why)) != 0) {
+		return e;
+	}
+	*up |= S_ISPIF;
+	if ((e = lcam_csid_on(st.lib->lanes, LST_XML_ASSIGN, st.m.dt, st.m.decode, false, (uint16_t)LST_W, (uint16_t)LST_H, why)) != 0) {
+		return e;
+	}
+	*up |= S_CSID;
+	if ((e = lcam_csiphy_on(st.lib->lanes, settle, why)) != 0) {
+		return e;
+	}
+	*up |= S_PHY;
+	return 0;
+}
+
+void
+lcam_stream_path_off(unsigned *up)
+{
+	if (*up & S_VFE) {
+		lcam_vfe_off();
+	}
+	if (*up & S_ISPIF) {
+		lcam_ispif_off();
+	}
+	if (*up & S_CSID) {
+		lcam_csid_off();
+	}
+	if (*up & S_PHY) {
+		lcam_csiphy_off();
+	}
+	*up &= ~(unsigned)(S_VFE | S_ISPIF | S_CSID | S_PHY);
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
