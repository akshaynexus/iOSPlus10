diff -ruN a/bsd/dev/laurel_cam_mode.h b/bsd/dev/laurel_cam_mode.h
--- a/bsd/dev/laurel_cam_mode.h
+++ b/bsd/dev/laurel_cam_mode.h
@@ -0,0 +1,193 @@
+/*
+ * laurel_sprout (Mi A3, SM6125) camera (laurel 2773): the sensor modes of a session and the lens motor's data. Pure (no kernel
+ * calls; host-tested by tools/laurel-cam-test/cam4_test.c against the stock libraries).
+ *
+ * The real pixel rate [V boot 2026-11-01 18:40: 234 fps at 780 lines, 37 fps at 4862 lines; the library said 93.5 fps]: the
+ * library's vt_pixel_clk field is not the sensor's clock. INCK / IVT_PREPLLCK_DIV * IVT_PLL_MPY / IVT_SYCK_DIV / IVT_PXCK_DIV x 8
+ * (the IMX586's 8 pixel pipes [I]) over line_length x frame_length gives whole frame rates for all 7 modes of the table:
+ * 15, 30, 60, 90, 120, 30, 240 fps. The wrong clock made every exposure 2.57 times shorter than AE believed and the session
+ * ran at 77 fps instead of 30.
+ *
+ * Preview: mode 2 (1920x1080, 4x4 binned) shows 72 % of the sensor's height and mode 6 (1280x720) only 64 % x 48 %. The window of
+ * LCAM_SM_WINDOW is mode 2 with the standard CCS window registers opened to the whole height: 1920x1440, 96 % of the sensor each
+ * way, the view of the photograph. The tail check of laurel_cam_stream.c tests its size at boot; a failure falls back to the stock
+ * mode 2, then mode 6. Photograph: mode 1 (4000x3000, 2x2 binned).
+ */
+#ifndef LAUREL_CAM_MODE_H
+#define LAUREL_CAM_MODE_H
+#include <stdint.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include "laurel_cam_lib.h"
+#include "laurel_cam_rdi.h"
+
+#define LCAM_PIXEL_PIPES        8u
+enum { LCAM_SM_WINDOW, LCAM_SM_1080, LCAM_SM_720, LCAM_SM_STILL, LCAM_SM_N };
+
+struct lcam_smode {
+	int             k;                      /* the library's mode; -1: not there */
+	bool            window;                 /* the table + lcam_window_regs */
+	uint16_t        w, h;
+	uint32_t        stride, bytes;
+	uint32_t        line, frame;            /* line length in pixel clocks, shortest frame in lines */
+	uint32_t        vt_hz, line_ns;
+	uint32_t        sensor_w, sensor_h;     /* the part of the 8000x6000 sensor the frame shows */
+};
+
+/* Mode 2 needs 222 lines of blanking (1302 - 1080): 1500 binned lines + 222 */
+#define LCAM_WINDOW_W           1920u
+#define LCAM_WINDOW_H           1440u
+#define LCAM_WINDOW_FRAME       1722u
+static const struct {
+	uint16_t reg;
+	uint8_t val;
+} lcam_window_regs[] = {
+	{ 0x0346, 0x00 }, { 0x0347, 0x00 },     /* Y_ADDR_START 0 */
+	{ 0x034a, 0x17 }, { 0x034b, 0x6f },     /* Y_ADDR_END 5999 */
+	{ 0x040a, 0x00 }, { 0x040b, 0x1e },     /* DIG_CROP_Y_OFFSET 30 of 1500 */
+	{ 0x040e, 0x05 }, { 0x040f, 0xa0 },     /* DIG_CROP_HEIGHT 1440 */
+	{ 0x034e, 0x05 }, { 0x034f, 0xa0 },     /* Y_OUTPUT_SIZE 1440 */
+	{ 0x0340, 0x06 }, { 0x0341, 0xba },     /* FRM_LENGTH_LINES 1722 */
+};
+
+/* the value of one register in a table of the library (k: mode or LCAM_LIB_INIT_MODE) */
+static inline bool
+lcam_table_value(const struct lcam_lib *l, int k, uint16_t reg, uint8_t *v)
+{
+	const uint8_t *e;
+	uint32_t n = lcam_lib_table(l, k, &e), d;
+	uint16_t a;
+	uint8_t x;
+	bool found = false;
+
+	for (uint32_t i = 0; i < n; i++) {
+		lcam_lib_entry(e, i, &a, &x, &d);
+		if (a == reg) {
+			*v = x;
+			found = true;           /* (the last write wins) */
+		}
+	}
+	return found;
+}
+
+/* the pixel rate of mode k from its PLL registers, 0 when one is not in the tables */
+static inline uint32_t
+lcam_mode_vt_hz(const struct lcam_lib *l, int k)
+{
+	uint8_t a = 0, b = 0, px, sy, pre, mh, ml;
+	uint64_t hz;
+
+	if (!lcam_table_value(l, LCAM_LIB_INIT_MODE, 0x0136, &a) || !lcam_table_value(l, LCAM_LIB_INIT_MODE, 0x0137, &b) ||
+	    !lcam_table_value(l, k, 0x0301, &px) || !lcam_table_value(l, k, 0x0303, &sy) || !lcam_table_value(l, k, 0x0305, &pre) ||
+	    !lcam_table_value(l, k, 0x0306, &mh) || !lcam_table_value(l, k, 0x0307, &ml) || px == 0 || sy == 0 || pre == 0) {
+		return 0;
+	}
+	hz = (uint64_t)a * 1000000u + (uint64_t)b * 1000000u / 256u;
+	hz = hz * (uint32_t)(mh << 8 | ml) / pre / sy / px * LCAM_PIXEL_PIPES;
+	return hz > 0xffffffffull ? 0 : (uint32_t)hz;
+}
+
+/* one session mode from the library: false when the library has no such mode */
+static inline bool
+lcam_mode_build(const struct lcam_lib *l, unsigned which, struct lcam_smode *s)
+{
+	static const uint16_t size[LCAM_SM_N][2] = { { 1920, 1080 }, { 1920, 1080 }, { 1280, 720 }, { 4000, 3000 } };
+	struct lcam_mode m;
+	int k = lcam_lib_find(l, size[which][0], size[which][1]);
+	uint8_t bin = 0x22;
+
+	s->k = -1;
+	if (k < 0 || lcam_lib_mode(l, (uint32_t)k, &m) != 0) {
+		return false;
+	}
+	s->k = k;
+	s->window = which == LCAM_SM_WINDOW;
+	s->w = which == LCAM_SM_WINDOW ? (uint16_t)LCAM_WINDOW_W : m.w;
+	s->h = which == LCAM_SM_WINDOW ? (uint16_t)LCAM_WINDOW_H : m.h;
+	s->stride = lcam_raw10_stride(s->w);
+	s->bytes = s->stride * s->h;
+	s->line = m.line;
+	s->frame = which == LCAM_SM_WINDOW ? LCAM_WINDOW_FRAME : m.frame;
+	s->vt_hz = lcam_mode_vt_hz(l, k);
+	s->vt_hz = s->vt_hz ? s->vt_hz : m.vt_pclk;     /* (the laurel_cam_sess.c line says which) */
+	s->line_ns = s->vt_hz ? (uint32_t)(((uint64_t)m.line * 1000000000ull + s->vt_hz / 2) / s->vt_hz) : 0;
+	(void)lcam_table_value(l, k, 0x0901, &bin);
+	s->sensor_w = (uint32_t)s->w * (bin >> 4);
+	s->sensor_h = (uint32_t)s->h * (bin & 0xfu);
+	return true;
+}
+
+/* mean above black and the level 1 in 100 samples are above, both above black, and the highest sample (the session lines) */
+static inline void
+lcam_raw10_levels(const uint8_t *buf, uint32_t w, uint32_t h, uint32_t step, uint32_t black, uint32_t *mean, uint32_t *bright,
+    uint32_t *top)
+{
+	uint32_t hist[64] = { 0 }, n = 0, stride = lcam_raw10_stride(w), above = 0;
+	uint64_t sum = 0;
+
+	*top = 0;
+	*bright = 0;
+	for (uint32_t y = 0; y < h; y += step) {
+		for (uint32_t x = 0; x < w; x += step) {
+			uint32_t v = lcam_raw10_px(buf, stride, x, y);
+
+			v = v > black ? v - black : 0;
+			sum += v;
+			*top = v > *top ? v : *top;
+			hist[v >> 4 > 63 ? 63 : v >> 4]++;
+			n++;
+		}
+	}
+	*mean = n ? (uint32_t)(sum / n) : 0;
+	for (int i = 63; i >= 0; i--) {
+		above += hist[i];
+		if (above * 100 >= n) {
+			*bright = (uint32_t)i * 16 + 8;
+			break;
+		}
+	}
+}
+
+/*
+ * ---- the lens motor's library ----------------------------------------------------------------------------------------
+ * /usr/share/firmware/laurel-camera/libactuator_{dw9800,laurus_dw9800w_qtech}.so, .data [V read from both files, stock vendor]:
+ *   0x80 u32 I2C address (8-bit form, 0x18: DW9800W at 7-bit 0x0c); 0x84 1 = 400 kHz; 0x94 DAC bits (10); 0xa4 position register (3)
+ *   0x15c u32 count of init writes, 0x160 + i x 0x18: u32 register, u32, u32 value (dw9800: 02=02 06=80 07=5e; qtech: 02=02 06=40 07=7a)
+ *   0x180c u16 initial code (381, 150), 0x1810 u16 steps (481, 400): defaults; the module's own calibration is in its EEPROM (not read here)
+ */
+#define LCAM_VCM_MAX_INIT       8u
+#define LCAM_VCM_DATA           0x1c0cu
+struct lcam_vcm_lib {
+	uint8_t         addr7, pos_reg, n;
+	uint8_t         reg[LCAM_VCM_MAX_INIT], val[LCAM_VCM_MAX_INIT];
+	uint16_t        initial, steps;
+};
+
+static inline int
+lcam_vcm_parse(const uint8_t *f, size_t len, struct lcam_vcm_lib *v)
+{
+	uint32_t off, size, n;
+	const uint8_t *d;
+
+	if (!lcam_elf_data(f, len, &off, &size) || size != LCAM_VCM_DATA) {
+		return 1;
+	}
+	d = f + off;
+	n = lcam_le32(d + 0x15c);
+	if (lcam_le32(d + 0x94) != 10 || n == 0 || n > LCAM_VCM_MAX_INIT || lcam_le32(d + 0x80) == 0 || lcam_le32(d + 0x80) > 0xff ||
+	    lcam_le32(d + 0xa4) > 0xff) {
+		return 1;
+	}
+	v->addr7 = (uint8_t)(lcam_le32(d + 0x80) >> 1);
+	v->pos_reg = (uint8_t)lcam_le32(d + 0xa4);
+	v->n = (uint8_t)n;
+	for (uint32_t i = 0; i < n; i++) {
+		v->reg[i] = (uint8_t)lcam_le32(d + 0x160 + i * 0x18u);
+		v->val[i] = (uint8_t)lcam_le32(d + 0x168 + i * 0x18u);
+	}
+	v->initial = lcam_le16(d + 0x180c);
+	v->steps = lcam_le16(d + 0x1810);
+	return v->initial > 1023 ? 1 : 0;
+}
+
