 #include <kern/clock.h>
 #include <kern/misc_protos.h>
+#include <string.h>
 #include <kern/thread.h>
 #include <mach/vm_param.h>
 #include <pexpert/pexpert.h>
@@ -38,6 +39,7 @@
 extern uint64_t vm_swap_get_max_configured_space(void);
 extern unsigned int vm_page_free_count, vm_page_active_count, vm_page_inactive_count, vm_page_speculative_count, vm_page_wire_count;
 extern unsigned int memorystatus_level;
+extern char swapfilename[];
 
 #define LSW_PERIOD_MS   60000u
 
@@ -124,12 +126,18 @@
 		printf("LAUREL SWAP: off: no choice was made before vm_config_init (hook missing): mode as the kernel chose\n");
 		return;
 	}
-	if (lsw.after != lsw.before) {
-		printf("LAUREL SWAP: on: %s: mode 0x%x -> 0x%x: compressed pages go to /private/var/vm/swapfileN, at most %d x %u MiB, %u MiB RAM; off with laurelswap=0\n",
-		    lsw.why, lsw.before, lsw.after, vm_num_swap_files_config, mib(vm_swap_get_max_configured_space() / (vm_num_swap_files_config ? vm_num_swap_files_config : 1)),
-		    mib(max_mem));
+	if (lsw.after == LSW_COMPRESSOR_WITH_SWAP || lsw.after == LSW_FREEZER_WITH_SWAP) {
+		char was[24] = "";
+		if (lsw.after != lsw.before) {
+			snprintf(was, sizeof(was), " (was 0x%x)", lsw.before);
+		}
+		/* laurel 3081: this kernel is built for the macOS platform (XNU_TARGET_OS_OSX), so its mode was 0x4 from the start, with
+		 * macOS's swap path /System/Volumes/VM and 100 x 1 GiB files; 3081 gives it the iPhone's path and sizes */
+		printf("LAUREL SWAP: on: %s: mode 0x%x%s: compressed pages go to %sN, at most %d x %u MiB, %u MiB RAM; off with laurelswap=0\n",
+		    lsw.why, lsw.after, was, swapfilename, vm_num_swap_files_config,
+		    mib(vm_swap_get_max_configured_space() / (vm_num_swap_files_config ? vm_num_swap_files_config : 1)), mib(max_mem));
 	} else {
-		printf("LAUREL SWAP: off: %s: mode 0x%x stays\n", lsw.why, lsw.before);
+		printf("LAUREL SWAP: off: %s: mode 0x%x stays, no swap file\n", lsw.why, lsw.before);
 	}
 	if (kernel_thread_start(laurel_swap_thread, NULL, &t) == KERN_SUCCESS) {
 		thread_set_thread_name(t, "laurel_swap");
