laurel 2302: charge-only boot and a real power off. Charge mode (negroni 0377 idea): before launchd (load_init_program), a cold charger power-on (PM6125 PON_REASON1 0x8c0 USB_CHG/CBL/DC, or PON1 with the PMI632 charger reason; no warm-reset reason 0x8c2, no hard reset/SMPL/RTC/power key) with the charger still in keeps launchd stopped and prints the battery on the kernel console every 10 s while the charger loop runs; power key = boot iOS, charger out for 3 s = power off; any failed check (also 10 failed PMIC reads in a row inside charge mode) boots iOS normally; power key polled every 200 ms; power off only after the USBIN plug-in RT bit is clear for 5 s (a collapsing charger keeps it). Power off and restart release our USB input suspend first; the PS_HOLD writes are checked and read back (failure logged, the S2 enable always restored). Lines 'LAUREL CHARGE MODE: on: normal boot (pon .. warm .. pmi .. charger N)' / 'on: charger power-on ...' / 'off: <reason>'; kill switch laurelchgmode=0. Power off (2003) now sets the PM6125 PS_HOLD reset type to SHUTDOWN (0x85A type 4 with the 0x85B enable cleared and set, as Linux qpnp_pon_system_pwr_off) before PSCI SYSTEM_OFF, and writes the old type back if PSCI returns; a plain restart selects HARD_RESET (type 7, msm-poweroff without a command), a restart with a reason keeps the 2018 warm reset; line 'LAUREL REBOOT: PS_HOLD_RST_CTL 0x.. -> 0x.. (shutdown)'.

diff -ruN a/bsd/dev/laurel_pmi632.c b/bsd/dev/laurel_pmi632.c
--- a/bsd/dev/laurel_pmi632.c	2026-11-01 05:08:53.033026620 +0530
+++ b/bsd/dev/laurel_pmi632.c	2026-11-01 05:09:33.453487740 +0530
@@ -1110,4 +1110,128 @@
 	IOLockUnlock(lp_lock);
 	return 0;
 }
+/*
+ * laurel 2302: charge-only boot (negroni 0377 idea, Mi A3 path). Powered off + a charger plugged in:
+ * the PMIC powers on (PON reason USB_CHG / CBL / DC on the PM6125, or PON1 = the PMI632 with the
+ * charger reason), ABL starts boot_b (our UEFI image; androidboot.mode=charger, if ABL adds it, is not
+ * passed on by Mu/DarwinBoot), and iOS would come up fully. Here, before launchd (load_init_program):
+ * a cold charger power-on (no warm-reset reason, no hard reset / SMPL / RTC / power key) with the
+ * charger still in enters charge mode: no launchd, one console line every 10 s with the battery
+ * (kernel console on the panel), the charger loop runs (SweetBattery's 10 s poll and our sample).
+ * Power key pressed: leave charge mode and boot iOS. Cable out (USBIN plug-in RT clear) for 5 s: power off. Any check that
+ * fails boots iOS normally, also 10 failed PMIC reads in a row inside charge mode. Kill switch
+ * laurelchgmode=0. [U] If ABL itself stops on a cable power-on (its charger screen, or fastboot), our
+ * kernel never runs: that case is ABL's (docs/laurel_sprout/battery-power.md).
+ */
+extern void laurel_power_off(void);
+#define CM_FAILS 10
+#define CM_OUT_S 5      /* USBIN plug-in RT clear for 5 checks (1 s apart) before power off */
+
+/* charger in now: USBIN plug-in RT status and a valid input in the power path */
+static int
+lp_external(void)
+{
+	uint8_t usbrt = 0, path = 0;
+	if (rd(USBIN + 0x10, &usbrt) || rd(DCDC + 0x0b, &path)) {
+		return -1;
+	}
+	return (usbrt & 0x10u) && ((path & 0x01u) || lp_usb_susp);   /* our warm-zone suspend: still plugged */
+}
+
+/* cable present: USBIN plug-in RT status alone (a collapsing or weak charger keeps it; the power path
+ * may drop). 1 in, 0 out, -1 read failed. Charge mode powers off only on this one. */
+static int
+lp_plugged(void)
+{
+	uint8_t usbrt = 0;
+	if (rd(USBIN + 0x10, &usbrt)) {
+		return -1;
+	}
+	return (usbrt & 0x10u) != 0;
+}
+
+/* power key down (PM6125 PON INT_RT_STS 0x810 bit 0): 1 down, 0 up, -1 no agreeing read (the keys thread
+ * polls the same APID). Polled every 200 ms: a press shorter than that can be missed [I]. */
+static int
+lp_power_key(void)
+{
+	uint8_t a = 0, b = 0;
+	for (unsigned t = 0; t < 3; t++) {
+		if (sweet_spmi_pon_read(0x810, &a) == 0 && sweet_spmi_pon_read(0x810, &b) == 0 && a == b) {
+			return (a & 1u) != 0;
+		}
+	}
+	return -1;
+}
+
+void
+laurel_charge_mode(void)
+{
+	int on = 1;
+	(void)PE_parse_boot_argn("laurelchgmode", &on, sizeof(on));
+	if (!on) {
+		printf("LAUREL CHARGE MODE: off: laurelchgmode=0\n");
+		return;
+	}
+	if (laurel_pmi632_init() != 0) {
+		printf("LAUREL CHARGE MODE: off: no PMI632 gauge\n");
+		return;
+	}
+	uint8_t r = 0, w = 0, p = 0;
+	if (laurel_pmi632_pon(&r, &w, &p) != 0) {
+		printf("LAUREL CHARGE MODE: off: PM6125 PON reason not read\n");
+		return;
+	}
+	/* PON_REASON1: 0 HARD_RESET, 1 SMPL, 2 RTC, 3 DC_CHG, 4 USB_CHG, 5 PON1 (secondary PMIC), 6 CBL, 7 KPD */
+	bool cable = (r & 0x58u) || ((r & 0x20u) && (p & 0x58u));
+	bool other = (r & 0x87u) != 0;
+	int ext = lp_external();
+	if (w || other || !cable || ext != 1) {
+		printf("LAUREL CHARGE MODE: on: normal boot (pon 0x%02x warm 0x%02x pmi 0x%02x charger %d)\n", r, w, p, ext);
+		return;
+	}
+	printf("LAUREL CHARGE MODE: on: charger power-on (pon 0x%02x pmi 0x%02x): charging screen; power key = boot iOS, cable out 5 s = power off\n",
+	    r, p);
+	/* 200 ms ticks: power key every tick, charger presence every 1 s, battery line every 10 s.
+	 * CM_FAILS reads in a row that fail: leave charge mode and boot iOS (never hang on a dead bus). */
+	unsigned out_n = 0, fails = 0;
+	for (unsigned tick = 0;; tick++) {
+		int k = lp_power_key();
+		fails = (k < 0) ? fails + 1 : fails;
+		if (k == 1) {
+			printf("LAUREL CHARGE MODE: power key: booting iOS\n");
+			return;
+		}
+		if (tick % 5 == 0) {
+			IOLockLock(lp_lock);
+			int e = lp_plugged();
+			IOLockUnlock(lp_lock);
+			fails = (e < 0) ? fails + 1 : (k >= 0 ? 0 : fails);
+			out_n = (e == 0) ? out_n + 1 : (e == 1 ? 0 : out_n);
+			if (out_n >= CM_OUT_S) {
+				printf("LAUREL CHARGE MODE: charger out: power off\n");
+				delay(200000);
+				laurel_power_off();
+				printf("LAUREL CHARGE MODE: power off refused: booting iOS\n");
+				return;
+			}
+		}
+		if (tick % 50 == 0) {
+			struct laurel_batt b;
+			if (laurel_pmi632_sample(&b) == 0) {
+				printf("LAUREL CHARGE MODE: battery %u%% %s, %u mV %d mA %d.%d C\n", b.soc,
+				    b.full ? "full" : b.charging ? "charging" : "not charging", b.mv, b.ma, b.temp_dC / 10,
+				    (b.temp_dC < 0 ? -b.temp_dC : b.temp_dC) % 10);
+			} else {
+				fails++;
+			}
+		}
+		if (fails >= CM_FAILS) {
+			printf("LAUREL CHARGE MODE: off: %u PMIC reads failed in a row: booting iOS\n", fails);
+			return;
+		}
+		IOSleep(200);
+	}
+}
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
