diff -ruN a/bsd/dev/laurel_reboot.c b/bsd/dev/laurel_reboot.c
--- a/bsd/dev/laurel_reboot.c	2026-11-01 04:17:22.480216098 +0530
+++ b/bsd/dev/laurel_reboot.c	2026-11-01 04:23:49.765152850 +0530
@@ -147,9 +147,34 @@
 	    spare, back, reason, w1, w2, w3, w4);
 }
 
+/*
+ * laurel 2302: power off = PS_HOLD shutdown on the PM6125 PON, as Linux qpnp_pon_system_pwr_off
+ * (qpnp_pon_reset_config: clear the S2 enable 0x85B bit 7, type 4 = SHUTDOWN in 0x85A [3:0], enable
+ * again) before PSCI SYSTEM_OFF; the PMIC otherwise keeps the type XBL/ABL left (a hard reset type
+ * turns the PS_HOLD drop into a reboot). No PON lane (self-check of 2018 failed): PSCI alone.
+ */
+static void
+lr_pon_shutdown_type(void)
+{
+	if (lr_pon_shift < 0) {
+		kdb_printf("LAUREL REBOOT: PS_HOLD type not set (no PON lane)\n");
+		return;
+	}
+	uint8_t ctl = 0, ctl2 = 0, back = 0;
+	(void)sweet_spmi_pon_read(LR_PON_RST_CTL2, &ctl2);
+	int w1 = sweet_spmi_pon_write(LR_PON_RST_CTL2, (uint8_t)(ctl2 & ~0x80u));
+	delay(500);
+	(void)sweet_spmi_pon_read(LR_PON_RST_CTL, &ctl);
+	int w2 = sweet_spmi_pon_write(LR_PON_RST_CTL, (uint8_t)((ctl & ~0x0fu) | 0x04u));
+	int w3 = sweet_spmi_pon_write(LR_PON_RST_CTL2, (uint8_t)(ctl2 | 0x80u));
+	(void)sweet_spmi_pon_read(LR_PON_RST_CTL, &back);
+	kdb_printf("LAUREL REBOOT: PS_HOLD_RST_CTL 0x%02x -> 0x%02x (shutdown), writes %d %d %d\n", ctl, back, w1, w2, w3);
+}
+
 void
 laurel_power_off(void)
 {
+	lr_pon_shutdown_type();
 	kdb_printf("LAUREL REBOOT: PSCI SYSTEM_OFF\n");
 	int64_t rc = lr_psci(PSCI_SYSTEM_OFF);
 	kdb_printf("LAUREL REBOOT: PSCI SYSTEM_OFF returned %lld\n", (long long)rc);
