--- a/bsd/dev/laurel_reboot.c	2026-11-01 05:07:24.000000000 +0530
+++ b/bsd/dev/laurel_reboot.c	2026-11-01 05:07:52.874193438 +0530
@@ -39,6 +39,7 @@
  * word alone did nothing on this device (boot 2026-11-01 03:48: "ctl bootloader" booted normally).
  */
 #include "sweet_spmi.h"
+#include "laurel_pmi632.h"   /* laurel 2302: laurel_pmi632_release_input */
 #define LR_PON_SUBTYPE   0x805u
 #define LR_PON_RST_CTL   0x85au
 #define LR_PON_RST_CTL2  0x85bu
@@ -147,22 +148,72 @@
 	    spare, back, reason, w1, w2, w3, w4);
 }
 
+/*
+ * laurel 2302: every reset selects its own PS_HOLD type on the PM6125 PON, as Linux does
+ * (qpnp_pon_reset_config: clear the S2 enable 0x85B bit 7, type in 0x85A [3:0], enable again; types of
+ * qcom,qpnp-power-on.h: 1 warm reset, 4 shutdown, 7 hard reset). The PMIC otherwise keeps the type of
+ * the last writer (boot 2026-11-01 03:59: 0x01 = warm, so a PS_HOLD drop for "power off" resets).
+ *   power off             4 SHUTDOWN (msm-poweroff do_msm_poweroff), then PSCI SYSTEM_OFF; if PSCI
+ *                         returns, the old type is written back
+ *   restart, no reason    7 HARD_RESET (msm_restart_prepare without a command; no
+ *                         qcom,force-warm-reboot in the Mi A3 DT)
+ *   restart with reason   1 WARM_RESET + SOFT_RB_SPARE (2018 lr_pon_set)
+ * No PON lane (self-check of 2018 failed): PSCI alone, as before.
+ * Returns the old type, -1 when nothing was written. kdb_printf only (panic hold, timer call).
+ */
+static int
+lr_pon_type(uint8_t type, const char *what)
+{
+	if (lr_pon_shift < 0) {
+		kdb_printf("LAUREL REBOOT: PS_HOLD type not set (no PON lane)\n");
+		return -1;
+	}
+	uint8_t ctl = 0, ctl2 = 0, back = 0;
+	if (sweet_spmi_pon_read(LR_PON_RST_CTL2, &ctl2) != 0 || sweet_spmi_pon_read(LR_PON_RST_CTL, &ctl) != 0) {
+		kdb_printf("LAUREL REBOOT: PS_HOLD type not set (PON read failed)\n");
+		return -1;
+	}
+	int w1 = sweet_spmi_pon_write(LR_PON_RST_CTL2, (uint8_t)(ctl2 & ~0x80u));
+	delay(500);
+	int w2 = w1 == 0 ? sweet_spmi_pon_write(LR_PON_RST_CTL, (uint8_t)((ctl & ~0x0fu) | (type & 0x0fu))) : -1;
+	/* the S2 enable goes back on in every case (also when the type write failed) */
+	int w3 = sweet_spmi_pon_write(LR_PON_RST_CTL2, (uint8_t)(ctl2 | 0x80u));
+	int r = sweet_spmi_pon_read(LR_PON_RST_CTL, &back);
+	int ok = w1 == 0 && w2 == 0 && w3 == 0 && r == 0 && (back & 0x0f) == (type & 0x0f);
+	kdb_printf("LAUREL REBOOT: PS_HOLD_RST_CTL 0x%02x -> 0x%02x (%s)%s, writes %d %d %d\n", ctl, back, what,
+	    ok ? "" : " NOT SET: the PMIC keeps its old type", w1, w2, w3);
+	return ok ? (ctl & 0x0f) : -1;
+}
+
 void
 laurel_power_off(void)
 {
+	laurel_pmi632_release_input();          /* the charger must not stay suspended while off */
+	int old = lr_pon_type(0x04, "shutdown");
+	if (old < 0) {
+		kdb_printf("LAUREL REBOOT: power off without the shutdown type: the PS_HOLD drop may reset\n");
+	}
 	kdb_printf("LAUREL REBOOT: PSCI SYSTEM_OFF\n");
 	int64_t rc = lr_psci(PSCI_SYSTEM_OFF);
 	kdb_printf("LAUREL REBOOT: PSCI SYSTEM_OFF returned %lld\n", (long long)rc);
+	if (old >= 0) {
+		(void)lr_pon_type((uint8_t)old, "restored");
+	}
 }
 
 void
 laurel_restart(void)
 {
+	laurel_pmi632_release_input();
 	if (lr_reason != NULL) {
 		*lr_reason = lr_modes[lr_mode].imem;
 		__asm__ volatile ("dsb sy" ::: "memory");
 	}
-	lr_pon_set(lr_modes[lr_mode].pon);
+	if (lr_modes[lr_mode].pon) {
+		lr_pon_set(lr_modes[lr_mode].pon);
+	} else {
+		(void)lr_pon_type(0x07, "hard reset");   /* laurel 2302: plain restart, msm-poweroff */
+	}
 	/* kdb_printf: also safe in the panic hold (console only, no os_log, no locks) */
 	kdb_printf("LAUREL REBOOT: PSCI SYSTEM_RESET (%s)\n", lr_modes[lr_mode].name);
 	int64_t rc = lr_psci(PSCI_SYSTEM_RESET);
