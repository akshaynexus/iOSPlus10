- * Init is serialized by the single built-in SweetBattery personality.
+ * Battery adaptation of input/sweet_keys.c, observer EXT_READL.
+ * laurel 2300: plus owner-checked writes to a short list of PMI632 registers
+ * (charger limits, ADC conversion request, our SDAM record), see sweet_spmi_write.
  * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
@@ -143,14 +142,71 @@
