+/* after the firmware, before the channels (ipa3_post_init reads these here): nothing the v4.2 tables rely on changed */
+bool
+lipa_fw_recheck(struct lipa_mem *m, char *why, size_t wl)
+{
+	uint32_t ver = rd(m, R_VERSION), sms = rd(m, R_SHARED_MEM_SIZE), base = 8 * (sms >> 16), comp = rd(m, R_COMP_CFG);
+	uint32_t grp = rd(m, R_SRC_RSRC_GRP_01(0)), idle = rd(m, R_IDLE_INDICATION_CFG);
+
+	m->pipes = rd(m, R_ENABLED_PIPES);
+	LOG("after the firmware: IPA_VERSION %08x, SHARED_MEM_SIZE %08x: %u bytes at offset 0x%x%s, %u pipes\n", ver, sms,
+	    8 * (sms & 0xFFFF), base, base == m->restricted ? " (same)" : " (CHANGED)", m->pipes);
+	if (ver != m->version) {
+		snprintf(why, wl, "IPA_VERSION changed from %08x to %08x with the firmware", m->version, ver);
+		return false;
+	}
+	m->restricted = base;
+	m->size = 8 * (sms & 0xFFFF);
+	if (!mem_fits(m, why, wl)) {
+		return false;
+	}
+	if ((comp & V_COMP_BITS) != V_COMP_BITS || (grp & 0x3F3F) != 0x3F03 || (idle & 0xFFFF) != V_IDLE_INDICATION) {
+		snprintf(why, wl, "the firmware load changed the IPA registers (COMP_CFG %08x, SRC_RSRC_GRP %08x, IDLE %08x)",
+		    comp, grp, idle);
+		return false;
+	}
