diff -ruN a/bsd/dev/laurel_ipa_gsi.c b/bsd/dev/laurel_ipa_gsi.c
--- a/bsd/dev/laurel_ipa_gsi.c	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_ipa_gsi.c	2026-11-01 17:21:16.359344031 +0530
@@ -0,0 +1,165 @@
+/*
+ * laurel_sprout (Mi A3, SM6125) IPA v4.2 AP side (laurel 2782): the GSI channels. The AP must allocate them, the modem's
+ * too, before the modem initializes its channels. Stock 4.14: ipa3_post_init() "GSI 2.2 requires to allocate all EE GSI
+ * channel during device bootup" -> ipa3_alloc_gsi_channel() -> gsi_alloc_channel_ee(), after gsi_register_device() and
+ * before the AP sends QMI INIT_MODEM_DRIVER. Mainline gsi.c: "IPA v4.2 requires the AP to allocate channels for the modem"
+ * (a hardware quirk). Without it the modem firmware asserted: ipa_hal.c:6001 "Failed to initialize GSI channel: CHID 1
+ * errval 6" (USB log 2026-11-01 17:01; channel 1 of EE 1 = Q6_CMD_PROD; 6 = GSI_STATUS_INVALID_PARAMS in the AP's enum).
+ *
+ * Polled: nobody takes the GSI interrupt in this kernel. The generic command's return code is in CNTXT_SCRATCH_0; an AP
+ * channel's state is in its context. Only reads and writes through lipa_gsi_rd/wr (laurel_ipa_hw.c; the simulated GSI
+ * of tools/laurel-ipa-test/gsi_test.c in the host test).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include "laurel_ipa_regs.h"
+
+extern void IOSleep(unsigned int milliseconds);
+
+#define LOG(...)                printf("LaurelIPA: " __VA_ARGS__)
+
+#define CMD_WAIT_MS             5000u           /* GSI_CMD_TIMEOUT (5 * HZ) */
+#define CH_STATE(v)             (((v) >> 20) & 0xFu)
+#define CH_NOT_ALLOCATED        0u
+#define CH_ALLOCATED            1u
+#define OP_GENERIC_ALLOC        2u              /* GSI_GEN_EE_CMD_ALLOC_CHANNEL */
+#define CODE_SUCCESS            1u              /* GSI_GEN_EE_CMD_RETURN_CODE_SUCCESS */
+#define GEN_CODE(v)             (((v) >> 5) & 7u)       /* struct gsi_ee_scratch generic_ee_cmd_return_code */
+#define GEN_CODE_MASK           (7u << 5)
+#define GP_INT1                 2u              /* CNTXT_GLOB_IRQ bit */
+#define TYPE_CH_CTRL_GLOB_EE    5u              /* CNTXT_TYPE_IRQ_MSK: CH_CTRL (0) + GLOB_EE (2) */
+
+/*
+ * ipa3_ep_mapping[IPA_4_2] in ipa3_alloc_gsi_channel()'s order: pipe 0, 1, ...; for each pipe the client that
+ * ipa3_get_client_by_pipe() finds first (lowest enum value, so no TEST_* client): { GSI channel, EE }.
+ * EE 0 = AP, 1 = modem (IPA_EE_Q6), 2 = uC (IPA_EE_UC).
+ */
+static const struct { uint8_t ch, ee; } pipe_ch[] = {
+	{ 5, 0 },       /*  0 USB_PROD */
+	{ 0, 0 },       /*  1 APPS_WAN_PROD */
+	{ 6, 0 },       /*  2 APPS_LAN_PROD */
+	{ 7, 0 },       /*  3 WLAN1_PROD */
+	{ 0, 1 },       /*  4 Q6_WAN_PROD */
+	{ 1, 1 },       /*  5 Q6_CMD_PROD: CHID 1 of the 17:01 assert */
+	{ 1, 0 },       /*  6 APPS_CMD_PROD */
+	{ 0, 2 },       /*  7 ETHERNET_PROD */
+	{ 2, 0 },       /*  8 APPS_LAN_CONS */
+	{ 3, 0 },       /*  9 APPS_WAN_CONS */
+	{ 2, 1 },       /* 10 Q6_WAN_CONS */
+	{ 3, 1 },       /* 11 Q6_LAN_CONS */
+	{ 4, 0 },       /* 12 USB_DPL_CONS */
+	{ 4, 1 },       /* 13 Q6_LTE_WIFI_AGGR_CONS: the last modem pipe */
+	{ 8, 0 },       /* 14 WLAN1_CONS */
+	{ 9, 0 },       /* 15 USB_CONS */
+	{ 1, 2 },       /* 16 ETHERNET_CONS */
+};
+#define PIPE_COUNT              (sizeof(pipe_ch) / sizeof(pipe_ch[0]))
+#define PIPES_MIN               14u             /* every modem pipe is below this */
+#define CH_MAX_USED             9u              /* highest channel number in the table */
+
+static void
+say_error(char *why, size_t wl, const char *what, uint32_t pipe, uint32_t ch, uint32_t ee, uint32_t value)
+{
+	snprintf(why, wl, "GSI channel %u of EE %u (pipe %u): %s %u, GLOB_IRQ %08x, ERROR_LOG %08x", ch, ee, pipe, what, value,
+	    lipa_gsi_rd(G_GLOB_IRQ_STTS), lipa_gsi_rd(G_ERROR_LOG));
+}
+
+/* gsi_alloc_ap_channel(): GSI_CH_ALLOCATE through our own EE; done when the context says ALLOCATED */
+static bool
+ap_alloc(uint32_t pipe, uint32_t ch, char *why, size_t wl)
+{
+	uint32_t st = CH_STATE(lipa_gsi_rd(G_CH_CNTXT_0(ch)));
+
+	if (st == CH_ALLOCATED) {
+		return true;
+	}
+	if (st != CH_NOT_ALLOCATED) {
+		say_error(why, wl, "before ALLOCATE the state is", pipe, ch, 0, st);
+		return false;
+	}
+	lipa_gsi_wr(G_CH_CMD, ch);              /* opcode GSI_CH_ALLOCATE = 0 in bits 31:24, channel in 7:0 */
+	for (uint32_t ms = 0; ms < CMD_WAIT_MS; ms++) {
+		st = CH_STATE(lipa_gsi_rd(G_CH_CNTXT_0(ch)));
+		if (st != CH_NOT_ALLOCATED) {
+			break;
+		}
+		IOSleep(1);
+	}
+	lipa_gsi_wr(G_SRC_CH_IRQ_CLR, 1u << ch);
+	if (st != CH_ALLOCATED) {
+		say_error(why, wl, "after ALLOCATE the state is", pipe, ch, 0, st);
+		return false;
+	}
+	return true;
+}
+
+/* gsi_alloc_channel_ee(): the generic command for another EE's channel. Only code SUCCESS counts: the AP cannot read
+ * the modem's channel state, so this code is the only proof (the stock driver also accepts codes 2-6; we do not) */
+static bool
+ee_alloc(uint32_t pipe, uint32_t ch, uint32_t ee, char *why, size_t wl)
+{
+	uint32_t en = lipa_gsi_rd(G_GLOB_IRQ_EN), code = 0;
+
+	lipa_gsi_wr(G_GLOB_IRQ_EN, en | GP_INT1);
+	lipa_gsi_wr(G_SCRATCH_0, lipa_gsi_rd(G_SCRATCH_0) & ~GEN_CODE_MASK);
+	lipa_gsi_wr(G_GENERIC_CMD, OP_GENERIC_ALLOC | ch << 5 | ee << 10);
+	for (uint32_t ms = 0; ms < CMD_WAIT_MS; ms++) {
+		code = GEN_CODE(lipa_gsi_rd(G_SCRATCH_0));
+		if (code != 0 || (lipa_gsi_rd(G_GLOB_IRQ_STTS) & GP_INT1) != 0) {
+			break;
+		}
+		IOSleep(1);
+	}
+	code = GEN_CODE(lipa_gsi_rd(G_SCRATCH_0));
+	if (code != CODE_SUCCESS) {
+		say_error(why, wl, code == 0 ? "no answer to ALLOCATE in 5 s, code" : "ALLOCATE refused, code", pipe, ch, ee, code);
+	}
+	lipa_gsi_wr(G_GLOB_IRQ_CLR, GP_INT1);
+	lipa_gsi_wr(G_GLOB_IRQ_EN, en & ~GP_INT1);
+	return code == CODE_SUCCESS;
+}
+
+/* gsi_register_device() (the parts without an interrupt handler) + ipa3_alloc_gsi_channel() */
+bool
+lipa_gsi_alloc(uint32_t pipes, char *why, size_t wl)
+{
+	uint32_t max_ch = (lipa_gsi_rd(G_HW_PARAM_2) >> 3) & 0x1Fu, n[3] = { 0, 0, 0 }, type, log;
+	bool ok = true;
+
+	if (max_ch <= CH_MAX_USED) {
+		snprintf(why, wl, "GSI has %u channels per EE (HW_PARAM_2 %08x), the v4.2 table needs %u", max_ch,
+		    lipa_gsi_rd(G_HW_PARAM_2), CH_MAX_USED + 1);
+		return false;
+	}
+	if (pipes < PIPES_MIN || pipes > 31) {
+		snprintf(why, wl, "IPA_ENABLED_PIPES is %u: the modem pipes of the v4.2 table need at least %u", pipes,
+		    PIPES_MIN);
+		return false;
+	}
+	lipa_gsi_wr(G_INTSET, 1);               /* GSI_INTR_IRQ: not MSI */
+	lipa_gsi_wr(G_MSI_LSB, 0);
+	lipa_gsi_wr(G_MSI_MSB, 0);
+	lipa_gsi_wr(G_ERROR_LOG, 0);
+	type = lipa_gsi_rd(G_TYPE_IRQ_MSK);
+	lipa_gsi_wr(G_TYPE_IRQ_MSK, type | TYPE_CH_CTRL_GLOB_EE);
+	for (uint32_t p = 0; p < pipes && p < PIPE_COUNT && ok; p++) {
+		uint32_t ch = pipe_ch[p].ch, ee = pipe_ch[p].ee;
+
+		ok = ee == 0 ? ap_alloc(p, ch, why, wl) : ee_alloc(p, ch, ee, why, wl);
+		n[ee] += ok ? 1 : 0;
+	}
+	lipa_gsi_wr(G_TYPE_IRQ_MSK, type);
+	if (!ok) {
+		return false;
+	}
+	log = lipa_gsi_rd(G_ERROR_LOG);
+	if (log != 0) {
+		snprintf(why, wl, "GSI ERROR_LOG %08x after the channel allocation", log);
+		return false;
+	}
+	LOG("GSI channels allocated: %u AP, %u modem, %u uC (%u pipes, %u channels per EE, ERROR_LOG 0)\n", n[0], n[1], n[2],
+	    pipes, max_ch);
+	return true;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
