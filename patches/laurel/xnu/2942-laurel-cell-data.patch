diff -ruN a/bsd/dev/laurel_cell_data2.h b/bsd/dev/laurel_cell_data2.h
--- a/bsd/dev/laurel_cell_data2.h	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_cell_data2.h	2026-11-01 23:27:42.199054428 +0530
@@ -0,0 +1,383 @@
+/*
+ * laurel 2942: second half of laurel_cell_data.c (included there): the steps of a data session and the hooks for laurel_cell.c.
+ */
+
+static void
+ask_dpm(void)
+{
+	uint8_t m[64], v[1 + 16] = { 1 };
+	uint32_t w[4] = { EP_EMBEDDED, EP_IFACE, PIPE_TO_MODEM, PIPE_FROM_MODEM };
+
+	memcpy(v + 1, w, 16);
+	d_send(D_DPM, MSG_DPM_OPEN, m, m_tlv(m, 7, 0x11, v, sizeof(v)));
+}
+
+static void
+ask_wda(void)
+{
+	uint8_t m[96];
+	uint32_t n = 7, x;
+	uint32_t ep[2] = { EP_EMBEDDED, EP_IFACE };
+
+	x = 2;              n = m_tlv(m, n, 0x11, &x, 4);       /* raw IP */
+	x = 5;              n = m_tlv(m, n, 0x12, &x, 4);       /* QMAP up */
+	n = m_tlv(m, n, 0x13, &x, 4);                           /* QMAP down */
+	x = DL_MAX_PKTS;    n = m_tlv(m, n, 0x15, &x, 4);
+	x = DL_MAX_BYTES;   n = m_tlv(m, n, 0x16, &x, 4);
+	n = m_tlv(m, n, 0x17, ep, 8);
+	d_send(D_WDA, MSG_WDA_FORMAT, m, n);
+}
+
+static void
+ask_call(int ci, uint64_t now)
+{
+	struct call *c = &calls[ci];
+	int di = D_WDS4 + ci;
+	uint8_t m[48];
+	uint32_t n = 7;
+
+	switch (c->step) {
+	case CALL_BIND: {
+		uint32_t ep[2] = { EP_EMBEDDED, EP_IFACE };
+		uint8_t mux = LCD_MUX_ID;
+		n = m_tlv(m, n, 0x10, ep, 8);
+		n = m_tlv(m, n, 0x11, &mux, 1);
+		d_send(di, MSG_WDS_BIND_MUX, m, n);
+		break;
+	}
+	case CALL_FAMILY:
+		n = m_tlv(m, n, 0x01, &c->family, 1);
+		d_send(di, MSG_WDS_FAMILY, m, n);
+		break;
+	case CALL_STARTING:
+		n = m_tlv(m, n, 0x19, &c->family, 1);
+		d_send(di, MSG_WDS_START, m, n);
+		c->starts++;
+		LOGD("%s: START_NETWORK (default profile, try %u)\n", dc[di].name, c->starts);
+		break;
+	case CALL_SETTINGS: {
+		uint32_t mask = SETTINGS_MASK;
+		n = m_tlv(m, n, 0x10, &mask, 4);
+		d_send(di, MSG_WDS_SETTINGS, m, n);
+		break;
+	}
+	default:
+		break;
+	}
+	(void)now;
+}
+
+static void
+say_on_line(void)
+{
+	bool v4 = calls[0].step == CALL_UP, v6 = calls[1].step == CALL_UP;
+
+	if ((v4 || v6) && !said_on) {
+		said_on = true;
+		SAYD("on: pdp_ip0%s%s, mux %u; the phone's ping proves it, not this line\n", v4 ? " IPv4" : "", v6 ? " IPv6" : "", LCD_MUX_ID);
+	} else if (!v4 && !v6) {
+		said_on = false;
+	}
+}
+
+static void
+call_settings(int ci, const uint8_t *d, uint32_t len)
+{
+	uint16_t l = 0;
+	const uint8_t *v;
+
+	if (ci == 0) {
+		uint32_t ip = get32(d, len, 0x1E), mask = get32(d, len, 0x21), gw = get32(d, len, 0x20);
+		uint32_t dns1 = get32(d, len, 0x15), dns2 = get32(d, len, 0x16), mtu = get32(d, len, 0x29);
+
+		LOGD("ipv4: address %u.%u.%u.%u mask %u.%u.%u.%u gateway %u.%u.%u.%u mtu %u\n", ip >> 24, (ip >> 16) & 255, (ip >> 8) & 255, ip & 255,
+		    mask >> 24, (mask >> 16) & 255, (mask >> 8) & 255, mask & 255, gw >> 24, (gw >> 16) & 255, (gw >> 8) & 255, gw & 255, mtu);
+		if (ip == 0) {
+			LOGD("ipv4: no address in the settings: this family stays down\n");
+			return;
+		}
+		laurel_pdp_set4(true, ip, mask, gw, dns1, dns2, mtu);
+	} else {
+		static const uint8_t zero[17];
+		const uint8_t *a = (v = d_tlv(d, len, 0x25, &l)) != NULL && l >= 17 ? v : zero;
+		const uint8_t *g = (v = d_tlv(d, len, 0x26, &l)) != NULL && l >= 17 ? v : zero;
+		const uint8_t *d1 = (v = d_tlv(d, len, 0x27, &l)) != NULL && l >= 16 ? v : zero;
+		const uint8_t *d2 = (v = d_tlv(d, len, 0x28, &l)) != NULL && l >= 16 ? v : zero;
+		uint32_t mtu = get32(d, len, 0x29);
+
+		LOGD("ipv6: address %02x%02x:%02x%02x:...:%02x%02x/%u mtu %u\n", a[0], a[1], a[2], a[3], a[14], a[15], a[16], mtu);
+		if (memcmp(a, zero, 16) == 0) {
+			LOGD("ipv6: no address in the settings: this family stays down\n");
+			return;
+		}
+		laurel_pdp_set6(true, a, a[16], g, d1, d2, mtu);
+	}
+	calls[ci].step = CALL_UP;
+	say_on_line();
+}
+
+static void
+call_rx(int ci, uint16_t msg, uint16_t e, const uint8_t *d, uint32_t len, uint64_t now)
+{
+	struct call *c = &calls[ci];
+	const char *name = dc[D_WDS4 + ci].name;
+
+	switch (msg) {
+	case MSG_WDS_BIND_MUX:
+		LOGD("%s: BIND_MUX_DATA_PORT mux %u: %s0x%x\n", name, LCD_MUX_ID, e == 0 ? "ok " : "error ", e);
+		c->step = CALL_FAMILY;  /* a refusal: scion's modem starts the session all the same */
+		break;
+	case MSG_WDS_FAMILY:
+		LOGD("%s: SET_IP_FAMILY: %s0x%x\n", name, e == 0 ? "ok " : "error ", e);
+		c->step = CALL_IDLE;
+		break;
+	case MSG_WDS_START: {
+		uint16_t l = 0, reason = 0, tech = 0;
+		const uint8_t *v = d_tlv(d, len, 0x10, &l);
+
+		if (v != NULL && l >= 2) {
+			memcpy(&reason, v, 2);
+		}
+		v = d_tlv(d, len, 0x11, &l);            /* verbose: type u16, reason u16 */
+		if (v != NULL && l >= 4) {
+			memcpy(&tech, v + 2, 2);
+		}
+		if (e == 0 || e == QMI_NO_EFFECT) {
+			c->handle = get32(d, len, 0x01);
+			LOGD("%s: START_NETWORK: connected (%s0x%x)\n", name, e == 0 ? "ok " : "already up ", e);
+			c->step = CALL_SETTINGS;
+			break;
+		}
+		if (e != c->last_err || reason != c->last_reason || c->starts <= 3) {
+			LOGD("%s: START_NETWORK: error 0x%x, call end reason %u, verbose %u (try %u)\n", name, e, reason, tech, c->starts);
+		}
+		c->last_err = e;
+		c->last_reason = reason;
+		c->step = CALL_IDLE;
+		c->next = now + (c->starts < START_FAST_TRIES ? START_GAP_MS : START_GAP_LONG_MS);
+		break;
+	}
+	case MSG_WDS_SETTINGS:
+		if (e == 0) {
+			c->step = CALL_IDLE;    /* unless the settings hold an address */
+			c->next = now + START_GAP_MS;
+			call_settings(ci, d, len);
+		} else {
+			LOGD("%s: GET_CURRENT_SETTINGS: error 0x%x\n", name, e);
+			c->step = CALL_IDLE;
+			c->next = now + START_GAP_MS;
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+/* the session ended: the interface loses this family; the next START comes when NAS says registered */
+static void
+call_status_ind(int ci, const uint8_t *d, uint32_t len, uint64_t now)
+{
+	struct call *c = &calls[ci];
+	uint16_t l = 0, reason = 0;
+	const uint8_t *v = d_tlv(d, len, 0x01, &l);
+
+	if (v == NULL || l < 1 || v[0] != 1) {
+		return;
+	}
+	v = d_tlv(d, len, 0x10, &l);
+	if (v != NULL && l >= 2) {
+		memcpy(&reason, v, 2);
+	}
+	LOGD("%s: disconnected, call end reason %u\n", dc[D_WDS4 + ci].name, reason);
+	if (ci == 0) {
+		laurel_pdp_set4(false, 0, 0, 0, 0, 0, 0);
+	} else {
+		laurel_pdp_set6(false, NULL, 0, NULL, NULL, NULL, 0);
+	}
+	c->step = CALL_IDLE;
+	c->next = now + START_GAP_MS;
+	say_on_line();
+}
+
+/* ---- hooks of laurel_cell.c */
+
+void
+lcd_server(uint32_t svc, uint32_t node, uint32_t port, bool up)
+{
+	for (int i = 0; i < D_N; i++) {
+		struct dc *c = &dc[i];
+
+		if (c->svc != svc) {
+			continue;
+		}
+		if (!up) {
+			if (c->up && c->node == node && c->sport == port) {
+				c->up = false;
+				c->want = 0;
+			}
+		} else if (!c->up) {
+			c->node = node;
+			c->sport = port;
+			c->up = true;
+			c->want = 0;
+		}
+	}
+}
+
+bool
+lcd_rx(uint32_t dst_port, const uint8_t *d, uint32_t len)
+{
+	int i;
+	uint16_t txn, msg;
+
+	for (i = 0; i < D_N && dc[i].port != dst_port; i++) {
+	}
+	if (i == D_N) {
+		return false;
+	}
+	if (len < 7 || st == ST_OFF) {
+		return true;
+	}
+	memcpy(&txn, d + 1, 2);
+	memcpy(&msg, d + 3, 2);
+	uint64_t now = lcd_now_ms();
+	if (d[0] == 4) {
+		if (i >= D_WDS4 && msg == MSG_WDS_STATUS_IND) {
+			call_status_ind(i - D_WDS4, d, len, now);
+		}
+		return true;
+	}
+	if (d[0] != 2 || dc[i].want != msg || txn != dc[i].txn) {
+		return true;
+	}
+	dc[i].want = 0;
+	uint16_t e = d_err(d, len);
+	if (i == D_DPM) {
+		LOGD("DPM OPEN_PORT (pipes %u, %u): %s0x%x\n", PIPE_TO_MODEM, PIPE_FROM_MODEM, e == 0 || e == QMI_NO_EFFECT ? "ok " : "error ", e);
+		st = ST_WDA;            /* a refusal: Android's own order goes on; WDA tells */
+	} else if (i == D_WDA) {
+		LOGD("WDA SET_DATA_FORMAT: %s0x%x: link %u, up %u, down %u (2 raw IP, 5 QMAP), down limit %u packets %u bytes\n",
+		    e == 0 ? "ok " : "error ", e, get32(d, len, 0x11), get32(d, len, 0x12), get32(d, len, 0x13), get32(d, len, 0x15), get32(d, len, 0x16));
+		if (e != 0) {
+			char why[80];
+			snprintf(why, sizeof(why), "WDA SET_DATA_FORMAT error 0x%x", e);
+			data_off_line(why);
+			return true;
+		}
+		st = ST_CALLS;
+	} else {
+		call_rx(i - D_WDS4, msg, e, d, len, now);
+	}
+	return true;
+}
+
+/* the steps; registered: NAS on the data subscription. Every client: one request at a time, a lost answer = one retry, then on with the next step */
+void
+lcd_poll(uint64_t now, bool registered)
+{
+	const char *why = "";
+
+	if (st == ST_OFF) {
+		return;
+	}
+	if (!data_enabled()) {
+		data_off_line("boot-arg cell_data=0");
+		return;
+	}
+	if (st == ST_WAIT) {
+		int ds = laurel_ipa_data_state(&why);
+
+		if (ds < 0) {
+			data_off_line(why);
+		} else if (ds == 1) {
+			st = ST_DPM;
+		}
+		if (st != ST_DPM) {
+			return;
+		}
+	}
+	for (int i = 0; i < D_N; i++) {
+		struct dc *c = &dc[i];
+
+		if (c->up && c->want != 0 && now - c->sent >= TIMEOUT_MS) {
+			if (c->tries < 2) {
+				c->tries++;
+				c->sent = now;
+				topaz_qrtr_data(c->port, c->node, c->sport, c->buf, c->len);
+			} else {
+				LOGD("%s: no answer to message 0x%x, 2 tries\n", c->name, c->want);
+				c->want = 0;
+				if (i == D_DPM) {
+					st = ST_WDA;
+				} else if (i == D_WDA) {
+					data_off_line("WDA SET_DATA_FORMAT: no answer");
+				} else {
+					calls[i - D_WDS4].step = calls[i - D_WDS4].step < CALL_IDLE ? calls[i - D_WDS4].step + 1 : CALL_IDLE;
+					calls[i - D_WDS4].next = now + START_GAP_MS;
+				}
+			}
+		}
+	}
+	if (st == ST_DPM && dc[D_DPM].want == 0) {
+		if (dc[D_DPM].up) {
+			ask_dpm();
+		} else if (dc[D_WDA].up) {
+			st = ST_WDA;    /* no DPM service in this firmware: WDA tells whether it matters */
+		}
+	} else if (st == ST_WDA && dc[D_WDA].up && dc[D_WDA].want == 0) {
+		ask_wda();
+	} else if (st == ST_CALLS) {
+		for (int ci = 0; ci < 2; ci++) {
+			struct call *c = &calls[ci];
+			if (!dc[D_WDS4 + ci].up || dc[D_WDS4 + ci].want != 0) {
+				continue;
+			}
+			if (c->step == CALL_IDLE && registered && now >= c->next) {
+				c->step = CALL_STARTING;
+			}
+			if (c->step != CALL_IDLE && c->step != CALL_UP) {
+				ask_call(ci, now);
+			}
+		}
+	}
+}
+
+/* DPM + WDA answered (or there is nothing to wait for): the radio may go online. Android's netmgrd sets the format before the RIL's ONLINE */
+bool
+lcd_format_done(void)
+{
+	return st == ST_OFF || st == ST_CALLS;
+}
+
+void
+lcd_off(const char *why)
+{
+	data_off_line(why);
+	laurel_pdp_set4(false, 0, 0, 0, 0, 0, 0);
+	laurel_pdp_set6(false, NULL, 0, NULL, NULL, NULL, 0);
+}
+
+/* the text in the cell line and the state keys */
+void
+lcd_summary(char *out, size_t max)
+{
+	bool v4 = calls[0].step == CALL_UP, v6 = calls[1].step == CALL_UP;
+
+	if (st == ST_OFF) {
+		snprintf(out, max, "data off: %s", off_why);
+	} else if (v4 || v6) {
+		snprintf(out, max, "data on: pdp_ip0%s%s", v4 ? " IPv4" : "", v6 ? " IPv6" : "");
+	} else if (st == ST_WAIT) {
+		const char *why = "";
+		(void)laurel_ipa_data_state(&why);
+		snprintf(out, max, "data off: %s", why);
+	} else {
+		snprintf(out, max, "data off: session not up yet");
+	}
+}
+
+const char *
+lcd_state_key(void)
+{
+	return calls[0].step == CALL_UP || calls[1].step == CALL_UP ? "on" : "off";
+}
diff -ruN a/bsd/dev/laurel_cell_data.c b/bsd/dev/laurel_cell_data.c
--- a/bsd/dev/laurel_cell_data.c	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_cell_data.c	2026-11-01 23:30:35.438355034 +0530
@@ -0,0 +1,164 @@
+/*
+ * laurel_sprout (Mi A3) cellular data (laurel 2942): the QMI side of a data session. Called from laurel_cell.c in the modem watch thread (one thread).
+ * Order as Android's netmgrd + ModemManager's "ipa" port: DPM OPEN_PORT (embedded port 1, IPA pipes 1 and 9), WDA SET_DATA_FORMAT (raw IP in QMAP, no
+ * checksum), then per IP family one WDS client: BIND_MUX_DATA_PORT (mux 1), SET_IP_FAMILY, START_NETWORK once NAS says registered, GET_CURRENT_SETTINGS.
+ * Layouts: libqmi qmi-service-{dpm,wda,wds}.json as used by hackios-scion hakios.mpss.c [V]; scion never saw a packet on them [V its docs]: on this phone all
+ * of it is [I] until a ping. One QRTR port per client: 0x4017-0x401A. A failed step is one line; data stays off; radio, Wi-Fi and the boot are not touched.
+ * The data SIM: the modem's default subscription (primary). The later "default SIM" task binds the WDS clients to another one; there is no such choice yet.
+ * Lines: "LaurelData: <step>: ..." and "LAUREL CELL DATA: on: pdp_ip0 IPv4 ..." or "LAUREL CELL DATA: off: <why>". cell_data=0 is the kill switch.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include "laurel_cell_data.h"
+
+#define SAYD(...)           printf("LAUREL CELL DATA: " __VA_ARGS__)
+#define LOGD(...)           printf("LaurelData: " __VA_ARGS__)
+
+enum { D_DPM, D_WDA, D_WDS4, D_WDS6, D_N };
+enum { ST_WAIT, ST_DPM, ST_WDA, ST_CALLS, ST_OFF };
+enum { CALL_BIND, CALL_FAMILY, CALL_IDLE, CALL_STARTING, CALL_SETTINGS, CALL_UP };
+
+#define MSG_DPM_OPEN        0x0020
+#define MSG_WDA_FORMAT      0x0020
+#define MSG_WDS_START       0x0020
+#define MSG_WDS_STATUS_IND  0x0022
+#define MSG_WDS_SETTINGS    0x002D
+#define MSG_WDS_FAMILY      0x004D
+#define MSG_WDS_BIND_MUX    0x00A2
+#define EP_EMBEDDED         4u
+#define EP_IFACE            1u
+#define PIPE_TO_MODEM       1u                  /* APPS_WAN_PROD: the modem's receiving end */
+#define PIPE_FROM_MODEM     9u                  /* APPS_WAN_CONS */
+#define DL_MAX_PKTS         16u
+#define DL_MAX_BYTES        6144u               /* V_AGGR_WAN_RX byte limit */
+#define SETTINGS_MASK       0xA310u             /* DNS, IP address, gateway, MTU, IP family */
+#define TIMEOUT_MS          10000u
+#define START_GAP_MS        10000u
+#define START_GAP_LONG_MS   60000u
+#define START_FAST_TRIES    6u
+
+struct dc {
+	const char *name;
+	uint32_t svc, port, node, sport;
+	bool up;
+	uint16_t txn, want;
+	uint64_t sent;
+	uint8_t tries, buf[160];
+	uint32_t len;
+};
+static struct dc dc[D_N] = {
+	[D_DPM]  = { .name = "dpm", .svc = 0x2F, .port = 0x4017 },
+	[D_WDA]  = { .name = "wda", .svc = 0x1A, .port = 0x4018 },
+	[D_WDS4] = { .name = "ipv4", .svc = 0x01, .port = 0x4019 },
+	[D_WDS6] = { .name = "ipv6", .svc = 0x01, .port = 0x401A },
+};
+struct call {
+	uint8_t step, family;
+	uint32_t handle, starts;
+	uint64_t next;
+	uint16_t last_err, last_reason;
+};
+static struct call calls[2] = { { .family = 4 }, { .family = 6 } };
+static int st = ST_WAIT;
+static bool data_on_read, data_on, said_on;
+static char off_why[160];
+
+static bool
+data_enabled(void)
+{
+	if (!data_on_read) {
+		uint32_t on = 1;
+		(void)PE_parse_boot_argn("cell_data", &on, sizeof(on));
+		data_on = on != 0;
+		data_on_read = true;
+	}
+	return data_on;
+}
+
+static void
+data_off_line(const char *why)
+{
+	if (st == ST_OFF) {
+		return;
+	}
+	st = ST_OFF;
+	strlcpy(off_why, why, sizeof(off_why));
+	SAYD("off: %s\n", why);
+}
+
+/* ---- requests: one at a time per client */
+
+static uint32_t
+m_tlv(uint8_t *m, uint32_t n, uint8_t type, const void *v, uint16_t len)
+{
+	m[n] = type;
+	memcpy(m + n + 1, &len, 2);
+	memcpy(m + n + 3, v, len);
+	return n + 3u + len;
+}
+
+static void
+d_send(int i, uint16_t msg, uint8_t *m, uint32_t n)
+{
+	struct dc *c = &dc[i];
+	uint16_t l = (uint16_t)(n - 7);
+
+	m[0] = 0;
+	memcpy(m + 3, &msg, 2);
+	memcpy(m + 5, &l, 2);
+	c->txn = (uint16_t)(c->txn + 1 == 0 ? 1 : c->txn + 1);
+	memcpy(m + 1, &c->txn, 2);
+	memcpy(c->buf, m, n);
+	c->len = n;
+	c->want = msg;
+	c->tries = 1;
+	c->sent = lcd_now_ms();
+	topaz_qrtr_data(c->port, c->node, c->sport, m, n);
+}
+
+/* TLV lookup + QMI result: as laurel_cell.c */
+static const uint8_t *
+d_tlv(const uint8_t *d, uint32_t len, uint8_t type, uint16_t *tl)
+{
+	for (uint32_t o = 7; o + 3 <= len;) {
+		uint16_t l;
+		memcpy(&l, d + o + 1, 2);
+		if (o + 3u + l > len) {
+			return NULL;
+		}
+		if (d[o] == type) {
+			*tl = l;
+			return d + o + 3;
+		}
+		o += 3u + l;
+	}
+	return NULL;
+}
+
+static uint16_t
+d_err(const uint8_t *d, uint32_t len)
+{
+	uint16_t l = 0, r[2];
+	const uint8_t *v = d_tlv(d, len, 0x02, &l);
+
+	if (v == NULL || l < 4) {
+		return 0xFFFF;
+	}
+	memcpy(r, v, 4);
+	return r[0] == 0 ? 0 : (r[1] != 0 ? r[1] : 0xFFFE);
+}
+
+static inline uint32_t
+get32(const uint8_t *d, uint32_t len, uint8_t type)
+{
+	uint16_t l = 0;
+	uint32_t x = 0;
+	const uint8_t *v = d_tlv(d, len, type, &l);
+
+	if (v != NULL && l >= 4) {
+		memcpy(&x, v, 4);
+	}
+	return x;
+}
+
+#include "laurel_cell_data2.h"
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN a/bsd/dev/laurel_cell_data.h b/bsd/dev/laurel_cell_data.h
--- a/bsd/dev/laurel_cell_data.h	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_cell_data.h	2026-11-01 23:27:42.160971500 +0530
@@ -0,0 +1,27 @@
+/*
+ * laurel 2942: declarations of the cellular data client (laurel_cell_data.c), the interface (laurel_pdp.c), for laurel_cell.c and the host test.
+ */
+#ifndef LAUREL_CELL_DATA_H
+#define LAUREL_CELL_DATA_H
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+
+#define LCD_MUX_ID      1u      /* = LIPA_MUX_ID */
+#define QMI_NO_EFFECT   0x001A
+
+extern void topaz_qrtr_data(uint32_t src_port, uint32_t node, uint32_t port, const void *data, uint32_t len);
+extern int laurel_ipa_data_state(const char **why);
+uint64_t lcd_now_ms(void);
+
+void lcd_server(uint32_t svc, uint32_t node, uint32_t port, bool up);
+bool lcd_rx(uint32_t dst_port, const uint8_t *d, uint32_t len);
+void lcd_poll(uint64_t now, bool registered);
+bool lcd_format_done(void);
+void lcd_off(const char *why);
+void lcd_summary(char *out, size_t max);
+const char *lcd_state_key(void);
+
+void laurel_pdp_set4(bool up, uint32_t ip, uint32_t mask, uint32_t gw, uint32_t dns1, uint32_t dns2, uint32_t mtu);
+void laurel_pdp_set6(bool up, const uint8_t *ip, uint8_t plen, const uint8_t *gw, const uint8_t *dns1, const uint8_t *dns2, uint32_t mtu);
