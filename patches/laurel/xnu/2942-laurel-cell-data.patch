diff -ruN a/bsd/dev/laurel_pdp2.h b/bsd/dev/laurel_pdp2.h
--- a/bsd/dev/laurel_pdp2.h	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_pdp2.h	2026-11-01 23:33:10.954828771 +0530
@@ -0,0 +1,166 @@
+/*
+ * laurel 2942: second half of laurel_pdp.c (included there): addresses by kernel socket ioctls, and kern.laurel_cell_net for laurel_celld (text: laurel_pdp_text.h).
+ */
+
+static errno_t
+set_addr4(const struct pdp_v4 *a, bool add)
+{
+	socket_t so = NULL;
+	struct ifaliasreq r;
+	errno_t e = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+
+	if (e != 0) {
+		return e;
+	}
+	bzero(&r, sizeof(r));
+	snprintf(r.ifra_name, sizeof(r.ifra_name), "pdp_ip0");
+	struct sockaddr_in *s = (struct sockaddr_in *)&r.ifra_addr;
+	s->sin_len = sizeof(*s);
+	s->sin_family = AF_INET;
+	s->sin_addr.s_addr = htonl(a->ip);
+	if (add) {
+		e = proto_plumb(PF_INET, ifp);
+		if (e == 0 || e == EEXIST) {
+			s = (struct sockaddr_in *)&r.ifra_mask;
+			s->sin_len = sizeof(*s);
+			s->sin_family = AF_INET;
+			s->sin_addr.s_addr = htonl(a->mask != 0 ? a->mask : 0xFFFFFFFFu);
+			s = (struct sockaddr_in *)&r.ifra_broadaddr;     /* the far end on a point to point interface */
+			s->sin_len = sizeof(*s);
+			s->sin_family = AF_INET;
+			s->sin_addr.s_addr = htonl(a->gw != 0 ? a->gw : a->ip);
+			e = sock_ioctl(so, SIOCAIFADDR, &r);
+		}
+	} else {
+		struct ifreq q;
+		bzero(&q, sizeof(q));
+		strlcpy(q.ifr_name, r.ifra_name, sizeof(q.ifr_name));
+		memcpy(&q.ifr_addr, &r.ifra_addr, sizeof(struct sockaddr_in));
+		e = sock_ioctl(so, SIOCDIFADDR, &q);
+	}
+	sock_close(so);
+	return e;
+}
+
+static errno_t
+set_addr6(const struct pdp_v6 *a, bool add)
+{
+	socket_t so = NULL;
+	struct in6_aliasreq_64 r;
+	errno_t e = sock_socket(PF_INET6, SOCK_DGRAM, 0, NULL, NULL, &so);
+
+	if (e != 0) {
+		return e;
+	}
+	bzero(&r, sizeof(r));
+	snprintf(r.ifra_name, sizeof(r.ifra_name), "pdp_ip0");
+	r.ifra_addr.sin6_len = sizeof(r.ifra_addr);
+	r.ifra_addr.sin6_family = AF_INET6;
+	memcpy(&r.ifra_addr.sin6_addr, a->ip, 16);
+	if (add) {
+		r.ifra_prefixmask.sin6_len = sizeof(r.ifra_prefixmask);
+		r.ifra_prefixmask.sin6_family = AF_INET6;
+		for (unsigned b = 0; b < a->plen && b < 128; b++) {
+			((uint8_t *)&r.ifra_prefixmask.sin6_addr)[b / 8] |= (uint8_t)(0x80u >> (b % 8));
+		}
+		r.ifra_flags = IN6_IFF_NODAD;   /* the network gave the address; there is no one else on this link */
+		r.ifra_lifetime.ia6t_vltime = ND6_INFINITE_LIFETIME;
+		r.ifra_lifetime.ia6t_pltime = ND6_INFINITE_LIFETIME;
+		e = sock_ioctl(so, SIOCAIFADDR_IN6_64, &r);     /* in6_control plumbs PF_INET6 itself (in6_domifattach) */
+	} else {
+		struct in6_ifreq q;
+		bzero(&q, sizeof(q));
+		strlcpy(q.ifr_name, r.ifra_name, sizeof(q.ifr_name));
+		memcpy(&q.ifr_addr, &r.ifra_addr, sizeof(struct sockaddr_in6));
+		e = sock_ioctl(so, SIOCDIFADDR_IN6, &q);
+	}
+	sock_close(so);
+	return e;
+}
+
+static void
+net_text_make(void)
+{
+	char t[sizeof(net_text)];
+
+	pdp_text(t, sizeof(t), &have4, &have6);
+	lck_mtx_lock(&pdp_lock);
+	strlcpy(net_text, t, sizeof(net_text));
+	lck_mtx_unlock(&pdp_lock);
+}
+
+static int
+net_sysctl(__unused struct sysctl_oid *o, __unused void *a1, __unused int a2, struct sysctl_req *req)
+{
+	char buf[sizeof(net_text)];
+
+	lck_mtx_lock(&pdp_lock);
+	strlcpy(buf, net_text, sizeof(buf));
+	lck_mtx_unlock(&pdp_lock);
+	return SYSCTL_OUT(req, buf, strlen(buf) + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, laurel_cell_net, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED,
+    NULL, 0, net_sysctl, "A", "LAUREL cellular data session: interface, addresses, DNS (for laurel_celld)");
+
+/* in the IPA data thread: one change at a time, one line each */
+void
+laurel_pdp_work(void)
+{
+	struct pdp_v4 w4;
+	struct pdp_v6 w6;
+	errno_t e;
+
+	lck_mtx_lock(&pdp_lock);
+	if (!dirty) {
+		lck_mtx_unlock(&pdp_lock);
+		return;
+	}
+	dirty = false;
+	w4 = want4;
+	w6 = want6;
+	lck_mtx_unlock(&pdp_lock);
+	if (failed || (ifp == NULL && !w4.up && !w6.up)) {
+		return;
+	}
+	if (ifp == NULL && !if_create()) {
+		failed = true;
+		LOG("off: cannot make interface pdp_ip0\n");
+		return;
+	}
+	if (have4.up && (!w4.up || w4.ip != have4.ip)) {
+		e = set_addr4(&have4, false);
+		LOG("pdp_ip0: IPv4 address removed (error %d)\n", e);
+		have4.up = false;
+	}
+	if (have6.up && (!w6.up || memcmp(w6.ip, have6.ip, 16) != 0)) {
+		e = set_addr6(&have6, false);
+		LOG("pdp_ip0: IPv6 address removed (error %d)\n", e);
+		have6.up = false;
+	}
+	if (w4.up || w6.up) {
+		uint32_t mtu = w4.up && w4.mtu != 0 ? w4.mtu : (w6.up && w6.mtu != 0 ? w6.mtu : 1500);
+		ifnet_set_mtu(ifp, mtu);
+		ifnet_set_flags(ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	}
+	if (w4.up && !have4.up) {
+		e = set_addr4(&w4, true);
+		LOG("pdp_ip0: IPv4 address %s (error %d)\n", e == 0 ? "set" : "NOT set", e);
+		have4 = w4;
+		have4.up = e == 0;
+	} else if (w4.up) {
+		have4 = w4;
+	}
+	if (w6.up && !have6.up) {
+		e = set_addr6(&w6, true);
+		LOG("pdp_ip0: IPv6 address %s (error %d)\n", e == 0 ? "set" : "NOT set", e);
+		have6 = w6;
+		have6.up = e == 0;
+	} else if (w6.up) {
+		have6 = w6;
+	}
+	session = have4.up || have6.up;
+	if (!session) {
+		ifnet_set_flags(ifp, 0, IFF_RUNNING);
+	}
+	net_text_make();
+}
diff -ruN a/bsd/dev/laurel_pdp.c b/bsd/dev/laurel_pdp.c
--- a/bsd/dev/laurel_pdp.c	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_pdp.c	2026-11-01 23:33:10.954609841 +0530
@@ -0,0 +1,242 @@
+/*
+ * laurel_sprout (Mi A3) cellular data (laurel 2942): the iOS interface pdp_ip0 (IFT_CELLULAR, raw IP, point to point): the name CommCenter uses on an iPhone.
+ * laurel_cell_data2.h stores the session's settings (watch thread); laurel_pdp_work() applies them in the IPA data thread: interface on first use, addresses
+ * by kernel socket ioctls. No default route here: userland/laurel/cell/laurel_celld.c publishes kern.laurel_cell_net to configd, and IPMonitor picks the
+ * primary service (Wi-Fi first when it is up [I until the phone test]). Plumbing like if_utun.c; the packets go through laurel_ipa_data.c, QMAP mux 1.
+ * [I] until a phone ping. A failure: one line, data off; nothing else is touched.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/socket.h>
+#include <sys/sockio.h>
+#include <sys/sysctl.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/kpi_socket.h>
+#include <kern/locks.h>
+#include <net/if.h>
+#include <net/if_types.h>
+#include <net/kpi_interface.h>
+#include <net/kpi_protocol.h>
+#include <netinet/in.h>
+#include <netinet/in_var.h>
+#include <netinet6/in6_var.h>
+#include <netinet6/nd6.h>
+#include "laurel_ipa_regs.h"
+#include "laurel_pdp_text.h"
+
+#define LOG(...)                printf("LaurelData: " __VA_ARGS__)
+#define BAUD                    150000000ull    /* LTE cat 7 downlink */
+
+static LCK_GRP_DECLARE(pdp_grp, "laurel_pdp");
+static LCK_MTX_DECLARE(pdp_lock, &pdp_grp);
+
+/* under pdp_lock: what the session says; the applied copy is the data thread's */
+static struct pdp_v4 want4, have4;
+static struct pdp_v6 want6, have6;
+static bool dirty;
+static ifnet_t ifp;
+static bool failed;
+static volatile bool session;
+static char net_text[640] = "state=off\n";
+
+/* ---- interface callbacks */
+
+static errno_t
+pdp_output(ifnet_t i, mbuf_t m)
+{
+	size_t len = mbuf_pkthdr_len(m);
+	uint8_t *p = lipa_tx_begin((uint32_t)len);
+
+	if (p == NULL) {
+		ifnet_stat_increment_out(i, 0, 0, 1);
+		mbuf_freem(m);
+		return ENOBUFS;
+	}
+	(void)mbuf_copydata(m, 0, len, p);
+	lipa_tx_end(LIPA_MUX_ID, (uint32_t)len);
+	ifnet_stat_increment_out(i, 1, (uint32_t)len, 0);
+	mbuf_freem(m);
+	return 0;
+}
+
+static errno_t
+pdp_demux(__unused ifnet_t i, mbuf_t m, __unused char *hdr, protocol_family_t *proto)
+{
+	const uint8_t *d = mbuf_data(m);
+
+	if (mbuf_len(m) < 1) {
+		return ENOENT;
+	}
+	switch (d[0] >> 4) {
+	case 4:
+		*proto = PF_INET;
+		return 0;
+	case 6:
+		*proto = PF_INET6;
+		return 0;
+	default:
+		return ENOENT;
+	}
+}
+
+static errno_t
+pdp_add_proto(__unused ifnet_t i, protocol_family_t proto, __unused const struct ifnet_demux_desc *a, __unused u_int32_t n)
+{
+	return proto == PF_INET || proto == PF_INET6 ? 0 : ENOPROTOOPT;
+}
+
+static errno_t
+pdp_del_proto(__unused ifnet_t i, __unused protocol_family_t proto)
+{
+	return 0;
+}
+
+static errno_t
+pdp_ioctl(ifnet_t i, u_long cmd, __unused void *data)
+{
+	switch (cmd) {
+	case SIOCSIFADDR:
+	case SIOCAIFADDR:
+		ifnet_set_flags(i, IFF_UP, IFF_UP);
+		return 0;
+	case SIOCSIFFLAGS:
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		return 0;
+	default:
+		return EOPNOTSUPP;
+	}
+}
+
+static errno_t
+pdp_proto_input(__unused ifnet_t i, protocol_family_t proto, mbuf_t m, __unused char *hdr)
+{
+	if (proto_input(proto, m) != 0) {
+		mbuf_freem(m);
+	}
+	return 0;
+}
+
+static errno_t
+pdp_pre_output(__unused ifnet_t i, __unused protocol_family_t proto, __unused mbuf_t *m, __unused const struct sockaddr *dest,
+    __unused void *route, __unused char *type, __unused char *lladdr)
+{
+	return 0;
+}
+
+static errno_t
+pdp_attach_proto(ifnet_t i, protocol_family_t proto)
+{
+	struct ifnet_attach_proto_param p;
+
+	bzero(&p, sizeof(p));
+	p.input = pdp_proto_input;
+	p.pre_output = pdp_pre_output;
+	errno_t e = ifnet_attach_protocol(i, proto, &p);
+	return e == EEXIST ? 0 : e;
+}
+
+/* from the data thread (lipa_data_poll): one IP packet of mux 1 */
+void
+laurel_pdp_input(uint8_t mux, const uint8_t *ip, uint32_t len)
+{
+	mbuf_t m = NULL;
+	struct ifnet_stat_increment_param st = { 0 };
+
+	if (ifp == NULL || !session || mux != LIPA_MUX_ID || len == 0) {
+		return;
+	}
+	if (mbuf_allocpacket(MBUF_DONTWAIT, len, NULL, &m) != 0 || mbuf_copyback(m, 0, len, ip, MBUF_DONTWAIT) != 0) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		st.dropped = 1;
+		(void)ifnet_stat_increment(ifp, &st);
+		return;
+	}
+	mbuf_pkthdr_setrcvif(m, ifp);
+	mbuf_pkthdr_setheader(m, mbuf_data(m));
+	st.packets_in = 1;
+	st.bytes_in = len;
+	(void)ifnet_input(ifp, m, &st);
+}
+
+bool
+laurel_pdp_session(void)
+{
+	return session;
+}
+
+/* ---- settings */
+
+void
+laurel_pdp_set4(bool up, uint32_t ip, uint32_t mask, uint32_t gw, uint32_t dns1, uint32_t dns2, uint32_t mtu)
+{
+	lck_mtx_lock(&pdp_lock);
+	want4 = (struct pdp_v4){ up, ip, mask, gw, dns1, dns2, mtu };
+	dirty = true;
+	lck_mtx_unlock(&pdp_lock);
+}
+
+void
+laurel_pdp_set6(bool up, const uint8_t *ip, uint8_t plen, const uint8_t *gw, const uint8_t *dns1, const uint8_t *dns2, uint32_t mtu)
+{
+	lck_mtx_lock(&pdp_lock);
+	bzero(&want6, sizeof(want6));
+	want6.up = up;
+	if (up) {
+		memcpy(want6.ip, ip, 16);
+		want6.plen = plen == 0 || plen > 128 ? 64 : plen;
+		memcpy(want6.gw, gw, 16);
+		memcpy(want6.dns1, dns1, 16);
+		memcpy(want6.dns2, dns2, 16);
+		want6.mtu = mtu;
+	}
+	dirty = true;
+	lck_mtx_unlock(&pdp_lock);
+}
+
+static bool
+if_create(void)
+{
+	struct ifnet_init_eparams init;
+
+	(void)proto_register_plumber(PF_INET, IFNET_FAMILY_CELLULAR, pdp_attach_proto, NULL);
+	(void)proto_register_plumber(PF_INET6, IFNET_FAMILY_CELLULAR, pdp_attach_proto, NULL);
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "laurel-pdp-ip0";
+	init.uniqueid_len = sizeof("laurel-pdp-ip0") - 1;
+	init.name = "pdp_ip";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_CELLULAR;
+	init.type = IFT_CELLULAR;
+	init.output = pdp_output;
+	init.demux = pdp_demux;
+	init.add_proto = pdp_add_proto;
+	init.del_proto = pdp_del_proto;
+	init.ioctl = pdp_ioctl;
+	if (ifnet_allocate_extended(&init, &ifp) != 0) {
+		ifp = NULL;
+		return false;
+	}
+	ifnet_set_hdrlen(ifp, 0);
+	ifnet_set_addrlen(ifp, 0);
+	ifnet_set_mtu(ifp, 1500);
+	ifnet_set_baudrate(ifp, BAUD);
+	ifnet_set_flags(ifp, IFF_POINTOPOINT | IFF_NOARP | IFF_MULTICAST, 0xFFFF);
+	if (ifnet_attach(ifp, NULL) != 0) {
+		ifnet_release(ifp);
+		ifp = NULL;
+		return false;
+	}
+	LOG("interface pdp_ip0 attached (cellular, raw IP)\n");
+	return true;
+}
+
+#include "laurel_pdp2.h"
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff -ruN a/bsd/dev/laurel_pdp_text.h b/bsd/dev/laurel_pdp_text.h
--- a/bsd/dev/laurel_pdp_text.h	1970-01-01 05:30:00.000000000 +0530
+++ b/bsd/dev/laurel_pdp_text.h	2026-11-01 23:33:10.941190557 +0530
@@ -0,0 +1,49 @@
+/*
+ * laurel 2942: the text of kern.laurel_cell_net: pure, so the host test (scripts/laurel/test-cell.sh) feeds the daemon's parser (userland/laurel/cell/celld_net.h) with
+ * the kernel's own text. Keys: state=on|off, if, mtu, v4, v4.mask, v4.gw, v4.dns (0-2), v6, v6.plen, v6.gw, v6.dns (0-2). Never a SIM or modem identity.
+ */
+#ifndef LAUREL_PDP_TEXT_H
+#define LAUREL_PDP_TEXT_H
+struct pdp_v4 { bool up; uint32_t ip, mask, gw, dns1, dns2, mtu; };
+struct pdp_v6 { bool up; uint8_t ip[16], plen, gw[16], dns1[16], dns2[16]; uint32_t mtu; };
+
+static size_t
+text_ip6(char *o, size_t max, const char *key, const uint8_t *a)
+{
+	size_t n = (size_t)snprintf(o, max, "%s=", key);
+
+	for (unsigned i = 0; i < 16 && n < max; i += 2) {
+		n += (size_t)snprintf(o + n, max - n, "%x%s", (unsigned)a[i] << 8 | a[i + 1], i < 14 ? ":" : "\n");
+	}
+	return n;
+}
+
+static size_t
+text_ip4(char *o, size_t max, const char *key, uint32_t a)
+{
+	return (size_t)snprintf(o, max, "%s=%u.%u.%u.%u\n", key, a >> 24, (a >> 16) & 255, (a >> 8) & 255, a & 255);
+}
+
+static void
+pdp_text(char *t, size_t max, const struct pdp_v4 *a4, const struct pdp_v6 *a6)
+{
+	static const uint8_t zero[16];
+	size_t n = (size_t)snprintf(t, max, "state=%s\nif=pdp_ip0\nmtu=%u\n", a4->up || a6->up ? "on" : "off",
+	    a4->up && a4->mtu != 0 ? a4->mtu : (a6->up && a6->mtu != 0 ? a6->mtu : 1500));
+
+	if (a4->up && n < max) {
+		n += text_ip4(t + n, max - n, "v4", a4->ip);
+		n += n < max ? text_ip4(t + n, max - n, "v4.mask", a4->mask != 0 ? a4->mask : 0xFFFFFFFFu) : 0;
+		n += n < max ? text_ip4(t + n, max - n, "v4.gw", a4->gw != 0 ? a4->gw : a4->ip) : 0;
+		n += n < max && a4->dns1 != 0 ? text_ip4(t + n, max - n, "v4.dns", a4->dns1) : 0;
+		n += n < max && a4->dns2 != 0 ? text_ip4(t + n, max - n, "v4.dns", a4->dns2) : 0;
+	}
+	if (a6->up && n < max) {
+		n += text_ip6(t + n, max - n, "v6", a6->ip);
+		n += n < max ? (size_t)snprintf(t + n, max - n, "v6.plen=%u\n", a6->plen) : 0;
+		n += n < max && memcmp(a6->gw, zero, 16) != 0 ? text_ip6(t + n, max - n, "v6.gw", a6->gw) : 0;
+		n += n < max && memcmp(a6->dns1, zero, 16) != 0 ? text_ip6(t + n, max - n, "v6.dns", a6->dns1) : 0;
+		n += n < max && memcmp(a6->dns2, zero, 16) != 0 ? text_ip6(t + n, max - n, "v6.dns", a6->dns2) : 0;
+	}
+}
+#endif
