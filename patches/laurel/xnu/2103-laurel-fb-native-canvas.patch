+/* laurel 2103: self-report of the canvas (see laurel_fb_native) */
+static void
+laurel_fb_first_frame(const uint8_t *rec, const char *path, uint32_t cw, uint32_t chh)
+{
+	static bool told;
+	uint32_t mask = get32(rec, 0x104), layers = 0, sid = 0;
+
+	if (told) {
+		return;
+	}
+	for (uint32_t i = 0; i < SWEET_FB_LAYERS; i++) {
+		uint32_t id = get32(rec, 0x54 + 4 * i);
+		if ((mask & (1u << i)) && id != 0) {
+			layers++;
+			sid = sid != 0 ? sid : id;
+		}
+	}
+	if (layers == 0) {
+		return;                 /* (a swap without a layer shows nothing of iOS) */
+	}
+	told = true;
+	SweetSurface *s = sweet_surface_copy(sid);
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	IOLog("LAUREL FB CANVAS: first frame on the panel: swap %u, %u layer(s), surface %u %ux%u fmt 0x%x, canvas %ux%u, %s path, %llu s after boot\n",
+	    get32(rec, 0x50), layers, sid, s ? s->width : 0, s ? s->height : 0, s ? s->pixelFormat : 0, cw, chh, path,
+	    ns / 1000000000ull);
+	OSSafeReleaseNULL(s);
+}
+
