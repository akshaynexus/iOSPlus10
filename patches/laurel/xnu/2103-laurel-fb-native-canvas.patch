+/*
+ * laurel 2103: the Mi A3 presents its real panel (720x1560) to iOS, not the iPhone X canvas. With the
+ * 1125x2436 canvas the panel showed only its centre (64 % of the width: status bar, dock and home bar cut
+ * off), and the ADT canvas (disp0 canvas-width/height 720x1560, mkadt.py) did not match the size IOMFB
+ * reported. On by default when the ADT says so: disp0 canvas-width/height equal the panel and /chosen
+ * display-scale (2: 360x780 points) divides both. Boot-arg sweetfb_native=0 is the kill switch (iPhone X
+ * canvas, as topaz 0114); sweetfb_native=1 forces the panel size. One line:
+ *   "LAUREL FB CANVAS: on: native 720x1560 at display-scale 2 (360x780 points)"
+ *   "LAUREL FB CANVAS: off: <reason>; iPhone X canvas 1125x2436"
+ * and, as its self-report, one line when the first iOS frame with a layer reaches the panel on that canvas:
+ *   "LAUREL FB CANVAS: first frame on the panel: swap N, L layer(s), surface S WxH fmt F, canvas WxH,
+ *    direct|copy path, T s after boot" (direct = a scanout surface copied to the back buffer and flipped,
+ *    copy = layers composed into it)
+ * [U] iOS has no status bar layout for 360x780 points (topaz 0061 saw the red "rdar:45025538" bar at
+ * 360x800); everything else of SpringBoard worked there.
+ */
+static uint32_t
+laurel_fb_prop_u32(IORegistryEntry *e, const char *key)
+{
+	OSData *d = e != NULL ? OSDynamicCast(OSData, e->getProperty(key)) : NULL;
+	uint32_t v = 0;
+	if (d != NULL && d->getLength() >= sizeof(v)) {
+		memcpy(&v, d->getBytesNoCopy(), sizeof(v));
+	}
+	return v;
+}
+
+static int
+laurel_fb_native(IOService *provider, uint32_t w, uint32_t h)
+{
+	int arg = -1;
+	char why[96];
+	uint32_t cw = laurel_fb_prop_u32(provider, "canvas-width"), ch = laurel_fb_prop_u32(provider, "canvas-height");
+	IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	uint32_t scale = laurel_fb_prop_u32(chosen, "display-scale");
+	OSSafeReleaseNULL(chosen);
+
+	why[0] = '\0';
+	PE_parse_boot_argn("sweetfb_native", &arg, sizeof(arg));
+	if (arg == 0) {
+		snprintf(why, sizeof(why), "kill switch sweetfb_native=0");
+	} else if (arg > 0) {
+		/* forced: as topaz */
+	} else if (cw != w || ch != h) {
+		snprintf(why, sizeof(why), "ADT canvas %ux%u is not the panel %ux%u", cw, ch, w, h);
+	} else if (scale == 0 || w % scale != 0 || h % scale != 0) {
+		snprintf(why, sizeof(why), "/chosen display-scale %u does not divide the panel %ux%u", scale, w, h);
+	}
+	if (why[0] != '\0') {
+		IOLog("LAUREL FB CANVAS: off: %s; iPhone X canvas %ux%u\n", why, SWEET_FB_LOGICAL_W, SWEET_FB_LOGICAL_H);
+		return 0;
+	}
+	IOLog("LAUREL FB CANVAS: on: native %ux%u at display-scale %u (%ux%u points)%s\n", w, h, scale,
+	    scale ? w / scale : 0, scale ? h / scale : 0, arg > 0 ? " (sweetfb_native=1)" : "");
+	return 1;
+}
