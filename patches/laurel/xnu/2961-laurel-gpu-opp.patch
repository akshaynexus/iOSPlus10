+	WR(gpucc, b + PLL_TEST_U, RD(gpucc, b + PLL_TEST_U) & ~1u);
+	WR(gpucc, b + PLL_MODE, RD(gpucc, b + PLL_MODE) | MODE_BYPASSNL);
+	IODelay(5);
+	WR(gpucc, b + PLL_MODE, RD(gpucc, b + PLL_MODE) | MODE_RESET_N);
+	for (int i = 0; (RD(gpucc, b + PLL_MODE) & MODE_LOCK) == 0; i++) {
+		if (i >= 200) {                 /* stock: 100 reads with 1 us */
+			pll_off(o->pll);
+			return false;
+		}
+		IODelay(1);
+	}
+	WR(gpucc, b + PLL_MODE, RD(gpucc, b + PLL_MODE) | MODE_OUTCTRL);
