+/* A stopped PLL: clk_alpha_pll_configure with this level's L and alpha (clk_alpha_pll_set_rate), then clk_alpha_pll_enable */
+static bool
+pll_on(const struct laurel_opp *o)
+{
+	uint32_t b = PLL_BASE(o->pll);
+
+	if (RD(gpucc, b + PLL_MODE) & MODE_FSM_ENA) {
+		return false;                   /* not the mode that stock sets up: not ours to change */
+	}
+	WR(gpucc, b + PLL_L, o->l);
+	WR(gpucc, b + PLL_ALPHA, o->alpha);
+	WR(gpucc, b + PLL_ALPHA_U, o->alpha_u);
+	WR(gpucc, b + PLL_CONFIG, PLL_CONFIG_VAL);
+	WR(gpucc, b + PLL_USER, (RD(gpucc, b + PLL_USER) & ~(3u << USER_VCO_SHIFT)) | USER_AUX2 | USER_ALPHA_EN | ((uint32_t)o->vco << USER_VCO_SHIFT));
