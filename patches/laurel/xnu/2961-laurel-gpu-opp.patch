+++ b/iokit/Kernel/arm/laurel_gpu_opp.h
@@ -0,0 +1,394 @@
+/*
+ * laurel 2961 (a piece of LaurelGpuDcvs.cpp): the stock OPP table of the Mi A3's Adreno 610 and the rules that use it. No hardware access:
+ * the kernel gives the operations in struct opp_ops, and the host test scripts/laurel/test-gpu-opp.sh runs this same text with fakes.
+ *
+ * Sources [V]: trinket-gpu.dtsi and the phone's own DTB (boot.img, TRINKET msm-id 0x18a; no overlay in dtbo.img changes it): frequency and
+ * bus level. gpucc-trinket.c: source, divider, CX limit of each rate, VCO table. clk-alpha-pll.c alpha_pll_round_rate: L and alpha.
+ * vdd-level-trinket.h + qcom,rpm-smd-regulator.h: corner numbers. adreno-gpulist.h: CX iPeak from 900 MHz. trinket-thermal.dtsi: limits.
+ */
+#define OPP_SRC_PLL0    2u
+#define OPP_SRC_PLL1    4u
+#define OPP_SRC_GPLL0   5u
+#define OPP_NO_PLL      (-1)
+
+#define CX_LOW_SVS      64u
+#define CX_SVS          128u
+#define CX_SVS_PLUS     192u
+#define CX_NOM          256u
+#define CX_NOM_PLUS     320u
+#define CX_TURBO        384u
+#define CX_TURBO_NO_CPR 416u
+
+struct laurel_opp {
+	uint16_t mhz;
+	uint8_t src, div;       /* gfx3d RCG */
+	int8_t pll;             /* 0, 1, or OPP_NO_PLL: GPLL0 */
+	uint8_t l, alpha_u;
+	uint32_t alpha;
+	uint8_t vco;            /* USER_CTL bits 20-21: 0 = 1-2 GHz, 2 = 0.5-1 GHz */
+	uint16_t cx;            /* stock corner of this rate */
+	uint16_t bus_mhz;       /* stock bus level of this rate (qcom,bus-freq), as a DDR clock */
+	uint8_t ipeak;          /* stock CX iPeak vote: rate >= 900 MHz */
+};
+
+/*
+ * VCO = 2 x rate. 300 MHz is not a stock rate: the GPLL0 / 2 of laurel 2892, the fallback when PLL1 fails. 600 MHz is the stock rate, from
+ * GPLL0 / 1 in place of PLL0 at 1200 MHz: the same frequency, measured on the phone since boot 2026-11-01, and no PLL to keep running.
+ */
+static const struct laurel_opp opp_table[] = {
+	{ 300, OPP_SRC_GPLL0, 2, OPP_NO_PLL,  0, 0x00, 0x00000000, 0, CX_LOW_SVS,       451, 0 },
+	{ 320, OPP_SRC_PLL1,  2, 1,          33, 0x55, 0x55555600, 2, CX_LOW_SVS,       451, 0 },
+	{ 465, OPP_SRC_PLL1,  2, 1,          48, 0x70, 0x00000000, 2, CX_SVS,           768, 0 },
+	{ 600, OPP_SRC_GPLL0, 1, OPP_NO_PLL,  0, 0x00, 0x00000000, 0, CX_SVS_PLUS,     1017, 0 },
+	{ 745, OPP_SRC_PLL0,  2, 0,          77, 0x9a, 0xaaaaab00, 0, CX_NOM,          1353, 0 },
+	{ 820, OPP_SRC_PLL0,  2, 0,          85, 0x6a, 0xaaaaab00, 0, CX_NOM_PLUS,     1555, 0 },
+	{ 900, OPP_SRC_PLL0,  2, 0,          93, 0xc0, 0x00000000, 0, CX_TURBO,        1804, 1 },
+	{ 950, OPP_SRC_PLL0,  2, 0,          98, 0xf5, 0x55555600, 0, CX_TURBO_NO_CPR, 1804, 1 },
+};
+#define OPP_N           (sizeof(opp_table) / sizeof(opp_table[0]))
+#define OPP_300         0u
+#define OPP_600         3u
+#define OPP_GPLL0_ONLY  ((1u << OPP_300) | (1u << OPP_600))
+#define OPP_CHECK_PCT   3u              /* the read of a clock: 900 and 950 are 5.5 % apart. Boot 11 read 298/300 and 598/600 */
+
+/* The vote on CX: the stock corner of the rate, not below the NOM that laurel 2892 holds for the other AP blocks */
+static inline uint32_t
+opp_cx_vote(uint32_t i)
+{
+	return opp_table[i].cx > CX_NOM ? opp_table[i].cx : CX_NOM;
+}
+
+/* The boot clock as a stock bus level: the period register reads 1355 for level 1353, and a vote of 1355 could round up to 1555 */
+static inline uint32_t
+opp_ddr_snap(uint32_t mhz)
+{
+	for (uint32_t i = 0; i < OPP_N; i++) {
+		uint32_t b = opp_table[i].bus_mhz;
+
+		if (mhz * 100 >= b * 99 && mhz * 100 <= b * 101) {
+			return b;
+		}
+	}
+	return mhz;
+}
+
+static inline bool
+opp_read_right(uint32_t want, uint32_t got)
+{
+	return got * 100 >= want * (100 - OPP_CHECK_PCT) && got * 100 <= want * (100 + OPP_CHECK_PCT);
+}
+
+static inline uint32_t
+opp_lowest(uint32_t usable)
+{
+	for (uint32_t i = 0; i < OPP_N; i++) {
+		if (usable & (1u << i)) {
+			return i;
+		}
+	}
+	return OPP_300;
+}
+
+/* highest usable level, not above cap */
+static inline uint32_t
+opp_top(uint32_t usable, uint32_t cap)
+{
+	uint32_t top = opp_lowest(usable);
+
+	for (uint32_t i = top; i <= cap && i < OPP_N; i++) {
+		if (usable & (1u << i)) {
+			top = i;
+		}
+	}
+	return top;
+}
+
+/*
+ * Thermal rule of Android [V trinket-thermal.dtsi and the phone's DTB, sensor 15; the vendor thermal-engine files have no GPU rule]: gpu-step 95 C,
+ * no hysteresis: one level down at each tick at or above it (step_wise holds on a stable trend; here it goes on, the safe side), one level up at
+ * each tick below it. gpu-cx-mon 100 C, hysteresis 5 C: the lowest level. No reading counts as the worst. true: hot: no raise.
+ */
+#define OPP_HOT_DC      950
+#define OPP_CRIT_DC     1000
+#define OPP_CRIT_CLR_DC 950
+
+struct opp_thermal {
+	uint32_t cap;   /* highest level allowed */
+	bool crit;
+};
+
+static inline bool
+opp_thermal_tick(struct opp_thermal *t, int dc, uint32_t cur, uint32_t usable)
+{
+	uint32_t low = opp_lowest(usable);
+
+	if (dc <= -1000 || dc >= OPP_CRIT_DC) {
+		t->crit = true;
+	} else if (dc < OPP_CRIT_CLR_DC) {
+		t->crit = false;
+	}
+	if (t->crit) {
+		t->cap = low;
+		return true;
+	}
+	if (dc >= OPP_HOT_DC) {
+		uint32_t top = cur < t->cap ? cur : t->cap;
+
+		t->cap = top > low ? opp_top(usable, top - 1) : low;
+		return true;
+	}
+	for (uint32_t i = t->cap + 1; i < OPP_N; i++) {
+		if (usable & (1u << i)) {
+			t->cap = i;
+			break;
+		}
+	}
+	return false;
+}
+
+/*
+ * The governor. Raise at once: busy >= OPP_RAISE_PCT over a tick goes to the level where this work takes OPP_AIM_PCT, one level at least;
+ * busy >= OPP_FULL_PCT says nothing about the real demand and goes to the top; a touch goes to OPP_TOUCH at least, the highest rate that needs no
+ * rail above what is held [V 2892]. Lower only when the work would take OPP_AIM_PCT or less on the lower level (below the raise mark, so no
+ * ping-pong), for OPP_LOWER_MS without a break, and during a touch not below OPP_TOUCH. Above the thermal cap: down at once.
+ */
+#define OPP_TICK_MS     50u
+#define OPP_RAISE_PCT   50u
+#define OPP_FULL_PCT    90u
+#define OPP_AIM_PCT     45u
+#define OPP_LOWER_MS    500u
+#define OPP_TOUCH       4u
+
+static inline uint32_t
+opp_for_load(uint32_t mhz, uint32_t pct, uint32_t usable)
+{
+	uint32_t need = mhz * pct / OPP_AIM_PCT, top = opp_top(usable, OPP_N - 1);
+
+	for (uint32_t i = 0; i <= top; i++) {
+		if ((usable & (1u << i)) && opp_table[i].mhz >= need) {
+			return i;
+		}
+	}
+	return top;
+}
+
+static inline uint32_t
+opp_decide(uint32_t cur, uint32_t pct, bool touch, uint32_t usable, uint32_t cap, uint32_t *low_ms)
+{
+	uint32_t top = opp_top(usable, cap), want = cur;
+
+	if (cur > top || !(usable & (1u << cur))) {
+		*low_ms = 0;
+		return opp_top(usable, cur < cap ? cur : cap);
+	}
+	if (pct >= OPP_FULL_PCT) {
+		want = top;
+	} else if (pct >= OPP_RAISE_PCT) {
+		want = opp_for_load(opp_table[cur].mhz, pct, usable);
+		if (want <= cur) {
+			want = cur;
+			for (uint32_t i = cur + 1; i < OPP_N; i++) {
+				if (usable & (1u << i)) {
+					want = i;
+					break;
+				}
+			}
+		}
+	} else {
+		want = opp_for_load(opp_table[cur].mhz, pct, usable);
+		if (want > cur) {
+			want = cur;
+		}
+	}
+	if (touch) {
+		uint32_t t = opp_top(usable, OPP_TOUCH);
+
+		want = want > t ? want : t;
+	}
+	if (want > top) {
+		want = top;
+	}
+	if (want >= cur) {
+		*low_ms = 0;
+		return want;
+	}
+	*low_ms += OPP_TICK_MS;
+	if (*low_ms < OPP_LOWER_MS) {
+		return cur;
+	}
+	*low_ms = 0;
+	return want;
+}
+
+/* --------------------------------------------------------------- one change of level */
+
+struct opp_ops {
+	bool (*ipeak)(bool on);                         /* stock: vote before the raise over 900 MHz, withdraw after the lower */
+	bool (*ddr)(uint32_t mhz);                      /* before the raise; the governor lowers it later */
+	bool (*cx)(uint32_t level);
+	bool (*pll_on)(const struct laurel_opp *o);     /* programs a stopped PLL, waits for the lock; false: no lock, PLL stopped */
+	void (*pll_off)(int pll);
+	bool (*rcg)(const struct laurel_opp *o);        /* false: the source did not take, or the watchdog holds the clock */
+	bool (*check)(uint32_t i);                      /* the read of the clock; only after a raise */
+};
+
+struct opp_state {
+	uint32_t cur;           /* the level the RCG is on */
+	uint32_t cx;            /* the CX vote held */
+	bool ipeak;             /* the iPeak vote held */
+	bool broken;            /* the clock could not go anywhere: the caller turns the feature off */
+};
+
+/* Parked on GPLL0 with a stopped PLL: the old rate back. When that also fails: stay on GPLL0, lower than before, with the rails held. */
+static void
+opp_back(const struct opp_ops *ops, struct opp_state *st, uint32_t from)
+{
+	const struct laurel_opp *f = &opp_table[from];
+
+	if (ops->pll_on(f)) {
+		if (ops->rcg(f)) {
+			st->cur = from;
+		} else {
+			ops->pll_off(f->pll);
+		}
+	}
+}
+
+/*
+ * RCG from level `from` to `to`, both sources running. A PLL is programmed only while it is stopped, so a level on the same PLL waits on GPLL0
+ * (`park`, never above `from`), and that is why this gives no glitch and needs no latch of the running PLL. false: st->cur tells where it is.
+ */
+static bool
+opp_clock(const struct opp_ops *ops, struct opp_state *st, uint32_t to)
+{
+	uint32_t from = st->cur;
+	const struct laurel_opp *f = &opp_table[from], *t = &opp_table[to];
+
+	if (t->pll != OPP_NO_PLL && t->pll == f->pll) {
+		uint32_t park = f->mhz >= opp_table[OPP_600].mhz ? OPP_600 : OPP_300;
+
+		if (!ops->rcg(&opp_table[park])) {
+			return false;
+		}
+		st->cur = park;
+		ops->pll_off(t->pll);
+		if (!ops->pll_on(t)) {
+			opp_back(ops, st, from);
+			return false;
+		}
+	} else if (t->pll != OPP_NO_PLL && !ops->pll_on(t)) {
+		return false;
+	}
+	if (!ops->rcg(t)) {
+		if (t->pll != OPP_NO_PLL && t->pll != f->pll) {
+			ops->pll_off(t->pll);
+		} else if (t->pll != OPP_NO_PLL) {
+			ops->pll_off(t->pll);
+			opp_back(ops, st, from);
+		} else {
+			st->broken = !ops->rcg(f);      /* a dead RCG: the caller turns the feature off */
+		}
+		return false;
+	}
+	st->cur = to;
+	if (f->pll != OPP_NO_PLL && f->pll != t->pll) {
+		ops->pll_off(f->pll);
+	}
+	return true;
+}
+
+/* The votes for the level the clock is on after a failed raise or after a lower: iPeak first off, then the rail. A refused lower vote only keeps the rail. */
+static void
+opp_votes_down(const struct opp_ops *ops, struct opp_state *st)
+{
+	uint32_t c = opp_cx_vote(st->cur);
+
+	if (st->ipeak && !opp_table[st->cur].ipeak) {
+		(void)ops->ipeak(false);
+		st->ipeak = false;
+	}
+	if (c < st->cx && ops->cx(c)) {
+		st->cx = c;
+	}
+}
+
+/*
+ * The order (stock kgsl_pwrctrl_pwrlevel_change and clk_set_rate). Raise: iPeak, DDR, CX, PLL + lock, RCG, read of the clock. Lower: PLL + lock,
+ * RCG, iPeak off, CX. A refused vote or no lock: the clock stays, *why says what. true: the level is `to`.
+ */
+static bool
+opp_go(const struct opp_ops *ops, struct opp_state *st, uint32_t to, const char **why)
+{
+	uint32_t from = st->cur;
+	const struct laurel_opp *t = &opp_table[to];
+
+	if (to == from) {
+		return true;
+	}
+	if (to > from) {
+		uint32_t c = opp_cx_vote(to);
+
+		if (t->ipeak && !st->ipeak) {
+			if (!ops->ipeak(true)) {
+				*why = "CX iPeak vote refused";
+				return false;
+			}
+			st->ipeak = true;
+		}
+		if (!ops->ddr(t->bus_mhz)) {
+			*why = "RPM refused the DDR vote";
+			opp_votes_down(ops, st);
+			return false;
+		}
+		if (c > st->cx) {
+			if (!ops->cx(c)) {
+				*why = "RPM refused the CX vote";
+				opp_votes_down(ops, st);
+				return false;
+			}
+			st->cx = c;
+		}
+	}
+	if (!opp_clock(ops, st, to)) {
+		*why = "no PLL lock or the RCG did not take";
+		opp_votes_down(ops, st);
+		return false;
+	}
+	if (to > from && ops->check != NULL && !ops->check(to)) {
+		*why = "the clock read is wrong";
+		if (!opp_clock(ops, st, from)) {
+			st->broken = st->cur == to;
+		}
+		opp_votes_down(ops, st);
+		return false;
+	}
+	if (to < from) {
+		opp_votes_down(ops, st);
+	}
+	return true;
+}
+
+/* The one self-check line. One kernel log line ends after 255 bytes: the host test builds the longest case. */
+static int
+opp_on_line(char *s, size_t n, uint32_t usable, const uint16_t *gcc, const uint16_t *cp, uint64_t fence_us, bool ipeak, const char *why)
+{
+	int at = scnprintf(s, n, "LAUREL GPU CLOCK: on: MHz=GCC/CP");
+
+	for (uint32_t i = 0; i < OPP_N; i++) {
+		if (usable & (1u << i)) {
+			at += scnprintf(s + at, n - at, " %u=%u/%u", opp_table[i].mhz, gcc[i], cp[i]);
+		}
+	}
+	at += scnprintf(s + at, n - at, "; fence %llu us; %s", (unsigned long long)fence_us, ipeak ? "iPeak" : "no iPeak");
+	if (why[0] != 0) {
+		at += scnprintf(s + at, n - at, "; out");
+		for (uint32_t i = 0; i < OPP_N; i++) {
+			if (i != OPP_300 && !(usable & (1u << i))) {
+				at += scnprintf(s + at, n - at, " %u", opp_table[i].mhz);
+			}
+		}
+		at += scnprintf(s + at, n - at, ": %s", why);
+	}
+	at += scnprintf(s + at, n - at, "; raise %u %% or touch; hot %d C", OPP_RAISE_PCT, OPP_HOT_DC / 10);
+	return at;
+}
