+/*
+ * laurel 3091: USB RX liveness (laurel_usb_check_core.h has the rules and the why). ud_thread runs one step per turn once ue0 is up;
+ * the actions are below. The ARP request goes through the normal TX queue: a reply from the host is a frame like any other
+ * (rx_frames moves), which is the only proof the check accepts.
+ */
+static struct luc ud_check;
+static int ud_check_on = 1;             /* laurelusbcheck=0 */
+
+static void
+ud_check_arp(void)
+{
+	mbuf_t m = NULL;
+
+	if (ud.ifp == NULL) {
+		return;
+	}
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0) {
+		return;
+	}
+	if (mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 || !(mbuf_flags(m) & MBUF_EXT) || mbuf_maxlen(m) < 64) {
+		mbuf_freem(m);
+		return;
+	}
+	uint8_t *f = (uint8_t *)mbuf_data(m);
+	bzero(f, 64);
+	memset(f, 0xff, ETHER_ADDR_LEN);
+	memcpy(f + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+	ud_put16(f + 12, ETHERTYPE_ARP);
+	uint8_t *a = f + ETHER_HDR_LEN;
+	ud_put16(a, 1);
+	ud_put16(a + 2, ETHERTYPE_IP);
+	a[4] = ETHER_ADDR_LEN;
+	a[5] = 4;
+	ud_put16(a + 6, 1);                     /* request: who has 192.168.7.1, tell 192.168.7.2 */
+	memcpy(a + 8, ud_phone_mac, ETHER_ADDR_LEN);
+	ud_put32(a + 14, UD_IP_PHONE);
+	ud_put32(a + 24, UD_IP_HOST);
+	mbuf_setlen(m, ETHER_HDR_LEN + 28);
+	mbuf_pkthdr_setlen(m, ETHER_HDR_LEN + 28);
+	(void)ud_if_output(ud.ifp, m);
+}
+
+/* the hold's recipe (3031): end the transfer the controller may still hold, then a fresh RX TRB. ud_thread owns the RX side: no lock. */
+static void
+ud_check_rearm(void)
+{
+	if (ud.ep_busy[EP_RX]) {
+		(void)ud_epcmd(EP_RX, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | (ud.ep_rsc[EP_RX] << 16), 0, 0, 0);
+		ud.ep_busy[EP_RX] = false;
+		ud_udelay(1000);
+	}
+	ud_rx_arm();
+}
+
+/*
+ * Soft disconnect and connect, as Linux dwc3 (dwc3_gadget_run_stop): every data transfer ended, the data endpoints off, RUN/STOP
+ * cleared until the controller halts, 200 ms for the host to see the detach, ep0 back at a SETUP, RUN/STOP set. The host then
+ * resets the bus and enumerates (ud_event handles both as for a cable plugged in again); SET_CONFIGURATION sets configured.
+ */
+static void
+ud_check_restart(void)
+{
+	static const unsigned data_eps[3] = { EP_RX, EP_TX, EP_INT };
+
+	for (unsigned i = 0; i < 3; i++) {
+		unsigned e = data_eps[i];
+		if (ud.ep_busy[e]) {
+			(void)ud_epcmd(e, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | (ud.ep_rsc[e] << 16), 0, 0, 0);
+			ud.ep_busy[e] = false;
+			ud_udelay(1000);
+		}
+	}
+	lck_mtx_lock(ud.lock);
+	ud.tx_busy = false;
+	ud.configured = false;
+	ud.data_alt = 0;
+	lck_mtx_unlock(ud.lock);
+	dwc_wr(DALEPENA, 0x3);
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	int i;
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT) == 0; i++) {
+		ud_udelay(1000);
+	}
+	ud_sleep_ms(200);
+	if (ud.state != EP0_SETUP) {
+		/* a control transfer was in flight: its TRBs go, then a SETUP waits as at the start */
+		for (unsigned e = 0; e < 2; e++) {
+			(void)ud_epcmd(e, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | (((dwc_rd(DEPCMD(e)) >> 16) & 0x7f) << 16), 0, 0, 0);
+			ud_udelay(1000);
+		}
+		ud_start_setup();
+	}
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	printf("LAUREL USB CHECK: gadget restarted (controller halted after %d ms): the host enumerates it again\n", i);
+}
+
+static void
+ud_check_poll(uint64_t now)
+{
+	uint64_t ns;
+
+	if (!ud_check_on || ud_early || ud_tc_mode || ud_in_panic || ud.ifp == NULL) {
+		return;
+	}
+	absolutetime_to_nanoseconds(now, &ns);
+	switch (luc_step(&ud_check, ns, ud.configured, ud.rx_frames)) {
+	case LUC_NONE:
+		break;
+	case LUC_ASK:
+		if (ud_check.stage == 1) {
+			printf("LAUREL USB CHECK: no frame from the host for %u s: asking it by ARP\n", LUC_QUIET_S);
+		}
+		ud_check_arp();
+		break;
+	case LUC_REARM:
+		printf("LAUREL USB CHECK: no ARP reply after %u asks: RX endpoint re-armed (rx %llu tx %llu, stale %u), asking again\n",
+		    LUC_ASKS, ud.rx_frames, ud.tx_frames, ud_rx_stale);
+		ud_check_rearm();
+		ud_check_arp();
+		break;
+	case LUC_RESTART:
+		printf("LAUREL USB CHECK: still no reply: restarting the gadget (%u s for the host)\n", LUC_RESTART_WAIT_S);
+		ud_check_restart();
+		break;
+	case LUC_BACK:
+		printf("LAUREL USB CHECK: RX back after %s (asks %u, re-arms %u, restarts %u, recovered %u)\n",
+		    luc_stage_name(ud_check.last_stage), ud_check.asks, ud_check.rearms, ud_check.restarts, ud_check.recovered);
+		break;
+	case LUC_PANIC:
+		panic("LAUREL USB CHECK: RX dead: no frame from the host for %llu s after %u ARP asks, %u RX re-arm, %u gadget restart "
+		    "(host configured again: %s); rx %llu tx %llu stale %u; laurelusbcheck=0 turns this off",
+		    (ns - ud_check.quiet_at) / NSEC_PER_SEC, ud_check.asks, ud_check.rearms, ud_check.restarts,
+		    ud.configured ? "yes" : "no", ud.rx_frames, ud.tx_frames, ud_rx_stale);
+		break;
+	}
+}
