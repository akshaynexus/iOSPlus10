+/*
+ * laurel 3091: USB RX liveness: the rules, with no kernel types, so the host runs them too
+ * (scripts/laurel/usb-check-test.sh builds this header with tools/usb-check-test/usb-check-test.c).
+ *
+ * Why: 2026-11-07 the gadget's receive side died while iOS ran on (the RX TRB shared a cache line with the TX TRB: 3052),
+ * the live log kept coming, no panic, no bark, and the host had no way in: only the keys. The host sends a frame at least
+ * every 10 s while scripts/debug/usblog.sh runs (its keepalive), SSH and ctl more. So: no frame for LUC_QUIET_S while the
+ * host has the gadget configured is the first sign. The feature then asks the host by ARP (the host's kernel answers for
+ * 192.168.7.1 with no program of ours), LUC_ASKS times, LUC_ASK_S apart. No answer: the RX endpoint is ended and armed
+ * again (the hold's recipe of 3031), one more ask; still nothing: the gadget restarts (RUN/STOP off and on: the host
+ * enumerates it again, LUC_RESTART_WAIT_S for that), one more ask; still nothing: a panic with the reason, which lands in
+ * fastboot (3090) where the guardian takes over. Any frame at any stage ends the check: "RX back after ...".
+ * Kill switch: laurelusbcheck=0. A host that sends nothing but answers ARP costs one ARP every LUC_QUIET_S + 2 s.
+ */
+#ifndef LAUREL_USB_CHECK_CORE_H
+#define LAUREL_USB_CHECK_CORE_H
+
+#define LUC_QUIET_S         30u     /* no frame from a configured host for this long: the check starts */
+#define LUC_ASKS            3u      /* ARP asks before the first repair */
+#define LUC_ASK_S           2u      /* between asks, and after each repair */
+#define LUC_RESTART_WAIT_S  20u     /* after the gadget restart: the host must configure it again */
+
+enum luc_act {
+	LUC_NONE = 0,
+	LUC_ASK,            /* send one ARP request to the host */
+	LUC_REARM,          /* end and arm the RX endpoint again, then ask */
+	LUC_RESTART,        /* restart the gadget (RUN/STOP), then wait for the host */
+	LUC_PANIC,          /* RX is dead: panic (the text says why) */
+	LUC_BACK            /* a frame came in during a check: say so */
+};
+
+enum luc_stage {
+	LUC_S_QUIET = 0,
+	LUC_S_ASKED,        /* 1..LUC_ASKS: that many asks are out */
+	LUC_S_REARMED = 10,
+	LUC_S_RESTARTED,    /* waiting for the host to configure again */
+	LUC_S_RESTART_ASKED,
+	LUC_S_DEAD
+};
+
+struct luc {
+	unsigned long long rx_seen;     /* rx_frames at the last change */
+	unsigned long long quiet_at;    /* when rx_frames last changed (or the host went away) */
+	unsigned long long next;        /* the next step not before this */
+	unsigned stage;
+	unsigned asks, rearms, restarts, recovered;
+	unsigned last_stage;            /* the stage a frame ended (for the line) */
+};
+
+/* one step of the rules; now in ns, from any monotonic clock */
+static inline enum luc_act
+luc_step(struct luc *c, unsigned long long now, int configured, unsigned long long rx_frames)
+{
+	const unsigned long long S = 1000000000ull;
+
+	if (c->stage == LUC_S_DEAD) {
+		return LUC_NONE;        /* the panic is on its way */
+	}
+	if (rx_frames != c->rx_seen) {
+		c->rx_seen = rx_frames;
+		c->quiet_at = now;
+		if (c->stage != LUC_S_QUIET) {
+			c->last_stage = c->stage;
+			c->stage = LUC_S_QUIET;
+			c->recovered++;
+			return LUC_BACK;
+		}
+		return LUC_NONE;
+	}
+	if (c->stage == LUC_S_RESTARTED) {
+		if (configured) {
+			c->stage = LUC_S_RESTART_ASKED;
+			c->asks++;
+			c->next = now + LUC_ASK_S * S;
+			return LUC_ASK;
+		}
+		if (now >= c->next) {
+			c->stage = LUC_S_DEAD;
+			return LUC_PANIC;
+		}
+		return LUC_NONE;
+	}
+	if (!configured) {
+		/* no host: silence is normal; a host that left during a check ends it */
+		c->quiet_at = now;
+		c->stage = LUC_S_QUIET;
+		return LUC_NONE;
+	}
+	if (now - c->quiet_at < LUC_QUIET_S * S || now < c->next) {
+		return LUC_NONE;
+	}
+	if (c->stage < LUC_ASKS) {
+		c->stage++;
+		c->asks++;
+		c->next = now + LUC_ASK_S * S;
+		return LUC_ASK;
+	}
+	if (c->stage == LUC_ASKS) {
+		c->stage = LUC_S_REARMED;
+		c->rearms++;
+		c->asks++;
+		c->next = now + LUC_ASK_S * S;
+		return LUC_REARM;
+	}
+	if (c->stage == LUC_S_REARMED) {
+		c->stage = LUC_S_RESTARTED;
+		c->restarts++;
+		c->next = now + LUC_RESTART_WAIT_S * S;
+		return LUC_RESTART;
+	}
+	if (c->stage == LUC_S_RESTART_ASKED) {
+		c->stage = LUC_S_DEAD;
+		return LUC_PANIC;
+	}
+	return LUC_NONE;
+}
+
+static inline const char *
+luc_stage_name(unsigned stage)
+{
+	switch (stage) {
+	case LUC_S_QUIET: return "quiet";
+	case LUC_S_REARMED: return "the RX re-arm";
+	case LUC_S_RESTARTED: return "the gadget restart";
+	case LUC_S_RESTART_ASKED: return "the ask after the gadget restart";
+	case LUC_S_DEAD: return "dead";
+	default: return stage <= LUC_ASKS ? "an ARP ask" : "?";
+	}
+}
+#endif
