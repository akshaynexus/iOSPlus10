+/* laurel 2408: ath10k_wmi_tlv_op_gen_vdev_wmm_conf: the AP's EDCA values, by BE, BK, VI, VO */
+#define CMD_VDEV_SET_WMM    0x500D
+#define TAG_VDEV_SET_WMM    0xC7
+#define CMD_PDEV_SET_PARAM  0x4003
+#define TAG_PDEV_SET_PARAM  0x52
+#define PDEV_PARAM_DYNAMIC_BW 0xA
+static bool
+w_vdev_wmm(void)
+{
+	uint8_t m[4 + 4 + 4 * 28] = {}, *p = wmi_put_tlv(m, TAG_VDEV_SET_WMM, 4 + 4 * 28);
+	uint32_t v[4][4];
+
+	lw_wmm_values(&s_ap, v);
+	p = w_p32(p, 0);
+	for (uint32_t a = 0; a < 4; a++) {
+		p = w_p32(p, 0);                        /* dummy (wmi_tlv_vdev_wmm_params) */
+		for (uint32_t i = 0; i < 4; i++) {
+			p = w_p32(p, v[a][i]);
+		}
+		p = w_p32(p, 0);                        /* acm */
+		p = w_p32(p, 0);                        /* no_ack */
+	}
+	return wmi_send(CMD_VDEV_SET_WMM, m, sizeof(m));
+}
+
+/* ath10k_start: dynamic bandwidth, once: lets the firmware fall back to 20 MHz on a busy 40/80 MHz channel */
+static void
+w_pdev_wide(void)
+{
+	static bool sent;
+	uint8_t m[4 + 12], *p;
+
+	if (!sent) {
+		sent = true;
+		p = wmi_put_tlv(m, TAG_PDEV_SET_PARAM, 12);
+		p = w_p32(p, 0);
+		p = w_p32(p, PDEV_PARAM_DYNAMIC_BW);
+		w_p32(p, 1);
+		(void)wmi_send(CMD_PDEV_SET_PARAM, m, sizeof(m));
+	}
 }
 
