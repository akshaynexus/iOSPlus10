diff --git a/iokit/Kernel/arm/SweetPlatformExpert.cpp b/iokit/Kernel/arm/SweetPlatformExpert.cpp
--- a/iokit/Kernel/arm/SweetPlatformExpert.cpp
+++ b/iokit/Kernel/arm/SweetPlatformExpert.cpp
@@ -9,6 +9,30 @@
 #include <IOKit/IOPlatformExpert.h>
 #include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
+
+/* laurel 2003: power off, restart, reboot mode (bsd/dev/laurel_reboot.c) */
+extern "C" {
+int laurel_reboot_prepare(void);
+void laurel_power_off(void);
+void laurel_restart(void);
+}
+
+static int
+laurel_halt_restart(unsigned int type)
+{
+	switch (type) {
+	case kPEHaltCPU:
+		laurel_power_off();
+		return -1;          /* returned: SYSTEM_OFF refused; XNU halts the CPU */
+	case kPERestartCPU:
+	case kPEPanicRestartCPU:
+	case kPEPanicRestartCPUNoCallouts:
+		laurel_restart();
+		return -1;
+	default:
+		return 0;           /* panic callouts and the rest: nothing to do */
+	}
+}
 
 class SweetPlatformExpert : public IODTPlatformExpert {
 	OSDeclareDefaultStructors(SweetPlatformExpert);
@@ -30,6 +54,9 @@
 		return false;
 	}
 	registerService();
+	if (laurel_reboot_prepare()) {
+		PE_halt_restart = &laurel_halt_restart;
+	}
 	IOLog("SWEET: platform expert registered\n");
 	return true;
 }
