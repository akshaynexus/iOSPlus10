+/*
+ * laurel 2201: publish AppleARMBacklight only with the GPU renderer (topaz 0110: with the CPU renderer,
+ * CoreBrightness's digital dimming took the UI under 1 fps). RedwoodGPU is published by TopazAdreno.cpp
+ * after the Adreno starts; without it in LAUREL_BL_GPU_WAIT_S the slider stays off and CoreBrightness keeps
+ * driving IOMFBBrightnessLevel on the framebuffer.
+ */
+void
+AppleCLCD::blPublisher(void *self, __unused wait_result_t result)
+{
+	AppleCLCD *fb = (AppleCLCD *)self;
+	const char *panel = fb->fPanel != NULL ? fb->fPanel->name : "unknown panel";
+	OSDictionary *match = IOService::serviceMatching("RedwoodGPU");
+	IOService *gpu = match != NULL ? IOService::waitForMatchingServiceWithToken(match,
+	    (uint64_t)LAUREL_BL_GPU_WAIT_S * NSEC_PER_SEC, NULL) : NULL;
+	OSSafeReleaseNULL(match);
+	if (gpu == NULL) {
+		IOLog("LAUREL BACKLIGHT: on: DCS max %u (%s), AppleARMBacklight off: CPU renderer (digital dimming; no RedwoodGPU "
+		    "in %u s), IOMFBBrightnessLevel kept\n", fb->fBlMax, panel, LAUREL_BL_GPU_WAIT_S);
+		fb->release();
+		return;
+	}
+	gpu->release();
+	AppleARMBacklight *bl = OSTypeAlloc(AppleARMBacklight);
+	bool published = false;
+	if (bl != NULL && bl->init()) {
+		bl->fFB = fb;
+		bl->setProperty("backlight-control", true);
+		bl->setProperty("max-nits", (unsigned long long)fb->fBlNits, 32);
+		bl->setProperty("min-nits", (unsigned long long)((LAUREL_BL_MIN * fb->fBlNits + fb->fBlMax - 1) / fb->fBlMax), 32);
+		bl->publish(laurel_value_for(fb->fBlLevel, fb->fBlMax), fb->fBlLevel * fb->fBlNits / fb->fBlMax);
+		if (bl->attach(fb)) {
+			fb->fBacklight = bl;    /* keeps the reference */
+			bl->registerService();
+			bl = NULL;
+			published = true;
+		}
+	}
+	OSSafeReleaseNULL(bl);
+	IOLog("LAUREL BACKLIGHT: on: DCS max %u (%s), AppleARMBacklight %s (RedwoodGPU up: GPU renderer)\n",
+	    fb->fBlMax, panel, published ? "published" : "failed");
+	fb->release();
+}
