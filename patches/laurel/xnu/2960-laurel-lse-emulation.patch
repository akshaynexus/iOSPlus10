 extern int _sweet_lse_x(user_addr_t, uint32_t, uint64_t, uint64_t, uint64_t *);
 
+__dead2 static void
+sweet_lse_bad_access(arm_saved_state_t *state, mach_exception_data_type_t code, user_addr_t va)
+{
+	mach_exception_data_type_t codes[2] = { code, (mach_exception_data_type_t)va };
+
+	thread_reset_pcs_will_fault(current_thread());
+	set_saved_state_far(state, va);
+	exception_triage(EXC_BAD_ACCESS, codes, 2);
+	__builtin_unreachable();
+}
+
+/*
+ * laurel 2960: the access gave EFAULT. handle_kernel_abort() already ran vm_fault with THREAD_UNINT and it failed. Ask once more, as handle_user_abort() does, for the real
+ * result. Success: the map changed in between. KERN_ABORTED: a signal is pending. In both, back to EL0 on the same word, which traps again. Else what the real word gives:
+ * EXC_BAD_ACCESS with the code and address, PC on the word, no register changed.
+ */
+static bool
+sweet_lse_fault(arm_saved_state_t *state, user_addr_t va, user_addr_t addr, bool write)
+{
+	kern_return_t kr = vm_fault(current_map(), vm_map_trunc_page(addr, PAGE_MASK), write ? (VM_PROT_READ | VM_PROT_WRITE) : VM_PROT_READ,
+	    FALSE, VM_KERN_MEMORY_NONE, THREAD_ABORTSAFE, NULL, 0);
+
+	if (kr != KERN_SUCCESS && kr != KERN_ABORTED) {
+		sweet_lse_bad_access(state, kr, va);
+	}
+	return true;
+}
