diff --git a/iokit/Kernel/arm/LaurelTorch.cpp b/iokit/Kernel/arm/LaurelTorch.cpp
new file mode 100644
index 0000000..c543fb0
--- /dev/null
+++ b/iokit/Kernel/arm/LaurelTorch.cpp
@@ -0,0 +1,84 @@
+/*
+ * laurel_sprout (Mi A3): the flashlight service (laurel 2770). The hardware driver is bsd/dev/laurel_torch.c
+ * (PMI632 flash LED, /dev/laureltorch); this class starts it from IOKit matching (IOResources, as LaurelVibrator)
+ * and gives iOS the one thing it reads in the device tree:
+ *
+ * laurel_torch_publish_flash(): IODeviceTree:/product/camera "flash" (any value). [V negroni userland/flashlight
+ * README, 20H392 disassembly]: +[AVFlashlight hasFlashlight] = MGGetBoolAnswer("camera-flash"); libMobileGestalt
+ * answers true when IODeviceTree:/product/camera has a property "flash" (presence only). Without it Control Center
+ * has no flashlight button. Called by laurel_torch.c after the root mount, only when the torch self-check passed and
+ * the root has the mediaserverd plug-in LaurelFlashlight.driver (userland/laurel/flashlight): with the button and
+ * no plug-in, Control Center would talk to a FigFlashlight server that is never started
+ * (com.apple.coremedia.flashlight is a MachService of mediaserverd [V root plist]; the root has
+ * StartRecorderServer false, so mediaserverd starts no capture server itself).
+ * Not in scripts/laurel/mkadt.py on purpose (as /product/haptics in LaurelVibrator.cpp).
+ * [I] /product/camera may also make MobileGestalt answer other camera keys; this port has no camera driver.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IORegistryEntry.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+
+extern "C" int laurel_torch_start(void);
+extern "C" int laurel_torch_publish_flash(void);
+
+class LaurelTorch : public IOService {
+	OSDeclareDefaultStructors(LaurelTorch);
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(LaurelTorch, IOService);
+
+bool
+LaurelTorch::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	bool on = laurel_torch_start() == 0;     /* one "LAUREL TORCH: on|off: ..." line */
+	setProperty("laurel-torch", on ? "on" : "off");
+	setProperty("torch-device", "/dev/laureltorch");
+	setProperty("torch-cap-ma", 150ULL, 32);
+	setProperty("torch-auto-off-s", 600ULL, 32);
+	registerService();
+	return true;
+}
+
+extern "C" int
+laurel_torch_publish_flash(void)
+{
+	IORegistryEntry *product = IORegistryEntry::fromPath("/product", gIODTPlane);
+	if (product == NULL) {
+		IOLog("LAUREL TORCH UI: no IODeviceTree:/product (ADT built without d22ap.adt)\n");
+		return -1;
+	}
+	static const uint32_t one = 1;
+	OSData *flash = OSData::withBytes(&one, sizeof(one));
+	IORegistryEntry *camera = product->childFromPath("camera", gIODTPlane);
+	bool ok = flash != NULL;
+	if (ok && camera != NULL) {
+		ok = camera->setProperty("flash", flash);       /* a /product/camera from the ADT: add the property */
+		camera->release();
+	} else if (ok) {
+		static const char name[] = "camera";
+		IORegistryEntry *node = new IORegistryEntry;
+		OSData *n = OSData::withBytes(name, sizeof(name));
+		ok = node != NULL && n != NULL && node->init(NULL);
+		if (ok) {
+			node->setName(name);
+			ok = node->setProperty("name", n) && node->setProperty("flash", flash) &&
+			    node->attachToParent(product, gIODTPlane);
+		}
+		OSSafeReleaseNULL(n);
+		OSSafeReleaseNULL(node);        /* the parent link keeps it */
+	}
+	OSSafeReleaseNULL(flash);
+	product->release();
+	return ok ? 0 : -1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
