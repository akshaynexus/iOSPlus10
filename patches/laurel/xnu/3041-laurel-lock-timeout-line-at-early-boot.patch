 STARTUP(TIMEOUTS, STARTUP_RANK_MIDDLE, ml_init_lock_timeout);
 
+/*
+ * laurel 3041: the line of 2994 printed from ml_init_lock_timeout(), a STARTUP(TIMEOUTS) function, inside kernel_startup_bootstrap():
+ * before the LOCKS phase. printf -> os_log_with_args -> _os_log_to_msgbuf_internal -> bsd_log_lock -> lck_ticket_lock(&log_lock), and
+ * log_lock (LCK_TICKET_DECLARE, osfmk/kern/printf.c) gets its type word only at STARTUP(LOCKS, rank 4): the DEVELOPMENT kernel's
+ * LCK_TICKET_VERIFY sees lck_ticket_type 0, not LCK_TYPE_TICKET, and panics "Invalid ticket lock" [V phone 2026-11-07 04:2x: after
+ * "SWEET EARLY 4: cpu_bootstrap done" the early console showed a blank row and two rows of dense text (sweet_early_panic prints a
+ * newline, then the panic text) and never mark 5; no USB]. The kill switch printed its "off" line from the same place. A good boot's
+ * first printf is "iBoot version" from PE_init_platform(TRUE), after kernel_startup_bootstrap(). The values stay set at TIMEOUTS (the
+ * lock timeouts must hold from the first contended lock); the line prints at EARLY_BOOT, where LAUREL RAM prints too.
+ */
+
+__startup_func
+static void
+laurel_lock_timeout_line(void)
+{
+	uint64_t lto_ns = 0, tlto_ns = 0;
+
+	absolutetime_to_nanoseconds(laurel_lockto_lto, &lto_ns);
+	absolutetime_to_nanoseconds(laurel_lockto_tlto, &tlto_ns);
+	if (!laurel_lockto_on) {
+		printf("LAUREL LOCK TIMEOUT: off: kill switch laurellockto=0: a spin lock waits for ever (spin %llu ms, ticket %llu ms)\n", lto_ns / NSEC_PER_MSEC, tlto_ns / NSEC_PER_MSEC);
+	} else {
+		printf("LAUREL LOCK TIMEOUT: on: a spin lock waits at most %llu ms, a ticket lock %llu ms, then a panic names the lock and its holder (wdt=-1 had left 0: a silent CPU); kill switch laurellockto=0\n",
+		    lto_ns / NSEC_PER_MSEC, tlto_ns / NSEC_PER_MSEC);
+	}
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, laurel_lock_timeout_line);
+
 
