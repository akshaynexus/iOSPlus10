+/*
+ * laurel 2916: the kept buffers of every client go back: for the wired guard before it refuses a surface, and for gemNew before a buffer goes to wired
+ * pages. At most twice a second. Takes the lock: not from under it. No line per call: one when it gives back, the first 4 and then every 64th.
+ */
+extern "C" uint64_t
+redwood_gpu_give_back_kept(void)
+{
+	static uint64_t last;
+	static uint32_t times;
+	uint64_t now = mach_absolute_time(), half, then = __atomic_load_n(&last, __ATOMIC_RELAXED), bytes = 0;
+	uint32_t clients = 0;
+
+	nanoseconds_to_absolutetime(500 * NSEC_PER_MSEC, &half);
+	if (gGPULock == NULL || (then != 0 && now - then < half) || !__atomic_compare_exchange_n(&last, &then, now, false, __ATOMIC_RELAXED, __ATOMIC_RELAXED)) {
+		return 0;
+	}
+	IOLockLock(gGPULock);
+	for (uint32_t i = 0; i < GPU_CLIENTS; i++) {
+		if (gGPUClients[i] != NULL) {
+			uint64_t one = gGPUClients[i]->giveBackKept();
+
+			bytes += one;
+			clients += one != 0;
+		}
+	}
+	IOLockUnlock(gGPULock);
+	if (bytes != 0 && (times++ < 4 || (times & 63) == 0)) {
+		IOLog("LAUREL GPU KEPT: gave back %llu MiB of kept buffers of %u clients: memory is short (call %u)\n", bytes >> 20, clients, times);
+	}
+	return bytes;
+}
+
+extern "C" void
+redwood_gpu_held(uint64_t * buffers, uint64_t * host, uint64_t * kept, uint32_t * clients)
+{
+	if (gGPULock == NULL) {
+		return;
+	}
+	IOLockLock(gGPULock);
+	for (uint32_t i = 0; i < GPU_CLIENTS; i++) {
+		if (gGPUClients[i] != NULL) {
+			gGPUClients[i]->held(buffers, host, kept);
+			(*clients)++;
+		}
+	}
+	IOLockUnlock(gGPULock);
+}
