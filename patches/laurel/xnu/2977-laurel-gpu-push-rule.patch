+/*
+ * laurel 2977: which own (not IOSurface, not host) buffer goes out of the CPU's cache at a submission, plain C, so that a host test runs exactly this
+ * (scripts/laurel/gpu-push-test.sh, tools/gpu-push-test/). The missed push is the failure that matters (visible corruption), so the rule only skips when the CPU
+ * cannot have a dirty line of the buffer:
+ *   pool buffer                write-combined, every map of it: nothing in the cache. Skip.
+ *   wc_now                     every page's attribute is write-combined (checked page by page when it is made; first page again each submission): skip.
+ *   mapped_now                 a user mapping (cached) is there: the CPU may write at any moment and says nothing: push, always. Stays dirty.
+ *   dirty                      was mapped (or written by the kernel) since the last push: push once; when no map is left it is clean after that push.
+ *   else                       no map since the last push: no CPU write can have happened. Skip.
+ * Every way to a CPU write: a user map = clientMemoryForType (sets dirty under the lock; retain count > 1 while it lives: mapped_now); kernel write through b->kernel = only
+ * gpu_keep=2's bzero (sets dirty); kept and given again: dirty goes with it. Host pages and surfaces have their own rules in submit().
+ * rule_on false (kill switch gpudirty=0): the old rule, exactly.
+ */
+#ifndef LAUREL_GPU_PUSH_CORE_H
+#define LAUREL_GPU_PUSH_CORE_H
+
+/* osfmk/arm/memory_types.h, the same on both kernels (test: the script greps both trees). A wrong value fails the page check: feature off, cached, pushed: safe. */
+#define LGF_WIMG_WCOMB  0x6u
+#define LGF_WIMG_MASK   0xFFu
+
+enum lgf_what {
+	LGF_SKIP,                       /* nothing, not counted */
+	LGF_CLEAN,                      /* nothing, counted as passed over */
+	LGF_PUSH,
+};
+
+struct lgf_own {
+	bool rule_on;                   /* gpudirty */
+	bool seed_rule;                 /* gpuseed */
+	bool gpu_cached;                /* gpu_cached */
+	bool seen;                      /* the old flag: mapped once */
+	bool same_place;                /* VA = PA: the pool */
+	bool dirty;                     /* a map or a kernel write since the last push */
+	bool mapped_now;                /* a user mapping lives */
+	bool wc_now;                    /* its pages are write-combined, checked now */
+};
+
+/* *dirty_after: the buffer's new dirty flag */
+static inline enum lgf_what
+lgf_own_buffer(const struct lgf_own *b, bool *dirty_after)
+{
+	*dirty_after = b->dirty;
+	if (!b->rule_on) {
+		if (!b->seen || !b->gpu_cached) {
+			return LGF_SKIP;
+		}
+		return b->seed_rule && b->same_place ? LGF_CLEAN : LGF_PUSH;
+	}
+	if (!b->gpu_cached) {
+		return LGF_SKIP;
+	}
+	if (b->same_place && b->seed_rule) {
+		return LGF_CLEAN;
+	}
+	if (b->wc_now) {
+		*dirty_after = false;
+		return LGF_CLEAN;
+	}
+	if (b->mapped_now || b->dirty) {
+		*dirty_after = b->mapped_now;
+		return LGF_PUSH;
+	}
+	return LGF_SKIP;
+}
+
+/* what a page's attribute must be for a buffer to count as write-combined: all pages, and at least one */
+static inline bool
+lgf_all_pages_wc(const unsigned *attributes, unsigned pages, unsigned wc, unsigned mask)
+{
+	if (pages == 0) {
+		return false;
+	}
+	for (unsigned i = 0; i < pages; i++) {
+		if ((attributes[i] & mask) != wc) {
+			return false;
+		}
+	}
+	return true;
+}
+
+#endif /* LAUREL_GPU_PUSH_CORE_H */
