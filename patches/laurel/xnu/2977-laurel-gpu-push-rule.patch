+/*
+ * laurel 2977: scattered pages that are write-combined in every map. Only a pageable descriptor gets this: its VM object carries the mode (vm_object wimg_bits); wiring sets each page's
+ * attribute (vm_object_iopl_request: PMAP_BATCH_SET_CACHE_ATTR) and the kernel's own alias with it. Not an option of the map: on a kernel-memory descriptor the option alone does nothing, the
+ * pages stay cached (and a descriptor made with the option is contiguous, topaz: from the lower bank). So it is checked: every page's attribute after the wiring. One that is not write-combined
+ * turns this off for good, one line, and the buffer is made cached: then the dirty rule pushes it. The read cost: a CPU read of a mapped block is uncached, as for every pool buffer already (the pool is
+ * write-combined and this is what Mesa gets when the pool has room). Readback of a mapped scattered block: [I] about 10 times slower than cached; the Metal paths read rarely. *page0: its first page.
+ */
+static IOBufferMemoryDescriptor *
+gpuScatteredWC(uint64_t size, ppnum_t * page0)
+{
+	static uint32_t said;
+	const char * why = NULL;
+	IOBufferMemoryDescriptor * memory;
+
+	if (gGPUScatteredWCOff) {
+		return NULL;
+	}
+	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryPageable | kIOMapWriteCombineCache, (vm_size_t) size, PAGE_SIZE);
+	if (memory == NULL) {
+		return NULL;                    /* (no memory or no kernel addresses now: cached this once) */
+	}
+	if (memory->prepare(kIODirectionInOut) != kIOReturnSuccess) {
+		memory->release();
+		return NULL;
+	}
+	*page0 = 0;
+	for (uint64_t offset = 0; offset < size && why == NULL; offset += PAGE_SIZE) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(offset, &length, kIOMemoryMapperNone);
+		unsigned attribute = phys != 0 ? pmap_cache_attributes((ppnum_t) atop_64(phys)) : 0;
+
+		if (phys == 0) {
+			why = "a page has no address";
+		} else if (!lgf_all_pages_wc(&attribute, 1, LGF_WIMG_WCOMB, LGF_WIMG_MASK)) {
+			why = "a page is not write-combined";
+		} else if (offset == 0) {
+			*page0 = (ppnum_t) atop_64(phys);
+		}
+		if (why == NULL) {
+			(void) *(volatile uint8_t *) ((uint8_t *) memory->getBytesNoCopy() + offset);   /* (its kernel map entry, before the push in gemNew) */
+		}
+	}
+	if (why != NULL) {
+		gGPUScatteredWCOff = true;
+		*page0 = 0;
+		memory->release();
+		IOLog("LAUREL GPU WC: off: %s: scattered buffers stay cached and go out of the cache while mapped\n", why);
+		return NULL;
+	}
+	if (said++ == 0) {
+		IOLog("LAUREL GPU WC: on: the first scattered buffer, %llu bytes, every page write-combined\n", size);
+	}
+	return memory;
+}
