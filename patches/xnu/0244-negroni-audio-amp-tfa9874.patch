+++ b/bsd/dev/negroni_tfa.h
@@ -0,0 +1,31 @@
+/*
+ * NEGRONI (SM8450) speaker/earpiece amplifiers: 2x NXP TFA9874 on QUP SE13 (I2C 0x34 = top, the
+ * earpiece/receiver and the left speaker channel; 0x35 = bottom, the right speaker channel), I2S
+ * data on TERT MI2S (negroni_audio.c). iOSPlus10 patch 0244, docs/audio-plan.md stage (c).
+ * UNTESTED ON HARDWARE. Off by default (boot-arg negroniaudio_amp=1).
+ */
+#ifndef _NEGRONI_TFA_H_
+#define _NEGRONI_TFA_H_
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define NEGRONI_TFA_ROUTE_OFF           0u
+#define NEGRONI_TFA_ROUTE_SPEAKER       1u      /* both amps, container profile "speaker" */
+#define NEGRONI_TFA_ROUTE_RECEIVER      2u      /* 0x34 only, container profile "receiver" (the earpiece) */
+
+bool negroni_tfa_wanted(void);                  /* boot-arg negroniaudio_amp=1 */
+/* Pins, the container table (tfa-init.bin in the ADSP area), reset pulse, revision. Amps stay off. */
+int negroni_tfa_probe(void);
+/* Cold start of the route's amps (the I2S clock must run). 0 = playing; amps are off on an error. */
+int negroni_tfa_start(uint32_t route);
+void negroni_tfa_stop(const char *why);         /* AMPE 0, PWDN 1 on every started amp */
+/* Status registers; a fault (over-temperature, over-current, under-voltage, alarm) stops the amps
+ * and blocks a restart for 10 s. 0 = fine or off. log != 0: one line per amp. */
+int negroni_tfa_check(int log);
+bool negroni_tfa_playing(void);
+bool negroni_tfa_ready(void);                   /* probe passed, no fault latch */
+/* Panic/halt: no locks, best effort: AMPE 0 + PWDN 1 over I2C, then the reset pins held high. */
+void negroni_tfa_panic(void);
+
+#endif
