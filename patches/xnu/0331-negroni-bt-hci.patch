+/* btqca.c:16 qca_read_soc_version: CC form (soc_type >= WCN3991, 15 bytes) or VSE form (rtype 0x02) */
+static int
+read_version(uint32_t n)
+{
+	const uint8_t sub = EDL_VER_REQ;
+	const uint8_t *r, *v = NULL;
+	uint32_t rl;
+	int error = hci_cmd(OP_EDL, &sub, 1, true), k;
+
+	if (error) {
+		return error;
+	}
+	k = wait_reply(OP_EDL, EDL_APP_VER_RES, &r, &rl);
+	if (k < 0) {
+		return -k;
+	}
+	if (k == R_CC && rl >= 15 && r[0] == 0 && r[1] == EDL_VER_REQ) {
+		v = r + 3;
+	} else if (k == R_VSE && rl >= 14 && r[0] == 0 && r[1] == EDL_APP_VER_RES) {
+		v = r + 2;
+	}
+	if (!v) {
+		SAY("%u version answer not understood (%s, %u bytes)\n", n, k == R_CC ? "CC" : "VSE", rl);
+		return EILSEQ;
+	}
+	h.ver.product = le32(v);
+	h.ver.patch = le16(v + 4);
+	h.ver.rom = le16(v + 6);
+	h.ver.soc = le32(v + 8);
+	uint32_t soc_ver = h.ver.soc << 16 | h.ver.rom;         /* btqca.h:51 get_soc_ver */
+	h.rom = (uint8_t)(((soc_ver & 0xf00u) >> 4) | (soc_ver & 0xfu));     /* btqca.c:776 */
+	h.gf = (h.ver.soc & 0xff00u) == 0x1200u;                /* QCA_HSP_GF_SOC_ID / _MASK, btqca.h:54 */
+	SAY("%u QCA product %#010x, SoC %#010x, ROM %#06x, patch %#06x (%s): controller version %#010x, firmware "
+	    "ROM %02x%s\n", n, h.ver.product, h.ver.soc, h.ver.rom, h.ver.patch, k == R_CC ? "Command Complete" :
+	    "vendor event", soc_ver, h.rom, h.gf ? " GF (\"g\" NVM)" : "");
+	if (h.ver.soc == 0 || h.ver.rom == 0) {                 /* btqca.c:79 */
+		return EILSEQ;
+	}
+	return 0;
+}
