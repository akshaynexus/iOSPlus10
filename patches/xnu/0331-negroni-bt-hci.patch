+/* One log line per HCI event: code, length, decoded CC/CS fields, first 16 bytes of the event */
+static void
+log_event(void)
+{
+	const uint8_t *p = h.pkt + 2;
+	uint32_t plen = h.pkt[1];
+	char what[64];
+
+	what[0] = 0;
+	if (h.pkt[0] == EV_CMD_COMPLETE && plen >= 3) {
+		if (plen >= 4) {
+			snprintf(what, sizeof(what), " (Command Complete op %#06x status %#x)", le16(p + 1), p[3]);
+		} else {
+			snprintf(what, sizeof(what), " (Command Complete op %#06x)", le16(p + 1));
+		}
+	} else if (h.pkt[0] == EV_CMD_STATUS && plen >= 4) {
+		snprintf(what, sizeof(what), " (Command Status op %#06x status %#x)", le16(p + 2), p[0]);
+	} else if (h.pkt[0] == EV_HW_ERROR && plen >= 1) {
+		snprintf(what, sizeof(what), " (Hardware Error code %#x)", p[0]);
+	} else if (h.pkt[0] == EV_VENDOR) {
+		snprintf(what, sizeof(what), " (vendor event)");
+	}
