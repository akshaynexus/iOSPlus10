+static int
+baud_code(uint32_t baud)
+{
+	switch (baud) {                                         /* hci_qca.c:1306 qca_get_baudrate_value */
+	case 115200: return 0x00;
+	case 230400: return 0x05;
+	case 460800: return 0x07;
+	case 921600: return 0x0a;
+	case 1000000: return 0x0b;
+	case 2000000: return 0x0d;
+	case 3000000: return 0x0e;
+	case 3200000: return 0x11;
+	default: return -1;
+	}
+}
