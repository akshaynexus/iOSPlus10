+	uint32_t i, m = MIN(n, DUMP_MAX);
+	s[0] = 0;
+	for (i = 0; i < m; i++) {
+		snprintf(s + 3 * i, 4, " %02x", b[i]);
+	}
+	if (n > m) {
+		strlcpy(s + 3 * m, " ...", 5);
+	}
+	return s;
