+static int
+hci_cmd(uint16_t op, const uint8_t *par, uint8_t len, bool log)
+{
+	uint8_t b[4 + 255];
+	b[0] = H4_CMD;
+	b[1] = (uint8_t)op;
+	b[2] = (uint8_t)(op >> 8);
+	b[3] = len;
+	if (len) {
+		memcpy(b + 4, par, len);
+	}
+	if (log) {
+		SAY("cmd %#06x plen %u:%s\n", op, len, hex(b, 4u + len));
+	}
+	int error = negroni_bt_uart_write(b, 4u + len);
+	if (error) {
+		SAY("cmd %#06x: UART write error %d\n", op, error);
+	}
+	return error;
+}
+
+#define R_CC    1
+#define R_VSE   2
+
+/*
+ * Wait for the answer to `op`: its Command Complete (return parameters in *ret / *rlen) or a vendor event
+ * [00 vse ...] (vse = the EDL response type; VSE_ANY: any vendor event; VSE_NONE: none). Command Status with an
+ * error ends the wait (EIO). Other packets are logged and skipped. Returns R_CC, R_VSE or -errno.
+ */
+#define VSE_NONE        (-1)
+#define VSE_ANY         0x100
+
+static int
+wait_reply(uint16_t op, int vse, const uint8_t **ret, uint32_t *rlen)
+{
+	uint64_t deadline = negroni_bt_us() + (uint64_t)h.to_ms * 1000u;
+
+	for (;;) {
+		if (h4_next(deadline)) {
+			SAY("no answer to %#06x within %u ms (RX buffer %u bytes:%s)\n", op, h.to_ms, h.rxn, hex(h.rx, h.rxn));
+			return -ETIMEDOUT;
+		}
+		if (h.type != H4_EVT) {
+			SAY("H4 type %#x, %u bytes, skipped:%s\n", h.type, h.pktn, hex(h.pkt, h.pktn));
+			continue;
+		}
+		const uint8_t *p = h.pkt + 2;
+		uint32_t plen = h.pkt[1];
+		if (!h.quiet) {
+			log_event();
+		}
+		if (h.pkt[0] == EV_CMD_COMPLETE && plen >= 3 && le16(p + 1) == op) {
+			*ret = p + 3;
+			*rlen = plen - 3u;
+			return R_CC;
+		}
+		if (h.pkt[0] == EV_CMD_STATUS && plen >= 4 && le16(p + 2) == op && p[0] != 0) {
+			if (h.quiet) {
+				log_event();
+			}
+			return -EIO;
+		}
+		if (h.pkt[0] == EV_VENDOR && (vse == VSE_ANY || (vse >= 0 && plen >= 2 && p[0] == 0 && p[1] == vse))) {
+			*ret = p;
+			*rlen = plen;
+			return R_VSE;
+		}
+		if (h.pkt[0] == EV_HW_ERROR && h.quiet) {
+			log_event();
+		}
+	}
+}
+
+/* Command + its Command Complete with status 0 */
+static int
+cmd_cc(uint16_t op, const uint8_t *par, uint8_t len, const uint8_t **ret, uint32_t *rlen)
+{
+	int r = hci_cmd(op, par, len, true);
+	if (r) {
+		return r;
+	}
+	r = wait_reply(op, VSE_NONE, ret, rlen);
+	if (r < 0) {
+		return -r;
+	}
+	if (*rlen < 1 || (*ret)[0] != 0) {
+		SAY("%#06x: Command Complete status %#x (%u return bytes)\n", op, *rlen ? (*ret)[0] : 0xffu, *rlen);
+		return EIO;
+	}
+	return 0;
+}
