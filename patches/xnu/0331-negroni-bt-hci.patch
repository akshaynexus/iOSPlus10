+static int
+step_reset(uint32_t n)
+{
+	const uint8_t *r;
+	uint32_t rl;
+	uint64_t t0 = negroni_bt_us();
+	int error = cmd_cc(OP_RESET, NULL, 0, &r, &rl);
+	if (!error) {
+		SAY("%u HCI_RESET: Command Complete status 0 after %llu ms at %u baud\n", n, (negroni_bt_us() - t0) / 1000u,
+		    negroni_bt_uart_baud());
+	}
+	return error;
+}
