+	h.to_ms = 100;
+	int k = wait_reply(OP_SET_BAUD, VSE_ANY, &r, &rl);
+	h.to_ms = saved;
+	SAY("11 answer to 0xfc48 at the new rate: %s\n", k == R_CC ? "Command Complete" : k == R_VSE ? "vendor event" :
+	    "none within 100 ms (hci_qca.c does not wait for one)");
+	return read_version(11);
+}
+
+/* ---- firmware pack (scripts/bt/mkbtpack.py) inside the WLAN area (scripts/wifi/mkwlanarea.py) ---- */
+
+static int
+step_area(void)
+{
+	struct area_header *a = NULL;
+	int error = ENOENT;
+
+	if (kmem_alloc(kernel_map, (vm_offset_t *)&a, AREA_HDR, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, (vm_offset_t *)&h.pack, PACK_HDR, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    kmem_alloc(kernel_map, (vm_offset_t *)&h.fw, FW_CAP, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		SAY("12 no memory for the firmware buffers; stop\n");
+		error = ENOMEM;
+		goto out;
+	}
+	error = negroni_ufs_wlan_area_read(0, a, AREA_HDR);
+	if (error || memcmp(a->magic, "NEGRWLAN", 8) != 0 || a->version != 1 || a->count == 0 || a->count > AREA_MAX) {
+		SAY("12 no WLAN firmware area header (read error %d); write out/bt/wlan-bt-area.bin "
+		    "(README-bluetooth.md); stop\n", error);
+		error = error ? error : EINVAL;
+		goto out;
+	}
+	error = ENOENT;
+	for (uint32_t i = 0; i < a->count; i++) {
+		const struct fw_entry *e = &a->e[i];
+		if (strncmp(e->name, PACK_NAME, sizeof(e->name)) != 0) {
+			continue;
+		}
+		if (e->offset < AREA_HDR || e->size < PACK_HDR || e->size > (8u << 20)) {
+			SAY("12 %s offset %#x size %u out of range; stop\n", PACK_NAME, e->offset, e->size);
+			error = ERANGE;
+			goto out;
+		}
+		h.pack_at = e->offset;
+		h.pack_size = e->size;
+		error = 0;
+		break;
+	}
+	if (error) {
+		SAY("12 the WLAN area (%u files) has no %s: write out/bt/wlan-bt-area.bin (scripts/bt/mkbtarea.sh); "
+		    "stop\n", a->count, PACK_NAME);
+		goto out;
+	}
+	error = negroni_ufs_wlan_area_read(h.pack_at, h.pack, PACK_HDR);
+	if (error || memcmp(h.pack->magic, "NEGRBTFW", 8) != 0 || h.pack->version != 1 || h.pack->count == 0 ||
+	    h.pack->count > PACK_MAX) {
+		SAY("12 %s header bad (read error %d); stop\n", PACK_NAME, error);
+		error = error ? error : EINVAL;
+		goto out;
+	}
+	SAY("12 %s at area byte %#llx, %u bytes, %u files\n", PACK_NAME, h.pack_at, h.pack_size, h.pack->count);
+out:
+	if (a) {
+		kmem_free(kernel_map, (vm_offset_t)a, AREA_HDR);
+	}
+	return error;
+}
+
+/* Read one file of the pack into h.fw, check its SHA-256 */
+static int
+fw_load(const char *name, uint32_t *size)
+{
+	for (uint32_t i = 0; i < h.pack->count; i++) {
+		const struct fw_entry *e = &h.pack->e[i];
+		if (strncmp(e->name, name, sizeof(e->name)) != 0) {
+			continue;
+		}
+		if (e->size == 0 || e->size > FW_CAP || e->offset < PACK_HDR || e->offset > h.pack_size ||
+		    e->size > h.pack_size - e->offset) {
+			SAY("%s size %u / offset %#x out of range\n", name, e->size, e->offset);
+			return ERANGE;
+		}
+		int error = negroni_ufs_wlan_area_read(h.pack_at + e->offset, h.fw, e->size);
+		if (error) {
+			SAY("%s read error %d\n", name, error);
+			return error;
+		}
+		uint8_t d[32];
+		SHA256_CTX c;
+		SHA256_Init(&c);
+		SHA256_Update(&c, h.fw, e->size);
+		SHA256_Final(d, &c);
+		if (memcmp(d, e->sha256, 32) != 0) {
+			SAY("%s %u bytes, sha-256 MISMATCH\n", name, e->size);
+			return EBADMSG;
+		}
+		SAY("%s %u bytes loaded, sha-256 OK\n", name, e->size);
+		*size = e->size;
+		return 0;
+	}
+	SAY("%s not in %s\n", name, PACK_NAME);
+	return ENOENT;
+}
+
+/*
+ * btqca.c:553 qca_download_firmware + :460 qca_tlv_send_segment: the whole file in 243-byte EDL_PATCH_TLV_REQ
+ * commands. skip (download mode 1 or 3): only the last (or a short) segment is acked; else every segment.
+ * Ack = Command Complete [00 1e] (soc_type >= WCN3991) or vendor event [00 04 result].
+ * Events are logged for segments 0, 1 and the last one; the rest are counted.
+ */
+static int
+tlv_download(uint32_t n, const uint8_t *data, uint32_t size, bool skip)
+{
+	uint8_t cmd[2 + TLV_SEG];
+	uint32_t seg = 0, acks = 0;
+	uint64_t t0 = negroni_bt_us();
+	int error = 0;
+
+	for (uint32_t at = 0; at < size; seg++) {
+		uint32_t len = MIN(TLV_SEG, size - at);
+		bool last = at + len == size || len < TLV_SEG;
+		bool wait = !skip || last;
+		const uint8_t *r;
+		uint32_t rl;
+
+		cmd[0] = EDL_TLV_REQ;
+		cmd[1] = (uint8_t)len;
+		memcpy(cmd + 2, data + at, len);
+		h.quiet = !(seg < 2 || last);
+		error = hci_cmd(OP_EDL, cmd, (uint8_t)(len + 2u), !h.quiet);
+		if (error) {
+			break;
+		}
+		at += len;
+		if (!wait) {
+			continue;
+		}
+		int k = wait_reply(OP_EDL, EDL_TLV_RES, &r, &rl);
+		if (k < 0) {
+			SAY("%u segment %u (byte %u of %u): no ack\n", n, seg, at, size);
+			error = -k;
+			break;
+		}
+		if (k == R_CC && rl >= 2 && r[0] == 0 && r[1] == EDL_TLV_REQ) {
+			acks++;
+		} else if (k == R_VSE && rl >= 3 && r[0] == 0 && r[1] == EDL_TLV_RES) {
+			acks++;
+			if (r[2]) {
+				SAY("%u segment %u: TLV result %#x (btqca.c logs it, goes on)\n", n, seg, r[2]);
+			}
+		} else {
+			if (h.quiet) {
+				log_event();
+			}
+			SAY("%u segment %u: ack not understood (%s, %u bytes)\n", n, seg, k == R_CC ? "CC" : "VSE", rl);
+			error = EIO;
+			break;
+		}
+	}
+	h.quiet = 0;
+	SAY("%u %u segments of <= %u bytes sent, %u acks, %llu ms, at %u baud%s\n", n, seg, TLV_SEG, acks,
+	    (negroni_bt_us() - t0) / 1000u, negroni_bt_uart_baud(), error ? " (FAILED)" : "");
+	return error;
+}
+
+static int
+step_rampatch(void)
+{
+	char name[24];
+	uint32_t size;
+
+	snprintf(name, sizeof(name), "hpbtfw%02x.tlv", h.rom);           /* btqca.c:849 (WCN6855 fallback name) */
+	int error = fw_load(name, &size);
+	if (error) {
+		return error;
+	}
+	const uint8_t *f = h.fw;
+	if (size < 28 || (f[0] & 0xffu) != 1) {                         /* tlv_type_hdr + tlv_type_patch */
+		SAY("13 %s: no TLV type 1 header\n", name);
+		return EINVAL;
+	}
+	uint8_t mode = f[14];
+	uint16_t rom_build = le16(f + 18);
+	SAY("13 %s: TLV length %u, total %u, data %u, format %u, signature %u, download mode %u, product %#06x, "
+	    "ROM build %#06x, patch %#06x\n", name, le32(f) >> 8, le32(f + 4), le32(f + 8), f[12], f[13], mode,
+	    le16(f + 16), rom_build, le16(f + 20));
+	if (rom_build != h.ver.rom) {
+		SAY("13 note: ROM build %#06x != controller ROM %#06x\n", rom_build, h.ver.rom);
+	}
+	error = tlv_download(13, f, size, mode == 1 || mode == 3);      /* QCA_SKIP_EVT_VSE / _VSE_CC */
+	negroni_bt_sleep_ms(10);                                        /* btqca.c:860 */
+	return error;
+}
+
+/* btqca.c:193 qca_read_fw_board_id: CC [00 23 xx hi lo] */
+static uint16_t
+read_bid(void)
+{
+	const uint8_t sub = EDL_BID_REQ;
+	const uint8_t *r;
+	uint32_t rl;
+
+	if (cmd_cc(OP_EDL, &sub, 1, &r, &rl)) {
+		SAY("14 board id: no answer; the default NVM follows\n");
+		return 0;
+	}
+	if (rl < 5 || r[1] != EDL_BID_REQ) {
+		SAY("14 board id: answer not understood (%u bytes); the default NVM follows\n", rl);
+		return 0;
+	}
+	return (uint16_t)(r[3] << 8 | r[4]);
+}
+
+/* btqca.c:291 qca_tlv_check_data, TLV_TYPE_NVM: bounds, tag 2 (BD address), tag 17 baud, optional IBS bits */
+static int
+nvm_patch(uint8_t *f, uint32_t size, uint8_t code)
+{
+	uint32_t off = 4;
+	if (size < 4) {
+		return EINVAL;
+	}
+	uint32_t tl = le32(f), len = tl >> 8, type = tl & 0xffu;
+	if (type == 4) {
+		if (size < 8) {
+			return EINVAL;
+		}
+		tl = le32(f + 4);
+		len = tl >> 8;
+		type = tl & 0xffu;
+		off = 8;
+	}
+	if (type != 2 || len > size - off) {
+		SAY("15 NVM: TLV type %u length %u (file %u bytes) not usable\n", type, len, size);
+		return EINVAL;
+	}
+	uint32_t tags = 0;
+	for (uint32_t i = 0; i + 12u <= len; tags++) {
+		uint8_t *t = f + off + i;
+		uint16_t id = le16(t), tlen = le16(t + 2);
+		uint8_t *d = t + 12;
+		if (len < i + 12u + tlen) {
+			return EINVAL;
+		}
+		if (id == TAG_BD_ADDR) {
+			if (tlen != 6) {
+				return EINVAL;
+			}
+			memcpy(h.nvm_bdaddr, d, 6);
+			h.nvm_bdaddr_set = true;
+		} else if (id == TAG_HCI) {
+			if (tlen < 3) {
+				return EINVAL;
+			}
+			SAY("15 NVM tag 17 (HCI transport) before:%s\n", hex(d, tlen));
+			if (h.ibs) {
+				d[0] |= 0x80u;
+			}
+			d[1] = code;                                    /* soc_type >= WCN3991: byte 1 (btqca.c:429) */
+			SAY("15 NVM tag 17 after: byte 0 %#x, baud byte %#x\n", d[0], d[1]);
+		} else if (id == TAG_DEEP_SLEEP && h.ibs) {
+			if (tlen < 1) {
+				return EINVAL;
+			}
+			d[0] |= 0x01u;
+		}
+		i += 12u + tlen;
+	}
+	SAY("15 NVM: %u tags, BD address tag %s\n", tags, h.nvm_bdaddr_set ? "present" : "absent");
+	return 0;
+}
+
+static int
+step_nvm(void)
+{
+	char name[32];
+	uint32_t size;
+	uint16_t bid = read_bid();
+	const char *v = h.gf ? "g" : "";
+	int error;
+
+	if (bid == 0 || bid == 0xffffu) {                                /* btqca.c:715 qca_get_nvm_name_by_board */
+		snprintf(name, sizeof(name), "hpnv%02x%s.bin", h.rom, v);
+	} else {
+		snprintf(name, sizeof(name), "hpnv%02x%s.b%02x", h.rom, v, bid);
+	}
+	SAY("14 board id %#x -> %s\n", bid, name);
+	STEP(15, "NVM download");
+	error = fw_load(name, &size);
+	if (error == ENOENT && bid != 0 && bid != 0xffffu) {             /* btqca.c:570 qca_get_alt_nvm_file */
+		snprintf(name, sizeof(name), "hpnv%02x%s.bin", h.rom, v);
+		error = fw_load(name, &size);
+	}
+	if (error) {
+		return error;
+	}
+	int code = baud_code(negroni_bt_uart_baud());
+	error = nvm_patch(h.fw, size, (uint8_t)(code < 0 ? 0 : code));
+	if (error) {
+		SAY("15 %s: NVM TLV check failed (%d)\n", name, error);
+		return error;
+	}
+	return tlv_download(15, h.fw, size, false);
+}
+
+static void
+step_build_info(void)
+{
+	const uint8_t sub = EDL_BUILD_INFO;
+	const uint8_t *r;
+	uint32_t rl;
+	char label[80];
+
+	if (cmd_cc(OP_EDL, &sub, 1, &r, &rl) || rl < 3 || r[1] != EDL_BUILD_INFO) {
+		SAY("18 build info: no answer (btqca.c:91; not needed for the next steps)\n");
+		return;
+	}
+	uint32_t n = MIN((uint32_t)r[2], rl - 3u);
+	n = MIN(n, (uint32_t)sizeof(label) - 1u);
+	for (uint32_t i = 0; i < n; i++) {
+		label[i] = (r[3 + i] >= 0x20 && r[3 + i] < 0x7f) ? (char)r[3 + i] : '.';
+	}
+	label[n] = 0;
+	SAY("18 firmware build label \"%s\"\n", label);
+}
+
+static int
+step_bdaddr(void)
+{
+	const uint8_t *r;
+	uint32_t rl;
+	int error = cmd_cc(OP_READ_BD_ADDR, NULL, 0, &r, &rl);
+	if (error) {
+		return error;
+	}
+	if (rl != 7) {                                                  /* status + bdaddr (btqca.c:700) */
+		SAY("19 Read_BD_ADDR: %u return bytes, expected 7\n", rl);
+		return EIO;
+	}
+	const uint8_t *a = r + 1;                                       /* little endian on the wire */
+	bool dflt = h.nvm_bdaddr_set && memcmp(a, h.nvm_bdaddr, 6) == 0;
+	SAY("19 BD address %02x:%02x:%02x:%02x:%02x:%02x (%s)\n", a[5], a[4], a[3], a[2], a[1], a[0],
+	    dflt ? "= the NVM default: no unique address; the host must set one (0xfc14, btqca.c:1005)" :
+	    "not the NVM default");
+	return 0;
+}
+
+int
 negroni_bt_hci_run(uint32_t mode)
 {
-	printf("NEGRONI BT: negronibt=%u: the HCI stage is not in this kernel (patch 0331)\n", mode);
+	uint32_t baud = negroni_bt_arg("baud", 3000000);
+	int error;
+
+	memset(&h, 0, sizeof(h));
+	h.to_ms = negroni_bt_arg("to", 2000);
+	h.to_ms = MAX(MIN(h.to_ms, 30000u), 50u);
+	h.ibs = negroni_bt_arg("ibs", 0);
+	SAY("HCI stage (patch 0331): negronibt=%u, wait %u ms, baud %u, IBS bits %s\n", mode, h.to_ms, baud,
+	    h.ibs ? "set" : "as in the file");
+
+	STEP(9, "HCI_RESET (ROM)");
+	if (step_reset(9)) {
+		SAY("9 no Command Complete for HCI_RESET; the version request decides\n");
+	}
+	STEP(10, "EDL version request (0xfc00 0x19)");
+	if ((error = read_version(10))) {
+		SAY("stop: step 10 version request failed (%d)\n", error);
+		goto out;
+	}
+	STEP(11, "baud change (0xfc48)");
+	if (baud != 115200 && (error = step_baud(baud))) {
+		SAY("stop: step 11 baud change to %u failed (%d)\n", baud, error);
+		goto out;
+	}
+	if (mode < 3) {
+		SAY("HCI stage done at step 11 (negronibt=2)\n");
+		goto out;
+	}
+	STEP(12, "firmware pack in the WLAN area");
+	if ((error = step_area())) {
+		goto out;
+	}
+	STEP(13, "rampatch download");
+	if ((error = step_rampatch())) {
+		SAY("stop: step 13 rampatch failed (%d)\n", error);
+		goto out;
+	}
+	STEP(14, "board id (0xfc00 0x23)");
+	if ((error = step_nvm())) {
+		SAY("stop: step 15 NVM failed (%d)\n", error);
+		goto out;
+	}
+	STEP(16, "SoC logging off (0xfc17)");
+	{
+		const uint8_t par[2] = { 0x14, 0x00 };                  /* QCA_DISABLE_LOGGING_SUB_OP */
+		const uint8_t *r;
+		uint32_t rl;
+		if (cmd_cc(OP_LOGGING, par, 2, &r, &rl)) {
+			SAY("16 no Command Complete (btqca.c:949 stops here; this stage goes on)\n");
+		}
+	}
+	STEP(17, "HCI_RESET (patched firmware)");
+	if ((error = step_reset(17))) {
+		SAY("stop: step 17 HCI_RESET after the download failed (%d)\n", error);
+		goto out;
+	}
+	STEP(18, "firmware build info (0xfc00 0x20)");
+	step_build_info();
+	STEP(19, "HCI_Read_BD_ADDR (0x1009)");
+	if ((error = step_bdaddr())) {
+		SAY("stop: step 19 failed (%d)\n", error);
+		goto out;
+	}
+	SAY("HCI stage done: firmware ROM %02x%s loaded, %u baud\n", h.rom, h.gf ? " GF" : "", negroni_bt_uart_baud());
+out:
+	if (h.fw) {
+		kmem_free(kernel_map, (vm_offset_t)h.fw, FW_CAP);
+	}
+	if (h.pack) {
+		kmem_free(kernel_map, (vm_offset_t)h.pack, PACK_HDR);
+	}
+	h.fw = NULL;
+	h.pack = NULL;
+	SAY("HCI stage end: %s (error %d, %u non-H4 bytes dropped)\n", error ? "FAILED" : "ok", error, h.garbage);
+	return error;
 }
