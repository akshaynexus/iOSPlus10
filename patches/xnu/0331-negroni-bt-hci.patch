+/* Next H4 packet from the UART into h.type / h.pkt, or ETIMEDOUT at `deadline` (us). */
+static int
+h4_next(uint64_t deadline)
+{
+	for (;;) {
+		while (h.rxn > 0) {
+			uint8_t t = h.rx[0];
+			uint32_t need;
+
+			if (t == IBS_WAKE_IND || t == IBS_SLEEP_IND || t == IBS_WAKE_ACK) {
+				SAY("IBS byte %#x from the controller%s\n", t, t == IBS_WAKE_IND ? " (WAKE_ACK sent)" : "");
+				if (t == IBS_WAKE_IND) {
+					uint8_t ack = IBS_WAKE_ACK;
+					(void)negroni_bt_uart_write(&ack, 1);
+				}
+				consume(1);
+				continue;
+			}
+			if (t == H4_EVT) {
+				if (h.rxn < 3) {
+					break;
+				}
+				need = 3u + h.rx[2];
+			} else if (t == H4_ACL) {
+				if (h.rxn < 5) {
+					break;
+				}
+				need = 5u + le16(h.rx + 3);
+			} else if (t == H4_SCO) {
+				if (h.rxn < 4) {
+					break;
+				}
+				need = 4u + h.rx[3];
+			} else {
+				if (h.garbage++ < 16) {
+					SAY("H4: byte %#x is no packet type, dropped\n", t);
+				}
+				consume(1);
+				continue;
+			}
+			if (need > RX_BUF) {
+				SAY("H4: type %#x length %u larger than %u, byte dropped\n", t, need, RX_BUF);
+				consume(1);
+				continue;
+			}
+			if (h.rxn < need) {
+				break;
+			}
+			h.type = t;
+			h.pktn = need - 1u;
+			memcpy(h.pkt, h.rx + 1, h.pktn);
+			consume(need);
+			return 0;
+		}
+		uint32_t got = negroni_bt_uart_read(h.rx + h.rxn, RX_BUF - h.rxn);
+		h.rxn += got;
+		if (negroni_bt_us() > deadline) {     /* every pass: a stream with no gap must not extend the wait */
+			return ETIMEDOUT;
+		}
+		if (got == 0) {
+			delay(20);
+		}
+	}
+}
