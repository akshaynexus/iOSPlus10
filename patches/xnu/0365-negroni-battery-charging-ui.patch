+/*
+ * 0365: iOS's name for the charger (IOPSKeysPrivate.h kIOPSFamilyCode*) from the PD's USB_ADAP_TYPE
+ * (Linux POWER_SUPPLY_USB_TYPE_*). The table of HakiOS hakios.battery.cpp family_code() (APSL 2.0);
+ * QTI HVDCP (0x80..0x82, oplus_battery_sm8450.h:302) and BrickID as a dedicated charger.
+ */
+static unsigned
+nb_family_code(int32_t usbType)
+{
+	switch (usbType) {
+	case 1: return 0xe0004000u;     /* SDP, a computer's port: kIOPSFamilyCodeUSBHost */
+	case 2: case 9: case 0x80: case 0x81: case 0x82:
+		return 0xe0004004u;     /* DCP (and BrickID, HVDCP): kIOPSFamilyCodeUSBChargingPortDedicated */
+	case 3: return 0xe0004005u;     /* CDP: kIOPSFamilyCodeUSBChargingPortDownstream */
+	case 5: return 0xe0004009u;     /* USB-C current: kIOPSFamilyCodeUSBCTypeC */
+	case 6: case 7: case 8: return 0xe000400au;     /* USB PD: kIOPSFamilyCodeUSBCPD */
+	default: return 0xe0004007u;    /* kIOPSFamilyCodeUSBUnknown */
+	}
+}
+
+/*
+ * 0365: IsCharging / FullyCharged, the adapter and the times (the comment at NB_IIN_MA). glinkBstatus is
+ * the fresh PD BATT_STATUS (1..4) or -1. instMa: InstantAmperage (+ = charging), in/out.
+ */
+void
+NegroniBattery::chargeState(const nb_sample &s, bool external, bool curKnown, int32_t cur, unsigned percent,
+    int32_t glinkBstatus, bool &charging, bool &full, int &instMa)
+{
+	(void)cur;                      /* instMa already holds it */
+	fAdMv = s.usbOk ? s.usbMv : 0;
+	fAdMa = s.iinOk && s.iinMa > 0 ? (unsigned)s.iinMa : 0;
+	fAdFamily = 0xe0004007u;
+	fAdSrc = "vadc";
+	fAvgMa = curKnown ? fCurAvg : INT32_MIN;
+	uint64_t nowAbs, nowNs;
+	clock_get_uptime(&nowAbs);
+	absolutetime_to_nanoseconds(nowAbs, &nowNs);
+	if (external != fCsExternal) {
+		fCsExternal = external;
+		fPlugNs = nowNs;        /* review C2: the PD status must be newer than this edge */
+	}
+	bool pd = glinkBstatus >= 1 && glinkBstatus <= 4;
+	bool pdStale = false;
+#if NB_HAVE_GLINK
+	negroni_chg_glink_status g;
+	if (pd && negroni_chg_glink_get(&g) && g.up && g.ready && g.soc_ns <= fPlugNs) {
+		pd = false;             /* read before the plug edge: the VADC rule until the next PD cycle */
+		pdStale = true;
+	}
+	if (pd && negroni_chg_glink_get(&g) && g.up && g.ready) {
+		if (g.usb_mv > 0) {
+			fAdMv = (unsigned)g.usb_mv;
+		}
+		if (g.usb_ma != INT32_MIN && g.usb_ma > 0) {
+			fAdMa = (unsigned)g.usb_ma;
+		}
+		fAdFamily = nb_family_code(g.usb_type);
+		fAdSrc = "pd";
+		if (g.ibat_ma != INT32_MIN && g.ibat_ma != 0) {
+			/*
+			 * Learn the PD's sign (review C1: "charging" can come with a net discharge under a load above the
+			 * input, so BATT_STATUS 1 does not name it). A vote: status 2 on battery (the current leaves the
+			 * pack), or the AP's own filtered current (BCL, + = charging) when both are above 50 mA; the sign
+			 * is taken after NB_PD_VOTES agreeing polls in a row.
+			 */
+			int vote = 0;
+			const bool big = g.ibat_ma > NB_CUR_MA || g.ibat_ma < -NB_CUR_MA;
+			if (big && glinkBstatus == 2 && !external) {
+				vote = g.ibat_ma > 0 ? -1 : 1;
+			} else if (big && curKnown && (fCurAvg > NB_CUR_MA || fCurAvg < -NB_CUR_MA)) {
+				vote = (g.ibat_ma > 0) == (fCurAvg > 0) ? 1 : -1;
+			}
+			if (fPdSign == 0 && vote != 0) {
+				fPdVotes = vote == fPdVote ? fPdVotes + 1 : 1;
+				fPdVote = vote;
+				if (fPdVotes >= NB_PD_VOTES) {
+					fPdSign = vote;
+					IOLog("NEGRONI BATTERY: charge: the charger PD's BATT_CURR_NOW is %s while charging (%u polls agree; "
+					    "last: status %d, PD %d mA, AP avg %d mA)\n", fPdSign > 0 ? "positive" : "negative", fPdVotes,
+					    glinkBstatus, g.ibat_ma, curKnown ? fCurAvg : 0);
+				}
+			}
+			if (fPdSign != 0) {
+				instMa = g.ibat_ma * fPdSign;
+			}
+		}
+	}
+#endif
+	if (pd) {
+		full = glinkBstatus == 4 || (fSoc >= 10000 && glinkBstatus != 1);
+		charging = external && glinkBstatus == 1 && !full;
+		snprintf(fWhy, sizeof(fWhy), "pd status %d", glinkBstatus);
+	} else {
+		full = external && fSoc >= 10000 && (!curKnown || fCurAvg < NB_FULL_MA);
+		/* review C5: at >= 99 % with the input on and the net current near zero the charge has tapered: full,
+		 * so the OCV estimate cannot show "charging" for ever; a clear discharge (a load) is not a taper */
+		if (external && !full && fSoc >= 9900 &&
+		    (!curKnown || (fCurAvg > -NB_CUR_MA && fCurAvg < NB_TAPER_MA))) {
+			full = true;
+		}
+		if (!external) {
+			charging = false;
+			snprintf(fWhy, sizeof(fWhy), "no VBUS");
+		} else if (full) {
+			charging = false;
+			snprintf(fWhy, sizeof(fWhy), "full");
+		} else if (s.iinOk) {
+			charging = s.iinMa >= NB_IIN_MA || (curKnown && fCurAvg > NB_CUR_MA);
+			snprintf(fWhy, sizeof(fWhy), "%siin %d mA avg %d mA", pdStale ? "pd stale, " : "", s.iinMa,
+			    curKnown ? fCurAvg : 0);
+		} else if (curKnown) {
+			charging = fCurAvg > -NB_CUR_MA;
+			snprintf(fWhy, sizeof(fWhy), "avg %d mA (no iin)", fCurAvg);
+		} else {
+			charging = percent < 100;
+			snprintf(fWhy, sizeof(fWhy), "no current reading");
+		}
+	}
+	/* times: linear in the filtered current [I] */
+	const int32_t avg = curKnown ? fCurAvg : 0;
+	const uint32_t haveMah = (uint32_t)((uint64_t)NB_DESIGN_MAH * (uint32_t)(fSoc < 0 ? 0 : fSoc) / 10000u);
+	const uint32_t missMah = NB_DESIGN_MAH > haveMah ? NB_DESIGN_MAH - haveMah : 0;
+	fTtf = fTte = 0xffff;
+	if (charging && avg > NB_CUR_MA) {
+		uint64_t m = (uint64_t)missMah * 60u / (uint32_t)avg;
+		fTtf = m < 1 ? 1 : m > 0xfffe ? 0xfffe : (unsigned)m;
+	}
+	if (!external && avg < -NB_CUR_MA) {
+		uint64_t m = (uint64_t)haveMah * 60u / (uint32_t)(-avg);
+		fTte = m < 1 ? 1 : m > 0xfffe ? 0xfffe : (unsigned)m;
+	}
+	const uint64_t mw = (uint64_t)fAdMv * fAdMa / 1000u;
+	putNumber("NegroniChargeInputMilliwatts", external ? (UInt32)mw : 0);
+	putNumber("NegroniChargeFamilyCode", external ? fAdFamily : 0);
+	putString("NegroniChargeSource", pd ? "pd" : "vadc");
+	putString("NegroniChargeReason", fWhy);
+	/* one line on a change, else every NB_PLOG_POLLS full reads while plugged */
+	int key = (external ? 1 : 0) | (charging ? 2 : 0) | (full ? 4 : 0) | (pd ? 8 : 0);
+	fChgLogPolls++;
+	if (key != fChgLogKey || (external && fChgLogPolls >= NB_PLOG_POLLS)) {
+		fChgLogKey = key;
+		fChgLogPolls = 0;
+		IOLog("NEGRONI BATTERY: charge: %u%% external=%d charging=%d full=%d (%s) | adapter %umV %umA %u.%02uW family 0x%x (%s) | "
+		    "battery inst %dmA avg %s%dmA | to full %u min to empty %u min\n",
+		    percent, external, charging, full, fWhy, external ? fAdMv : 0, external ? fAdMa : 0,
+		    external ? (unsigned)(mw / 1000) : 0, external ? (unsigned)(mw % 1000 / 10) : 0,
+		    external ? fAdFamily : 0, fAdSrc, instMa, curKnown ? "" : "?", avg, fTtf, fTte);
+	}
+}
