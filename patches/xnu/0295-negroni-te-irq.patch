 #include <stdint.h>
+#include <stdbool.h>
 #include <libkern/section_keywords.h>
 #include <arm64/proc_reg.h>
 #include <kern/clock.h>
@@ -52,6 +53,86 @@ _gic_write32(vm_offset_t addr, uint32_t value)
