+#if defined(NEGRONI)
+/*
+ * 0295: shared peripheral interrupts for negroni drivers. This port has no IOKit interrupt
+ * controller for the GIC (sleh_irq takes the timer and the IPI itself), so a driver registers
+ * a handler for its SPI here and sleh_irq calls it in interrupt context before the EOI. The
+ * handler must clear its device's level before it returns. GICv3 distributor (Arm IHI 0069):
+ * IGROUPR 0x080 (Group 1 NS; RAZ/WI from the non-secure side when the secure side owns the
+ * grouping, as GICR_IGROUPR0 above), ISENABLER 0x100, ICENABLER 0x180, ICPENDR 0x280,
+ * IPRIORITYR 0x400 (byte per INTID), ICFGR 0xc00 (2 bits per INTID, 0b10 edge),
+ * IROUTER 0x6000 (64 bits per INTID, affinity, mode 0 = this PE).
+ */
+#define NEGRONI_SPI_SLOTS       4
+typedef void (*negroni_spi_handler_t)(void *arg, uint32_t intid);
+static struct {
+	uint32_t                intid;
+	negroni_spi_handler_t   fn;
+	void                    *arg;
+} negroni_spi[NEGRONI_SPI_SLOTS];
+static uint32_t negroni_spi_used;
+
+int negroni_spi_register(uint32_t intid, bool edge, negroni_spi_handler_t fn, void *arg);
+void negroni_spi_enable(uint32_t intid, bool on);
+bool negroni_spi_dispatch(uint32_t intid);
+
+void
+negroni_spi_enable(uint32_t intid, bool on)
+{
+	if (gicd_base == 0 || intid < 32 || intid >= 1020) {
+		return;
+	}
+	gicd_write32((on ? 0x100 : 0x180) + 4 * (intid / 32), 1u << (intid % 32));
+	__builtin_arm_dsb(0xf);
+}
+
+/* Thread context. 0 = registered and enabled, routed to the calling CPU. */
+int
+negroni_spi_register(uint32_t intid, bool edge, negroni_spi_handler_t fn, void *arg)
+{
+	if (gicd_base == 0 || intid < 32 || intid >= 1020 || fn == NULL || negroni_spi_used >= NEGRONI_SPI_SLOTS) {
+		return -1;
+	}
+	uint32_t n = intid / 32, bit = 1u << (intid % 32);
+	gicd_write32(0x180 + 4 * n, bit);
+	gicd_write32(0x080 + 4 * n, gicd_read32(0x080 + 4 * n) | bit);
+	*(volatile uint8_t *)(gicd_base + 0x400 + intid) = 0xa0;
+	uint32_t c = gicd_read32(0xc00 + 4 * (intid / 16)), sh = 2 * (intid % 16);
+	c = (c & ~(3u << sh)) | (edge ? 2u << sh : 0u);
+	gicd_write32(0xc00 + 4 * (intid / 16), c);
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	*(volatile uint64_t *)(gicd_base + 0x6000 + 8 * (vm_offset_t)intid) = (mpidr & 0xffffffull) | ((mpidr >> 32) & 0xffull) << 32;
+	gicd_write32(0x280 + 4 * n, bit);
+	uint32_t slot = negroni_spi_used;
+	negroni_spi[slot].intid = intid;
+	negroni_spi[slot].arg = arg;
+	__atomic_store_n(&negroni_spi[slot].fn, fn, __ATOMIC_RELEASE);
+	__atomic_store_n(&negroni_spi_used, slot + 1, __ATOMIC_RELEASE);
