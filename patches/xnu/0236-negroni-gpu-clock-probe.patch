+/*
+ * GPU clock probe (patch 0236): what the GX clock really runs at. Boot-args, all default 1:
+ * negronigpu_clkdump (gpucc PLL0/PLL1/GX-area dumps, cmd-db levels, GMU log head at the end of
+ * step 17, after the OOB GPU_SET ack and after a revote), negronigpu_gxclk (CP perf counter 0 counts
+ * every CP clock: "gxclk N MHz" in steps 18/20 and the watch line), negronigpu_timetest (step 22 times
+ * its blit on the GPU). negronigpu_revote (default 1 with negronigpu_level>0, else 0): the
+ * GX_BW_PERF_VOTE again after the OOB GPU_SET ack. Registers (mesa a6xx.xml): CP_PERFCTR_CP_SEL[0]
+ * 0x08d0, RBBM_PERFCTR_CP[0] 0x0300 (A7XX-; A6XX has 0x0400), RBBM_PERFCTR_CNTL 0x0500,
+ * CP_ALWAYS_ON_COUNTER 0x0980 (reg64), PERF_CP_ALWAYS_COUNT 0; GMU_ALWAYS_ON_COUNTER_L/H
+ * (a6xx_gmu.xml 0x5088/0x5089). Linux a6xx_hw_init selects CP0 = PERF_CP_ALWAYS_COUNT the same way.
+ * PLL layout (Linux gpucc-sm8450.c, Lucid EVO): PLL0 at +0x0, PLL1 at +0x1000, +0 MODE, +4 L, +8 ALPHA.
+ */
+#define GPUCC_PLL0              0x0000
+#define GPUCC_PLL1              0x1000
+#define GPUCC_GX_AREA           0x9000
+#define GMU_AO_COUNTER_H        0x1f889
+#define CLK_CP_PERFCTR_CP_SEL_0 0x08d0          /* dword, GPU space */
+#define CLK_RBBM_PERFCTR_CP_0   0x0300          /* A7XX-; lo, hi */
+#define CLK_RBBM_PERFCTR_CNTL   0x0500
+#define CLK_CP_ALWAYS_ON        0x0980          /* lo, hi; 19.2 MHz */
+#define CLK_PERF_CP_ALWAYS_COUNT 0
+#define CLK_AT                  0x300           /* in the scratch page: step 22's AO/cycle samples */
+
+static uint32_t clk_dump = 1, clk_probe = 1, clk_timetest = 1;
+static uint32_t vote_level = 1, vote_bw = 3, vote_arg;
+static uint64_t
+rd64(vm_offset_t lo)
+{
+	uint32_t hi = rd(lo + 4), l = rd(lo), hi2 = rd(lo + 4);
+
+	if (hi2 != hi) {
+		l = rd(lo);
+	}
+	return (uint64_t)hi2 << 32 | l;
+}
+
+static uint64_t
+ao_now(void)
+{
+	return rd64(gmu + GMU_REG(GMU_AO_COUNTER_L));
+}
+
+static uint64_t
+gx_cycles(void)
+{
+	return rd64(gpu_regs + 4 * (vm_offset_t)CLK_RBBM_PERFCTR_CP_0);
+}
+
+/* cycles of the CP clock over ticks of the 19.2 MHz always-on counter */
+static uint32_t
+clk_mhz(uint64_t cycles, uint64_t ticks)
+{
+	return ticks ? (uint32_t)(cycles * 192 / (ticks * 10)) : 0;
+}
+
+static void
+gpucc_dump(uint32_t from, uint32_t to)
+{
+	for (uint32_t off = from; off < to; off += 32) {
+		uint32_t v[8];
+		for (uint32_t i = 0; i < 8; i++) {
+			v[i] = rd(gpucc + off + 4 * i);
+		}
+		printf("NEGRONI ADRENO: gpucc[%#x] = %08x %08x %08x %08x %08x %08x %08x %08x\n", off,
+		    v[0], v[1], v[2], v[3], v[4], v[5], v[6], v[7]);
+	}
+}
+
+static void
+clock_dump(const char *when)
+{
+	if (!clk_dump) {
+		return;
+	}
+	printf("NEGRONI ADRENO: %u clock dump %s: GX GDSC %#x, PLL0 mode %#x L %#x alpha %#x, PLL1 mode %#x L %#x alpha %#x\n",
+	    step, when, rd(gpucc + GPUCC_GX_GDSCR), rd(gpucc + GPUCC_PLL0), rd(gpucc + GPUCC_PLL0 + 4),
+	    rd(gpucc + GPUCC_PLL0 + 8), rd(gpucc + GPUCC_PLL1), rd(gpucc + GPUCC_PLL1 + 4), rd(gpucc + GPUCC_PLL1 + 8));
+	gpucc_dump(GPUCC_PLL0, GPUCC_PLL0 + 0x40);
+	gpucc_dump(GPUCC_PLL1, GPUCC_PLL1 + 0x40);
+	gpucc_dump(GPUCC_GX_AREA, GPUCC_GX_AREA + 0x100);
+	to_memory(gmu_log.memory, 64);
+	const volatile uint32_t *l = (const volatile uint32_t *)gmu_log.memory;
+	printf("NEGRONI ADRENO: %u GMU log head: %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x "
+	    "%08x %08x\n", step, l[0], l[1], l[2], l[3], l[4], l[5], l[6], l[7], l[8], l[9], l[10], l[11], l[12], l[13],
+	    l[14], l[15]);
+}
+
+/* Only while GX has power: CP perf counter 0 counts every CP clock (needs RBBM_PERFCTR_CNTL 1). */
+static void
+clock_probe_start(void)
+{
+	if (!clk_probe || !(rd(gpucc + GPUCC_GX_GDSCR) & GDSC_PWR_ON)) {
+		return;
+	}
+	wr(gpu_regs + 4 * (vm_offset_t)CLK_CP_PERFCTR_CP_SEL_0, CLK_PERF_CP_ALWAYS_COUNT);
+	wr(gpu_regs + 4 * (vm_offset_t)CLK_RBBM_PERFCTR_CNTL, 1);
+}
+
+static void
+clock_measure(const char *when)
+{
+	if (!clk_probe || !(rd(gpucc + GPUCC_GX_GDSCR) & GDSC_PWR_ON)) {
+		return;
+	}
+	uint64_t c0 = gx_cycles(), a0 = ao_now();
+	delay(10000);
+	uint64_t c1 = gx_cycles(), a1 = ao_now();
+	printf("NEGRONI ADRENO: %u gxclk %u MHz %s (CP cycles +%llu in AO ticks +%llu, SEL0 %#x, PERFCTR_CNTL %#x)\n", step,
+	    clk_mhz(c1 - c0, a1 - a0), when, c1 - c0, a1 - a0, rd(gpu_regs + 4 * (vm_offset_t)CLK_CP_PERFCTR_CP_SEL_0),
+	    rd(gpu_regs + 4 * (vm_offset_t)CLK_RBBM_PERFCTR_CNTL));
 }
 
+/* the raw aux length of a cmd-db entry (cmd_db_find with a 0-byte buffer) */
+static uint32_t
+cmd_db_raw(const char *name)
+{
+	uint8_t none;
+	uint32_t a, n = 0;
+
+	return cmd_db_find(name, &a, &none, &n) ? cmd_db_raw_len : 0;
+}
+
+static void
+print_levels(const char *name, const uint16_t *v, uint32_t n)
+{
+	char line[256];
+	int at = 0;
+
+	for (uint32_t i = 0; i < n && at < (int)sizeof(line) - 8; i++) {
+		at += snprintf(line + at, sizeof(line) - at, " %u", v[i]);
+	}
+	line[at] = 0;
+	printf("NEGRONI ADRENO: 17 cmd-db %s raw %u bytes, %u levels:%s\n", name, cmd_db_raw(name), n, line);
+}
