+/* ---- the scalar ABI (ios-sailfish SweetGPU 10-16) ---- */
+
+/* fLock held. Struct in: scalar_submit, scalar_ib[nr_ibs], uint32_t handles[nr_bos]. */
+IOReturn
+RedwoodGPUUserClient::scalarSubmit(IOExternalMethodArguments * args)
+{
+	const uint8_t * in = (const uint8_t *) args->structureInput;
+	size_t length = args->structureInputSize;
+	void * copy = NULL;
+	struct scalar_submit h = { 0, 0 };
+	uint64_t * addresses = NULL;
+	uint32_t * words = NULL, * handles = NULL, fence = 0;
+	IOReturn ret = kIOReturnBadArgument;
+
+	if (args->scalarOutputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	if (args->structureInputDescriptor != NULL) {
+		IOMemoryDescriptor * d = args->structureInputDescriptor;
+		length = (size_t) d->getLength();
+		copy = length <= GPU_SUBMIT_BYTES ? IOMallocData(length) : NULL;
+		if (copy == NULL) {
+			return kIOReturnNoMemory;
+		}
+		if (d->prepare() != kIOReturnSuccess) {
+			IOFreeData(copy, length);
+			return kIOReturnVMError;
+		}
+		bool read = d->readBytes(0, copy, length) == length;
+		d->complete();
+		if (!read) {
+			IOFreeData(copy, length);
+			return kIOReturnVMError;
+		}
+		in = (const uint8_t *) copy;
+	}
+	if (in == NULL || length < sizeof(h)) {
+		goto out;
+	}
+	memcpy(&h, in, sizeof(h));
+	if (h.nr_ibs == 0 || h.nr_ibs > GPU_SUBMIT_CMDS || h.nr_bos > GPU_SUBMIT_BOS ||
+	    length != sizeof(h) + (size_t) h.nr_ibs * sizeof(struct scalar_ib) + (size_t) h.nr_bos * sizeof(uint32_t)) {
+		h.nr_ibs = h.nr_bos = 0;
+		goto out;
+	}
+	addresses = IONew(uint64_t, h.nr_ibs);
+	words = IONew(uint32_t, h.nr_ibs);
+	handles = h.nr_bos ? IONew(uint32_t, h.nr_bos) : NULL;
+	if (addresses == NULL || words == NULL || (h.nr_bos != 0 && handles == NULL)) {
+		ret = kIOReturnNoMemory;
+		goto out;
+	}
+	for (uint32_t i = 0; i < h.nr_ibs; i++) {
+		struct scalar_ib ib;
+		memcpy(&ib, in + sizeof(h) + i * sizeof(ib), sizeof(ib));
+		addresses[i] = ib.iova;
+		words[i] = ib.dwords;
+	}
+	if (h.nr_bos != 0) {
+		memcpy(handles, in + sizeof(h) + (size_t) h.nr_ibs * sizeof(struct scalar_ib), h.nr_bos * sizeof(uint32_t));
+	}
+	ret = submitIBs(addresses, words, h.nr_ibs, handles, h.nr_bos, &fence);
+	args->scalarOutput[0] = fence;
+	args->scalarOutputCount = 1;
+out:
+	if (addresses != NULL) {
+		IODelete(addresses, uint64_t, h.nr_ibs);
+	}
+	if (words != NULL) {
+		IODelete(words, uint32_t, h.nr_ibs);
+	}
+	if (handles != NULL) {
+		IODelete(handles, uint32_t, h.nr_bos);
+	}
+	if (copy != NULL) {
+		IOFreeData(copy, length);
+	}
+	return ret;
+}
+
+IOReturn
+RedwoodGPUUserClient::scalarMethod(uint32_t selector, IOExternalMethodArguments * args)
+{
+	IOReturn ret = kIOReturnBadArgument;
+	uint32_t handle = 0;
+
+	if (selector == kScalarWait) {          /* without fLock: other threads submit meanwhile */
+		if (args->scalarInputCount != 2 || args->scalarInput[0] > 0xffffffffull) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gGPULock);
+		ret = gpuWait((uint32_t) args->scalarInput[0], MIN(args->scalarInput[1], (uint64_t) GPU_WAIT_MAX_MS));
+		IOLockUnlock(gGPULock);
+		return ret;
+	}
+	if (selector == kScalarInfo) {
+		if (args->scalarOutputCount < 5) {
+			return kIOReturnBadArgument;
+		}
+		negroni_gpu_parameter(MSM_PARAM_CHIP_ID, &args->scalarOutput[0]);
+		negroni_gpu_parameter(MSM_PARAM_GMEM_SIZE, &args->scalarOutput[1]);
+		negroni_gpu_parameter(MSM_PARAM_GMEM_BASE, &args->scalarOutput[2]);
+		negroni_gpu_parameter(MSM_PARAM_MAX_FREQ, &args->scalarOutput[3]);
+		args->scalarOutput[4] = 0;      /* no fence page in the caller: poll with 14 */
+		args->scalarOutputCount = 5;
+		return kIOReturnSuccess;
+	}
+	IOLockLock(fLock);
+	if (fClosed) {
+		IOLockUnlock(fLock);
+		return kIOReturnNotOpen;
+	}
+	switch (selector) {
+	case kScalarBoNew:
+		if (args->scalarInputCount >= 1 && args->scalarOutputCount >= 3) {
+			ret = makeBuffer(args->scalarInput[0], MSM_BO_CACHED, true, &handle);
+			if (ret == kIOReturnSuccess) {
+				struct gpu_buffer * b = buffer(handle);
+				args->scalarOutput[0] = handle;
+				args->scalarOutput[1] = b->address;
+				args->scalarOutput[2] = b->umap->getAddress();
+				args->scalarOutputCount = 3;
+			}
+		}
+		break;
+	case kScalarBoFree:
+		if (args->scalarInputCount == 1) {
+			struct gpu_buffer * b = args->scalarInput[0] <= 0xffffffffull ? buffer((uint32_t) args->scalarInput[0]) : NULL;
+			ret = b != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+			if (b != NULL) {
+				freeBuffer(b);
+			}
+		}
+		break;
+	case kScalarBoImport:
+		if (args->scalarInputCount == 1 && args->scalarOutputCount >= 3) {
+			ret = importSurface((uint32_t) args->scalarInput[0], &handle);
+			if (ret == kIOReturnSuccess) {
+				struct gpu_buffer * b = buffer(handle);
+				args->scalarOutput[0] = handle;
+				args->scalarOutput[1] = b->address;
+				args->scalarOutput[2] = b->size;
+				args->scalarOutputCount = 3;
+			}
+		}
+		break;
+	case kScalarSubmit:
+		ret = scalarSubmit(args);
+		break;
+	case kScalarBoCpuPrep:
+		if (args->scalarInputCount == 1 && args->scalarInput[0] <= 0xffffffffull) {
+			ret = cpuPrep((uint32_t) args->scalarInput[0], 0);
+		}
+		break;
+	default:
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	IOLockUnlock(fLock);
+	return ret;
+}
+
+IOReturn
+RedwoodGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	if (fCalls < 64) {
+		fCalls++;
+		IOLog("RedwoodGPU: %s request %#x, %u bytes in, %u out, scalars %u\n", fName, selector,
+		    args->structureInputSize, args->structureOutputSize, args->scalarInputCount);
+	}
+	if (!negroni_gpu_ready()) {
+		return kIOReturnNotReady;
+	}
+	if (selector >= kScalarBoNew && selector <= kScalarBoCpuPrep) {
+		return scalarMethod(selector, args);
+	}
+	return msmMethod(selector, args);
+}
