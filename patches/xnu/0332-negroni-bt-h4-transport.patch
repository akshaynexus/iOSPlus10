+/*
+ * Step 20 (negronibt=4, patch 0332): give the controller the address bluetoothd uses. bluetoothd 20H392 reads
+ * local-mac-address of the registry entry "bluetooth" (main 0x1000269b4 -> 0x100027920) and discards the
+ * BT_DEVICE_ADDRESS env value (0x1000268f4/0x1000268f8 store zero after the sscanf). The ADT bytes are in display
+ * order (02:00:5e:...), which is the order 0xfc14 wants (btqca.c:1011 swaps the little-endian bdaddr_t).
+ * A failure is logged only: the controller then keeps the NVM default and bluetoothd still runs.
+ */
+static void
+step_set_bdaddr(void)
+{
+	DTEntry node;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	const uint8_t *r;
+	uint32_t rl;
+	uint8_t now[6];
+
+	if (SecureDTLookupEntry(NULL, "/arm-io/bluetooth", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "local-mac-address", &prop, &size) != kSuccess || size < 6) {
+		SAY("20 no /arm-io/bluetooth local-mac-address in the ADT: the controller keeps its address\n");
+		return;
+	}
+	const uint8_t *a = prop;
+	if (cmd_cc(OP_WRITE_BDADDR, a, 6, &r, &rl)) {
+		SAY("20 0xfc14 failed: the controller keeps its address\n");
+		return;
+	}
+	if (step_bdaddr(20, now) == 0) {
+		bool same = true;
+		for (uint32_t i = 0; i < 6; i++) {
+			same = same && now[i] == a[5 - i];
+		}
+		SAY("20 ADT address %02x:%02x:%02x:%02x:%02x:%02x %s\n", a[0], a[1], a[2], a[3], a[4], a[5],
+		    same ? "is the controller address now" : "NOT taken by the controller");
+	}
+}
