 		goto out;
 	}
+	if (mode >= 4) {
+		STEP(20, "BD address from the ADT (0xfc14)");
+		step_set_bdaddr();
+	}
 	SAY("HCI stage done: firmware ROM %02x%s loaded, %u baud\n", h.rom, h.gf ? " GF" : "", negroni_bt_uart_baud());
 out:
