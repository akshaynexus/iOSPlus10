+		snprintf(what, sizeof(what), "BATT_CHG_CTRL_LIM (FCC, uA; %u mA)", ma);
+		if (put_log(BC_BATTERY_SET, BATT_CHG_CTRL_LIM, ma * 1000u, what, (int32_t)ma != st.fcc_set_ma)) {
+			st.fcc_set_ma = (int32_t)ma;
+			fcc_fails = 0;
+		} else if (++fcc_fails == LOOP_FAILS) {
+			LOG("loop: %u FCC writes failed in a row: no FCC write until the next plug", LOOP_FAILS);
+		}
+	}
+	/* 6. read back; a difference is logged (bounded: the first 20, then every 100th) */
+	int32_t fvBack = get(BC_BATTERY_GET, BATT_VOLT_MAX, &v) ? (int32_t)v : -1;
+	int32_t fccBack = get(BC_BATTERY_GET, BATT_CHG_CTRL_LIM, &v) ? (int32_t)(v / 1000) : -1;
+	st.fv_mv = fvBack;
+	st.fcc_ma = fccBack;
+	if ((st.fv_set_mv && fvBack >= 0 && fvBack != st.fv_set_mv) || (st.fcc_set_ma && fccBack >= 0 && fccBack != st.fcc_set_ma)) {
+		if (mismatch_lines < 20 || mismatch_lines % 100 == 0) {
+			LOG("loop: read back FV %d (wrote %d) FCC %d mA (wrote %d)", fvBack, st.fv_set_mv, fccBack, st.fcc_set_ma);
+		}
+		mismatch_lines++;
+	}
+	st.gen++;
