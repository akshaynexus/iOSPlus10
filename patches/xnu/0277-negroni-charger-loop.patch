+/*
+ * ---- 0277: the charge loop ----
+ * JEITA bands of the DT (out/live.dts qcom,battery_charger), per cell, in the decision order of
+ * oplus_chg_check_tbatt_status (oplus_charger.c:8041-8059). The lower bounds are in 0.1 C; the DT
+ * cold/removed values are negated by the parser (oplus_charger.c:5446, :5463). FCC: the plain (non-PD,
+ * non-QC) values: this client negotiates no PD/QC voltage (5 V, ICL <= 2000 mA). vbatt > 4180 mV has
+ * _low/_high variants in the DT that are equal here (:6687-6696). fv 0 / fcc 0 = no charging
+ * (oplus_chg_set_charging_current returns for HIGH/LOW/REMOVED, oplus_charger.c:6890-6894).
+ */
+#define FV_DT_MV        4435u   /* live.dts:6709 temp_normal_vfloat_mv 0x1153: the highest band FV */
+#define FCC_DT_MA       1100u   /* live.dts:6708 temp_normal_fastchg_current_ma 0x44c: the highest plain FCC */
+#define VBATT_NUM       2u      /* live.dts:6749 qcom,vbatt_num; oplus_charger.c:7252 flv * vbatt_num */
+#define HYST_DC         20      /* oplus_charger.c:7849 HYSTERISIS_DECIDEGC */
+#define BAND_NORMAL     6
+#define LOOP_FAILS      5u
+struct chg_band {
+	const char *name;
+	int32_t lo_dc;                  /* lower bound, 0.1 C, inclusive */
+	uint32_t fv_mv;                 /* per cell; 0 = stop */
+	uint32_t fcc_ma;                /* 0 = stop */
+};
+static const struct chg_band kBand[] = {
+	{ "removed", INT32_MIN, 0, 0 },     /* <= -19.0 C (removed_bat_decidegc 0xbe :6681) */
+	{ "low", -189, 0, 0 },              /* -19.0 .. -10.1 C: LOW_TEMP (:8055) */
+	{ "cold", -100, 4435, 600 },        /* cold_bat_decidegc 0x64 :6682; FV 0x1153 :6683; FCC 0x258 :6684 */
+	{ "little_cold", 0, 4435, 1100 },   /* :6685; FV :6686; FCC 0x44c :6687/:6689 */
+	{ "cool", 50, 4435, 1100 },         /* :6694; FV :6695; FCC 0x44c :6696 */
+	{ "little_cool", 120, 4435, 1100 }, /* :6702; FV :6703; FCC 0x44c :6704 */
+	{ "normal", 160, 4435, 1100 },      /* :6707; FCC 0x44c :6708; FV 0x1153 :6709 */
+	{ "warm", 450, 4130, 500 },         /* :6712; FV 0x1022 :6713; FCC 0x1f4 :6717 (screen-on value; 0x44c :6714 screen off) */
+	{ "hot", 531, 0, 0 },               /* > 53.0 C: HIGH_TEMP (hot_bat_decidegc 0x212 :6718; ">" at :8041) */
+};
+#define NBANDS ((int)(sizeof(kBand) / sizeof(kBand[0])))
+static const uint32_t kThermMa[5] = { 0, 3000, 1500, 1000, 500 };      /* live.dts:6647 qcom,thermal-mitigation (uA / 1000) */
+static uint32_t fv_scale;               /* 0 unknown, 1 cell mV, 2 pack mV */
+static unsigned fv_fails, fcc_fails, en_fails, loop_runs, mismatch_lines;
+static bool notemp_logged, fvunit_logged;
+
+/* Every table value at or below the DT maximum, else the loop stays off. */
+static bool
+bands_ok(void)
+{
+	for (int i = 0; i < NBANDS; i++) {
+		if (kBand[i].fv_mv > FV_DT_MV || kBand[i].fcc_ma > FCC_DT_MA) {
+			LOG("loop: band %s FV %u mV / FCC %u mA above the DT maximum %u mV / %u mA: REFUSED, loop off",
+			    kBand[i].name, kBand[i].fv_mv, kBand[i].fcc_ma, FV_DT_MV, FCC_DT_MA);
+			return false;
+		}
+	}
+	return true;
+}
+
+static int
+band_of(int32_t dc)
+{
+	for (int i = NBANDS - 1; i > 0; i--) {
+		if (dc >= kBand[i].lo_dc) {
+			return i;
+		}
+	}
+	return 0;
+}
+
+/* A new plug (or USB out): the next loop writes everything again. chg_stopped stays: a hot battery
+ * is not enabled by a re-plug; the loop restarts it when the band is good. */
+static void
+loop_reset(void)
+{
+	st.band = -1;
+	st.fv_set_mv = st.fcc_set_ma = 0;
+	fv_fails = fcc_fails = en_fails = 0;
+}
