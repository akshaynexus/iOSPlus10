+/* ---- 0277: the power hub (temperatures for the thermal policy) and the thermal FCC level ---- */
+static LCK_MTX_DECLARE(hub_mtx, &negroni_chg_grp);
+static int32_t hub_t[NEGRONI_PWR_T_N];
+static uint64_t hub_ns[NEGRONI_PWR_T_N];
+static volatile uint32_t therm_level_req;
+
+void
+negroni_pwr_temp_set(unsigned which, int32_t centi_c)
+{
+	if (which >= NEGRONI_PWR_T_N) {
+		return;
+	}
+	lck_mtx_lock(&hub_mtx);
+	hub_t[which] = centi_c;
+	hub_ns[which] = now_ns();
+	lck_mtx_unlock(&hub_mtx);
+}
+
+bool
+negroni_pwr_temp_get(unsigned which, int32_t *centi_c, uint32_t max_age_ms)
+{
+	bool ok = false;
+	uint64_t t = now_ns();
+
+	if (which >= NEGRONI_PWR_T_N || centi_c == NULL) {
+		return false;
+	}
+	lck_mtx_lock(&hub_mtx);
+	if (hub_ns[which] != 0 && t >= hub_ns[which] && t - hub_ns[which] <= (uint64_t)max_age_ms * 1000000ull) {
+		*centi_c = hub_t[which];
+		ok = true;
+	}
+	lck_mtx_unlock(&hub_mtx);
+	return ok;
+}
+
+void
+negroni_chg_glink_set_thermal_level(unsigned level)
+{
+	therm_level_req = level > 4 ? 4 : level;
+}
