+}
+
+/* Wait `s` seconds; GLINK stays polled (notifications). A USB notification ends it after 2 s (true). */
+static bool
 idle(uint32_t s)
 {
+	bool early = false;
+
 	for (uint32_t ms = 0; ms < s * 1000; ms += 50) {
 		negroni_glink_poll();
 		if (notify_usb && ms >= 2000) {
+			early = true;
 			break;
 		}
 		IOSleep(50);
 	}
 	notify_usb = false;
+	return early;
+}
+
+/* 0277: the poll period in loop_s pieces, with a charge loop run between them (USB in and READY only). */
+static void
+idle_loop(uint32_t s)
+{
+	for (uint32_t done = 0; done < s;) {
+		uint32_t chunk = (loop_on && was_online && st.ready) ? MIN(loop_s, s - done) : s - done;
+		if (idle(chunk)) {
+			return;
+		}
+		done += chunk;
+		if (done < s) {
+			charge_loop();
+		}
+	}
 }
 
