+	if ((address = OSData::withBytes(mac, 6)) != NULL) {
+		awdl->setProperty("IOMACAddress", address);
+		address->release();
+	}
+	awdl->setProperty("IOBuiltin", true);
+	awdl->setProperty("IO80211VirtualInterfaceRole", "AirLink");
+	if (publish(awdl, wlan_controller, "NegroniAWDL") == NULL) {
