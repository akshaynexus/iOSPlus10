+
+static const struct {
+	uint32_t bit;
+	const char *name;
+} services[] = {
+	/* WMI_TLV_SERVICE_* numbers: Linux ath11k wmi.h (enum wmi_tlv_service) */
+	{ 52, "NAN" }, { 96, "NAN_DATA" }, { 97, "NAN_RTT" }, { 164, "NAN_DBS" }, { 166, "NAN_SAP" }, { 175, "NAN_DISABLE" },
+	{ 75, "MGMT_TX_HTT" }, { 76, "MGMT_TX_WMI" }, { 123, "OFFCHAN_TX_WMI" }, { 130, "VDEV_LIMIT_OFFCHAN" },
+	{ 144, "OFFCHAN_DATA_TID" }, { 105, "VDEV_RX_FILTER" }, { 145, "RX_PROMISC_ENABLE" }, { 106, "P2P_LISTEN_OFFLOAD" },
+	{ 56, "TDLS_OFFCHAN" }, { 59, "IBSS_PWRSAVE" }, { 174, "TX_DATA_MGMT_ACK_RSSI" },
+};
+
+static void
+service_line(bool fake)
+{
+	char line[400];
+	size_t used = 0;
+
+	if (fake) {
+		printf("NEGRONI AWDL: fake radio: no WMI service bits\n");
+		return;
+	}
+	if (!negroni_wlan_wmi_services_known()) {
+		printf("NEGRONI AWDL: the WMI service bitmap is not known (no SERVICE_READY)\n");
+		return;
+	}
+	line[0] = '\0';
+	for (unsigned i = 0; i < sizeof(services) / sizeof(services[0]) && used + 32 < sizeof(line); i++) {
+		used += (size_t)snprintf(line + used, sizeof(line) - used, "%s%s %u %s", i ? ", " : "", services[i].name,
+		    services[i].bit, negroni_wlan_wmi_service(services[i].bit) ? "yes" : "no");
+	}
+	printf("NEGRONI AWDL: WMI services for AWDL/NAN: %s\n", line);
+}
+
+/* ---- observer awdl0 (bit 1) ---------------------------------------------------------------------------------------- */
+
+#define KINDS_MAX               64u
+#define PER_KIND_LOG            4u
+#define REQUEST_LINES_MAX       300u
+
+static LCK_GRP_DECLARE(awdl_lock_group, "negroni-awdl");
+static LCK_MTX_DECLARE(awdl_lock, &awdl_lock_group);
+
+static struct {
+	ifnet_t ifp;
+	uint8_t mac[6];
+	bool published;
+	uint64_t attached_ms, summary_at, rx_summary_at;
+	uint64_t requests, requests_at_summary, tx_drop;
+	uint32_t lines, other_ioctls;
+	uint32_t kind_count;
+	struct {
+		int32_t type;
+		bool set;
+		uint32_t times;
+		uint32_t len;
+		char who[20];
+	} kinds[KINDS_MAX];
+} A;
+
+/* true if this request gets a log line */
+static bool
+awdl_note(const struct apple80211req *r, bool is_set, const char *who)
+{
+	uint32_t i;
+	bool say;
+
+	lck_mtx_lock(&awdl_lock);
+	A.requests++;
+	for (i = 0; i < A.kind_count && !(A.kinds[i].type == r->req_type && A.kinds[i].set == is_set); i++) {
+	}
+	if (i == A.kind_count && i < KINDS_MAX) {
+		A.kinds[i].type = r->req_type;
+		A.kinds[i].set = is_set;
+		strlcpy(A.kinds[i].who, who, sizeof(A.kinds[i].who));
+		A.kind_count++;
+	}
+	if (i < KINDS_MAX) {
+		A.kinds[i].times++;
+		A.kinds[i].len = r->req_len;
+		say = A.kinds[i].times <= PER_KIND_LOG;
+	} else {
+		say = true;
+	}
+	if (say) {
+		say = A.lines < REQUEST_LINES_MAX;
+		A.lines += say;
+	}
+	lck_mtx_unlock(&awdl_lock);
+	return say;
+}
+
+static void
+awdl_request_summary(void)
+{
+	lck_mtx_lock(&awdl_lock);
+	A.requests_at_summary = A.requests;
+	printf("NEGRONI AWDL: awdl0 Apple80211 summary: %u request kinds, %llu requests (SYNC_ENABLED answered; the rest "
+	    "refused, airdrop-plan step 6)\n", A.kind_count, A.requests);
+	for (uint32_t i = 0; i < A.kind_count; i++) {
+		printf("NEGRONI AWDL: awdl0 %s %d (%s) %u times, %u bytes, first from %s\n", A.kinds[i].set ? "set" : "get",
+		    A.kinds[i].type, type_name(A.kinds[i].type), A.kinds[i].times, A.kinds[i].len, A.kinds[i].who);
+	}
+	lck_mtx_unlock(&awdl_lock);
+}
+
+static int
+awdl_apple80211(u_long command, void *data)
+{
+	struct apple80211req *r = data;
+	bool is_set = command == SIOCSA80211_CMD;
+	char who[32] = "?";
+	int ret = EOPNOTSUPP;
+	const char *how = "refused (layout not confirmed: airdrop-plan [U])";
+
+	proc_selfname(who, sizeof(who));
+	/* Answer the requests whose layout is confirmed from the 20H392 binaries. AWDL_SYNC_ENABLED (117)
+	 * is a simple on/off carried in req_val. The engine runs on its own; a set only tracks the wish.
+	 * Every other AWDL_* request is logged and gets a clean error (the work list, airdrop-plan step 6). */
+	switch (r->req_type) {
+	case 117:       /* AWDL_SYNC_ENABLED */
+		if (is_set) {
+			ret = 0;
+			how = "accepted";
+		} else {
+			r->req_val = engine_is_on() ? 1 : 0;
+			ret = 0;
+			how = "answered";
+		}
+		break;
+	default:
+		break;
+	}
+	if (awdl_note(r, is_set, who)) {
+		printf("NEGRONI AWDL: %s %s %d (%s) on %.16s, value %d, %u bytes: %s\n", who, is_set ? "sets" : "gets",
+		    r->req_type, type_name(r->req_type), r->req_if_name, r->req_val, r->req_len, how);
+	}
+	return ret;
+}
+
+static errno_t
+awdl_output(ifnet_t ifp, mbuf_t packet)
+{
+	/* no data path yet: everything is dropped (a later step sends AWDL data frames) */
+	A.tx_drop++;
+	ifnet_stat_increment_out(ifp, 0, 0, 1);
+	mbuf_freem(packet);
+	return 0;
+}
+
+static errno_t
+awdl_ioctl(ifnet_t ifp, u_long command, void *data)
+{
+	const int media[] = { IFM_IEEE80211 | IFM_AUTO };      /* wifip2pd: "not a WiFi interface" otherwise [I] */
+	struct ifreq *request = data;
+	struct ifmediareq *media_request = data;
+	user_addr_t list;
+	errno_t error = 0;
+
+	switch (command) {
+	case SIOCSA80211_CMD:
+	case SIOCGA80211_CMD:
+		return awdl_apple80211(command, data);
+	case SIOCSIFADDR:
+		ifnet_set_flags(ifp, IFF_UP, IFF_UP);
+		break;
+	case SIOCSIFFLAGS:
+		ifnet_set_flags(ifp, (ifnet_flags(ifp) & IFF_UP) ? IFF_RUNNING : 0, IFF_RUNNING);
+		break;
+	case SIOCGIFMEDIA32:
+	case SIOCGIFMEDIA64:
+		list = command == SIOCGIFMEDIA64 ? ((struct ifmediareq64 *)media_request)->ifmu_ulist :
+		    CAST_USER_ADDR_T(((struct ifmediareq32 *)media_request)->ifmu_ulist);
+		media_request->ifm_active = media_request->ifm_current = media[0];
+		media_request->ifm_mask = 0;
+		media_request->ifm_status = IFM_AVALID;         /* never ACTIVE: there is no AWDL link */
+		if (list != USER_ADDR_NULL && media_request->ifm_count > 0) {
+			error = copyout(media, list, sizeof(media));
+		}
+		media_request->ifm_count = 1;
+		break;
+	case SIOCGIFDEVMTU:
+		request->ifr_devmtu.ifdm_current = ifnet_mtu(ifp);
+		request->ifr_devmtu.ifdm_max = ETHERMTU;
+		request->ifr_devmtu.ifdm_min = IF_MINMTU;
+		break;
+	case SIOCSIFMTU:
+		error = request->ifr_mtu > ETHERMTU || request->ifr_mtu < IF_MINMTU ? EINVAL : ifnet_set_mtu(ifp, request->ifr_mtu);
+		break;
+	case SIOCADDMULTI:
+	case SIOCDELMULTI:
+		break;
+	default:
+		if (A.other_ioctls++ < 20) {
+			char who[32] = "?";
+
+			proc_selfname(who, sizeof(who));
+			printf("NEGRONI AWDL: awdl0 ioctl %#lx from %s: not handled\n", command, who);
+		}
+		error = EOPNOTSUPP;
+		break;
+	}
+	return error;
+}
+
+static bool
+awdl_attach(void)
+{
+	struct ifnet_init_eparams init = {
+		.ver = IFNET_INIT_CURRENT_VERSION,
+		.len = sizeof(init),
+		.flags = IFNET_INIT_LEGACY | IFNET_INIT_NX_NOAUTO,
+		.uniqueid = "negroni-wlan-awdl0",
+		.uniqueid_len = sizeof("negroni-wlan-awdl0") - 1,
+		.name = "awdl",
+		.unit = 0,
+		.family = IFNET_FAMILY_ETHERNET,
+		.subfamily = IFNET_SUBFAMILY_WIFI,
+		.type = IFT_ETHER,
+		.output = awdl_output,
+		.demux = ether_demux,
+		.add_proto = ether_add_proto,
+		.del_proto = ether_del_proto,
+		.check_multi = ether_check_multi,
+		.framer_extended = ether_frameout_extended,
+		.ioctl = awdl_ioctl,
+		.broadcast_addr = etherbroadcastaddr,
+		.broadcast_len = ETHER_ADDR_LEN,
+	};
+	ifnet_t ifp = NULL;
+	errno_t error;
+
+	error = ifnet_allocate_extended(&init, &ifp);
+	if (error != 0) {
+		printf("NEGRONI AWDL: awdl0 cannot be made: error %d\n", error);
+		return false;
+	}
+	ifnet_set_addrlen(ifp, ETHER_ADDR_LEN);
+	ifnet_set_baudrate(ifp, 100 * 1000 * 1000);
+	ifnet_set_mtu(ifp, ETHERMTU);
+	ifnet_set_flags(ifp, IFF_BROADCAST | IFF_MULTICAST | IFF_SIMPLEX, 0xffff);
+	ifnet_set_hdrlen(ifp, ETHER_HDR_LEN);
+	ifnet_set_offload(ifp, 0);
+	error = ifnet_attach(ifp, NULL);
+	if (error != 0) {
+		printf("NEGRONI AWDL: awdl0 cannot be attached: error %d\n", error);
+		ifnet_release(ifp);
+		return false;
+	}
+	ifnet_set_lladdr(ifp, A.mac, ETHER_ADDR_LEN);
+	/* the kernel adds IFEF_LOCALNET_PRIVATE, IFEF_IPV6_ND6ALT, IFEF_RESTRICTED_RECV (IFEF_AWDL_MASK) */
+	error = ifnet_set_eflags(ifp, IFEF_AWDL, IFEF_AWDL);
+	bpfattach(ifp, DLT_EN10MB, ETHER_HDR_LEN);
+	A.ifp = ifp;
+	printf("NEGRONI AWDL: awdl0 attached (MAC %02x:%02x:%02x:.., locally administered), IFEF_AWDL %s (eflags %#x), link down\n",
+	    A.mac[0], A.mac[1], A.mac[2], error == 0 ? "set" : "NOT set", ifnet_eflags(ifp));
+	return true;
+}
+
+/* ==== the AWDL engine (bit 2, NAWDL_ENGINE): OWL port on the driver thread ========================================== */
+
+#define AWDL_CHAN_NUM           6u              /* social channel 6 */
+#define AWDL_CHAN_OPCLASS       0x51u
+#define AWDL_CHAN_FREQ          2437u           /* MHz */
+#define AWDL_TX_SLOTS           4u
+#define AWDL_TX_SLOT            1024u
+#define AWDL_DESC_BASE          0x100u          /* our MGMT_TX desc ids; the join code uses 0..3 */
+#define AWDL_PSF_MS             112u            /* 110 TU ~= 112 ms */
+#define AWDL_MIF_MS             440u
+#define AWDL_ELECTION_MS        1000u
+#define AWDL_PEER_TIMEOUT_US    3000000ull      /* a peer is dropped after 3 s of silence */
+#define AWDL_ROC_MS             2000u           /* remain-on-channel window, re-armed while en0 is idle */
+#define AWDL_ROC_LOST_MS        1500u           /* no end event this long after the window: take it as ended */
+#define AWDL_ROC_RETRY_MS       1000u           /* back-off after a failed ROC start */
+#define AWDL_ROC_FAIL_MAX       10u             /* failed ROC starts in a row: engine off */
+#define AWDL_YIELD_MS           300u            /* en0 waits at most this long for our ROC to end */
+#define AWDL_TX_LOST_MS         1000u           /* a slot with no completion this long is free again */
+#define AWDL_TX_NOCOMPL_MAX     8u              /* sent frames with no completion at all: engine off */
+
+static struct {
+	bool inited, on;
+	const char *off_why;
+	struct awdl_state owl;
+	struct nwlan_dma dma;
+	bool slot_busy[AWDL_TX_SLOTS];
+	uint64_t slot_ms[AWDL_TX_SLOTS];        /* 0347 review: send time, a lost completion frees the slot */
+	bool roc_armed;                         /* START_SCAN sent, no end event yet */
+	bool roc_on;                            /* STARTED seen: the radio is on our channel */
+	volatile bool roc_ended;                /* yield: the end event of our scan came */
+	uint32_t roc_fail_run;                  /* START_FAILED (or send errors) in a row, no STARTED */
+	uint64_t roc_until_ms, roc_retry_ms, next_psf_ms, next_mif_ms, next_election_ms;
+	uint32_t tx_sent, tx_ok, tx_fail, tx_lost, roc_start_fail, last_tx_status;
+	bool first_rx;
+	uint64_t last_summary_ms;
+} E;
+
+static uint64_t
+now_us(void)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_USEC;
+}
+
+static bool
+engine_is_on(void)
+{
+	return E.on;
+}
+
+static void
+engine_off(const char *why)
+{
+	if (E.on) {
+		E.on = false;
+		E.off_why = why;
+		if (E.roc_armed || E.roc_on) {
+			(void)negroni_awdl_roc_stop();
+		}
+		E.roc_armed = E.roc_on = false;
+		printf("NEGRONI AWDL: engine OFF: %s (TX sent %u, ok %u, fail %u, last status %u)\n", why, E.tx_sent,
+		    E.tx_ok, E.tx_fail, E.last_tx_status);
+	}
+}
+
+static void
+peer_gone(const struct awdl_peer *p)
+{
+	printf("NEGRONI AWDL: peer %02x:%02x:%02x:xx:xx:xx gone (name '%s')\n", p->addr.a[0], p->addr.a[1], p->addr.a[2],
+	    p->name);
+}
+
+/* en0 must never break: the engine takes the radio only when en0 does not use it */
+static bool
+en0_idle(void)
+{
+	return negroni_wlan_sta_state() == NWLAN_STATE_IDLE && !negroni_wlan_sta_scanning();
+}
+
+/* self-check 1: the firmware must let us send management frames by WMI */
+static bool
+engine_services_ok(void)
+{
+	if (!negroni_wlan_wmi_services_known()) {
+		return true;            /* not known yet: do not judge */
+	}
+	if (!negroni_wlan_wmi_service(76)) {    /* WMI_SERVICE_MGMT_TX_WMI */
+		return false;
+	}
+	return true;
+}
+
+static void
+engine_init(void)
+{
+	struct awdl_ea self;
+
+	if (E.inited) {
+		return;
+	}
+	memcpy(self.a, A.mac, 6);
+	negroni_owl_init_state(&E.owl, "negroni", &self, AWDL_CHAN_NUM, AWDL_CHAN_OPCLASS, now_us());
+	if (negroni_wlan_dma_alloc(AWDL_TX_SLOTS * AWDL_TX_SLOT, &E.dma) != 0) {
+		E.off_why = "no DMA for the TX slots";
+		printf("NEGRONI AWDL: engine OFF: %s\n", E.off_why);
+		E.inited = true;
+		return;
+	}
+	E.inited = true;
+	E.on = true;
+	printf("NEGRONI AWDL: engine ready (self %02x:%02x:%02x:%02x:%02x:%02x, channel %u, PSF %u TU)\n", A.mac[0],
+	    A.mac[1], A.mac[2], A.mac[3], A.mac[4], A.mac[5], AWDL_CHAN_NUM, E.owl.psf_interval);
+}
+
+/* build the 802.11 header + AWDL action body into a free slot and send it by WMI */
+static void
+engine_tx(uint8_t subtype)
+{
+	uint32_t slot = AWDL_TX_SLOTS, hlen, blen;
+	uint8_t *f;
+	static const uint8_t bcast[6] = { 0xff, 0xff, 0xff, 0xff, 0xff, 0xff };
+	static const uint8_t awdl_bssid3[6] = { 0x00, 0x25, 0x00, 0xff, 0x94, 0x73 };
+
+	for (uint32_t i = 0; i < AWDL_TX_SLOTS; i++) {
+		if (!E.slot_busy[i]) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot == AWDL_TX_SLOTS || !E.dma.nc || !E.roc_on) {
+		return;         /* no free slot, or the radio is not on our channel */
+	}
+	f = (uint8_t *)(E.dma.nc + slot * AWDL_TX_SLOT);
+	/* 802.11 management action header: type 0 subtype 13 (action), to broadcast, BSSID = AWDL */
+	f[0] = 0xd0;            /* fc: version 0, type mgmt, subtype action */
+	f[1] = 0x00;
+	f[2] = f[3] = 0;        /* duration (firmware fills) */
+	memcpy(f + 4, bcast, 6);                /* addr1 = broadcast */
+	memcpy(f + 10, A.mac, 6);               /* addr2 = our awdl0 MAC */
+	memcpy(f + 16, awdl_bssid3, 6);         /* addr3 = AWDL BSSID */
+	f[22] = (uint8_t)(E.owl.sequence_number << 4);
+	f[23] = (uint8_t)(E.owl.sequence_number >> 4);
+	E.owl.sequence_number++;
+	hlen = 24;
+	blen = negroni_owl_build_action(&E.owl, subtype, now_us(), f + hlen, AWDL_TX_SLOT - hlen);
+	if (blen == 0) {
+		return;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	E.slot_busy[slot] = true;
+	E.slot_ms[slot] = negroni_wlan_ms();
+	E.tx_sent++;
+	if (negroni_awdl_mgmt_tx(E.dma.dva + (uint64_t)slot * AWDL_TX_SLOT, hlen + blen, f, AWDL_DESC_BASE + slot,
+	    AWDL_CHAN_FREQ) != 0) {
+		E.slot_busy[slot] = false;
+		E.tx_sent--;
+	}
+}
+
+/* WMI MGMT_TX_COMPLETION for our desc range (service pass: record only) */
+bool
+negroni_awdl_wmi_event(uint32_t id, const uint8_t *p, uint32_t len)
+{
+	if (id != 0x7006u) {            /* WMI_MGMT_TX_COMPLETION_EVENTID */
+		return false;
+	}
+	/* TLV: tag 0x1a7 (MGMT_TX_COMPL_EVENT): desc_id, status */
+	struct wmi_tlv_it it = { p, p + len };
+	const uint8_t *v;
+	uint32_t tag, l;
+
+	while (negroni_wmi_tlv_next(&it, &tag, &v, &l) == 1) {
+		if (tag == 0x1a7u && l >= 8) {
+			uint32_t desc = (uint32_t)v[0] | ((uint32_t)v[1] << 8) | ((uint32_t)v[2] << 16) |
+			    ((uint32_t)v[3] << 24);
+			uint32_t status = (uint32_t)v[4] | ((uint32_t)v[5] << 8) | ((uint32_t)v[6] << 16) |
+			    ((uint32_t)v[7] << 24);
+
+			if (desc < AWDL_DESC_BASE || desc >= AWDL_DESC_BASE + AWDL_TX_SLOTS) {
+				return false;   /* a join-code frame: let the join handler take it */
+			}
+			E.slot_busy[desc - AWDL_DESC_BASE] = false;
+			E.last_tx_status = status;
+			if (status == 0) {
+				E.tx_ok++;
+			} else {
+				E.tx_fail++;
+				/* self-check 2: TX completions must succeed */
+				if (E.tx_ok == 0 && E.tx_fail >= 3) {
+					engine_off("the firmware rejects our AWDL TX (completion status not 0)");
+				}
+			}
+			return true;
+		}
+	}
+	return false;           /* a completion event with no readable TLV: let the join handler try */
+}
+
+void
+negroni_awdl_scan_event(uint32_t ev, uint32_t reason, uint32_t freq __unused)
+{
+	switch (ev) {
+	case 0x1u:              /* STARTED */
+		E.roc_on = true;
+		E.roc_fail_run = 0;
+		break;
+	case 0x40u:             /* WMI_SCAN_EV_START_FAILED */
+		E.roc_start_fail++;
+		E.roc_fail_run++;
+		E.roc_armed = E.roc_on = false;
+		E.roc_ended = true;
+		E.roc_retry_ms = negroni_wlan_ms() + AWDL_ROC_RETRY_MS;
+		if (E.roc_start_fail <= 3) {
+			printf("NEGRONI AWDL: remain-on-channel start failed (reason %u)\n", reason);
+		}
+		break;
+	case 0x2u:              /* COMPLETED */
+	case 0x10u:             /* DEQUEUED */
+		E.roc_armed = E.roc_on = false;
+		E.roc_ended = true;
+		break;
+	default:
+		break;
+	}
+}
+
+static void
+engine_summary(void)
+{
+	char tree[160];
+
+	negroni_owl_election_tree(&E.owl, tree, sizeof(tree));
+	printf("NEGRONI AWDL: engine summary: %u peers, TX %u (ok %u, fail %u), RX action %llu; %s\n", E.owl.npeers,
+	    E.tx_sent, E.tx_ok, E.tx_fail, E.owl.rx_action, tree);
+}
+
+static bool awdl_fake;
+static bool awdl_started;               /* 0347 review: set (release) at the end of negroni_awdl_start */
+
+/* make awdl0 + the AirLink IOService, only after a real AWDL RX proved the firmware passes frames */
+static void
+awdl_ensure_if(void)
+{
+	if (!(negroni_awdl_mode() & NAWDL_IF) || A.ifp != NULL) {
+		return;
+	}
+	/* 0347 review: with the engine bit, awdl0 waits for both self-checks (RX seen + one TX completed OK) */
+	if ((negroni_awdl_mode() & NAWDL_ENGINE) && !(E.on && E.tx_ok > 0)) {
+		return;
+	}
+	if (!awdl_attach()) {
+		return;
+	}
+	A.published = negroni_awdl_publish("awdl0", A.mac);
+	A.attached_ms = now_ms();
+	A.summary_at = A.attached_ms + 120 * 1000;
+	printf("NEGRONI AWDL: awdl0 + AirLink IOService made after the self-checks (first AWDL RX%s) (%s)\n",
+	    (negroni_awdl_mode() & NAWDL_ENGINE) ? ", first TX OK" : "",
+	    A.published ? "service registered" : "service NOT registered");
+}
+
+static void
+engine_rx(const uint8_t *frame, const uint8_t *body, uint32_t blen, int32_t rssi, uint32_t freq)
+{
+	struct awdl_ea sa;
+
+	if (!__atomic_load_n(&awdl_started, __ATOMIC_ACQUIRE)) {
+		return;         /* 0347 review: before negroni_awdl_start (boot scan): no MAC, no IO80211Controller yet */
+	}
+	if (!E.first_rx) {
+		E.first_rx = true;
+		printf("NEGRONI AWDL: first AWDL frame RX: the firmware passes AWDL frames to the host\n");
+	}
+	awdl_ensure_if();
+	if (E.inited && E.on) {
+		memcpy(sa.a, frame + 10, 6);
+		negroni_owl_rx_action(&E.owl, &sa, body, blen, rssi, freq, now_us());
+	}
+}
+
+/*
+ * 0347 review: en0 needs the radio (scan, join, or not idle). Stop our ROC scan and wait, bounded, for its end
+ * event, so en0's START_SCAN / VDEV_START never meet our scan. Driver thread, top level only.
+ */
+void
+negroni_awdl_yield(void)
+{
+	uint64_t deadline;
+
+	if (!E.roc_armed && !E.roc_on) {
+		return;
+	}
+	E.roc_ended = false;
+	if (negroni_awdl_roc_stop() == 0) {
+		deadline = negroni_wlan_ms() + AWDL_YIELD_MS;
+		while (!E.roc_ended && negroni_wlan_ms() < deadline) {
+			if (negroni_wlan_service() != 0) {
+				break;
+			}
+			negroni_wlan_nap(2);
+		}
+	}
+	if (!E.roc_ended) {
+		printf("NEGRONI AWDL: no end event of our ROC scan in %u ms after STOP (en0 goes on)\n", AWDL_YIELD_MS);
+	}
+	E.roc_armed = E.roc_on = false;
+	E.roc_retry_ms = negroni_wlan_ms() + AWDL_ROC_RETRY_MS;
+}
+
+/* ---- driver-thread top level (negroni_wlan_sta_service) ---- */
+void
+negroni_awdl_service(void)
+{
+	if (awdl_fake) {
+		return;         /* the fake backend has no radio */
+	}
+	uint64_t now;
+
+	if (!(negroni_awdl_mode() & NAWDL_ENGINE)) {
+		return;
+	}
+	if (!E.inited && A.ifp == NULL && !E.first_rx) {
+		return;         /* wait for the first AWDL RX before spending the radio */
+	}
+	if (!E.inited) {
+		if (!engine_services_ok()) {
+			E.inited = true;
+			E.off_why = "no WMI_SERVICE_MGMT_TX_WMI (76): the firmware cannot send our frames";
+			printf("NEGRONI AWDL: engine OFF: %s\n", E.off_why);
+			return;
+		}
+		engine_init();
+	}
+	if (!E.on) {
+		return;
+	}
+	awdl_ensure_if();                               /* 0347 review: after both self-checks */
+	if (!en0_idle()) {
+		negroni_awdl_yield();                   /* give the radio back to en0 */
+		return;
+	}
+	now = negroni_wlan_ms();
+	/* lost completions: free the slot; no completion at all: self-check 2 */
+	for (uint32_t i = 0; i < AWDL_TX_SLOTS; i++) {
+		if (E.slot_busy[i] && now - E.slot_ms[i] > AWDL_TX_LOST_MS) {
+			E.slot_busy[i] = false;
+			E.tx_lost++;
+		}
+	}
+	if (E.tx_ok == 0 && E.tx_fail == 0 && E.tx_lost >= AWDL_TX_NOCOMPL_MAX) {
+		engine_off("no TX completion from the firmware for our AWDL frames");
+		return;
+	}
+	if (E.roc_fail_run >= AWDL_ROC_FAIL_MAX) {
+		engine_off("the firmware refuses the remain-on-channel scan (START_FAILED in a row)");
+		return;
+	}
+	/* park on channel 6: arm the next window only after the last one ended (no overlapping scans) */
+	if (E.roc_armed && now >= E.roc_until_ms + AWDL_ROC_LOST_MS) {
+		E.roc_armed = E.roc_on = false;         /* no end event came: take it as ended */
+	}
+	if (!E.roc_armed && now >= E.roc_retry_ms) {
+		if (negroni_awdl_roc(AWDL_CHAN_FREQ, AWDL_ROC_MS) == 0) {
+			E.roc_armed = true;
+			E.roc_until_ms = now + AWDL_ROC_MS;
+		} else {
+			E.roc_fail_run++;
+			E.roc_retry_ms = now + AWDL_ROC_RETRY_MS;
+			if (E.roc_start_fail++ < 3) {
+				printf("NEGRONI AWDL: remain-on-channel WMI send failed\n");
+			}
+		}
+	}
+	/* timers (OWL daemon): PSF every 110 TU, MIF in the extended availability window */
+	if (now >= E.next_psf_ms) {
+		E.next_psf_ms = now + AWDL_PSF_MS;
+		engine_tx(AWDL_ACTION_PSF);
+	}
+	if (now >= E.next_mif_ms) {
+		E.next_mif_ms = now + AWDL_MIF_MS;
+		engine_tx(AWDL_ACTION_MIF);
+	}
+	if (now >= E.next_election_ms) {
+		E.next_election_ms = now + AWDL_ELECTION_MS;
+		negroni_owl_peers_clean(&E.owl, now_us() - AWDL_PEER_TIMEOUT_US, peer_gone);
+		negroni_owl_election_run(&E.owl);
+	}
+	if (now - E.last_summary_ms >= 60000) {
+		E.last_summary_ms = now;
+		engine_summary();
+	}
+}
+
+/* ---- entry points (negroni-wlan-ios thread) ------------------------------------------------------------------------ */
+
+void
+negroni_awdl_start(const uint8_t en0_mac[6], bool fake)
+{
+	uint32_t mode = negroni_awdl_mode();
+
+	if (mode == 0) {
+		printf("NEGRONI AWDL: off (negroniawdl=0)\n");
+		return;
+	}
+	awdl_fake = fake;
+	printf("NEGRONI AWDL: on (negroniawdl=%u:%s%s%s)\n", mode, (mode & NAWDL_RX) ? " RX" : "",
+	    (mode & NAWDL_IF) ? " awdl0" : "", (mode & NAWDL_ENGINE) ? " engine" : "");
+	if (mode & NAWDL_RX) {
+		service_line(fake);
+		A.rx_summary_at = now_ms() + 60 * 1000;
+	}
+	if (!(mode & (NAWDL_IF | NAWDL_ENGINE))) {
+		return;
+	}
+	/* our own address, as Apple's awdl0 has: en0's with the locally administered bit set and byte 3 changed */
+	memcpy(A.mac, en0_mac, 6);
+	A.mac[0] = (uint8_t)((A.mac[0] | 0x02) & ~0x01);
+	A.mac[3] ^= 0xa5;
+	/* awdl0 and the engine both wait for the first AWDL RX (NO PROBES: a feature that proves itself).
+	 * Nothing is sent and no interface is made until the firmware shows it passes AWDL frames. */
+	printf("NEGRONI AWDL: self MAC %02x:%02x:%02x:%02x:%02x:%02x; awdl0/engine start after the first AWDL frame\n",
+	    A.mac[0], A.mac[1], A.mac[2], A.mac[3], A.mac[4], A.mac[5]);
+	__atomic_store_n(&awdl_started, true, __ATOMIC_RELEASE);
+}
+
+void
+negroni_awdl_tick(void)
+{
+	uint64_t now;
+
+	if (negroni_awdl_mode() == 0) {
+		return;
+	}
+	now = now_ms();
+	if ((negroni_awdl_mode() & NAWDL_RX) && now >= A.rx_summary_at) {
+		A.rx_summary_at = now + 60 * 1000;
+		rx_summary(false);
+	}
+	if (A.ifp != NULL && now >= A.summary_at) {
+		/* 120 s after awdl0, then every 600 s while requests come */
+		A.summary_at = now + 600 * 1000;
+		if (A.requests != A.requests_at_summary || A.requests == 0) {
+			awdl_request_summary();
+		}
+	}
+}
