+/*
+ * NEGRONI AWDL core (patch 0347): a kernel port of the portable AWDL engine of
+ *
+ *   OWL: an open Apple Wireless Direct Link (AWDL) implementation
+ *   Copyright (C) 2018  The Open Wireless Link Project
+ *   Copyright (C) 2018  Milan Stute
+ *   seemoo-lab/owl, commit 0ee3263f944ea721c355f826aa90d636d012a512 (GPL-3.0-or-later)
+ *   src/{frame.h,state.h,sync.c,election.c,schedule.c,channel.c,tx.c,rx.c,peers.c}
+ *
+ * This program is free software: you can redistribute it and/or modify it under
+ * the terms of the GNU General Public License as published by the Free Software
+ * Foundation, either version 3 of the License, or (at your option) any later
+ * version. This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more
+ * details. You should have received a copy of the GNU General Public License
+ * along with this program. If not, see <https://www.gnu.org/licenses/>.
+ *
+ * Port notes (ours): no malloc (fixed peer array), no libpcap/netlink, clock is
+ * passed in as a parameter (us, monotonic), hashmap and iterators replaced by a
+ * linear table, logging through printf. Frame layouts, the sync math and the
+ * election algorithm are kept as in OWL; the AWDL BSSID, OUI, type and TLV ids
+ * are the public protocol constants (Stute et al., MobiCom 2018).
+ */
+#ifndef _NEGRONI_AWDL_OWL_H_
+#define _NEGRONI_AWDL_OWL_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ---- constants (OWL frame.h / channel.h; public AWDL protocol) ---- */
+#define AWDL_OUI0               0x00u
+#define AWDL_OUI1               0x17u
+#define AWDL_OUI2               0xf2u
+#define AWDL_TYPE               8u
+#define AWDL_VERSION_COMPAT     0x10u   /* awdl_version(1,0) = (1<<4)|0 */
+#define IEEE80211_VENDOR_SPECIFIC 127u
+#define AWDL_ACTION_PSF         0u
+#define AWDL_ACTION_MIF         3u
+
+#define AWDL_CHANSEQ_LENGTH     16u
+#define AWDL_CHAN_ENC_OPCLASS   3u
+
+/* TLV ids (OWL enum awdl_tlvs) */
+#define AWDL_SYNCHRONIZATON_PARAMETERS_TLV      4u
+#define AWDL_ELECTION_PARAMETERS_TLV            5u
+#define AWDL_SERVICE_PARAMETERS_TLV             6u
+#define AWDL_DATA_PATH_STATE_TLV                12u
+#define AWDL_ARPA_TLV                           16u
+#define AWDL_CHAN_SEQ_TLV                       18u
+#define AWDL_SYNCTREE_TLV                       20u
+#define AWDL_VERSION_TLV                        21u
+#define AWDL_ELECTION_PARAMETERS_V2_TLV         24u
+
+#define AWDL_ELECTION_TREE_MAX_HEIGHT   10u
+#define AWDL_ELECTION_METRIC_INIT       60u
+#define AWDL_PEERS_MAX                  32u
+#define AWDL_NAME_MAX                   64u
+
+/* a 6-byte MAC; its own type so it never clashes with net/ethernet struct ether_addr */
+struct awdl_ea { uint8_t a[6]; };
+
+/* ---- sync (OWL sync.h / sync.c) ---- */
+struct awdl_sync_state {
+	uint16_t aw_counter;
+	uint64_t last_update;   /* us */
+	uint16_t aw_period;     /* TU */
+	uint8_t presence_mode;
+};
+
+/* ---- election (OWL election.h / election.c) ---- */
+struct awdl_election_state {
+	struct awdl_ea master_addr;
+	struct awdl_ea sync_addr;
+	struct awdl_ea self_addr;
+	uint32_t height;
+	uint32_t master_metric;
+	uint32_t self_metric;
+	uint32_t master_counter;
+	uint32_t self_counter;
+};
+
+/* ---- one peer (OWL peers.h, trimmed) ---- */
+struct awdl_peer {
+	bool used;
+	bool is_valid;
+	struct awdl_ea addr;
+	uint64_t last_update;           /* us */
+	struct awdl_election_state election;
+	uint8_t version;
+	uint8_t devclass;
+	char name[AWDL_NAME_MAX + 1];
+	int32_t rssi;
+	uint32_t freq;
+};
+
+/* ---- complete node state (OWL state.h, trimmed) ---- */
+struct awdl_state {
+	struct awdl_ea self_address;
+	char name[AWDL_NAME_MAX + 1];
+	uint8_t version;
+	uint8_t dev_class;
+	uint16_t sequence_number;       /* data frames */
+	uint16_t psf_interval;          /* TU */
+	uint8_t chan_num;               /* social channel we park on (6/44/149) */
+	uint8_t chan_opclass;
+	struct awdl_sync_state sync;
+	struct awdl_election_state election;
+	struct awdl_peer peers[AWDL_PEERS_MAX];
+	uint32_t npeers;
+	/* statistics */
+	uint64_t tx_action, rx_action, rx_unknown;
+};
+
+/* init the whole node state (OWL awdl_init_state) */
+void negroni_owl_init_state(struct awdl_state *s, const char *hostname, const struct awdl_ea *self,
+    uint8_t chan_num, uint8_t chan_opclass, uint64_t now_us);
+
+/* sync math (OWL sync.c), verbatim logic */
+uint16_t negroni_owl_sync_next_aw_tu(uint64_t now_us, const struct awdl_sync_state *st);
+uint64_t negroni_owl_sync_next_aw_us(uint64_t now_us, const struct awdl_sync_state *st);
+uint16_t negroni_owl_sync_current_aw(uint64_t now_us, const struct awdl_sync_state *st);
+bool negroni_owl_is_multicast_eaw(const struct awdl_state *s, uint64_t now_us);
+
+/* election (OWL election.c), run over the live peer table */
+void negroni_owl_election_run(struct awdl_state *s);
+int negroni_owl_election_tree(const struct awdl_state *s, char *str, int len);
+
+/* peers (OWL peers.c), fixed array */
+struct awdl_peer *negroni_owl_peer_get(struct awdl_state *s, const struct awdl_ea *addr, uint64_t now_us, bool *is_new);
+void negroni_owl_peers_clean(struct awdl_state *s, uint64_t before_us, void (*gone)(const struct awdl_peer *));
+
+/* build one PSF or MIF action frame body (category..last TLV). Returns length, 0 on overflow. */
+uint32_t negroni_owl_build_action(struct awdl_state *s, uint8_t subtype, uint64_t now_us, uint8_t *buf, uint32_t cap);
+
+/* parse one received AWDL action frame body (starts at the 127 category octet). Updates the peer.
+ * sa is the 802.11 source address. Returns true if it was a well-formed AWDL action. */
+bool negroni_owl_rx_action(struct awdl_state *s, const struct awdl_ea *sa, const uint8_t *body, uint32_t blen,
+    int32_t rssi, uint32_t freq, uint64_t now_us);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _NEGRONI_AWDL_OWL_H_ */
