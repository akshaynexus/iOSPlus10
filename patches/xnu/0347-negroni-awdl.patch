+ */
+/*
+ * NEGRONI AirDrop (patch 0347, docs/airdrop-plan.md): the AWDL engine. Boot-arg negroniawdl.
+ * Default (arg unset) = on (NAWDL_RX | NAWDL_IF | NAWDL_ENGINE = 7). negroniawdl=0 is the kill switch.
+ *   bit 0 (NAWDL_RX, 1):     WMI service bits + classify every management frame of WMI_MGMT_RX.
+ *   bit 1 (NAWDL_IF, 2):     awdl0 BSD interface + AirLink IOService, made ONLY after the first
+ *                            received AWDL frame proves the firmware passes AWDL frames to the host.
+ *   bit 2 (NAWDL_ENGINE, 4): the AWDL engine (OWL port): park on channel 6, TX PSF/MIF action frames
+ *                            by WMI_MGMT_TX_SEND from our own DMA slots (desc ids 0x100+), election,
+ *                            sync, peer table. Runs on the Wi-Fi driver thread, only while en0 is idle.
+ *
+ * Self-checks (NO PROBES rule): no MGMT_TX_WMI service (76) -> engine off + one line; a failed TX
+ * completion -> engine off + the status; awdl0/AirLink made only after a real AWDL RX. Everything
+ * logs why it turned itself off.
+ */
+#ifndef _NEGRONI_AWDL_H_
+#define _NEGRONI_AWDL_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define NAWDL_RX                1u      /* service bits + RX classification (read only) */
+#define NAWDL_IF                2u      /* awdl0 + AirLink IOService (after first AWDL RX) */
+#define NAWDL_ENGINE            4u      /* the AWDL engine: park, TX PSF/MIF, election, sync */
+#define NAWDL_DEFAULT           (NAWDL_RX | NAWDL_IF | NAWDL_ENGINE)
+
+uint32_t negroni_awdl_mode(void);       /* the boot-arg, read once (default on) */
+
+/* driver thread (negroni_wlan_wmi.c scan_mgmt_rx), every management frame; never blocks */
+void negroni_awdl_mgmt_rx(const uint8_t *frame, uint32_t len, int32_t rssi, uint32_t freq);
+
+/* negroni-wlan-ios thread: once after en0 is attached, then on every loop pass (about 10 per second) */
+void negroni_awdl_start(const uint8_t en0_mac[6], bool fake);
+void negroni_awdl_tick(void);
+
+/* driver thread top level (negroni_wlan_sta_service): one engine pass (may send WMI, may wait) */
+void negroni_awdl_service(void);
+
+/* negroni_wlan_wmi.c event dispatch: our MGMT_TX_COMPLETION (desc ids 0x100+). True if consumed. */
+/* driver thread, top level: en0 needs the radio now; stop our ROC scan and wait (<= 300 ms) for its end */
+void negroni_awdl_yield(void);
+bool negroni_awdl_wmi_event(uint32_t id, const uint8_t *p, uint32_t len);
+/* negroni_wlan_wmi.c scan-event loop: a WMI_SCAN event of our remain-on-channel scan id */
+void negroni_awdl_scan_event(uint32_t ev, uint32_t reason, uint32_t freq);
+
+/* NegroniWLAN.cpp: the AirLink IOService under the IO80211Controller of en0 */
+bool negroni_awdl_publish(const char *ifname, const uint8_t mac[6]);
+
+/* negroni_wlan_wmi.c: a bit of the firmware's WMI service bitmap (SERVICE_READY + SERVICE_AVAILABLE) */
+bool negroni_wlan_wmi_service(uint32_t bit);
+bool negroni_wlan_wmi_services_known(void);
+
+/* negroni_wlan_wmi.c (0347): remain-on-channel on one frequency by a single-channel passive scan with
+ * the offchan-mgmt-tx flag and our own scan id; stop gives the radio back to en0. Our MGMT_TX of one
+ * AWDL action frame from a device buffer (dva) with a desc id and the channel frequency. */
+int negroni_awdl_roc(uint32_t freq_mhz, uint32_t max_ms);
+int negroni_awdl_roc_stop(void);
+int negroni_awdl_mgmt_tx(uint64_t dva, uint32_t frame_len, const uint8_t *frame, uint32_t desc_id, uint32_t chanfreq);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _NEGRONI_AWDL_H_ */
diff --git a/bsd/dev/negroni_awdl_owl.c b/bsd/dev/negroni_awdl_owl.c
new file mode 100644
index 0000000..b3dbe4c
--- /dev/null
+++ b/bsd/dev/negroni_awdl_owl.c
@@ -0,0 +1,482 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/*
+ * NEGRONI AWDL core (patch 0347): a kernel port of the portable AWDL engine of
+ *
+ *   OWL: an open Apple Wireless Direct Link (AWDL) implementation
+ *   Copyright (C) 2018  The Open Wireless Link Project
+ *   Copyright (C) 2018  Milan Stute
+ *   seemoo-lab/owl, commit 0ee3263f944ea721c355f826aa90d636d012a512 (GPL-3.0-or-later)
+ *   src/{frame.h,state.h,sync.c,election.c,schedule.c,channel.c,tx.c,rx.c,peers.c}
+ *
+ * This program is free software: you can redistribute it and/or modify it under
+ * the terms of the GNU General Public License as published by the Free Software
+ * Foundation, either version 3 of the License, or (at your option) any later
+ * version. This program is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ * FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more
+ * details. You should have received a copy of the GNU General Public License
+ * along with this program. If not, see <https://www.gnu.org/licenses/>.
+ *
+ * The AWDL frame layouts, the sync math and the election algorithm are kept as
+ * in OWL. Our changes: no malloc (fixed peer array), the clock is passed in,
+ * frames are built and parsed with explicit little-endian byte accessors (no
+ * casts to packed structs), logging through printf.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include "negroni_awdl_owl.h"
+
+/* ---- little-endian byte accessors (frames are little-endian on the wire) ---- */
+static inline uint8_t *w8(uint8_t *p, uint8_t v) { *p = v; return p + 1; }
+static inline uint8_t *w16(uint8_t *p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); return p + 2; }
+static inline uint8_t *w32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24);
+	return p + 4;
+}
+static inline uint8_t *wea(uint8_t *p, const struct awdl_ea *e) { memcpy(p, e->a, 6); return p + 6; }
+static inline uint16_t r16(const uint8_t *p) { return (uint16_t)(p[0] | (p[1] << 8)); }
+static inline uint32_t r32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* TU <-> us (OWL ieee80211.h) */
+static inline uint64_t tu_to_us(uint64_t tu) { return tu * 1024ull; }
+static inline uint64_t us_to_tu(uint64_t us) { return us / 1024ull; }
+
+static inline int ea_cmp(const struct awdl_ea *a, const struct awdl_ea *b) { return memcmp(a->a, b->a, 6); }
+
+/* ================= sync (OWL sync.c, verbatim logic) ================= */
+static void
+sync_init(struct awdl_sync_state *st, uint64_t now)
+{
+	st->last_update = now;
+	st->aw_counter = 0;
+	st->aw_period = 16;
+	st->presence_mode = 4;
+}
+
+uint16_t
+negroni_owl_sync_next_aw_tu(uint64_t now_us, const struct awdl_sync_state *st)
+{
+	uint64_t eaw_period = (uint64_t)st->presence_mode * st->aw_period;
+	uint64_t time_since = us_to_tu(now_us - st->last_update);
+	return (uint16_t)(eaw_period - (time_since % eaw_period));
+}
+
+uint64_t
+negroni_owl_sync_next_aw_us(uint64_t now_us, const struct awdl_sync_state *st)
+{
+	uint64_t eaw_period = tu_to_us((uint64_t)st->presence_mode * st->aw_period);
+	uint64_t time_since = now_us - st->last_update;
+	return eaw_period - (time_since % eaw_period);
+}
+
+uint16_t
+negroni_owl_sync_current_aw(uint64_t now_us, const struct awdl_sync_state *st)
+{
+	uint64_t eaw_period = (uint64_t)st->presence_mode * st->aw_period;
+	uint64_t time_since = us_to_tu(now_us - st->last_update);
+	uint64_t current_aw = st->aw_counter +
+	    (time_since % eaw_period) / st->aw_period +
+	    (uint64_t)st->presence_mode * (time_since / eaw_period);
+	return (uint16_t)current_aw;
+}
+
+/* OWL schedule.c awdl_is_multicast_eaw: extended availability window boundary */
+bool
+negroni_owl_is_multicast_eaw(const struct awdl_state *s, uint64_t now_us)
+{
+	uint16_t aw = negroni_owl_sync_current_aw(now_us, &s->sync);
+	return (aw % s->sync.presence_mode) == 0;
+}
+
+/* ================= election (OWL election.c, verbatim logic) ================= */
+static void
+election_reset_self(struct awdl_election_state *st)
+{
+	st->height = 0;
+	st->master_addr = st->self_addr;
+	st->sync_addr = st->self_addr;
+	st->master_metric = st->self_metric;
+	st->master_counter = st->self_counter;
+}
+
+static void
+election_init(struct awdl_election_state *st, const struct awdl_ea *self)
+{
+	st->self_addr = *self;
+	st->self_counter = 0;
+	st->self_metric = AWDL_ELECTION_METRIC_INIT;
+	st->master_addr = *self;
+	st->sync_addr = *self;
+	election_reset_self(st);
+}
+
+static inline int
+cmp_u32(uint32_t a, uint32_t b) { return (a < b) ? -1 : (a > b); }
+
+static int
+election_compare_master(const struct awdl_election_state *a, const struct awdl_election_state *b)
+{
+	int result = cmp_u32(a->master_counter, b->master_counter);
+	if (!result) {
+		result = cmp_u32(a->master_metric, b->master_metric);
+	}
+	return result;
+}
+
+void
+negroni_owl_election_run(struct awdl_state *s)
+{
+	struct awdl_election_state *state = &s->election;
+	struct awdl_election_state *master_state = state;
+
+	election_reset_self(state);
+	for (uint32_t i = 0; i < AWDL_PEERS_MAX; i++) {
+		struct awdl_peer *peer = &s->peers[i];
+		struct awdl_election_state *ps = &peer->election;
+		int cmp;
+
+		if (!peer->used || !peer->is_valid) {
+			continue;
+		}
+		if (ps->height + 1 > AWDL_ELECTION_TREE_MAX_HEIGHT) {
+			continue;       /* sync tree would get too large */
+		}
+		if (ea_cmp(&ps->sync_addr, &state->self_addr) == 0) {
+			continue;       /* no cycles */
+		}
+		cmp = election_compare_master(ps, master_state);
+		if (cmp < 0) {
+			continue;
+		} else if (cmp == 0) {
+			if (ps->height > master_state->height) {
+				continue;
+			} else if (ps->height == master_state->height) {
+				if (ea_cmp(&ps->self_addr, &master_state->self_addr) <= 0) {
+					continue;
+				}
+			}
+		}
+		master_state = ps;      /* accept */
+	}
+	if (state != master_state) {
+		state->master_addr = master_state->master_addr;
+		state->sync_addr = master_state->self_addr;
+		state->master_metric = master_state->master_metric;
+		state->master_counter = master_state->master_counter;
+		state->height = master_state->height + 1;
+	}
+}
+
+int
+negroni_owl_election_tree(const struct awdl_state *s, char *str, int len)
+{
+	const struct awdl_election_state *st = &s->election;
+	return snprintf(str, len, "self %02x:%02x:%02x:%02x:%02x:%02x master %02x:%02x:%02x:%02x:%02x:%02x "
+	    "height %u metric %u counter %u", st->self_addr.a[0], st->self_addr.a[1], st->self_addr.a[2],
+	    st->self_addr.a[3], st->self_addr.a[4], st->self_addr.a[5], st->master_addr.a[0], st->master_addr.a[1],
+	    st->master_addr.a[2], st->master_addr.a[3], st->master_addr.a[4], st->master_addr.a[5], st->height,
+	    st->master_metric, st->master_counter);
+}
+
+/* ================= peers (OWL peers.c, fixed array) ================= */
+struct awdl_peer *
+negroni_owl_peer_get(struct awdl_state *s, const struct awdl_ea *addr, uint64_t now_us, bool *is_new)
+{
+	uint32_t free_slot = AWDL_PEERS_MAX;
+
+	if (is_new) {
+		*is_new = false;
+	}
+	for (uint32_t i = 0; i < AWDL_PEERS_MAX; i++) {
+		if (s->peers[i].used) {
+			if (ea_cmp(&s->peers[i].addr, addr) == 0) {
+				s->peers[i].last_update = now_us;
+				return &s->peers[i];
+			}
+		} else if (free_slot == AWDL_PEERS_MAX) {
+			free_slot = i;
+		}
+	}
+	if (free_slot == AWDL_PEERS_MAX) {
+		return NULL;    /* table full */
+	}
+	struct awdl_peer *p = &s->peers[free_slot];
+	memset(p, 0, sizeof(*p));
+	p->used = true;
+	p->addr = *addr;
+	p->last_update = now_us;
+	election_init(&p->election, addr);
+	s->npeers++;
+	if (is_new) {
+		*is_new = true;
+	}
+	return p;
+}
+
+void
+negroni_owl_peers_clean(struct awdl_state *s, uint64_t before_us, void (*gone)(const struct awdl_peer *))
+{
+	for (uint32_t i = 0; i < AWDL_PEERS_MAX; i++) {
+		if (s->peers[i].used && s->peers[i].last_update < before_us) {
+			if (gone) {
+				gone(&s->peers[i]);
+			}
+			s->peers[i].used = false;
+			if (s->npeers) {
+				s->npeers--;
+			}
+		}
+	}
+}
+
+/* ================= node state ================= */
+void
+negroni_owl_init_state(struct awdl_state *s, const char *hostname, const struct awdl_ea *self,
+    uint8_t chan_num, uint8_t chan_opclass, uint64_t now_us)
+{
+	memset(s, 0, sizeof(*s));
+	s->self_address = *self;
+	strlcpy(s->name, hostname ? hostname : "negroni", sizeof(s->name));
+	s->version = AWDL_VERSION_COMPAT;
+	s->dev_class = 1;               /* macOS, OWL default */
+	s->psf_interval = 110;          /* TU, OWL daemon default */
+	s->chan_num = chan_num;
+	s->chan_opclass = chan_opclass;
+	sync_init(&s->sync, now_us);
+	election_init(&s->election, self);
+}
+
+/* ================= frame build (OWL tx.c) ================= */
+/* static channel sequence: every slot is our social channel (opclass encoding, 2 bytes/slot) */
+static uint8_t *
+build_chanseq(uint8_t *p, const struct awdl_state *s)
+{
+	p = w8(p, AWDL_CHANSEQ_LENGTH - 1);     /* count (+1) */
+	p = w8(p, AWDL_CHAN_ENC_OPCLASS);       /* encoding */
+	p = w8(p, 0);                           /* duplicate_count */
+	p = w8(p, 3);                           /* step_count */
+	p = w16(p, 0xffff);                     /* fill_channel: repeat current */
+	for (uint32_t i = 0; i < AWDL_CHANSEQ_LENGTH; i++) {
+		p = w8(p, s->chan_num);         /* opclass encoding: chan_num then opclass */
+		p = w8(p, s->chan_opclass);
+	}
+	return p;
+}
+
+/* sync parameters TLV (type 4) + embedded channel sequence + 2 pad */
+static uint8_t *
+build_sync_params(uint8_t *p, struct awdl_state *s, uint64_t now_us)
+{
+	uint8_t *len_at;
+	uint8_t *start;
+
+	p = w8(p, AWDL_SYNCHRONIZATON_PARAMETERS_TLV);
+	len_at = p;                     /* fill length (u16) after the body */
+	p = w16(p, 0);
+	start = p;
+	p = w8(p, s->chan_num);                                 /* next_aw_channel */
+	p = w16(p, negroni_owl_sync_next_aw_tu(now_us, &s->sync)); /* tx_down_counter */
+	p = w8(p, s->chan_num);                                 /* master_channel */
+	p = w8(p, 0);                                           /* guard_time */
+	p = w16(p, s->sync.aw_period);                          /* aw_period */
+	p = w16(p, s->psf_interval);                            /* af_period */
+	p = w16(p, 0x1800);                                     /* flags (OWL) */
+	p = w16(p, s->sync.aw_period);                          /* aw_ext_length */
+	p = w16(p, s->sync.aw_period);                          /* aw_com_length */
+	p = w16(p, 0);                                          /* remaining_aw_length */
+	p = w8(p, (uint8_t)(s->sync.presence_mode - 1));        /* min_ext */
+	p = w8(p, (uint8_t)(s->sync.presence_mode - 1));        /* max_ext_multicast */
+	p = w8(p, (uint8_t)(s->sync.presence_mode - 1));        /* max_ext_unicast */
+	p = w8(p, (uint8_t)(s->sync.presence_mode - 1));        /* max_ext_af */
+	p = wea(p, &s->election.master_addr);                   /* master_addr */
+	p = w8(p, s->sync.presence_mode);                       /* presence_mode */
+	p = w8(p, 0);                                           /* reserved */
+	p = w16(p, negroni_owl_sync_current_aw(now_us, &s->sync)); /* next_aw_seq */
+	p = w16(p, negroni_owl_sync_current_aw(now_us, &s->sync)); /* ap_alignment = next_aw_seq */
+	p = build_chanseq(p, s);
+	p = w8(p, 0);
+	p = w8(p, 0);                                           /* padding */
+	(void)w16(len_at, (uint16_t)(p - start));
+	return p;
+}
+
+static uint8_t *
+build_chanseq_tlv(uint8_t *p, const struct awdl_state *s)
+{
+	uint8_t *len_at, *start;
+
+	p = w8(p, AWDL_CHAN_SEQ_TLV);
+	len_at = p;
+	p = w16(p, 0);
+	start = p;
+	p = build_chanseq(p, s);
+	p = w8(p, 0);
+	p = w8(p, 0);
+	p = w8(p, 0);                   /* padding */
+	(void)w16(len_at, (uint16_t)(p - start));
+	return p;
+}
+
+static uint8_t *
+build_election_params(uint8_t *p, const struct awdl_state *s)
+{
+	p = w8(p, AWDL_ELECTION_PARAMETERS_TLV);
+	p = w16(p, 21);                 /* body length = sizeof - 3 */
+	p = w8(p, 0);                   /* flags */
+	p = w16(p, 0);                  /* id */
+	p = w8(p, (uint8_t)s->election.height); /* distancetop */
+	p = w8(p, 0);                   /* unknown */
+	p = wea(p, &s->election.master_addr);   /* top_master_addr */
+	p = w32(p, s->election.master_metric);  /* top_master_metric */
+	p = w32(p, s->election.self_metric);    /* self_metric */
+	p = w8(p, 0);
+	p = w8(p, 0);                   /* pad */
+	return p;
+}
+
+static uint8_t *
+build_election_params_v2(uint8_t *p, const struct awdl_state *s)
+{
+	p = w8(p, AWDL_ELECTION_PARAMETERS_V2_TLV);
+	p = w16(p, 40);                 /* body length */
+	p = wea(p, &s->election.master_addr);
+	p = wea(p, &s->election.sync_addr);
+	p = w32(p, s->election.master_counter);
+	p = w32(p, s->election.height); /* distance_to_master */
+	p = w32(p, s->election.master_metric);
+	p = w32(p, s->election.self_metric);
+	p = w32(p, 0);                  /* unknown */
+	p = w32(p, 0);                  /* reserved */
+	p = w32(p, s->election.self_counter);
+	return p;
+}
+
+static uint8_t *
+build_service_params(uint8_t *p)
+{
+	p = w8(p, AWDL_SERVICE_PARAMETERS_TLV);
+	p = w16(p, 9);                  /* body length = sizeof - 3 */
+	p = w8(p, 0); p = w8(p, 0); p = w8(p, 0);       /* unknown[3] */
+	p = w16(p, 0);                  /* sui */
+	p = w32(p, 0);                  /* bitmask */
+	return p;
+}
+
+uint32_t
+negroni_owl_build_action(struct awdl_state *s, uint8_t subtype, uint64_t now_us, uint8_t *buf, uint32_t cap)
+{
+	uint8_t *p = buf;
+	uint32_t steady = (uint32_t)now_us;
+
+	if (cap < 256) {
+		return 0;
+	}
+	/* action header (OWL struct awdl_action, 16 bytes) */
+	p = w8(p, IEEE80211_VENDOR_SPECIFIC);
+	p = w8(p, AWDL_OUI0); p = w8(p, AWDL_OUI1); p = w8(p, AWDL_OUI2);
+	p = w8(p, AWDL_TYPE);
+	p = w8(p, AWDL_VERSION_COMPAT);
+	p = w8(p, subtype);
+	p = w8(p, 0);                   /* reserved */
+	p = w32(p, steady);             /* phy_tx */
+	p = w32(p, steady);             /* target_tx */
+	/* TLVs, same order as OWL awdl_send_psf/mif */
+	p = build_sync_params(p, s, now_us);
+	p = build_election_params(p, s);
+	p = build_chanseq_tlv(p, s);
+	p = build_election_params_v2(p, s);
+	p = build_service_params(p);
+	s->tx_action++;
+	return (uint32_t)(p - buf);
+}
+
+/* ================= frame parse (OWL rx.c) ================= */
+/* walk the TLVs of an AWDL action body (after the 16-byte header) and update the peer */
+static void
+parse_tlvs(struct awdl_peer *peer, const uint8_t *p, uint32_t len)
+{
+	while (len >= 3) {
+		uint8_t type = p[0];
+		uint16_t l = r16(p + 1);
+		const uint8_t *v = p + 3;
+
+		if (l > len - 3) {
+			break;          /* runs past the end */
+		}
+		switch (type) {
+		case AWDL_ELECTION_PARAMETERS_TLV:
+			if (l >= 21) {
+				peer->election.height = v[3];
+				memcpy(peer->election.master_addr.a, v + 5, 6);
+				peer->election.master_metric = r32(v + 11);
+				peer->election.self_metric = r32(v + 15);
+				peer->election.self_addr = peer->addr;
+				peer->election.sync_addr = peer->addr;
+				peer->election.master_counter = 0;
+			}
+			break;
+		case AWDL_ELECTION_PARAMETERS_V2_TLV:
+			if (l >= 40) {
+				memcpy(peer->election.master_addr.a, v + 0, 6);
+				memcpy(peer->election.sync_addr.a, v + 6, 6);
+				peer->election.master_counter = r32(v + 12);
+				/* 0347 review: clamp (height + 1 must not wrap past the tree-height check) */
+				peer->election.height = MIN(r32(v + 16), AWDL_ELECTION_TREE_MAX_HEIGHT + 1);
+				peer->election.master_metric = r32(v + 20);
+				peer->election.self_metric = r32(v + 24);
+				peer->election.self_addr = peer->addr;
+			}
+			break;
+		case AWDL_VERSION_TLV:
+			if (l >= 2) {
+				peer->version = v[0];
+				peer->devclass = v[1];
+			}
+			break;
+		case AWDL_ARPA_TLV:
+			if (l >= 3) {
+				uint8_t nl = v[1];
+				if (nl > AWDL_NAME_MAX) {
+					nl = AWDL_NAME_MAX;
+				}
+				if ((uint32_t)nl + 2 <= l) {
+					memcpy(peer->name, v + 2, nl);
+					peer->name[nl] = '\0';
+				}
+			}
+			break;
+		default:
+			break;
+		}
+		p += 3 + l;
+		len -= 3 + l;
+	}
+}
+
+bool
+negroni_owl_rx_action(struct awdl_state *s, const struct awdl_ea *sa, const uint8_t *body, uint32_t blen,
+    int32_t rssi, uint32_t freq, uint64_t now_us)
+{
+	struct awdl_peer *peer;
+	bool is_new = false;
+
+	if (blen < 16 || body[0] != IEEE80211_VENDOR_SPECIFIC ||
+	    body[1] != AWDL_OUI0 || body[2] != AWDL_OUI1 || body[3] != AWDL_OUI2 || body[4] != AWDL_TYPE) {
+		s->rx_unknown++;
+		return false;
+	}
+	s->rx_action++;
+	peer = negroni_owl_peer_get(s, sa, now_us, &is_new);
+	if (peer == NULL) {
+		return true;    /* table full: still a valid frame */
+	}
+	peer->is_valid = true;
+	peer->rssi = rssi;
+	peer->freq = freq;
+	parse_tlvs(peer, body + 16, blen - 16);
+	return true;
+}
