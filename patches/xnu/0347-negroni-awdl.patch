+/* engine hook, defined with the engine below (one driver thread, no lock needed with the RX path) */
+static void engine_rx(const uint8_t *frame, const uint8_t *body, uint32_t blen, int32_t rssi, uint32_t freq);
+static bool engine_is_on(void);
+
+/* ---- RX classification (bit 0), driver thread only ------------------------------------------------------------ */
+
+#define FC_TYPE(fc)             (((fc) >> 2) & 3u)
+#define FC_SUBTYPE(fc)          (((fc) >> 4) & 0xfu)
+#define FC_ORDER                0x8000u
+#define CAT_PUBLIC              4u
+#define CAT_VENDOR              127u
+#define AWDL_TYPE               8u
+#define AWDL_PSF                0u              /* periodic synchronization frame */
+#define AWDL_MIF                3u              /* master indication frame */
+#define AWDL_HDR                16u             /* category, OUI, type, version, subtype, reserved, 2 x u32 time */
+#define SOURCES_MAX             16u
+#define AWDL_LINES_MAX          12u
+#define NAN_LINES_MAX           4u
+
+static const uint8_t oui_apple[3] = { 0x00, 0x17, 0xf2 };
+static const uint8_t oui_wfa[3] = { 0x50, 0x6f, 0x9a };
+static const uint8_t awdl_bssid[6] = { 0x00, 0x25, 0x00, 0xff, 0x94, 0x73 };
+
+static struct {
+	uint32_t frames, beacons, probe_req, probe_resp, action, other, short_frames;
+	uint32_t public_action, vendor_action, other_action;
+	uint32_t awdl, awdl_psf, awdl_mif, awdl_other, awdl_foreign_bssid, awdl_2g, awdl_5g;
+	uint32_t nan_sdf;
+	uint32_t lines, nan_lines;
+	uint32_t nsources;
+	struct {
+		uint8_t mac[6];
+		uint32_t frames, freq;
+		int32_t rssi;
+	} src[SOURCES_MAX];
+	uint32_t said_frames;           /* summary: frames at the last summary */
+} R;
