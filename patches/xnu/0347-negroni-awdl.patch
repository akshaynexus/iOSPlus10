+static const char *
+awdl_subtype_name(uint32_t subtype)
+{
+	return subtype == AWDL_PSF ? "PSF" : subtype == AWDL_MIF ? "MIF" : "subtype?";
+}
+
+/* "t1 t2 ..." of the first TLVs after the 16-byte AWDL action header (type u8, length u16 little endian) */
+static void
+awdl_tlv_list(const uint8_t *p, uint32_t len, char *out, size_t out_size)
+{
+	size_t used = 0;
+	uint32_t n = 0;
+
+	out[0] = '\0';
+	while (len >= 3 && n < 12 && used + 8 < out_size) {
+		uint32_t t = p[0], l = (uint32_t)p[1] | ((uint32_t)p[2] << 8);
+
+		used += (size_t)snprintf(out + used, out_size - used, "%s%u", n ? " " : "", t);
+		n++;
+		if (l > len - 3) {
+			used += (size_t)snprintf(out + used, out_size - used, "(cut)");
+			break;
+		}
+		p += 3 + l;
+		len -= 3 + l;
+	}
+}
+
+static void
+awdl_source(const uint8_t mac[6], int32_t rssi, uint32_t freq)
+{
+	uint32_t i;
+
+	for (i = 0; i < R.nsources; i++) {
+		if (memcmp(R.src[i].mac, mac, 6) == 0) {
+			R.src[i].frames++;
+			R.src[i].rssi = rssi;
+			R.src[i].freq = freq;
+			return;
+		}
+	}
+	if (R.nsources < SOURCES_MAX) {
+		memcpy(R.src[R.nsources].mac, mac, 6);
+		R.src[R.nsources].frames = 1;
+		R.src[R.nsources].rssi = rssi;
+		R.src[R.nsources].freq = freq;
+		R.nsources++;
+		/* the address is a peer's (random for AWDL): only its first three bytes are logged */
+		printf("NEGRONI AWDL: new AWDL peer %u: %02x:%02x:%02x:xx:xx:xx, %u MHz, RSSI %d dBm\n", R.nsources, mac[0], mac[1],
+		    mac[2], freq, rssi);
+	}
+}
+
+void
+negroni_awdl_mgmt_rx(const uint8_t *f, uint32_t len, int32_t rssi, uint32_t freq)
+{
+	uint32_t fc, hdr = 24, subtype;
+	const uint8_t *body;
+	uint32_t blen;
+
+	if (negroni_awdl_mode() == 0 || f == NULL) {
+		return;         /* 0347 review: bits 1/2 also need the RX path (negroniawdl=4 or 6 never started) */
+	}
+	R.frames++;
+	if (len < 24) {
+		R.short_frames++;
+		return;
+	}
+	fc = (uint32_t)f[0] | ((uint32_t)f[1] << 8);
+	if (FC_TYPE(fc) != 0) {
+		R.other++;
+		return;
+	}
+	subtype = FC_SUBTYPE(fc);
+	if (subtype == 8) {
+		R.beacons++;
+		return;
+	}
+	if (subtype == 4) {
+		R.probe_req++;
+		return;
+	}
+	if (subtype == 5) {
+		R.probe_resp++;
+		return;
+	}
+	if (subtype != 13 && subtype != 14) {           /* action, action no ack */
+		R.other++;
+		return;
+	}
+	R.action++;
+	if (fc & FC_ORDER) {
+		hdr += 4;                               /* HT control */
+	}
+	if (len < hdr + 1) {
+		R.short_frames++;
+		return;
+	}
+	body = f + hdr;
+	blen = len - hdr;
+	if (body[0] == CAT_PUBLIC) {
+		R.public_action++;
+		/* NAN SDF: public action 9 (vendor specific), OUI 50:6f:9a, OUI type 0x13 */
+		if (blen >= 6 && body[1] == 9 && memcmp(body + 2, oui_wfa, 3) == 0 && body[5] == 0x13) {
+			R.nan_sdf++;
+			if (R.nan_lines < NAN_LINES_MAX) {
+				R.nan_lines++;
+				printf("NEGRONI AWDL: RX NAN service discovery frame from %02x:%02x:%02x:xx:xx:xx, %u MHz, RSSI %d dBm, "
+				    "%u bytes\n", f[10], f[11], f[12], freq, rssi, len);
+			}
+		}
+		return;
+	}
+	if (body[0] != CAT_VENDOR) {
+		R.other_action++;
+		return;
+	}
+	R.vendor_action++;
+	if (blen < AWDL_HDR || memcmp(body + 1, oui_apple, 3) != 0 || body[4] != AWDL_TYPE) {
+		return;
+	}
+	R.awdl++;
+	R.awdl_psf += body[6] == AWDL_PSF;
+	R.awdl_mif += body[6] == AWDL_MIF;
+	R.awdl_other += body[6] != AWDL_PSF && body[6] != AWDL_MIF;
+	R.awdl_foreign_bssid += memcmp(f + 16, awdl_bssid, 6) != 0;
+	if (freq < 4000) {
+		R.awdl_2g++;
+	} else {
+		R.awdl_5g++;
+	}
+	awdl_source(f + 10, rssi, freq);
+	engine_rx(f, body, blen, rssi, freq);           /* 0347: feed the OWL engine + make awdl0 lazily */
+	if ((negroni_awdl_mode() & NAWDL_RX) && R.lines < AWDL_LINES_MAX) {
+		char tlvs[80];
+
+		R.lines++;
+		awdl_tlv_list(body + AWDL_HDR, blen - AWDL_HDR, tlvs, sizeof(tlvs));
+		printf("NEGRONI AWDL: RX AWDL %s (version %#x) from %02x:%02x:%02x:xx:xx:xx to %s, BSSID %s, %u MHz, RSSI %d dBm, "
+		    "%u bytes, TLV types: %s\n", awdl_subtype_name(body[6]), body[5], f[10], f[11], f[12],
+		    (f[4] & 1) ? "a group address" : "one station", memcmp(f + 16, awdl_bssid, 6) == 0 ? "00:25:00:ff:94:73 (AWDL)" :
+		    "another one", freq, rssi, len, tlvs[0] ? tlvs : "none");
+	}
+}
+
+static void
+rx_summary(bool force)
+{
+	if (!(negroni_awdl_mode() & NAWDL_RX) || (!force && R.frames == R.said_frames)) {
+		return;
+	}
+	R.said_frames = R.frames;
+	printf("NEGRONI AWDL: RX summary: %u management frames (%u beacons, %u probe requests, %u probe responses, %u action, "
+	    "%u other, %u short); action: %u public, %u vendor, %u other; AWDL %u (PSF %u, MIF %u, other %u, not the AWDL BSSID %u; "
+	    "2.4 GHz %u, 5 GHz %u) from %u peers; NAN SDF %u\n", R.frames, R.beacons, R.probe_req, R.probe_resp, R.action, R.other,
+	    R.short_frames, R.public_action, R.vendor_action, R.other_action, R.awdl, R.awdl_psf, R.awdl_mif, R.awdl_other,
+	    R.awdl_foreign_bssid, R.awdl_2g, R.awdl_5g, R.nsources, R.nan_sdf);
+}
