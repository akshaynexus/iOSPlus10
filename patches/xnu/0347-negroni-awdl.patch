+/* ---- boot-arg ------------------------------------------------------------------------------------------------ */
+
+static uint32_t awdl_mode_value;
+static bool awdl_mode_read;
+
+uint32_t
+negroni_awdl_mode(void)
+{
+	if (!awdl_mode_read) {
+		uint32_t v = 0;
+
+		/* default on (kill switch negroniawdl=0); an explicit value picks the bits */
+		if (PE_parse_boot_argn("negroniawdl", &v, sizeof(v))) {
+			awdl_mode_value = v & (NAWDL_RX | NAWDL_IF | NAWDL_ENGINE);
+		} else {
+			awdl_mode_value = NAWDL_DEFAULT;
+		}
+		awdl_mode_read = true;
+	}
+	return awdl_mode_value;
+}
