+/* ---- 0347: remain-on-channel and AWDL management TX ----
+ * ROC = a single-channel passive scan with the offchan-mgmt-tx flag and our own scan id, so en0's
+ * scan handling (WLAN_SCAN_ID) is untouched. Stop = WMI_STOP_SCAN. The AWDL engine never arms this
+ * unless en0 is idle, and stops it before en0 needs the radio (negroni_awdl.c).
+ */
+int
+negroni_awdl_roc(uint32_t freq_mhz, uint32_t max_ms)
+{
+	static uint8_t m[4 + 39 * 4 + 4 + 1 * 4 + 4 + 4 + 8 + 4];
+	uint8_t *p, *c;
+	uint32_t w[39] = { 0 };
+
+	memset(m, 0, sizeof(m));
+	c = put_tlv(m, WMI_TAG_START_SCAN_CMD, 39 * 4);
+	w[0] = AWDL_ROC_SCAN_ID;                /* scan_id */
+	w[1] = 1;                               /* scan_req_id */
+	w[2] = 0;                               /* vdev 0 */
+	w[3] = 4;                               /* priority HIGH */
+	w[4] = WMI_SCAN_EV_STARTED | WMI_SCAN_EV_COMPLETED | WMI_SCAN_EV_FOREIGN_CHAN | WMI_SCAN_EV_DEQUEUED |
+	    WMI_SCAN_EV_START_FAILED;
+	w[5] = max_ms;                          /* dwell active */
+	w[6] = max_ms;                          /* dwell passive: stay on the channel */
+	w[7] = 0;                               /* min rest */
+	w[8] = 0;                               /* max rest */
+	w[12] = max_ms;                         /* max scan time: the ROC window */
+	w[14] = WMI_SCAN_FLAG_PASSIVE | WMI_SCAN_FLAG_OFFCHAN_MGMT_TX;
+	w[16] = 1;                              /* num_chan */
+	w[17] = 1;                              /* num_bssid */
+	memcpy(c, w, sizeof(w));
+	p = c + sizeof(w);
+	c = put_tlv(p, WMI_TAG_ARRAY_UINT32, 1 * 4);
+	c = put32(c, freq_mhz);
+	p = put_tlv(c, WMI_TAG_ARRAY_FIXED_STRUCT, 0);          /* ssids: none */
+	c = put_tlv(p, WMI_TAG_ARRAY_FIXED_STRUCT, 8);          /* bssid: broadcast */
+	memset(c, 0xff, 6);
+	p = put_tlv(c + 8, WMI_TAG_ARRAY_BYTE, 0);              /* extra IEs: none */
+	return negroni_wlan_wmi_send(WMI_START_SCAN_CMDID, m, (uint32_t)(p - m));
+}
+
+int
+negroni_awdl_roc_stop(void)
+{
+	uint8_t m[4 + 5 * 4];
+	uint8_t *p;
+
+	memset(m, 0, sizeof(m));
+	p = put_tlv(m, TAG_STOP_SCAN_CMD_W, 5 * 4);     /* wmi_stop_scan_cmd */
+	p = put32(p, 1);                                /* requestor = our START_SCAN scan_req_id */
+	p = put32(p, AWDL_ROC_SCAN_ID);                 /* scan_id */
+	p = put32(p, 0);                                /* WMI_SCAN_STOP_ONE (ath11k wmi.h: 0x00000000) */
+	p = put32(p, 0);                                /* vdev 0 */
+	p = put32(p, negroni_wlan_wmi_pdev_id());
+	return negroni_wlan_wmi_send(WMI_STOP_SCAN_CMDID_W, m, (uint32_t)(p - m));
+}
+
+/* send one AWDL action frame (already in a device buffer at dva) by WMI_MGMT_TX_SEND */
+int
+negroni_awdl_mgmt_tx(uint64_t dva, uint32_t frame_len, const uint8_t *frame, uint32_t desc_id, uint32_t chanfreq)
+{
+	uint8_t m[4 + 32 + 4 + AWDL_MGMT_DOWNLD_LEN];
+	uint8_t *p;
+	uint32_t dl = MIN(frame_len, AWDL_MGMT_DOWNLD_LEN);
+
+	memset(m, 0, sizeof(m));
+	p = put_tlv(m, TAG_MGMT_TX_SEND_CMD_W, 32);
+	p = put32(p, 0);                        /* vdev 0 */
+	p = put32(p, desc_id);                  /* desc_id (our range 0x100+) */
+	p = put32(p, chanfreq);                 /* chanfreq: the ROC channel */
+	p = put32(p, (uint32_t)dva);
+	p = put32(p, (uint32_t)(dva >> 32));
+	p = put32(p, frame_len);
+	p = put32(p, dl);
+	p = put32(p, 0);                        /* tx_params_valid */
+	p = put_tlv(p, TAG_ARRAY_BYTE_W, dl);
+	memcpy(p, frame, dl);
+	p += (dl + 3) & ~3u;
+	return negroni_wlan_wmi_send(WMI_MGMT_TX_SEND_CMDID_W, m, (uint32_t)(p - m));
+}
