+	}
+	awdl->setProperty("IOInterfaceName", ifname);
+	awdl->setProperty("BSD Name", ifname);
+	awdl->setProperty("IOInterfaceNamePrefix", "awdl");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		awdl->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber(0ULL, 32)) != NULL) {
+		awdl->setProperty("IOInterfaceUnit", number);
+		number->release();
