+	snprintf(buf, size, "cpu %u/%u/%u MHz", dom_base[0] ? row_mhz(0, dom_row[0]) : 0,
+	    dom_base[1] ? row_mhz(1, dom_row[1]) : 0, dom_base[2] ? row_mhz(2, dom_row[2]) : 0);
+}
