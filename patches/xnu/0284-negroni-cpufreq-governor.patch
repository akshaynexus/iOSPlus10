+
+/* 0284: "cpu 1785/2496/2995 MHz", the rows asked for now, for the GPU WATCH line. */
+void
+negroni_cpufreq_mhz_line(char *buf, size_t size)
+{
+	if (!dom_known) {
+		snprintf(buf, size, "cpu off");
