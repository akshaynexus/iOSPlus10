+	(void)PE_parse_boot_argn("negronicpufreq_lo", &gov_lo, sizeof(gov_lo));
+	if (gov_hi > 100) {
+		gov_hi = 100;
+	}
+	if (gov_hi == 0) {
+		gov_hi = 1;
+	}
+	if (gov_lo > gov_hi - 1) {
+		gov_lo = gov_hi - 1;
+	}
+	for (uint32_t d = 0; d < EPSS_DOMAINS; d++) {
+		if (!dom_base[d]) {
+			continue;
+		}
+		/* the table, once, for the record: the rows the policy can use */
+		char tab[200];
+		size_t t = 0;
+		for (uint32_t r = 0; r < dom_rows[d] && t < sizeof(tab) - 8; r++) {
+			t += snprintf(tab + t, sizeof(tab) - t, "%s%u", r ? "," : "", dom_khz[d][r] / 1000);
+		}
+		printf("NEGRONI CPUFREQ: d%u table (%u rows, MHz): %s; ABL row %u\n", d, dom_rows[d], tab, dom_abl_row[d]);
+		/* the floor: the ABL row (0098); negronicpufreq_floor_mhz can only raise it */
+		dom_floor_row[d] = dom_abl_row[d];
+		if (floor_mhz) {
+			uint32_t want = row_for_khz(d, floor_mhz * 1000);
