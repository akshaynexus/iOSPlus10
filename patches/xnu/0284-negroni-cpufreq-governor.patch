+/*
+ * The busy share of every CPU over the last GOV_WINDOW ticks, from the kernel's
+ * own counters: processor_cpu_load_info() (osfmk/kern/processor.c) adds the
+ * user/system/idle ticks of the CPU (processor->pr_recount through
+ * recount_processor_usage(), divided by hz_tick_interval = 10 ms) into ticks[].
+ * The same function fills HOST_CPU_LOAD_INFO cpu_ticks[]. Per domain: the busiest core.
+ */
+static void
+sample_busy(void)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+
+	for (uint32_t d = 0; d < EPSS_DOMAINS; d++) {
+		dom_busy[d] = 0;
+	}
+	for (unsigned int i = 0; i < topology->num_cpus && i < GOV_MAX_CPUS; i++) {
+		uint32_t d = domain_of(topology->cpus[i].phys_id);
+		processor_t p = cpu_to_processor((int)topology->cpus[i].cpu_id);
+		natural_t ticks[CPU_STATE_MAX] = { 0 };
+		uint32_t busy, all, busy_w = 0, all_w = 0, pct;
+
+		if (p == PROCESSOR_NULL) {
+			continue;
+		}
+		processor_cpu_load_info(p, ticks);
+		busy = ticks[CPU_STATE_USER] + ticks[CPU_STATE_SYSTEM] + ticks[CPU_STATE_NICE];
+		all = busy + ticks[CPU_STATE_IDLE];
+		/* the counters count from boot: the first sample is only the base of the deltas */
+		cpu_busy_d[i][win_at] = sampled ? busy - cpu_busy_last[i] : 0;
+		cpu_all_d[i][win_at] = sampled ? all - cpu_all_last[i] : 0;
+		cpu_busy_last[i] = busy;
+		cpu_all_last[i] = all;
+		for (uint32_t w = 0; w < GOV_WINDOW; w++) {
+			busy_w += cpu_busy_d[i][w];
+			all_w += cpu_all_d[i][w];
+		}
+		pct = all_w ? busy_w * 100 / all_w : 0;
+		if (pct > 100) {
+			pct = 100;
+		}
+		if (pct > dom_busy[d]) {
+			dom_busy[d] = pct;
+		}
+	}
+	win_at = (win_at + 1) % GOV_WINDOW;
+	sampled = true;
+}
+
+static inline uint32_t
+lmh_mhz(uint32_t domain)
+{
+	return (*(volatile uint32_t *)(dom_base[domain] + EPSS_DOMAIN_STATE) & 0xff) * XO_KHZ / 1000;
+}
+
+static void
+format_line(void)
+{
+	size_t at = 0;
+
+	gov_line[0] = 0;
+	for (uint32_t d = 0; d < EPSS_DOMAINS; d++) {
+		if (!dom_base[d]) {
+			continue;
+		}
+		at += snprintf(gov_line + at, sizeof(gov_line) - at, "%sd%u %u MHz busy %u%% lmh %u",
+		    at ? " | " : "", d, row_mhz(d, dom_row[d]), dom_busy[d], lmh_mhz(d));
+		if (at >= sizeof(gov_line)) {
+			break;
+		}
+	}
+}
+
+/* 0284: one tick of the policy. Returns true when a row changed. */
+static bool
+gov_step(void)
+{
+	bool changed = false;
+
+	lck_mtx_lock(&cpufreq_lock);
+	for (uint32_t d = 0; d < EPSS_DOMAINS; d++) {
+		uint32_t row, want;
+
+		if (!dom_base[d]) {
+			continue;
+		}
+		row = want = dom_row[d];
+		if (dom_busy[d] > gov_hi) {
+			dom_low_ticks[d] = 0;
+			if (want < dom_cap_row[d]) {
+				want++;
+			}
+		} else if (dom_busy[d] < gov_lo) {
+			if (++dom_low_ticks[d] >= GOV_LOW_TICKS) {
+				dom_low_ticks[d] = 0;
+				if (want > dom_floor_row[d]) {
+					want--;
+				}
+			}
+		} else {
+			dom_low_ticks[d] = 0;
+		}
+		/* the bounds hold whatever happened above (a cap that moved under us) */
+		if (want > dom_cap_row[d]) {
+			want = dom_cap_row[d];
+		}
+		if (want < dom_floor_row[d]) {
+			want = dom_floor_row[d];
+		}
+		if (want != row) {
+			wr_perf_state(d, want);
+			changed = true;
+		}
+	}
+	lck_mtx_unlock(&cpufreq_lock);
+	return changed;
+}
+
+__attribute__((noreturn)) static void
+gov_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint32_t tick = 0, printed = 0;
+	bool pending = false;   /* a row changed since the last line */
+
+	sample_busy();          /* the first delta starts here */
+	for (;;) {
+		assert_wait_timeout((event_t)&tick, THREAD_UNINT, GOV_TICK_MS, NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+		tick++;
+		sample_busy();
+		if (gov_step()) {
+			pending = true;
+		}
+		format_line();
+		/* change lines: at most one a second (the state then, not each step); the minute line always */
+		if ((pending && tick - printed >= GOV_CHANGE_TICKS) || tick % GOV_LOG_TICKS == 0) {
+			printf("NEGRONI CPUFREQ: %s\n", gov_line);
+			printed = tick;
+			pending = false;
+		}
+	}
+}
+
+/* 0284: the state for another log line (the GPU WATCH line can append it). */
+void
