+		at += snprintf(rows + at, sizeof(rows) - at, "%sd%u rows %u..%u (%u..%u MHz)", at ? ", " : "",
+		    d, dom_floor_row[d], dom_cap_row[d], row_mhz(d, dom_floor_row[d]), row_mhz(d, dom_cap_row[d]));
+	}
+	printf("NEGRONI CPUFREQ: governor on (%s; up > %u%%, down < %u%% for %u ms, tick %u ms)\n",
+	    rows, gov_hi, gov_lo, GOV_LOW_TICKS * GOV_TICK_MS, GOV_TICK_MS);
+	if (kernel_thread_start(gov_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("NEGRONI CPUFREQ: governor thread did not start\n");
+	}
+}
