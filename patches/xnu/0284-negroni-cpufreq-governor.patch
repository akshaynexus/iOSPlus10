+				printf("NEGRONI CPUFREQ: d%u negronicpufreq_floor_mhz=%u is row %u, below the ABL row %u: floor stays %u\n",
+				    d, floor_mhz, want, dom_abl_row[d], dom_abl_row[d]);
+			}
