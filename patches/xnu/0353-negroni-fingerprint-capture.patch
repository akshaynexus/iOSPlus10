+/* ---- 0353: one raw capture into a buffer + /dev/negroni-fp ---- */
+
+#define FP_IMG_DEFAULT   183456u          /* 364 x 252 x 2: DELMAR_ORIGIN_BUFFER_LEN (public gf_delmar_types.h) */
+#define FP_IMG_MAX       (1u << 20)
+#define FP_IMG_W         364u
+#define FP_IMG_H         252u
+#define FP_HDR_MAGIC     0x4950464eu      /* 'NFPI' little endian */
+
+struct negroni_fp_hdr {
+	uint32_t magic, width, height, len;    /* len = bytes that follow the header */
+	uint32_t mode, wrap, proto, pad;       /* negronifp, transport used, 2/1/0 = step 10 result, 0 */
+};
+
+static struct {
+	vm_offset_t buf;
+	uint32_t cap, len;
+	bool ready;
+	int proto;
+} fp_img;
+
+/* step 11 */
+static void
+fp_capture(uint32_t cap)
+{
+	static const uint8_t p01[2] = { 0x01, 0x00 };   /* mcu_get_image payload of the public 51x0 driver */
+	uint8_t frame[GX_MAX_FRAME];
+	int wrap = gx_best_wrap > 0 ? 1 : 0;
+	bool hbm_on = false;
+
+	if (fp_img.buf == 0) {
+		if (kmem_alloc(kernel_map, &fp_img.buf, cap, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			printf("NEGRONI FP: capture: no buffer of %u bytes\n", cap);
+			return;
+		}
+		fp_img.cap = cap;
+	}
+	int hb = negroni_fp_hbm(true);
+	hbm_on = (hb == 0);
+	printf("NEGRONI FP: capture: panel HBM on rc %d\n", hb);
+	int te = negroni_fb_te_wait(2, 100);
+	if (te < 0) {
+		IOSleep(17);            /* 2 frames at 120 Hz; the TE counter needs negronifb_te=1 */
+	}
+	printf("NEGRONI FP: capture: TE wait %d (%s)\n", te,
+	    te >= 0 ? "frames counted" : te == -1 ? "TE counter off (negronifb_te=0): 17 ms timed" : "no TE in 100 ms: timed");
+
+	uint32_t n = gx_encode(frame, GX_CMD_MCU_GET_IMAGE, p01, 2, true);
+	hexline(wrap ? "wrap get image tx" : "plain get image tx", frame, (int)n);
+	if (gx_write(frame, n, wrap) != 0) {
+		printf("NEGRONI FP: capture: tx failed\n");
+		goto done;
+	}
+	int level = 0, irq = irq_wait(gx_irqwait_ms < 100 ? gx_irqwait_ms : 100, &level);
+	printf("NEGRONI FP: capture: irq40 %s (level %d)\n", irq >= 0 ? "changed" : "unchanged", level);
+	/* the exposure is at the frame; the readout needs no light: HBM off before the (long) bulk read */
+	hb = negroni_fp_hbm(false);
+	hbm_on = false;
+	printf("NEGRONI FP: capture: panel HBM off rc %d\n", hb);
+
+	/* bounded read: FIFO pieces under one chip select; stop after 16 idle pieces when nothing looked like data */
+	{
+		uint8_t *b = (uint8_t *)fp_img.buf;
+		uint32_t got = 0, idle = 0;
+		bool data = false;
+		int rc = se_cmd_simple(SPI_CS_ASSERT, "cs assert");
+		if (rc == 0 && wrap) {
+			static const uint8_t h[4] = { 0xbb, 0xf1, 0x00, 0x00 };
+			rc = se_tx(h, 4);
+		}
+		while (rc == 0 && got < cap) {
+			uint32_t c = cap - got < GX_CHUNK ? cap - got : GX_CHUNK;
+			int r = se_rx(b + got, c, got + c >= cap);
+			if (r <= 0) {
+				break;
+			}
+			if (all_same(b + got, (uint32_t)r)) {
+				idle++;
+			} else {
+				data = true;
+				idle = 0;
+			}
+			got += (uint32_t)r;
+			if (!data && idle >= 16) {
+				break;
+			}
+		}
+		(void)se_cmd_simple(SPI_CS_DEASSERT, "cs deassert");
+		fp_img.len = got;
+		uint32_t z = 0, f = 0, distinct = 0;
+		uint8_t seen[32] = { 0 };
+		for (uint32_t i = 0; i < got; i++) {
+			z += b[i] == 0;
+			f += b[i] == 0xff;
+			seen[b[i] >> 3] |= (uint8_t)(1u << (b[i] & 7));
+		}
+		for (uint32_t i = 0; i < 256; i++) {
+			distinct += (seen[i >> 3] >> (i & 7)) & 1u;
+		}
+		hexline("capture rx", b, got > 16 ? 16 : (int)got);
+		uint8_t rcmd = 0;
+		uint32_t rplen = 0, at = 0;
+		int d = got ? gx_decode(b, got > 64 ? 64 : got, &rcmd, &rplen, &at) : 0;
+		printf("NEGRONI FP: capture: %u bytes read of %u (00: %u, ff: %u, %u distinct values)%s%s\n", got, cap, z, f, distinct,
+		    d == 2 ? ": message pack header, cmd " : d == 1 ? ": pack header without a valid checksum, cmd " : "",
+		    d ? "(see rx line)" : "");
+		if (d) {
+			printf("NEGRONI FP: capture: pack at byte %u cmd %02x payload %u bytes\n", at, rcmd, rplen);
+		}
+		printf("NEGRONI FP: capture: %s\n",
+		    distinct > 16 ? "VARIED DATA: pull /dev/negroni-fp and run scripts/fp/raw-to-png.py" :
+		    got == 0 ? "no bytes" : "idle bytes only: the public get-image frame is not the G7 readout command [I]");
+		fp_img.ready = true;
+	}
+done:
+	if (hbm_on) {                   /* the tx-failure path */
+		hb = negroni_fp_hbm(false);
+		printf("NEGRONI FP: capture: panel HBM off rc %d\n", hb);
+	}
+}
+
+/* /dev/negroni-fp: header + the captured bytes */
+static int
+fp_dev_open(dev_t dev, int flags, int devtype, struct proc *p)
+{
+	(void)dev; (void)flags; (void)devtype; (void)p;
+	return 0;
+}
+
+static int
+fp_dev_close(dev_t dev, int flags, int devtype, struct proc *p)
+{
+	(void)dev; (void)flags; (void)devtype; (void)p;
+	return 0;
+}
+
+static int
+fp_dev_read(dev_t dev, struct uio *uio, int ioflag)
+{
+	struct negroni_fp_hdr h = {
+		.magic = FP_HDR_MAGIC, .width = FP_IMG_W, .height = FP_IMG_H, .len = fp_img.ready ? fp_img.len : 0,
+		.mode = (uint32_t)fp.mode, .wrap = (uint32_t)(gx_best_wrap > 0), .proto = (uint32_t)fp_img.proto, .pad = 0,
+	};
+	(void)dev; (void)ioflag;
+	off_t off = uio_offset(uio);
+	uint64_t tot = sizeof(h) + h.len;
+	if (off < 0 || (uint64_t)off >= tot) {
+		return 0;
+	}
+	if (off < (off_t)sizeof(h)) {
+		uint32_t n = (uint32_t)(sizeof(h) - off);
+		if (n > uio_resid(uio)) {
+			n = (uint32_t)uio_resid(uio);
+		}
+		int e = uiomove((caddr_t)&h + off, (int)n, uio);
+		if (e) {
+			return e;
+		}
+		off = uio_offset(uio);
+	}
+	while (uio_resid(uio) > 0 && (uint64_t)off < tot) {
+		uint32_t n = (uint32_t)(tot - off);
+		if (n > uio_resid(uio)) {
+			n = (uint32_t)uio_resid(uio);
+		}
+		int e = uiomove((caddr_t)fp_img.buf + (off - sizeof(h)), (int)n, uio);
+		if (e) {
+			return e;
+		}
+		off = uio_offset(uio);
+	}
+	return 0;
+}
+
+static const struct cdevsw fp_cdevsw = {
+	.d_open = fp_dev_open,
+	.d_close = fp_dev_close,
+	.d_read = fp_dev_read,
+	.d_write = eno_rdwrt,
+	.d_ioctl = eno_ioctl,
+	.d_stop = eno_stop,
+	.d_reset = eno_reset,
+	.d_ttys = NULL,
+	.d_select = eno_select,
+	.d_mmap = eno_mmap,
+	.d_strategy = eno_strat,
+	.d_type = 0,
+};
+
+static void
+fp_dev_init(void)
+{
+	int major = cdevsw_add(-1, &fp_cdevsw);
+	if (major < 0) {
+		printf("NEGRONI FP: cdevsw_add failed\n");
+		return;
+	}
+	devfs_make_node(makedev(major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0600, "negroni-fp");
+}
