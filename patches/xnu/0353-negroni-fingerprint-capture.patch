  * DCS). negronifb_vrr_hs=1|0 forces the DCS transmission mode (default: high-speed for mode 2 as
  * Android's dsi_hs_mode, low-power for mode 1 like the brightness). All default off.
  */
+/*
+ * 0353: wait until the tearcheck frame counter (INTF_TEAR_INT_COUNT_VAL bits 31:16, one count per
+ * TE) advanced by frames. Returns the frames seen, -1 when the counter is not mapped (negronifb_te
+ * and negronifb_vrr both 0), -2 on timeout. Sleeps 1 ms per poll; any thread.
+ */
+extern "C" int
+negroni_fb_te_wait(uint32_t frames, uint32_t timeout_ms)
+{
+	vm_offset_t intf = negroni_fb_te_intf;
+	if (intf == 0) {
+		return -1;
+	}
+	uint32_t f0 = negroni_dpu_rd(intf + INTF_TEAR_INT_COUNT_VAL) >> 16;
+	for (uint32_t ms = 0; ms < timeout_ms; ms++) {
+		IOSleep(1);
+		uint32_t d = ((negroni_dpu_rd(intf + INTF_TEAR_INT_COUNT_VAL) >> 16) - f0) & 0xffffu;
+		if (d >= frames) {
+			return (int)d;
+		}
+	}
+	return -2;
+}
