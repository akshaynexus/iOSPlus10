+/*
+ * Every frame the controller has written since the last call (in ring
+ * order), from ud_thread or the panic loop. A TRB is armed again only
+ * when its whole cache line (4 TRBs) is done; then one UPDATETRANSFER.
+ */
+static void
+ud_rx_ring_poll(void)
+{
+	struct ifnet_stat_increment_param stats = {};
+	mbuf_t head = NULL, tail = NULL;
+	uint32_t frames = 0;
+	bool rearmed = false;
+
+	if (!ud_ring || !ud.rx_started || !ud.configured) {
+		return;
+	}
+	for (;;) {
+		unsigned i = ud.rx_idx;
+		volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_RING_TRBS + 16 * i);
+		ud_sync(UD_RING_TRBS + 16 * i, 16);
+		if (t[3] & TRB_HWO) {
+			break;
+		}
+		uint32_t len = UD_FRAME_MAX - (t[2] & 0xffffff);
+		ud_sync(UD_RXBUF + i * UD_FRAME_MAX, UD_FRAME_MAX);
+		ud_rx_frame((const uint8_t *)(ud.dma + UD_RXBUF + i * UD_FRAME_MAX), len, &head, &tail, &stats);
+		frames++;
+		/* the controller must not see this TRB again before it is armed: HWO stays 0 until the line is done */
+		if ((i & 3) == 3) {
+			for (unsigned j = i - 3; j <= i; j++) {
+				ud_rx_ring_set(j);
+			}
+			ud_sync(UD_RXBUF + (i - 3) * UD_FRAME_MAX, 4 * UD_FRAME_MAX);
+			ud_sync(UD_RING_TRBS + 16 * (i - 3), 64);
+			rearmed = true;
+		}
+		ud.rx_idx = (i + 1) % UD_RXN;
+		if (frames >= UD_RXN) {
+			break;
+		}
+	}
+	if (rearmed) {
+		(void)ud_epcmd(EP_RX, DEPCMD_UPDATETRANSFER | (ud.rx_rsc << 16), 0, 0, 0);
+	}
+	if (frames) {
+		if (frames > ud.rx_max_poll) {
