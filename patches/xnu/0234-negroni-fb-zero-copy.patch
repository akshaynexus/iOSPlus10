+void
+negroni_surface_cache(uintptr_t va, uint64_t len, int op)
+{
+	uintptr_t a = va & ~(uintptr_t)63, end = va + len;
+
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (; a < end; a += 64) {
+		if (op == kNegroniCacheClean) {
+			__asm__ volatile ("dc cvac, %0" : : "r"(a) : "memory");
+		} else {
+			__asm__ volatile ("dc civac, %0" : : "r"(a) : "memory");
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void negroni_surface_init_lock(void);
+
+void
+negroni_surface_set_display_slots(uint64_t phys, uint64_t slotSize, uint32_t count,
+    uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	negroni_surface_init_lock();
+	IOLockLock(negroni_surface_lock);
+	negroni_slot_phys = phys;
+	negroni_slot_size = slotSize;
+	negroni_slot_count = count < NEGRONI_SURFACE_MAX_SLOTS ? count : NEGRONI_SURFACE_MAX_SLOTS;
+	negroni_slot_width = width;
+	negroni_slot_height = height;
+	negroni_slot_format = pixelFormat;
+	IOLockUnlock(negroni_surface_lock);
+	IOLog("NEGRONI SURF: %u display slots of %llu bytes at 0x%llx for %ux%u 0x%x\n",
+	    negroni_slot_count, slotSize, phys, width, height, pixelFormat);
+}
+
+/* A free slot for s (backboardd's framebuffer geometry), or -1. Lock held. */
+static int
+negroni_surface_slot_take_locked(NegroniSurface *s)
+{
+	if (negroni_slot_count == 0 || s->pixelFormat != negroni_slot_format || s->width != negroni_slot_width ||
+	    s->height != negroni_slot_height || s->planeCount != 0 || s->offset != 0 ||
+	    s->bytesPerElement != 4 || s->elementWidth != 1 || s->elementHeight != 1 ||
+	    (s->bytesPerRow & 63) != 0 || s->bytesPerRow > 0xffff || s->allocSize > negroni_slot_size) {
+		return -1;
+	}
+	for (uint32_t i = 0; i < negroni_slot_count; i++) {
+		if (negroni_slot_surface[i] == NULL) {
+			negroni_slot_surface[i] = s;
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+void
+negroni_surface_slots_dirty(int32_t y0, int32_t y1)
+{
+	if (negroni_surface_lock == NULL || (y0 >= 0 && y0 >= y1)) {
+		return;
+	}
+	IOLockLock(negroni_surface_lock);
+	for (uint32_t i = 0; i < negroni_slot_count; i++) {
+		NegroniSurface *s = negroni_slot_surface[i];
+		if (s == NULL) {
+			continue;
+		}
+		uint32_t a = y0 < 0 ? 0 : (uint32_t)y0;
+		uint32_t b = y0 < 0 ? s->height : (y1 > (int32_t)s->height ? s->height : (uint32_t)y1);
+		if (s->dirtyY0 >= s->dirtyY1) {
+			s->dirtyY0 = a;
+			s->dirtyY1 = b;
+		} else {
+			s->dirtyY0 = a < s->dirtyY0 ? a : s->dirtyY0;
+			s->dirtyY1 = b > s->dirtyY1 ? b : s->dirtyY1;
+		}
+	}
+	IOLockUnlock(negroni_surface_lock);
+}
+
+bool
+negroni_surface_take_dirty(NegroniSurface *s, uint32_t *y0, uint32_t *y1)
+{
+	IOLockLock(negroni_surface_lock);
+	*y0 = s->dirtyY0;
+	*y1 = s->dirtyY1 < s->height ? s->dirtyY1 : s->height;
+	s->dirtyY0 = s->dirtyY1 = 0;
+	IOLockUnlock(negroni_surface_lock);
+	return *y0 < *y1;
+}
