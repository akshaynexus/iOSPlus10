+/* ---- zero-copy scanout (0234) ---- */
+
+/*
+ * Read what ABL left in the display engine (read only) and check it is the layout the flips
+ * assume: one pipe, or two side by side, fetching the panel memory from row 0 with its stride.
+ * Then, with negronifb_zerocopy=1, the rest of the splash region becomes display slots.
+ */
+void
+AppleCLCD::zeroCopyInit(void)
+{
+	int on = 0, probe = 1, quiet = 0, badge = 0;
+	uint32_t ctl = ~0u, width = 0;
+	const char *why = NULL;
+
+	PE_parse_boot_argn("negronifb_zerocopy", &on, sizeof(on));
+	PE_parse_boot_argn("negronifb_dpuprobe", &probe, sizeof(probe));
+	PE_parse_boot_argn("negronifb_noconsole", &quiet, sizeof(quiet));
+	PE_parse_boot_argn("negronibadge", &badge, sizeof(badge));
+	PE_parse_boot_argn("negronifb_ctl", &ctl, sizeof(ctl));
+	if (!probe && !on) {
+		return;
+	}
+	if (fPhys != NEGRONI_SPLASH_PA) {
+		IOLog("NEGRONI FB: zero-copy: the panel memory 0x%llx is not the splash region\n", fPhys);
+		return;
+	}
+	fMdss = ml_io_map(NEGRONI_MDSS_PA, NEGRONI_MDSS_LEN);
+	if (fMdss == 0) {
+		IOLog("NEGRONI FB: zero-copy: no mapping of the display engine\n");
+		return;
+	}
+	for (uint32_t p = 0; p < NEGRONI_SSPPS; p++) {
+		vm_offset_t b = fMdss + negroni_sspp_off[p];
+		uint32_t addr = negroni_dpu_rd(b + SSPP_SRC0_ADDR);
+		IOLog("NEGRONI FB: DPU %s addr 0x%x size 0x%x xy 0x%x out 0x%x at 0x%x stride 0x%x format 0x%x op 0x%x\n",
+		    negroni_sspp_name[p], addr, negroni_dpu_rd(b + SSPP_SRC_SIZE), negroni_dpu_rd(b + SSPP_SRC_XY),
+		    negroni_dpu_rd(b + SSPP_OUT_SIZE), negroni_dpu_rd(b + SSPP_OUT_XY), negroni_dpu_rd(b + SSPP_SRC_YSTRIDE0),
+		    negroni_dpu_rd(b + SSPP_SRC_FORMAT), negroni_dpu_rd(b + SSPP_SRC_OP_MODE));
+		if (addr == (uint32_t)fPhys && fZCPipes < 2) {
+			fZCPipe[fZCPipes++] = p;
+		} else if (addr == (uint32_t)fPhys) {
+			why = "more than two pipes fetch the panel memory";
+		}
+	}
+	for (uint32_t c = 0; c < NEGRONI_CTLS; c++) {
+		vm_offset_t b = fMdss + negroni_ctl_off[c];
+		uint32_t intf = negroni_dpu_rd(b + CTL_INTF_ACTIVE);
+		IOLog("NEGRONI FB: DPU CTL%u layer 0x%x 0x%x 0x%x 0x%x top 0x%x flush 0x%x intf 0x%x fetch 0x%x\n", c,
+		    negroni_dpu_rd(b + CTL_LAYER0), negroni_dpu_rd(b + CTL_LAYER0 + 4), negroni_dpu_rd(b + CTL_LAYER0 + 8),
+		    negroni_dpu_rd(b + CTL_LAYER0 + 12), negroni_dpu_rd(b + CTL_TOP), negroni_dpu_rd(b + CTL_FLUSH), intf,
+		    negroni_dpu_rd(b + CTL_FETCH_PIPE_ACTIVE));
+		if (ctl == ~0u && (intf & CTL_INTF_DSI0)) {
+			ctl = c;
+		}
+	}
+	if (ctl >= NEGRONI_CTLS) {
+		ctl = 0;
+	}
+	fZCCtl = negroni_ctl_off[ctl];
+	for (uint32_t i = 0; i < fZCPipes; i++) {
+		vm_offset_t b = fMdss + negroni_sspp_off[fZCPipe[i]];
+		uint32_t size = negroni_dpu_rd(b + SSPP_SRC_SIZE);
+		fZCAblAddr[i] = negroni_dpu_rd(b + SSPP_SRC0_ADDR);
+		fZCAblXY[i] = negroni_dpu_rd(b + SSPP_SRC_XY);
+		fZCAblStride[i] = negroni_dpu_rd(b + SSPP_SRC_YSTRIDE0);
+		if ((size >> 16) != fHeight || (fZCAblXY[i] >> 16) != 0 || (fZCAblXY[i] & 0xffff) != width ||
+		    (fZCAblStride[i] & 0xffff) != fRowBytes) {
+			why = "the pipes' layout differs (size, crop or stride)";
+		}
+		width += size & 0xffff;
+		fZCFlush |= 1u << negroni_sspp_flush[fZCPipe[i]];
+	}
+	fZCFlush |= CTL_FLUSH_CTL;
+	uint64_t base = fPhys + round_page((uint64_t)fRowBytes * fHeight);
+	uint64_t slotSize = trunc_page((NEGRONI_SPLASH_END - base) / NEGRONI_ZC_SLOTS);
+	if (why != NULL) {
+	} else if (fZCPipes == 0) {
+		why = "no pipe fetches the panel memory";
+	} else if (width != fWidth) {
+		why = "the pipes do not cover the panel's width";
+	} else if (fOffX < 0 || fOffY < 0 || (uint32_t)fOffX + fWidth > fLogicalW || (uint32_t)fOffY + fHeight > fLogicalH) {
+		why = "the canvas does not cover the panel (negronifb_shift)";
+	} else if (slotSize < round_page((uint64_t)fLogicalW * 4 * fLogicalH)) {
+		why = "no room for display slots in the splash region";
+	} else if (!on) {
+		why = "off (boot-arg negronifb_zerocopy=1 turns it on)";
+	} else if (!quiet) {
+		why = "off: the console draws over the GUI (negronifb_noconsole=0)";
+	} else if (badge) {
+		why = "off: negronibadge=1 draws into the panel memory";
+	}
+	IOLog("NEGRONI FB: zero-copy %s: %u pipe(s) %s%s%s at CTL%u, flush bits 0x%x, %u slots of %llu bytes at 0x%llx, crop %d,%d\n",
+	    why != NULL ? why : "ready", fZCPipes, fZCPipes ? negroni_sspp_name[fZCPipe[0]] : "-", fZCPipes > 1 ? "+" : "",
+	    fZCPipes > 1 ? negroni_sspp_name[fZCPipe[1]] : "", ctl, fZCFlush, NEGRONI_ZC_SLOTS, slotSize, base, fOffX, fOffY);
+	if (why == NULL) {
+		fZCReady = true;
+		negroni_fb_zc = this;
+		negroni_surface_set_display_slots(base, slotSize, NEGRONI_ZC_SLOTS, fLogicalW, fLogicalH, NEGRONI_FB_FORMAT_BGRA);
+	}
+}
+
+/* The display slot surface a swap shows alone in layer 0, full canvas (retained), or NULL. */
+NegroniSurface *
+AppleCLCD::zeroCopySurface(const uint8_t *rec)
+{
+	const uint8_t *a = rec + 0x64, *b = rec + 0xc4;
+
+	if (!fZCReady || (get32(rec, 0x104) & 0xf) != 1 || get32(a, 0) != 0 || get32(a, 4) != 0 ||
+	    get32(b, 0) != 0 || get32(b, 4) != 0 || get32(a, 8) != fLogicalW || get32(a, 12) != fLogicalH ||
+	    get32(b, 8) != fLogicalW || get32(b, 12) != fLogicalH) {
+		return NULL;
+	}
+	NegroniSurface *s = negroni_surface_copy(get32(rec, 0x54));
+	if (s != NULL && (s->slot < 0 || s->width != fLogicalW || s->height != fLogicalH || s->phys == 0 ||
+	    s->bytesPerRow > 0xffff || (s->bytesPerRow & 63) != 0 || s->phys + s->allocSize > NEGRONI_SPLASH_END)) {
+		OSSafeReleaseNULL(s);
+	}
+	return s;
+}
+
+/* The engine took the last flush (it clears the bits at the frame start that applies them). */
+bool
+AppleCLCD::zeroCopyLatched(void)
+{
+	return fMdss == 0 || (negroni_dpu_rd(fMdss + fZCCtl + CTL_FLUSH) & fZCFlush) == 0;
+}
+
+/*
+ * A taken flush: the frame shown before goes back to CoreAnimation. tick (work loop): count the
+ * vsyncs a flush waits; too many and zero-copy is off for good.
+ */
+void
+AppleCLCD::zeroCopyRetire(bool tick)
+{
+	NegroniSurface *old = NULL;
+	bool stuck = false;
+
+	if (fMdss == 0) {
+		return;
+	}
+	IOLockLock(fLock);
+	if (fZCNextValid && zeroCopyLatched()) {
+		old = fZCShown;
+		fZCShown = fZCNext;
+		fZCNext = NULL;
+		fZCNextValid = false;
+		if (fZCNextID > fPresentedID) {
+			fPresentedID = fZCNextID;
+		}
+	} else if (fZCNextValid && tick && ++fZCNextTicks > NEGRONI_ZC_LATCH_TICKS) {
+		stuck = true;
+	}
+	IOLockUnlock(fLock);
+	if (old != NULL) {
+		zeroCopyUnshow(old);
+	}
+	if (stuck) {
+		IOLog("NEGRONI FB: zero-copy off: the display engine does not take flushes (CTL_FLUSH 0x%x)\n",
+		    negroni_dpu_rd(fMdss + fZCCtl + CTL_FLUSH));
+		fZCReady = false;
+		zeroCopyStop(true);
+	}
+}
+
+/* No longer shown: the clock shift undone, the hold and the reference given back. */
+void
+AppleCLCD::zeroCopyUnshow(NegroniSurface *s)
+{
+	if (s->saved && s->save != NULL) {
+		uintptr_t k = s->kernelAddress();
+		uint32_t half = fWidth / 2, bpr = s->bytesPerRow;
+		if (k != 0) {
+			uintptr_t top = k + (uint64_t)fOffY * bpr;
+			for (uint32_t y = 0; y < NEGRONI_ZC_CLOCK_ROWS; y++) {
+				memcpy((uint32_t *)(top + (uint64_t)y * bpr) + fOffX, (uint32_t *)s->save + (uint64_t)y * half,
+				    (size_t)half * 4);
+			}
+			negroni_surface_cache(top, (uint64_t)NEGRONI_ZC_CLOCK_ROWS * bpr, kNegroniCacheFlush);
+		}
+		s->saved = false;
+	}
+	negroni_surface_hold(s, false);
+	s->release();
+}
+
+/*
+ * negronifb_clockshift on a frame the engine shows itself: the left ear of the status bar
+ * shifted in the framebuffer (as negroni_shift_clock does in the panel memory), its pixels kept
+ * to put back when CoreAnimation gets the framebuffer again (zeroCopyUnshow).
+ */
+void
+AppleCLCD::zeroCopyShiftClock(NegroniSurface *s, uintptr_t k, bool gpu)
+{
+	uint32_t half = fWidth / 2, bpr = s->bytesPerRow, size = NEGRONI_ZC_CLOCK_ROWS * half * 4;
+
+	if (negroni_clock_shift < 0) {
+		negroni_clock_shift = 0;
+		PE_parse_boot_argn("negronifb_clockshift", &negroni_clock_shift, sizeof(negroni_clock_shift));
+		if (negroni_clock_shift < 0 || negroni_clock_shift > 400) {
+			negroni_clock_shift = 0;
+		}
+	}
+	uint32_t n = (uint32_t)negroni_clock_shift;
+	if (n == 0 || n >= half || s->saved || (uint64_t)fOffY + NEGRONI_ZC_CLOCK_ROWS > s->height ||
+	    (uint64_t)fOffX + half > s->width) {
+		return;
+	}
+	if (s->save == NULL) {
+		s->save = IOMallocData(size);
+		s->saveSize = s->save != NULL ? size : 0;
+		if (s->save == NULL) {
+			return;
+		}
+	}
+	uintptr_t top = k + (uint64_t)fOffY * bpr;
+	if (gpu) {
+		/* the GPU's pixels from memory, not lines the CPU caches may still hold from before */
+		negroni_surface_cache(top, (uint64_t)NEGRONI_ZC_CLOCK_ROWS * bpr, kNegroniCacheFlush);
+	}
+	for (uint32_t y = 0; y < NEGRONI_ZC_CLOCK_ROWS; y++) {
+		uint32_t *row = (uint32_t *)(top + (uint64_t)y * bpr) + fOffX;
+		uint32_t edge = row[0];
+		memcpy((uint32_t *)s->save + (uint64_t)y * half, row, (size_t)half * 4);
+		memmove(row + n, row, (size_t)(half - n) * 4);
+		for (uint32_t x = 0; x < n; x++) {
+			row[x] = edge;
+		}
+	}
+	negroni_surface_cache(top, (uint64_t)NEGRONI_ZC_CLOCK_ROWS * bpr, kNegroniCacheClean);
+	s->saved = true;
+}
+
+/* ABL's values back in the pipes: they fetch the panel memory from the next frame on. No lock (panic). */
+void
+AppleCLCD::zeroCopyRestore(void)
+{
+	if (fMdss == 0 || fZCPipes == 0) {
+		return;
+	}
+	for (uint32_t i = 0; i < fZCPipes; i++) {
+		vm_offset_t b = fMdss + negroni_sspp_off[fZCPipe[i]];
+		negroni_dpu_wr(b + SSPP_SRC_YSTRIDE0, fZCAblStride[i]);
+		negroni_dpu_wr(b + SSPP_SRC_XY, fZCAblXY[i]);
+		negroni_dpu_wr(b + SSPP_SRC0_ADDR, fZCAblAddr[i]);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	negroni_dpu_wr(fMdss + fZCCtl + CTL_FLUSH, fZCFlush);
+}
+
+/*
+ * The pipes back on the panel memory (it must hold the frame to show). now: everything held is
+ * given back at once (display off, a stuck engine); else when the engine takes the flush. Work loop.
+ */
+void
+AppleCLCD::zeroCopyStop(bool now)
+{
+	NegroniSurface *shown = NULL, *next = NULL;
+	bool active = fZCActive;
+
+	if (!active && fZCShown == NULL && fZCNext == NULL && !fZCNextValid) {
+		return;
+	}
+	for (uint32_t i = 0; i < 80 && fZCNextValid && !zeroCopyLatched(); i++) {
+		delay_for_interval(500, kMicrosecondScale);
+	}
+	zeroCopyRetire(false);
+	if (active) {
+		zeroCopyRestore();
+	}
+	IOLockLock(fLock);
+	fZCActive = false;
+	if (now || fZCNextValid) {
+		shown = fZCShown;
+		next = fZCNext;
+		fZCShown = fZCNext = NULL;
+		fZCNextValid = false;
+		fPresentedID = fEndedID;
+	} else if (active) {
+		fZCNextValid = true;            /* back to the panel memory: the shown one goes when it is taken */
+		fZCNextID = fPresentedID;
+		fZCNextTicks = 0;
+	}
+	IOLockUnlock(fLock);
+	if (shown != NULL) {
+		zeroCopyUnshow(shown);
+	}
+	if (next != NULL) {
+		zeroCopyUnshow(next);
+	}
+	static uint32_t logged;
+	if (active && logged < 32) {
+		logged++;
+		IOLog("NEGRONI FB: zero-copy paused: the pipes fetch the panel memory again\n");
+	}
+}
+
+/* Show slot surface s (retained and held: taken over) from the next frame on. Work loop. */
+void
+AppleCLCD::flip(NegroniSurface *s, uint32_t id)
+{
+	static uint32_t logged;
+	uintptr_t k = s->kernelAddress();
+	uint32_t y0 = 0, y1 = 0, bpr = s->bytesPerRow;
+	bool gpu = s->gpuFence != 0;
+
+	if (!fConsolePaused) {
+		fConsolePaused = true;
+		negroni_console_muted = 1;      /* zero-copy needs negronifb_noconsole=1 */
+	}
+	if (k == 0) {
+		negroni_surface_hold(s, false);
+		s->release();
+		return;
+	}
+	if (negroni_surface_take_dirty(s, &y0, &y1) && !gpu) {
+		/* the rows CoreAnimation's CPU renderer wrote, out of the CPU caches for the engine */
+		y0 = y0 > (uint32_t)fOffY ? y0 : (uint32_t)fOffY;
+		y1 = y1 < (uint32_t)fOffY + fHeight ? y1 : (uint32_t)fOffY + fHeight;
+		if (y0 < y1) {
+			negroni_surface_cache(k + (uint64_t)y0 * bpr, (uint64_t)(y1 - y0) * bpr, kNegroniCacheClean);
+		}
+	}
+	zeroCopyShiftClock(s, k, gpu);
+	for (uint32_t i = 0; i < fZCPipes; i++) {
+		vm_offset_t b = fMdss + negroni_sspp_off[fZCPipe[i]];
+		uint32_t x = (fZCAblXY[i] & 0xffff) + (uint32_t)fOffX, y = (fZCAblXY[i] >> 16) + (uint32_t)fOffY;
+		negroni_dpu_wr(b + SSPP_SRC_YSTRIDE0, (fZCAblStride[i] & 0xffff0000u) | bpr);
+		negroni_dpu_wr(b + SSPP_SRC_XY, y << 16 | x);
+		negroni_dpu_wr(b + SSPP_SRC0_ADDR, (uint32_t)s->phys);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	negroni_dpu_wr(fMdss + fZCCtl + CTL_FLUSH, fZCFlush);
+	IOLockLock(fLock);
+	fZCActive = true;
+	fZCNext = s;
+	fZCNextValid = true;
+	fZCNextID = id;
+	fZCNextTicks = 0;
+	IOLockUnlock(fLock);
+	fZCFrames++;
+	if (logged < 4) {
+		/* bring-up: how long the engine takes to apply a flip (expected: up to one 8.3 ms frame) */
+		uint64_t t0 = mach_absolute_time(), ns;
+		uint32_t i;
+		logged++;
+		for (i = 0; i < 80 && !zeroCopyLatched(); i++) {
+			delay_for_interval(250, kMicrosecondScale);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+		IOLog("NEGRONI FB: flip %u: slot %d at 0x%llx (%s, rows %u-%u cleaned), %s after %llu us\n", id, s->slot,
+		    s->phys, gpu ? "GPU" : "CPU", y0, y1, zeroCopyLatched() ? "taken" : "NOT taken", ns / 1000);
+	} else if (fZCFrames % 1000 == 0) {
+		IOLog("NEGRONI FB: %llu frames shown zero-copy\n", fZCFrames);
+	}
+}
+
+/*
+ * SwapWait: until swap id is on screen (the engine took its flip), at most NEGRONI_ZC_WAIT_MS.
+ * CoreAnimation passes the swap that showed its other framebuffer before it draws into this one
+ * again (ios-s9 0096), so this keeps it out of the framebuffer the engine is fetching. Returns at
+ * once when no zero-copy frame is on its way (copied frames: as before).
+ */
+void
+AppleCLCD::swapWait(uint32_t id)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(NEGRONI_ZC_WAIT_MS, kMillisecondScale, &deadline);
+	for (;;) {
+		zeroCopyRetire(false);
+		IOLockLock(fLock);
+		bool done = id == 0 || !fZCReady || fPowerOff || id > fEndedID || fPresentedID >= id ||
+		    (!fPendZC && !fZCNextValid);
+		IOLockUnlock(fLock);
+		if (done || mach_absolute_time() >= deadline) {
+			break;
+		}
+		delay_for_interval(500, kMicrosecondScale);
+	}
+}
