+/* 0396: the kill switch, read once (the first time a joined scan is asked for) */
+static bool
+sj_enabled(void)
+{
+	if (g_sj_switch < 0) {
+		uint32_t v = 1;
+		(void)PE_parse_boot_argn("negroniwlan_scanjoined", &v, sizeof(v));
+		g_sj_switch = v ? 1 : 0;
+		if (!g_sj_switch) {
+			g_sj_off = true;
+			printf("NEGRONI WLAN: scan while joined off: negroniwlan_scanjoined=0\n");
+		}
+	}
+	return g_sj_switch == 1 && !g_sj_off;
+}
+
+static void
+sj_turn_off(const char *why)
+{
+	if (g_sj_off) {
+		return;
+	}
+	g_sj_off = true;
+	printf("NEGRONI WLAN: scan while joined off: %s (scan %u; scan requests while joined get the last list again)\n",
+	    why, g_sj_scans);
