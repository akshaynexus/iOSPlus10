+
+/* a failed joined scan: off before the first success, or after SJ_FAIL_ROW failures in a row */
+static void sj_failed(const char *fmt, ...) __printflike(1, 2);
+static void
+sj_failed(const char *fmt, ...)
+{
+	char why[160];
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsnprintf(why, sizeof(why), fmt, ap);
+	va_end(ap);
+	g_sj_fail_row++;
+	if (!g_sj_proven || g_sj_fail_row >= SJ_FAIL_ROW) {
+		sj_turn_off(why);
+		return;
+	}
+	printf("NEGRONI WLAN: scan while joined: failure %u of %u in a row: %s\n", g_sj_fail_row, SJ_FAIL_ROW, why);
