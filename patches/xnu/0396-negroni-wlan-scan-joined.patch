+/* STOP_SCAN of a running joined scan; waits at most SJ_STOP_MS for the end event, then ends it here */
+static void
+sj_stop(const char *why)
+{
+	uint64_t deadline;
+
+	if (!g_sj_run) {
+		return;
+	}
+	g_sj_stopping = true;
+	if (negroni_wlan_wmi_scan_stop() == 0) {
