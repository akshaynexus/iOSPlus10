+/* ---- level 6: ICP firmware through PAS 33 + HFI (0316) ---- */
+
+static struct area_header *icp_area;
+static uint8_t *icp_mdt;
+static uint32_t icp_mdt_size, icp_nseg, icp_min_pa, icp_max_pa;
+static struct icp_seg icp_segs[ICP_MAX_SEGS];
+static bool icp_reloc;
+
+static const struct area_entry *
+icp_area_file(const char *name)
+{
+	for (uint32_t i = 0; icp_area && i < icp_area->count; i++) {
+		if (strncmp(icp_area->entry[i].name, name, sizeof(icp_area->entry[i].name)) == 0) {
+			return &icp_area->entry[i];
+		}
+	}
+	return NULL;
+}
+
+static bool
+icp_area_check(const struct area_entry *e, uint8_t *buf)
+{
+	SHA256_CTX ctx;
+	uint8_t digest[32];
+	SHA256_Init(&ctx);
+	for (uint32_t at = 0; at < e->size; at += AREA_CHUNK) {
+		uint32_t n = MIN(AREA_CHUNK, e->size - at);
+		if (negroni_ufs_adsp_area_read(e->offset + at, buf, n) != 0) {
+			return false;
+		}
+		SHA256_Update(&ctx, buf, n);
+	}
+	SHA256_Final(digest, &ctx);
+	return memcmp(digest, e->sha256, 32) == 0;
+}
+
+/* the area header, CAMERA_ICP.mdt and its program headers (negroni_adsp.c step_firmware, mdt_loader.c) */
+static bool
+l6_firmware(vm_offset_t buf)
+{
+	step_begin("icp firmware (adsp area)");
+	vm_offset_t a = 0, m = 0;
+	if (kmem_alloc(kernel_map, &a, AREA_HEADER, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return step_fail("no memory");
+	}
+	icp_area = (struct area_header *)a;
+	if (negroni_ufs_adsp_area_read(0, icp_area, AREA_HEADER) != 0 || memcmp(icp_area->magic, AREA_MAGIC, 8) != 0 ||
+	    icp_area->version != 1 || icp_area->count == 0 || icp_area->count > AREA_MAX) {
+		return step_fail("no ADSP firmware area (scripts/fw/build-areas.sh + the userdata flash)");
+	}
+	for (uint32_t i = 0; i < icp_area->count; i++) {
+		struct area_entry *x = &icp_area->entry[i];
+		x->name[47] = 0;
+		if (x->offset < AREA_HEADER || x->offset > AREA_SIZE || x->size > AREA_SIZE - x->offset) {
+			return step_fail("area entry out of range");
+		}
+	}
+	const struct area_entry *e = icp_area_file("CAMERA_ICP.mdt");
+	if (e == NULL || e->size < 52 || e->size > PAGE_SIZE || !icp_area_check(e, (uint8_t *)buf)) {
+		return step_fail("CAMERA_ICP.mdt missing (scripts/camera/extract-icp-fw.sh), too big, or SHA-256 mismatch");
+	}
+	if (kmem_alloc(kernel_map, &m, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS ||
+	    negroni_ufs_adsp_area_read(e->offset, (void *)m, e->size) != 0) {
+		return step_fail("mdt read");
+	}
+	icp_mdt = (uint8_t *)m;
+	icp_mdt_size = e->size;
+	uint32_t phoff, phnum, bytes = 0;
+	memcpy(&phoff, icp_mdt + 28, 4);
+	phnum = (uint32_t)(icp_mdt[44] | icp_mdt[45] << 8);
+	if (memcmp(icp_mdt, "\177ELF\1\1", 6) != 0 || phnum == 0 || phnum > ICP_MAX_SEGS || phoff + 32 * phnum > icp_mdt_size) {
+		return step_fail("CAMERA_ICP.mdt is not an ELF32 LE header");
+	}
+	icp_nseg = phnum;
+	icp_min_pa = ~0u;
+	icp_max_pa = 0;
+	for (uint32_t i = 0; i < icp_nseg; i++) {
+		uint32_t ph[8];
+		memcpy(ph, icp_mdt + phoff + 32 * i, sizeof(ph));
+		icp_segs[i] = (struct icp_seg){ ph[0], ph[1], ph[3], ph[4], ph[5], ph[6] };
+		struct icp_seg *s = &icp_segs[i];
+		if (s->type != 1 || s->memsz == 0 || MDT_TYPE(s->flags) == MDT_TYPE_HASH) {
+			continue;
+		}
+		icp_reloc |= (s->flags & MDT_RELOCATABLE) != 0;
+		icp_min_pa = MIN(icp_min_pa, s->paddr);
+		icp_max_pa = MAX(icp_max_pa, s->paddr + s->memsz);
+		if (s->filesz == 0) {
+			continue;
+		}
+		char name[24];
+		snprintf(name, sizeof(name), "CAMERA_ICP.b%02u", i);
+		const struct area_entry *f = icp_area_file(name);
+		if (f == NULL || f->size != s->filesz || s->filesz > s->memsz || !icp_area_check(f, (uint8_t *)buf)) {
+			say("  %s missing, not %u bytes, or SHA-256 mismatch", name, s->filesz);
+			return step_fail("segment file");
+		}
+		bytes += f->size;
+	}
+	icp_max_pa = (icp_max_pa + 0xfffu) & ~0xfffu;
+	say("  CAMERA_ICP.mdt: %u program headers, load %#x..%#x (%u KiB), %u KiB of segments, %s", icp_nseg, icp_min_pa,
+	    icp_max_pa, (icp_max_pa - icp_min_pa) >> 10, bytes >> 10, icp_reloc ? "relocatable" : "fixed");
+	if (icp_min_pa == ~0u || icp_max_pa - icp_min_pa > CAMERA_REGION_SIZE || (!icp_reloc &&
+	    (icp_min_pa < CAMERA_REGION_PA || icp_max_pa > CAMERA_REGION_PA + CAMERA_REGION_SIZE))) {
+		return step_fail("the image does not fit camera_region");
+	}
+	return step_ok();
+}
