+			hash = i;
+			break;
+		}
+	}
+	if (icp_segs[0].type == 1 || hash == ~0u || ehdr == 0 || (uint64_t)ehdr + icp_segs[hash].filesz > PAGE_SIZE ||
+	    ehdr + icp_segs[hash].filesz != icp_mdt_size) {
+		return step_fail("no ELF-header + hash layout in CAMERA_ICP.mdt");
+	}
