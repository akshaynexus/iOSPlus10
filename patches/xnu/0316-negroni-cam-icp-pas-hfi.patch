+	if (kmem_alloc(kernel_map, &meta, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return step_fail("no memory");
+	}
+	memcpy((void *)meta, icp_mdt, icp_mdt_size);           /* headers + hash, packed (qcom_mdt_read_metadata) */
+	clean_dcache(meta, PAGE_SIZE, FALSE);
