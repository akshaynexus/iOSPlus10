+	for (uint32_t i = 0; i < icp_nseg && ok; i++) {
+		struct icp_seg *s = &icp_segs[i];
+		if (s->type != 1 || s->memsz == 0 || MDT_TYPE(s->flags) == MDT_TYPE_HASH || s->filesz == 0) {
+			continue;
+		}
+		char name[24];
+		snprintf(name, sizeof(name), "CAMERA_ICP.b%02u", i);
+		const struct area_entry *f = icp_area_file(name);
+		uint32_t base = (icp_reloc ? 0 : (uint32_t)(icp_min_pa - CAMERA_REGION_PA)) + (s->paddr - icp_min_pa);
+		for (uint32_t at = 0; f && at < f->size && ok; at += AREA_CHUNK) {
+			uint32_t n = MIN(AREA_CHUNK, f->size - at);
+			if (negroni_ufs_adsp_area_read(f->offset + at, (void *)buf, n) != 0) {
+				ok = false;
+				break;
+			}
+			for (uint32_t t = 0; t < n; t++) {
+				mem[base + at + t] = ((const uint8_t *)buf)[t];
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ml_io_unmap((vm_offset_t)mem, CAMERA_REGION_SIZE);
+	if (!ok) {
+		return step_fail("segment read");
+	}
+	say("  segments written into camera_region %#lx", CAMERA_REGION_PA);
+	answer = ~0ull;
+	if (icp_scm("PAS auth and reset (camera)", SCM_64 | SCM_SIP | SCM_PAS_AUTH_AND_RESET, SCM_ONE_VALUE, PAS_CAMERA, 0, 0,
+	    &answer) != 0 || answer != 0) {
+		return step_fail("PAS auth and reset (33) failed");
+	}
+	say("ICP: qcom_scm_pas_auth_and_reset(33) returned 0: TrustZone started the ICP");
+	return step_ok();
+}
+
+/* queue header word w of queue q, in the uncached view of the HFI block */
+#define QW(q, w)        (*(volatile uint32_t *)(hfi_uc + HFI_OFF_QTBL + 24u + 4u * (HFI_Q_WORDS * (q) + (w))))
+
+/*
+ * cam_hfi_init (hfi.c) with event mode 0 (INTR_MODE, cam_icp_mgr_hfi_init), then HFI_CMD_SYS_INIT
+ * (CAM_ICP_SEND_INIT, lx7_core.c:858-861) and a poll of the message queue for SYS_INIT_DONE.
+ * Addresses are physical: the ICP stream group must be in bypass (level 3) [I: the firmware may expect
+ * IOVAs inside the DT windows (live.dts:22646-22669); then the init response or the queue read fails].
+ */
+static bool
+l6_hfi(void)
+{
+	step_begin("icp hfi init");
+	if (kmem_alloc_contig(kernel_map, &hfi_kva, HFI_BLOCK, 0, (ppnum_t)(atop(0x100000000ull) - 1), 0, KMA_KOBJECT,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		hfi_kva = 0;
+		return step_fail("no HFI memory below 4 GiB");
+	}
+	hfi_pa = kvtophys(hfi_kva);
+	bzero((void *)hfi_kva, HFI_BLOCK);
+	flush_dcache64((addr64_t)hfi_pa, HFI_BLOCK, TRUE);
+	/* from here only the non-cacheable view is used (no cached lines of the block are touched again) */
+	hfi_uc = ml_io_map_unmappable((vm_offset_t)hfi_pa, HFI_BLOCK, 0x6u);
+	icp_csr = icp_csr ? icp_csr : ml_io_map_unmappable(ICP_CSR_PA, 0x1000, CAM_WIMG_IO);
+	if (!hfi_uc || !icp_csr) {
+		return step_fail("map");
+	}
+	volatile uint32_t *qt = (volatile uint32_t *)(hfi_uc + HFI_OFF_QTBL);
+	qt[0] = 0xffffffffu;                            /* qtbl_version */
+	qt[1] = 24u + 4u * 4u * HFI_Q_WORDS;            /* sizeof(struct hfi_qtbl) */
+	qt[2] = 24u;                                    /* qhdr0 offset */
+	qt[3] = 4u * HFI_Q_WORDS;                       /* sizeof(struct hfi_q_hdr) */
+	qt[4] = 3;
+	qt[5] = 3;
+	static const uint32_t qoff[3] = { HFI_OFF_CMDQ, HFI_OFF_MSGQ, HFI_OFF_DBGQ };
+	static const uint32_t qsize[3] = { 4096u >> 2, 4096u >> 2, 102400u >> 2 };
+	for (uint32_t q = 0; q < 3; q++) {
+		QW(q, QH_STATUS) = 1;                   /* QHDR_ACTIVE */
+		QW(q, QH_START) = (uint32_t)hfi_pa + qoff[q];
+		QW(q, QH_QSIZE) = qsize[q];
+		QW(q, QH_PKTSIZE) = 0;
+		QW(q, QH_DROP) = 0;
+		QW(q, QH_READ_IDX) = 0;
+		QW(q, QH_WRITE_IDX) = 0;
+		QW(q, QH_TYPE) = q;                     /* INTR_MODE: Q_CMD / Q_MSG / Q_DBG */
+		QW(q, QH_RX_WM) = 1;
+		QW(q, QH_TX_WM) = q == 2 ? 1024u : 1u;  /* dbg: SET_WM */
+		QW(q, QH_RX_REQ) = q == 2 ? 0u : 1u;
+		QW(q, QH_TX_REQ) = 0;
+		QW(q, QH_RX_IRQ) = 0;
+		QW(q, QH_TX_IRQ) = 0;
+	}
+	*(volatile uint32_t *)(hfi_uc + HFI_OFF_SFR) = 4096;    /* sfr_buf.size */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	vm_offset_t gp = icp_csr;
+	wr(gp + ICP_GP(HFI_QTBL_PTR), (uint32_t)hfi_pa + HFI_OFF_QTBL);
+	wr(gp + ICP_GP(HFI_SFR_PTR), (uint32_t)hfi_pa + HFI_OFF_SFR);
+	wr(gp + ICP_GP(HFI_SHMEM_PTR), (uint32_t)hfi_pa + HFI_OFF_SHMEM);
+	wr(gp + ICP_GP(HFI_SHMEM_SIZE), HFI_SHMEM_LEN);
+	wr(gp + ICP_GP(HFI_SECHEAP_PTR), (uint32_t)hfi_pa + HFI_OFF_SECHEAP);
+	wr(gp + ICP_GP(HFI_SECHEAP_SIZE), HFI_SECHEAP_LEN);
+	wr(gp + ICP_GP(HFI_QDSS_IOVA), 0);
+	wr(gp + ICP_GP(HFI_QDSS_SIZE), 0);
+	wr(gp + ICP_GP(HFI_IO_IOVA), 0x80000000u);      /* [I] DRAM below 4 GiB as the IO window (bypass) */
+	wr(gp + ICP_GP(HFI_IO_SIZE), 0x7ff00000u);
+	wr(gp + ICP_GP(HFI_IO2_IOVA), 0);
+	wr(gp + ICP_GP(HFI_IO2_SIZE), 0);
+	wr(gp + ICP_GP(HFI_FWUNC_IOVA), (uint32_t)hfi_pa + HFI_OFF_FWUNC);
+	wr(gp + ICP_GP(HFI_FWUNC_SIZE), HFI_FWUNC_LEN);
+	wr(gp + ICP_GP(HFI_INIT_REQ), 1);               /* ICP_INIT_REQUEST_SET */
+	uint32_t got = 0;
+	/* HFI_POLL_TIMEOUT_US 1.5 s (hfi.c:37-38) */
+	bool ok = poll(gp + ICP_GP(HFI_INIT_RESP), 0xffffffffu, 1, 1500000, &got);
+	say("  HFI block phys %#llx; INIT_RESPONSE %#x (1 = success, 2 = failed), FW_VERSION %#x, CIRQ ob status %#x, "
+	    "pfault %#x", hfi_pa, got, rd(gp + ICP_GP(HFI_FW_VERSION)), rd(icp_csr + ICP_CIRQ_OFF + CIRQ_OB_STATUS),
+	    rd(icp_csr + ICP_CIRQ_OFF + CIRQ_PFAULT));
+	if (!ok) {
+		const char *sfr = (const char *)(hfi_uc + HFI_OFF_SFR + 4);
+		char text[96];
+		for (uint32_t i = 0; i < sizeof(text) - 1; i++) {
+			char c = sfr[i];
+			text[i] = (c >= 32 && c < 127) ? c : (c == 0 ? 0 : '.');
+			if (c == 0) {
+				break;
+			}
+		}
+		text[sizeof(text) - 1] = 0;
+		say("  ICP SFR (crash reason): \"%s\"", text);
+		return step_fail("no HFI init response");
+	}
+	say("ICP READY: HFI init response SUCCESS, firmware version %#x", rd(gp + ICP_GP(HFI_FW_VERSION)));
+	/* irq enable (cam_lx7_irq_enable): WDT bite 0 + ICP2HOST; the GIC line stays off, the queue is polled */
+	wr(icp_csr + ICP_CIRQ_OFF + CIRQ_OB_MASK, (1u << 4) | (1u << 2));
+	/* HFI_CMD_SYS_INIT: {size 8, pkt_type} into the command queue (hfi_write_cmd), then HOST2ICPINT */
+	volatile uint32_t *cmdq = (volatile uint32_t *)(hfi_uc + HFI_OFF_CMDQ);
+	uint32_t w = QW(0, QH_WRITE_IDX);
+	cmdq[w] = 8;
+	cmdq[w + 1] = HFI_CMD_SYS_INIT;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	QW(0, QH_WRITE_IDX) = w + 2;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(icp_csr + ICP_CIRQ_OFF + CIRQ_HOST2ICP, 1);
+	/* wait for a message: cam_icp_mgr_send_fw_init waits 5 s */
+	uint32_t msg_w = 0;
+	for (uint32_t ms = 0; ms < 5000; ms++) {
+		msg_w = QW(1, QH_WRITE_IDX);
+		if (msg_w != QW(1, QH_READ_IDX)) {
+			break;
+		}
+		delay(1000);
+	}
+	volatile uint32_t *msgq = (volatile uint32_t *)(hfi_uc + HFI_OFF_MSGQ);
+	uint32_t r = QW(1, QH_READ_IDX);
+	if (msg_w == r) {
+		say("  no message from the ICP in 5 s (cmd queue read idx %u, write idx %u)", QW(0, QH_READ_IDX), QW(0, QH_WRITE_IDX));
+		return step_fail("no SYS_INIT_DONE");
+	}
+	uint32_t size = msgq[r % 1024u], type = msgq[(r + 1) % 1024u], err = msgq[(r + 2) % 1024u];
+	say("ICP message: size %u, type %#x (%s), err %#x, num_prop %u", size, type,
+	    type == HFI_MSG_SYS_INIT_DONE ? "HFI_MSG_SYS_INIT_DONE" : "other", err, msgq[(r + 3) % 1024u]);
+	QW(1, QH_READ_IDX) = msg_w;
+	if (type != HFI_MSG_SYS_INIT_DONE || err != 0) {
+		return step_fail("unexpected first message");
+	}
+	return step_ok();
+}
+
+static bool
+l6_icp(void)
+{
+	vm_offset_t buf = 0;
+	bool ok = false;
+	step_begin("icp clocks");
+	if (!rcg_to_xo("cam_cc_icp_clk_src", 0x13108)) {
+		return step_fail("RCG update");
+	}
+	icp_branches_on |= 1u;
+	if (!branch_set("cam_cc_icp_ahb_clk", camcc + 0x13128, true, true)) {
+		return step_fail("icp ahb clock");
+	}
+	icp_branches_on |= 2u;
+	if (!branch_set("cam_cc_icp_clk", camcc + 0x13120, true, true)) {
+		return step_fail("icp clock");
+	}
+	(void)step_ok();
+	if (!dma_ok[1] && smmu_policy != 0) {
+		step_begin("icp dma path");
+		return step_fail("ICP stream group has no bypass (level 3)");
+	}
+	if (kmem_alloc(kernel_map, &buf, AREA_CHUNK, KMA_KOBJECT | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	ok = l6_firmware(buf) && l6_pas(buf) && l6_hfi();
+	kmem_free(kernel_map, buf, AREA_CHUNK);
+	return ok;
+}
