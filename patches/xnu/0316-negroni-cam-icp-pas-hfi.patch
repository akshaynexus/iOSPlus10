+/* PAS init image + mem setup, segments into camera_region, auth and reset (lx7_core.c:528-663) */
+static bool
+l6_pas(vm_offset_t buf)
+{
+	step_begin("icp pas 33");
+	uint64_t answer = ~0ull;
+	uint32_t ehdr = icp_segs[0].filesz, hash = ~0u;
+	for (uint32_t i = 0; i < icp_nseg; i++) {
