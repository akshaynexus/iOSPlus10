 	}
+	if (sctlr != SCTLR_ON) {
+		printf("%s: SMMU context %u SCTLR reads %#x after writing %#x: bits %#x differ outside the fields we own %#x; "
+		    "accepted\n", s->name, s->cb, sctlr, SCTLR_ON, sctlr ^ SCTLR_ON, SCTLR_OWN);
+	}
 	/* the streams: S2CR (translate, context) first, then the SMR; each SMR read again right before */
 	for (uint32_t k = 0; k < s->nstreams; k++) {
 		uint32_t n = s->smr[k], want = SMMU_SMR_VALID | (uint32_t)s->streams[k].mask << 16 | s->streams[k].id, now = ~0u;
@@ -683,7 +709,7 @@ s1_on_locked(struct negroni_s1 *s)
 			return EBUSY;
 		}
 		s->written[k] = true;
-		if ((error = g_put(s, "S2CR", SMMU_S2CR(n), s->cb, ~0u))) {     /* type 0 = translate */
+		if ((error = g_put(s, "S2CR", SMMU_S2CR(n), s->cb, S2CR_OWN))) {        /* type 0 = translate */
 			return error;
 		}
 		if (!s->reused[k] && (error = g_put(s, "SMR", SMMU_SMR(n), want, ~0u))) {
