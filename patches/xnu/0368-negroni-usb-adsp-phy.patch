+/*
+ * 0368: every message on PMIC_RTR_ADSP_APPS during the first 10 s after the first one (the ADSP
+ * start; also the answers to our requests), then notifications and other owners (UCSI 32779,
+ * USBC_PAN 32780 altmode) up to 200 lines: owner, type, opcode, length and the first 5 body words.
+ * Runs under the GLINK lock (printf only).
+ */
+#define RX_LOG_WINDOW_NS        (10ull * NSEC_PER_SEC)
+#define RX_LOG_MAX              200u
+static uint64_t rx_first_ns;
+static uint32_t rx_lines, rx_seen;
+
+static void
+rx_log(const uint8_t *data, uint32_t len)
+{
+	uint32_t w[8] = { 0 };
+	uint64_t t = now_ns();
+
+	if (rx_first_ns == 0) {
+		rx_first_ns = t;
+	}
+	rx_seen++;
+	memcpy(w, data, MIN(len, (uint32_t)sizeof(w)));
+	bool early = t - rx_first_ns < RX_LOG_WINDOW_NS;
+	bool notable = len < sizeof(struct bc_hdr) || w[0] != BC_OWNER || w[2] == BC_NOTIFY_IND;
+	if (!early && !(notable && rx_lines < RX_LOG_MAX)) {
+		return;
+	}
+	rx_lines++;
+	LOG("rx #%u +%llu ms: owner %u type %u opcode 0x%x len %u: %08x %08x %08x %08x %08x%s", rx_seen,
+	    (t - rx_first_ns) / NSEC_PER_MSEC, w[0], w[1], w[2], len, w[3], w[4], w[5], w[6], w[7],
+	    w[0] == BC_OWNER && w[2] == BC_NOTIFY_IND ? " (BC_NOTIFY_IND)" : w[0] != BC_OWNER ? " (not battery_charger)" : "");
+}
+
 static void
 chg_rx(const uint8_t *data, uint32_t len)
 {
 	struct bc_hdr h;
 
+	rx_log(data, len);                      /* 0368 */
 	if (len < sizeof(h)) {
 		stray_count++;
 		return;
