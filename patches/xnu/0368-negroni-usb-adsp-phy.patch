+/*
+ * 0368: the ADSP charger firmware and the HS PHY (README-usb.md "0368").
+ * [V] The ADSP image has a USB PHY utility (adsp.b14 strings, usb_pmic_util_log.c):
+ * usb_hs_phy_reset, usb_hs_phy_set_nondrive_mode, usb_hs_phy_toggle_dp, usb_hs_phy_dp_high,
+ * usb_hs_phy_dp_default_state, usb_hs_phy_enable_clkref ("clk_cnt %d, enable %d") on
+ * gcc_eusb3_0_clkref_en, which is the ref_clk of our PHY (live.dts hsphy@88e3000 clocks
+ * <gcc 0x1f>, gcc-waipio.h 31 = GCC_EUSB3_0_CLKREF_EN, register 0x9c00c). Its BC1.2/APSD,
+ * HVDCP and VOOC detection takes D+/D- from the PHY when the charger PD starts with a cable in.
+ * [V] Android starts the gadget after the ADSP, and dwc3-msm runs the PHY init on every role
+ * change; we start the gadget long before the ADSP and never touched the PHY. [I] So the PHY
+ * stays reset / non-driving / without its reference clock after the ADSP's detection, and the
+ * host sees no device at all.
+ * Here: snapshot of the PHY, its GCC reset and ref clock at the gadget start (the baseline, a
+ * working link), a log of every change (10 ms samples from the ADSP start to 10 s after it is
+ * up), and a repair: PHY init as Linux qcom_snps_hsphy_init (ref clock on, block reset,
+ * register sequence with the baseline's FSEL/REFCLK_SEL/overrides) inside a soft reconnect.
+ */
+#define HSPHY_PA                0x088e3000      /* live.dts hsphy@88e3000 "qcom,usb-hsphy-snps-femto" */
+#define EUD_EN_PA               0x088e2000      /* live.dts hsphy reg "eud_enable_reg" */
+#define GCC_HSPHY_BCR_PA        (GCC_PA + 0x22000)      /* GCC_QUSB2PHY_PRIM_BCR (gcc-sm8450.c, gcc-waipio.c) */
+#define GCC_CLKREF_PAGE         (GCC_PA + 0x9c000)      /* GCC_EUSB3_0_CLKREF_EN at +0xc */
+#define GCC_CLKREF_OFF          0x00c
+/* Linux phy-qcom-snps-femto-v2.c register offsets (the same in ios-flame 0089) */
+#define HP_UTMI_CTRL0   0x3c    /* SLEEPM 0, OPMODE 4:3 (1 = non-driving), TERMSEL 5 */
+#define HP_UTMI_CTRL1   0x40    /* XCVRSEL */
+#define HP_UTMI_CTRL5   0x50    /* POR 1 */
+#define HP_COMMON0      0x54    /* SIDDQ 2, FSEL 6:4 */
+#define HP_COMMON1      0x58    /* VBUSVLDEXTSEL0 4, PLLBTUNE 5 */
+#define HP_COMMON2      0x5c    /* VREGBYPASS 0 */
+#define HP_CTRL1        0x60    /* VBUSVLDEXT0 0 */
+#define HP_CTRL2        0x64    /* USB2_SUSPEND_N 2, USB2_SUSPEND_N_SEL 3 */
+#define HP_X0           0x6c    /* parameter overrides X0..X3 */
+#define HP_CFG0         0x94    /* UTMI_PHY_DATAPATH_CTRL_OVERRIDE_EN 0, UTMI_PHY_CMN_CTRL_OVERRIDE_EN 1 */
+#define HP_REFCLK       0xa0    /* REFCLK_SEL 1:0 */
+static const uint16_t hp_regs[] = { HP_UTMI_CTRL0, HP_UTMI_CTRL1, HP_UTMI_CTRL5, HP_COMMON0, HP_COMMON1,
+	                            HP_COMMON2, HP_CTRL1, HP_CTRL2, HP_X0, HP_X0 + 4, HP_X0 + 8, HP_X0 + 12, HP_CFG0, HP_REFCLK };
+static const char *const hp_names[] = { "utmi0", "utmi1", "utmi5", "common0", "common1", "common2", "ctrl1",
+	                                "ctrl2", "x0", "x1", "x2", "x3", "cfg0", "refclk", "clkref_en", "bcr", "eud_en" };
+#define HP_N            (sizeof(hp_regs) / sizeof(hp_regs[0]))
+#define HP_CLKREF       HP_N            /* snapshot slots after the PHY registers */
+#define HP_BCR          (HP_N + 1)
+#define HP_EUD          (HP_N + 2)
+#define HP_SLOTS        (HP_N + 3)
+_Static_assert(sizeof(hp_names) / sizeof(hp_names[0]) == HP_SLOTS, "0368 PHY slot names");
+/* live.dts hsphy qcom,param-override-seq = <0xe7 0x6c 0x0f 0x70 0x17 0x74 0x03 0x78> (value, offset) */
+static const uint8_t hp_dt_override[4] = { 0xe7, 0x0f, 0x17, 0x03 };
+
+static int ud_phyfix = 1;       /* boot-arg negroniusb_phyfix: 0 log only, 1 repair a changed PHY (default), 2 also re-init 3 s after each ADSP up */
+static int ud_phyfix_ms = 1500; /* boot-arg negroniusb_phyfix_ms: the PHY must stay unchanged this long before a repair */
+static int ud_phyfix_holdoff_s = 5;     /* boot-arg negroniusb_phyfix_holdoff_s: no PHY init until ADSP up + N s (HVDCP holds D+ ~1.25 s) */
+#define HP_MAX_INITS            5       /* PHY inits per ADSP start; then log only (review F3) */
+#define HP_MAX_WINDOW_LINES     200     /* change lines in the 10 ms window (review F4) */
+static struct {
+	vm_offset_t phy, eud, bcr, clkref;
+	bool        ok;                 /* mapped and the baseline taken */
+	bool        reinit_next;        /* the next soft reconnect runs hp_init() */
+	bool        differs;            /* the last sample differs from ref[] */
+	uint32_t    base[HP_SLOTS];     /* at the gadget start: a working link (restore values) */
+	uint32_t    ref[HP_SLOTS];      /* what a repair compares with: base, then the state after the last repair */
+	uint32_t    last[HP_SLOTS];
+	volatile uint64_t adsp_start_at, adsp_up_at;    /* mach_absolute_time (negroni_usb_adsp_event) */
+	volatile bool adsp_seen;
+	uint64_t    next, changed_at, last_repair, forced_for;
+	uint32_t    change_lines, repairs;
+	bool        host_seen;          /* review 2: DSTS.SOFFN changed between two of our samples (a host sends SOFs) */
+	bool        sof_valid;
+	uint32_t    last_sof;
+	uint32_t    start_inits;        /* PHY inits since the last ADSP start (review F3: at most HP_MAX_INITS) */
+	uint32_t    window_lines;       /* change lines in the 10 ms window (review F4: at most HP_MAX_WINDOW_LINES) */
+} hp;
+
+/* the slots a repair looks at: the PHY registers, clkref enable (bit 0) + CLK_OFF (bit 31), BCR (bit 0); not EUD */
+static uint32_t
+hp_cmp_mask(unsigned i)
+{
+	return i < HP_N ? 0xffffffffu : i == HP_CLKREF ? 0x80000001u : i == HP_BCR ? 1u : 0u;
+}
+
+static bool
+hp_same(const uint32_t *a, const uint32_t *b)
+{
+	for (unsigned i = 0; i < HP_SLOTS; i++) {
+		if ((a[i] ^ b[i]) & hp_cmp_mask(i)) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+hp_snap(uint32_t *v)
+{
+	for (unsigned i = 0; i < HP_N; i++) {
+		v[i] = usb_rd(hp.phy, hp_regs[i]);
+	}
+	v[HP_CLKREF] = usb_rd(hp.clkref, GCC_CLKREF_OFF);
+	v[HP_BCR] = usb_rd(hp.bcr, 0);
+	v[HP_EUD] = usb_rd(hp.eud, 0);
+}
+
+static void
+hp_dump(const char *when, const uint32_t *v)
+{
+	printf("NEGRONI USB: PHY %s: utmi0 %x utmi1 %x utmi5 %x common0 %x common1 %x common2 %x ctrl1 %x ctrl2 %x "
+	    "x0-3 %x %x %x %x cfg0 %x refclk %x | clkref_en 0x%08x bcr 0x%x eud_en 0x%x\n", when, v[0], v[1], v[2],
+	    v[3], v[4], v[5], v[6], v[7], v[8], v[9], v[10], v[11], v[12], v[13], v[HP_CLKREF], v[HP_BCR], v[HP_EUD]);
+}
+
+/* ms from t (mach_absolute_time) to now: negative when t is later than now; -1 when t is 0 (not set) */
+static int64_t
+hp_ms_since(uint64_t t, uint64_t now)
+{
+	if (t == 0) {
+		return -1;
+	}
+	return now >= t ? (int64_t)((now - t) * 1000 / ud_abs_ms(1000)) : -(int64_t)((t - now) * 1000 / ud_abs_ms(1000));
+}
+
+/* At the gadget start: map, read the boot-args, take the baseline. */
+static void
+hp_setup(void)
+{
+	PE_parse_boot_argn("negroniusb_phyfix", &ud_phyfix, sizeof(ud_phyfix));
+	PE_parse_boot_argn("negroniusb_phyfix_ms", &ud_phyfix_ms, sizeof(ud_phyfix_ms));
+	PE_parse_boot_argn("negroniusb_phyfix_holdoff_s", &ud_phyfix_holdoff_s, sizeof(ud_phyfix_holdoff_s));
+	if (ud_phyfix_holdoff_s < 0 || ud_phyfix_holdoff_s > 120) {
+		ud_phyfix_holdoff_s = 5;
+	}
+	if (ud_phyfix_ms < 100 || ud_phyfix_ms > 60000) {
+		ud_phyfix_ms = 1500;
+	}
+	hp.phy = ml_io_map(HSPHY_PA, 0x1000);
+	hp.eud = ml_io_map(EUD_EN_PA, 0x1000);
+	hp.bcr = ml_io_map(GCC_HSPHY_BCR_PA, 0x1000);
+	hp.clkref = ml_io_map(GCC_CLKREF_PAGE, 0x1000);
+	if (!hp.phy || !hp.eud || !hp.bcr || !hp.clkref) {
+		printf("NEGRONI USB: PHY watch off: map failed\n");
+		return;
+	}
+	hp_snap(hp.base);
+	memcpy(hp.ref, hp.base, sizeof(hp.ref));
+	memcpy(hp.last, hp.base, sizeof(hp.last));
+	hp.ok = true;
+	hp_dump("baseline at the gadget start", hp.base);
+	printf("NEGRONI USB: PHY watch on: repair %s (negroniusb_phyfix=%d), stable %d ms before a repair (negroniusb_phyfix_ms), "
+	    "hold-off ADSP up + %d s, at most %d PHY inits per ADSP start, host ports only, not during VOOC\n",
+	    ud_phyfix >= 2 ? "on + re-init after each ADSP up" : ud_phyfix ? "on" : "off (log only)", ud_phyfix, ud_phyfix_ms,
+	    ud_phyfix_holdoff_s, HP_MAX_INITS);
+}
+
+static void
+hp_rmw(uint32_t off, uint32_t mask, uint32_t val)
+{
+	uint32_t v = usb_rd(hp.phy, off);
+	*(volatile uint32_t *)(hp.phy + off) = (v & ~mask) | (val & mask);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * Review F2/F3: may the PHY be set up now? Not while the EUD owns the PHY (eud_en bit 0), not before ADSP up +
+ * negroniusb_phyfix_holdoff_s, not while the ADSP's VOOC path is active, only on a host port (the charger client's
+ * adapter type SDP 1 / CDP 3; without that client: a host was seen, SOFs since boot), at most HP_MAX_INITS per
+ * ADSP start. NULL = yes, else the reason.
+ */
+static const char *
+hp_init_blocked(void)
+{
+	struct negroni_chg_glink_status cs;
+	uint64_t now = mach_absolute_time(), up = hp.adsp_up_at;
+
+	if (usb_rd(hp.eud, 0) & 1) {
+		return "the EUD is on (eud_en bit 0)";
+	}
+	if (hp.adsp_start_at != 0 && (up == 0 || now < up + ud_abs_ms((uint64_t)ud_phyfix_holdoff_s * 1000))) {
+		return "ADSP hold-off (up + negroniusb_phyfix_holdoff_s not reached)";
+	}
+	if (hp.start_inits >= HP_MAX_INITS) {
+		return "5 PHY inits since the ADSP start already (log only now)";
+	}
+	if (negroni_chg_glink_get(&cs) && cs.ready) {
+		/* 0369 adds: not while VOOC is active */
+		if (cs.usb_type != 1 && cs.usb_type != 3) {
+			return "the adapter type is not a host port (SDP/CDP)";
+		}
+		return NULL;
+	}
+	return hp.host_seen ? NULL : "no host seen (SOFFN never moved between two samples) and no adapter type";
+}
+
+/*
+ * PHY init as Linux qcom_snps_hsphy_init (phy-qcom-snps-femto-v2.c) after
+ * reset_control_assert/deassert of GCC_QUSB2PHY_PRIM_BCR and with the ref clock on.
+ * FSEL, REFCLK_SEL and the X0..X3 overrides come from the baseline (the firmware's working
+ * setup). Called with the controller halted (soft reconnect); ud_hw_start() follows.
+ */
+static void
+hp_init(void)
+{
+	uint32_t before[HP_SLOTS], after[HP_SLOTS];
+	bool clk_was_off;
+
+	hp_snap(before);
+	clk_was_off = !(before[HP_CLKREF] & 1);
+	if (clk_was_off) {
+		*(volatile uint32_t *)(hp.clkref + GCC_CLKREF_OFF) = before[HP_CLKREF] | 1;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		for (int i = 0; i < 100 && (usb_rd(hp.clkref, GCC_CLKREF_OFF) & 0x80000000u); i++) {
+			ud_udelay(10);
+		}
+	}
+	*(volatile uint32_t *)hp.bcr = usb_rd(hp.bcr, 0) | 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ud_udelay(150);
+	*(volatile uint32_t *)hp.bcr = usb_rd(hp.bcr, 0) & ~1u;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	ud_udelay(150);
+	hp_rmw(HP_CFG0, 1u << 1, 1u << 1);                     /* UTMI_PHY_CMN_CTRL_OVERRIDE_EN */
+	hp_rmw(HP_UTMI_CTRL5, 1u << 1, 1u << 1);               /* POR */
+	hp_rmw(HP_COMMON0, 7u << 4, hp.base[3] & (7u << 4));   /* FSEL */
+	hp_rmw(HP_COMMON1, 1u << 5, 1u << 5);                  /* PLLBTUNE */
+	hp_rmw(HP_REFCLK, 3u, hp.base[13] & 3u);               /* REFCLK_SEL */
+	hp_rmw(HP_COMMON1, 1u << 4, 1u << 4);                  /* VBUSVLDEXTSEL0 */
+	hp_rmw(HP_CTRL1, 1u << 0, 1u << 0);                    /* VBUSVLDEXT0 */
+	for (unsigned i = 0; i < 4; i++) {                     /* parameter overrides (Linux: before VREGBYPASS) */
+		hp_rmw(HP_X0 + 4 * i, 0xffu, hp.base[8 + i] & 0xffu);
+	}
+	hp_rmw(HP_COMMON2, 1u << 0, 1u << 0);                  /* VREGBYPASS */
+	hp_rmw(HP_CTRL2, (1u << 3) | (1u << 2), (1u << 3) | (1u << 2));        /* USB2_SUSPEND_N_SEL | USB2_SUSPEND_N */
+	hp_rmw(HP_UTMI_CTRL0, 1u << 0, 1u << 0);               /* SLEEPM */
+	hp_rmw(HP_COMMON0, 1u << 2, 0);                        /* SIDDQ off */
+	ud_udelay(100);
+	hp_rmw(HP_UTMI_CTRL5, 1u << 1, 0);                     /* POR release */
+	hp_rmw(HP_CTRL2, 1u << 3, 0);                          /* USB2_SUSPEND_N_SEL off */
+	hp_rmw(HP_CFG0, 3u, hp.base[12] & 3u);                 /* override enables as at the baseline (Linux: CMN off) */
+	ud_udelay(1000);
+	hp_snap(after);
+	hp.repairs++;
+	hp.start_inits++;
+	if (hp.repairs <= 10 || hp.repairs % 10 == 0) {
+		hp_dump("before the re-init", before);
+		hp_dump("after the re-init", after);
+		printf("NEGRONI USB: PHY re-init #%u (%u since the ADSP start): ref clock %s, block reset, Linux init sequence, "
+		    "cfg0 datapath override (bit 0) %u -> %u (overrides x0-3 %x %x %x %x; DT has %x %x %x %x)\n",
+		    hp.repairs, hp.start_inits, clk_was_off ? "was OFF, now on" : "on", before[12] & 1, after[12] & 1,
+		    after[8], after[9], after[10], after[11],
+		    hp_dt_override[0], hp_dt_override[1], hp_dt_override[2], hp_dt_override[3]);
+	}
+	memcpy(hp.ref, after, sizeof(hp.ref));
+	memcpy(hp.last, after, sizeof(hp.last));
+	hp.differs = false;
+}
+
+/*
+ * 0368: called by negroni_adsp.c: 0 = the ADSP is about to start (PAS auth and reset), 1 = it is
+ * up (READY), 2 = it stopped or failed. Only timestamps and one snapshot line (no writes).
+ */
+void negroni_usb_adsp_event(int what);
+void
+negroni_usb_adsp_event(int what)
+{
+	uint32_t v[HP_SLOTS];
+
+	if (!hp.ok) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (what == 0) {
+		hp.adsp_start_at = now;
+		hp.adsp_up_at = 0;
+		hp.adsp_seen = true;
+		hp.start_inits = 0;
+		hp.window_lines = 0;
+	} else if (what == 1) {
+		hp.adsp_up_at = now;
+	}
+	hp_snap(v);
+	hp_dump(what == 0 ? "at the ADSP start" : what == 1 ? "at ADSP up" : "at the ADSP stop", v);
+}
+
