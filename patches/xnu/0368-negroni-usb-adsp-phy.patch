+			    hp_ms_since(st, now), hp_ms_since(up, now));
+			for (unsigned i = 0; i < HP_SLOTS && n > 0 && n < (int)sizeof(line) - 40; i++) {
+				if (v[i] != hp.last[i]) {
+					n += snprintf(line + n, sizeof(line) - n, " %s %x->%x", hp_names[i], hp.last[i], v[i]);
+				}
+			}
+			printf("%s\n", line);
+		}
+		hp.change_lines++;
