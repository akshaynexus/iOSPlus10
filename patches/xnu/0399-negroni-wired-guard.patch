+/*
+ * Patch 0399: wired memory guard (NegroniGPU.h NegroniWiredAllow). Freeze of 2026-10-27 20:24 and
+ * 20:36 (Safari video, logs/usblog-20261027-171256.txt): VM_pageout_scan / VM_compressor /
+ * VM_pageout_external_iothread at 60-80 % of a CPU each, then every user thread at 0 %: the
+ * pageable memory was gone. Surfaces (up to 1536 MiB) and every GPU client (1024 MiB own + 1024 MiB
+ * host imports) may wire far more than the 3072 MiB this kernel has, and no footprint counts it.
+ * The guard keeps the system's wired pages at or below NEGRONI_WIRED_GUARD_PERCENT of max_mem.
+ * Compressor pages are not in vm_page_wire_count (VM_PAGE_USED_BY_COMPRESSOR), the GPU pool and the
+ * display slots are outside the kernel's RAM, so the count is wired kernel and driver memory.
+ */
+extern "C" unsigned int vm_page_wire_count;
+extern "C" unsigned int vm_page_free_count;
+/* max_mem: mach/vm_param.h */
+static uint64_t      negroni_wired_limit;          /* bytes; 0 = guard off (not started, or negroniwiredguard=0) */
+static uint32_t      negroni_wired_refusals;
+static bool          negroni_wired_near;           /* the one "near the limit" line was logged */
+
+static void
+negroni_wired_guard_start(void)
+{
+	uint32_t on = 1;
+	uint64_t wired = (uint64_t)vm_page_wire_count * PAGE_SIZE;
+
+	PE_parse_boot_argn("negroniwiredguard", &on, sizeof(on));
+	if (!on) {
+		IOLog("NEGRONI WIRED: off: negroniwiredguard=0\n");
+		return;
+	}
+	uint64_t limit = max_mem / 100 * NEGRONI_WIRED_GUARD_PERCENT;
+	if (max_mem == 0 || vm_page_wire_count == 0 || wired >= limit) {
+		IOLog("NEGRONI WIRED: off: max_mem %llu MiB, %llu MiB wired at start (limit %u%%)\n",
+		    max_mem >> 20, wired >> 20, NEGRONI_WIRED_GUARD_PERCENT);
+		return;
+	}
+	__atomic_store_n(&negroni_wired_limit, limit, __ATOMIC_RELEASE);
+	IOLog("NEGRONI WIRED: guard on: surfaces, GPU buffers and host imports refused above %llu MiB wired "
+	    "(%u%% of %llu MiB; backboardd and SpringBoard up to %u%%); %llu MiB wired, %llu MiB free now; "
+	    "negroniwiredguard=0 = off\n",
+	    limit >> 20, NEGRONI_WIRED_GUARD_PERCENT, max_mem >> 20, NEGRONI_WIRED_GUARD_UI_PERCENT, wired >> 20,
+	    ((uint64_t)vm_page_free_count * PAGE_SIZE) >> 20);
+}
+
+bool
+NegroniWiredAllow(uint64_t bytes, const char *who, const char *what)
+{
+	uint64_t limit = __atomic_load_n(&negroni_wired_limit, __ATOMIC_ACQUIRE);
+
+	if (limit == 0) {
+		return true;
+	}
+	/*
+	 * The UI shell keeps a reserve above the limit: backboardd's render targets and SpringBoard's
+	 * surfaces are what the screen needs; a refusal there is a black screen or a respring loop,
+	 * while a refused app (WebKit, an extension) takes its other path or exits.
+	 */
+	if (who != NULL && (strcmp(who, "backboardd") == 0 || strcmp(who, "SpringBoard") == 0)) {
+		limit = max_mem / 100 * NEGRONI_WIRED_GUARD_UI_PERCENT;
+	}
+	uint64_t wired = (uint64_t)vm_page_wire_count * PAGE_SIZE;
+	if (wired + bytes <= limit) {
+		if (wired + bytes > limit / 10 * 9 && !__atomic_exchange_n(&negroni_wired_near, true, __ATOMIC_RELAXED)) {
+			IOLog("NEGRONI WIRED: near the limit: %s of %llu KiB for %s: %llu MiB wired, limit %llu MiB, "
+			    "surfaces %llu MiB (once per boot)\n", what, bytes >> 10, who != NULL ? who : "?", wired >> 20,
+			    limit >> 20, __atomic_load_n(&negroni_surface_wired, __ATOMIC_RELAXED) >> 20);
+		}
+		return true;
+	}
+	uint32_t n = OSIncrementAtomic((volatile SInt32 *)&negroni_wired_refusals) + 1;
+	if (n <= 8 || (n & 255) == 0) {
+		IOLog("NEGRONI WIRED: refused %s of %llu KiB for %s: %llu MiB wired, limit %llu MiB, %llu MiB free, "
+		    "surfaces %llu MiB (refusal %u)\n", what, bytes >> 10, who != NULL ? who : "?", wired >> 20,
+		    limit >> 20, ((uint64_t)vm_page_free_count * PAGE_SIZE) >> 20,
+		    __atomic_load_n(&negroni_surface_wired, __ATOMIC_RELAXED) >> 20, n);
+	}
+	return false;
+}
