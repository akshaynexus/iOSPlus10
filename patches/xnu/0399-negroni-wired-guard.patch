+/*
+ * 0399 (wired memory guard, NegroniSurface.cpp): IOSurfaces, RedwoodGPU buffers of their own and
+ * host imports are wired pages that no task footprint counts, so jetsam never frees them. true when
+ * bytes more wired pages keep the system's wired count (vm_page_wire_count) at or below
+ * NEGRONI_WIRED_GUARD_PERCENT of max_mem (NEGRONI_WIRED_GUARD_UI_PERCENT when who is backboardd or
+ * SpringBoard); one "NEGRONI WIRED: near the limit" line per boot at 90 % of it; else one rate-limited
+ * "NEGRONI WIRED: refused" line and
+ * false (the caller answers kIOReturnNoMemory). Always true before IOCoreSurfaceRoot started and with
+ * boot-arg negroniwiredguard=0 (kill switch).
+ */
+#define NEGRONI_WIRED_GUARD_PERCENT 55
+#define NEGRONI_WIRED_GUARD_UI_PERCENT 65       /* backboardd and SpringBoard (who): a reserve above the limit */
+bool NegroniWiredAllow(uint64_t bytes, const char *who, const char *what);
+
 #endif /* NEGRONI */
 #endif /* _NEGRONI_GPU_H */
