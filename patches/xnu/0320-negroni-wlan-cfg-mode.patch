+/* ---- HAL SRNG register map of the CE rings (wcn6855_regs, hal.h:43-60, :198-204) ---- */
+#define HAL_CE0_SRC_R0          0x01b80000u     /* hal_seq_wcss_umac_ce0_src_reg */
+#define HAL_CE0_DST_R0          0x01b81000u     /* hal_seq_wcss_umac_ce0_dst_reg */
+#define HAL_CE_STRIDE           0x2000u         /* ce1_src_reg - ce0_src_reg */
