+/*
+ * NEGRONI QCA6490 Wi-Fi: copy engine (CE) layout shared by the QMI WLAN_CFG message (patch 0320)
+ * and the CE/HAL SRNG code (patch 0321).
+ *
+ * Values only (no code) from Linux ath11k (BSD-3-Clause-Clear): hw.c
+ * ath11k_target_ce_config_wlan_qca6390 / ath11k_target_service_to_ce_map_wlan_qca6390 (used by the
+ * wcn6855 hw2.0/2.1 hw_params, core.c:412-577; PCI id 17cb:1103 = WCN6855, pci.c:32), hw.c
+ * wcn6855_regs, hal.h, hal.c ath11k_hal_srng_create_config / hw_srng_config_template, ce.c
+ * ath11k_ce_get_shadow_config (non-CE rings first, then the CE rings of the host CE table).
+ */
+#ifndef _NEGRONI_WLAN_CE_H_
+#define _NEGRONI_WLAN_CE_H_
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+
+#include <stdint.h>
+#include <stdbool.h>
+
+/* ---- register window (pcic.h:17-21, pci.c:75-128): BAR0 offsets >= 0x80000 go through it ---- */
+#define WLAN_WINDOW_REG         0x310cu         /* window select register in BAR0 */
+#define WLAN_WINDOW_ENABLE      0x40000000u
+#define WLAN_WINDOW_START       0x80000u        /* the 512 KiB window in BAR0 */
+#define WLAN_WINDOW_RANGE       0x7ffffu        /* offset bits 18:0 */
+#define WLAN_WINDOW_SHIFT       19u             /* window value = offset bits 24:19 */
+#define WLAN_WINDOW_VALUE       0x3fu
+
+/* ---- pipe directions (ce.h:42-46) and service ids (htc.h:158-195, SVC(g, i) = g << 8 | i) ---- */
+#define WLAN_PIPEDIR_NONE       0u
+#define WLAN_PIPEDIR_IN         1u      /* target -> host */
+#define WLAN_PIPEDIR_OUT        2u      /* host -> target */
+#define WLAN_PIPEDIR_INOUT      3u
+#define WLAN_PIPEDIR_INOUT_H2H  4u
+#define WLAN_CE_ATTR_DIS_INTR   8u      /* ce.h:16 (CE_ATTR_FLAGS = 0 on little endian, ce.h:22) */
+
+#define HTC_SVC_RSVD_CTRL       0x0001u
+#define HTC_SVC_WMI_CONTROL     0x0100u
+#define HTC_SVC_WMI_DATA_BE     0x0101u
+#define HTC_SVC_WMI_DATA_BK     0x0102u
+#define HTC_SVC_WMI_DATA_VI     0x0103u
+#define HTC_SVC_WMI_DATA_VO     0x0104u
+#define HTC_SVC_HTT_DATA        0x0300u
+
+/* target CE configuration (WLAN_CFG tgt_cfg), hw.c:1623-1714 */
+struct wlan_ce_tgt {
+	uint32_t pipe, dir, nentries, nbytes_max, flags;
+};
+#define WLAN_CE_TGT_N           9u
+static const struct wlan_ce_tgt wlan_ce_tgt_cfg[WLAN_CE_TGT_N] = {
+	{ 0, WLAN_PIPEDIR_OUT, 32, 2048, 0 },                           /* host->target HTC control */
+	{ 1, WLAN_PIPEDIR_IN, 32, 2048, 0 },                            /* target->host HTT + HTC control */
+	{ 2, WLAN_PIPEDIR_IN, 32, 2048, 0 },                            /* target->host WMI */
+	{ 3, WLAN_PIPEDIR_OUT, 32, 2048, 0 },                           /* host->target WMI */
+	{ 4, WLAN_PIPEDIR_OUT, 256, 256, WLAN_CE_ATTR_DIS_INTR },       /* host->target HTT */
+	{ 5, WLAN_PIPEDIR_IN, 32, 2048, 0 },                            /* target->host pktlog */
+	{ 6, WLAN_PIPEDIR_INOUT, 32, 16384, 0 },                        /* target autonomous hif_memcpy */
+	{ 7, WLAN_PIPEDIR_INOUT_H2H, 0, 0, WLAN_CE_ATTR_DIS_INTR },     /* host only */
+	{ 8, WLAN_PIPEDIR_INOUT, 32, 16384, 0 },                        /* IPA */
+};
+
+/* service -> pipe map (WLAN_CFG svc_cfg), hw.c:1720-1800 (14 entries, no terminator) */
+struct wlan_ce_svc {
+	uint32_t service, dir, pipe;
+};
+#define WLAN_CE_SVC_N           14u
+static const struct wlan_ce_svc wlan_ce_svc_map[WLAN_CE_SVC_N] = {
+	{ HTC_SVC_WMI_DATA_VO, WLAN_PIPEDIR_OUT, 3 }, { HTC_SVC_WMI_DATA_VO, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_WMI_DATA_BK, WLAN_PIPEDIR_OUT, 3 }, { HTC_SVC_WMI_DATA_BK, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_WMI_DATA_BE, WLAN_PIPEDIR_OUT, 3 }, { HTC_SVC_WMI_DATA_BE, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_WMI_DATA_VI, WLAN_PIPEDIR_OUT, 3 }, { HTC_SVC_WMI_DATA_VI, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_WMI_CONTROL, WLAN_PIPEDIR_OUT, 3 }, { HTC_SVC_WMI_CONTROL, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_RSVD_CTRL, WLAN_PIPEDIR_OUT, 0 }, { HTC_SVC_RSVD_CTRL, WLAN_PIPEDIR_IN, 2 },
+	{ HTC_SVC_HTT_DATA, WLAN_PIPEDIR_OUT, 4 }, { HTC_SVC_HTT_DATA, WLAN_PIPEDIR_IN, 1 },
+};
