+/*
+ * 0320 keep-alive (audit 2026-10-26 section 2.4): after the last asked level the thread stays and drains the
+ * event rings every 20 ms (sleeping, not spinning), so the chip never stalls on a full IPCR ring, M1 gets its
+ * answer and late QMI indications are seen. negroniwlan_keep=S stops it after S seconds (0 = until the chip
+ * stops). A chip error here takes the normal failure path (MHI reset, bus master off, then free).
+ */
+static int
+wlan_keep_alive(void)
+{
+	uint64_t start = negroni_wlan_ms(), next_log = start + 60000;
+	uint32_t ev0 = H.events, rx0 = H.rx_packets;
+	int error;
+
+	printf("NEGRONI WLAN: keep-alive poller on (20 ms, %s)\n", g_keep_s ? "negroniwlan_keep seconds" :
+	    "until a chip error");
+	for (;;) {
+		error = negroni_wlan_service();
+		if (error) {
+			printf("NEGRONI WLAN: keep-alive: the chip stopped after %llu s (MHISTATUS %#x, EE %u)\n",
+			    (negroni_wlan_ms() - start) / 1000, negroni_wlan_rd(MHI_STATUS), H.ee);
+			return error;
+		}
+		if (negroni_qrtr.attached) {
+			negroni_wlan_wlfw_idle();
+		}
+		uint64_t now = negroni_wlan_ms();
+		if (now >= next_log) {
+			next_log = now + 60000;
+			printf("NEGRONI WLAN: keep-alive %llu s: %u MHI events, %u IPCR packets, %u M1 seen\n",
+			    (now - start) / 1000, H.events - ev0, H.rx_packets - rx0, H.m1_seen);
+		}
+		if (g_keep_s && now - start >= (uint64_t)g_keep_s * 1000) {
+			printf("NEGRONI WLAN: keep-alive ends after %u s (negroniwlan_keep); the chip keeps running\n", g_keep_s);
+			return 0;
+		}
+		negroni_wlan_nap(20);
+	}
+}
