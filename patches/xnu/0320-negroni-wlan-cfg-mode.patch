+#define HAL_CE_DST_RING_CTRL    0xb0u           /* MAX_LEN in bits 15:0 */
+#define HAL_CE_RING_HP          0x400u          /* HAL_CE_DST_RING_HP (R2 group) */
+#define HAL_CE_STATUS_RING_HP   0x408u          /* HAL_CE_DST_STATUS_RING_HP */
+#define HAL_HP_TO_TP            4u              /* HAL_OFFSET_FROM_HP_TO_TP */
+#define HAL_SHADOW_BASE         0x8fcu          /* wcn6855 hal_shadow_base_addr */
+#define HAL_SHADOW_REG(i)       (HAL_SHADOW_BASE + 4u * (i))
+#define HAL_SHADOW_MAX          36u             /* HAL_SHADOW_NUM_REGS = QMI v01 shadow_reg_v2 max */
+
+/* ring ids (hal.h:333-398): the slot of a ring's HW-written pointer in the read-pointer area */
+#define HAL_RING_ID_CE_SRC(n)   (32u + (n))
+#define HAL_RING_ID_CE_DST(n)   (56u + (n))
+#define HAL_RING_ID_CE_STS(n)   (80u + (n))
+#define HAL_RING_ID_MAX         128u
+
+/*
+ * Shadow register v2 list as ath11k builds it for wcn6855 (ce.c:840-862): first every non-CE,
+ * non-LMAC ring of hw_srng_config_template in type order (hal.c:13-192; for a source ring the HP
+ * register, for a destination ring HP + 4 = TP), then for each host CE with src entries its
+ * CE_SRC HP and with dst entries its CE_DST HP and CE_DST_STATUS TP (ce.c:821-838, host CE table
+ * ce.c:118-189: src on CE 0/3/4/7, dst on CE 1/2/5). Index i of this list is the host's shadow
+ * register HAL_SHADOW_REG(i); the firmware copies a write there to the target register.
+ */
+#define WLAN_SHADOW_N           30u
+static const uint32_t wlan_shadow_v2[WLAN_SHADOW_N] = {
+	/* REO_DST x4 (REO 0xa38000 + reo1_ring_hp 0x3030, stride 8, + TP) */
+	0x00a3b034u, 0x00a3b03cu, 0x00a3b044u, 0x00a3b04cu,
+	0x00a3b064u,    /* REO_EXCEPTION (reo_tcl_ring_hp 0x3060 + TP) */
+	0x00a3b028u,    /* REO_REINJECT (sw2reo_ring_hp 0x3028) */
+	0x00a3b020u,    /* REO_CMD (reo_cmd_ring_hp 0x3020) */
+	0x00a3b07cu,    /* REO_STATUS (reo_status_hp 0x3078 + TP) */
+	/* TCL_DATA x3 (TCL 0xa44000 + 0x2000, stride 8) */
+	0x00a46000u, 0x00a46008u, 0x00a46010u,
+	0x00a46018u,    /* TCL_CMD (0x2018) */
+	0x00a46034u,    /* TCL_STATUS (0x2030 + TP) */
+	0x00a370b0u,    /* WBM_IDLE_LINK (WBM 0xa34000 + 0x30b0) */
+	0x00a37018u,    /* SW2WBM_RELEASE (0x3018) */
+	/* WBM2SW_RELEASE x5 (0x30c0, stride 8, + TP) */
+	0x00a370c4u, 0x00a370ccu, 0x00a370d4u, 0x00a370dcu, 0x00a370e4u,
+	/* CE rings, host CE order */
+	0x01b80400u,    /* 20: CE0 SRC HP */
+	0x01b83400u,    /* 21: CE1 DST HP */
+	0x01b8340cu,    /* 22: CE1 DST_STATUS TP */
+	0x01b85400u,    /* 23: CE2 DST HP */
+	0x01b8540cu,    /* 24: CE2 DST_STATUS TP */
+	0x01b86400u,    /* 25: CE3 SRC HP */
+	0x01b88400u,    /* 26: CE4 SRC HP */
+	0x01b8b400u,    /* 27: CE5 DST HP */
+	0x01b8b40cu,    /* 28: CE5 DST_STATUS TP */
+	0x01b8e400u,    /* 29: CE7 SRC HP */
+};
+_Static_assert(WLAN_SHADOW_N <= HAL_SHADOW_MAX, "shadow list longer than the v01 maximum");
+/* shadow indexes of the CE rings this driver runs (0321) */
+#define WLAN_SHADOW_CE0_SRC     20u
+#define WLAN_SHADOW_CE1_DST     21u
+#define WLAN_SHADOW_CE1_STS     22u
+#define WLAN_SHADOW_CE2_DST     23u
+#define WLAN_SHADOW_CE2_STS     24u
+#define WLAN_SHADOW_CE3_SRC     25u
+
