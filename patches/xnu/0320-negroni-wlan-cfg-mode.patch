+void
+negroni_wlan_add_poller(void (*fn)(void))
+{
+	for (uint32_t i = 0; i < WLAN_POLLERS; i++) {
+		if (g_pollers[i] == fn) {
+			return;
+		}
+		if (!g_pollers[i]) {
+			g_pollers[i] = fn;
+			return;
+		}
+	}
+	printf("NEGRONI WLAN: no poller slot left\n");
+}
