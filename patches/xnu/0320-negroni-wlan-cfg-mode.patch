+/*
+ * Level 7 (0320): steps 25-26, ath11k qmi.c:2841-2869 ath11k_qmi_firmware_start (core.c:2242-2256 builds the
+ * shadow list first). WLAN_CFG carries the target CE pipes, the service -> pipe map and the shadow register v2
+ * list (negroni_wlan_ce.h); WLAN_MODE MISSION starts the WLAN firmware. ath11k sends WLAN_INI (enablefwlog)
+ * first for wcn6855 (fw_wmi_diag_event); we do not: the cnss2 v01 table has no WLAN_INI message and its only
+ * effect is firmware log events over WMI.
+ */
+static struct wlfw_wlan_cfg_req g_cfg;
+
+int
+negroni_wlan_wlfw_start(struct mhi_host *h)
+{
+	struct wlfw_resp_only r;
+	int error;
+
+	W.h = h;
+	negroni_qrtr.data_cb = wlfw_data;
+
+	negroni_wlan_step(25, "WLFW WLAN_CFG");
+	memset(&g_cfg, 0, sizeof(g_cfg));
+	g_cfg.host_version_valid = 1;
+	strlcpy(g_cfg.host_version, WLFW_HOST_VERSION, sizeof(g_cfg.host_version));
+	g_cfg.tgt_cfg_valid = 1;
+	g_cfg.tgt_cfg_len = WLAN_CE_TGT_N;
+	for (uint32_t i = 0; i < WLAN_CE_TGT_N; i++) {
+		g_cfg.tgt_cfg[i].pipe_num = wlan_ce_tgt_cfg[i].pipe;
+		g_cfg.tgt_cfg[i].pipe_dir = wlan_ce_tgt_cfg[i].dir;
+		g_cfg.tgt_cfg[i].nentries = wlan_ce_tgt_cfg[i].nentries;
+		g_cfg.tgt_cfg[i].nbytes_max = wlan_ce_tgt_cfg[i].nbytes_max;
+		g_cfg.tgt_cfg[i].flags = wlan_ce_tgt_cfg[i].flags;
+	}
+	g_cfg.svc_cfg_valid = 1;
+	g_cfg.svc_cfg_len = WLAN_CE_SVC_N;
+	for (uint32_t i = 0; i < WLAN_CE_SVC_N; i++) {
+		g_cfg.svc_cfg[i].service_id = wlan_ce_svc_map[i].service;
+		g_cfg.svc_cfg[i].pipe_dir = wlan_ce_svc_map[i].dir;
+		g_cfg.svc_cfg[i].pipe_num = wlan_ce_svc_map[i].pipe;
+	}
+	g_cfg.shadow_reg_v2_valid = 1;
+	g_cfg.shadow_reg_v2_len = WLAN_SHADOW_N;
+	memcpy(g_cfg.shadow_reg_v2, wlan_shadow_v2, sizeof(wlan_shadow_v2));
+	printf("NEGRONI WLAN: WLAN_CFG host \"%s\", %u CE pipes, %u service routes, %u shadow registers v2 "
+	    "(CE0 src -> shadow %u at BAR0 %#x)\n", g_cfg.host_version, WLAN_CE_TGT_N, WLAN_CE_SVC_N, WLAN_SHADOW_N,
+	    WLAN_SHADOW_CE0_SRC, HAL_SHADOW_REG(WLAN_SHADOW_CE0_SRC));
+	error = wlfw_txn(&wlfw_wlan_cfg_req_d, &g_cfg, &wlfw_wlan_cfg_resp_d, &r, false, false);
+	if (error) {
+		return error;
+	}
+
+	negroni_wlan_step(26, "WLFW WLAN_MODE mission");
+	{
+		struct wlfw_wlan_mode_req q = { .mode = WLFW_MODE_MISSION, .hw_debug_valid = 1, .hw_debug = 0 };
+
+		error = wlfw_txn(&wlfw_wlan_mode_req_d, &q, &wlfw_wlan_mode_resp_d, &r, false, false);
+		if (error) {
+			return error;
+		}
+	}
+	printf("NEGRONI WLAN: WLAN firmware in mission mode (ath11k: copy engines next)\n");
+	return 0;
+}
+
+/* keep-alive (0320): QMI indications that arrive after level 6 are logged once each */
+void
+negroni_wlan_wlfw_idle(void)
+{
+	static bool cal_logged, ready_logged;
+
+	if (W.cal_done && !cal_logged) {
+		cal_logged = true;
+		printf("NEGRONI WLAN: QMI CAL_DONE_IND seen\n");
+	}
+	if (W.fw_ready && !ready_logged) {
+		ready_logged = true;
+		printf("NEGRONI WLAN: QMI FW_READY_IND seen\n");
+	}
+	if (W.req_mem) {
+		W.req_mem = false;
+		printf("NEGRONI WLAN: QMI REQUEST_MEM_IND after level 6 (%u segments); not answered\n", W.mem.mem_seg_len);
+	}
+}
