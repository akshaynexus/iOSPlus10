+/* 0320: MHI events + QRTR (QMI) + later pollers; EIO when the chip stopped (SYSERR, RDDM, dead link) */
+int
+negroni_wlan_service(void)
+{
+	int error;
+
+	if (negroni_qrtr.attached) {
+		error = negroni_wlan_qrtr_pump(&H);
+	} else {
+		(void)negroni_wlan_mhi_poll(&H);
+		uint32_t st = negroni_wlan_rd(MHI_STATUS);
+		error = (H.syserr || H.rddm_seen || st == MHI_ALL_ONES || (st & MHI_STATUS_SYSERR)) ? EIO : 0;
+	}
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < WLAN_POLLERS && g_pollers[i]; i++) {
+		g_pollers[i]();
+	}
+	return 0;
+}
