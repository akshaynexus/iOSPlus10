+/*
+ * ---- 0366: reconnect after unplug ----
+ *
+ * The driver forces VBUS valid in QSCRATCH (no charger driver tells it about
+ * the cable), so the controller never sees the cable go: no disconnect
+ * event. It only sees the bus go idle (USB 2.0 suspend, L2), and with the
+ * old DEVTEN 0x7 not even that. Before this patch a bus reset only cleared
+ * DALEPENA: the RX ring (0361, always active), a TX batch and a CDC
+ * notification stayed active in the controller, and nothing ever retried
+ * when the host did not come back. Now, as Linux dwc3 gadget.c:
+ *   - bus reset, disconnect, SET_CONFIGURATION(0): ENDTRANSFER (FORCERM) on
+ *     every active data transfer, ep0 back to the setup phase
+ *     (dwc3_gadget_reset_interrupt, dwc3_stop_active_transfers,
+ *     dwc3_ep0_reset_state); SET_CONFIGURATION(1) sets everything up again;
+ *   - more device events (wakeup, U3/L2 suspend, erratic error), each type
+ *     logged (rate-limited);
+ *   - GUSB2PHYCFG SUSPHY and ENBLSLPM cleared (sm8450.dtsi
+ *     snps,dis_u2_susphy_quirk + snps,dis_enblslpm_quirk);
+ *   - a watchdog (ud_link_watch, every 100 ms from ud_thread and the panic
+ *     loop) reads DSTS: no SOF for negroniusb_reconnect s (default 5), or a
+ *     device event that brought no SOF within 1 s (once per episode), means the host is gone or
+ *     did not get the device: soft disconnect + soft connect
+ *     (dwc3_gadget_soft_disconnect / _soft_connect: ENDTRANSFER, RUN_STOP 0,
+ *     wait for the halt, pull-up off 100 ms, core soft reset, event buffer,
+ *     ep0, RUN_STOP 1). The host sees a fresh attach. Then again every
+ *     negroniusb_reconnect s (6x as long after 12 tries in one episode, or
+ *     at once while configured in L2: a sleeping host) until SOFs come.
+ */
+static uint64_t
+ud_abs_ms(uint64_t ms)
+{
+	uint64_t abs;
+	nanoseconds_to_absolutetime(ms * NSEC_PER_MSEC, &abs);
+	return abs;
+}
+
+static const char *
+ud_link_name(uint32_t l)
+{
+	switch (l) {
+	case 0: return "on";
+	case 2: return "sleep L1";
+	case 3: return "suspend L2";
+	case 4: return "disconnected";
+	case 5: return "early suspend";
+	case 14: return "reset";
+	case 15: return "resume";
+	default: return "?";
+	}
+}
+
+/* Device event type t happened: true = log it (the first 8 of each type, then every 100th). */
+static bool
+ud_devevent_note(unsigned t)
+{
+	uint32_t n = ++ud.devevents[t & 15];
+	return n <= 8 || (n % 100) == 0;
+}
+
+/*
+ * ENDTRANSFER on physical endpoint ep if a transfer is active. Data
+ * endpoints: FORCERM (Linux dwc3_stop_active_transfer); ep0/ep1: CMDIOC
+ * without FORCERM (Linux dwc3_ep0_end_control_data; the completion event is
+ * not used). Then 1 ms before the next command on that endpoint: Linux
+ * mdelay(1) for a DWC_usb31 without GUCTL2[14] (the end may still be in
+ * progress when the command bit clears).
+ */
+static void
+ud_end_transfer(unsigned ep)
+{
+	if (ep >= 6 || !ud.ep_busy[ep]) {
+		return;
+	}
+	ud.ep_busy[ep] = false;
+	uint32_t flags = ep <= 1 ? DEPCMD_CMDIOC : DEPCMD_FORCERM;
+	(void)ud_epcmd(ep, DEPCMD_ENDTRANSFER | flags | (ud.ep_rsc[ep] << 16), 0, 0, 0);
+	ud_udelay(1000);
+}
+
+/*
+ * Bus reset, disconnect, SET_CONFIGURATION(0), soft reconnect: every data
+ * transfer ended, the data endpoints off, "not configured". Also from the
+ * panic loop (no lock there).
+ */
+static void
+ud_drop_data(void)
+{
+	bool was = ud.configured;
+
+	if (!ud_in_panic) {
+		lck_mtx_lock(ud.lock);
+	}
+	ud.configured = false;          /* ud_if_output and ud_tx_kick_locked stop here */
+	if (ud_reset_end) {
+		ud_end_transfer(EP_TX);
+	}
+	ud.tx_busy = false;
+	ud.tx_batch = false;
+	if (!ud_in_panic) {
+		lck_mtx_unlock(ud.lock);
+	}
+	if (ud_reset_end) {
+		ud_end_transfer(EP_RX);
+		ud_end_transfer(EP_INT);
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud.rx_started = false;          /* 0361: SET_CONFIGURATION starts the ring again */
+	ud.data_alt = 0;
+	if (was) {
+		ud_link_event(false);
+	}
+}
+
+/* ep0 back to the setup phase (Linux dwc3_ep0_reset_state: end the control transfer, stall, restart). */
+static void
+ud_ep0_reset(void)
+{
+	if (ud.state == EP0_SETUP || !ud_reset_end) {
+		return;
+	}
+	printf("NEGRONI USB: ep0 was in state %d: control transfer ended, setup phase again\n", (int)ud.state);
+	ud_end_transfer(0);
+	ud_end_transfer(1);
+	ud_stall();
+}
+
+/*
+ * Device controller start: from negroni_usb_gadget_start() and after a soft
+ * disconnect (Linux dwc3_gadget_soft_connect: core soft reset, event
+ * buffer, __dwc3_gadget_start, run). The PHY and the global setup stay as
+ * the firmware left them (but GUSB2PHYCFG, see 0366 above).
+ */
+static bool
+ud_hw_start(bool loud)
+{
+	int i;
+
+	/* Port in device mode (Linux dwc3_set_prtcap: GCTL PRTCAPDIR = 2); the firmware may have left it a host. */
+	dwc_wr(GCTL, (dwc_rd(GCTL) & ~(3u << 12)) | (2u << 12));
+	/* Device controller soft reset (PHY and global setup stay as the firmware left them). */
+	dwc_wr(DCTL, DCTL_CSFTRST);
+	for (i = 0; i < 500 && (dwc_rd(DCTL) & DCTL_CSFTRST); i++) {
+		ud_udelay(1000);
+	}
+	if (loud || (dwc_rd(DCTL) & DCTL_CSFTRST)) {
+		printf("NEGRONI USB: soft reset %s after %d ms, GCTL 0x%08x DCFG 0x%08x\n",
+		    (dwc_rd(DCTL) & DCTL_CSFTRST) ? "STUCK" : "done", i, dwc_rd(GCTL), dwc_rd(DCFG));
+	}
+	if (dwc_rd(DCTL) & DCTL_CSFTRST) {
+		return false;
+	}
+	/* 0366: Linux dwc3_core_soft_reset waits 50 ms after the reset for a DWC_usb31 <= 1.80a (ours: 1.10a) before PHY-domain writes */
+	ud_udelay(50 * 1000);
+	if (ud_phycfg) {
+		/* 0366: Linux snps,dis_u2_susphy_quirk + snps,dis_enblslpm_quirk (sm8450.dtsi) */
+		uint32_t p = dwc_rd(GUSB2PHYCFG), q = p & ~(GUSB2PHYCFG_SUSPHY | GUSB2PHYCFG_ENBLSLPM);
+		if (q != p) {
+			dwc_wr(GUSB2PHYCFG, q);
+		}
+		if (loud) {
+			printf("NEGRONI USB: GUSB2PHYCFG 0x%08x -> 0x%08x (SUSPHY, ENBLSLPM off; negroniusb_phycfg=0 keeps it)\n",
+			    p, dwc_rd(GUSB2PHYCFG));
+		}
+	}
+
+	dwc_wr(GEVNTADRLO, (uint32_t)(ud.dma_pa + UD_EVT));
+	dwc_wr(GEVNTADRHI, (uint32_t)((ud.dma_pa + UD_EVT) >> 32));
+	dwc_wr(GEVNTSIZ, (1u << 31) | UD_EVT_SIZE);     /* interrupt masked: polled */
+	dwc_wr(GEVNTCOUNT, dwc_rd(GEVNTCOUNT) & 0xffff);
+	ud.evt_pos = 0;
+
+	/* High speed, address 0 */
+	uint32_t dcfg = dwc_rd(DCFG) & ~(7u | (0x7fu << 3));
+	dwc_wr(DCFG, dcfg | 0);
+	/* Events: disconnect, USB reset, connect done (+ 0366: wakeup, U3/L2 suspend, erratic error) */
+	dwc_wr(DEVTEN, DEVTEN_BASE | (ud_more_events >= 1 ? DEVTEN_MORE : 0) | (ud_more_events >= 2 ? DEVTEN_ULSTCNG : 0));
+	for (i = 0; i < 6; i++) {
+		ud.ep_busy[i] = false;  /* the soft reset ended every transfer */
+	}
+
+	/* Endpoint 0 OUT/IN: start config, control type, max packet 512 until connect done. */
+	if (ud_epcmd(0, DEPCMD_DEPSTARTCFG, 0, 0, 0) ||
+	    ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (0u << 25), 0) ||
+	    ud_epcmd(0, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0) ||
+	    ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (512u << 3), (1u << 8) | (1u << 10) | (1u << 25), 0) ||
+	    ud_epcmd(1, DEPCMD_SETTRANSFRESOURCE, 1, 0, 0)) {
+		printf("NEGRONI USB: endpoint 0 setup failed\n");
+		return false;
+	}
+	dwc_wr(DALEPENA, 0x3);
+	ud_start_setup();
+
+	if (ud.qs != 0) {
+		uint32_t hs = usb_rd(ud.qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(ud.qs, QSCRATCH_SS_PHY_CTRL);
+		if (loud) {
+			printf("NEGRONI USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x GENERAL_CFG 0x%08x\n",
+			    hs, ss, usb_rd(ud.qs, 0x08));
+		}
+		*(volatile uint32_t *)(ud.qs + QSCRATCH_HS_PHY_CTRL) = hs | UTMI_OTG_VBUS_VALID | SW_SESSVLD_SEL;
+		*(volatile uint32_t *)(ud.qs + QSCRATCH_SS_PHY_CTRL) = ss | LANE0_PWR_PRESENT;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		if (loud) {
+			printf("NEGRONI USB: VBUS override on: HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x\n",
+			    usb_rd(ud.qs, QSCRATCH_HS_PHY_CTRL), usb_rd(ud.qs, QSCRATCH_SS_PHY_CTRL));
+		}
+	}
+
+	dwc_wr(DCTL, dwc_rd(DCTL) | DCTL_RUN_STOP);
+	for (i = 0; i < 500 && (dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		ud_udelay(1000);
+	}
+	if (loud) {
+		printf("NEGRONI USB: running (DSTS 0x%08x after %d ms), DMA at 0x%llx\n", dwc_rd(DSTS), i, ud.dma_pa);
+	}
+	return true;
+}
+
+/* Soft disconnect + soft connect: the host sees the device go and come back (a fresh attach). */
+static void
+ud_soft_reconnect(const char *why, uint32_t dsts, uint64_t quiet_ms)
+{
+	uint32_t dropped = 0;
+	int i;
+
+	ud.reconnects++;
+	ud.episode_reconnects++;
+	bool loud = ud.episode_reconnects <= 3 || (ud.reconnects % 10) == 0;
+	if (loud) {
+		printf("NEGRONI USB: soft reconnect #%llu (%u in this episode): %s; no SOF for %llu ms, DSTS 0x%08x "
+		    "link %u (%s), %sconfigured, rx %llu tx %llu frames\n", ud.reconnects, ud.episode_reconnects, why,
+		    quiet_ms, dsts, DSTS_LINK(dsts), ud_link_name(DSTS_LINK(dsts)), ud.configured ? "" : "not ",
+		    ud.rx_frames, ud.tx_frames);
+	}
+	/* Linux dwc3_gadget_soft_disconnect: end the active transfers, ep0 to setup, RUN_STOP 0, wait for the halt */
+	ud_drop_data();
+	ud_end_transfer(0);
+	ud_end_transfer(1);
+	ud.state = EP0_SETUP;
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	for (i = 0; i < 500 && !(dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		/* the controller halts only when the event buffer is empty: ack what comes (not handled) */
+		uint32_t c = dwc_rd(GEVNTCOUNT) & 0xffff;
+		if (c) {
+			ud.evt_pos = (ud.evt_pos + c) % UD_EVT_SIZE;
+			dwc_wr(GEVNTCOUNT, c);
+			dropped += c / 4;
+		}
+		ud_udelay(1000);
+	}
+	bool halted = (dwc_rd(DSTS) & DSTS_DEVCTRLHLT) != 0;
+	/* pull-up off long enough for any host to see a disconnect */
+	if (ud_in_panic) {
+		ud_udelay(100 * 1000);
+	} else {
+		ud_sleep_ms(100);
+	}
+	bool ok = ud_hw_start(false);
+	if (ud.events > 140) {
+		ud.events = 140;        /* print the next enumeration's events again */
+	}
+	if (loud || !ok || !halted) {
+		printf("NEGRONI USB: soft reconnect #%llu: %s after %d ms (%u events dropped), restart %s, DSTS 0x%08x\n",
+		    ud.reconnects, halted ? "halted" : "NOT halted", i, dropped, ok ? "ok" : "FAILED", dwc_rd(DSTS));
+	}
+}
+
+/*
+ * Every 100 ms (ud_thread, panic loop): DSTS link state and SOF number.
+ * No SOF for negroniusb_reconnect s: soft reconnect.
+ */
+static void
+ud_link_watch(void)
+{
+	uint64_t now = mach_absolute_time();
+
+	if (now < ud.next_watch) {
+		return;
+	}
+	ud.next_watch = now + ud_abs_ms(100);
+	uint32_t dsts = dwc_rd(DSTS);
+	uint32_t sof = DSTS_SOFFN(dsts), link = DSTS_LINK(dsts);
+	if (link != ud.last_link) {
+		if (ud_devevent_note(13)) {     /* type 13 is unused by the controller: our DSTS poll */
+			printf("NEGRONI USB: link %u (%s) -> %u (%s), DSTS 0x%08x\n", ud.last_link,
+			    ud_link_name(ud.last_link), link, ud_link_name(link), dsts);
+		}
+		ud.last_link = link;
+	}
+	if (ud.sof_seen == 0 || sof != ud.last_soffn) {
+		if (ud.nosof_logged) {
+			printf("NEGRONI USB: SOF again after %llu ms (link %u, %sconfigured, %u reconnects)\n",
+			    ud.sof_seen ? (now - ud.sof_seen) * 1000 / ud_abs_ms(1000) : 0, link,
+			    ud.configured ? "" : "not ", ud.episode_reconnects);
+		}
+		ud.last_soffn = sof;
+		ud.sof_seen = now;
+		ud.nosof_logged = false;
+		ud.event_rule_done = false;
+		ud.episode_reconnects = 0;
+		return;
+	}
+	uint64_t quiet = now - ud.sof_seen;
+	uint64_t quiet_ms = quiet * 1000 / ud_abs_ms(1000);
+	if (!ud.nosof_logged && quiet >= ud_abs_ms(3000)) {
+		ud.nosof_logged = true;
+		printf("NEGRONI USB: no SOF for 3 s (%sconfigured): DSTS 0x%08x link %u (%s), DCTL 0x%08x DEVTEN 0x%08x "
+		    "GUSB2PHYCFG 0x%08x, tx busy %d, rx %llu tx %llu frames (cable out, host asleep, or link lost)\n",
+		    ud.configured ? "" : "not ", dsts, link, ud_link_name(link), dwc_rd(DCTL), dwc_rd(DEVTEN),
+		    dwc_rd(GUSB2PHYCFG), ud.tx_busy, ud.rx_frames, ud.tx_frames);
+	}
+	if (ud_reconnect_s <= 0) {
+		return;
+	}
+	/* the long period at once while configured and in L2: most likely a sleeping host (review N2) */
+	bool slow = ud.episode_reconnects >= 12 || (link == 3 && ud.configured);
+	uint64_t wait = ud_abs_ms((uint64_t)ud_reconnect_s * (slow ? 6000 : 1000));
+	if (quiet >= wait) {
+		ud_soft_reconnect(slow ? "no SOF (long period)" : "no SOF", dsts, quiet_ms);
+	} else if (!ud.event_rule_done && ud.dev_event_at > ud.sof_seen + ud_abs_ms(500) &&
+	    now - ud.dev_event_at >= ud_abs_ms(1000)) {
+		/* a device event (wakeup, reset, ...) long after the last SOF and still no SOF 1 s later: the replug did not take (once per episode) */
+		ud.event_rule_done = true;
+		ud_soft_reconnect("device event without SOF", dsts, quiet_ms);
+	} else {
+		return;
+	}
+	ud.dev_event_at = 0;
+	ud.last_soffn = DSTS_SOFFN(dwc_rd(DSTS));
+	ud.sof_seen = mach_absolute_time();     /* the next try one period later */
+	ud.next_watch = ud.sof_seen + ud_abs_ms(100);
+}
+
 static void
 ud_event(uint32_t ev)
 {
 	if (ev & 1) {                   /* device event */
 		uint32_t type = (ev >> 8) & 0xf;
+		ud.dev_event_at = mach_absolute_time();
 		if (type == 1) {        /* USB reset */
 			dwc_wr(DCFG, dwc_rd(DCFG) & ~(0x7fu << 3));
+			ud_ep0_reset();         /* 0366 */
 			if (ud_reset_drop && ud.configured) {
 				/*
 				 * Patch 0282: a bus reset kills every endpoint but 0. Before, ud.configured stayed
@@ -1310,23 +1685,18 @@ ud_event(uint32_t ev)
 				 * early): the device enumerated again ("en10 up" 3 s after "gone") but no frame
 				 * ever moved (no RX TRB armed, tx_busy stuck). Drop the data state: the next
 				 * SET_CONFIGURATION sets the endpoints up again (DEPSTARTCFG 2 resets the
-				 * transfer resources, as Linux dwc3 does after a reset).
+				 * transfer resources, as Linux dwc3 does after a reset). 0366: ud_drop_data()
