+/*
+ * 0389: frame-pacing floor. [V logs/usblog-20261027-171256.txt, scripts/display/fbstat-report.py] With the UI moving,
+ * simple_ondemand sees the GMU busy share of a 100 ms tick: 20-30 % (CoreAnimation renders one frame, then the GPU idles
+ * until the next vsync tick), so it picks the lowest level >= cur x busy / 87.5 % (220-317 MHz) although the display
+ * holds frames for the GPU: 1160 active seconds with >= 10 "gpu-wait skips" averaged 0.85 held ticks per frame, the DCVS
+ * line showed 8.2 level changes a second (late-frame step up, busy rule down again), end level 363 MHz mean; in seconds
+ * with 100-130 presents the skips were 0.1/s. corr(skips, presents/s) = -0.72 over the 242 seconds with >= 40 swaps.
+ * A busy-share governor cannot see a latency limit; KGSL's msm-adreno-tz has the same blind spot and Android adds
+ * input/frame boosts in userspace.
+ * Rule: in a governor tick where the UI swapped and the display held a frame for the GPU in at least PACE_LATE_PER_100MS
+ * of the (12 per 100 ms) vsync ticks, the floor goes to max(floor, current level) + 1 (+ 2 when half of the ticks held a
+ * frame). Without such a tick for PACE_HOLD_MS the floor goes down one level, then one more every PACE_STEP_MS until a
+ * tick is late again, so it settles at the lowest level that keeps the frames on time; when a step down was late, the
+ * next step down waits PACE_PROBE_HOLD_MS (fewer probe misses while the content stays the same). No swap for PACE_IDLE_MS: the floor is dropped (simple_ondemand alone, level 1 when idle) and
+ * remembered; the next UI burst starts one level under it (the VRR wake and the first touch frames). Display off: none.
+ * The thermal cap (0280) and negronigpu_maxlevel still win. negronigpu_pace=0: off.
+ */
+#define PACE_LATE_PER_100MS     2       /* held vsync ticks per 100 ms (of 12) that count as "the GPU is late" */
+#define PACE_FAST_PER_100MS     6       /* half of the ticks held: two levels at once */
+#define PACE_HOLD_MS            500     /* no late tick this long after a raise: one level down */
+#define PACE_PROBE_HOLD_MS      2000    /* a step down was late again: the next step down waits this long */
+#define PACE_STEP_MS            200     /* then one more level down every this long while no tick is late */
+#define PACE_IDLE_MS            300     /* no swap this long: the floor goes (remembered for the next burst) */
+#define PACE_FORGET_MS          10000   /* idle this long: the remembered level is forgotten */
+#define PACE_TOP_MS             5000    /* at the top allowed level and still late this long: one line */
+static bool pace_on;
+static uint32_t pace_floor, pace_resume, pace_quiet_ms, pace_idle_ms, pace_top_ms;
+static uint32_t pace_sec_late, pace_sec_swaps, pace_sec_raises, pace_sec_decays, pace_sec_resumes, pace_sec_max;
+static bool pace_top_logged, pace_was, pace_falling;
+static uint32_t pace_acc_late, pace_acc_sw, pace_acc_ms;
+
+/*
+ * 0389 input boost: a finger down or moving (negroni_touch.c touch_report -> negroni_input_boost) holds the GPU at
+ * PACE_INPUT_LEVEL or more for PACE_INPUT_MS after the last report, so the first frames of a touch burst do not start at
+ * 220 MHz (VRR wake second: 11.2 presents/s, the 2 after 15.2/14.6). The watch is woken at once when it is in its 250 ms
+ * idle tick. The pacing floor still goes higher when frames are late. One hook for every input-driven boost: the CPU
+ * side may add its own call inside negroni_input_boost(). negronigpu_inputboost=0: off.
+ */
+#define PACE_INPUT_LEVEL        6       /* 492 MHz, bus 6: mid table */
+#define PACE_INPUT_MS           200
+static bool input_boost_on;
+static volatile uint64_t input_boost_at;        /* mach time of the last input report (0: none) */
+static uint64_t input_boost_abs;
+static uint32_t pace_sec_inputs;
+static volatile uint32_t input_boost_reports;
+static uint32_t pace_hold_ms = PACE_HOLD_MS;
+
 static uint32_t
-gov_want(uint32_t cur, uint32_t pct, uint32_t min, uint32_t max)
+pace_tick(uint32_t late, uint32_t sw, uint32_t ms, bool dark, uint32_t max)
+{
+	if (!pace_on) {
+		return 0;
+	}
+	pace_sec_late += late;
+	pace_sec_swaps += sw;
+	if (dark) {
+		pace_floor = pace_resume = pace_quiet_ms = pace_idle_ms = pace_top_ms = 0;
+		pace_falling = false;
+		return 0;
+	}
+	if (sw == 0) {
+		pace_idle_ms += ms;
+		if (pace_idle_ms >= PACE_IDLE_MS && pace_floor != 0) {
+			pace_resume = pace_floor;
+			pace_floor = pace_quiet_ms = pace_top_ms = 0;
+			pace_falling = false;
+		}
+		if (pace_idle_ms >= PACE_FORGET_MS) {
+			pace_resume = 0;
+		}
+		return pace_floor;
+	}
+	if (pace_idle_ms >= PACE_IDLE_MS && pace_resume > 1 && pace_floor < pace_resume - 1) {
+		pace_floor = MIN(pace_resume - 1, max);         /* a new burst: one under the level that kept up last time */
+		pace_quiet_ms = 0;
+		pace_falling = true;            /* not proven for this burst: down at the fast step */
+		pace_sec_resumes++;
+	}
+	pace_idle_ms = 0;
+	uint32_t per100 = late * 100 / MAX(ms, 1u);
+	if (per100 >= PACE_LATE_PER_100MS) {
+		uint32_t base = MAX(pace_floor, dcvs_level);
+		uint32_t up = per100 >= PACE_FAST_PER_100MS ? 2 : 1;
+		pace_floor = MIN(base + up, max);
+		pace_quiet_ms = 0;
+		pace_hold_ms = pace_falling ? PACE_PROBE_HOLD_MS : PACE_HOLD_MS;     /* the level under was too low */
+		pace_falling = false;
+		pace_sec_raises++;
+		if (pace_floor >= max) {
+			pace_top_ms += ms;
+			if (pace_top_ms >= PACE_TOP_MS && !pace_top_logged) {
+				pace_top_logged = true;
+				printf("NEGRONI GPU PACE: at the top allowed level %u (%u MHz, cap %u) for %u ms and frames still wait: the "
+				    "render time, not the clock, limits the frame rate now\n", max, gpu_khz[max] / 1000,
+				    negroni_thermal_gpu_cap(), pace_top_ms);
+			}
+		} else {
+			pace_top_ms = 0;
+		}
+	} else if (pace_floor != 0) {
+		pace_top_ms = 0;
+		pace_quiet_ms += ms;
+		if (pace_quiet_ms >= (pace_falling ? PACE_STEP_MS : pace_hold_ms)) {
+			pace_floor--;
+			pace_quiet_ms = 0;
+			pace_falling = true;
+			pace_sec_decays++;
+		}
+	}
+	if (pace_floor > max) {
+		pace_floor = max;
+	}
+	pace_sec_max = MAX(pace_sec_max, pace_floor);
+	return pace_floor;
+}
