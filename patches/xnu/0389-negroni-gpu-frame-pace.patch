+/* 0389: called by the touch driver on every finger-down / move report (any thread, no lock). */
+void negroni_input_boost(void);
+void
+negroni_input_boost(void)
+{
+	if (!input_boost_on) {
+		return;
+	}
+	uint64_t now = mach_absolute_time(), last = input_boost_at;
+	input_boost_at = now;
+	__atomic_fetch_add(&input_boost_reports, 1, __ATOMIC_RELAXED);
+	if ((last == 0 || now - last > input_boost_abs) && pm_watch_idle) {
+		thread_wakeup((event_t)&gpu_kept);      /* the watch leaves its 250 ms idle tick now */
+	}
+}
