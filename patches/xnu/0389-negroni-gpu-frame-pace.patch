+/*
+ * 0389: msm_adreno_tz, the GPU governor of the phone's own Android kernel, ported. Source (GPL-2.0-only, SPDX kept by
+ * reference): OnePlusOSS android_kernel_oneplus_sm8450, branch oneplus/sm8450_b_16.0_oneplus_10_pro, commit e9da592
+ * (QCOM AU_LINUX_KERNEL.PLATFORM.1.0.R1.00.00.00.000.130), drivers/gpu/msm/governor_msm_adreno_tz.c
+ * ("Copyright (c) 2010-2021, The Linux Foundation. Copyright (c) 2022 Qualcomm Innovation Center, Inc."),
+ * kgsl_pwrscale.c, drivers/firmware/qcom_scm.c; fetched by scripts/setup/fetch-gpu-governor-sources.sh.
+ * The level decision is TrustZone's (QCOM_SCM_SVC_DCVS): Android gives TZ the pwrlevel frequency table once
+ * (DCVS_INIT_V2) and every devfreq poll (10 ms, kgsl_pwrscale polling_ms / KGSL_GOVERNOR_CALL_INTERVAL) the current
+ * pwrlevel and the busy and total time in us of the bin (DCVS_UPDATE_V2); TZ answers a level step. Kernel side, as
+ * tz_get_target_freq: bins below FLOOR (5 ms) are kept; a bin with less than MIN_BUSY (1 ms) busy at the lowest level is
+ * kept; busy > CEILING (50 ms) jumps to pwrlevel 0 (the top); mod_percent 100. Busy = GMU power counter XOCLK_0 x 10 / 192
+ * (gen7_power_stats), total = the GMU always-on counter (both 19.2 MHz). Level index: KGSL pwrlevel 0 = 818 MHz ..
+ * 11 = 220 MHz (live.dts qcom,gpu-pwrlevel@0..11) = our level 12 - pwrlevel. No context-aware DCVS (no qcom,enable-ca-jump
+ * in live.dts) and no busy-time burst disable (no qcom,disable-busy-time-burst). gpubw_mon is not ported: it needs the
+ * GBIF RAM counters (gen7_read_bus_stats); the bus vote stays the level's DT qcom,bus-freq (KGSL's default).
+ * Self-check: is-call-available for DCVS INIT/UPDATE/RESET (qcom_scm_dcvs_core_available), then INIT_V2 must return 0
+ * and version 0 (MAX_TZ_VERSION); else simple_ondemand (0384) with one line. Three failed updates in a row: the same.
+ */
+#define TZ_SVC_DCVS             0x0d
+#define TZ_DCVS_RESET           0x07
+#define TZ_DCVS_UPDATE          0x08
+#define TZ_DCVS_INIT            0x09
+#define TZ_DCVS_UPDATE_V2       0x0a
+#define TZ_DCVS_INIT_V2         0x0b
+#define TZ_FLOOR_US             5000
+#define TZ_MIN_BUSY_US          1000
+#define TZ_CEILING_US           50000
+#define TZ_MAX_PWRLEVELS        16      /* MSM_ADRENO_MAX_PWRLEVELS */
+#define TZ_POLL_MS              10      /* kgsl_pwrscale polling_ms */
+#define SCM_ARGS_RW_VAL         (2 | 2 << 4)    /* QCOM_SCM_ARGS(2, QCOM_SCM_RW, QCOM_SCM_VAL) */
+#define SCM_ARGS_3VAL           3
+#define SCM_WAITQ_SLEEP         2       /* QCOM_SCM_WAITQ_SLEEP / _WAKE (qcom_scm.h) */
+#define SCM_WAITQ_WAKE          3
+static bool tz_on, tz_suspended;
+static uint64_t tz_bin_total, tz_bin_busy;
+static uint32_t tz_errors, tz_sec_calls, tz_sec_ups, tz_sec_downs, tz_sec_bursts;
+
+/* One SCM call without the bring-up print and pause of scm() (runtime: up to 100 a second). */
+static int32_t
+scm_quiet(uint64_t function, uint64_t args, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t *answer)
+{
+	uint64_t session = 0;
+
+	for (int i = 0; i < 100; i++) {
+		register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = args;
+		register uint64_t x2 __asm__("x2") = a0;
+		register uint64_t x3 __asm__("x3") = a1;
+		register uint64_t x4 __asm__("x4") = a2;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+		    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+		session = x6;
+		if (x0 != SCM_INTERRUPTED) {
+			*answer = x1;
+			return (int32_t)x0;
+		}
+	}
+	return -1;
+}
+
+/* tz_start + tz_init: the pwrlevel table to TrustZone. false: not available (the reason is logged). */
+static bool
+tz_start(void)
+{
+	uint64_t answer = 0, how = SCM_FAST | SCM_64 | SCM_SIP | SCM_IS_CALL_AVAILABLE;
+	static const uint32_t need[3] = { TZ_DCVS_INIT, TZ_DCVS_UPDATE, TZ_DCVS_RESET };
+
+	for (int i = 0; i < 3; i++) {
+		answer = 0;
+		if (scm_quiet(how, SCM_ONE_VALUE, SCM_SIP | SCM_CALL(TZ_SVC_DCVS, need[i]), 0, 0, &answer) != 0 || answer != 1) {
+			printf("NEGRONI GPU TZ: off: TrustZone has no DCVS call %#x (is-call-available %llu): simple_ondemand decides\n",
+			    need[i], answer);
+			return false;
+		}
+	}
+	vm_offset_t page = 0;
+	if (kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("NEGRONI GPU TZ: off: no memory for the level table\n");
+		return false;
+	}
+	/* tz_pwrlevels[0] = the number of levels, then freq_table[] in Hz, pwrlevel 0 (the top) first */
+	uint32_t *t = (uint32_t *)page, top = sizeof(gpu_khz) / sizeof(gpu_khz[0]) - 1;
+	t[0] = top;
+	for (uint32_t p = 0; p < top; p++) {
+		t[1 + p] = gpu_khz[top - p] * 1000;
+	}
+	clean_dcache(page, PAGE_SIZE, FALSE);   /* TrustZone reads memory (dma_sync_single_for_device) */
+	answer = ~0ull;
+	int32_t r = scm_quiet(SCM_64 | SCM_SIP | SCM_CALL(TZ_SVC_DCVS, TZ_DCVS_INIT_V2), SCM_ARGS_RW_VAL, kvtophys(page),
+	    (TZ_MAX_PWRLEVELS + 1) * sizeof(uint32_t), 0, &answer);
+	kmem_free(kernel_map, page, PAGE_SIZE);
+	if (r != 0 || answer > 0) {
+		printf("NEGRONI GPU TZ: off: DCVS_INIT_V2 returned %d, version %llu (want 0, 0): simple_ondemand decides\n", r, answer);
+		return false;
+	}
+	printf("NEGRONI GPU TZ: on (0389, msm_adreno_tz port): %u levels %u..%u MHz to TrustZone (DCVS_INIT_V2 version 0), "
+	    "poll %u ms, floor %u us, min busy %u us, ceiling %u us; negronigpu_tz=0 = off\n", top, gpu_khz[top] / 1000,
+	    gpu_khz[1] / 1000, TZ_POLL_MS, TZ_FLOOR_US, TZ_MIN_BUSY_US, TZ_CEILING_US);
+	return true;
+}
+
+/* tz_suspend: the display went off (KGSL: the GPU suspends). */
+static void
+tz_reset(void)
+{
+	uint64_t answer;
+
+	tz_bin_total = tz_bin_busy = 0;
+	(void)scm_quiet(SCM_64 | SCM_SIP | SCM_CALL(TZ_SVC_DCVS, TZ_DCVS_RESET), 0, 0, 0, 0, &answer);
+}
+
+/* tz_get_target_freq on our levels (1 = 220 .. 12 = 818 MHz); returns the wanted level. */
+static uint32_t
+tz_want(uint32_t cur, uint32_t min, uint32_t max)
+{
+	uint32_t top = sizeof(gpu_khz) / sizeof(gpu_khz[0]) - 1;
+	uint64_t tot_us = busy_tick_ao * 10 / 192, busy_us = busy_tick_xo * 10 / 192;     /* us */
+	int32_t level = (int32_t)(top - cur), val;     /* KGSL pwrlevel */
+
+	if (cur < 1 || cur > top) {
+		return cur;                                     /* TZ gets only pwrlevels 0..top - 1 */
+	}
+	busy_us = MIN(busy_us, tot_us);                        /* mod_percent 100 */
+	tz_bin_total += tot_us;
+	tz_bin_busy += busy_us;
+	if (tot_us == 0 || tz_bin_total < TZ_FLOOR_US ||
+	    (tz_bin_busy < TZ_MIN_BUSY_US && level == (int32_t)top - 1)) {
+		return cur;
+	}
+	if (tz_bin_busy > TZ_CEILING_US) {
+		val = -level;
+		tz_sec_bursts++;
+	} else {
+		uint64_t answer = 0;
+		int32_t r = scm_quiet(SCM_64 | SCM_SIP | SCM_CALL(TZ_SVC_DCVS, TZ_DCVS_UPDATE_V2), SCM_ARGS_3VAL, (uint64_t)level,
+		    tz_bin_total, tz_bin_busy, &answer);
+		tz_sec_calls++;
+		if (r != 0) {
+			tz_bin_total = tz_bin_busy = 0;
+			if (r == SCM_WAITQ_SLEEP || r == SCM_WAITQ_WAKE) {
+				tz_on = false;          /* qcom_scm-smc.c: needs WAITQ_RESUME after the wait-queue IRQ; not ported */
+				printf("NEGRONI GPU TZ: off: DCVS_UPDATE_V2 answered wait-queue %d: simple_ondemand decides now\n", r);
+				return cur;
+			}
+			if (++tz_errors >= 3) {
+				tz_on = false;
+				printf("NEGRONI GPU TZ: off: DCVS_UPDATE_V2 failed 3 times (last %d): simple_ondemand decides now\n", r);
+			}
+			return cur;
+		}
+		tz_errors = 0;
+		val = (int32_t)answer;
+	}
+	tz_bin_total = tz_bin_busy = 0;
+	if (val != 0) {
+		level += val;
+		level = level < 0 ? 0 : level > (int32_t)top - 1 ? (int32_t)top - 1 : level;
+		val < 0 ? tz_sec_ups++ : tz_sec_downs++;
+	}
+	uint32_t want = top - (uint32_t)level;
+	return want < min ? min : want > max ? max : want;
+}
