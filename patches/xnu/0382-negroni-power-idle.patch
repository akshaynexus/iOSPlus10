+	if (fast_ok && ud.last_rx != 0 && (rx_age < idle_after || (txq && rx_age < ud_abs_ms(2000)))) {
+		return (unsigned)ud_poll_us;    /* the host sends (or acks a stream of ours) */
+	}
+	if (txq || now - ud.last_active < idle_after || (ud.last_rx != 0 && rx_age < ud_abs_ms(2000)) ||
