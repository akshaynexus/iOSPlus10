+		return ENOTCONN;
+	}
+	memcpy(f, g_bssid, 6);
+	memcpy(f + 6, negroni_wlan_wmi_mac(), 6);
+	f[12] = 0x88;
+	f[13] = 0x8e;
+	memcpy(f + 14, body, len);
+	return tcl_send(f, 14 + len);
+}
+
+/* true when every TX buffer came back (0329 waits for message 4 before installing the keys) */
+bool
+negroni_wlan_dp_tx_idle(void)
+{
+	tx_complete();
+	for (uint32_t i = 0; i < N_TX_BUFS; i++) {
+		if (g_tx_busy[i]) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* ---- API ---- */
+int
+negroni_wlan_tx(const uint8_t *frame, uint32_t len)
+{
+	int error = 0;
+
+	if (!frame || len < 14 || len > TXQ_FRAME) {
+		return EINVAL;
+	}
+	if (!g_link_up || negroni_wlan_sta_state() != NWLAN_STATE_CONNECTED) {
+		return ENOTCONN;
+	}
+	lck_mtx_lock(&dp_txq_mtx);
+	uint32_t next = (g_txq_head + 1) % TXQ_N;
+	if (next == g_txq_tail) {
+		error = ENOBUFS;
+		g_tx_drops++;
+	} else {
+		memcpy(g_txq[g_txq_head], frame, len);
+		g_txq_len[g_txq_head] = (uint16_t)len;
+		g_txq_head = next;
+	}
+	lck_mtx_unlock(&dp_txq_mtx);
+	return error;
 }
 
 void
 negroni_wlan_sta_link_counters(struct nwlan_link *out)
 {
-	(void)out;
+	out->tx_frames = g_tx_frames;
+	out->rx_frames = g_rx_frames;
+	out->tx_dropped = g_tx_drops + g_tx_fail;
+	out->rx_dropped = g_rx_drops + g_rx_err + g_rx_bad;
+}
+
+/* one line for the keep-alive log */
+void
+negroni_wlan_dp_report(void)
+{
+	if (!g_pdev_on) {
+		return;
+	}
+	printf("NEGRONI WLAN: DP tx %llu (fail %u, queue drops %llu), rx %llu (drops %llu, errors %u, bad %u), released "
+	    "bufs %u, link descs returned %u, HTT other %u\n", g_tx_frames, g_tx_fail, g_tx_drops, g_rx_frames, g_rx_drops,
+	    g_rx_err, g_rx_bad, g_rel_bufs, g_link_returned, g_htt_other);
+}
+
+/* after the chip lost bus mastering */
+void
+negroni_wlan_dp_free(void)
+{
+	g_pdev_on = g_dp_on = g_link_up = g_secured = false;
+	memset(g_rx_posted, 0, sizeof(g_rx_posted));
+	memset(g_tx_busy, 0, sizeof(g_tx_busy));
+	g_repost_n = g_lpend_n = 0;
+	negroni_wlan_dma_free(&g_rings);
+	negroni_wlan_dma_free(&g_link);
+	negroni_wlan_dma_free(&g_rxb);
+	negroni_wlan_dma_free(&g_txb);
+	negroni_wlan_dma_free(&g_qd);
+	g_rdp = g_wrp = NULL;
+}
