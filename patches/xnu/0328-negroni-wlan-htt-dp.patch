+	    (error = htt_srng_setup(&R_err_dst[1], 1, HTT_HW_TO_SW, HTT_RXDMA_NON_MON_DEST_RING)) ||
+	    (error = htt_srng_setup(&R_mon[0], 0, HTT_SW_TO_HW, HTT_RXDMA_MON_STATUS_RING)) ||
+	    (error = htt_srng_setup(&R_mon[1], 1, HTT_SW_TO_HW, HTT_RXDMA_MON_STATUS_RING))) {
