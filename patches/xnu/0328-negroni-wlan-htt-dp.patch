+/* ---- peer (join, 0327): HTT peer map, default routing, REO queues, vdev Ethernet mode ---- */
+static int
+vdev_param(uint32_t param, uint32_t value)
+{
+	uint32_t m[4] = { (WMI_TAG_VDEV_SET_PARAM_CMD << 16) | 12, 0, param, value };
+	return negroni_wlan_wmi_send(WMI_VDEV_SET_PARAM_CMDID, m, sizeof(m));
+}
+
+static uint32_t
+tid_to_ac(uint32_t tid)
+{
+	return (tid == 0 || tid == 3) ? 0 : (tid == 1 || tid == 2) ? 1 : (tid == 4 || tid == 5) ? 2 : 3;
+}
+
+/* ath11k_hal_reo_qdesc_setup (ba window 1 -> 2 for QoS TIDs, no PN check, ignore AMPDU flag) */
+static void
+qdesc_setup(volatile uint32_t *q, uint32_t tid)
+{
+	for (uint32_t i = 0; i < QDESC_SIZE / 4; i++) {
+		q[i] = 0;
+	}
+	q[0] = 4u | (8u << 4) | (0xDDBEEFu << 8);          /* owner REO, type queue desc, magic */
+	q[1] = tid & 0xffff;                                /* rx_queue_num */
+	uint32_t ba = tid == 16 ? 1 : 2;
+	q[2] = 1u | (1u << 1) | (tid_to_ac(tid) << 5) | ((ba == 1) ? (1u << 8) : 0) | ((ba - 1) << 11) | (1u << 25);
+	q[3] = 0;                                           /* info1: SSN 0, SVLD 0 */
+	if (tid == 16) {
+		return;
+	}
+	static const uint32_t magic[3] = { 0xADBEEFu, 0xBDBEEFu, 0xCDBEEFu };
+	for (uint32_t e = 0; e < 3; e++) {
+		q[32 + e * 32] = 4u | (9u << 4) | (magic[e] << 8);     /* ext descs after the 128-byte queue desc */
+	}
+}
