 }
 
+/*
+ * Review D5: REO PN replay check on every TID queue after the pairwise key (ath11k_dp_peer_rx_pn_replay_config):
+ * REO_UPDATE_RX_QUEUE with PN check, PN size 48, PN valid, PN 0. Then only decrypted frames pass (D6).
+ */
 int
-negroni_wlan_tx(const uint8_t *frame, uint32_t len)
+negroni_wlan_dp_secure(void)
+{
+	if (!g_pdev_on) {
+		return ENXIO;
+	}
+	uint32_t sent = 0;
+	for (uint32_t tid = 0; tid < NUM_TIDS; tid++) {
+		volatile uint32_t *d = src_next(&R_reo_cmd);
+		if (!d) {
+			break;
+		}
+		uint64_t a = g_qd.dva + (uint64_t)tid * QDESC_SIZE;
+		uint32_t num = d[1] & 0xffff;                           /* command number kept (ath11k memset_startat) */
+		d[0] = (419u << 1) | (36u << 10);                       /* HAL_REO_UPDATE_RX_REO_QUEUE, 9 dwords */
+		d[1] = num;                                             /* no status required */
+		d[2] = (uint32_t)a;
+		d[3] = (uint32_t)((a >> 32) & 0xff) | (1u << 19) | (1u << 23) | (1u << 25) | (1u << 29) | (1u << 30);
+		d[4] = (1u << 27);                                      /* PN check on */
+		d[5] = 1u | (1u << 8);                                  /* BA window 2 - 1, PN size 48 */
+		d[6] = d[7] = d[8] = d[9] = 0;                          /* PN 0 */
+		sent++;
+	}
+	ring_commit(&R_reo_cmd);
+	g_secured = true;
+	printf("NEGRONI WLAN: DP PN replay check on %u TID queues; only decrypted frames from now on\n", sent);
+	return sent == NUM_TIDS ? 0 : ENOBUFS;
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
+
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+/*
+ * Review D7: the data path is a soft part. A failure prints one line, keeps every DMA area allocated (rings the hardware
+ * already knows stay valid memory), stops using the data path (no NWLAN_CAP_DATA) and lets the level go on (scan).
+ */
+static int
+dp_soft(int error, const char *stage)
 {
-	(void)frame;
-	(void)len;
-	return ENOTSUP;
+	if (error) {
+		printf("NEGRONI WLAN: DP OFF after %s (error %d): no data path this boot; scan and join frames still work\n", stage,
+		    error);
+		g_dp_on = g_pdev_on = g_link_up = false;
+	}
+	return 0;
 }
 
+int
+negroni_wlan_dp_common_setup(void)
+{
+	return dp_soft(negroni_wlan_dp_common_setup_inner(), "the common rings");
+}
+
+int
+negroni_wlan_dp_reo_setup(void)
+{
+	return dp_soft(negroni_wlan_dp_reo_setup_inner(), "the REO rings");
+}
+
+int
+negroni_wlan_dp_pdev_setup(void)
+{
+	return dp_soft(negroni_wlan_dp_pdev_setup_inner(), "the pdev rings");
+}
 #endif /* ARM64_BOARD_CONFIG_NEGRONI */
