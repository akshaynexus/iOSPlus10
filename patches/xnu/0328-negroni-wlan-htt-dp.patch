+
+/* ---- TX (driver thread): one TCL data descriptor per frame (ath11k_dp_tx + ath11k_hal_tx_cmd_desc_setup) ---- */
+static int
+tcl_send(const uint8_t *frame, uint32_t len)
+{
+	uint32_t slot = N_TX_BUFS;
+
+	if (!g_pdev_on || len < 14 || len > TX_BUF) {
+		return EINVAL;
+	}
+	for (uint32_t k = 0; k < N_TX_BUFS; k++) {
+		uint32_t i = (g_tx_next + k) % N_TX_BUFS;
+		if (!g_tx_busy[i]) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot == N_TX_BUFS) {
+		return ENOBUFS;
+	}
+	volatile uint32_t *d = src_next(&R_tcl_data);
+	if (!d) {
+		return ENOBUFS;
+	}
+	memcpy((void *)(g_txb.nc + slot * TX_BUF), frame, len);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint64_t a = g_txb.dva + (uint64_t)slot * TX_BUF;
+	uint32_t desc_id = (0u) | (slot << 2);                          /* mac 0, msdu id, pool 0 */
+	/* d[0] = TLV header (set at init) */
+	d[1] = (uint32_t)a;
+	d[2] = (uint32_t)((a >> 32) & 0xff) | (RBM_SW0 << 8) | (desc_id << 11);
+	d[3] = (0u) | (TCL_ENCAP_ETHERNET << 2) | (0u << 4) | (TCL_SEARCH_DEFAULT << 12) | (TCL_ADDRY_EN << 14) |
+	    ((g_tcl_meta & 0xffff) << 16);
+	d[4] = len & 0xffff;                                            /* data length, pkt offset 0 */
+	d[5] = (1u << 21) | (0u << 22) | (0u << 26);                    /* TID overwrite, TID 0, lmac 0 */
+	d[6] = 0;                                                       /* dscp table 0, search index 0, cache set 0 */
+	d[7] = 0;
+	g_tx_busy[slot] = true;
+	g_tx_next = (slot + 1) % N_TX_BUFS;
+	ring_commit(&R_tcl_data);
+	g_tx_frames++;
+	return 0;
+}
+
+static void
+tx_complete(void)
+{
+	volatile uint32_t *d;
+	bool moved = false;
+
+	while ((d = dst_next(&R_tx_comp))) {
+		uint32_t desc_id = d[1] >> 11, slot = (desc_id >> 2) & 0x1ffff;
+		uint32_t src = d[2] & 7, reason = (d[2] >> 13) & 0xf;
+		if (slot < N_TX_BUFS) {
+			g_tx_busy[slot] = false;
+		}
+		if (src == 0 && reason != 0) {                          /* TQM: 0 = acked (HAL_WBM_TQM_REL_REASON_FRAME_ACKED) */
+			g_tx_fail++;
+		}
+		moved = true;
+	}
+	if (moved) {
+		ring_commit(&R_tx_comp);
+	}
+}
+
+/* ---- RX ---- */
+static uint8_t g_rx_frame[RX_BUF];
+
+/* native Wi-Fi decap (802.11 3-address header + LLC/SNAP) -> Ethernet II */
+static uint32_t
+nwifi_to_eth(const uint8_t *p, uint32_t len, uint8_t *out)
+{
+	if (len < 24 + 8 || p[24] != 0xaa || p[25] != 0xaa || p[26] != 0x03) {
+		return 0;
+	}
+	uint32_t fc = p[0] | p[1] << 8;
+	const uint8_t *da = p + 4, *sa = (fc & 0x0200) ? p + 16 : p + 10;        /* from DS: addr3 = SA */
+	memcpy(out, da, 6);
+	memcpy(out + 6, sa, 6);
+	memcpy(out + 12, p + 30, 2);                                    /* ethertype after the SNAP header */
+	memcpy(out + 14, p + 32, len - 32);
+	return len - 32 + 14;
+}
+
+static bool g_rx_decrypted;             /* of the frame rx_deliver handles */
+
+static void
+rx_deliver(const uint8_t *eth, uint32_t len)
+{
+	if (len < 14) {
+		g_rx_drops++;
+		return;
+	}
+	g_rx_frames++;
+	if (eth[12] == 0x88 && eth[13] == 0x8e) {                       /* EAPOL: the kernel's WPA2 handshake (0329) */
+		if (memcmp(eth + 6, g_bssid, 6) != 0) {
+			g_rx_drops++;                                   /* review: EAPOL only from our AP */
+			return;
+		}
+		if (negroni_wlan_wpa_rx_eapol(eth + 14, len - 14)) {
+			return;
+		}
+	}
+	if (g_secured && !g_rx_decrypted) {
+		g_rx_drops++;                   /* review D6: after the keys, a frame that was not decrypted is dropped */
+		return;
+	}
+	if (negroni_wlan_sta_state() == NWLAN_STATE_CONNECTED) {
+		negroni_wlan_sta_deliver(eth, len);
+	} else {
+		g_rx_drops++;
+	}
+}
+
+static void
+rx_process_ring(struct dp_ring *r)
+{
+	volatile uint32_t *d;
+	bool moved = false;
+
+	while ((d = dst_next(r))) {
+		moved = true;
+		uint32_t slot = rx_slot(d[1]), push = (d[7] >> 9) & 3, msdu = d[4];      /* info0 = dword 7 */
+		if (slot == ~0u) {
+			g_rx_bad++;
+			continue;
+		}
+		if (!g_rx_posted[slot]) {
+			g_rx_unposted++;        /* review D2: a buffer we do not own: neither read nor posted again */
+			continue;
+		}
+		const uint8_t *b = (const uint8_t *)(g_rxb.nc + slot * RX_BUF);
+		bool cont = (msdu >> 2) & 1;
+		if (push != PUSH_ROUTING || cont || r->skip_cont) {
+			r->skip_cont = cont;            /* a frame larger than a buffer: dropped (ath11k: multi-buffer msdu) */
+			g_rx_err++;
+			rx_recycle(slot);
+			continue;
+		}
+		__asm__ volatile ("dmb ld" ::: "memory");
+		uint32_t attn2, end2, start1, start2, mp1, mp2;
+		memcpy(&mp1, b + RXD_MPDU_START_INFO1, 4);
+		memcpy(&mp2, b + RXD_MPDU_START_INFO2, 4);
+		memcpy(&attn2, b + RXD_ATTN_INFO2, 4);
+		memcpy(&end2, b + RXD_MSDU_END_INFO2, 4);
+		memcpy(&start1, b + RXD_MSDU_START_INFO1, 4);
+		memcpy(&start2, b + RXD_MSDU_START_INFO2, 4);
+		uint32_t mlen = start1 & 0x3fff, pad = (end2 >> 26) & 3, decap = (start2 >> 8) & 3;
+		if (!(attn2 & RXD_MSDU_DONE) || RX_DESC_SZ + pad + mlen > RX_BUF) {
+			g_rx_bad++;
+			rx_recycle(slot);
+			continue;
+		}
+		const uint8_t *data = b + RX_DESC_SZ + pad;
+		/* review D6 (ath11k_dp_rx_h_attn_is_decrypted): encrypted (encrypt info valid, type not OPEN) and decrypt OK */
+		bool decrypted = (mp1 & RXD_MPDU_ENC_VALID) && ((mp2 >> 2) & 0xf) != HAL_ENC_OPEN && ((attn2 >> 10) & 7) == 0;
+		g_rx_decrypted = decrypted;
+		if (decap == DECAP_ETH2) {
+			memcpy(g_rx_frame, data, mlen);
+			rx_recycle(slot);
+			rx_deliver(g_rx_frame, mlen);
+		} else if (decap == DECAP_NATIVE_WIFI && mlen >= 32 && mlen - 32 + 14 <= sizeof(g_rx_frame)) {
+			uint32_t n = nwifi_to_eth(data, mlen, g_rx_frame);
+			rx_recycle(slot);
+			if (n) {
+				rx_deliver(g_rx_frame, n);
+			} else {
+				g_rx_drops++;
+			}
+		} else {
+			rx_recycle(slot);
+			g_rx_drops++;
+		}
+	}
+	if (moved) {
+		ring_commit(r);
+	}
+}
+
+/* a link descriptor back to the WBM idle list (ath11k_dp_rx_link_desc_return) */
+static bool
+link_return_one(uint32_t info0, uint32_t info1)
+{
+	volatile uint32_t *w = src_next(&R_wbm_rel);
+	if (!w) {
+		return false;
+	}
+	for (uint32_t i = 0; i < 8; i++) {
+		w[i] = 0;
+	}
+	w[0] = info0;
+	w[1] = info1;
+	w[2] = WBM_REL_SRC_SW | (0u << 3) | (WBM_REL_DESC_MSDU_LINK << 6);      /* put in idle */
+	ring_commit(&R_wbm_rel);
+	g_link_returned++;
+	return true;
+}
+
+static void
+link_return(uint32_t info0, uint32_t info1)
+{
+	while (g_lpend_n && link_return_one(g_lpend[g_lpend_n - 2], g_lpend[g_lpend_n - 1])) {
+		g_lpend_n -= 2;
+	}
+	if (!link_return_one(info0, info1) && g_lpend_n + 2 <= sizeof(g_lpend) / sizeof(g_lpend[0])) {
+		g_lpend[g_lpend_n++] = info0;
+		g_lpend[g_lpend_n++] = info1;
+	}
+}
+
+/* REO exception and rxdma error entries point at an MSDU link descriptor: recycle its buffers, return it */
+static void
+err_ring(struct dp_ring *r)
+{
+	volatile uint32_t *d;
+	bool moved = false;
+
+	while ((d = dst_next(r))) {
+		moved = true;
+		g_rx_err++;
+		uint64_t la = (uint64_t)d[0] | ((uint64_t)(d[1] & 0xff) << 32);
+		if (la < g_link.dva || la >= g_link.dva + g_link.size || ((la - g_link.dva) % LINK_DESC_SIZE) != 0) {
+			g_rx_bad++;     /* review D1: not one of our 128-byte link descriptors */
+			continue;
+		}
+		volatile uint32_t *ld = (volatile uint32_t *)(g_link.nc + (la - g_link.dva));
+		for (uint32_t i = 0; i < 6; i++) {
+			uint32_t a0 = ld[8 + 4 * i], a1 = ld[8 + 4 * i + 1];
+			if (!a0) {
+				break;
+			}
+			rx_recycle(rx_slot(a1));
+		}
+		link_return(d[0], d[1]);
+	}
+	if (moved) {
+		ring_commit(r);
+	}
+}
+
+/* WBM2SW3: released rx buffers (wbm error path) */
+static void
+rel_ring(void)
+{
+	volatile uint32_t *d;
+	bool moved = false;
+
+	while ((d = dst_next(&R_rx_rel))) {
+		moved = true;
+		uint32_t desc_type = (d[2] >> 6) & 7;
+		if (desc_type == WBM_REL_DESC_MSDU_LINK) {
+			continue;
+		}
+		rx_recycle(rx_slot(d[1]));
+		g_rel_bufs++;
+	}
+	if (moved) {
+		ring_commit(&R_rx_rel);
+	}
+}
+
+/* drain the API's TX queue into the TCL ring (driver thread) */
+static void
+tx_drain(void)
+{
+	static uint8_t f[TXQ_FRAME];
+	for (;;) {
+		uint32_t len = 0;
+		lck_mtx_lock(&dp_txq_mtx);
+		if (g_txq_tail != g_txq_head) {
+			len = g_txq_len[g_txq_tail];
+			memcpy(f, g_txq[g_txq_tail], len);
+		}
+		lck_mtx_unlock(&dp_txq_mtx);
+		if (!len) {
+			return;
+		}
+		if (tcl_send(f, len) == ENOBUFS) {
+			return;                         /* keep it queued; completions free slots */
+		}
+		lck_mtx_lock(&dp_txq_mtx);
+		g_txq_tail = (g_txq_tail + 1) % TXQ_N;
+		lck_mtx_unlock(&dp_txq_mtx);
+	}
+}
+
+/* poller (inside negroni_wlan_service): never sends WMI, never waits */
+void
+negroni_wlan_dp_poll(void)
+{
+	if (!g_pdev_on || g_in_poll) {
+		return;
+	}
+	g_in_poll = true;
+	tx_complete();
+	for (uint32_t i = 0; i < 4; i++) {
+		rx_process_ring(&R_reo_dst[i]);
+	}
+	rx_repost();
+	err_ring(&R_reo_except);
+	err_ring(&R_err_dst[0]);
+	err_ring(&R_err_dst[1]);
+	rel_ring();
+	if (g_link_up) {
+		tx_drain();
+	}
+	/* the shadow-register timer of ath11k: publish the producer pointers again while they are ahead */
+	if (src_free(&R_tcl_data) + 1 < N_TCL_DATA) {
+		ring_commit(&R_tcl_data);
+	}
+	g_in_poll = false;
+}
