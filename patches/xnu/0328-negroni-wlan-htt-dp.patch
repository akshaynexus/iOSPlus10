+static bool g_link_up;
+static uint8_t g_bssid[6];
+static uint32_t g_tcl_meta;
+/* counters */
+static uint64_t g_tx_frames, g_rx_frames, g_tx_drops, g_rx_drops;
+static uint32_t g_rx_err, g_rx_bad, g_tx_fail, g_rel_bufs, g_link_returned, g_htt_other;
+static bool g_in_poll;
+/* TX queue from the API (any thread) */
+static LCK_GRP_DECLARE(dp_grp, "negroni_wlan_dp");
+static LCK_MTX_DECLARE(dp_txq_mtx, &dp_grp);
+static uint8_t g_txq[TXQ_N][TXQ_FRAME];
+static uint16_t g_txq_len[TXQ_N];
+static uint32_t g_txq_head, g_txq_tail;
+
+int negroni_wlan_htt_send(const void *msg, uint32_t len);       /* negroni_wlan_wmi.c */
+
+/* review D7: a data-path failure is soft (the step goes on, scan keeps working): a "DP:" line, not a step failure */
+static int __printflike(2, 3)
+dp_fail(int error, const char *fmt, ...)
+{
+	char why[160];
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsnprintf(why, sizeof(why), fmt, ap);
+	va_end(ap);
+	printf("NEGRONI WLAN: DP: %s (error %d)\n", why, error);
+	return error;
+}
+
+static inline void
+wr32(uint32_t off, uint32_t v)
+{
+	negroni_wlan_reg_wr(off, v);
+}
+
+/* ---- ring memory and pointers ---- */
+static int
+ring_alloc(struct dp_ring *r, const char *name, uint32_t ring_id, uint32_t esz, uint32_t n, bool src, bool lmac,
+    uint32_t r0, uint32_t r2, int shadow)
 {
+	uint32_t bytes = n * esz * 4, at = (g_rings_used + 63) & ~63u;
+
+	if (at + bytes > g_rings.size) {
+		return dp_fail(ENOMEM, "DP ring %s does not fit the ring area (%u + %u > %u)", name, at, bytes,
+		           g_rings.size);
+	}
+	memset(r, 0, sizeof(*r));
+	r->name = name;
+	r->ring_id = ring_id;
+	r->esz = esz;
+	r->n = n;
+	r->size = n * esz;
+	r->src = src;
+	r->lmac = lmac;
+	r->r0 = r0;
+	r->r2 = r2;
+	r->shadow = shadow;
+	r->lmac_idx = lmac ? ring_id - RID_LMAC1 : 0;
+	r->base = (volatile uint32_t *)(g_rings.nc + at);
+	r->dva = g_rings.dva + at;
+	memset((void *)(uintptr_t)r->base, 0, bytes);
+	g_rings_used = at + bytes;
+	g_rdp[ring_id] = 0;
+	if (lmac) {
+		g_wrp[r->lmac_idx] = 0;
+	}
 	return 0;
 }
 
+/* the pointer the other side moves: TP of a source ring, HP of a destination ring (rdp, dwords) */
+static inline uint32_t
+ring_hw_ptr(const struct dp_ring *r)
+{
+	uint32_t v = g_rdp[r->ring_id];
+	__asm__ volatile ("dmb ld" ::: "memory");
+	/* review D3: only an in-range, entry-aligned pointer is believed */
+	return (v < r->size && (v % r->esz) == 0) ? v : (r->src ? r->tp : r->hp);
+}
+
+/* publish our pointer: HP of a source ring, TP of a destination ring (ath11k_hal_srng_access_end) */
+static void
+ring_commit(struct dp_ring *r)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t v = r->src ? r->hp : r->tp;
+	if (r->lmac) {
+		g_wrp[r->lmac_idx] = v;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	} else if (r->shadow >= 0) {
+		negroni_wlan_wr(HAL_SHADOW_REG((uint32_t)r->shadow), v);
+	}
+}
+
+static volatile uint32_t *
+src_next(struct dp_ring *r)
+{
+	r->tp = ring_hw_ptr(r);
+	uint32_t next = (r->hp + r->esz) % r->size;
+	if (next == r->tp) {
+		return NULL;
+	}
+	volatile uint32_t *d = r->base + r->hp;
+	r->hp = next;
+	return d;
+}
+
+static uint32_t
+src_free(struct dp_ring *r)
+{
+	r->tp = ring_hw_ptr(r);
+	return r->tp > r->hp ? (r->tp - r->hp) / r->esz - 1 : (r->size - r->hp + r->tp) / r->esz - 1;
+}
+
+static volatile uint32_t *
+dst_next(struct dp_ring *r)
+{
+	if (r->tp == r->hp) {
+		r->hp = ring_hw_ptr(r);
+		if (r->tp == r->hp) {
+			return NULL;
+		}
+	}
+	volatile uint32_t *d = r->base + r->tp;
+	r->tp = (r->tp + r->esz) % r->size;
+	return d;
+}
+
+/* ath11k_hal_srng_src_hw_init / _dst_hw_init (no MSI, no interrupt thresholds) */
+static void
+ring_hw_init(struct dp_ring *r)
+{
+	uint64_t ptr = g_rdp_dva + 4ull * r->ring_id;
+	uint32_t msb = (uint32_t)((r->dva >> 32) & 0xff) | (r->size << 8);
+
+	wr32(r->r0, (uint32_t)r->dva);
+	wr32(r->r0 + R0_BASE_MSB, msb);
+	if (r->src) {
+		wr32(r->r0 + R0_ID, r->esz);
+		if (r->ring_id == RID_WBM_IDLE_LINK) {
+			wr32(r->r0, (uint32_t)r->dva);
+			wr32(r->r0 + R0_BASE_MSB, msb);
+		}
+		wr32(r->r0 + R0_SRC_INT_IX0, 0);
+		wr32(r->r0 + R0_SRC_INT_IX1, 0);
+		if (r->ring_id != RID_WBM_IDLE_LINK) {
+			wr32(r->r0 + R0_SRC_TP_ADDR_LSB, (uint32_t)ptr);
+			wr32(r->r0 + R0_SRC_TP_ADDR_MSB, (uint32_t)(ptr >> 32));
+		}
+	} else {
+		wr32(r->r0 + R0_ID, (r->ring_id << 8) | r->esz);
+		wr32(r->r0 + R0_DST_PRODUCER_INT, 0);
+		wr32(r->r0 + R0_DST_HP_ADDR_LSB, (uint32_t)ptr);
+		wr32(r->r0 + R0_DST_HP_ADDR_MSB, (uint32_t)(ptr >> 32));
+	}
+	wr32(r->r2, 0);                 /* HP */
+	wr32(r->r2 + 4, 0);             /* TP */
+	g_rdp[r->ring_id] = 0;
+	wr32(r->r0 + R0_MISC, (r->src ? MISC_LOOPCNT_OFF : 0) | MISC_SRNG_ENABLE);
+}
+
+/* ---- rx buffers: slot k at g_rxb + k * 2048, cookie = buf id k + 1 (DP_RXDMA_BUF_COOKIE_BUF_ID, pdev 0) ---- */
+static bool
+rx_post(struct dp_ring *r, uint32_t slot)
+{
+	volatile uint32_t *d = src_next(r);
+	if (!d) {
+		return false;
+	}
+	uint64_t a = g_rxb.dva + (uint64_t)slot * RX_BUF;
+	d[0] = (uint32_t)a;
+	d[1] = (uint32_t)((a >> 32) & 0xff) | (RBM_SW1 << 8) | ((slot + 1) << 11);
+	g_rx_posted[slot] = true;
+	return true;
+}
+
+/* a returned buffer cookie -> its slot, or ~0u */
+static uint32_t
+rx_slot(uint32_t info1)
+{
+	uint32_t cookie = info1 >> 11, id = cookie & 0x3ffffu;
+	return (id >= 1 && id <= N_RX_BUFS) ? id - 1 : ~0u;
+}
+
+/*
+ * Give a consumed buffer back to the refill ring (review D2): a cookie for a slot the hardware does not own is counted
+ * and dropped (never posted twice); a full refill ring keeps the buffer on the repost list (rx_repost).
+ */
+static void
+rx_recycle(uint32_t slot)
+{
+	if (slot >= N_RX_BUFS) {
+		return;
+	}
+	if (!g_rx_posted[slot]) {
+		g_rx_unposted++;
+		return;
+	}
+	g_rx_posted[slot] = false;
+	if (rx_post(&R_refill, slot)) {
+		ring_commit(&R_refill);
+	} else if (g_repost_n < N_RX_BUFS) {
+		g_repost[g_repost_n++] = (uint16_t)slot;
+	}
+}
+
+static void
+rx_repost(void)
+{
+	bool moved = false;
+
+	while (g_repost_n && rx_post(&R_refill, g_repost[g_repost_n - 1])) {
+		g_repost_n--;
+		moved = true;
+	}
+	if (moved) {
+		ring_commit(&R_refill);
+	}
+}
+
+/* ---- common setup (ath11k_dp_alloc), after the CE rings ---- */
+static int
+negroni_wlan_dp_common_setup_inner(void)
+{
+	int error;
+	uint32_t v = 1;
+
+	(void)PE_parse_boot_argn("negroniwlan_dp", &v, sizeof(v));
+	g_dp_enabled = v != 0;
+	memset(g_rx_posted, 0, sizeof(g_rx_posted));    /* review: no state from an earlier run */
+	memset(g_tx_busy, 0, sizeof(g_tx_busy));
+	g_repost_n = g_lpend_n = 0;
+	g_secured = g_peer_lost = false;
+	if (!g_dp_enabled) {
+		printf("NEGRONI WLAN: DP off (negroniwlan_dp=0): no data path, scan only\n");
+		return 0;
+	}
+	if ((error = negroni_wlan_dma_alloc(256u << 10, &g_rings)) || (error = negroni_wlan_dma_alloc(N_LINK_DESC *
+	    LINK_DESC_SIZE, &g_link)) || (error = negroni_wlan_dma_alloc(N_RX_BUFS * RX_BUF, &g_rxb)) ||
+	    (error = negroni_wlan_dma_alloc(N_TX_BUFS * TX_BUF, &g_txb)) ||
+	    (error = negroni_wlan_dma_alloc(NUM_TIDS * QDESC_SIZE, &g_qd))) {
+		return dp_fail(ENOMEM, "no DMA memory for the data path");
+	}
+	/* rdp (u32 per ring id) and wrp (u32 per LMAC ring) at the start of the ring area */
+	g_rdp = (volatile uint32_t *)g_rings.nc;
+	g_rdp_dva = g_rings.dva;
+	g_wrp = (volatile uint32_t *)(g_rings.nc + 1024);
+	g_wrp_dva = g_rings.dva + 1024;
+	memset((void *)g_rings.nc, 0, 2048);
+	g_rings_used = 2048;
+
+	/* WBM idle link ring + link descriptors (ath11k_wbm_idle_ring_setup, ath11k_dp_link_desc_setup) */
+	if ((error = ring_alloc(&R_wbm_idle, "WBM idle link", RID_WBM_IDLE_LINK, 2, N_LINK_DESC, true, false,
+	    WBM_REG + 0x870, WBM_REG + 0x30b0, 13))) {
+		return error;
+	}
+	ring_hw_init(&R_wbm_idle);
+	uint32_t nl = 0;
+	for (uint32_t i = 0; i < N_LINK_DESC; i++) {
+		volatile uint32_t *d = src_next(&R_wbm_idle);
+		if (!d) {
+			break;
+		}
+		uint64_t a = g_link.dva + (uint64_t)i * LINK_DESC_SIZE;
+		d[0] = (uint32_t)a;
+		d[1] = (uint32_t)((a >> 32) & 0xff) | (RBM_IDLE_DESC_LIST << 8) | (0u << 11);   /* cookie = bank 0 */
+		nl++;
+	}
+	ring_commit(&R_wbm_idle);
+
+	/* ath11k_dp_srng_common_setup order */
+	if ((error = ring_alloc(&R_wbm_rel, "SW2WBM release", RID_WBM_SW_RELEASE, 8, N_WBM_REL, true, false, WBM_REG + 0x1e8,
+	    WBM_REG + 0x3018, 14)) ||
+	    (error = ring_alloc(&R_tcl_cmd, "TCL cmd", RID_SW2TCL_CMD, 8, N_TCL_CMD, true, false, TCL_REG + 0x798,
+	    TCL_REG + 0x2018, 11)) ||
+	    (error = ring_alloc(&R_tcl_status, "TCL status", RID_TCL_STATUS, 9, N_TCL_STATUS, false, false, TCL_REG + 0x8a0,
+	    TCL_REG + 0x2030, 12)) ||
+	    (error = ring_alloc(&R_tcl_data, "TCL data 0", RID_SW2TCL(0), 8, N_TCL_DATA, true, false, TCL_REG + 0x690,
+	    TCL_REG + 0x2000, 8)) ||
+	    (error = ring_alloc(&R_tx_comp, "WBM2SW0 tx completion", RID_WBM2SW(0), 8, N_TX_COMP, false, false,
+	    WBM_REG + 0x920, WBM_REG + 0x30c0, 15)) ||
+	    (error = ring_alloc(&R_reo_reinject, "REO reinject", RID_SW2REO, 8, N_REO_REINJECT, true, false, REO_REG + 0x1ec,
+	    REO_REG + 0x3028, 5)) ||
+	    (error = ring_alloc(&R_rx_rel, "WBM2SW3 rx release", RID_WBM2SW(3), 8, N_RX_REL, false, false,
+	    WBM_REG + 0x920 + 3 * 0x58, WBM_REG + 0x30c0 + 3 * 8, 18)) ||
+	    (error = ring_alloc(&R_reo_except, "REO exception", RID_REO2TCL, 16, N_REO_EXCEPT, false, false, REO_REG + 0x454,
+	    REO_REG + 0x3060, 4)) ||
+	    (error = ring_alloc(&R_reo_cmd, "REO cmd", RID_REO_CMD, 10, N_REO_CMD, true, false, REO_REG + 0x194,
+	    REO_REG + 0x3020, 6)) ||
+	    (error = ring_alloc(&R_reo_status, "REO status", RID_REO_STATUS, 26, N_REO_STATUS, false, false, REO_REG + 0x55c,
+	    REO_REG + 0x3078, 7))) {
+		return error;
+	}
+	struct dp_ring *common[] = { &R_wbm_rel, &R_tcl_cmd, &R_tcl_status, &R_tcl_data, &R_tx_comp, &R_reo_reinject,
+		                     &R_rx_rel, &R_reo_except, &R_reo_cmd, &R_reo_status };
+	for (uint32_t i = 0; i < sizeof(common) / sizeof(common[0]); i++) {
+		ring_hw_init(common[i]);
+	}
+	/* TCL data descriptors carry a TLV header (ath11k_hal_tx_init_data_ring) */
+	for (uint32_t i = 0; i < N_TCL_DATA; i++) {
+		R_tcl_data.base[i * R_tcl_data.esz] = (HAL_TCL_DATA_CMD_TAG << 1) | ((7u * 4u) << 10);
+	}
+	/* REO cmd ring: command numbers (ath11k_hal_reo_init_cmd_ring) */
+	for (uint32_t i = 0; i < N_REO_CMD; i++) {
+		R_reo_cmd.base[i * R_reo_cmd.esz + 1] = (i + 1) & 0xffff;
+	}
+	/* REO (ath11k_hw_wcn6855_reo_setup) */
+	uint32_t hash = 1u << 0 | 2u << 4 | 3u << 8 | 4u << 12 | 1u << 16 | 2u << 20 | 3u << 24 | 4u << 28;
+	wr32(REO_REG + REO1_GEN_ENABLE, negroni_wlan_reg_rd(REO_REG + REO1_GEN_ENABLE) | (1u << 2) | (1u << 3));
+	wr32(REO_REG + REO1_MISC_CTL, negroni_wlan_reg_rd(REO_REG + REO1_MISC_CTL) & ~(0xfu << 17));   /* frag dst REO2SW1 */
+	for (uint32_t i = 0; i < 4; i++) {
+		wr32(REO_REG + REO1_AGING_IX(i), REO_AGING_US);
+	}
+	wr32(REO_REG + REO1_DEST_RING_CTRL_IX_2, hash);
+	wr32(REO_REG + REO1_DEST_RING_CTRL_IX_3, hash);
+	/* DSCP -> TID tables (ath11k_hal_tx_set_dscp_tid_map), 48 tables of 24 bytes: tid = dscp >> 3 */
+	uint32_t ctl = negroni_wlan_reg_rd(TCL_REG + TCL1_CMN_CTRL);
+	wr32(TCL_REG + TCL1_CMN_CTRL, ctl | TCL_DSCP_PROG_EN);
+	for (uint32_t id = 0; id < 48; id++) {
+		uint8_t m[24];
+		for (uint32_t i = 0, c = 0; i < 64; i += 8, c += 3) {
+			uint32_t val = 0;
+			for (uint32_t k = 0; k < 8; k++) {
+				val |= ((i + k) >> 3) << (3 * k);
+			}
+			memcpy(m + c, &val, 3);
+		}
+		for (uint32_t i = 0; i < 24; i += 4) {
+			uint32_t w;
+			memcpy(&w, m + i, 4);
+			wr32(TCL_REG + TCL1_DSCP_TID_MAP + id * 24 + i, w);
+		}
+	}
+	wr32(TCL_REG + TCL1_CMN_CTRL, negroni_wlan_reg_rd(TCL_REG + TCL1_CMN_CTRL) & ~TCL_DSCP_PROG_EN);
+	g_dp_on = true;
+	printf("NEGRONI WLAN: DP common rings up: %u link descriptors, TCL data %u, tx completion %u, REO exception %u, "
+	    "ring area %u bytes at device %#llx; TCL data base reads %#x (wrote %#x)\n", nl, N_TCL_DATA, N_TX_COMP,
+	    N_REO_EXCEPT, g_rings_used, g_rings.dva, negroni_wlan_reg_rd(R_tcl_data.r0), (uint32_t)R_tcl_data.dva);
+	if (negroni_wlan_reg_rd(R_tcl_data.r0) != (uint32_t)R_tcl_data.dva) {
+		return dp_fail(EIO, "TCL data ring base does not read back: the UMAC registers are not reached");
+	}
+	return 0;
+}
+
+/* ---- REO destination rings (ath11k_dp_pdev_reo_setup), before WMI INIT ---- */
+static int
+negroni_wlan_dp_reo_setup_inner(void)
+{
+	int error;
+
+	if (!g_dp_on) {
+		return 0;
+	}
+	for (uint32_t i = 0; i < 4; i++) {
+		if ((error = ring_alloc(&R_reo_dst[i], "REO2SW", RID_REO2SW(i), 16, N_REO_DST, false, false,
+		    REO_REG + 0x244 + i * 0x58, REO_REG + 0x3030 + i * 8, (int)i))) {
+			return error;
+		}
+		ring_hw_init(&R_reo_dst[i]);
+	}
+	printf("NEGRONI WLAN: DP REO2SW1..4 up (%u entries each)\n", N_REO_DST);
+	return 0;
+}
+
+/* ---- HTT messages ---- */
+void
+negroni_wlan_dp_htt_rx(const uint8_t *p, uint32_t len)
+{
+	uint32_t w0, w1, w2;
+
+	if (len < 4) {
+		return;
+	}
+	memcpy(&w0, p, 4);
+	switch (w0 & 0xff) {
+	case HTT_T2H_VERSION_CONF:
+		g_htt_minor = (w0 >> 8) & 0xff;
+		g_htt_major = (w0 >> 16) & 0xff;
+		g_htt_ver = true;
+		break;
+	case HTT_T2H_PEER_MAP:
+	case HTT_T2H_PEER_MAP2:
+		if (len >= 12) {
+			memcpy(&w1, p + 4, 4);
+			memcpy(&w2, p + 8, 4);
+			memcpy(g_peer_mac, &w1, 4);
+			g_peer_mac[4] = (uint8_t)w2;
+			g_peer_mac[5] = (uint8_t)(w2 >> 8);
+			g_peer_id = w0 >> 16;
+			g_peer_mapped = true;
+		}
+		break;
+	case HTT_T2H_PEER_UNMAP:
+	case HTT_T2H_PEER_UNMAP2:
+		if ((w0 >> 16) == g_peer_id) {
+			g_peer_mapped = false;
+			if (g_link_up) {
+				g_peer_lost = true;     /* review: the firmware dropped our AP peer: the join goes down */
+			}
+		}
+		break;
+	default:
+		g_htt_other++;
+		break;
+	}
+}
+
+static int
+htt_srng_setup(struct dp_ring *r, uint32_t mac_id, uint32_t htt_type, uint32_t htt_id)
+{
+	uint32_t m[13];
+	uint64_t hp, tp;
+
+	/* ath11k_hal_srng_get_hp_addr / _tp_addr for an LMAC ring */
+	if (r->src) {
+		hp = g_wrp_dva + 4ull * r->lmac_idx;
+		tp = g_rdp_dva + 4ull * r->ring_id;
+	} else {
+		hp = g_rdp_dva + 4ull * r->ring_id;
+		tp = g_wrp_dva + 4ull * r->lmac_idx;
+	}
+	uint32_t pdev = (htt_type == HTT_SW_TO_HW || htt_type == HTT_HW_TO_SW) ? mac_id + 1 : mac_id;
+	memset(m, 0, sizeof(m));
+	m[0] = HTT_H2T_SRING_SETUP | pdev << 8 | htt_id << 16 | htt_type << 24;
+	m[1] = (uint32_t)r->dva;
+	m[2] = (uint32_t)(r->dva >> 32);
+	m[3] = (r->size & 0xffff) | (r->esz << 16) | (htt_type == HTT_SW_TO_HW ? (1u << 25) : 0);
+	m[4] = (uint32_t)hp;
+	m[5] = (uint32_t)(hp >> 32);
+	m[6] = (uint32_t)tp;
+	m[7] = (uint32_t)(tp >> 32);
+	/* msi addr/data 0, intr_info 0 (polled), info2: low threshold 0 */
+	int error = negroni_wlan_htt_send(m, sizeof(m));
+	if (error) {
+		return dp_fail(error, "HTT SRING_SETUP for %s not sent", r->name);
+	}
+	return 0;
+}
+
+/* HTT_H2T_MSG_TYPE_RX_RING_SELECTION_CFG with an empty filter (monitor status off) */
+static int
+htt_ring_filter_off(struct dp_ring *r, uint32_t mac_id)
+{
+	uint32_t m[7];             /* htt_rx_ring_selection_cfg_cmd */
+
+	memset(m, 0, sizeof(m));
+	m[0] = HTT_H2T_RX_RING_SEL_CFG | (mac_id + 1) << 8 | HTT_RXDMA_MON_STATUS_RING << 16;
+	m[1] = RX_BUF;
+	(void)r;
+	return negroni_wlan_htt_send(m, sizeof(m));
+}
+
+/* ---- pdev setup (after WMI READY + hw mode) ---- */
+static int
+negroni_wlan_dp_pdev_setup_inner(void)
+{
+	int error;
+
+	if (!g_dp_on) {
+		return 0;
+	}
+	uint32_t ver = HTT_H2T_VERSION_REQ;
+	g_htt_ver = false;
+	if ((error = negroni_wlan_htt_send(&ver, 4)) ||
