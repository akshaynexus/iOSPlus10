+/*
+ * Patch 0281: a busy-based GPU DCVS governor instead of the one fixed vote. Runs on the watch
+ * thread (the only HFI sender once the GPU is kept), every DCVS_TICK_MS:
+ *   busy  = RBBM_STATUS GPU_BUSY_IGN_AHB (bit 23) or a submitted fence the core has not written
+ *   idle for DCVS_IDLE_MS            -> level DCVS_FLOOR (350 MHz)
+ *   busy in both of the last 2 ticks -> one level up per DCVS_UP_MS, up to the max
+ *   max = negronigpu_level (the start level; 0 = the table top), lowered by the thermal cap
+ *   (patch 0280 negroni_thermal_gpu_cap: one level per 10 s above 70 C, back below 60 C)
+ * The bw level follows the GX level (bw_level_num - 1 at the top, DCVS_BW_FLOOR at the floor).
+ * Boot-arg negronigpu_dcvs (default 1); 0 keeps the fixed vote of 0235. The WATCH line gets
+ * "dcvs L busy N%" and the thermal line; every vote change is logged (at most one line per second).
+ */
+#define DCVS_TICK_MS            100
+#define DCVS_IDLE_MS            500
+#define DCVS_UP_MS              200
+#define DCVS_FLOOR              4
+#define DCVS_BW_FLOOR           3
+#define REG_RBBM_STATUS_GPU_BUSY (1u << 23)
+extern uint32_t negroni_thermal_gpu_cap(void);
+extern void negroni_thermal_line(char *buf, size_t size);
+
+static uint32_t dcvs_on = 1, dcvs_level, dcvs_max, dcvs_busy_pct, dcvs_votes, dcvs_failed;
+
+static uint32_t
+dcvs_bw_for(uint32_t level, uint32_t top)
+{
+	uint32_t bw_top = 11;           /* bw_level_num - 1 (a730_build_bw_table) */
+	if (level >= top) {
+		return bw_top;
+	}
+	uint32_t bw = DCVS_BW_FLOOR + (bw_top - DCVS_BW_FLOOR) * (level - DCVS_FLOOR) / (top > DCVS_FLOOR ? top - DCVS_FLOOR : 1);
+	return bw < DCVS_BW_FLOOR ? DCVS_BW_FLOOR : bw > bw_top ? bw_top : bw;
+}
+
+/* One governor tick; returns true when it voted. */
+static bool
+dcvs_tick(bool gx, uint32_t rbbm, uint32_t *idle_ms, uint32_t *busy_ms, uint32_t *busy_ticks, uint32_t *ticks)
+{
+	uint32_t top = sizeof(gpu_khz) / sizeof(gpu_khz[0]) - 1;
+	bool busy = gx && ((rbbm & REG_RBBM_STATUS_GPU_BUSY) != 0 || negroni_gpu_completed() != gpu_fence);
+	uint32_t cap = negroni_thermal_gpu_cap(), max = dcvs_max;
+
+	if (cap >= DCVS_FLOOR && cap < max) {
+		max = cap;
+	}
+	(*ticks)++;
+	if (busy) {
+		(*busy_ticks)++;
+		*busy_ms += DCVS_TICK_MS;
+		*idle_ms = 0;
+	} else {
+		*idle_ms += DCVS_TICK_MS;
+		*busy_ms = 0;
+	}
+	if (*ticks >= 10) {
+		dcvs_busy_pct = *busy_ticks * 100 / *ticks;
+		*ticks = *busy_ticks = 0;
+	}
+	uint32_t want = dcvs_level;
+	if (*idle_ms >= DCVS_IDLE_MS) {
+		want = DCVS_FLOOR;
+	} else if (*busy_ms >= DCVS_UP_MS) {
+		want = dcvs_level + 1;
+		*busy_ms = 0;
+	}
+	if (want > max) {
+		want = max;
+	}
+	if (want < DCVS_FLOOR) {
+		want = DCVS_FLOOR;
+	}
+	if (want > top) {
+		want = top;
+	}
+	if (want == dcvs_level || !gx) {
+		return false;
+	}
+	uint32_t vote[4] = { 0, 1 /* blocking ack */, want, dcvs_bw_for(want, top) };
+	hfi_quiet = true;
+	bool ok = hfi_send("GX_BW_PERF_VOTE", 30, vote, sizeof(vote));
+	hfi_quiet = false;
+	dcvs_votes++;
+	if (!ok) {
+		dcvs_failed++;
+		if (dcvs_failed <= 3) {
+			printf("NEGRONI GPU DCVS: vote level %u FAILED (%u of %u)\n", want, dcvs_failed, dcvs_votes);
 		}
+		return false;
 	}
+	dcvs_level = want;
+	vote_level = want;
+	vote_bw = vote[3];
+	return true;
 }
 
