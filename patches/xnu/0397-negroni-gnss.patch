+static uint64_t
+ms_since(uint64_t t0)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	return ns / 1000000;
+}
+
+static uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb osh" ::: "memory");
+	return v;
+}
+
+static void
+wr32(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb osh" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+#define le16 gc_le16
+#define le32 gc_le32
+#define le64 gc_le64
+
+/* The SCM call of negroni_slpi.c, with a fourth argument in x5 (the extra-argument buffer of a 7-arg call). */
+static int32_t
+scm(const char *what, uint64_t function, uint64_t args, uint64_t a0, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t *answer)
+{
+	uint64_t t0 = mach_absolute_time();
+
+	for (int busy = 0; busy <= 20; busy++) {
+		uint64_t session = 0;
+		int i;
+		for (i = 0; i < 2000000; i++) {
+			register uint64_t x0 __asm__("x0") = i == 0 ? function : SCM_INTERRUPTED;
+			register uint64_t x1 __asm__("x1") = args;
+			register uint64_t x2 __asm__("x2") = a0;
+			register uint64_t x3 __asm__("x3") = a1;
+			register uint64_t x4 __asm__("x4") = a2;
+			register uint64_t x5 __asm__("x5") = a3;
+			register uint64_t x6 __asm__("x6") = session;
+			register uint64_t x7 __asm__("x7") = 0;
+
+			__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3), "+r" (x4), "+r" (x5), "+r" (x6),
+			    "+r" (x7) : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+			session = x6;
+			if (x0 == SCM_INTERRUPTED) {
+				continue;
+			}
+			if ((int32_t)x0 == -12 && busy < 20) {
+				IOSleep(30);
+				break;
+			}
+			if (x0 == 2) {
+				say("%u SCM %s: WAITQ_SLEEP: not supported", step, what);
+				return -1;
+			}
+			say("%u SCM %s -> %d, answer %#llx (%llu ms)", step, what, (int32_t)x0, x1, ms_since(t0));
+			*answer = x1;
+			return (int32_t)x0;
+		}
+		if (i == 2000000) {
+			break;
+		}
+	}
+	say("%u SCM %s keeps returning interrupted or busy (%llu ms)", step, what, ms_since(t0));
+	return -1;
+}
