+static void
+gn_set_off(const char *fmt, ...) __printflike(1, 2);
+
+static void
+gn_set_off(const char *fmt, ...)
+{
+	char why[192];
+	va_list ap;
+
+	va_start(ap, fmt);
+	vsnprintf(why, sizeof(why), fmt, ap);
+	va_end(ap);
+	lck_mtx_lock(&gn_lock);
+	if (gn_state == GN_OFF) {
+		lck_mtx_unlock(&gn_lock);
+		return;
+	}
+	gn_state = GN_OFF;
+	gn_session_on = false;
+	strlcpy(gn_reason, why, sizeof(gn_reason));
+	lck_mtx_unlock(&gn_lock);
+	printf("NEGRONI GNSS: off: %s\n", why);
+}
