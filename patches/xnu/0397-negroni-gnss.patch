+#define GN_WIMG_WCOMB           0x6u            /* VM_WIMG_WCOMB, as negroni_adsp.c */
+#define GN_SETTLE_S             20u             /* boot I/O first: the firmware read is ~110 MB */
+#define GN_READY_S              10u             /* step 10: READY after auth and reset */
+#define GN_LOC_WAIT_S           180u            /* step 12: the modem reads its files first (~30 s on SM7325) */
+#define GN_DEMAND_S             30u             /* a session runs while /dev/negroni_gnss was read in the last 30 s */
+#define GN_PING_S               30u             /* liveness request period */
+#define GN_PING_LOST            3u              /* lost answers in a row = off */
+#define GN_FRESH_MS             3000u           /* the locd= line only for a fix younger than this */
+
+/* ---- addresses (live DT) ---- */
+#define SMEM_PHYS               0x80900000UL
+#define SMEM_SIZE               0x00200000u
+#define MPSS_MEM_PHYS           0x8bc00000UL    /* mpss_region@8bc00000 { reg = <0 0x8bc00000 0 0x13200000> } */
+#define MPSS_MEM_SIZE           0x13200000u
+_Static_assert((MPSS_MEM_SIZE & 0x3fffu) == 0, "ml_io_unmap needs a 16 KiB page multiple");
+#define IPCC_PHYS               0x0ed18000UL
+#define AOSS_PHYS               0x0c300000UL
+#define AOSS_SIZE               0x400u
+#define TCSR_MUTEX_PHYS         0x01f43000UL    /* smem hwlocks = <&tcsr_mutex 3> */
+/*
+ * The RMTFS buffer. The DT node qcom,rmtfs_sharedmem@0 has a dynamic address (Linux takes it from its CMA
+ * below 4 GiB). The modem's RMTFS requests carry 32-bit addresses (HakiOS: a buffer above 4 GiB fails), and
+ * all XNU RAM on this port is at 0x841000000 or higher. So the buffer is the start of the Mu memory map
+ * region "Kernel" 0xa8000000 + 256 MiB (Reserv, HLOS memory: where ABL loads a Linux kernel; nothing of
+ * this port uses it after Mu) [I: free; HakiOS used the same Mu region on SM7325].
+ */
+#define GN_RMTFS_PHYS           0xa8000000UL
+#define GN_RMTFS_SIZE           0x280000u       /* reg of qcom,rmtfs_sharedmem@0 */
+_Static_assert((GN_RMTFS_SIZE & 0x3fffu) == 0, "16 KiB page multiple");
+
+/* ---- SCM ---- */
+#define SCM_64                  (1ull << 30)
+#define SCM_SIP                 (2ull << 24)
+#define SCM_CALL(svc, cmd)      ((uint64_t)(svc) << 8 | (cmd))
+#define SCM_PAS_INIT_IMAGE      SCM_CALL(2, 1)
+#define SCM_PAS_MEM_SETUP       SCM_CALL(2, 2)
+#define SCM_PAS_AUTH_AND_RESET  SCM_CALL(2, 5)
+#define SCM_PAS_SHUTDOWN        SCM_CALL(2, 6)
+#define SCM_PAS_IS_SUPPORTED    SCM_CALL(2, 7)
+#define SCM_MP_ASSIGN           SCM_CALL(0xc, 0x16)
+#define SCM_ONE_VALUE           1
+#define SCM_THREE_VALUES        3
+#define SCM_VALUE_AND_BUFFER    (2 | 2 << 6)
+#define SCM_ASSIGN_ARGS         0x1117          /* 7 args: buf, val, buf, val, buf, val, val (qcom_scm_assign_mem) */
+#define SCM_INTERRUPTED         1
+#define PAS_MPSS                4               /* sm8450_mpss_resource .pas_id */
+#define VMID_HLOS               3
+#define VMID_MSS_MSA            15
+#define VM_PERM_RW              6
+
+/* ---- SMEM ---- */
+#define SMEM_APPS               0
+#define SMEM_MPSS               1               /* qcom,remote-pid of smp2p-modem and the glink-edge */
+#define SMEM_GLOBAL             0xfffe
+#define SMEM_CANARY             0xa5a5
+#define ITEM_CRASH_REASON       421             /* sm8450_mpss_resource .crash_reason_smem */
+#define ITEM_SMP2P_OURS         428             /* qcom,smem = <0x1b3 0x1ac> = <435 428>: inbound, outbound */
+#define ITEM_SMP2P_THEIRS       435
+#define ITEM_GLINK_DESC         478
+#define ITEM_GLINK_FIFO0        479
+#define ITEM_GLINK_FIFO1        480
+
+/* ---- SMP2P ---- */
+#define SMP2P_MAGIC             0x504d5324      /* "$SMP" */
+#define SMP2P_VERSION           1
+#define SMP2P_FEATURE_SSR_ACK   1u
+#define SMP2P_ENTRIES           16
+#define SMP2P_ITEM_SIZE         (20 + 20 * SMP2P_ENTRIES)
+#define DSP_FATAL               (1u << 0)
+#define DSP_READY               (1u << 1)
+#define DSP_HANDOVER            (1u << 2)
+#define DSP_STOP_ACK            (1u << 3)
+
+/* ---- IPCC ---- */
+#define IPCC_SEND_ID            0x0c
+#define IPCC_CLIENT_AOP         0u
+#define IPCC_CLIENT_MPSS        2u              /* mboxes = <&ipcc 2 ...> */
+#define IPCC_SIGNAL_GLINK       0u
+#define IPCC_SIGNAL_SMP2P       2u
+
+/* ---- AOSS QMP (qcom_aoss.c) ---- */
+#define QMP_MAGIC               0x00
+#define QMP_MAGIC_VALUE         0x4d41494c
+#define QMP_VERSION             0x04
+#define QMP_UCORE_LINK          0x0c
+#define QMP_UCORE_LINK_ACK      0x10
+#define QMP_UCORE_CH            0x14
+#define QMP_UCORE_CH_ACK        0x18
+#define QMP_MCORE_LINK          0x24
+#define QMP_MCORE_LINK_ACK      0x28
+#define QMP_MCORE_CH            0x2c
+#define QMP_MCORE_CH_ACK        0x30
+#define QMP_MCORE_MBOX_SIZE     0x34
+#define QMP_MCORE_MBOX_OFFSET   0x38
+#define QMP_UP                  0x0000ffffu
