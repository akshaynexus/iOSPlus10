+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t entry_lba;
+	uint32_t nent, esz;
+	int error = ufs_read_blocks_lun(lun, 1, 1);
+
+	if (error) {
+		return error;
+	}
+	if (memcmp(b, "EFI PART", 8) != 0) {
+		return ENOENT;
+	}
+	memcpy(&entry_lba, b + 72, 8);
+	memcpy(&nent, b + 80, 4);
+	memcpy(&esz, b + 84, 4);
+	if (esz != 128 || nent == 0 || nent > 1024 || nent * esz > BOUNCE_SIZE || entry_lba < 2 || entry_lba > 64) {
+		return ENOENT;
+	}
+	error = ufs_read_blocks_lun(lun, entry_lba, (nent * esz + UFS_BLOCK - 1) / UFS_BLOCK);
+	if (error) {
+		return error;
+	}
+	for (uint32_t i = 0; i < nent; i++) {
+		const uint8_t *e = b + i * esz;
+		char name[37];
+		unsigned c;
+		uint64_t f, l;
+
+		for (c = 0; c < 36; c++) {
+			uint16_t ch = (uint16_t)(e[56 + 2 * c] | e[57 + 2 * c] << 8);
+			if (ch == 0 || ch > 0x7f) {
+				break;
+			}
+			name[c] = (char)ch;
+		}
+		name[c] = 0;
+		if (strcmp(name, want) != 0) {
+			continue;
+		}
+		memcpy(&f, e + 32, 8);
+		memcpy(&l, e + 40, 8);
+		if (l < f || l > UINT32_MAX) {
+			return ENOENT;
+		}
+		*first = f;
+		*blocks = l - f + 1;
+		return 0;
+	}
+	return ENOENT;
+}
+
+/*
+ * The partition `name` (one of ufs_part_allowed) on LUN 0..7: its handle (>= 0) and size in bytes, or
+ * -errno. The scan result is kept; LUNs are searched in the order 4, 5, then 0..7 (NE2211 layout first).
+ */
+int negroni_ufs_part_open(const char *name, uint64_t *bytes);
+
+int
+negroni_ufs_part_open(const char *name, uint64_t *bytes)
+{
+	static const uint8_t order[] = { 4, 5, 0, 1, 2, 3, 6, 7 };
+	unsigned h;
+	int error = ENOENT;
+
+	for (h = 0; h < UFS_PART_MAX && strcmp(ufs_part_allowed[h], name) != 0; h++) {
+	}
+	if (h == UFS_PART_MAX || !su.ready) {
+		return h == UFS_PART_MAX ? -EPERM : -ENXIO;
+	}
+	lck_mtx_lock(&negroni_ufs_lock);
+	for (unsigned i = 0; i < sizeof(order) && !ufs_part[h].found; i++) {
+		uint64_t f = 0, n = 0;
+		int e = ufs_part_scan_locked(order[i], name, &f, &n);
+		if (e == 0) {
+			ufs_part[h].lun = order[i];
+			ufs_part[h].first = f;
+			ufs_part[h].blocks = n;
+			ufs_part[h].found = true;
+		} else if (e != ENOENT && error == ENOENT) {
+			error = e;
+		}
+	}
+	lck_mtx_unlock(&negroni_ufs_lock);
+	if (!ufs_part[h].found) {
+		return -error;
+	}
+	printf("NEGRONI UFS: partition \"%s\" (read only): LUN %u, first block 0x%llx, %llu KiB\n", name, ufs_part[h].lun,
+	    ufs_part[h].first, ufs_part[h].blocks * (UFS_BLOCK / 1024));
+	*bytes = ufs_part[h].blocks * UFS_BLOCK;
+	return (int)h;
+}
+
+/* `count` bytes at byte `at` of an opened partition into `dst` (kernel memory). Read only. */
+int negroni_ufs_part_read(int handle, uint64_t at, void *dst, uint32_t count);
+
+int
+negroni_ufs_part_read(int handle, uint64_t at, void *dst, uint32_t count)
+{
+	const uint8_t *bounce = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint8_t *to = (uint8_t *)dst;
+
+	if (handle < 0 || (unsigned)handle >= UFS_PART_MAX || !ufs_part[handle].found || !su.ready) {
+		return EINVAL;
+	}
+	uint64_t size = ufs_part[handle].blocks * UFS_BLOCK;
+	if (at > size || count > size - at) {
+		return EINVAL;
+	}
+	while (count > 0) {
+		uint32_t skip = (uint32_t)(at % UFS_BLOCK);
+		uint32_t n = MIN(count, BOUNCE_SIZE - skip);
+		uint32_t nblk = (skip + n + UFS_BLOCK - 1) / UFS_BLOCK;
+		int error;
+
+		lck_mtx_lock(&negroni_ufs_lock);
+		error = ufs_read_blocks_lun(ufs_part[handle].lun, ufs_part[handle].first + at / UFS_BLOCK, nblk);
+		if (!error) {
+			memcpy(to, bounce + skip, n);
+		}
+		lck_mtx_unlock(&negroni_ufs_lock);
+		if (error) {
+			return error;
+		}
+		to += n;
+		at += n;
+		count -= n;
+	}
+	return 0;
+}
