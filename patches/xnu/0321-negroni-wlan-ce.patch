+/* ---- 0321: the CE driver (negroni_wlan_ce.c) ---- */
+/* HTC header (htc.h:12-30): htc_info = eid 7:0 | flags 15:8 | payload length 31:16; ctrl_info = trailer
+ * length 7:0 (ControlBytes0) | sequence 15:8 */
+#define HTC_HDR_LEN             8u
+#define HTC_FLAG_NEED_CREDIT    0x01u
+#define HTC_FLAG_TRAILER        0x02u
+#define HTC_MSG_READY           1u
+#define HTC_MSG_CONNECT         2u
