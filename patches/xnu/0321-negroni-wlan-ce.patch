+
+struct negroni_wlan_htc_ready {
+	uint32_t pipe;                  /* the CE it came on */
+	uint32_t credits, credit_size, max_endpoints;
+	uint32_t version, max_bundle;   /* the extended part, when present */
+	bool extended;
+};
+
+struct negroni_wlan_ce_stats {
+	uint32_t rx[4], tx[4], tx_done, tx_full, bad_len, bad_ptr;
+};
+extern struct negroni_wlan_ce_stats negroni_wlan_ce_stats;
+/* every received CE buffer (a private copy, valid during the call); 0322 installs the HTC receiver */
+extern void (*negroni_wlan_ce_rx_cb)(uint32_t pipe, const uint8_t *data, uint32_t len);
+
+extern struct negroni_wlan_htc_ready negroni_wlan_ready;  /* negroni_wlan.c, step 28 */
+int negroni_wlan_ce_start(void);                        /* step 27 */
+int negroni_wlan_ce_wait_ready(struct negroni_wlan_htc_ready *out);     /* step 28 */
+int negroni_wlan_ce_send(uint32_t pipe, const void *data, uint32_t len, uint32_t transfer_id);
+uint32_t negroni_wlan_ce_tx_free(uint32_t pipe);
+void negroni_wlan_ce_poll(void);
+void negroni_wlan_ce_free(void);
+/* pure parser of an HTC READY buffer (header included); 0 or EBADMSG (host-tested) */
+int negroni_wlan_htc_parse_ready(const uint8_t *b, uint32_t len, uint32_t pipe, struct negroni_wlan_htc_ready *out);
+
 #endif /* ARM64_BOARD_CONFIG_NEGRONI */
 #endif /* _NEGRONI_WLAN_CE_H_ */
