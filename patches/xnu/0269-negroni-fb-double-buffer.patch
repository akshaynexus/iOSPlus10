+{
+	if (!fDbuf) {
+		return;
+	}
+	for (uint32_t i = 0; i < 80 && fDbFlipped >= 0 && !zeroCopyLatched(); i++) {
+		delay_for_interval(250, kMicrosecondScale);
+	}
+	if (fDbFlipped >= 0) {
+		if (!zeroCopyLatched()) {
