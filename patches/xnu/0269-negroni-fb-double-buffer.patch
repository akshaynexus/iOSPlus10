+
+/* Back to one buffer for good: the pipes on the panel memory (ABL's values). Work loop. */
+void
+AppleCLCD::dbufOff(const char *why)
+{
+	IOLog("NEGRONI FB: 0269 double buffering off: %s (CTL_FLUSH 0x%x, %llu flips)\n", why,
+	    negroni_dpu_rd(fMdss + fZCCtl + CTL_FLUSH), fDbFlipsTotal);
+	NegroniGPUFenceWait(fLastGPUFence, NEGRONI_FB_GPU_COPY_WAIT_MS);
+	fDbuf = false;
+	zeroCopyRestore();
+	for (uint32_t i = 0; i < fDbN; i++) {
+		fDb[i].state = i == 0 ? kNegroniDbShown : kNegroniDbFree;
+	}
+	fDbShown = fDbDraw = 0;
+	fDbFlipped = fDbTarget = -1;
+	fPixels = fDb[0].pixels;
+	fDrawPhys = fPhys;
+	IOLockLock(fLock);
+	fDirty = true;                  /* the latest frame again, into the panel memory */
+	IOLockUnlock(fLock);
+}
