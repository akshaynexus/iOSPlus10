+		}
+		fDbShown = fDbFlipped;  /* taken: no new flip here, the black goes into this one */
+		fDb[fDbShown].state = kNegroniDbShown;
+		fDbFlipped = -1;
+	}
+	for (uint32_t i = 0; i < fDbN; i++) {
+		if ((int32_t)i != fDbShown) {
+			fDb[i].state = kNegroniDbFree;
+		}
+	}
