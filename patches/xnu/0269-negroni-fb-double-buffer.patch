+/* ---- panel double buffering (0269) ---- */
+
+/*
+ * negronifb_dbuf=1: present() writes a buffer the display engine does not fetch, and the pipes
+ * get that buffer's address once the copy is done, the way Android's commit does it
+ * (sde_hw_sspp_setup_sourceaddress sde_hw_sspp.c:925-948: SSPP_SRC0_ADDR; sde_hw_ctl_trigger_flush_v1
+ * sde_hw_ctl.c:685-711: CTL_FLUSH with the pipe's bit, sspp_tbl :78-79, and CTL bit 17; the engine
+ * takes the flushed registers at the next frame start). The UEFI's auto-refresh is the frame
+ * start here (no CTL_START: under auto-refresh Android does not kick either,
+ * sde_encoder_phys_cmd.c:2169-2175): a flip written before a TE is shown from that TE on, a whole
+ * frame, never half a copy. The buffers: the panel memory (ABL's, at the pipes' address) and
+ * negronifb_dbufn - 1 more (default 2: three in all) right after it in the splash region. Two
+ * buffers would let the GPU path reach 60 frames/s only: the copy into the back buffer ends some
+ * ms after the tick, the flip goes at the next tick, and the buffer that was shown is free only
+ * after that flip is taken, one tick later again. Pipes, CTL and flush bits come from 0234's probe
+ * (zeroCopyInit, read only). negronifb_dbuf=0 (default): one buffer, as before.
+ */
+void
+AppleCLCD::dbufInit(void)
+{
+	uint32_t on = 0, n = NEGRONI_DB_MAX;
+	const char *why = NULL;
+	uint64_t size = round_page((uint64_t)fRowBytes * fHeight);
+
+	fDrawPhys = fPhys;
+	fDbShown = 0;
+	fDbFlipped = fDbTarget = -1;
+	fDbDraw = 0;
+	fDb[0].phys = fPhys;
+	fDb[0].pixels = fPixels;
+	fDb[0].surface = fSurface;
+	fDb[0].state = kNegroniDbShown;
+	PE_parse_boot_argn("negronifb_dbuf", &on, sizeof(on));
+	PE_parse_boot_argn("negronifb_dbufn", &n, sizeof(n));
+	if (!on) {
+		IOLog("NEGRONI FB: 0269 double buffering off (negronifb_dbuf=0): one panel buffer\n");
+		return;
+	}
+	n = n < 2 ? 2 : (n > NEGRONI_DB_MAX ? NEGRONI_DB_MAX : n);
+	if (fMdss == 0 || !fZCLayoutOk) {
+		why = "the DPU probe found no pipe layout to flip (negronifb_dpuprobe=0, or see the NEGRONI FB: DPU lines)";
+	} else if (fZCReady) {
+		why = "zero-copy (negronifb_zerocopy=1) has the splash region";
+	} else if (fPhys + n * size > NEGRONI_DB_END) {
+		why = "no room in the splash region";
+	}
+	for (uint32_t i = 1; why == NULL && i < n; i++) {
+		fDb[i].phys = fPhys + i * size;
+		fDb[i].surface = negroni_surface_create_physical(fDb[i].phys, fWidth, fHeight, fRowBytes, NEGRONI_FB_FORMAT_BGRA);
+		fDb[i].pixels = fDb[i].surface != NULL ? fDb[i].surface->kernelAddress() : 0;
+		fDb[i].state = kNegroniDbFree;
+		if (fDb[i].pixels == 0) {
+			why = "a buffer cannot be mapped";
+		}
+	}
+	if (why != NULL) {
+		IOLog("NEGRONI FB: 0269 double buffering off: %s\n", why);
+		return;
+	}
+	fDbN = n;
+	fDbuf = true;
+	negroni_fb_zc = this;           /* the panic hook puts the pipes back on the panel memory */
+	IOLog("NEGRONI FB: 0269 double buffering on: %u panel buffers of 0x%llx at 0x%llx 0x%llx%s0x%llx, pipe(s) %s%s%s, "
+	    "CTL at +0x%x, flush bits 0x%x\n", n, size, fDb[0].phys, fDb[1].phys, n > 2 ? " " : "", n > 2 ? fDb[2].phys : 0ULL,
+	    negroni_sspp_name[fZCPipe[0]], fZCPipes > 1 ? "+" : "", fZCPipes > 1 ? negroni_sspp_name[fZCPipe[1]] : "",
+	    fZCCtl, fZCFlush);
+}
+
+bool
+AppleCLCD::dbufAnyPending(void)
+{
+	for (uint32_t i = 0; i < fDbN; i++) {
+		if (fDb[i].state == kNegroniDbPending) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * Which buffer this frame (rec) is written into; false: none yet, the frame stays pending (next
+ * tick). A frame of one layer that covers the whole panel goes into a free buffer; anything else
+ * (several layers, a part of the panel) is drawn over the picture on screen, so it waits until
+ * no copy and no flip is outstanding and then goes into the shown buffer (the old single-buffer
+ * way, rare: CoreAnimation sends full-canvas frames of one layer). A frame with the panel memory
+ * itself as a layer (GetLayerDefaultSurface) shows the panel memory. Work loop, fLock held.
+ */
+bool
+AppleCLCD::dbufTarget(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104), layers = 0;
+	int32_t last = -1;
+	bool panel = false, full = false;
+
+	fDbTarget = -1;
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		layers++;
+		last = (int32_t)layer;
+		panel = panel || (fSurface != NULL && id == fSurface->id);
+	}
+	if (!panel && layers == 1) {
+		/* present()'s mapping: logical -> panel coordinates, clipped at the left/top edge */
+		const uint8_t *a = rec + 0x64 + 16 * last, *b = rec + 0xc4 + 16 * last;
+		int32_t aw = (int32_t)get32(a, 8), ah = (int32_t)get32(a, 12);
+		int32_t dx = (int32_t)get32(b, 0) - fOffX, dy = (int32_t)get32(b, 4) - fOffY;
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+		int32_t cx = dx < 0 ? -dx : 0, cy = dy < 0 ? -dy : 0;
+		full = (int32_t)get32(b, 0) >= 0 && (int32_t)get32(b, 4) >= 0 && w > 0 && h > 0 && dx <= 0 && dy <= 0 &&
+		    w - cx >= (int32_t)fWidth && h - cy >= (int32_t)fHeight &&
+		    aw - cx >= (int32_t)fWidth && ah - cy >= (int32_t)fHeight;
+	}
+	int32_t t = -1;
+	if (panel) {
+		t = fDbFlipped < 0 && !dbufAnyPending() ? 0 : -1;
+	} else if (full) {
+		for (uint32_t i = 0; i < fDbN && t < 0; i++) {
+			if (fDb[i].state == kNegroniDbFree) {
+				t = (int32_t)i;
+			}
+		}
+	} else if (fDbFlipped < 0 && !dbufAnyPending()) {
+		t = fDbShown;
+		fStatDbInPlace++;
+	}
+	if (t >= 0 && fShiftPending && t != fDbDraw) {
+		t = -1;                 /* 0256: the last frame's clock shift is still to do in its buffer */
+	}
+	if (t < 0) {
+		fStatDbWaits++;
+		return false;
+	}
+	fDbTarget = t;
+	fDbDraw = t;
+	fPixels = fDb[t].pixels;
+	fDrawPhys = fDb[t].phys;
+	return true;
+}
+
+/* present() queued the frame into fDbTarget (fence: its newest GPU copy, 0: all done by the CPU). */
+void
+AppleCLCD::dbufQueued(uint32_t fence)
+{
+	int32_t t = fDbTarget;
+
+	fDbTarget = -1;
+	if (!fDbuf || t < 0 || t == fDbShown || t == fDbFlipped) {
+		return;                 /* drawn in place */
+	}
+	fDb[t].state = kNegroniDbPending;
+	fDb[t].fence = fence;
+	fDb[t].seq = ++fDbSeq;
+}
+
+/* The pipes fetch buffer i from the next frame start on. */
+void
+AppleCLCD::dbufFlip(int32_t i)
+{
+	/* the CPU's stores to the write-combined buffer (copy, badges) reach memory before the engine reads it */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t p = 0; p < fZCPipes; p++) {
+		negroni_dpu_wr(fMdss + negroni_sspp_off[fZCPipe[p]] + SSPP_SRC0_ADDR, (uint32_t)fDb[i].phys);
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	negroni_dpu_wr(fMdss + fZCCtl + CTL_FLUSH, fZCFlush);
+	fDb[i].state = kNegroniDbFlipped;
+	fDbFlipped = i;
+	fDbFlipTicks = 0;
+	fDbFlipAt = mach_absolute_time();
+	fStatDbFlips++;
+	fDbFlipsTotal++;
+	if (fDbLogged < 4) {
+		/* bring-up: how long the engine takes to apply a flip (expected: up to one 8.3 ms frame) */
+		uint32_t k;
+		uint64_t ns;
+		fDbLogged++;
+		for (k = 0; k < 80 && !zeroCopyLatched(); k++) {
+			delay_for_interval(250, kMicrosecondScale);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time() - fDbFlipAt, &ns);
+		IOLog("NEGRONI FB: 0269 flip %llu: buffer %d at 0x%llx (fence %u), %s after %llu us, CTL_FLUSH 0x%x\n",
+		    fDbFlipsTotal, i, fDb[i].phys, fDb[i].fence, zeroCopyLatched() ? "taken" : "NOT taken", ns / 1000,
+		    negroni_dpu_rd(fMdss + fZCCtl + CTL_FLUSH));
+	}
+}
+
+/*
+ * Every vsync tick (tick) and after the frame's copy (not tick): a taken flip makes its buffer the
+ * shown one and frees the one before; the newest pending buffer whose copy is done (and whose
+ * CPU drawing, presentFinish / the 0256 shift, is done) is flipped. Work loop.
+ */
+void
+AppleCLCD::dbufTick(bool tick)
+{
+	if (!fDbuf) {
+		return;
+	}
+	if (fDbFlipped >= 0) {
+		if (zeroCopyLatched()) {
+			uint64_t dt = mach_absolute_time() - fDbFlipAt;
+			if (dt > fStatDbLatchMaxAbs) {
+				fStatDbLatchMaxAbs = dt;
+			}
+			if (fDbShown >= 0 && fDbShown != fDbFlipped) {
+				fDb[fDbShown].state = kNegroniDbFree;
+			}
+			fDbShown = fDbFlipped;
+			fDb[fDbShown].state = kNegroniDbShown;
+			fDbFlipped = -1;
+		} else if (tick && !fPowerOff && !fArPaused && ++fDbFlipTicks > NEGRONI_DB_LATCH_TICKS) {
