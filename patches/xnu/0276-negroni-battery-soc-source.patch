+/* 0276: the plug state only, between the full reads: VBUS through the VADC (modes 4/5; one ADC7
+ * conversion), else the BCL current direction (observer reads). On a change the keys the status bar
+ * reads first are published at once, then the full read runs. The charger's own USBIN plug bit
+ * (SMB5 USBIN_INT_RT_STS 0x1310 bit 4) has no APID in the HLOS map (0272/0273), and the SID 3 rt_sts
+ * bits the census watches (0x2710 bit 6) follow the load current, not the cable (logs 2026-10-26). */
+void
+NegroniBattery::fastCheck(void)
+{
+	bool known = false, ext = fExternal;
+	unsigned usbMv = 0;
+	uint64_t now, ns;
+	clock_get_uptime(&now);
+	absolutetime_to_nanoseconds(now, &ns);
+	if (fVadc) {
+		int64_t uv = 0;
+		if (adcMicro(kUsbIn, &uv)) {
+			usbMv = (unsigned)(uv / 1000);
+			ext = usbMv >= NB_EXT_MV;
+			known = true;
+		}
+	} else if (fReal && fIbatSeen) {
+		nb_sample s = {};
+		readBcl(s);
+		if (s.bclIbatOk && s.bclIbatNonzero) {
+			if (s.bclIbatMa >= NB_CUR_MA) {
+				ext = true;
+				known = true;
+			} else if (s.bclIbatMa <= -NB_CUR_MA) {
+				ext = false;
+				known = true;
+			}
+		}
+	}
+	uint64_t sinceMs = fFastNs && ns > fFastNs ? (ns - fFastNs) / 1000000ull : 0;
+	fFastNs = ns;
+	if (!known || ext == fExternal) {
+		return;
+	}
+	IOLog("NEGRONI BATTERY: external %d->%d (usbin %u mV) after %llu ms\n", fExternal, ext, usbMv,
+	    (unsigned long long)sinceMs);
+	fExternal = ext;
+	setExternalConnected(ext);
+	setExternalChargeCapable(ext);
+	if (!ext) {
+		setIsCharging(false);
+	}
+	putBool("AppleRawExternalConnected", ext);
+	updateStatus();
+	fTicks = 0;
+	poll();
+}
