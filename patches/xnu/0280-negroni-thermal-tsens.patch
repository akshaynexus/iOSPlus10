 #define EPSS_PHYS               0x17d91000UL    /* domain 0: A510 0-3, 1: A710 4-6, 2: X2 7 */
 #define EPSS_DOMAIN_SIZE        0x1000UL
@@ -32,6 +35,10 @@
 #define XO_KHZ                  19200
 #define ALTERNATE_KHZ           300000          /* source 0: GPLL0 300 MHz */
 
+static vm_offset_t dom_base[EPSS_DOMAINS];
+static uint32_t dom_abl_row[EPSS_DOMAINS], dom_cores[EPSS_DOMAINS];
