+/*
+ * 0375: data-path watchdog (boot-arg negroniusb_idle_reboot=S, default 0 =
+ * off). Its own kernel thread, so it runs when ud_thread, the network stack
+ * or the endpoint queues are stuck. Every 250 ms. Once the device was
+ * configured AND a host frame reached the bulk OUT path in this boot: when
+ * no OUT frame came for S s, or one IN transfer has been active for S s
+ * without XferComplete, it logs one line, sets reboot reason 0 and resets
+ * like the "reboot" command (0367 boot log end mark, PSCI SYSTEM_RESET).
+ * It does the reset itself (ud_ctl_poll runs in ud_thread, which may be the
+ * stuck part); a thread_call resets 5 s later if the end mark blocks (UFS
+ * lock). Once per boot. Never in panic mode. A pending USB command (reset,
+ * power off, panic) wins; only when it is still not run 5 s after its time
+ * (ud_thread stuck) the watchdog resets (the command's reason stays).
+ * It also logs when ud_thread has not started a loop pass for 5 s (step,
+ * last event) and keeps its own DSTS.SOFFN sample (SOF age in the line).
+ * Host side: something must reach the phone at least every S s; the
+ * usblog script sends a UDP broadcast every 10 s (USBLOG_KEEPALIVE).
+ */
+static int ud_idle_chan;
+static thread_call_t ud_idle_fallback;
+
+static void
+ud_idle_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&ud_idle_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+ud_idle_fallback_reset(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
+{
+	if (ud_in_panic) {
+		return;
+	}
+	printf("NEGRONI USB: idle reboot: the end mark did not finish in 5 s: PSCI SYSTEM_RESET now\n");
+	negroni_reboot_reset();
+}
+
+static uint64_t
+ud_ms_since(uint64_t t, uint64_t now)
+{
+	return t == 0 || now < t ? 0 : (now - t) * 1000 / ud_abs_ms(1000);
+}
+
+static void
+ud_idle_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t limit = ud_abs_ms((uint64_t)ud_idle_reboot_s * 1000), stall = ud_abs_ms(5000);
+	uint64_t sof_at = 0;
+	uint32_t last_sof = 0, stalls = 0;
+	bool stall_open = false, wait_logged = false;
+
+	for (;;) {
+		ud_idle_sleep_ms(250);
+		if (ud_in_panic) {
+			continue;               /* the panic hold loop owns the controller and has its own timed reset */
+		}
+		uint64_t now = mach_absolute_time();
+		uint32_t dsts = dwc_rd(DSTS), sof = DSTS_SOFFN(dsts);
+		if (sof_at == 0 || sof != last_sof) {
+			last_sof = sof;
+			sof_at = now;
+		}
+		uint64_t beat = ud.beat;
+		uint32_t at = ud.where;
+		if (beat != 0 && now > beat && now - beat >= stall) {
+			if (!stall_open && stalls < 8) {
+				stalls++;
+				printf("NEGRONI USB: ud_thread has not run for %llu ms: in step %s, last event 0x%08x, "
+				    "DSTS 0x%08x link %u (%s), SOF %llu ms ago (0375 watch)\n", ud_ms_since(beat, now),
+				    at < UD_AT_N ? ud_at_names[at] : "?", ud.last_ev, dsts, DSTS_LINK(dsts),
+				    ud_link_name(DSTS_LINK(dsts)), ud_ms_since(sof_at, now));
+			}
+			stall_open = true;
+		} else if (stall_open && now - beat < stall) {
+			stall_open = false;
+			printf("NEGRONI USB: ud_thread runs again (0375 watch)\n");
+		}
+		if (!ud.ever_configured || ud.out_at == 0) {
+			continue;               /* no host data in this boot yet: a boot with no cable never reboots */
+		}
+		/* tx_busy first: ud_tx_kick_locked stores tx_start_at before it (release), so a busy flag never pairs with an older start */
+		bool busy = __atomic_load_n(&ud.tx_busy, __ATOMIC_ACQUIRE);
+		uint64_t out_at = ud.out_at, tx_at = __atomic_load_n(&ud.tx_start_at, __ATOMIC_RELAXED);
+		bool out_idle = now > out_at && now - out_at >= limit;
+		bool tx_stuck = busy && tx_at != 0 && now > tx_at && now - tx_at >= limit;
+		if (!out_idle && !tx_stuck) {
+			wait_logged = false;
+			continue;
+		}
+		int action = __atomic_load_n(&ud.ctl_action, __ATOMIC_ACQUIRE);   /* then ctl_deadline: ud_ctl_schedule stores it first */
+		bool takeover = false;
+		if (action == UD_CTL_WATCHDOG) {
+			continue;
+		}
+		if (action != UD_CTL_NONE) {
+			if (now < ud.ctl_deadline + stall) {
+				if (!wait_logged) {
+					wait_logged = true;
+					printf("NEGRONI USB: idle reboot waits: a USB command is pending (%d)\n", action);
+				}
+				continue;       /* the pending command wins */
+			}
+			takeover = true;        /* still pending 5 s after its time: ud_thread does not run it */
+		}
+		if (!__atomic_compare_exchange_n(&ud.ctl_action, &action, UD_CTL_WATCHDOG, false,
+		    __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+			continue;               /* ud_ctl_poll took the command, or a command came in just now: it wins */
+		}
+		if (ud_idle_fallback != NULL) {
+			thread_call_enter_delayed(ud_idle_fallback, now + stall);
+		}
+		printf("NEGRONI USB: no USB data for %d s: rebooting (negroniusb_idle_reboot); %s; last OUT frame %llu ms "
+		    "ago (%llu OUT frames), IN transfer %s %llu ms, last IN done %llu ms ago, txq %u, tx drops %llu, "
+		    "rx %llu tx %llu frames; SOF %llu ms ago, DSTS 0x%08x link %u (%s), %sconfigured, %llu soft reconnects; "
+		    "ud_thread %llu ms ago in step %s, last event 0x%08x%s\n", ud_idle_reboot_s,
+		    out_idle && tx_stuck ? "no OUT frame and IN stuck" : out_idle ? "no OUT frame" : "IN transfer stuck",
+		    ud_ms_since(out_at, now), ud.out_frames, ud.tx_busy ? "active" : "idle", ud.tx_busy ? ud_ms_since(tx_at, now) : 0,
+		    ud_ms_since(ud.tx_done_at, now), ud.txq_count, ud.tx_drops, ud.rx_frames, ud.tx_frames,
+		    ud_ms_since(sof_at, now), dsts, DSTS_LINK(dsts), ud_link_name(DSTS_LINK(dsts)),
+		    ud.configured ? "" : "not ", ud.reconnects, ud_ms_since(beat, now), at < UD_AT_N ? ud_at_names[at] : "?",
+		    ud.last_ev, takeover ? "; a pending USB command was not run: reset now (its reason stays)" : "");
+		if (!takeover || action != UD_CTL_RESET) {
+			bool set = negroni_reboot_set_reason(0) == 0;
+			printf("NEGRONI USB: idle reboot: reason 0 %s\n", set ? "set" : "NOT set (plain reset)");
+			snprintf(ud_ctl_why, sizeof(ud_ctl_why), "reset (USB data idle %d s)", ud_idle_reboot_s);
+		}
+		ud_idle_sleep_ms(UD_CTL_DELAY_MS);      /* the live log may still carry the line */
+		if (ud_in_panic) {
+			continue;
+		}
+		negroni_bootlog_end(4, ud_ctl_why);     /* 0367 */
+		printf("NEGRONI USB: idle reboot: PSCI SYSTEM_RESET\n");
+		negroni_reboot_reset();         /* returns only if PSCI refused (logged there) */
+		__atomic_store_n(&ud.ctl_action, UD_CTL_NONE, __ATOMIC_SEQ_CST);  /* USB commands (poweroff, panic) work again */
+		return;
+	}
+}
