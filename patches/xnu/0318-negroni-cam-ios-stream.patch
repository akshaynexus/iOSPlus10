+/* ---- level 7: the frames for iOS, /dev/negronicam (0318) ---- */
+
+/*
+ * negronicam=7: nothing runs at boot; /dev/negronicam is published. The first read() after an open starts a
+ * session in its own thread: the level 1-5 bring-up (votes, camcc, CCI, IMX789 power + chip id, CPAS, the
+ * SMMU stage-1 context of 0317, capture clocks, CSIPHY1, CSID0/IFE0 map), a ring of NRING frame places (kernel
+ * memory, page by page at IOVAs from 0x10c00000), the 0315 pipe with frame increment 0, sensor stream on
+ * (negronicam_src=1: the TPG13 colour bars instead, no sensor power). The session ends after the last close, after
+ * IDLE_MS without a read, or on a fault (then /dev/negronicam answers EIO for the rest of the boot); the end
+ * is the stream off + cam_down() + the ring freed.
+ *
+ * The ABI is HakiOS's /dev/hakios-camera (out/src/hackios-next/userland/src/hakios.camera.h, MIT; the same
+ * struct layout under our own names, magic "NCFRAME1"), so their camera_device.c needs few edits:
+ *   read()   waits (at most 1 s, 4 s for the session's first frame) for the newest frame not read yet: the
+ *            header, then as many frame bytes as fit. A buffer of the header's size gets the header only.
+ *            EAGAIN on a time-out, EIO after a fault.
+ *   write()  struct negronicam_command: EXPOSURE (a lines, b gain x256 linear, c frame lines or 0) and SENSOR
+ *            (only sensor 1, the rear main, exists here). KEEP and FOCUS are accepted and ignored.
+ *
+ * Which place the IFE writes (as HakiOS's SOF scheme, our registers): at each RDI0 SOF (CSID path irq bit 4
+ * CAMIF_SOF or bit 12 INFO_INPUT_SOF, cam_ife_csid680.h:123-176) the address of the place for the frame after
+ * goes to WM_IMAGE_ADDR and RUP+AUP (CSID 0x18, camss-csid-gen3.c:33-34; the latch is at the next SOF). BUF_DONE
+ * (CSID 0x8c bit 14) marks the written place ready. Without any SOF bit in the first 3 frames the loop programs
+ * the next address at BUF_DONE instead (Linux camss vfe_buf_done order) [I: which one the 680 latches by].
+ * Exposure [I]: SMIA registers of the FTM table (0x0202/3 coarse integration, 0x0204/5 analog gain, 0x0340/1
+ * frame length) in a group hold (0x0104); Sony code = 1024 - 1024 / gain [I for IMX789], at most 16x.
+ */
+#define NRING           3u
+#define RING_SPARE      (256u << 10)            /* room after each frame: some come longer than the mode */
+#define IDLE_MS         1000u
+#define FIRST_FRAME_MS  4000u
+#define FRAME_TIMEOUT_MS 1500u
+#define RDI_SOF_BITS    ((1u << 4) | (1u << 12))
+#define NCAM_MAGIC      "NCFRAME1"
+#define NCAM_NO_FOCUS   0xffffffffu
+#define NCAM_GID_MOBILE 501             /* iOS group "mobile" (mediaserverd's) */
+#define CMD_EXPOSURE    1u
+#define CMD_KEEP        2u
+#define CMD_SENSOR      3u
+#define CMD_FOCUS       4u
+#define GAIN_UNITY      256u
+#define GAIN_MAX        (16u * GAIN_UNITY)
+#define EXPOSURE_MARGIN 48u                     /* coarse integration <= frame length - margin [I] */
+#define FTM_FRAME_LINES 3134u                   /* 0x0340/1 = 0x0c3e of the FTM table */
+#define FTM_LINE_NS     10636u                  /* 1e9 / (30 fps x 3134 lines) [I: from the 30 fps of the mode] */
+#define IMX789_BLACK    64u                     /* 10-bit pedestal [I: usual Sony value] */
+
+struct ncam_frame_hdr {                 /* = struct hakios_camera_frame */
+	char magic[8];
+	uint32_t header_bytes, width, height, stride, format, bayer, black;
+	uint64_t sequence, time;
+	uint32_t exposure_lines, line_ns, gain, gain_unity, gain_max, frame_lines, frame_lines_min, frame_lines_max, margin;
+	uint32_t sensor, focus, reserved[5];
+};
+_Static_assert(sizeof(struct ncam_frame_hdr) == 120, "the HakiOS frame header is 120 bytes");
+struct ncam_command { uint32_t command, bytes, a, b, c, d; };
+
+enum { PLACE_FREE, PLACE_WRITING, PLACE_READY, PLACE_READING };
+static struct {
+	vm_offset_t kva;
+	uint64_t dva;
+	uint8_t state;
+	uint64_t sequence, time;
+	uint32_t lines, gain, frame_lines;
+} place[NRING];
+static vm_size_t place_bytes;
+static uint32_t ios_w, ios_h, ios_stride, ios_bytes, ios_bayer;
+static lck_grp_t *ios_grp;
+static lck_mtx_t *ios_lock;
+static volatile bool ios_running, ios_broken;
+static volatile uint64_t ios_last_read_ms, ios_frames, ios_given;
+static struct { uint32_t lines, gain, frame_lines; bool pending; } ios_ask;
+static struct { uint32_t lines, gain, frame_lines; } ios_now;
+extern void IOSleep(unsigned int ms);
+
+static uint64_t
+ms_now(void)
+{
+	return now_us() / 1000u;
+}
+
+/* gain x256 linear -> Sony analog gain code (1024 - 1024 / gain) [I] */
+static uint32_t
+gain_code(uint32_t gain)
+{
+	gain = MAX(MIN(gain, GAIN_MAX), GAIN_UNITY);
+	return 1024u - (1024u * GAIN_UNITY + gain / 2u) / gain;
+}
+
+static bool
+exposure_write(uint32_t lines, uint32_t gain, uint32_t frame_lines)
+{
+	uint32_t code = gain_code(gain);
+	int e = cci_write8(CCI_MASTER, SENSOR_SID, 0x0104, 1);          /* group hold */
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0340, frame_lines >> 8);
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0341, frame_lines & 0xffu);
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0202, lines >> 8);
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0203, lines & 0xffu);
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0204, code >> 8);
+	e = e ? e : cci_write8(CCI_MASTER, SENSOR_SID, 0x0205, code & 0xffu);
+	int e2 = cci_write8(CCI_MASTER, SENSOR_SID, 0x0104, 0);         /* release, also after a failed write */
+	if (e || e2) {
+		say("  exposure write failed: errno %d/%d", e, e2);
+		return false;
+	}
+	return true;
+}
+
+static void
+exposure_limits(uint32_t *lines, uint32_t *gain, uint32_t *frame_lines)
+{
+	uint32_t fl = *frame_lines ? *frame_lines : MAX(FTM_FRAME_LINES, *lines + EXPOSURE_MARGIN);
+	*frame_lines = MIN(MAX(fl, FTM_FRAME_LINES), 0xfff0u);
+	*lines = MIN(MAX(*lines, 8u), *frame_lines - EXPOSURE_MARGIN);
+	*gain = MIN(MAX(*gain, GAIN_UNITY), GAIN_MAX);
+}
+
+static void
+ring_free(void)
+{
+	for (unsigned i = 0; i < NRING; i++) {
+		if (place[i].kva) {
+			kmem_free(kernel_map, place[i].kva, place_bytes);
+		}
+		bzero(&place[i], sizeof(place[i]));
+	}
+}
+
+/* the ring: NRING places of kernel memory, each mapped at its own IOVA (needs the 0317 context) */
+static bool
+ring_alloc(void)
+{
+	step_begin("ios frame ring");
+	if (!dma_s1) {
+		return step_fail("the stream needs the SMMU stage-1 context (negronicam_smmu=3)");
+	}
+	place_bytes = round_page((vm_size_t)ios_bytes + RING_SPARE);
+	for (unsigned i = 0; i < NRING; i++) {
+		if (kmem_alloc(kernel_map, &place[i].kva, place_bytes, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			place[i].kva = 0;
+			return step_fail("no memory for the frame ring");
+		}
+		uint64_t iova = cam_iova_next;
+		if (iova + place_bytes > CAM_IOVA_IO_END || negroni_s1_map_kva(&cam_s1, iova, place[i].kva, place_bytes) != 0) {
+			return step_fail("ring map through the SMMU");
+		}
+		cam_iova_next = (iova + place_bytes + 0x100000ull + 0xfffffull) & ~0xfffffull;     /* >= 1 MiB unmapped gap */
+		place[i].dva = iova;
+		flush_dcache((vm_offset_t)place[i].kva, (unsigned)place_bytes, FALSE);  /* no dirty line over the DMA */
+	}
+	say("  %u places of %lu bytes (frame %ux%u RAW10, stride %u) at IOVA %#llx..", NRING, (unsigned long)place_bytes,
+	    ios_w, ios_h, ios_stride, place[0].dva);
+	return step_ok();
+}
+
+static bool
+ios_bringup(void)
+{
+	step = 0;
+	bool sensor = (src_mask & 2u) != 0;
+	bool ok = (votes_policy == 0 || l0_votes()) && l1_map() && l1_gcc() && l1_gdsc() && l1_clocks() && l1_cci();
+	if (ok && sensor) {
+		ok = l2_pins() && l2_rails() && l2_reset() && l2_mclk() && l2_cci_pins() && l2_chip_id();
+	}
+	ok = ok && l3_cpas() && l3_smmu() && l4_clocks() && (!sensor || l4_csiphy()) && l5_map();
+	if (!ok) {
+		return false;
+	}
+	ios_w = sensor ? FTM_WIDTH : TPG_W;
+	ios_h = sensor ? FTM_HEIGHT : TPG_H;
+	ios_stride = ios_w * 10u / 8u;
+	ios_bytes = ios_stride * ios_h;
+	if (!ring_alloc()) {
+		return false;
+	}
+	step_begin(sensor ? "ios stream: imx789 -> csid0 -> ife0 rdi0 -> ring" : "ios stream: tpg13 -> csid0 -> ife0 rdi0 -> ring");
+	if (!pipe_start(place[0].dva, ios_stride, 0, !sensor)) {
+		return step_fail("pipe start");
+	}
+	ios_now.lines = FTM_FRAME_LINES - EXPOSURE_MARGIN;
+	ios_now.gain = GAIN_UNITY;
+	ios_now.frame_lines = FTM_FRAME_LINES;
+	if (sensor) {
+		uint32_t hi = 0, lo = 0;
+		if (cci_read8(CCI_MASTER, SENSOR_SID, 0x0202, &hi) == 0 && cci_read8(CCI_MASTER, SENSOR_SID, 0x0203, &lo) == 0) {
+			ios_now.lines = hi << 8 | lo;
+		}
+	}
+	return step_ok();
+}
+
+/* the session: bring-up, the frame loop, the end; one at a time (ios_running) */
+static void
+ios_thread(void *arg __unused, wait_result_t wr_ __unused)
+{
+	bool sensor = (src_mask & 2u) != 0, sof_mode = true, fault = false;
+	int writing = 0, next = 0;      /* place 0 is the WM's address from pipe_start: taken at the first SOF */
+	uint64_t last_frame, started = ms_now(), late = 0, sofs = 0;
+	const char *why = "closed";
+
+	say("ios session: start (%s)", sensor ? "IMX789" : "TPG13 colour bars");
+	if (!ios_bringup()) {
+		fault = true;
+		why = "the bring-up failed";
+		goto out;
+	}
+	lck_mtx_lock(ios_lock);
+	ios_frames = 0;
+	ios_given = 0;
+	ios_last_read_ms = ms_now();
+	lck_mtx_unlock(ios_lock);
+	last_frame = ms_now();
+	while (ios_open) {
+		IOSleep(1);
+		uint64_t now = ms_now();
+		uint32_t rdi = rd(csid + CSID_RDI0_IRQ_STATUS), bd = rd(csid + CSID_BUF_DONE_STATUS);
+		bool sof = (rdi & RDI_SOF_BITS) != 0, done = (bd & CSID_BUF_DONE_RDI0) != 0;
+		if (!sof && !done) {
+			if (now - last_frame > (ios_frames ? FRAME_TIMEOUT_MS : FIRST_FRAME_MS)) {
+				say("  ios session: no frame for %llu ms; RDI0 irq %#x, RX irq %#x, IFE bus violation %#x overflow %#x",
+				    now - last_frame, rdi, rd(csid + CSID_RX_IRQ_STATUS), rd(ife + VFE_BUS_VIOLATION),
+				    rd(ife + VFE_BUS_OVERFLOW));
+				fault = true;
+				why = "no frame";
+				break;
+			}
+			if (now - ios_last_read_ms > IDLE_MS) {
+				why = "nobody reads";
+				break;
+			}
+			continue;
+		}
+		if (rdi) {
+			wr(csid + CSID_RDI0_IRQ_CLEAR, rdi);
+		}
+		if (bd) {
+			wr(csid + CSID_BUF_DONE_CLEAR, bd);
+		}
+		wr(csid + CSID_IRQ_CMD, 1);
+		sofs += sof;
+		lck_mtx_lock(ios_lock);
+		if (done) {
+			last_frame = now;
+			ios_frames++;
+			place[writing].state = PLACE_READY;
+			place[writing].sequence = ios_frames;
+			place[writing].time = mach_absolute_time();
+			place[writing].lines = ios_now.lines;
+			place[writing].gain = ios_now.gain;
+			place[writing].frame_lines = ios_now.frame_lines;
+			if (ios_frames == 3 && sofs == 0) {
+				sof_mode = false;
+				say("  ios session: no SOF bit in 3 frames (RDI0 irq %#x): next address at BUF_DONE", rdi);
+			}
+		}
+		/* SOF mode: at SOF; BUF_DONE mode: at BUF_DONE. The address for the frame after the one starting now. */
+		if (sof_mode ? sof : done) {
+			if (next >= 0) {
+				writing = next;
+				next = -1;
+			} else {
+				late++;         /* no address waiting: this frame goes where the last one went */
+			}
+			place[writing].state = PLACE_WRITING;
+			for (unsigned i = 1; i < NRING; i++) {
+				int c = (int)((writing + i) % NRING);
+				if (place[c].state != PLACE_READING && (next < 0 || place[c].sequence < place[next].sequence)) {
+					next = c;
+				}
+			}
+			if (next >= 0) {
+				wr(ife + WM_RDI0 + WM_IMAGE_ADDR, (uint32_t)place[next].dva);
+				wr(csid + CSID_RUP_AUP, 1u << 4 | 1u << 20);
+			}
+		}
+		bool ask = done && ios_ask.pending;
+		uint32_t lines = ios_ask.lines, gain = ios_ask.gain, frame_lines = ios_ask.frame_lines;
+		ios_ask.pending = ios_ask.pending && !ask;
+		lck_mtx_unlock(ios_lock);
+		if (ask && sensor) {
+			exposure_limits(&lines, &gain, &frame_lines);
+			if ((lines != ios_now.lines || gain != ios_now.gain || frame_lines != ios_now.frame_lines) &&
+			    exposure_write(lines, gain, frame_lines)) {
+				ios_now.lines = lines;          /* [I] takes effect 2 frames later; the header says it now */
+				ios_now.gain = gain;
+				ios_now.frame_lines = frame_lines;
+			}
+		}
+		if (done && ios_frames % 30 == 0) {
+			if (negroni_s1_fsr(&cam_s1)) {
+				negroni_s1_report(&cam_s1, "while streaming");
+				fault = true;
+				why = "the SMMU refused the IFE";
+				break;
+			}
+			if (ios_frames == 30 || ios_frames % 900 == 0) {
+				say("  ios session: %llu frames in %llu ms, %llu late address updates, %llu read", ios_frames,
+				    now - started, late, ios_given);
+			}
+		}
+	}
+out:
+	say("ios session: end (%s) after %llu frames", why, ios_frames);
+	if (csid_on) {
+		wr(csid + CSID_RDI0_CTRL, 0);   /* halt at the frame boundary, then the rest in cam_down */
+	}
+	if (gcc && camcc && cci) {
+		cam_down();
+	}
+	lck_mtx_lock(ios_lock);
+	for (unsigned i = 0; i < NRING; i++) {
+		while (place[i].state == PLACE_READING) {       /* a read still copies: wait for it */
+			lck_mtx_unlock(ios_lock);
+			IOSleep(5);
+			lck_mtx_lock(ios_lock);
+		}
+		place[i].state = PLACE_FREE;
+	}
+	ios_broken = ios_broken || fault;
+	lck_mtx_unlock(ios_lock);
+	ring_free();
+	ios_running = false;
+	if (fault) {
+		say("ios session: FAULT: /dev/negronicam answers EIO until reboot");
+	}
+	(void)thread_terminate(current_thread());
+}
+
+static int
+ios_read(struct uio *uio)
+{
+	uint64_t t0 = ms_now(), limit = 1000;
+	int error = 0;
+
+	if (ios_broken) {
+		return EIO;
+	}
+	lck_mtx_lock(ios_lock);
+	ios_last_read_ms = ms_now();
+	if (!ios_running) {
+		thread_t th;
+		ios_running = true;
+		limit = FIRST_FRAME_MS + 2000u;         /* bring-up + the first frame */
+		if (kernel_thread_start(ios_thread, NULL, &th) != KERN_SUCCESS) {
+			ios_running = false;
+			lck_mtx_unlock(ios_lock);
+			return ENOMEM;
+		}
+		thread_deallocate(th);
+	}
+	int best = -1;
+	for (;;) {
+		for (unsigned i = 0; i < NRING; i++) {
+			if (place[i].state == PLACE_READY && place[i].sequence > ios_given &&
+			    (best < 0 || place[i].sequence > place[best].sequence)) {
+				best = (int)i;
+			}
+		}
+		if (best >= 0 || ios_broken || ms_now() - t0 > limit) {
+			break;
+		}
+		lck_mtx_unlock(ios_lock);
+		IOSleep(2);
+		lck_mtx_lock(ios_lock);
+		ios_last_read_ms = ms_now();
+	}
+	if (best < 0) {
+		lck_mtx_unlock(ios_lock);
+		return ios_broken ? EIO : EAGAIN;
+	}
+	struct ncam_frame_hdr h;
+	bzero(&h, sizeof(h));
+	memcpy(h.magic, NCAM_MAGIC, 8);
+	h.header_bytes = sizeof(h);
+	h.width = ios_w;
+	h.height = ios_h;
+	h.stride = ios_stride;
+	h.format = 1;
+	h.bayer = ios_bayer;
+	h.black = (src_mask & 2u) ? IMX789_BLACK : 0;
+	h.sequence = place[best].sequence;
+	h.time = place[best].time;
+	h.exposure_lines = place[best].lines;
+	h.line_ns = FTM_LINE_NS;
+	h.gain = place[best].gain;
+	h.gain_unity = GAIN_UNITY;
+	h.gain_max = GAIN_MAX;
+	h.frame_lines = place[best].frame_lines;
+	h.frame_lines_min = FTM_FRAME_LINES;
+	h.frame_lines_max = 0xfff0u;
+	h.margin = EXPOSURE_MARGIN;
+	h.sensor = 1;                   /* the wide (rear main) camera in HakiOS's numbering */
+	h.focus = NCAM_NO_FOCUS;
+	ios_given = place[best].sequence;
+	bool body = uio_resid(uio) > (user_ssize_t)sizeof(h);
+	if (body) {
+		place[best].state = PLACE_READING;
+	}
+	lck_mtx_unlock(ios_lock);
+	error = uiomove((caddr_t)&h, (int)MIN((user_ssize_t)sizeof(h), uio_resid(uio)), uio);
+	if (body) {
+		/* the CPU view of the DMA'd bytes: invalidate (the SMMU writes with Normal non-cacheable attributes) */
+		flush_dcache((vm_offset_t)place[best].kva, (unsigned)round_page(ios_bytes), FALSE);
+		for (uint32_t at = 0; error == 0 && at < ios_bytes && uio_resid(uio) > 0;) {
+			int n = (int)MIN(MIN((user_ssize_t)(ios_bytes - at), uio_resid(uio)), (user_ssize_t)(1 << 20));
+			error = uiomove((caddr_t)(place[best].kva + at), n, uio);
+			at += (uint32_t)n;
+		}
+		lck_mtx_lock(ios_lock);
+		place[best].state = PLACE_READY;
+		lck_mtx_unlock(ios_lock);
+	}
+	return error;
+}
+
+static int
+ios_write(struct uio *uio)
+{
+	struct ncam_command c;
+	int error;
+
+	if (uio_resid(uio) < (user_ssize_t)sizeof(c)) {
+		return EINVAL;
+	}
+	if ((error = uiomove((caddr_t)&c, sizeof(c), uio)) != 0) {
+		return error;
+	}
+	switch (c.command) {
+	case CMD_EXPOSURE:
+		lck_mtx_lock(ios_lock);
+		ios_ask.lines = c.a;
+		ios_ask.gain = c.b;
+		ios_ask.frame_lines = c.c;
+		ios_ask.pending = true;
+		lck_mtx_unlock(ios_lock);
+		return 0;
+	case CMD_SENSOR:
+		return c.a == 1 ? 0 : ENODEV;   /* only the rear main camera (IMX789) has a driver */
+	case CMD_KEEP:
+	case CMD_FOCUS:
+		if (c.bytes && uio_resid(uio) > 0) {
+			uio_update(uio, MIN((user_size_t)c.bytes, (user_size_t)uio_resid(uio)));     /* skip the payload */
+		}
+		return 0;
+	default:
+		return EINVAL;
+	}
+}
+
+static void
+ios_publish(void)
+{
+	ios_grp = lck_grp_alloc_init("negronicam", LCK_GRP_ATTR_NULL);
+	ios_lock = lck_mtx_alloc_init(ios_grp, LCK_ATTR_NULL);
+	(void)PE_parse_boot_argn("negronicam_bayer", &ios_bayer, sizeof(ios_bayer));
+	ios_bayer &= 3u;
+	camdev_publish();
+	if (camdev_major >= 0) {
+		/* root:mobile 0660: the reader is mediaserverd, which runs as mobile (uid/gid 501) */
+		(void)devfs_make_node(makedev(camdev_major, 2), DEVFS_CHAR, UID_ROOT, NCAM_GID_MOBILE, 0660, "negronicam");
+		say("level 7: /dev/negronicam for iOS (%s; open + read starts the camera, the last close stops it; bayer %u)",
+		    (src_mask & 2u) ? "IMX789 rear main" : "TPG13 colour bars", ios_bayer);
+	}
+}
