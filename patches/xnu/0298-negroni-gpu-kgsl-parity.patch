+/*
+ * Patch 0298: the bus votes as KGSL builds them (adreno_gen7_rpmh.c:121-260 build_rpmh_bw_votes / tcs_cmd_data,
+ * 415-497 build_bw_table): per DT bus level (out/live.dts:21079 qcom,bus-table-ddr, KBps) one TCS word per BCM
+ * (SH0 bus width 16, MC0 4, ACV fixed), unit/width/vcd from the BCM's cmd-db aux data (struct bcm_data
+ * {le32 unit, le16 width, u8 vcd}); the CNOC BCM CN0 (bus width 4) for qcom,bus-table-cnoc <0 100> (21078).
+ * BCM_TCS_CMD (include/soc/qcom/tcs.h): commit bit 30, valid bit 29, vote_x bits 27:14, vote_y bits 13:0.
+ * A BCM that cmd-db does not describe keeps the Linux constants (a730_build_bw_table).
+ */
+#define BCM_CMD(commit, valid, x, y) ((uint32_t)(commit) << 30 | (uint32_t)(valid) << 29 | \
+	((uint32_t)(x) & 0x3fff) << 14 | ((uint32_t)(y) & 0x3fff))
+struct bcm_info {
+	const char *name;
+	uint32_t buswidth;
+	bool fixed;
+	uint32_t addr, unit, width, vcd;
+};
+static const uint32_t ddr_kbps[12] = {          /* out/live.dts:21079 */
+	0, 0xbebc2, 0x1ae1b6, 0x209a8e, 0x28973c, 0x2dc6c0, 0x5caf6a, 0x65ce03, 0x7cb163, 0xa3140c, 0xbe7f17, 0xc7acf1,
+};
+static const uint32_t cnoc_kbps[2] = { 0, 100 };        /* out/live.dts:21078 */
+
+static bool
+bcm_read(struct bcm_info *b)
+{
+	uint8_t aux[8] = { 0 };
+	uint32_t n = sizeof(aux);
+
+	if (!cmd_db_find(b->name, &b->addr, aux, &n) || n < 7) {
+		return false;
+	}
+	b->unit = (uint32_t)aux[0] | (uint32_t)aux[1] << 8 | (uint32_t)aux[2] << 16 | (uint32_t)aux[3] << 24;
+	b->width = (uint32_t)aux[4] | (uint32_t)aux[5] << 8;
+	b->vcd = aux[6];
+	return b->fixed || (b->unit != 0 && b->width != 0 && b->buswidth != 0);
+}
+
+/* tcs_cmd_data with ab = 0 (KGSL votes peak only) */
+static void
+bcm_votes(const struct bcm_info *b, uint32_t count, uint32_t ib, uint32_t *data)
+{
+	for (uint32_t i = 0; i < count; i++) {
+		bool commit = i == count - 1 || b[i].vcd != b[i + 1].vcd;
+		if (b[i].fixed) {
+			data[i] = ib ? BCM_CMD(commit, 1, 0, 8) : BCM_CMD(commit, 0, 0, 0);
+			continue;
+		}
+		uint64_t y = (uint64_t)ib * b[i].width / b[i].buswidth * 1000ull / b[i].unit;
+		if (ib && y == 0) {
+			y = 1;
+		}
+		y = MIN(y, 0x3fffull);
+		data[i] = BCM_CMD(commit, y != 0, 0, y);
+	}
+}
+
+static uint32_t
+bcm_wait_mask(const struct bcm_info *b, uint32_t count)
+{
+	uint32_t mask = 0;
+
+	for (uint32_t i = 0; i < count; i++) {
+		if (i == count - 1 || b[i].vcd != b[i + 1].vcd) {
+			mask |= 1u << i;
+		}
+	}
+	return mask;
+}
