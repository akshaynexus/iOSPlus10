+{
+	k_args();
+	if (k_busy_pct) {
+		wr(gmu + GMU_REG(K_AO_GPU_CX_BUSY_MASK), 0xff000000);
+		wr(gmu + GMU_REG(K_POWER_COUNTER_SELECT_0), (rd(gmu + GMU_REG(K_POWER_COUNTER_SELECT_0)) & ~0xffu) | 0x20);
