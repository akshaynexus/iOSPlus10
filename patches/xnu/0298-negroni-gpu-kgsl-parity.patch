+/* bw = the HFI BW_TABLE message (hfi_bwtable_cmd) with the Linux constants in; replaced from cmd-db where known */
+static void
+bw_from_cmd_db(uint32_t *bw)
+{
+	struct bcm_info ddr[3] = { { "SH0", 16, false, 0, 0, 0, 0 }, { "MC0", 4, false, 0, 0, 0, 0 }, { "ACV", 0, true, 0, 0, 0, 0 } };
+	struct bcm_info cn = { "CN0", 4, false, 0, 0, 0, 0 };
+	uint32_t *ddr_data = &bw[6 + 6 + 12 + 8], row[3], differ = 0, bw_kept = 0;
+
+	k_args();
+	bool ok = bcm_read(&ddr[0]) && bcm_read(&ddr[1]) && bcm_read(&ddr[2]);
+	printf("NEGRONI ADRENO: 17 BCM cmd-db: SH0 unit %u width %u vcd %u, MC0 unit %u width %u vcd %u, ACV vcd %u (%s)\n",
+	    ddr[0].unit, ddr[0].width, ddr[0].vcd, ddr[1].unit, ddr[1].width, ddr[1].vcd, ddr[2].vcd, ok ? "complete" : "INCOMPLETE");
+	for (uint32_t l = 0; ok && l < 12; l++) {
+		bcm_votes(ddr, 3, ddr_kbps[l], row);
+		for (uint32_t j = 0; j < 3; j++) {
+			differ += row[j] != ddr_data[8 * l + j];
+		}
+		if (l == 11 || l == 6 || l == 1) {
+			printf("NEGRONI ADRENO: 17 bw level %u (%u KBps): SH0 %#x MC0 %#x ACV %#x (Linux constants %#x %#x %#x)\n", l,
+			    ddr_kbps[l], row[0], row[1], row[2], ddr_data[8 * l], ddr_data[8 * l + 1], ddr_data[8 * l + 2]);
+		}
+		if (k_bwcalc) {
+			for (uint32_t j = 0; j < 3; j++) {
+				/* a wrong cmd-db read must not lower a DDR vote: keep the Linux word when its vote_y is larger */
+				if ((row[j] & 0x3fff) < (ddr_data[8 * l + j] & 0x3fff)) {
+					if (bw_kept++ < 8) {
+						printf("NEGRONI ADRENO: 17 bw level %u BCM %u: computed %#x below the Linux constant %#x: constant kept\n",
+						    l, j, row[j], ddr_data[8 * l + j]);
+					}
+					continue;
+				}
+				ddr_data[8 * l + j] = row[j];
+			}
+		}
+	}
+	if (ok && k_bwcalc) {
+		bw[5] = bcm_wait_mask(ddr, 3);
+	}
+	printf("NEGRONI ADRENO: 17 bw table: %s; %u of 36 words differ from the Linux constants (%u kept: never below them); ddr wait mask %#x\n",
+	    ok && k_bwcalc ? "computed from cmd-db" : !ok ? "Linux constants (cmd-db incomplete)" : "Linux constants (negronigpu_bwcalc=0)",
+	    differ, bw_kept, bw[5]);
+	if (k_cnoc && bcm_read(&cn)) {
+		bw[2] = 1;                      /* cnoc_cmds_num */
+		bw[4] = bcm_wait_mask(&cn, 1);  /* cnoc_wait_bitmask */
+		bw[6] = cn.addr;                /* cnoc_cmd_addrs[0] */
+		for (uint32_t l = 0; l < 2; l++) {
+			bcm_votes(&cn, 1, cnoc_kbps[l], &bw[12 + 6 * l]);      /* cnoc_cmd_data[l][0] */
+		}
+		printf("NEGRONI ADRENO: 17 CNOC CN0 %#x unit %u width %u: votes %#x %#x\n", cn.addr, cn.unit, cn.width, bw[12], bw[18]);
+	} else {
+		printf("NEGRONI ADRENO: 17 CNOC vote %s\n", k_cnoc ? "NOT SENT: CN0 not in cmd-db" : "off (negronigpu_cnoc=0)");
+	}
+}
