+/* Send a DT-format command set, each packet one DCS write in HS mode, the wait byte honoured. */
+static int
+negroni_fp_send_set(const uint8_t *set, uint32_t len, uint32_t *sent)
+{
+	uint32_t i = 0, n = 0;
+	int rc = 0;
+	while (i + 7 <= len && rc == 0) {
+		uint8_t type = set[i], wait = set[i + 4];
+		uint32_t plen = (uint32_t)set[i + 5] << 8 | set[i + 6];
+		if (plen == 0 || i + 7 + plen > len || (type != 0x05 && type != 0x15 && type != 0x39)) {
+			rc = -4;
+			break;
+		}
+		rc = negroni_dsi_dcs_write(set + i + 7, plen, false);
+		if (rc == 0) {
+			n++;
+			if (wait != 0) {
+				IOSleep(wait);
+			}
+		}
+		i += 7 + plen;
+	}
+	*sent = n;
+	return rc;
+}
+
+/* Thread context (0250: the DSI write sleeps on its lock). */
+extern "C" int
+negroni_fp_hbm(bool on)
+{
+	uint32_t sent = 0;
+	int rc = on ? negroni_fp_send_set(negroni_fp_hbm_on, sizeof(negroni_fp_hbm_on), &sent)
+	    : negroni_fp_send_set(negroni_fp_hbm_off, sizeof(negroni_fp_hbm_off), &sent);
+	if (rc == 0) {
+		negroni_fp_hbm_state = on;
+	}
+	IOLog("NEGRONI FP HL: panel HBM %s: %s (%u packets)\n", on ? "on" : "off", rc == 0 ? "ok" : "failed", sent);
+	return rc;
+}
+
+static void
+negroni_fp_hbm_callout(thread_call_param_t p0, thread_call_param_t p1)
+{
+	(void)p0;
+	(void)p1;
+	(void)negroni_fp_hbm(true);
+}
+
+static int
+negroni_fp_hl_mode(void)
+{
+	if (negroni_fp_hl < 0) {
+		negroni_fp_hl = 0;
+		PE_parse_boot_argn("negronifp_hl", &negroni_fp_hl, sizeof(negroni_fp_hl));
+		PE_parse_boot_argn("negronifp_hl_x", &negroni_fp_hl_x, sizeof(negroni_fp_hl_x));
+		PE_parse_boot_argn("negronifp_hl_y", &negroni_fp_hl_y, sizeof(negroni_fp_hl_y));
+		PE_parse_boot_argn("negronifp_hl_r", &negroni_fp_hl_r, sizeof(negroni_fp_hl_r));
+		if (negroni_fp_hl < 0 || negroni_fp_hl > 2 || negroni_fp_hl_r < 4 || negroni_fp_hl_r > 400) {
+			negroni_fp_hl = 0;
+		}
+		if (negroni_fp_hl) {
+			IOLog("NEGRONI FP HL: highlight on (mode %d): disc at %d,%d radius %d panel px%s\n", negroni_fp_hl,
+			    negroni_fp_hl_x, negroni_fp_hl_y, negroni_fp_hl_r, negroni_fp_hl == 1 ? ", panel HBM once" : "");
+		}
+	}
+	return negroni_fp_hl;
+}
+
+/* A filled white disc at the sensor position, drawn into the panel memory after a copy. */
+static void
+negroni_fp_draw_highlight(uintptr_t pixels, uint32_t rowBytes, uint32_t width, uint32_t height)
+{
+	int mode = negroni_fp_hl_mode();
+	if (mode == 0 || pixels == 0) {
+		return;
+	}
+	const int cx = negroni_fp_hl_x, cy = negroni_fp_hl_y, r = negroni_fp_hl_r;
+	for (int y = cy - r; y <= cy + r; y++) {
+		if (y < 0 || y >= (int)height) {
+			continue;
+		}
+		int dy = y - cy, dx = 0;
+		while (dx * dx + dy * dy <= r * r) {
+			dx++;
+		}
+		dx--;
+		int x0 = cx - dx, x1 = cx + dx;
+		if (x0 < 0) {
+			x0 = 0;
+		}
+		if (x1 >= (int)width) {
+			x1 = (int)width - 1;
+		}
+		uint32_t *row = (uint32_t *)(pixels + (uint64_t)y * rowBytes);
+		for (int x = x0; x <= x1; x++) {
+			row[x] = 0xffffffffu;
+		}
+	}
+	negroni_fp_hl_frames++;
+	if (mode == 1 && !negroni_fp_hbm_sent) {
+		negroni_fp_hbm_sent = true;
+		if (negroni_fp_hbm_call == NULL) {
+			negroni_fp_hbm_call = thread_call_allocate(&negroni_fp_hbm_callout, NULL);
+		}
+		if (negroni_fp_hbm_call != NULL) {
+			uint64_t deadline;
+			clock_interval_to_deadline(50, kMillisecondScale, &deadline);
+			thread_call_enter_delayed(negroni_fp_hbm_call, deadline);
+		}
+	}
+}
