-	memset(gPoolUsed + (pa - gPoolBase) / PAGE_SIZE, 0, (size_t)(size / PAGE_SIZE));
+	uint32_t first = (uint32_t)((pa - gPoolBase) / PAGE_SIZE), n = (uint32_t)(size / PAGE_SIZE);
