 {
 	uint32_t want = (uint32_t)(size / PAGE_SIZE), run = 0;
 
-	for (uint32_t i = 0; i < gPoolPages; i++) {
+	if (want == 0 || want > gPoolPages - gPoolInUse) {
+		return 0;
+	}
+	/* 0402: first fit from the lowest page that may be free (the same pick, without the scan of the full start) */
+	for (uint32_t i = gPoolLow; i < gPoolPages; i++) {
 		run = gPoolUsed[i] ? 0 : run + 1;
 		if (run == want) {
 			uint32_t first = i + 1 - want;
 			memset(gPoolUsed + first, 1, want);
+			gPoolInUse += want;
+			if (first == gPoolLow) {
