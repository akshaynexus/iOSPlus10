+	if (base >= GPU_POOL_RAM_END) {
+		IOLog("RedwoodGPU: pool off: base 0x%llx is past the end of RAM 0x%llx\n", base, GPU_POOL_RAM_END);
+		return;
+	}
+	if (base + size > GPU_POOL_RAM_END) {
+		IOLog("RedwoodGPU: pool 0x%llx + %u MiB cut to %llu MiB at the end of RAM 0x%llx\n", base, mib,
+		    (GPU_POOL_RAM_END - base) >> 20, GPU_POOL_RAM_END);
+		size = GPU_POOL_RAM_END - base;
