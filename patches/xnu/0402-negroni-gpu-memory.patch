+/* 0402: the client in gClients (for the memory line), while there is room. */
+static void
+listClient(RedwoodGPUUserClient * c, int * slot)
+{
+	if (gClientsLock == NULL) {
+		return;
+	}
+	IOLockLock(gClientsLock);
+	for (uint32_t i = 0; i < GPU_CLIENTS_LISTED && *slot < 0; i++) {
+		if (gClients[i] == NULL) {
+			gClients[i] = c;
+			*slot = (int)i;
+		}
+	}
+	IOLockUnlock(gClientsLock);
+}
+
+static void
+unlistClient(RedwoodGPUUserClient * c, int * slot)
+{
+	if (gClientsLock == NULL || *slot < 0) {
+		return;
+	}
+	IOLockLock(gClientsLock);
+	if (gClients[*slot] == c) {
+		gClients[*slot] = NULL;
+	}
+	*slot = -1;
+	IOLockUnlock(gClientsLock);
+}
+
+void
+NegroniGPUMemoryLine(char *buf, size_t len)
+{
+	struct {
+		uint64_t ram, pool, host;
+		char name[24];
+	} top[3];
+	int n;
+
+	if (len == 0) {
+		return;
+	}
+	buf[0] = 0;
+	if (gGPULock == NULL || gClientsLock == NULL) {
+		return;
+	}
+	bzero(top, sizeof(top));
+	IOLockLock(gClientsLock);
+	for (uint32_t i = 0; i < GPU_CLIENTS_LISTED; i++) {
+		RedwoodGPUUserClient * c = gClients[i];
+		if (c == NULL) {
+			continue;
+		}
+		/* without the client's lock: a log line, aligned 64-bit reads */
+		uint64_t ram = __atomic_load_n(&c->fRamBytes, __ATOMIC_RELAXED);
+		uint64_t own = __atomic_load_n(&c->fOwnBytes, __ATOMIC_RELAXED);
+		uint64_t host = __atomic_load_n(&c->fHostBytes, __ATOMIC_RELAXED);
+		uint64_t pool = own > ram ? own - ram : 0;
+		for (uint32_t t = 0; t < 3; t++) {
+			if (ram + pool + host > top[t].ram + top[t].pool + top[t].host) {
+				memmove(&top[t + 1], &top[t], (2 - t) * sizeof(top[0]));
+				top[t].ram = ram;
+				top[t].pool = pool;
+				top[t].host = host;
+				strlcpy(top[t].name, c->fName, sizeof(top[t].name));
+				break;
+			}
+		}
+	}
+	IOLockUnlock(gClientsLock);
+	n = snprintf(buf, len, "GPU RAM %llu MiB, pool %llu/%llu MiB (full %u times), host %llu MiB",
+	    __atomic_load_n(&gGPURamBytes, __ATOMIC_RELAXED) >> 20,
+	    ((uint64_t)__atomic_load_n(&gPoolInUse, __ATOMIC_RELAXED) * PAGE_SIZE) >> 20,
+	    ((uint64_t)gPoolPages * PAGE_SIZE) >> 20, __atomic_load_n(&gPoolFull, __ATOMIC_RELAXED),
+	    __atomic_load_n(&gGPUHostBytes, __ATOMIC_RELAXED) >> 20);
+	if (__atomic_load_n(&gGPULeftBytes, __ATOMIC_RELAXED) != 0 && n > 0 && (size_t)n < len) {
+		n += snprintf(buf + n, len - n, ", left to the GPU %llu MiB", __atomic_load_n(&gGPULeftBytes, __ATOMIC_RELAXED) >> 20);
+	}
+	for (uint32_t t = 0; t < 3 && top[t].name[0] != 0 && n > 0 && (size_t)n < len; t++) {
+		n += snprintf(buf + n, len - n, "%s%s %llu+%llu+%llu", t == 0 ? "; top (RAM+pool+host MiB) " : ", ",
+		    top[t].name, top[t].ram >> 20, top[t].pool >> 20, top[t].host >> 20);
+	}
+}
