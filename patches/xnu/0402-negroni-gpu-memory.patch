+static IOLock * gClientsLock;
+class RedwoodGPUUserClient;
+static RedwoodGPUUserClient * gClients[GPU_CLIENTS_LISTED];
+
+/*
+ * Patch 0402: the config's pool is the whole [ram] gpu region (negronigpu_pool=2048 at 0xa00000000).
+ * The 512 MiB pool was full ~40 s after boot (2026-10-27 21:13: 49 metal2vulkan blocks of 8 MiB in
+ * 10 Metal processes, 16 of them already in wired kernel RAM), and every write-combined buffer after
+ * that was wired kernel RAM (makeBuffer's fallback): ~1 GiB of IOKit wired memory that was not
+ * surfaces, then the 0399 refusals and a low-swap kill of mediaserverd. The pool never goes past the
+ * end of the RAM bank (GPU_POOL_RAM_END); "pool full" lines and the memory line (NegroniGPUMemoryLine)
+ * count it.
+ */
