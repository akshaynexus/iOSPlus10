@@ -602,6 +656,10 @@ class RedwoodGPUUserClient : public IOUserClient
 	uint32_t                fCap;
 	uint64_t                fOwnBytes;
 	uint64_t                fHostBytes;             /* host imports (0x49) */
+	uint64_t                fRamBytes;              /* 0402: of fOwnBytes, wired kernel RAM (the rest is pool) */
