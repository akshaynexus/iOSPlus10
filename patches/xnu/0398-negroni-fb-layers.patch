+/* 0398: a frame (a merged swap record) of two or more layers, none of them the panel memory itself */
+bool
+AppleCLCD::composeFrame(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104), n = 0;
+
+	if (!fLayersKeep) {
+		return false;
+	}
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		if (fSurface != NULL && id == fSurface->id) {
+			return false;
+		}
+		n++;
+	}
+	return n > 1;
+}
