+/*
+ * 0398: the frame's layers composed into the panel buffer: layer 0 at the bottom (CoreAnimation puts a detached
+ * layer on 0 under its framebuffer on 1), each higher layer premultiplied source-over, nearest-pixel scaling when
+ * the source and display rects differ, black where no layer is. The CPU reads only the surfaces (cached), never
+ * the write-combined panel memory, and writes each panel row once (negroni_compose_row). shiftPx: the 0267 clock
+ * shift applied to the band rows on the way (0: none). Two unscaled full-panel layers, both GPU copies allowed
+ * (held, fence passed, as present()'s copy loop): the row runs where the upper layer is all clear or all opaque
+ * are GPU 2D copies of one layer (*gpuFence: the newest), the CPU composes only the mixed rows and the band.
+ * Only 32-bit BGRA single-plane surfaces; another layer is left out with one line (composeRefuse). Every panel
+ * row is written (0269 counts the frame as full). Work loop.
+ */
+bool
+AppleCLCD::compose(const uint8_t *rec, const uint32_t *fences, NegroniSurface *const *held, uint32_t shiftPx,
+    bool *shifted, uint32_t *gpuFence)
+{
+	struct NegroniComposeLayer ly[NEGRONI_FB_LAYERS];
+	uint32_t n = 0, mask = get32(rec, 0x104), used = 0, fence = 0, gpuRows = 0;
+
+	*gpuFence = 0;
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		NegroniSurface *s = negroni_surface_copy(id);
+		if (s == NULL) {
+			continue;               /* gone since the swap */
+		}
+		const uint8_t *a = rec + 0x64 + 16 * layer, *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4), aw = (int32_t)get32(a, 8), ah = (int32_t)get32(a, 12);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4), bw = (int32_t)get32(b, 8), bh = (int32_t)get32(b, 12);
+		uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+		const char *why = NULL;
+		uintptr_t k = 0;
+		if (bw <= 0 || bh <= 0) {
+			bw = (int32_t)s->width;
+			bh = (int32_t)s->height;
+		}
+		if (aw <= 0 || ah <= 0) {
+			aw = bw;
+			ah = bh;
+		}
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 || s->planeCount > 1 ||
+		    (s->pixelFormat != 0x42475241 /* 'BGRA' */ && s->pixelFormat != 0)) {
+			why = "not 32-bit BGRA";
+		} else if ((uint64_t)sx + (uint64_t)aw > s->width || (uint64_t)sy + (uint64_t)ah > s->height || bw <= 0 || bh <= 0) {
+			why = "source rect outside the surface";
+		} else if (s->memory == NULL || (uint64_t)s->offset + (uint64_t)(sy + ah - 1) * s->bytesPerRow +
+		    (uint64_t)(sx + aw) * 4 > s->memory->getLength()) {
+			why = "source rect outside the memory";
+		} else if ((k = s->kernelAddress()) == 0) {
+			why = "no kernel mapping";
+		}
+		if (why != NULL) {
+			composeRefuse(layer, s, (layer << 28) ^ s->pixelFormat ^ (uint32_t)(uintptr_t)why, why);
+			s->release();
+			continue;
+		}
