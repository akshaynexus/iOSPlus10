+	if (!fLayersKeep) {
+		return;
+	}
+	IOLockLock(fLock);
+	reset = closing ? fLyrOwner == client : fLyrOwner != client;
+	if (reset) {
+		fLyrOwner = closing ? NULL : client;
+	}
