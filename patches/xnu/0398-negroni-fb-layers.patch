+/* 0398: every layer off; the surfaces they held go back to their owners. */
+void
+AppleCLCD::layersReset(void)
+{
+	NegroniSurface *old[NEGRONI_FB_LAYERS];
+
+	IOLockLock(fLock);
+	memcpy(old, fLyrHold, sizeof(old));
+	bzero(fLyrHold, sizeof(fLyrHold));
+	bzero(fLyrId, sizeof(fLyrId));
+	bzero(fLyrFence, sizeof(fLyrFence));
+	IOLockUnlock(fLock);
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		if (old[layer] != NULL) {
+			negroni_surface_hold(old[layer], false);
+			old[layer]->release();
+		}
+	}
+}
