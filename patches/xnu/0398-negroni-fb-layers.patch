+/* 0398: one line per layer configuration the composition cannot take (8 at most) */
+void
+AppleCLCD::composeRefuse(uint32_t layer, NegroniSurface *s, uint32_t key, const char *why)
+{
+	for (uint32_t i = 0; i < fLyrRefusedN; i++) {
+		if (fLyrRefused[i] == key) {
+			return;
+		}
+	}
+	if (fLyrRefusedN >= sizeof(fLyrRefused) / sizeof(fLyrRefused[0])) {
+		return;
+	}
+	fLyrRefused[fLyrRefusedN++] = key;
+	IOLog("NEGRONI FB: 0398 layer %u not composed: %s (surface %u %ux%u fmt 0x%x bpe %u planes %u); the frame "
+	    "is composed without it\n", layer, why, s->id, s->width, s->height, s->pixelFormat, s->bytesPerElement,
+	    s->planeCount);
+}
+
+/* premultiplied source-over: s over d, per 8-bit channel */
+static inline uint32_t
+negroni_over(uint32_t s, uint32_t d)
+{
+	uint32_t a = s >> 24, ia, o = 0;
+
+	if (a == 255) {
+		return s;
+	}
+	if (s == 0) {
+		return d;
+	}
+	ia = 255 - a;
+	for (uint32_t c = 0; c < 32; c += 8) {
+		uint32_t v = ((s >> c) & 0xff) + (((d >> c) & 0xff) * ia + 127) / 255;
+		o |= (v > 255 ? 255 : v) << c;
+	}
+	return o;
+}
+
+/* 0398: one layer of a composed frame */
+struct NegroniComposeLayer {
+	NegroniSurface *s;
+	uintptr_t       base;           /* first pixel of the source rect */
+	uint32_t        bpr;
+	uint32_t        sx, sy;         /* the source rect's surface position */
+	uint32_t        layer;
+	uint32_t        ah;             /* the source rect's rows */
+	bool            gpuWritten;     /* the CPU drops its cache lines of the rows it reads (NegroniGPUSurfaceForCPU) */
+	int32_t         px, py;         /* panel position of the display rect (may be off the panel) */
+	int32_t         x0, x1, y0, y1; /* its part on the panel */
+	uint32_t        stepX, stepY;   /* source pixels per panel pixel, 16.16 */
+	bool            scaled;
+};
+
+#define NEGRONI_FB_ROW_CPU      0       /* fLyrKind: the CPU composes the row */
+#define NEGRONI_FB_ROW_LOWER    1       /* the upper layer is clear in the whole row: a GPU copy of the lower one */
+#define NEGRONI_FB_ROW_UPPER    2       /* the upper layer is opaque in the whole row: a GPU copy of it */
+#define NEGRONI_FB_COMPOSE_MIN_ROWS     8       /* shorter clear / opaque runs: the CPU (one submission less) */
+#define NEGRONI_FB_COMPOSE_SUBMITS      8       /* GPU submissions per composed frame at most; the rest: the CPU */
+
+/*
+ * 0398: panel row y of a composed frame through r (one cached row): layer 0 at the bottom, each higher layer
+ * premultiplied source-over, nearest scaling, black where no layer is; then written once into d (the 0267 /
+ * 0391 clock shift on the band rows). true: the row was shifted.
+ */
+static bool
+negroni_compose_row(uint32_t *r, uint8_t *d, uint32_t W, uint32_t y, const struct NegroniComposeLayer *ly, uint32_t n,
+    uint32_t shiftPx, uint32_t top, uint32_t bottom, bool box)
+{
+	const uint32_t half = W / 2;
+	bool any = false;
+
+	for (uint32_t i = 0; i < n; i++) {
+		if ((int32_t)y < ly[i].y0 || (int32_t)y >= ly[i].y1) {
+			continue;
+		}
+		uint32_t srow = (uint32_t)(((uint64_t)((int32_t)y - ly[i].py) * ly[i].stepY) >> 16);
+		const uint32_t *sp = (const uint32_t *)(ly[i].base + (uintptr_t)srow * ly[i].bpr);
+		int32_t x0 = ly[i].x0, x1 = ly[i].x1;
+		if (!any) {
+			/* the lowest layer on this row: over black, a premultiplied pixel stays as it is */
+			if (x0 > 0) {
+				bzero(r, (size_t)x0 * 4);
+			}
+			if (x1 < (int32_t)W) {
+				bzero(r + x1, (size_t)(W - (uint32_t)x1) * 4);
+			}
+			if (!ly[i].scaled) {
+				memcpy(r + x0, sp + (x0 - ly[i].px), (size_t)(x1 - x0) * 4);
+			} else {
+				for (int32_t x = x0; x < x1; x++) {
+					r[x] = sp[((uint64_t)(x - ly[i].px) * ly[i].stepX) >> 16];
+				}
+			}
+			any = true;
+		} else if (!ly[i].scaled) {
+			const uint32_t *q = sp + (x0 - ly[i].px);
+			for (int32_t x = x0; x < x1; x++, q++) {
+				r[x] = negroni_over(*q, r[x]);
+			}
+		} else {
+			for (int32_t x = x0; x < x1; x++) {
+				r[x] = negroni_over(sp[((uint64_t)(x - ly[i].px) * ly[i].stepX) >> 16], r[x]);
+			}
+		}
+	}
+	if (!any) {
+		bzero(r, (size_t)W * 4);
+	}
+	const uint8_t *rr = (const uint8_t *)r;
+	if (shiftPx > 0 && shiftPx < half && y >= top && y < bottom) {
+		if (box) {
+			/* 0391: the box n to the right, the n columns right of it into the opened gap */
+			memcpy(d, rr, (size_t)W * 4);
+			memcpy(d + (uint64_t)(NEGRONI_FB_CLOCK_BOX_LEFT + shiftPx) * 4, rr + (uint64_t)NEGRONI_FB_CLOCK_BOX_LEFT * 4,
+			    (size_t)(NEGRONI_FB_CLOCK_BOX_RIGHT - NEGRONI_FB_CLOCK_BOX_LEFT) * 4);
+			memcpy(d + (uint64_t)NEGRONI_FB_CLOCK_BOX_LEFT * 4, rr + (uint64_t)NEGRONI_FB_CLOCK_BOX_RIGHT * 4,
+			    (size_t)shiftPx * 4);
+		} else {
+			/* 0267: the left half n to the right, its last n pixels to the left edge */
+			memcpy(d + (uint64_t)shiftPx * 4, rr, (size_t)(half - shiftPx) * 4);
+			memcpy(d, rr + (uint64_t)(half - shiftPx) * 4, (size_t)shiftPx * 4);
+			memcpy(d + (uint64_t)half * 4, rr + (uint64_t)half * 4, (size_t)(W - half) * 4);
+		}
+		return true;
+	}
+	memcpy(d, rr, (size_t)W * 4);
+	return false;
+}
+
+/* 0398: NEGRONI_FB_ROW_LOWER if the n pixels at p are all clear (0), _UPPER if all opaque (alpha 255), else _CPU */
+static uint8_t
+negroni_compose_row_kind(const uint32_t *p, uint32_t n)
+{
+	uint64_t ors = 0, ands = ~0ull, v[4];
+	uint32_t x = 0;
+
+	for (; x + 8 <= n; x += 8) {
+		memcpy(v, p + x, sizeof(v));
+		ors |= v[0] | v[1] | v[2] | v[3];
+		ands &= v[0] & v[1] & v[2] & v[3];
+		if (ors != 0 && (ands & 0xff000000ff000000ull) != 0xff000000ff000000ull) {
+			return NEGRONI_FB_ROW_CPU;
+		}
+	}
+	for (; x < n; x++) {
+		ors |= p[x];
+		ands &= p[x] | 0xffffffff00000000ull;
+	}
+	if (ors == 0) {
+		return NEGRONI_FB_ROW_LOWER;
+	}
+	return (ands & 0xff000000ff000000ull) == 0xff000000ff000000ull ? NEGRONI_FB_ROW_UPPER : NEGRONI_FB_ROW_CPU;
+}
