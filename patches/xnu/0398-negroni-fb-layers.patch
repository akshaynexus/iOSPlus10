+/*
+ * 0398: rec (a SwapEnd) applied to the per-layer state; out = the whole picture as a swap record:
+ * every layer that shows something in +0x54/+0x64/+0xc4 and +0x104, +0x108 cleared. fences: the
+ * swap-time GPU fence of each layer this swap did not change (the one it was set with; the surface's
+ * gpuFence names newer work by now). touched: the layers rec changed. Not in the work loop.
+ */
+void
+AppleCLCD::layersMerge(const uint8_t *rec, uint8_t *out, uint32_t *fences, uint32_t *touched)
+{
+	uint32_t mask = get32(rec, 0x104) & ((1u << NEGRONI_FB_LAYERS) - 1), off = get32(rec, 0x108), all = 0;
+	NegroniSurface *add[NEGRONI_FB_LAYERS] = {}, *old[NEGRONI_FB_LAYERS] = {};
+
+	/* surface lookups outside fLock (the surface registry has a lock of its own) */
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if ((mask & (1u << layer)) && !(off & (1u << layer)) && id != 0) {
+			add[layer] = negroni_surface_copy(id);
+			if (add[layer] != NULL) {
+				negroni_surface_hold(add[layer], true);
+			}
+		}
+	}
+	memcpy(out, rec, NEGRONI_FB_SWAP_REC_SIZE);
+	IOLockLock(fLock);
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		if (mask & (1u << layer)) {
+			bool on = !(off & (1u << layer));
+			old[layer] = fLyrHold[layer];
+			fLyrHold[layer] = add[layer];
+			fLyrId[layer] = on ? get32(rec, 0x54 + 4 * layer) : 0;
+			fLyrFence[layer] = add[layer] != NULL ? add[layer]->gpuFence : 0;
+			memcpy(fLyrA[layer], rec + 0x64 + 16 * layer, 16);
+			memcpy(fLyrB[layer], rec + 0xc4 + 16 * layer, 16);
+		}
+		uint32_t id = fLyrId[layer];
+		memcpy(out + 0x54 + 4 * layer, &id, 4);
+		memcpy(out + 0x64 + 16 * layer, fLyrA[layer], 16);
+		memcpy(out + 0xc4 + 16 * layer, fLyrB[layer], 16);
+		fences[layer] = fLyrFence[layer];
+		all |= id != 0 ? 1u << layer : 0;
+	}
+	IOLockUnlock(fLock);
+	memcpy(out + 0x104, &all, 4);
+	bzero(out + 0x108, 4);
+	*touched = mask;
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		if (old[layer] != NULL) {
+			negroni_surface_hold(old[layer], false);
+			old[layer]->release();
+		}
+	}
 }
 
