 void NegroniGPUSurfaceForCPU(NegroniSurface *s, uint64_t offset, uint64_t length);
 
+/*
+ * 0289: how long the IOSurface CPU lock (NegroniSurface.cpp trap 2) waits for a surface's gpuFence
+ * before it answers, in ms: boot-arg negronisurf_gpuwait (default NEGRONI_SURFACE_GPU_WAIT_MS, 0 =
+ * the lock never waits). RedwoodGPU publishes RedwoodWaitsForGPU = true when it is not 0, so a
+ * library can trust glFlush/commit + the lock instead of glFinish/waitUntilCompleted.
+ */
+#define NEGRONI_SURFACE_GPU_WAIT_MS 50          /* the same bound as the framebuffer's NEGRONI_FB_GPU_WAIT_MS */
+uint32_t NegroniGPUSurfaceWaitMS(void);
+
