 #if defined(NEGRONI)
 #include <IOKit/IOService.h>
@@ -1139,6 +1146,34 @@ negroni_surface_held(IOLock *lock, OSArray *refs, uint32_t id)
 	return s;
 }
 
+/*
+ * 0289: before the CPU reads (or writes) a surface the GPU wrote. The last submission that listed
+ * the surface is s->gpuFence (0230 import, also the fence 0254 records at swap time). Wait for it,
+ * bounded (NegroniGPUSurfaceWaitMS; NegroniGPUFenceWait gives up at once when the GPU is stopped),
+ * then drop the CPU's cached lines when the user mapping is cached (write-combined mappings, the
+ * created surfaces' default, have none). Once per fence value: the seed-bump locks of a Metal
+ * process after every completed command buffer cost one fence check, not a page walk each.
+ */
+static void
+negroni_surface_wait_gpu(NegroniSurface *s)
+{
+	uint32_t fence = s->gpuFence;
+	uint32_t ms = NegroniGPUSurfaceWaitMS();
+	static uint32_t gaveUp;
+
+	if (fence == 0 || ms == 0 || fence == s->cpuSeenFence) {
+		return;
+	}
+	if (!NegroniGPUFenceWait(fence, ms) && gaveUp++ < 8) {
+		IOLog("NEGRONI SURF: %s lock of surface %u: the GPU (fence %u) is not done after %u ms: answered anyway\n",
+		    proc_best_name(current_proc()), s->id, fence, ms);
+	}
+	if (s->mapCache != kIOMapWriteCombineCache) {
+		NegroniGPUSurfaceForCPU(s, 0, s->allocSize);
+	}
+	s->cpuSeenFence = fence;
+}
