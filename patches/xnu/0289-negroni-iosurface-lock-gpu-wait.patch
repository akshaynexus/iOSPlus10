 IOReturn
 IOSurfaceRootUserClient::trapLock(void *id, __unused void *options, void *seedOut,
     void *, void *, void *)
@@ -1147,6 +1182,7 @@ IOSurfaceRootUserClient::trapLock(void *id, __unused void *options, void *seedOu
 	if (s == NULL) {
 		return kIOReturnNotFound;
 	}
+	negroni_surface_wait_gpu(s);
 	IOReturn ret = negroni_surface_seed_out(s, seedOut, false);
 	s->release();
 	return ret;
