+ * bounded polls (delay() spins with interrupts off). Only the flash driver uses this channel.
+ * Returns 0 when both writes completed without an error status, -1 otherwise (or when locked).
+ */
+int
+negroni_spmi_flash_off_nolock(void)
+{
+	static const uint8_t regs[2] = { 0x4e, 0x46 };
+	int rc = 0;
+	if (!sp_flash_unlocked || !sp_flash_chn || sp_flash_apid == SP_NO_APID) {
+		return -1;
+	}
+	for (unsigned r = 0; r < 2; ++r) {
