+/*
+ * negronibatt=2/5, once: every SID 3 (PM8350B) peripheral of the APID map. Only SID 3: no other
+ * kernel user reads a SID 3 APID (the keys read SID 1 GPIO 0x18d on their own thread).
+ */
+void
+NegroniBattery::census(void)
+{
+	static uint16_t ppids[1024];
+	static uint8_t owners[1024];
+	unsigned n = negroni_spmi_ppids(ppids, owners, 1024);
+	char line[200];
+	int m = 0;
+	unsigned shown = 0;
+	IOLog("NEGRONI BATTERY: census: %u APIDs on bus 0 (ppid type/subtype rt_sts owner)\n", n);
+	for (unsigned i = 0; i < n; ++i) {
+		unsigned sid = ppids[i] >> 8;
+		if (sid != 3) {
+			continue;
+		}
+		uint8_t type = 0xff, sub = 0xff, rt = 0xff;
+		unsigned base = (ppids[i] & 0xffu) << 8;
+		(void)negroni_spmi_read(sid, base + 0x04, &type);
+		(void)negroni_spmi_read(sid, base + 0x05, &sub);
+		(void)negroni_spmi_read(sid, base + 0x10, &rt);
+		if (sid == 3 && fRtCount < NB_RT_MAX) {
+			fRtPpid[fRtCount] = ppids[i];
+			fRtLast[fRtCount] = rt;
+			fRtCount++;
+		}
+		m += snprintf(line + m, sizeof(line) - (size_t)m, " %03x %02x/%02x %02x e%u", ppids[i], type, sub, rt, owners[i]);
+		if (++shown % 7 == 0 || m > (int)sizeof(line) - 28) {
+			IOLog("NEGRONI BATTERY: census%s\n", line);
+			m = 0;
+		}
+	}
+	if (m) {
+		IOLog("NEGRONI BATTERY: census%s\n", line);
+	}
+}
