+/* negronibatt=2/5, each poll: a line for each PM8350B peripheral whose INT_RT_STS changed (plug a cable to find VBUS). */
+void
+NegroniBattery::rtChanges(void)
+{
+	for (unsigned i = 0; i < fRtCount; ++i) {
+		uint8_t rt;
+		unsigned base = (fRtPpid[i] & 0xffu) << 8;
+		if (negroni_spmi_read(3, base + 0x10, &rt) || rt == fRtLast[i]) {
+			continue;
+		}
+		IOLog("NEGRONI BATTERY: rt_sts %03x (0x%04x+0x10): 0x%02x -> 0x%02x\n", fRtPpid[i], base, fRtLast[i], rt);
+		fRtLast[i] = rt;
+	}
