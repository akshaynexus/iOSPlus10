0336-negroni-bt-init-fixes: bluetoothd's HCI init on the QCA6490 (phone 2026-10-27 02:49, kernel with 0334/0335:
stage A + HCI stage ok, then "OI_HCICMD_WriteDefaultErroneousDataReporting (status=628)", "HCI initialization
failed", restart reason 108 every ~10 s).

[V] h4 log (logs/usblog-t2.txt): the init sequence is 0c03 1001 1002 1009 1003 1004 2003 0c01 0c63 2001 0c56 0c6d
2060 202f 2031 2024 201c 200f 1005 204a 2074 0c33 0c31, then the client closes. The only chip error is 0x0c6d
(status 0x11). 0x0c5b is never sent: bluetoothd's stack checks the Read_Local_Supported_Commands mask and fails
locally.

Answered in the kernel (negroni_bt_shim.c), negronibt_shimfix=0 turns this off:
- 0x0c6d Write_LE_Host_Support: always, Command Complete status 0.
- 0x0c5b Write_Default_Erroneous_Data_Reporting: Command Complete status 0, when the chip's mask lacks octet 18 bit 3.
- 0x0c5a Read_Default_Erroneous_Data_Reporting: Command Complete status 0 + 0x00 (disabled), when the mask lacks
  octet 18 bit 2.
- The 0x1002 answer gets octet 18 bits 2+3 set; the full 64-byte mask is logged once per client.
- Every other standard command the chip rejects is logged: "shim controller rejected 0xXXXX: ... status 0xNN".

diff --git a/bsd/dev/negroni_bt_shim.c b/bsd/dev/negroni_bt_shim.c
index e3c60ae..9d1cbab 100644
--- a/bsd/dev/negroni_bt_shim.c
+++ b/bsd/dev/negroni_bt_shim.c
@@ -45,6 +45,26 @@
 #define EV_VENDOR       0xffu
 #define OGF_VENDOR      0x3fu
 #define OP_READ_LOCAL_VERSION 0x1001u
+#define EV_CMD_STATUS   0x0fu
+/*
+ * 0336 (iOSPlus10): standard commands of bluetoothd's HCI init that the QCA6490 does not take [V, phone 2026-10-27,
+ * logs/usblog-t2.txt and phone-log-20261027-025222.txt]:
+ *   0x0c6d Write_LE_Host_Support: the chip answers status 0x11 (Unsupported Feature or Parameter Value) on every init
+ *          (LE host support is implied on a 5.x controller; the command is deprecated) -> local status 0.
+ *   0x0c5b Write_Default_Erroneous_Data_Reporting / 0x0c5a Read_...: bluetoothd never sends them; its stack checks the
+ *          Read_Local_Supported_Commands mask (octet 18 bit 3 / bit 2, as Linux hci_sync.c commands[18] & 0x08 / 0x04),
+ *          fails locally ("OI_HCICMD_WriteDefaultErroneousDataReporting (status=628)", "HCI initialization failed",
+ *          restart reason 108). So the 0x1002 answer gets both bits, and when the chip did not have them the commands
+ *          are answered here (write: status 0; read: status 0, reporting 0x00 disabled).
+ * Every other non-zero status from the chip is logged ("controller rejected ...") for the next round.
+ * negronibt_shimfix=0 turns 0336 off.
+ */
+#define OP_READ_SUPPORTED_COMMANDS 0x1002u
+#define OP_READ_ERR_DATA  0x0c5au
+#define OP_WRITE_ERR_DATA 0x0c5bu
+#define OP_WRITE_LE_HOST  0x0c6du
+#define CMDS_OCTET_ERR    18u
+#define CMDS_ERR_BITS     0x0cu         /* bit 2 read, bit 3 write */
 
 struct shim_op {
 	uint16_t op;
@@ -80,6 +100,9 @@ static struct {
 	bool version_logged;
 	uint16_t seen[SEEN_SLOTS];
 	uint32_t n_local, n_vse;
+	uint32_t fix;
