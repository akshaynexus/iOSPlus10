+/* 0391: the first panel row of the clock band (0 with negronifb_clockband=0) */
+static int negroni_clock_band = -1;
+
+static bool
+negroni_clock_band_on(void)
+{
+	if (negroni_clock_band < 0) {
+		negroni_clock_band = 1;
+		PE_parse_boot_argn("negronifb_clockband", &negroni_clock_band, sizeof(negroni_clock_band));
+		negroni_clock_band = negroni_clock_band != 0;
+		IOLog("NEGRONI FB: 0391 clock shift %s\n", negroni_clock_band ? "on panel rows 34..80 only (the clock's rows; "
+		    "content under the status bar below them stays in place)" : "on the whole strip (negronifb_clockband=0)");
+	}
+	return negroni_clock_band != 0;
+}
+
+static uint32_t
+negroni_clock_top(void)
+{
+	return negroni_clock_band_on() && negroni_clock_rows() > NEGRONI_FB_CLOCK_BAND_TOP ? NEGRONI_FB_CLOCK_BAND_TOP : 0;
+}
+
+/* 0391: the box shift fits this row width (n <= box width, box end + n <= half the row) */
+static bool
+negroni_clock_box(uint32_t width, uint32_t n)
+{
+	return negroni_clock_band_on() && n <= NEGRONI_FB_CLOCK_BOX_RIGHT - NEGRONI_FB_CLOCK_BOX_LEFT &&
+	       NEGRONI_FB_CLOCK_BOX_RIGHT + n <= width / 2;
+}
+
+/* 0391: one band row shifted in place (row = panel pixels of one row; box or the 0256 half-row shift with edge fill) */
+static void
+negroni_clock_row_inplace(uint32_t *row, uint32_t width, uint32_t n, const uint32_t *fillFrom)
+{
+	uint32_t half = width / 2;
+	if (negroni_clock_box(width, n)) {
+		uint32_t tmp[400];
+		memcpy(tmp, row + NEGRONI_FB_CLOCK_BOX_RIGHT, (size_t)n * 4);
+		memmove(row + NEGRONI_FB_CLOCK_BOX_LEFT + n, row + NEGRONI_FB_CLOCK_BOX_LEFT,
+		    (size_t)(NEGRONI_FB_CLOCK_BOX_RIGHT - NEGRONI_FB_CLOCK_BOX_LEFT) * 4);
+		memcpy(row + NEGRONI_FB_CLOCK_BOX_LEFT, tmp, (size_t)n * 4);
+		return;
+	}
+	uint32_t edge = row[0];         /* the status bar's own colour at its left edge */
+	memmove(row + n, row, (size_t)(half - n) * 4);
+	for (uint32_t x = 0; x < n; x++) {
+		row[x] = fillFrom != NULL ? fillFrom[half - n + x] : edge;
+	}
+}
+
+/* the row after the band: with the band, the 0391 bottom (or negronifb_clockrows when that is lower) */
+static uint32_t
+negroni_clock_bottom(void)
+{
+	uint32_t rows = negroni_clock_rows();
+	return negroni_clock_band_on() && rows > NEGRONI_FB_CLOCK_BAND_BOTTOM ? NEGRONI_FB_CLOCK_BAND_BOTTOM : rows;
+}
