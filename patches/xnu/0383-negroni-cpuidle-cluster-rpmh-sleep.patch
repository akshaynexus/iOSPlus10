@@ -77,6 +103,18 @@ bool negroni_cpuidle_bcast_irq(uint32_t intid);
 #define PSCI_CPU_SUSPEND64      0xc4000001ull
 #define PSCI_SET_SUSPEND_MODE   0x8400000full
 #define PSCI_INVALID_PARAMETERS (-2)
+#define PSCI_DENIED             (-3)
+#define PSCI_MODE_OSI           1ull
+#define CI_CL_SKIP              4       /* idles core-only after a DENIED cluster request */
+#define SS_AOP_PHYS             0xc3f0000ull    /* live.dts soc-sleep-stats@c3f0000 */
+#define SS_AOP_WIN              0x10000ull      /* base = 0xc3f0000 | offset word: inside this window */
+#define SS_RECORDS              3
