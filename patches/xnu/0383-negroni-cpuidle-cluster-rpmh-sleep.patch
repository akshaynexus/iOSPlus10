index 50a7c2f..25c410d 100644
--- a/bsd/dev/negroni_rpmh.c
+++ b/bsd/dev/negroni_rpmh.c
@@ -61,6 +61,15 @@ static unsigned rh_ncpt;
 static unsigned rh_lock;
 static bool rh_poisoned;
 
+/*
+ * 0383: SLEEP and WAKE sets of this DRV (boot-arg negronirpmh_sleep, default 0 = never written). Forward
+ * declarations; the code is at the end of this file.
+ */
+#include <pexpert/pexpert.h>
+static void rh_sleep_init(void);
+static void rh_note_vote(uint32_t address, const uint32_t *offsets, const uint32_t *values, unsigned ncmd, int mode);
+static bool rh_keepalive;       /* negroni_rpmh_qup_bcm: this BCM vote is the keepalive minimum (Linux: sleep 0) */
+
 static uint32_t
 rh_read(vm_offset_t base, uint32_t off)
 {
@@ -152,6 +161,7 @@ rh_map(void)
 		printf("NEGRONI RPMH: unsupported/standalone cmd-db\n");
 		return EINVAL;
 	}
+	rh_sleep_init();        /* 0383: once: read-only TCS dump, sleep/wake set mode */
 	return 0;
 }
 
@@ -350,6 +360,7 @@ rh_send(uint32_t address, unsigned mv, int mode)
 	}
 	rh_poisoned = false;
 	printf("NEGRONI RPMH: ACTIVE vote for %#x complete\n", address);
+	rh_note_vote(address, offsets, values, ncmd, mode);     /* 0383: cache + SLEEP/WAKE sets */
 	return 0;
 }
 
@@ -764,6 +775,7 @@ negroni_rpmh_qup_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uin
 		uint64_t y = rh_bcm_div(rh_bcm_div((uint64_t)peak_kbps * width, buswidth) * vote_scale, unit);
 		if (x == 0 && y == 0) {
 			x = y = 1;      /* keepalive */
+			rh_keepalive = true;    /* 0383: Linux bcm-voter keepalive is AMC + WAKE only: sleep 0 */
 		}
 		x = MIN(x, 0x3fffull);
 		y = MIN(y, 0x3fffull);
@@ -776,10 +788,265 @@ negroni_rpmh_qup_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uin
 		error = rh_send(address, data, RH_MODE_BCM);
 	}
 out:
+	rh_keepalive = false;
 	if (error) {
 		printf("NEGRONI RPMH: BCM %s vote failed errno=%d\n", res, error);
 	}
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
 }
+
+/*
+ * 0383 (iOSPlus10): SLEEP and WAKE sets of the apps DRV 2, as Linux drivers/soc/qcom/rpmh.c (cache_rpm_request,
+ * _rpmh_flush, is_req_valid) and rpmh-rsc.c (rpmh_probe_tcs_config, tcs_invalidate, find_slots, __tcs_buffer_write).
+ *
+ * The RSC of this DRV has no HW solver (DRV_SOLVER_CONFIG bit 24 = 0: solver=0x4010100 on the phone), so the
+ * hardware sends the SLEEP TCS commands when the APSS goes to its deepest state (the cluster collapse) and the WAKE
+ * TCS commands when it comes back, before a CPU runs. Linux writes them at the cluster power-domain PRE_OFF
+ * (rpmh_rsc_pd_cb, live.dts rsc@17a00000 power-domains = cluster-pd). Here they are written at once in thread
+ * context, after every ACTIVE vote that changes the cache (under rh_lock; the APSS is awake then, so the hardware
+ * does not run them while we write). The idle path only asks negroni_rpmh_sleep_ready() (no MMIO writes).
+ *
+ * TCS layout: live.dts qcom,tcs-config = <2 3> <0 2> <1 2> <3 0> <4 1> = ACTIVE 3, SLEEP 2, WAKE 2, CONTROL 0,
+ * FAST_PATH 1, numbered in that order: TCS 0-2 ACTIVE, 3-4 SLEEP, 5-6 WAKE, 7 FAST_PATH; 16 commands per TCS.
+ *
+ * Linux puts a request into the sets only when its sleep value differs from its wake value (is_req_valid). Our votes:
+ *   VRM rails (touch, Wi-Fi, BT, USB PHY, camera): Linux qcom,set = 3 = the same value in both sets -> not written.
+ *   ARC levels (lcx/lmx/mmcx/mxc), BCM bandwidth: rpmhpd non-AO / icc tag ALWAYS = the same value -> not written,
+ *     except negronirpmh_sleep=2 (ours, not Linux): sleep = level 0 / bandwidth 0.
+ *   BCM keepalive-only vote (QUP x = y = 1 for 0 kBps): bcm-voter keepalive covers AMC + WAKE only -> sleep 0.
+ * WAKE = the ACTIVE value. Sleep commands are fire-and-forget, wake commands need a response (Linux send_single).
+ *
+ * Boot-arg negronirpmh_sleep: 0 (default) = the sets are never written (as before 0383); 1 = Linux rules above;
+ * 2 = + ARC level 0 and BCM 0 in sleep for every ARC/BCM vote of this DRV.
+ */
+#define RH_TCS_COUNT    8u
+#define RH_SLEEP_TCS0   3u
+#define RH_WAKE_TCS0    5u
+#define RH_FAST_TCS     7u
+#define RH_SW_N         2u              /* TCS per set */
+#define RH_CACHE_MAX    48u
+#define RH_MSG_FIRE     (8u | (1u << 16))               /* CMD_MSGID_LEN | CMD_MSGID_WRITE */
+#define RH_MSG_RESP     (8u | (1u << 8) | (1u << 16))   /* + CMD_MSGID_RESP_REQ */
+#define RH_BCM_SLEEP0   (1u << 30)                      /* BCM_TCS_CMD(commit, !valid, 0, 0): bcm-voter tcs_cmd_gen */
+
+enum { RH_K_SAME = 0, RH_K_ARC, RH_K_BCM, RH_K_KEEPALIVE };
+
+struct rh_entry {
+	uint32_t addr, wake;
+	uint8_t kind;
+};
+
+static struct rh_entry rh_cache[RH_CACHE_MAX];
+static unsigned rh_ncache;
+static uint32_t rh_sleep_mode;
+static bool rh_sleep_inited, rh_sw_ok, rh_sw_broken, rh_dirty;
+static uint32_t rh_flushes, rh_flush_fail, rh_nsleep, rh_cache_full, rh_busy_idle;
+
+bool negroni_rpmh_sleep_ready(void);
+void negroni_rpmh_sleep_log(void);
+
+static uint32_t
+rh_sleep_value(const struct rh_entry *e)
+{
+	switch (e->kind) {
+	case RH_K_KEEPALIVE:
+		return RH_BCM_SLEEP0;
+	case RH_K_BCM:
+		return rh_sleep_mode >= 2 ? RH_BCM_SLEEP0 : e->wake;
+	case RH_K_ARC:
+		return rh_sleep_mode >= 2 ? 0u : e->wake;
+	default:
+		return e->wake;
+	}
+}
+
+/* Once, under rh_lock, after the first good rh_map(): a read-only dump of all 8 TCS and the mode. */
+static void
+rh_sleep_init(void)
+{
+	if (rh_sleep_inited) {
+		return;
+	}
+	rh_sleep_inited = true;
+	(void)PE_parse_boot_argn("negronirpmh_sleep", &rh_sleep_mode, sizeof(rh_sleep_mode));
+	uint32_t config = rh_read(rh_rsc, 0x0c);
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	bool inherited = false;
+	for (unsigned t = 0; t < RH_TCS_COUNT && t < count; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE, en = rh_read(rh_tcs, b + RH_ENABLE);
+		const char *kind = t < RH_ACTIVE_N ? "ACTIVE" : t < RH_WAKE_TCS0 ? "SLEEP" : t < RH_FAST_TCS ? "WAKE" : "FAST";
+		printf("NEGRONI RPMH: 0383 TCS%u %s status %#x control %#x enable %#x wait %#x\n", t, kind,
+		    rh_read(rh_tcs, b + RH_STATUS), rh_read(rh_tcs, b + RH_CONTROL), en, rh_read(rh_tcs, b + RH_WAIT));
+		for (unsigned c = 0; c < rh_ncpt && c < 16; ++c) {
+			if (!(en & (1u << c))) {
+				continue;
+			}
+			uint32_t cb = b + c * RH_CMD_STRIDE;
+			printf("NEGRONI RPMH: 0383 TCS%u cmd%u msgid %#x addr %#x data %#x status %#x\n", t, c,
+			    rh_read(rh_tcs, cb + RH_MSGID), rh_read(rh_tcs, cb + RH_ADDR), rh_read(rh_tcs, cb + RH_DATA),
+			    rh_read(rh_tcs, cb + RH_CMD_STATUS));
+			if (t >= RH_SLEEP_TCS0 && t < RH_FAST_TCS) {
+				inherited = true;
+			}
+		}
+	}
+	const char *why = NULL;
+	if (rh_sleep_mode == 0) {
+		why = "negronirpmh_sleep=0 (default)";
+	} else if (count != RH_TCS_COUNT || rh_ncpt != 16) {
+		why = "TCS geometry is not the live DT one (8 TCS, 16 commands)";
+	} else if (inherited) {
+		why = "the boot chain left SLEEP/WAKE commands: not touched";
+	}
+	rh_sw_ok = why == NULL;
+	printf("NEGRONI RPMH: 0383 sleep/wake sets %s (mode %u%s%s)\n", rh_sw_ok ? "ON" : "off", rh_sleep_mode,
+	    why ? ": " : "", why ? why : "");
+}
+
+static bool
+rh_sw_cmd(unsigned t, unsigned c, uint32_t msgid, uint32_t addr, uint32_t data)
+{
+	uint32_t cb = t * RH_TCS_STRIDE + c * RH_CMD_STRIDE;
+	return rh_sync(cb + RH_MSGID, msgid) && rh_sync(cb + RH_ADDR, addr) && rh_sync(cb + RH_DATA, data);
+}
+
+/*
+ * Under rh_lock, thread context: rewrite both sets from the cache (Linux _rpmh_flush: invalidate, then every valid
+ * request as one sleep + one wake command). WAKE commands and enables go in first, SLEEP last, so a partial write
+ * never leaves a sleep value without its wake value. On a failure the SLEEP and then the WAKE enables are cleared (empty
+ * sets change nothing); if even that fails, the cluster states stay off for this boot (negroni_rpmh_sleep_ready).
+ */
+static void
+rh_flush_sets(void)
+{
+	uint32_t wen[RH_SW_N] = { 0 }, sen[RH_SW_N] = { 0 };
+	unsigned n = 0;
+	bool ok = true;
+
+	for (unsigned i = 0; i < RH_SW_N && ok; ++i) {
+		uint32_t bs = (RH_SLEEP_TCS0 + i) * RH_TCS_STRIDE, bw = (RH_WAKE_TCS0 + i) * RH_TCS_STRIDE;
+		ok = rh_sync(bs + RH_ENABLE, 0) && rh_sync(bs + RH_WAIT, 0) && rh_sync(bw + RH_ENABLE, 0) &&
+		    rh_sync(bw + RH_WAIT, 0);
+	}
+	for (unsigned i = 0; i < rh_ncache && ok; ++i) {
+		const struct rh_entry *e = &rh_cache[i];
+		uint32_t sleep = rh_sleep_value(e);
+		if (sleep == e->wake) {
+			continue;
+		}
+		if (n >= RH_SW_N * rh_ncpt) {
+			rh_cache_full++;
+			break;
+		}
+		unsigned t = n / rh_ncpt, c = n % rh_ncpt;
+		ok = rh_sw_cmd(RH_WAKE_TCS0 + t, c, RH_MSG_RESP, e->addr, e->wake) &&
+		    rh_sw_cmd(RH_SLEEP_TCS0 + t, c, RH_MSG_FIRE, e->addr, sleep);
+		wen[t] |= 1u << c;
+		sen[t] |= 1u << c;
+		n++;
+	}
+	for (unsigned t = 0; t < RH_SW_N && ok; ++t) {
+		ok = rh_sync((RH_WAKE_TCS0 + t) * RH_TCS_STRIDE + RH_ENABLE, wen[t]);
+	}
+	for (unsigned t = 0; t < RH_SW_N && ok; ++t) {
+		ok = rh_sync((RH_SLEEP_TCS0 + t) * RH_TCS_STRIDE + RH_ENABLE, sen[t]);
+	}
+	rh_flushes++;
+	if (ok) {
+		rh_nsleep = n;
+		rh_dirty = false;
+		return;
+	}
+	rh_flush_fail++;
+	rh_sw_ok = false;
+	/*
+	 * SLEEP first, then WAKE: the sets are not rewritten after this, so a WAKE command left enabled would send a
+	 * stale value at every APSS wake and undo a later ACTIVE vote for the same resource.
+	 */
+	bool cleared = true;
+	for (unsigned t = 0; t < RH_SW_N; ++t) {
+		cleared &= rh_sync((RH_SLEEP_TCS0 + t) * RH_TCS_STRIDE + RH_ENABLE, 0);
+	}
+	for (unsigned t = 0; t < RH_SW_N; ++t) {
+		cleared &= rh_sync((RH_WAKE_TCS0 + t) * RH_TCS_STRIDE + RH_ENABLE, 0);
+	}
+	rh_sw_broken = !cleared;
+	rh_dirty = false;
+	rh_nsleep = 0;
+	printf("NEGRONI RPMH: 0383 sleep/wake set write failed: sets off for this boot, sets %s\n",
+	    cleared ? "emptied" : "NOT emptied (cluster states stay off)");
+}
+
+/* Under rh_lock after a completed ACTIVE vote: cache each command (WAKE = ACTIVE value), then rewrite the sets. */
+static void
+rh_note_vote(uint32_t address, const uint32_t *offsets, const uint32_t *values, unsigned ncmd, int mode)
+{
+	uint8_t kind = mode == RH_MODE_ARC ? RH_K_ARC : mode == RH_MODE_BCM ? (rh_keepalive ? RH_K_KEEPALIVE : RH_K_BCM) :
+	    RH_K_SAME;
+	bool changed = false;
+
+	for (unsigned c = 0; c < ncmd; ++c) {
+		uint32_t a = address + offsets[c];
+		unsigned i = 0;
+		while (i < rh_ncache && rh_cache[i].addr != a) {
+			i++;
+		}
+		if (i == rh_ncache) {
+			if (rh_ncache >= RH_CACHE_MAX) {
+				rh_cache_full++;
+				continue;
+			}
+			rh_ncache++;
+			rh_cache[i].addr = a;
+			rh_cache[i].wake = ~values[c];
+		}
+		struct rh_entry old = rh_cache[i];
+		rh_cache[i].wake = values[c];
+		rh_cache[i].kind = kind;
+		changed |= old.wake != values[c] || old.kind != kind;
+	}
+	if (!rh_sw_ok || !changed) {
+		return;
+	}
+	rh_dirty = true;
+	rh_flush_sets();
+}
+
+/*
+ * The CPU idle path (osfmk/arm64/negroni_cpuidle.c, interrupts masked), before a cluster state: false when an RPMh
+ * transaction of this DRV may be in flight or the sets are not current (Linux rpmh_rsc_ctrlr_is_busy + a failed
+ * flush = NOTIFY_BAD). Reads only; never waits.
+ */
+bool
+negroni_rpmh_sleep_ready(void)
+{
+	if (__atomic_load_n(&rh_lock, __ATOMIC_ACQUIRE) || rh_sw_broken || (rh_sw_ok && rh_dirty)) {
+		__atomic_fetch_add(&rh_busy_idle, 1, __ATOMIC_RELAXED);
+		return false;
+	}
+	vm_offset_t tcs = rh_tcs;
+	if (tcs != 0) {
+		for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+			if (rh_read(tcs, t * RH_TCS_STRIDE + RH_STATUS) == 0) {
+				__atomic_fetch_add(&rh_busy_idle, 1, __ATOMIC_RELAXED);
+				return false;
+			}
+		}
+		if (rh_read(tcs, RH_FAST_TCS * RH_TCS_STRIDE + RH_STATUS) == 0) {
+			__atomic_fetch_add(&rh_busy_idle, 1, __ATOMIC_RELAXED);
+			return false;
+		}
+	}
+	return true;
+}
+
+/* One status line (the 60 s line of negroni_cpuidle.c). */
+void
+negroni_rpmh_sleep_log(void)
+{
+	printf("NEGRONI RPMH: 0383 sleep/wake sets %s, mode %u, %u cached votes, %u sleep+wake pairs written, flushes %u "
+	    "(failed %u), cache full %u, busy at idle %u\n", rh_sw_broken ? "BROKEN" : rh_sw_ok ? "on" : "off", rh_sleep_mode,
+	    rh_ncache, rh_nsleep, rh_flushes, rh_flush_fail, rh_cache_full, rh_busy_idle);
+}
 #endif /* ARM64_BOARD_CONFIG_NEGRONI */
