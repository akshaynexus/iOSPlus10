+			ss_prev_acc[i] = acc;
+		}
+		printf("NEGRONI CPUIDLE: rpmh stats (aosd = AOSS sleep / XO off, cxsd = CX collapse): %s\n", line);
+	}
+	if (ss_ddr) {
