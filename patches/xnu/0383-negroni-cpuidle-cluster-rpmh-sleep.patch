+ * - Sleep statistics, read-only (negronicpuidle_stats, default 7 at level >= 1, 0 at level 0): bit 0 the AOP
+ *   rpmh-sleep-stats records (live.dts soc-sleep-stats@c3f0000, Linux soc_sleep_stats.c rpmh_data: base = 0xc3f0000 |
+ *   [0xc3f0004], 3 records of 32 bytes: name, count, last entered, last exited, accumulated 19.2 MHz ticks), bit 1 the
+ *   DDR stats (base = 0xc3f0000 | [0xc3f001c], magic 0xa1157a75), bit 2 the CPUSS LPM counters (live.dts
+ *   cpuss-sleep-stats apss_seq_mem_base 0x178c0000, qcom_cpuss_sleep_stats.c v1 offsets: C4 count 0x80d8 + 8n,
+ *   cluster D4 count at n = 8, C4/D4 residency 0xc0d0 + 8n). One line each per 60 s with the change.
  */
 #include <pexpert/arm64/board_config.h>
 
@@ -65,6 +86,11 @@ extern int setPop(uint64_t time);                               /* osfmk/arm/rtc
 extern void negroni_gic_spi_enable(uint32_t intid, uint64_t mpidr);     /* pexpert/arm/pe_fiq.c (0288) */
 extern void negroni_gic_spi_route(uint32_t intid, uint64_t mpidr);
 
+extern bool negroni_rpmh_sleep_ready(void);              /* bsd/dev/negroni_rpmh.c (0383) */
+extern void negroni_rpmh_sleep_log(void);
+extern int negroni_mmio_try_rd32(vm_offset_t a, uint32_t *v);  /* osfmk/arm64/sleh.c (0297): 0 = read, < 0 = refused */
+extern uint32_t negroni_mmio_try_faults;
+
 void negroni_cpuidle_init(void);
