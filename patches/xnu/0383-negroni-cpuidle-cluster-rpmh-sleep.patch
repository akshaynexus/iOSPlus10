+static vm_offset_t ss_aop, ss_ddr, ss_cnt, ss_res;
+static uint32_t ss_ddr_n;
+static uint32_t ss_prev_cnt[SS_RECORDS];
+static uint64_t ss_prev_acc[SS_RECORDS];
+static uint32_t ss_prev_ddr[SS_DDR_MAX];
+static uint64_t ss_prev_c4[CI_CPUS + 1], ss_prev_res[CI_CPUS + 1];
+
+static uint64_t
+ss_rd64(vm_offset_t base, uint32_t off)
+{
+	return (uint64_t)bc_rd(base, off + 4) << 32 | bc_rd(base, off);
+}
+
+/*
+ * A stats page may be outside the HLOS VM's stage-2 map (Gunyah injects a synchronous external abort): the first
+ * and the last word of each region are read with the 0297 try-accessor (sleh.c) first; a refused region stays off.
+ * negroni_mmio_try_rd32 returns -2 without an access on kernels without CONFIG_XNUPOST: then the stats stay off.
+ */
+static bool
+ss_probe(vm_offset_t base, uint32_t first, uint32_t last)
+{
+	uint32_t v;
+
+	return base != 0 && negroni_mmio_try_rd32(base + first, &v) == 0 && negroni_mmio_try_rd32(base + last, &v) == 0;
+}
+
+static void
+ss_start(void)
+{
+	if (ci_stats_arg & 3) {
+		vm_offset_t hdr = ml_io_map(SS_AOP_PHYS, 0x20);
