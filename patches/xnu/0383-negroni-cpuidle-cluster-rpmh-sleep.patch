+			vm_offset_t a = ml_io_map(SS_AOP_PHYS | off, SS_RECORDS * SS_RECORD);
+			ss_aop = ss_probe(a, 0, SS_RECORDS * SS_RECORD - 4) ? a : 0;
+		}
+		if ((ci_stats_arg & 2) && doff != 0 && (doff & 3) == 0 && doff <= SS_AOP_WIN - (8 + SS_DDR_MAX * 16)) {
+			vm_offset_t d = ml_io_map(SS_AOP_PHYS | doff, 8 + SS_DDR_MAX * 16);
+			bool readable = ss_probe(d, 0, 8 + SS_DDR_MAX * 16 - 4);
