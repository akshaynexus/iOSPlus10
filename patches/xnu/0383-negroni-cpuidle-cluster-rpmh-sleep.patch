+		if (hdr == 0 || negroni_mmio_try_rd32(hdr + 0x4, &off) != 0 || negroni_mmio_try_rd32(hdr + 0x1c, &doff) != 0) {
+			printf("NEGRONI CPUIDLE: sleep stats header at 0x%llx not readable (try faults %u): AOP/DDR stats off\n",
