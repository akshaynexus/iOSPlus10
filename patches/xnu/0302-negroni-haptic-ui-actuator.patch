 #include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSData.h>
+#include <IOKit/IORegistryEntry.h>
+#include <IOKit/IODeviceTreeSupport.h>
 #include <libkern/c++/OSDictionary.h>
 #include <libkern/c++/OSNumber.h>
 #include <libkern/c++/OSString.h>
@@ -61,9 +64,62 @@ private:
 
 OSDefineMetaClassAndStructors(NegroniVibrator, IOService);
 
+/*
+ * Patch 0302 (negronihap_ui=1): IODeviceTree:/product/haptics as in the D22 ADT
+ * (external/slop/research/ipsw-x/d22ap.adt: closed-loop = 1, supports-3rd-party-haptics = 1).
+ * libMobileGestalt [V 20H392]: DeviceSupportsClosedLoopHaptics (gqDnklGQnpv5ilgh5uHckw, handler
+ * 0x19c564a9c) = "IODeviceTree:/product/haptics" "closed-loop"; DeviceSupportsHaptics
+ * (cBy4BcYs5YWtFHbBpt4C6A, 0x19c576454) looks at "IODeviceTree:/product" for "haptics".
+ * With them UIKit's feedback level is 2 and CoreHaptics, UIFeedbackGenerator and the vibe engine
+ * play on VirtualAudioDevice_Actuator -> NegroniAudio "Actuator" -> /dev/negroni-haptic
+ * (bsd/dev/negroni_haptic_ui.c). Called before the "vibrator" checks: it does not need negronivib.
+ */
+static void
+negroni_publish_haptics_node(void)
+{
+	uint32_t hap = 0, ui = 0;
+	(void)PE_parse_boot_argn("negronihap", &hap, sizeof(hap));
+	(void)PE_parse_boot_argn("negronihap_ui", &ui, sizeof(ui));
+	if (hap == 0 || ui == 0) {
+		return;
+	}
+	IORegistryEntry *product = IORegistryEntry::fromPath("/product", gIODTPlane);
+	if (product == NULL) {
+		IOLog("NEGRONI HAPTIC UI: no IODeviceTree:/product: closed-loop not published\n");
+		return;
+	}
+	IORegistryEntry *old = product->childFromPath("haptics", gIODTPlane);
+	if (old != NULL) {
+		IOLog("NEGRONI HAPTIC UI: IODeviceTree:/product/haptics exists already (ADT): kept\n");
+		old->release();
+		product->release();
+		return;
+	}
+	static const uint32_t one = 1;
+	static const char name[] = "haptics";
+	IORegistryEntry *node = new IORegistryEntry;
+	OSData *n = OSData::withBytes(name, sizeof(name));
+	OSData *cl = OSData::withBytes(&one, sizeof(one));
+	OSData *third = OSData::withBytes(&one, sizeof(one));
+	bool ok = node && n && cl && third && node->init(NULL);
+	if (ok) {
+		node->setName(name);
+		ok = node->setProperty("name", n) && node->setProperty("closed-loop", cl) &&
+		    node->setProperty("supports-3rd-party-haptics", third) && node->attachToParent(product, gIODTPlane);
+	}
+	IOLog("NEGRONI HAPTIC UI: IODeviceTree:/product/haptics closed-loop = 1, supports-3rd-party-haptics = 1: %s\n",
+	    ok ? "published (UI haptics -> VirtualAudioDevice_Actuator -> /dev/negroni-haptic)" : "FAILED");
+	OSSafeReleaseNULL(n);
+	OSSafeReleaseNULL(cl);
+	OSSafeReleaseNULL(third);
+	OSSafeReleaseNULL(node);        /* the parent link keeps it */
+	product->release();
+}
