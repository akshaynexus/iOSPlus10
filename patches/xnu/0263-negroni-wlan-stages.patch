+/*
+ * Step 6 (0263, read only unless negroniwlan_smmu=2): can the chip's DMA reach RAM?
+ * PCIe0 DMA uses apps-SMMU stream 0x1c01 (out/live.dts iommu-map) through the PCIe TBU
+ * (clock gcc_ddrss_pcie_sf_tbu_clk) and the aggre NoC (gcc_aggre_noc_pcie_0_axi_clk). A stream
+ * the SMMU faults, or a gated TBU/NoC clock, can hang or fault the first BHI read [I]; the phone
+ * restarted during the first BHI SBL download (notes section 16, 2026-10-26).
+ */
+#include "negroni_mmio.h"      /* 0255: hypervisor-safe apps SMMU access (here: later patches anchor on the include list) */
+#define APPS_SMMU_PHYS          0x15000000u
+#define SMMU_SCR0               0x000
+#define SMMU_SCR0_CLIENTPD      (1u << 0)
+#define SMMU_SCR0_USFCFG        (1u << 10)
+#define SMMU_SCR0_EXIDENABLE    (1u << 3)
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_SGFSR              0x048
+#define SMMU_SMR(n)             (0x800u + 4u * (n))
+#define SMMU_S2CR(n)            (0xc00u + 4u * (n))
+#define SMMU_SMR_VALID          (1u << 31)
+#define PCIE0_SID               0x1c01u
+#define GCC_AGGRE_NOC_PCIE_0    0x7b08cu        /* gcc-sm8450.c gcc_aggre_noc_pcie_0_axi_clk halt reg */
+#define GCC_DDRSS_PCIE_SF_TBU   0x9d094u        /* gcc_ddrss_pcie_sf_tbu_clk halt reg */
+#define GCC_CLK_OFF             (1u << 31)
+#define GCC_VOTE_0              0x62000u        /* APCS clock branch enable vote */
+#define GCC_VOTE_NOC            (1u << 12)      /* gcc_aggre_noc_pcie_0_axi_clk */
+#define GCC_VOTE_TBU            (1u << 19)      /* gcc_ddrss_pcie_sf_tbu_clk */
+
 static int
-wlan_run(void)
+wlan_dma_path(void)
+{
+	uint32_t noc = MHI_ALL_ONES, tbu = MHI_ALL_ONES, vote = MHI_ALL_ONES;
+
+	if (P.gcc) {
+		noc = *(volatile uint32_t *)(P.gcc + GCC_AGGRE_NOC_PCIE_0);
+		tbu = *(volatile uint32_t *)(P.gcc + GCC_DDRSS_PCIE_SF_TBU);
+		vote = *(volatile uint32_t *)(P.gcc + GCC_VOTE_0);
+	}
+	/*
+	 * Both branches are BRANCH_HALT_SKIP with hardware clock gating (gcc-waipio.c:1756, :1971): CLK_OFF
+	 * (bit 31) reads 1 while the branch is idle, so it is only a report. The proof is the vote bit
+	 * in GCC 0x62000 (bit 12 NoC, bit 19 TBU; gcc-waipio.c:1761, :1976), set by survey step 5.
+	 */
+	printf("NEGRONI WLAN: GCC AGGRE_NOC_PCIE_0_AXI %#x (CLK_OFF %u), DDRSS_PCIE_SF_TBU %#x (CLK_OFF %u), vote %#x = %#x\n",
+	    noc, (noc & GCC_CLK_OFF) ? 1 : 0, tbu, (tbu & GCC_CLK_OFF) ? 1 : 0, GCC_VOTE_0, vote);
+	if (g_smmu_policy != 0 && P.gcc && (vote & (GCC_VOTE_NOC | GCC_VOTE_TBU)) != (GCC_VOTE_NOC | GCC_VOTE_TBU)) {
+		return negroni_wlan_failed(EPERM, "GCC vote %#x lacks the PCIe NoC (bit 12) or TBU (bit 19) clock: chip DMA would hang",
+		           vote);
+	}
+
+	vm_offset_t smmu = ml_io_map_unmappable(APPS_SMMU_PHYS, PAGE_SIZE, WLAN_WIMG_IO);
+	if (!smmu) {
+		printf("NEGRONI WLAN: apps SMMU map failed; DMA path not checked\n");
+		return 0;
+	}
+	/* single plain ldr/str only: Gunyah emulates this space and injects an SEA on writeback/pair/WZR (0255) */
+#define SRD(o) negroni_mmio_rd32(smmu + (o))
+#define SWR(o, v) negroni_mmio_wr32(smmu + (o), (v))
+	uint32_t scr0 = SRD(SMMU_SCR0), idr0 = SRD(SMMU_IDR0), idr1 = SRD(SMMU_IDR1), gfsr = SRD(SMMU_SGFSR);
+	uint32_t nsmr = MIN(MIN(idr0 & 0xffu, 0x78u), 128u), hit = ~0u, free_smr = ~0u, s2cr = 0;
+	int error = 0;
+
+	printf("NEGRONI WLAN: apps SMMU sCR0 %#x (CLIENTPD %u, USFCFG %u, EXIDS %u), IDR0 %#x (%u SMRs), IDR1 %#x, sGFSR %#x\n",
+	    scr0, scr0 & SMMU_SCR0_CLIENTPD ? 1 : 0, scr0 & SMMU_SCR0_USFCFG ? 1 : 0,
+	    scr0 & SMMU_SCR0_EXIDENABLE ? 1 : 0, idr0, nsmr, idr1, gfsr);
+	if (scr0 == MHI_ALL_ONES || idr0 == MHI_ALL_ONES || nsmr == 0) {
+		printf("NEGRONI WLAN: apps SMMU global space does not answer; DMA path not checked\n");
+		goto out;
+	}
+	if (scr0 & SMMU_SCR0_EXIDENABLE) {
+		/* extended stream IDs: VALID moves to S2CR bit 10 and the SMR holds 16-bit IDs; no scan, no write */
+		printf("NEGRONI WLAN: apps SMMU EXIDS set; SMR format not handled, DMA path not checked\n");
+		goto out;
+	}
+	for (uint32_t i = 0; i < nsmr; i++) {
+		uint32_t smr = SRD(SMMU_SMR(i));
+		uint32_t id = smr & 0x7fffu, mask = (smr >> 16) & 0x7fffu;
+
+		if (!(smr & SMMU_SMR_VALID)) {
+			if (free_smr == ~0u) {
+				free_smr = i;
+			}
+			continue;
+		}
+		if (((id ^ PCIE0_SID) & ~mask & 0x7fffu) == 0 && hit == ~0u) {
+			hit = i;
+		}
+	}
+	if (hit != ~0u) {
+		s2cr = SRD(SMMU_S2CR(hit));
+		uint32_t type = (s2cr >> 16) & 3u;
+		printf("NEGRONI WLAN: stream %#x matches SMR%u %#x, S2CR %#x (%s, context %u)\n", PCIE0_SID, hit,
+		    SRD(SMMU_SMR(hit)), s2cr, type == 0 ? "translate" : type == 1 ? "bypass" : "fault", s2cr & 0xffu);
+		if (type == 2 && g_smmu_policy != 0) {
+			error = negroni_wlan_failed(EPERM, "SMMU stream %#x is set to fault (S2CR%u %#x)", PCIE0_SID, hit, s2cr);
+		} else if (type == 0) {
+			/* a context we did not program: the chip's physical addresses would be translated */
+			printf("NEGRONI WLAN: stream %#x goes through context %u that this kernel did not set up [I]\n",
+			    PCIE0_SID, s2cr & 0xffu);
+			if (g_smmu_policy != 0) {
+				error = negroni_wlan_failed(EPERM, "SMMU stream %#x translates through context %u (not ours)",
+				           PCIE0_SID, s2cr & 0xffu);
+			}
+		}
+		goto out;
+	}
+	if (scr0 & SMMU_SCR0_CLIENTPD) {
+		printf("NEGRONI WLAN: stream %#x has no SMR; the SMMU is in client bypass (CLIENTPD)\n", PCIE0_SID);
+		goto out;
+	}
+	if (!(scr0 & SMMU_SCR0_USFCFG)) {
+		printf("NEGRONI WLAN: stream %#x has no SMR; unmatched streams bypass (USFCFG 0)\n", PCIE0_SID);
+		goto out;
+	}
+	printf("NEGRONI WLAN: stream %#x has no SMR and unmatched streams FAULT (USFCFG 1)\n", PCIE0_SID);
+	if (g_smmu_policy == 2 && free_smr != ~0u) {
+		/* opt-in write: S2CR bypass first, then the SMR (arm-smmu.c order: S2CR before SMR valid) */
+		SWR(SMMU_S2CR(free_smr), 1u << 16);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		SWR(SMMU_SMR(free_smr), SMMU_SMR_VALID | PCIE0_SID);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		uint32_t smr = SRD(SMMU_SMR(free_smr)), s2 = SRD(SMMU_S2CR(free_smr));
+		printf("NEGRONI WLAN: SMR%u = %#x, S2CR%u = %#x (bypass for stream %#x, negroniwlan_smmu=2)\n",
+		    free_smr, smr, free_smr, s2, PCIE0_SID);
+		if (smr != (SMMU_SMR_VALID | PCIE0_SID) || ((s2 >> 16) & 3u) != 1u) {
+			error = negroni_wlan_failed(EPERM, "the SMMU (or the hypervisor) did not take the bypass entry");
+		}
+	} else if (g_smmu_policy != 0) {
+		error = negroni_wlan_failed(EPERM, "SMMU stream %#x would fault; boot with negroniwlan_smmu=2 to add a "
+		           "bypass entry, or =0 to try anyway", PCIE0_SID);
+	}
+out:
+#undef SRD
+#undef SWR
+	ml_io_unmap(smmu, PAGE_SIZE);
+	return error;
+}
