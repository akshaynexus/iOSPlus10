+/*
+ * Boot log (patch 0367, patches/xnu/README-bootlog.md). The console ring of
+ * each boot goes into one slot of a reserved area of the partition, so a
+ * boot that loses the USB link, hangs or resets can be read on the next good
+ * boot. Always on (boot-arg negronilog=0 turns it off); it does not need
+ * ufsrw=1: ufs_log_write_blocks() writes only inside the area.
+ *
+ * Area: NBL_AREA_BLOCKS device blocks right below the WLAN firmware area
+ * (relative to the partition end N: blocks N-28673 .. N-19458; NE2211
+ * userdata N = 58672399). Before any write the HFS+ volume header (byte 1024
+ * of the partition) is read: the volume must end at or below the area.
+ *   area block 0                      superblock (struct nbl_super, "NEGRBLOG")
+ *   area block 1 + i*NBL_SLOT_BLOCKS  slot i: header block (struct nbl_slot,
+ *                                     "NEGRBOOT"), then the 4 MiB console ring
+ *                                     (byte n of the boot at ring offset n % 4 MiB)
+ * The rest of the area (1015 blocks) is reserved. The slot of a boot is the
+ * one after the slot with the highest boot counter. Header fields: boot
+ * counter, state (running / panic / halt / restart), flags (SpringBoard seen,
+ * panic log written), bytes written, flush count, calendar and uptime of
+ * the start, the last flush, SpringBoard and the end, kernel UUID and
+ * version, boot-args, the PMIC PON log summary of this power-on (why the
+ * previous boot ended) and the end text (panic first line / halt / restart).
+ * CRC-32 (IEEE) over the header without the crc field.
+ *
+ * Flushes: every ufslogsecs seconds (default 1) when the console has new
+ * text, else a header heartbeat every NBL_HEARTBEAT_SECS; each with
+ * SYNCHRONIZE CACHE. The panic path (negroni_log_panic) writes once more
+ * without the lock, polled; halt and restart write the end state.
+ * Read back: /dev/negronibootlog (root, read-only: the area as a file) and
+ * the USB command server ("bootlog", "bootlog read A C": negroni_usb.c);
+ * host: op10tool bootlog.
+ */
+#define NBL_AREA_BLOCKS     9216u                       /* 36 MiB */
+#define NBL_FROM_END        (NEGRONI_LOG_BLOCKS + NEGRONI_FW_BLOCKS + NEGRONI_ADSP_AREA_BLOCKS + \
+	                     NEGRONI_WLAN_AREA_BLOCKS + NBL_AREA_BLOCKS)   /* 28673 */
+#define NBL_SLOTS           8u
+#define NBL_SLOT_BLOCKS     NEGRONI_LOG_BLOCKS          /* 1 header + 1024 ring blocks */
+#define NBL_VERSION         1u
+#define NBL_HEARTBEAT_SECS  30u     /* header only, when the console is quiet (review F1: was 5) */
+#define NBL_EARLY_SECS      300u    /* flush every ufslogsecs (1 s) only in the first 5 min of uptime ... */
+#define NBL_LATE_SECS       5u      /* ... then at most every 5 s */
+#define NBL_BUDGET_BYTES    (256u << 10)    /* more than this flushed in NBL_BUDGET_SECS: */
+#define NBL_BUDGET_SECS     10u
+#define NBL_SLOW_SECS       10u     /* flush every 10 s until a quiet window */
+
+enum { NBL_RUNNING = 1, NBL_PANIC = 2, NBL_HALT = 3, NBL_RESTART = 4 };
+#define NBL_F_SPRINGBOARD   0x1u
+#define NBL_F_PANICLOG      0x2u
+
+struct nbl_super {
+	char magic[8];                  /* "NEGRBLOG" */
+	uint32_t version;               /* 1 */
+	uint32_t slots;                 /* 8 */
+	uint32_t slot_blocks;           /* 1025 */
+	uint32_t area_blocks;           /* 9216 */
+	uint32_t ring_size;             /* 4 MiB */
