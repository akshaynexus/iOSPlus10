+	clock_usec_t us;
+	clock_get_calendar_microtime(&s, &us);
+	nbl.hdr.start_cal = nbl.hdr.last_cal = (uint64_t)s;
+	strlcpy(nbl.hdr.uuid, kernel_uuid_string, sizeof(nbl.hdr.uuid));
+	strlcpy(nbl.hdr.kversion, version, sizeof(nbl.hdr.kversion));
+	strlcpy(nbl.hdr.bootargs, PE_boot_args(), sizeof(nbl.hdr.bootargs));
+	nbl.ok = true;
+
+	printf("NEGRONI BOOTLOG: area at block %llu (%u blocks, HFS+ ends at %llu, anchor %s)%s; boot %llu -> slot %u\n",
+	    rel, NBL_AREA_BLOCKS, nbl.hfs_end, wlan ? "NEGRWLAN" : "superblock", fresh ? ", new superblock" : "",
+	    nbl.hdr.boot, nbl.slot);
+	for (uint32_t k = 1; k <= NBL_SLOTS && !fresh; k++) {
+		uint32_t i = (max_slot + NBL_SLOTS + 1 - k) % NBL_SLOTS;  /* newest first */
+		if (!valid[i] || k > 3) {
+			continue;
+		}
+		const struct nbl_slot *h = &prev[i];
+		printf("NEGRONI BOOTLOG: earlier boot %llu (slot %u): %s, last flush %llu s, %llu bytes, SpringBoard %s; %s\n",
+		    h->boot, i, h->state == NBL_RUNNING ? "no end mark (reset, hang or power loss)" : nbl_state_name(h->state),
+		    h->last_up_ms / 1000, h->total,
+		    (h->flags & NBL_F_SPRINGBOARD) ? "yes" : "no", h->end[0] ? h->end : "-");
+	}
