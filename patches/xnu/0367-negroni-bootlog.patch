index 0000000..ca5209b
--- /dev/null
+++ b/bsd/dev/negroni_bootlog_core.h
@@ -0,0 +1,101 @@
+/*
+ * NEGRONI boot log (patch 0367): the pure checks, shared by the kernel
+ * (bsd/dev/negroni_ufs.c, bsd/dev/negroni_usb.c) and the host unit test
+ * (tools/bootlog-core-test, scripts/kernel/test-bootlog-core.sh takes this
+ * file from the patch). No includes: the includer gives uint8_t, uint32_t,
+ * uint64_t, bool and size_t.
+ */
+#ifndef NEGRONI_BOOTLOG_CORE_H
+#define NEGRONI_BOOTLOG_CORE_H
+
+#define NBL_CORE_BLOCK          4096u
+#define NBL_CORE_AREA_BLOCKS    9216u           /* 36 MiB */
+#define NBL_CORE_FROM_END       28673u          /* area start = partition end - 28673 (op10tool, root-simg.sh) */
+#define NBL_CORE_MIN_REL        16u             /* the area start must leave the partition start alone */
+
+/* [lba, lba + count) inside the partition [first, first + nblocks), count 1..max_count, 32-bit LBA. */
+static inline bool
+nbl_core_in_partition(uint64_t first, uint64_t nblocks, uint64_t lba, uint32_t count, uint32_t max_count)
+{
+	return nblocks != 0 && count != 0 && count <= max_count && lba >= first && lba - first < nblocks &&
+	       count <= nblocks - (lba - first) && lba + count - 1 <= 0xffffffffull;
+}
+
+/* [lba, lba + count) inside the open log window [lo, hi); hi == 0 = closed. */
+static inline bool
+nbl_core_in_window(uint64_t lo, uint64_t hi, uint64_t lba, uint32_t count)
+{
+	return hi != 0 && hi > lo && count != 0 && lba >= lo && count <= hi - lo && lba <= hi - count;
+}
+
+/*
+ * HFS+ / HFSX volume end in 4096-byte device blocks from the partition
+ * start. vh = the volume header (partition byte 1024): signature at 0
+ * ("H+" 0x482b / "HX" 0x4858), block size at 40, total blocks at 44, big
+ * endian. 0 = ok, -1 = not an HFS+ header.
+ */
+static inline int
+nbl_core_hfs_end(const uint8_t *vh, uint64_t *end)
+{
+	uint32_t sig = (uint32_t)vh[0] << 8 | vh[1];
+	uint32_t bsize = (uint32_t)vh[40] << 24 | (uint32_t)vh[41] << 16 | (uint32_t)vh[42] << 8 | vh[43];
+	uint32_t nblk = (uint32_t)vh[44] << 24 | (uint32_t)vh[45] << 16 | (uint32_t)vh[46] << 8 | vh[47];
+	if ((sig != 0x482b && sig != 0x4858) || bsize < 512 || (bsize & (bsize - 1)) != 0 || nblk == 0) {
+		return -1;
+	}
+	*end = ((uint64_t)bsize * nblk + NBL_CORE_BLOCK - 1) / NBL_CORE_BLOCK;
+	return 0;
+}
+
+/*
+ * The area start (blocks from the partition start) for a partition of
+ * nblocks and an HFS+ volume of hfs_end blocks. 0 = ok, -1 = partition too
+ * small, -2 = the volume reaches the area.
+ */
+static inline int
+nbl_core_area_rel(uint64_t nblocks, uint64_t hfs_end, uint64_t *rel)
+{
+	if (nblocks < (uint64_t)NBL_CORE_FROM_END + NBL_CORE_MIN_REL) {
+		return -1;
+	}
+	*rel = nblocks - NBL_CORE_FROM_END;
+	return hfs_end > *rel ? -2 : 0;
+}
+
+/* Decimal number at *q (advanced past it); *ok = false if there is no digit or more than 9 digits. */
+static inline uint32_t
+nbl_core_parse_u32(const char **q, bool *ok)
+{
+	uint32_t v = 0;
+	const char *p = *q;
+	unsigned n = 0;
+	if (*p < '0' || *p > '9') {
+		*ok = false;
+	}
+	while (*p >= '0' && *p <= '9') {
+		if (++n > 9) {
+			*ok = false;
+			break;
+		}
+		v = v * 10 + (uint32_t)(*p++ - '0');
+	}
+	*q = p;
+	return v;
+}
+
+/* CRC-32 (IEEE 802.3, the zlib / crc32fast value). */
+static inline uint32_t
+nbl_core_crc32(const void *buf, size_t n)
+{
+	const uint8_t *b = (const uint8_t *)buf;
+	uint32_t c = 0xffffffffu;
+	while (n--) {
+		c ^= *b++;
+		for (int k = 0; k < 8; k++) {
+			c = (c >> 1) ^ (0xedb88320u & (0u - (c & 1u)));
+		}
+	}
+	return ~c;
+}
+
+#endif /* NEGRONI_BOOTLOG_CORE_H */
