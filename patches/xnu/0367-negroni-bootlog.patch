+/*
+ * Checks the area and picks this boot's slot (with negroni_ufs_lock held).
+ * The write gate (ufs_log_lo/hi) opens only after all checks:
+ *  1. HFS+ volume header (partition byte 1024): the volume ends at or below
+ *     the area start (nbl_core_hfs_end / nbl_core_area_rel).
+ *  2. Layout anchor (review F2): the block right after the area (N-19457) is
+ *     the WLAN firmware area header "NEGRWLAN", or the area already holds our
+ *     superblock (written by an earlier boot that passed this check, or by
+ *     AREAS=1 root-simg.sh at N-28673). So N and the area layout are the ones
+ *     the firmware areas were written with.
+ * The caller closes the gate again on any error (review F3).
+ */
+static int
+nbl_setup_locked(void)
+{
+	const uint8_t *b = (const uint8_t *)(su.dma + DMA_BOUNCE);
