+	if ((error = ufs_read_blocks(su.first_block, 1)) != 0) {
+		return error;
+	}
+	if (nbl_core_hfs_end(b + 1024, &nbl.hfs_end) != 0) {
+		printf("NEGRONI BOOTLOG: no HFS+ volume header at the partition start (sig %#x): off\n",
+		    (unsigned)(b[1024] << 8 | b[1025]));
+		return ENOENT;
+	}
+	switch (nbl_core_area_rel(su.nblocks, nbl.hfs_end, &rel)) {
+	case 0:
+		break;
+	case -1:
+		printf("NEGRONI BOOTLOG: partition too small (%llu blocks): off\n", su.nblocks);
+		return ENOSPC;
+	default:
+		printf("NEGRONI BOOTLOG: HFS+ volume ends at block %llu, past the area at block %llu: off\n",
+		    nbl.hfs_end, rel);
+		return EEXIST;
+	}
+	nbl.lo = su.first_block + rel;
+
+	struct nbl_super sb = {
+		.magic = { 'N', 'E', 'G', 'R', 'B', 'L', 'O', 'G' }, .version = NBL_VERSION, .slots = NBL_SLOTS,
+		.slot_blocks = NBL_SLOT_BLOCKS, .area_blocks = NBL_AREA_BLOCKS, .ring_size = NEGRONI_LOG_SIZE,
+		.from_end = NBL_FROM_END,
+	};
+	sb.crc = nbl_crc32(&sb, offsetof(struct nbl_super, crc));
+	if ((error = ufs_read_blocks(nbl.lo, 1)) != 0) {
+		return error;
+	}
+	bool fresh = memcmp(b, &sb, sizeof(sb)) != 0;
+	if ((error = ufs_read_blocks(nbl.lo + NBL_AREA_BLOCKS, 1)) != 0) {
+		return error;
+	}
+	bool wlan = memcmp(b, "NEGRWLAN", 8) == 0;
+	if (fresh && !wlan) {
+		printf("NEGRONI BOOTLOG: no WLAN area header (NEGRWLAN) at block %llu and no boot log superblock at %llu: "
+		    "layout not proven, off (write the firmware areas: AREAS=1 root-simg.sh)\n",
+		    rel + NBL_AREA_BLOCKS, rel);
+		return ENOENT;
+	}
+
+	/* every check passed: open the write gate for the area only */
+	ufs_log_lo = nbl.lo;
+	ufs_log_hi = nbl.lo + NBL_AREA_BLOCKS;
+
+	if (fresh) {
+		/* new superblock, and all 8 slot headers zeroed (no stale header from an older layout) */
+		bzero((void *)(su.dma + DMA_BOUNCE), UFS_BLOCK);
+		for (uint32_t i = 0; i < NBL_SLOTS && !error; i++) {
+			error = ufs_log_write_blocks(nbl_slot_base(i), 1);
+		}
+		if (!error) {
+			memcpy((void *)(su.dma + DMA_BOUNCE), &sb, sizeof(sb));
+			error = ufs_log_write_blocks(nbl.lo, 1);
+		}
+		if (error) {
+			return error;
+		}
+	}
+
+	/* slot headers; the next slot after the highest boot counter */
+	uint64_t max_boot = 0;
+	uint32_t max_slot = NBL_SLOTS - 1;
+	for (uint32_t i = 0; i < NBL_SLOTS && !fresh; i++) {
+		if ((error = ufs_read_blocks(nbl_slot_base(i), 1)) != 0) {
+			return error;
+		}
+		memcpy(&prev[i], b, sizeof(prev[i]));
+		valid[i] = nbl_slot_valid(&prev[i]);
+		/* review F7: the strings come from the disk; terminate them before any printf */
+		prev[i].uuid[sizeof(prev[i].uuid) - 1] = 0;
+		prev[i].kversion[sizeof(prev[i].kversion) - 1] = 0;
+		prev[i].bootargs[sizeof(prev[i].bootargs) - 1] = 0;
+		prev[i].pon[sizeof(prev[i].pon) - 1] = 0;
+		prev[i].end[sizeof(prev[i].end) - 1] = 0;
+		if (valid[i] && prev[i].boot > max_boot) {
+			max_boot = prev[i].boot;
+			max_slot = i;
+		}
+	}
+	nbl.slot = (max_slot + 1) % NBL_SLOTS;
+
+	bzero(&nbl.hdr, sizeof(nbl.hdr));
+	memcpy(nbl.hdr.magic, "NEGRBOOT", 8);
+	nbl.hdr.version = NBL_VERSION;
+	nbl.hdr.hdr_size = sizeof(nbl.hdr);
+	nbl.hdr.boot = max_boot + 1;
+	nbl.hdr.state = NBL_RUNNING;
+	nbl.hdr.ring_size = NEGRONI_LOG_SIZE;
+	nbl.hdr.flush_secs = negroni_log_secs;
