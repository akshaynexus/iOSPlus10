+/*
+ * 0367: boot log commands (negroni_ufs.c, README-bootlog.md).
+ *   bootlog          one text line: area, slots, this boot (negroni_bootlog_info)
+ *   bootlog read A C area blocks A .. A+C-1 (C 1..4): 4 datagrams per block,
+ *                    each a 16-byte header "NBLD" | u32 block | u32 byte offset
+ *                    in the block | u32 length (little endian) and 1024 data bytes
+ * The read runs here in ud_thread (UFS lock, one READ command); datagrams the
+ * TX queue drops are asked for again by the host (op10tool bootlog).
+ */
+#define UD_BOOTLOG_CHUNK 1024u
+
+#include "negroni_bootlog_core.h"            /* nbl_core_parse_u32 (host-tested: tools/bootlog-core-test) */
+
+static void
+ud_ctl_bootlog(const uint8_t *f, const char *cmd)
+{
+	static uint8_t blocks[4 * 4096];
+	static uint8_t dgram[16 + UD_BOOTLOG_CHUNK];
+	char reply[256];
+
+	if (cmd[7] == 0) {
+		negroni_bootlog_info(reply, sizeof(reply));
+		ud_ctl_reply(f, reply);
+		return;
+	}
+	const char *q = cmd + 13;
+	bool ok = true;
+	uint32_t blk = nbl_core_parse_u32(&q, &ok);
+	if (*q == ' ') {
+		q++;
+	} else {
+		ok = false;
+	}
+	uint32_t count = nbl_core_parse_u32(&q, &ok);
+	if (!ok || *q != 0 || count == 0 || count > 4) {
+		ud_ctl_reply(f, "error: bootlog read <area block> <count 1..4>");
+		return;
+	}
+	int error = negroni_bootlog_read(blk, count, blocks);
+	if (error) {
+		snprintf(reply, sizeof(reply), "error: bootlog read %u %u: %d", blk, count, error);
+		ud_ctl_reply(f, reply);
+		return;
+	}
+	const uint8_t *rip = f + ETHER_HDR_LEN;
+	const uint8_t *rudp = rip + (rip[0] & 0xfu) * 4;
+	for (uint32_t i = 0; i < count; i++) {
+		for (uint32_t off = 0; off < 4096; off += UD_BOOTLOG_CHUNK) {
+			uint32_t b = blk + i, n = UD_BOOTLOG_CHUNK;
+			memcpy(dgram, "NBLD", 4);
+			memcpy(dgram + 4, &b, 4);
+			memcpy(dgram + 8, &off, 4);
+			memcpy(dgram + 12, &n, 4);
+			memcpy(dgram + 16, blocks + i * 4096 + off, n);
+			(void)ud_udp_send(f + ETHER_ADDR_LEN, rip + 12, UD_CTL_PORT, ud_be16(rudp), dgram, 16 + n);
+		}
+	}
+}
