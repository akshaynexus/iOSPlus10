+/*
+ * Audio DSP firmware area (bsd/dev/negroni_adsp.c, scripts/audio/mkadsparea.py in iOSPlus10):
+ * NEGRONI_ADSP_AREA_SIZE right before the GPU firmware area, written with dd like it. The ADSP
+ * image (adsp.mdt + 25 segments, 18 MiB) does not fit the 8 MiB / 16-entry GPU area.
+ * Read-only: copies `count` bytes at byte `at` of the area to `dst` (kernel memory).
+ */
+#define NEGRONI_ADSP_AREA_SIZE    (32u << 20)
+#define NEGRONI_ADSP_AREA_BLOCKS  (NEGRONI_ADSP_AREA_SIZE / UFS_BLOCK)
+
+int negroni_ufs_adsp_area_read(uint64_t at, void *dst, uint32_t count);
+
+int
+negroni_ufs_adsp_area_read(uint64_t at, void *dst, uint32_t count)
+{
+	const uint8_t *bounce = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint8_t *to = (uint8_t *)dst;
+
+	if (!su.ready || su.nblocks < 4 * (NEGRONI_LOG_BLOCKS + NEGRONI_FW_BLOCKS + NEGRONI_ADSP_AREA_BLOCKS) ||
+	    at > NEGRONI_ADSP_AREA_SIZE || count > NEGRONI_ADSP_AREA_SIZE - at) {
+		return EINVAL;
+	}
+	uint64_t base = su.first_block + su.nblocks - NEGRONI_LOG_BLOCKS - NEGRONI_FW_BLOCKS - NEGRONI_ADSP_AREA_BLOCKS;
+	while (count > 0) {
+		uint32_t skip = (uint32_t)(at % UFS_BLOCK);
+		uint32_t n = MIN(count, BOUNCE_SIZE - skip);
+		uint32_t nblk = (skip + n + UFS_BLOCK - 1) / UFS_BLOCK;
+		int error;
+
+		lck_mtx_lock(&negroni_ufs_lock);
+		error = ufs_read_blocks(base + at / UFS_BLOCK, nblk);
+		if (!error) {
+			memcpy(to, bounce + skip, n);
+		}
+		lck_mtx_unlock(&negroni_ufs_lock);
+		if (error) {
+			return error;
+		}
+		to += n;
+		at += n;
+		count -= n;
+	}
+	return 0;
+}
