+/*
+ * ARC (rpmhpd) resource: address and the level index (hlvl) of the first cmd-db
+ * level >= `level` (Linux rpmhpd_update_level_mapping / rpmhpd_aggregate_corner).
+ */
+static int
+rh_lookup_arc(const char *res, unsigned level, uint32_t *address, unsigned *hlvl)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave != RH_ARC || (entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			continue;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16);
+			uint32_t data = aux + rh_db16(e + 22), len = rh_db16(e + 20);
+			if ((addr >> 16) != RH_ARC || (addr & 15u) || len < 2 || len > 32 || !rh_range(data, len)) {
+				printf("NEGRONI RPMH: invalid ARC entry for %s\n", res);
+				return EINVAL;
+			}
+			for (unsigned l = 0; l < len / 2; ++l) {
+				unsigned v = rh_db16(data + 2 * l);
+				printf("NEGRONI RPMH: %s addr=%#x hlvl %u = vlvl %u\n", res, addr, l, v);
+				if (v >= level) {
+					*address = addr;
+					*hlvl = l;
+					return 0;
+				}
+				if (l > 0 && v == 0) {
+					break;
+				}
+			}
+			printf("NEGRONI RPMH: %s has no level >= %u\n", res, level);
+			return ERANGE;
+		}
+	}
+	printf("NEGRONI RPMH: no ARC resource %s\n", res);
+	return ENODEV;
+}
+
+/*
+ * Level vote on an LPASS rail for the audio DSP start (negroni_adsp.c; Linux
+ * qcom_q6v5_pas proxy votes on the lcx/lmx power domains). level 0 drops the vote.
+ */
+int
+negroni_rpmh_arc_vote(const char *res, unsigned level)
+{
+	if (!res || (strcmp(res, "lcx.lvl") && strcmp(res, "lmx.lvl")) || level > 416) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	unsigned hlvl = 0;
+	if (rh_poisoned) {
+		printf("NEGRONI RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_arc(res, level, &address, &hlvl);
+	}
+	if (!error) {
+		printf("NEGRONI RPMH: ARC %s level %u -> hlvl %u\n", res, level, hlvl);
+		error = rh_send(address, hlvl, RH_MODE_ARC);
+	}
+out:
+	if (error) {
+		printf("NEGRONI RPMH: ARC vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
