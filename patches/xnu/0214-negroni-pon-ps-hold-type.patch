+
+/*
+ * PON_PBS: type 0x01 (PON) and GEN3 PBS subtype 0x08 required (the DT's
+ * qcom,system-reset device). Gives the PS_HOLD_RST_CTL/CTL2 offsets of the
+ * generation. 0 = usable, -1 = not (logged once).
+ */
+static int
+nr_pon_check(uint32_t *ctl, uint32_t *ctl2)
+{
+	uint8_t type = 0, subtype = 0;
+
+	if (!nr_open(&nr_pon)) {
+		return -1;
+	}
+	if (nr_pon_subtype == 0) {
+		if (nr_read(&nr_pon, NR_PON_TYPE, &type) || nr_read(&nr_pon, NR_PON_SUBTYPE, &subtype) ||
+		    type != NR_PON_TYPE_PON || subtype != NR_PON_SUBTYPE_GEN3_PBS) {
+			printf("NEGRONI REBOOT: PON_PBS type %#04x subtype %#04x, not PON GEN3 PBS: no PS_HOLD config\n",
+			    type, subtype);
+			return -1;
+		}
+		nr_pon_subtype = subtype;
+	}
+	bool gen3 = nr_pon_subtype == NR_PON_SUBTYPE_GEN3_PBS || nr_pon_subtype == NR_PON_SUBTYPE_GEN3_HLOS;
+	*ctl = gen3 ? NR_PON3_PS_HOLD_RST_CTL : NR_PON_PS_HOLD_RST_CTL;
+	*ctl2 = gen3 ? NR_PON3_PS_HOLD_RST_CTL2 : NR_PON_PS_HOLD_RST_CTL2;
+	return 0;
 }
 
+static const char *
+nr_pon_type_name(uint8_t type)
+{
+	switch (type & NR_PON_TYPE_MASK) {
+	case NR_PON_TYPE_WARM_RESET:        return "WARM_RESET";
+	case NR_PON_TYPE_SHUTDOWN:          return "SHUTDOWN";
+	case NR_PON_TYPE_DVDD_SHUTDOWN:     return "DVDD_SHUTDOWN";
+	case NR_PON_TYPE_HARD_RESET:        return "HARD_RESET";
+	case NR_PON_TYPE_DVDD_HARD_RESET:   return "DVDD_HARD_RESET";
+	default:                            return "unknown";
+	}
+}
+
+/* The PS_HOLD reset type (bits 3:0 of PS_HOLD_RST_CTL). 0 = read, -1 = not. */
+static int
+nr_pon_type_get(uint8_t *type)
+{
+	uint32_t ctl, ctl2;
+	uint8_t v = 0;
+
+	if (nr_pon_check(&ctl, &ctl2) != 0 || nr_read(&nr_pon, ctl, &v) != 0) {
+		return -1;
+	}
+	*type = v & NR_PON_TYPE_MASK;
+	return 0;
+}
+
+/* Boot-time status line: the PS_HOLD reset type the bootloader left. */
+static void
+nr_pon_status(void)
+{
+	uint32_t ctl, ctl2;
+	uint8_t v = 0, en = 0;
+
+	if (nr_pon_check(&ctl, &ctl2) != 0) {
+		return;
+	}
+	if (nr_read(&nr_pon, ctl, &v) || nr_read(&nr_pon, ctl2, &en)) {
+		printf("NEGRONI REBOOT: PON_PBS PS_HOLD_RST_CTL read failed\n");
+		return;
+	}
+	printf("NEGRONI REBOOT: PON_PBS subtype %#04x: PS_HOLD_RST_CTL +%#x = %#04x (%s), CTL2 +%#x = %#04x (%s)\n",
+	    nr_pon_subtype, ctl, v, nr_pon_type_name(v), ctl2, en, (en & NR_PON_RESET_EN) ? "enabled" : "disabled");
+}
+
+/*
+ * PS_HOLD reset type = type, like qpnp_pon_reset_config(): disable, 500 us
+ * (10 sleep clock cycles), type, enable. 0 = set, -1 = not set (logged).
+ */
+static int
+nr_pon_set_type(uint8_t type)
+{
+	uint32_t ctl, ctl2;
+
+	if (nr_pon_check(&ctl, &ctl2) != 0) {
+		return -1;
+	}
+	if (nr_update(&nr_pon, ctl2, NR_PON_RESET_EN, 0) != 0) {
+		return -1;
+	}
+	delay(500);
+	int rc = nr_update(&nr_pon, ctl, NR_PON_TYPE_MASK, type);
+	/* Enable again also after a failed type write: the reset must still work. */
+	if (nr_update(&nr_pon, ctl2, NR_PON_RESET_EN, NR_PON_RESET_EN) != 0 || rc != 0) {
+		return -1;
+	}
+	printf("NEGRONI REBOOT: PS_HOLD reset type = %s\n", nr_pon_type_name(type));
+	return 0;
+}
+
+static const char *
+nr_pon_log_event_name(uint8_t event)
+{
+	switch (event) {
+	case 0x01: return "PON_TRIGGER";
+	case 0x02: return "OTP_COPY_COMPLETE";
+	case 0x03: return "TRIM_COMPLETE";
+	case 0x04: return "XVLO_CHECK_COMPLETE";
+	case 0x05: return "PMIC_CHECK_COMPLETE";
+	case 0x06: return "RESET_TRIGGER";
+	case 0x07: return "RESET_TYPE";
+	case 0x08: return "WARM_RESET_COUNT";
+	case 0x09: return "FAULT_REASON_1_2";
+	case 0x0a: return "FAULT_REASON_3";
+	case 0x0b: return "PBS_PC_DURING_FAULT";
+	case 0x0c: return "FUNDAMENTAL_RESET";
+	case 0x0d: return "PON_SEQ_START";
+	case 0x0e: return "PON_SUCCESS";
+	case 0x0f: return "WAITING_ON_PSHOLD";
+	case 0x20: return "VREG_READY_CHECK";
+	default:   return event >= 0x10 && event <= 0x1c ? "PMIC_SIDn_FAULT" : "event";
+	}
+}
+
+/* Trigger codes of pmic-pon-log.c (PON triggers and reset triggers share the small codes). */
+static const char *
+nr_pon_log_trigger_name(uint8_t event, uint16_t code)
+{
+	if (event == 0x01) {
+		switch (code) {
+		case 0x0084: return "PS_HOLD";
+		case 0x0085: return "HARD_RESET";
+		case 0x0086: return "RESIN_N";
+		case 0x0087: return "KPDPWR_N";
+		case 0x0621: return "RTC_ALARM";
+		case 0x0640: return "SMPL";
+		case 0x31c2: return "USB_CHARGER";
+		case 0x8732: return "USB_CHARGER";
+		default:     return NULL;
+		}
+	}
+	switch (code) {
+	case 0x0080: return "KPDPWR_N_S2";
+	case 0x0081: return "RESIN_N_S2";
+	case 0x0082: return "KPDPWR_N_AND_RESIN_N_S2";
+	case 0x0083: return "PMIC_WATCHDOG_S2";
+	case 0x0084: return "PS_HOLD";
+	case 0x0085: return "SW_RESET";
+	case 0x0086: return "RESIN_N_DEBOUNCE";
+	case 0x0087: return "KPDPWR_N_DEBOUNCE";
+	default:     return NULL;
+	}
+}
+
+/*
+ * The PMIC PON log (SDAM 0x7400, downstream pmic-pon-log.c), oldest entry
+ * first. Only the first SDAM of the FIFO is decoded (the NE2211 DT lists
+ * one). Read only (observer channel); nothing is written.
+ */
+static void
+nr_pon_log_dump(void)
+{
+	static const char *const states[8] = {
+		"FAULT", "PON", "POFF", "ON", "RESET", "OFF", "FAULT", "WARM_RESET"
+	};
+	uint8_t count = 0, ptr = 0, sdam = 0;
+	uint8_t fifo[NR_PONLOG_FIFO_SIZE];
+
+	if (!nr_open(&nr_ponlog)) {
+		return;
+	}
+	if (nr_read(&nr_ponlog, NR_PONLOG_SDAM_COUNT, &count) || nr_read(&nr_ponlog, NR_PONLOG_PUSH_PTR, &ptr) ||
+	    nr_read(&nr_ponlog, NR_PONLOG_PUSH_SDAM, &sdam)) {
+		printf("NEGRONI PON LOG: SDAM 0x7400 header read failed\n");
+		return;
+	}
+	printf("NEGRONI PON LOG: SDAM 0x7400: %u SDAM(s), push pointer +%#x in SDAM %u\n", count, ptr, sdam);
+	if (ptr < NR_PONLOG_FIFO_START || ptr > NR_PONLOG_FIFO_END || sdam != 0) {
+		printf("NEGRONI PON LOG: not decoded (pointer outside the FIFO, or in another SDAM)\n");
+		return;
+	}
+	for (unsigned i = 0; i < NR_PONLOG_FIFO_SIZE; i++) {
+		if (nr_read(&nr_ponlog, NR_PONLOG_FIFO_START + i, &fifo[i])) {
+			printf("NEGRONI PON LOG: FIFO read failed at +%#x\n", NR_PONLOG_FIFO_START + i);
+			return;
+		}
+	}
+	const unsigned entries = NR_PONLOG_FIFO_SIZE / 4;
+	int start = (int)(ptr - NR_PONLOG_FIFO_START) - (int)(entries * 4);
+	if (start < 0) {
+		start += NR_PONLOG_FIFO_SIZE;
+	}
+	for (unsigned i = 0; i < entries; i++) {
+		unsigned idx = ((unsigned)start + i * 4) % NR_PONLOG_FIFO_SIZE;
+		uint8_t state = fifo[idx], event = fifo[(idx + 1) % NR_PONLOG_FIFO_SIZE];
+		uint8_t data1 = fifo[(idx + 2) % NR_PONLOG_FIFO_SIZE], data0 = fifo[(idx + 3) % NR_PONLOG_FIFO_SIZE];
+		if (state == 0 && event == 0 && data1 == 0 && data0 == 0) {
+			continue;
+		}
+		uint16_t data = (uint16_t)((data1 << 8) | data0);
+		const char *extra = NULL;
+		if (event == 0x01 || event == 0x06) {
+			extra = nr_pon_log_trigger_name(event, data);
+		} else if (event == 0x07) {
+			extra = nr_pon_type_name(data0);
+		}
+		printf("NEGRONI PON LOG: %-10s %-20s data %#06x%s%s\n", states[state & 7],
+		    nr_pon_log_event_name(event), data, extra ? " " : "", extra ? extra : "");
+	}
+}
