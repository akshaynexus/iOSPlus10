+/*
+ * ---- patch 0287: GPU hang detection and recovery ----
+ *
+ * Before 0287 a lost WPTR write, a full ring or 2 s without a fence set gGPUStopped (NegroniGPU.cpp)
+ * for the rest of the boot: every fence then read done, and the display went on with CPU copies.
+ * Reference: the OnePlus KGSL (out/src/op-kernel/drivers/gpu/msm). The A730 is gen7_0_0 with the
+ * non-hwsched dispatcher (adreno-gpulist.h:2045-2073, .gpudev = adreno_gen7_gmu_gpudev); its reset is
+ * gen7_gmu_reset (adreno_gen7.c:1507-1517, adreno_gen7_gmu.c:3127-3146):
+ *   detect   adreno_dispatch.c: drawobj timeout 2000 ms (:50, _adreno_dispatch_check_timeout :2315-2344),
+ *            fault interrupts (adreno_gen7.c:1123-1156: MISHANGDETECT 23, CP_HW_ERROR 9, GPC_ERR 7, UCHE OOB 24),
+ *            GMU AO interrupts (adreno_gen7_gmu.c:1693-1725: watchdog bite bit 0), SMMU page faults;
+ *   log      dispatcher_do_fault (adreno_dispatch.c:1964-2148): RBBM_STATUS/STATUS3, CP_RB_BASE, CP_IB1_BASE,
+ *            snapshot (GMU log);
+ *   reset    gen7_gmu_reset: GPU/GMU interrupts off, HFI stop, gen7_gmu_suspend -> gen7_gmu_pwrctrl_suspend
+ *            (adreno_gen7_gmu.c:1354-1410): AHB fence ALLOW, CM3_SYSRESET 1, GBIF GX halt (if GX on), GBIF CX
+ *            halt, RBBM_SW_RESET_CMD 1 (if GX on), 100 us, GX GDSC off from the CPU; clocks and CX off;
+ *            then gen7_boot (warm boot, the 0285 wake path here);
+ *   fences   the hung ring's timestamps are written as retired (adreno_dispatch.c:2109-2121), the waiters
+ *            see them; Turnip sees MSM_PARAM_FAULTS change (device lost);
+ *   bound    _fault_throttle 3 per 3000 ms per context (adreno_dispatch.c:34-35); here REC_MAX per 60 s for
+ *            the whole GPU, then the GPU stays stopped as before 0287.
+ * Differences: no IRQ (the watch thread polls once a second); CX and the GMU clocks stay on (the RSC sleep
+ * sequence of 0285 instead of CX off); the GX GDSC is collapsed from the CPU only with negronigpu_recover=2.
+ * Boot-args: negronigpu_recover (default 1; 0 = the old stop for good), negronigpu_recover_max (default 3,
+ * 1..16, per 60 s), negronigpu_recover_watch (default 1: the watch thread detects too).
+ */
+#define REC_WINDOW_MS           60000
+#define REC_STALL_MS            2000            /* = RedwoodGPU's GPU_HUNG_MS and KGSL's adreno_drawobj_timeout */
+#define REC_HISTORY             16
+#define REG_RBBM_STATUS3        0x0213
+#define REG_RBBM_SW_RESET_CMD   0x0043
+#define REG_RBBM_GBIF_HALT_ACK  0x0017
+#define REG_GBIF_HALT_ACK       0x3c46
+#define REG_CP_PROTECT_STATUS   0x0824
+#define REG_CP_IB1_BASE         0x0928
+#define REG_CP_IB1_REM_SIZE     0x092a
+#define REG_CP_IB2_BASE         0x092b
+#define REG_CP_IB2_REM_SIZE     0x092d
+#define GMU_AO_HOST_INTERRUPT_CLR    0x23b04
+#define GMU_AO_HOST_INTERRUPT_STATUS 0x23b05
+#define GMU_AHB_FENCE_STATUS_CLR     0x23b14
+#define GMU_AO_INT_WDOG_BITE    (1u << 0)
+
+extern void NegroniGPUWatchFault(const char *why, uint32_t completed);  /* NegroniGPU.cpp (0287) */
+uint32_t negroni_gpu_recoveries(void);
+bool negroni_gpu_fence_failed(uint32_t fence);
+uint32_t negroni_gpu_recovery_lo(uint32_t n);
+bool negroni_gpu_recover(const char *why);
+
+static uint32_t rec_arg = 1, rec_max = 3, rec_watch = 1;
+static bool rec_args_read;
+static uint32_t rec_count, rec_tries;
+static uint64_t rec_times[REC_HISTORY];
+static uint32_t rec_lo[REC_HISTORY], rec_hi[REC_HISTORY];
+
+static void
+rec_args(void)
+{
+	if (rec_args_read) {
+		return;
+	}
+	rec_args_read = true;
+	(void)PE_parse_boot_argn("negronigpu_recover", &rec_arg, sizeof(rec_arg));
+	(void)PE_parse_boot_argn("negronigpu_recover_max", &rec_max, sizeof(rec_max));
+	(void)PE_parse_boot_argn("negronigpu_recover_watch", &rec_watch, sizeof(rec_watch));
+	rec_max = rec_max < 1 ? 1 : rec_max > REC_HISTORY ? REC_HISTORY : rec_max;
+}
+
+/* How many recoveries passed (each one fails a range of fences). */
+uint32_t
+negroni_gpu_recoveries(void)
+{
+	return rec_count;
+}
+
+/* A fence a recovery cut off (it reads done, but its work did not run to its end). */
+bool
+negroni_gpu_fence_failed(uint32_t fence)
+{
+	for (uint32_t i = rec_count > REC_HISTORY ? rec_count - REC_HISTORY : 0; fence != 0 && i < rec_count; i++) {
+		uint32_t lo = rec_lo[i % REC_HISTORY], hi = rec_hi[i % REC_HISTORY];
+		if ((int32_t)(fence - lo) >= 0 && (int32_t)(hi - fence) >= 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* The first fence recovery n failed (0: n is too old to know; the caller counts it as a fault). */
+uint32_t
+negroni_gpu_recovery_lo(uint32_t n)
+{
+	return n < rec_count && rec_count - n <= REC_HISTORY ? rec_lo[n % REC_HISTORY] : 0;
+}
+
+/* The lock held: what the GPU says at the fault (dispatcher_do_fault's header; no snapshot) */
+static void
+rec_report(uint32_t n, const char *why)
+{
+	volatile uint32_t *scratch = (volatile uint32_t *)core_scratch.memory;
+	uint32_t ccb = smmu_cb(&core_space), gcb = smmu_cb(&gmu_space);
+	bool asleep = pm_mode == PM_SLUMBER && pm_asleep;
+
+	to_memory(core_scratch.memory, 4096);
+	printf("NEGRONI GPU RECOVERY: %u: %s: fence %u (bv %u) of %u, wptr %u, pm %s, GX GDSC %#x, power state %#x, GMU AO_INT %#x "
+	    "FW_INIT_RESULT %#x\n", n, why, scratch[GPU_FENCE_AT / 4], scratch[GPU_BV_FENCE_AT / 4], gpu_fence, ring_at, pm_name(),
+	    rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)),
+	    asleep ? 0 : rd(gmu + GMU_REG(GMU_AO_HOST_INTERRUPT_STATUS)), rd(gmu + GMU_REG(GMU_CM3_FW_INIT_RESULT)));
+	bool held = !asleep && pm_gx_on() && gx_hold();
+	if (held) {
+		printf("NEGRONI GPU RECOVERY: %u: RBBM_STATUS %#x STATUS3 %#x INT_0 %#x | CP rptr %u HW_FAULT %#x INT %#x PROTECT %#x | "
+		    "IB1 %#x:%08x rem %u | IB2 %#x:%08x rem %u | scratch2 %u\n", n,
+		    rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS)), rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS3)),
+		    rd(gpu_regs + GPU_WORD(REG_RBBM_INT_0_STATUS)), rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_HW_FAULT)), rd(gpu_regs + GPU_WORD(REG_CP_INTERRUPT_STATUS)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_PROTECT_STATUS)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_IB1_BASE + 1)), rd(gpu_regs + GPU_WORD(REG_CP_IB1_BASE)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_IB1_REM_SIZE)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_IB2_BASE + 1)), rd(gpu_regs + GPU_WORD(REG_CP_IB2_BASE)),
+		    rd(gpu_regs + GPU_WORD(REG_CP_IB2_REM_SIZE)), rd(gpu_regs + GPU_WORD(REG_CP_SCRATCH_REG2)));
+		gx_release();
+	} else {
+		printf("NEGRONI GPU RECOVERY: %u: GX registers not read (GX off, asleep, or the GMU did not hold it)\n", n);
+	}
+	/* the 0233 SMMU fault registers of both contexts, read whether or not a fault bit is set */
+	printf("NEGRONI GPU RECOVERY: %u: SMMU SGFSR %#x | core FSR %#x FAR %#x:%#x FSYNR0 %#x | gmu FSR %#x FAR %#x:%#x\n", n,
+	    rd(smmu + SMMU_SGFSR), rd(smmu + ccb + SMMU_CB_FSR), rd(smmu + ccb + SMMU_CB_FAR + 4), rd(smmu + ccb + SMMU_CB_FAR),
+	    rd(smmu + ccb + SMMU_CB_FSYNR0), rd(smmu + gcb + SMMU_CB_FSR), rd(smmu + gcb + SMMU_CB_FAR + 4), rd(smmu + gcb + SMMU_CB_FAR));
+	to_memory(gmu_log.memory, 64);
+	const volatile uint32_t *l = (const volatile uint32_t *)gmu_log.memory;
+	printf("NEGRONI GPU RECOVERY: %u: GMU log head %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
+	    n, l[0], l[1], l[2], l[3], l[4], l[5], l[6], l[7], l[8], l[9], l[10], l[11], l[12], l[13], l[14], l[15]);
+}
+
+/*
+ * The lock held: gen7_gmu_pwrctrl_suspend without clocks/CX off, then the 0285 RSC sleep (the warm boot
+ * expects the CM3 in reset and the RSC asleep). The GX registers are touched only while the GX GDSC is
+ * on; with the CM3 in reset nothing collapses GX any more, so that check stays true.
+ */
+static void
+rec_reset(uint32_t n, bool collapse)
+{
+	uint64_t t0 = mach_absolute_time();
+
+	wr(gmu + GMU_REG(GMU_INTR_MASK), ~0u);
+	wr(gmu + GMU_REG(GMU_AO_HOST_INTERRUPT_CLR), ~0u);
+	wr(gmu + GMU_REG(GMU_AHB_FENCE_STATUS_CLR), 7);
+	wr(gmu + GMU_REG(GMU_AO_AHB_FENCE_CTRL), 0);
+	__asm__ volatile ("dsb sy");
+	wr(gmu + GMU_REG(GMU_CM3_SYSRESET), 1);
+	__asm__ volatile ("dsb sy");
+	bool gx = pm_gx_on(), gx_halt = false, cx_halt, off;
+	if (gx) {
+		wr(gpu_regs + GPU_WORD(REG_RBBM_GBIF_HALT), 1);
+		gx_halt = wait_for(gpu_regs + GPU_WORD(REG_RBBM_GBIF_HALT_ACK), 1, 1, 100);
+	}
+	wr(gpu_regs + GPU_WORD(REG_GBIF_HALT), 2);
+	cx_halt = wait_for(gpu_regs + GPU_WORD(REG_GBIF_HALT_ACK), 2, 2, 100);
+	if (gx) {
+		wr(gpu_regs + GPU_WORD(REG_RBBM_SW_RESET_CMD), 1);
+		(void)rd(gpu_regs + GPU_WORD(REG_RBBM_SW_RESET_CMD));
+		delay(100);
+		wr(gpu_regs + GPU_WORD(REG_RBBM_SW_RESET_CMD), 0);
+	}
+	if (collapse && pm_gx_on()) {
+		/* negronigpu_recover=2: KGSL's regulator_enable + regulator_disable of the GX GDSC = SW_COLLAPSE from the CPU */
+		wr(gpucc + GPUCC_GX_GDSCR, rd(gpucc + GPUCC_GX_GDSCR) | GDSC_SW_COLLAPSE);
+		(void)wait_for(gpucc + GPUCC_GX_GDSCR, GDSC_PWR_ON, 0, 100);
+	}
+	off = !pm_gx_on();
+	/* the halts end before the GMU boots through the same bus (step 20 writes both 0 again) */
+	if (!off) {
+		wr(gpu_regs + GPU_WORD(REG_RBBM_GBIF_HALT), 0);
+	}
+	wr(gpu_regs + GPU_WORD(REG_GBIF_HALT), 0);
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 1);
+	bool rsc = wait_for(rscc + RSCC_STATUS0, 1u << 16, 1u << 16, 100);
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 0);
+	/* FSR is write-1-to-clear; the contexts terminate faulting accesses (SCTLR CFCFG 0): nothing to resume */
+	uint32_t ccb = smmu_cb(&core_space), gcb = smmu_cb(&gmu_space);
+	wr(smmu + ccb + SMMU_CB_FSR, rd(smmu + ccb + SMMU_CB_FSR));
+	wr(smmu + gcb + SMMU_CB_FSR, rd(smmu + gcb + SMMU_CB_FSR));
+	gx_on = false;
+	printf("NEGRONI GPU RECOVERY: %u: reset in %u us: CM3 in reset, GX GBIF halt %s, CX GBIF halt %s, RBBM SW reset %s, GX %s "
+	    "(GDSC %#x%s), RSC %s (%#x)\n", n, pm_us_since(t0), !gx ? "skipped (GX off)" : gx_halt ? "acked" : "NOT ACKED",
+	    cx_halt ? "acked" : "NOT ACKED", gx ? "done" : "skipped", off ? "off" : "on", rd(gpucc + GPUCC_GX_GDSCR),
+	    collapse ? ", collapsed by the CPU" : "", rsc ? "asleep" : "DID NOT SLEEP", rd(rscc + RSCC_STATUS0));
+}
+
+/*
+ * Called with RedwoodGPU's gGPULock held (no submission runs meanwhile), not with gpu_pm_lock.
+ * true: the GPU runs again, every fence up to negroni_gpu_last() reads done, the cut-off ones are
+ * failed (negroni_gpu_fence_failed). false: the GPU stays stopped (the caller sets gGPUStopped).
+ */
+bool
+negroni_gpu_recover(const char *why)
+{
+	rec_args();
+	lck_mtx_lock(&gpu_pm_lock);
+	uint32_t n = ++rec_tries;
+	uint64_t now = mach_absolute_time();
+	uint32_t recent = 0;
+
+	rec_report(n, why);
+	for (uint32_t i = rec_count > REC_HISTORY ? rec_count - REC_HISTORY : 0; i < rec_count; i++) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(now - rec_times[i % REC_HISTORY], &ns);
+		recent += ns < (uint64_t)REC_WINDOW_MS * NSEC_PER_MSEC;
+	}
+	const char *no = !gpu_kept ? "the GPU is not kept" : pm_dead ? "the GPU is off for good (a wake failed)" :
+	    rec_arg == 0 ? "negronigpu_recover=0" : recent >= rec_max ? "too many recoveries in 60 s" : NULL;
+	if (no != NULL) {
+		printf("NEGRONI GPU RECOVERY: %u: no recovery (%s; %u in the last 60 s, max %u): the GPU stays stopped for this boot\n",
+		    n, no, recent, rec_max);
+		lck_mtx_unlock(&gpu_pm_lock);
+		return false;
+	}
+	uint32_t done = negroni_gpu_completed(), last = gpu_fence;
+	rec_reset(n, rec_arg >= 2);
+	bool rsc;
+	rec_active = true;
+	bool ok = gpu_warm_boot(n <= 2, &rsc);  /* the first two recoveries log every step */
+	rec_active = false;
+	uint32_t us = pm_us_since(now);
+	if (!ok) {
+		pm_dead = true;
+		printf("NEGRONI GPU RECOVERY: %u: FAILED after %u us (RSC %s, GX GDSC %#x, FW_INIT_RESULT %#x): the GPU stays stopped "
+		    "for this boot\n", n, us, rsc ? "awake" : "NOT AWAKE", rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_CM3_FW_INIT_RESULT)));
+		lck_mtx_unlock(&gpu_pm_lock);
+		return false;
+	}
+	/* KGSL writes the hung ring's timestamps as retired; here the fence words take the newest fence */
+	*(volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT) = last;
+	*(volatile uint32_t *)(core_scratch.memory + GPU_BV_FENCE_AT) = last;
+	to_memory(core_scratch.memory, 4096);
+	for (unsigned i = 0; i < 256; i++) {
+		fence_pos[i] = ring_at;
+	}
+	rec_lo[rec_count % REC_HISTORY] = done + 1 == 0 ? 1 : done + 1;
+	rec_hi[rec_count % REC_HISTORY] = last;
+	rec_times[rec_count % REC_HISTORY] = now;
+	rec_count++;
+	pm_asleep = false;
+	pm_revote = true;               /* the watch's DCVS takes the level step 17 voted */
+	pm_seen_collapse = false;
+	gpu_invalidate_next = true;
+	pm_last_submit = mach_absolute_time();
+	if (pm_mode == PM_IFPC) {
+		if (pm_ifpc_ok) {
+			pm_gpu_clear();         /* as pm_start: the GMU collapses GX again */
+		} else {
+			pm_mode = pm_slumber_arg ? PM_SLUMBER : PM_OFF;
+		}
+	}
+	snprintf(negroni_gpu_badge, sizeof(negroni_gpu_badge), "GPU RESET %u", rec_count);
+	printf("NEGRONI GPU RECOVERY: %u: done in %u us: fences %u..%u failed (%u), ring at %u, pm %s, GX GDSC %#x; %u recoveries "
+	    "this boot, %u in the last 60 s (max %u)\n", n, us, done + 1, last, last - done, ring_at, pm_name(),
+	    rd(gpucc + GPUCC_GX_GDSCR), rec_count, recent + 1, rec_max);
+	lck_mtx_unlock(&gpu_pm_lock);
+	return true;
+}
+
 /*
  * Keep mode, watched (boot-arg negroniadreno_watch, default 1 with negroniadreno_keep=1): once a
