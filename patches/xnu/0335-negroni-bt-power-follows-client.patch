+/*
+ * 0335: power cycle for the H4 transport (negroni_bt_h4.c power worker). Off = BT_EN low (btpower.c power off
+ * drives only the enable GPIO; the rails are shared and stay, the QUP2 clocks stay voted). On = the line back to
+ * 115200 (the ROM rate after BT_EN), the step 7 sequence, step 8, then the whole HCI stage (version, 3 Mbaud,
+ * rampatch, NVM, reset, BD address), as at boot.
+ */
+void
+negroni_bt_chip_off(void)
+{
+	if (!bt.powered) {
+		return;
+	}
+	gpio_out(PIN_BT_EN, false, 1u);
+	bt.powered = false;
+	SAY("power off: BT_EN low (SW_CTRL %u); rails and QUP2 clocks stay\n", gpio_in(PIN_SW_CTRL));
+}
+
+int
+negroni_bt_chip_on(void)
+{
+	uint64_t t0 = negroni_bt_us();
+	int error;
+
+	SAY("power on: line to 115200, BT_EN sequence, HCI stage\n");
+	negroni_bt_uart_flow(true);
+	if ((error = negroni_bt_uart_set_baud(115200u)) != 0) {
+		SAY("power on: no SE clock for 115200 (%d)\n", error);
+		return error;
+	}
+	bt.head = bt.tail = 0;
+	(void)step_power_on();
+	step_rx_idle();
+	error = negroni_bt_hci_run(bt.mode);
+	if (error) {
+		negroni_bt_chip_off();
+	}
+	SAY("power on: %s after %llu ms (error %d)\n", error ? "FAILED" : "chip ready", (negroni_bt_us() - t0) / 1000u,
+	    error);
+	return error;
+}
