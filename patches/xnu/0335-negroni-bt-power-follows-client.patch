+/*
+ * 0335: commands whose controller answer is a Command Status event (Core spec Vol 4 Part E 7.x "Command Status
+ * event shall be generated"), so the dead-chip answer has the event type the host waits for.
+ */
+static bool
+uses_cmd_status(uint16_t op)
+{
+	static const uint16_t ops[] = {
+		0x0401, 0x0405, 0x0406, 0x0408, 0x0409, 0x040a, 0x040f, 0x0411, 0x0413, 0x0415, 0x0417, 0x0419,
+		0x041b, 0x041c, 0x041d, 0x041f, 0x0428, 0x0429, 0x043d, 0x043e, 0x0801, 0x0803, 0x0804, 0x0807,
+		0x080b, 0x200d, 0x2013, 0x2016, 0x2019, 0x2025, 0x2026, 0x2032, 0x2043, 0x205d,
+	};
+	for (size_t i = 0; i < sizeof(ops) / sizeof(ops[0]); i++) {
+		if (ops[i] == op) {
+			return true;
+		}
+	}
+	return false;
+}
