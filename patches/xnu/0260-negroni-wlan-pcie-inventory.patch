 	if (negroni_probe_wifi != ~0u) {
 		last = negroni_probe_wifi;      /* probe menu (negroni_keys.c) */
 	}
+	if (wlan) {
+		/* Separate opt-in: run the complete PCIe stage and read-only BAR/MSI inventory. */
+		last = (uint32_t)(sizeof(steps) / sizeof(steps[0]));
+	}
 	(void)PE_parse_boot_argn("negroniwifi_pause", &pause_ms, sizeof(pause_ms));
 	if (last == 0) {
 		return;
