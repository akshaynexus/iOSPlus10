  *   8  writes  the root port (bridge class, bus 0 -> 1), iATU 0 bus 1 config at 0x60100000 (ECAM layout),
  *              iATU 1 memory 0x60300000-0x63ffffff; PERST high, LTSSM on, waits for the link (DLLLA)
  *   9  reads   bus 1 config space: the chip's vendor/device (17cb:1103), class, BAR0
+ *  10  reads   PCI capability list: BAR assignment and MSI/MSI-X capability presence
  *
  * Addresses: sm8450.dtsi pcie@1c00000 / phy@1c06000, gcc-sm8450.c, the phone's DT.
  */
@@ -459,20 +460,75 @@ step_chip(void)
 	return id == CHIP_ID;
 }
 
+/* Read the standard PCI capability list after step 9. The independent
+ * Apple80211 upper-layer design reference is ios-sailfish patch 0175; it does
+ * not define this PCI inventory or QCA6490 transport. Do not assign BARs or
+ * enable interrupts here: the current port has no verified endpoint aperture
+ * or XNU MSI route. This is an explicit, opt-in inventory step. */
+static bool
+step_pci_caps(void)
+{
+	uint32_t command, bar0, status, cap;
+	unsigned count = 0;
+	bool msi = false, msix = false;
+
+	if (!linked || !cfg_bus1) {
+		printf("NEGRONI WLAN: 10 stop: PCIe config space is not available\n");
+		return false;
+	}
+	command = rd(cfg_bus1 + 0x04);
+	status = command >> 16;
+	bar0 = rd(cfg_bus1 + 0x10);
+	printf("NEGRONI WLAN: 10 BAR0 %#x (%s, %s), command %#x, status %#x\n",
+	    bar0, (bar0 & 1) ? "I/O" : "memory",
+	    (bar0 & 1) ? "n/a" : ((bar0 & 6) == 4 ? "64-bit" : "32-bit"),
+	    command & 0xffff, status);
+	if (!(status & (1u << 4))) {
+		printf("NEGRONI WLAN: 10 endpoint reports no capability list\n");
+		return true;
+	}
+	cap = rd(cfg_bus1 + 0x34) & 0xff;
+	while (cap >= 0x40 && cap <= 0xfc && !(cap & 3) && count++ < 48) {
+		uint32_t header = rd(cfg_bus1 + cap);
+		uint32_t id = header & 0xff;
+		uint32_t next = (header >> 8) & 0xff;
+		if (id == 0x05) {
+			msi = true;
+			printf("NEGRONI WLAN: 10 MSI capability at %#x control %#x\n", cap, (header >> 16) & 0xffff);
+		} else if (id == 0x11) {
+			msix = true;
+			printf("NEGRONI WLAN: 10 MSI-X capability at %#x control %#x\n", cap, (header >> 16) & 0xffff);
+		}
+		if (!next || next == cap) {
+			break;
+		}
+		cap = next;
+	}
+	printf("NEGRONI WLAN: 10 interrupt inventory: MSI %s, MSI-X %s; no vector enabled\n",
+	    msi ? "present" : "absent", msix ? "present" : "absent");
+	return true;
+}
+
 static bool (*const steps[])(void) = {
-	step_gcc, step_pins, step_rails, step_pcie, step_power, step_chip_on, step_phy, step_link, step_chip,
+step_gcc, step_pins, step_rails, step_pcie, step_power, step_chip_on, step_phy, step_link, step_chip, step_pci_caps,
 };
 
