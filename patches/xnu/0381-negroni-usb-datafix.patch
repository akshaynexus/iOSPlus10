+/* Two lines: the counters of the data path, then the controller, TRB, PHY and ue0 state. */
+static void
+ud_data_state(const char *head, const char *why)
+{
+	uint64_t now = mach_absolute_time();
+	bool busy = __atomic_load_n(&ud.tx_busy, __ATOMIC_ACQUIRE);
+
+	printf("NEGRONI USB: %s: %s; speed %u (%s), %sconfigured, data alt %u, link up %llu ms ago, OUT frames %llu (last %llu ms "
+	    "ago, ARP for 192.168.7.2 %llu), IN %s %llu ms, last IN done %llu ms ago, txq %u, tx drops %llu, rx %llu tx %llu frames\n",
+	    head, why, ud.speed, ud_speed_name(ud.speed), ud.configured ? "" : "not ", ud.data_alt, ud_df_ms(ud.alt1_at, now),
+	    ud.out_frames, ud_df_ms(ud.out_at, now), ud.arp_req, busy ? "active" : "idle", busy ? ud_df_ms(ud.tx_start_at, now) : 0,
+	    ud_df_ms(ud.tx_done_at, now), ud.txq_count, ud.tx_drops, ud.rx_frames, ud.tx_frames);
+
+	uint32_t dsts = dwc_rd(DSTS);
+	ud_sync(UD_TXB_TRBS, 16);
+	uint32_t trb0 = *(volatile uint32_t *)(ud.dma + UD_TXB_TRBS + 12);
+	unsigned armed = 0;
+	ud_sync(UD_RING_TRBS, 16 * UD_RXN);
+	for (unsigned i = 0; i < UD_RXN; i++) {
+		if (*(volatile uint32_t *)(ud.dma + UD_RING_TRBS + 16 * i + 12) & TRB_HWO) {
+			armed++;
+		}
+	}
