+/*
+ * ---- 0381: the data path after a re-enumeration (negroniusb_datafix, README-usb.md "0381") ----
+ *
+ * t22 (logs/usblog-20261026-233816.txt, logs/bootlog-12.txt): after the charger PD's Type-C restart
+ * the Mac enumerated the gadget again (05:05:25, again at 05:10:02 after a host re-enumeration), so
+ * ud_thread and ep0 worked, but no frame moved in either direction (no log, no ARP, no ctl answer)
+ * for 7 h, and no USB line reached the boot log. The boot log ring had lost that time. These
+ * functions find that state (configured, data alt 1, SOFs move, but no host frame since the link up
+ * or one IN transfer hangs), print what the next test needs to tell the causes apart (speed, the
+ * endpoints, the TRBs, the PHY against the gadget start, ue0 and its address), and with bit 1 set
+ * the whole data path up again.
+ */
+static struct {
+	uint64_t    next;           /* next check (100 ms) */
+	uint64_t    last_line;      /* last state line (re-inits used up / watch only: every 300 s) */
+	uint32_t    tries;          /* re-inits in this episode (an episode ends when host frames come) */
+	uint32_t    lines;          /* periodic state lines in this episode (at most 24) */
+	bool        logged;         /* the first state line of this episode is out */
+} df;
