+/*
+ * 0381: an ARP request for 192.168.7.2 on the OUT path (normal mode; the panic mode has its own
+ * answer in ud_panic_rx). Counted while negroniusb_datafix != 0; with bit 2 answered here as a raw
+ * frame (192.168.7.2 is at 02:00:5e:77:ee:02), so the host reaches the command server also when
+ * the stack does not answer (no address on ue0, stack stuck). The frame still goes to the stack:
+ * a second answer from it does no harm.
+ */
+static void
+ud_arp_answer(const uint8_t *f, uint32_t len)
+{
+	const uint8_t *a = f + ETHER_HDR_LEN;
+	uint32_t flen = ETHER_HDR_LEN + 28;
+	mbuf_t m = NULL;
+
+	if (len < flen || ud_be16(f + 12) != ETHERTYPE_ARP || ud_be16(a) != 1 || ud_be16(a + 2) != ETHERTYPE_IP ||
+	    a[4] != ETHER_ADDR_LEN || a[5] != 4 || ud_be16(a + 6) != 1 || ud_be32(a + 24) != UD_IP_PHONE ||
+	    (a[8] & 1) != 0) {          /* review: no answer to a group (multicast/broadcast) sender MAC */
+		return;
+	}
+	ud.arp_req++;
+	if (!(ud_datafix & UD_DF_RAW) || ud.ifp == NULL) {
+		return;
+	}
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 || mbuf_maxlen(m) < flen) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		return;
+	}
+	uint8_t *r = mbuf_data(m);
+	bzero(r, flen);
+	memcpy(r, a + 8, ETHER_ADDR_LEN);               /* to the sender's MAC */
+	memcpy(r + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+	ud_put16(r + 12, ETHERTYPE_ARP);
+	uint8_t *ra = r + ETHER_HDR_LEN;
+	ud_put16(ra, 1);
+	ud_put16(ra + 2, ETHERTYPE_IP);
+	ra[4] = ETHER_ADDR_LEN;
+	ra[5] = 4;
+	ud_put16(ra + 6, 2);                            /* reply */
+	memcpy(ra + 8, ud_phone_mac, ETHER_ADDR_LEN);
+	ud_put32(ra + 14, UD_IP_PHONE);
+	memcpy(ra + 18, a + 8, ETHER_ADDR_LEN);         /* target: the sender's MAC and IP */
+	memcpy(ra + 24, a + 14, 4);
+	mbuf_setlen(m, flen);
+	mbuf_pkthdr_setlen(m, flen);
+	(void)ud_if_output(ud.ifp, m);
+}
