+/*
+ * Review of 0381: the network stack part (the ue0 address list, ifnet_set_flags, SIOCAIFADDR) runs
+ * in this thread call, never in ud_thread. ud_thread serves ep0 and the command server ("reboot"
+ * must work while the stack hangs, cause (c)), so it must not wait for a stack lock. p1: 1 = report
+ * the address only (state lines), 2 = re-init (ue0 IFF_UP|IFF_RUNNING, the address again if gone).
+ */
+static thread_call_t ud_df_call;
+
+static void
+ud_df_stack(thread_call_param_t p0 __unused, thread_call_param_t p1)
+{
+	bool fix = (uintptr_t)p1 == 2;
+	int has = ud_if_has_addr();
+	errno_t err = 0;
+
+	if (fix && ud.ifp != NULL) {
+		ifnet_set_flags(ud.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+		if (has == 0) {
+			err = ud_if_addr_add();
+		}
+	}
+	printf("NEGRONI USB: data path %s: ue0 flags 0x%x, 192.168.7.2 %s\n", fix ? "re-init, stack part" : "state, stack part",
+	    ud.ifp ? (unsigned)ifnet_flags(ud.ifp) : 0u,
+	    has > 0 ? "on ue0" : has < 0 ? "unknown (address list failed)" : !fix ? "GONE from ue0" :
+	    err ? "was GONE, add FAILED" : "was GONE, added again");
+	if (err != 0) {
+		printf("NEGRONI USB: data path re-init: SIOCAIFADDR 192.168.7.2 on ue0 failed: %d\n", err);
+	}
+}
+
+static void
+ud_df_stack_enter(uintptr_t what)
+{
+	if (ud_df_call != NULL) {
+		(void)thread_call_enter1(ud_df_call, (thread_call_param_t)what);    /* a pending call takes the new p1 */
+	}
+}
+
+/* TX queue empty (the frames of the dead link are old). */
+static unsigned
+ud_txq_flush(void)
+{
+	unsigned n = 0;
+	uint32_t was = ud.where;
+
+	ud.where = UD_AT_DROPLOCK;
+	lck_mtx_lock(ud.lock);
+	ud.where = was;
+	while (ud.txq_count > 0) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		mbuf_freem(m);
+		n++;
+	}
+	lck_mtx_unlock(ud.lock);
+	return n;
+}
+
+/*
+ * The whole data path again: soft reconnect with a PHY init (0368 hp_init, one past the 5 per ADSP
+ * start; the EUD, hold-off and VOOC rules stay), TX queue dropped, ue0 IFF_UP|IFF_RUNNING, the
+ * address again if it is gone, a new log socket. The host sees a detach + attach and enumerates
+ * again; SET_CONFIGURATION starts the endpoints and the RX ring as at boot.
+ */
+static void
+ud_data_reinit(void)
+{
+	uint64_t now = mach_absolute_time();
+	uint32_t repairs = hp.repairs;
+
+	if (hp.ok && ud_phyfix >= 1) {  /* review: negroniusb_phyfix=0 means no PHY writes (and no stale reinit_next) */
+		hp.reinit_next = true;
+		hp.cap_bypass = true;
+	}
+	ud_soft_reconnect("data path dead (negroniusb_datafix)", dwc_rd(DSTS), ud_df_ms(ud.sof_seen, now));
+	hp.cap_bypass = false;
+	/* as hp_watch after its reconnect: the 0366/0371 rules count from here */
+	ud.dev_event_at = 0;
+	ud.last_soffn = DSTS_SOFFN(dwc_rd(DSTS));
+	ud.sof_moved = false;
+	ud.sof_seen = mach_absolute_time();
+	ud.next_watch = ud.sof_seen + ud_abs_ms(100);
+	ud.alt1_at = 0;
+	unsigned flushed = ud_txq_flush();
+	ud_df_stack_enter(2);           /* ue0 up + the address: in the thread call (review: not in ud_thread) */
+	ud_log_resock = true;
+	printf("NEGRONI USB: data path re-init done: PHY init %s, %u queued frames dropped, ue0 + 192.168.7.2 in a thread call, "
+	    "new log socket; the host enumerates again\n",
+	    hp.repairs != repairs ? "done" : ud_phyfix < 1 ? "off (negroniusb_phyfix=0)" : "NOT done (see the reconnect lines)",
+	    flushed);
+}
+
+/* Every 100 ms from ud_thread. */
+static void
+ud_data_watch(void)
+{
+	char why[112];
+
+	if (!(ud_datafix & (UD_DF_REINIT | UD_DF_WATCH)) || ud_in_panic) {
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (now < df.next) {
+		return;
+	}
+	df.next = now + ud_abs_ms(100);
+	if (!ud.configured || ud.data_alt != 1 || ud.alt1_at == 0) {
+		return;                 /* no host link: 0366 (no SOF) and 0371 handle that */
+	}
+	uint64_t lim = ud_abs_ms((uint64_t)ud_datafix_s * 1000);
+	bool host = ud.sof_seen != 0 && now - ud.sof_seen < ud_abs_ms(1000);   /* SOFFN moved in the last second */
+	bool got_out = ud.out_at >= ud.alt1_at;
+	bool busy = __atomic_load_n(&ud.tx_busy, __ATOMIC_ACQUIRE);
+	uint64_t tx_at = __atomic_load_n(&ud.tx_start_at, __ATOMIC_RELAXED);
+	why[0] = 0;
+	if (host && !got_out && now - ud.alt1_at >= lim) {
+		snprintf(why, sizeof(why), "no frame from the host %d s after its link up (SET_INTERFACE alt 1)", ud_datafix_s);
+	} else if (host && busy && tx_at != 0 && now > tx_at && now - tx_at >= lim) {
+		snprintf(why, sizeof(why), "IN transfer active %d s while the host sends SOFs", ud_datafix_s);
+	}
+	if (why[0] == 0) {
+		if (got_out && (df.tries != 0 || df.logged)) {
+			printf("NEGRONI USB: data path works: %llu OUT frames, host frames since the link up, after %u re-inits "
+			    "(negroniusb_datafix)\n", ud.out_frames, df.tries);
+			df.tries = 0;
+			df.lines = 0;
+			df.logged = false;
+		}
+		return;
+	}
+	if ((ud_datafix & UD_DF_WATCH) || df.tries >= UD_DF_TRIES) {
+		/* watch only, or the re-inits are used up: the state lines once, then every 300 s (at most 24) */
+		if (!df.logged || (now - df.last_line >= ud_abs_ms(300000) && df.lines < 24)) {
+			df.logged = true;
+			df.lines++;
+			df.last_line = now;
+			ud_data_state((ud_datafix & UD_DF_WATCH) ? "data path dead (watch only)" :
+			    "data path still dead (3 re-inits done; 0371/0375 decide)", why);
+			ud_df_stack_enter(1);
+		}
+		return;
+	}
+	df.tries++;
+	char head[64];
+	snprintf(head, sizeof(head), "data path dead (re-init %u of %u)", df.tries, UD_DF_TRIES);
+	ud_data_state(head, why);
+	ud_data_reinit();
+}
