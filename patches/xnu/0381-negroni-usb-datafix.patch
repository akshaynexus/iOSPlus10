+/* 0381: 1 = ue0 has 192.168.7.2, 0 = it has not (configd or someone removed it), -1 = unknown */
+static int
+ud_if_has_addr(void)
+{
+	ifaddr_t *list = NULL;
+	int found = 0;
+
+	if (ud.ifp == NULL) {
+		return -1;
+	}
+	errno_t err = ifnet_get_address_list_family(ud.ifp, &list, AF_INET);
+	if (err == ENXIO) {
+		return 0;               /* no IPv4 address at all */
+	}
+	if (err != 0 || list == NULL) {
+		return -1;
+	}
+	for (int i = 0; list[i] != NULL; i++) {
+		struct sockaddr_in sin;
+		bzero(&sin, sizeof(sin));
+		if (ifaddr_address(list[i], (struct sockaddr *)&sin, sizeof(sin)) == 0 && sin.sin_family == AF_INET &&
+		    sin.sin_addr.s_addr == htonl(UD_IP_PHONE)) {
+			found = 1;
+		}
+	}
+	ifnet_free_address_list(list);
+	return found;
+}
