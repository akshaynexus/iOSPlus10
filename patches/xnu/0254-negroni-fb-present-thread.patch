+/*
+ * 0254: the next tick at the next deadline, not one period after the end of this handler. A
+ * deadline already gone is skipped to the next one ahead, and each skipped one is a late tick.
+ */
+void
+AppleCLCD::rearm(IOTimerEventSource *sender)
+{
+	uint64_t now = mach_absolute_time();
+
+	fDeadline += fTickAbs;
+	if (fDeadline <= now) {
+		uint64_t missed = (now - fDeadline) / fTickAbs + 1;
+		fDeadline += missed * fTickAbs;
+		fStatLate += (uint32_t)missed;
+	}
+	sender->wakeAtTime(fDeadline);
+}
+
+/*
+ * 0254: the fence is done, or the tick need not wait for it: the GPU has written no fence for
+ * NEGRONI_FB_GPU_STUCK_MS while the tick waited, or the fence is at or before a given-up one
+ * (one ring, fences done in order). Work loop only.
+ */
+bool
+AppleCLCD::fenceGone(uint32_t fence)
+{
+	if (NegroniGPUFenceDone(fence)) {
+		return true;
+	}
+	if (fGaveUpFence != 0 && NegroniGPUFenceDone(fGaveUpFence)) {
+		fGaveUpFence = 0;       /* the GPU went past it */
+	}
+	if (fWaitFence != 0 && !NegroniGPUFenceDone(fWaitFence) && mach_absolute_time() - fMovedT0 > fStuckAbs) {
+		return true;            /* hung (RedwoodGPU stops it only when someone waits 2 s) */
+	}
+	return fGaveUpFence != 0 && (int32_t)(fence - fGaveUpFence) <= 0;
+}
+
+/*
+ * 0254: the tick may go past this fence (of surface id surface): done, or given up. Never waits.
+ * A slow GPU is waited for: the oldest fence the tick waits for is given up only after
+ * NEGRONI_FB_GPU_GIVEUP_MS since the tick first saw it and a GPU client closed meanwhile, or
+ * when the GPU hangs (fenceGone). Logged once per surface id.
+ */
+bool
+AppleCLCD::fencePassed(uint32_t fence, uint32_t surface, bool *gaveUp)
+{
+	if (NegroniGPUFenceDone(fence)) {
+		return true;
+	}
+	if (!fenceGone(fence)) {
+		uint64_t now = mach_absolute_time();
+		if (fWaitFence == 0 || NegroniGPUFenceDone(fWaitFence)) {
+			fWaitFence = fence;
+			fWaitT0 = now;
+			fWaitCloses = NegroniGPUClientCloses();
+			fMovedT0 = now;         /* the hang clock starts with the wait */
+		} else if ((int32_t)(fence - fWaitFence) < 0) {
+			fWaitFence = fence;     /* older than it: pending since fWaitT0 at least */
+		}
+		if (now - fWaitT0 <= fGiveUpAbs || NegroniGPUClientCloses() == fWaitCloses) {
+			return false;
+		}
+		fGaveUpFence = fWaitFence;
+		fWaitFence = 0;
+		if (!fenceGone(fence)) {
+			return false;   /* a newer fence than the given-up one: the GPU still works on it */
+		}
+	}
+	if (gaveUp != NULL) {
+		*gaveUp = true;
+	}
+	for (uint32_t i = 0; i < NEGRONI_FB_GIVEUP_LOGGED; i++) {
+		if (fGaveUpLogged[i] == surface) {
+			return true;
+		}
+	}
+	fGaveUpLogged[fGaveUpLogN++ % NEGRONI_FB_GIVEUP_LOGGED] = surface;
+	IOLog("NEGRONI FB: gave up on fence %u of surface %u\n", fence, surface);
+	return true;
 }
 
