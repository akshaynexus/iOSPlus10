+/*
+ * Halt/restart (bsd/dev/negroni_reboot.c). Without a PE_halt_restart hook
+ * IOPlatformExpert::haltRestart() returned -1 for every type, so power off
+ * ("slide to power off": launchd reboot(RB_HALT) -> reboot_kernel() ->
+ * host_reboot(HOST_REBOOT_HALT) -> halt_all_cpus(FALSE) ->
+ * PEHaltRestart(kPEHaltCPU)) and restart only printed "CPU halted" /
+ * "MACH Reboot" and spun; 30 s later "Halt/Restart Timed Out" panicked.
+ *   kPEHaltCPU          PSCI SYSTEM_OFF (boot-arg negronipoweroff)
+ *   kPERestartCPU       reboot reason cleared to normal, PSCI SYSTEM_RESET
+ *   kPEPanicRestartCPU  panic text kept on the screen for negronipanic
+ *                       seconds (default 30), then reset
+ * kPEPanicBegin marks the panic; other types (panic callouts) do nothing.
+ */
+extern "C" {
+void negroni_reboot_prepare(void);
+void negroni_reboot(unsigned reason);
+void negroni_power_off(void);
+void negroni_panic_restart(void);
+void negroni_reboot_settle(unsigned ms);
+}
+
+static bool negroni_in_panic;
+
+static int
+negroni_halt_restart(unsigned int type)
+{
+	switch (type) {
+	case kPEPanicBegin:
+		negroni_in_panic = true;
+		return 0;
+	case kPEHaltCPU:
+		if (negroni_in_panic) {
+			negroni_panic_restart();        /* does not return */
+		}
+		IOLog("NEGRONI: power off\n");
+		negroni_reboot_settle(300);             /* the USB log thread sends the last lines */
+		negroni_power_off();
+		return -1;                              /* refused: halt_all_cpus() spins */
+	case kPERestartCPU:
+		if (negroni_in_panic) {
+			negroni_panic_restart();        /* does not return */
+		}
+		IOLog("NEGRONI: restart\n");
+		negroni_reboot_settle(300);
+		negroni_reboot(0);
+		return -1;
+	case kPEPanicRestartCPU:
+		negroni_panic_restart();                /* does not return */
+		return -1;
+	default:
+		return 0;
+	}
+}
