-/* PSCI SYSTEM_RESET (SMC conduit, as NegroniCPU's CPU_ON). Returns only if PSCI refused. */
-void
-negroni_reboot_reset(void)
+static int64_t
+nr_psci(uint64_t function)
 {
-	register uint64_t x0 __asm__("x0") = PSCI_SYSTEM_RESET;
+	register uint64_t x0 __asm__("x0") = function;
 	register uint64_t x1 __asm__("x1") = 0;
 	register uint64_t x2 __asm__("x2") = 0;
 	register uint64_t x3 __asm__("x3") = 0;
 	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
 	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
-	printf("NEGRONI REBOOT: PSCI SYSTEM_RESET returned %lld\n", (long long)x0);
+	return (int64_t)x0;
+}
+
+/* Sleeps ms if this thread may block (other threads, the USB log, still run); else returns at once. */
+void
+negroni_reboot_settle(unsigned ms)
+{
+	if (!preemption_enabled() || ml_at_interrupt_context()) {
+		return;
+	}
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline((event_t)&nr_prepared, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Boot-args and the SPMI mappings, once, in thread context (before any panic needs them). */
+void
+negroni_reboot_prepare(void)
+{
+	if (nr_prepared) {
+		return;
+	}
+	nr_prepared = true;
+	PE_parse_boot_argn("negronipoweroff", &nr_poweroff_mode, sizeof(nr_poweroff_mode));
+	PE_parse_boot_argn("negronipanic", &nr_panic_secs, sizeof(nr_panic_secs));
+	PE_parse_boot_argn("negronipanicreason", &nr_panic_reason, sizeof(nr_panic_reason));
+	(void)nr_open(&nr_sdam);
+	if (nr_poweroff_mode != 0) {
+		(void)nr_open(&nr_pon);
+	}
+	printf("NEGRONI REBOOT: power off = %s, panic = %s %d s (reason %d)\n",
+	    nr_poweroff_mode == 0 ? "PSCI SYSTEM_OFF" : nr_poweroff_mode == 1 ? "SYSTEM_OFF, then PMIC" : "PMIC",
+	    nr_panic_secs > 0 ? "reset after" : "stay", nr_panic_secs, nr_panic_reason);
+}
+
+/*
+ * Reboot reason field of 0x7148 = reason (0 normal, 1 recovery,
+ * 2 bootloader); bit 0 is kept. 0 = set and read back, -1 = not set.
+ */
+int
+negroni_reboot_set_reason(unsigned reason)
+{
+	if (reason > 0x7f || !nr_open(&nr_sdam)) {
+		return -1;
+	}
+	if (nr_update(&nr_sdam, NR_REASON_REG, NR_REASON_MASK, (uint8_t)(reason << NR_REASON_SHIFT)) != 0) {
+		return -1;
+	}
+	printf("NEGRONI REBOOT: reboot reason %u\n", reason);
+	return 0;
+}
+
+/* PSCI SYSTEM_RESET (SMC conduit, as NegroniCPU's CPU_ON). Returns only if PSCI refused. */
+void
+negroni_reboot_reset(void)
+{
+	int64_t rc = nr_psci(PSCI_SYSTEM_RESET);
+	printf("NEGRONI REBOOT: PSCI SYSTEM_RESET returned %lld\n", (long long)rc);
 }
 
 /* Reason (best effort: a reason that cannot be set gives a plain reset), then reset. */
@@ -241,4 +352,77 @@ negroni_reboot(unsigned reason)
 	}
 	negroni_reboot_reset();
 }
+
+/* PS_HOLD reset type = SHUTDOWN in PON_PBS. 0 = set, -1 = not set (logged). */
+static int
+nr_pon_shutdown_type(void)
+{
+	uint8_t type = 0, subtype = 0;
+
+	if (!nr_open(&nr_pon)) {
+		return -1;
+	}
+	if (nr_read(&nr_pon, NR_PON_TYPE, &type) || nr_read(&nr_pon, NR_PON_SUBTYPE, &subtype) ||
+	    type != NR_PON_TYPE_PON || subtype != NR_PON_SUBTYPE_GEN3_PBS) {
+		printf("NEGRONI REBOOT: PON_PBS type %#04x subtype %#04x, not PON GEN3 PBS: no PMIC power off\n",
+		    type, subtype);
+		return -1;
+	}
+	/* Like qpnp_pon_reset_config(): disable, 500 us (10 sleep clock cycles), type, enable. */
+	if (nr_update(&nr_pon, NR_PON_PS_HOLD_RST_CTL2, NR_PON_RESET_EN, 0) != 0) {
+		return -1;
+	}
+	delay(500);
+	int rc = nr_update(&nr_pon, NR_PON_PS_HOLD_RST_CTL, NR_PON_TYPE_MASK, NR_PON_TYPE_SHUTDOWN);
+	/* Enable again also after a failed type write: the reset must still work. */
+	if (nr_update(&nr_pon, NR_PON_PS_HOLD_RST_CTL2, NR_PON_RESET_EN, NR_PON_RESET_EN) != 0 || rc != 0) {
+		return -1;
+	}
+	return 0;
+}
+
+/* Power off. Returns only if every enabled method failed (all logged). */
+void
+negroni_power_off(void)
+{
+	if (nr_poweroff_mode != 2) {
+		printf("NEGRONI REBOOT: PSCI SYSTEM_OFF\n");
+		int64_t rc = nr_psci(PSCI_SYSTEM_OFF);
+		printf("NEGRONI REBOOT: PSCI SYSTEM_OFF returned %lld\n", (long long)rc);
+		if (nr_poweroff_mode == 0) {
+			printf("NEGRONI REBOOT: no power off (boot-arg negronipoweroff=1 tries the PMIC)\n");
+			return;
+		}
+	}
+	printf("NEGRONI REBOOT: PMIC power off: PS_HOLD reset type SHUTDOWN, then PSCI SYSTEM_RESET\n");
+	if (nr_pon_shutdown_type() != 0) {
+		printf("NEGRONI REBOOT: PMIC power off not possible\n");
+		return;
+	}
+	(void)negroni_reboot_set_reason(0);
+	negroni_reboot_reset();
+}
+
+/*
+ * Panic: the panic text stays on the screen for negronipanic seconds
+ * (default 0 = stay, the owner's choice), then reset with reason negronipanicreason (default 0).
+ * negronipanic=0: stay on the panic screen (never returns).
+ */
+void
+negroni_panic_restart(void)
+{
+	if (nr_panic_secs > 0) {
+		printf("NEGRONI REBOOT: panic: reset in %d s (boot-arg negronipanic), reason %d\n",
+		    nr_panic_secs, nr_panic_reason);
+		for (int i = 0; i < nr_panic_secs; i++) {
+			delay(1000000);
+		}
+		negroni_reboot((unsigned)nr_panic_reason);
+	} else {
+		printf("NEGRONI REBOOT: panic: staying on the panic screen (negronipanic=0)\n");
+	}
+	for (;;) {
+		__builtin_arm_wfe();
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_NEGRONI */
