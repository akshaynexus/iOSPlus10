+/*
+ * NEGRONI software keybag core: passcode hash, compare and the bag blob.
+ *
+ * Plain C with no kernel dependencies other than a SHA-256 with the
+ * SHA256_CTX / SHA256_Init / SHA256_Update / SHA256_Final interface
+ * (libkern/crypto/sha2.h in the kernel). The host unit test
+ * (tools/aks-core-test, scripts/kernel/test-aks-core.sh) compiles this same
+ * file against CommonCrypto and checks PBKDF2 against CCKeyDerivationPBKDF.
+ *
+ * The passcode is never stored. The bag keeps a random 16-byte salt and
+ * PBKDF2-HMAC-SHA256(passcode, salt, iterations, 32 bytes).
+ *
+ * Blob (NKS_BLOB_LEN bytes, little endian), what aks_save_bag returns and
+ * aks_load_bag accepts; keybagd keeps it in /private/var/keybags/systembag.kb
+ * (key KeyBagKeys):
+ *    0  "NAKS"
+ *    4  u16 version (1)
+ *    6  u16 flags (bit 0: a passcode is set)
+ *    8  u32 PBKDF2 iterations
+ *   12  u32 grace period (seconds, aks_set_configuration "gp")
+ *   16  salt[16]
+ *   32  hash[32]
+ *   64  bag UUID[16]
+ *   80  reserved[16] (0)
+ *   96  SHA-256 of bytes 0..95 (detects a damaged file; not a secret)
+ */
+#ifndef NEGRONI_KEYSTORE_CORE_H
+#define NEGRONI_KEYSTORE_CORE_H
+
+/* every helper is static; some are used only by the host test */
+#define NKS_STATIC          static __attribute__((unused))
+
+#define NKS_SALT_LEN        16
+#define NKS_HASH_LEN        32
+#define NKS_UUID_LEN        16
+#define NKS_BLOB_LEN        128
+#define NKS_BLOB_VERSION    1
+#define NKS_ITERATIONS      20000       /* about 40k SHA-256 blocks per check */
+#define NKS_ITERATIONS_MAX  1000000
+#define NKS_PASSCODE_MAX    128         /* bytes; libaks passcodes are short */
+#define NKS_FLAG_SECRET     0x1
+
+struct nks_bag {
+	uint8_t  has_secret;
+	uint32_t iterations;
+	uint32_t grace;                         /* seconds */
+	uint8_t  salt[NKS_SALT_LEN];
+	uint8_t  hash[NKS_HASH_LEN];
+	uint8_t  uuid[NKS_UUID_LEN];
+};
+
+NKS_STATIC void
+nks_memzero(void *p, size_t n)
+{
+	volatile uint8_t *v = (volatile uint8_t *)p;
+	while (n--) {
+		*v++ = 0;
+	}
+}
+
+/* HMAC-SHA256 key schedule: the inner and outer contexts after the pads. */
+struct nks_hmac {
+	SHA256_CTX inner;
+	SHA256_CTX outer;
+};
+
+NKS_STATIC void
+nks_hmac_init(struct nks_hmac *h, const uint8_t *key, size_t klen)
+{
+	uint8_t k[64], pad[64];
+	size_t i;
+
+	nks_memzero(k, sizeof(k));
+	if (klen > sizeof(k)) {
+		SHA256_CTX c;
+		SHA256_Init(&c);
+		SHA256_Update(&c, key, klen);
+		SHA256_Final(k, &c);
+	} else if (klen > 0) {
+		memcpy(k, key, klen);
+	}
+	for (i = 0; i < 64; i++) {
+		pad[i] = k[i] ^ 0x36;
+	}
+	SHA256_Init(&h->inner);
+	SHA256_Update(&h->inner, pad, 64);
+	for (i = 0; i < 64; i++) {
+		pad[i] = k[i] ^ 0x5c;
+	}
+	SHA256_Init(&h->outer);
+	SHA256_Update(&h->outer, pad, 64);
+	nks_memzero(k, sizeof(k));
+	nks_memzero(pad, sizeof(pad));
+}
+
+/* out = HMAC(key, m1 || m2), from a prepared key schedule. */
+NKS_STATIC void
+nks_hmac_run(const struct nks_hmac *h, const uint8_t *m1, size_t l1,
+    const uint8_t *m2, size_t l2, uint8_t out[NKS_HASH_LEN])
+{
+	SHA256_CTX c = h->inner;
+	uint8_t inner[NKS_HASH_LEN];
+
+	SHA256_Update(&c, m1, l1);
+	if (l2 > 0) {
+		SHA256_Update(&c, m2, l2);
+	}
+	SHA256_Final(inner, &c);
+	c = h->outer;
+	SHA256_Update(&c, inner, sizeof(inner));
+	SHA256_Final(out, &c);
+	nks_memzero(inner, sizeof(inner));
+	nks_memzero(&c, sizeof(c));
+}
+
+NKS_STATIC void
+nks_hmac_sha256(const uint8_t *key, size_t klen, const uint8_t *msg, size_t mlen,
+    uint8_t out[NKS_HASH_LEN])
+{
+	struct nks_hmac h;
+	nks_hmac_init(&h, key, klen);
+	nks_hmac_run(&h, msg, mlen, NULL, 0, out);
+	nks_memzero(&h, sizeof(h));
+}
+
+/* PBKDF2-HMAC-SHA256 (RFC 8018), any output length. */
+NKS_STATIC void
+nks_pbkdf2_sha256(const uint8_t *pw, size_t pwlen, const uint8_t *salt, size_t saltlen,
+    uint32_t iterations, uint8_t *out, size_t outlen)
+{
+	struct nks_hmac h;
+	uint8_t u[NKS_HASH_LEN], t[NKS_HASH_LEN], ctr[4];
+	uint32_t block = 1;
+
+	nks_hmac_init(&h, pw, pwlen);
+	while (outlen > 0) {
+		size_t n = outlen < NKS_HASH_LEN ? outlen : NKS_HASH_LEN;
+		ctr[0] = (uint8_t)(block >> 24);
+		ctr[1] = (uint8_t)(block >> 16);
+		ctr[2] = (uint8_t)(block >> 8);
+		ctr[3] = (uint8_t)block;
+		nks_hmac_run(&h, salt, saltlen, ctr, 4, u);
+		memcpy(t, u, sizeof(t));
+		for (uint32_t i = 1; i < iterations; i++) {
+			nks_hmac_run(&h, u, sizeof(u), NULL, 0, u);
+			for (size_t j = 0; j < sizeof(t); j++) {
+				t[j] ^= u[j];
+			}
+		}
+		memcpy(out, t, n);
+		out += n;
+		outlen -= n;
+		block++;
+	}
+	nks_memzero(&h, sizeof(h));
+	nks_memzero(u, sizeof(u));
+	nks_memzero(t, sizeof(t));
+}
+
+/* Constant-time compare (no early exit on the first different byte). */
+NKS_STATIC int
+nks_equal(const uint8_t *a, const uint8_t *b, size_t n)
+{
+	uint8_t d = 0;
+	for (size_t i = 0; i < n; i++) {
+		d |= a[i] ^ b[i];
+	}
+	return d == 0;
+}
+
+/*
+ * Set (pwlen > 0) or clear (pwlen == 0) the passcode. salt: NKS_SALT_LEN
+ * random bytes from the caller. The grace period and UUID do not change.
+ */
+NKS_STATIC void
+nks_bag_set_secret(struct nks_bag *bag, const uint8_t *pw, size_t pwlen,
+    const uint8_t salt[NKS_SALT_LEN], uint32_t iterations)
+{
+	if (pwlen == 0) {
+		bag->has_secret = 0;
+		bag->iterations = 0;
+		nks_memzero(bag->salt, sizeof(bag->salt));
+		nks_memzero(bag->hash, sizeof(bag->hash));
+		return;
+	}
+	bag->has_secret = 1;
+	bag->iterations = iterations;
+	memcpy(bag->salt, salt, NKS_SALT_LEN);
+	nks_pbkdf2_sha256(pw, pwlen, bag->salt, NKS_SALT_LEN, iterations, bag->hash, NKS_HASH_LEN);
+}
+
+/* 1 when pw opens the bag. A bag without a passcode accepts any input. */
+NKS_STATIC int
+nks_bag_verify(const struct nks_bag *bag, const uint8_t *pw, size_t pwlen)
+{
+	uint8_t h[NKS_HASH_LEN];
+	int ok;
+
+	if (!bag->has_secret) {
+		return 1;
+	}
+	if (pwlen == 0) {
+		return 0;
+	}
+	nks_pbkdf2_sha256(pw, pwlen, bag->salt, NKS_SALT_LEN, bag->iterations, h, sizeof(h));
+	ok = nks_equal(h, bag->hash, sizeof(h));
+	nks_memzero(h, sizeof(h));
+	return ok;
+}
+
+NKS_STATIC void
+nks_put16(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+}
+
+NKS_STATIC void
+nks_put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)v;
+	p[1] = (uint8_t)(v >> 8);
+	p[2] = (uint8_t)(v >> 16);
+	p[3] = (uint8_t)(v >> 24);
+}
+
+NKS_STATIC uint32_t
+nks_get16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+}
+
+NKS_STATIC uint32_t
+nks_get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/* Write the blob; returns NKS_BLOB_LEN. */
+NKS_STATIC size_t
+nks_bag_serialize(const struct nks_bag *bag, uint8_t out[NKS_BLOB_LEN])
+{
+	SHA256_CTX c;
+
+	nks_memzero(out, NKS_BLOB_LEN);
+	memcpy(out, "NAKS", 4);
+	nks_put16(out + 4, NKS_BLOB_VERSION);
+	nks_put16(out + 6, bag->has_secret ? NKS_FLAG_SECRET : 0);
+	nks_put32(out + 8, bag->has_secret ? bag->iterations : 0);
+	nks_put32(out + 12, bag->grace);
+	if (bag->has_secret) {
+		memcpy(out + 16, bag->salt, NKS_SALT_LEN);
+		memcpy(out + 32, bag->hash, NKS_HASH_LEN);
+	}
+	memcpy(out + 64, bag->uuid, NKS_UUID_LEN);
+	SHA256_Init(&c);
+	SHA256_Update(&c, out, 96);
+	SHA256_Final(out + 96, &c);
+	return NKS_BLOB_LEN;
+}
+
+/*
+ * Read a blob. Returns 1 and fills bag for a valid blob of ours, 0 for
+ * anything else (another format, a damaged file); bag is then untouched.
+ */
+NKS_STATIC int
+nks_bag_parse(const uint8_t *in, size_t len, struct nks_bag *bag)
+{
+	uint8_t sum[NKS_HASH_LEN];
+	SHA256_CTX c;
+	uint32_t flags, iterations;
+
+	if (in == NULL || len != NKS_BLOB_LEN || memcmp(in, "NAKS", 4) != 0 ||
+	    nks_get16(in + 4) != NKS_BLOB_VERSION) {
+		return 0;
+	}
+	SHA256_Init(&c);
+	SHA256_Update(&c, in, 96);
+	SHA256_Final(sum, &c);
+	if (!nks_equal(sum, in + 96, sizeof(sum))) {
+		return 0;
+	}
+	flags = nks_get16(in + 6);
+	iterations = nks_get32(in + 8);
+	if ((flags & ~(uint32_t)NKS_FLAG_SECRET) != 0 ||
+	    ((flags & NKS_FLAG_SECRET) && (iterations == 0 || iterations > NKS_ITERATIONS_MAX))) {
+		return 0;
+	}
+	bag->has_secret = (flags & NKS_FLAG_SECRET) ? 1 : 0;
+	bag->iterations = bag->has_secret ? iterations : 0;
+	bag->grace = nks_get32(in + 12);
+	memcpy(bag->salt, in + 16, NKS_SALT_LEN);
+	memcpy(bag->hash, in + 32, NKS_HASH_LEN);
+	memcpy(bag->uuid, in + 64, NKS_UUID_LEN);
+	return 1;
+}
+
+/* Value of a base64 character; -1 for any other character. */
+NKS_STATIC int
+nks_b64val(uint8_t c)
+{
+	if (c >= 'A' && c <= 'Z') {
+		return c - 'A';
+	}
+	if (c >= 'a' && c <= 'z') {
+		return c - 'a' + 26;
+	}
+	if (c >= '0' && c <= '9') {
+		return c - '0' + 52;
+	}
+	if (c == '+') {
+		return 62;
+	}
+	if (c == '/') {
+		return 63;
+	}
+	return -1;
+}
+
+/*
+ * Find a valid blob of ours in a keybag file (keybagd's systembag.kb, a
+ * property list with KeyBagKeys = blob). A binary plist (what keybagd
+ * writes, CFPropertyListWrite format 200) keeps the bytes as they are; an
+ * XML plist keeps them as base64 in <data>...</data>. Returns 1 and fills
+ * bag for the first valid blob; 0 (bag untouched) when there is none, e.g.
+ * slop's "SWEET" placeholder or a damaged file.
+ */
+NKS_STATIC int
+nks_find_blob(const uint8_t *buf, size_t len, struct nks_bag *bag)
+{
+	uint8_t out[NKS_BLOB_LEN];
+	size_t i, j, n;
+	uint32_t acc;
+	int bits, bad, v;
+
+	if (buf == NULL) {
+		return 0;
+	}
+	for (i = 0; len >= NKS_BLOB_LEN && i <= len - NKS_BLOB_LEN; i++) {
+		if (buf[i] == 'N' && nks_bag_parse(buf + i, NKS_BLOB_LEN, bag)) {
+			return 1;
+		}
+	}
+	for (i = 0; len >= 6 && i <= len - 6; i++) {
+		if (memcmp(buf + i, "<data>", 6) != 0) {
+			continue;
+		}
+		n = 0;
+		acc = 0;
+		bits = 0;
+		bad = 0;
+		for (j = i + 6; j < len && buf[j] != '<'; j++) {
+			v = nks_b64val(buf[j]);
+			if (v < 0) {
+				if (buf[j] == '=' || buf[j] == ' ' || buf[j] == '\t' || buf[j] == '\n' || buf[j] == '\r') {
+					continue;
+				}
+				bad = 1;
+				break;
+			}
+			acc = ((acc << 6) | (uint32_t)v) & 0xffff;
+			bits += 6;
+			if (bits >= 8) {
+				bits -= 8;
+				if (n == sizeof(out)) {
+					bad = 1;        /* longer than a blob of ours */
+					break;
+				}
+				out[n++] = (uint8_t)(acc >> bits);
+			}
+		}
+		if (!bad && n == NKS_BLOB_LEN && nks_bag_parse(out, n, bag)) {
+			nks_memzero(out, sizeof(out));
+			return 1;
+		}
+		i = j > i ? j - 1 : i;  /* continue after this element */
+	}
+	nks_memzero(out, sizeof(out));
+	return 0;
+}
+
+/*
+ * DER length at p (short or long form up to 4 bytes). Returns the header
+ * size (bytes of the length field) or 0 when it does not fit in end.
+ */
+NKS_STATIC size_t
+nks_der_len(const uint8_t *p, const uint8_t *end, size_t *len)
+{
+	size_t n, i;
+
+	if (p >= end) {
+		return 0;
+	}
+	if (p[0] < 0x80) {
+		*len = p[0];
+		return 1;
+	}
+	n = p[0] & 0x7f;
+	if (n == 0 || n > 4 || (size_t)(end - p) < 1 + n) {
+		return 0;
+	}
+	*len = 0;
+	for (i = 0; i < n; i++) {
+		*len = (*len << 8) | p[1 + i];
+	}
+	return 1 + n;
+}
+
+/*
+ * Find SEQUENCE { UTF8String key, INTEGER v } in a DER SET/SEQUENCE of
+ * such pairs (the libaks configuration and state dictionaries). Returns 1
+ * and v (non-negative values up to 32 bits) when found.
+ */
+NKS_STATIC int
+nks_der_find_int(const uint8_t *buf, size_t len, const char *key, uint32_t *v)
+{
+	const uint8_t *p = buf, *end = buf + len;
+	size_t klen = strlen(key), l, h;
+
+	if (len < 2 || (p[0] != 0x31 && p[0] != 0x30)) {
+		return 0;
+	}
+	h = nks_der_len(p + 1, end, &l);
+	if (h == 0 || l > (size_t)(end - (p + 1 + h))) {
+		return 0;
+	}
+	p += 1 + h;
+	end = p + l;
+	while (p < end) {
+		const uint8_t *item, *iend;
+		if (p[0] != 0x30) {
+			return 0;
+		}
+		h = nks_der_len(p + 1, end, &l);
+		if (h == 0 || l > (size_t)(end - (p + 1 + h))) {
+			return 0;
+		}
+		item = p + 1 + h;
+		iend = item + l;
+		p = iend;
+		/* key */
+		if (item >= iend || item[0] != 0x0c) {
+			continue;
+		}
+		h = nks_der_len(item + 1, iend, &l);
+		if (h == 0 || l > (size_t)(iend - (item + 1 + h))) {
+			continue;
+		}
+		if (l != klen || memcmp(item + 1 + h, key, klen) != 0) {
+			continue;
+		}
+		item += 1 + h + l;
+		/* value */
+		if (item >= iend || item[0] != 0x02) {
+			return 0;
+		}
+		h = nks_der_len(item + 1, iend, &l);
+		if (h == 0 || l == 0 || l > 5 || l > (size_t)(iend - (item + 1 + h))) {
+			return 0;
+		}
+		item += 1 + h;
+		if (item[0] & 0x80) {
+			return 0;               /* negative */
+		}
+		if (l == 5 && item[0] != 0) {
+			return 0;
+		}
+		uint64_t x = 0;
+		for (size_t i = 0; i < l; i++) {
+			x = (x << 8) | item[i];
+		}
+		*v = (uint32_t)x;
+		return 1;
+	}
+	return 0;
+}
+
+/* Append SEQUENCE { UTF8String key, INTEGER value } (key below 100 bytes). */
+NKS_STATIC size_t
+nks_der_pair(uint8_t *p, const char *key, uint32_t value)
+{
+	size_t klen = strlen(key), n = 0, ilen = 1;
+	uint8_t ib[5];
+
+	/* minimal two's complement, positive */
+	ib[0] = 0;
+	ib[1] = (uint8_t)(value >> 24);
+	ib[2] = (uint8_t)(value >> 16);
+	ib[3] = (uint8_t)(value >> 8);
+	ib[4] = (uint8_t)value;
+	{
+		size_t s = 1;
+		while (s < 4 && ib[s] == 0) {
+			s++;          /* drop leading zero bytes, keep the last one */
+		}
+		if (ib[s] & 0x80) {
+			s--;          /* a leading 0 keeps the value positive */
+		}
+		ilen = 5 - s;
+		memmove(ib, ib + s, ilen);
+	}
+	p[n++] = 0x30;
+	p[n++] = (uint8_t)(2 + klen + 2 + ilen);
+	p[n++] = 0x0c;
+	p[n++] = (uint8_t)klen;
+	memcpy(p + n, key, klen);
+	n += klen;
+	p[n++] = 0x02;
+	p[n++] = (uint8_t)ilen;
+	memcpy(p + n, ib, ilen);
+	n += ilen;
+	return n;
+}
+
+#endif /* NEGRONI_KEYSTORE_CORE_H */
