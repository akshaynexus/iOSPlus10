+/*
+ * ---- Software keybag (0221) ----
+ * All functions below run with negroni_aks_mtx held (externalMethod).
+ */
+
+static bool
+negroni_aks_caller_is(const char *name)
+{
+	char self[32];
+	proc_selfname(self, sizeof(self));
+	return strcmp(self, name) == 0;
+}
+
+/*
+ * Read up to cap bytes of a regular file (no symlinks). 0 or an errno.
+ * Root userland can put any node at the path, and the AKS lock is held
+ * here: look the node up first and open only a regular file, so a FIFO
+ * or a device is never opened (a FIFO open for reading blocks until a
+ * writer comes, a device open has side effects). O_NONBLOCK covers a node
+ * swapped in between the lookup and the open; the type is checked again.
+ */
+static int
+negroni_aks_read_file(const char *path, uint8_t *buf, size_t cap, size_t *outlen)
+{
+	vfs_context_t ctx = vfs_context_current();
+	vnode_t vp = NULLVP;
+	int resid = 0, err;
+	bool reg;
+
+	*outlen = 0;
+	err = vnode_lookup(path, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (err != 0) {
+		return err;
+	}
+	reg = vnode_isreg(vp);
+	vnode_put(vp);
+	vp = NULLVP;
+	if (!reg) {
+		return EFTYPE;
+	}
+	err = vnode_open(path, FREAD | O_NOFOLLOW | O_NONBLOCK, 0, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (err != 0) {
+		return err;
+	}
+	if (!vnode_isreg(vp)) {
+		err = EFTYPE;
+	} else {
+		err = vn_rdwr(UIO_READ, vp, (caddr_t)buf, (int)cap, 0, UIO_SYSSPACE, 0,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	}
+	(void)vnode_close(vp, FREAD, ctx);
+	if (err == 0 && resid >= 0 && (size_t)resid <= cap) {
+		*outlen = cap - (size_t)resid;
+	}
+	return err;
+}
+
+/*
+ * The system bag from keybagd's file, at keybagd's first aks_get_system.
+ * Never fails: no file, a read error, no blob of ours or negroniaks_reset=1
+ * give a bag without a passcode. Sets the boot lock state.
+ */
+static void
+negroni_aks_load_system_file(void)
+{
+	struct nks_bag bag;
+	const char *file = NEGRONI_AKS_BAG_FILE, *what;
+	size_t len = 0;
+	int err = ENOMEM;
+	uint8_t *buf = (uint8_t *)IOMallocData(NEGRONI_AKS_BAG_FILE_MAX);
+
+	bzero(&bag, sizeof(bag));
+	if (buf != NULL) {
+		err = negroni_aks_read_file(file, buf, NEGRONI_AKS_BAG_FILE_MAX, &len);
+		if (err != 0 || len == 0) {
+			/* keybagd reads systembag.kb.writing when systembag.kb fails */
+			file = NEGRONI_AKS_BAG_FILE_TMP;
+			err = negroni_aks_read_file(file, buf, NEGRONI_AKS_BAG_FILE_MAX, &len);
+		}
+	}
+	if (err != 0 || len == 0) {
+		what = "no file or unreadable: no passcode";
+		file = NEGRONI_AKS_BAG_FILE;
+	} else if (!nks_find_blob(buf, len, &bag)) {
+		bzero(&bag, sizeof(bag));
+		what = "no NEGRONI bag in it: no passcode";
+	} else if (negroni_aks_reset && bag.has_secret) {
+		nks_bag_set_secret(&bag, NULL, 0, NULL, 0);
+		what = "negroniaks_reset=1: stored passcode ignored";
+	} else {
+		what = bag.has_secret ? "passcode set" : "no passcode";
+	}
+	if (buf != NULL) {
+		nks_memzero(buf, len);
+		IOFreeData(buf, NEGRONI_AKS_BAG_FILE_MAX);
+	}
+	negroni_aks_system = bag;
+	nks_memzero(&bag, sizeof(bag));
+	negroni_aks_system_set = true;
+	negroni_aks_lock_deadline = 0;
+	negroni_aks_failed = 0;
+	/* before the first unlock: locked when a passcode is set */
+	negroni_aks_locked = negroni_aks_has_passcode();
+	negroni_aks_unlocked_once = !negroni_aks_locked;
+	if (negroni_aks_locked) {
+		negroni_aks_post |= NEGRONI_AKS_POST_LOCK_STATUS;
+	}
+	IOLog("NEGRONI AKS: keybagd: system bag from %s (%lu bytes, error %d): %s, lock state 0x%x\n",
+	    file, (unsigned long)len, err, what, negroni_aks_lock_state());
+}
+
+/* The bag of a handle; NULL for a temporary handle that matches no bag. */
+static struct nks_bag *
+negroni_aks_bag(uint64_t handle, bool *is_temp)
+{
+	bool temp = handle >= NEGRONI_AKS_TEMP_BASE && handle < NEGRONI_AKS_TEMP_END;
+	if (is_temp != NULL) {
+		*is_temp = temp;
+	}
+	if (!temp) {
+		return &negroni_aks_system;
+	}
+	uint64_t i = (handle - NEGRONI_AKS_TEMP_BASE) % NEGRONI_AKS_TEMP_COUNT;
+	if (negroni_aks_temp_used[i] && negroni_aks_temp_handle[i] == handle) {
+		return &negroni_aks_temp[i];
+	}
+	return NULL;
+}
+
+static void
+negroni_aks_temp_free(uint64_t handle)
+{
+	bool is_temp;
+	struct nks_bag *bag = negroni_aks_bag(handle, &is_temp);
+	if (is_temp && bag != NULL) {
+		uint64_t i = (handle - NEGRONI_AKS_TEMP_BASE) % NEGRONI_AKS_TEMP_COUNT;
+		negroni_aks_temp_used[i] = false;
+		nks_memzero(bag, sizeof(*bag));
+	}
+}
+
+static void
+negroni_aks_new_uuid(struct nks_bag *bag)
+{
+	static const uint8_t zero[NKS_UUID_LEN] = { 0 };
+	if (memcmp(bag->uuid, zero, sizeof(zero)) == 0) {
+		read_random(bag->uuid, sizeof(bag->uuid));
+	}
+}
