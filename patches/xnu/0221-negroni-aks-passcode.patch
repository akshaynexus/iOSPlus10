+		i = 0;
+	}
+	negroni_aks_temp_gen = (negroni_aks_temp_gen + 1) & 0xff;
+	negroni_aks_temp[i] = *from;
+	negroni_aks_temp_used[i] = true;
+	negroni_aks_temp_handle[i] = NEGRONI_AKS_TEMP_BASE + negroni_aks_temp_gen * NEGRONI_AKS_TEMP_COUNT + i;
+	return negroni_aks_temp_handle[i];
+}
+
+/* Copy a passcode (user pointer + length from the scalars) into buf. */
+static IOReturn
+negroni_aks_copyin_secret(uint64_t uaddr, uint64_t len, uint8_t buf[NKS_PASSCODE_MAX], size_t *outlen)
+{
+	*outlen = 0;
+	if (uaddr == 0 || len == 0) {
+		return kIOReturnSuccess;
+	}
+	if (len > NKS_PASSCODE_MAX) {
+		return kIOReturnBadArgument;
+	}
+	if (copyin((user_addr_t)uaddr, buf, (size_t)len) != 0) {
+		return kIOReturnVMError;
+	}
+	*outlen = (size_t)len;
+	return kIOReturnSuccess;
+}
+
+/*
+ * Inband or out-of-line structure input, up to cap bytes. prefix: a longer
+ * input gives its first cap bytes, else kIOReturnNoSpace.
+ */
+static IOReturn
+negroni_aks_struct_in(IOExternalMethodArguments *args, uint8_t *buf, uint32_t cap, uint32_t *len,
+    bool prefix)
+{
+	*len = 0;
+	if (args->structureInputDescriptor != NULL) {
+		IOMemoryDescriptor *md = args->structureInputDescriptor;
+		IOByteCount n = md->getLength();
+		if (n > cap) {
+			if (!prefix) {
+				return kIOReturnNoSpace;
+			}
+			n = cap;
+		}
+		IOReturn ret = md->prepare();
+		if (ret != kIOReturnSuccess) {
+			return ret;
+		}
+		IOByteCount done = md->readBytes(0, buf, n);
+		md->complete();
+		if (done != n) {
+			return kIOReturnVMError;
+		}
+		*len = (uint32_t)n;
+		return kIOReturnSuccess;
+	}
+	uint32_t n = args->structureInputSize;
+	if (n > cap) {
+		if (!prefix) {
+			return kIOReturnNoSpace;
+		}
+		n = cap;
+	}
+	if (n > 0) {
+		if (args->structureInput == NULL) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(buf, args->structureInput, n);
+	}
+	*len = n;
+	return kIOReturnSuccess;
+}
+
+static void
+negroni_aks_unlocked(void)
+{
+	if (negroni_aks_locked) {
+		negroni_aks_post |= NEGRONI_AKS_POST_LOCK_STATUS;
+	}
+	if (!negroni_aks_unlocked_once) {
+		negroni_aks_post |= NEGRONI_AKS_POST_LOCK_STATUS | NEGRONI_AKS_POST_FIRST_UNLOCK;
+	}
+	negroni_aks_locked = false;
+	negroni_aks_unlocked_once = true;
+	negroni_aks_lock_deadline = 0;
+	negroni_aks_failed = 0;
+}
+
+/*
+ * Selector 14: always handle 0 (as 0220), never kIOReturnNotFound. That
+ * answer sends keybagd --init into its own file load, and keybagd reboots
+ * the phone ("FATAL KEYBAG ERROR") on any failure there. Instead the kernel
+ * reads the file at keybagd's first call, once per boot.
+ */
+static IOReturn
+negroni_aks_get_system(IOExternalMethodArguments *args)
+{
+	if (args->scalarOutputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	if ((negroni_aks_options & NEGRONI_AKS_OPT_PASSCODE) && !negroni_aks_system_set &&
+	    negroni_aks_caller_is("keybagd")) {
+		negroni_aks_load_system_file();
+	}
+	args->scalarOutput[0] = NEGRONI_AKS_SYSTEM_HANDLE;
+	args->scalarOutputCount = 1;
+	return kIOReturnSuccess;
+}
+
+/* Selector 6: blob in, handle out. Never fails on content (keybagd reboots then). */
+static IOReturn
+negroni_aks_load_bag(IOExternalMethodArguments *args)
+{
+	uint8_t blob[512];
+	uint32_t len = 0;
+	struct nks_bag bag;
+	const char *what;
+
+	if (args->scalarOutputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	bzero(&bag, sizeof(bag));
+	if (negroni_aks_struct_in(args, blob, sizeof(blob), &len, false) != kIOReturnSuccess) {
+		len = 0;
+		what = "unreadable or large blob: no passcode";
+	} else if (!nks_bag_parse(blob, len, &bag)) {
+		bzero(&bag, sizeof(bag));
+		what = "not a NEGRONI bag: no passcode";
+	} else if (negroni_aks_reset && bag.has_secret) {
+		nks_bag_set_secret(&bag, NULL, 0, NULL, 0);
+		what = "negroniaks_reset=1: stored passcode ignored";
+	} else {
+		what = bag.has_secret ? "passcode set" : "no passcode";
+	}
+	uint64_t h = negroni_aks_temp_alloc(&bag, true);
+	IOLog("NEGRONI AKS: load bag (%u bytes): %s, handle 0x%llx\n", len, what, h);
+	args->scalarOutput[0] = h;
+	args->scalarOutputCount = 1;
+	return kIOReturnSuccess;
+}
+
+/* Selector 5: {handle, system handle, passcode ptr, len}. */
+static IOReturn
+negroni_aks_set_system(IOExternalMethodArguments *args)
+{
+	bool is_temp;
+	struct nks_bag *bag = negroni_aks_bag(args->scalarInputCount > 0 ? args->scalarInput[0] : 0, &is_temp);
+	bool boot = !negroni_aks_system_set;
+
+	args->scalarOutputCount = 0;
+	if (bag == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!is_temp) {
+		return kIOReturnSuccess;        /* already the system bag */
+	}
+	negroni_aks_system = *bag;
+	negroni_aks_system_set = true;
+	negroni_aks_lock_deadline = 0;
+	if (boot) {
+		/* before the first unlock: locked when a passcode is set */
+		negroni_aks_locked = negroni_aks_has_passcode();
+		negroni_aks_unlocked_once = !negroni_aks_locked;
+		negroni_aks_failed = 0;
+	} else if (!negroni_aks_has_passcode()) {
+		negroni_aks_unlocked();
+	}
+	negroni_aks_post |= NEGRONI_AKS_POST_LOCK_STATUS;
+	IOLog("NEGRONI AKS: system bag set (%s, %s, lock state 0x%x)\n",
+	    negroni_aks_system.has_secret ? "passcode set" : "no passcode",
+	    boot ? "boot" : "change", negroni_aks_lock_state());
+	return kIOReturnSuccess;
+}
+
+/* Selector 3: {handle} -> blob. */
+static IOReturn
+negroni_aks_save_bag(IOExternalMethodArguments *args)
+{
+	uint8_t blob[NKS_BLOB_LEN];
+	struct nks_bag *bag = negroni_aks_bag(args->scalarInputCount > 0 ? args->scalarInput[0] : 0, NULL);
+
+	args->scalarOutputCount = 0;
+	if (bag == NULL) {
+		return kIOReturnBadArgument;
+	}
+	nks_bag_serialize(bag, blob);
+	return negroni_aks_struct_out(args, blob, sizeof(blob));
+}
+
+/* Selector 2: {type, generation, passcode ptr, len, 0, 0} -> handle. */
+static IOReturn
+negroni_aks_create_bag(IOExternalMethodArguments *args)
+{
+	uint8_t pc[NKS_PASSCODE_MAX], salt[NKS_SALT_LEN];
+	size_t pclen;
+	struct nks_bag bag;
+	IOReturn ret;
+
+	if (args->scalarInputCount < 4 || args->scalarOutputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	ret = negroni_aks_copyin_secret(args->scalarInput[2], args->scalarInput[3], pc, &pclen);
+	if (ret != kIOReturnSuccess) {
+		return ret;
+	}
+	bzero(&bag, sizeof(bag));
+	read_random(salt, sizeof(salt));
+	nks_bag_set_secret(&bag, pc, pclen, salt, NKS_ITERATIONS);
+	nks_memzero(pc, sizeof(pc));
+	negroni_aks_new_uuid(&bag);
+	args->scalarOutput[0] = negroni_aks_temp_alloc(&bag, false);
+	nks_memzero(&bag, sizeof(bag));
+	if (args->scalarOutput[0] == 0) {
+		args->scalarOutputCount = 0;
+		return kIOReturnNoResources;
+	}
+	args->scalarOutputCount = 1;
+	IOLog("NEGRONI AKS: create bag (%s), handle 0x%llx\n", pclen ? "passcode" : "no passcode",
+	    args->scalarOutput[0]);
+	return kIOReturnSuccess;
+}
+
+/*
+ * Selector 15: {handle, flags, 0xff, old ptr, old len, new ptr, new len, ...}
+ * -> handle. Flag 4: the result goes into a new bag (keybagd then saves it,
+ * makes it the system bag and unloads it); else the bag changes in place.
+ * An empty new passcode turns the passcode off.
+ */
+static IOReturn
+negroni_aks_change_secret(IOExternalMethodArguments *args)
+{
+	uint8_t oldpc[NKS_PASSCODE_MAX], newpc[NKS_PASSCODE_MAX], salt[NKS_SALT_LEN];
+	size_t oldlen, newlen;
+	bool is_temp;
+	struct nks_bag *bag, nb;
+	uint64_t handle, flags, h;
+	IOReturn ret;
+
+	if (args->scalarInputCount < 7 || args->scalarOutputCount < 1) {
+		return kIOReturnBadArgument;
+	}
+	handle = args->scalarInput[0];
+	flags = args->scalarInput[1];
+	bag = negroni_aks_bag(handle, &is_temp);
+	if (bag == NULL) {
+		return kIOReturnBadArgument;
+	}
+	ret = negroni_aks_copyin_secret(args->scalarInput[3], args->scalarInput[4], oldpc, &oldlen);
+	if (ret == kIOReturnSuccess) {
+		ret = negroni_aks_copyin_secret(args->scalarInput[5], args->scalarInput[6], newpc, &newlen);
+	}
+	if (ret != kIOReturnSuccess) {
+		nks_memzero(oldpc, sizeof(oldpc));
+		nks_memzero(newpc, sizeof(newpc));
+		return ret;
+	}
+	if (!nks_bag_verify(bag, oldpc, oldlen)) {
+		nks_memzero(oldpc, sizeof(oldpc));
+		nks_memzero(newpc, sizeof(newpc));
+		IOLog("NEGRONI AKS: change secret: old passcode wrong (handle 0x%llx)\n", handle);
+		return NEGRONI_AKS_BAD_PASSCODE;
+	}
+	nb = *bag;
+	read_random(salt, sizeof(salt));
+	nks_bag_set_secret(&nb, newpc, newlen, salt, NKS_ITERATIONS);
+	negroni_aks_new_uuid(&nb);
+	nks_memzero(oldpc, sizeof(oldpc));
+	nks_memzero(newpc, sizeof(newpc));
+	if (flags & NEGRONI_AKS_FLAG_NEW_BAG) {
+		h = negroni_aks_temp_alloc(&nb, false);
+		if (h == 0) {
+			nks_memzero(&nb, sizeof(nb));
+			return kIOReturnNoResources;
+		}
+	} else {
+		*bag = nb;
+		h = handle;
+		if (!is_temp) {
+			negroni_aks_unlocked();
+			negroni_aks_system_set = true;
+			negroni_aks_post |= NEGRONI_AKS_POST_LOCK_STATUS;
+		}
+	}
+	args->scalarOutput[0] = h;
+	args->scalarOutputCount = 1;
+	IOLog("NEGRONI AKS: change secret: passcode %s (handle 0x%llx flags 0x%llx -> 0x%llx)\n",
+	    nb.has_secret ? "set" : "removed", handle, flags, h);
+	return kIOReturnSuccess;
+}
+
+/*
+ * Selectors 9 / 12: {handle, passcode ptr, len}. Unlocks the device for the
+ * system bag; for a temporary bag it only checks the passcode.
+ */
+static IOReturn
+negroni_aks_unlock(IOExternalMethodArguments *args)
+{
+	uint8_t pc[NKS_PASSCODE_MAX];
+	size_t pclen;
+	bool is_temp, ok;
+	struct nks_bag *bag;
+	IOReturn ret;
+
+	args->scalarOutputCount = 0;
+	if (args->scalarInputCount < 3) {
+		return kIOReturnBadArgument;
+	}
+	bag = negroni_aks_bag(args->scalarInput[0], &is_temp);
+	if (bag == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!is_temp && !negroni_aks_has_passcode()) {
+		return kIOReturnSuccess;
+	}
+	ret = negroni_aks_copyin_secret(args->scalarInput[1], args->scalarInput[2], pc, &pclen);
+	if (ret != kIOReturnSuccess) {
+		return ret;
+	}
+	ok = nks_bag_verify(bag, pc, pclen);
+	nks_memzero(pc, sizeof(pc));
+	if (is_temp) {
+		return ok ? kIOReturnSuccess : NEGRONI_AKS_BAD_PASSCODE;
+	}
+	if (!ok) {
+		negroni_aks_failed++;
+		IOLog("NEGRONI AKS: unlock: wrong passcode (%u since the last unlock)\n", negroni_aks_failed);
+		return NEGRONI_AKS_BAD_PASSCODE;
+	}
+	if (negroni_aks_locked || !negroni_aks_unlocked_once) {
+		IOLog("NEGRONI AKS: unlocked%s\n", negroni_aks_unlocked_once ? "" : " (first unlock since boot)");
+	}
+	negroni_aks_unlocked();
+	return kIOReturnSuccess;
+}
+
+/* Selector 42: {handle} + packed {u32 count; u32 len, bytes, pad to 4; ...}. */
+static IOReturn
+negroni_aks_verify_password(IOExternalMethodArguments *args)
+{
+	uint8_t buf[4 + 4 + NKS_PASSCODE_MAX];
+	uint32_t len = 0, count, plen;
+	struct nks_bag *bag;
+	bool is_temp, ok;
+	IOReturn ret;
+
+	args->scalarOutputCount = 0;
+	bag = negroni_aks_bag(args->scalarInputCount > 0 ? args->scalarInput[0] : 0, &is_temp);
+	if (bag == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!is_temp && !negroni_aks_has_passcode()) {
+		return kIOReturnSuccess;
+	}
+	/* only the first item (the passcode) is used: read a prefix */
+	ret = negroni_aks_struct_in(args, buf, sizeof(buf), &len, true);
+	if (ret != kIOReturnSuccess) {
+		return ret;
+	}
+	if (len < 8) {
+		nks_memzero(buf, sizeof(buf));
+		return kIOReturnBadArgument;
+	}
+	count = nks_get32(buf);
+	plen = nks_get32(buf + 4);
+	if (count < 1 || plen > NKS_PASSCODE_MAX || plen > len - 8) {
+		nks_memzero(buf, sizeof(buf));
+		return kIOReturnBadArgument;
+	}
+	ok = nks_bag_verify(bag, buf + 8, plen);
+	nks_memzero(buf, sizeof(buf));
+	return ok ? kIOReturnSuccess : NEGRONI_AKS_BAD_PASSCODE;
+}
+
+/* Selectors 8 (lock after the grace period), 32 (lock now), 13 (lock bag). */
+static IOReturn
+negroni_aks_lock(uint32_t selector, IOExternalMethodArguments *args)
+{
+	bool is_temp;
+
+	args->scalarOutputCount = 0;
+	(void)negroni_aks_bag(args->scalarInputCount > 0 ? args->scalarInput[0] : 0, &is_temp);
+	if (is_temp || !negroni_aks_has_passcode() || negroni_aks_locked) {
+		return kIOReturnSuccess;        /* no passcode: the device never locks */
+	}
+	if (selector == kAKSLockDevice && negroni_aks_system.grace > 0) {
+		if (negroni_aks_lock_deadline == 0) {
+			uint64_t delta;
+			nanoseconds_to_absolutetime((uint64_t)negroni_aks_system.grace * NSEC_PER_SEC, &delta);
+			negroni_aks_lock_deadline = mach_continuous_time() + delta;
+		}
+		return kIOReturnSuccess;
+	}
+	negroni_aks_locked = true;
+	negroni_aks_lock_deadline = 0;
+	negroni_aks_post |= NEGRONI_AKS_POST_LOCK_STATUS;
+	return kIOReturnSuccess;
+}
+
+/* Selector 30: {handle, DER ptr, DER len}; keeps "gp" (grace period, seconds). */
+static IOReturn
+negroni_aks_set_configuration(IOExternalMethodArguments *args)
+{
+	uint8_t der[1024];
+	uint32_t gp;
+	uint64_t len;
+
+	args->scalarOutputCount = 0;
+	if (args->scalarInputCount < 3) {
+		return kIOReturnBadArgument;
+	}
+	len = args->scalarInput[2];
+	if (args->scalarInput[1] == 0 || len == 0 || len > sizeof(der)) {
+		return kIOReturnBadArgument;
+	}
+	if (copyin((user_addr_t)args->scalarInput[1], der, (size_t)len) != 0) {
+		return kIOReturnVMError;
+	}
+	if (nks_der_find_int(der, (size_t)len, "gp", &gp)) {
+		if (gp != negroni_aks_system.grace) {
+			IOLog("NEGRONI AKS: grace period %u s\n", gp);
+		}
+		negroni_aks_system.grace = gp;
+	}
+	nks_memzero(der, sizeof(der));         /* may hold the passcode ("pc") */
+	return kIOReturnSuccess;
+}
