 /* 0277: log = false logs only a failure (bounded): the loop re-sends the same values every 5 s. */
+/*
+ * 0370: write classes for bisecting (boot-arg negronichg_wr, bit set = allowed; default 0x7f all) and a delay
+ * after the client start before any write (negronichg_wr_delay_s, default 0). Every write logs +ms since start.
+ */
+#define WR_ICL          0x01u   /* USB_INPUT_CURR_LIMIT (5) */
+#define WR_SUSPEND      0x02u   /* USB_SUSPEND_PMIC (26) */
+#define WR_CHG_EN       0x04u   /* BATT_CHG_EN (24) */
+#define WR_FV_FCC       0x08u   /* BATT_VOLT_MAX (8), BATT_CHG_CTRL_LIM (10) */
+#define WR_VOOC         0x10u   /* USB 13, 25; BATT 28, 29, 37 (0369) */
+#define WR_NOTIFY       0x20u   /* BC_SET_NOTIFY_REQ */
+#define WR_OTHER        0x40u
+
+static uint32_t
+wr_class(uint32_t opcode, uint32_t prop)
+{
+	if (opcode == BC_USB_SET) {
+		return prop == USB_INPUT_CURR_LIMIT ? WR_ICL : prop == USB_SUSPEND_PMIC ? WR_SUSPEND :
+		       (prop == 13u || prop == 25u) ? WR_VOOC : WR_OTHER;
+	}
+	if (opcode == BC_BATTERY_SET) {
+		return prop == BATT_CHG_EN ? WR_CHG_EN : (prop == BATT_VOLT_MAX || prop == BATT_CHG_CTRL_LIM) ? WR_FV_FCC :
+		       (prop == 28u || prop == 29u || prop == 37u) ? WR_VOOC : WR_OTHER;
+	}
+	return WR_OTHER;
+}
+
+/* false: this write class is off (negronichg_wr) or the start delay runs (logged once per class) */
+static bool
+wr_allowed(uint32_t cls, const char *what)
+{
+	bool delay = wr_delay_s && now_ns() - start_ns < (uint64_t)wr_delay_s * NSEC_PER_SEC;
+	if (wr_safety || ((wr_mask & cls) && !delay)) {
+		return true;
+	}
+	if (!(wr_skip_logged & cls) || delay) {
+		if (!(wr_skip_logged & cls)) {
+			LOG("write %s skipped: %s (class %#x)", what, delay ? "negronichg_wr_delay_s runs" : "off by negronichg_wr", cls);
+		}
+		wr_skip_logged |= cls;
+	}
+	return false;
+}
