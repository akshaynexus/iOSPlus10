+	uint16_t    port;
+	char        text[64];
+} ud_preply[UD_PANIC_REPLIES];
+static unsigned ud_preply_head, ud_preply_count;
+static bool     ud_panic_ok, ud_panic_busy;
+static int      ud_panic_action = -1;
+static uint64_t ud_panic_pos;           /* next console ring byte to send */
+static uint64_t ud_panic_tx_at;         /* start time of the frame on the IN endpoint */
+static uint64_t ud_panic_tx_timeout;    /* 2 s in absolute time units */
+static uint32_t ud_panic_tx_len;        /* its length (sent again after a timeout) */
+static uint32_t ud_panic_tx_rsc;        /* its transfer resource index (for ENDTRANSFER) */
+static unsigned ud_panic_txq_left;      /* frames of ud.txq not looked at yet */
+static uint32_t ud_panic_timeouts;
+static bool     ud_panic_host_seen;     /* a frame from 192.168.7.1 came since the last configuration */
+static bool     ud_panic_was_configured;
+static uint64_t ud_panic_conf_at;       /* time of that configuration */
+static uint64_t ud_panic_host_wait;     /* 10 s: then the ring is sent without a sign of the host */
+static uint64_t ud_panic_gap, ud_panic_last;    /* log frames at most one per 1 ms (1.4 MB/s) */
+static const uint8_t ud_host_ip[4] = { 192, 168, 7, 1 };
+
+static void
+ud_panic_queue(int kind, const uint8_t *mac, const uint8_t *ip, uint16_t port, const char *text)
+{
+	if (ud_preply_count == UD_PANIC_REPLIES) {
+		return;                         /* full: the host asks again */
+	}
+	unsigned i = (ud_preply_head + ud_preply_count) % UD_PANIC_REPLIES;
+	ud_preply[i].kind = (uint8_t)kind;
+	memcpy(ud_preply[i].mac, mac, ETHER_ADDR_LEN);
+	memcpy(ud_preply[i].ip, ip, 4);
+	ud_preply[i].port = port;
+	strlcpy(ud_preply[i].text, text != NULL ? text : "", sizeof(ud_preply[i].text));
+	ud_preply_count++;
+}
+
+/* One received frame in panic mode: ARP for 192.168.7.2, or a command on UDP 5141. */
+static void
+ud_panic_rx(const uint8_t *f, uint32_t len)
+{
+	uint16_t type = ud_be16(f + 12);
+
+	/*
+	 * Any ARP or IPv4 frame from 192.168.7.1 shows that the host has its
+	 * address (usblog.sh sends "settime" when the link comes up): only then
+	 * the console ring is sent, so the panic text does not go out before
+	 * the host can receive it.
+	 */
+	if ((type == ETHERTYPE_ARP && len >= ETHER_HDR_LEN + 28 && ud_be32(f + ETHER_HDR_LEN + 14) == UD_IP_HOST) ||
+	    (type == ETHERTYPE_IP && len >= ETHER_HDR_LEN + 20 && ud_be32(f + ETHER_HDR_LEN + 12) == UD_IP_HOST)) {
+		ud_panic_host_seen = true;
+	}
+	if (type == ETHERTYPE_ARP) {
+		const uint8_t *a = f + ETHER_HDR_LEN;
+		if (len >= ETHER_HDR_LEN + 28 && ud_be16(a) == 1 && ud_be16(a + 2) == ETHERTYPE_IP &&
+		    a[4] == ETHER_ADDR_LEN && a[5] == 4 && ud_be16(a + 6) == 1 && ud_be32(a + 24) == UD_IP_PHONE) {
+			ud_panic_queue(UD_PREPLY_ARP, a + 8, a + 14, 0, NULL);  /* sender MAC and IP */
+		}
+		return;
+	}
+	if (!ud.ctl_enabled || type != ETHERTYPE_IP || len < ETHER_HDR_LEN + 20 + 8) {
+		return;
+	}
+	const uint8_t *ip = f + ETHER_HDR_LEN;
+	uint32_t ihl = (ip[0] & 0xfu) * 4, tot = ud_be16(ip + 2);
+	if ((ip[0] >> 4) != 4 || ihl < 20 || ip[9] != IPPROTO_UDP || tot < ihl + 8 ||
+	    ETHER_HDR_LEN + tot > len || (ud_be16(ip + 6) & 0x3fff) != 0) {
+		return;
+	}
+	const uint8_t *udp = ip + ihl;
+	uint32_t ulen = ud_be16(udp + 4);
+	if (ud_be32(ip + 16) != UD_IP_PHONE || ud_be16(udp + 2) != UD_CTL_PORT || ud_be32(ip + 12) != UD_IP_HOST ||
+	    ud_sum_fold(ud_sum_add(0, ip, ihl)) != 0 || ulen < 8 || ulen > tot - ihl) {
+		return;
+	}
+	char cmd[32];
+	uint32_t n = ulen - 8;
+	const uint8_t *p = udp + 8;
+	while (n > 0 && (p[n - 1] == '\n' || p[n - 1] == '\r' || p[n - 1] == ' ' ||
+	    p[n - 1] == '\t' || p[n - 1] == 0)) {
+		n--;
+	}
+	if (n >= sizeof(cmd)) {
+		n = sizeof(cmd) - 1;            /* too long: no command matches */
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		cmd[i] = (p[i] >= 0x20 && p[i] < 0x7f) ? (char)p[i] : '?';
+	}
+	cmd[n] = 0;
+
+	const char *reply;
+	char text[64];
+	int action = -1;
+	if (strcmp(cmd, "ping") == 0) {
+		reply = "pong (panic)";
+	} else if (strcmp(cmd, "log") == 0) {
+		uint64_t end = negroni_log_position();
+		ud_panic_pos = end > 65536 ? end - 65536 : 0;
+		reply = "ok log (panic)";
+	} else if (strcmp(cmd, "reboot") == 0 || strcmp(cmd, "recovery") == 0 ||
+	    strcmp(cmd, "bootloader") == 0 || strcmp(cmd, "poweroff") == 0) {
+		if (ud_panic_busy || ud_panic_action >= 0) {
+			reply = "error: busy";
+		} else {
+			action = cmd[0] == 'r' ? (cmd[2] == 'b' ? 0 : 1) :
+			    cmd[0] == 'b' ? 2 : NEGRONI_PANIC_ACT_POWEROFF;
+			snprintf(text, sizeof(text), "ok %s (panic)", cmd);
+			reply = text;
+		}
+	} else if (strcmp(cmd, "panic") == 0) {
+		reply = "error: already in panic";
+	} else {
+		reply = "error: panic mode: ping log reboot bootloader recovery poweroff";
+	}
+	printf("NEGRONI PANIC CTL: \"%s\" -> %s\n", cmd, reply);
+	ud_panic_queue(UD_PREPLY_UDP, f + ETHER_ADDR_LEN, ip + 12, ud_be16(udp), reply);
+	if (action >= 0) {
+		ud_panic_action = action;
+	}
+}
+
+/* The frame in the TX buffer (len bytes) goes out on the IN endpoint. */
+static void
+ud_panic_tx_start(uint32_t len)
+{
+	uint8_t *buf = (uint8_t *)(ud.dma + UD_TX);
+
+	if ((len % 512) == 0) {
+		buf[len++] = 0;                 /* as ud_tx_kick_locked: no zero-length packet needed */
+	}
+	ud_panic_tx_len = len;
+	ud.tx_busy = true;
+	ud.tx_frames++;
+	ud_panic_tx_at = mach_absolute_time();
+	ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, len, TRBCTL_NORMAL);
+	ud_panic_tx_rsc = (dwc_rd(DEPCMD(EP_TX)) >> 16) & 0x7f;
+}
+
+/* A log frame from before the panic (UDP to 5140, or a 5141 reply): worth sending. */
+static bool
+ud_panic_is_log_frame(const uint8_t *f, uint32_t len)
+{
+	const uint8_t *ip = f + ETHER_HDR_LEN;
+	if (len < ETHER_HDR_LEN + 20 + 8 || ud_be16(f + 12) != ETHERTYPE_IP || ip[9] != IPPROTO_UDP) {
+		return false;
+	}
+	uint32_t ihl = (ip[0] & 0xfu) * 4;
+	if (ihl < 20 || ETHER_HDR_LEN + ihl + 8 > len) {
+		return false;
+	}
+	const uint8_t *udp = ip + ihl;
+	return ud_be16(udp + 2) == 5140 || ud_be16(udp) == UD_CTL_PORT;
+}
+
+static void
+ud_panic_tx_next(void)
+{
+	uint8_t *f = (uint8_t *)(ud.dma + UD_TX);
+
+	if (ud_preply_count > 0) {
+		unsigned i = ud_preply_head;
+		ud_preply_head = (ud_preply_head + 1) % UD_PANIC_REPLIES;
+		ud_preply_count--;
+		if (ud_preply[i].kind == UD_PREPLY_ARP) {
+			/* ARP reply: 192.168.7.2 is at 02:00:5e:77:ee:02 */
+			bzero(f, ETHER_HDR_LEN + 28);
+			memcpy(f, ud_preply[i].mac, ETHER_ADDR_LEN);
+			memcpy(f + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+			ud_put16(f + 12, ETHERTYPE_ARP);
+			uint8_t *a = f + ETHER_HDR_LEN;
+			ud_put16(a, 1);
+			ud_put16(a + 2, ETHERTYPE_IP);
+			a[4] = ETHER_ADDR_LEN;
+			a[5] = 4;
+			ud_put16(a + 6, 2);
+			memcpy(a + 8, ud_phone_mac, ETHER_ADDR_LEN);
+			ud_put32(a + 14, UD_IP_PHONE);
+			memcpy(a + 18, ud_preply[i].mac, ETHER_ADDR_LEN);
+			memcpy(a + 24, ud_preply[i].ip, 4);
+			ud_panic_tx_start(ETHER_HDR_LEN + 28);
+		} else {
+			ud_panic_tx_start(ud_udp_build(f, ud_preply[i].mac, ud_preply[i].ip, UD_CTL_PORT,
+			    ud_preply[i].port, ud_preply[i].text, (uint32_t)strlen(ud_preply[i].text)));
+		}
+		return;
+	}
+	uint64_t now = mach_absolute_time();
+	if (!ud_panic_host_seen && now - ud_panic_conf_at < ud_panic_host_wait) {
+		return;                         /* the host may not have 192.168.7.1 yet */
+	}
+	if (now - ud_panic_last < ud_panic_gap) {
+		return;                         /* pace: the host's UDP receive buffer is not unlimited */
+	}
+	ud_panic_last = now;
+	while (ud_panic_txq_left > 0 && ud.txq_count > 0) {
+		mbuf_t m = ud.txq[ud.txq_head];
+		ud.txq_head = (ud.txq_head + 1) % UD_TXQ;
+		ud.txq_count--;
+		ud_panic_txq_left--;
+		/* not freed: no allocator calls in panic context */
+		size_t len = mbuf_pkthdr_len(m);
+		if (len > ETHER_MAX_LEN - ETHER_CRC_LEN || mbuf_copydata(m, 0, len, f) != 0 ||
+		    !ud_panic_is_log_frame(f, (uint32_t)len)) {
+			continue;
 		}
+		ud_panic_tx_start((uint32_t)len);
+		return;
+	}
+	uint32_t n = negroni_log_copy(&ud_panic_pos, (char *)f + ETHER_HDR_LEN + 20 + 8, UD_PANIC_CHUNK);
+	if (n > 0) {
+		ud_panic_tx_start(ud_udp_build(f, ud_host_mac, ud_host_ip, 5140, 5140,
+		    f + ETHER_HDR_LEN + 20 + 8, n));
+	}
+}
+
+/* Once, from negroni_panic_restart(). false: no USB in this panic (not started, or negronipanicusb=0). */
+bool
+negroni_usb_panic_begin(void)
+{
+	if (ud_in_panic) {
+		return ud_panic_ok;
+	}
+	if (!ud_panic_enabled || !ud_running || ud.dwc == 0 || ud.dma == 0) {
+		return false;
+	}
+	ud_in_panic = true;
+	nanoseconds_to_absolutetime(2 * NSEC_PER_SEC, &ud_panic_tx_timeout);
+	nanoseconds_to_absolutetime(10 * NSEC_PER_SEC, &ud_panic_host_wait);
+	nanoseconds_to_absolutetime(NSEC_PER_MSEC, &ud_panic_gap);
+	/* the live log reached the host before the panic: no need to wait for it */
+	ud_panic_host_seen = ud.configured && ud.rx_frames > 0;
+	ud_panic_was_configured = ud.configured;
+	ud_panic_conf_at = mach_absolute_time();
+	uint64_t end = negroni_log_position(), from = ud_log_sent;
+	if (from > end || end - from > UD_PANIC_RING_MAX) {
+		from = end > UD_PANIC_RING_MAX ? end - UD_PANIC_RING_MAX : 0;
+	}
+	ud_panic_pos = from;
+	ud_panic_txq_left = ud.txq_count;
+	if (ud.tx_busy) {
+		/* a frame of the normal path is on the endpoint: give it the same 2 s */
+		volatile uint32_t *t = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
+		ud_sync(UD_TRB_TX, 16);
+		uint32_t len = t[2] & 0xffffff;
+		ud_panic_tx_len = (len > 0 && len < UD_FRAME_MAX) ? len : 0;
+		ud_panic_tx_rsc = (dwc_rd(DEPCMD(EP_TX)) >> 16) & 0x7f;
+		ud_panic_tx_at = mach_absolute_time();
+	}
+	ud_panic_ok = true;
+	kdb_printf("NEGRONI PANIC: USB %s: console ring %llu bytes to send, %u frames queued; "
+	    "commands on udp 192.168.7.2:%u %s\n", ud.configured ? "configured" : "not configured (waiting for the host)",
+	    end - from, ud.txq_count, UD_CTL_PORT, ud.ctl_enabled ? "on" : "off");
+	return true;
+}
+
+/*
+ * One step of the panic loop. busy: the caller still has an action to run
+ * (new reset commands get "error: busy"). Returns -1, a reboot reason
+ * (0 normal, 1 recovery, 2 bootloader) or NEGRONI_PANIC_ACT_POWEROFF.
+ */
+int
+negroni_usb_panic_service(bool busy)
+{
+	if (!ud_panic_ok) {
+		return -1;
+	}
+	ud_panic_busy = busy;
+	uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+	if (count > UD_EVT_SIZE) {
+		count = UD_EVT_SIZE;
+	}
+	if (count) {
+		ud_sync(UD_EVT, UD_EVT_SIZE);
+		for (uint32_t done = 0; done + 4 <= count; done += 4) {
+			uint32_t ev = *(volatile uint32_t *)(ud.dma + UD_EVT + ud.evt_pos);
+			ud.evt_pos = (ud.evt_pos + 4) % UD_EVT_SIZE;
+			dwc_wr(GEVNTCOUNT, 4);
+			ud_event(ev);
+		}
+	}
+	if (ud.configured != ud_panic_was_configured) {
+		ud_panic_was_configured = ud.configured;
+		if (ud.configured) {            /* (re)enumerated in panic mode: wait for the host's address */
+			ud_panic_host_seen = false;
+			ud_panic_conf_at = mach_absolute_time();
+		}
+	}
+	if (ud.tx_busy && mach_absolute_time() - ud_panic_tx_at > ud_panic_tx_timeout) {
+		/* The host did not take the frame in 2 s: end the transfer and start it again. */
+		(void)ud_epcmd(EP_TX, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | (ud_panic_tx_rsc << 16), 0, 0, 0);
+		ud_udelay(100);
+		ud.tx_busy = false;
+		ud_panic_timeouts++;
+		if (ud.configured && ud_panic_tx_len > 0) {
+			uint32_t len = ud_panic_tx_len;
+			ud.tx_frames--;
+			ud_panic_tx_start(len);
+		}
+	}
+	if (ud.configured && !ud.tx_busy) {
+		ud_panic_tx_next();
 	}
+	int action = ud_panic_action;
+	ud_panic_action = -1;
+	return action;
 }
 
