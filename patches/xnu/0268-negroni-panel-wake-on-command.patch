+/*
+ * 0268: INTF_1 of the DSI display for the backlight's panel wake (NegroniBacklight.cpp
+ * wakePanel): pause the auto-refresh during the on-command, re-arm it after, and sample the
+ * TE and frame counters. Registers: sde_hw_intf.c:80-95 (INTF_TEAR_AUTOREFRESH_CONFIG 0x2B4,
+ * bit 31 enable, [15:0] frames per refresh; sde_hw_intf_setup_autorefresh_config :668-686),
+ * INTF_FRAME_COUNT 0xAC, the tear interrupt block +0x800 (sde_hw_interrupts.c:24-26).
+ */
+extern "C" bool negroni_fb_autorefresh_pause(uint32_t *saved);
+extern "C" void negroni_fb_autorefresh_resume(uint32_t saved);
+extern "C" bool negroni_fb_te_check(uint32_t *te, uint32_t *frames, uint32_t *tear, bool *rearmed);
+
+static vm_offset_t
+negroni_fb_intf(void)
+{
+	AppleCLCD *fb = negroni_fb_main;
+
+	if (fb == NULL) {
+		return 0;
+	}
+	return fb->fIntf != 0 ? fb->fIntf : fb->fMdss != 0 ? fb->fMdss + NEGRONI_INTF1_OFF : fb->fIntfWake;
+}
+
+extern "C" bool
+negroni_fb_autorefresh_pause(uint32_t *saved)
+{
+	vm_offset_t intf = negroni_fb_intf();
+
+	if (intf == 0) {
+		return false;
+	}
+	uint32_t ar = negroni_dpu_rd(intf + INTF_TEAR_AUTOREFRESH_CONFIG);
+	*saved = ar;
+	if (!(ar & (1u << 31))) {
+		return false;
+	}
+	negroni_dpu_wr(intf + INTF_TEAR_AUTOREFRESH_CONFIG, ar & ~(1u << 31));
+	__asm__ volatile ("dsb sy" ::: "memory");
+	return true;
+}
+
+extern "C" void
+negroni_fb_autorefresh_resume(uint32_t saved)
+{
+	vm_offset_t intf = negroni_fb_intf();
+
+	if (intf == 0 || !(saved & (1u << 31))) {
+		return;
+	}
+	if (negroni_dpu_rd(intf + INTF_TEAR_AUTOREFRESH_CONFIG) & (1u << 31)) {
+		return;         /* 0259's VRR wake wrote it meanwhile */
+	}
+	negroni_dpu_wr(intf + INTF_TEAR_AUTOREFRESH_CONFIG, saved);
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/*
+ * 50 ms of TE pulses (INT_COUNT_VAL frame field), INTF frames and the latched tear interrupt
+ * bits. TE pulses but no frame sign (no INTF frame, no AUTOREFRESH_DONE/WR_PTR bit): the
+ * auto-refresh is switched off and on once (re-arm) and measured again. Thread context.
+ */
+extern "C" bool
+negroni_fb_te_check(uint32_t *te, uint32_t *frames, uint32_t *tear, bool *rearmed)
+{
+	vm_offset_t intf = negroni_fb_intf();
+
+	*rearmed = false;
+	if (intf == 0) {
+		return false;
+	}
+	for (uint32_t pass = 0; pass < 2; pass++) {
+		negroni_dpu_wr(intf + INTF_TEAR_INTR_CLEAR, 0x1f);
+		uint32_t c0 = negroni_dpu_rd(intf + INTF_TEAR_INT_COUNT_VAL) >> 16, f0 = negroni_dpu_rd(intf + INTF_FRAME_COUNT);
+		IOSleep(50);
+		uint32_t c1 = negroni_dpu_rd(intf + INTF_TEAR_INT_COUNT_VAL) >> 16, f1 = negroni_dpu_rd(intf + INTF_FRAME_COUNT);
+		*te = (c1 - c0) & 0xffffu;
+		*frames = f1 - f0;
+		*tear = negroni_dpu_rd(intf + INTF_TEAR_INTR_STATUS) & 0x1fu;
+		bool sent = *frames != 0 || (*tear & 0x3u) != 0;
+		uint32_t ar = negroni_dpu_rd(intf + INTF_TEAR_AUTOREFRESH_CONFIG);
+		if (pass == 1 || *te == 0 || sent || !(ar & (1u << 31))) {
+			break;
+		}
+		negroni_dpu_wr(intf + INTF_TEAR_AUTOREFRESH_CONFIG, ar & ~(1u << 31));
+		__asm__ volatile ("dsb sy" ::: "memory");
+		IODelay(100);
+		negroni_dpu_wr(intf + INTF_TEAR_AUTOREFRESH_CONFIG, ar);
+		__asm__ volatile ("dsb sy" ::: "memory");
+		*rearmed = true;
+	}
+	return true;
+}
