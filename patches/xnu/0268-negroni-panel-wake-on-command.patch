+ * 0x29 (94 packets, live.dts line 35658). Then the MIPI PPS packet (0x0A, 128
+ * bytes, the PPS the UEFI programmed with the DPU's DSC encoders).
+ * During the set the DPU auto-refresh is paused (INTF_TEAR_AUTOREFRESH_CONFIG bit
+ * 31 off, as _sde_encoder_autorefresh_disable_seq1 sde_encoder_phys_cmd.c:2015 does
+ * before a commit): no frame transfer between the packets once 0x11 restarts the
+ * TE. After it the auto-refresh is re-armed (0x80000001) and the TE and frame
+ * counters are sampled for 50 ms (negroni_fb_te_check). The DSI controller
+ * itself is not touched by the panel's sleep (its clocks and command engine stay
+ * as the UEFI left them; Android re-inits it only after its own clock/power-off:
+ * dsi_display.c dsi_display_enable with continuous splash skips it too), so there
+ * is no controller re-init. negronifb_wake=1: the on-command without the
+ * packets that need the memory DMA (9E PPS, 0x0A PPS); =0: the 0258 sleep-out
+ * (0x11, 133 ms, 0x29). Backlight work loop.
+ */
+const char *
+AppleARMBacklight::wakePanel(char *info, size_t size)
+{
+	const char *wake;
+	uint32_t ar = 0;
+
+	if (negroni_dsi == NULL || negroni_dsi_dead) {
+		return "failed";
+	}
+	if (fWakeMode == 0) {
+		uint8_t c = 0x11;               /* exit_sleep_mode (mdss-dsi-on-command: 12 + 121 ms to 0x29) */
+		int rc = negroni_dsi_dcs_write(&c, 1, fLP);
+		if (rc != 0 || negroni_dsi_dead) {
+			/* no sleep-out: the wait and 0x29 are useless, restore DBV now; the next wake retries */
+			return "failed";
+		}
+		IOSleep(NEGRONI_BL_SLEEP_OUT_WAIT_MS);
+		c = 0x29;                       /* set_display_on */
+		int rc2 = negroni_dsi_dcs_write(&c, 1, fLP);
+		fPanelOn = true;
+		snprintf(info, size, "sleep-out 0x11/0x29 (negronifb_wake=0)");
+		return rc2 == 0 ? "ok" : "failed";
+	}
+	bool paused = negroni_fb_autorefresh_pause(&ar);
+	if (paused) {
+		/* _sde_encoder_autorefresh_disable_seq1: a frame still on its way ends first */
+		for (uint32_t i = 0; i < 1000 && (ndsi_rd(NDSI_STATUS) & NDSI_STATUS_MDP_BUSY); i++) {
+			IODelay(20);
+		}
+	}
+	struct negroni_dsi_set_result r;
+	int rc = negroni_dsi_dcs_set_ex(negroni_panel_on_command, sizeof(negroni_panel_on_command), fLP,
+	    NDSI_SET_GO_ON | (fWakeMode < 2 ? NDSI_SET_SKIP_LONG : 0), &r);
+	bool complete = r.packets == NEGRONI_PANEL_ON_PACKETS && (rc == 0 || r.longFailed != 0);
+	const char *pps = "PPS skipped (negronifb_wake=1)";
+	int prc = 0;
+	if (fWakeMode >= 2) {
+		if (complete && !negroni_dsi_dead) {
+			prc = negroni_dsi_long_packet(0x0a, negroni_panel_pps, sizeof(negroni_panel_pps), fLP);
+		}
+		pps = !complete ? "PPS not sent (set incomplete)" :
+		    r.longSent == 1 && prc == 0 ? "PPS ok" :
+		    r.longSent == 1 ? "PPS 9E ok, 0x0A failed" : "PPS failed";
+	}
+	bool rearmed = false;
+	if (paused) {
+		negroni_fb_autorefresh_resume(ar);
+	}
+	uint32_t te = 0, frames = 0, tear = 0;
+	bool sampled = negroni_fb_te_check(&te, &frames, &tear, &rearmed);
+	/* a set that broke off before its end: the next wake sends it again */
+	fPanelOn = complete || (r.sent != 0 && negroni_dsi_dead);
+	if (sampled) {
+		snprintf(info, size, "on-command %u packets%s, %s, TE %s: %u TE %u frames tear 0x%x in 50 ms%s, autorefresh 0x%08x%s",
+		    r.sent, r.skipped ? " (long ones skipped)" : "", pps, te != 0 ? "on" : "MISSING", te, frames, tear,
+		    rearmed ? " (re-armed)" : "", ar, paused ? " paused+resumed" : "");
+	} else {
+		snprintf(info, size, "on-command %u packets%s, %s, TE not sampled (no INTF_1 mapping)", r.sent,
+		    r.skipped ? " (long ones skipped)" : "", pps);
+	}
+	wake = complete ? (rc == 0 && prc == 0 ? "ok" : "ok except PPS") : "failed";
+	if (!complete) {
+		IOLog("NEGRONI BL: on-command stopped at packet %u of %u (rc %d)\n", r.packets, NEGRONI_PANEL_ON_PACKETS, rc);
+	}
+	return wake;
+}
