+/* ---- per-client tables (negronigpu_pt=1) ---- */
+
+bool
+negroni_gpu_per_client(void)
+{
+	return gpu_per_client;
+}
+
+/* A zeroed 4K table of vm's (tables come four to a PAGE_SIZE page, given back with the vm). */
+static uint64_t *
+vm_new_table(struct negroni_gpu_vm *vm)
+{
+	uint64_t *table;
+
+	if (vm->tables_left == 0) {
+		vm_offset_t page = 0;
+		if (vm->page_count == GPU_VM_PAGES ||
+		    kmem_alloc(kernel_map, &page, PAGE_SIZE, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		vm->pages[vm->page_count++] = page;
+		vm->tables_left = PAGE_SIZE / 4096;
+	}
+	table = (uint64_t *)(vm->pages[vm->page_count - 1] + PAGE_SIZE - 4096 * vm->tables_left--);
+	to_memory((vm_offset_t)table, 4096);    /* zeroed: the walker must not see old lines */
+	return table;
+}
+
+/* The level-3 entry for address in vm's tables (made on the way when make is set), or NULL. */
+static uint64_t *
+vm_entry(struct negroni_gpu_vm *vm, uint64_t address, bool make)
+{
+	uint64_t *table = vm->root;
+
+	for (unsigned shift = 30; shift >= 21; shift -= 9) {
+		uint64_t *entry = &table[(address >> shift) & 0x1ff];
+		if (*entry & 1) {
+			table = (uint64_t *)phystokv(*entry & PTE_ADDRESS);
+			continue;
+		}
+		if (!make || (table = vm_new_table(vm)) == NULL) {
+			return NULL;
+		}
+		*entry = kvtophys((vm_offset_t)table) | PTE_TABLE;
+		to_memory((vm_offset_t)entry, sizeof(*entry));
+	}
+	return &table[(address >> 12) & 0x1ff];
+}
+
+/*
+ * A client's tables: a root whose kernel entries are the kernel's (the same level-2 tables, made
+ * at gpu_keep), its own address list. NULL when negronigpu_pt is 0 or there is no memory.
+ * gGPULock held (NegroniGPU.cpp), as for every negroni_gpu_vm_* call.
+ */
+struct negroni_gpu_vm *
+negroni_gpu_vm_create(void)
+{
+	struct negroni_gpu_vm *vm = NULL;
+
+	if (!gpu_per_client || !gpu_kept || core_space.root == NULL ||
+	    kmem_alloc(kernel_map, (vm_offset_t *)&vm, round_page(sizeof(*vm)), KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return NULL;
+	}
+	vm->root = vm_new_table(vm);
+	if (vm->root == NULL) {
+		(void)negroni_gpu_vm_destroy(vm);
+		return NULL;
+	}
+	for (unsigned i = 0; i < GPU_KERNEL_ROOTS; i++) {
+		vm->root[i] = core_space.root[i];
+	}
+	to_memory((vm_offset_t)vm->root, 4096);
+	vm->root_phys = kvtophys((vm_offset_t)vm->root);
+	vm->heap.free = vm->ranges;
+	vm->heap.cap = sizeof(vm->ranges) / sizeof(vm->ranges[0]);
+	vm->ranges[0].start = GPU_VM_HEAP_START;
+	vm->ranges[0].size = GPU_VM_HEAP_SIZE;
+	vm->heap.count = 1;
+	return vm;
+}
+
+/*
+ * Its tables given back. The 3D core must not be able to walk them: when they are the context's
+ * now, the context goes back to the kernel's tables first (the caller waited for the GPU); if that
+ * cannot be done, everything stays allocated (false: leaked on purpose).
+ */
+bool
+negroni_gpu_vm_destroy(struct negroni_gpu_vm *vm)
+{
+	if (vm == NULL) {
+		return true;
+	}
+	if (vm->root_phys != 0 && gpu_root_current == vm->root_phys && !negroni_gpu_vm_switch(NULL)) {
+		printf("NEGRONI GPU: a client's tables are still the GPU's: kept\n");
+		return false;
+	}
+	for (unsigned i = 0; i < vm->page_count; i++) {
+		kmem_free(kernel_map, vm->pages[i], PAGE_SIZE);
+	}
+	kmem_free(kernel_map, (vm_offset_t)vm, round_page(sizeof(*vm)));
+	return true;
+}
+
+/* vm NULL: the kernel's addresses. */
+uint64_t
+negroni_gpu_vm_address(struct negroni_gpu_vm *vm, uint64_t size)
+{
+	return vm == NULL ? negroni_gpu_address(size) : heap_alloc(&vm->heap, size);
+}
+
+void
+negroni_gpu_vm_address_free(struct negroni_gpu_vm *vm, uint64_t address, uint64_t size)
+{
+	if (vm == NULL) {
+		negroni_gpu_address_free(address, size);
+	} else {
+		heap_free(&vm->heap, address, size);
+	}
+}
+
+/* One 4K page at a client address (never in the kernel's part); vm NULL: the kernel's tables. */
+bool
+negroni_gpu_vm_map(struct negroni_gpu_vm *vm, uint64_t address, uint64_t phys, bool read_only)
+{
+	uint64_t *entry;
+
+	if (vm == NULL) {
+		return negroni_gpu_map(address, phys, read_only);
+	}
+	if ((address >> 39) || (address >> 30) < GPU_KERNEL_ROOTS || phys == 0 ||
+	    (entry = vm_entry(vm, address, true)) == NULL) {
+		return false;
+	}
+	*entry = phys | PTE_GMU | PTE_UNPRIVILEGED | (read_only ? PTE_READ_ONLY : 0) | PTE_PAGE;
+	to_memory((vm_offset_t)entry, sizeof(*entry));
+	return true;
+}
+
+void
+negroni_gpu_vm_unmap(struct negroni_gpu_vm *vm, uint64_t address, uint64_t size)
+{
+	if (vm == NULL) {
+		negroni_gpu_unmap(address, size);
+		return;
+	}
+	for (uint64_t offset = 0; offset < size; offset += 4096) {
+		uint64_t a = address + offset, *entry;
+		if (!(a >> 39) && (a >> 30) >= GPU_KERNEL_ROOTS && (entry = vm_entry(vm, a, false)) != NULL) {
+			*entry = 0;
+			to_memory((vm_offset_t)entry, sizeof(*entry));
+		}
+	}
+	negroni_gpu_vm_mapped(vm);
+}
+
+/* After map/unmap: the TLB forgotten if these are the context's tables now (the next switch flushes it otherwise). */
+void
+negroni_gpu_vm_mapped(struct negroni_gpu_vm *vm)
+{
+	if (vm == NULL || gpu_root_current == vm->root_phys) {
+		negroni_gpu_mapped();
+	}
+}
+
+/* vm's tables (NULL: the kernel's) are the 3D core's context's now. */
+bool
+negroni_gpu_vm_current(const struct negroni_gpu_vm *vm)
+{
+	return gpu_root_current == (vm != NULL ? vm->root_phys : core_space.tables[0].phys);
+}
+
+/*
+ * The 3D core's context to vm's tables (NULL: the kernel's). Only while the core is idle: every
+ * submission's fence done (the caller waits for negroni_gpu_last() first) and the ring read to its
+ * end. false: not idle, or the context did not take the new TTBR0.
+ */
+bool
+negroni_gpu_vm_switch(struct negroni_gpu_vm *vm)
+{
+	static unsigned logged;
+	uint64_t root = vm != NULL ? vm->root_phys : core_space.tables[0].phys;
+	uint64_t ttbr = root | (uint64_t)core_space.context << 48;
+	uint32_t cb = smmu_cb(&core_space), rptr = ~0u;
+
+	if (!gpu_kept || root == 0) {
+		return false;
+	}
+	if (root == gpu_root_current) {
+		return true;
+	}
+	if (!negroni_gpu_done(gpu_fence)) {
+		return false;
+	}
+	for (unsigned i = 0; i < GPU_IDLE_US / 10 && (rptr = rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR))) != ring_at; i++) {
+		delay(10);
+	}
+	if (rptr != ring_at) {
+		printf("NEGRONI GPU: no table switch: the ring is read to %u of %u\n", rptr, ring_at);
+		return false;
+	}
+	__asm__ volatile ("dsb sy");
+	wr(smmu + cb + SMMU_CB_TTBR0, (uint32_t)ttbr);
+	wr(smmu + cb + SMMU_CB_TTBR0 + 4, (uint32_t)(ttbr >> 32));
+	__asm__ volatile ("dsb sy");
+	gpu_root_current = root;                /* whatever the read-back says: the TLB goes either way */
+	negroni_gpu_mapped();
+	gpu_invalidate_next = true;
+	if (rd(smmu + cb + SMMU_CB_TTBR0) != (uint32_t)ttbr || rd(smmu + cb + SMMU_CB_TTBR0 + 4) != (uint32_t)(ttbr >> 32)) {
+		printf("NEGRONI GPU: the SMMU context did not take TTBR0 %#llx (reads %#x:%#x): per-client tables off\n",
+		    ttbr, rd(smmu + cb + SMMU_CB_TTBR0 + 4), rd(smmu + cb + SMMU_CB_TTBR0));
+		return false;
+	}
+	if (logged < 8) {
+		logged++;
+		printf("NEGRONI GPU: the 3D core's tables are now %s (root %#llx)\n", vm != NULL ? "a client's" : "the kernel's",
+		    root);
+	}
+	return true;
+}
+
+/* A client's own window (MSM_PARAM_VA_START/VA_SIZE) with negronigpu_pt=1: the same place in every client's tables. */
+uint64_t
+negroni_gpu_vm_window(uint64_t *size)
+{
+	*size = GPU_VM_WINDOW_SIZE;
+	return GPU_VM_WINDOW_START;
+}
