+/* 0274: open a channel after step 9 (the charger PD's PMIC_RTR_ADSP_APPS). gl_lock per poll. */
+int
+negroni_glink_open(unsigned c, unsigned intents, uint32_t wait_ms)
+{
+	struct gl_channel *ch;
+	int error = 0;
+
+	if (c >= NEGRONI_GLINK_CHANNELS) {
+		return EINVAL;
+	}
+	ch = &gl_ch[c];
+	gl_lock();
+	if (gl_dead || !gl_version_ok) {
+		error = ENOTCONN;
+	} else if (!ch->open_sent && gl_send_open(ch) != 0) {
+		error = EIO;
+	}
+	gl_unlock();
+	for (uint32_t ms = 0; error == 0 && ms < wait_ms; ms++) {
+		bool done;
+		gl_lock();
+		gl_poll();
+		done = gl_up(ch) || gl_dead;
+		gl_unlock();
+		if (done) {
+			break;
+		}
+		IOSleep(1);
+	}
+	if (error) {
+		return error;
+	}
+	gl_lock();
+	if (gl_dead) {
+		error = ENOTCONN;
+	} else if (!gl_up(ch)) {
+		error = ETIMEDOUT;
+	} else {
+		/*
+		 * A re-open after a remote CLOSE: the ADSP forgot our intents and we forget its intents.
+		 * Advertise all of ours again, clear theirs. [U] whether the ADSP takes the old lcid (we
+		 * never send CLOSE or a second OPEN).
+		 */
+		if (ch->nours > 0 && ch->intents_sent) {
+			bzero(ch->theirs, sizeof(ch->theirs));
+			for (unsigned i = 0; error == 0 && i < ch->nours; i++) {
+				ch->fill[i] = 0;
+				error = gl_advertise(ch, i) == 0 ? 0 : EIO;
+			}
+		}
+		while (error == 0 && ch->nours < MIN(intents, (unsigned)GL_OURS)) {
+			error = gl_add_intent(ch, GL_INTENT_SIZE) ? 0 : ENOMEM;
+		}
+		if (error == 0) {
+			ch->intents_sent = true;
+		}
+	}
+	gl_unlock();
+	return error;
+}
