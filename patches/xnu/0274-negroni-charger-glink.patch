+/* 0274: the charger PD state (bsd/dev/negroni_chg_glink.c) into fGlinkIcl and the registry. */
+void
+NegroniBattery::glinkStatus(void)
+{
+	negroni_chg_glink_status g;
+	if (!negroni_chg_glink_get(&g)) {
+		fGlinkIcl = -1;
+		if (!fGlinkWarned) {
+			unsigned want = 0;
+			(void)PE_parse_boot_argn("negronichg_glink", &want, sizeof(want));
+			if (want) {
+				IOLog("NEGRONI BATTERY: negronichg_glink=1 needs negroniadsp=1 (the ADSP runs the charger PD): off\n");
+			}
+			fGlinkWarned = true;
+		}
+		return;
+	}
+	bool ready = g.up && g.ready;
+	fGlinkIcl = (ready && g.icl_ma >= 0) ? g.icl_ma : -1;
+	putBool("NegroniChargerGlinkReady", ready);
+	putNumber("NegroniChargerGlinkIclMa", (UInt32)(g.icl_ma < 0 ? 0 : g.icl_ma));
+	putNumber("NegroniChargerGlinkSOC", (UInt32)(g.soc_centi < 0 ? 0xffffffffu : (UInt32)g.soc_centi));  /* 1/100 % */
+	putNumber("NegroniChargerGlinkStatus", (UInt32)g.bstatus);
+	putNumber("NegroniChargerGlinkVbusMv", (UInt32)(g.usb_mv < 0 ? 0 : g.usb_mv));
+	putBool("NegroniChargerGlinkChargeEnable", g.chg_en_set);
+}
