+/*
+ * NEGRONI (SM8450) patch 0274: what the ADSP charger PD reports over GLINK PMIC_RTR_ADSP_APPS
+ * (bsd/dev/negroni_chg_glink.c), read by iokit/Kernel/arm/NegroniBattery.cpp. C and C++.
+ * iOSPlus10 docs/charger-glink-plan.md.
+ */
+#ifndef _NEGRONI_CHG_GLINK_H_
+#define _NEGRONI_CHG_GLINK_H_
+#include <stdint.h>
+#include <stdbool.h>
+
+struct negroni_chg_glink_status {
+	uint32_t gen;           /* +1 for each completed poll cycle */
+	bool wanted;            /* negronichg_glink=1 and negroniadsp set */
+	bool up;                /* the channel is open both ways */
+	bool ready;             /* the PD answered a property read with ret_code 0 */
+	bool icl_set;           /* our ICL write was accepted for this plug */
+	bool chg_en_set;        /* our BATT_CHG_EN = 1 was accepted for this plug */
+	int32_t soc_centi;      /* hundredths of a percent; -1 = unknown */
+	uint8_t soc_src;        /* 1 = OEM read buffer (the external gauge), 2 = BATT_CAPACITY */
+	int32_t vbat_mv;        /* as the PD reports it (pack or cell: see the plan) ; 0 = unknown */
+	int32_t ibat_ma;        /* as the PD reports it; INT32_MIN = unknown */
+	int32_t temp_centi;     /* hundredths of a degree C; INT32_MIN = unknown */
+	int32_t bstatus;        /* BATT_STATUS: 1 charging 2 discharging 3 not charging 4 full; -1 = unknown */
+	int32_t usb_online;     /* USB_ONLINE; -1 = unknown */
+	int32_t usb_mv;         /* USB_VOLT_NOW in mV; -1 = unknown */
+	int32_t usb_ma;         /* USB_CURR_NOW in mA; INT32_MIN = unknown */
+	int32_t icl_ma;         /* USB_INPUT_CURR_LIMIT read back, mA; -1 = unknown */
+	uint64_t soc_ns;        /* uptime (ns) of the last good SoC read */
+	uint64_t soc_change_ns; /* uptime (ns) when the SoC value last changed */
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* A copy of the last status. false: no 0274 client (negronichg_glink=0 or no ADSP). */
+bool negroni_chg_glink_get(struct negroni_chg_glink_status *out);
+/* Start the client thread (once; nothing without negronichg_glink=1 and negroniadsp). */
+void negroni_chg_glink_start(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
