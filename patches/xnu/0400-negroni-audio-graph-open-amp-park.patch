+/*
+ * 0400: the boot park. The amps sit on their own I2C bus (SE13) and need no ADSP, so every boot
+ * (ADSP on or off) checks them once, 15 s after the UFS start (the table is in the ADSP firmware area):
+ * reset pulse (active-high), revision of 0x34/0x35, MTP/R25C read only, container table. The amps stay
+ * in their power-on state (powered down, no I2S clock): this only proves the control path and puts the
+ * amps into a known state before any sound. No register write. Kill switch negroniaudio_park=0.
+ * When the ADSP sink (step 15) probes first, the park finds the probe done and only reports it.
+ */
+#define TFA_PARK_DELAY_MS       15000u
+
+static void
+tfa_park_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	int rc;
+
+	IOSleep(TFA_PARK_DELAY_MS);
+	rc = tfa_probe("boot park");
+	if (rc == 0) {
+		say("park: amps answer and stay powered down until audio plays (negroniaudio_amp=%u)", amp_on);
+	} else if (rc == ENXIO || rc == ENOMEM) {
+		say("park: off: %s (errno %d); no amp register written", rc == ENXIO ? "no TFA9874 answers on SE13 "
+		    "(GPIO48/49, 0x34/0x35)" : "no TLMM mapping", rc);
+	} else {
+		say("park: amps answer; container table not usable (errno %d), so negroniaudio_amp=1 cannot start them", rc);
+	}
+	(void)thread_terminate(current_thread());
+}
+
+void
+negroni_tfa_park(void)
+{
+	uint32_t park = 1;
+	thread_t th;
+
+	(void)negroni_tfa_wanted();                     /* parses the floors for the probe line */
+	(void)PE_parse_boot_argn("negroniaudio_park", &park, sizeof(park));
+	if (park == 0) {
+		say("park: off: negroniaudio_park=0");
+		return;
+	}
+	if (kernel_thread_start(tfa_park_thread, NULL, &th) == KERN_SUCCESS) {
+		thread_deallocate(th);
+	} else {
+		say("park: off: no thread");
+	}
 }
 
