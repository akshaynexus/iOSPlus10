+/*
+ * 0312 (iOSPlus10): bus (BCM) votes of the camera paths, as Linux icc-rpmh/bcm-voter.c computes them for
+ * one node per BCM: vote_x = avg * width / (buswidth * channels) * 1000 / unit, vote_y = peak * width /
+ * buswidth * 1000 / unit (kBps; width and unit from the cmd-db aux data {u32 unit, u16 width, u8 vcd}),
+ * clamped to 14 bits; a BCM with an enable_mask (CN0, MM1) gets x = 0, y = 1 (:99-101). One AMC command, commit set.
+ * Only the five BCMs of the camera paths, at most 3,000,000 kBps (the DT camnoc-axi-min-ib-bw 3e9 B/s).
+ */
+int negroni_rpmh_cam_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uint32_t buswidth, uint32_t channels,
+    bool enable_mask, uint32_t *data_out);
+
+static int
+rh_lookup_bcm(const char *res, uint32_t *address, uint32_t *unit, uint32_t *width)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if (slave != RH_BCM || (entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			continue;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = rh_read(rh_db, e + 16), data = aux + rh_db16(e + 22), len = rh_db16(e + 20);
+			if ((addr >> 16) != RH_BCM || (addr & 3u) || len < 8 || !rh_range(data, len)) {
+				printf("NEGRONI RPMH: invalid BCM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			*unit = rh_db16(data) | (uint32_t)rh_db16(data + 2) << 16;
+			*width = rh_db16(data + 4);
+			printf("NEGRONI RPMH: BCM %s addr=%#x unit=%u width=%u\n", res, addr, *unit, *width);
+			return (*unit == 0 || *width == 0) ? EINVAL : 0;
+		}
+	}
+	printf("NEGRONI RPMH: no BCM %s in cmd-db\n", res);
+	return ENODEV;
+}
+
+int
+negroni_rpmh_cam_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uint32_t buswidth, uint32_t channels,
+    bool enable_mask, uint32_t *data_out)
+{
+	if (!res || (strcmp(res, "CN0") && strcmp(res, "MM1") && strcmp(res, "MM0") && strcmp(res, "SH0") &&
+	    strcmp(res, "MC0")) || avg_kbps > 3000000u || peak_kbps > 3000000u || buswidth == 0 || channels == 0) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, unit = 0, width = 0;
+	if (rh_poisoned) {
+		printf("NEGRONI RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_bcm(res, &address, &unit, &width);
+	}
+	if (!error) {
+		uint64_t x = 0, y = 1;
+		if (!enable_mask) {
+			x = (uint64_t)avg_kbps * width / ((uint64_t)buswidth * channels) * 1000u / unit;
+			y = (uint64_t)peak_kbps * width / buswidth * 1000u / unit;
+		}
+		x = MIN(x, 0x3fffull);
+		y = MIN(y, 0x3fffull);
+		uint32_t data = 1u << 30 | 1u << 29 | (uint32_t)x << 14 | (uint32_t)y;
+		printf("NEGRONI RPMH: BCM %s avg %u peak %u kBps -> x %llu y %llu, data %#x\n", res, avg_kbps, peak_kbps, x, y, data);
+		if (data_out) {
+			*data_out = data;
+		}
+		error = rh_send(address, data, RH_MODE_BCM);
+	}
+out:
+	if (error) {
+		printf("NEGRONI RPMH: BCM vote failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
