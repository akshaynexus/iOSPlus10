+	step_begin("rpmh mmcx + camera noc votes");
+	int error = vote_retry(vote_mmcx, NULL);
+	say("  mmcx.lvl level %u: errno %d", MMCX_LEVEL, error);
+	if (error) {
+		return step_fail("MMCX vote");
+	}
+	for (unsigned i = 0; i < sizeof(cam_bcms) / sizeof(cam_bcms[0]); i++) {
+		error = vote_retry(vote_bcm, (void *)(uintptr_t)&cam_bcms[i]);
+		say("  BCM %s (%s): errno %d", cam_bcms[i].name, cam_bcms[i].enable_mask ? "on" : "avg 1 GB/s, peak 3 GB/s", error);
+		if (error) {
+			return step_fail("BCM vote");
+		}
+	}
+	say("  votes stay after the run (not dropped)");
+	return step_ok();
+}
