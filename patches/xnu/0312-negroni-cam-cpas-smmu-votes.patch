+			uint32_t s2cr = rd(smmu + SMMU_S2CR(hit)), type = (s2cr >> 16) & 3u;
+			say("  %s SID %#x: SMR%u %#x S2CR %#x (%s, context %u)", cg->name, cg->sids[k], hit,
+			    rd(smmu + SMMU_SMR(hit)), s2cr, type == 0 ? "translate" : type == 1 ? "bypass" : "fault", s2cr & 0xffu);
+			bypass += type == 1;
+			translate += type == 0;
+			fault += type >= 2;
+		}
+		/* unmatched streams follow sCR0: CLIENTPD = whole SMMU bypassed, else USFCFG 0 bypass / 1 fault */
+		bool unmatched_bypass = (scr0 & 1u) || !(scr0 & (1u << 10));
+		if (unmatched_bypass) {
+			bypass += unmatched;
+		} else {
+			fault += unmatched;
+		}
+		say("  %s group (SMR %#x mask %#x): %u bypass, %u translate, %u fault (%u SIDs without SMR, unmatched -> %s)",
+		    cg->name, cg->sid, cg->mask, bypass, translate, fault, unmatched, unmatched_bypass ? "bypass" : "fault");
+		dma_ok[g] = bypass == cg->nsids;
+		if (!dma_ok[g] && smmu_policy == 2 && translate == 0 && unmatched == cg->nsids && free_smr != ~0u) {
+			/* arm-smmu.c order: S2CR first, then the SMR valid bit */
+			wr(smmu + SMMU_S2CR(free_smr), 1u << 16);
+			wr(smmu + SMMU_SMR(free_smr), SMR_VALID | cg->mask << 16 | cg->sid);
+			uint32_t smr = rd(smmu + SMMU_SMR(free_smr)), s2 = rd(smmu + SMMU_S2CR(free_smr));
+			say("  %s: SMR%u = %#x, S2CR%u = %#x (bypass added, negronicam_smmu=2)", cg->name, free_smr, smr, free_smr, s2);
+			smr_added[g] = free_smr + 1;
+			dma_ok[g] = smr == (SMR_VALID | cg->mask << 16 | cg->sid) && ((s2 >> 16) & 3u) == 1u;
+			if (!dma_ok[g]) {
+				say("  %s: the SMMU (or the hypervisor) did not take the bypass entry", cg->name);
+			}
+		}
+		say("  %s DMA by physical address: %s", cg->name, dma_ok[g] ? "YES" : "NO");
+		if (!dma_ok[g] && smmu_policy == 1 && level >= (g == 0 ? 5u : 6u)) {     /* IFE DMA at level 5, ICP at 6 */
+			stop = true;
+		}
+	}
+	ml_io_unmap(smmu, 0x4000);
+	if (stop) {
+		return step_fail("a camera stream group would fault or translate (negronicam_smmu=2 adds a bypass entry, "
+		           "=0 tries anyway)");
+	}
+	return step_ok();
+}
