+/* ---- 0312: RPMh votes before the first camcc access ---- */
+
+static int
+vote_retry(int (*fn)(void *), void *arg)
+{
+	int error = EBUSY;
+	/* the RPMh try-lock is shared with other drivers: retry EBUSY for 1 s */
+	for (unsigned i = 0; i < 200 && error == EBUSY; i++) {
+		error = fn(arg);
+		if (error == EBUSY) {
+			delay(5000);
+		}
+	}
+	return error;
+}
+
+static int
+vote_mmcx(void *arg __unused)
+{
+	return negroni_rpmh_arc_vote("mmcx.lvl", MMCX_LEVEL);
+}
+
+static int
+vote_bcm(void *arg)
+{
+	const struct cam_bcm *b = arg;
+	uint32_t data = 0;
+	return negroni_rpmh_cam_bcm(b->name, CAM_BW_AVG_KBPS, CAM_BW_PEAK_KBPS, b->buswidth, b->channels, b->enable_mask,
+	           &data);
+}
