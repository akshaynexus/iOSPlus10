diff --git a/bsd/kern/negroni_amfi.c b/bsd/kern/negroni_amfi.c
index 3fc7b08..98e39344 100644
--- a/bsd/kern/negroni_amfi.c
+++ b/bsd/kern/negroni_amfi.c
@@ -367,6 +367,97 @@ static struct mac_policy_conf negroni_amfi_mac_conf = {
 
 static mac_policy_handle_t negroni_amfi_mac_handle;
 
+/*
+ * Policy named exactly "AMFI": userland asks AMFI questions with
+ * __mac_syscall("AMFI", op, arg) (libamfi / __sandbox_ms), and the policy
+ * above is "NEGRONI AMFI", so every such call failed with ENOPOLICY
+ * ("Policy not found"). Two ops are answered; every other op keeps that
+ * answer (ENOPOLICY). The first use of each op is logged.
+ *
+ * 0x5a amfi_check_dyld_policy_self, arg -> { u64 input flags; u64 *output }.
+ *      dyld asks it at every launch and treats an error as "allow
+ *      nothing": then every @rpath / @executable_path / @loader_path load
+ *      fails ("security policy does not allow @ path expansion"), i.e. any
+ *      app or app extension with embedded frameworks. Answer (ios-flame
+ *      0114): @ paths always; DYLD_* path variables, fallback paths, print
+ *      variables, failed insertions, interposing and LC_DYLD_ENVIRONMENT
+ *      unless the process is restricted (__RESTRICT segment) or FairPlay
+ *      encrypted, like a development device. A custom shared cache stays
+ *      off. (dyld AMFI_DYLD_INPUT_* / AMFI_DYLD_OUTPUT_ALLOW_* bits.)
+ * 0x60 amfi_interface_query_bootarg_state, arg -> u64 state. ExtensionFoundation
+ *      (lsd) verifies the signed extension point catalog
+ *      /System/Library/xpc/extensions.plist through AMFI unless
+ *      (state & 0x86) != 0; with no AMFI the read fails ("Unable to find
+ *      AMFI"), the catalog stays empty and no app extension (widgets,
+ *      poster providers) is registered. Answer 0x86 (bergamota 0099,
+ *      docs/EXTENSION_CACHE.md there, iOS 16.7.16 20H392). Side effect:
+ *      lsd/installd also read "code signing enforcement disabled".
+ *
+ * Boot-arg negroniamfi (bit mask, default 7): bit 0 op 0x5a, bit 1 op 0x60,
+ * bit 2 the AppleMobileFileIntegrity IOService (NegroniAMFI.cpp). With
+ * bits 0 and 1 clear the "AMFI" policy is not registered.
+ */
+#define NEGRONI_AMFI_OPT_DYLD           0x1
+#define NEGRONI_AMFI_OPT_BOOTARG_STATE  0x2
+static TUNABLE(uint32_t, negroni_amfi_options, "negroniamfi", 0x7);
+
+#define NEGRONI_AMFI_OP_DYLD_POLICY_SELF        0x5a
+#define NEGRONI_AMFI_OP_BOOTARG_STATE           0x60
+#define NEGRONI_AMFI_DYLD_IN_RESTRICTED         (1ULL << 1)     /* __RESTRICT segment */
+#define NEGRONI_AMFI_DYLD_IN_ENCRYPTED          (1ULL << 2)     /* FairPlay */
+#define NEGRONI_AMFI_DYLD_ALLOW_AT_PATH         (1ULL << 0)
+/* path vars 0x2, fallback paths 0x8, print vars 0x10, failed insertion 0x20, interposing 0x40, embedded vars 0x80 */
+#define NEGRONI_AMFI_DYLD_ALLOW_DEVELOPMENT     0xfaULL
+#define NEGRONI_AMFI_BOOTARG_STATE              0x86ULL
+
+static uint64_t negroni_amfi_ops_seen[4];
+
+static int
+negroni_amfi_name_syscall(struct proc *p, int call, user_addr_t arg)
+{
+	if (call >= 0 && call < 256 && !(negroni_amfi_ops_seen[call / 64] & (1ULL << (call % 64)))) {
+		negroni_amfi_ops_seen[call / 64] |= 1ULL << (call % 64);
+		char name[32];
+		proc_name(proc_pid(p), name, sizeof(name));
+		printf("NEGRONI AMFI: %s __mac_syscall(\"AMFI\", 0x%x)\n", name, call);
+	}
+	if (call == NEGRONI_AMFI_OP_DYLD_POLICY_SELF && (negroni_amfi_options & NEGRONI_AMFI_OPT_DYLD)) {
+		struct {
+			uint64_t input;
+			uint64_t output;        /* user pointer to u64 */
+		} req;
+		int error = copyin(arg, &req, sizeof(req));
+		if (error) {
+			return error;
+		}
+		if (req.output == 0) {
+			return EFAULT;
+		}
+		uint64_t allow = NEGRONI_AMFI_DYLD_ALLOW_AT_PATH;
+		if (!(req.input & (NEGRONI_AMFI_DYLD_IN_RESTRICTED | NEGRONI_AMFI_DYLD_IN_ENCRYPTED))) {
+			allow |= NEGRONI_AMFI_DYLD_ALLOW_DEVELOPMENT;
+		}
+		return copyout(&allow, (user_addr_t)req.output, sizeof(allow));
+	}
+	if (call == NEGRONI_AMFI_OP_BOOTARG_STATE && (negroni_amfi_options & NEGRONI_AMFI_OPT_BOOTARG_STATE)) {
+		uint64_t state = NEGRONI_AMFI_BOOTARG_STATE;
+		return copyout(&state, arg, sizeof(state));
+	}
+	return ENOPOLICY;
+}
+
+static const struct mac_policy_ops negroni_amfi_name_mac_ops = {
+	.mpo_policy_syscall = negroni_amfi_name_syscall,
+};
+
+static struct mac_policy_conf negroni_amfi_name_mac_conf = {
+	.mpc_name = "AMFI",             /* __mac_syscall("AMFI", ...) finds it by this name */
+	.mpc_fullname = "NEGRONI AMFI userland interface stand-in",
+	.mpc_ops = &negroni_amfi_name_mac_ops,
+};
+
+static mac_policy_handle_t negroni_amfi_name_mac_handle;
+
 /* Called from bsd_init once MAC policies can register, before any exec. */
 void negroni_amfi_policy_register(void);
 
@@ -376,6 +467,11 @@ negroni_amfi_policy_register(void)
 	int error = mac_policy_register(&negroni_amfi_mac_conf, &negroni_amfi_mac_handle, NULL);
 	printf("NEGRONI AMFI: platform binary policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
+	if (negroni_amfi_options & (NEGRONI_AMFI_OPT_DYLD | NEGRONI_AMFI_OPT_BOOTARG_STATE)) {
+		error = mac_policy_register(&negroni_amfi_name_mac_conf, &negroni_amfi_name_mac_handle, NULL);
+		printf("NEGRONI AMFI: \"AMFI\" syscall policy (negroniamfi 0x%x) %s (%d)\n",
+		    negroni_amfi_options, error ? "NOT registered" : "registered", error);
+	}
 	error = mac_policy_register(&negroni_sandbox_mac_conf, &negroni_sandbox_mac_handle, NULL);
 	printf("NEGRONI Sandbox: permissive policy %s (%d)\n",
 	    error ? "NOT registered" : "registered", error);
diff --git a/iokit/Kernel/arm/NegroniAMFI.cpp b/iokit/Kernel/arm/NegroniAMFI.cpp
new file mode 100644
index 0000000..72e9e94
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniAMFI.cpp
@@ -0,0 +1,112 @@
+/*
+ * A stand-in for AppleMobileFileIntegrity's IOService (ios-flame 0103).
+ * NEGRONI has no AMFI kext. Userland looks the service up by class name:
+ * ExtensionFoundation's +[NSDictionary _EX_dictionaryWithSignedURL:] reads
+ * signed caches (the extension point catalog
+ * /System/Library/xpc/extensions.plist) only after it asks AMFI whether the
+ * file's cdhash is in the trust cache. Without the service the read fails
+ * ("Unable to find AMFI"), sandboxed readers (lsd) get no extension point
+ * catalog, MobileInstallation rejects every app extension ("Extension cache
+ * does not have an entry for ...") and LaunchServices registers none:
+ * widgets, poster providers and other app extensions do not run.
+ *
+ * User client, IOConnectCallMethod:
+ *   6 trust cache query  [1 scalar] + struct cdhash -> 0 (trusted)
+ * Every cdhash is trusted: code signing is not enforced on NEGRONI and there
+ * is no trust cache to look in. Other selectors are logged once and answered
+ * kIOReturnUnsupported, which is what their callers got from the missing
+ * service. Boot-arg negroniamfi bit 2 clear (e.g. negroniamfi=0) leaves the
+ * service out (bsd/kern/negroni_amfi.c documents the other bits).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+#define NEGRONI_AMFI_OPT_SERVICE        0x4
+#define NEGRONI_AMFI_SEL_TRUST_QUERY    6
+
+class AppleMobileFileIntegrity : public IOService {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+
+IOService *
+AppleMobileFileIntegrity::probe(IOService *provider, SInt32 *score)
+{
+	uint32_t options = 0x7;
+	(void)PE_parse_boot_argn("negroniamfi", &options, sizeof(options));
+	if (!(options & NEGRONI_AMFI_OPT_SERVICE)) {
+		IOLog("NEGRONI AMFI: AppleMobileFileIntegrity left out (negroniamfi 0x%x)\n", options);
+		return NULL;
+	}
+	return IOService::probe(provider, score);
+}
+
+bool
+AppleMobileFileIntegrity::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleMobileFileIntegrityUserClient");
+	registerService();
+	IOLog("NEGRONI AMFI: AppleMobileFileIntegrity published (trust cache queries answer trusted)\n");
+	return true;
+}
+
+class AppleMobileFileIntegrityUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrityUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrityUserClient, IOUserClient);
+
+IOReturn
+AppleMobileFileIntegrityUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+AppleMobileFileIntegrityUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target, __unused void *reference)
+{
+	static uint32_t logged;         /* one line per selector */
+	uint32_t in_struct = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+
+	if (selector == NEGRONI_AMFI_SEL_TRUST_QUERY) {
+		if (!(logged & (1u << selector))) {
+			logged |= 1u << selector;
+			IOLog("NEGRONI AMFI: trust cache query (%u scalars, %u-byte cdhash): trusted\n",
+			    args->scalarInputCount, in_struct);
+		}
+		args->scalarOutputCount = 0;
+		return kIOReturnSuccess;
+	}
+	if (selector < 32 && !(logged & (1u << selector))) {
+		logged |= 1u << selector;
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("NEGRONI AMFI: %s selector %u (in %u/%u) unsupported\n", name, selector,
+		    args->scalarInputCount, in_struct);
+	}
+	return kIOReturnUnsupported;
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
