+static bool
+frame_alloc(struct cam_frame *f, uint32_t width, uint32_t height, uint32_t source)
+{
+	f->width = width;
+	f->height = height;
+	f->stride = width * 10u / 8u;   /* MIPI RAW10 bytes per line as received (RDI payload only) */
+	f->bytes = f->stride * height;
+	f->source = source;
+	f->done = 0;
+	if (f->kva == 0) {
+		/* two frames: the frame-based WM moves to addr + frame_incr for the next frame until the halt */
+		f->alloc = round_page((vm_size_t)f->bytes * 2u);
+		if (kmem_alloc_contig(kernel_map, &f->kva, f->alloc, 0, (ppnum_t)(atop(0x100000000ull) - 1), 0,
+		    KMA_KOBJECT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			f->kva = 0;
+			say("  no %lu bytes of contiguous memory below 4 GiB", (unsigned long)f->alloc);
+			return false;
+		}
+	}
+	f->pa = kvtophys(f->kva);
+	if (f->pa == 0 || f->pa + f->alloc > 0x100000000ull || kvtophys(f->kva + f->alloc - PAGE_SIZE) !=
+	    f->pa + f->alloc - PAGE_SIZE) {
+		say("  buffer at phys %#llx is not one piece below 4 GiB", f->pa);
+		return false;
+	}
+	memset((void *)f->kva, FRAME_FILL, f->alloc);
+	flush_dcache64((addr64_t)f->pa, (unsigned)f->alloc, TRUE);      /* clean + invalidate: RAM holds the fill */
+	say("  buffer %s: phys %#llx, %lu bytes (frame %u x %u RAW10, %u bytes per line, %u bytes)", source == 1 ? "TPG" :
+	    "sensor", f->pa, (unsigned long)f->alloc, width, height, f->stride, f->bytes);
+	return true;
