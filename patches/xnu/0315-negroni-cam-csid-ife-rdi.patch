+/* the proof lines: first bytes, bytes changed from the fill, distinct values, a coarse histogram */
+static bool
+frame_check(struct cam_frame *f, const char *name)
+{
+	flush_dcache64((addr64_t)f->pa, (unsigned)f->alloc, TRUE);      /* drop stale lines before the CPU reads */
+	const uint8_t *p = (const uint8_t *)f->kva;
+	uint32_t changed = 0, hist[8] = { 0 }, seen[8] = { 0 }, distinct = 0;
+	for (uint32_t i = 0; i < f->bytes; i++) {
+		changed += p[i] != FRAME_FILL;
+		hist[p[i] >> 5]++;
+		if (!(seen[p[i] >> 5] & (1u << (p[i] & 31u)))) {
+			seen[p[i] >> 5] |= 1u << (p[i] & 31u);
+			distinct++;
+		}
+	}
+	say("%s frame first bytes: %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x %02x", name,
+	    p[0], p[1], p[2], p[3], p[4], p[5], p[6], p[7], p[8], p[9], p[10], p[11], p[12], p[13], p[14], p[15]);
+	const uint8_t *m = p + (f->bytes / 2u & ~15u);
+	say("%s frame middle bytes: %02x %02x %02x %02x %02x %02x %02x %02x", name, m[0], m[1], m[2], m[3], m[4], m[5],
+	    m[6], m[7]);
+	say("%s frame: %u of %u bytes changed from the %#x fill, %u distinct byte values, histogram (byte >> 5) "
+	    "%u %u %u %u %u %u %u %u", name, changed, f->bytes, FRAME_FILL, distinct, hist[0], hist[1], hist[2], hist[3],
+	    hist[4], hist[5], hist[6], hist[7]);
+	bool good = changed > f->bytes / 2u && distinct > 4;
+	say("%s frame sanity: %s", name, good ? "PASS (non-constant data in most of the buffer)" : "FAIL");
+	f->done = good;
+	return good;
+}
+
+/* /dev/negronicam-tpg (minor 0) and /dev/negronicam-sensor (minor 1): 64-byte header + the frame bytes */
+struct camdev_hdr {
+	char magic[8];                  /* "NCAMRAW1" */
+	uint32_t version, width, height, stride, bytes, data_type, bits, packing, source, valid;
+	uint8_t pad[16];
+};
+_Static_assert(sizeof(struct camdev_hdr) == 64, "camdev header is 64 bytes");
+
+static int
+camdev_open(dev_t dev, int flags __unused, int devtype __unused, struct proc *p __unused)
+{
+	return minor(dev) < 2 ? 0 : ENXIO;
+}
+
+static int
+camdev_close(dev_t dev __unused, int flags __unused, int devtype __unused, struct proc *p __unused)
+{
+	return 0;
+}
+
+static int
+camdev_read(dev_t dev, struct uio *uio, int ioflag __unused)
+{
+	struct cam_frame *f = &frames[minor(dev) & 1];
+	if (f->kva == 0) {
+		return ENXIO;
+	}
+	struct camdev_hdr h;
+	bzero(&h, sizeof(h));
+	memcpy(h.magic, "NCAMRAW1", 8);
+	h.version = 1;
+	h.width = f->width;
+	h.height = f->height;
+	h.stride = f->stride;
+	h.bytes = f->bytes;
+	h.data_type = DT_RAW10;
+	h.bits = 10;
+	h.packing = 1;                  /* MIPI RAW10: 4 pixels in 5 bytes */
+	h.source = f->source;
+	h.valid = f->done;
+	int error = 0;
+	while (error == 0 && uio_resid(uio) > 0) {
+		off_t off = uio_offset(uio);
+		if (off < 0 || off >= (off_t)sizeof(h) + f->bytes) {
+			break;
+		}
+		if (off < (off_t)sizeof(h)) {
+			error = uiomove((caddr_t)&h + off, (int)MIN((off_t)sizeof(h) - off, uio_resid(uio)), uio);
+		} else {
+			off_t at = off - (off_t)sizeof(h);
+			int n = (int)MIN(MIN((off_t)f->bytes - at, uio_resid(uio)), (off_t)(1 << 20));
+			error = uiomove((caddr_t)(f->kva + at), n, uio);
+		}
+	}
+	return error;
+}
+
+static const struct cdevsw camdev_cdevsw = {
+	.d_open = camdev_open,
+	.d_close = camdev_close,
+	.d_read = camdev_read,
+	.d_write = eno_rdwrt,
+	.d_ioctl = eno_ioctl,
+	.d_stop = eno_stop,
+	.d_reset = eno_reset,
+	.d_ttys = NULL,
+	.d_select = eno_select,
+	.d_mmap = eno_mmap,
+	.d_strategy = eno_strat,
+	.d_type = 0,
+};
+
+static void
+camdev_publish(void)
+{
+	if (camdev_major >= 0) {
+		return;
+	}
+	camdev_major = cdevsw_add(-1, &camdev_cdevsw);
+	if (camdev_major < 0) {
+		say("cdevsw_add failed: no /dev/negronicam-*");
+		return;
+	}
+	(void)devfs_make_node(makedev(camdev_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0440, "negronicam-tpg");
+	(void)devfs_make_node(makedev(camdev_major, 1), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0440, "negronicam-sensor");
+	say("frames readable as /dev/negronicam-tpg and /dev/negronicam-sensor (scripts/camera/pull-frame.sh)");
+}
+
+/* level 5: TPG frame (no sensor), then the sensor frame */
+static bool
+l5_frames(void)
+{
+	bool any = false, ok = true;
+	if (!l5_map()) {
+		return false;
+	}
+	if (src_mask & 1u) {
+		step_begin("tpg13 -> csid0 -> ife0 rdi0 -> memory");
+		if (!frame_alloc(&frames[0], TPG_W, TPG_H, 1)) {
+			return step_fail("buffer");
+		}
+		bool got = capture(&frames[0], true, 1000) && frame_check(&frames[0], "TPG");
+		any |= got;
+		ok &= got;
+		if (got) {
+			(void)step_ok();
+		} else {
+			(void)step_fail("no TPG frame");
+		}
+	}
+	if (src_mask & 2u) {
+		step_begin("imx789 -> csiphy1 -> csid0 -> ife0 rdi0 -> memory");
+		if (!frame_alloc(&frames[1], FTM_WIDTH, FTM_HEIGHT, 2)) {
+			return step_fail("buffer");
+		}
+		bool got = capture(&frames[1], false, 2000);
+		csiphy_status("after the sensor frame");
+		got = got && frame_check(&frames[1], "SENSOR");
+		any |= got;
+		ok &= got;
+		if (got) {
+			(void)step_ok();
+		} else {
+			(void)step_fail("no sensor frame");
+		}
+	}
+	if (any) {
+		camdev_publish();
+	}
+	return ok;
+}
