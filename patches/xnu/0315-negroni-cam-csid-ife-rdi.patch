+		wr(tpg + TPG_VC0_VBI, TPG_H / 10u);
+		wr(tpg + TPG_VC0_LFSR, 0x12345678);
+		wr(tpg + TPG_VC0_CFG0, 0);                                      /* 1 DT, VC 0, endless frames */
+		wr(tpg + TPG_VC0_DT0_CFG0, TPG_W << 16 | TPG_H);
+		wr(tpg + TPG_VC0_DT0_CFG1, DT_RAW10);
+		wr(tpg + TPG_VC0_DT0_CFG2, 2u << 20 | 8u);                       /* RAW_10_BIT, COLOR_BARS */
+		wr(tpg + TPG_THROTTLE, 0);
+		wr(tpg + TPG_TOP_IRQ_MASK, 1);
+		wr(tpg + TPG_CTRL, 0u << 30 | 3u << 4 | 0u << 6 | 0u << 3 | 1u);   /* 1 VC, 4 lanes, D-PHY, enable */
+		say("  TPG13 on: ctrl %#x status %#x", rd(tpg + TPG_CTRL), rd(tpg + TPG_STATUS));
+	} else if (!l4_stream()) {
+		return false;
+	}
+	/* wait for the frame */
+	uint64_t t0 = now_us();
+	bool ok = poll(csid + CSID_BUF_DONE_STATUS, CSID_BUF_DONE_RDI0, CSID_BUF_DONE_RDI0, timeout_ms * 1000u, &got);
+	uint32_t took = (uint32_t)((now_us() - t0) / 1000u);
+	wr(csid + CSID_RDI0_CTRL, 0);            /* halt at the frame boundary */
+	uint32_t rdi_irq = rd(csid + CSID_RDI0_IRQ_STATUS), rx_irq = rd(csid + CSID_RX_IRQ_STATUS),
+	    top_irq = rd(csid + CSID_TOP_IRQ_STATUS);
+	say("  %s: BUF_DONE status %#x after %u ms; RDI0 irq %#x (SOF bit 12, EOF bit 9, overflow bit 2/19), RX irq %#x, "
+	    "top irq %#x", ok ? "FRAME DONE" : "NO FRAME", got, took, rdi_irq, rx_irq, top_irq);
+	say("  CSID0 rx packets %u, ECC %#x, CRC errors %u, long pkt hdr %#x, RDI0 format measure %#x",
+	    rd(csid + CSID_RX_TOTAL_PKTS), rd(csid + CSID_RX_STATS_ECC), rd(csid + CSID_RX_CRC_ERRORS),
+	    rd(csid + CSID_RX_LONG_PKT_0), rd(csid + CSID_RDI0_FORMAT_MEASURE0));
+	say("  IFE0 bus irq %#x %#x, violation %#x, overflow %#x, image violation %#x; WM addr status %#x, debug %#x %#x",
+	    rd(ife + VFE_BUS_IRQ_STATUS0), rd(ife + VFE_BUS_IRQ_STATUS1), rd(ife + VFE_BUS_VIOLATION),
+	    rd(ife + VFE_BUS_OVERFLOW), rd(ife + VFE_BUS_IMG_VIOLATION), rd(ife + WM_RDI0 + WM_ADDR_STATUS0),
+	    rd(ife + WM_RDI0 + WM_DEBUG_STATUS0), rd(ife + WM_RDI0 + WM_DEBUG_STATUS1));
+	camnoc_report("after the frame");
+	delay(40000);                           /* let a frame in flight finish into the guard frame */
+	wr(ife + WM_RDI0 + WM_CFG, 0);
+	wm_on = false;
+	if (from_tpg) {
+		wr(tpg + TPG_CTRL, 0);
+		tpg_on = false;
+	} else if (streaming) {
+		int e = cci_write8(CCI_MASTER, SENSOR_SID, SENSOR_MODE_SEL, 0);
+		say("  IMX789 stream off: errno %d", e);
+		streaming = false;
+	}
+	wr(csid + CSID_RDI0_CFG0, rd(csid + CSID_RDI0_CFG0) & ~(1u << 31));
+	wr(csid + CSID_BUF_DONE_CLEAR, got);
+	wr(csid + CSID_RDI0_IRQ_CLEAR, rdi_irq);
+	wr(csid + CSID_RX_IRQ_CLEAR, rx_irq);
+	wr(csid + CSID_IRQ_CMD, 1);
+	return ok;
+}
