+/* CSID global reset (camss-csid-680.c csid_reset :290-330; cam_ife_csid680.h:1205-1217 values) */
+static bool
+csid_reset(void)
+{
+	uint32_t got = 0;
+	wr(csid + CSID_TOP_IRQ_MASK, CSID_TOP_IRQ_RESET);
+	wr(csid + CSID_IRQ_CMD, 1);
+	wr(csid + CSID_RESET_CFG, 1u | 1u << 4);        /* mode immediate, location complete */
+	wr(csid + CSID_RESET_CMD, 3);                   /* HW + SW reset */
+	bool ok = poll(csid + CSID_TOP_IRQ_STATUS, CSID_TOP_IRQ_RESET, CSID_TOP_IRQ_RESET, 100000, &got);
+	wr(csid + CSID_TOP_IRQ_CLEAR, got);
+	wr(csid + CSID_IRQ_CMD, 1);
+	say("  CSID0 reset %s (top irq status %#x)", ok ? "done" : "NOT acked in 100 ms", got);
+	return ok;
