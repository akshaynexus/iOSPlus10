+/* the PCIe capability (ID 0x10) of a config space, 0 if none */
+static uint32_t
+wlan_pcie_cap(volatile uint32_t *cfg)
+{
+	return wlan_cfg_cap(cfg, 0x10u);
+}
+
 static void
 wlan_boot_dump_pcie(const char *when)
 {
@@ -847,12 +865,224 @@ wlan_boot_dump_pcie(const char *when)
 	    (!(ia && ia != MHI_ALL_ONES) && !(warm && warm != MHI_ALL_ONES) && !dma_err && !rp_err) ? " no PCIe/WLAON error bit" : "");
 }
 
+/*
+ * 0344: the chip's MSI into a RAM mailbox (boot-arg negroniwlan_msi bit 0). Phone 2026-10-27: BHI SBL DONE, then EE 0,
+ * MHISTATUS 0, no SBL log pointer for 30 s; the endpoint MSI capability (0x50) reads 0x10a7005 = MSI off, 32 vectors,
+ * per-vector mask, 32-bit address only. Linux (ath11k_pci_alloc_msi, cnss2 cnss_pci_enable_msi) always enables MSI
+ * before the MHI power-up; on Android the PCIe0 MSIs go to the GIC ITS, which this port does not set up. Here the MSI
+ * address is the IOVA of one word in our DMA pool (OFF_MSI, its own 4 KiB page between the IPCR rings and the
+ * firmware), mapped through our SMMU context (negroniwlan_smmu=3), so each MSI the chip sends is a 32-bit memory write
+ * of "data base | vector" into that word. Data base 0xa500 (32-aligned: the chip puts the vector in bits 4:0).
+ * The word holds the sentinel 0xffffffff; every poll (the boot dumps, the BHI wait, the READY wait, the service pass)
+ * prints a change and writes the sentinel again. Two MSIs between two polls show as one (the last one wins).
+ * Without an SMMU context the pool is above 4 GiB (RAM starts at 0x840000000) and the 32-bit-only capability cannot
+ * take its address: then MSI stays off. On every failure path (wlan_quiesce) MSI is masked and turned off before the
+ * pool and the SMMU context go away. With MSI off the chip sends no MSI write (PCI 3.0 6.8.1.3: MSI Enable 0 =
+ * the function must not use MSI); masked vectors only set pending bits.
+ */
+#define MSI_CAP_ID              0x05u
+#define MSI_CTL_ENABLE          0x0001u
+#define MSI_CTL_MMC(c)          (((c) >> 1) & 7u)
+#define MSI_CTL_MME(c)          (((c) >> 4) & 7u)
+#define MSI_CTL_MME_MASK        0x0070u
+#define MSI_CTL_64BIT           0x0080u
+#define MSI_CTL_PVM             0x0100u
+#define MSI_DATA_BASE           0xa500u
+#define MSI_SENTINEL            0xffffffffu
+#define MSI_LINES_MAX           64u
+_Static_assert((MSI_DATA_BASE & 31u) == 0, "MSI data base must leave the low 5 bits for 32 vectors");
+
+static uint32_t g_msi_cap;              /* config offset of the capability we programmed (0 = not touched) */
+static bool g_msi_on;
+static uint32_t g_msi_vectors;
+static uint32_t g_msi_count, g_msi_lines;
+static uint64_t g_msi_t0;
+
+bool
+negroni_wlan_msi_on(void)
+{
+	return g_msi_on;
+}
+
+/* register offsets inside the MSI capability (PCI 3.0 6.8.1): 32-bit layout or 64-bit layout */
+static void
+msi_offsets(uint32_t cap, uint32_t ctl, uint32_t *data, uint32_t *mask)
+{
+	bool is64 = (ctl & MSI_CTL_64BIT) != 0;
+
+	*data = cap + (is64 ? 0x0cu : 0x08u);
+	*mask = (ctl & MSI_CTL_PVM) ? cap + (is64 ? 0x10u : 0x0cu) : 0;
+}
+
+void
+negroni_wlan_msi_poll(const char *when)
+{
+	if (!g_msi_on || !g_pool_nc) {
+		return;
+	}
+	volatile uint32_t *box = (volatile uint32_t *)(g_pool_nc + OFF_MSI);
+	uint32_t v = *box;
+	if (v == MSI_SENTINEL) {
+		return;
+	}
+	*box = MSI_SENTINEL;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	g_msi_count++;
+	if (g_msi_lines >= MSI_LINES_MAX) {
+		return;
+	}
+	g_msi_lines++;
+	uint32_t vmask = g_msi_vectors ? g_msi_vectors - 1 : 0;
+	char vec[24];
+	if ((v & ~vmask) == MSI_DATA_BASE) {
+		snprintf(vec, sizeof(vec), "vector %u", v & vmask);
+	} else {
+		snprintf(vec, sizeof(vec), "not our data base");
+	}
+	printf("NEGRONI WLAN: MSI #%u data %#x (%s) at %s after %llu ms%s\n", g_msi_count, v, vec, when,
+	    negroni_wlan_ms() - g_msi_t0, g_msi_lines == MSI_LINES_MAX ? " (last MSI line; later MSIs are only counted)" : "");
+}
+
+/* step 7, after the PBL check, before BHI: bit 1 SOC_WAKE, bit 0 the MSI mailbox. A refusal leaves MSI off (no stop). */
+static void
+wlan_msi_setup(void)
+{
+	volatile uint32_t *cfg = (volatile uint32_t *)P.cfg_bus1;
+
+	if (g_msi_mode & 2u) {
+		uint32_t w0 = negroni_wlan_rd(QCA_PCIE_SOC_WAKE);
+		negroni_wlan_wr(QCA_PCIE_SOC_WAKE, 1);
+		negroni_wlan_nap(5);
+		printf("NEGRONI WLAN: SOC_WAKE %#x -> wrote 1 -> %#x after 5 ms (negroniwlan_msi bit 1)\n", w0,
+		    negroni_wlan_rd(QCA_PCIE_SOC_WAKE));
+	}
+	if (!(g_msi_mode & 1u)) {
+		return;
+	}
+	if (!cfg) {
+		printf("NEGRONI WLAN: MSI: no endpoint config space; MSI stays off\n");
+		return;
+	}
+	uint32_t cap = wlan_cfg_cap(cfg, MSI_CAP_ID);
+	if (!cap) {
+		printf("NEGRONI WLAN: MSI: no MSI capability in the endpoint list; MSI stays off\n");
+		return;
+	}
+	uint32_t hdr = cfg[cap / 4], ctl = hdr >> 16, data_off, mask_off;
+	msi_offsets(cap, ctl, &data_off, &mask_off);
+
+	/* the chip's address for the mailbox: inside the pool's device mapping, inside the SMMU window, 32-bit if need be */
+	uint64_t base = 0, limit = 0, addr = g_pool_dva + OFF_MSI;
+	const char *why = NULL;
+	if (g_pool_dva == WLAN_DMA_NONE || !g_pool_nc) {
+		why = "the DMA pool has no device address";
+	} else if (g_smmu_policy != 3 || !negroni_wlan_smmu_window(&base, &limit)) {
+		why = "no SMMU context (negroniwlan_smmu=3 needed: the pool's physical address is above 4 GiB)";
+	} else if (g_pool_dva < base || g_pool_dva + NEGRONI_WLAN_POOL_SIZE - 1 > limit || addr + 3 > limit) {
+		why = "the mailbox IOVA is outside the SMMU window";
+	} else if (!(ctl & MSI_CTL_64BIT) && addr > 0xfffffffcull) {
+		why = "the capability takes a 32-bit address only";
+	} else if (ctl & MSI_CTL_ENABLE) {
+		why = "MSI is already enabled (not by us)";
+	}
+	/*
+	 * the root port's iMSI-RX (DWC PCIE_MSI_ADDR_LO/HI, DBI 0x820/0x824) ends an inbound write to its address in the
+	 * port and never sends it to the SMMU. Linux (dw_pcie_msi_init) programs it; our survey does not: log what the
+	 * UEFI left, and refuse a mailbox in the same 4 KiB page.
+	 */
+	if (!why && P.dbi) {
+		volatile uint32_t *dbi = (volatile uint32_t *)P.dbi;
+		uint32_t imsi_lo = dbi[0x820 / 4], imsi_hi = dbi[0x824 / 4], imsi_en = dbi[0x828 / 4];
+		printf("NEGRONI WLAN: MSI: root port iMSI-RX address %#x:%08x, vector enable %#x (DBI 0x820/0x824/0x828)\n",
+		    imsi_hi, imsi_lo, imsi_en);
+		if (imsi_hi == (uint32_t)(addr >> 32) && (imsi_lo & ~0xfffu) == ((uint32_t)addr & ~0xfffu)) {
+			why = "the root port iMSI-RX address is in the mailbox page (the write would stop in the port)";
+		}
+	}
+	if (why) {
+		printf("NEGRONI WLAN: MSI: capability %#x control %#x, mailbox %#llx: %s; MSI stays off\n", cap, ctl, addr, why);
+		return;
+	}
+
+	volatile uint32_t *box = (volatile uint32_t *)(g_pool_nc + OFF_MSI);
+	*box = MSI_SENTINEL;
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	g_msi_cap = cap;                /* from here on wlan_msi_off undoes it */
+	cfg[(cap + 0x04) / 4] = (uint32_t)addr;
+	if (ctl & MSI_CTL_64BIT) {
+		cfg[(cap + 0x08) / 4] = (uint32_t)(addr >> 32);
+	}
+	cfg[data_off / 4] = MSI_DATA_BASE;      /* the upper 16 bits (extended data) stay 0 */
+	if (mask_off) {
+		cfg[mask_off / 4] = 0;          /* all vectors unmasked */
+	}
+	uint32_t mmc = MSI_CTL_MMC(ctl);
+	uint32_t nctl = (ctl & ~(uint32_t)MSI_CTL_MME_MASK) | (mmc << 4) | MSI_CTL_ENABLE;
+	cfg[cap / 4] = (nctl << 16) | (hdr & 0xffffu);   /* ID and next pointer are read only */
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	uint32_t rctl = cfg[cap / 4] >> 16, raddr = cfg[(cap + 0x04) / 4], rdata = cfg[data_off / 4] & 0xffffu;
+	uint32_t rmask = mask_off ? cfg[mask_off / 4] : 0;
+	g_msi_vectors = 1u << MSI_CTL_MME(rctl);
+	g_msi_count = g_msi_lines = 0;
+	g_msi_t0 = negroni_wlan_ms();
+	g_msi_on = (rctl & MSI_CTL_ENABLE) && raddr == (uint32_t)addr && rdata == MSI_DATA_BASE;
+	printf("NEGRONI WLAN: MSI %s: capability %#x control %#x -> %#x (%u of %u vectors, %s address, per-vector mask %s), "
+	    "address %#x (pool + %#x, SMMU window %#llx-%#llx), data %#x, mask %#x, mailbox %#x\n",
+	    g_msi_on ? "on" : "DID NOT TAKE", cap, ctl, rctl, g_msi_vectors, 1u << mmc, (ctl & MSI_CTL_64BIT) ? "64-bit" : "32-bit",
+	    mask_off ? "yes" : "no", raddr, OFF_MSI, base, limit, rdata, rmask, *box);
+	if (!g_msi_on) {
+		cfg[cap / 4] = ((rctl & ~(uint32_t)(MSI_CTL_ENABLE | MSI_CTL_MME_MASK)) << 16) | (hdr & 0xffffu);
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+}
+
+/* every failure path (wlan_quiesce), before the pool and the SMMU context go: no MSI write to a stale address later */
+static void
+wlan_msi_off(const char *why)
+{
+	volatile uint32_t *cfg = (volatile uint32_t *)P.cfg_bus1;
+	uint32_t cap = g_msi_cap;
+
+	if (!cap || !cfg) {
+		return;
+	}
+	negroni_wlan_msi_poll(why);     /* the last MSI before the stop */
+	uint32_t hdr = cfg[cap / 4], ctl = hdr >> 16, data_off, mask_off;
+	g_msi_on = false;
+	if (hdr == MHI_ALL_ONES) {
+		/* link down: the chip cannot send anything upstream; the SMMU context still goes away after the quiesce */
+		g_msi_cap = 0;
+		printf("NEGRONI WLAN: MSI off (%s): config space reads 0xffffffff (link down); not written, %u MSIs seen\n", why,
+		    g_msi_count);
+		return;
+	}
+	msi_offsets(cap, ctl, &data_off, &mask_off);
+	if (mask_off) {
+		cfg[mask_off / 4] = 0xffffffffu;        /* mask first: no new message */
+	}
+	cfg[cap / 4] = ((ctl & ~(uint32_t)(MSI_CTL_ENABLE | MSI_CTL_MME_MASK)) << 16) | (hdr & 0xffffu);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	cfg[(cap + 0x04) / 4] = 0;
+	if (ctl & MSI_CTL_64BIT) {
+		cfg[(cap + 0x08) / 4] = 0;
+	}
+	cfg[data_off / 4] = 0;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	g_msi_on = false;
+	g_msi_cap = 0;
+	printf("NEGRONI WLAN: MSI off (%s): control %#x, address %#x, %u MSIs seen\n", why, cfg[cap / 4] >> 16,
+	    cfg[(cap + 0x04) / 4], g_msi_count);
+}
+
