+/*
+ * QCA6490 Bluetooth supplies (negroni_bt.c, patch 0330): live DT bt_qca6490 qcom,bt-vdd-*-supply and
+ * -config (min = max voltage): aon/dig pm8350_s11, rfa1 pm8350c_s1, rfa2 pm8350_s12, asd pmr735a_l7.
+ * Voltage + enable only (no mode), as the Wi-Fi SMPS votes. Never voted off (shared rails).
+ */
+int negroni_rpmh_bt_enable(const char *res, unsigned mv);
+
+int
+negroni_rpmh_bt_enable(const char *res, unsigned mv)
+{
+	static const struct { const char *name; unsigned mv; } rails[] = {
+		{ "smpb11", 966 }, { "smpc1", 1900 }, { "smpb12", 1350 }, { "ldoe7", 2800 },
+	};
+	for (unsigned i = 0; res && i < sizeof(rails) / sizeof(rails[0]); i++) {
+		if (!strcmp(res, rails[i].name) && mv == rails[i].mv) {
+			return rh_vreg_enable(res, mv, -1);
+		}
+	}
+	return EINVAL;
+}
 #endif /* ARM64_BOARD_CONFIG_NEGRONI */
