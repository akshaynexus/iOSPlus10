--- /dev/null
+++ b/bsd/dev/negroni_bt.h
@@ -0,0 +1,26 @@
+/*
+ * NEGRONI (OnePlus 10 Pro 5G, SM8450): Bluetooth of the QCA6490 combo chip (patches 0330-0349).
+ * The seam between the UART/power stage (negroni_bt.c, patch 0330) and the HCI stage
+ * (negroni_bt_hci.c, patch 0331). Plan and facts: iOSPlus10 docs/bluetooth-plan.md.
+ */
+#ifndef _NEGRONI_BT_H_
+#define _NEGRONI_BT_H_
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <stdint.h>
+#include <stdbool.h>
+
+/* UART stage, implemented in negroni_bt.c */
+int negroni_bt_uart_write(const uint8_t *buf, uint32_t len);    /* 0 or errno; waits until sent */
+uint32_t negroni_bt_uart_read(uint8_t *buf, uint32_t max);      /* bytes now in the RX ring, no wait */
+int negroni_bt_uart_set_baud(uint32_t baud);                    /* 0 or errno (no clock level fits) */
+void negroni_bt_uart_flow(bool on);     /* false: RFR not ready + CTS ignored (hci_qca baud switch) */
+uint32_t negroni_bt_uart_baud(void);
+uint64_t negroni_bt_us(void);
+void negroni_bt_sleep_ms(uint32_t ms);
+uint32_t negroni_bt_arg(const char *name, uint32_t def);        /* "negronibt_" + name boot-arg */
+
+/* HCI stage, implemented in negroni_bt_hci.c: runs on the BT thread after step 8 when negronibt >= 2 */
+void negroni_bt_hci_run(uint32_t mode);
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
+#endif /* _NEGRONI_BT_H_ */
