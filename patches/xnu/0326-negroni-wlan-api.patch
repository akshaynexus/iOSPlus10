diff --git a/bsd/dev/negroni_wlan_sta.c b/bsd/dev/negroni_wlan_sta.c
new file mode 100644
index 0000000..7d7dd20
--- /dev/null
+++ b/bsd/dev/negroni_wlan_sta.c
@@ -0,0 +1,510 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: the station manager and the API for the iOS side (negroni_wlan_api.h).
+ *
+ * 0326: API state, client registration, the BSS list (every beacon / probe response of WMI_MGMT_RX, with its
+ *       security and the elements a join needs), scan requests from the API.
+ * 0327+: join, data path and WPA2 add to the service pass.
+ *
+ * Threads: the API functions take g_mtx, copy, post a request flag and return. The driver thread (keep-alive loop,
+ * negroni_wlan_sta_service) does all chip work. Callbacks run on the driver thread with g_mtx not held.
+ * UNTESTED ON HARDWARE.
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include "negroni_wlan.h"
+#include "negroni_wlan_mhi.h"
+#include "negroni_wlan_sta.h"
+
+static LCK_GRP_DECLARE(g_grp, "negroni_wlan_api");
+static LCK_MTX_DECLARE(g_mtx, &g_grp);
+
+static struct nwlan_link g_link;                /* under g_mtx */
+static struct nwlan_bss g_bss[NWLAN_BSS_MAX];   /* under g_mtx */
+static uint32_t g_nbss;
+static struct nwlan_callbacks g_cb;             /* under g_mtx */
+static bool g_cb_set;
+static uint32_t g_caps = NWLAN_CAP_SCAN;
+/* requests from the API (under g_mtx) */
+static bool g_req_scan;
+static bool g_scanning;                         /* driver thread only */
+static uint32_t g_scan_count;
+static uint64_t g_scan_start_ms;
+#define API_SCAN_TIMEOUT_MS     30000u
+
+/* ---- events: called on the driver thread without the lock ---- */
+static void
+emit(uint32_t ev)
+{
+	struct nwlan_callbacks cb;
+	bool set;
+
+	lck_mtx_lock(&g_mtx);
+	cb = g_cb;
+	set = g_cb_set;
+	lck_mtx_unlock(&g_mtx);
+	if (set && cb.event) {
+		cb.event(cb.ctx, ev);
+	}
+}
+
+static void
+set_state(uint32_t st, int error)
+{
+	uint32_t old;
+
+	lck_mtx_lock(&g_mtx);
+	old = g_link.state;
+	g_link.state = st;
+	if (error) {
+		g_link.last_error = error;
+	}
+	lck_mtx_unlock(&g_mtx);
+	if (old != st) {
+		printf("NEGRONI WLAN: API state %u -> %u%s\n", old, st, error ? " (error)" : "");
+		emit(NWLAN_EV_STATE);
+	}
+}
+
+void
+negroni_wlan_sta_lifecycle(uint32_t state, int error)
+{
+	if (state == NWLAN_STATE_IDLE) {
+		const uint8_t *mac = negroni_wlan_wmi_mac();
+		lck_mtx_lock(&g_mtx);
+		if (mac) {
+			memcpy(g_link.mac, mac, 6);
+		}
+		lck_mtx_unlock(&g_mtx);
+	}
+	set_state(state, error);
+}
+
+/* ---- the BSS of a beacon / probe response (pure: no kernel state; IEEE 802.11-2016 9.3.3.3, 9.4.2) ---- */
+static bool
+oui_is(const uint8_t *d, uint32_t a, uint32_t b, uint32_t c, uint32_t t)
+{
+	return d[0] == a && d[1] == b && d[2] == c && d[3] == t;
+}
+
+/* RSN element (9.4.2.25): WPA2-PSK = AKM 00-0f-ac:2 and CCMP (00-0f-ac:4) pairwise */
+static uint32_t
+rsn_security(const uint8_t *d, uint32_t n)
+{
+	uint32_t o = 2, cnt;
+	bool ccmp = false, psk = false, other = false;
+
+	if (n < 2 || (d[0] | d[1] << 8) != 1) {
+		return NWLAN_SEC_WPA2_OTHER;
+	}
+	if (n < o + 4) {
+		return NWLAN_SEC_WPA2_PSK;      /* defaults: CCMP + PSK (9.4.2.25.1) */
+	}
+	o += 4;                                 /* group cipher */
+	if (n < o + 2) {
+		return NWLAN_SEC_WPA2_PSK;
+	}
+	cnt = d[o] | d[o + 1] << 8;
+	o += 2;
+	if (cnt == 0 || n < o + 4 * cnt) {
+		return NWLAN_SEC_WPA2_OTHER;
+	}
+	for (uint32_t i = 0; i < cnt; i++, o += 4) {
+		ccmp = ccmp || oui_is(d + o, 0x00, 0x0f, 0xac, 4);
+	}
+	if (n < o + 2) {
+		return ccmp ? NWLAN_SEC_WPA2_PSK : NWLAN_SEC_WPA2_OTHER;
+	}
+	cnt = d[o] | d[o + 1] << 8;
+	o += 2;
+	if (cnt == 0 || n < o + 4 * cnt) {
+		return NWLAN_SEC_WPA2_OTHER;
+	}
+	for (uint32_t i = 0; i < cnt; i++, o += 4) {
+		if (oui_is(d + o, 0x00, 0x0f, 0xac, 2)) {
+			psk = true;
+		} else {
+			other = true;
+		}
+	}
+	return (psk && ccmp) ? NWLAN_SEC_WPA2_PSK : (other || !ccmp ? NWLAN_SEC_WPA2_OTHER : NWLAN_SEC_WPA2_PSK);
+}
+
+int
+negroni_wlan_sta_parse_bss(const uint8_t *f, uint32_t len, struct nwlan_bss *out)
+{
+	memset(out, 0, sizeof(*out));
+	if (!f || len < 24) {
+		return EBADMSG;
+	}
+	uint32_t fc = (uint32_t)f[0] | (uint32_t)f[1] << 8;
+	if (((fc >> 2) & 3) != 0 || (((fc >> 4) & 0xf) != 8 && ((fc >> 4) & 0xf) != 5)) {
+		return ENOENT;
+	}
+	if (len < 36) {
+		return EBADMSG;
+	}
+	memcpy(out->bssid, f + 16, 6);
+	out->beacon_int = (uint16_t)(f[32] | f[33] << 8);
+	out->capab = (uint16_t)(f[34] | f[35] << 8);
+	bool have_ssid = false, rsn = false, wpa = false;
+	for (uint32_t o = 36; o < len;) {
+		if (len - o < 2) {
+			return EBADMSG;
+		}
+		uint32_t id = f[o], el = f[o + 1];
+		const uint8_t *d = f + o + 2;
+		if (el > len - o - 2) {
+			return EBADMSG;
+		}
+		bool keep = false;
+		if (id == 0 && !have_ssid) {
+			if (el > NWLAN_SSID_MAX) {
+				return EBADMSG;
+			}
+			have_ssid = true;
+			out->ssid_len = (uint8_t)el;
+			memcpy(out->ssid, d, el);
+		} else if (id == 3 && el >= 1) {
+			out->channel = d[0];
+		} else if (id == 48 && !rsn) {
+			rsn = true;
+			out->security |= rsn_security(d, el);
+			keep = true;
+		} else if (id == 221 && el >= 4 && d[0] == 0x00 && d[1] == 0x50 && d[2] == 0xf2) {
+			wpa = wpa || d[3] == 1;
+			keep = d[3] == 1 || d[3] == 2;  /* WPA, WMM */
+		} else if (id == 1 || id == 50 || id == 45 || id == 61 || id == 191 || id == 192 || id == 127) {
+			keep = true;                    /* rates, ext rates, HT cap/op, VHT cap/op, ext cap */
+		}
+		if (keep && out->ie_len + 2 + el <= NWLAN_IE_MAX) {
+			memcpy(out->ie + out->ie_len, f + o, 2 + el);
+			out->ie_len = (uint16_t)(out->ie_len + 2 + el);
+		}
+		o += 2 + el;
+	}
+	if (!rsn) {
+		out->security |= wpa ? NWLAN_SEC_WPA : (out->capab & 0x10) ? NWLAN_SEC_WEP : NWLAN_SEC_OPEN;
+	}
+	return 0;
+}
+
+static uint8_t
+freq_channel(uint32_t f)
+{
+	if (f == 2484) {
+		return 14;
+	}
+	if (f >= 2412 && f < 2484) {
+		return (uint8_t)((f - 2407) / 5);
+	}
+	if (f >= 5000 && f < 5900) {
+		return (uint8_t)((f - 5000) / 5);
+	}
+	return 0;
+}
+
+/* MGMT_RX (inside the service pass): beacons and probe responses into the list; later patches add join frames */
+void
+negroni_wlan_sta_mgmt_rx(const uint8_t *frame, uint32_t len, int32_t rssi, uint32_t freq)
+{
+	static struct nwlan_bss b;      /* driver thread only */
+	uint64_t now = negroni_wlan_ms();
+	bool rssi_ev = false;
+
+	if (negroni_wlan_sta_parse_bss(frame, len, &b) != 0) {
+		negroni_wlan_sta_join_frame(frame, len);       /* 0327: auth / assoc / deauth */
+		return;
+	}
+	b.rssi = (int8_t)MAX(MIN(rssi, 0), -127);
+	b.freq = (uint16_t)freq;
+	if (!b.channel) {
+		b.channel = freq_channel(freq);
+	}
+	b.seen_ms = now;
+	lck_mtx_lock(&g_mtx);
+	uint32_t i, oldest = 0;
+	for (i = 0; i < g_nbss; i++) {
+		if (!memcmp(g_bss[i].bssid, b.bssid, 6)) {
+			break;
+		}
+		if (g_bss[i].seen_ms < g_bss[oldest].seen_ms) {
+			oldest = i;
+		}
+	}
+	if (i == g_nbss) {
+		i = g_nbss < NWLAN_BSS_MAX ? g_nbss++ : oldest;
+	}
+	if (b.ssid_len == 0 && g_bss[i].ssid_len && !memcmp(g_bss[i].bssid, b.bssid, 6)) {
+		/* a hidden beacon after a probe response: keep the name */
+		b.ssid_len = g_bss[i].ssid_len;
+		memcpy(b.ssid, g_bss[i].ssid, b.ssid_len);
+	}
+	g_bss[i] = b;
+	if (g_link.state >= NWLAN_STATE_JOINING && g_link.state <= NWLAN_STATE_CONNECTED &&
+	    !memcmp(g_link.bssid, b.bssid, 6)) {
+		static uint64_t last_rssi_ms;
+		g_link.rssi = b.rssi;
+		if (now - last_rssi_ms >= 1000) {
+			last_rssi_ms = now;
+			rssi_ev = true;
+		}
+	}
+	lck_mtx_unlock(&g_mtx);
+	negroni_wlan_sta_beacon_seen(b.bssid);         /* 0327: beacon-loss timer */
+	if (rssi_ev) {
+		emit(NWLAN_EV_RSSI);
+	}
+}
+
+void
+negroni_wlan_sta_scan_done(uint32_t reason)
+{
+	(void)reason;
+	if (!g_scanning && g_link.state != NWLAN_STATE_SCANNING) {
+		g_scan_count++;                 /* the level-10 scan or a join's own scan: no API scan to finish */
+		emit(NWLAN_EV_SCAN_DONE);
+		return;
+	}
+	g_scanning = false;
+	g_scan_count++;
+	printf("NEGRONI WLAN: API scan %u done: %u BSS in the list\n", g_scan_count, g_nbss);
+	if (g_link.state == NWLAN_STATE_SCANNING) {
+		set_state(NWLAN_STATE_IDLE, 0);
+	}
+	emit(NWLAN_EV_SCAN_DONE);
+}
+
+/* driver thread, top level (keep-alive loop) */
+void
+negroni_wlan_sta_service(void)
+{
+	bool scan;
+
+	lck_mtx_lock(&g_mtx);
+	scan = g_req_scan && !g_scanning && g_link.state == NWLAN_STATE_IDLE;
+	if (scan) {
+		g_req_scan = false;
+	}
+	lck_mtx_unlock(&g_mtx);
+	if (scan) {
+		int error = negroni_wlan_wmi_scan_start();
+		if (error) {
+			printf("NEGRONI WLAN: API scan not started (error %d)\n", error);
+			emit(NWLAN_EV_SCAN_DONE);
+		} else {
+			g_scanning = true;
+			g_scan_start_ms = negroni_wlan_ms();
+			set_state(NWLAN_STATE_SCANNING, 0);
+		}
+	}
+	if (g_scanning && negroni_wlan_ms() - g_scan_start_ms > API_SCAN_TIMEOUT_MS) {
+		printf("NEGRONI WLAN: API scan time-out after %u ms (no SCAN COMPLETED)\n", API_SCAN_TIMEOUT_MS);
+		negroni_wlan_sta_scan_done(~0u);
+	}
+	negroni_wlan_sta_join_service();               /* 0327 */
+}
+
+/* ================================ API ================================ */
+uint32_t
+negroni_wlan_api_version(void)
+{
+	return NWLAN_API_VERSION;
+}
+
+uint32_t
+negroni_wlan_api_caps(void)
+{
+	return g_caps | negroni_wlan_sta_join_caps();
+}
+
+bool
+negroni_wlan_api_ready(void)
+{
+	uint32_t st = g_link.state;
+	return st >= NWLAN_STATE_IDLE && st != NWLAN_STATE_FAILED;
+}
+
+int
+negroni_wlan_register(const struct nwlan_callbacks *cb)
+{
+	int error = 0;
+
+	lck_mtx_lock(&g_mtx);
+	if (!cb) {
+		memset(&g_cb, 0, sizeof(g_cb));
+		g_cb_set = false;
+	} else if (g_cb_set) {
+		error = EBUSY;
+	} else {
+		g_cb = *cb;
+		g_cb_set = true;
+	}
+	lck_mtx_unlock(&g_mtx);
+	return error;
+}
+
+int
+negroni_wlan_link(struct nwlan_link *out)
+{
+	if (!out) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&g_mtx);
+	*out = g_link;
+	lck_mtx_unlock(&g_mtx);
+	negroni_wlan_sta_link_counters(out);           /* 0328: data counters */
+	return 0;
+}
+
+int
+negroni_wlan_scan(void)
+{
+	int error = 0;
+
+	lck_mtx_lock(&g_mtx);
+	if (g_link.state != NWLAN_STATE_IDLE && g_link.state != NWLAN_STATE_SCANNING) {
+		error = (g_link.state < NWLAN_STATE_IDLE || g_link.state == NWLAN_STATE_FAILED) ? ENXIO : EBUSY;
+	} else {
+		g_req_scan = true;
+	}
+	lck_mtx_unlock(&g_mtx);
+	return error;
+}
+
+uint32_t
+negroni_wlan_scan_results(struct nwlan_bss *out, uint32_t max)
+{
+	uint32_t n = 0;
+	bool used[NWLAN_BSS_MAX] = { false };
+
+	if (!out) {
+		return 0;
+	}
+	lck_mtx_lock(&g_mtx);
+	while (n < max && n < g_nbss) {
+		uint32_t best = ~0u;
+		for (uint32_t i = 0; i < g_nbss; i++) {
+			if (!used[i] && (best == ~0u || g_bss[i].seen_ms > g_bss[best].seen_ms)) {
+				best = i;
+			}
+		}
+		used[best] = true;
+		out[n++] = g_bss[best];
+	}
+	lck_mtx_unlock(&g_mtx);
+	return n;
+}
+
+/* the strongest BSS named `ssid` seen in the last 60 s (copy); false if none */
+bool
+negroni_wlan_sta_find(const uint8_t *ssid, uint32_t ssid_len, struct nwlan_bss *out)
+{
+	uint64_t now = negroni_wlan_ms();
+	bool found = false;
+
+	lck_mtx_lock(&g_mtx);
+	for (uint32_t i = 0; i < g_nbss; i++) {
+		struct nwlan_bss *b = &g_bss[i];
+		if (b->ssid_len != ssid_len || memcmp(b->ssid, ssid, ssid_len) || now - b->seen_ms > 60000 || b->freq == 0) {
+			continue;
+		}
+		if (!found || b->rssi > out->rssi) {
+			*out = *b;
+			found = true;
+		}
+	}
+	lck_mtx_unlock(&g_mtx);
+	return found;
+}
+
+/* a scan runs (the join waits for its end) */
+bool
+negroni_wlan_sta_scanning(void)
+{
+	return g_scanning;
+}
+
+/* a join starts: a scan request not yet started ends now (SCAN_DONE with the current list) */
+void
+negroni_wlan_sta_scan_cancel(void)
+{
+	bool pending;
+
+	lck_mtx_lock(&g_mtx);
+	pending = g_req_scan;
+	g_req_scan = false;
+	lck_mtx_unlock(&g_mtx);
+	if (pending) {
+		emit(NWLAN_EV_SCAN_DONE);
+	}
+}
+
+/* a join that ends before JOINING (no BSS, wrong security, ...): state IDLE and always NWLAN_EV_LINK_DOWN */
+void
+negroni_wlan_sta_join_failed(const struct nwlan_bss *b, int error, uint16_t reason)
+{
+	negroni_wlan_sta_set_link(b, NWLAN_STATE_IDLE, error, reason, 0);
+	emit(NWLAN_EV_LINK_DOWN);
+}
+
+/* 0327+: helpers for the join / data parts */
+void
+negroni_wlan_sta_set_link(const struct nwlan_bss *b, uint32_t state, int error, uint16_t reason, uint16_t aid)
+{
+	uint32_t old;
+
+	lck_mtx_lock(&g_mtx);
+	old = g_link.state;
+	if (b) {
+		memcpy(g_link.bssid, b->bssid, 6);
+		g_link.ssid_len = b->ssid_len;
+		memcpy(g_link.ssid, b->ssid, b->ssid_len);
+		g_link.rssi = b->rssi;
+		g_link.freq = b->freq;
+		g_link.security = b->security;
+	}
+	g_link.state = state;
+	g_link.aid = aid;
+	if (error || reason) {
+		g_link.last_error = error;
+		g_link.reason = reason;
+	}
+	lck_mtx_unlock(&g_mtx);
+	if (old != state) {
+		printf("NEGRONI WLAN: API state %u -> %u (error %d, reason %u)\n", old, state, error, reason);
+		emit(NWLAN_EV_STATE);
+		if (state == NWLAN_STATE_CONNECTED) {
+			emit(NWLAN_EV_LINK_UP);
+		} else if (old >= NWLAN_STATE_JOINING && old <= NWLAN_STATE_CONNECTED &&
+		    (state < NWLAN_STATE_JOINING || state > NWLAN_STATE_CONNECTED)) {
+			emit(NWLAN_EV_LINK_DOWN);
+		}
+	}
+}
+
+uint32_t
+negroni_wlan_sta_state(void)
+{
+	return g_link.state;
+}
+
+/* deliver one 802.3 frame to the client (driver thread) */
+void
+negroni_wlan_sta_deliver(const uint8_t *frame, uint32_t len)
+{
+	struct nwlan_callbacks cb;
+	bool set;
+
+	lck_mtx_lock(&g_mtx);
+	cb = g_cb;
+	set = g_cb_set;
+	lck_mtx_unlock(&g_mtx);
+	if (set && cb.rx) {
+		cb.rx(cb.ctx, frame, len);
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
