diff --git a/bsd/dev/negroni_wlan_api.h b/bsd/dev/negroni_wlan_api.h
new file mode 100644
index 0000000..cadeb6e
--- /dev/null
+++ b/bsd/dev/negroni_wlan_api.h
@@ -0,0 +1,142 @@
+/*
+ * NEGRONI QCA6490 Wi-Fi: the seam between the kernel driver (bsd/dev/negroni_wlan*.c, patches 0261-0329) and the
+ * iOS side (the Apple80211 / IO80211 interface and en0). Patch 0326 defines it; 0327-0329 fill it in.
+ *
+ * Plain C, no IOKit types: an IOKit (C++) client includes it inside extern "C" { }. Every function may be called
+ * from any thread, after negroni_wlan_api_ready() returns true. None of them blocks on the chip: a request goes
+ * into the driver thread's mailbox and the result comes back as an event (callback) and in negroni_wlan_link().
+ *
+ * Threads: the driver owns the chip on its own kernel thread (the keep-alive poller, 20 ms). Callbacks run on that
+ * thread. A callback must not block, sleep or call back into this API except negroni_wlan_tx() and the getters;
+ * copy what you need and return. RX frames are only valid during the callback.
+ *
+ * Frames: 802.3 / Ethernet II, as en0 sees them: dst[6] src[6] ethertype[2] payload. The driver converts to and
+ * from 802.11 (data path, 0328). EAPOL (0x888e) never reaches the RX callback while the kernel's own WPA2 handshake
+ * runs (0329); it does after the link is up only if the AP starts a new group-key handshake (the driver answers it,
+ * the frame is not passed on).
+ *
+ * Status of each function: see the NWLAN_CAP_* bits returned by negroni_wlan_api_caps(). A function whose bit is not
+ * set returns ENOTSUP. The caller checks NWLAN_API_VERSION against negroni_wlan_api_version().
+ */
+#ifndef _NEGRONI_WLAN_API_H_
+#define _NEGRONI_WLAN_API_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#define NWLAN_API_VERSION       1u
+
+#define NWLAN_SSID_MAX          32u
+#define NWLAN_IE_MAX            320u    /* RSN, WPA, HT/VHT capability elements of a BSS, as received */
+#define NWLAN_BSS_MAX           64u     /* the driver keeps the newest 64 BSS of the last scans */
+#define NWLAN_PSK_MIN           8u      /* passphrase 8..63 printable ASCII, or 64 hex digits (a raw PMK) */
+#define NWLAN_PSK_MAX           64u
+
+/* capability bits: which parts of this API the running kernel implements */
+#define NWLAN_CAP_SCAN          (1u << 0)       /* 0326: scan list + passive scan request */
+#define NWLAN_CAP_JOIN_OPEN     (1u << 1)       /* 0327: associate to an open network */
+#define NWLAN_CAP_DATA          (1u << 2)       /* 0328: negroni_wlan_tx and the RX callback carry frames */
+#define NWLAN_CAP_WPA2_PSK      (1u << 3)       /* 0329: associate with a passphrase (WPA2-PSK, CCMP) */
+
+/* security of a BSS (bits) */
+#define NWLAN_SEC_OPEN          0u
+#define NWLAN_SEC_WEP           (1u << 0)       /* privacy bit without RSN/WPA: not supported for joining */
+#define NWLAN_SEC_WPA           (1u << 1)       /* WPA1 element: not supported for joining */
+#define NWLAN_SEC_WPA2_PSK      (1u << 2)       /* RSN with AKM 00-0f-ac:2 and CCMP */
+#define NWLAN_SEC_WPA2_OTHER    (1u << 3)       /* RSN with another AKM (802.1X, SAE, ...): not supported */
+
+/* link state (struct nwlan_link.state) */
+enum nwlan_state {
+	NWLAN_STATE_OFF = 0,            /* driver not started, or stopped after a chip error */
+	NWLAN_STATE_STARTING,           /* firmware download .. WMI READY */
+	NWLAN_STATE_IDLE,               /* firmware up, no association */
+	NWLAN_STATE_SCANNING,
+	NWLAN_STATE_JOINING,            /* channel, authentication, association */
+	NWLAN_STATE_HANDSHAKE,          /* associated, WPA2 4-way handshake running */
+	NWLAN_STATE_CONNECTED,          /* data frames flow (open: after association; WPA2: after the keys) */
+	NWLAN_STATE_FAILED,             /* the chip stopped; see last_error */
+};
+
+/* events (struct nwlan_callbacks.event) */
+enum nwlan_event {
+	NWLAN_EV_STATE = 1,             /* the state changed: read negroni_wlan_link() */
+	NWLAN_EV_SCAN_DONE,             /* a scan ended: read negroni_wlan_scan_results() */
+	NWLAN_EV_LINK_UP,               /* CONNECTED reached (en0: link up, start DHCP) */
+	NWLAN_EV_LINK_DOWN,             /* the association ended (deauth, beacon loss, failure, request) */
+	NWLAN_EV_RSSI,                  /* a new RSSI value (at most once per second) */
+};
+
+struct nwlan_bss {
+	uint8_t bssid[6];
+	uint8_t ssid_len;               /* 0 = hidden */
+	uint8_t ssid[NWLAN_SSID_MAX];   /* raw bytes, not NUL terminated */
+	int8_t rssi;                    /* dBm */
+	uint8_t channel;
+	uint16_t freq;                  /* MHz */
+	uint16_t beacon_int;            /* TU */
+	uint16_t capab;                 /* 802.11 capability information */
+	uint32_t security;              /* NWLAN_SEC_* */
+	uint64_t seen_ms;               /* uptime of the last beacon / probe response */
+	uint16_t ie_len;
+	uint8_t ie[NWLAN_IE_MAX];       /* selected elements as received (id, len, data)...: RSN 48, WPA 221, HT 45, VHT 191 */
+};
+
+struct nwlan_link {
+	uint32_t state;                 /* enum nwlan_state */
+	uint8_t mac[6];                 /* the chip's MAC (WMI READY); en0's address */
+	uint8_t bssid[6];               /* valid in JOINING .. CONNECTED */
+	uint8_t ssid_len;
+	uint8_t ssid[NWLAN_SSID_MAX];
+	int8_t rssi;                    /* dBm, last value */
+	uint16_t freq;
+	uint16_t aid;
+	uint32_t security;              /* NWLAN_SEC_* of the joined BSS */
+	int32_t last_error;             /* errno of the last failure (0 = none) */
+	uint16_t reason;                /* 802.11 status (auth/assoc) or reason (deauth/disassoc) code of the last failure */
+	uint64_t tx_frames, rx_frames, tx_dropped, rx_dropped;
+};
+
+struct nwlan_callbacks {
+	void *ctx;
+	/* one 802.3 frame received (valid only during the call) */
+	void (*rx)(void *ctx, const uint8_t *frame, uint32_t len);
+	/* enum nwlan_event */
+	void (*event)(void *ctx, uint32_t event);
+};
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+uint32_t negroni_wlan_api_version(void);        /* NWLAN_API_VERSION of the kernel */
+uint32_t negroni_wlan_api_caps(void);           /* NWLAN_CAP_* */
+bool negroni_wlan_api_ready(void);              /* the firmware is up (state >= IDLE) */
+
+/* one client (the en0 driver); NULL unregisters. Returns EBUSY if another client is registered. */
+int negroni_wlan_register(const struct nwlan_callbacks *cb);
+
+/* link state, counters, MAC (copy) */
+int negroni_wlan_link(struct nwlan_link *out);
+
+/* start a passive scan of all channels (about 6 s); NWLAN_EV_SCAN_DONE at the end. EBUSY while joining. */
+int negroni_wlan_scan(void);
+/* copy up to `max` BSS of the list (newest first); returns how many were copied */
+uint32_t negroni_wlan_scan_results(struct nwlan_bss *out, uint32_t max);
+
+/*
+ * Join `ssid` (the strongest BSS with that SSID from the list; a scan runs first if none is known).
+ * psk == NULL / psk_len == 0: open network. Else WPA2-PSK: a passphrase (8..63 bytes) or 64 hex digits.
+ * Returns at once (0, EINVAL, ENOTSUP, EBUSY); the result is NWLAN_EV_LINK_UP or NWLAN_EV_LINK_DOWN with
+ * last_error / reason in negroni_wlan_link(). The passphrase is copied, never logged, and wiped after use.
+ */
+int negroni_wlan_associate(const uint8_t *ssid, uint32_t ssid_len, const char *psk, uint32_t psk_len);
+int negroni_wlan_disassociate(void);
+
+/* send one 802.3 frame (copied). ENOTCONN when not CONNECTED, ENOBUFS when the TX queue is full (64 frames). */
+int negroni_wlan_tx(const uint8_t *frame, uint32_t len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _NEGRONI_WLAN_API_H_ */
