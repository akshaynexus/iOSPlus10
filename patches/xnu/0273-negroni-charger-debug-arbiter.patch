+/* ---- 0273: the AOP QMP message for the QDSS clock (patch 0240 step 4, Linux qcom_aoss.c) ---- */
+
+static bool
+qm_wait(vm_offset_t aoss, unsigned off, uint32_t want, unsigned ms)
+{
+	for (unsigned i = 0; i < ms; i++) {
+		if (sp_rd(aoss, off) == want) {
+			return true;
+		}
+		IOSleep(1);
+	}
+	return sp_rd(aoss, off) == want;
+}
+
+/* Thread context, sleeps; not under sp_lock (QMP is not SPMI). 0 when the AOP took the message. */
+static int
+qm_send(const char *text, char *why, size_t len)
+{
+	static vm_offset_t aoss, ipcc;
+	uint32_t words[QM_MSG_LEN / 4] = { 0 }, box, boxsize;
+	size_t n = strlen(text);
+	if (n >= QM_MSG_LEN) {
+		snprintf(why, len, "message too long");
+		return -1;
+	}
+	if (!aoss) {
+		aoss = ml_io_map(QM_AOSS_PA, QM_AOSS_SIZE);
+	}
+	if (!ipcc) {
+		ipcc = ml_io_map(QM_IPCC_PA, 0x1000);
+	}
+	if (!aoss || !ipcc) {
+		snprintf(why, len, "AOSS/IPCC map failed");
+		return -1;
+	}
+	if (sp_rd(aoss, QM_MAGIC) != QM_MAGIC_VALUE || sp_rd(aoss, QM_VERSION) != 1) {
+		snprintf(why, len, "AOSS QMP magic %#x version %u", sp_rd(aoss, QM_MAGIC), sp_rd(aoss, QM_VERSION));
+		return -1;
+	}
+	box = sp_rd(aoss, QM_MBOX_OFFSET);
+	boxsize = sp_rd(aoss, QM_MBOX_SIZE);
+	if ((box & 3) || box < 0x3c || boxsize < QM_MSG_LEN + 4 || box + boxsize > QM_AOSS_SIZE) {
+		snprintf(why, len, "QMP mailbox at %#x size %#x does not fit", box, boxsize);
+		return -1;
+	}
+	if (!(sp_rd(aoss, QM_MCORE_LINK) == QM_UP && sp_rd(aoss, QM_MCORE_LINK_ACK) == QM_UP &&
+	    sp_rd(aoss, QM_MCORE_CH) == QM_UP && sp_rd(aoss, QM_UCORE_CH) == QM_UP && sp_rd(aoss, QM_MCORE_CH_ACK) == QM_UP)) {
+		printf("NEGRONI BATTERY: debug arbiter: opening the QMP link and channel to the AOP\n");
+		sp_wr(aoss, QM_UCORE_LINK_ACK, sp_rd(aoss, QM_UCORE_LINK));
+		sp_wr(aoss, QM_MCORE_LINK, QM_UP);
+		sp_wr(ipcc, QM_IPCC_SEND_ID, 0);
+		if (!qm_wait(aoss, QM_MCORE_LINK_ACK, QM_UP, 1000)) {
+			snprintf(why, len, "AOP does not ack our QMP link");
+			return -1;
+		}
+		sp_wr(aoss, QM_MCORE_CH, QM_UP);
+		sp_wr(ipcc, QM_IPCC_SEND_ID, 0);
+		if (!qm_wait(aoss, QM_UCORE_CH, QM_UP, 1000)) {
+			snprintf(why, len, "AOP does not open its QMP channel");
+			return -1;
+		}
+		sp_wr(aoss, QM_UCORE_CH_ACK, QM_UP);
+		sp_wr(ipcc, QM_IPCC_SEND_ID, 0);
+		if (!qm_wait(aoss, QM_MCORE_CH_ACK, QM_UP, 1000)) {
+			snprintf(why, len, "AOP does not ack our QMP channel");
+			return -1;
+		}
+	}
+	/* another sender (patch 0240) may be in the middle of a message: wait up to 1 s for an empty box */
+	if (!qm_wait(aoss, box, 0, 1000)) {
+		snprintf(why, len, "QMP mailbox still holds %u bytes", sp_rd(aoss, box));
+		return -1;
+	}
+	memcpy(words, text, n + 1);
+	for (unsigned i = 0; i < QM_MSG_LEN / 4; i++) {
+		sp_wr(aoss, box + 4 + 4 * i, words[i]);
+	}
+	sp_wr(aoss, box, QM_MSG_LEN);
+	sp_wr(ipcc, QM_IPCC_SEND_ID, 0);
+	if (!qm_wait(aoss, box, 0, 1000)) {
+		sp_wr(aoss, box, 0);
+		snprintf(why, len, "AOP does not take the QMP message");
+		return -1;
+	}
+	return 0;
+}
+
+/* ---- 0273: the debug arbiter ---- */
+
+static bool
+sp_chg_block(unsigned sid, unsigned addr)
+{
+	return sid == 3 && (addr >> 8) >= 0x10 && (addr >> 8) <= 0x16;
+}
+
+/* sp_lock held, sd_state > 0. One byte. 0 ok, 1 timeout (closes the debug path), 2 failure/denied/dropped. */
+static int
+sd_xfer(unsigned op, unsigned sid, unsigned addr, uint8_t *value)
+{
+	if (op == SD_OP_EXT_WRITEL) {
+		sp_wr(sd_core, SD_WDATA0, *value);
+	}
+	sp_wr(sd_core, SD_CMD3, addr & 0xffu);
+	sp_wr(sd_core, SD_CMD2, (addr >> 8) & 0xffu);
+	sp_wr(sd_core, SD_CMD1, (0u << 4) | (sid & 0xfu));          /* 1 byte */
+	sp_wr(sd_core, SD_CMD0, op << 1);
+	uint32_t st = 0;
+	for (unsigned i = 0; i < SD_POLLS; ++i) {
+		st = sp_rd(sd_core, SD_STATUS);
+		if (st & SD_DONE) {
+			if (st & (SD_FAILURE | SD_DENIED | SD_DROPPED)) {
+				if (sd_fail_logged < SD_FAIL_LOG) {
+					sd_fail_logged++;
+					printf("NEGRONI BATTERY: debug arbiter %s sid=%u addr=%#x: status %#x (%s)%s\n",
+					    op == SD_OP_EXT_WRITEL ? "write" : "read", sid, addr, st,
+					    (st & SD_DENIED) ? "denied" : (st & SD_DROPPED) ? "dropped" : "failed",
+					    sd_fail_logged == SD_FAIL_LOG ? " (last such line)" : "");
+				}
+				if (++sd_fail_run >= SD_FAIL_CLOSE) {
+					sd_state = -1;
+					printf("NEGRONI BATTERY: debug arbiter: debug path closed: %u failures\n", sd_fail_run);
+				}
+				return 2;
+			}
+			sd_fail_run = 0;
+			if (op == SD_OP_EXT_READL) {
+				*value = (uint8_t)sp_rd(sd_core, SD_RDATA0);
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	sd_state = -1;
+	printf("NEGRONI BATTERY: debug arbiter %s sid=%u addr=%#x: timeout (status %#x): debug path closed\n",
+	    op == SD_OP_EXT_WRITEL ? "write" : "read", sid, addr, st);
+	return 1;
+}
+
+/* Once per boot (thread context, sleeps). True when the debug path is open. */
+static bool
+sd_open(bool check_fuse, bool qdss)
+{
+	if (sd_state) {
+		return sd_state > 0;
+	}
+	sd_state = -1;
+	vm_offset_t fuse = ml_io_map(SD_FUSE_PA, 0x1000);
+	uint32_t f = 0;
+	if (fuse) {
+		/* also a first access (QFPROM): the line reaches the USB log before it */
+		printf("NEGRONI BATTERY: debug arbiter: reading fuse 0x221c8784\n");
+		IOSleep(200);
+		f = sp_rd(fuse, SD_FUSE_OFF);
+	}
+	bool enabled = (f >> SD_FUSE_BIT) & 1u;
+	printf("NEGRONI BATTERY: debug arbiter: fuse 0x221c8784 = %#x%s, bit 18 %s%s\n", f, fuse ? "" : " (map failed)",
+	    enabled ? "set: debug bus enabled" : "clear: debug bus disabled by fuse",
+	    check_fuse ? "" : " (negronichg_dbgfuse=0: ignored)");
+	if (!fuse || (check_fuse && !enabled)) {
+		return false;
+	}
+	unsigned adsp = 0;
+	(void)PE_parse_boot_argn("negroniadsp", &adsp, sizeof(adsp));
+	if (qdss && adsp) {
+		/* patch 0240 (negroniadsp) uses the same QMP mailbox with no shared lock: no vote, no debug path */
+		printf("NEGRONI BATTERY: debug arbiter: QDSS vote skipped: negroniadsp=%u shares the QMP mailbox; debug path "
+		    "closed (negronichg_qdss=0 opens it without the vote)\n", adsp);
+		return false;
+	}
+	if (qdss) {
+		char why[96] = "";
+		printf("NEGRONI BATTERY: debug arbiter: AOP QMP \"{class: clock, res: qdss, val: 1}\"\n");
+		if (qm_send("{class: clock, res: qdss, val: 1}", why, sizeof(why))) {
+			printf("NEGRONI BATTERY: debug arbiter: QDSS clock vote failed (%s): debug path closed "
+			    "(negronichg_qdss=0 skips the vote)\n", why);
+			return false;
+		}
+		printf("NEGRONI BATTERY: debug arbiter: the AOP took the QDSS clock vote\n");
+	}
+	sd_core = ml_io_map(SD_CORE_PA, 0x1000);
+	if (!sd_core) {
+		printf("NEGRONI BATTERY: debug arbiter: core map failed\n");
+		return false;
+	}
+	printf("NEGRONI BATTERY: debug arbiter: first access of 0x10b14000 (a hang here: the bus has no clock)\n");
+	IOSleep(500);                   /* the line reaches the USB log before the access */
+	uint8_t dbg = 0xff, nrm = 0xff;
+	int nrc = -1;
+	lck_mtx_lock(&sp_lock);
+	sd_state = 1;
+	int rc = sd_xfer(SD_OP_EXT_READL, 3, 0x4704, &dbg);   /* PM8350B BCL TYPE */
+	if (sp_bcl_apid != SP_NO_APID && !sp_poisoned[sp_bcl_apid]) {
+		nrc = sk_read8(&sp_arb, sp_bcl_apid, 0x04, &nrm);
+	}
+	if (rc != 0 || (nrc == 0 && dbg != nrm)) {
+		sd_state = -1;
+	}
+	lck_mtx_unlock(&sp_lock);
+	printf("NEGRONI BATTERY: debug arbiter: check read SID 3 0x4704 = %02x (rc %d), normal path %02x (rc %d): %s\n",
+	    dbg, rc, nrm, nrc, sd_state > 0 ? "debug path OPEN" : "debug path closed");
+	return sd_state > 0;
+}
+
+int
+negroni_spmi_chg_route(int arb, bool want_write, bool check_fuse, bool qdss)
+{
+	static const char *const arbName[] = { "auto", "normal", "debug" };
+	if (!sp_ready || arb < 0 || arb > 2) {
+		return -1;
+	}
+	uint8_t type = 0xff;
+	int nrc = negroni_spmi_read_rc(3, 0x1004, &type);      /* CHGR TYPE through the current route */
+	unsigned chgrOwner = 7, usbinOwner = 7;
+	int chgr = negroni_spmi_apid(3, 0x10, &chgrOwner), usbin = negroni_spmi_apid(3, 0x13, &usbinOwner);
+	bool normalReads = sp_chg_route == 0 && nrc == 0;
+	bool normalWrites = chgr >= 0 && usbin >= 0 && chgrOwner == SP_EE && usbinOwner == SP_EE;
+	bool debug = arb == 2 || (arb == 0 && (!normalReads || (want_write && !normalWrites)));
+	printf("NEGRONI BATTERY: charger route (negronichg_arb=%s): normal path read CHGR 0x1004 rc %d, CHGR APID %d EE %u, "
+	    "USBIN APID %d EE %u -> %s\n", arbName[arb], nrc, chgr, chgrOwner, usbin, usbinOwner,
+	    debug ? "try the debug arbiter" : "normal arbiter");
+	if (debug && sd_open(check_fuse, qdss)) {
+		lck_mtx_lock(&sp_lock);
+		if (sp_chg_route != 1) {
+			sp_chg_route = 1;
+			sp_chg_unlocked = false;        /* negroni_spmi_chg_unlock() decides again */
+		}
+		lck_mtx_unlock(&sp_lock);
+	}
+	return sp_chg_route;
+}
