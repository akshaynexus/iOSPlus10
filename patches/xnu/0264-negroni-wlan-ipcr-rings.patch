@@ -708,6 +718,22 @@ wlan_level_amss(void)
 		return error;
 	}
 	negroni_wlan_step(15, "IPCR channels 20/21");
+	/* 0264: RX/TX buffers for QRTR, a second contiguous allocation (inside the 0..36-bit MHI window) */
+	if (kmem_alloc_contig(kernel_map, &g_xfer_kva, WLAN_XFER_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
