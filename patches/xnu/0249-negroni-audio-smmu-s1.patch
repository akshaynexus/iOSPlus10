diff --git a/bsd/dev/negroni_smmu_s1.c b/bsd/dev/negroni_smmu_s1.c
new file mode 100644
index 0000000..ba17d38
--- /dev/null
+++ b/bsd/dev/negroni_smmu_s1.c
@@ -0,0 +1,911 @@
+/*
+ * NEGRONI (SM8450): apps-SMMU stage-1 contexts of our own (patch 0249). See negroni_smmu_s1.h for why
+ * and for the rules that keep this file and the Wi-Fi copy (0324 negroni_wlan_smmu.c) apart.
+ *
+ * Order (Linux arm-smmu.c arm_smmu_write_context_bank / arm_smmu_write_sme, io-pgtable-arm.c; the same
+ * values as negroni_adreno.c (0233) and negroni_wlan_smmu.c (0324) on this SoC): context bank off,
+ * CBA2R (VA64), CBAR (stage 1, stage 2 bypass), TCR2/TCR (39-bit input, 36-bit output, 4 KiB granule),
+ * TTBR0 (+ ASID = context index), MAIR0, fault status clear, TLB invalidate + sync, SCTLR on; then per
+ * stream S2CR (translate, context index) and only then the SMR valid bit. Every global write is read
+ * back; a refused write stops before any DMA; stream entries are put back, CBAR/CBA2R never (see below).
+ * Hardware: live.dts:15350-15370 apps-smmu@15000000 (qcom,qsmmu-v500, qcom,skip-init,
+ * qcom,num-smr-override 0x78, qcom,num-context-banks-override 0x4e). The first version panicked on hardware
+ * (2026-10-27, below); this version is not yet run on hardware.
+ *
+ * 2026-10-27 rework, after the panic of the first boot with 0249 (Kernel data abort, ESR 0x96000010, FAR
+ * offset 0x128 of global page 1 = CBAR(74), pc at the CBAR restore in undo(): Gunyah refused the write
+ * of the old CBAR (type S2_TRANS) with an SEA):
+ *   - every global/context access of setup, teardown and probe goes through negroni_mmio_try_rd32/wr32
+ *     (0297): a refused access is an error, not a panic; a kernel without that hook (no CONFIG_XNUPOST)
+ *     gets no stage-1 context at all (ENOTSUP);
+ *   - teardown is Linux's: arm_smmu_destroy_domain_context -> arm_smmu_write_context_bank(cfg NULL) writes
+ *     SCTLR = 0 only (OnePlus sm8450 arm-smmu.c:1168-1171, 1779-1833). CBAR and CBA2R are never written
+ *     back (HakiOS hakios.wifi.c/sound.c/camera.c do the same and ran on SM7325); the bank goes on a
+ *     "released by us" list and is reused by the next negroni_s1_on;
+ *   - context banks from the bottom up, from IDR1.NUMS2CB (Linux arm_smmu_init_domain_context: stage-1
+ *     start = num_s2_context_banks, arm-smmu.c:1572-1574; HakiOS used contexts 7/8); a bank whose claim
+ *     write (CBA2R/CBAR) is refused or not kept is skipped (no restore write), up to 8 candidates;
+ *   - TLB sync: TLBIASID, TLBSYNC, TLBSTATUS polled up to 500 ms with a doubling delay (Linux
+ *     __arm_smmu_tlb_sync, TLB_LOOP_TIMEOUT 500000 us; was 10 ms); a time-out prints the TBU sync/inv
+ *     ack state (IMPL_DEF5 + 0x5dc) and GR0 + 0x2670 (qsmmuv500_tlb_sync_timeout);
+ *   - negronismmu_probe=1|2 (default 0): one survey of all banks at boot: reads plus a same-value CBAR write
+ *     (see negroni_smmu_probe); result again in the log after negronismmu_probe_again s (default 60) and in
+ *     sysctl kern.negroni_smmu_probe (root).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <stdarg.h>
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/startup.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <sys/sysctl.h>
+#include <sys/kauth.h>
+#include <kern/thread_call.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern.h>
+#include "negroni_mmio.h"
+#include "negroni_smmu_s1.h"
+
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t sz);
+extern uint64_t kvtophys(vm_offset_t va);
+extern vm_map_address_t phystokv(uint64_t pa);
+
+#define APPS_SMMU_PHYS          0x15000000ull
+#define APPS_SMMU_SIZE          0x100000ull     /* live.dts:15352 */
+#define S1_WIMG_IO              0x7u
+#define MAX_CTX                 0x4eu           /* qcom,num-context-banks-override */
+#define MAX_SMR                 0x78u           /* qcom,num-smr-override */
+#define G0_PAGES                8u              /* global pages 0-7: GR0, GR1, ..., IMPL_DEF5 (page 7) */
+#define MAX_TRIES               8u              /* context banks tried per negroni_s1_on */
+
+#define SMMU_SCR0               0x000
+#define SMMU_SCR0_EXIDENABLE    (1u << 3)
+#define SMMU_IDR0               0x020
+#define SMMU_IDR1               0x024
+#define SMMU_IDR2               0x028
+#define SMMU_SGFSR              0x048
+#define SMMU_SGFSYNR1           0x054
+#define SMMU_STLBGSTATUS        0x074
+#define SMMU_SMR(n)             (0x800u + 4u * (n))
+#define SMMU_S2CR(n)            (0xc00u + 4u * (n))
+#define SMMU_SMR_VALID          (1u << 31)
+#define SMMU_CBAR(n)            (4u * (n))              /* global page 1 */
+#define SMMU_CBFRSYNRA(n)       (0x400u + 4u * (n))     /* global page 1: the faulting stream ID */
+#define SMMU_CBA2R(n)           (0x800u + 4u * (n))     /* global page 1 */
+#define QSMMU_WAIT_CNTR         0x2670u                 /* GR0: bit 20 TCU sync, bit 16 TCU inv in progress */
+#define QSMMU_TBU_ACK           0x5dcu                  /* IMPL_DEF5 (page 7): SYNC_ACK 31:17, SYNC_REQ 16, INV_ACK 15:1, INV_REQ 0 */
+#define CB_SCTLR                0x00
+#define CB_TCR2                 0x10
+#define CB_TTBR0                0x20
+#define CB_TTBR1                0x28
+#define CB_TCR                  0x30
+#define CB_MAIR0                0x38
+#define CB_MAIR1                0x3c
+#define CB_FSR                  0x58
+#define CB_FAR                  0x60
+#define CB_FSYNR0               0x68
+#define CB_TLBIASID             0x610
+#define CB_TLBSYNC              0x7f0
+#define CB_TLBSTATUS            0x7f4
+#define CBAR_S1                 (1u << 16 | 3u << 8 | 0xfu << 12)       /* 0x1f300, Linux's stage-1 CBAR */
+#define CBAR_KEEP_MASK          0x300ffu                /* TYPE and VMID: what must read back as written */
+#define CBAR_TYPE(v)            (((v) >> 16) & 3u)
+#define SCTLR_ON                (1u << 0 | 1u << 1 | 1u << 2 | 1u << 5 | 1u << 12)
+#define TCR_39                  (25u | 1u << 8 | 1u << 10 | 3u << 12 | 1u << 23)
+#define TCR2_36                 (1u | 1u << 4 | 7u << 15)
+#define MAIR0                   0xf404ff44u     /* index 0 = Normal non-cacheable; the CPU cleans/invalidates */
+#define FSR_ALL                 0xc00001feu
+#define PTE_VALID               3ull
+#define PTE_ATTR                ((1ull << 10) | (2ull << 8) | (1ull << 6) | (1ull << 11))   /* AF, SH outer, AP unpriv RW, nG */
+#define PTE_ADDR                0x0000fffffffff000ull
+#define S2CR_TYPE(v)            (((v) >> 16) & 3u)
+#define TLB_SYNC_US             500000u         /* Linux TLB_LOOP_TIMEOUT */
+
+/*
+ * The claim lock (exported, negroni_smmu_s1.h): held from the free-entry scan to the last SMR/S2CR/CBAR write in
+ * negroni_s1_on, over the whole teardown and over the probe. Any other apps-SMMU user that claims entries (Wi-Fi
+ * 0325) must take it too; until it does, it is outside this protection (the re-reads remain).
+ */
+static LCK_GRP_DECLARE(negroni_smmu_claim_grp, "negroni_smmu_claim");
+LCK_MTX_DECLARE(negroni_smmu_claim_lock, &negroni_smmu_claim_grp);
+static uint32_t snap_smr[128], snap_s2cr[128];  /* under negroni_smmu_claim_lock */
+int8_t negroni_smmu_cb_verdict[128];            /* NEGRONI_CB_*, filled by the probe and by negroni_s1_on */
+static bool cb_released[128];                   /* ours once, SCTLR 0 now, CBAR left at CBAR_S1: reusable */
+
+#define G0R(s, o)       negroni_mmio_rd32((s)->g0 + (o))
+#define CBR(s, c, o)    negroni_mmio_rd32((s)->cbva + (vm_offset_t)(c) * (s)->page + (o))
+#define CBW(s, c, o, v) negroni_mmio_wr32((s)->cbva + (vm_offset_t)(c) * (s)->page + (o), (v))
+
+static void
+dsb(void)
+{
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* refusable accesses (0297): 0 done, else the access aborted (or cannot be guarded) */
+static int
+grd(struct negroni_s1 *s, uint32_t off, uint32_t *v)
+{
+	return negroni_mmio_try_rd32(s->g0 + off, v) ? EFAULT : 0;
+}
+
+static int
+gwr(struct negroni_s1 *s, uint32_t off, uint32_t v)
+{
+	return negroni_mmio_try_wr32(s->g0 + off, v) ? EFAULT : 0;
+}
+
+static int
+crd(struct negroni_s1 *s, uint32_t c, uint32_t off, uint32_t *v)
+{
+	return negroni_mmio_try_rd32(s->cbva + (vm_offset_t)c * s->page + off, v) ? EFAULT : 0;
+}
+
+static int
+cwr(struct negroni_s1 *s, uint32_t c, uint32_t off, uint32_t v)
+{
+	return negroni_mmio_try_wr32(s->cbva + (vm_offset_t)c * s->page + off, v) ? EFAULT : 0;
+}
+
+/* a page-aligned uncached mapping of [pa, pa + size): map and msize for the unmap, the return value at pa */
+static vm_offset_t
+io_map(uint64_t pa, vm_size_t size, vm_offset_t *map, vm_size_t *msize)
+{
+	uint64_t base = pa & ~(uint64_t)PAGE_MASK;
+	vm_size_t len = round_page(size + (vm_size_t)(pa - base));
+	vm_offset_t va = ml_io_map_unmappable((vm_offset_t)base, len, S1_WIMG_IO);
+
+	*map = va;
+	*msize = len;
+	return va ? va + (vm_offset_t)(pa - base) : 0;
+}
+
+/* a global write, read back; mask: the bits that must read back as written */
+static int
+g_put(struct negroni_s1 *s, const char *what, uint32_t off, uint32_t v, uint32_t mask)
+{
+	uint32_t got = 0;
+
+	if (gwr(s, off, v)) {
+		printf("%s: SMMU %s write %#x REFUSED (synchronous external abort, caught)\n", s->name, what, v);
+		return EPERM;
+	}
+	dsb();
+	if (grd(s, off, &got)) {
+		printf("%s: SMMU %s read-back aborted after writing %#x\n", s->name, what, v);
+		return EPERM;
+	}
+	if ((got & mask) != (v & mask)) {
+		printf("%s: SMMU %s reads %#x after writing %#x (the hypervisor did not keep it)\n", s->name, what, got, v);
+		return EPERM;
+	}
+	return 0;
+}
+
+static int
+cb_put(struct negroni_s1 *s, const char *what, uint32_t off, uint32_t v)
+{
+	uint32_t got = 0;
+
+	int bad = cwr(s, s->cb, off, v);
+	dsb();
+	if (bad || crd(s, s->cb, off, &got)) {
+		printf("%s: SMMU context %u %s write %#x aborted (caught)\n", s->name, s->cb, what, v);
+		return EPERM;
+	}
+	if (got != v) {
+		printf("%s: SMMU context %u %s reads %#x after writing %#x\n", s->name, s->cb, what, got, v);
+		return EPERM;
+	}
+	return 0;
+}
+
+/* what the TCU and the TBUs say when a sync does not finish (qsmmuv500_tlb_sync_timeout; reads only) */
+static void
+sync_diag(struct negroni_s1 *s, uint32_t status)
+{
+	uint32_t ack = ~0u, cntr = ~0u, gst = ~0u;
+	int e1 = grd(s, 7u * s->page + QSMMU_TBU_ACK, &ack), e2 = grd(s, QSMMU_WAIT_CNTR, &cntr);
+	int e3 = grd(s, SMMU_STLBGSTATUS, &gst);
+
+	printf("%s: SMMU context %u TLB sync NOT finished after %u ms: TLBSTATUS %#x; TBU ack %#x%s (sync req %u ack %#x, "
+	    "inv req %u ack %#x); TCU %#x%s (sync %s, inv %s); sTLBGSTATUS %#x%s\n", s->name, s->cb, TLB_SYNC_US / 1000, status,
+	    ack, e1 ? " (read aborted)" : "", (ack >> 16) & 1, ack >> 17, ack & 1, (ack >> 1) & 0x7fff, cntr,
+	    e2 ? " (read aborted)" : "", (cntr >> 20) & 1 ? "in progress" : "idle", (cntr >> 16) & 1 ? "in progress" : "idle",
+	    gst, e3 ? " (read aborted)" : "");
+}
+
+/* invalidate the context's TLB (ASID = context index, as TTBR0) and wait (500 ms at most); false on a time-out */
+static bool
+tlb_sync(struct negroni_s1 *s)
+{
+	uint32_t st = 1;
+
+	if (cwr(s, s->cb, CB_TLBIASID, s->cb) || cwr(s, s->cb, CB_TLBSYNC, ~0u)) {      /* Linux writes QCOM_DUMMY_VAL */
+		printf("%s: SMMU context %u TLBIASID/TLBSYNC write aborted (caught)\n", s->name, s->cb);
+		return false;
+	}
+	for (uint32_t waited = 0, d = 1; waited <= TLB_SYNC_US; waited += d, d = MIN(d * 2, 1000u)) {
+		if (crd(s, s->cb, CB_TLBSTATUS, &st)) {
+			printf("%s: SMMU context %u TLBSTATUS read aborted (caught)\n", s->name, s->cb);
+			return false;
+		}
+		if ((st & 1) == 0) {
+			return true;
+		}
+		delay(d);
+	}
+	sync_diag(s, st);
+	return false;
+}
+
+static void
+tbl_flush(const void *p, size_t n)
+{
+	for (vm_offset_t a = (vm_offset_t)p & ~(vm_offset_t)63; a < (vm_offset_t)p + n; a += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (a));
+	}
+	dsb();
+}
+
+static uint64_t *
+tbl_new(struct negroni_s1 *s, uint64_t *pa_out)
+{
+	if (s->tleft == 0) {
+		if (s->tpages == NEGRONI_S1_TABLE_PAGES || kmem_alloc(kernel_map, &s->tpage[s->tpages], PAGE_SIZE,
+		    KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return NULL;
+		}
+		s->tpages++;
+		s->tleft = PAGE_SIZE / 4096;
+	}
+	uint64_t *t = (uint64_t *)(s->tpage[s->tpages - 1] + PAGE_SIZE - 4096 * s->tleft--);
+	tbl_flush(t, 4096);
+	*pa_out = kvtophys((vm_offset_t)t);
+	return t;
+}
+
+static uint64_t *
+tbl_next(struct negroni_s1 *s, uint64_t *entry)
+{
+	uint64_t pa;
+
+	if (*entry & 1) {
+		return (uint64_t *)phystokv(*entry & PTE_ADDR);
+	}
+	uint64_t *t = tbl_new(s, &pa);
+	if (t) {
+		*entry = pa | PTE_VALID;
+		tbl_flush(entry, sizeof(*entry));
+	}
+	return t;
+}
+
+static bool
+map_page(struct negroni_s1 *s, uint64_t iova, uint64_t pa)
+{
+	uint64_t *l2 = tbl_next(s, &s->root[(iova >> 30) & 0x1ff]);
+	uint64_t *l3 = l2 ? tbl_next(s, &l2[(iova >> 21) & 0x1ff]) : NULL;
+
+	if (!l3 || pa == 0) {
+		return false;
+	}
+	uint64_t *e = &l3[(iova >> 12) & 0x1ff];
+	*e = (pa & PTE_ADDR) | PTE_ATTR | PTE_VALID;
+	tbl_flush(e, sizeof(*e));
+	return true;
+}
+
+int
+negroni_s1_map_kva(struct negroni_s1 *s, uint64_t iova, vm_offset_t kva, uint64_t size)
+{
+	if (!s->on || size == 0 || (iova & 0xfff) || (kva & 0xfff) || iova + size > (1ull << 39)) {
+		return EINVAL;
+	}
+	for (uint64_t o = 0; o < size; o += 4096) {
+		if (!map_page(s, iova + o, kvtophys(kva + (vm_offset_t)o))) {
+			printf("%s: SMMU map of IOVA %#llx failed (no table page or no physical page)\n", s->name, iova + o);
+			return ENOMEM;
+		}
+	}
+	s->mapped_pages += (uint32_t)((size + 4095) / 4096);
+	if (!tlb_sync(s)) {
+		printf("%s: SMMU context %u TLB sync does not finish after the map of IOVA %#llx\n", s->name, s->cb, iova);
+		return ETIMEDOUT;
+	}
+	printf("%s: SMMU context %u: IOVA %#llx-%#llx -> phys %#llx.. (%llu KiB)\n", s->name, s->cb, iova, iova + size - 1,
+	    kvtophys(kva), size >> 10);
+	return 0;
+}
+
+void
+negroni_s1_report(struct negroni_s1 *s, const char *when)
+{
+	if (!s->on) {
+		return;
+	}
+	uint32_t fsr = ~0u, gfsr = ~0u, sid = ~0u, farh = ~0u, farl = ~0u, fsynr0 = ~0u, gsyn = ~0u;
+	int e = crd(s, s->cb, CB_FSR, &fsr);    /* every read refusable (0297): ~0 and "aborted" when refused */
+	e |= grd(s, SMMU_SGFSR, &gfsr) | grd(s, s->page + SMMU_CBFRSYNRA(s->cb), &sid) | crd(s, s->cb, CB_FAR + 4, &farh) |
+	    crd(s, s->cb, CB_FAR, &farl) | crd(s, s->cb, CB_FSYNR0, &fsynr0) | grd(s, SMMU_SGFSYNR1, &gsyn);
+	printf("%s: SMMU context %u %s: FSR %#x%s FAR %#x:%#x FSYNR0 %#x stream %#x; sGFSR %#x sGFSYNR1 %#x; %u pages mapped%s\n",
+	    s->name, s->cb, when, fsr, fsr == ~0u ? "" : (fsr & FSR_ALL) ? " (CONTEXT FAULT)" : " (no fault)", farh, farl, fsynr0,
+	    sid & 0xffffu, gfsr, gsyn, s->mapped_pages, e ? " (a read ABORTED, caught)" : "");
+	if (fsr != ~0u && (fsr & FSR_ALL)) {
+		(void)cwr(s, s->cb, CB_FSR, fsr);       /* write one to clear */
+	}
+}
+
+uint32_t
+negroni_s1_fsr(struct negroni_s1 *s)
+{
+	uint32_t fsr = 0;
+	if (!s->on) {
+		return 0;
+	}
+	return crd(s, s->cb, CB_FSR, &fsr) ? FSR_ALL : fsr & FSR_ALL;        /* a refused read counts as a fault */
+}
+
+static void
+unmap_all(struct negroni_s1 *s)
+{
+	for (uint32_t i = 0; i < s->tpages; i++) {
+		kmem_free(kernel_map, s->tpage[i], PAGE_SIZE);
+	}
+	s->tpages = s->tleft = 0;
+	s->root = NULL;
+	s->mapped_pages = 0;
+	if (s->cb_map) {
+		ml_io_unmap(s->cb_map, s->cb_size);
+		s->cb_map = s->cbva = 0;
+	}
+	if (s->g0_map) {
+		ml_io_unmap(s->g0_map, s->g0_size);
+		s->g0_map = s->g0 = 0;
+	}
+}
+
+/*
+ * The S2CRs and SMRs back as found, then the context off the way Linux frees a domain: SCTLR = 0 and a TLB
+ * invalidate, nothing else. CBAR/CBA2R stay as we wrote them (0x1f300 / 1): writing the old CBAR back (type
+ * S2_TRANS) is what Gunyah refused on 2026-10-27. Every write is refusable (0297); a refusal is logged. (lock held)
+ */
+static void
+undo(struct negroni_s1 *s)
+{
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		if (!s->written[k]) {
+			continue;
+		}
+		uint32_t n = s->smr[k], now = ~0u;
+		int e = 0;
+		if (s->reused[k]) {
+			e |= gwr(s, SMMU_S2CR(n), s->old_s2cr[k]);      /* the SMR stays as it was */
+		} else {
+			e |= gwr(s, SMMU_SMR(n), s->old_smr[k]);        /* invalid first, then the S2CR */
+			dsb();
+			e |= gwr(s, SMMU_S2CR(n), s->old_s2cr[k]);
+		}
+		dsb();
+		(void)grd(s, SMMU_S2CR(n), &now);
+		printf("%s: SMMU SMR%u %s, S2CR%u = %#x%s\n", s->name, n, s->reused[k] ? "kept" : "cleared", n, now,
+		    e ? " (a write was REFUSED: SEA caught)" : "");
+		s->written[k] = false;
+	}
+	if (s->cb != ~0u && s->cbva && s->cb_written) {
+		uint32_t cbar = ~0u;
+		int e = cwr(s, s->cb, CB_SCTLR, 0);
+		dsb();
+		bool synced = e == 0 && tlb_sync(s);
+		e |= grd(s, s->page + SMMU_CBAR(s->cb), &cbar);
+		if (e == 0 && (cbar & CBAR_KEEP_MASK) == (CBAR_S1 & CBAR_KEEP_MASK)) {
+			cb_released[s->cb] = true;
+		}
+		printf("%s: SMMU context %u released: SCTLR 0%s, TLB %s; CBAR left at %#x (as Linux: no CBAR write on free)%s\n",
+		    s->name, s->cb, e ? " (an access ABORTED, caught)" : "", synced ? "synced" : "NOT synced", cbar,
+		    cb_released[s->cb] ? ", reusable" : "");
+		s->cb_written = false;
+	}
+}
+
+void
+negroni_s1_off(struct negroni_s1 *s)
+{
+	lck_mtx_lock(&negroni_smmu_claim_lock);
+	if (s->on) {
+		negroni_s1_report(s, "at teardown");
+	}
+	if (s->g0 && s->cbva) {
+		undo(s);
+	}
+	if (s->on) {
+		printf("%s: SMMU context %u off\n", s->name, s->cb);
+	}
+	s->on = false;
+	unmap_all(s);
+	s->cb = ~0u;
+	lck_mtx_unlock(&negroni_smmu_claim_lock);
+}
+
+/* does SMR value v (valid) match any stream of the (id, mask) set? */
+static bool
+smr_overlaps(uint32_t v, uint32_t id, uint32_t mask)
+{
+	uint32_t vid = v & 0x7fffu, vmask = (v >> 16) & 0x7fffu;
+	return ((vid ^ id) & ~(vmask | mask) & 0x7fffu) == 0;
+}
+
+/* map global pages 0-7 and the context banks; read the layout (lock held). 0 or an errno, the reason printed */
+static int
+map_layout(struct negroni_s1 *s)
+{
+	uint32_t scr0 = 0, idr0, idr1;
+
+	s->g0 = io_map(APPS_SMMU_PHYS, 0x2000, &s->g0_map, &s->g0_size);
+	if (!s->g0) {
+		printf("%s: SMMU map failed\n", s->name);
+		return ENOMEM;
+	}
+	int r = negroni_mmio_try_rd32(s->g0 + SMMU_SCR0, &scr0);
+	if (r == -2) {
+		printf("%s: this kernel cannot catch a refused SMMU access (no CONFIG_XNUPOST): no SMMU writes\n", s->name);
+		return ENOTSUP;
+	}
+	if (r || grd(s, SMMU_IDR0, &idr0) || grd(s, SMMU_IDR1, &idr1)) {
+		printf("%s: SMMU sCR0/IDR0/IDR1 read aborted (caught)\n", s->name);
+		return EFAULT;
+	}
+	s->page = (idr1 >> 31) ? 0x10000u : 0x1000u;
+	s->pages = 2u << ((idr1 >> 28) & 7);
+	s->nctx = MIN(idr1 & 0xffu, MAX_CTX);
+	s->nums2cb = (idr1 >> 16) & 0xffu;
+	s->nsmr = MIN(MIN(idr0 & 0xffu, MAX_SMR), 128u);
+	printf("%s: SMMU S1 setup: sCR0 %#x IDR0 %#x IDR1 %#x: %u SMRs, %u contexts (NUMS2CB %u), %u pages of %#x\n", s->name,
+	    scr0, idr0, idr1, s->nsmr, s->nctx, s->nums2cb, s->pages, s->page);
+	if (scr0 == ~0u || s->nsmr == 0 || s->nctx < 2 || s->pages < G0_PAGES || 2ull * s->pages * s->page > APPS_SMMU_SIZE) {
+		printf("%s: SMMU layout does not fit\n", s->name);
+		return ENXIO;
+	}
+	if (scr0 & SMMU_SCR0_EXIDENABLE) {
+		printf("%s: SMMU uses extended stream IDs; SMR format not handled\n", s->name);
+		return ENOTSUP;
+	}
+	ml_io_unmap(s->g0_map, s->g0_size);     /* again with pages 0-7 (page 1 = CBAR, page 7 = IMPL_DEF5) */
+	s->g0 = io_map(APPS_SMMU_PHYS, (vm_size_t)G0_PAGES * s->page, &s->g0_map, &s->g0_size);
+	if (!s->g0) {
+		return ENOMEM;
+	}
+	s->cbva = io_map(APPS_SMMU_PHYS + (uint64_t)s->pages * s->page, (vm_size_t)s->nctx * s->page, &s->cb_map, &s->cb_size);
+	if (!s->cbva) {
+		return ENOMEM;
+	}
+	/* one snapshot of the stream-match table (each read is a hypervisor trap); re-read before each write */
+	for (uint32_t i = 0; i < s->nsmr; i++) {
+		if (grd(s, SMMU_SMR(i), &snap_smr[i]) || grd(s, SMMU_S2CR(i), &snap_s2cr[i])) {
+			printf("%s: SMMU SMR%u/S2CR%u read aborted (caught)\n", s->name, i, i);
+			return EFAULT;
+		}
+	}
+	return 0;
+}
+
+/* how many valid SMRs translate into context c (snapshot), and the first such SMR value */
+static uint32_t
+cb_refs(struct negroni_s1 *s, uint32_t c, uint32_t *first_smr)
+{
+	uint32_t n = 0;
+	for (uint32_t m = 0; m < s->nsmr; m++) {
+		if ((snap_smr[m] & SMMU_SMR_VALID) && S2CR_TYPE(snap_s2cr[m]) == 0 && (snap_s2cr[m] & 0xffu) == c) {
+			if (n++ == 0 && first_smr) {
+				*first_smr = snap_smr[m];
+			}
+		}
+	}
+	return n;
+}
+
+/*
+ * Is context c free for us? The U-Boot qcom-hyp-smmu.c CBAR rule (S2_TRANS, or S1_TRANS_S2_BYPASS with VMID 0xff),
+ * or a bank we released earlier (CBAR still 0x1f300); SCTLR.M = 0; no valid SMR translates into it; TLBSTATUS idle;
+ * not marked READ_ABORT/CLAIM_REFUSED, nor REWRITE_REFUSED/CHANGED by the probe. Reads only. (lock held)
+ */
+static bool
+cb_free(struct negroni_s1 *s, uint32_t c, uint32_t *cbar_out, uint32_t *cba2r_out, uint32_t *sctlr_out)
+{
+	uint32_t cbar, cba2r, sctlr, st;
+	int8_t v = negroni_smmu_cb_verdict[c];
+
+	/* the probe's REFUSED/CHANGED banks too: a bank whose own CBAR value is not taken back is not ours [I] */
+	if (v == NEGRONI_CB_READ_ABORT || v == NEGRONI_CB_CLAIM_REFUSED || v == NEGRONI_CB_REWRITE_REFUSED ||
+	    v == NEGRONI_CB_REWRITE_CHANGED) {
+		return false;
+	}
+	if (grd(s, s->page + SMMU_CBAR(c), &cbar) || grd(s, s->page + SMMU_CBA2R(c), &cba2r) ||
+	    crd(s, c, CB_SCTLR, &sctlr) || crd(s, c, CB_TLBSTATUS, &st)) {
+		negroni_smmu_cb_verdict[c] = NEGRONI_CB_READ_ABORT;
+		printf("%s: SMMU context %u: a read ABORTED (caught): not ours\n", s->name, c);
+		return false;
+	}
+	uint32_t type = CBAR_TYPE(cbar);
+	bool rule = type == 0 || (type == 1 && (cbar & 0xffu) == 0xffu) ||
+	    (cb_released[c] && (cbar & CBAR_KEEP_MASK) == (CBAR_S1 & CBAR_KEEP_MASK));
+	if (!rule || (sctlr & 1) || (st & 1) || cb_refs(s, c, NULL)) {
+		return false;
+	}
+	*cbar_out = cbar;
+	*cba2r_out = cba2r;
+	*sctlr_out = sctlr;
+	return true;
+}
+
+static int
+s1_on_locked(struct negroni_s1 *s)
+{
+	int error;
+
+	if (s->nstreams == 0 || s->nstreams > NEGRONI_S1_MAX_STREAMS) {
+		return EINVAL;
+	}
+	s->cb = ~0u;
+	if ((error = map_layout(s))) {
+		return error;
+	}
+
+	/* stream-match entries: an SMR equal to ours whose S2CR does not translate is reused; any other valid
+	 * SMR that matches one of our IDs belongs to someone (a double match is a conflict fault): stop */
+	uint32_t taken = 0;     /* bit per stream k: it has an entry */
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		uint32_t id = s->streams[k].id, mask = s->streams[k].mask, want = SMMU_SMR_VALID | mask << 16 | id;
+		for (uint32_t i = 0; i < s->nsmr; i++) {
+			uint32_t v = snap_smr[i];
+			if (!(v & SMMU_SMR_VALID) || !smr_overlaps(v, id, mask)) {
+				continue;
+			}
+			uint32_t s2 = snap_s2cr[i];
+			if (v == want && S2CR_TYPE(s2) != 0) {
+				s->smr[k] = i;
+				s->reused[k] = true;
+				s->old_smr[k] = v;
+				s->old_s2cr[k] = s2;
+				taken |= 1u << k;
+				printf("%s: SMMU stream %#x/%#x: SMR%u already there (S2CR %#x, %s): reused\n", s->name, id, mask, i, s2,
+				    S2CR_TYPE(s2) == 1 ? "bypass" : "fault");
+				break;
+			}
+			printf("%s: SMMU stream %#x/%#x: SMR%u %#x (S2CR %#x) already matches it: somebody's entry, left alone\n",
+			    s->name, id, mask, i, v, s2);
+			return EBUSY;
+		}
+	}
+	/* free SMRs from the top down (0324 takes them from the bottom up) */
+	uint32_t next = s->nsmr;
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		if (taken & (1u << k)) {
+			continue;
+		}
+		while (next > 0 && (snap_smr[next - 1] & SMMU_SMR_VALID)) {
+			next--;
+		}
+		if (next == 0) {
+			printf("%s: SMMU has no free stream-match register\n", s->name);
+			return EBUSY;
+		}
+		next--;
+		s->smr[k] = next;
+		s->reused[k] = false;
+		s->old_smr[k] = snap_smr[next];
+		s->old_s2cr[k] = snap_s2cr[next];
+	}
+
+	/*
+	 * A context bank from the bottom up, from NUMS2CB (Linux: stage-1 banks start at num_s2_context_banks). The
+	 * claim (SCTLR 0, CBA2R 1, CBAR 0x1f300, each read back) is the test: a refused or not-kept write skips the
+	 * bank (no restore write: it may be refused too), at most MAX_TRIES banks.
+	 */
+	uint32_t tries = 0, cbar = 0, cba2r = 0, sctlr = 0;
+	for (uint32_t c = MAX(s->nums2cb, 1u); c < s->nctx && s->cb == ~0u && tries < MAX_TRIES; c++) {
+		if (!cb_free(s, c, &cbar, &cba2r, &sctlr)) {
+			continue;
+		}
+		tries++;
+		s->cb = c;
+		s->old_cbar = cbar;
+		s->old_cba2r = cba2r;
+		printf("%s: SMMU context %u free: CBAR %#x CBA2R %#x; claiming it\n", s->name, c, cbar, cba2r);
+		/* SCTLR (M is 0 already) is written only after the claim and only when not 0: a refused claim leaves
+		 * the bank's own registers untouched (Linux writes the CB registers after CBAR too) */
+		if (g_put(s, "CBA2R", s->page + SMMU_CBA2R(c), 1, 1u) ||                        /* VA64 */
+		    g_put(s, "CBAR", s->page + SMMU_CBAR(c), CBAR_S1, CBAR_KEEP_MASK)) {
+			negroni_smmu_cb_verdict[c] = NEGRONI_CB_CLAIM_REFUSED;
+			printf("%s: SMMU context %u: claim refused or not kept; left as it is now, next bank\n", s->name, c);
+			s->cb = ~0u;
+			continue;
+		}
+		negroni_smmu_cb_verdict[c] = NEGRONI_CB_OURS;
+		cb_released[c] = false;
+		s->cb_written = true;
+		if (sctlr != 0) {
+			int bad = cwr(s, c, CB_SCTLR, 0);
+			dsb();
+			if (bad) {
+				printf("%s: SMMU context %u SCTLR 0 write aborted (caught)\n", s->name, c);
+				return EPERM;
+			}
+		}
+	}
+	if (s->cb == ~0u) {
+		printf("%s: SMMU has no usable context bank (%u tried; U-Boot CBAR rule, SCTLR.M, S2CR targets, claim)\n",
+		    s->name, tries);
+		return EBUSY;
+	}
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		printf("%s: SMMU stream %#x mask %#x: SMR%u (%s, was %#x / S2CR %#x) -> context %u\n", s->name, s->streams[k].id,
+		    s->streams[k].mask, s->smr[k], s->reused[k] ? "reused" : "free", s->old_smr[k], s->old_s2cr[k], s->cb);
+	}
+
+	s->root = tbl_new(s, &s->root_pa);
+	if (!s->root) {
+		return ENOMEM;
+	}
+	uint64_t ttbr = s->root_pa | ((uint64_t)s->cb << 48);
+	if ((error = cb_put(s, "TCR2", CB_TCR2, TCR2_36)) ||
+	    (error = cb_put(s, "TCR", CB_TCR, TCR_39)) ||
+	    (error = cb_put(s, "TTBR0 lo", CB_TTBR0, (uint32_t)ttbr)) ||
+	    (error = cb_put(s, "TTBR0 hi", CB_TTBR0 + 4, (uint32_t)(ttbr >> 32))) ||
+	    (error = cb_put(s, "MAIR0", CB_MAIR0, MAIR0))) {
+		return error;
+	}
+	if (cwr(s, s->cb, CB_TTBR1, 0) || cwr(s, s->cb, CB_TTBR1 + 4, 0) || cwr(s, s->cb, CB_MAIR1, 0) ||
+	    cwr(s, s->cb, CB_FSR, FSR_ALL)) {
+		printf("%s: SMMU context %u TTBR1/MAIR1/FSR write aborted (caught)\n", s->name, s->cb);
+		return EPERM;
+	}
+	if (!tlb_sync(s)) {
+		return ETIMEDOUT;
+	}
+	sctlr = 0;
+	int bad = cwr(s, s->cb, CB_SCTLR, SCTLR_ON);
+	dsb();
+	if (bad || crd(s, s->cb, CB_SCTLR, &sctlr) || !(sctlr & 1)) {
+		printf("%s: SMMU context %u SCTLR does not take M (%#x)\n", s->name, s->cb, sctlr);
+		return EPERM;
+	}
+	/* the streams: S2CR (translate, context) first, then the SMR; each SMR read again right before */
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		uint32_t n = s->smr[k], want = SMMU_SMR_VALID | (uint32_t)s->streams[k].mask << 16 | s->streams[k].id, now = ~0u;
+		if (grd(s, SMMU_SMR(n), &now) || (s->reused[k] ? now != s->old_smr[k] : (now & SMMU_SMR_VALID) != 0)) {
+			printf("%s: SMMU SMR%u changed under us (%#x): another driver took it\n", s->name, n, now);
+			return EBUSY;
+		}
+		s->written[k] = true;
+		if ((error = g_put(s, "S2CR", SMMU_S2CR(n), s->cb, ~0u))) {     /* type 0 = translate */
+			return error;
+		}
+		if (!s->reused[k] && (error = g_put(s, "SMR", SMMU_SMR(n), want, ~0u))) {
+			return error;
+		}
+	}
+	s->on = true;
+	for (uint32_t k = 0; k < s->nstreams; k++) {
+		uint32_t smr = ~0u, s2cr = ~0u;
+		(void)grd(s, SMMU_SMR(s->smr[k]), &smr);
+		(void)grd(s, SMMU_S2CR(s->smr[k]), &s2cr);
+		printf("%s: SMMU SMR%u = %#x, S2CR%u = %#x\n", s->name, s->smr[k], smr, s->smr[k], s2cr);
+	}
+	uint32_t ttbh = ~0u, ttbl = ~0u;
+	sctlr = ~0u;
+	(void)crd(s, s->cb, CB_SCTLR, &sctlr);
+	(void)crd(s, s->cb, CB_TTBR0 + 4, &ttbh);
+	(void)crd(s, s->cb, CB_TTBR0, &ttbl);
+	printf("%s: SMMU context %u ON: SCTLR %#x TTBR0 %#x:%#x (root %#llx), %u stream entr%s translate through it\n", s->name,
+	    s->cb, sctlr, ttbh, ttbl, s->root_pa, s->nstreams, s->nstreams == 1 ? "y" : "ies");
+	return 0;
+}
+
+int
+negroni_s1_on(struct negroni_s1 *s)
+{
+	lck_mtx_lock(&negroni_smmu_claim_lock);
+	if (s->on) {
+		lck_mtx_unlock(&negroni_smmu_claim_lock);
+		return 0;
+	}
+	bzero(s->written, sizeof(s->written));
+	s->cb_written = false;
+	int error = s1_on_locked(s);
+	if (error) {
+		printf("%s: SMMU S1 context not set up (errno %d); stream entries put back, context released\n", s->name, error);
+		if (s->g0 && s->cbva) {
+			undo(s);
+		}
+		s->on = false;
+		unmap_all(s);
+		s->cb = ~0u;
+	}
+	lck_mtx_unlock(&negroni_smmu_claim_lock);
+	return error;
+}
+
+/*
+ * negronismmu_probe=1|2 (default 0): which apps-SMMU context banks does the hypervisor let us touch? At boot
+ * (STARTUP EARLY_BOOT), under the claim lock, every access refusable (0297). Per bank: CBAR, CBA2R, SCTLR,
+ * TLBSTATUS read; then CBAR written back with the value just read (no value changes) and read again:
+ *   =1 the write only on dormant banks (SCTLR.M 0, no valid SMR translating into it), =2 on every bank.
+ * One line per bank and a summary; the verdicts go to negroni_smmu_cb_verdict[] (negroni_s1_on skips a bank whose
+ * reads abort). Nothing else is written: no SMR, S2CR, SCTLR, TLB operation.
+ */
+static const char *
+verdict_name(int8_t v)
+{
+	switch (v) {
+	case NEGRONI_CB_REWRITE_OK: return "same-value CBAR write OK";
+	case NEGRONI_CB_REWRITE_REFUSED: return "same-value CBAR write REFUSED (SEA caught)";
+	case NEGRONI_CB_REWRITE_CHANGED: return "same-value CBAR write accepted but reads back DIFFERENT";
+	case NEGRONI_CB_READ_ABORT: return "a READ ABORTED (SEA caught): not visible to us";
+	case NEGRONI_CB_NOT_TRIED: return "in use: write not tried (probe=2 tries)";
+	case NEGRONI_CB_CLAIM_REFUSED: return "stage-1 claim refused";
+	case NEGRONI_CB_OURS: return "ours";
+	default: return "?";
+	}
+}
+
+/* the probe's lines: printed now, and kept for kern.negroni_smmu_probe and the later re-print (the EARLY_BOOT
+ * lines come before the USB console and fall out of `op10tool ctl log`) */
+static char probe_txt[16384];
+static size_t probe_len;
+static uint32_t probe_level;
+
+static void ptxt(const char *fmt, ...) __printflike(1, 2);
+static void
+ptxt(const char *fmt, ...)
+{
+	char line[640];
+	va_list ap;
+
+	va_start(ap, fmt);
+	(void)vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+	printf("NEGRONI SMMU PROBE: %s", line);
+	if (probe_len + strlen(line) + 1 < sizeof(probe_txt)) {
+		probe_len += strlcpy(probe_txt + probe_len, line, sizeof(probe_txt) - probe_len);
+	}
+}
+
+void
+negroni_smmu_probe(uint32_t level)
+{
+	static struct negroni_s1 p = { .name = "NEGRONI SMMU PROBE" };
+	uint32_t n_ok = 0, n_ref = 0, n_chg = 0, n_rab = 0, n_nt = 0, nvalid = 0;
+	uint32_t f0 = negroni_mmio_try_faults;
+
+	lck_mtx_lock(&negroni_smmu_claim_lock);
+	p.cb = ~0u;
+	probe_len = 0;
+	probe_txt[0] = 0;
+	probe_level = level;
+	if (map_layout(&p) != 0) {
+		ptxt("stopped (see the line above)\n");
+		goto out;
+	}
+	uint32_t idr2 = ~0u, gfsr = ~0u, gst = ~0u, cntr = ~0u, ack = ~0u;
+	(void)grd(&p, SMMU_IDR2, &idr2);
+	(void)grd(&p, SMMU_SGFSR, &gfsr);
+	(void)grd(&p, SMMU_STLBGSTATUS, &gst);
+	(void)grd(&p, QSMMU_WAIT_CNTR, &cntr);
+	(void)grd(&p, 7u * p.page + QSMMU_TBU_ACK, &ack);
+	for (uint32_t i = 0; i < p.nsmr; i++) {
+		nvalid += (snap_smr[i] & SMMU_SMR_VALID) != 0;
+	}
+	ptxt("level %u: %u SMRs, %u contexts, NUMS2CB %u, page %#x; IDR2 %#x sGFSR %#x sTLBGSTATUS %#x TCU %#x TBU-ack %#x; "
+	    "%u of %u SMRs valid\n", level, p.nsmr, p.nctx, p.nums2cb, p.page, idr2, gfsr, gst, cntr, ack, nvalid, p.nsmr);
+	for (uint32_t c = 0; c < p.nctx; c++) {
+		uint32_t cbar = ~0u, cba2r = ~0u, sctlr = ~0u, st = ~0u, first = 0;
+		uint32_t refs = cb_refs(&p, c, &first);
+		int8_t v;
+		if (grd(&p, p.page + SMMU_CBAR(c), &cbar) | grd(&p, p.page + SMMU_CBA2R(c), &cba2r) |
+		    crd(&p, c, CB_SCTLR, &sctlr) | crd(&p, c, CB_TLBSTATUS, &st)) {
+			v = NEGRONI_CB_READ_ABORT;
+		} else if (level < 2 && ((sctlr & 1) || refs)) {
+			v = NEGRONI_CB_NOT_TRIED;
+		} else {
+			uint32_t again = ~0u;
+			int bad = gwr(&p, p.page + SMMU_CBAR(c), cbar);
+			dsb();
+			if (bad) {
+				v = NEGRONI_CB_REWRITE_REFUSED;
+			} else if (grd(&p, p.page + SMMU_CBAR(c), &again) || again != cbar) {
+				v = NEGRONI_CB_REWRITE_CHANGED;
+				ptxt("cb %u CBAR %#x after writing %#x\n", c, again, cbar);
+			} else {
+				v = NEGRONI_CB_REWRITE_OK;
+			}
+		}
+		negroni_smmu_cb_verdict[c] = v;
+		n_ok += v == NEGRONI_CB_REWRITE_OK;
+		n_ref += v == NEGRONI_CB_REWRITE_REFUSED;
+		n_chg += v == NEGRONI_CB_REWRITE_CHANGED;
+		n_rab += v == NEGRONI_CB_READ_ABORT;
+		n_nt += v == NEGRONI_CB_NOT_TRIED;
+		ptxt("cb %2u CBAR %#07x (type %u vmid %#x) CBA2R %#x SCTLR %#x TLBSTATUS %#x refs %u%s%#x%s: %s\n",
+		    c, cbar, CBAR_TYPE(cbar), cbar & 0xffu, cba2r, sctlr, st, refs, refs ? " (SMR " : "", refs ? first : 0u,
+		    refs ? ")" : "", verdict_name(v));
+	}
+	ptxt("summary: %u banks (stage-1 from %u): rewrite OK %u, REFUSED %u, changed %u, read-abort %u, "
+	    "not tried %u; %u aborts caught\n", p.nctx, p.nums2cb, n_ok, n_ref, n_chg, n_rab, n_nt, negroni_mmio_try_faults - f0);
+	for (int8_t want = NEGRONI_CB_REWRITE_REFUSED; want <= NEGRONI_CB_REWRITE_OK; want++) {
+		char line[512];
+		size_t used = 0;
+		line[0] = 0;
+		for (uint32_t c = 0; c < p.nctx && used + 8 < sizeof(line); c++) {
+			if (negroni_smmu_cb_verdict[c] == want) {
+				used += (size_t)snprintf(line + used, sizeof(line) - used, " %u", c);
+			}
+		}
+		if (used) {
+			ptxt("%s:%s\n", verdict_name(want), line);
+		}
+	}
+out:
+	unmap_all(&p);
+	lck_mtx_unlock(&negroni_smmu_claim_lock);
+}
+
+/* the survey again, line by line, once the USB console is up (negronismmu_probe_again seconds, default 60, 0 = off) */
+static void
+negroni_smmu_probe_again(thread_call_param_t p0 __unused, thread_call_param_t p1 __unused)
+{
+	const char *t = probe_txt;
+
+	printf("NEGRONI SMMU PROBE: again (level %u, from boot):\n", probe_level);
+	while (*t) {
+		const char *nl = strchr(t, '\n');
+		int n = nl ? (int)(nl - t) : (int)strlen(t);
+		printf("NEGRONI SMMU PROBE: %.*s\n", n, t);
+		t += n + (nl != NULL);
+	}
+}
+
+/* sysctl kern.negroni_smmu_probe (root only): the survey text, or why there is none */
+static int
+sysctl_negroni_smmu_probe SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	if (!kauth_cred_issuser(kauth_cred_get())) {
+		return EPERM;
+	}
+	if (probe_len == 0) {
+		static const char none[] = "no probe this boot (boot-arg negronismmu_probe=1|2)\n";
+		return SYSCTL_OUT(req, none, sizeof(none));
+	}
+	return SYSCTL_OUT(req, probe_txt, probe_len + 1);
+}
+SYSCTL_PROC(_kern, OID_AUTO, negroni_smmu_probe, CTLTYPE_STRING | CTLFLAG_RD | CTLFLAG_LOCKED, 0, 0,
+    sysctl_negroni_smmu_probe, "A", "NEGRONI apps-SMMU bank probe (negronismmu_probe)");
+
+static void
+negroni_smmu_probe_boot(void)
+{
+	uint32_t level = 0, again = 60;
+
+	if (PE_parse_boot_argn("negronismmu_probe", &level, sizeof(level)) && level != 0) {
+		negroni_smmu_probe(level);
+		(void)PE_parse_boot_argn("negronismmu_probe_again", &again, sizeof(again));
+		if (again != 0) {
+			uint64_t when;
+			thread_call_t tc = thread_call_allocate_with_options(negroni_smmu_probe_again, NULL,
+			    THREAD_CALL_PRIORITY_LOW, THREAD_CALL_OPTIONS_ONCE);
+			clock_interval_to_deadline(again, NSEC_PER_SEC, &when);
+			if (tc) {
+				(void)thread_call_enter_delayed(tc, when);
+			}
+		}
+	}
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, negroni_smmu_probe_boot);
+
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_smmu_s1.h b/bsd/dev/negroni_smmu_s1.h
new file mode 100644
index 0000000..2612782
--- /dev/null
+++ b/bsd/dev/negroni_smmu_s1.h
@@ -0,0 +1,102 @@
+/*
+ * NEGRONI (SM8450): an apps-SMMU stage-1 translation context of our own for a set of stream IDs
+ * (patch 0249; used by negroni_audio.c for the ADSP stream 0x1801 and by negroni_cam.c (0317) for the
+ * camera IFE and ICP streams).
+ *
+ * Why: XNU's RAM on this port starts at 0x840000000 (ADT --dram 840000000:C0000000), so no buffer of
+ * ours has a 32-bit physical address, and the Gunyah hypervisor turns an S2CR BYPASS entry into FAULT
+ * (README-wifi.md "2026-10-26 panic fix", arm-smmu-qcom.c bypass quirk). A context bank of our own, with
+ * our page tables, is the only DMA path for a 32-bit master: Android does the same (iommu-dma IOVAs from
+ * the DT qcom,iommu-dma-addr-pool / iova-mem-region-* windows).
+ *
+ * The register sequence of patch 0324 (negroni_wlan_smmu.c, the Wi-Fi stream 0x1c01), made generic: one
+ * struct negroni_s1 per user. SCTLR is 0324's (M, TRE, AFE, CFRE, ASIDPNE); the Wi-Fi 0325 rewrite differs there
+ * (HUPCF on, CFRE off, from the DT wlan fault flags): here a context fault aborts the access [I: fine for the
+ * camera and the ADSP, both log and stop on a fault]. TODO: one shared negroni_smmu.c should replace this file and
+ * negroni_wlan_smmu.c (0324) later; until then the two never take the same entries:
+ *   - this file takes free stream-match registers from the TOP index down (0324 from the bottom up); context
+ *     banks from the bottom up from IDR1.NUMS2CB as Linux (since 2026-10-27; 0325 also from the bottom), so the
+ *     CBAR marker below, the re-read and the claim lock keep the two apart;
+ *   - a context bank is free only by the U-Boot qcom-hyp-smmu.c rule (CBAR type S2_TRANS, or S1_TRANS_S2_BYPASS
+ *     with VMID 0xff; the rule 0325 uses too) and with SCTLR.M = 0 and no valid SMR whose S2CR translates into it;
+ *     a taken bank gets CBAR S1_TRANS_S2_BYPASS VMID 0 (0x1f300), so the other user's rule sees it as used;
+ *     teardown writes SCTLR 0 only (Linux) and never a CBAR: a released bank keeps 0x1f300 and only this file
+ *     reuses it (cb_released); every setup/teardown access is refusable (0297 negroni_mmio_try_*);
+ *   - each SMR is read again right before it is written (still invalid, or still the value we reuse);
+ *   - the claim lock negroni_smmu_claim_lock (exported below) is held from the free-entry scan to the last
+ *     SMR/S2CR/CBAR write and over the teardown; the CBAR is read again right before it is written. Wi-Fi
+ *     (0324/0325) is outside the lock until it takes it too.
+ * Every apps-SMMU access is one plain 32-bit ldr/str through negroni_mmio.h (Gunyah traps the global
+ * space and injects an SEA for any other access form).
+ */
+#ifndef _NEGRONI_SMMU_S1_H_
+#define _NEGRONI_SMMU_S1_H_
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+#include <kern/locks.h>
+
+/* 0249: the apps-SMMU claim lock; every driver that claims SMRs/context banks takes it */
+extern lck_mtx_t negroni_smmu_claim_lock;
+
+/*
+ * Per context bank, what this boot learned (negronismmu_probe, negroni_s1_on). Another SMMU user (Wi-Fi 0325)
+ * should skip a bank with READ_ABORT, CLAIM_REFUSED or OURS, and must never write a CBAR back on teardown.
+ */
+enum {
+	NEGRONI_CB_UNKNOWN = 0,
+	NEGRONI_CB_REWRITE_REFUSED = 1,         /* probe: the same CBAR value written back: SEA */
+	NEGRONI_CB_REWRITE_CHANGED = 2,         /* probe: accepted, but CBAR reads back another value */
+	NEGRONI_CB_READ_ABORT = 3,              /* a read of the bank's CBAR/CBA2R/SCTLR/TLBSTATUS aborted */
+	NEGRONI_CB_NOT_TRIED = 4,               /* probe=1: in use (SCTLR.M 1 or an SMR translates into it) */
+	NEGRONI_CB_REWRITE_OK = 5,              /* probe: the same CBAR value written back and kept */
+	NEGRONI_CB_CLAIM_REFUSED = 6,           /* negroni_s1_on: CBA2R/CBAR 0x1f300 refused or not kept */
+	NEGRONI_CB_OURS = 7,                    /* negroni_s1_on: claimed */
+};
+extern int8_t negroni_smmu_cb_verdict[128];
+/* the probe (negronismmu_probe=1|2 at boot): one line per bank; reads, and same-value CBAR writes only */
+void negroni_smmu_probe(uint32_t level);
+
+#define NEGRONI_S1_MAX_STREAMS  6
+#define NEGRONI_S1_TABLE_PAGES  32      /* 16 KiB kernel pages, 4 tables of 4 KiB each: 128 tables */
+
+struct negroni_s1_stream {
+	uint16_t id, mask;              /* one SMR: ID 14:0, MASK 30:16 (live DT iommus = <&apps_smmu id mask>) */
+};
+
+struct negroni_s1 {
+	/* set by the user */
+	const char *name;                       /* log prefix, e.g. "NEGRONI CAM" */
+	const struct negroni_s1_stream *streams;
+	uint32_t nstreams;
+	/* state (zero at start) */
+	bool on;
+	uint32_t cb;                            /* context bank index */
+	uint32_t old_cbar, old_cba2r;           /* as found (logged; never written back since 2026-10-27) */
+	bool cb_written;
+	uint32_t page, pages, nctx, nsmr, nums2cb;
+	vm_offset_t g0, cbva;                   /* global pages 0-1, our context bank page */
+	vm_offset_t g0_map, cb_map;             /* the mappings to free (page aligned) */
+	vm_size_t g0_size, cb_size;
+	uint32_t smr[NEGRONI_S1_MAX_STREAMS], old_smr[NEGRONI_S1_MAX_STREAMS], old_s2cr[NEGRONI_S1_MAX_STREAMS];
+	bool reused[NEGRONI_S1_MAX_STREAMS], written[NEGRONI_S1_MAX_STREAMS];
+	vm_offset_t tpage[NEGRONI_S1_TABLE_PAGES];
+	uint32_t tpages, tleft;
+	uint64_t *root;
+	uint64_t root_pa;
+	uint32_t mapped_pages;
+};
+
+/* Context on for all streams of s. 0 or an errno; the reason is printed. On failure nothing stays written. */
+int negroni_s1_on(struct negroni_s1 *s);
+/* Map `size` bytes of kernel memory at `kva` (any physical layout, 4 KiB pages) at device address `iova`. */
+int negroni_s1_map_kva(struct negroni_s1 *s, uint64_t iova, vm_offset_t kva, uint64_t size);
+/* Print the context's fault registers (FSR, FAR, FSYNR0, the faulting stream) and clear them. */
+void negroni_s1_report(struct negroni_s1 *s, const char *when);
+/* The context's fault status (CB_FSR fault bits), 0 when off or no fault: cheap enough for a frame loop. */
+uint32_t negroni_s1_fsr(struct negroni_s1 *s);
+/* After the masters stopped: the SMRs/S2CRs back as found, the context off, the tables freed. */
+void negroni_s1_off(struct negroni_s1 *s);
+
+#endif /* _NEGRONI_SMMU_S1_H_ */
