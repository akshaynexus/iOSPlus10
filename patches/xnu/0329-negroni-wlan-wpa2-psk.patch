+	if (key_len > 32) {
+		return EINVAL;
+	}
+	memset(w, 0, sizeof(w));
+	w[0] = 0;                                       /* vdev */
+	memcpy(&w[1], g_wpa.peer, 6);                   /* wmi_mac_addr (the AP for both keys in STA mode) */
+	w[3] = idx;
+	w[4] = flags;
+	w[5] = WMI_CIPHER_AES_CCM;
