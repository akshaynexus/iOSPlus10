+	memcpy(m + 4, w, sizeof(w));
+	uint32_t ka = (key_len + 3) & ~3u;
+	h = (TAG_ARRAY_BYTE << 16) | ka;
+	memcpy(m + 4 + sizeof(w), &h, 4);
