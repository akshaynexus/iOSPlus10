+/*
+ * fLock held. 0x49: the caller's pages [pointer, pointer + size) as a buffer (Turnip's
+ * VK_EXT_external_memory_host, Metal's newBufferWithBytesNoCopy:). The pages are wired
+ * (prepare) while the handle lives, so the GPU keeps the pages that were there at import even if
+ * the program unmaps or remaps the range. Read-only (kUserptrReadOnly): wired for reading only
+ * (read-only memory of the program can be imported) and mapped read-only for the GPU. Cache rules
+ * as for an IOSurface import: cleaned and dropped now, the CPU's later writes cleaned at each
+ * submission that lists it, CPU_PREP after GPU writes. Only the task that opened the connection.
+ */
+IOReturn
+RedwoodGPUUserClient::importHost(uint64_t pointer, uint64_t size, uint32_t flags, uint32_t * handle)
+{
+	bool readOnly = (flags & kUserptrReadOnly) != 0;
+	struct gpu_buffer * b;
+
+	if ((flags & ~kUserptrReadOnly) != 0 || pointer == 0 || size == 0 || (pointer & PAGE_MASK) ||
+	    (size & PAGE_MASK) || size > GPU_BUFFER_MAX || pointer + size < pointer) {
+		return kIOReturnBadArgument;
+	}
+	if (current_task() != fTask) {
+		return kIOReturnNotPermitted;
+	}
+	if (fHostBytes + size > GPU_CLIENT_HOST_BYTES) {
+		return kIOReturnNoMemory;
+	}
+	b = newBuffer(handle);
+	if (b == NULL) {
+		IOLog("RedwoodGPU: %s has no handles left\n", fName);
+		return kIOReturnNoResources;
+	}
+	b->kind = kBufferHost;
+	b->size = size;
+	b->readOnly = readOnly;
+	b->flags = MSM_BO_CACHED | (readOnly ? MSM_BO_GPU_READONLY : 0);
+	b->memory = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)pointer, (mach_vm_size_t)size,
+	    readOnly ? kIODirectionOut : kIODirectionInOut, fTask);
+	if (b->memory == NULL) {
+		dropBuffer(b);
+		return kIOReturnNoMemory;
+	}
+	if (b->memory->prepare() != kIOReturnSuccess) {
+		dropBuffer(b);
+		return kIOReturnVMError;        /* not mapped, or not writable without kUserptrReadOnly */
+	}
+	b->prepared = true;
+	if (!takePages(b)) {
+		dropBuffer(b);
+		return kIOReturnVMError;
+	}
+	for (uint32_t p = 0; p < b->npages; p++) {
+		cachePage(b->pa[p]);
+		if (pmap_valid_page((ppnum_t)(b->pa[p] >> PAGE_SHIFT))) {
+			pmap_clear_modify((ppnum_t)(b->pa[p] >> PAGE_SHIFT));
+		}
+	}
+	if (!mapAnywhere(b)) {
+		dropBuffer(b);
+		return kIOReturnNoMemory;
+	}
+	fHostBytes += size;
+	return kIOReturnSuccess;
+}
