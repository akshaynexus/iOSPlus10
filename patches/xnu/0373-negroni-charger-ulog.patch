diff --git a/bsd/dev/negroni_chg_glink.c b/bsd/dev/negroni_chg_glink.c
index 366900b..f9af56c 100644
--- a/bsd/dev/negroni_chg_glink.c
+++ b/bsd/dev/negroni_chg_glink.c
@@ -1473,12 +1473,202 @@ chg_thread(__unused void *arg, __unused wait_result_t wr)
