+#endif
+
+#define NWIOS_IFNAME            "en0"
+#define SIOCSA80211_CMD         0x802869c8ul    /* _IOW('i', 200, struct apple80211req) */
+#define SIOCGA80211_CMD         0xc02869c9ul    /* _IOWR('i', 201, struct apple80211req) */
+
+/* ---- backend (negroni_wlan_ios.c); every call returns at once, results come as events ---- */
+const char *nwios_backend_name(void);           /* "driver" or "fake" */
+uint32_t nwios_caps(void);                      /* NWLAN_CAP_* */
+bool nwios_present(void);                       /* en0 exists and the backend answers */
+bool nwios_powered(void);                       /* the soft radio switch (Settings / Control Center) */
+int nwios_set_power(bool on);                   /* off: leave the network; event NWIOS_EV_POWER */
+int nwios_scan(void);                           /* 0 / ENETDOWN / ENXIO; always ends in NWIOS_EV_SCAN_DONE */
+/* the BSS list of the last finished scan, copied at NWIOS_EV_SCAN_DONE; returns false past the end */
+bool nwios_result(uint32_t index, struct nwlan_bss *out);
+/* psk NULL: open; else a passphrase (8..63) or 64 hex digits; always ends in NWIOS_EV_JOIN_DONE */
+int nwios_associate(const uint8_t *ssid, uint32_t ssid_len, const char *psk, uint32_t psk_len);
+int nwios_disassociate(void);
+void nwios_link(struct nwlan_link *out);        /* state, bssid, ssid, rssi, freq of the backend */
+bool nwios_joined(void);                        /* en0's link is up */
+
+/* ---- Apple80211 (negroni_apple80211.c) ---- */
+enum nwios_event {
+	NWIOS_EV_POWER,                         /* status 1 on, 0 off */
+	NWIOS_EV_SCAN_DONE,                     /* status 0 or errno */
+	NWIOS_EV_JOIN_DONE,                     /* status 0 or errno (EAUTH: wrong passphrase, ETIMEDOUT) */
+	NWIOS_EV_LINK,                          /* status 1 joined, 0 left when asked, errno: lost */
+};
+int negroni_apple80211_ioctl(unsigned long command, void *data);
+void negroni_apple80211_event(enum nwios_event event, int status);     /* worker thread only */
+void negroni_apple80211_summary(void);
+
+/* ---- registry (NegroniWLAN.cpp) ---- */
+bool negroni_wlan_ios_dt_entry(void);          /* make IODeviceTree "wlan" if no entry has that name */
+bool negroni_wlan_ios_adt_mac(uint8_t mac[6]);  /* /chosen mac-address-wifi0 */
+void negroni_wlan_ios_publish(const char *ifname, const uint8_t mac[6]);
+
+void negroni_wlan_ios_init(void);               /* from negroni_wifi_init() */
+uint32_t negroni_wlan_ios_log_max(void);        /* negroniwlan_ios_log */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _NEGRONI_WLAN_IOS_H_ */
diff --git a/iokit/Kernel/arm/NegroniWLAN.cpp b/iokit/Kernel/arm/NegroniWLAN.cpp
new file mode 100644
index 0000000..8e3eef5
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniWLAN.cpp
@@ -0,0 +1,231 @@
+/*
+ * Copyright (c) 2026 iOSPlus10. Derived from HakiOS (oosexgang/hackios-xnu-kernel, xnu/files/iokit/Kernel/
+ * hakios.wlan.cpp, Apple Public Source License 2.0).
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_START@
+ *
+ * This file contains Original Code and/or Modifications of Original Code
+ * as defined in and that are subject to the Apple Public Source License
+ * Version 2.0 (the 'License'). You may not use this file except in
+ * compliance with the License. The rights granted to you under the License
+ * may not be used to create, or enable the creation or redistribution of,
+ * unlawful or unlicensed software or any other software. Please obtain a
+ * copy of the License at http://www.opensource.apple.com/apsl/ and read it
+ * before using this file.
+ *
+ * The Original Code and all software distributed under the License are
+ * distributed on an 'AS IS' basis, WITHOUT WARRANTY OF ANY KIND, EITHER
+ * EXPRESS OR IMPLIED, AND APPLE HEREBY DISCLAIMS ALL SUCH WARRANTIES,
+ * INCLUDING WITHOUT LIMITATION, ANY WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE, QUIET ENJOYMENT OR NON-INFRINGEMENT.
+ * Please see the License for the specific language governing rights and
+ * limitations under the License.
+ *
+ * @APPLE_OSREFERENCE_LICENSE_HEADER_END@
+ */
+/*
+ * NEGRONI Wi-Fi, iOS side (patch 0340): the registry entries iOS looks for.
+ *
+ * 1. IODeviceTree "wlan". The launchd job com.apple.wifid has _LimitLoadToDeviceTree ("wlan", "marconi-wifi");
+ *    launchd 20H392 asks io_device_tree_entry_exists_with_name (IOUserClient.cpp), which runs
+ *    IODTFindMatchingEntries(root, kIODTRecursive, name) over the IODeviceTree plane and compares entry names.
+ *    Our ADT has no such node, so wifid never ran and Settings had no Wi-Fi device (greyed switch). The entry is
+ *    made here at boot, before launchd reads its jobs, under /arm-io (or the root), with name/compatible data.
+ * 2. IO80211Controller + IONetworkInterface, property-only, as IO80211Family / IONetworkingFamily name theirs
+ *    (HakiOS hakios.wlan.cpp): IO80211.framework 20H392 matches IO80211Controller ("No Matches for
+ *    IO80211Controller, trying dk matching"), then the interface by IOPropertyMatch IO80211InterfaceRole =
+ *    "Infrastructure" and IOInterfaceName; SystemConfiguration lists IONetworkInterface objects and calls one Wi-Fi
+ *    when its parent is an IO80211Controller (IOMACAddress on the controller). No user client: the framework falls
+ *    back to the ioctl path (negroni_apple80211.c).
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSString.h>
+
+extern "C" {
+#include "../../../bsd/dev/negroni_wlan_ios.h"
+}
+
+class IO80211Controller : public IOService
+{
+	OSDeclareDefaultStructors(IO80211Controller);
+};
+
+OSDefineMetaClassAndStructors(IO80211Controller, IOService);
+
+class IONetworkInterface : public IOService
+{
+	OSDeclareDefaultStructors(IONetworkInterface);
+};
+
+OSDefineMetaClassAndStructors(IONetworkInterface, IOService);
+
+class NegroniWLANInterface : public IONetworkInterface
+{
+	OSDeclareDefaultStructors(NegroniWLANInterface);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+	    IOUserClient ** handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(NegroniWLANInterface, IONetworkInterface);
+
+/* none on purpose: IO80211.framework then uses the ioctls ("Falling back to IOCTL path") */
+IOReturn
+NegroniWLANInterface::newUserClient(task_t owningTask, void * securityID, UInt32 type, OSDictionary * properties,
+    IOUserClient ** handler)
+{
+	static unsigned said;
+
+	if (said++ < 8) {
+		IOLog("NEGRONI WLAN iOS: user client type %u asked of en0's service: none (ioctl path)\n", (unsigned) type);
+	}
+	return kIOReturnUnsupported;
+}
+
+static IOService *
+publish(IOService * service, IOService * provider, const char * name)
+{
+	if (service == NULL || !service->attach(provider)) {
+		OSSafeReleaseNULL(service);
+		return NULL;
+	}
+	service->setName(name);
+	if (!service->start(provider)) {
+		service->detach(provider);
+		service->release();
+		return NULL;
+	}
+	service->registerService();
+	return service;
+}
+
+static void
+set_data_string(IORegistryEntry * entry, const char * key, const char * value)
+{
+	OSData * data = OSData::withBytes(value, (unsigned) strlen(value) + 1);
+
+	if (data != NULL) {
+		entry->setProperty(key, data);
+		data->release();
+	}
+}
+
+/* IODeviceTree "wlan" when no entry has that name; true if one was made */
+extern "C" bool
+negroni_wlan_ios_dt_entry(void)
+{
+	OSCollectionIterator * found = IODTFindMatchingEntries(IORegistryEntry::getRegistryRoot(), kIODTRecursive, "wlan");
+	bool there = found != NULL && found->getNextObject() != NULL;
+	IORegistryEntry * parent;
+	IORegistryEntry * entry;
+
+	OSSafeReleaseNULL(found);
+	if (there) {
+		return false;
+	}
+	parent = IORegistryEntry::fromPath("/arm-io", gIODTPlane);
+	if (parent == NULL) {
+		parent = IORegistryEntry::fromPath("/", gIODTPlane);
+	}
+	entry = OSTypeAlloc(IORegistryEntry);
+	if (parent == NULL || entry == NULL || !entry->init()) {
+		OSSafeReleaseNULL(parent);
+		OSSafeReleaseNULL(entry);
+		IOLog("NEGRONI WLAN iOS: cannot make IODeviceTree \"wlan\"\n");
+		return false;
+	}
+	entry->setName("wlan", gIODTPlane);
+	entry->setName("wlan");
+	set_data_string(entry, "name", "wlan");
+	set_data_string(entry, "compatible", "wlan-pcie,negroni");
+	set_data_string(entry, "device_type", "wlan");
+	if (!entry->attachToParent(parent, gIODTPlane)) {
+		IOLog("NEGRONI WLAN iOS: cannot attach IODeviceTree \"wlan\"\n");
+		entry->release();
+		parent->release();
+		return false;
+	}
+	entry->release();
+	parent->release();
+	return true;
+}
+
+/* /chosen mac-address-wifi0 (config/negroni-ne2211.toml [adt.extra.chosen]) */
+extern "C" bool
+negroni_wlan_ios_adt_mac(uint8_t mac[6])
+{
+	IORegistryEntry * chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	OSData * data;
+	bool ok = false;
+
+	if (chosen != NULL) {
+		data = OSDynamicCast(OSData, chosen->getProperty("mac-address-wifi0"));
+		if (data != NULL && data->getLength() >= 6) {
+			memcpy(mac, data->getBytesNoCopy(), 6);
+			ok = true;
+		}
+		chosen->release();
+	}
+	return ok;
+}
+
+/* once, after en0 is attached */
+extern "C" void
+negroni_wlan_ios_publish(const char * ifname, const uint8_t mac[6])
+{
+	IOService * platform = IOService::getPlatform();
+	IO80211Controller * controller = OSTypeAlloc(IO80211Controller);
+	NegroniWLANInterface * wlan = OSTypeAlloc(NegroniWLANInterface);
+	OSData * address;
+	OSNumber * number;
+
+	if (platform == NULL || controller == NULL || wlan == NULL || !controller->init() || !wlan->init()) {
+		OSSafeReleaseNULL(controller);
+		OSSafeReleaseNULL(wlan);
+		IOLog("NEGRONI WLAN iOS: cannot create the IO80211 services\n");
+		return;
+	}
+	if ((address = OSData::withBytes(mac, 6)) != NULL) {
+		controller->setProperty("IOMACAddress", address);
+		address->release();
+	}
+	controller->setProperty("IOBuiltin", true);
+	controller->setProperty("IOVendor", "Qualcomm");
+	controller->setProperty("IOModel", "QCA6490");
+	if ((controller = (IO80211Controller *) publish(controller, platform, "NegroniWLANController")) == NULL) {
+		wlan->release();
+		IOLog("NEGRONI WLAN iOS: the IO80211Controller did not start\n");
+		return;
+	}
+
+	wlan->setProperty("IOInterfaceName", ifname);
+	wlan->setProperty("BSD Name", ifname);
+	wlan->setProperty("IOInterfaceNamePrefix", "en");
+	if ((number = OSNumber::withNumber(6ULL, 32)) != NULL) {        /* IFT_ETHER */
+		wlan->setProperty("IOInterfaceType", number);
+		number->release();
+	}
+	if ((number = OSNumber::withNumber((unsigned long long) (ifname[2] - '0'), 32)) != NULL) {
+		wlan->setProperty("IOInterfaceUnit", number);
+		number->release();
+	}
+	wlan->setProperty("IOBuiltin", true);
+	wlan->setProperty("IOPrimaryInterface", true);
+	wlan->setProperty("IO80211InterfaceRole", "Infrastructure");
+	if (publish(wlan, controller, "NegroniWLAN") == NULL) {
+		IOLog("NEGRONI WLAN iOS: the en0 service did not start\n");
+	} else {
+		IOLog("NEGRONI WLAN iOS: IO80211Controller + IONetworkInterface (%s, IO80211InterfaceRole Infrastructure) registered\n",
+		    ifname);
+		wlan->release();
+	}
+	controller->release();
+}
