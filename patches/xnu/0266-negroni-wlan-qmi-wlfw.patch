+/* Read one named file from the area into the pool (cacheable view), check SHA-256, push it to RAM. */
+static int
+wlan_load(const struct wlan_area_header *hdr, const char *name, uint32_t off, uint32_t cap, uint32_t *out)
+{
+	int error = wlan_area_get(hdr, name, (void *)(g_pool_kva + off), cap, out);
+
+	if (!error) {
+		flush_dcache64((addr64_t)(g_pool_pa + off), *out, TRUE);
+	}
+	return error;
+}
+
+int
+negroni_wlan_fw_file(const char *name, void *dst, uint32_t cap, uint32_t *size)
+{
+	struct wlan_area_header *hdr = NULL;
+	int error;
+
+	if (kmem_alloc(kernel_map, (vm_offset_t *)&hdr, WLAN_AREA_HDR, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return ENOMEM;
+	}
+	error = negroni_ufs_wlan_area_read(0, hdr, WLAN_AREA_HDR);
+	if (!error && (memcmp(hdr->magic, "NEGRWLAN", 8) != 0 || hdr->version != 1 || hdr->count == 0 ||
+	    hdr->count > WLAN_FW_MAX)) {
+		error = EINVAL;
+	}
+	if (!error) {
+		error = wlan_area_get(hdr, name, dst, cap, size);
+	}
+	kmem_free(kernel_map, (vm_offset_t)hdr, WLAN_AREA_HDR);
+	return error;
+}
