From: iOSPlus10 display-perf agent
Subject: [PATCH] negroni gpu: DCVS UI floor from the framebuffer's swap rate (0286)

0281 raises the GX level only after two busy 100 ms samples in a row; under UI load
(40-80 swaps/s, GPU 30-40 % busy) it stayed at level 4-5 (350-421 MHz) and backboardd's
Metal command buffers took 10-24 ms commit-to-complete (telemetry mean 15.6 ms, n 9368).
A fixed 818 MHz boot (2026-10-25) averaged 57.7 presents/s against 43.5 with DCVS.

NegroniFramebuffer swap() counts SwapEnds (negroni_gpu_ui_swaps); the DCVS tick turns the
count into a rate over >= 100 ms. At negronigpu_uifps (default 30) swaps/s or more the
level is at least negronigpu_uifloor (default 9 = 640 MHz) for negronigpu_uihold ms
(default 1000) after the last such window, and one busy tick (100 ms instead of 200)
moves one level up. The thermal cap (0280) still limits it. negronigpu_uifloor=0 = off.
Log: "NEGRONI GPU DCVS: UI floor level 9 (640 MHz) at 30 swaps/s or more, held 1000 ms
(0286)"; the per-second DCVS line ends in ", ui N swaps/s[ floor on] (N boosts)".

diff --git a/bsd/dev/negroni_adreno.c b/bsd/dev/negroni_adreno.c
index 5ece67c..d519eb7 100644
--- a/bsd/dev/negroni_adreno.c
+++ b/bsd/dev/negroni_adreno.c
@@ -3476,6 +3476,23 @@ extern void negroni_cpufreq_mhz_line(char *buf, size_t size);    /* 0284 */
 
 static uint32_t dcvs_on = 1, dcvs_level, dcvs_max, dcvs_busy_pct, dcvs_votes, dcvs_failed;
 
+/*
+ * Patch 0286: a UI floor for the governor. The busy rule above samples a pending fence every
+ * 100 ms; CoreAnimation at 40-80 frames/s keeps the GPU 30-40 % busy (each frame 10-24 ms from
+ * commit to completion at 350-421 MHz), so it rarely sees two busy samples in a row and the GPU
+ * stays at levels 4-5 while the UI misses its 8.3 ms frames (log 2026-10-26 13:18-13:31: dcvs 4-5,
+ * busy 20-50 %). The framebuffer counts swaps (negroni_gpu_ui_swaps, NegroniFramebuffer.cpp
+ * swap()); at negronigpu_uifps swaps/s or more the level is at least negronigpu_uifloor for
+ * negronigpu_uihold ms after the last such tick, and a single busy tick (100 ms) moves one level
+ * up. The thermal cap (0280) still wins. negronigpu_uifloor=0 turns it off.
+ */
+#define DCVS_UI_FLOOR           9       /* 640 MHz */
+#define DCVS_UI_FPS             30
+#define DCVS_UI_HOLD_MS         1000
+uint32_t negroni_gpu_ui_swaps;          /* NegroniFramebuffer.cpp: one per SwapEnd (atomic) */
+static uint32_t dcvs_ui_floor = DCVS_UI_FLOOR, dcvs_ui_fps = DCVS_UI_FPS, dcvs_ui_hold = DCVS_UI_HOLD_MS;
+static uint32_t dcvs_ui_left, dcvs_ui_rate, dcvs_ui_ms, dcvs_ui_count, dcvs_ui_boosts;
+
 static uint32_t
 dcvs_bw_for(uint32_t level, uint32_t top)
 {
@@ -3511,13 +3528,32 @@ dcvs_tick(bool gx, bool busy, uint32_t ms, uint32_t *idle_ms, uint32_t *busy_ms,
 		dcvs_busy_pct = *busy_ticks * 100 / *ticks;
 		*ticks = *busy_ticks = 0;
 	}
+	/* 0286: the swap rate over at least 100 ms */
+	dcvs_ui_count += __atomic_exchange_n(&negroni_gpu_ui_swaps, 0, __ATOMIC_RELAXED);
+	dcvs_ui_ms += ms;
+	if (dcvs_ui_ms >= DCVS_TICK_MS) {
+		dcvs_ui_rate = dcvs_ui_count * 1000 / dcvs_ui_ms;
+		if (dcvs_ui_floor != 0 && dcvs_ui_rate >= dcvs_ui_fps) {
+			if (dcvs_ui_left == 0) {
+				dcvs_ui_boosts++;
+			}
+			dcvs_ui_left = dcvs_ui_hold;
+		} else {
+			dcvs_ui_left = dcvs_ui_left > dcvs_ui_ms ? dcvs_ui_left - dcvs_ui_ms : 0;
+		}
+		dcvs_ui_count = dcvs_ui_ms = 0;
+	}
+	bool ui = dcvs_ui_left != 0;
 	uint32_t want = dcvs_level;
 	if (*idle_ms >= DCVS_IDLE_MS) {
 		want = DCVS_FLOOR;
-	} else if (*busy_ms >= DCVS_UP_MS) {
+	} else if (*busy_ms >= (ui ? DCVS_TICK_MS : DCVS_UP_MS)) {
 		want = dcvs_level + 1;
 		*busy_ms = 0;
 	}
+	if (ui && want < dcvs_ui_floor) {
+		want = dcvs_ui_floor;
+	}
 	if (want > max) {
 		want = max;
 	}
@@ -3559,12 +3595,27 @@ gpu_watch(void *arg __unused, wait_result_t wr __unused)
 	uint32_t top = sizeof(gpu_khz) / sizeof(gpu_khz[0]) - 1;
 
 	(void)PE_parse_boot_argn("negronigpu_dcvs", &dcvs_on, sizeof(dcvs_on));
+	(void)PE_parse_boot_argn("negronigpu_uifloor", &dcvs_ui_floor, sizeof(dcvs_ui_floor));
+	(void)PE_parse_boot_argn("negronigpu_uifps", &dcvs_ui_fps, sizeof(dcvs_ui_fps));
+	(void)PE_parse_boot_argn("negronigpu_uihold", &dcvs_ui_hold, sizeof(dcvs_ui_hold));
+	if (dcvs_ui_floor > top) {
+		dcvs_ui_floor = top;
+	}
+	if (dcvs_ui_fps == 0) {
+		dcvs_ui_fps = 1;
+	}
 	dcvs_max = vote_arg ? vote_arg : top;
 	dcvs_level = vote_level;
 	from = dcvs_level;
 	if (dcvs_on) {
 		printf("NEGRONI GPU DCVS: on: start level %u (%u MHz), max %u, floor %u, tick %u ms, idle %u ms, up %u ms\n",
 		    dcvs_level, gpu_khz[dcvs_level] / 1000, dcvs_max, DCVS_FLOOR, DCVS_TICK_MS, DCVS_IDLE_MS, DCVS_UP_MS);
+		if (dcvs_ui_floor != 0) {
+			printf("NEGRONI GPU DCVS: UI floor level %u (%u MHz) at %u swaps/s or more, held %u ms (0286)\n",
+			    dcvs_ui_floor, gpu_khz[dcvs_ui_floor] / 1000, dcvs_ui_fps, dcvs_ui_hold);
+		} else {
+			printf("NEGRONI GPU DCVS: UI floor off (negronigpu_uifloor=0)\n");
+		}
 	}
 	for (uint32_t second = 1;; second++) {
 		uint32_t now[14];
@@ -3611,8 +3662,9 @@ gpu_watch(void *arg __unused, wait_result_t wr __unused)
 		}
 		pm_watch_idle = false;
 		if (changes) {
-			printf("NEGRONI GPU DCVS: level %u -> %u (%u MHz, bw %u), %u changes this second, busy %u%%, cap %u\n",
-			    from, dcvs_level, gpu_khz[dcvs_level] / 1000, vote_bw, changes, dcvs_busy_pct, negroni_thermal_gpu_cap());
+			printf("NEGRONI GPU DCVS: level %u -> %u (%u MHz, bw %u), %u changes this second, busy %u%%, cap %u, ui %u swaps/s%s (%u boosts)\n",
+			    from, dcvs_level, gpu_khz[dcvs_level] / 1000, vote_bw, changes, dcvs_busy_pct, negroni_thermal_gpu_cap(),
+			    dcvs_ui_rate, dcvs_ui_left != 0 ? " floor on" : "", dcvs_ui_boosts);
 			changes = 0;
 			from = dcvs_level;
 		}
diff --git a/iokit/Kernel/arm/NegroniFramebuffer.cpp b/iokit/Kernel/arm/NegroniFramebuffer.cpp
index 34073cc..41b41e0 100644
--- a/iokit/Kernel/arm/NegroniFramebuffer.cpp
+++ b/iokit/Kernel/arm/NegroniFramebuffer.cpp
@@ -134,6 +134,7 @@
 extern "C" int negroni_console_muted;     /* osfmk/console/serial_console.c */
 extern "C" char negroni_gpu_badge[24];   /* bsd/dev/negroni_adreno.c */
 extern "C" uint32_t negroni_gpu_badge_color;
+extern "C" uint32_t negroni_gpu_ui_swaps;       /* bsd/dev/negroni_adreno.c (0286): the GPU DCVS UI floor */
 extern "C" char negroni_wifi_badge[24];   /* bsd/dev/negroni_wifi.c */
 extern "C" uint32_t negroni_wifi_badge_color;
 extern "C" unsigned char iso_font[256 * 16];
@@ -1762,6 +1763,7 @@ AppleCLCD::swap(const uint8_t *rec)
 		}
 	}
 	__atomic_fetch_add(&fStatSwaps, 1, __ATOMIC_RELAXED);
+	__atomic_fetch_add(&negroni_gpu_ui_swaps, 1, __ATOMIC_RELAXED);     /* 0286 */
 	if ((++negroni_fb_swap_count % 1000) == 0) {
 		IOLog("NEGRONI FB: %llu swaps\n", negroni_fb_swap_count);
 	}
