+/*
+ * Patch 0362 (negroni-kmem-report): one line with the state of the kernel
+ * data VA range (KMEM_RANGE_ID_DATA: kalloc_large of KHEAP_DATA_BUFFERS,
+ * kmem_alloc(KMA_DATA), ml_io_map_unmappable) and of the physical pages.
+ * kmem_alloc_guard fails with KERN_NO_SPACE (3) when the range has no hole
+ * and with KERN_RESOURCE_SHORTAGE (6) when vm_page_grab() finds no free page
+ * and wired + free_target pages leave no room (vm_page_alloc_list).
+ * Callers: kalloc_large failures, bsd_init before the root mount, the HFS
+ * journal when its transaction buffer is NULL. Takes the kernel_map read
+ * lock: not for a panic path or a caller that holds a map lock.
+ */
+void negroni_kmem_report(const char *why, vm_size_t req, int kr);
+
+void
+negroni_kmem_report(const char *why, vm_size_t req, int kr)
+{
+	const struct mach_vm_range *r = &kmem_ranges[KMEM_RANGE_ID_DATA];
+	vm_map_offset_t prev = r->min_address;
+	vm_map_size_t used = 0, hole = 0;
+	vm_map_entry_t e;
+	uint32_t n = 0;
+
+	if (startup_phase < STARTUP_SUB_KMEM || r->max_address == 0) {
+		printf("NEGRONI KMEM: %s: req %lu kr %d (no kmem ranges yet)\n", why, (unsigned long)req, kr);
+		return;
+	}
+	vm_map_lock_read(kernel_map);
+	for (e = vm_map_first_entry(kernel_map); e != vm_map_to_entry(kernel_map); e = e->vme_next) {
+		vm_map_offset_t s = MAX(e->vme_start, r->min_address);
+		vm_map_offset_t t = MIN(e->vme_end, r->max_address);
+
+		if (t <= s) {
+			continue;
+		}
+		used += t - s;
+		n++;
+		if (s > prev && s - prev > hole) {
+			hole = s - prev;
+		}
+		if (t > prev) {
+			prev = t;
+		}
+	}
+	vm_map_unlock_read(kernel_map);
+	if (r->max_address > prev && r->max_address - prev > hole) {
+		hole = r->max_address - prev;
+	}
+	printf("NEGRONI KMEM: %s: req %lu kr %d; data range used %llu MiB in %u entries, free %llu MiB, "
+	    "largest hole %llu MiB; pages free %u wired %u free_target %u reserved %u (16 KiB), max_mem %llu MiB\n",
+	    why, (unsigned long)req, kr,
+	    (unsigned long long)(used >> 20), n,
+	    (unsigned long long)((mach_vm_range_size(r) - used) >> 20),
+	    (unsigned long long)(hole >> 20),
+	    vm_page_free_count, vm_page_wire_count, vm_page_free_target, vm_page_free_reserved,
+	    (unsigned long long)(max_mem >> 20));
+}
