+/*
+ * Patch 0285: the CP's power-up register list (KGSL adreno_gen7.c gen7_patch_pwrup_reglist, the lists
+ * gen7_ifpc_pwrup_reglist and gen7_pwrup_reglist, offsets from gen7_reg.h). After an IFPC exit the CP
+ * writes these registers back from the list (ME_INIT ordinal mask BIT(8), the list address, BIT(31):
+ * a dynamic part of triplets, gen7_cp_init_cmds). Layout (kgsl_util.h struct cpu_gpu_lock): gpu_req,
+ * cpu_req, turn, then u8 ifpc_list_len, u8 preemption_list_len, u16 dynamic_list_len; the pairs
+ * {offset, value} of both static lists; the triplets {pipe << 12, offset, value}: KGSL's one
+ * (RBBM_PERFCTR_CNTL = 1). Values: what the registers read after step 20's writes, as KGSL does.
+ */
+#define PWRUP_AT                0x400   /* in the scratch page */
+static const uint16_t pwrup_ifpc_regs[] = {
+	0xb604 /* TPL1_NC_MODE_CNTL */, 0x0843 /* CP_DBG_ECO_CNTL */, 0x084f /* CP_PROTECT_CNTL */,
+	0x0b09 /* CP_LPAC_PROTECT_CNTL */,
+};
+#define PWRUP_PROTECT_REG       0x0850  /* CP_PROTECT_REG 0..47 */
+#define PWRUP_PROTECT_COUNT     48
+static const uint16_t pwrup_regs[] = {
+	0x0e09, 0x0e0a /* UCHE_TRAP_BASE */, 0x0e07, 0x0e08 /* UCHE_WRITE_THRU_BASE */, 0x0e0b, 0x0e0c,
+	0x0e0d, 0x0e0e /* UCHE_GMEM_RANGE_MIN/MAX */, 0x0e17 /* UCHE_CACHE_WAYS */, 0x0e01 /* UCHE_MODE_CNTL */,
+	0x8e08 /* RB_NC_MODE_CNTL */, 0x8e28 /* RB_CMP_DBG_ECO_CNTL */, 0xae02 /* SP_NC_MODE_CNTL */,
+	0x8602 /* GRAS_NC_MODE_CNTL */, 0x8e50 /* RB_CONTEXT_SWITCH_GMEM_SAVE_RESTORE */,
+	0x0e3a /* UCHE_GBIF_GX_CONFIG */, 0x0e19 /* UCHE_CLIENT_PF */,
+};
+
+static bool
+pwrup_list_build(void)
+{
+	volatile uint32_t *w = (volatile uint32_t *)(core_scratch.memory + PWRUP_AT);
+	uint32_t n = 4, ifpc = 0, pre = 0;
+
+	for (uint32_t i = 0; i < sizeof(pwrup_ifpc_regs) / sizeof(pwrup_ifpc_regs[0]); i++, ifpc++) {
+		w[n++] = pwrup_ifpc_regs[i];
+		w[n++] = rd(gpu_regs + GPU_WORD(pwrup_ifpc_regs[i]));
+	}
+	for (uint32_t i = 0; i < PWRUP_PROTECT_COUNT; i++, ifpc++) {
+		w[n++] = PWRUP_PROTECT_REG + i;
+		w[n++] = rd(gpu_regs + GPU_WORD(PWRUP_PROTECT_REG + i));
+	}
+	w[n++] = REG_CP_AHB_CNTL;
+	w[n++] = rd(gpu_regs + GPU_WORD(REG_CP_AHB_CNTL));
+	ifpc++;
+	for (uint32_t i = 0; i < sizeof(pwrup_regs) / sizeof(pwrup_regs[0]); i++, pre++) {
+		w[n++] = pwrup_regs[i];
+		w[n++] = rd(gpu_regs + GPU_WORD(pwrup_regs[i]));
+	}
+	w[n++] = 0u << 12;              /* PIPE_NONE (adreno_gen7.h) */
+	w[n++] = REG_RBBM_PERFCTR_CNTL;
+	w[n++] = 1;
+	w[0] = w[1] = w[2] = 0;
+	w[3] = ifpc | pre << 8 | 1u << 16;
+	to_memory((vm_offset_t)w, 4 * n);
+	printf("NEGRONI GPU PM: 20 power-up list at scratch +%#x: %u IFPC + %u IFPC/preemption pairs, 1 triplet, %u bytes\n",
+	    PWRUP_AT, ifpc, pre, 4 * n);
+	return PWRUP_AT + 4 * n <= 4096;
+}
