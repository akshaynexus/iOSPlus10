+/*
+ * ---- patch 0285: GPU power between frames (IFPC) and after 2 s idle (slumber) ----
+ *
+ * Before 0285 the GMU started once, OOB GPU_SET stayed set from step 18 for the whole boot, so GX was
+ * powered all the time (0281 only lowered its clock). References: the OnePlus KGSL gen7 driver
+ * (out/src/op-kernel/drivers/gpu/msm). Three modes, chosen in gpu_keep (pm_start):
+ *
+ * PM_IFPC (negronigpu_ifpc=1, default, and the GMU acked FEATURE_CTRL IFPC at step 17): the CP has its
+ *   power-up list (step 20), OOB GPU_SET is cleared after step 22 (KGSL gen7_gpu_boot clears it once the
+ *   GPU runs), and the GMU collapses GX by itself 300 us after the CP passed the ring's "IFPC enable"
+ *   marker (every submission is already bracketed by SET_MARKER 0x101/0x100, as gen7_ringbuffer.c). The
+ *   CPU must not touch a collapsed GX: CP_RB_WPTR is a fenced write (adreno_gen7.c gen7_fenced_write:
+ *   write, GMU_AHB_FENCE_STATUS bit 0 = dropped, 10 us, again, up to 200 times; the dropped write makes
+ *   the GMU bring GX back), the ring room comes from the fences in memory (no CP_RB_RPTR read), and the
+ *   few GX reads left (watch line, report, table switch) hold GX with OOB PERFCNTR (gen7_gmu_oob_set:
+ *   set BIT(30 - 2 * 1), ack BIT(31 - 1), clear BIT(31 - 2 * 1)). KGSL has no OOB per submission.
+ * PM_SLUMBER (IFPC refused or off, negronigpu_slumber=1, default): after PM_SLUMBER_MS with no work,
+ *   KGSL gen7_power_off + gen7_gmu_power_off without the clock/CX-off part: OOB GPU_SET clear,
+ *   PREPARE_SLUMBER (H2F 33), wait for the GMU idle (GPU_CX_BUSY_STATUS bit 30) and GX off, RSC sleep
+ *   (gen7_rscc_sleep_sequence: CM3 into reset, RSCC_CONTROL_REQ bit 0, RSC_STATUS0 bit 16). The GMU then
+ *   does not run, so the wake is KGSL's warm boot (gen7_gmu_boot + gen7_gpu_boot): RSC wake
+ *   (gen7_rscc_wakeup_sequence), steps 14-18 again (firmware, start, HFI, tables, OOB GPU_SET), step 20
+ *   (registers, SQE, ME_INIT) and CP_SET_SECURE_MODE 0 (adreno_gen7.c gen7_rb_start: the zap shader is
+ *   loaded once). The submission that finds the GPU asleep does the wake and logs its time.
+ * PM_OFF: the 0281 behaviour (negronigpu_ifpc=0 negronigpu_slumber=0).
+ * IFPC acked but GX never collapsed in 10 s of idle: back to OOB GPU_SET and PM_SLUMBER (if allowed).
+ * One mutex (gpu_pm_lock) orders the submissions, the watch thread's HFI votes and the sleep/wake.
+ */
+#define PM_OFF                  0
+#define PM_IFPC                 1
+#define PM_SLUMBER              2
+#define PM_SLUMBER_MS           2000
+#define PM_IDLE_TICK_MS         250
+#define PM_NEVER_COLLAPSED_MS   10000
+#define GMU_OOB_PERF_SET        28
+#define GMU_OOB_PERF_ACK        30
+#define GMU_OOB_PERF_CLEAR      29
+#define GMU_INTR_MASK           0x1f993
+#define GMU_GFX_PWR_CLK_STATUS  0x1f8d0         /* bit 0 GX GDSC off, bit 1 GX clock off (gen7_gmu_gx_is_on) */
+#define GMU_RPMH_POWER_STATE    0x1f8ec         /* 0 active, 3 IFPC, 0xf slumber (kgsl_gmu_core.h GPU_HW_*) */
+#define GMU_AHB_FENCE_STATUS    0x23b13
+#define GMU_CX_BUSY_STATUS      0x23b0c         /* GPU_GMU_AO_GPU_CX_BUSY_STATUS, bit 30 CXGXCPUBUSYIGNAHB */
+#define GMU_RSCC_CONTROL_REQ    0x23b07
+#define PM_FENCE_RETRIES        200             /* GMU_CORE_LONG_WAKEUP_RETRY_LIMIT, 10 us each */
+
+static LCK_GRP_DECLARE(gpu_pm_grp, "negroni_gpu_pm");
+static LCK_MTX_DECLARE(gpu_pm_lock, &gpu_pm_grp);
+static uint32_t pm_mode;
+static bool pm_asleep, pm_dead, pm_revote, pm_watch_idle, pm_seen_collapse;
+static uint32_t fence_pos[256];         /* IFPC: ring position after each fence's write (fence & 255) */
+static uint64_t pm_last_submit, pm_asleep_at;
+static uint32_t pm_sleeps, pm_wakes, pm_wake_us, pm_wake_max_us, pm_sleep_failed, pm_hold_failed;
+static uint32_t pm_fence_waits, pm_fence_max_us, pm_fence_fails;
+static uint32_t pm_samples, pm_collapsed, pm_gmu_off;  /* watch samples since the last WATCH line */
+
+static bool
+pm_gx_on(void)
+{
+	return (rd(gpucc + GPUCC_GX_GDSCR) & GDSC_PWR_ON) != 0;
+}
+
+static uint32_t
+pm_us_since(uint64_t t0)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	return (uint32_t)MIN(ns / 1000, 0xffffffffull);
+}
+
+static const char *
+pm_name(void)
+{
+	return pm_mode == PM_IFPC ? "ifpc" : pm_mode == PM_SLUMBER ? (pm_asleep ? "slumber (asleep)" : "slumber") : "off";
+}
+
+/* GX may be read by the CPU until gx_release(). PM_IFPC: OOB PERFCNTR; the other modes hold GX already. */
+static bool
+gx_hold(void)
+{
+	if (pm_mode != PM_IFPC) {
+		return !(pm_mode == PM_SLUMBER && pm_asleep);
+	}
+	wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << GMU_OOB_PERF_SET);
+	bool acked = wait_for(gmu + GMU_REG(GMU_GMU2HOST_INTR_INFO), 1u << GMU_OOB_PERF_ACK, 1u << GMU_OOB_PERF_ACK, 20);
+	wr(gmu + GMU_REG(GMU_GMU2HOST_INTR_CLR), 1u << GMU_OOB_PERF_ACK);
+	if (acked && pm_gx_on()) {
+		return true;
+	}
+	wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << GMU_OOB_PERF_CLEAR);
+	if (pm_hold_failed++ < 4) {
+		printf("NEGRONI GPU PM: OOB PERFCNTR %s, GX GDSC %#x: no GX register read\n", acked ? "acked" : "NOT ACKED",
+		    rd(gpucc + GPUCC_GX_GDSCR));
+	}
+	return false;
+}
+
+static void
+gx_release(void)
+{
+	if (pm_mode == PM_IFPC) {
+		wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << GMU_OOB_PERF_CLEAR);
+	}
+}
+
+/* OOB GPU_SET (step 18's request): true when acked and GX reads powered */
+static bool
+pm_gpu_set(void)
+{
+	wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << OOB_GPU_SET_REQUEST);
+	bool acked = wait_for(gmu + GMU_REG(GMU_GMU2HOST_INTR_INFO), 1u << OOB_GPU_SET_ACK, 1u << OOB_GPU_SET_ACK, 100);
+	wr(gmu + GMU_REG(GMU_GMU2HOST_INTR_CLR), 1u << OOB_GPU_SET_ACK);
+	return acked && pm_gx_on();
+}
+
+static void
+pm_gpu_clear(void)
+{
+	wr(gmu + GMU_REG(GMU_HOST2GMU_INTR_SET), 1u << OOB_GPU_SET_ACK);       /* gen7_gmu_oob_clear: BIT(31 - 2 * 0) */
+}
+
+/* PM_IFPC: where the CP has read the ring to at least, from the newest fence it wrote (no GX read) */
+static uint32_t
+pm_rptr_estimate(void)
+{
+	uint32_t done = negroni_gpu_completed();
+
+	if (gpu_fence - done >= 256) {
+		return (ring_at + 1) % RING_WORDS;      /* not known: no room */
+	}
+	return fence_pos[done & 255];
+}
+
+/* CP_RB_RPTR where it can be read; a collapsed or sleeping GX has read the ring to its end */
+static uint32_t
+pm_rptr_now(bool held)
+{
+	if (pm_mode == PM_OFF || (pm_mode == PM_SLUMBER && !pm_asleep) || (pm_mode == PM_IFPC && held)) {
+		return rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR));
+	}
+	return pm_gx_on() ? ~0u : ring_at;
+}
+
+/* CP_RB_WPTR; PM_IFPC: KGSL gen7_fenced_write, then OOB GPU_SET as the last try. false: not written. */
+static bool
+pm_wptr(uint32_t value)
+{
+	vm_offset_t reg = gpu_regs + GPU_WORD(REG_CP_RB_WPTR);
+	uint32_t i;
+
+	if (pm_mode != PM_IFPC) {
+		wr(reg, value);
+		return true;
+	}
+	uint64_t t0 = mach_absolute_time();
+	wr(reg, value);
+	for (i = 0; i < PM_FENCE_RETRIES; i++) {
+		__asm__ volatile ("dsb sy");
+		if (!(rd(gmu + GMU_REG(GMU_AHB_FENCE_STATUS)) & 1)) {
+			break;
+		}
+		delay(10);
+		wr(reg, value);
+	}
+	if (i > 0 && i < PM_FENCE_RETRIES) {
+		uint32_t us = pm_us_since(t0);
+		pm_fence_waits++;
+		pm_fence_max_us = MAX(pm_fence_max_us, us);
+		if (pm_fence_waits <= 8) {
+			printf("NEGRONI GPU PM: WPTR write dropped %u times (GX collapsed), taken after %u us\n", i, us);
+		}
+	}
+	if (i < PM_FENCE_RETRIES) {
+		return true;
+	}
+	pm_fence_fails++;
+	bool set = pm_gpu_set();
+	wr(reg, value);
+	__asm__ volatile ("dsb sy");
+	bool ok = set && !(rd(gmu + GMU_REG(GMU_AHB_FENCE_STATUS)) & 1);
+	pm_gpu_clear();
+	printf("NEGRONI GPU PM: WPTR write still dropped after %u us (%u tries): OOB GPU_SET %s, write %s, GX GDSC %#x, power state %#x\n",
+	    pm_us_since(t0), PM_FENCE_RETRIES, set ? "acked" : "NOT ACKED", ok ? "taken" : "LOST",
+	    rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)));
+	return ok;
+}
+
+/* PM_SLUMBER, the lock held, awake (GX held by OOB GPU_SET). false: not idle, or the GMU said no. */
+static bool
+pm_sleep(void)
+{
+	uint64_t t0 = mach_absolute_time();
+	uint32_t rptr = rd(gpu_regs + GPU_WORD(REG_CP_RB_RPTR)), status = rd(gpu_regs + GPU_WORD(REG_RBBM_STATUS));
+
+	if (negroni_gpu_completed() != gpu_fence || rptr != ring_at || (status & ~1u)) {
+		return false;
+	}
+	pm_gpu_clear();
+	uint32_t slumber[3] = { 0, 0 /* bw */, 0 /* freq */ };      /* hfi_prep_slumber_cmd, as gpu_stop sends it */
+	hfi_quiet = true;
+	bool ok = hfi_send("PREPARE_SLUMBER", 33, slumber, sizeof(slumber));
+	hfi_quiet = false;
+	wr(gmu + GMU_REG(GMU_AO_AHB_FENCE_CTRL), 0);                    /* gen7_gmu_notify_slumber: fence to allow */
+	if (!ok) {
+		bool back = pm_gpu_set();
+		pm_sleep_failed++;
+		printf("NEGRONI GPU PM: PREPARE_SLUMBER not acked (%u); GX %s\n", pm_sleep_failed, back ? "held again" : "NOT BACK");
+		if (pm_sleep_failed >= 3 || !back) {
+			pm_mode = PM_OFF;
+			printf("NEGRONI GPU PM: slumber off for this boot\n");
+		}
+		return false;
+	}
+	bool idle = wait_for(gmu + GMU_REG(GMU_CX_BUSY_STATUS), 1u << 30, 0, 100);
+	bool gx_off = wait_for(gpucc + GPUCC_GX_GDSCR, GDSC_PWR_ON, 0, 100);
+	wr(gmu + GMU_REG(GMU_INTR_MASK), ~0u);
+	wr(gmu + GMU_REG(GMU_CM3_SYSRESET), 1);
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 1);
+	bool rsc = wait_for(rscc + RSCC_STATUS0, 1u << 16, 1u << 16, 100);
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 0);
+	pm_asleep = true;
+	pm_asleep_at = mach_absolute_time();
+	gx_on = false;
+	pm_sleeps++;
+	if (pm_sleeps <= 8 || pm_sleeps % 100 == 0) {
+		printf("NEGRONI GPU PM: slumber %u in %u us: GMU %s, GX %s (GDSC %#x), RSC %s (%#x)\n", pm_sleeps, pm_us_since(t0),
+		    idle ? "idle" : "STILL BUSY", gx_off ? "off" : "STILL ON", rd(gpucc + GPUCC_GX_GDSCR), rsc ? "asleep" : "DID NOT SLEEP",
+		    rd(rscc + RSCC_STATUS0));
+	}
+	return true;
+}
+
+/* PM_SLUMBER, the lock held, asleep: KGSL's warm boot. false: the GPU stays off for this boot (pm_dead). */
+static bool
+pm_wake(void)
+{
+	uint64_t t0 = mach_absolute_time();
+	uint32_t pause = pause_ms, asleep_ms = pm_us_since(pm_asleep_at) / 1000;
+	bool loud = pm_wakes == 0;
+
+	if (loud) {
+		printf("NEGRONI GPU PM: first wake: steps 14-21 again with their lines (later wakes are quiet)\n");
+	} else {
+		adreno_quiet_thread = current_thread();
+	}
+	pause_ms = 0;
+	pm_rewaking = true;
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 1u << 1);
+	bool rsc = wait_for(gmu + GMU_REG(GMU_RSCC_CONTROL_ACK), 1u << 1, 1u << 1, 100) &&
+	    wait_for(rscc + RSCC_SEQ_BUSY_DRV0, ~0u, 0, 100);
+	wr(gmu + GMU_REG(GMU_RSCC_CONTROL_REQ), 0);
+	bool ok = rsc && step_gmu_firmware() && step_gmu_start() && step_hfi_start() && step_hfi_messages() &&
+	    step_core_power();
+	if (ok) {
+		ring_at = ring_sent = 0;        /* the CP starts at the ring's base again */
+		ok = step_core_start();
+	}
+	if (ok) {
+		ring_command(CP_SET_SECURE_MODE, 1);
+		ring(0);
+		ok = ring_run("leave secure mode (wake)");
+	}
+	pm_rewaking = false;
+	pause_ms = pause;
+	adreno_quiet_thread = NULL;
+	uint32_t us = pm_us_since(t0);
+	if (!ok) {
+		pm_dead = true;
+		printf("NEGRONI GPU PM: WAKE FAILED after %u us (RSC %s, GX GDSC %#x, FW_INIT_RESULT %#x): the GPU stays off\n", us,
+		    rsc ? "awake" : "NOT AWAKE", rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_CM3_FW_INIT_RESULT)));
+		return false;
+	}
+	pm_asleep = false;
+	pm_wakes++;
+	pm_wake_us = us;
+	pm_wake_max_us = MAX(pm_wake_max_us, us);
+	pm_revote = true;
+	gpu_invalidate_next = true;
+	if (pm_wakes <= 8 || pm_wakes % 100 == 0) {
+		printf("NEGRONI GPU PM: wake %u in %u us (asleep %u ms), GX GDSC %#x\n", pm_wakes, us, asleep_ms,
+		    rd(gpucc + GPUCC_GX_GDSCR));
+	}
+	return true;
+}
+
+/* After step 22 (gpu_keep): the mode, before the watch and the service start */
+static void
+pm_start(void)
+{
+	(void)PE_parse_boot_argn("negronigpu_slumber", &pm_slumber_arg, sizeof(pm_slumber_arg));
+	for (unsigned i = 0; i < 256; i++) {
+		fence_pos[i] = ring_at;
+	}
+	pm_last_submit = mach_absolute_time();
+	if (pm_ifpc_ok) {
+		lck_mtx_lock(&gpu_pm_lock);
+		pm_mode = PM_IFPC;
+		pm_gpu_clear();         /* KGSL gen7_gpu_boot: oob_clear(oob_gpu) once the GPU runs */
+		lck_mtx_unlock(&gpu_pm_lock);
+		printf("NEGRONI GPU PM: IFPC on: OOB GPU_SET released, the GMU collapses GX 300 us after the work; WPTR "
+		    "writes fenced; GX GDSC %#x, power state %#x\n", rd(gpucc + GPUCC_GX_GDSCR), rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)));
+	} else if (pm_slumber_arg) {
+		pm_mode = PM_SLUMBER;
+		printf("NEGRONI GPU PM: IFPC %s: slumber after %u ms idle, warm GMU restart on the next submission\n",
+		    pm_ifpc_arg ? "refused by the GMU" : "off (negronigpu_ifpc=0)", PM_SLUMBER_MS);
+	} else {
+		printf("NEGRONI GPU PM: off (IFPC %s, negronigpu_slumber=0): GX stays powered\n",
+		    pm_ifpc_arg ? "refused" : "off");
+	}
+}
+
+/* One watch tick, the lock held: the collapse sample, the slumber decision, the never-collapses check */
+static void
+pm_tick(uint32_t idle_for_ms, bool gx, bool late_done)
+{
+	if (pm_mode == PM_OFF) {
+		return;
+	}
+	pm_samples++;
+	pm_collapsed += !gx;
+	pm_gmu_off += (rd(gmu + GMU_REG(GMU_GFX_PWR_CLK_STATUS)) & 1) != 0;
+	if (pm_mode == PM_IFPC) {
+		if (!gx) {
+			pm_seen_collapse = true;
+		} else if (!pm_seen_collapse && idle_for_ms >= PM_NEVER_COLLAPSED_MS) {
+			pm_seen_collapse = true;
+			bool held = pm_slumber_arg && pm_gpu_set();
+			printf("NEGRONI GPU PM: IFPC acked, but GX never collapsed in %u ms of idle (power state %#x): %s\n",
+			    idle_for_ms, rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)),
+			    !pm_slumber_arg ? "kept (negronigpu_slumber=0)" : held ? "OOB GPU_SET again, slumber instead" : "OOB GPU_SET NOT ACKED, IFPC kept");
+			if (held) {
+				pm_mode = PM_SLUMBER;
+			}
+		}
+		return;
+	}
+	if (!pm_asleep && late_done && idle_for_ms >= PM_SLUMBER_MS) {
+		(void)pm_sleep();
+	}
+}
+
+/* The WATCH line's power part; starts the next sample window */
+static void
+pm_line(char *buf, size_t size)
+{
+	uint32_t pct = pm_samples ? pm_collapsed * 100 / pm_samples : 0, gpct = pm_samples ? pm_gmu_off * 100 / pm_samples : 0;
+
+	if (pm_mode == PM_IFPC) {
+		snprintf(buf, size, "pm ifpc GX collapsed %u%% gmu %u%% pwr %#x fenced %u max %uus fail %u", pct, gpct,
+		    rd(gmu + GMU_REG(GMU_RPMH_POWER_STATE)), pm_fence_waits, pm_fence_max_us, pm_fence_fails);
+	} else if (pm_mode == PM_SLUMBER) {
+		snprintf(buf, size, "pm %s GX collapsed %u%% sleeps %u wakes %u last %uus max %uus", pm_name(), pct, pm_sleeps,
+		    pm_wakes, pm_wake_us, pm_wake_max_us);
+	} else {
+		snprintf(buf, size, "pm off");
+	}
+	pm_samples = pm_collapsed = pm_gmu_off = 0;
+}
