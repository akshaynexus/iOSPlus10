+/*
+ * 0342: PCIE_SOC_GLOBAL_RESET clears the window register in the chip (ath11k pci.c ath11k_pci_soc_global_reset
+ * "Restore window register as its content is cleared during hardware global reset"). Forget the cached value, so
+ * the next windowed access writes the select again.
+ */
+void
+negroni_wlan_window_forget(void)
+{
+	g_window = ~0u;
+}
