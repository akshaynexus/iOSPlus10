+static void
+tlmm_cfg(uint32_t pin, uint32_t cfg)
+{
+	/* an eGPIO pin (bit 11 present) belongs to the TLMM only with bit 12 set (Linux msm_pinmux_set_mux) */
+	if (rd(tlmm + TLMM_PIN(pin)) & TLMM_EGPIO_PRESENT) {
+		cfg |= TLMM_EGPIO_ENABLE;
+	}
+	wr(tlmm + TLMM_PIN(pin), cfg);
+}
+
 static void
 gpio_out(uint32_t pin, bool high)
 {
 	wr(tlmm + TLMM_PIN(pin) + 4, high ? 2u : 0);
-	wr(tlmm + TLMM_PIN(pin), 7u << 6 | 1u << 9);           /* gpio function, 16 mA, no pull, output */
+	tlmm_cfg(pin, 7u << 6 | 1u << 9);                      /* gpio function, 16 mA, no pull, output */
+}
+
+static uint32_t
+gpio_level(uint32_t pin, bool output)
+{
+	uint32_t io = rd(tlmm + TLMM_PIN(pin) + 4);
+	return output ? (io >> 1) & 1 : io & 1;
 }
 
