diff --git a/bsd/dev/negroni_adreno.c b/bsd/dev/negroni_adreno.c
index 13be243..e69b803 100644
--- a/bsd/dev/negroni_adreno.c
+++ b/bsd/dev/negroni_adreno.c
@@ -65,6 +65,14 @@
 #include <kern/sched_prim.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/*
+ * 0290 (iOSPlus10): io_submap is 8 MiB for the whole kernel (osfmk/arm/io_map.c IO_MAP_SIZE,
+ * permanent entries, KMA_NOFAIL: a request that does not fit panics). The GCC (2 MiB) map uses
+ * ml_io_map_unmappable (kernel_map VA) with VM_WIMG_IO (osfmk/arm/memory_types.h, 0x7): the same
+ * Device memory type as ml_io_map, without the io_submap space. Table: docs/notes.md "io_submap".
+ */
+extern vm_offset_t ml_io_map_unmappable(vm_offset_t phys_addr, vm_size_t size, uint32_t flags);
+#define ADRENO_WIMG_IO 0x7u
 extern const void *negroni_fw_get(const char *name, uint32_t *size);
 extern uint64_t kvtophys(vm_offset_t va);
 extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size);     /* osfmk/arm/pmap/pmap.h (pmap_paddr_t) */
@@ -2774,7 +2782,7 @@ negroni_adreno_init(void)
 	}
 	last = MIN(last, (uint32_t)(sizeof(steps) / sizeof(steps[0])));
 	printf("NEGRONI ADRENO: steps 1..%u\n", last);
-	gcc = ml_io_map(GCC_PHYS, GCC_SIZE);
+	gcc = ml_io_map_unmappable(GCC_PHYS, GCC_SIZE, ADRENO_WIMG_IO);
 	gpucc = ml_io_map(GPUCC_PHYS, GPUCC_SIZE);
 	gmu = ml_io_map(GMU_PHYS, GMU_SIZE);
 	rscc = ml_io_map(RSCC_PHYS, RSCC_SIZE);
