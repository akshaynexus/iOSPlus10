 		memcpy((uint32_t *)s->save + (uint64_t)y * half, row, (size_t)half * 4);
@@ -1381,7 +1458,7 @@ AppleCLCD::zeroCopyShiftClock(NegroniSurface *s, uintptr_t k, bool gpu)
 			row[x] = edge;
