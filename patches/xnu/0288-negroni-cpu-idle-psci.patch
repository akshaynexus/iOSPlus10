+#if defined(NEGRONI)
+/*
+ * Patch 0288: one SPI for the CPU-idle wake timer (osfmk/arm64/negroni_cpuidle.c): Group 1 NS,
+ * priority 0xA0 as the PPIs above, level-sensitive, routed to one PE by affinity (GICD_IROUTER,
+ * Interrupt_Routing_Mode 0), enabled. Offsets: GICv3 architecture (GICD_IGROUPR 0x80,
+ * GICD_ISENABLER 0x100, GICD_IPRIORITYR 0x400, GICD_ICFGR 0xC00, GICD_IROUTER 0x6000).
+ */
+void negroni_gic_spi_route(uint32_t intid, uint64_t mpidr);
+void negroni_gic_spi_enable(uint32_t intid, uint64_t mpidr);
+
+void
+negroni_gic_spi_route(uint32_t intid, uint64_t mpidr)
+{
+	uint64_t aff = (mpidr & 0xffffffull) | ((mpidr >> 32) & 0xff) << 32;
+
+	*(volatile uint64_t *)(gicd_base + 0x6000 + 8 * (vm_offset_t)intid) = aff;
+	__builtin_arm_dsb(DSB_SY);
+}
+
+void
+negroni_gic_spi_enable(uint32_t intid, uint64_t mpidr)
+{
+	uint32_t word = intid / 32, bit = 1u << (intid % 32);
+
+	gicd_write32(0x80 + 4 * word, gicd_read32(0x80 + 4 * word) | bit);
+	*(volatile uint8_t *)(gicd_base + 0x400 + intid) = 0xA0;
+	gicd_write32(0xC00 + 4 * (intid / 16), gicd_read32(0xC00 + 4 * (intid / 16)) & ~(2u << (2 * (intid % 16))));
+	negroni_gic_spi_route(intid, mpidr);
+	gicd_write32(0x100 + 4 * word, bit);
+	while (gicd_read32(GICD_CTLR) & GICD_CTLR_RWP) {
+		;
+	}
+}
+#endif /* NEGRONI */
