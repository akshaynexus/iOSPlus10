+/*
+ * Key wrap / unwrap (selectors 10 / 11), from HackiOS MiniAppleKeyStore.cpp
+ * (also ios-flame 0123). securityd gives each keychain item (and each
+ * keychain metadata key) its own key and has AKS wrap it with the key of the
+ * item's protection class before it stores it; to read the item it asks for
+ * the unwrap. Seen: "securityd sel 10 arg0 0 in 2/32 out 1/40": handle and
+ * class, a 32-byte key in, the class and a 40-byte wrapped key out (8 bytes
+ * longer, like AES key wrap, RFC 3394).
+ *
+ * There is no SEP and no secret on this device. The "wrapped" key is a mark
+ * ("HKwr"), the class, 3 zero bytes and the key mixed with a fixed pattern:
+ * a reversible encoding, NOT encryption. Anybody who can read the keychain
+ * database (/private/var/Keychains) can recover every item. The format is
+ * the HackiOS/flame one, so the encoding is the same on all these ports.
+ */
+#define NEGRONI_AKS_WRAP_HDR   8
+#define NEGRONI_AKS_KEY_MAX    64
+static const uint8_t negroni_aks_wrap_mark[4] = { 'H', 'K', 'w', 'r' };
+
+static void
+negroni_aks_wrap_mix(uint8_t *bytes, uint32_t len)
+{
+	for (uint32_t i = 0; i < len; i++) {
+		bytes[i] ^= (uint8_t)(0x5a + 37 * i);
+	}
+}
+
+static IOReturn
+negroni_aks_wrap(IOExternalMethodArguments *args)
+{
+	uint8_t wrapped[NEGRONI_AKS_WRAP_HDR + NEGRONI_AKS_KEY_MAX];
+	uint32_t len = args->structureInputSize;
+
+	/* Keys are small: always inband (out of line starts above 4096 bytes). */
+	if (args->structureInputDescriptor != NULL || args->structureInput == NULL ||
+	    len == 0 || len > NEGRONI_AKS_KEY_MAX || args->scalarInputCount < 2) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(wrapped, negroni_aks_wrap_mark, sizeof(negroni_aks_wrap_mark));
+	wrapped[4] = (uint8_t)args->scalarInput[1];
+	wrapped[5] = wrapped[6] = wrapped[7] = 0;
+	memcpy(wrapped + NEGRONI_AKS_WRAP_HDR, args->structureInput, len);
+	negroni_aks_wrap_mix(wrapped + NEGRONI_AKS_WRAP_HDR, len);
+	IOReturn ret = negroni_aks_struct_out(args, wrapped, NEGRONI_AKS_WRAP_HDR + len);
+	if (ret == kIOReturnSuccess && args->scalarOutputCount >= 1) {
+		args->scalarOutput[0] = args->scalarInput[1];
+		args->scalarOutputCount = 1;
+	} else {
+		args->scalarOutputCount = 0;
+	}
+	return ret;
+}
+
+static IOReturn
+negroni_aks_unwrap(IOExternalMethodArguments *args)
+{
+	uint8_t key[NEGRONI_AKS_KEY_MAX];
+	const uint8_t *wrapped = (const uint8_t *)args->structureInput;
+	uint32_t len = args->structureInputSize;
+
+	if (args->structureInputDescriptor != NULL || wrapped == NULL ||
+	    len <= NEGRONI_AKS_WRAP_HDR || len > NEGRONI_AKS_WRAP_HDR + sizeof(key) ||
+	    memcmp(wrapped, negroni_aks_wrap_mark, sizeof(negroni_aks_wrap_mark)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	len -= NEGRONI_AKS_WRAP_HDR;
+	memcpy(key, wrapped + NEGRONI_AKS_WRAP_HDR, len);
+	negroni_aks_wrap_mix(key, len);
+	args->scalarOutputCount = 0;
+	IOReturn ret = negroni_aks_struct_out(args, key, len);
+	bzero(key, sizeof(key));
+	return ret;
+}
