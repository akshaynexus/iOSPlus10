+/* Device configuration (selector 31, HackiOS): backoff delay, grace period, max unlock attempts. */
+static IOReturn
+negroni_aks_configuration(IOExternalMethodArguments *args)
+{
+	uint8_t buf[64];
+	uint32_t n = 2;
+	n += negroni_aks_der_pair(buf + n, "bd", 0);
+	n += negroni_aks_der_pair(buf + n, "gp", 0);
+	n += negroni_aks_der_pair(buf + n, "mua", 10);
+	buf[0] = 0x31;
+	buf[1] = (uint8_t)(n - 2);
+	return negroni_aks_struct_out(args, buf, n);
+}
