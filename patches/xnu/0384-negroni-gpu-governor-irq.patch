+/*
+ * ---- patch 0384: the fence interrupt ----
+ * KGSL (out/src/op-kernel/drivers/gpu/msm): the ring's last CP_EVENT_WRITE is CACHE_CLEAN | BIT(31) (IRQ) | BIT(27)
+ * (adreno_gen7_ringbuffer.c:372-379); RBBM_INT_0_MASK (0x38) holds GEN7_INT_MASK with RB_DONE_TS 17 and
+ * CACHE_CLEAN_TS 20 (adreno_gen7.h:193-206, gen7_reg.h:24-25, 607-608), written once per GPU boot
+ * (adreno_gen7_gmu.c:2578; not in the IFPC lists); gen7_irq_handler (adreno_gen7.c:1194-1222): GMU
+ * PWR_COL_KEEPALIVE (0x1f8c3) = 1, AHB fence must read ALLOW (gen7_irq_poll_fence: 100 x 1 us), RBBM_INT_0_STATUS
+ * read, RBBM_INT_CLEAR_CMD (0x37) = status, keepalive 0; bit 20 -> gen7_cp_callback (retire). The line is
+ * kgsl_3d0_irq, GIC SPI 0x12c level (out/live.dts:21063). Here the handler wakes every fence waiter
+ * (negroni_gpu_fence_sleep); the waiters keep a timed look (negronigpu_irq_poll_us) as the polled fallback.
+ * Armed only while GX is reachable: disarmed (and masked at the GIC) before a slumber, a recovery reset and a
+ * warm boot; armed again with GX held at their end. A storm (> GPU_IRQ_STORM a second) turns it off for the boot.
+ */
+#define REG_RBBM_INT_CLEAR_CMD  0x0037
+#define REG_RBBM_INT_0_MASK     0x0038
+#define GPU_INT_RB_DONE_TS      (1u << 17)
+#define GPU_INT_CACHE_CLEAN_TS  (1u << 20)
+#define GMU_PWR_COL_KEEPALIVE   0x1f8c3
+#define EVENT_WRITE_IRQ         (1u << 31)
+#define GPU_IRQ_STORM           20000
+
+extern int negroni_spi_register(uint32_t intid, bool edge, void (*fn)(void *, uint32_t), void *arg);
+extern void negroni_spi_enable(uint32_t intid, bool on);
+
+static bool gpu_irq_registered, gpu_irq_off;
+static bool gpu_irq_armed, gpu_irq_live, gpu_irq_masked;       /* atomics */
+static uint32_t gpu_irq_busy;                                   /* atomic: handlers running now */
+static uint32_t gpu_irq_count, gpu_irq_fences, gpu_irq_other, gpu_irq_unarmed, gpu_irq_gx_off, gpu_irq_fence_held;
+static uint32_t gpu_irq_status_or, gpu_irq_woken, gpu_irq_missed, gpu_irq_polled;
+static uint32_t gpu_fence_event;                                /* the waiters sleep on its address */
+
+/* GIC SPI handler, interrupt context, one CPU (the SPI is routed to the CPU that registered it) */
+static void
+gpu_irq(void *arg __unused, uint32_t intid)
+{
+	__atomic_fetch_add(&gpu_irq_busy, 1, __ATOMIC_SEQ_CST);
+	__atomic_fetch_add(&gpu_irq_count, 1, __ATOMIC_RELAXED);
+	if (!__atomic_load_n(&gpu_irq_armed, __ATOMIC_SEQ_CST)) {
+		/* a level line we must not clear now (GX in a transition): masked until the watch arms it again */
+		negroni_spi_enable(intid, false);
+		__atomic_store_n(&gpu_irq_masked, true, __ATOMIC_SEQ_CST);
+		gpu_irq_unarmed++;
+	} else {
+		wr(gmu + GMU_REG(GMU_PWR_COL_KEEPALIVE), 1);
+		__asm__ volatile ("dsb sy");
+		uint32_t i;
+		for (i = 0; i < 100 && rd(gmu + GMU_REG(GMU_AO_AHB_FENCE_CTRL)) != 0; i++) {
+			delay(1);
+		}
+		if (i == 100) {
+			/* gen7_irq_poll_fence: the status and clear registers are not reachable; the watch unmasks */
+			negroni_spi_enable(intid, false);
+			__atomic_store_n(&gpu_irq_masked, true, __ATOMIC_SEQ_CST);
+			gpu_irq_fence_held++;
+		} else if (!(rd(gpucc + GPUCC_GX_GDSCR) & GDSC_PWR_ON)) {
+			/* GX already collapsed: no RBBM register to read (the level went with GX) */
+			negroni_spi_enable(intid, false);
+			__atomic_store_n(&gpu_irq_masked, true, __ATOMIC_SEQ_CST);
+			gpu_irq_gx_off++;
+		} else {
+			uint32_t status = rd(gpu_regs + GPU_WORD(REG_RBBM_INT_0_STATUS));
+			wr(gpu_regs + GPU_WORD(REG_RBBM_INT_CLEAR_CMD), status);
+			__asm__ volatile ("dsb sy");
+			gpu_irq_status_or |= status;
+			if (status & (GPU_INT_CACHE_CLEAN_TS | GPU_INT_RB_DONE_TS)) {
+				gpu_irq_fences++;
+				__atomic_store_n(&gpu_irq_live, true, __ATOMIC_RELAXED);
+			} else {
+				gpu_irq_other++;
+			}
+		}
+		wr(gmu + GMU_REG(GMU_PWR_COL_KEEPALIVE), 0);
+	}
+	__atomic_fetch_sub(&gpu_irq_busy, 1, __ATOMIC_SEQ_CST);
+	thread_wakeup((event_t)&gpu_fence_event);
+}
+
+/* Before GX goes away (slumber, recovery reset, warm boot): no handler reads GX after this returns. */
+static void
+gpu_irq_disarm(void)
+{
+	if (!gpu_irq_registered) {
+		return;
+	}
+	__atomic_store_n(&gpu_irq_armed, false, __ATOMIC_SEQ_CST);
+	negroni_spi_enable(k_irq_intid, false);
+	__atomic_store_n(&gpu_irq_masked, true, __ATOMIC_SEQ_CST);
+	while (__atomic_load_n(&gpu_irq_busy, __ATOMIC_SEQ_CST) != 0) {
+		;
+	}
+}
+
+/* GX held (OOB GPU_SET or PM off): KGSL adreno_irqctrl(1) after each GPU boot, then the line on. */
+static void
+gpu_irq_arm(void)
+{
+	if (!gpu_irq_registered || gpu_irq_off) {
+		return;
+	}
+	wr(gpu_regs + GPU_WORD(REG_RBBM_INT_CLEAR_CMD), ~0u);
+	wr(gpu_regs + GPU_WORD(REG_RBBM_INT_0_MASK), GPU_INT_CACHE_CLEAN_TS | GPU_INT_RB_DONE_TS);
+	__asm__ volatile ("dsb sy");
+	__atomic_store_n(&gpu_irq_armed, true, __ATOMIC_SEQ_CST);
+	__atomic_store_n(&gpu_irq_masked, false, __ATOMIC_SEQ_CST);
+	negroni_spi_enable(k_irq_intid, true);
+	thread_wakeup((event_t)&gpu_fence_event);       /* waiters of fences the reset or the wake made done */
+}
+
+/* pm_start, GX held: register the SPI (thread context) and arm it */
+static void
+gpu_irq_start(void)
+{
+	if (!k_irq) {
+		printf("NEGRONI GPU IRQ: off (negronigpu_irq=0): fence waiters poll every 200 us\n");
+		return;
+	}
+	if (negroni_spi_register(k_irq_intid, false, gpu_irq, NULL) != 0) {
+		printf("NEGRONI GPU IRQ: INTID %u not registered (no GIC distributor or no free slot): fence waiters poll\n", k_irq_intid);
+		return;
+	}
+	gpu_irq_registered = true;
+	gpu_irq_arm();
+	printf("NEGRONI GPU IRQ: on: INTID %u (SPI %u, level), RBBM_INT_0_MASK %#x (CACHE_CLEAN_TS, RB_DONE_TS), the last fence "
+	    "of each submission raises it; waiters look again every %u us as the fallback\n", k_irq_intid, k_irq_intid - 32,
+	    GPU_INT_CACHE_CLEAN_TS | GPU_INT_RB_DONE_TS, k_irq_poll_us);
+}
+
+/*
+ * RedwoodGPU's wait between two looks at a fence (it holds no lock here): until the fence interrupt or the poll
+ * time. poll_us: the caller's polled interval (200 us); with the interrupt live, negronigpu_irq_poll_us.
+ */
+void negroni_gpu_fence_sleep(uint32_t fence, uint32_t poll_us);
+void
+negroni_gpu_fence_sleep(uint32_t fence, uint32_t poll_us)
+{
+	bool irq = __atomic_load_n(&gpu_irq_live, __ATOMIC_RELAXED) && __atomic_load_n(&gpu_irq_armed, __ATOMIC_RELAXED) &&
+	    !__atomic_load_n(&gpu_irq_masked, __ATOMIC_RELAXED);
+	uint32_t us = irq ? MAX(poll_us, k_irq_poll_us) : poll_us;
+
+	wait_result_t w = assert_wait_timeout((event_t)&gpu_fence_event, THREAD_UNINT, us, NSEC_PER_USEC);
+	if (w != THREAD_WAITING) {
+		return;
+	}
+	if (negroni_gpu_done(fence)) {
+		clear_wait(current_thread(), THREAD_AWAKENED);
+		return;
+	}
+	w = thread_block(THREAD_CONTINUE_NULL);
+	if (!irq) {
+		__atomic_fetch_add(&gpu_irq_polled, 1, __ATOMIC_RELAXED);
+	} else if (w == THREAD_AWAKENED) {
+		__atomic_fetch_add(&gpu_irq_woken, 1, __ATOMIC_RELAXED);
+	} else if (negroni_gpu_done(fence)) {
+		__atomic_fetch_add(&gpu_irq_missed, 1, __ATOMIC_RELAXED);      /* done, but no interrupt woke us */
+	}
+}
+
+/*
+ * The watch, once a second: unmask a line the handler masked (GX was off or the fence held), the storm guard, and
+ * the WATCH line's irq part. A second with many misses and no fence interrupt drops "live": the waiters poll at
+ * 200 us again until the next fence interrupt.
+ */
+static uint32_t gpu_irq_sec_count, gpu_irq_sec_fences, gpu_irq_sec_woken, gpu_irq_sec_missed;
+static void
+gpu_irq_second(char *buf, size_t size)
+{
+	uint32_t c = gpu_irq_count, f = gpu_irq_fences, wk = gpu_irq_woken, ms = gpu_irq_missed;
+	uint32_t dc = c - gpu_irq_sec_count, df = f - gpu_irq_sec_fences, dw = wk - gpu_irq_sec_woken, dm = ms - gpu_irq_sec_missed;
+
+	gpu_irq_sec_count = c;
+	gpu_irq_sec_fences = f;
+	gpu_irq_sec_woken = wk;
+	gpu_irq_sec_missed = ms;
+	if (!gpu_irq_registered) {
+		snprintf(buf, size, "irq off (polled %u)", gpu_irq_polled);
+		return;
+	}
+	if (!gpu_irq_off && dc > GPU_IRQ_STORM) {
+		gpu_irq_off = true;
+		gpu_irq_disarm();
+		__atomic_store_n(&gpu_irq_live, false, __ATOMIC_RELAXED);
+		printf("NEGRONI GPU IRQ: %u interrupts in a second (status bits %#x): off for this boot, fence waiters poll\n", dc,
+		    gpu_irq_status_or);
+	}
+	if (!gpu_irq_off && df == 0 && dm > 50) {
+		__atomic_store_n(&gpu_irq_live, false, __ATOMIC_RELAXED);
+	}
+	/*
+	 * gpu_pm_lock held: a slumber attempt that stopped early (lowest idle not reached, PREPARE_SLUMBER refused, GX not
+	 * back) can leave the line disarmed with the GPU awake. RBBM_INT_0_MASK lives on over IFPC (KGSL writes it once per
+	 * GPU boot), so arming needs no register write here.
+	 */
+	if (!gpu_irq_off && !__atomic_load_n(&gpu_irq_armed, __ATOMIC_SEQ_CST) && !pm_asleep && !pm_dead && !pm_rewaking &&
+	    !rec_active && gpu_kept) {
+		__atomic_store_n(&gpu_irq_armed, true, __ATOMIC_SEQ_CST);
+		__atomic_store_n(&gpu_irq_masked, true, __ATOMIC_SEQ_CST);     /* the next lines unmask it */
+	}
+	if (!gpu_irq_off && __atomic_load_n(&gpu_irq_armed, __ATOMIC_SEQ_CST) && __atomic_load_n(&gpu_irq_masked, __ATOMIC_SEQ_CST)) {
+		__atomic_store_n(&gpu_irq_masked, false, __ATOMIC_SEQ_CST);
+		negroni_spi_enable(k_irq_intid, true);
+	}
+	snprintf(buf, size, "irq %s %u/s fence %u/s woke %u missed %u | all %u fence %u gx-off %u held %u unarmed %u other %u bits %#x",
+	    gpu_irq_off ? "OFF" : __atomic_load_n(&gpu_irq_live, __ATOMIC_RELAXED) ? "live" : "armed", dc, df, dw, dm, c, f,
+	    gpu_irq_gx_off, gpu_irq_fence_held, gpu_irq_unarmed, gpu_irq_other, gpu_irq_status_or);
+}
