+/* 0283: the per-zone policy, every second. cpu/gpu/ddr in tenths of a degree (-10000 = none). True on a change. */
+static bool
+policy_0283(uint32_t tick, int cpu, int gpu, int ddr)
+{
+	bool changed = false;
+	int32_t skin = 0, xo = 0;
+	bool skinOk = negroni_pwr_temp_get(NEGRONI_PWR_T_SKIN, &skin, 60000);
+	bool xoOk = negroni_pwr_temp_get(NEGRONI_PWR_T_XO, &xo, 60000);
+
+	changed |= trip_set(T_CPU110, cpu != -10000, cpu, 1100, 1000);
+	changed |= trip_set(T_GPU95, gpu != -10000, gpu, 950, 900);
+	changed |= trip_set(T_IPA53, skinOk, skin, 5300, 5100);
+	changed |= trip_set(T_XO78, xoOk, xo, 7800, 7000);
+	changed |= trip_set(T_XO80, xoOk, xo, 8000, 7000);
+	changed |= trip_set(T_DDR90, ddr != -10000, ddr, 900, 850);
+	/* BCL levels: the status bits, kept BCL_HOLD_S after they clear */
+	uint8_t bcl = 0;
+	bool bclOk = negroni_spmi_read(3, BCL_STATUS_ADDR, &bcl) == 0;
+	for (unsigned k = 0; k < 3; k++) {
+		bool bit = bclOk && (bcl & (1u << k));
+		bool was = trip_on[T_BCL0 + k];
+		if (bit) {
+			trip_on[T_BCL0 + k] = true;
+			bcl_clear_tick[k] = 0;
+		} else if (was) {
+			if (bcl_clear_tick[k] == 0) {
+				bcl_clear_tick[k] = tick;
+			} else if (tick - bcl_clear_tick[k] >= BCL_HOLD_S) {
+				trip_on[T_BCL0 + k] = false;
+				bcl_clear_tick[k] = 0;
+			}
+		}
+		if (trip_on[T_BCL0 + k] != was) {
+			printf("NEGRONI THERMAL: trip %s %s (BCL status 0x4708 = %#x)\n", trip_name[T_BCL0 + k],
+			    trip_on[T_BCL0 + k] ? "ON" : "off", bcl);
+			changed = true;
+		}
+	}
+	/* gpu-95C: step_wise, one level a second */
+	if (trip_on[T_GPU95]) {
+		if (gpu95_level > GPU_LEVEL_FLOOR) {
+			gpu95_level--;
+		}
+	} else if (gpu < 900 && gpu95_level < GPU_LEVEL_TOP) {
+		gpu95_level++;
+	}
+	/* ipa-53C and ddr-90C: one CPU cap step per 10 s */
+	if (tick % 10 == 0) {
+		if (trip_on[T_IPA53]) {
+			ipa_step += ipa_step < CPU_STEP_DEEPEST;
+		} else if (ipa_step) {
+			ipa_step--;
+		}
+		if (trip_on[T_DDR90]) {
+			ddr_step += ddr_step < CPU_STEP_DEEPEST;
+		} else if (ddr_step) {
+			ddr_step--;
+		}
+	}
+	/* the caps: the deepest of all */
+	uint32_t g = gpu95_level;
+	unsigned c = ipa_step > ddr_step ? ipa_step : ddr_step;
+	if (trip_on[T_XO78] || trip_on[T_XO80]) {
+		g = MIN(g, GPU_LEVEL_XO);
+		c = CPU_STEP_DEEPEST;
+	}
+	if (trip_on[T_CPU110]) {
+		c = CPU_STEP_DEEPEST;
+	}
+	for (unsigned k = 0; k < 3; k++) {
+		if (trip_on[T_BCL0 + k]) {
+			g = MIN(g, gpu_level_bcl[k]);
+			c = MAX(c, cpu_step_bcl[k]);
+		}
+	}
+	if (g < GPU_LEVEL_FLOOR) {
+		g = GPU_LEVEL_FLOOR;
+	}
+	if (g != gpu_cap) {
+		gpu_cap = g;
+		changed = true;
+	}
+	if (c != cpu_step) {
+		cpu_step = c;
+		negroni_cpufreq_cap(cpu_steps_mhz[cpu_step]);
+		changed = true;
+	}
+	/* the charger FCC level (0277) [I design]: skin 45 C -> 1000 mA, ipa-53C or xo-78C -> 500 mA */
+	if (skinOk && skin >= 4500) {
+		chg_skin_on = true;
+	} else if (!skinOk || skin < 4300) {
+		chg_skin_on = false;
+	}
+	unsigned lvl = (trip_on[T_IPA53] || trip_on[T_XO78] || trip_on[T_XO80]) ? 4 : chg_skin_on ? 3 : 0;
+	if (lvl != chg_level) {
+		chg_level = lvl;
+		negroni_chg_glink_set_thermal_level(lvl);
+		changed = true;
+	}
+	return changed;
+}
