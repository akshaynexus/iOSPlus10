+/* 0283: one trip with hysteresis (tenths or hundredths, the caller's unit). True on a change. */
+static bool
+trip_set(unsigned i, bool known, int v, int on_at, int off_below)
+{
+	bool was = trip_on[i];
+	if (!known) {
+		trip_on[i] = false;
+	} else if (v >= on_at) {
+		trip_on[i] = true;
+	} else if (v < off_below) {
+		trip_on[i] = false;
+	}
+	if (trip_on[i] != was) {
+		printf("NEGRONI THERMAL: trip %s %s (value %d, on at %d, off below %d)\n", trip_name[i], trip_on[i] ? "ON" : "off", v,
+		    on_at, off_below);
+		return true;
+	}
+	return false;
+}
