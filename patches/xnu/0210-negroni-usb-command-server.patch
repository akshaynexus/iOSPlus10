diff --git a/bsd/dev/negroni_reboot.c b/bsd/dev/negroni_reboot.c
new file mode 100644
index 0000000..a7e0749
--- /dev/null
+++ b/bsd/dev/negroni_reboot.c
@@ -0,0 +1,244 @@
+/*
+ * NEGRONI: restart with a reboot reason (OnePlus 10 Pro 5G, SM8450).
+ *
+ * ABL reads the reboot reason from the PMK8350 SDAM: the Android DT's
+ * `qcom,reboot-reason` nvmem cell is SID 0, SDAM block 0x7100, byte 0x48,
+ * bits 7:1 (value << 1, bit 0 is kept). Values: 1 = recovery,
+ * 2 = bootloader (fastboot), 0 = normal. The reason is written with one
+ * read-modify-write of register 0x7148, then a PSCI SYSTEM_RESET follows.
+ * (The IMEM restart_reason at 0x146aa65c does not select a mode here.)
+ *
+ * The PMIC is reached through the SPMI PMIC arbiter, version 7 (Linux
+ * drivers/spmi/spmi-pmic-arb.c, sm8450.dtsi spmi@c400000, qcom,ee = <0>):
+ *   core   0x0c400000  version at +0, APID count at +4 bits 10:0,
+ *                      APID map at +0x2000 + 4*apid (bits 19:8 = PPID)
+ *   chnls  0x0c500000  read/write channel of an APID at 0x1000*apid
+ *   obsrvr 0x0c440000  observer (read) channel at 0x8000*ee + 0x20*apid
+ *   cnfg   0x0c42d000  owner table, 4*apid, bits 2:0 = EE that may write
+ * Channel registers: CMD +0x00, STATUS +0x08 (bit 0 done, bits 3:1
+ * failed/denied/dropped), WDATA0 +0x10, RDATA0 +0x18. Command word:
+ * opcode << 27 | register byte << 4 | (byte count - 1); EXT_WRITEL = 0,
+ * EXT_READL = 1. Like Linux, the write is only issued when the owner table
+ * gives the SDAM APID to EE 0; otherwise the reason is not set and the
+ * reset is a plain one. The keys driver (negroni_keys.c) reads this arbiter
+ * the same way (core + observer) on this hardware.
+ *
+ * Adapted from slop unixnu-negroni/package/BootResetCore.h + BootReset.c
+ * (SM8550 "sheng", same arbiter layout and SDAM cell).
+ *
+ * Callers: thread context, one at a time (the USB command server).
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+int negroni_reboot_set_reason(unsigned reason);
+void negroni_reboot_reset(void);
+void negroni_reboot(unsigned reason);
+
+#define NR_CORE_PA              0x0c400000u
+#define NR_CORE_SIZE            0x3000u
+#define NR_CHNLS_PA             0x0c500000u
+#define NR_OBS_PA               0x0c440000u
+#define NR_CNFG_PA              0x0c42d000u
+#define NR_EE                   0u
+
+#define NR_VERSION_V7_MIN       0x70000000u
+#define NR_VERSION_V8_MIN       0x80000000u
+#define NR_FEATURES             0x04u
+#define NR_APID_MAP             0x2000u
+#define NR_MAX_APIDS            1024u
+#define NR_CHNL_STRIDE          0x1000u
+#define NR_OBS_EE_STRIDE        0x8000u
+#define NR_OBS_APID_STRIDE      0x20u
+
+#define NR_CMD                  0x00u
+#define NR_STATUS               0x08u
+#define NR_WDATA0               0x10u
+#define NR_RDATA0               0x18u
+#define NR_OP_EXT_WRITEL        0u
+#define NR_OP_EXT_READL         1u
+#define NR_STATUS_DONE          (1u << 0)
+#define NR_STATUS_ERRORS        0x0eu
+
+#define NR_SDAM_PPID            0x071u          /* SID 0, peripheral 0x71 (0x7100) */
+#define NR_REASON_REG           0x48u           /* 0x7148 */
+#define NR_REASON_MASK          0xfeu
+#define NR_REASON_SHIFT         1
+
+#define PSCI_SYSTEM_RESET       0x84000009ull
+
+static bool nr_attempted, nr_ready;
+static vm_offset_t nr_obs, nr_chn;              /* this APID's observer / read-write channel */
+
+static uint32_t
+nr_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+nr_wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = v;
+	__asm__ volatile ("dsb osh" ::: "memory");
+}
+
+static uint32_t
+nr_cmd(uint32_t op, uint32_t reg)
+{
+	return (op << 27) | ((reg & 0xffu) << 4);     /* byte count 1 */
+}
+
+/* 0 done, 1 timeout, 2 the arbiter reported an error */
+static int
+nr_wait(vm_offset_t ch)
+{
+	for (unsigned i = 0; i < 2000; i++) {
+		uint32_t s = nr_rd(ch, NR_STATUS);
+		if (s & NR_STATUS_DONE) {
+			return (s & NR_STATUS_ERRORS) ? 2 : 0;
+		}
+		delay(1);
+	}
+	return 1;
+}
+
+/* Finds the SDAM APID, checks that EE 0 may write it and maps its channels. */
+static bool
+nr_open(void)
+{
+	if (nr_attempted) {
+		return nr_ready;
+	}
+	nr_attempted = true;
+	vm_offset_t core = ml_io_map(NR_CORE_PA, NR_CORE_SIZE);
+	vm_offset_t cnfg = ml_io_map(NR_CNFG_PA, 0x1000);
+	if (core == 0 || cnfg == 0) {
+		printf("NEGRONI REBOOT: SPMI map failed\n");
+		return false;
+	}
+	uint32_t arb = nr_rd(core, 0), apids = nr_rd(core, NR_FEATURES) & 0x7ffu;
+	if (arb < NR_VERSION_V7_MIN || arb >= NR_VERSION_V8_MIN || apids == 0 || apids > NR_MAX_APIDS) {
+		printf("NEGRONI REBOOT: unknown SPMI arbiter %#x (%u APIDs)\n", arb, apids);
+		return false;
+	}
+	/* As Linux picks it: the first mapping, replaced by one this EE owns. */
+	int apid = -1;
+	unsigned owner = 0;
+	for (uint32_t i = 0; i < apids; i++) {
+		uint32_t map = nr_rd(core, NR_APID_MAP + 4 * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != NR_SDAM_PPID) {
+			continue;
+		}
+		unsigned o = nr_rd(cnfg, 4 * i) & 7u;
+		if (apid < 0 || o == NR_EE) {
+			apid = (int)i;
+			owner = o;
+		}
+	}
+	if (apid < 0) {
+		printf("NEGRONI REBOOT: SDAM 0x7100 not in the SPMI APID map\n");
+		return false;
+	}
+	if (owner != NR_EE) {
+		printf("NEGRONI REBOOT: SDAM APID %d is owned by EE %u, not EE %u: no reboot reason\n",
+		    apid, owner, NR_EE);
+		return false;
+	}
+	uint32_t obs_off = NR_OBS_EE_STRIDE * NR_EE + NR_OBS_APID_STRIDE * (uint32_t)apid;
+	vm_offset_t obs_page = ml_io_map(NR_OBS_PA + (obs_off & ~0xfffu), 0x1000);
+	nr_chn = ml_io_map(NR_CHNLS_PA + NR_CHNL_STRIDE * (uint32_t)apid, NR_CHNL_STRIDE);
+	if (obs_page == 0 || nr_chn == 0) {
+		printf("NEGRONI REBOOT: SPMI channel map failed\n");
+		return false;
+	}
+	nr_obs = obs_page + (obs_off & 0xfffu);
+	nr_ready = true;
+	printf("NEGRONI REBOOT: SPMI arbiter %#x, SDAM APID %d (EE %u)\n", arb, apid, owner);
+	return true;
+}
+
+static int
+nr_read(uint8_t *value)
+{
+	nr_wr(nr_obs, NR_CMD, nr_cmd(NR_OP_EXT_READL, NR_REASON_REG));
+	int rc = nr_wait(nr_obs);
+	if (rc == 0) {
+		*value = (uint8_t)nr_rd(nr_obs, NR_RDATA0);
+	}
+	return rc;
+}
+
+static int
+nr_write(uint8_t value)
+{
+	nr_wr(nr_chn, NR_WDATA0, value);
+	nr_wr(nr_chn, NR_CMD, nr_cmd(NR_OP_EXT_WRITEL, NR_REASON_REG));
+	return nr_wait(nr_chn);
+}
+
+/*
+ * Reboot reason field of 0x7148 = reason (0 normal, 1 recovery,
+ * 2 bootloader); bit 0 is kept. 0 = set and read back, -1 = not set.
+ */
+int
+negroni_reboot_set_reason(unsigned reason)
+{
+	uint8_t before = 0, after = 0;
+
+	if (reason > 0x7f || !nr_open()) {
+		return -1;
+	}
+	int rc = nr_read(&before);
+	if (rc) {
+		printf("NEGRONI REBOOT: read of 0x7148 failed (%d)\n", rc);
+		return -1;
+	}
+	uint8_t next = (uint8_t)((before & ~NR_REASON_MASK) | ((reason << NR_REASON_SHIFT) & NR_REASON_MASK));
+	if (next == before) {
+		printf("NEGRONI REBOOT: 0x7148 = %#04x already (reason %u)\n", before, reason);
+		return 0;
+	}
+	rc = nr_write(next);
+	if (rc == 0) {
+		rc = nr_read(&after);
+	}
+	if (rc || after != next) {
+		printf("NEGRONI REBOOT: write of 0x7148 %#04x -> %#04x failed (rc %d, read back %#04x)\n",
+		    before, next, rc, after);
+		return -1;
+	}
+	printf("NEGRONI REBOOT: 0x7148 %#04x -> %#04x (reason %u)\n", before, after, reason);
+	return 0;
+}
+
+/* PSCI SYSTEM_RESET (SMC conduit, as NegroniCPU's CPU_ON). Returns only if PSCI refused. */
+void
+negroni_reboot_reset(void)
+{
+	register uint64_t x0 __asm__("x0") = PSCI_SYSTEM_RESET;
+	register uint64_t x1 __asm__("x1") = 0;
+	register uint64_t x2 __asm__("x2") = 0;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile ("smc #0" : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	printf("NEGRONI REBOOT: PSCI SYSTEM_RESET returned %lld\n", (long long)x0);
+}
+
+/* Reason (best effort: a reason that cannot be set gives a plain reset), then reset. */
+void
+negroni_reboot(unsigned reason)
+{
+	if (negroni_reboot_set_reason(reason) != 0) {
+		printf("NEGRONI REBOOT: reason %u not set, plain reset\n", reason);
+	}
+	negroni_reboot_reset();
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
