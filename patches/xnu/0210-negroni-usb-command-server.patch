+		ud.rx_frames++;         /* a command: taken before the stack */
+	} else if (ud.ifp != NULL && len >= ETHER_HDR_LEN && len <= ETHER_MAX_LEN) {
 		/*
 		 * One mbuf with a 2 KiB cluster holds any frame. (mbuf_allocpacket
 		 * may return a first mbuf of length 0: stripping the header from
@@ -560,6 +569,241 @@ ud_if_output(ifnet_t ifp, mbuf_t m)
 	return 0;
 }
 
+/*
+ * Command server on 192.168.7.2:5141 (UDP), in the receive path above: a
+ * frame for this port is handled here and never reaches the network stack,
+ * so the commands need no socket or userland and still work while either
+ * hangs, as long as ud_thread runs. Only unfragmented IPv4/UDP from
+ * 192.168.7.1 to 192.168.7.2 is accepted. One ASCII command per datagram
+ * (trailing white space ignored), each logged as "NEGRONI CTL:":
+ *   ping        reply "pong"
+ *   reboot      PSCI SYSTEM_RESET (a reboot reason left in the PMIC is cleared)
+ *   bootloader  reboot reason 2 (ABL fastboot), then the reset
+ *   recovery    reboot reason 1 (recovery), then the reset
+ *   panic       panic("requested over USB"), so the panic log path runs
+ * The last four reply "ok <command>" and act UD_CTL_DELAY_MS later, so the
+ * reply and the console log still reach the host. The reason is written
+ * at once (negroni_reboot.c); if it cannot be set the reply says so and
+ * the reset is a plain one. Replies go straight back to the sender's MAC
+ * and port (no ARP, no socket). Boot-arg negronictl=0 disables the server.
+ * Host side: op10tool ctl <command>.
+ */
+#define UD_CTL_PORT     5141
+#define UD_IP_PHONE     0xc0a80702u     /* 192.168.7.2 */
+#define UD_IP_HOST      0xc0a80701u     /* 192.168.7.1 */
+#define UD_CTL_DELAY_MS 500
+
+enum { UD_CTL_NONE, UD_CTL_RESET, UD_CTL_PANIC };
+
+extern int negroni_reboot_set_reason(unsigned reason);
+extern void negroni_reboot_reset(void);
+
+static const struct {
+	const char *name;
+	unsigned    reason;         /* PMIC reboot reason: 0 normal, 1 recovery, 2 bootloader */
+} ud_ctl_resets[] = {
+	{ "reboot", 0 },
+	{ "recovery", 1 },
+	{ "bootloader", 2 },
+};
+
+static uint16_t
+ud_be16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] << 8 | p[1]);
+}
+
+static uint32_t
+ud_be32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+static void
+ud_put16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)(v >> 8);
+	p[1] = (uint8_t)v;
+}
+
+static void
+ud_put32(uint8_t *p, uint32_t v)
+{
+	ud_put16(p, (uint16_t)(v >> 16));
+	ud_put16(p + 2, (uint16_t)v);
+}
+
+/* Internet checksum (RFC 1071): add 16-bit big-endian words, an odd last byte padded with 0. */
+static uint32_t
+ud_sum_add(uint32_t sum, const uint8_t *p, unsigned len)
+{
+	for (unsigned i = 0; i < len; i += 2) {
+		sum += (uint32_t)p[i] << 8 | (i + 1 < len ? p[i + 1] : 0u);
+	}
+	return sum;
+}
+
+static uint16_t
+ud_sum_fold(uint32_t sum)
+{
+	while (sum >> 16) {
+		sum = (sum & 0xffff) + (sum >> 16);
+	}
+	return (uint16_t)~sum;
+}
+
+/* UDP datagram from 192.168.7.2:5141 back to the sender of req (a frame ud_ctl_input accepted). */
+static void
+ud_ctl_reply(const uint8_t *req, const char *text)
+{
+	const uint8_t *rip = req + ETHER_HDR_LEN;
+	const uint8_t *rudp = rip + (rip[0] & 0xfu) * 4;
+	uint32_t n = (uint32_t)strlen(text);
+	uint32_t len = ETHER_HDR_LEN + 20 + 8 + n;
+	mbuf_t m = NULL;
+
+	if (mbuf_gethdr(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    mbuf_mclget(MBUF_DONTWAIT, MBUF_TYPE_DATA, &m) != 0 ||
+	    !(mbuf_flags(m) & MBUF_EXT) || mbuf_maxlen(m) < len) {
+		if (m != NULL) {
+			mbuf_freem(m);
+		}
+		printf("NEGRONI CTL: no mbuf for the reply\n");
+		return;
+	}
+	uint8_t *f = mbuf_data(m);
+	bzero(f, len);
+	memcpy(f, req + ETHER_ADDR_LEN, ETHER_ADDR_LEN);        /* to the sender's MAC */
+	memcpy(f + ETHER_ADDR_LEN, ud_phone_mac, ETHER_ADDR_LEN);
+	ud_put16(f + 12, ETHERTYPE_IP);
+	uint8_t *ip = f + ETHER_HDR_LEN;
+	ip[0] = 0x45;                   /* IPv4, 20-byte header */
+	ud_put16(ip + 2, (uint16_t)(20 + 8 + n));
+	ud_put16(ip + 4, ud.ctl_ip_id++);
+	ud_put16(ip + 6, 0x4000);       /* don't fragment */
+	ip[8] = 64;                     /* TTL */
+	ip[9] = IPPROTO_UDP;
+	ud_put32(ip + 12, UD_IP_PHONE);
+	memcpy(ip + 16, rip + 12, 4);   /* to the sender's address */
+	ud_put16(ip + 10, ud_sum_fold(ud_sum_add(0, ip, 20)));
+	uint8_t *udp = ip + 20;
+	ud_put16(udp, UD_CTL_PORT);
+	memcpy(udp + 2, rudp, 2);       /* to the sender's port */
+	ud_put16(udp + 4, (uint16_t)(8 + n));
+	memcpy(udp + 8, text, n);
+	/* UDP checksum over the pseudo header (addresses, protocol, length) and the datagram */
+	uint32_t sum = ud_sum_add(0, ip + 12, 8) + IPPROTO_UDP + 8 + n;
+	uint16_t csum = ud_sum_fold(ud_sum_add(sum, udp, 8 + n));
+	ud_put16(udp + 6, csum ? csum : 0xffff);
+	mbuf_setlen(m, len);
+	mbuf_pkthdr_setlen(m, len);
+	(void)ud_if_output(ud.ifp, m);
+}
+
+static void
+ud_ctl_schedule(int action)
+{
+	clock_interval_to_deadline(UD_CTL_DELAY_MS, NSEC_PER_MSEC, &ud.ctl_deadline);
+	ud.ctl_action = action;
+}
+
+/* One received frame (Ethernet header first). true = it was for the command server. */
+static bool
+ud_ctl_input(const uint8_t *f, uint32_t len)
+{
+	char cmd[32], reply[80];
+
+	if (!ud.ctl_enabled || len < ETHER_HDR_LEN + 20 + 8 || ud_be16(f + 12) != ETHERTYPE_IP) {
+		return false;
+	}
+	const uint8_t *ip = f + ETHER_HDR_LEN;
+	uint32_t ihl = (ip[0] & 0xfu) * 4, tot = ud_be16(ip + 2);
+	if ((ip[0] >> 4) != 4 || ihl < 20 || ip[9] != IPPROTO_UDP || tot < ihl + 8 ||
+	    ETHER_HDR_LEN + tot > len || (ud_be16(ip + 6) & 0x3fff) != 0) {
+		return false;           /* not one whole IPv4/UDP datagram: for the stack */
+	}
+	const uint8_t *udp = ip + ihl;
+	if (ud_be32(ip + 16) != UD_IP_PHONE || ud_be16(udp + 2) != UD_CTL_PORT) {
+		return false;
+	}
+	/* From here on the frame is the command server's: it never reaches the stack. */
+	if (ud_be32(ip + 12) != UD_IP_HOST) {
+		printf("NEGRONI CTL: datagram from %u.%u.%u.%u ignored (only 192.168.7.1)\n",
+		    ip[12], ip[13], ip[14], ip[15]);
+		return true;
+	}
+	uint32_t ulen = ud_be16(udp + 4);
+	if (ud_sum_fold(ud_sum_add(0, ip, ihl)) != 0 || ulen < 8 || ulen > tot - ihl) {
+		printf("NEGRONI CTL: malformed datagram ignored\n");
+		return true;
+	}
+	uint32_t n = ulen - 8;
+	const uint8_t *p = udp + 8;
+	while (n > 0 && (p[n - 1] == '\n' || p[n - 1] == '\r' || p[n - 1] == ' ' ||
+	    p[n - 1] == '\t' || p[n - 1] == 0)) {
+		n--;
+	}
+	if (n >= sizeof(cmd)) {
+		printf("NEGRONI CTL: %u-byte command ignored\n", n);
+		ud_ctl_reply(f, "error: unknown command");
+		return true;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		cmd[i] = (p[i] >= 0x20 && p[i] < 0x7f) ? (char)p[i] : '?';
+	}
+	cmd[n] = 0;
+	printf("NEGRONI CTL: \"%s\" from 192.168.7.1:%u\n", cmd, ud_be16(udp));
+
+	if (strcmp(cmd, "ping") == 0) {
+		ud_ctl_reply(f, "pong");
+		return true;
+	}
+	if (ud.ctl_action != UD_CTL_NONE) {
+		printf("NEGRONI CTL: busy (a reset or panic is pending)\n");
+		ud_ctl_reply(f, "error: busy");
+		return true;
+	}
+	if (strcmp(cmd, "panic") == 0) {
+		printf("NEGRONI CTL: panic in %u ms\n", UD_CTL_DELAY_MS);
+		ud_ctl_reply(f, "ok panic");
+		ud_ctl_schedule(UD_CTL_PANIC);
+		return true;
+	}
+	for (unsigned i = 0; i < sizeof(ud_ctl_resets) / sizeof(ud_ctl_resets[0]); i++) {
+		if (strcmp(cmd, ud_ctl_resets[i].name) != 0) {
+			continue;
+		}
+		unsigned reason = ud_ctl_resets[i].reason;
+		bool set = negroni_reboot_set_reason(reason) == 0;
+		snprintf(reply, sizeof(reply), "ok %s%s", cmd,
+		    (set || reason == 0) ? "" : " (reason not set: plain reset)");
+		printf("NEGRONI CTL: %s: reason %u %s, reset in %u ms\n", cmd, reason,
+		    set ? "set" : "NOT set", UD_CTL_DELAY_MS);
+		ud_ctl_reply(f, reply);
+		ud_ctl_schedule(UD_CTL_RESET);
+		return true;
+	}
+	printf("NEGRONI CTL: unknown command\n");
+	ud_ctl_reply(f, "error: unknown command");
+	return true;
+}
+
+/* ud_thread, every tick: run a scheduled reset or panic once its delay is over. */
+static void
+ud_ctl_poll(void)
+{
+	if (ud.ctl_action == UD_CTL_NONE || mach_absolute_time() < ud.ctl_deadline) {
+		return;
+	}
+	int action = ud.ctl_action;
+	ud.ctl_action = UD_CTL_NONE;
+	if (action == UD_CTL_PANIC) {
+		panic("requested over USB");
+	}
+	printf("NEGRONI CTL: PSCI SYSTEM_RESET\n");
+	negroni_reboot_reset();         /* returns only if PSCI refused (logged there) */
+}
