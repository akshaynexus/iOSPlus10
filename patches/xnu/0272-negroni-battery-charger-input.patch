+/*
+ * 0272: with a cable in, make the charger take USB input at negronichg_ma (default 500 mA; 0 = read only):
+ * the downstream smblib_set_icl_current() order (limit, USBIN_MODE_CHG, ICL override, un-suspend), then
+ * charging enabled. Only registers whose value differs are written; at most CHG_TRIES polls per plug.
+ */
+void
+NegroniBattery::driveCharger(nb_sample &s)
+{
+	if (!(s.usbRt & 0x10)) {
+		fChgTries = 0;          /* unplugged: nothing to do, the next plug gets new tries */
+		return;
+	}
+	unsigned wantRaw = fChgMa / fChgStep;
+	if (wantRaw > 255) {
+		wantRaw = 255;
+	}
+	bool suspended = (s.cmdIl & 1) || (s.powerPath & 0x40);
+	bool chgOff = !(s.chgEn & 1);
+	bool limitWrong = s.iclCfg != wantRaw || !(s.iclOpt & 1) || !(s.loadCfg & 0x10);
+	if (!suspended && !chgOff && !limitWrong) {
+		return;
+	}
+	if (fChgTries >= CHG_TRIES) {
+		return;
+	}
+	fChgTries++;
+	IOLog("NEGRONI BATTERY: charger set (try %u): want %u mA (raw %u, %u mA/LSB)%s%s%s\n", fChgTries, fChgMa, wantRaw,
+	    fChgStep, suspended ? ", un-suspend" : "", chgOff ? ", enable charging" : "", limitWrong ? ", input limit" : "");
+	if (s.iclCfg != wantRaw) {
+		chgWrite(CHG_USBIN_ICL_CFG, (uint8_t)wantRaw, "USBIN_CURRENT_LIMIT_CFG");
+	}
+	if (!(s.iclOpt & 1)) {
+		chgWrite(CHG_USBIN_ICL_OPT, s.iclOpt | 1, "USBIN_ICL_OPTIONS mode_chg");
+	}
+	if (!(s.loadCfg & 0x10)) {
+		chgWrite(CHG_USBIN_LOAD_CFG, s.loadCfg | 0x10, "USBIN_LOAD_CFG icl_override_after_apsd");
 	}
