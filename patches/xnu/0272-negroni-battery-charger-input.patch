+int
+NegroniBattery::chgWrite(unsigned addr, uint8_t value, const char *what)
+{
+	int rc = negroni_spmi_write(CHG_SID, addr, value);
+	IOLog("NEGRONI BATTERY: charger write %s: %#x = 0x%02x %s\n", what, addr, value, rc ? "FAILED" : "ok");
+	return rc;
