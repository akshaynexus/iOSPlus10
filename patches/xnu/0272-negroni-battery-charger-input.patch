+static bool
+sp_write_target(unsigned sid, unsigned addr, vm_offset_t *chn, uint16_t *apid)
+{
+	/* ADC7 user registers of the PMK8350 VADC; 0x3146 (EN_CTL1) is not written */
+	if (sid == 0 && addr >= 0x3140 && addr <= 0x3147 && addr != 0x3146) {
+		*chn = sp_vadc_chn;
+		*apid = sp_vadc_apid;
+		return sp_vadc_unlocked;
