+	if (sid == 3 && sp_chg_unlocked) {
+		if (addr == 0x1042) {
+			*chn = sp_chg_chn[0];
+			*apid = sp_chg_apid[0];
+			return *chn != 0;
+		}
+		if (addr == 0x1340 || addr == 0x1342 || addr == 0x1365 || addr == 0x1366 || addr == 0x1370) {
+			*chn = sp_chg_chn[1];
+			*apid = sp_chg_apid[1];
+			return *chn != 0;
+		}
+	}
+	return false;
