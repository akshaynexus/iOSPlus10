+/* 0272: the SMB5 charger registers, read only. s.chgRead only when every register was read. */
+void
+NegroniBattery::readCharger(nb_sample &s)
+{
+	struct { unsigned addr; uint8_t *out; } regs[] = {
+		{ CHG_STATUS1, &s.st1 }, { CHG_STATUS2, &s.st2 }, { CHG_ENABLE_CMD, &s.chgEn }, { CHG_FCC_CFG, &s.fcc },
+		{ CHG_FV_CFG, &s.fv }, { CHG_APSD_STATUS, &s.apsdSt }, { CHG_APSD_RESULT, &s.apsdRes },
+		{ CHG_USBIN_RT_STS, &s.usbRt }, { CHG_USBIN_CMD_IL, &s.cmdIl }, { CHG_USBIN_LOAD_CFG, &s.loadCfg },
+		{ CHG_USBIN_ICL_OPT, &s.iclOpt }, { CHG_USBIN_ICL_CFG, &s.iclCfg }, { CHG_USBIN_AICL_OPT, &s.aiclOpt },
+		{ CHG_TYPEC_SNK_STS, &s.typecSnk }, { CHG_TYPEC_MISC_STS, &s.typecMisc }, { CHG_ICL_STATUS, &s.iclSts },
+		{ CHG_AICL_ICL_STS, &s.aiclSts }, { CHG_POWER_PATH_STS, &s.powerPath },
+	};
+	unsigned ok = 0;
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); ++i) {
+		if (negroni_spmi_read(CHG_SID, regs[i].addr, regs[i].out) == 0) {
+			ok++;
+		}
+	}
+	s.chgRead = ok == sizeof(regs) / sizeof(regs[0]);
+	if (!s.chgRead) {
+		if (fChgKey != 0xfffffffeu) {
+			IOLog("NEGRONI BATTERY: charger registers: %u of %u readable (SID 3 0x1000-0x1600 not reachable)\n",
+			    ok, (unsigned)(sizeof(regs) / sizeof(regs[0])));
+			fChgKey = 0xfffffffeu;
+		}
+		return;
+	}
+	fChgSt1 = s.st1;
+	fChgIclSts = s.iclSts;
+	fChgPowerPath = s.powerPath;
+	uint32_t key = (uint32_t)s.st1 | (uint32_t)s.usbRt << 8 | (uint32_t)s.cmdIl << 16 | (uint32_t)s.iclSts << 24;
+	if (key != fChgKey || fDiag) {
+		fChgKey = key;
+		IOLog("NEGRONI BATTERY: charger %s%s%s: st1 %02x st2 %02x en %02x fcc %02x fv %02x apsd %02x/%02x usb_rt %02x "
+		    "cmd_il %02x load %02x icl_opt %02x icl_cfg %02x (%u mA) aicl %02x typec %02x/%02x | icl_sts %02x (%u mA) "
+		    "aicl_sts %02x power_path %02x\n",
+		    kChgState[s.st1 & 7], (s.usbRt & 0x10) ? ", USBIN plugged" : ", USBIN unplugged",
+		    ((s.cmdIl & 1) || (s.powerPath & 0x40)) ? ", USBIN SUSPENDED" : "",
+		    s.st1, s.st2, s.chgEn, s.fcc, s.fv, s.apsdSt, s.apsdRes, s.usbRt, s.cmdIl, s.loadCfg, s.iclOpt, s.iclCfg,
+		    s.iclCfg * fChgStep, s.aiclOpt, s.typecSnk, s.typecMisc, s.iclSts, s.iclSts * fChgStep, s.aiclSts, s.powerPath);
+	}
+}
