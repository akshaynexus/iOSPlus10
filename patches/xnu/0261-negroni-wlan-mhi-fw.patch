+/*
+ * NEGRONI QCA6490 Wi-Fi: MHI host definitions shared by negroni_wlan.c, negroni_wlan_bhi.c and
+ * negroni_wlan_mhi.c (patch 0261). Register layout from Linux drivers/bus/mhi/common.h
+ * (GPL-2.0, Copyright (c) 2022 Linaro Ltd.) and include/linux/mhi.h; values only, no code.
+ */
+#ifndef _NEGRONI_WLAN_MHI_H_
+#define _NEGRONI_WLAN_MHI_H_
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <mach/vm_types.h>
+
+/* MHI registers (BAR0 offsets) */
+#define MHI_REGLEN              0x00
+#define MHI_VER                 0x08
+#define MHI_CFG                 0x10
+#define MHI_CHDBOFF             0x18
+#define MHI_ERDBOFF             0x20
+#define MHI_BHIOFF              0x28
+#define MHI_BHIEOFF             0x2c
+#define MHI_CTRL                0x38
+#define MHI_STATUS              0x48
+#define MHI_CCABAP              0x58    /* low, then high at +4 */
+#define MHI_ECABAP              0x60
+#define MHI_CRCBAP              0x68
+#define MHI_CRDB                0x70
+#define MHI_CTRLBASE            0x80
+#define MHI_CTRLLIMIT           0x88
+#define MHI_DATABASE            0x98
+#define MHI_DATALIMIT           0xa0
+#define MHI_CTRL_RESET          (1u << 1)
+#define MHI_STATUS_READY        (1u << 0)
+#define MHI_STATUS_SYSERR       (1u << 2)
+#define MHI_ALL_ONES            0xffffffffu     /* a read over a dead PCIe link */
+
+/* BHI (offsets from BHIOFF) */
+#define BHI_IMGADDR_LOW         0x08
+#define BHI_IMGADDR_HIGH        0x0c
+#define BHI_IMGSIZE             0x10
+#define BHI_IMGTXDB             0x18
+#define BHI_INTVEC              0x20
+#define BHI_EXECENV             0x28
+#define BHI_STATUS              0x2c
+#define BHI_ERRCODE             0x30
+#define BHI_ERRDBG1             0x34
+#define BHI_SERIALNU            0x40
+
+/* BHIe (offsets from BHIEOFF) */
+#define BHIE_TXVECADDR_LOW      0x2c
+#define BHIE_TXVECADDR_HIGH     0x30
+#define BHIE_TXVECSIZE          0x34
+#define BHIE_TXVECDB            0x3c
+#define BHIE_TXVECSTATUS        0x44
+#define BHI_SEQ_MASK            0x3fffffffu
+#define BHI_ST_DONE             2       /* status field bits 31:30 */
+#define BHI_ST_ERROR            3
+
+/* states and execution environments */
+#define MHI_ST_RESET            0x0
+#define MHI_ST_READY            0x1
+#define MHI_ST_M0               0x2
+#define MHI_ST_SYS_ERR          0xff
+#define MHI_EE_PBL              0
+#define MHI_EE_SBL              1
+#define MHI_EE_AMSS             2
+#define MHI_EE_RDDM             3
+#define MHI_EE_WFW              4
+#define MHI_EE_PTHRU            5
+#define MHI_EE_EDL              6
+
+/* ring element types (dword1 bits 23:16) */
+#define MHI_PKT_TRANSFER        0x02
+#define MHI_PKT_START_CHAN      0x12
+#define MHI_PKT_STATE_CHANGE    0x20
+#define MHI_PKT_CMD_DONE        0x21
+#define MHI_PKT_TX_EVENT        0x22
+#define MHI_PKT_EE_EVENT        0x40
+#define MHI_EV_CC_SUCCESS       0x1
+
+/* configuration (Linux ath11k mhi.c ath11k_mhi_config_qca6390) */
+#define MHI_MAX_CH              128
+#define MHI_WAKE_DB             127     /* device-wake doorbell = channel doorbell 127 (internal.h) */
+#define MHI_EV_RINGS            2
+#define MHI_CMD_ELEMENTS        128
+#define MHI_CH_ELEMENTS         64
+#define MHI_IPCR_OUT            20
+#define MHI_IPCR_IN             21
+#define MHI_SEG                 (512u << 10)    /* sbl_size = seg_len */
+#define MHI_DMA_MASK            ((1ull << 36) - 1)
+
+/*
+ * One contiguous DMA pool holds the contexts, rings, firmware image, m3 buffer and BHIe vector
+ * table (negroni_wlan.c owns the byte layout). The size is shared so mhi_init can set the MHI
+ * CTRL/DATA address window (MHICTRLBASE..MHICTRLLIMIT) to the whole pool.
+ */
+#define NEGRONI_WLAN_POOL_SIZE  0x691000u       /* 6.57 MiB, page aligned */
+#define NEGRONI_WLAN_CHCTX_SIZE (MHI_MAX_CH * 44u)      /* full channel context array (5632 B) */
+
+/* host memory structures: little endian, accessed through a Normal non-cacheable mapping */
+struct mhi_el {                 /* ring element, 16 bytes */
+	uint64_t ptr;
+	uint32_t dw0, dw1;
+};
+struct mhi_ctx {                /* channel / event / command context, 44 bytes (packed) */
+	uint32_t w0, w1, w2;    /* chcfg chtype erindex | intmod ertype msivec | reserved */
+	uint32_t rbase[2], rlen[2], rp[2], wp[2];
+} __attribute__((packed, aligned(4)));
+
+/* a host ring: virtual base (non-cacheable), DMA address, size, local pointers */
+struct mhi_ring {
+	volatile struct mhi_el *va;
+	uint64_t pa;
+	uint32_t n;             /* elements */
+	uint32_t rp, wp;        /* element indexes */
+	volatile struct mhi_ctx *ctx;
+	uint32_t db;            /* doorbell BAR0 offset */
+};
+
+/* the MHI host state (negroni_wlan_mhi.c) */
+struct mhi_host {
+	vm_offset_t bar;
+	uint32_t bar_len;       /* mapped BAR0 bytes; every MHI offset is checked against it */
+	uint32_t bhi, bhie, chdb, erdb, wake_db;
+	vm_offset_t pool;       /* non-cacheable view of the DMA pool */
+	uint64_t pool_pa;
+	struct mhi_ring ev[MHI_EV_RINGS], cmd, ch_out, ch_in;
+	uint32_t timeout_ms;
+	uint32_t ee, state;     /* last seen by event */
+	bool sbl_seen, amss_seen, syserr, ch_started, mmio_set;
+	uint32_t events;
+};
+
+/* negroni_wlan.c (rd returns MHI_ALL_ONES and wr does nothing for an offset outside BAR0) */
+uint32_t negroni_wlan_rd(uint32_t off);
+void negroni_wlan_wr(uint32_t off, uint32_t v);
+uint64_t negroni_wlan_ms(void);
+uint32_t negroni_wlan_seq(void);
+
+/* negroni_wlan_bhi.c */
+int negroni_wlan_bhi_sbl(struct mhi_host *h, uint64_t pa, uint32_t size);
+int negroni_wlan_bhie_image(struct mhi_host *h, uint64_t vec_pa, uint32_t entries);
+
+/* negroni_wlan_mhi.c, in the Linux order (op-kernel boot.c mhi_fw_load_handler, pm.c) */
+int negroni_wlan_mhi_ready(struct mhi_host *h);         /* MHICTRL RESET clear, MHISTATUS READY */
