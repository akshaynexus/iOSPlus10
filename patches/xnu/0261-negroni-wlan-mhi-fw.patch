diff --git a/bsd/dev/negroni_ufs.c b/bsd/dev/negroni_ufs.c
index 8a9b3ef..80c87bf 100644
--- a/bsd/dev/negroni_ufs.c
+++ b/bsd/dev/negroni_ufs.c
@@ -994,6 +994,51 @@ negroni_ufs_adsp_area_read(uint64_t at, void *dst, uint32_t count)
 	return 0;
 }
 
+/*
+ * WLAN firmware area (bsd/dev/negroni_wlan.c, scripts/wifi/mkwlanarea.py in iOSPlus10):
+ * NEGRONI_WLAN_AREA_SIZE right before the ADSP area, written with dd like it (amss*.bin, m3.bin,
+ * regdb.bin, the board files: 22 MiB). Read-only: copies `count` bytes at byte `at` of the area
+ * to `dst` (kernel memory, also a non-cacheable mapping).
+ */
+#define NEGRONI_WLAN_AREA_SIZE    (32u << 20)
+#define NEGRONI_WLAN_AREA_BLOCKS  (NEGRONI_WLAN_AREA_SIZE / UFS_BLOCK)
+
+int negroni_ufs_wlan_area_read(uint64_t at, void *dst, uint32_t count);
+
+int
+negroni_ufs_wlan_area_read(uint64_t at, void *dst, uint32_t count)
+{
+	const uint8_t *bounce = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	uint8_t *to = (uint8_t *)dst;
+
+	if (!su.ready || su.nblocks < 4 * (NEGRONI_LOG_BLOCKS + NEGRONI_FW_BLOCKS + NEGRONI_ADSP_AREA_BLOCKS +
+	    NEGRONI_WLAN_AREA_BLOCKS) || at > NEGRONI_WLAN_AREA_SIZE || count > NEGRONI_WLAN_AREA_SIZE - at) {
+		return EINVAL;
+	}
+	uint64_t base = su.first_block + su.nblocks - NEGRONI_LOG_BLOCKS - NEGRONI_FW_BLOCKS - NEGRONI_ADSP_AREA_BLOCKS -
+	    NEGRONI_WLAN_AREA_BLOCKS;
+	while (count > 0) {
+		uint32_t skip = (uint32_t)(at % UFS_BLOCK);
+		uint32_t n = MIN(count, BOUNCE_SIZE - skip);
+		uint32_t nblk = (skip + n + UFS_BLOCK - 1) / UFS_BLOCK;
+		int error;
+
+		lck_mtx_lock(&negroni_ufs_lock);
+		error = ufs_read_blocks(base + at / UFS_BLOCK, nblk);
+		if (!error) {
+			memcpy(to, bounce + skip, n);
+		}
+		lck_mtx_unlock(&negroni_ufs_lock);
+		if (error) {
+			return error;
+		}
+		to += n;
+		at += n;
+		count -= n;
+	}
+	return 0;
+}
+
 struct negroni_log_header {
 	char magic[8];
 	uint32_t version, size;
