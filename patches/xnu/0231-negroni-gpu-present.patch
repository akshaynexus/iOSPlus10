@@ -254,23 +295,79 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		sender->setTimeoutUS(NEGRONI_FB_VSYNC_US);
 		return;
 	}
-	bool flush = fb->fDirty && (count % fb->fFlushTicks) == 0;
+	bool flush = fb->fDirty && (count % (fb->fPendGPU ? fb->fGpuFlushTicks : fb->fFlushTicks)) == 0;
 	uint8_t *rec = NULL;
+	NegroniSurface *held[NEGRONI_FB_LAYERS] = {};
 	if (flush) {
 		rec = (uint8_t *)IOMallocData(NEGRONI_FB_SWAP_REC_SIZE);
 		if (rec != NULL) {
 			memcpy(rec, fb->fPending, NEGRONI_FB_SWAP_REC_SIZE);
+			memcpy(held, fb->fPendHold, sizeof(held));
+			bzero(fb->fPendHold, sizeof(fb->fPendHold));
 			fb->fDirty = false;
 		}
 	}
 	IOLockUnlock(fb->fLock);
+	fb->releaseBusy(false);
 	if (rec != NULL) {
