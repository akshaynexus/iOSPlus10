 }
 
+/*
+ * Held surfaces whose GPU copy is done (all: wait for each, at most NEGRONI_FB_GPU_WAIT_MS)
+ * are given back to CoreAnimation. Work loop only.
+ */
+void
+AppleCLCD::releaseBusy(bool all)
+{
+	for (uint32_t i = 0; i < NEGRONI_FB_GPU_BUSY; i++) {
+		NegroniSurface *s = fBusy[i].surface;
+		if (s == NULL) {
+			continue;
+		}
+		if (all) {
+			NegroniGPUFenceWait(fBusy[i].fence, NEGRONI_FB_GPU_WAIT_MS);
+		} else if (!NegroniGPUFenceDone(fBusy[i].fence)) {
+			continue;
+		}
+		negroni_surface_hold(s, false);
+		s->release();
+		fBusy[i].surface = NULL;
+	}
+}
+
+/* The surfaces of a presented frame stay held until fence (0: released now). Work loop only. */
+void
+AppleCLCD::keepBusy(NegroniSurface **held, uint32_t fence)
+{
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		NegroniSurface *s = held[layer];
+		uint32_t slot = NEGRONI_FB_GPU_BUSY;
+		if (s == NULL) {
+			continue;
+		}
+		for (uint32_t i = 0; fence != 0 && i < NEGRONI_FB_GPU_BUSY && slot == NEGRONI_FB_GPU_BUSY; i++) {
+			if (fBusy[i].surface == NULL) {
+				slot = i;
+			}
+		}
+		if (slot == NEGRONI_FB_GPU_BUSY) {
+			if (fence != 0) {
+				NegroniGPUFenceWait(fence, NEGRONI_FB_GPU_WAIT_MS);
+			}
+			negroni_surface_hold(s, false);
+			s->release();
+			continue;
+		}
+		fBusy[slot].surface = s;
+		fBusy[slot].fence = fence;
+	}
+}
+
 void
 AppleCLCD::addClient(IOMobileFramebufferUserClient *client)
 {
@@ -311,10 +408,39 @@ static uint64_t negroni_fb_swap_count;
 void
 AppleCLCD::swap(const uint8_t *rec)
 {
+	NegroniSurface *held[NEGRONI_FB_LAYERS] = {}, *dropped[NEGRONI_FB_LAYERS];
+	uint32_t mask = get32(rec, 0x104);
+	bool gpu = NegroniGPUPresentReady() && mask != 0;
+
+	/* a frame of GPU-rendered layers only: each surface held until the GPU copied it */
+	for (uint32_t layer = 0; gpu && layer < NEGRONI_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		held[layer] = negroni_surface_copy(id);
+		gpu = held[layer] != NULL && held[layer] != fSurface && held[layer]->gpuFence != 0;
+	}
+	for (uint32_t layer = 0; layer < NEGRONI_FB_LAYERS; layer++) {
+		if (held[layer] != NULL && !gpu) {
+			OSSafeReleaseNULL(held[layer]);
+		} else if (held[layer] != NULL) {
+			negroni_surface_hold(held[layer], true);
+		}
+	}
 	IOLockLock(fLock);
