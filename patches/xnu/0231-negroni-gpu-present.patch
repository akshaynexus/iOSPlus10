diff --git a/iokit/Kernel/arm/NegroniGPU.cpp b/iokit/Kernel/arm/NegroniGPU.cpp
index 10a8d47..0d4b860 100644
--- a/iokit/Kernel/arm/NegroniGPU.cpp
+++ b/iokit/Kernel/arm/NegroniGPU.cpp
@@ -1518,4 +1518,261 @@ RedwoodGPUUserClient::externalMethod(uint32_t selector, IOExternalMethodArgument
 	}
 	return msmMethod(selector, args);
 }
+
+/*
+ * ---- the panel present (NegroniFramebuffer.cpp, patch 0231) ----
+ *
+ * The framebuffer hands over a swapped surface the GPU rendered; the 2D engine copies the
+ * visible rectangle into the panel memory (ABL's continuous-splash buffer, which the display
+ * engine scans out by itself), queued behind the render on the same ring, so nobody waits.
+ * The stream is built by bsd/dev/negroni_gpu_blit.c into one of two kernel command buffers;
+ * up to four surfaces stay mapped (read-only for the GPU) and retained, the oldest whose copy
+ * is done makes room. The panel memory is mapped once. All of it under gGPULock.
+ */
+#include "NegroniGPU.h"
+#include "../../../bsd/dev/negroni_gpu_blit.h"
+
+#define PRESENT_SURFACES        4
+
+static struct {
+	NegroniSurface *        surface;        /* retained, its memory prepared */
+	uint64_t                address, size;
+	uint32_t                fence;          /* the last copy that read it */
+} gPresentMaps[PRESENT_SURFACES];
+static uint32_t gPresentNext;
+static uint64_t gPanelPhys, gPanelAddress, gPanelBytes;
+static IOBufferMemoryDescriptor * gPresentIB[2];
+static uint64_t gPresentIBAddress[2];
+static uint32_t gPresentIBFence[2], gPresentIBNext;
+static int gPresentOn = -1;
+static uint32_t gPresentLogged;
+
+/* gGPULock held. [phys, + size) or the pages of md, at a new GPU address; 0 on failure. */
+static uint64_t
+presentMap(IOMemoryDescriptor * md, uint64_t phys, uint64_t size, bool readOnly)
+{
+	uint64_t address = negroni_gpu_address(size);
+	bool mapped = address != 0;
+
+	for (uint64_t offset = 0; offset < size && mapped; offset += GPU_PAGE) {
+		uint64_t pa = phys + offset;
+		if (md != NULL) {
+			IOByteCount length = 0;
+			pa = md->getPhysicalSegment((IOByteCount)offset, &length, kIOMemoryMapperNone);
+			mapped = pa != 0 && (pa & (GPU_PAGE - 1)) == 0 && length >= GPU_PAGE;
+		}
+		mapped = mapped && negroni_gpu_map(address + offset, pa, readOnly);
+	}
+	if (!mapped) {
+		if (address != 0) {
+			negroni_gpu_unmap(address, size);
+			negroni_gpu_address_free(address, size);
+		}
+		return 0;
+	}
+	negroni_gpu_mapped();
+	return address;
+}
+
+/* gGPULock held. */
+static void
+presentUnmap(uint64_t address, uint64_t size)
+{
+	negroni_gpu_unmap(address, size);
+	negroni_gpu_address_free(address, size);
+}
+
+/* gGPULock held. The GPU address of s's memory (mapped now if it is not), or 0. */
+static uint64_t
+presentSurface(NegroniSurface * s, uint32_t * slot)
+{
+	uint32_t pick = PRESENT_SURFACES;
+	uint64_t size = s->memory->getLength();
+
+	for (uint32_t i = 0; i < PRESENT_SURFACES; i++) {
+		if (gPresentMaps[i].surface == s) {
+			*slot = i;
+			return gPresentMaps[i].address;
+		}
+	}
+	for (uint32_t n = 0; n < PRESENT_SURFACES && pick == PRESENT_SURFACES; n++) {
+		uint32_t i = (gPresentNext + n) % PRESENT_SURFACES;
+		if (gPresentMaps[i].surface == NULL || negroni_gpu_done(gPresentMaps[i].fence)) {
+			pick = i;
+		}
+	}
+	if (pick == PRESENT_SURFACES || size == 0 || (size & PAGE_MASK) || size > GPU_BUFFER_MAX) {
+		return 0;                       /* four copies in flight, or an odd surface */
+	}
+	if (gPresentMaps[pick].surface != NULL) {
+		presentUnmap(gPresentMaps[pick].address, gPresentMaps[pick].size);
+		gPresentMaps[pick].surface->memory->complete();
+		gPresentMaps[pick].surface->release();
+		gPresentMaps[pick].surface = NULL;
+	}
+	if (s->memory->prepare() != kIOReturnSuccess) {
+		return 0;
+	}
+	uint64_t address = presentMap(s->memory, 0, size, true);
+	if (address == 0) {
+		s->memory->complete();
+		return 0;
+	}
+	s->retain();
+	gPresentMaps[pick].surface = s;
+	gPresentMaps[pick].address = address;
+	gPresentMaps[pick].size = size;
+	gPresentMaps[pick].fence = 0;
+	gPresentNext = pick + 1;
+	*slot = pick;
+	return address;
+}
+
+bool
+NegroniGPUPresentReady(void)
+{
+	if (gPresentOn < 0) {
+		int on = 1;
+		PE_parse_boot_argn("negronifb_gpu", &on, sizeof(on));
+		gPresentOn = on != 0;
+	}
+	return gPresentOn > 0 && gGPULock != NULL && negroni_gpu_ready() && !gGPUStopped;
+}
+
+uint32_t
+NegroniGPUPresent(NegroniSurface * s, uint64_t panelPhys, uint32_t pitch, uint32_t rows,
+    uint32_t sx, uint32_t sy, uint32_t dx, uint32_t dy, uint32_t w, uint32_t h)
+{
+	uint32_t words[NEGRONI_GPU_COPY_WORDS], count, fence = 0, slot = 0, ib;
+	uint64_t source, panelBytes = ((uint64_t)pitch * rows + GPU_PAGE - 1) & ~(GPU_PAGE - 1);
+	const char * why = NULL;
+
+	if (!NegroniGPUPresentReady() || s == NULL || s->memory == NULL || s->bytesPerElement != 4 ||
+	    s->elementWidth != 1 || s->elementHeight != 1 || (s->offset & 63) || (s->bytesPerRow & 63) ||
+	    (panelPhys & (GPU_PAGE - 1)) || (uint64_t)dy + h > rows) {
+		return 0;
+	}
+	IOLockLock(gGPULock);
+	if (gGPUStopped) {
+		goto out;
+	}
+	if (gPanelAddress == 0 || gPanelPhys != panelPhys || gPanelBytes != panelBytes) {
+		if (gPanelAddress != 0) {
+			presentUnmap(gPanelAddress, gPanelBytes);
+			gPanelAddress = 0;
+		}
+		gPanelAddress = presentMap(NULL, panelPhys, panelBytes, false);
+		gPanelPhys = panelPhys;
+		gPanelBytes = panelBytes;
+		IOLog("RedwoodGPU: panel memory 0x%llx (%llu bytes) at GPU address 0x%llx\n", panelPhys, panelBytes, gPanelAddress);
+		if (gPanelAddress == 0) {
+			why = "the panel memory cannot be mapped";
+			goto out;
+		}
+	}
+	for (ib = 0; ib < 2; ib++) {
+		if (gPresentIB[ib] == NULL) {
+			IOBufferMemoryDescriptor * md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+			    kIODirectionInOut, PAGE_SIZE, PAGE_SIZE);
+			uint64_t address = md != NULL ? presentMap(md, 0, PAGE_SIZE, true) : 0;
+			if (address == 0) {
+				OSSafeReleaseNULL(md);
+				why = "no command buffer";
+				goto out;
+			}
+			gPresentIB[ib] = md;
+			gPresentIBAddress[ib] = address;
+		}
+	}
+	ib = gPresentIBNext;
+	if (!negroni_gpu_done(gPresentIBFence[ib])) {
+		goto out;                       /* two copies still queued: this frame goes the CPU way */
+	}
+	source = presentSurface(s, &slot);
+	if (source == 0) {
+		goto out;
+	}
+	{
+		struct negroni_gpu_copy copy = {
+			.src = source + s->offset, .src_pitch = s->bytesPerRow,
+			.dst = gPanelAddress, .dst_pitch = pitch,
+			.sx = sx, .sy = sy, .dx = dx, .dy = dy, .w = w, .h = h,
+		};
+		count = negroni_gpu_copy_ib(&copy, words, NEGRONI_GPU_COPY_WORDS);
+	}
+	if (count == 0) {
+		why = "the copy cannot be put to the 2D engine";
+		goto out;
+	}
+	memcpy(gPresentIB[ib]->getBytesNoCopy(), words, count * 4);
+	flush_dcache64((addr64_t)(uintptr_t)gPresentIB[ib]->getBytesNoCopy(), count * 4, FALSE);
+	fence = negroni_gpu_submit(&gPresentIBAddress[ib], &count, 1);
+	if (fence == 0) {
+		negroni_gpu_report("the ring stays full (present)");
+		gGPUStopped = true;
+		goto out;
+	}
+	gPresentIBFence[ib] = fence;
+	gPresentIBNext = ib ^ 1;
+	gPresentMaps[slot].fence = fence;
+	if (gPresentLogged < 4) {
+		gPresentLogged++;
+		IOLog("RedwoodGPU: present %u: surface %u (fence %u) %ux%u from %u,%u to %u,%u, %u words\n", fence,
+		    s->id, s->gpuFence, w, h, sx, sy, dx, dy, count);
+	}
+out:
+	IOLockUnlock(gGPULock);
+	if (why != NULL && gPresentLogged < 8) {
+		gPresentLogged++;
+		IOLog("RedwoodGPU: present of surface %u: %s\n", s->id, why);
+	}
+	return fence;
+}
+
+bool
+NegroniGPUFenceDone(uint32_t fence)
+{
+	bool done;
+
+	if (fence == 0 || gGPULock == NULL) {
+		return true;
+	}
+	IOLockLock(gGPULock);
+	done = negroni_gpu_done(fence) || gGPUStopped;  /* stopped: nothing more will come */
+	IOLockUnlock(gGPULock);
+	return done;
+}
+
+bool
+NegroniGPUFenceWait(uint32_t fence, uint32_t ms)
+{
+	IOReturn ret;
+
+	if (fence == 0 || gGPULock == NULL) {
+		return true;
+	}
+	IOLockLock(gGPULock);
+	ret = gpuWait(fence, ms);
+	IOLockUnlock(gGPULock);
+	return ret == kIOReturnSuccess;
+}
+
+void
+NegroniGPUSurfaceForCPU(NegroniSurface * s, uint64_t offset, uint64_t length)
+{
+	IOMemoryDescriptor * md = s != NULL ? s->memory : NULL;
+	uint64_t end;
+
+	if (md == NULL || length == 0) {
+		return;
+	}
+	end = MIN(round_page_64(offset + length), (uint64_t)md->getLength());
+	for (uint64_t at = trunc_page_64(offset); at < end; at += PAGE_SIZE) {
+		IOByteCount segment = 0;
+		uint64_t pa = md->getPhysicalSegment((IOByteCount)at, &segment, kIOMemoryMapperNone);
+		if (pa != 0 && (pa & PAGE_MASK) == 0) {
+			cachePage(pa);
+		}
+	}
+}
 #endif /* NEGRONI */
diff --git a/iokit/Kernel/arm/NegroniGPU.h b/iokit/Kernel/arm/NegroniGPU.h
new file mode 100644
index 0000000..2ccab6f
--- /dev/null
+++ b/iokit/Kernel/arm/NegroniGPU.h
@@ -0,0 +1,42 @@
+/*
+ * NEGRONI: what the framebuffer (NegroniFramebuffer.cpp) asks of the kept
+ * Adreno 730 (NegroniGPU.cpp): a GPU copy of a swapped IOSurface into the
+ * panel memory, and its fence.
+ */
+#ifndef _NEGRONI_GPU_H
+#define _NEGRONI_GPU_H
+
+#include <pexpert/arm64/board_config.h>
+
+#if defined(NEGRONI)
+#include <stdint.h>
+
+class NegroniSurface;
+
+/* The GPU is kept, answers, and boot-arg negronifb_gpu is not 0 (default 1). */
+bool NegroniGPUPresentReady(void);
+
+/*
+ * Copy w x h BGRA pixels at (sx, sy) of s into the panel memory (physical,
+ * pitch bytes per row, rows rows) at (dx, dy), on the GPU, after everything
+ * submitted before (so after the render that wrote s). Returns the copy's
+ * fence, 0 when it cannot be done (alignment, mapping, GPU stopped): then the
+ * caller copies with the CPU. Does not wait.
+ */
+uint32_t NegroniGPUPresent(NegroniSurface *s, uint64_t panelPhys, uint32_t pitch, uint32_t rows,
+    uint32_t sx, uint32_t sy, uint32_t dx, uint32_t dy, uint32_t w, uint32_t h);
+
+/* The fence is done (0 is always done). */
+bool NegroniGPUFenceDone(uint32_t fence);
+
+/* Wait at most ms milliseconds for the fence; true when it is done. */
+bool NegroniGPUFenceWait(uint32_t fence, uint32_t ms);
+
+/*
+ * Before the CPU reads a surface the GPU wrote: its cached lines dropped
+ * (whole pages of [offset, offset + length) of its memory).
+ */
+void NegroniGPUSurfaceForCPU(NegroniSurface *s, uint64_t offset, uint64_t length);
+
+#endif /* NEGRONI */
+#endif /* _NEGRONI_GPU_H */
