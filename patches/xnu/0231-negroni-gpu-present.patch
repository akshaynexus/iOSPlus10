@@ -243,6 +279,11 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 			fb->fFadeStep = step + 1;
 		}
 		IOLockUnlock(fb->fLock);
+		if (step == 0) {
