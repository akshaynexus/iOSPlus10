diff --git a/bsd/dev/negroni_gpu_blit.c b/bsd/dev/negroni_gpu_blit.c
new file mode 100644
index 0000000..92f6410
--- /dev/null
+++ b/bsd/dev/negroni_gpu_blit.c
@@ -0,0 +1,206 @@
+/*
+ * NEGRONI: the A730's 2D engine copies a BGRA8 rectangle (see negroni_gpu_blit.h).
+ *
+ * The stream is the one Mesa 25.0.7 emits for a sysmem 2D blit on A7XX
+ * (gallium fd6_blitter.cc emit_setup + emit_blit_setup + emit_blit_src/dst +
+ * emit_blit_fini; turnip r2d_setup_common/r2d_run), register offsets and fields
+ * from src/freedreno/registers/adreno/a6xx.xml, events from adreno_pm4.xml
+ * (A7XX names), the sysmem CCU layout of the A730 from freedreno_devices.py
+ * (4 CCUs, 256K depth + 64K color each: depth at 0, color at 1 MiB).
+ *
+ * The destination pitch of the 2D engine is in 64-byte units and its base is
+ * 64-byte aligned; the panel's rows are 4320 bytes (1080 pixels). So the copy
+ * is two blits: the even rows and the odd rows, each as an image of twice the
+ * pitch (8640 = 135 * 64). An odd row starts 32 bytes into a 64-byte line: its
+ * blit starts at that line and at x + 8 pixels. The source gets the same
+ * treatment (twice its pitch: a multiple of 128, which A7XX's
+ * SP_PS_2D_SRC_PITCH asks for when the texture type is 2D).
+ */
+#include "negroni_gpu_blit.h"
+
+#if !defined(KERNEL) || defined(ARM64_BOARD_CONFIG_NEGRONI)
+
+/* PM4 */
+#define CP_WAIT_FOR_IDLE        0x26
+#define CP_BLIT                 0x2c
+#define CP_EVENT_WRITE7         0x46
+#define BLIT_OP_SCALE           3
+
+/* A7XX events */
+#define EV_CCU_INVALIDATE_DEPTH 0x18
+#define EV_CCU_INVALIDATE_COLOR 0x19
+#define EV_CCU_CLEAN_DEPTH      0x20
+#define EV_CCU_CLEAN_COLOR      0x21
+#define EV_CACHE_CLEAN          0x31
+#define EV_CACHE_INVALIDATE7    0x33
+
+/* registers (dwords) */
+#define GRAS_2D_BLIT_CNTL       0x8400
+#define GRAS_2D_SRC_TL_X        0x8401  /* .. SRC_BR_X, SRC_TL_Y, SRC_BR_Y, DST_TL, DST_BR (0x8406) */
+#define RB_WINDOW_OFFSET        0x8890
+#define RB_WINDOW_OFFSET2       0x88d4
+#define RB_CCU_CNTL2            0x88e5  /* A7XX */
+#define RB_2D_BLIT_CNTL         0x8c00
+#define RB_2D_UNKNOWN_8C01      0x8c01
+#define RB_2D_DST_INFO          0x8c17  /* .. RB_2D_DST lo, hi, RB_2D_DST_PITCH (0x8c1a) */
+#define RB_2D_DST_FLAGS         0x8c20  /* .. lo, hi, pitch */
+#define SP_2D_DST_FORMAT        0xa9bf  /* A7XX (0xacc0 is the A6XX one) */
+#define SP_WINDOW_OFFSET        0xab21  /* A7XX */
+#define SP_PS_2D_SRC_INFO       0xb2c0  /* A7XX: .. SIZE, SRC lo, hi, PITCH (0xb2c4) */
+#define SP_PS_2D_SRC_FLAGS      0xb2ca  /* A7XX: .. lo, hi, pitch */
+#define SP_PS_2D_WINDOW_OFFSET  0xb2d1  /* A7XX */
+#define TPL1_2D_SRC_CNTL        0xb2d2  /* A7XX */
+#define SP_TP_WINDOW_OFFSET     0xb307
+
+/* values */
+#define FMT6_8_8_8_8_UNORM      0x30u
+#define SWAP_WZYX               1u      /* B G R A in memory, as the boot ladder's step 22 fill */
+#define R2D_UNORM8              0x10u
+#define TEX_2D                  1u
+#define BLIT_CNTL_COPY          (FMT6_8_8_8_8_UNORM << 8 | 0xfu << 20 | R2D_UNORM8 << 24)
+#define DST_FORMAT_8888         (FMT6_8_8_8_8_UNORM << 3 | 0xfu << 12)
+#define SURF_INFO_BGRA          (FMT6_8_8_8_8_UNORM | SWAP_WZYX << 10)
+#define SRC_INFO_UNK20_UNK22    (1u << 20 | 1u << 22)   /* Mesa sets both for every 2D source */
+#define CCU_CNTL2_A730_SYSMEM   (0x100u << 23)          /* color at 1 MiB (>> 12), depth at 0, full sizes */
+#define MAX_2D                  16384u
+
+static uint32_t
+odd_parity(uint32_t v)
+{
+	return (0x9669 >> (0xf & (v ^ v >> 4 ^ v >> 8 ^ v >> 12 ^ v >> 16 ^ v >> 20 ^ v >> 24 ^ v >> 28))) & 1;
+}
+
+static uint32_t
+pkt7(uint32_t opcode, uint32_t words)
+{
+	return 7u << 28 | words | odd_parity(words) << 15 | opcode << 16 | odd_parity(opcode) << 23;
+}
+
+static uint32_t
+pkt4(uint32_t reg, uint32_t count)
+{
+	return 4u << 28 | count | odd_parity(count) << 7 | reg << 8 | odd_parity(reg) << 27;
+}
+
+struct ib {
+	uint32_t *w;
+	uint32_t n, max;
+};
+
+static void
+put(struct ib *b, uint32_t v)
+{
+	if (b->n < b->max) {
+		b->w[b->n] = v;
+	}
+	b->n++;
+}
+
+static void
+event(struct ib *b, uint32_t e)
+{
+	put(b, pkt7(CP_EVENT_WRITE7, 1));
+	put(b, e);
+}
+
+static void
+reg(struct ib *b, uint32_t r, uint32_t v)
+{
+	put(b, pkt4(r, 1));
+	put(b, v);
+}
+
+uint32_t
+negroni_gpu_copy_ib(const struct negroni_gpu_copy *c, uint32_t *words, uint32_t max_words)
+{
+	struct ib b = { .w = words, .n = 0, .max = max_words };
+	uint32_t blits = 0;
+
+	if (c->w == 0 || c->h == 0 || (c->src & 63) || (c->dst & 63) || (c->src_pitch & 63) ||
+	    (c->dst_pitch & 31) || c->src_pitch == 0 || c->dst_pitch == 0 ||
+	    (uint64_t)c->src_pitch * 2 >= (1u << 21) || (uint64_t)c->dst_pitch * 2 / 64 > 0xffffu ||
+	    (uint64_t)c->sx + c->w > c->src_pitch / 4 || (uint64_t)c->sx + c->w > MAX_2D ||
+	    (uint64_t)c->dx + c->w > c->dst_pitch / 4 || c->h > 2 * MAX_2D) {
+		return 0;
+	}
+
+	/* emit_setup: CCU clean + invalidate, texture cache invalidate (the source was just written) */
+	event(&b, EV_CCU_CLEAN_COLOR);
+	event(&b, EV_CCU_CLEAN_DEPTH);
+	event(&b, EV_CCU_INVALIDATE_COLOR);
+	event(&b, EV_CCU_INVALIDATE_DEPTH);
+	event(&b, EV_CACHE_INVALIDATE7);
+	put(&b, pkt7(CP_WAIT_FOR_IDLE, 0));
+	reg(&b, RB_CCU_CNTL2, CCU_CNTL2_A730_SYSMEM);
+	/* what a user submission may have left from binned (GMEM) rendering */
+	reg(&b, RB_WINDOW_OFFSET, 0);
+	reg(&b, RB_WINDOW_OFFSET2, 0);
+	reg(&b, SP_WINDOW_OFFSET, 0);
+	reg(&b, SP_TP_WINDOW_OFFSET, 0);
+	reg(&b, SP_PS_2D_WINDOW_OFFSET, 0);
+	/* emit_blit_setup */
+	reg(&b, RB_2D_BLIT_CNTL, BLIT_CNTL_COPY);
+	reg(&b, GRAS_2D_BLIT_CNTL, BLIT_CNTL_COPY);
+	reg(&b, TPL1_2D_SRC_CNTL, TEX_2D << 29);
+	reg(&b, SP_2D_DST_FORMAT, DST_FORMAT_8888);
+	reg(&b, RB_2D_UNKNOWN_8C01, 0);
+
+	for (uint32_t parity = 0; parity < 2; parity++) {
+		uint32_t rows = c->h > parity ? (c->h - parity + 1) / 2 : 0;
+		if (rows == 0) {
+			continue;
+		}
+		uint64_t row = c->dst + (uint64_t)(c->dy + parity) * c->dst_pitch;
+		uint64_t dst = row & ~63ull;
+		uint32_t x = c->dx + (uint32_t)(row - dst) / 4;
+		uint32_t dpitch = 2 * c->dst_pitch, spitch = 2 * c->src_pitch;
+		uint64_t src = c->src + (uint64_t)(c->sy + parity) * c->src_pitch;
+		uint32_t width = c->sx + c->w;
+
+		if (x + c->w > MAX_2D || rows > MAX_2D || (uint64_t)x + c->w > dpitch / 4) {
+			return 0;
+		}
+		/* emit_blit_texture: coordinates (source 24.8 fixed point, inclusive) */
+		put(&b, pkt4(GRAS_2D_SRC_TL_X, 6));
+		put(&b, c->sx << 8);
+		put(&b, (c->sx + c->w - 1) << 8);
+		put(&b, 0);
+		put(&b, (rows - 1) << 8);
+		put(&b, x);
+		put(&b, (x + c->w - 1) | (rows - 1) << 16);
+		/* emit_blit_src: linear BGRA8, nearest */
+		put(&b, pkt4(SP_PS_2D_SRC_INFO, 5));
+		put(&b, SURF_INFO_BGRA | SRC_INFO_UNK20_UNK22);
+		put(&b, width | rows << 15);
+		put(&b, (uint32_t)src);
+		put(&b, (uint32_t)(src >> 32));
+		put(&b, spitch << 3);
+		put(&b, pkt4(SP_PS_2D_SRC_FLAGS, 3));
+		put(&b, 0);
+		put(&b, 0);
+		put(&b, 0);
+		/* emit_blit_dst */
+		put(&b, pkt4(RB_2D_DST_INFO, 4));
+		put(&b, SURF_INFO_BGRA);
+		put(&b, (uint32_t)dst);
+		put(&b, (uint32_t)(dst >> 32));
+		put(&b, dpitch >> 6);
+		put(&b, pkt4(RB_2D_DST_FLAGS, 3));
+		put(&b, 0);
+		put(&b, 0);
+		put(&b, 0);
+		/* emit_blit_fini (RB_DBG_ECO_CNTL_blit is 0 on the A730, as RB_DBG_ECO_CNTL) */
+		put(&b, pkt7(CP_WAIT_FOR_IDLE, 0));
+		put(&b, pkt7(CP_BLIT, 1));
+		put(&b, BLIT_OP_SCALE);
+		put(&b, pkt7(CP_WAIT_FOR_IDLE, 0));
+		blits++;
+	}
+	/* the pixels out of the CCU and the caches before the fence */
+	event(&b, EV_CCU_CLEAN_COLOR);
+	event(&b, EV_CACHE_CLEAN);
+	put(&b, pkt7(CP_WAIT_FOR_IDLE, 0));
+	return blits != 0 && b.n <= b.max ? b.n : 0;
+}
+
+#endif /* !KERNEL || ARM64_BOARD_CONFIG_NEGRONI */
diff --git a/bsd/dev/negroni_gpu_blit.h b/bsd/dev/negroni_gpu_blit.h
new file mode 100644
index 0000000..7b87559
--- /dev/null
+++ b/bsd/dev/negroni_gpu_blit.h
@@ -0,0 +1,43 @@
+/*
+ * NEGRONI: A730 2D-engine copy of a BGRA8 rectangle (the panel present of
+ * iokit/Kernel/arm/NegroniGPU.cpp). Pure C, no kernel headers: the host test
+ * patches/xnu/tests/gpu-blit-ib-test.c (project repo) builds this file as it is.
+ */
+#ifndef _NEGRONI_GPU_BLIT_H
+#define _NEGRONI_GPU_BLIT_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Copy w x h pixels (4 bytes each, B G R A, no conversion) from (sx, sy) of
+ * the source image to (dx, dy) of the destination image. Addresses are GPU
+ * addresses of row 0, pixel 0. The source must be 64-byte aligned with a
+ * pitch that is a multiple of 64; the destination 64-byte aligned with a
+ * pitch that is a multiple of 32 (the panel's 4320 is 32 * 135, not 64 * n).
+ */
+struct negroni_gpu_copy {
+	uint64_t src;
+	uint32_t src_pitch;
+	uint64_t dst;
+	uint32_t dst_pitch;
+	uint32_t sx, sy, dx, dy, w, h;
+};
+
+/* Words the IB of one copy needs at most. */
+#define NEGRONI_GPU_COPY_WORDS  256
+
+/*
+ * Writes the command stream (PM4 type 4/7 packets) into ib and returns its
+ * length in words; 0 when the copy cannot be expressed (alignment, sizes).
+ */
+uint32_t negroni_gpu_copy_ib(const struct negroni_gpu_copy *c, uint32_t *ib, uint32_t max_words);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _NEGRONI_GPU_BLIT_H */
