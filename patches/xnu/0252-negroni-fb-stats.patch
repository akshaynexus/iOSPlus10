+/*
+ * Per-second statistics (0252): from vsyncFired, work loop only. A late tick came more than
+ * 1.5 vsync periods after the one before. One line per second; all counters start again.
+ */
+static uint64_t
+negroni_fb_abs_us(uint64_t abs)
+{
+	uint64_t ns;
+
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000;
+}
+
+void
+AppleCLCD::statTick(uint64_t now)
+{
+	if (fStatLastTick != 0 && now - fStatLastTick > fStatLateAbs) {
+		fStatLate++;
+	}
+	fStatLastTick = now;
+	if (fStatT0 == 0) {
+		fStatT0 = now;
+		return;
+	}
+	if (now - fStatT0 < fStatSecAbs) {
+		return;
+	}
+	uint32_t swaps = __atomic_exchange_n(&fStatSwaps, 0, __ATOMIC_RELAXED);
+	uint32_t waits = __atomic_exchange_n(&fStatWaits, 0, __ATOMIC_RELAXED);
+	uint32_t timeouts = __atomic_exchange_n(&fStatWaitTimeouts, 0, __ATOMIC_RELAXED);
+	uint64_t waitAbs = __atomic_exchange_n(&fStatWaitAbs, 0, __ATOMIC_RELAXED);
+	uint64_t waitMax = __atomic_exchange_n(&fStatWaitMaxAbs, 0, __ATOMIC_RELAXED);
+	uint32_t copies = fStatCPU + fStatGPU;
+	IOLog("NEGRONI FB STAT: swaps/s %u presents/s %u (cpu %u gpu %u zc %u) copy avg/max us %llu/%llu "
+	    "late ticks %u swapwait calls %u waited us avg/max %llu/%llu timeouts %u\n",
+	    swaps, copies + fStatZC, fStatCPU, fStatGPU, fStatZC,
+	    copies ? negroni_fb_abs_us(fStatCopyAbs) / copies : 0, negroni_fb_abs_us(fStatCopyMaxAbs),
+	    fStatLate, waits, waits ? negroni_fb_abs_us(waitAbs) / waits : 0, negroni_fb_abs_us(waitMax), timeouts);
+	fStatT0 = now;
+	fStatCPU = fStatGPU = fStatZC = fStatLate = 0;
+	fStatCopyAbs = fStatCopyMaxAbs = 0;
+}
+
