+ * NEGRONI_TE_TARGET_DEFAULT). negronifb_vrr=1: after negronifb_vrr_ms without a swap the panel
+ * holds each picture for 120/negronifb_vrr_fps TEs (DCS BD[0x14]) and the auto-refresh sends one
+ * frame per that many TEs; =2: the panel's 60 Hz (or 90 Hz, negronifb_vrr_fps=90) timing-switch
+ * command set, back to the 120 Hz set on the next swap; =3: the auto-refresh divider only (no
+ * DCS). negronifb_vrr_hs=1|0 forces the DCS transmission mode (default: high-speed for mode 2 as
+ * Android's dsi_hs_mode, low-power for mode 1 like the brightness). All default off.
+ */
+void
+AppleCLCD::teInit(void)
+{
+	uint32_t te = 0, vrr = 0, fps = NEGRONI_VRR_FPS_DEFAULT, ms = NEGRONI_VRR_IDLE_MS_DEFAULT;
+	int32_t off = NEGRONI_TE_TARGET_DEFAULT, hs = -1;
+
+	PE_parse_boot_argn("negronifb_te", &te, sizeof(te));
+	PE_parse_boot_argn("negronifb_te_off", &off, sizeof(off));
+	PE_parse_boot_argn("negronifb_vrr", &vrr, sizeof(vrr));
+	PE_parse_boot_argn("negronifb_vrr_fps", &fps, sizeof(fps));
+	PE_parse_boot_argn("negronifb_vrr_ms", &ms, sizeof(ms));
+	PE_parse_boot_argn("negronifb_vrr_hs", &hs, sizeof(hs));
+	if (te == 0 && vrr == 0) {
+		return;
+	}
+	fIntf = fMdss != 0 ? fMdss + NEGRONI_INTF1_OFF :
+	    ml_io_map_unmappable(NEGRONI_INTF1_PA, NEGRONI_INTF1_LEN, NEGRONI_WIMG_IO);
+	if (fIntf == 0) {
+		IOLog("NEGRONI FB TE: no mapping of INTF_1 (0x%lx): negronifb_te/vrr off\n", NEGRONI_INTF1_PA);
+		return;
+	}
+	uint32_t cfg = negroni_dpu_rd(fIntf + INTF_TEAR_SYNC_CONFIG_VSYNC);
+	uint32_t count = negroni_dpu_rd(fIntf + INTF_TEAR_INT_COUNT_VAL);
+	uint32_t ar = negroni_dpu_rd(fIntf + INTF_TEAR_AUTOREFRESH_CONFIG);
+	uint32_t vsyncCount = cfg & 0x7ffffu;
+	fTeInit = negroni_dpu_rd(fIntf + INTF_TEAR_VSYNC_INIT_VAL) & 0xffffu;
+	fTeLineNs = vsyncCount != 0 ? (uint32_t)((uint64_t)vsyncCount * 1000000000ull / NEGRONI_TE_VSYNC_CLK_HZ) : 0;
+	IOLog("NEGRONI FB TE: INTF_1 tear_en %u sync_cfg 0x%08x (te pin %u, counter %u, vsync_count %u = %u ns/line) "
+	    "height %u init %u start %u thresh 0x%08x rd_ptr_irq %u wr_ptr_irq %u wrcount 0x%08x autorefresh 0x%08x "
+	    "count 0x%08x (frame %u line %u) tear_line %u vsync_sel %u intf_status 0x%x frame_count %u tear_irq 0x%08x\n",
+	    negroni_dpu_rd(fIntf + INTF_TEAR_TEAR_CHECK_EN), cfg, (cfg >> 20) & 1u, (cfg >> 19) & 1u, vsyncCount, fTeLineNs,
+	    negroni_dpu_rd(fIntf + INTF_TEAR_SYNC_CONFIG_HEIGHT) & 0xffffu, fTeInit,
+	    negroni_dpu_rd(fIntf + INTF_TEAR_START_POS) & 0xffffu, negroni_dpu_rd(fIntf + INTF_TEAR_SYNC_THRESH),
+	    negroni_dpu_rd(fIntf + INTF_TEAR_RD_PTR_IRQ) & 0xffffu, negroni_dpu_rd(fIntf + INTF_TEAR_WR_PTR_IRQ) & 0xffffu,
+	    negroni_dpu_rd(fIntf + INTF_TEAR_SYNC_WRCOUNT), ar, count, count >> 16, count & 0xffffu,
+	    negroni_dpu_rd(fIntf + INTF_TEAR_LINE_COUNT) & 0xffffu, negroni_dpu_rd(fIntf + INTF_TEAR_MDP_VSYNC_SEL),
+	    negroni_dpu_rd(fIntf + INTF_STATUS), negroni_dpu_rd(fIntf + INTF_FRAME_COUNT),
+	    negroni_dpu_rd(fIntf + INTF_TEAR_INTR_STATUS));
+	if (te != 0) {
+		if (fTeLineNs == 0) {
+			IOLog("NEGRONI FB TE: vsync_count 0: no line clock, negronifb_te off\n");
+		} else {
+			fTeMode = te;
+			fTeTarget = off;
+			if (te >= 2) {
+				negroni_dpu_wr(fIntf + INTF_VSYNC_TIMESTAMP_CTRL, 1);
+			}
+			IOLog("NEGRONI FB TE: lock on, target %d us %s the TE\n", off < 0 ? -off : off, off < 0 ? "before" : "after");
+		}
+	}
+	if (vrr != 0) {
+		if (vrr != 1 && vrr != 2 && vrr != 3) {
+			IOLog("NEGRONI FB VRR: negronifb_vrr=%u unknown: off\n", vrr);
+		} else if (vrr != 2 && ar != NEGRONI_VRR_AR_ON_1) {
+			IOLog("NEGRONI FB VRR: autorefresh 0x%08x is not on/1 as the UEFI leaves it: mode %u off\n", ar, vrr);
+		} else {
+			fVrrCall = thread_call_allocate(&AppleCLCD::vrrCall, this);
+			if (fVrrCall == NULL) {
+				IOLog("NEGRONI FB VRR: no thread call: off\n");
+				return;
+			}
+			fVrrMode = vrr;
+			/* Android sends the timing-switch sets in dsi_hs_mode, the brightness in LP (0250 default) */
+			fVrrHS = hs < 0 ? vrr == 2 : hs != 0;
+			fVrrIdleAbs = negroni_fb_us_abs((uint64_t)(ms < 200 ? 200 : ms) * 1000ull);
+			if (vrr == 2) {
+				fVrrFps = fps == 90 ? 90 : 60;
+				fVrrExt = 0;
+				fVrrDiv = 1;
+			} else {
+				fps = fps == 0 ? 1 : (fps > 120 ? 120 : fps);
+				fVrrExt = 120 / fps - 1;        /* 10 Hz -> 0x0b, 1 Hz -> 0x77 */
+				fVrrExt = fVrrExt > 0x77 ? 0x77 : fVrrExt;
+				fVrrDiv = fVrrExt + 1;
+				fVrrFps = 120 / fVrrDiv;
+			}
+			fLastSwapAbs = mach_absolute_time();
+			IOLog("NEGRONI FB VRR: mode %u, idle %u Hz (hold 0x%02x, autorefresh 1/%u) after %u ms without a swap, DCS %s\n",
+			    vrr, fVrrFps, fVrrExt, fVrrDiv, ms, fVrrHS ? "HS" : "LP");
+		}
+	}
+}
+
+/*
+ * One tick: the tearcheck counter restarts at fTeInit on each TE and counts lines, so
+ * (line - init) * line time = the time since the TE. The phase is taken at this tick's
+ * deadline (a late handler start is not a phase error), compared with the target, and half
+ * the error moves the next deadline (bounded to a quarter period). The TE period itself is
+ * frames per second from the counter's frame field, and the tick period follows it when it
+ * is within 15 % of the nominal one.
+ */
+void
+AppleCLCD::teTick(uint64_t now)
+{
+	uint32_t v = negroni_dpu_rd(fIntf + INTF_TEAR_INT_COUNT_VAL);
+	uint32_t frame = v >> 16, line = v & 0xffffu;
+	uint64_t nominalNs;
+
+	absolutetime_to_nanoseconds(fTickNominalAbs, &nominalNs);
+	uint32_t nominalUs = (uint32_t)(nominalNs / 1000);
+	if (!fTeSeen) {
+		fTeSeen = true;
+		fTeLastFrame = fTeFirstFrame = frame;
+		fTeFirstAbs = now;
+		return;
+	}
+	uint32_t df = (frame - fTeLastFrame) & 0xffffu;
+	fTeLastFrame = frame;
+	fTeFrames += df;
+	if (df == 0) {
+		if (++fTeStopped == 120) {
+			IOLog("NEGRONI FB TE: no TE for 120 ticks (count 0x%08x)\n", v);
+		}
+	} else {
+		if (fTeStopped >= 120) {
+			IOLog("NEGRONI FB TE: TE back after %u ticks\n", fTeStopped);
+			fTeFirstFrame = frame;
+			fTeFirstAbs = now;
+		}
+		fTeStopped = 0;
+	}
+	uint64_t window = now - fTeFirstAbs;
+	uint32_t frames = (frame - fTeFirstFrame) & 0xffffu;
+	if (window >= fStatSecAbs && frames != 0) {
+		fTePeriodUs = (uint32_t)(negroni_fb_abs_us(window) / frames);
+		fTeFirstFrame = frame;
+		fTeFirstAbs = now;
+		/* the tick period follows the measured TE period (bounded; the nominal one when unsure) */
+		uint32_t lo = nominalUs - nominalUs * 15 / 100, hi = nominalUs + nominalUs * 15 / 100;
+		fTickAbs = (fTePeriodUs >= lo && fTePeriodUs <= hi) ? negroni_fb_us_abs(fTePeriodUs) : fTickNominalAbs;
+	}
+	uint32_t periodUs = fTePeriodUs != 0 ? fTePeriodUs : nominalUs;
+	if (fTeStopped != 0 && df == 0 && fTeStopped > 2) {
+		fTeNoSample++;
+		return;                 /* no TE for several ticks: no phase to lock on */
+	}
+	if (line < fTeInit) {
+		fTeNoSample++;
+		return;
+	}
+	uint64_t sinceTeNs = (uint64_t)(line - fTeInit) * fTeLineNs;
+	if (sinceTeNs > 2ull * periodUs * 1000ull) {
+		fTeNoSample++;
+		return;                 /* the counter ran past a frame: no TE came */
+	}
+	int64_t lateNs = 0;
+	if (now > fDeadline) {
+		uint64_t ns;
+		absolutetime_to_nanoseconds(now - fDeadline, &ns);
+		lateNs = (int64_t)ns;
+	}
+	int32_t phase = (int32_t)(((int64_t)sinceTeNs - lateNs) / 1000);
+	while (phase < 0) {
+		phase += (int32_t)periodUs;
+	}
+	phase %= (int32_t)periodUs;
+	int32_t target = fTeTarget < 0 ? (int32_t)periodUs + fTeTarget : fTeTarget;
+	target = target < 0 ? 0 : (target >= (int32_t)periodUs ? (int32_t)periodUs - 1 : target);
+	int32_t err = phase - target;
+	if (err > (int32_t)periodUs / 2) {
+		err -= (int32_t)periodUs;
+	} else if (err < -(int32_t)periodUs / 2) {
+		err += (int32_t)periodUs;
+	}
+	/* err > 0: this tick came after the target: the next deadline comes sooner */
+	int32_t adj = -err / 2;
+	int32_t bound = (int32_t)periodUs / 4;
+	adj = adj > bound ? bound : (adj < -bound ? -bound : adj);
+	fTePhaseUs = phase;
+	fTeErrUs = err;
+	fTeAdjUs = adj;
+	fTeAdjAbs = adj >= 0 ? (int64_t)negroni_fb_us_abs((uint64_t)adj) : -(int64_t)negroni_fb_us_abs((uint64_t)(-adj));
+	fTeSamples++;
+	fTeErrSum += err < 0 ? -err : err;
+	if ((err < 0 ? -err : err) > fTeErrMax) {
+		fTeErrMax = err < 0 ? -err : err;
+	}
+	if ((err < 0 ? -err : err) <= NEGRONI_TE_LOCK_US) {
+		fTeLocked++;
+	}
+}
+
+/* One line per second after the STAT line (statTick). */
+void
+AppleCLCD::teLog(void)
+{
+	if (fTeMode != 0 && fIntf != 0) {
+		uint32_t frames = fTeFrames;
+		fTeFrames = 0;
+		char ts[48] = "";
+		if (fTeMode >= 2) {
+			uint64_t t = (uint64_t)negroni_dpu_rd(fIntf + INTF_VSYNC_TIMESTAMP1) << 32 |
+			    negroni_dpu_rd(fIntf + INTF_VSYNC_TIMESTAMP0);
+			snprintf(ts, sizeof(ts), " ts 0x%llx (+%llu)", t, t - fTeTs);
+			fTeTs = t;
+		}
+		IOLog("NEGRONI FB TE: te/s %u period us %u tick us %llu phase us %d target %d err avg/max us %lld/%d "
+		    "adj us %d locked %u/%u ticks (no sample %u) count 0x%08x autorefresh 0x%08x%s\n",
+		    frames, fTePeriodUs, negroni_fb_abs_us(fTickAbs), fTePhaseUs,
+		    fTeTarget < 0 ? (int32_t)(fTePeriodUs != 0 ? fTePeriodUs : 8333) + fTeTarget : fTeTarget,
+		    fTeSamples != 0 ? fTeErrSum / fTeSamples : 0, fTeErrMax, fTeAdjUs, fTeLocked, fTeSamples, fTeNoSample,
+		    negroni_dpu_rd(fIntf + INTF_TEAR_INT_COUNT_VAL), negroni_dpu_rd(fIntf + INTF_TEAR_AUTOREFRESH_CONFIG), ts);
+		fTeLocked = fTeSamples = fTeNoSample = 0;
+		fTeErrSum = 0;
+		fTeErrMax = 0;
+	}
+	if (fVrrMode != 0) {
+		IOLockLock(fLock);
+		uint32_t state = fVrrState;
+		uint64_t idleAbs = fVrrIdleTotalAbs + (state == kNegroniVrrIdle ? mach_absolute_time() - fVrrIdleAt : 0);
+		IOLockUnlock(fLock);
+		static const char *const names[] = { "active", "going idle", "idle", "waking" };
+		IOLog("NEGRONI FB VRR: %s (idle %u Hz)%s, %u idle periods, idle %llu ms in all, DCS errors %u\n",
+		    names[state & 3], fVrrFps, fVrrDisabled ? " OFF after a failed switch" : "", fVrrIdleCount,
+		    negroni_fb_abs_us(idleAbs) / 1000, fVrrDcsErrors);
+	}
+}
+
+/* Work loop, fLock held: no swap for negronifb_vrr_ms while the display is on: go idle. */
+void
+AppleCLCD::vrrTick(uint64_t now)
+{
+	if (fVrrMode == 0 || fVrrDisabled || fPowerOff || fVrrState != kNegroniVrrActive || fLastSwapAbs == 0 ||
+	    now - fLastSwapAbs < fVrrIdleAbs) {
+		return;
+	}
+	fVrrState = kNegroniVrrGoingIdle;
+	if (!fVrrBusy) {
+		fVrrBusy = true;
+		thread_call_enter(fVrrCall);
+	}
+}
+
+/*
+ * fLock held, any thread (swap: backboardd; RequestPowerChange; the tick). Back to the full
+ * rate: the auto-refresh divider goes back at once (one register write, the engine sends the
+ * next frame on the next TE), the DCS follows on the thread call.
+ */
+void
+AppleCLCD::vrrWakeLocked(void)
+{
+	if (fVrrMode == 0 || fVrrState == kNegroniVrrActive || fVrrState == kNegroniVrrWaking) {
+		return;
+	}
+	if (fVrrMode != 2 && fIntf != 0) {
+		negroni_dpu_wr(fIntf + INTF_TEAR_AUTOREFRESH_CONFIG, NEGRONI_VRR_AR_ON_1);
+	}
+	fVrrState = kNegroniVrrWaking;
+	if (!fVrrBusy) {
+		fVrrBusy = true;
+		thread_call_enter(fVrrCall);
+	}
+}
+
+void
+AppleCLCD::vrrCall(thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	((AppleCLCD *)p0)->vrrWork();
+}
+
+/* Mode 2: the tick, CoreAnimation's interval and the refresh property follow the panel rate. */
+void
+AppleCLCD::vrrSetRate(uint32_t fps)
+{
+	uint64_t ticks = negroni_fb_us_abs(1000000ull / fps);
+
+	fTickNominalAbs = ticks;
+	fTickAbs = ticks;
+	fStatLateAbs = ticks / 2;
+	fTePeriodUs = 0;        /* measured again at the new rate */
+	if (fRefreshTicks != 0) {
+		fRefreshTicks = ticks;
+		OSDictionary *refresh = OSDictionary::withCapacity(2);
+		OSNumber *step = OSNumber::withNumber(ticks, 64);
+		OSNumber *min = OSNumber::withNumber(1ULL, 32);
+		if (refresh != NULL && step != NULL && min != NULL) {
+			refresh->setObject("displayRefreshStepMachTime", step);
+			refresh->setObject("displayMinRefreshInterval", min);
+			setProperty("IOMFBDisplayRefresh", refresh);
+		}
+		OSSafeReleaseNULL(refresh);
+		OSSafeReleaseNULL(step);
+		OSSafeReleaseNULL(min);
+	}
+}
+
+/*
+ * Thread call: bring the panel to the wanted state until it is stable. The DCS writes sleep on
+ * the DSI lock and wait for the MDP stream (NegroniBacklight.cpp), so they never run on the
+ * vsync work loop or on backboardd's thread.
+ */
+void
+AppleCLCD::vrrWork(void)
+{
+	for (;;) {
+		IOLockLock(fLock);
+		bool wantIdle = fVrrState == kNegroniVrrGoingIdle || fVrrState == kNegroniVrrIdle;
+		if (wantIdle == fVrrApplied) {
+			fVrrState = wantIdle ? kNegroniVrrIdle : kNegroniVrrActive;
+			fVrrBusy = false;
+			IOLockUnlock(fLock);
+			return;
+		}
+		IOLockUnlock(fLock);
+
+		bool lp = true;
+		bool ready = negroni_backlight_panel_ready(&lp);
+		lp = !fVrrHS && lp;
+		uint64_t t0 = mach_absolute_time();
+		int rc = 0;
+		uint32_t sent = 0;
+		if (wantIdle && !ready) {
+			/* the display is off or there is no DSI: stay at the full rate */
+			IOLockLock(fLock);
+			if (fVrrState == kNegroniVrrGoingIdle) {
+				fVrrState = kNegroniVrrActive;
+				fLastSwapAbs = mach_absolute_time();
+			}
+			IOLockUnlock(fLock);
+			continue;
+		}
+		if (fVrrMode == 2) {
+			if (wantIdle) {
+				rc = fVrrFps == 90 ?
+				    negroni_dsi_dcs_set(negroni_vrr_switch_90, sizeof(negroni_vrr_switch_90), lp, &sent) :
+				    negroni_dsi_dcs_set(negroni_vrr_switch_60, sizeof(negroni_vrr_switch_60), lp, &sent);
+				if (rc == 0) {
+					vrrSetRate(fVrrFps);
+				}
+			} else {
+				if (ready) {
+					rc = negroni_dsi_dcs_set(negroni_vrr_switch_120, sizeof(negroni_vrr_switch_120), lp, &sent);
+				}
+				vrrSetRate(120);
+			}
+		} else {
+			if (wantIdle) {
+				if (fVrrMode == 1) {
+					uint8_t set[sizeof(negroni_vrr_minfps_set)];
+					memcpy(set, negroni_vrr_minfps_set, sizeof(set));
+					set[NEGRONI_VRR_MINFPS_EXT_OFF] = (uint8_t)fVrrExt;
+					rc = negroni_dsi_dcs_set(set, sizeof(set), lp, &sent);
+				}
+				if (rc == 0) {
+					negroni_dpu_wr(fIntf + INTF_TEAR_AUTOREFRESH_CONFIG, 1u << 31 | fVrrDiv);
+				}
+			} else {
+				negroni_dpu_wr(fIntf + INTF_TEAR_AUTOREFRESH_CONFIG, NEGRONI_VRR_AR_ON_1);
+				if (fVrrMode == 1 && ready) {
+					rc = negroni_dsi_dcs_set(negroni_vrr_minfps_set, sizeof(negroni_vrr_minfps_set), lp, &sent);
+				}
+			}
+		}
+		uint64_t ms = negroni_fb_abs_us(mach_absolute_time() - t0) / 1000;
+		IOLockLock(fLock);
+		if (rc != 0) {
+			fVrrDcsErrors++;
+		}
+		if (wantIdle && rc == 0) {
+			fVrrApplied = true;
+			fVrrIdleAt = mach_absolute_time();
+			fVrrIdleCount++;
+			IOLockUnlock(fLock);
+			IOLog("NEGRONI FB VRR: idle %u Hz (hold 0x%02x, autorefresh 1/%u, %u DCS packets, %llu ms)\n",
+			    fVrrFps, fVrrExt, fVrrDiv, sent, ms);
+		} else if (wantIdle) {
+			/*
+			 * The switch failed: VRR off for this boot (a retry every idle period would reach
+			 * 0250's three-failure DSI shutdown and take the brightness and the 0258 sleep DCS
+			 * with it). The auto-refresh divider was not written. Close the Samsung key in
+			 * case the set stopped inside it (best effort).
+			 */
+			fVrrState = kNegroniVrrActive;
+			fVrrDisabled = true;
+			fLastSwapAbs = mach_absolute_time();
+			IOLockUnlock(fLock);
+			if (rc != -1 && rc != -2) {
+				static const uint8_t keyLock[3] = { 0xf0, 0xa5, 0xa5 };
+				(void)negroni_dsi_dcs_write(keyLock, sizeof(keyLock), lp);
+			}
+			IOLog("NEGRONI FB VRR: idle switch failed (%d after %u packets): VRR off\n", rc, sent);
+		} else {
+			uint64_t idle = fVrrApplied ? mach_absolute_time() - fVrrIdleAt : 0;
+			fVrrApplied = false;
+			fVrrIdleTotalAbs += idle;
+			IOLockUnlock(fLock);
+			IOLog("NEGRONI FB VRR: active 120 Hz after %llu ms idle (%u DCS packets, %llu ms%s)\n",
+			    negroni_fb_abs_us(idle) / 1000, sent, ms, rc != 0 ? ", DCS failed" : "");
+		}
+	}
 }
 
