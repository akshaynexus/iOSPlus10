+/*
+ * 0259: send a command set in the Qualcomm device-tree format (dsi_panel.c
+ * dsi_panel_create_cmd_packets: per packet a 7-byte header {type, last, vc,
+ * flags, wait ms, length hi, length lo} then the payload). Each packet goes
+ * out as one FIFO DMA (negroni_dsi_dcs_write: the type comes from the length,
+ * which is the same for 0x05/0x15/0x39; generic types are refused), behind the
+ * same MDP-not-busy wait; a wait byte is honoured after the packet. Thread
+ * context only. 0 when every packet went out, else the first error, and
+ * *sent gets the number of packets that did.
+ */
+extern "C" int
+negroni_dsi_dcs_set(const uint8_t *set, uint32_t len, bool lp, uint32_t *sent)
+{
+	uint32_t i = 0, n = 0;
+	int rc = 0;
+
+	while (i + 7 <= len && rc == 0) {
+		uint8_t type = set[i], wait = set[i + 4];
+		uint32_t plen = (uint32_t)set[i + 5] << 8 | set[i + 6];
+		if (plen == 0 || i + 7 + plen > len) {
+			rc = -4;
+			break;
+		}
+		if (type != 0x05 && type != 0x15 && type != 0x39) {
+			rc = -5;        /* generic packets are not expected in these sets */
+			break;
+		}
+		rc = negroni_dsi_dcs_write(set + i + 7, plen, lp);
+		if (rc == 0) {
+			n++;
+			if (wait != 0) {
+				IOSleep(wait);
+			}
+		}
+		i += 7 + plen;
+	}
+	if (sent != NULL) {
+		*sent = n;
+	}
+	return rc;
+}
