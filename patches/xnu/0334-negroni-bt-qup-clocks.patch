diff --git a/bsd/dev/negroni_rpmh.c b/bsd/dev/negroni_rpmh.c
index bfa7678..c6502ec 100644
--- a/bsd/dev/negroni_rpmh.c
+++ b/bsd/dev/negroni_rpmh.c
@@ -674,4 +674,73 @@ negroni_rpmh_bt_enable(const char *res, unsigned mv)
 	}
 	return EINVAL;
 }
+
+/*
+ * 0334 (iOSPlus10): the QUP core BCM vote of a GENI serial engine (negroni_bt.c step 4). Linux: the SE's
+ * "qup-core" icc path qupN_core_master -> qupN_core_slave (drivers/interconnect/qcom/sm8450.c: clk_virt,
+ * bcm_qupN "QUPN", keepalive, vote_scale 1, slave buswidth 4, 1 channel), set by geni_icc_enable. Vote as
+ * bcm-voter.c bcm_aggregate: x = div(avg * width, buswidth * channels) * vote_scale / unit, y = div(peak *
+ * width, buswidth) * vote_scale / unit, a non-zero value below 1 rounds up to 1 (bcm_div), 14-bit clamp;
+ * keepalive: never 0. Width and unit come from the cmd-db aux data. One AMC command, commit set.
+ * The AMC vote of this DRV only adds to the other voters (the BCM takes the max), so it never lowers the
+ * QUP clock. Never voted off.
+ */
+int negroni_rpmh_qup_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uint32_t *data_out);
+
+static uint64_t
+rh_bcm_div(uint64_t num, uint64_t base)
+{
+	if (!num) {
+		return 0;
+	}
+	if (num < base) {
+		return 1;
+	}
+	return num / base;
+}
+
+int
+negroni_rpmh_qup_bcm(const char *res, uint32_t avg_kbps, uint32_t peak_kbps, uint32_t *data_out)
+{
+	if (!res || (strcmp(res, "QUP0") && strcmp(res, "QUP1") && strcmp(res, "QUP2")) || avg_kbps > 100000u ||
+	    peak_kbps > 100000u) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0, unit = 0, width = 0;
+	if (rh_poisoned) {
+		printf("NEGRONI RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup_bcm(res, &address, &unit, &width);
+	}
+	if (!error) {
+		const uint64_t buswidth = 4, channels = 1, vote_scale = 1;
+		uint64_t x = rh_bcm_div(rh_bcm_div((uint64_t)avg_kbps * width, buswidth * channels) * vote_scale, unit);
+		uint64_t y = rh_bcm_div(rh_bcm_div((uint64_t)peak_kbps * width, buswidth) * vote_scale, unit);
+		if (x == 0 && y == 0) {
+			x = y = 1;      /* keepalive */
+		}
+		x = MIN(x, 0x3fffull);
+		y = MIN(y, 0x3fffull);
+		uint32_t data = 1u << 30 | 1u << 29 | (uint32_t)x << 14 | (uint32_t)y;
+		printf("NEGRONI RPMH: BCM %s avg %u peak %u kBps (unit %u width %u) -> x %llu y %llu, data %#x\n", res,
+		    avg_kbps, peak_kbps, unit, width, x, y, data);
+		if (data_out) {
+			*data_out = data;
+		}
+		error = rh_send(address, data, RH_MODE_BCM);
+	}
+out:
+	if (error) {
+		printf("NEGRONI RPMH: BCM %s vote failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_NEGRONI */
