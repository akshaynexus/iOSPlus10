+		    gl_ch[1].remote_open, gl_ch[1].open_acked, gl_dead ? ", GLINK stopped" : "");
+		return false;
+	}
+	for (unsigned c = 0; c < NEGRONI_GLINK_CHANNELS; c++) {
+		for (unsigned i = 0; i < (c == 0 ? 4u : 8u); i++) {         /* leaves 4 slots for RX_INTENT_REQ */
+			if (!gl_add_intent(&gl_ch[c], GL_INTENT_SIZE)) {
+				FAIL("GLINK: %s: intent %u not given", gl_ch[c].name, i);
+				return false;
+			}
+		}
+		say("GLINK: channel %s open (lcid %u rcid %u), %u intents of %u bytes given", gl_ch[c].name, gl_ch[c].lcid,
+		    gl_ch[c].rcid, gl_ch[c].nours, GL_INTENT_SIZE);
+	}
+	negroni_glink_poll();
+	say("GLINK UP after %u ms", ms);
+	return true;
+}
