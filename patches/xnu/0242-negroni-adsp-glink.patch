+/*
+ * NEGRONI (SM8450) audio DSP: the interface between negroni_adsp.c (stage (a): ADSP start, step 9
+ * GLINK) and stage (b) (patch 0243). iOSPlus10 docs/audio-plan.md. One recursive mutex (gl_lock) inside the public GLINK API serializes its callers.
+ */
+#ifndef _NEGRONI_ADSP_H_
+#define _NEGRONI_ADSP_H_
+
+#define NEGRONI_GLINK_CHANNELS  2
+#define NEGRONI_GLINK_IPCRTR    0       /* QRTR */
+#define NEGRONI_GLINK_GPR       1       /* "adsp_apps": GPR */
+
+/* GLINK (negroni_adsp.c) */
+void negroni_glink_poll(void);
+bool negroni_glink_up(unsigned channel);
+void negroni_glink_set_rx(unsigned channel, void (*fn)(const uint8_t *data, uint32_t len));
+int negroni_glink_send(unsigned channel, const void *data, uint32_t len);
