+/* ---- GLINK over SMEM (step 9; Linux qcom_glink_smem.c + qcom_glink_native.c, read for the protocol) ---- */
+
+/*
+ * Transport: item 478 = 4 words {our TX tail, our TX head, our RX tail, our RX head} (32 bytes),
+ * item 479 = our TX FIFO (16 KiB, we allocate), item 480 = our RX FIFO (the ADSP allocates it).
+ * Every message is padded to 8 bytes; the heads and tails stay 8-byte aligned, so the 32-bit
+ * copies below never cross the FIFO end inside a word. IPCC client 3 signal 0 is the doorbell
+ * (live DT glink-edge "lpass": mboxes <&ipcc 3 0>). No interrupt: negroni_glink_poll() is called
+ * by any client (the ADSP thread, the /dev/negroni-audio writer, the charger client); gl_lock, a
+ * recursive mutex inside the public API, serializes them.
+ */
+#define GLINK_FIFO_SIZE         0x4000u
+#define GLINK_RESERVE           16u             /* FIFO_FULL_RESERVE + TX_BLOCKED_CMD_RESERVE */
+#define IPCC_SIGNAL_GLINK       0u
+#define GL_VERSION              0
+#define GL_VERSION_ACK          1
+#define GL_OPEN                 2
+#define GL_CLOSE                3
+#define GL_OPEN_ACK             4
+#define GL_INTENT               5
+#define GL_RX_DONE              6
+#define GL_RX_INTENT_REQ        7
+#define GL_RX_INTENT_REQ_ACK    8
+#define GL_TX_DATA              9
+#define GL_CLOSE_ACK            11
+#define GL_TX_DATA_CONT         12
+#define GL_READ_NOTIF           13
+#define GL_RX_DONE_W_REUSE      14
+#define GL_SIGNALS              15
+#define GL_FEATURE_INTENT_REUSE 1u
+#define GL_OURS                 12              /* local (RX) intents per channel (8 given at open, 4 for RX_INTENT_REQ) */
+#define GL_THEIRS               32              /* remote (TX) intents per channel */
+#define GL_INTENT_SIZE          4096u           /* our default RX intents and our largest TX message */
+#define GL_INTENT_MAX           0x4400u         /* largest RX intent we grant (live DT IPCRTR intents: 5 x 0x800, 3 x 0x2000, 2 x 0x4400) */
+#define GL_MSG_MAX              (GL_INTENT_MAX + 16)
+#define GL_LOG_MAX              8               /* lines per kind of repeated GLINK complaint */
+
+struct gl_intent {
+	uint32_t id, size;
+	bool used;
+};
+
+struct gl_channel {
+	const char *name;
+	uint16_t lcid, rcid;
+	bool open_sent, remote_open, open_acked, ack_sent, intents_sent;
+	int32_t req_result;                     /* RX_INTENT_REQ answer: -1 none yet */
+	struct gl_intent ours[GL_OURS];
+	uint8_t *buf[GL_OURS];
+	uint32_t fill[GL_OURS];                 /* bytes of a fragmented message so far */
+	uint32_t nours;
+	struct gl_intent theirs[GL_THEIRS];
+	void (*rx)(const uint8_t *data, uint32_t len);
+	uint64_t rx_count, tx_count;
+};
+
+static struct gl_channel gl_ch[NEGRONI_GLINK_CHANNELS] = {
+	{ .name = "IPCRTR", .lcid = 1 },        /* QRTR (stage (b): service discovery, servreg locator) */
+	{ .name = "adsp_apps", .lcid = 2 },     /* GPR (stage (b): APM, PRM) */
+};
+static uint32_t gl_desc, gl_tx, gl_rx, gl_rx_len, gl_features = GL_FEATURE_INTENT_REUSE, gl_next_liid = 1;
+static bool gl_version_ok, gl_dead, gl_notified;
+static uint8_t gl_msg[GL_MSG_MAX];
+static uint32_t gl_complaints;                  /* repeated-error lines printed so far (capped at GL_LOG_MAX) */
+#define gl_complain(fmt, ...) do { if (gl_complaints < GL_LOG_MAX) { gl_complaints++; say(fmt, ##__VA_ARGS__); } } while (0)
+
+/*
+ * One lock over the GLINK state (FIFO heads/tails, intents, the static TX buffer): the ADSP thread,
+ * the /dev/negroni-audio writer (0243) and the charger client (0274) all send. Recursive for the
+ * owning thread, because an RX callback inside negroni_glink_poll() may call negroni_glink_send().
+ */
+static LCK_GRP_DECLARE(gl_grp, "negroni_glink");
+static LCK_MTX_DECLARE(gl_mtx, &gl_grp);
+static thread_t gl_owner;
+static uint32_t gl_depth;
+
+static void
+gl_lock(void)
+{
+	if (gl_owner == current_thread()) {
+		gl_depth++;
+		return;
+	}
+	lck_mtx_lock(&gl_mtx);
+	gl_owner = current_thread();
+	gl_depth = 1;
+}
+
+static void
+gl_unlock(void)
+{
+	if (--gl_depth == 0) {
+		gl_owner = NULL;
+		lck_mtx_unlock(&gl_mtx);
+	}
+}
+
+static uint32_t
+gl_mod(uint32_t v, uint32_t len)
+{
+	return v >= len ? v - len : v;
+}
+
+static uint32_t
+gl_tx_avail(void)
+{
+	uint32_t tail = rd32(smem, gl_desc + 0), head = rd32(smem, gl_desc + 4);
+	uint32_t avail = tail <= head ? GLINK_FIFO_SIZE - head + tail : tail - head;
+
+	return avail < GLINK_RESERVE ? 0 : avail - GLINK_RESERVE;
+}
+
+/* One message (len a multiple of 8) into our TX FIFO, then the doorbell. ETIMEDOUT after 200 ms full. */
+static int
+gl_write(const void *msg, uint32_t len)
+{
+	const uint32_t *w = msg;
+	uint32_t head;
+
+	if (gl_dead || (len & 7) || len >= GLINK_FIFO_SIZE - GLINK_RESERVE) {
+		return EINVAL;
+	}
+	for (uint32_t ms = 0; gl_tx_avail() < len; ms++) {
+		if (ms == 200) {
+			gl_complain("GLINK: our TX FIFO stays full (tail %#x head %#x)", rd32(smem, gl_desc), rd32(smem, gl_desc + 4));
+			return ETIMEDOUT;
+		}
+		if (!gl_notified) {
+			uint32_t note[2] = { GL_READ_NOTIF, 0 };
+			gl_notified = true;
+			head = rd32(smem, gl_desc + 4);
+			uint32_t tl = rd32(smem, gl_desc + 0);
+			uint32_t raw = tl <= head ? GLINK_FIFO_SIZE - head + tl : tl - head;
+			if (raw > 8) {                  /* raw space: gl_tx_avail() already keeps the reserve back */
+				wr32(smem, gl_tx + head, note[0]);
+				wr32(smem, gl_tx + head + 4, note[1]);
+				wr32(smem, gl_desc + 4, gl_mod(head + 8, GLINK_FIFO_SIZE));
+				kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_GLINK);
+			}
+		}
+		IOSleep(1);
+	}
+	gl_notified = false;
+	head = rd32(smem, gl_desc + 4);
+	for (uint32_t i = 0; i < len / 4; i++) {
+		wr32(smem, gl_tx + head, w[i]);
+		head = gl_mod(head + 4, GLINK_FIFO_SIZE);
+	}
+	wr32(smem, gl_desc + 4, head);          /* wr32 orders the FIFO stores before the head */
+	kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_GLINK);
+	return 0;
+}
+
+static int
+gl_cmd(uint16_t cmd, uint16_t p1, uint32_t p2)
+{
+	uint32_t m[2] = { cmd | (uint32_t)p1 << 16, p2 };
+	return gl_write(m, sizeof(m));
+}
+
+static uint32_t
+gl_rx_avail(void)
+{
+	uint32_t size = 0;
+
+	if (gl_rx == 0) {
+		gl_rx = smem_item(ITEM_GLINK_FIFO1, &size);
+		if (gl_rx == 0) {
+			return 0;
+		}
+		gl_rx_len = size & ~7u;
+		say("GLINK: the ADSP's FIFO (item %u) is there: %#x bytes", ITEM_GLINK_FIFO1, size);
+		if (gl_rx_len < 64 || gl_rx_len > 0x100000) {
+			say("GLINK: FIFO size %#x is not usable", size);
+			gl_dead = true;
+			gl_rx = 0;
+			return 0;
+		}
+	}
+	uint32_t tail = rd32(smem, gl_desc + 8), head = rd32(smem, gl_desc + 12);
+	if (head >= gl_rx_len || tail >= gl_rx_len) {
+		say("GLINK: RX head %#x / tail %#x outside the FIFO (%#x): GLINK stopped", head, tail, gl_rx_len);
+		gl_dead = true;
+		return 0;
+	}
+	return head >= tail ? head - tail : gl_rx_len - tail + head;
+}
+
+/* Copy `len` bytes (rounded up to 4) at `off` past our RX tail. */
+static void
+gl_peek(uint32_t off, void *dst, uint32_t len)
+{
+	uint32_t *w = dst, at = gl_mod(rd32(smem, gl_desc + 8) + off, gl_rx_len);
+
+	for (uint32_t i = 0; i < (len + 3) / 4; i++) {
+		w[i] = rd32(smem, gl_rx + at);
+		at = gl_mod(at + 4, gl_rx_len);
+	}
+}
+
+static void
+gl_advance(uint32_t len)
+{
+	wr32(smem, gl_desc + 8, gl_mod(rd32(smem, gl_desc + 8) + ((len + 7) & ~7u), gl_rx_len));
+}
+
+static struct gl_channel *
+gl_by_rcid(uint32_t rcid)
+{
+	for (unsigned c = 0; c < NEGRONI_GLINK_CHANNELS; c++) {
+		if (gl_ch[c].remote_open && gl_ch[c].rcid == rcid) {
+			return &gl_ch[c];
+		}
+	}
+	return NULL;
+}
+
+static bool
+gl_up(const struct gl_channel *ch)
+{
+	return ch->remote_open && ch->open_acked;
+}
+
+static int
+gl_send_open(struct gl_channel *ch)
+{
+	uint32_t m[2 + 8] = { 0 }, n = (uint32_t)strlen(ch->name) + 1;
+
+	m[0] = GL_OPEN | (uint32_t)ch->lcid << 16;
+	m[1] = n;
+	memcpy(&m[2], ch->name, n);
+	ch->open_sent = true;
+	return gl_write(m, (8 + n + 7) & ~7u);
+}
+
+static int
+gl_advertise(struct gl_channel *ch, unsigned i)
+{
+	uint32_t m[4];
+
+	m[0] = GL_INTENT | (uint32_t)ch->lcid << 16;
+	m[1] = 1;
+	m[2] = ch->ours[i].size;
+	m[3] = ch->ours[i].id;
+	return gl_write(m, sizeof(m));
+}
+
+/* Advertise one local intent of `size` bytes (GL_INTENT_SIZE..GL_INTENT_MAX, kmem). */
+static bool
+gl_add_intent(struct gl_channel *ch, uint32_t size)
+{
+	vm_offset_t b = 0;
+	uint32_t bytes = MAX(size, GL_INTENT_SIZE);
+
+	if (ch->nours >= GL_OURS || size > GL_INTENT_MAX ||
+	    kmem_alloc(kernel_map, &b, round_page(bytes), KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return false;
+	}
+	unsigned i = ch->nours++;
+	ch->buf[i] = (uint8_t *)b;
+	ch->ours[i] = (struct gl_intent){ gl_next_liid++, bytes, false };
+	ch->fill[i] = 0;
+	return gl_advertise(ch, i) == 0;
+}
+
+static void
+gl_rx_data(struct gl_channel *ch, uint32_t liid, const uint8_t *data, uint32_t chunk, uint32_t left)
+{
+	unsigned i;
+
+	for (i = 0; i < ch->nours && ch->ours[i].id != liid; i++) {
+	}
+	if (i == ch->nours) {
+		gl_complain("GLINK: %s: data for an intent %u we never gave", ch->name, liid);
+		return;
+	}
+	if (ch->fill[i] + chunk > ch->ours[i].size) {
+		gl_complain("GLINK: %s: %u + %u bytes do not fit intent %u: dropped", ch->name, ch->fill[i], chunk, liid);
+		ch->fill[i] = 0;
+		return;
+	}
+	memcpy(ch->buf[i] + ch->fill[i], data, chunk);
+	ch->fill[i] += chunk;
+	if (left) {
+		return;
+	}
+	uint32_t whole = ch->fill[i];
+	ch->fill[i] = 0;
+	ch->rx_count++;
+	if (ch->rx) {
+		ch->rx(ch->buf[i], whole);
+	}
+	/*
+	 * RX_DONE_W_REUSE {cmd, our lcid, liid} keeps the intent when both sides agreed on
+	 * INTENT_REUSE (feature bit 0); otherwise RX_DONE ends it and we give the same buffer again.
+	 */
+	if (gl_features & GL_FEATURE_INTENT_REUSE) {
+		(void)gl_cmd(GL_RX_DONE_W_REUSE, ch->lcid, liid);
+	} else {
+		(void)gl_cmd(GL_RX_DONE, ch->lcid, liid);
+		ch->ours[i].id = gl_next_liid++;
+		(void)gl_advertise(ch, i);
+	}
+}
+
+/* Handle every complete message in our RX FIFO (with gl_lock held). */
+static void
+gl_poll(void)
+{
+	for (int n = 0; n < 256 && !gl_dead; n++) {
+		uint32_t avail = gl_rx_avail(), hdr[4], cmd, p1, p2, need = 8;
+		struct gl_channel *ch;
+
+		if (avail < 8) {
+			return;
+		}
+		gl_peek(0, hdr, 8);
+		cmd = hdr[0] & 0xffff;
+		p1 = hdr[0] >> 16;
+		p2 = hdr[1];
+		switch (cmd) {
+		case GL_VERSION:
+			if (p1 == 1) {
+				gl_features &= p2;
+			}
+			gl_advance(8);
+			if (p1 != 0) {
+				/* any version != 0 is acked with version 1, as Linux's default case does */
+				(void)gl_cmd(GL_VERSION_ACK, 1, gl_features);
+				if (!gl_version_ok) {
+					say("GLINK: the ADSP offers version %u features %#x: version 1 ok (features %#x)", p1, p2, gl_features);
+				}
+				gl_version_ok = true;
+			}
+			break;
+		case GL_VERSION_ACK:
+			gl_advance(8);
+			if (p1 == 0) {
+				say("GLINK: the ADSP refuses version 1");
+				gl_dead = true;
+			} else if (p1 == 1 && p2 != gl_features) {
+				gl_features &= p2;
+				(void)gl_cmd(GL_VERSION, 1, gl_features);
+			} else {
+				if (!gl_version_ok) {
+					say("GLINK: version 1 ok (features %#x)", gl_features);
+				}
+				gl_version_ok = true;
+			}
+			break;
+		case GL_OPEN: {
+			char name[33];
+			uint32_t len = p2 & 0xffff;
+
+			need = 8 + len;
+			if (avail < need) {
+				return;
+			}
+			bzero(name, sizeof(name));
+			if (len > 32) {
+				len = 32;
+			}
+			{
+				uint32_t w[10];
+				gl_peek(0, w, 8 + len);
+				memcpy(name, (uint8_t *)w + 8, len);
+			}
+			name[32] = 0;
+			gl_advance(need);
+			ch = NULL;
+			for (unsigned c = 0; c < NEGRONI_GLINK_CHANNELS; c++) {
+				if (strcmp(gl_ch[c].name, name) == 0) {
+					ch = &gl_ch[c];
+				}
+			}
+			if (ch == NULL) {
+				say("GLINK: the ADSP opens \"%s\" (rcid %u): not ours, left unanswered", name, p1);
+				break;
+			}
+			ch->rcid = (uint16_t)p1;
+			ch->remote_open = true;
+			say("GLINK: the ADSP opens %s (rcid %u)", ch->name, p1);
+			(void)gl_cmd(GL_OPEN_ACK, ch->rcid, 0);
+			ch->ack_sent = true;
+			if (!ch->open_sent) {
+				(void)gl_send_open(ch);
+			}
+			break;
+		}
+		case GL_CLOSE:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			say("GLINK: the ADSP closes rcid %u (%s)", p1, ch ? ch->name : "?");
+			(void)gl_cmd(GL_CLOSE_ACK, (uint16_t)p1, 0);
+			if (ch) {
+				ch->remote_open = false;
+			}
+			break;
+		case GL_CLOSE_ACK:
+			gl_advance(8);
+			break;
+		case GL_OPEN_ACK:
+			gl_advance(8);
+			for (unsigned c = 0; c < NEGRONI_GLINK_CHANNELS; c++) {
+				if (gl_ch[c].lcid == p1) {
+					gl_ch[c].open_acked = true;
+					say("GLINK: the ADSP acks our open of %s", gl_ch[c].name);
+				}
+			}
+			break;
+		case GL_INTENT: {
+			uint32_t pair[2];
+
+			need = 8 + 8 * p2;
+			if (p2 > 64) {
+				say("GLINK: INTENT with %u entries: GLINK stopped", p2);
+				gl_dead = true;
+				return;
+			}
+			if (avail < need) {
+				return;
+			}
+			ch = gl_by_rcid(p1);
+			for (uint32_t i = 0; ch && i < p2; i++) {
+				gl_peek(8 + 8 * i, pair, 8);
+				for (unsigned k = 0; k < GL_THEIRS; k++) {
+					if (ch->theirs[k].size == 0) {
+						ch->theirs[k] = (struct gl_intent){ pair[1], pair[0], false };
+						break;
+					}
+				}
+			}
+			gl_advance(need);
+			break;
+		}
+		case GL_RX_DONE:
+		case GL_RX_DONE_W_REUSE:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			for (unsigned k = 0; ch && k < GL_THEIRS; k++) {
+				if (ch->theirs[k].size && ch->theirs[k].id == p2) {
+					if (cmd == GL_RX_DONE) {
+						ch->theirs[k].size = 0;
+					}
+					ch->theirs[k].used = false;
+				}
+			}
+			break;
+		case GL_RX_INTENT_REQ:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			if (ch) {
+				bool granted = gl_add_intent(ch, p2);
+				(void)gl_cmd(GL_RX_INTENT_REQ_ACK, ch->lcid, granted);
+				if (!granted) {
+					gl_complain("GLINK: %s: the ADSP asks for an intent of %u bytes: refused", ch->name, p2);
+				}
+			}
+			break;
+		case GL_RX_INTENT_REQ_ACK:
+			gl_advance(8);
+			ch = gl_by_rcid(p1);
+			if (ch) {
+				ch->req_result = (int32_t)p2;
+			}
+			break;
+		case GL_TX_DATA:
+		case GL_TX_DATA_CONT: {
+			uint32_t chunk, left;
+
+			if (avail < 16) {
+				return;
+			}
+			gl_peek(0, hdr, 16);
+			chunk = hdr[2];
+			left = hdr[3];
+			need = 16 + chunk;
+			if (chunk > GL_INTENT_MAX) {
+				say("GLINK: a %u-byte chunk is bigger than any intent of ours: GLINK stopped", chunk);
+				gl_dead = true;
+				return;
+			}
+			if (avail < need) {
+				return;
+			}
+			gl_peek(16, gl_msg, chunk);
+			gl_advance(need);
+			ch = gl_by_rcid(p1);
+			if (ch) {
+				gl_rx_data(ch, p2, gl_msg, chunk, left);
+			}
+			break;
+		}
+		case GL_READ_NOTIF:
+			gl_advance(8);
+			kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_GLINK);
+			break;
+		case GL_SIGNALS:
+			gl_advance(8);
+			break;
+		default:
+			say("GLINK: unknown command %u (%#x %#x): GLINK stopped", cmd, hdr[0], hdr[1]);
+			gl_dead = true;
+			return;
+		}
+	}
+}
+
+bool
+negroni_glink_up(unsigned c)
+{
+	return c < NEGRONI_GLINK_CHANNELS && !gl_dead && gl_up(&gl_ch[c]);
+}
+
+void
+negroni_glink_set_rx(unsigned c, void (*fn)(const uint8_t *data, uint32_t len))
+{
+	if (c < NEGRONI_GLINK_CHANNELS) {
+		gl_ch[c].rx = fn;
+	}
+}
+
+/*
+ * One message to the ADSP on channel c: needs a remote intent of >= len bytes (asks for one with
+ * RX_INTENT_REQ and waits up to 1 s). One chunk: len <= GL_INTENT_SIZE. With gl_lock held.
+ */
+static int
+gl_send(unsigned c, const void *data, uint32_t len)
+{
+	struct gl_channel *ch;
+	struct gl_intent *best = NULL;
+
+	if (c >= NEGRONI_GLINK_CHANNELS || len == 0 || len > GL_INTENT_SIZE) {
+		return EINVAL;
+	}
+	ch = &gl_ch[c];
+	if (gl_dead || !gl_up(ch)) {
+		return ENOTCONN;
+	}
+	for (int round = 0; round < 2 && best == NULL; round++) {
+		for (unsigned k = 0; k < GL_THEIRS; k++) {
+			struct gl_intent *t = &ch->theirs[k];
+			if (t->size >= len && !t->used && (best == NULL || t->size < best->size)) {
+				best = t;
+			}
+		}
+		if (best == NULL && round == 0) {
+			ch->req_result = -1;
+			if (gl_cmd(GL_RX_INTENT_REQ, ch->lcid, len) != 0) {
+				return EIO;
+			}
+			for (uint32_t ms = 0; ms < 1000 && ch->req_result < 0; ms++) {
+				gl_poll();
+				if (ch->req_result < 0) {
+					IOSleep(1);
+				}
+			}
+			gl_poll();           /* the INTENT may follow the ack */
+			if (ch->req_result <= 0) {
+				gl_complain("GLINK: %s: the ADSP gives no intent for %u bytes (answer %d)", ch->name, len, ch->req_result);
+				return EAGAIN;
+			}
+		}
+	}
+	if (best == NULL) {
+		return EAGAIN;
+	}
+	best->used = true;
+	{
+		static uint32_t m[(16 + GL_INTENT_SIZE + 7) / 4];     /* under gl_lock: no 4 KiB stack copy */
+		m[0] = GL_TX_DATA | (uint32_t)ch->lcid << 16;
+		m[1] = best->id;
+		m[2] = len;
+		m[3] = 0;
+		memcpy(&m[4], data, len);
+		bzero((uint8_t *)&m[4] + len, ((len + 7) & ~7u) - len);
+		if (gl_write(m, 16 + ((len + 7) & ~7u)) != 0) {
+			best->used = false;
+			return EIO;
+		}
+	}
+	ch->tx_count++;
+	return 0;
+}
+
+/* Public API (stable for 0243 and the charger client 0274): each call takes gl_lock. */
+void
+negroni_glink_poll(void)
+{
+	gl_lock();
+	gl_poll();
+	gl_unlock();
+}
+
+/*
+ * Send one message (len <= 4096) on channel c. Blocks the caller for up to ~1.2 s (an intent
+ * request, a full TX FIFO); returns 0, EINVAL, ENOTCONN, EAGAIN (no remote intent) or EIO.
+ */
+int
+negroni_glink_send(unsigned c, const void *data, uint32_t len)
+{
+	int error;
+
+	gl_lock();
+	error = gl_send(c, data, len);
+	gl_unlock();
+	return error;
+}
+
+static bool
+step_glink(void)
+{
+	uint32_t size = 0, ms;
+
+	announce("GLINK: allocate SMEM items 478 (descriptors) and 479 (our TX FIFO), say version 1");
+	if (!smem_alloc(ITEM_GLINK_DESC, 32) || !smem_alloc(ITEM_GLINK_FIFO0, GLINK_FIFO_SIZE)) {
+		return false;
+	}
+	gl_desc = smem_item(ITEM_GLINK_DESC, &size);
+	if (gl_desc == 0 || size != 32) {
+		FAIL("GLINK descriptor item %u: %s (%u bytes)", ITEM_GLINK_DESC, gl_desc ? "wrong size" : "absent", size);
+		return false;
+	}
+	gl_tx = smem_item(ITEM_GLINK_FIFO0, &size);
+	if (gl_tx == 0 || size < GLINK_FIFO_SIZE) {
+		FAIL("GLINK TX FIFO item %u: %s (%u bytes)", ITEM_GLINK_FIFO0, gl_tx ? "too small" : "absent", size);
+		return false;
+	}
+	wr32(smem, gl_desc + 8, 0);             /* our RX tail */
+	wr32(smem, gl_desc + 4, 0);             /* our TX head */
+	say("GLINK: descriptors at %#lx, TX FIFO at %#lx (%#x bytes)", SMEM_PHYS + gl_desc, SMEM_PHYS + gl_tx, size);
+	if (gl_cmd(GL_VERSION, 1, gl_features) != 0) {
+		FAIL("GLINK: VERSION does not go out");
+		return false;
+	}
+	for (ms = 0; ms < step_budget_ms && !gl_dead; ms++) {
+		negroni_glink_poll();
+		if (gl_version_ok) {
+			for (unsigned c = 0; c < NEGRONI_GLINK_CHANNELS; c++) {
