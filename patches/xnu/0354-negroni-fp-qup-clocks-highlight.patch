+/*
+ * negroni_touch.c: every finger report (down = 1 on down and move, 0 on up), panel pixels. The
+ * fingers are tracked in every mode (0353's capture needs the finger with negronifp_hl=0 too);
+ * only the drawing is gated by negronifp_hl.
+ */
+extern "C" void
+negroni_fp_touch(int finger, int down, int x, int y)
+{
+	if (finger < 0 || finger > 31) {
+		return;
+	}
+	(void)negroni_fp_hl_mode();     /* parses x, y, r and makes the lock */
+	const int dx = x - negroni_fp_hl_x, dy = y - negroni_fp_hl_y, r = negroni_fp_hl_r;
+	uint32_t bit = 1u << finger, now = (down && dx * dx + dy * dy <= r * r) ? bit : 0;
+	bool changed, open;
+	IOLockLock(negroni_fp_lock);
+	uint32_t before = negroni_fp_fingers;
+	negroni_fp_fingers = (before & ~bit) | now;
+	changed = negroni_fp_fingers != before;
+	open = negroni_fp_cap_open;
+	IOLockUnlock(negroni_fp_lock);
+	if (changed && open) {
+		negroni_fp_overlay_update();
 	}
 }
 
