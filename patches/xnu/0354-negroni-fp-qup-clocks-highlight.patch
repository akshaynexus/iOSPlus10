+		IOLockUnlock(negroni_fp_lock);
+		return;
+	}
+	const int r = negroni_fp_hl_r;
+	if (fb->fZCActive) {
+		negroni_fp_shown = 0;           /* that picture is not ours to touch; the next copy draws */
+		IOLockUnlock(negroni_fp_lock);
+		return;
+	}
+	uintptr_t px = fb->fPixels;
+	uint32_t rb = fb->fRowBytes, w = fb->fWidth, h = fb->fHeight;
+	/* put the saved pixels back when they are still the picture under the drawing */
+	if (negroni_fp_shown != 0 && negroni_fp_save != NULL && negroni_fp_shown_frame == negroni_fp_hl_frames) {
+		const int cx = negroni_fp_hl_x, cy = negroni_fp_hl_y;
+		for (int y = cy - r; y <= cy + r; y++) {
+			if (y < 0 || y >= (int)h) {
+				continue;
+			}
+			uint32_t *row = (uint32_t *)(px + (uint64_t)y * rb);
+			for (int x = cx - r; x <= cx + r; x++) {
+				if (x >= 0 && x < (int)w) {
