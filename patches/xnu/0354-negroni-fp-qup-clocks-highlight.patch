+		negroni_fp_restores++;
+	}
+	negroni_fp_shown = 0;
+	if (what != 0) {
+		negroni_fp_paint(px, rb, w, h, what, negroni_fp_save);
+		negroni_fp_shown = what;
+		negroni_fp_shown_frame = negroni_fp_hl_frames;
+		negroni_fp_direct++;
+	}
+	uint32_t fingers = negroni_fp_fingers, direct = negroni_fp_direct, restores = negroni_fp_restores;
+	bool open = negroni_fp_cap_open;
+	int ui = negroni_fp_ui;
+	IOLockUnlock(negroni_fp_lock);
+	IOLog("NEGRONI FP HL: overlay %s (ui %d, capture %s, fingers %#x; direct %u, restores %u, frames %llu)\n",
+	    what == 2 ? "capture disc" : what == 1 ? "lock-screen glyph" : "off", ui, open ? "open" : "closed",
