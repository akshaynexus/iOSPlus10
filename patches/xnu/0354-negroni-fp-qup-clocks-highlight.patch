+extern "C" void
+negroni_fp_overlay_update(void)
+{
+	AppleCLCD *fb = negroni_fb_main;
+	if (fb == NULL || fb->fPixels == 0 || negroni_fp_hl_mode() == 0) {
+		return;
+	}
+	IOLockLock(negroni_fp_lock);
+	int what = negroni_fp_hl_show();
