+/*
+ * One register write, as cam_cci_data_queue (cam_cci_core.c:770-1000) for one i2c_cmd with a word
+ * address and a byte value: queue 1 gets SET_PARAM, LOCK, WRITE (3 bytes: address MSB, LSB, value in one
+ * word), UNLOCK, REPORT (:330: cmd 8 | 1 << 8 | 1 << 9); then QUEUE_START and the Q1 REPORT bit.
+ */
+/* one-byte read: cci_read16 with READ 1 (cam_cci_read num_byte 1); value = byte 1 of the FIFO word */
+static int
+cci_read8(uint32_t m, uint32_t sid, uint32_t reg, uint32_t *value)
+{
+	const uint32_t q = 1;
+	uint32_t got = 0, cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+
+	if (cnt != 0) {
+		return EBUSY;
+	}
+	cci_irq_clear(CCI_IRQ_MASK_0_ALL);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_SET_PARAM | sid << 4);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_LOCK);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_WRITE_DISABLE_P | 2u << 4 | ((reg >> 8) & 0xffu) << 8 | (reg & 0xffu) << 16);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_READ | 1u << 4);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_UNLOCK);
+	cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+	wr(cci + CCI_MQ_EXEC_CNT(m, q), cnt);
+	wr(cci + CCI_QUEUE_START, 1u << (m * 2 + q));
+	bool done = false;
+	for (uint32_t us = 0; us <= CCI_TIMEOUT_US; us++) {
+		got = rd(cci + CCI_IRQ_STATUS_0);
+		if (got & (CCI_RD_DONE(m) | CCI_ERROR(m))) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || (got & CCI_ERROR(m))) {
+		cci_irq_clear(got);
+		cci_recover(m);
+		return !done ? ETIMEDOUT : (got & CCI_NACK(m)) ? ENXIO : EIO;
+	}
+	uint32_t words = rd(cci + CCI_M_READ_LEVEL(m)), data = 0;
+	for (uint32_t i = 0; i < words && i < 64; i++) {
+		uint32_t w = rd(cci + CCI_M_READ_DATA(m));
+		if (i == 0) {
+			data = w;
+		}
+	}
+	cci_irq_clear(got);
+	*value = (data >> 8) & 0xffu;
+	return words >= 1 ? 0 : EIO;
+}
+
+static int
+cci_write8(uint32_t m, uint32_t sid, uint32_t reg, uint32_t val)
+{
+	const uint32_t q = 1;
+	uint32_t got = 0, cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+
+	if (cnt != 0) {
+		return EBUSY;
+	}
+	cci_irq_clear(CCI_IRQ_MASK_0_ALL);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_SET_PARAM | sid << 4);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_LOCK);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_WRITE | 3u << 4 | ((reg >> 8) & 0xffu) << 8 | (reg & 0xffu) << 16 |
+	    (val & 0xffu) << 24);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_UNLOCK);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_REPORT | 1u << 8 | 1u << 9);
+	cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+	wr(cci + CCI_MQ_EXEC_CNT(m, q), cnt);
+	wr(cci + CCI_QUEUE_START, 1u << (m * 2 + q));
+	bool done = false;
+	for (uint32_t us = 0; us <= CCI_TIMEOUT_US; us++) {
+		got = rd(cci + CCI_IRQ_STATUS_0);
+		if (got & (CCI_M0_Q1_REPORT | CCI_ERROR(m))) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || (got & CCI_ERROR(m))) {
+		say("  CCI0 M%u write sid %#x reg %#06x = %#04x: %s, irq status %#x", m, sid, reg, val,
+		    !done ? "timeout" : (got & CCI_NACK(m)) ? "NACK" : "error", got);
+		cci_irq_clear(got);
+		cci_recover(m);
+		return !done ? ETIMEDOUT : (got & CCI_NACK(m)) ? ENXIO : EIO;
+	}
+	cci_irq_clear(got);
+	return 0;
+}
