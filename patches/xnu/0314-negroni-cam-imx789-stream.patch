+/* ---- 0314: IMX789 FTM table, stream on ---- */
+
+static bool
+l4_stream(void)
+{
+	step_begin("imx789 ftm table + stream on");
+	uint32_t fc0 = 0, fc1 = 0, fc2 = 0;
+	for (unsigned i = 0; i < NFTM; i++) {
+		if (imx789_ftm[i].reg == SENSOR_MODE_SEL) {
+			streaming = true;               /* the stream off runs on every path after this write */
+		}
+		int e = cci_write8(CCI_MASTER, SENSOR_SID, imx789_ftm[i].reg, imx789_ftm[i].val);
+		if (e) {
+			say("  write %u/%u (%#06x = %#04x) failed: errno %d", i + 1, (unsigned)NFTM, imx789_ftm[i].reg,
+			    imx789_ftm[i].val, e);
+			return step_fail("CCI write");
+		}
+	}
+	say("  %u writes done (last: %#06x = %#04x, stream on)", (unsigned)NFTM, imx789_ftm[NFTM - 1].reg,
+	    imx789_ftm[NFTM - 1].val);
+	/* frame counter: 3 reads 50 ms apart (30 fps = 33 ms per frame) */
+	if (cci_read8(CCI_MASTER, SENSOR_SID, SENSOR_FRAME_CNT, &fc0) || (delay(50000), 0) ||
+	    cci_read8(CCI_MASTER, SENSOR_SID, SENSOR_FRAME_CNT, &fc1) || (delay(50000), 0) ||
+	    cci_read8(CCI_MASTER, SENSOR_SID, SENSOR_FRAME_CNT, &fc2)) {
+		return step_fail("frame counter read");
+	}
+	say("IMX789 frame counter %#04x -> %#04x -> %#04x: %s", fc0, fc1, fc2,
+	    (fc0 != fc1 && fc1 != fc2) ? "MOVES (sensor streams)" : "STUCK (no stream)");
+	if (fc0 == fc1 && fc1 == fc2) {
+		return step_fail("the sensor does not stream");
+	}
+	return step_ok();
+}
