 /* Mode 2: the tick, CoreAnimation's interval and the refresh property follow the panel rate. */
+/* 0364: one number into a dictionary */
+static void
+negroni_fb_dict_num(OSDictionary *d, const char *key, uint64_t value)
+{
+	OSNumber *n = OSNumber::withNumber(value, 32);
+	if (n != NULL) {
+		d->setObject(key, n);
+		n->release();
