+static bool negroni_fb_modes_on;          /* 0364: TimingElements published (GetBlock 0x40 answers) */
+#define NEGRONI_FB_TIMING_ID              1
+#define NEGRONI_FB_COLOR_ID               1
+
+/*
+ * 0364: the display mode the way CoreAnimation reads it (header comment). Keys and layout as HakiOS
+ * MiniIOMobileFramebuffer.cpp:329-379 (APSL 2.0); the size is the presented one (GetDisplaySize).
+ */
+void
+AppleCLCD::publishModes(void)
+{
+	uint32_t on = 1;
+	/* default: the rate frames really reach the panel (negronifb_hz: one copy every fFlushTicks ticks) */
+	uint32_t hz = 1000000u / NEGRONI_FB_VSYNC_US / (fFlushTicks ? fFlushTicks : 1);
+	PE_parse_boot_argn("negronifb_modes", &on, sizeof(on));
+	PE_parse_boot_argn("negronifb_modehz", &hz, sizeof(hz));
+	if (on == 0) {
+		IOLog("NEGRONI FB: modes: off (negronifb_modes=0): no TimingElements, CoreAnimation uses the refresh interval\n");
+		return;
+	}
+	if (hz < 1 || hz > 1000000u / NEGRONI_FB_VSYNC_US) {
+		hz = 1000000u / NEGRONI_FB_VSYNC_US;
+	}
+	const uint64_t rate = (uint64_t)hz << 16;       /* 16.16 fixed point */
+	OSDictionary *timing = OSDictionary::withCapacity(8);
+	OSDictionary *horizontal = OSDictionary::withCapacity(4);
+	OSDictionary *vertical = OSDictionary::withCapacity(4);
+	OSDictionary *color = OSDictionary::withCapacity(8);
+	OSArray *timings = OSArray::withCapacity(1);
+	OSArray *colors = OSArray::withCapacity(1);
+	if (timing != NULL && horizontal != NULL && vertical != NULL && color != NULL && timings != NULL && colors != NULL) {
+		negroni_fb_dict_num(color, "ID", NEGRONI_FB_COLOR_ID);
+		negroni_fb_dict_num(color, "PixelEncoding", 0);         /* RGB 4:4:4 */
+		negroni_fb_dict_num(color, "Depth", 8);
+		negroni_fb_dict_num(color, "Colorimetry", 1);
+		negroni_fb_dict_num(color, "EOTF", 1);
+		negroni_fb_dict_num(color, "DynamicRange", 0);
+		negroni_fb_dict_num(color, "Score", 1);
+		color->setObject("IsVirtual", kOSBooleanFalse);
+		colors->setObject(color);
+		negroni_fb_dict_num(horizontal, "Active", fLogicalW);
+		negroni_fb_dict_num(horizontal, "Total", fLogicalW);
+		negroni_fb_dict_num(horizontal, "SyncRate", rate);
+		negroni_fb_dict_num(horizontal, "PreciseSyncRate", rate);
+		negroni_fb_dict_num(vertical, "Active", fLogicalH);
+		negroni_fb_dict_num(vertical, "Total", fLogicalH);
+		negroni_fb_dict_num(vertical, "SyncRate", rate);
+		negroni_fb_dict_num(vertical, "PreciseSyncRate", rate);
+		negroni_fb_dict_num(timing, "ID", NEGRONI_FB_TIMING_ID);
+		negroni_fb_dict_num(timing, "Score", 1);
+		timing->setObject("IsVirtual", kOSBooleanFalse);
+		timing->setObject("IsOverscanned", kOSBooleanFalse);
+		timing->setObject("HorizontalAttributes", horizontal);
+		timing->setObject("VerticalAttributes", vertical);
+		timing->setObject("ColorModes", colors);
+		timings->setObject(timing);
+		setProperty("TimingElements", timings);
+		setProperty("ColorElements", colors);
+		negroni_fb_modes_on = true;
+		IOLog("NEGRONI FB: modes: TimingElements %ux%u at %u Hz (SyncRate 0x%llx), ColorElements RGB 8-bit, current mode "
+		    "colour %u timing %u (negronifb_modes=1 negronifb_modehz=%u)\n", fLogicalW, fLogicalH, hz,
+		    (unsigned long long)rate, NEGRONI_FB_COLOR_ID, NEGRONI_FB_TIMING_ID, hz);
+	} else {
+		IOLog("NEGRONI FB: modes: not published (no memory)\n");
+	}
+	OSSafeReleaseNULL(timings);
+	OSSafeReleaseNULL(colors);
+	OSSafeReleaseNULL(timing);
+	OSSafeReleaseNULL(horizontal);
+	OSSafeReleaseNULL(vertical);
+	OSSafeReleaseNULL(color);
+}
