+/*
+ * 0248: the ADSP crash watch (Linux qcom_q6v5.c fatal IRQ -> rproc_report_crash -> qcom_q6v5_request_stop
+ * + qcom_q6v5_pas.c PAS shutdown, read for the order). No interrupt here: a thread reads the ADSP's
+ * slave-kernel SMP2P entry every 200 ms. On FATAL: the ADSP's last words (item 423), the amps off and
+ * the audio sink off (negroni_audio_dsp_lost: no GPR to a dead DSP), GLINK stopped, our master-kernel
+ * "stop" bit (bit 0, qcom,smem-states <... 0> "stop") set + IPCC kick, up to 5 s for STOP-ACK (bit 3),
+ * then PAS shutdown. No restart (the "has run since the reset" gate stays: HackiOS saw a SoC reset on a
+ * second start without a stop-ack). The watch does not see a watchdog bite (a separate LPASS IRQ in
+ * Linux) [I]; GLINK timeouts then show it.
+ */
+static void
+adsp_watch(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t size = 0, value = 0, last = ~0u, theirs;
+
+	say("watch: polling slave-kernel every 200 ms for FATAL");
+	for (;;) {
+		IOSleep(200);
+		theirs = smem_item(ITEM_SMP2P_THEIRS, &size);
+		if (theirs == 0 || !smp2p_value(theirs, "slave-kernel", &value) || value == last) {
+			continue;
+		}
+		say("watch: slave-kernel = %#x%s%s", value, value & DSP_FATAL ? " FATAL" : "", value & DSP_STOP_ACK ? " STOP-ACK" : "");
+		last = value;
+		if (value & DSP_FATAL) {
+			break;
+		}
+	}
+	say("ADSP FATAL AFTER START: audio off, stop, PAS shutdown (no restart in this boot)");
+	last_words();
+	negroni_audio_dsp_lost("ADSP fatal");
+	gl_dead = true;
+	if (our_item) {
+		wr32(smem, our_item + 36, rd32(smem, our_item + 36) | 1u);     /* master-kernel entry 0: "stop" */
+		kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_SMP2P);
+		for (uint32_t ms = 0; ms < 5000; ms += 10) {
+			if (smp2p_value(theirs, "slave-kernel", &value) && (value & DSP_STOP_ACK)) {
+				say("watch: STOP-ACK after %u ms", ms);
+				break;
+			}
+			IOSleep(10);
+		}
+		wr32(smem, our_item + 36, rd32(smem, our_item + 36) & ~1u);    /* stop bit cleared again (Linux does) */
+		kick(IPCC_CLIENT_LPASS, IPCC_SIGNAL_SMP2P);
+	}
+	pas_shutdown("ADSP fatal after start");
+	adsp_running = false;
+	(void)thread_terminate(current_thread());
+}
+
 /* steps 10..15 are stage (b) (negroni_audio.c): one bridge per step keeps the timing/fail line. */
 static bool
 step_audio(uint32_t n)
@@ -1719,6 +1771,12 @@ adsp_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 	printf("NEGRONI ADSP: done (asked 1..%u, %s at %u)\n", last_step, failed ? "stopped" : "complete",
 	    MIN(step, last_step));
+	if (adsp_running) {
+		thread_t w;
+		if (kernel_thread_start(adsp_watch, NULL, &w) == KERN_SUCCESS) {
+			thread_deallocate(w);
+		}
+	}
 	(void)thread_terminate(current_thread());
 }
 
