+void
+negroni_audio_dsp_lost(const char *reason)
+{
+	say("ADSP LOST (%s): amps off, sink off, graph state dropped (no GPR to a dead DSP)", reason ? reason : "");
+	negroni_tfa_stop("ADSP lost");
+	if (audio_lock) {
+		lck_mtx_lock(audio_lock);
+	}
+	sink_on = false;
+	graph_started = false;
+	graph_opened = false;
+	clock_on = false;
+	mem_map_handle = 0;
+	if (audio_lock) {
+		lck_mtx_unlock(audio_lock);
+	}
+}
