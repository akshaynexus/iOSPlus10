+/*
+ * 0278: the BCL monitor on, as Linux bcl_configure_bcl_peripheral() (bcl_pmic5.c:777-780) does at probe.
+ * Returns 0 when MONITOR_EN bit 7 already reads set (XBL/ABL left it on: no write), 1 when this call set
+ * it (read back), -1 on failure (no APID, another EE owns it, write or read back failed).
+ */
+int
+negroni_spmi_bcl_monitor_on(void)
+{
+	uint8_t v = 0, back = 0;
+	unsigned owner = 7;
+	int rc;
+
+	if (!sp_ready || sp_bcl_apid == SP_NO_APID || negroni_spmi_read(3, 0x4746, &v)) {
+		return -1;
+	}
+	if (v & 0x80u) {
+		return 0;
+	}
+	lck_mtx_lock(&sp_lock);
+	(void)sp_find_apid(SP_BCL_PPID, &owner);
+	if (owner == SP_EE && !sp_poisoned[sp_bcl_apid]) {
+		if (!sp_bcl_chn) {
+			sp_bcl_chn = ml_io_map(SP_CHNLS_PA + SP_CHNL_STRIDE * sp_bcl_apid, SP_CHNL_STRIDE);
+		}
+		sp_bcl_unlocked = sp_bcl_chn != 0;
+	}
+	lck_mtx_unlock(&sp_lock);
+	if (!sp_bcl_unlocked) {
+		printf("NEGRONI BATTERY: BCL MONITOR_EN 0x4746 = %#x (off): not written (APID %u owner EE %u%s)\n", v,
+		    sp_bcl_apid, owner, sp_bcl_chn ? "" : ", no channel window");
+		return -1;
+	}
+	rc = negroni_spmi_write(3, 0x4746, 0x80);
+	lck_mtx_lock(&sp_lock);
+	sp_bcl_unlocked = false;                /* one write, locked again */
+	lck_mtx_unlock(&sp_lock);
+	if (rc == 0) {
+		IOSleep(2);
+		rc = negroni_spmi_read(3, 0x4746, &back);
+	}
+	printf("NEGRONI BATTERY: BCL MONITOR_EN 0x4746 was %#x: wrote 0x80 (bcl_pmic5.c:779): %s, reads %#x\n", v,
+	    rc == 0 && (back & 0x80u) ? "monitor ON" : "FAILED", back);
+	return rc == 0 && (back & 0x80u) ? 1 : -1;
+}
