+/* 0278: queue a save on a 1 % change (the first one at once), at most once a minute; only after the restore decision. */
+void
+NegroniBattery::storeSave(uint64_t ns)
+{
+	if (!fStoreDone || !fHaveSoc) {
+		return;
+	}
+	int32_t d = fLastSavedSoc < 0 ? 10000 : (fSoc > fLastSavedSoc ? fSoc - fLastSavedSoc : fLastSavedSoc - fSoc);
+	if (d < 100 || (fLastSavedSoc >= 0 && ns - fLastSaveNs < NB_STORE_MIN_NS)) {
+		return;
+	}
+	negroni_batt_store_save(fSoc);
+	fLastSavedSoc = fSoc;
+	fLastSaveNs = ns;
+}
