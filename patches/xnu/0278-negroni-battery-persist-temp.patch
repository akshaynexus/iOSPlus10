 }
 
+/* 0278: drop the QDSS clock vote once the debug path is closed. Thread context, sp_lock NOT held. */
+static void
+sd_vote_release(const char *why_closed)
+{
+	char why[96] = "";
+	bool go;
+
+	lck_mtx_lock(&sp_lock);
+	go = sd_voted;
+	sd_voted = sd_release_pending = false;
+	lck_mtx_unlock(&sp_lock);
+	if (!go) {
+		return;
+	}
+	if (qm_send("{class: clock, res: qdss, val: 0}", why, sizeof(why))) {
+		printf("NEGRONI BATTERY: debug arbiter: %s: QDSS clock vote release failed (%s)\n", why_closed, why);
+	} else {
+		printf("NEGRONI BATTERY: debug arbiter: %s: QDSS clock vote released (AOP QMP \"{class: clock, res: qdss, val: 0}\")\n",
+		    why_closed);
+	}
+}
