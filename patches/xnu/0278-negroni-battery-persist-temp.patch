diff --git a/bsd/dev/negroni_batt_store.c b/bsd/dev/negroni_batt_store.c
new file mode 100644
index 0000000..bcb20c7
--- /dev/null
+++ b/bsd/dev/negroni_batt_store.c
@@ -0,0 +1,199 @@
+/*
+ * NEGRONI (SM8450) patch 0278: the battery percentage kept across boots, in the same way patch 0203
+ * keeps the RTC offset (bsd/dev/negroni_rtc.c: a text file in /private/var/db, read with vnode_open +
+ * vn_rdwr, written by a thread call with O_CREAT | O_TRUNC + VNOP_FSYNC, a failed write tried again
+ * every 30 s, 60 times, while the root is read only).
+ *
+ * File /private/var/db/negroni_batt (text):
+ *   negroni-batt 1
+ *   soc 1234            hundredths of a percent, the value the battery service showed
+ *   wall 1793001749     calendar seconds of the write (for the log only)
+ * The battery service (iokit/Kernel/arm/NegroniBattery.cpp) reads it at its first OCV estimate and uses
+ * it only when it is within 15 % of that estimate (else the estimate wins); it saves on each 1 % change
+ * and at most once a minute.
+ * Log prefix "NEGRONI BATTERY: store:".
+ */
+#if defined(ARM64_BOARD_CONFIG_NEGRONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/fcntl.h>
+#include <sys/proc.h>
+#include <sys/mount.h>
+#include <sys/vnode.h>
+#include <sys/vnode_if.h>
+#include <sys/kauth.h>
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <kern/thread_call.h>
+#include <libkern/libkern.h>
+
+int negroni_batt_store_load(int32_t *soc_centi, uint64_t *wall_s);
+void negroni_batt_store_save(int32_t soc_centi);
+
+#define NB_FILE         "/private/var/db/negroni_batt"
+#define NB_RETRY_S      30
+#define NB_RETRIES      60
+
+static LCK_GRP_DECLARE(nbs_grp, "negroni_batt_store");
+static LCK_MTX_DECLARE(nbs_lock, &nbs_grp);
+static thread_call_t nbs_call;
+static int32_t nbs_want = -1;           /* the value to write; -1 = nothing */
+static int32_t nbs_written = -1;        /* the value in the file */
+static unsigned nbs_retries;
+static bool nbs_logged_fail;
+
+static bool
+root_mounted(void)
+{
+	vnode_t r = vfs_rootvnode();
+	if (r == NULLVP) {
+		return false;
+	}
+	vnode_put(r);
+	return true;
+}
+
+/* 0: *soc_centi (0..10000) and *wall_s set. EAGAIN: no root yet. ENOENT / EINVAL / an I/O error. */
+int
+negroni_batt_store_load(int32_t *soc_centi, uint64_t *wall_s)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	char buf[128];
+	int resid = 0, error;
+	bool magic = false, haveSoc = false;
+	int64_t soc = -1;
+	uint64_t wall = 0;
+
+	if (!root_mounted()) {
+		return EAGAIN;
+	}
+	bzero(buf, sizeof(buf));
+	error = vnode_open(NB_FILE, FREAD, 0, 0, &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	error = vn_rdwr(UIO_READ, vp, buf, sizeof(buf) - 1, 0, UIO_SYSSPACE, IO_NODELOCKED,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	(void)vnode_close(vp, FREAD, ctx);
+	if (error != 0) {
+		return error;
+	}
+	/* "key value" lines */
+	for (char *line = buf; line && *line;) {
+		char *nl = strchr(line, '\n');
+		if (nl) {
+			*nl = 0;
+		}
+		char *sp = strchr(line, ' ');
+		if (sp) {
+			*sp = 0;
+			uint64_t v = 0;
+			bool num = sp[1] != 0;
+			for (char *c = sp + 1; *c; c++) {
+				if (*c < '0' || *c > '9' || v > 100000000000ull) {
+					num = false;
+					break;
+				}
+				v = v * 10 + (uint64_t)(*c - '0');
+			}
+			if (strcmp(line, "negroni-batt") == 0 && num && v == 1) {
+				magic = true;
+			} else if (strcmp(line, "soc") == 0 && num) {
+				soc = (int64_t)v;
+				haveSoc = true;
+			} else if (strcmp(line, "wall") == 0 && num) {
+				wall = v;
+			}
+		}
+		line = nl ? nl + 1 : NULL;
+	}
+	if (!magic || !haveSoc || soc < 0 || soc > 10000) {
+		return EINVAL;
+	}
+	*soc_centi = (int32_t)soc;
+	*wall_s = wall;
+	lck_mtx_lock(&nbs_lock);
+	nbs_written = (int32_t)soc;
+	lck_mtx_unlock(&nbs_lock);
+	return 0;
+}
+
+static void
+nbs_persist(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	char text[96];
+	int resid = 0, error;
+	clock_sec_t now_s;
+	clock_usec_t now_us;
+
+	lck_mtx_lock(&nbs_lock);
+	int32_t soc = nbs_want;
+	bool same = soc == nbs_written;
+	lck_mtx_unlock(&nbs_lock);
+	if (soc < 0 || same) {
+		return;
+	}
+	if (!root_mounted()) {
+		error = EAGAIN;
+	} else {
+		clock_get_calendar_microtime(&now_s, &now_us);
+		snprintf(text, sizeof(text), "negroni-batt 1\nsoc %d\nwall %lu\n", soc, (unsigned long)now_s);
+		error = vnode_open(NB_FILE, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, S_IRUSR | S_IWUSR,
+		    VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+		if (error == 0) {
+			error = vn_rdwr(UIO_WRITE, vp, text, (int)strlen(text), 0, UIO_SYSSPACE, IO_NODELOCKED | IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (error == 0 && resid != 0) {
+				error = EIO;
+			}
+			if (error == 0) {
+				error = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+			}
+			(void)vnode_close(vp, FWRITE, ctx);
+		}
+	}
+	lck_mtx_lock(&nbs_lock);
+	if (error == 0) {
+		if (nbs_written < 0) {
+			printf("NEGRONI BATTERY: store: soc %d.%02d%% saved to %s (then on each 1 %% change, at most once a minute)\n",
+			    soc / 100, soc % 100, NB_FILE);
+		}
+		nbs_written = soc;
+		nbs_retries = 0;
+	} else if (nbs_retries++ < NB_RETRIES) {
+		if (!nbs_logged_fail) {
+			nbs_logged_fail = true;
+			printf("NEGRONI BATTERY: store: %s not written (error %d): again every %d s\n", NB_FILE, error, NB_RETRY_S);
+		}
+		uint64_t deadline;
+		clock_interval_to_deadline(NB_RETRY_S, NSEC_PER_SEC, &deadline);
+		thread_call_enter_delayed(nbs_call, deadline);
+	}
+	lck_mtx_unlock(&nbs_lock);
+}
+
+/* Queue a write of soc_centi (a thread call; the caller does not wait). */
+void
+negroni_batt_store_save(int32_t soc_centi)
+{
+	if (soc_centi < 0 || soc_centi > 10000) {
+		return;
+	}
+	lck_mtx_lock(&nbs_lock);
+	if (nbs_call == NULL) {
+		nbs_call = thread_call_allocate_with_options(nbs_persist, NULL, THREAD_CALL_PRIORITY_LOW, 0);
+	}
+	nbs_want = soc_centi;
+	if (nbs_retries >= NB_RETRIES) {
+		nbs_retries = 0;                /* a new value: try again */
+	}
+	thread_call_t c = nbs_call;
+	lck_mtx_unlock(&nbs_lock);
+	if (c != NULL) {
+		thread_call_enter(c);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_NEGRONI */
