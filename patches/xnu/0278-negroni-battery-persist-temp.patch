+/*
+ * 0278: the saved percentage (bsd/dev/negroni_batt_store.c). True when it replaced fSoc. Tried at the first
+ * OCV estimate and, while the root is not mounted yet (EAGAIN), at the next NB_STORE_TRIES polls.
+ */
+bool
+NegroniBattery::storeTry(int32_t target)
+{
+	int32_t saved = -1;
+	uint64_t wall = 0;
+
+	if (fStoreDone) {
+		return false;
+	}
+	int rc = negroni_batt_store_load(&saved, &wall);
+	if (rc == EAGAIN && ++fStoreTries < NB_STORE_TRIES) {
+		return false;                       /* no root file system yet: the next poll tries again */
+	}
+	fStoreDone = true;
+	if (rc != 0) {
+		IOLog("NEGRONI BATTERY: store: no saved percentage (%s, error %d): the OCV estimate %d.%02d%% stays\n",
+		    rc == ENOENT ? "no file yet" : rc == EAGAIN ? "no root file system" : rc == EINVAL ? "file not understood" : "read error",
+		    rc, target / 100, target % 100);
+		return false;
+	}
+	int32_t diff = saved > target ? saved - target : target - saved;
+	if (diff > NB_STORE_TRUST) {
+		IOLog("NEGRONI BATTERY: store: saved %d.%02d%% (wall %llu) is %d.%02d %% from the OCV estimate %d.%02d%% (> 15 %%): "
+		    "the estimate wins\n", saved / 100, saved % 100, wall, diff / 100, diff % 100, target / 100, target % 100);
+		return false;
+	}
+	IOLog("NEGRONI BATTERY: store: soc restored %d.%02d%% (saved at wall %llu; OCV estimate %d.%02d%%, %d.%02d %% apart)\n",
+	    saved / 100, saved % 100, wall, target / 100, target % 100, diff / 100, diff % 100);
+	fSoc = saved;
+	return true;
