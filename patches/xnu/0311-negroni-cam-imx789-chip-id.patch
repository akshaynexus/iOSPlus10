+	if (rd(p) & TLMM_EGPIO_PRESENT) {
+		cfg |= TLMM_EGPIO_ENABLE;       /* as negroni_wifi.c tlmm_cfg */
+	}
+	wr(p, cfg);
+	say("  gpio%u cfg %#x io %#x", pin, rd(p), rd(p + 4));
