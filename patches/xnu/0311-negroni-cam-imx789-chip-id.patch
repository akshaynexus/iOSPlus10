+/* halt + reset of one master after an error or a timeout (cam_cci_core.c flush / ISR halt-ack path) */
+static void
+cci_recover(uint32_t m)
+{
+	uint32_t got = 0;
+	wr(cci + CCI_HALT_REQ, 1u << m);
+	bool ok = poll(cci + CCI_IRQ_STATUS_0, CCI_HALT_ACK(m), CCI_HALT_ACK(m), CCI_TIMEOUT_US, &got);
+	say("  CCI0 M%u halt %s (irq status %#x)", m, ok ? "acked" : "NOT acked", got);
+	cci_irq_clear(got);
+	(void)cci_reset(m ? CCI_RESET_M1 : CCI_RESET_M0, NULL);
+	cci_timing(m);
+}
+
+/*
+ * One register read, as cam_cci_read (cam_cci_core.c): queue 1 gets SET_PARAM (sid), LOCK,
+ * WRITE_DISABLE_P (register, MSB first, no STOP), READ n, UNLOCK; then EXEC_WORD_CNT, QUEUE_START and
+ * RD_DONE. The first byte of READ_DATA is not data. Returns 0, ENXIO (NACK), EIO, ETIMEDOUT, EBUSY.
+ */
+static int
+cci_read16(uint32_t m, uint32_t sid, uint32_t reg, uint32_t *value)
+{
+	const uint32_t q = 1;
+	uint32_t got = 0, cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+
+	if (cnt != 0) {
+		say("  CCI0 M%u Q%u not empty (%u words)", m, q, cnt);
+		return EBUSY;
+	}
+	cci_irq_clear(CCI_IRQ_MASK_0_ALL);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_SET_PARAM | sid << 4);      /* retries 0, id_map 0 */
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_LOCK);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_WRITE_DISABLE_P | 2u << 4 | ((reg >> 8) & 0xffu) << 8 | (reg & 0xffu) << 16);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_READ | 2u << 4);
+	wr(cci + CCI_MQ_LOAD(m, q), CCI_CMD_UNLOCK);
+	cnt = rd(cci + CCI_MQ_CUR_CNT(m, q));
+	wr(cci + CCI_MQ_EXEC_CNT(m, q), cnt);
+	wr(cci + CCI_QUEUE_START, 1u << (m * 2 + q));
+	bool done = false;
+	for (uint32_t us = 0; us <= CCI_TIMEOUT_US; us++) {
+		got = rd(cci + CCI_IRQ_STATUS_0);
+		if (got & (CCI_RD_DONE(m) | CCI_ERROR(m))) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || (got & CCI_ERROR(m))) {
+		say("  CCI0 M%u read sid %#x reg %#06x: %s, irq status %#x, %u words queued", m, sid, reg,
+		    !done ? "timeout" : (got & CCI_NACK(m)) ? "NACK" : "error", got, cnt);
+		cci_irq_clear(got);
+		cci_recover(m);
+		return !done ? ETIMEDOUT : (got & CCI_NACK(m)) ? ENXIO : EIO;
+	}
+	uint32_t words = rd(cci + CCI_M_READ_LEVEL(m));
+	if (words != 1) {               /* num_byte / 4 + 1 */
+		say("  CCI0 M%u read: %u words in the FIFO, 1 expected", m, words);
+		for (uint32_t i = 0; i < words && i < 64; i++) {
+			(void)rd(cci + CCI_M_READ_DATA(m));
+		}
+		cci_irq_clear(got);
+		return EIO;
+	}
+	uint32_t data = rd(cci + CCI_M_READ_DATA(m));
+	cci_irq_clear(got);
+	*value = ((data >> 8) & 0xffu) << 8 | ((data >> 16) & 0xffu);
+	say("  CCI0 M%u read sid %#x reg %#06x: data word %#010x -> %#06x", m, sid, reg, data, *value);
+	return 0;
+}
