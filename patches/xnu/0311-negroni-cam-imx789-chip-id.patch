+		}
+	}
+	say("  %s (%s) %s %u mV mode %d: %s (errno %d)", r->name, r->res, on ? "on" : "off", r->uv / 1000u, mode,
+	    error ? "FAILED" : "ok", error);
+	return error;
+}
 
