+static int
+rail_vote(const struct cam_rail *r, bool on)
+{
+	int mode = -1;
+	if (on) {
+		/* refuse anything that is not one fixed DT voltage inside the regulator node range */
+		if (r->uv == 0 || r->uv < r->rail_min || r->uv > r->rail_max || r->uv % 1000u) {
