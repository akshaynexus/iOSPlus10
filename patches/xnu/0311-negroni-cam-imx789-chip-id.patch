+		}
+		if (r->hpm_ua) {
+			mode = r->load_ua >= r->hpm_ua ? 7 : 4;  /* PMIC5 LDO HPM / LPM (rpmh-regulator.c:286-287) */
+		}
+	}
+	int error = EBUSY;
+	/* the RPMh try-lock is shared with touch/Wi-Fi/ADSP votes: retry EBUSY up to 1 s (as 0240 rail_vote) */
+	for (unsigned i = 0; i < 100 && error == EBUSY; i++) {
+		error = negroni_rpmh_cam_rail(r->res, r->uv / 1000u, mode, on);
+		if (error == EBUSY) {
