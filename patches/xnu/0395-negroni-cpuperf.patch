+	for (uint32_t d = 0; d < EPSS_DOMAINS; d++) {
+		uint32_t row, top;
+
+		if (!dom_base[d]) {
+			continue;
+		}
+		dom_busy[d] = busy[d];
+		row = row_at_or_above(d, want[d]);
+		top = dom_cap_row[d];
