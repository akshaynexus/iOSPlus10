+	 * ASSOCIATE (wifid does that) could end the new join at once with the error of an older failed join (the driver
+	 * keeps last_error until the next failure). Only the driver's callback sets P_LINK_DOWN now.
+	 */
+	P_LEAVE         = 1u << 7,
