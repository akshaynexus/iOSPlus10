+/* 0345: the highest legacy rate (Mbit/s) in the rates elements (1, 50) of a BSS; 0 if it has none */
+static unsigned
+bss_best_rate(const struct nwlan_bss *bss)
+{
+	unsigned best = 0, length = MIN(bss->ie_len, (uint16_t)NWLAN_IE_MAX);
+
+	for (unsigned at = 0; at + 2 <= length && at + 2 + bss->ie[at + 1] <= length; at += 2 + bss->ie[at + 1]) {
+		for (unsigned i = 0; (bss->ie[at] == 1 || bss->ie[at] == 50) && i < bss->ie[at + 1]; i++) {
+			unsigned rate = (bss->ie[at + 2 + i] & 0x7f) / 2;
+
+			if (rate <= 54 && rate > best) {
+				best = rate;
+			}
+		}
+	}
+	return best;
+}
