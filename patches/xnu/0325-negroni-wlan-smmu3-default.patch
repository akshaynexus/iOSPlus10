+/*
+ * 0325: ASPM off on both link ends during the firmware download (ath11k pci.c:828-831 ath11k_pci_aspm_disable:
+ * "problems switching to AMSS state"). LNKCTL bits 1:0 = ASPM L0s/L1 control. Only the low 16 bits are written
+ * (LNKSTA above them has RW1C bits). Endpoint: the PCIe capability (ID 0x10) from the list at 0x34; root port:
+ * DBI 0x70 + 0x10 (negroni_wifi.c DBI_LNKCTL2 comment).
+ */
+static void
+wlan_aspm_off(struct negroni_wlan_pcie *p)
+{
+	volatile uint32_t *cfg = (volatile uint32_t *)p->cfg_bus1;
+	uint32_t ep = MHI_ALL_ONES, rp = MHI_ALL_ONES, cap = 0;
+
+	for (uint32_t ptr = cfg[0x34 / 4] & 0xfcu, guard = 48; ptr >= 0x40 && guard--; ) {
+		uint32_t h = cfg[ptr / 4];
+		if ((h & 0xffu) == 0x10u) {
+			cap = ptr;
+			break;
+		}
+		ptr = (h >> 8) & 0xfcu;
+	}
+	if (cap) {
+		ep = cfg[(cap + 0x10) / 4];
+		if (ep != MHI_ALL_ONES && (ep & 3u)) {
+			cfg[(cap + 0x10) / 4] = ep & 0xfffcu;
+		}
+	}
+	if (p->dbi) {
+		volatile uint32_t *lc = (volatile uint32_t *)(p->dbi + 0x80);
+		rp = *lc;
+		if (rp != MHI_ALL_ONES && (rp & 3u)) {
+			*lc = rp & 0xfffcu;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	printf("NEGRONI WLAN: ASPM: endpoint LNKCTL %#x (cap %#x) -> ASPM %u, root port LNKCTL %#x -> ASPM %u (off for the "
+	    "download, ath11k)\n", ep & 0xffffu, cap, cap ? cfg[(cap + 0x10) / 4] & 3u : 9u, rp & 0xffffu,
+	    p->dbi ? *(volatile uint32_t *)(p->dbi + 0x80) & 3u : 9u);
+}
+
+/*
+ * 0325: the PCIe controller's BDF-to-SID table (pci-msm.c msm_pcie_config_sid, called on every link enable):
+ * the survey's core reset (step 7) puts it back to reset state, BYPASS on. Android writes BYPASS off, zeroes the
+ * 256 hash entries and puts BDF 0x0100 -> SID offset 1 (iommu-map 0x100 -> 0x1c01, smmu-sid-base 0x1c00) at
+ * crc8(BDF big endian, poly 0x07, MSB first). RID 0 -> offset 0 is the value 0 = an empty entry. Only with
+ * negroniwlan_smmu=3 (the SMR then matches 0x1c00/0x1c01 anyway, see negroni_wlan_smmu.c).
+ */
+#define PARF_BDF_TO_SID_TABLE   0x2000u
+#define PARF_BDF_TO_SID_CFG     0x2c00u         /* bit 0: BYPASS */
+#define WLAN_EP_BDF             0x0100u
+
+static uint8_t
+crc8_msb07(const uint8_t *b, uint32_t n)
+{
+	uint8_t c = 0;
+
+	while (n--) {
+		c ^= *b++;
+		for (int i = 0; i < 8; i++) {
+			c = (uint8_t)((c & 0x80) ? (c << 1) ^ 0x07 : c << 1);
+		}
+	}
+	return c;
+}
+
+static void
+wlan_pcie_sid(bool program)
+{
+	if (!P.parf) {
+		printf("NEGRONI WLAN: no PARF handle; BDF-to-SID table not checked\n");
+		return;
+	}
+	uint32_t cfg = negroni_mmio_rd32(P.parf + PARF_BDF_TO_SID_CFG);
+	uint8_t be[2] = { WLAN_EP_BDF >> 8, WLAN_EP_BDF & 0xff };
+	uint32_t hash = crc8_msb07(be, 2), val = WLAN_EP_BDF << 16 | 1u << 8;
+
+	printf("NEGRONI WLAN: PCIe BDF-to-SID: CFG %#x (BYPASS %u), entry %#x = %#x\n", cfg, cfg & 1u, hash,
+	    negroni_mmio_rd32(P.parf + PARF_BDF_TO_SID_TABLE + 4 * hash));
+	if (!program) {
+		return;
+	}
+	negroni_mmio_wr32(P.parf + PARF_BDF_TO_SID_CFG, cfg & ~1u);
+	for (uint32_t i = 0; i < 256; i++) {
+		negroni_mmio_wr32(P.parf + PARF_BDF_TO_SID_TABLE + 4 * i, 0);
+	}
+	negroni_mmio_wr32(P.parf + PARF_BDF_TO_SID_TABLE + 4 * hash, val);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint32_t got = negroni_mmio_rd32(P.parf + PARF_BDF_TO_SID_TABLE + 4 * hash);
+	cfg = negroni_mmio_rd32(P.parf + PARF_BDF_TO_SID_CFG);
+	printf("NEGRONI WLAN: PCIe BDF-to-SID programmed: CFG %#x, entry %#x = %#x (BDF %#x -> SID 0x1c00 + 1)%s\n", cfg,
+	    hash, got, WLAN_EP_BDF, (got == val && !(cfg & 1u)) ? "" : " - DID NOT TAKE, the chip may use SID 0x1c00");
+}
