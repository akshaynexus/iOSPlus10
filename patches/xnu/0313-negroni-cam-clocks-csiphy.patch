+static void
+phy_write(const struct phy_reg *r, uint32_t lane_off, uint32_t delay_extra)
+{
+	uint32_t v = r->data;
+	if (r->type == PT_SETTLE_LO) {
+		v = settle_cnt & 0xffu;
+	} else if (r->type == PT_SETTLE_HI) {
+		v = (settle_cnt >> 8) & 0xffu;
+	}
+	wr(csiphy + r->addr + lane_off, v);
+	if (r->delay_us + delay_extra) {
+		delay(r->delay_us + delay_extra);
+	}
+}
