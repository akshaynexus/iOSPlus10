+/* clk_lucid_evo_pll_configure + alpha_pll_lucid_evo_enable (clk-alpha-pll.c:2969-3105) */
+static bool
+pll_enable(const struct cam_pll *p)
+{
+	vm_offset_t b = camcc + p->off;
+	uint32_t mode = rd(b + PLL_MODE), op = rd(b + PLL_OPMODE), user = rd(b + PLL_USER_CTL), got = 0;
+
+	say("  %s: mode %#x opmode %#x user_ctl %#x l %#x", p->name, mode, op, user, rd(b + PLL_L_VAL));
+	if (user & PLL_VOTE_RUN) {
+		say("  %s is in FSM vote mode: not ours, not touched", p->name);
+		return false;
+	}
+	if ((op & 1u) && (mode & PLL_OUTCTRL)) {
+		say("  %s already runs: not ours, used as is", p->name);
+		return true;
+	}
+	wr(b + PLL_L_VAL, (p->cal_l << 16) | p->l);
+	wr(b + PLL_ALPHA_VAL, p->alpha);
+	wr(b + PLL_CONFIG_CTL, p->cfg);
+	wr(b + PLL_CONFIG_CTL_U, p->cfg_u);
+	wr(b + PLL_CONFIG_CTL_U1, p->cfg_u1);
+	wr(b + PLL_USER_CTL, p->user);
+	wr(b + PLL_USER_CTL_U, p->user_u);
+	wr(b + PLL_MODE, rd(b + PLL_MODE) & ~PLL_OUTCTRL);
+	wr(b + PLL_OPMODE, 0);                  /* STANDBY */
+	wr(b + PLL_MODE, rd(b + PLL_MODE) | PLL_RESET_N);
+	wr(b + PLL_OPMODE, 1);                  /* RUN */
+	bool ok = poll(b + PLL_MODE, PLL_LOCK_DET, PLL_LOCK_DET, 200, &got);     /* Linux: 100 x 1 us */
+	if (!ok) {
+		say("  %s: no LOCK_DET (mode %#x)", p->name, got);
+		wr(b + PLL_OPMODE, 0);
+		return false;
+	}
+	wr(b + PLL_USER_CTL, rd(b + PLL_USER_CTL) | PLL_OUT_MASK);
+	wr(b + PLL_MODE, rd(b + PLL_MODE) | PLL_OUTCTRL);
+	say("  %s locked: mode %#x user_ctl %#x", p->name, rd(b + PLL_MODE), rd(b + PLL_USER_CTL));
+	return true;
+}
+
+static void
+pll_disable(const struct cam_pll *p)
+{
+	vm_offset_t b = camcc + p->off;
+	wr(b + PLL_MODE, rd(b + PLL_MODE) & ~PLL_OUTCTRL);
+	wr(b + PLL_USER_CTL, rd(b + PLL_USER_CTL) & ~PLL_OUT_MASK);
+	wr(b + PLL_OPMODE, 0);
+	say("  %s off: mode %#x", p->name, rd(b + PLL_MODE));
+}
