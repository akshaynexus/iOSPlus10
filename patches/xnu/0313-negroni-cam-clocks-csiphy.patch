+static bool
+l4_csiphy(void)
+{
+	step_begin("csiphy1 c-phy 3 trios");
+	if (drate_idx != 0) {
+		return step_fail("only data-rate entry 0 (<= 1.2 GSps) is carried in this file");
+	}
+	csiphy = ml_io_map_unmappable(CSIPHY1_PA, CSIPHY_SIZE, CAM_WIMG_IO);
+	if (!csiphy) {
+		return step_fail("map");
+	}
+	csiphy_on = true;
+	say("  rails csi-vdd-0p9 pm8350_l5 / csi-vdd-1p2 pm8350_l6: shared with the UFS PHY, on, not voted");
+	/* reset enter (:51-54) */
+	wr(csiphy + 0x1014, 0);
+	wr(csiphy + 0x1000, 1);
+	/* common data (:44-49): DEFAULT_PARAMS entries */
+	wr(csiphy + 0x1084, 0x00);
+	wr(csiphy + 0x1018, 0x01);
+	wr(csiphy + 0x101c, 0x7a);
+	/* config_dev: common regs, lane enable first */
+	wr(csiphy + 0x1014, CPHY_LANE_ENABLE);
+	wr(csiphy + 0x1084, 0x00);
+	wr(csiphy + 0x1018, 0x01);
+	wr(csiphy + 0x101c, 0x7a);
+	for (uint32_t t = 0; t < 3; t++) {
+		for (unsigned i = 0; i < sizeof(cphy_drate0) / sizeof(cphy_drate0[0]); i++) {
+			phy_write(&cphy_drate0[i], 0x400u * t, 0);
+		}
+	}
+	wr(csiphy + 0x108c, 0x0c);              /* entry 0, trio 2 (:548) */
+	for (uint32_t t = 0; t < 3; t++) {
+		for (unsigned i = 0; i < NCPHY_LANE; i++) {
+			phy_write(&cphy_lane[i], 0x400u * t, (t == 2 && i == NCPHY_LANE - 1) ? 100 : 0);
+		}
+	}
+	/* cam_csiphy_cphy_irq_config: csiphy_irq_reg_2_1_0 (:62-74) */
+	static const uint8_t irqv[11] = { 0xff, 0xff, 0xfb, 0xff, 0x7f, 0xff, 0xff, 0xef, 0xff, 0xff, 0xff };
+	for (uint32_t i = 0; i < 11; i++) {
+		wr(csiphy + 0x102c + 4 * i, irqv[i]);
+	}
+	delay(100);                             /* 0x1054 entry delay 0x64 */
+	/* release from reset, 3-phase (:56-60): 0x1000 = 0x0e, delay 0xbe8 us */
+	wr(csiphy + 0x1000, 0x0e);
+	delay(3048);
+	/* trio status (status_regs_2_1_0 :18-24 cphy_lane_status 0x358/0x758/0xb58, low 5 bits; 0 or 8 = normal) */
+	for (uint32_t t = 0; t < 3; t++) {
+		uint32_t s = rd(csiphy + 0x358 + 0x400 * t);
+		say("  trio %u status %#x (low 5 bits %#x: %s)", t, s, s & 0x1fu, ((s & 0x1fu) == 0 || (s & 0x1fu) == 8) ?
+		    "normal" : "unexpected");
+	}
+	say("  lane enable %#x, settle count %u, data-rate entry %u, irq status0 %#x", rd(csiphy + 0x1014), settle_cnt,
+	    drate_idx, rd(csiphy + 0x10b0));
+	return step_ok();
+}
+
+/* CSIPHY 3-phase status after the sensor streams (status_regs_2_1_0: 24 words at 0x340 per trio) */
+static void
+csiphy_status(const char *when)
+{
+	if (!csiphy_on) {
+		return;
+	}
+	for (uint32_t t = 0; t < 3; t++) {
+		vm_offset_t b = csiphy + 0x340 + 0x400 * t;
+		say("  CSIPHY1 trio %u %s: status0-7 %#x %#x %#x %#x %#x %#x %#x %#x", t, when, rd(b), rd(b + 4), rd(b + 8),
+		    rd(b + 12), rd(b + 16), rd(b + 20), rd(b + 24), rd(b + 28));
+	}
+	say("  CSIPHY1 irq status %#x %#x %#x %#x", rd(csiphy + 0x10b0), rd(csiphy + 0x10b4), rd(csiphy + 0x10b8),
+	    rd(csiphy + 0x10bc));
+}
