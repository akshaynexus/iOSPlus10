+/* RCG to source src with divider field hid (level 4 path clocks) */
+static bool
+rcg_set(const char *name, uint32_t off, uint32_t src, uint32_t hid)
+{
+	vm_offset_t cmd = camcc + off;
+	uint32_t got = 0, cfg = rd(cmd + 4);
+
+	wr(cmd + 4, (cfg & ~RCG_CFG_MASK) | (hid & 0x1fu) | (src & 7u) << 8);
+	wr(cmd, rd(cmd) | RCG_CMD_ROOT_EN);
+	wr(cmd, rd(cmd) | RCG_CMD_UPDATE);
+	bool ok = poll(cmd, RCG_CMD_UPDATE, 0, 500, &got);
+	wr(cmd, rd(cmd) & ~RCG_CMD_ROOT_EN);
+	say("  %s: cfg %#x -> %#x (src %u div field %u), cmd %#x%s", name, cfg, rd(cmd + 4), src, hid, got,
+	    ok ? "" : " (UPDATE stuck)");
+	return ok;
+}
