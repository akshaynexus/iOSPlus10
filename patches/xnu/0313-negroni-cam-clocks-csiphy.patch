+/* ---- level 4: capture clocks + CSIPHY1 C-PHY (0313) ---- */
+
+static bool
+l4_clocks(void)
+{
+	step_begin("capture clocks");
+	use_plls = (src_mask & 2u) != 0;
+	if (use_plls) {
+		int error = EBUSY;
+		for (unsigned i = 0; i < 200 && error == EBUSY; i++) {
+			error = negroni_rpmh_arc_vote("mxc.lvl", MXC_PLL_LEVEL);
+			if (error == EBUSY) {
+				delay(5000);
+			}
+		}
+		say("  RPMh mxc.lvl level %u: errno %d", MXC_PLL_LEVEL, error);
+		if (error) {
+			return step_fail("MXC vote for the PLL calibration");
+		}
+		mxc_voted = true;
+		for (unsigned i = 0; i < NPLLS; i++) {
+			plls_on |= 1u << i;
+			if (!pll_enable(&cam_plls[i])) {
+				return step_fail("PLL did not lock");
+			}
+		}
+	}
+	for (unsigned i = 0; i < NPATH_RCGS; i++) {
+		path_rcgs_set |= 1u << i;
+		if (!rcg_set(path_rcgs[i].name, path_rcgs[i].off, use_plls ? path_rcgs[i].src : 0, use_plls ? path_rcgs[i].hid : 0)) {
+			return step_fail("RCG update");
+		}
+	}
+	/* IFE0 GDSC (ife0-supply, live.dts:23523), as l1_gdsc */
+	uint32_t v = rd(camcc + CC_IFE0_GDSCR), got = 0;
+	say("  IFE0 GDSCR %#x", v);
+	if (v & GDSC_HW_CONTROL) {
+		return step_fail("IFE0 GDSC under HW control");
+	}
+	if (!(v & GDSC_PWR_ON)) {
+		wr(camcc + CC_IFE0_GDSCR, v & ~GDSC_SW_COLLAPSE);
+		ife_gdsc_ours = true;
+		if (!poll(camcc + CC_IFE0_GDSCR, GDSC_PWR_ON, GDSC_PWR_ON, GDSC_TIMEOUT_US, &got)) {
+			say("  IFE0 GDSCR %#x after %u us", got, GDSC_TIMEOUT_US);
+			return step_fail("IFE0 GDSC did not power on");
+		}
+	}
+	wr(camcc + CC_IFE0_GDSCR, rd(camcc + CC_IFE0_GDSCR) | GDSC_RETAIN_FF);  /* qcom,retain-regs (live.dts:940) */
+	for (unsigned i = 0; i < NPATH_BRANCHES; i++) {
+		path_branches_on |= 1u << i;
+		if (!branch_set(path_branches[i].name, camcc + path_branches[i].off, true, true)) {
+			return step_fail("branch clock did not start");
+		}
+	}
+	return step_ok();
+}
