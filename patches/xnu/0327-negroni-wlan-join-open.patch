+#define TAG_PEER_DELETE_CMD             0x62u
+#define TAG_PEER_SET_PARAM_CMD          0x64u
+#define TAG_PEER_ASSOC_COMPLETE_CMD     0x65u
+#define TAG_VHT_RATE_SET                0x66u
+#define TAG_STA_POWERSAVE_MODE_CMD      0x6cu
+#define TAG_MGMT_TX_SEND_CMD            0x1a6u
+#define TAG_VDEV_START_RESPONSE_EVENT   0x28u
+#define TAG_PEER_STA_KICKOUT_EVENT      0x2bu
+#define TAG_ROAM_EVENT                  0x30u
+#define TAG_MGMT_TX_COMPL_EVENT         0x1a7u
