+} J;
+
+/* ---- WMI helpers ---- */
+static uint8_t *
+tlv(uint8_t *p, uint32_t tag, uint32_t len)
+{
+	uint32_t h = (tag << 16) | (len & 0xffff);
+	memcpy(p, &h, 4);
+	return p + 4;
+}
+
+static uint8_t *
+w32(uint8_t *p, uint32_t v)
 {
-	(void)frame;
-	(void)len;
+	memcpy(p, &v, 4);
+	return p + 4;
+}
+
+static uint8_t *
+wmac(uint8_t *p, const uint8_t mac[6])
+{
+	memset(p, 0, 8);                /* wmi_mac_addr: 6 bytes + 2 pad */
+	memcpy(p, mac, 6);
+	return p + 8;
+}
+
+static uint32_t
+rd32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* the first TLV of an event with `tag` and at least `min` bytes */
+static const uint8_t *
+ev_tlv(const uint8_t *p, uint32_t len, uint32_t tag, uint32_t min)
+{
+	struct wmi_tlv_it it = { p, p + len };
+	const uint8_t *v;
+	uint32_t t, l;
+
+	while (negroni_wmi_tlv_next(&it, &t, &v, &l) == 1) {
+		if (t == tag && l >= min) {
+			return v;
+		}
+	}
+	return NULL;
+}
+
+/* WMI events of the join (inside the service pass: record only). True when handled. */
+bool
+negroni_wlan_join_wmi_event(uint32_t id, const uint8_t *p, uint32_t len)
+{
+	const uint8_t *v;
+
+	switch (id) {
+	case WMI_VDEV_START_RESP_EVENTID:
+		if ((v = ev_tlv(p, len, TAG_VDEV_START_RESPONSE_EVENT, 16))) {
+			J.start_status = rd32(v + 12);
+			J.start_resp = true;
+		}
+		return true;
+	case WMI_VDEV_STOPPED_EVENTID:
+		J.stopped = true;
+		return true;
+	case WMI_PEER_ASSOC_CONF_EVENTID:
+		J.assoc_conf = true;
+		return true;
+	case WMI_PEER_DELETE_RESP_EVENTID:
+		J.peer_deleted = true;
+		return true;
+	case WMI_MGMT_TX_COMPLETION_EVENTID:
+		if ((v = ev_tlv(p, len, TAG_MGMT_TX_COMPL_EVENT, 8))) {
+			uint32_t desc = rd32(v), status = rd32(v + 4);
+			if (desc < MGMT_SLOTS) {
+				J.mgmt_busy[desc] = false;
+			}
+			J.mgmt_done++;
+			if (status != 0) {
+				J.mgmt_fail++;
+			}
+		}
+		return true;
+	case WMI_PEER_STA_KICKOUT_EVENTID:
+		if ((v = ev_tlv(p, len, TAG_PEER_STA_KICKOUT_EVENT, 6)) && J.up && !memcmp(v, J.bss.bssid, 6)) {
+			J.lost = true;
+			J.lost_why = "PEER_STA_KICKOUT";
+		}
+		return true;
+	case WMI_ROAM_EVENTID:
+		if ((v = ev_tlv(p, len, TAG_ROAM_EVENT, 8)) && J.up && rd32(v + 4) == ROAM_REASON_BMISS) {
+			J.lost = true;
+			J.lost_why = "ROAM beacon miss";
+		}
+		return true;
+	case WMI_VDEV_INSTALL_KEY_COMPLETE_EVENTID:
+		negroni_wlan_wpa_key_event(p, len);    /* 0329 */
+		return true;
+	default:
+		return false;
+	}
+}
+
+/* ---- 802.11 frames ---- */
+static uint32_t
+hdr80211(uint8_t *f, uint32_t fc, const uint8_t *da, const uint8_t *bssid)
+{
+	const uint8_t *mac = negroni_wlan_wmi_mac();
+
+	f[0] = (uint8_t)fc;
+	f[1] = (uint8_t)(fc >> 8);
+	f[2] = f[3] = 0;                /* duration: the firmware fills it */
+	memcpy(f + 4, da, 6);
+	memcpy(f + 10, mac, 6);
+	memcpy(f + 16, bssid, 6);
+	uint16_t sc = (uint16_t)(J.seq++ << 4);
+	f[22] = (uint8_t)sc;
+	f[23] = (uint8_t)(sc >> 8);
+	return 24;
+}
+
+/* an element of the BSS's saved elements (NULL if absent) */
+static const uint8_t *
+bss_ie(const struct nwlan_bss *b, uint32_t id, uint32_t *len)
+{
+	for (uint32_t o = 0; o + 2 <= b->ie_len;) {
+		uint32_t el = b->ie[o + 1];
+		if (o + 2 + el > b->ie_len) {
+			break;
+		}
+		if (b->ie[o] == id) {
+			*len = el;
+			return b->ie + o + 2;
+		}
+		o += 2 + el;
+	}
+	return NULL;
+}
+
+static bool
+bss_wmm(const struct nwlan_bss *b)
+{
+	for (uint32_t o = 0; o + 2 <= b->ie_len;) {
+		uint32_t el = b->ie[o + 1];
+		if (o + 2 + el > b->ie_len) {
+			break;
+		}
+		const uint8_t *d = b->ie + o + 2;
+		if (b->ie[o] == 221 && el >= 5 && d[0] == 0x00 && d[1] == 0x50 && d[2] == 0xf2 && d[3] == 2) {
+			return true;
+		}
+		o += 2 + el;
+	}
+	return false;
+}
+
+/* send one management frame by WMI (frame copied into a DMA slot) */
+static int
+mgmt_send(const uint8_t *frame, uint32_t len)
+{
+	uint8_t m[4 + 36 + 4 + MGMT_SEND_DOWNLD_LEN];
+	uint32_t slot = MGMT_SLOTS;
+
+	if (len > MGMT_SLOT || !J.mgmt.nc) {
+		return EMSGSIZE;
+	}
+	for (uint32_t i = 0; i < MGMT_SLOTS; i++) {
+		if (!J.mgmt_busy[i]) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot == MGMT_SLOTS) {
+		return ENOBUFS;
+	}
+	memcpy((void *)(J.mgmt.nc + slot * MGMT_SLOT), frame, len);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	uint64_t a = J.mgmt.dva + (uint64_t)slot * MGMT_SLOT;
+	uint32_t dl = MIN(len, MGMT_SEND_DOWNLD_LEN);
+	memset(m, 0, sizeof(m));
+	uint8_t *p = tlv(m, TAG_MGMT_TX_SEND_CMD, 32);
+	p = w32(p, 0);                  /* vdev */
+	p = w32(p, slot);               /* desc_id */
+	p = w32(p, 0);                  /* chanfreq: the vdev's channel */
+	p = w32(p, (uint32_t)a);
+	p = w32(p, (uint32_t)(a >> 32));
+	p = w32(p, len);
+	p = w32(p, dl);
+	p = w32(p, 0);                  /* tx_params_valid */
+	p = tlv(p, TAG_ARRAY_BYTE, dl);
+	memcpy(p, frame, dl);
+	p += (dl + 3) & ~3u;
+	J.mgmt_busy[slot] = true;
+	J.mgmt_sent++;
+	int error = negroni_wlan_wmi_send(WMI_MGMT_TX_SEND_CMDID, m, (uint32_t)(p - m));
+	if (error) {
+		J.mgmt_busy[slot] = false;
+	}
+	return error;
+}
+
+/* non-beacon management frames from WMI MGMT_RX (service pass: record only) */
+void
+negroni_wlan_sta_join_frame(const uint8_t *f, uint32_t len)
+{
+	if (len < 24 || !J.active) {
+		return;
+	}
+	uint32_t fc = f[0] | f[1] << 8, type = (fc >> 2) & 3, sub = (fc >> 4) & 0xf;
+	const uint8_t *sa = f + 10, *body = f + 24;
+	uint32_t bl = len - 24;
+
+	if (type != 0 || memcmp(sa, J.bss.bssid, 6) || memcmp(f + 4, negroni_wlan_wmi_mac(), 6)) {
+		return;
+	}
+	switch (sub) {
+	case 11:        /* authentication */
+		if (bl >= 6 && (body[0] | body[1] << 8) == 0 && (body[2] | body[3] << 8) == 2) {
+			J.auth_status = (uint16_t)(body[4] | body[5] << 8);
+			J.auth_rx = true;
+		}
+		break;
+	case 1:         /* association response */
+	case 3:         /* reassociation response */
+		if (bl >= 6) {
+			J.assoc_capab = (uint16_t)(body[0] | body[1] << 8);
+			J.assoc_status = (uint16_t)(body[2] | body[3] << 8);
+			J.assoc_aid = (uint16_t)((body[4] | body[5] << 8) & 0x3fff);
+			J.assoc_rx = true;
+		}
+		break;
+	case 10:        /* disassociation */
+	case 12:        /* deauthentication */
+		if (J.up || J.peer) {
+			J.lost = true;
+			J.lost_reason = bl >= 2 ? (uint16_t)(body[0] | body[1] << 8) : 0;
+			J.lost_why = sub == 12 ? "deauthentication from the AP" : "disassociation from the AP";
+		}
+		break;
+	default:
+		break;
+	}
 }
 
 void
 negroni_wlan_sta_beacon_seen(const uint8_t bssid[6])
 {
-	(void)bssid;
+	if (J.active && !memcmp(bssid, J.bss.bssid, 6)) {
+		J.last_beacon_ms = negroni_wlan_ms();
+	}
+}
+
+/* ---- WMI commands ---- */
+static bool
+is_2g(uint32_t f)
+{
+	return f < 3000;
+}
+
+static int
+vdev_start(const struct nwlan_bss *b)
+{
+	uint8_t m[4 + 104 + 4 + 24 + 4];
+	uint32_t chains = negroni_wlan_wmi_chains();
+	uint8_t *p;
+
+	memset(m, 0, sizeof(m));
+	/* wmi_vdev_start_request_cmd: 26 u32 after the header (wmi.h:2681) */
+	p = m + 4;
+	p = w32(p, 0);                          /* vdev_id */
+	p = w32(p, 0);                          /* requestor_id */
+	p = w32(p, b->beacon_int ? b->beacon_int : 100);
+	p = w32(p, 1);                          /* dtim_period (the TIM element updates it in the firmware) */
+	p = w32(p, VDEV_START_LDPC_RX_ENABLED); /* flags */
+	p += 36;                                /* wmi_ssid {len, 8 words}: empty for a STA */
+	p = w32(p, 0);                          /* bcn_tx_rate */
+	p = w32(p, 0);                          /* bcn_txpower */
+	p = w32(p, 0);                          /* num_noa_descriptors */
+	p = w32(p, 0);                          /* disable_hw_ack */
+	p = w32(p, chains);                     /* preferred_tx_streams */
+	p = w32(p, chains);                     /* preferred_rx_streams */
+	p = w32(p, 0);                          /* he_ops */
+	p = w32(p, 0);                          /* cac_duration_ms */
+	p = w32(p, 0);                          /* regdomain */
+	p = w32(p, 0);                          /* min_data_rate */
+	p = w32(p, 0);                          /* mbssid_flags */
+	p = w32(p, 0);                          /* mbssid_tx_vdev_id */
+	(void)tlv(m, TAG_VDEV_START_REQUEST_CMD, (uint32_t)(p - m) - 4);
+	p = tlv(p, TAG_CHANNEL, 24);
+	p = w32(p, b->freq);
+	p = w32(p, b->freq);                    /* band_center_freq1: 20 MHz */
+	p = w32(p, 0);
+	p = w32(p, is_2g(b->freq) ? MODE_11AX_HE20_2G : MODE_11AX_HE20);       /* ath11k_phymodes[band][20] */
+	p = w32(p, (20u << 8) | (20u << 16));   /* reg_info_1: max power, max reg power (dBm) */
+	p = w32(p, 20u << 8);                   /* reg_info_2: max tx power */
+	p = tlv(p, TAG_ARRAY_STRUCT, 0);        /* no NoA descriptors */
+	J.start_resp = false;
+	int error = negroni_wlan_wmi_send(WMI_VDEV_START_REQUEST_CMDID, m, (uint32_t)(p - m));
+	if (!error) {
+		error = negroni_wlan_wmi_wait(&J.start_resp, 3000, "VDEV_START_RESP");
+	}
+	if (!error && J.start_status != 0) {
+		error = negroni_wlan_failed(EIO, "VDEV_START status %u", J.start_status);
+	}
+	return error;
+}
+
+static int
+vdev_simple(uint32_t cmd, uint32_t tag, const char *what)
+{
+	uint8_t m[4 + 4];
+	(void)w32(tlv(m, tag, 4), 0);
+	int error = negroni_wlan_wmi_send(cmd, m, sizeof(m));
+	if (error) {
+		printf("NEGRONI WLAN: JOIN %s not sent (error %d)\n", what, error);
+	}
+	return error;
+}
+
+static int
+peer_cmd(uint32_t cmd, uint32_t tag, bool create)
+{
+	uint8_t m[4 + 4 + 8 + 4];
+	uint8_t *p = tlv(m, tag, create ? 16 : 12);
+	p = w32(p, 0);
+	p = wmac(p, J.bss.bssid);
+	if (create) {
+		p = w32(p, 0);                  /* WMI_PEER_TYPE_DEFAULT */
+	}
+	return negroni_wlan_wmi_send(cmd, m, (uint32_t)(p - m));
+}
+
+int
+negroni_wlan_peer_set_param(const uint8_t mac[6], uint32_t param, uint32_t value)
+{
+	uint8_t m[4 + 4 + 8 + 8];
+	uint8_t *p = tlv(m, TAG_PEER_SET_PARAM_CMD, 20);
+	p = w32(p, 0);
+	p = wmac(p, mac);
+	p = w32(p, param);
+	p = w32(p, value);
+	return negroni_wlan_wmi_send(WMI_PEER_SET_PARAM_CMDID, m, (uint32_t)(p - m));
+}
+
+static int
+vdev_set_param(uint32_t param, uint32_t value)
+{
+	uint8_t m[4 + 12];
+	uint8_t *p = tlv(m, TAG_VDEV_SET_PARAM_CMD, 12);
+	p = w32(p, 0);
+	p = w32(p, param);
+	p = w32(p, value);
+	return negroni_wlan_wmi_send(WMI_VDEV_SET_PARAM_CMDID, m, (uint32_t)(p - m));
+}
+
+static int
+sta_ps_off(void)
+{
+	uint8_t m[4 + 8];
+	uint8_t *p = tlv(m, TAG_STA_POWERSAVE_MODE_CMD, 8);
+	p = w32(p, 0);
+	p = w32(p, 0);                  /* WMI_STA_PS_MODE_DISABLED */
+	return negroni_wlan_wmi_send(WMI_STA_POWERSAVE_MODE_CMDID, m, (uint32_t)(p - m));
+}
+
+/* ath11k_parse_mpdudensity */
+static uint32_t
+mpdu_density(uint32_t d)
+{
+	static const uint8_t t[8] = { 0, 1, 1, 1, 2, 4, 8, 16 };
+	return t[d & 7];
+}
+
+/* the AP's rates in ath11k's form: 500 kb/s units, bit 7 for CCK (ath11k_mac_bitrate_to_rate) */
+static uint32_t
+legacy_rates(const struct nwlan_bss *b, uint8_t out[16])
+{
+	uint32_t n = 0, l;
+	const uint8_t *d;
+
+	for (uint32_t id = 1; id <= 50; id += 49) {     /* supported rates (1), extended (50) */
+		if (!(d = bss_ie(b, id, &l))) {
+			continue;
+		}
+		for (uint32_t i = 0; i < l && n < 16; i++) {
+			uint32_t r = d[i] & 0x7f;
+			if (r == 0x7f || r == 0) {
+				continue;               /* BSS membership selectors */
+			}
+			bool cck = r == 2 || r == 4 || r == 11 || r == 22;
+			if (cck && !is_2g(b->freq)) {
+				continue;
+			}
+			out[n++] = (uint8_t)(r | (cck ? 0x80 : 0));
+		}
+	}
+	return n;
+}
+
+/* WMI_PEER_ASSOC from the AP's elements (ath11k_peer_assoc_prepare for a 20 MHz HT or legacy peer) */
+static int
+peer_assoc(bool rsn)
+{
+	static uint8_t m[512];
+	uint8_t leg[16], ht[16];
+	uint32_t nleg = legacy_rates(&J.bss, leg), nht = 0, l = 0;
+	const uint8_t *htc = bss_ie(&J.bss, 45, &l);
+	bool has_ht = htc && l >= 19;
+	uint32_t chains = MAX(negroni_wlan_wmi_chains(), 1u), nss = 1;
+	uint32_t flags = PEER_AUTH, rate_caps = 0, ht_caps = 0, max_mpdu = 0, density = 0, phymode;
+	bool ofdm_only = true;
+
+	for (uint32_t i = 0; i < nleg; i++) {
+		ofdm_only = ofdm_only && !(leg[i] & 0x80);
+	}
+	if (has_ht) {
+		uint32_t cap = htc[0] | htc[1] << 8, ampdu = htc[2];
+		ht_caps = cap & ~(0x20u | 0x40u);       /* SGI bits cleared, RC_SGI instead (default GI) */
+		max_mpdu = (1u << (13 + (ampdu & 3))) - 1;
+		density = mpdu_density((ampdu >> 2) & 7);
+		rate_caps |= RC_HT_FLAG;
+		if (cap & 0x20) {
+			rate_caps |= RC_SGI_FLAG;
+		}
+		if (cap & 0x1) {
+			flags |= PEER_LDPC;
+		}
+		for (uint32_t i = 0; i < 8 * MIN(chains, 2u); i++) {
+			if (htc[3 + i / 8] & (1u << (i % 8))) {
+				ht[nht++] = (uint8_t)i;
+				nss = MAX(nss, i / 8 + 1);
+			}
+		}
+		if (htc[4] && chains >= 2) {
+			rate_caps |= RC_DS_FLAG;
+		}
+		if (nht == 0) {                         /* ath11k: MCS 0-7 are mandatory */
+			for (nht = 0; nht < 8; nht++) {
+				ht[nht] = (uint8_t)nht;
+			}
+		}
+		flags |= PEER_HT;
+	}
+	if (bss_wmm(&J.bss)) {
+		flags |= PEER_QOS;                      /* is_wme_set + qos_flag */
+	} else {
+		flags &= ~(PEER_HT | PEER_LDPC);        /* ath11k sets HT flags only with WME */
+	}
+	if (rsn) {
+		flags |= PEER_NEED_PTK_4_WAY;
+		flags &= ~PEER_AUTH;                    /* authorised at key installation (hw crypto) */
+	}
+	if (is_2g(J.bss.freq)) {
+		phymode = has_ht ? MODE_11NG_HT20 : ofdm_only ? MODE_11G : MODE_11B;
+	} else {
+		phymode = has_ht ? MODE_11NA_HT20 : MODE_11A;
+	}
+
+	uint32_t la = (nleg + 3) & ~3u, ha = (nht + 3) & ~3u;
+	uint8_t *p = m;
+	memset(m, 0, sizeof(m));
+	/* wmi_peer_assoc_complete_cmd: hdr, mac(8), then 17 u32 up to num_peer_ht_rates..., see wmi.h */
+	uint8_t *c = p + 4;
+	c = wmac(c, J.bss.bssid);
+	c = w32(c, 0);                          /* vdev_id */
+	c = w32(c, 1);                          /* peer_new_assoc */
+	c = w32(c, J.assoc_aid);                /* peer_associd */
+	c = w32(c, flags);
+	c = w32(c, J.assoc_capab);              /* peer_caps */
+	c = w32(c, 10);                         /* peer_listen_intval (our ASSOC REQ) */
+	c = w32(c, ht_caps);
+	c = w32(c, max_mpdu);
+	c = w32(c, density);
+	c = w32(c, rate_caps);
+	c = w32(c, nss);
+	c = w32(c, 0);                          /* peer_vht_caps */
+	c = w32(c, phymode);
+	c = w32(c, 0);                          /* peer_ht_info[0] */
+	c = w32(c, 0);                          /* peer_ht_info[1] */
+	c = w32(c, nleg);
+	c = w32(c, nht);
+	c = w32(c, 0);                          /* peer_bw_rxnss_override */
+	/* wmi_ppe_threshold: numss_m1, ru_count, ppet16_ppet8_ru3_ru0[8] */
+	for (int i = 0; i < 10; i++) {
+		c = w32(c, 0);
+	}
+	c = w32(c, 0);                          /* peer_he_cap_info */
+	c = w32(c, 0);                          /* peer_he_ops */
+	for (int i = 0; i < 3; i++) {
+		c = w32(c, 0);                  /* peer_he_cap_phy[3] */
+	}
+	c = w32(c, 0);                          /* peer_he_mcs */
+	c = w32(c, 0);                          /* peer_he_cap_info_ext */
+	c = w32(c, 0);                          /* peer_he_cap_info_internal */
+	c = w32(c, 0);                          /* min_data_rate */
+	c = w32(c, 0);                          /* peer_he_caps_6ghz */
+	(void)tlv(p, TAG_PEER_ASSOC_COMPLETE_CMD, (uint32_t)(c - p) - 4);
+	p = tlv(c, TAG_ARRAY_BYTE, la);
+	memcpy(p, leg, nleg);
+	p += la;
+	p = tlv(p, TAG_ARRAY_BYTE, ha);
+	memcpy(p, ht, nht);
+	p += ha;
+	p = tlv(p, TAG_VHT_RATE_SET, 20);       /* wmi_vht_rate_set: not VHT capable -> zeroes */
+	p += 20;
+	p = tlv(p, TAG_ARRAY_STRUCT, 0);        /* no HE rate sets */
+	J.assoc_conf = false;
+	int error = negroni_wlan_wmi_send(WMI_PEER_ASSOC_CMDID, m, (uint32_t)(p - m));
+	printf("NEGRONI WLAN: JOIN PEER_ASSOC: AID %u, phymode %u, %u legacy + %u HT rates, nss %u, flags %#x, rate caps %#x, "
+	    "ht caps %#x\n", J.assoc_aid, phymode, nleg, nht, nss, flags, rate_caps, ht_caps);
+	if (!error) {
+		error = negroni_wlan_wmi_wait(&J.assoc_conf, 1000, "PEER_ASSOC_CONF");
+	}
+	return error;
+}
+
+static int
+vdev_up(void)
+{
+	uint8_t m[4 + 8 + 16 + 8];
+	uint8_t *p = tlv(m, TAG_VDEV_UP_CMD, 32);
+	p = w32(p, 0);
+	p = w32(p, J.assoc_aid);
+	p = wmac(p, J.bss.bssid);
+	p = wmac(p, (const uint8_t[6]){ 0 });   /* tx_vdev_bssid */
+	p = w32(p, 0);
+	p = w32(p, 0);
+	return negroni_wlan_wmi_send(WMI_VDEV_UP_CMDID, m, (uint32_t)(p - m));
 }
 
+/* wait for a received frame flag, servicing the chip; false on time-out */
+static bool
+wait_frame(volatile bool *flag, uint32_t ms)
+{
+	uint64_t deadline = negroni_wlan_ms() + ms;
+	while (!*flag) {
+		if (negroni_wlan_service() || negroni_wlan_ms() >= deadline) {
+			return false;
+		}
+		negroni_wlan_nap(2);
+	}
+	return true;
+}
+
+static int
+send_auth(void)
+{
+	uint8_t f[24 + 6];
+	uint32_t n = hdr80211(f, 0x00b0, J.bss.bssid, J.bss.bssid);
+	f[n++] = 0; f[n++] = 0;                 /* open system */
+	f[n++] = 1; f[n++] = 0;                 /* transaction 1 */
+	f[n++] = 0; f[n++] = 0;                 /* status */
+	return mgmt_send(f, n);
+}
+
+static int
+send_assoc(const uint8_t *rsn_ie, uint32_t rsn_len)
+{
+	uint8_t f[MGMT_SLOT];
+	uint32_t n = hdr80211(f, 0x0000, J.bss.bssid, J.bss.bssid), l;
+	uint16_t capab = 0x0001 | (J.bss.capab & (0x0020 | 0x0400)) | (rsn_len ? 0x0010 : 0);
+	const uint8_t *d;
+
+	f[n++] = (uint8_t)capab;
+	f[n++] = (uint8_t)(capab >> 8);
+	f[n++] = 10; f[n++] = 0;                /* listen interval */
+	f[n++] = 0;                             /* SSID */
+	f[n++] = J.bss.ssid_len;
+	memcpy(f + n, J.bss.ssid, J.bss.ssid_len);
+	n += J.bss.ssid_len;
+	for (uint32_t id = 1; id <= 50; id += 49) {     /* rates as the AP announces them */
+		if ((d = bss_ie(&J.bss, id, &l)) && l <= 255) {
+			f[n++] = (uint8_t)id;
+			f[n++] = (uint8_t)l;
+			memcpy(f + n, d, l);
+			n += l;
+		}
+	}
+	if (rsn_len && rsn_len + 2 <= 64) {
+		f[n++] = 48;
+		f[n++] = (uint8_t)rsn_len;
+		memcpy(f + n, rsn_ie, rsn_len);
+		n += rsn_len;
+	}
+	if (bss_ie(&J.bss, 45, &l) && bss_wmm(&J.bss)) {
+		/* HT capabilities (9.4.2.56): LDPC, SM PS disabled, SGI 20; A-MPDU 64 KiB; MCS 0-7 (0-15 with 2 chains) */
+		uint16_t cap = 0x0001 | 0x000c | 0x0020;
+		memset(f + n, 0, 28);
+		f[n] = 45;
+		f[n + 1] = 26;
+		f[n + 2] = (uint8_t)cap;
+		f[n + 3] = (uint8_t)(cap >> 8);
+		f[n + 4] = 0x03;                        /* max A-MPDU exponent 3, no density restriction */
+		f[n + 5] = 0xff;                        /* rx MCS bitmask: MCS 0-7 */
+		f[n + 6] = negroni_wlan_wmi_chains() >= 2 ? 0xff : 0x00;
+		f[n + 17] = 0x01;                       /* tx MCS set defined (byte 12 of the MCS set) */
+		n += 28;
+	}
+	if (bss_wmm(&J.bss)) {
+		static const uint8_t wmm[9] = { 221, 7, 0x00, 0x50, 0xf2, 2, 0, 1, 0 };
+		memcpy(f + n, wmm, sizeof(wmm));
+		n += sizeof(wmm);
+	}
+	return mgmt_send(f, n);
+}
+
+static int
+send_deauth(uint16_t reason)
+{
+	uint8_t f[26];
+	uint32_t n = hdr80211(f, 0x00c0, J.bss.bssid, J.bss.bssid);
+	f[n++] = (uint8_t)reason;
+	f[n++] = (uint8_t)(reason >> 8);
+	return mgmt_send(f, n);
+}
+
+/* everything down, back to IDLE (ath11k bss_disassoc + peer delete + vdev stop) */
+static void
+join_down(int error, uint16_t reason, const char *why)
+{
+	negroni_wlan_wpa_reset();                       /* 0329: keys and handshake state */
+	negroni_wlan_dp_link_down();                   /* 0328 */
+	if (J.up) {
+		(void)vdev_simple(WMI_VDEV_DOWN_CMDID, TAG_VDEV_DOWN_CMD, "VDEV_DOWN");
+	}
+	/* ath11k station_remove with vdev_start_delay: stop the vdev early, then delete the peer */
+	if (J.vdev_started) {
+		J.stopped = false;
+		if (!vdev_simple(WMI_VDEV_STOP_CMDID, TAG_VDEV_STOP_CMD, "VDEV_STOP")) {
+			(void)negroni_wlan_wmi_wait(&J.stopped, 3000, "VDEV_STOPPED");
+		}
+	}
+	if (J.peer) {
+		J.peer_deleted = false;
+		if (!peer_cmd(WMI_PEER_DELETE_CMDID, TAG_PEER_DELETE_CMD, false)) {
+			(void)negroni_wlan_wmi_wait(&J.peer_deleted, 3000, "PEER_DELETE_RESP");
+		}
+	}
+	printf("NEGRONI WLAN: JOIN down: %s (error %d, 802.11 code %u)\n", why, error, reason);
+	J.up = J.peer = J.vdev_started = J.active = false;
+	negroni_wlan_sta_set_link(NULL, NWLAN_STATE_IDLE, error, reason, 0);
+}
+
+/* the whole join, on the driver thread (top level) */
+static void
+join_run(const uint8_t *ssid, uint32_t ssid_len, const char *psk, uint32_t psk_len)
+{
+	int error;
+	bool rsn = psk_len != 0;
+
+	if (!negroni_wlan_sta_find(ssid, ssid_len, &J.bss)) {
+		printf("NEGRONI WLAN: JOIN: SSID not in the list; scanning\n");
+		negroni_wlan_sta_set_link(NULL, NWLAN_STATE_SCANNING, 0, 0, 0);
+		if (negroni_wlan_wmi_scan_start() == 0) {
+			uint64_t deadline = negroni_wlan_ms() + 30000;
+			while (negroni_wlan_sta_state() == NWLAN_STATE_SCANNING && negroni_wlan_ms() < deadline) {
+				if (negroni_wlan_service()) {
+					break;
+				}
+				negroni_wlan_nap(5);
+			}
+		}
+		if (!negroni_wlan_sta_find(ssid, ssid_len, &J.bss)) {
+			negroni_wlan_sta_join_failed(NULL, ENOENT, 0);         /* LINK_DOWN with last_error */
+			printf("NEGRONI WLAN: JOIN: no BSS with that SSID\n");
+			return;
+		}
+	}
+	if ((J.bss.security & (NWLAN_SEC_WEP | NWLAN_SEC_WPA | NWLAN_SEC_WPA2_OTHER)) ||
+	    (rsn != !!(J.bss.security & NWLAN_SEC_WPA2_PSK))) {
+		printf("NEGRONI WLAN: JOIN: BSS security %#x does not match the request (%s)\n", J.bss.security,
+		    rsn ? "WPA2-PSK" : "open");
+		negroni_wlan_sta_join_failed(&J.bss, ENOTSUP, 0);
+		return;
+	}
+	J.active = true;
+	J.lost = false;
+	J.last_beacon_ms = negroni_wlan_ms();
+	negroni_wlan_sta_set_link(&J.bss, NWLAN_STATE_JOINING, 0, 0, 0);
+	printf("NEGRONI WLAN: JOIN %02x:%02x:%02x:xx:xx:xx, %u MHz, RSSI %d dBm, security %#x\n", J.bss.bssid[0],
+	    J.bss.bssid[1], J.bss.bssid[2], J.bss.freq, J.bss.rssi, J.bss.security);
+
+	if (!J.mgmt.nc && (error = negroni_wlan_dma_alloc(MGMT_SLOTS * MGMT_SLOT, &J.mgmt))) {
+		join_down(error, 0, "no DMA buffer for management frames");
+		return;
+	}
+	/* WCN6855 has vdev_start_delay: the BSS peer must exist before VDEV_START (ath11k mac.c assign_vif_chanctx) */
+	if ((error = peer_cmd(WMI_PEER_CREATE_CMDID, TAG_PEER_CREATE_CMD, true))) {
+		join_down(error, 0, "PEER_CREATE not sent");
+		return;
+	}
+	J.peer = true;
+	if ((error = negroni_wlan_dp_wait_peer(J.bss.bssid))) {        /* 0328: HTT peer map + dp peer setup */
+		join_down(error, 0, "peer map / data path peer setup");
+		return;
+	}
+	if ((error = vdev_start(&J.bss))) {
+		join_down(error, 0, "VDEV_START failed");
+		return;
+	}
+	J.vdev_started = true;
