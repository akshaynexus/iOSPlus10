+#define TAG_VDEV_START_REQUEST_CMD      0x58u
+#define TAG_VDEV_UP_CMD                 0x5cu
+#define TAG_VDEV_STOP_CMD               0x5du
+#define TAG_VDEV_DOWN_CMD               0x5eu
+#define TAG_VDEV_SET_PARAM_CMD          0x5fu
