+/* ---- request mailbox (API threads) ---- */
+static LCK_GRP_DECLARE(j_grp, "negroni_wlan_join");
+static LCK_MTX_DECLARE(j_mtx, &j_grp);
+static struct {
+	bool assoc, disassoc;
+	uint8_t ssid[NWLAN_SSID_MAX];
+	uint32_t ssid_len;
+	char psk[NWLAN_PSK_MAX + 1];
+	uint32_t psk_len;
+} R;
+
+/* ---- driver-thread state ---- */
+static struct {
+	/* event flags (set in the service pass) */
+	volatile bool start_resp, assoc_conf, stopped, peer_deleted;
+	uint32_t start_status;
+	volatile bool auth_rx, assoc_rx;
+	uint16_t auth_status, assoc_status, assoc_aid, assoc_capab;
+	volatile bool lost;
+	uint16_t lost_reason;
+	const char *lost_why;
+	/* the BSS being joined / joined */
+	struct nwlan_bss bss;
+	bool active, vdev_started, peer, up;
+	uint64_t last_beacon_ms;
+	uint16_t seq;
+	/* management TX */
