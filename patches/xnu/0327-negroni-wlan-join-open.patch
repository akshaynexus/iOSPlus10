+/* ---- a small DMA buffer (contiguous, Normal NC view, device address through the SMMU) ---- */
+#define WLAN_WIMG_WCOMB                 0x6u
+int
+negroni_wlan_dma_alloc(uint32_t size, struct nwlan_dma *d)
+{
+	memset(d, 0, sizeof(*d));
+	d->size = (size + PAGE_MASK) & ~(uint32_t)PAGE_MASK;
+	if (kmem_alloc_contig(kernel_map, &d->kva, d->size, PAGE_MASK, (ppnum_t)(atop_64(MHI_DMA_MASK + 1) - 1), 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		d->kva = 0;
+		return ENOMEM;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)d->kva);
+	d->pa = ptoa_64(pn);
+	flush_dcache64((addr64_t)d->pa, d->size, TRUE);
+	d->nc = ml_io_map_unmappable((vm_offset_t)d->pa, d->size, WLAN_WIMG_WCOMB);
+	d->dva = d->nc ? negroni_wlan_dma_map(d->pa, d->size) : WLAN_DMA_NONE;
+	if (!pn || !d->nc || d->dva == WLAN_DMA_NONE) {
+		negroni_wlan_dma_free(d);
+		return ENOMEM;
+	}
+	return 0;
+}
+
+/* only after the chip can no longer use it (unmapped from the SMMU first) */
 void
-negroni_wlan_sta_join_frame(const uint8_t *frame, uint32_t len)
+negroni_wlan_dma_free(struct nwlan_dma *d)
+{
+	if (d->dva && d->dva != WLAN_DMA_NONE) {
+		negroni_wlan_dma_unmap(d->dva, d->size);
+	}
+	if (d->nc) {
+		ml_io_unmap(d->nc, d->size);
+	}
+	if (d->kva) {
+		flush_dcache64((addr64_t)d->pa, d->size, TRUE);
+		kmem_free(kernel_map, d->kva, d->size);
+	}
+	memset(d, 0, sizeof(*d));
+}
