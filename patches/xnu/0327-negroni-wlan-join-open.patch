+#define PEER_QOS                        0x2u
+#define PEER_NEED_PTK_4_WAY             0x4u
+#define PEER_HT                         0x1000u
+#define PEER_LDPC                       0x10000u
+#define RC_DS_FLAG                      0x01u
+#define RC_SGI_FLAG                     0x04u
