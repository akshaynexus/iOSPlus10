# Keep device dumps, serial numbers, firmware and Apple artifacts out of git.
*.img
*.simg
*.zip
*.ipsw
*.dmg
*.bin
*.efi
*.fd
*.macho
*.adt
getvar*.txt
backup/
dumps/
out/
inputs/
.DS_Store
logs/
tools/op10tool/target/
__pycache__/
# Hand builds in the source folder (userland/rebootapp/build.sh writes to out/powermenu/).
userland/rebootapp/PowerMenu
userland/rebootapp/*.app/
userland/rebootapp/_CodeSignature/
