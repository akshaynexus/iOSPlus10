@@ -352,6 +356,34 @@
       mesa_logi("Found compatible device '%s'.", path);

    return result;
+#elif defined(__APPLE__) && defined(TU_HAS_MSM)
+   struct tu_instance *instance =
+      container_of(vk_instance, struct tu_instance, vk);
+   int fd = drmOpenWithType("msm", NULL, DRM_NODE_RENDER);
+   if (fd < 0)
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+   char driver_name[] = "msm";
+   struct _drmVersion version = { .version_major = 1, .version_minor = 7,
+                                  .name_len = 3, .name = driver_name };
+   struct tu_physical_device *device = NULL;
+   VkResult result = tu_knl_drm_msm_load(instance, fd, &version, &device);
+   if (result != VK_SUCCESS) {
+      close(fd);
+      return result;
+   }
+   device->master_fd = -1;
+   device->kgsl_dma_fd = -1;
+   snprintf(device->fd_path, ARRAY_SIZE(device->fd_path), "%s", "RedwoodGPU");
+   device->has_master = false;
+   device->has_local = false;
+   result = tu_physical_device_init(device, instance);
+   if (result != VK_SUCCESS) {
+      close(fd);
+      vk_free(&instance->vk.alloc, device);
+      return result;
+   }
+   list_addtail(&device->vk.link, &instance->vk.physical_devices.list);
+   return VK_SUCCESS;
 #else
    return VK_ERROR_INCOMPATIBLE_DRIVER;
