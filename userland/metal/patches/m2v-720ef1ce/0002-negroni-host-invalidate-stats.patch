NegroniMetal change to metal2vulkan 720ef1ce, on top of m2v/0001 (applied by scripts/metal/fetch-sources.sh):
counters for CommandBuffer::invalidate_host_imports (calls with ranges, ranges, bytes), read by the frontend's
telemetry through the C symbol m2v_negroni_host_invalidate_stat (flame/0006), with no bridge ABI change.

--- a/crates/metal2vulkan-runtime/src/command_buffer/mod.rs
+++ b/crates/metal2vulkan-runtime/src/command_buffer/mod.rs
@@ -1281,6 +1281,10 @@
             }
         }
         if !ranges.is_empty() {
+            use std::sync::atomic::Ordering::Relaxed;
+            HOST_INVALIDATE[0].fetch_add(1, Relaxed);
+            HOST_INVALIDATE[1].fetch_add(ranges.len() as u64, Relaxed);
+            HOST_INVALIDATE[2].fetch_add(ranges.iter().map(|range| range.size).sum(), Relaxed);
             // SAFETY: each range is a live import of this device (the command buffer holds its
             // buffer), host-visible, mapped at the caller's pointer for its whole size.
             let _ = unsafe { shared.vk().invalidate_mapped_memory_ranges(&ranges) };
@@ -2944,4 +2948,18 @@
         Error::OutOfMemory(_) => CommandBufferError::OutOfMemory,
         _ => CommandBufferError::Internal(super::error::VkResultCode(error.as_raw())),
     }
+}
+
+/// NegroniMetal: `CommandBuffer::invalidate_host_imports` calls that had ranges, the ranges and
+/// their bytes, since the process started (the frontend's telemetry, `native_bridge_metal_telemetry`).
+static HOST_INVALIDATE: [std::sync::atomic::AtomicU64; 3] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+
+/// NegroniMetal: one of the host-import invalidation counters (`HOST_INVALIDATE`): 0 calls,
+/// 1 ranges, 2 bytes; 0 for any other `which`. A C symbol: the frontend reads it without a
+/// bridge change.
+#[unsafe(no_mangle)]
+pub extern "C" fn m2v_negroni_host_invalidate_stat(which: u32) -> u64 {
+    let count = HOST_INVALIDATE.get(which as usize);
+    count.map_or(0, |count| count.load(std::sync::atomic::Ordering::Relaxed))
 }
