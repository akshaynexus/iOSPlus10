+// NegroniMetal: SPI -finish waits for every command buffer of this queue that is committed and not yet complete
+- (void)finish {
+ NSArray *pending;
+ @synchronized(gInFlight){pending=[gInFlight allObjects];}
+ for(NBCommandBuffer *commandBuffer in pending)
+  if([commandBuffer isKindOfClass:[NBCommandBuffer class]] && commandBuffer.queue==self)[(id<MTLCommandBuffer>)commandBuffer waitUntilCompleted];
