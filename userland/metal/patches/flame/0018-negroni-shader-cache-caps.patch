+
+/// Build-time caps of metal2vulkan's shader cache, set by a device port (scripts/laurel/metal-env.sh: NMB_SHADER_MEMO_MB,
+/// NMB_SHADER_DISK_MB). Unset (negroni) = metal2vulkan's defaults: a 256 MiB memo of compiled pipelines per device
+/// (per process) and a 25 GiB directory. The Mi A3 (4-6 GB RAM, every Metal process its own device) takes far less.
+pub fn shader_cache_caps(c: &mut metal2vulkan_runtime::ShaderCacheOptions) {
+    let mb = |v: Option<&str>| v.and_then(|v| v.parse::<u64>().ok()).filter(|&v| v > 0);
+    if let Some(m) = mb(option_env!("NMB_SHADER_MEMO_MB")) {
+        c.memory_capacity = m << 20;
+    }
+    if let Some(m) = mb(option_env!("NMB_SHADER_DISK_MB")) {
+        c.capacity = m << 20;
+    }
+}
