NegroniMetal change to ios-flame 745c434 phone/metal2 (on top of flame/0001-0007), applied by scripts/metal/fetch-sources.sh:
- noteRefused(): every refused buffer, texture, library, render/compute pipeline (and binary archive, through failWith) is logged to the
  plugin log once per (what, reason) text, with what was asked for: buffer length and options, texture type/format/size/levels/usage/options,
  pipeline label, function names, attachment formats, library path and size. failWith() used to count the problem without a log line, so a
  refused pipeline showed only as "nil render pipeline" (flame/0002) and in pipelines.log.
- newBufferWithLength:options: and newBufferWithBytes:length:options: retry a refused buffer under 1 MiB: first without the CPU cache mode
  (MTLResourceCPUCacheModeWriteCombined -> default), then with plain shared options (0); a retry that works is logged once with both option
  words. nil only when every form is refused (the runtime is dead or out of memory). AegirPoster's -[NUNIAegirRenderer
  getOrCreateUniformBufferforFrameBufferIndex:] inserts the buffer into an NSMutableArray without a nil check (sig 6).

--- a/phone/metal2/NativeBridgeMetalFrontend.mm
+++ b/phone/metal2/NativeBridgeMetalFrontend.mm
@@ -96,6 +96,39 @@
  return [NSError errorWithDomain:@"org.blu-sharky.native-metal" code:-1 userInfo:@{NSLocalizedDescriptionKey:why?:@"refused"}];
 }
 static NSString *lastError() {return [NSString stringWithUTF8String:nmb_last_error()];}
+// NegroniMetal (flame/0008): every refused buffer, texture, library or pipeline is logged once per (what, reason) text with what was
+// asked for (length, options, descriptor), so the plugin log names the refusal; the counters go on. At most 128 texts.
+static std::mutex gRefuseLock;static NSMutableSet *gRefuseSeen;
+static void noteRefused(NSString *what,NSString *reason) {
+ NSString *text=[NSString stringWithFormat:@"%@: %@",what,reason?:@"?"];
+ {std::lock_guard<std::mutex> lock(gRefuseLock);
+  if(!gRefuseSeen)gRefuseSeen=[NSMutableSet set];
+  if(gRefuseSeen.count>=128 || [gRefuseSeen containsObject:text]){noteProblem(text);return;}
+  [gRefuseSeen addObject:text];}
+ NBLOG(@"native-metal: refused (logged once per reason): %@",text);
+}
+// The options to try after a refused buffer: first without the CPU cache mode (write-combined -> default), then plain shared (0).
+// UINT64_MAX: nothing left to try.
+static uint64_t bufferRetryOptions(uint64_t options,unsigned step) {
+ const uint64_t noCache=options&~(uint64_t)MTLResourceCPUCacheModeMask;
+ if(step==0)return noCache!=options?noCache:(options?0:UINT64_MAX);
+ if(step==1)return noCache!=0?0:UINT64_MAX;
+ return UINT64_MAX;
+}
+// nmb_buffer_new with the retries: a small buffer (< 1 MiB) is made with the next options when the asked ones are refused, each refusal
+// logged once; nil only when every form is refused (the runtime is dead or out of memory).
+static NmbBuffer *bufferWithRetries(NSString *what,uint64_t length,MTLResourceOptions *options,const void *bytes) {
+ NmbBuffer *handle=nmb_buffer_new(gDevice,length,*options,bytes);
+ if(handle)return handle;
+ NSString *first=lastError();const uint64_t asked=*options;
+ for(unsigned step=0;!handle && length<(1u<<20);step++) {
+  const uint64_t next=bufferRetryOptions(asked,step);if(next==UINT64_MAX)break;
+  handle=nmb_buffer_new(gDevice,length,next,bytes);
+  if(handle){noteRefused([NSString stringWithFormat:@"%@ length %llu options 0x%llx (made again with options 0x%llx)",what,(unsigned long long)length,(unsigned long long)asked,(unsigned long long)next],first);*options=(MTLResourceOptions)next;}
+ }
+ if(!handle)noteRefused([NSString stringWithFormat:@"%@ length %llu options 0x%llx",what,(unsigned long long)length,(unsigned long long)asked],first);
+ return handle;
+}
