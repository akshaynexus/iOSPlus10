+// NegroniMetal (flame/0006): a no-copy buffer's memory goes now (its deallocator runs next); is GPU work still using it?
+static void noteNoCopyDealloc(__unsafe_unretained NBBuffer *buffer) {
+ NSArray *pending=nil;@synchronized(gInFlight){pending=gInFlight.count?gInFlight.allObjects:nil;}
+ if(!pending.count)return;
+ gNoCopyDeallocInFlight++;
+ for(NBCommandBuffer *commandBuffer in pending) {
+  if(nmb_command_buffer_uses_buffer(commandBuffer.handle,buffer.handle)<=0)continue;
+  if(gNoCopyDeallocUsed++<8)NBLOG(@"native-metal: no-copy buffer %p (+%lu) deallocated while command buffer %@ uses it",
+   buffer.wrapped,(unsigned long)nmb_buffer_length(buffer.handle),commandBuffer.label);
+  return;
+ }
 }
