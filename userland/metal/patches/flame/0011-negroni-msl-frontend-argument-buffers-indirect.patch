+// ---- NegroniMetal (flame/0011): argument buffers, residency, indirect work ----
+// metal2vulkan's own MTLArgumentEncoder (argument_encoder.rs): each argument is the 8-byte word a program could write itself (a buffer's
+// Metal address + offset, a texture's or sampler's gpu_resource_id), so encoded and hand-written argument buffers reach the translated
+// functions alike. Nothing is made resident by an encoder: the frontend passes useResource(s)/useHeap(s) through nmb_encoder_use_*.
+
+pub struct NmbArgumentEncoder(metal2vulkan_runtime::ArgumentEncoder);
+
+/// MTLArgumentDescriptor's fields as Metal's raw values.
+#[repr(C)]
+pub struct NmbArgumentDescriptor {
+    pub data_type: u64,
+    pub index: u64,
+    pub array_length: u64,
+    pub access: u64,
+    pub texture_type: u64,
+    pub constant_block_alignment: u64,
+}
+
+/// # Safety
+/// `arguments` holds `count` descriptors.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nmb_argument_encoder_new(device: *mut NmbDevice, arguments: *const NmbArgumentDescriptor, count: usize)
+                                                  -> *mut NmbArgumentEncoder {
+    guard(std::ptr::null_mut(), || {
+        if arguments.is_null() && count != 0 {
+            return Err("null argument descriptors".into());
+        }
+        // SAFETY: the caller's contract.
+        let raw_arguments = if count == 0 { &[][..] } else { unsafe { std::slice::from_raw_parts(arguments, count) } };
+        let mut list = Vec::with_capacity(count);
+        for a in raw_arguments {
+            let mut d = metal2vulkan::bind::ArgumentDescriptor::new(raw::<DataType>(a.data_type, "data type")?,
+                                                                    u32::try_from(a.index).map_err(e("argument index"))?);
+            d.array_length = u32::try_from(a.array_length).map_err(e("array length"))?;
+            d.access = raw::<metal2vulkan::metal::BindingAccess>(a.access, "binding access")?;
+            d.texture_type = raw::<TextureType>(a.texture_type, "texture type")?;
+            d.constant_block_alignment = u32::try_from(a.constant_block_alignment).map_err(e("constant block alignment"))?;
+            list.push(d);
+        }
+        let encoder = get(device)?.0.new_argument_encoder_with_arguments(&list).map_err(e("argument encoder"))?;
+        Ok(boxed(NmbArgumentEncoder(encoder)))
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_argument_encoder_new_for_function(function: *mut NmbFunction, buffer_index: u32) -> *mut NmbArgumentEncoder {
+    guard(std::ptr::null_mut(), || {
+        let encoder = get(function)?.0.new_argument_encoder_with_buffer_index(buffer_index).map_err(e("argument encoder"))?;
+        Ok(boxed(NmbArgumentEncoder(encoder)))
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_argument_encoder_new_nested(encoder: *mut NmbArgumentEncoder, index: u32) -> *mut NmbArgumentEncoder {
+    guard(std::ptr::null_mut(), || {
+        let nested = get(encoder)?.0.new_argument_encoder_for_buffer_at_index(index).map_err(e("nested argument encoder"))?;
+        Ok(boxed(NmbArgumentEncoder(nested)))
+    })
+}
