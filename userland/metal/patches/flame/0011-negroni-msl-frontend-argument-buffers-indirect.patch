+/// setArgumentBuffer:startOffset:arrayElement: (setArgumentBuffer:offset: = element 0); a null buffer sets none.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_argument_encoder_set_argument_buffer(encoder: *mut NmbArgumentEncoder, buffer: *mut NmbBuffer, start_offset: u64,
+                                                           element: u64) -> bool {
+    guard(false, || {
+        let buffer = optional(buffer)?.map(|b| &b.0);
+        get_mut(encoder)?.0.set_argument_buffer_start_offset_array_element(buffer, start_offset, element)
+            .map_err(e("set argument buffer"))?;
+        Ok(true)
+    })
+}
