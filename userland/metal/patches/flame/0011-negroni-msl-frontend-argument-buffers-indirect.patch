+/// dispatchThreadgroupsWithIndirectBuffer:indirectBufferOffset:threadsPerThreadgroup:
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_compute_dispatch_indirect(encoder: *mut NmbEncoder, indirect: *mut NmbBuffer, offset: u64, per_group: *const u64) -> bool {
+    guard(false, || {
+        let g = triple(per_group)?;
+        compute(encoder)?.dispatch_threadgroups_indirect(&get(indirect)?.0, offset, Size::new(g[0], g[1], g[2]))
+            .map_err(e("indirect dispatch"))?;
+        Ok(true)
+    })
+}
+
+/// drawPrimitives:indirectBuffer:indirectBufferOffset:
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_render_draw_indirect(encoder: *mut NmbEncoder, primitive: u64, indirect: *mut NmbBuffer, offset: u64) -> bool {
+    guard(false, || {
+        render(encoder)?.draw_primitives_indirect(raw::<PrimitiveType>(primitive, "primitive type")?, &get(indirect)?.0, offset)
+            .map_err(e("indirect draw"))?;
+        Ok(true)
+    })
+}
+
+/// drawIndexedPrimitives:indexType:indexBuffer:indexBufferOffset:indirectBuffer:indirectBufferOffset:
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_render_draw_indexed_indirect(encoder: *mut NmbEncoder, primitive: u64, index_type: u64, indices: *mut NmbBuffer,
+                                                   index_offset: u64, indirect: *mut NmbBuffer, offset: u64) -> bool {
+    guard(false, || {
+        render(encoder)?.draw_indexed_primitives_indirect(raw::<PrimitiveType>(primitive, "primitive type")?,
+                                                          raw::<IndexType>(index_type, "index type")?, &get(indices)?.0, index_offset,
+                                                          &get(indirect)?.0, offset)
+            .map_err(e("indexed indirect draw"))?;
+        Ok(true)
+    })
+}
+
+/// MTLBlitOption is a bit set (DepthFromDepthStencil 1, StencilFromDepthStencil 2, RowLinearPVRTC 4); the runtime takes one
+/// option per copy. RowLinearPVRTC only changes PVRTC formats, so with a depth/stencil bit it is dropped (a texture is not both).
+/// Depth and stencil together (3) are refused: Metal's validation refuses the pair too, the buffer layout of both planes is
+/// not defined.
+fn blit_option(value: u64) -> Result<BlitOption, String> {
+    const DEPTH: u64 = 1;
+    const STENCIL: u64 = 2;
+    const PVRTC: u64 = 4;
+    if value & !(DEPTH | STENCIL | PVRTC) != 0 {
+        return Err(format!("blit option {value:#x} has bits Metal does not define"));
+    }
+    Ok(match (value & DEPTH != 0, value & STENCIL != 0, value & PVRTC != 0) {
+        (true, true, _) => return Err("blit options DepthFromDepthStencil and StencilFromDepthStencil together".into()),
+        (true, false, _) => BlitOption::DepthFromDepthStencil,
+        (false, true, _) => BlitOption::StencilFromDepthStencil,
+        (false, false, true) => BlitOption::RowLinearPVRTC,
+        (false, false, false) => BlitOption::None,
+    })
+}
+
+/// copyFromBuffer:...toTexture:...options:
+#[unsafe(no_mangle)]
+#[allow(clippy::too_many_arguments)]
+pub extern "C" fn nmb_blit_buffer_to_texture_options(encoder: *mut NmbEncoder, source: *mut NmbBuffer, offset: u64, bytes_per_row: u64,
+                                                     bytes_per_image: u64, extent: *const u64, destination: *mut NmbTexture, slice: u64,
+                                                     level: u64, destination_origin: *const u64, options: u64) -> bool {
+    guard(false, || {
+        blit(encoder)?.copy_from_buffer_to_texture(&get(source)?.0, offset, bytes_per_row, bytes_per_image, size(extent)?,
+                                                   &get(destination)?.0, slice, level, origin(destination_origin)?, blit_option(options)?)
+            .map_err(e("buffer to texture"))?;
+        Ok(true)
+    })
+}
+
+/// copyFromTexture:...toBuffer:...options:
+#[unsafe(no_mangle)]
+#[allow(clippy::too_many_arguments)]
+pub extern "C" fn nmb_blit_texture_to_buffer_options(encoder: *mut NmbEncoder, source: *mut NmbTexture, slice: u64, level: u64,
+                                                     source_origin: *const u64, extent: *const u64, destination: *mut NmbBuffer, offset: u64,
+                                                     bytes_per_row: u64, bytes_per_image: u64, options: u64) -> bool {
+    guard(false, || {
+        blit(encoder)?.copy_from_texture_to_buffer(&get(source)?.0, slice, level, origin(source_origin)?, size(extent)?,
+                                                   &get(destination)?.0, offset, bytes_per_row, bytes_per_image, blit_option(options)?)
+            .map_err(e("texture to buffer"))?;
+        Ok(true)
+    })
+}
