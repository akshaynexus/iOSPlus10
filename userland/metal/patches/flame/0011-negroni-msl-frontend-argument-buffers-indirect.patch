+/// useResource:usage:(stages:) for a buffer or a texture (one of them non-null). stages is ignored on a compute encoder.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_encoder_use_resource(encoder: *mut NmbEncoder, buffer: *mut NmbBuffer, texture: *mut NmbTexture, usage: u64,
+                                           stages: u64) -> bool {
+    guard(false, || {
+        let resource: metal2vulkan_runtime::ResourceRef<'_> = match (optional(buffer)?, optional(texture)?) {
+            (Some(b), None) => (&b.0).into(),
+            (None, Some(t)) => (&t.0).into(),
+            _ => return Err("use resource: one buffer or one texture".into()),
+        };
+        let usage = raw::<metal2vulkan::metal::ResourceUsage>(usage, "resource usage")?;
+        match get_mut(encoder)? {
+            NmbEncoder::Compute(c) => c.use_resource(resource, usage),
+            NmbEncoder::Render(r) => r.use_resource(resource, usage, raw::<RenderStages>(stages, "render stages")?),
+            NmbEncoder::Blit(_) => return Err("use resource on a blit encoder".into()),
+        }
+        .map_err(e("use resource"))?;
+        Ok(true)
+    })
+}
+
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_encoder_use_heap(encoder: *mut NmbEncoder, heap: *mut NmbHeap, stages: u64) -> bool {
+    guard(false, || {
+        let heap = &get(heap)?.0;
+        match get_mut(encoder)? {
+            NmbEncoder::Compute(c) => c.use_heap(heap),
+            NmbEncoder::Render(r) => r.use_heap(heap, raw::<RenderStages>(stages, "render stages")?),
+            NmbEncoder::Blit(_) => return Err("use heap on a blit encoder".into()),
+        }
+        .map_err(e("use heap"))?;
+        Ok(true)
+    })
+}
