+ static std::atomic<bool> told{false};
+ if(planes && !told.exchange(true))NBLOG(@"native-metal: first texture over a surface with planes: fmt %lu, plane %lu of %zu, OSType 0x%08x (flame/0016)",
+   (unsigned long)d.pixelFormat,(unsigned long)plane,planes,(unsigned)IOSurfaceGetPixelFormat(surface));
