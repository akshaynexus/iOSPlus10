+/// NegroniMetal (flame/0016): `newTextureWithDescriptor:iosurface:plane:` over a surface with planes. `buffer` stands for the whole
+/// surface (its base address, every plane); the texture lies at `offset` (the plane's base less the surface's) with rows
+/// `bytes_per_row` apart. `planar`: the surface has plane info. The surface's facts (`fourcc`, the asked `plane`, its `width` and
+/// `height`, plane 1's offset and `bytesPerRow`) go to the runtime as `IoSurfaceYCbCr`: a two-plane YCbCr texture reads its
+/// chroma there and a two-plane extended-range one (`RGB10A8_2P_XR10`) its alpha plane; other formats ignore them.
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_texture_new_on_surface_plane(buffer: *mut NmbBuffer, descriptor: *const NmbTextureDescriptor, offset: u64,
+                                                   bytes_per_row: u64, planar: bool, fourcc: u32, plane: u64, width: u64,
+                                                   height: u64, plane1_offset: u64, plane1_bytes_per_row: u64) -> *mut NmbTexture {
+    guard(std::ptr::null_mut(), || {
+        let descriptor = texture_descriptor(descriptor)?;
+        let buffer = &get(buffer)?.0;
+        let mut at = IoSurfacePlane::new(offset, bytes_per_row, planar);
+        if planar {
+            at = at.with_ycbcr(IoSurfaceYCbCr::new(fourcc, plane, [width, height], plane1_offset, plane1_bytes_per_row));
+        }
+        let texture = buffer.new_texture_with_iosurface_plane(&descriptor, at);
+        Ok(boxed(NmbTexture(texture.map_err(e("texture over surface plane"))?)))
+    })
+}
