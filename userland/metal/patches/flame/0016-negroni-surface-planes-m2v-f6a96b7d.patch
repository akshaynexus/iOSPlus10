 // The surface's pages are the texels: its mapping in this process is imported without a copy (pinned by the kernel, mapped into the GPU's
 // 4 KiB context by Turnip), so every process that imports the surface renders and samples the same memory.
+// NegroniMetal (flame/0016): surfaces with planes too. Before, every surface with plane info was nil without a log line: RenderBox's
+// widget drawables in chronod (465x465, OSType '_RB4' = RGB10A8_2P_XR10: plane 0 the 10-bit colour words, plane 1 the alpha bytes)
+// and the same surfaces in backboardd ("Failed to allocate MTLTexture from IOSurface 0x..."), CA's 'b3a8' framebuffers and the
+// posters' '420f' camera/photo surfaces. metal2vulkan (f6a96b7d) makes these over the surface's planes
+// (Buffer::new_texture_with_iosurface_plane with the surface's facts: texture/surface_two_planes.rs, ycbcr.rs).
+static uint32_t surfaceOSType(IOSurfaceRef surface) {
+ const uint32_t type=(uint32_t)IOSurfaceGetPixelFormat(surface);
+ // RenderBox names its own two-plane extended-range surface '_RB4' (RB::create_iosurface, 20H392: plane 0 4 bytes a texel, plane 1
+ // 1 byte a texel); CoreVideo's OSType of that layout is 'b3a8', the one metal2vulkan's two-plane XR10 texture is measured over.
+ if(type=='_RB4' && IOSurfaceGetPlaneCount(surface)==2 && IOSurfaceGetBytesPerElementOfPlane(surface,0)==4 &&
+    IOSurfaceGetBytesPerElementOfPlane(surface,1)==1 &&
+    IOSurfaceGetWidthOfPlane(surface,1)==IOSurfaceGetWidthOfPlane(surface,0) && IOSurfaceGetHeightOfPlane(surface,1)==IOSurfaceGetHeightOfPlane(surface,0))return 'b3a8';
+ return type;
+}
+static NBTexture *textureOnSurfacePlane(NBBuffer *buffer,MTLTextureDescriptor *d,IOSurfaceRef surface,NSUInteger plane) {
+ NmbTextureDescriptor descriptor;if(!buffer || !textureDescriptor(d,&descriptor))return nil;
+ const size_t planes=IOSurfaceGetPlaneCount(surface);
+ const uintptr_t base=(uintptr_t)IOSurfaceGetBaseAddress(surface),at=(uintptr_t)IOSurfaceGetBaseAddressOfPlane(surface,plane);
+ if(at<base)return nil;
+ const uint64_t offset=at-base,row=IOSurfaceGetBytesPerRowOfPlane(surface,plane);
+ uint64_t offset1=0,row1=0;
+ if(planes>1){const uintptr_t one=(uintptr_t)IOSurfaceGetBaseAddressOfPlane(surface,1);if(one>=base){offset1=one-base;row1=IOSurfaceGetBytesPerRowOfPlane(surface,1);}}
+ const uint32_t type=surfaceOSType(surface);
+ NmbTexture *handle=nmb_texture_new_on_surface_plane(buffer.handle,&descriptor,offset,row,true,type,plane,IOSurfaceGetWidth(surface),
+                                                       IOSurfaceGetHeight(surface),offset1,row1);
+ if(!handle){
+  const uint32_t raw=(uint32_t)IOSurfaceGetPixelFormat(surface);
+  noteRefused([NSString stringWithFormat:@"texture fmt %lu usage 0x%lx over plane %lu of %zu of a '%c%c%c%c' surface",(unsigned long)d.pixelFormat,
+    (unsigned long)d.usage,(unsigned long)plane,planes,(char)(raw>>24),(char)(raw>>16),(char)(raw>>8),(char)raw],lastError());
+  return nil;
+ }
+ NBTexture *texture=[NBTexture new];texture.handle=handle;nmb_texture_describe(handle,&descriptor);texture.descriptor=descriptor;
+ texture.buffer=buffer;texture.offset=offset;texture.rowBytes=row;return texture;
+}
