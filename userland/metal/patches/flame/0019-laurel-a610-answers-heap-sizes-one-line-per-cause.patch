+/// `heapTextureSizeAndAlignWithDescriptor:`: what placing this texture in a heap takes on this device (laurel, 2026-11-01).
+#[unsafe(no_mangle)]
+pub extern "C" fn nmb_device_heap_texture_size(
+    device: *const NmbDevice,
+    descriptor: *const NmbTextureDescriptor,
+    size: *mut u64,
+    align: *mut u64,
+) -> bool {
+    guard(false, || {
+        let d = &get(device)?.0;
+        let descriptor = texture_descriptor(descriptor)?;
+        let answer = d.heap_texture_size_and_align(&descriptor).map_err(e("heap texture size"))?;
+        // SAFETY: the caller's words.
+        unsafe {
+            *size = answer.size;
+            *align = answer.align;
+        }
+        Ok(true)
+    })
+}
