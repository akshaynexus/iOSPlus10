+/// NegroniMetal: the device policy from env NEGRONIMETAL_POLICY (docs/metal-management.md).
+/// - `exact`: metal2vulkan's defaults (Metal's 8-bit linear filter and color-write rounding emulated, containment on).
+/// - `compositor` (default, also when unset or unknown): the device's 8-bit unorm linear filter (Turnip row, m2v/0003)
+///   and the device's 8-bit unorm color-write conversion; containment and isolation on.
+/// - `compositor-srgb`: `compositor` plus the device's 8-bit sRGB encode on color writes.
+/// - `unsafe`: `compositor` plus containment UnsafeOff and isolation Off (no bounds checks).
+pub(crate) fn negroni_policy() -> metal2vulkan::device::DevicePolicy {
+    use metal2vulkan::device::{ColorWritesPolicy, ContainmentPolicy, DevicePolicy, GuestIsolation, Unorm8LinearFilterPolicy};
+    let mut policy = DevicePolicy::default();
+    let name = std::env::var("NEGRONIMETAL_POLICY").unwrap_or_default();
+    if name == "exact" {
+        return policy;
+    }
+    policy.unorm8_linear_filter = Unorm8LinearFilterPolicy::DeviceWithinOneCode;
+    policy.color_writes = if name == "compositor-srgb" { ColorWritesPolicy::DeviceUnorm8Srgb } else { ColorWritesPolicy::DeviceUnorm8 };
+    if name == "unsafe" {
+        policy.containment = ContainmentPolicy::UnsafeOff;
+        policy.isolation = GuestIsolation::Off;
+    }
+    policy
+}
+
