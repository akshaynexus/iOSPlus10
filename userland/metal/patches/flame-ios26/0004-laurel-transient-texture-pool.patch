+/* The transient-texture pool (flame-ios26/0004; idea: IOS-26-Hot canPoolTextureDesc, MIT, self-reported on an A640). Plain data, one lock outside. */
+#define LAUREL_POOL_SLOTS 32
+#define LAUREL_POOL_MAX_AGE_US 2000000ull   /* a pooled texture nobody asked for in 2 s goes back: the GPU pool is the phone's short resource */
+struct laurel_pool_slot { void *handle; uint64_t key[8]; uint64_t bytes, stamp_us; };
+struct laurel_pool { struct laurel_pool_slot slot[LAUREL_POOL_SLOTS]; unsigned count; uint64_t bytes; };
+/* Newest first: a texture of the same key. NULL: none. */
+static inline void *laurel_pool_take(struct laurel_pool *p, const uint64_t key[8])
+{
+	for (unsigned i = p->count; i > 0; i--) {
+		struct laurel_pool_slot *s = &p->slot[i - 1];
+		int same = 1;
+		for (unsigned k = 0; k < 8; k++)
+			same &= s->key[k] == key[k];
+		if (same) {
+			void *h = s->handle;
+			p->bytes -= s->bytes;
+			for (unsigned j = i; j < p->count; j++)
+				p->slot[j - 1] = p->slot[j];
+			p->count--;
+			return h;
+		}
+	}
+	return (void *)0;
+}
+/* Takes the oldest slot out and gives its handle. For the caller's release, outside the lock. */
+static inline void *laurel_pool_drop_oldest(struct laurel_pool *p)
+{
+	if (!p->count)
+		return (void *)0;
+	void *h = p->slot[0].handle;
+	p->bytes -= p->slot[0].bytes;
+	for (unsigned j = 1; j < p->count; j++)
+		p->slot[j - 1] = p->slot[j];
+	p->count--;
+	return h;
+}
+/* Room for bytes within cap_bytes and cap_count? The caller drops the oldest until this says yes. */
+static inline int laurel_pool_fits(const struct laurel_pool *p, uint64_t bytes, uint64_t cap_bytes, unsigned cap_count)
+{
+	return p->bytes + bytes <= cap_bytes && p->count < cap_count && p->count < LAUREL_POOL_SLOTS;
+}
+static inline void laurel_pool_put(struct laurel_pool *p, void *handle, const uint64_t key[8], uint64_t bytes, uint64_t now_us)
+{
+	struct laurel_pool_slot *s = &p->slot[p->count++];
+	s->handle = handle;
+	for (unsigned k = 0; k < 8; k++)
+		s->key[k] = key[k];
+	s->bytes = bytes;
+	s->stamp_us = now_us;
+	p->bytes += bytes;
+}
+static inline int laurel_pool_oldest_stale(const struct laurel_pool *p, uint64_t now_us)
+{
+	return p->count && now_us - p->slot[0].stamp_us > LAUREL_POOL_MAX_AGE_US;
+}
 #endif
