+    for(NSUInteger i=0;i<wantFlags.length;i++)if([haveFlags rangeOfString:[wantFlags substringWithRange:NSMakeRange(i,1)]].location==NSNotFound)cost+=3;
+    for(NSUInteger i=0;i<haveFlags.length;i++)if([wantFlags rangeOfString:[haveFlags substringWithRange:NSMakeRange(i,1)]].location==NSNotFound)cost+=10;
+    if(cost<bestCost || (cost==bestCost && (!best || [candidate compare:best]==NSOrderedAscending))){best=candidate;bestCost=cost;}
