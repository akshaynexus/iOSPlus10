+  NSString *best=nil;
+  NSInteger bestCost=NSIntegerMax;
+  if(want)for(NSString *candidate in names) {
+    if(![candidate hasPrefix:prefix])continue;
+    NSString *haveText=[candidate substringFromIndex:prefix.length];
+    NSTextCheckingResult *have=[form firstMatchInString:haveText options:0 range:NSMakeRange(0,haveText.length)];
