@@ -0,0 +1,23 @@
+/* Plain rules of the Mi A3's iOS 26 frontend, with no Objective-C: the frontend includes this file, and so does the host test (userland/laurel/metal/tests/ca-pipelines.c). */
+#ifndef LAUREL_RULES_H
+#define LAUREL_RULES_H
+#include <stdint.h>
+/* maxTotalThreadsPerThreadgroup on a GPU with less threadgroup memory than Apple's 32 KiB. [V 23F84] CA::OGL::MetalContext::compute_surface_apl_dimming_factor takes threadExecutionWidth x
+ * (maxTotal / width) threads and setThreadgroupMemoryLength: 16 bytes per thread. A610: 16 KiB (Mesa cs_shared_mem_size). With the runtime's 1024: 16 KiB + the module's arena: the dispatch is refused, the draw is lost.
+ * The answer keeps 16 bytes per thread and a 4 KiB arena inside the limit, and stays a power of two as Apple's 1024 is (sum_apl_and_compute_dimming_factor's group size is one, capped by this answer; A610: 512 = 32 x 16).
+ * A lower answer is a valid Metal answer: every caller that asks divides its work by it. */
+#define LAUREL_THREADGROUP_BYTES_PER_THREAD 16u
+#define LAUREL_THREADGROUP_ARENA 4096u
+static inline uint64_t laurel_kernel_max_threads(uint64_t runtime_max, uint64_t width, uint64_t shared)
+{
+	if (shared == 0 || shared >= 32768 || shared <= LAUREL_THREADGROUP_ARENA)
+		return runtime_max;
+	uint64_t room = (shared - LAUREL_THREADGROUP_ARENA) / LAUREL_THREADGROUP_BYTES_PER_THREAD;
+	if (room >= runtime_max)
+		return runtime_max;
+	uint64_t answer = 1;
+	while (answer * 2 <= room)
+		answer *= 2;
+	return answer >= width ? answer : runtime_max;
+}
+#endif
