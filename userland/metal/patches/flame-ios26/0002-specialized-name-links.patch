+/// `newFunctionWithDescriptor:`: `specialized_name` is the name a stage links this function under (MTLFunctionDescriptor.specializedName: RenderBox's custom_fn);
+/// null or empty keeps `name`. When `has_constants`, `constants` holds `count` entries, as `nmb_function_new_specialized`.
+///
+/// # Safety
+/// `name` is a C string; `specialized_name` is null or a C string; `constants` as `nmb_function_new_specialized`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn nmb_function_new_with_descriptor(library: *mut NmbLibrary, name: *const c_char, specialized_name: *const c_char,
+                                                          constants: *const NmbConstant, count: u32, has_constants: bool) -> *mut NmbFunction {
+    guard(std::ptr::null_mut(), || {
+        if name.is_null() || (constants.is_null() && count > 0) {
+            return Err("null function name or constants".into());
+        }
+        // SAFETY: the caller's contract.
+        let name = unsafe { CStr::from_ptr(name) }.to_str().map_err(e("function name"))?;
+        let mut descriptor = metal2vulkan_runtime::FunctionDescriptor::new(name);
+        if !specialized_name.is_null() {
+            // SAFETY: the caller's contract.
+            let link_name = unsafe { CStr::from_ptr(specialized_name) }.to_str().map_err(e("specialized function name"))?;
+            if !link_name.is_empty() {
+                descriptor.specialized_name = Some(link_name.to_owned());
+            }
+        }
+        if has_constants {
+            let list = if count == 0 { &[][..] } else { unsafe { std::slice::from_raw_parts(constants, count as usize) } };
+            let mut values = FunctionConstantValues::defaults();
+            for c in list {
+                if c.bytes.is_null() {
+                    return Err("constant without bytes".into());
+                }
+                // SAFETY: the caller's contract.
+                let bytes = unsafe { std::slice::from_raw_parts(c.bytes as *const u8, c.length as usize) };
+                let value = FunctionConstantValue::new(raw::<DataType>(c.kind, "constant type")?, bytes.to_vec());
+                if c.name.is_null() {
+                    values.by_index.insert(u32::try_from(c.index).map_err(e("constant index"))?, value);
+                } else {
+                    // SAFETY: the caller's contract.
+                    let key = unsafe { CStr::from_ptr(c.name) }.to_str().map_err(e("constant name"))?;
+                    values.by_name.insert(key.to_string(), value);
+                }
+            }
+            descriptor.constant_values = Some(values);
+        }
+        let function = get(library)?.0.new_function_with_descriptor(&descriptor).map_err(e("function descriptor"))?;
+        Ok(boxed(NmbFunction(function)))
+    })
+}
