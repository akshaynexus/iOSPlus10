+
+/// laurel (flame-ios26/0007): a render encoder's calls are lowered on the runtime's lowering thread
+/// (`RenderLoweringPolicy::Worker`), not inside each call on CoreAnimation's render thread. On the
+/// Mi A3 the render thread paid the whole lowering: of its busy time in a Home animation 45 % was
+/// metal2vulkan, 13 % Turnip and 5 % malloc, while the other 7 cores had room
+/// (docs/laurel_sprout/ios26-default-speed.md section 7). With the worker a call makes Metal's checks
+/// of its arguments, logs them and returns; the thread lowers the batches of 32 calls in order while
+/// the render thread goes on; the encoder's end and the commit follow on the thread. A refusal only
+/// the lowering finds fails the command buffer (`CommandBufferError::CallRefused`), which
+/// CoreAnimation reads in the status. Self-check: the runtime starts the thread at the first encoder
+/// that logs; where it cannot start, every call is lowered on the program's thread as before, so
+/// nothing is lost. One line: `LAUREL RENDER LOWERING: on|off`. Kill switch `NEGRONIMETAL_LOWERING=0`;
+/// `=1`: the thread with upstream's rule for fetching pipelines (m2v-ios26/0007 relaxes it).
+fn laurel_render_lowering(mut policy: metal2vulkan::device::DevicePolicy) -> metal2vulkan::device::DevicePolicy {
+    use metal2vulkan::device::RenderLoweringPolicy;
+    static SAID: std::sync::Once = std::sync::Once::new();
+    let on = std::env::var_os("NEGRONIMETAL_LOWERING").is_none_or(|v| v != "0");
+    policy.render_lowering = if on { RenderLoweringPolicy::Worker } else { RenderLoweringPolicy::AtCall };
+    SAID.call_once(|| {
+        let name = std::env::args().next().unwrap_or_default();
+        let name = name.rsplit('/').next().unwrap_or("").to_owned();
+        let text = match on {
+            true => "on: render encoder calls lowered on the runtime's lowering thread, fetching pipelines too (NEGRONIMETAL_LOWERING=1: upstream's rule, fetching pipelines at the call; =0: off)",
+            false => "off: NEGRONIMETAL_LOWERING=0: calls lowered inside each call",
+        };
+        let line = format!("NMTL[{} {}]: LAUREL RENDER LOWERING: {}\n", std::process::id(), name, text);
+        for path in ["/dev/console", "/var/db/negronimetal/metal.log"] {
+            if let Ok(mut file) = std::fs::OpenOptions::new().append(true).open(path) {
+                use std::io::Write;
+                let _ = file.write_all(line.as_bytes());
+            }
+        }
+    });
     policy
 }
 
