+/// `rules` with each 8-bit unorm (and, under `DeviceUnorm8Srgb`, 8-bit sRGB) channel left to the
+/// device's conversion where the profile's `ColorWritesPolicy` asks for it (NegroniMetal).
+fn device_8bit(
+    mut rules: [Option<ChannelWrite>; 4],
+    p: &DeviceProfile,
+) -> [Option<ChannelWrite>; 4] {
+    use crate::device::ColorWritesPolicy as P;
+    let srgb = match p.fields().color_writes {
+        P::DeviceUnorm8 => false,
+        P::DeviceUnorm8Srgb => true,
+        _ => return rules,
+    };
+    for rule in rules.iter_mut().flatten() {
+        match rule {
+            ChannelWrite::Unorm { bits: 8 } => *rule = ChannelWrite::Device,
+            ChannelWrite::Srgb if srgb => *rule = ChannelWrite::Device,
+            _ => {}
+        }
+    }
+    rules
+}
