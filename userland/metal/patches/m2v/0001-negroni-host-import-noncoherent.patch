+/// NegroniMetal: the host-visible types among `allowed` that are not host-coherent, for an import
+/// of the caller's host pages of a host-visible `class` (`Shared`, `Managed`, `WriteCombined`)
+/// where the pointer allows no coherent type (`Memory::import_host`), best first: host-cached
+/// ones, then device-local ones. Turnip on Darwin (RedwoodGPU, docs/gpu-abi.md section 6) imports
+/// host pages only as `HOST_CACHED` without `HOST_COHERENT`: the CPU keeps its cached mapping and
+/// the GPU's view is non-cacheable. The kernel cleans the CPU-written pages at each submission
+/// that lists the import, and the command buffer invalidates the CPU's lines over every such
+/// import its commands used when it completes, before its status and handlers say so
+/// (`CommandBuffer::invalidate_host_imports`, `command_buffer/mod.rs`). Empty for any other class
+/// and where a coherent type is allowed (`candidates` serves that).
+pub(super) fn incoherent_host_candidates(
+    types: &[vk::MemoryType],
+    allowed: u32,
+    class: MemoryClass,
+) -> Vec<u32> {
+    use vk::MemoryPropertyFlags as P;
+    if matches!(class, MemoryClass::Private | MemoryClass::Memoryless) {
+        return Vec::new();
+    }
+    let mut ranked: Vec<((u8, u8), u32)> = (types.iter().enumerate())
+        .filter(|&(index, ty)| {
+            let flags = ty.property_flags;
+            allowed & (1 << index) != 0
+                && allocatable(flags)
+                && flags.contains(P::HOST_VISIBLE)
+                && !flags.contains(P::HOST_COHERENT)
+                && !flags.contains(P::LAZILY_ALLOCATED)
+        })
+        .map(|(index, ty)| {
+            let flags = ty.property_flags;
+            let lacks = |wanted: P| u8::from(!flags.contains(wanted));
+            ((lacks(P::HOST_CACHED), lacks(P::DEVICE_LOCAL)), index as u32)
+        })
+        .collect();
+    ranked.sort_by_key(|&(rank, _)| rank);
+    ranked.into_iter().map(|(_, index)| index).collect()
+}
