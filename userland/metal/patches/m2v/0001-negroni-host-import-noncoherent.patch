+impl CommandBuffer {
+    /// NegroniMetal: drop the CPU's cache lines over every host import its commands used whose
+    /// memory type is host-visible but not host-coherent (`memory::incoherent_host_candidates`):
+    /// `vkInvalidateMappedMemoryRanges` over each whole import, once, as it completes. Turnip
+    /// cleans and invalidates them by the caller's pointer (`dc civac`), so the GPU's writes
+    /// become the CPU's (docs/gpu-abi.md section 6 rule 2). The resources come from its ended
+    /// encoders (`used_resources`): a no-copy buffer, a texture over one (an IOSurface's), and a
+    /// heap over host pages. Imports of coherent types, dma-buf imports and released imports are
+    /// left alone.
+    fn invalidate_host_imports(&self) {
+        use vk::MemoryPropertyFlags as P;
+        let used = self.used_resources();
+        let shared = self.device().shared();
+        let mut ranges: Vec<vk::MappedMemoryRange<'_>> = Vec::new();
+        {
+            let memory = lock(&shared.memory);
+            let heaps = used.heaps.iter().filter_map(|heap| heap.bytes());
+            for buffer in used.buffers.iter().chain(heaps) {
+                let Some(pages) = buffer.host_pages() else {
+                    continue;
+                };
+                if pages.over_dma_buf() {
+                    continue;
+                }
+                let incoherent = memory.type_flags(pages.type_index()).is_some_and(|flags| {
+                    flags.contains(P::HOST_VISIBLE) && !flags.contains(P::HOST_COHERENT)
+                });
+                if !incoherent {
+                    continue;
+                }
+                let Some((raw, offset, size)) = pages.import_range() else {
+                    continue;
+                };
+                if size == 0 || ranges.iter().any(|range| range.memory == raw) {
+                    continue;
+                }
+                ranges.push(vk::MappedMemoryRange::default().memory(raw).offset(offset).size(size));
+            }
+        }
+        if !ranges.is_empty() {
+            // SAFETY: each range is a live import of this device (the command buffer holds its
+            // buffer), host-visible, mapped at the caller's pointer for its whole size.
+            let _ = unsafe { shared.vk().invalidate_mapped_memory_ranges(&ranges) };
+        }
+        // Released after the call: what it holds may be a resource's last handle.
+        drop(used);
+    }
+}
