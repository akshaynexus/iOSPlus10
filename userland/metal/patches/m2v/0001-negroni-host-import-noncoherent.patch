@@ -0,0 +1,69 @@
+//! NegroniMetal (m2v/0001): a host-pointer import on Turnip/RedwoodGPU, whose pointer allows only a
+//! host-visible, host-cached type without HOST_COHERENT, takes that type (`Memory::import_host`
+//! through `Memory::import_types`).
+use crate::memory::{candidates, incoherent_host_candidates, Memory, MemoryClass};
+use ash::vk;
+
+fn ty(flags: vk::MemoryPropertyFlags) -> vk::MemoryType {
+    vk::MemoryType {
+        property_flags: flags,
+        heap_index: 0,
+    }
+}
+
+const TYPES: [vk::MemoryPropertyFlags; 4] = [
+    vk::MemoryPropertyFlags::DEVICE_LOCAL,
+    vk::MemoryPropertyFlags::from_raw(
+        vk::MemoryPropertyFlags::DEVICE_LOCAL.as_raw()
+            | vk::MemoryPropertyFlags::HOST_VISIBLE.as_raw()
+            | vk::MemoryPropertyFlags::HOST_COHERENT.as_raw(),
+    ),
+    vk::MemoryPropertyFlags::from_raw(
+        vk::MemoryPropertyFlags::DEVICE_LOCAL.as_raw()
+            | vk::MemoryPropertyFlags::HOST_VISIBLE.as_raw()
+            | vk::MemoryPropertyFlags::HOST_CACHED.as_raw(),
+    ),
+    vk::MemoryPropertyFlags::HOST_VISIBLE,
+];
+
+#[test]
+fn a_cached_incoherent_pointer_type_serves_host_classes() {
+    let types = TYPES.map(ty);
+    // vkGetMemoryHostPointerPropertiesEXT allows types 2 and 3 only (no coherent type).
+    let allowed = 0b1100;
+    for class in [MemoryClass::Shared, MemoryClass::Managed, MemoryClass::WriteCombined] {
+        for unified in [false, true] {
+            assert!(candidates(&types, allowed, class, unified).is_empty(), "{class:?}");
+        }
+        assert_eq!(incoherent_host_candidates(&types, allowed, class), vec![2, 3], "{class:?}");
+    }
+    assert!(incoherent_host_candidates(&types, allowed, MemoryClass::Private).is_empty());
+    assert!(incoherent_host_candidates(&types, allowed, MemoryClass::Memoryless).is_empty());
+    // A coherent type allowed: `candidates` serves it; the fallback is never asked.
+    assert_eq!(candidates(&types, 0b0110, MemoryClass::Shared, false), vec![1]);
+}
+
+/// The list `Memory::import_host` hands the driver: this fails on a port that puts the fallback
+/// anywhere but the import's own type choice.
+#[test]
+fn the_host_import_tries_the_incoherent_types_where_no_coherent_one_is_allowed() {
+    let mut properties = vk::PhysicalDeviceMemoryProperties::default();
+    properties.memory_type_count = TYPES.len() as u32;
+    properties.memory_heap_count = 1;
+    properties.memory_heaps[0] = vk::MemoryHeap {
+        size: 1 << 32,
+        flags: vk::MemoryHeapFlags::DEVICE_LOCAL,
+    };
+    for (slot, &flags) in properties.memory_types.iter_mut().zip(&TYPES) {
+        *slot = ty(flags);
+    }
+    let memory = Memory::new(&properties, 1 << 32, true, false, vec![0], None, None);
+    assert_eq!(memory.import_types(0b1100, MemoryClass::Shared), vec![2, 3]);
+    assert_eq!(memory.import_types(0b0110, MemoryClass::Shared), vec![1]);
+    // A device-local class takes its own types (here the cached device-local type 2), never the
+    // host-visible-only fallback type 3.
+    let types = TYPES.map(ty);
+    let private = memory.import_types(0b1100, MemoryClass::Private);
+    assert_eq!(private, candidates(&types, 0b1100, MemoryClass::Private, false));
+    assert!(!private.contains(&3));
+}
