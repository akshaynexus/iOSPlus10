+/// laurel (Mi A3, iOS 26): a texture that renders over host pages renders on them, on a device whose linear
+/// images take color attachment usage beside any other (Turnip), so an IOSurface is its own attachment. The
+/// shadow cost a copy in, a keep and a word-by-word merge per pass: 16 ms of GPU per frame at 950 MHz on the
+/// Adreno 610. A pass writes only the texels its draws write, as Metal does. Kill switch NEGRONIMETAL_RENDER_IN_PLACE=0.
+fn renders_in_place() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("NEGRONIMETAL_RENDER_IN_PLACE").is_none_or(|v| v != "0"))
+}
