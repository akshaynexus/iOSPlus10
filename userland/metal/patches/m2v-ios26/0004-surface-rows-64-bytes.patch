metal2vulkan (Mi A3, iOS 26): surfaces get rows of a multiple of 64 bytes: CoreAnimation takes its alignment from iosurfaceTextureAlignmentBytes, and an Adreno's image lies only on such rows, so a surface with other rows was a shadow, copied per use (8.6 % of CA's render thread) [V phone 2026-11-03]. Docs: docs/laurel_sprout/ios26-default-speed.md.

--- a/crates/metal2vulkan-runtime/src/private_properties.rs
+++ b/crates/metal2vulkan-runtime/src/private_properties.rs
@@ -232,9 +232,12 @@
             C::MaxVertexAmplificationCount => ("maxVertexAmplificationCount", 2),
             C::DeviceLinearTextureAlignmentBytes => ("deviceLinearTextureAlignmentBytes", 16),
             C::LinearTextureAlignmentBytes => ("linearTextureAlignmentBytes", 16),
-            C::IosurfaceTextureAlignmentBytes => ("iosurfaceTextureAlignmentBytes", 16),
+            // laurel (Mi A3, iOS 26): CoreAnimation asks surfaces with rows this aligned (CADeviceSetMinimumAlignment, CARenderServerGetNeededAlignment). An Adreno's
+            // image lies on rows of a multiple of 64 bytes: a surface with other rows is a shadow, copied per use (8.6 % of CA's thread [V phone]).
+            // Kill switch NEGRONIMETAL_SURFACE_ROWS=0.
+            C::IosurfaceTextureAlignmentBytes => ("iosurfaceTextureAlignmentBytes", surface_rows()),
             C::IosurfaceReadOnlyTextureAlignmentBytes => {
-                ("iosurfaceReadOnlyTextureAlignmentBytes", 16)
+                ("iosurfaceReadOnlyTextureAlignmentBytes", surface_rows())
             }
             C::MaxVertexBuffers => ("maxVertexBuffers", 31),
             C::MaxFragmentBuffers => ("maxFragmentBuffers", 31),
@@ -678,3 +681,11 @@
         })
     }
 }
+
+/// laurel (Mi A3, iOS 26): the rows' alignment of a surface, `C::IosurfaceTextureAlignmentBytes`.
+fn surface_rows() -> u64 {
+    match std::env::var_os("NEGRONIMETAL_SURFACE_ROWS") {
+        Some(v) if v == "0" => 16,
+        _ => 64,
+    }
+}
