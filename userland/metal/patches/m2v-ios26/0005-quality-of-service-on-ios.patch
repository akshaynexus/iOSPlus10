+    pub(crate) fn join() -> Member {
+        // SAFETY: the calling thread's own handle.
+        let me = unsafe { libc::pthread_self() } as usize;
+        let mut threads = THREADS.lock().unwrap_or_else(PoisonError::into_inner);
+        threads.push(me);
+        let packed = REFERENCE.load(Ordering::SeqCst);
+        if packed != 0 && packed != u64::MAX {
+            let _ = apply(me, packed);
+        }
+        Member(me)
+    }
