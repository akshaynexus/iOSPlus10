+    use std::io::Write;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::sync::{Mutex, PoisonError};
+
+    /// policy << 32 | priority; 0: no reference yet; u64::MAX: off.
+    static REFERENCE: AtomicU64 = AtomicU64::new(0);
+    /// The member threads, as `pthread_t` values.
+    static THREADS: Mutex<Vec<usize>> = Mutex::new(Vec::new());
+
+    fn say(text: &str) {
+        let name = std::env::args().next().unwrap_or_default();
+        let name = name.rsplit('/').next().unwrap_or("").to_owned();
+        let line = format!("NMTL[{} {}]: LAUREL RENDER CLASS: {}\n", std::process::id(), name, text);
