+    /// The calling thread is one of the members while this lives.
+    pub(crate) struct Member(usize);
+
+    impl Drop for Member {
+        fn drop(&mut self) {
+            THREADS.lock().unwrap_or_else(PoisonError::into_inner).retain(|&t| t != self.0);
+        }
+    }
