+            if let Ok(mut file) = std::fs::OpenOptions::new().append(true).open(path) {
+                let _ = file.write_all(line.as_bytes());
+            }
+        }
+    }
+
+    fn apply(thread: usize, packed: u64) -> i32 {
+        // SAFETY: a zeroed sched_param is valid; the thread is a live member (it leaves the list
+        // before it ends), and the call only reads `param`.
+        unsafe {
+            let mut param: libc::sched_param = std::mem::zeroed();
+            param.sched_priority = (packed & 0xffff_ffff) as i32;
+            libc::pthread_setschedparam(thread as libc::pthread_t, (packed >> 32) as i32, &param)
+        }
+    }
