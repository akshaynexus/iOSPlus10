+    pub(crate) fn note_caller() {
+        if REFERENCE.load(Ordering::Relaxed) != 0 || !super::classes_on() {
+            return;
+        }
+        let (mut policy, mut param) = (0, unsafe { std::mem::zeroed::<libc::sched_param>() });
+        // SAFETY: reads the calling thread's own policy into locals.
+        if unsafe { libc::pthread_getschedparam(libc::pthread_self(), &mut policy, &mut param) } != 0
+            || policy == libc::SCHED_OTHER
+        {
+            return;
+        }
+        let packed = ((policy as u32 as u64) << 32) | param.sched_priority as u32 as u64;
+        if REFERENCE.compare_exchange(0, packed, Ordering::SeqCst, Ordering::SeqCst).is_err() {
+            return;
+        }
+        let threads = THREADS.lock().unwrap_or_else(PoisonError::into_inner);
+        let failed = threads.iter().map(|&t| apply(t, packed)).find(|&e| e != 0);
+        match failed {
+            Some(error) => {
+                REFERENCE.store(u64::MAX, Ordering::SeqCst);
+                say(&format!("off: pthread_setschedparam: error {error}; the threads keep their class"));
+            }
+            None => say(&format!(
+                "on: scheduler and handler threads at policy {policy}, priority {} as the first command buffer's thread ({} now; kill switch NEGRONIMETAL_QOS=0)",
+                param.sched_priority,
