+/// Start one of the runtime's threads that do the render thread's frame work: as
+/// [`spawn_user_interactive`], and on iOS at the render thread's policy and priority once it is
+/// known ([`render_class`]).
+pub(crate) fn spawn_render_class<F, T>(
+    builder: std::thread::Builder,
+    f: F,
+) -> std::io::Result<std::thread::JoinHandle<T>>
+where
+    F: FnOnce() -> T + Send + 'static,
+    T: Send + 'static,
+{
+    spawn_user_interactive(builder, move || {
+        #[cfg(target_os = "ios")]
+        let _member = render_class::join();
+        f()
+    })
+}
