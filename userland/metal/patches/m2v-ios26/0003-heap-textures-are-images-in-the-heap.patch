+/// laurel (Mi A3, iOS 26): a heap texture is an image bound in the heap's memory, at the device's size and alignment, not a shadow of Metal's tiles. The program
+/// sizes its heap by this answer, so nothing it placed moves; its bytes in the heap are not Metal's layout, which only a program that reads a heap's bytes as a
+/// texture's could see (CoreAnimation's and RenderBox's heaps are for targets and images). The shadow cost a merge of its words per pass: [V phone 2026-11-03]
+/// 12.4 s of 15 s of backboardd's GPU time, up to 200 ms each. Kill switch NEGRONIMETAL_HEAP_IMAGES=0.
+pub(crate) fn images_in_heap() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("NEGRONIMETAL_HEAP_IMAGES").is_none_or(|v| v != "0"))
+}
