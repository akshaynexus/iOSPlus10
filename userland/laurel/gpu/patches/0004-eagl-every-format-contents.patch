+/*
+ * laurel 0004: a surface of 32-bit words other than blue-first bytes (BGR10_XR, BGR10A2, RGB10A2), turned into the 8-bit picture by the
+ * GPU: the surface's memory is a texture of bytes as for any surface (no copy), the program puts each word together again and writes
+ * the texture CoreAnimation reads. Once in a frame in which it is bound: a Metal client's GPU writes move no seed.
+ */
+#define GL_COLOR_WRITEMASK      0x0c23
+
+static const char xr_fragment[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "uniform highp sampler2D source;\n"
+    "uniform int kind;\n"
+    "uniform int flip;\n"
+    "layout(location = 0) out vec4 colour;\n"
+    "void main() {\n"
+    "  ivec2 at = ivec2(gl_FragCoord.xy);\n"
+    "  if (flip != 0) at.y = textureSize(source, 0).y - 1 - at.y;\n"
+    "  uvec4 t = uvec4(texelFetch(source, at, 0) * 255.0 + 0.5);\n"       /* (t.r is the word's third byte: the texture is blue-first) */
+    "  uint w = t.b | (t.g << 8) | (t.r << 16) | (t.a << 24);\n"
+    "  vec3 c = vec3(float((w >> 20) & 1023u), float((w >> 10) & 1023u), float(w & 1023u));\n"
+    "  if (kind == 0) colour = vec4(clamp((c - 384.0) / 510.0, 0.0, 1.0), 1.0);\n"
+    "  else if (kind == 1) colour = vec4(c / 1023.0, float(w >> 30) / 3.0);\n"
+    "  else colour = vec4(c.bgr / 1023.0, float(w >> 30) / 3.0);\n"
+    "}\n";
+
+/* with the texture of the image bound: true: it will be converted by the GPU. false: this is for the CPU */
+static bool
+xr_setup(struct eagl *e, struct image *image)
+{
+	uint8_t kind = image->decoded->kind;
+	bool made;
+
+	if (!share_surfaces || e->xr_failed || (kind != LSF_XR_BGR10 && kind != LSF_BGR10A2 && kind != LSF_RGB10A2) ||
+	    IOSurfaceGetPlaneCount(image->surface) != 0 || IOSurfaceGetBytesPerElement(image->surface) != 4 ||
+	    (size_t)image->width != IOSurfaceGetWidth(image->surface) || (size_t)image->height != IOSurfaceGetHeight(image->surface)) {
+		return false;
