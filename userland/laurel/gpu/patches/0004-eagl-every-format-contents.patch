 /*
+ * laurel 0004: IOSurface formats OpenGL ES cannot take as they are. QuartzCore 20H392 CA::OGL::GLESContext::attach_surface_texture
+ * has its own GL form for BGRA, RGBA, A008, L008, L565, L555, RGhA, RGfA and the 420/422/444 pairs (-texImageIOSurface:, its shaders
+ * convert). Every other OSType goes to -attachImage: and CoreAnimation does not look at the answer: a refusal is an empty texture, a
+ * blank layer. '_RB4' is what RenderBox picks for an opaque layer once the device is of family Apple3 or better
+ * (RB::ColorMode::pixel_format 0x1e68c95e0, RB_COLOR_MODE=fixed does not change that path): every widget on the home screen.
+ * A surface here gets 8-bit pixels in the texture CoreAnimation has bound: by the GPU where the kernel lets it read the surface
+ * as bytes (one plane, 4 bytes a pixel: xr_pass), else by the CPU (surface_formats.c).
+ */
+static unsigned
+surface_planes(IOSurfaceRef surface, struct lsf_plane plane[2])
+{
+	size_t count = IOSurfaceGetPlaneCount(surface);
+
+	if (count == 0) {
+		plane[0] = (struct lsf_plane){ IOSurfaceGetBaseAddress(surface), IOSurfaceGetBytesPerRow(surface),
+			(uint32_t)IOSurfaceGetWidth(surface), (uint32_t)IOSurfaceGetHeight(surface),
+			(uint32_t)IOSurfaceGetBytesPerElement(surface) };
+		return 0;
+	}
+	for (size_t i = 0; i < 2; i++) {
+		bool there = i < count;
+
+		plane[i] = (struct lsf_plane){ there ? IOSurfaceGetBaseAddressOfPlane(surface, i) : NULL,
+			there ? IOSurfaceGetBytesPerRowOfPlane(surface, i) : 0, there ? (uint32_t)IOSurfaceGetWidthOfPlane(surface, i) : 0,
+			there ? (uint32_t)IOSurfaceGetHeightOfPlane(surface, i) : 0,
+			there ? (uint32_t)IOSurfaceGetBytesPerElementOfPlane(surface, i) : 0 };
+	}
+	return (unsigned)count;
+}
