+/*
+ * The kernel keeps 'w30r', 'l10r' and 'w30R' as BGRA (SweetSurface: clients that draw with the CPU read that back), so the OSType does
+ * not say what a Metal client draws there: NegroniMetal (flame/0020) writes the texture's pixel format into the surface's value.
+ * The Astronomy poster's BGR10_XR_sRGB words read as BGRA are the false colours of 2026-11-01 (docs/laurel_sprout/gpu.md).
+ */
+static const struct lsf_format *
+surface_drawn_as(IOSurfaceRef surface)
+{
+	CFTypeRef value;
+	int32_t format = 0;
+
+	if (IOSurfaceGetPixelFormat(surface) != 'BGRA' || IOSurfaceGetPlaneCount(surface) != 0 ||
+	    (value = IOSurfaceCopyValue(surface, CFSTR("LaurelMetalFormat"))) == NULL) {
+		return NULL;
+	}
+	if (CFGetTypeID(value) == CFNumberGetTypeID()) {
+		CFNumberGetValue((CFNumberRef)value, kCFNumberSInt32Type, &format);
+	}
+	CFRelease(value);
+	return lsf_of_metal((uint32_t)format);
+}
+
+static bool
+surface_value_says(IOSurfaceRef surface, CFStringRef key, CFStringRef word)
+{
+	CFTypeRef value = IOSurfaceCopyValue(surface, key);
+	bool says = false;
+
+	if (value != NULL) {
+		says = CFGetTypeID(value) == CFStringGetTypeID() && CFStringFind((CFStringRef)value, word, 0).location != kCFNotFound;
+		CFRelease(value);
+	}
+	return says;
+}
