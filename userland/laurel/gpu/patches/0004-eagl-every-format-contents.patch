+static void
+contents_of_memory(struct image *image)
+{
+	const uint8_t *base = IOSurfaceGetBaseAddress(image->surface);
+	size_t row = IOSurfaceGetBytesPerRow(image->surface);
+
+	if (base != NULL && IOSurfaceGetPlaneCount(image->surface) == 0 && IOSurfaceGetBytesPerElement(image->surface) == 4) {
+		sys_dcache_flush((void *)(uintptr_t)base, row * (size_t)image->height);
+		lsf_contents_of_words(image->decoded != NULL ? (enum lsf_kind)image->decoded->kind : LSF_BGRA, base, row, (uint32_t)image->width,
+		    (uint32_t)image->height, &image->contents);
+	}
+}
