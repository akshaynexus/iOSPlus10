+static void
+xr_pass(struct eagl *e, struct image *image)
+{
+	GLint view[4], box[4];
+	GLboolean scissored, blended, mask[4];
+
+	if (image->xr_frame == e->frames + 1) {
+		return;
+	}
+	image->xr_frame = e->frames + 1;
+	glGetIntegerv(GL_VIEWPORT, view);
+	glGetIntegerv(GL_SCISSOR_BOX, box);
+	glGetBooleanv(GL_COLOR_WRITEMASK, mask);
+	scissored = glIsEnabled(GL_SCISSOR_TEST);
+	blended = glIsEnabled(GL_BLEND);
+	clear_now(e);
+	glBindFramebuffer(GL_FRAMEBUFFER, e->xr_framebuffer);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image->texture, 0);
+	if (!image->xr_checked) {
+		GLenum status = glCheckFramebufferStatus(GL_FRAMEBUFFER);
+
+		image->xr_checked = true;
+		if (status != GL_FRAMEBUFFER_COMPLETE) {
+			/* (off for this surface, with one line; the CPU converts it from here on) */
+			say("redwood-gl: surface %u: the GPU cannot write its 8-bit picture (framebuffer status %#x): the CPU converts it\n",
+			    IOSurfaceGetID(image->surface), status);
+			glBindFramebuffer(GL_FRAMEBUFFER, e->framebuffer);
+			glDeleteTextures(1, &image->xr_source);
+			image->xr_source = 0;
+			decoded_fill(e, image);
+			return;
+		}
+	}
+	glViewport(0, 0, image->width, image->height);
+	glDisable(GL_SCISSOR_TEST);
+	glDisable(GL_BLEND);
+	glColorMask(1, 1, 1, 1);
+	glUseProgram(e->xr_program);
+	glUniform1i(e->xr_kind, image->decoded->kind == LSF_XR_BGR10 ? 0 : image->decoded->kind == LSF_BGR10A2 ? 1 : 2);
+	glUniform1i(e->xr_flip, image->invert);
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, image->xr_source);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+	glBindTexture(GL_TEXTURE_2D, e->bound[0]);
+	glActiveTexture(GL_TEXTURE0 + e->unit);
+	glUseProgram(e->program);
+	glColorMask(mask[0], mask[1], mask[2], mask[3]);
+	(blended ? glEnable : glDisable)(GL_BLEND);
+	(scissored ? glEnable : glDisable)(GL_SCISSOR_TEST);
+	glScissor(box[0], box[1], box[2], box[3]);
+	glViewport(view[0], view[1], view[2], view[3]);
+	glBindFramebuffer(GL_FRAMEBUFFER, e->framebuffer);
+}
