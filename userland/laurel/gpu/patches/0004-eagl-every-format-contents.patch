+/* Before a draw: the textures bound for it. (Bound is what is known here; a program may not read them all.) */
+static void
+contents_at_draw(struct eagl *e)
+{
+	bool again = e->frames % 128 == 0;
+
+	for (unsigned unit = 0; unit < 8; unit++) {
+		struct image *image = e->bound[unit] != 0 ? image_of(e, e->bound[unit]) : NULL;
+		char when[48];
