+/* The surface as 8-bit pixels by the CPU, into the texture that is bound. */
+static void
+decoded_fill(struct eagl *e, struct image *image)
+{
+	IOSurfaceRef surface = image->surface;
+	struct lsf_plane plane[2];
+	unsigned planes;
+	size_t row = (size_t)image->width * 4;
+	enum lsf_matrix matrix = LSF_MATRIX_601;
+	bool linear = false, was_blank = image->told == 1;
+	GLint row_length = 0, alignment = 4;
+	uint8_t *pixels = malloc(row * (size_t)image->height);
+
+	if (pixels == NULL || IOSurfaceLock(surface, kIOSurfaceLockReadOnly, NULL) != 0) {
+		say("redwood-gl: surface %u: no memory for its pixels, or it cannot be locked\n", IOSurfaceGetID(surface));
+		free(pixels);
+		return;
+	}
+	planes = surface_planes(surface, plane);
+	if (plane[0].base == NULL) {
+		say("redwood-gl: surface %u has no memory in this process\n", IOSurfaceGetID(surface));
+		IOSurfaceUnlock(surface, kIOSurfaceLockReadOnly, NULL);
+		free(pixels);
+		return;
+	}
+	if (image->decoded->kind >= LSF_YUV_2P8 && image->decoded->kind <= LSF_UYVY) {
+		matrix = surface_value_says(surface, CFSTR("IOSurfaceYCbCrMatrix"), CFSTR("709")) ? LSF_MATRIX_709 :
+		    surface_value_says(surface, CFSTR("IOSurfaceYCbCrMatrix"), CFSTR("2020")) ? LSF_MATRIX_2020 : LSF_MATRIX_601;
+	}
+	if (image->decoded->kind == LSF_HALF || image->decoded->kind == LSF_FLOAT) {
+		linear = surface_value_says(surface, CFSTR("IOSurfaceColorSpace"), CFSTR("Linear"));
+	}
+	sys_dcache_flush(IOSurfaceGetBaseAddress(surface), IOSurfaceGetAllocSize(surface));
+	lsf_convert(image->decoded, matrix, linear, plane, planes, (uint32_t)image->width, (uint32_t)image->height, pixels, row, image->invert);
+	IOSurfaceUnlock(surface, kIOSurfaceLockReadOnly, NULL);
+	lsf_contents_of_pixels(image->decoded, pixels, row, (uint32_t)image->width, (uint32_t)image->height, &image->contents);
+	glGetIntegerv(GL_UNPACK_ROW_LENGTH, &row_length);
+	glGetIntegerv(GL_UNPACK_ALIGNMENT, &alignment);
+	glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+	if (image->fills != 0) {
+		glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, image->width, image->height, GL_BGRA, GL_UNSIGNED_BYTE, pixels);
+	} else {
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_BGRA, image->width, image->height, 0, GL_BGRA, GL_UNSIGNED_BYTE, pixels);
+	}
+	glPixelStorei(GL_UNPACK_ROW_LENGTH, row_length);
+	glPixelStorei(GL_UNPACK_ALIGNMENT, alignment);
+	free(pixels);
+	image->fills++;
+	image->seed = IOSurfaceGetSeed(surface);
+	e->uploads++;
+	e->upload_bytes += row * (size_t)image->height;
+	if (was_blank && image->contents.lit != 0) {
+		char when[48];
+
+		snprintf(when, sizeof(when), "frame %u, fill %u, now drawn", e->frames + 1, image->fills);
+		contents_say(image, when);
+	}
+}
