+		if (image == NULL || image->target) {
+			continue;
+		}
+		if (image->told == 0) {
+			if (image->decoded == NULL || image->xr_source != 0) {
+				contents_of_memory(image);
+			}
+			e->contents_wanted--;
+			snprintf(when, sizeof(when), "frame %u, first draw with it", e->frames + 1);
+			contents_say(image, when);
+		} else if (image->told == 1 && again && (image->decoded == NULL || image->xr_source != 0)) {
+			contents_of_memory(image);
+			if (image->contents.lit != 0) {
+				snprintf(when, sizeof(when), "frame %u, now drawn", e->frames + 1);
+				contents_say(image, when);
+			}
+		}
+	}
+}
