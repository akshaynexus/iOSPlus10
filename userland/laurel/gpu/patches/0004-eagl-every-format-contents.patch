+	    image->contents.samples, image->contents.unlike, blank ? " = BLANK, nothing drawn in it yet" : "",
+	    image->xr_source != 0 ? "converted by the GPU from " : image->decoded != NULL ? "converted by the CPU from " : "as it is",
