+#define GL_ONE_SWIZZLE          1
+#define GL_RED_COMPONENT        0x1903
+#define GL_GREEN_COMPONENT      0x1904
+#define GL_ALPHA_FORMAT         0x1906
+#define GL_LUMINANCE_FORMAT     0x1909
