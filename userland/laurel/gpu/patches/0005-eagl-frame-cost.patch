+static bool
+plane_info(IOSurfaceRef surface, unsigned plane, struct laurel_plane *p)
+{
+	if (planes_state == 0) {
+		plane_fn = (int (*)(int, struct laurel_plane *))dlsym(RTLD_DEFAULT, "redwood_drm_plane");
+		planes_state = plane_fn != NULL ? 1 : -1;
+		if (plane_fn == NULL) {
+			say("LAUREL GL PLANES: off: %s has no redwood_drm_plane: CPU copies\n", redwood_gl_library());
+		}
+	}
+	if (planes_state < 0) {
+		return false;
+	}
+	memset(p, 0, sizeof(*p));
+	p->surface = IOSurfaceGetID(surface);
+	p->plane = plane;
+	if (plane_fn(0, p) != 0) {
+		if (errno == ENOSYS || errno == EIO || errno == EOPNOTSUPP) {
+			planes_state = -1;
+			say("LAUREL GL PLANES: off: the kernel refuses request 0x7c (error %d): CPU copies\n", errno);
+		}
+		return false;
+	}
+	client_seeds = p->seed_moves != 0;
+	return (p->row & 63) == 0;
