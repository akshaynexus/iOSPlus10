+static bool
+plane_shared(struct eagl *e, struct image *image)
+{
+	IOSurfaceRef surface = image->surface;
+	uint32_t pixels = (uint32_t)IOSurfaceGetPixelFormat(surface);
+	GLint swizzle[4];
+	struct laurel_plane p;
+
+	if (!share_surfaces || planes_state < 0 || image->invert || image->plane != 0 || image->to != GL_TEXTURE_2D || image->type != GL_UNSIGNED_BYTE ||
+	    IOSurfaceGetPlaneCount(surface) != 0 || (size_t)image->width != IOSurfaceGetWidth(surface) || (size_t)image->height != IOSurfaceGetHeight(surface)) {
+		return false;
+	}
+	/* (a small one is cheaper to copy than to map: 4 requests and a table entry against a few KB) */
+	if ((size_t)image->width * (size_t)image->height * IOSurfaceGetBytesPerElement(surface) < 32 * 1024) {
+		return false;
+	}
+	if (pixels == FOURCC_A008 && image->format == GL_ALPHA_FORMAT) {
+		swizzle[0] = swizzle[1] = swizzle[2] = GL_ZERO_SWIZZLE;
+		swizzle[3] = GL_RED_COMPONENT;
+	} else if (pixels == FOURCC_L008 && image->format == GL_LUMINANCE_FORMAT) {
+		swizzle[0] = swizzle[1] = swizzle[2] = GL_RED_COMPONENT;
+		swizzle[3] = GL_ONE_SWIZZLE;
+	} else if (pixels == 0x4c413038u /* 'LA08' */ && image->format == GL_LUMINANCE_ALPHA_FORMAT) {
+		swizzle[0] = swizzle[1] = swizzle[2] = GL_RED_COMPONENT;
+		swizzle[3] = GL_GREEN_COMPONENT;
+	} else {
+		return false;
+	}
+	if (!plane_info(surface, 0, &p) || !laurel_gl_plane_texture(p.surface, 0)) {
+		return false;
+	}
+	if (!plane_check(e, surface, &p)) {
+		return false;   /* (surface_to_texture gives the texture storage of its own) */
+	}
+	glTexParameteri(GL_TEXTURE_2D, GL_SWIZZLE_R, swizzle[0]);
+	glTexParameteri(GL_TEXTURE_2D, GL_SWIZZLE_G, swizzle[1]);
+	glTexParameteri(GL_TEXTURE_2D, GL_SWIZZLE_B, swizzle[2]);
+	glTexParameteri(GL_TEXTURE_2D, GL_SWIZZLE_A, swizzle[3]);
+	image->shared = true;
+	e->shared++;
+	return true;
+}
