+/*
+ * With the plane's texture bound, swizzle still its own: 8 x 8 texels read by the GPU and by the CPU are the same. false: GL_FALSE to all sharing.
+ * (Read at once: a texture of the wrong rows shows garbage, nothing else would ever say so.)
+ */
+static bool
+plane_check(struct eagl *e, IOSurfaceRef surface, const struct laurel_plane *p)
+{
+	uint8_t got[8 * 8 * 4];
+	struct gl_kept kept;
+	GLint bound = 0;
+	unsigned sx = p->width > 8 ? (p->width - 1) / 7 : 1, sy = p->height > 8 ? (p->height - 1) / 7 : 1;
+	unsigned w = p->width < 8 ? p->width : 8, h = p->height < 8 ? p->height : 8;
+	bool good = true;
+
+	if (p->bytes == 0 || p->bytes > 2 || (e->planes_checked & (1u << p->bytes)) != 0) {
+		return true;
+	}
+	if (e->check_program == 0) {
+		e->check_program = vblur_program(vblur_vertex_text(), plane_check_fragment, "read back one plane");
+		if (e->check_program == 0) {
+			return true;    /* (no way to look: the rows are 64 as the kernel says) */
+		}
+		glGenTextures(1, &e->check_texture);
+		glGenFramebuffers(1, &e->check_framebuffer);
+		glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+		glBindTexture(GL_TEXTURE_2D, e->check_texture);
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, 8, 8, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+		glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+		glBindFramebuffer(GL_FRAMEBUFFER, e->check_framebuffer);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, e->check_texture, 0);
+		glBindFramebuffer(GL_FRAMEBUFFER, e->framebuffer);
+	}
+	e->planes_checked |= 1u << p->bytes;
+	gl_keep(&kept);
+	clear_now(e);
+	glBindFramebuffer(GL_FRAMEBUFFER, e->check_framebuffer);
+	glViewport(0, 0, 8, 8);
+	glDisable(GL_SCISSOR_TEST);
+	glDisable(GL_BLEND);
+	glColorMask(1, 1, 1, 1);
+	glUseProgram(e->check_program);
+	glUniform2i(glGetUniformLocation(e->check_program, "steps"), (GLint)sx, (GLint)sy);
+	glUniform1i(glGetUniformLocation(e->check_program, "source"), (GLint)e->unit);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+	glReadPixels(0, 0, 8, 8, GL_RGBA, GL_UNSIGNED_BYTE, got);
+	gl_back(e, &kept);
+	if (IOSurfaceLock(surface, kIOSurfaceLockReadOnly, NULL) != 0) {
+		return true;
+	}
+	const uint8_t *base = IOSurfaceGetPlaneCount(surface) > 0 ? IOSurfaceGetBaseAddressOfPlane(surface, p->plane) : IOSurfaceGetBaseAddress(surface);
+
+	for (unsigned y = 0; good && base != NULL && y < h; y++) {
+		for (unsigned x = 0; good && x < w; x++) {
+			const uint8_t *cpu = base + p->row * (size_t)(y * sy) + (size_t)(x * sx) * p->bytes, *gpu = got + (y * 8u + x) * 4u;
+
+			if (gpu[0] != cpu[0] || (p->bytes == 2 && gpu[1] != cpu[1])) {
+				good = false;
+				say("LAUREL GL PLANES: off: surface %u, plane %u, %ux%u, %u bytes a row: texel %u,%u the GPU reads %u, memory holds %u: CPU copies\n",
+				    p->surface, p->plane, p->width, p->height, p->row, x * sx, y * sy, gpu[0], cpu[0]);
+			}
+		}
+	}
+	IOSurfaceUnlock(surface, kIOSurfaceLockReadOnly, NULL);
+	if (!good) {
+		planes_state = -1;
+	} else if (p->bytes == 1) {
+		say("LAUREL GL PLANES: on: surfaces of 1 and 2 bytes a pixel and the planes of '_RB4' are textures of their own memory, 64 texels read back equal; other clients' GPU writes move the seed: %s\n",
+		    client_seeds ? "yes" : "no");
+	}
+	return good;
+}
