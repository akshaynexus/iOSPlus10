+static const char plane_check_fragment[] =
+    "#version 300 es\n"
+    "precision highp float;\n"
+    "uniform highp sampler2D source;\n"
+    "uniform ivec2 steps;\n"
+    "layout(location = 0) out vec4 colour;\n"
+    "void main() { colour = texelFetch(source, ivec2(gl_FragCoord.xy) * steps, 0); }\n";
