+
+/* what xr_pass() and plane_check() change, and put back */
+struct gl_kept {
+	GLint view[4], box[4];
+	GLboolean scissored, blended, mask[4];
+};
+
+static void
+gl_keep(struct gl_kept *k)
+{
+	glGetIntegerv(GL_VIEWPORT, k->view);
+	glGetIntegerv(GL_SCISSOR_BOX, k->box);
+	glGetBooleanv(GL_COLOR_WRITEMASK, k->mask);
+	k->scissored = glIsEnabled(GL_SCISSOR_TEST);
+	k->blended = glIsEnabled(GL_BLEND);
+}
+
+static void
+gl_back(struct eagl *e, const struct gl_kept *k)
+{
+	glUseProgram(e->program);
+	glColorMask(k->mask[0], k->mask[1], k->mask[2], k->mask[3]);
+	(k->blended ? glEnable : glDisable)(GL_BLEND);
+	(k->scissored ? glEnable : glDisable)(GL_SCISSOR_TEST);
+	glScissor(k->box[0], k->box[1], k->box[2], k->box[3]);
+	glViewport(k->view[0], k->view[1], k->view[2], k->view[3]);
+	glBindFramebuffer(GL_FRAMEBUFFER, e->framebuffer);
