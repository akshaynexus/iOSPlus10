+/*
+ * laurel 0006: surfaces that stay black: by process and format, with what the memory holds now and what the GPU reads. The contents lines say only
+ * "black at the first draw", and that is every new drawable (boot 23:28: surface 605 black on 2 textures, then 4221 of 4225), and "now drawn" came
+ * only when the surface was bound in every 128th frame.
+ */
+static void
+blank_line(struct eagl *e)
+{
+	uint64_t now = blank_now_ms();
+	char text[640];
+	size_t used = 0;
+	unsigned black = 0, named = 0, looks = 0;
+	struct lsf_blank b;
+
+	if (now - e->blank_line_ms < 5000 || e->blank_lines >= 512) {
+		return;
+	}
+	e->blank_line_ms = now;
+	text[0] = 0;
+	while (lsf_blank_take(&e->blanks, now, 2000, &b)) {
+		IOSurfaceRef surface = IOSurfaceLookup(b.surface);
+		struct image *image = NULL, none;
+		char name[5];
+		int gpu = -1;
+
+		if (surface == NULL) {
+			black++;
+			if (named++ < 5 && used < sizeof(text) - 96) {
+				lsf_name(b.pixels, name);
+				used += (size_t)snprintf(text + used, sizeof(text) - used, "%s%s '%s' %ux%u id %u: gone", named > 1 ? "; " : "", b.who, name, b.width, b.height, b.surface);
+			}
+			continue;
+		}
+		for (unsigned i = 0; i < e->image_count; i++) {
+			if (e->images[i].surface == surface && !e->images[i].target) {
+				image = &e->images[i];  /* (the last one made: the one drawn with) */
+			}
+		}
+		if (image == NULL) {
+			memset(&none, 0, sizeof(none));
+			none.surface = surface;
+			none.width = (GLsizei)b.width;
+			none.height = (GLsizei)b.height;
+			image = &none;
+		}
+		contents_of_memory(image);
+		if (image != &none && looks < 4) {
+			looks++;
+			gpu = blank_gpu_look(e, image);
+		}
+		if (image->contents.lit != 0 && gpu != 0) {
+			e->blanks.filled++;
+		} else {
+			black++;
+			if (named++ < 5 && used < sizeof(text) - 96) {
+				lsf_name(b.pixels, name);
+				used += (size_t)snprintf(text + used, sizeof(text) - used, "%s%s '%s' %ux%u id %u: memory %u of %u, GPU %d of 64", named > 1 ? "; " : "", b.who, name, b.width,
+				    b.height, b.surface, image->contents.lit, image->contents.samples, gpu);
+			}
+		}
+		CFRelease(surface);
+	}
+	if (black != 0) {
+		e->blank_lines++;
+		say("LAUREL BLANK: %u surfaces stay black: %s%s; since the last line %u black at a first draw, %u filled, on average in %llu ms%s\n", black, text, named > 5 ? "; more" : "",
+		    e->blanks.seen, e->blanks.filled, e->blanks.filled != 0 ? (unsigned long long)(e->blanks.filled_ms / e->blanks.filled) : 0ull,
+		    e->blank_lines == 1 ? " (memory 0 + GPU 0: the client drew nothing or black; memory 0 + GPU lit: a stale CPU view; memory lit + GPU 0: the import or the texture; GPU -1: no texture to look at)" : "");
+		e->blanks.seen = e->blanks.filled = 0;
+		e->blanks.filled_ms = 0;
+	}
+}
