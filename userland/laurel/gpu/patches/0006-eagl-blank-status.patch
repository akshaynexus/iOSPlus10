+static uint64_t
+blank_now_ms(void)
+{
+	return clock_gettime_nsec_np(CLOCK_UPTIME_RAW) / 1000000u;
+}
+
+/* laurel 0006: which process created a surface (kernel 2916, request 0x7b); "?" with an older kernel or Mesa */
+static void
+blank_who(uint32_t surface, char *name, size_t size)
+{
+	static int (*who_fn)(uint32_t, char *, size_t);
+	static int state;
+
+	if (state == 0) {
+		who_fn = (int (*)(uint32_t, char *, size_t))dlsym(RTLD_DEFAULT, "redwood_drm_surface_who");
+		state = who_fn != NULL ? 1 : -1;
+	}
+	if (state < 0 || who_fn(surface, name, size) != 0 || name[0] == 0) {
+		strlcpy(name, "?", size);
+	}
+}
