+/*
+ * laurel 0006: 64 texels of a texture as the GPU reads them, how many are not black: a stale CPU view and an empty import look alike in the memory
+ * sample alone. -1: no way to look. One draw and a read-back: at most 4 a line, a line at most every 5 s, and only when something stayed black.
+ */
+#ifndef GL_TEXTURE_MIN_FILTER
+#define GL_TEXTURE_MIN_FILTER 0x2801
+#endif
+#ifndef GL_LINEAR
+#define GL_LINEAR 0x2601
+#endif
+static int
+blank_gpu_look(struct eagl *e, const struct image *image)
+{
+	uint8_t got[8 * 8 * 4];
+	struct gl_kept kept;
+	GLint bound = 0, filter = GL_LINEAR;
+	unsigned sx = image->width > 8 ? (unsigned)(image->width - 1) / 7 : 1, sy = image->height > 8 ? (unsigned)(image->height - 1) / 7 : 1;
+	int lit = 0;
+
+	if (image->to != GL_TEXTURE_2D || image->width < 8 || image->height < 8 || !check_setup(e)) {
+		return -1;
+	}
+	gl_keep(&kept);
+	clear_now(e);
+	glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+	glBindTexture(GL_TEXTURE_2D, image->texture);
+	glGetTexParameteriv(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, &filter);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);      /* (a mip filter on one level is an incomplete texture: all black) */
+	glBindFramebuffer(GL_FRAMEBUFFER, e->check_framebuffer);
+	glViewport(0, 0, 8, 8);
+	glDisable(GL_SCISSOR_TEST);
+	glDisable(GL_BLEND);
+	glColorMask(1, 1, 1, 1);
+	glUseProgram(e->check_program);
+	glUniform2i(glGetUniformLocation(e->check_program, "steps"), (GLint)sx, (GLint)sy);
+	glUniform1i(glGetUniformLocation(e->check_program, "source"), (GLint)e->unit);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+	glReadPixels(0, 0, 8, 8, GL_RGBA, GL_UNSIGNED_BYTE, got);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
+	glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+	gl_back(e, &kept);
+	for (unsigned i = 0; i < 64; i++) {
+		lit += (got[i * 4] | got[i * 4 + 1] | got[i * 4 + 2]) != 0;
+	}
+	return lit;
+}
