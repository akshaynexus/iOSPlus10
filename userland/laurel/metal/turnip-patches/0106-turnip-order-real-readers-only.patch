+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -5841,6 +5841,15 @@ tu6_draw_common(struct tu_cmd_buffer *cmd,
    if (cmd->state.dirty & TU_CMD_DIRTY_FS)
       tu_flush_dynamic_input_attachments(cmd);
 
+   /* laurel: a writer of this pass flushed no overlap (tu_orders_reads): a reader that follows it sees its writes through a barrier */
+   {
+      const struct tu_shader *fs = cmd->state.shaders[MESA_SHADER_FRAGMENT];
+      if (fs && fs->fs.reads_input_attachments && cmd->state.rp.drawcall_count > 1 && !cmd->state.rp_reader_is_current) {
+         cmd->state.renderpass_cache.flush_bits |= TU_CMD_FLAG_CCU_CLEAN_COLOR | TU_CMD_FLAG_CACHE_INVALIDATE | TU_CMD_FLAG_WAIT_FOR_IDLE;
+      }
+      cmd->state.rp_reader_is_current = fs && fs->fs.reads_input_attachments;
+   }
+
    tu_emit_cache_flush_renderpass<CHIP>(cmd);
 
   if (BITSET_TEST(cmd->vk.dynamic_graphics_state.dirty,
