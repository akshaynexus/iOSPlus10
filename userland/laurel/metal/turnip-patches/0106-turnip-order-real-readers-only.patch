diff --git a/src/freedreno/vulkan/tu_pipeline.cc b/src/freedreno/vulkan/tu_pipeline.cc
index a9dc691..8f220b4 100644
--- a/src/freedreno/vulkan/tu_pipeline.cc
+++ b/src/freedreno/vulkan/tu_pipeline.cc
@@ -3346,6 +3346,21 @@ tu6_prim_mode_sysmem_size(struct tu_device *dev,
    return 2;
 }
 
+/* laurel: ordering is for a shader that reads the attachment. metal2vulkan asks it of every pipeline of a device with
+ * rasterization-order access, because a pass cannot foresee which of its draws fetch (framebuffer_fetch.rs), so every overlap
+ * flushed and every pass stayed in GMEM. A reader after a writer gets a barrier at its draw (tu_cmd_buffer.cc), so the writer
+ * needs no flush of its own. Kill switch: NEGRONIMETAL_READERS=0 in /var/db/negronimetal/env. */
+static bool
+tu_orders_reads(const struct tu_shader *fs)
+{
+   static int all = -1;
+   if (all < 0) {
+      const char *e = getenv("NEGRONIMETAL_READERS");
+      all = e && e[0] == '0';
+   }
+   return all || !fs || fs->fs.reads_input_attachments;
+}
+
 template <chip CHIP>
 static void
 tu6_emit_prim_mode_sysmem(struct tu_cs *cs,
@@ -3371,8 +3386,8 @@ tu6_emit_prim_mode_sysmem(struct tu_cs *cs,
