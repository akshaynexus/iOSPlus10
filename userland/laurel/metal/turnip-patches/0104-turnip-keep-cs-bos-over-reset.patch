+   for (uint32_t i = 0; i < cs->read_write.spare_count; ++i)
+      tu_bo_finish(cs->device, cs->read_write.spare[i]);
+
    if (cs->refcount_bo)
       tu_bo_finish(cs->device, cs->refcount_bo);
 
@@ -155,6 +160,18 @@
 
    struct tu_bo *new_bo;
 
+   /* laurel: one kept over a reset: no new kernel buffer, no map (RedwoodGPU made 130 buffers a second with live glass) */
+   for (uint32_t i = bos->spare_count; i > 0; --i) {
+      if (bos->spare[i - 1]->size >= size * sizeof(uint32_t)) {
+         new_bo = bos->spare[i - 1];
+         bos->spare[i - 1] = bos->spare[--bos->spare_count];
+         bos->bos[bos->bo_count++] = new_bo;
+         cs->start = cs->cur = cs->reserved_end = (uint32_t *) new_bo->map;
+         cs->end = cs->start + new_bo->size / sizeof(uint32_t);
+         return VK_SUCCESS;
+      }
+   }
+
    VkResult result =
       tu_bo_init_new(cs->device, NULL, &new_bo, size * sizeof(uint32_t),
                      (enum tu_bo_alloc_flags)(COND(!cs->writeable,
@@ -501,11 +518,19 @@
    }
 
    for (uint32_t i = 0; i + 1 < cs->read_only.bo_count; ++i) {
+      if (cs->read_only.spare_count < ARRAY_SIZE(cs->read_only.spare)) {
+         cs->read_only.spare[cs->read_only.spare_count++] = cs->read_only.bos[i];
+         continue;
+      }
       TU_RMV(resource_destroy, cs->device, cs->read_only.bos[i]);
       tu_bo_finish(cs->device, cs->read_only.bos[i]);
    }
 
    for (uint32_t i = 0; i + 1 < cs->read_write.bo_count; ++i) {
+      if (cs->read_write.spare_count < ARRAY_SIZE(cs->read_write.spare)) {
