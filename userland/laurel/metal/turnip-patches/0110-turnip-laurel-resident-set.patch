+/* laurel 0110: the resident set. On the Mi A3 the kernel (RedwoodGPU laurel 3060) takes every live buffer of the client as named by a submission
+ * flagged MSM_SUBMIT_LAUREL_RESIDENT, whose list holds the command buffers only; the device's whole list (about 2,500 buffers with live
+ * glass) is not copied in and walked at every submission. The self-check: GET_PARAM 0x7c answers 1. Kill switch NEGRONIMETAL_RESIDENT=0.
+ * One line: LAUREL TURNIP RESIDENT: on|off. */
+#define MSM_SUBMIT_LAUREL_RESIDENT 0x01000000
+#define MSM_PARAM_LAUREL_RESIDENT 0x7c
+#ifdef __APPLE__
+extern "C" void ngl_log(const char *fmt, ...);
+#define laurel_say(...) ngl_log(__VA_ARGS__)
+#else
+#define laurel_say(...) mesa_logi(__VA_ARGS__)
+#endif
+
+static bool
+laurel_resident_init(int fd)
+{
+   const char *off = getenv("NEGRONIMETAL_RESIDENT");
+   uint64_t value = 0;
+
+   if (off != NULL && off[0] == '0') {
+      laurel_say("LAUREL TURNIP RESIDENT: off: NEGRONIMETAL_RESIDENT=0: every buffer named at every submission");
+      return false;
+   }
+   if (tu_drm_get_param(fd, MSM_PARAM_LAUREL_RESIDENT, &value) != 0 || value != 1) {
+      laurel_say("LAUREL TURNIP RESIDENT: off: the kernel has no resident set (GET_PARAM 0x7c): every buffer named at every submission");
+      return false;
+   }
+   laurel_say("LAUREL TURNIP RESIDENT: on: a submission names its command buffers only, the kernel takes every buffer of the device as named (kill switch NEGRONIMETAL_RESIDENT=0)");
+   return true;
+}
+
 static VkResult
