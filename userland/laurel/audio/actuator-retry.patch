+	/*
+	 * laurel (actuator-retry.patch): a failed open is tried again, at every write for the first HAPTIC_TRIES_FAST, then
+	 * once in HAPTIC_TRIES_EVERY. The one-shot open (haptic = -2 for good) lost the haptics for the whole boot when the
+	 * kernel made the node after the first haptic (Scion 027dd2b saw the same on the S9). Said once when it opens late.
+	 */
+	if (haptic < 0 && (haptic_tries < HAPTIC_TRIES_FAST || haptic_tries % HAPTIC_TRIES_EVERY == 0)) {
+		int fd = open("/dev/redwood-haptic", O_WRONLY | O_NONBLOCK);
+
+		if (fd >= 0) {
+			haptic = fd;
+			if (haptic_tries > 0) {
+				say("redwood: audio: /dev/redwood-haptic opened after %u failed tries\n", haptic_tries);
+			}
+		} else {
+			haptic = -2;
+		}
+	}
+	if (haptic < 0) {
+		haptic_tries++;
 	}
