+/* The capture gain's scale, a straight line of decibels too. */
+static Float32
+mic_scalar_to_db(Float32 scalar)
+{
+	scalar = scalar < 0 ? 0 : scalar > 1 ? 1 : scalar;
+	return (Float32)(-MIC_RANGE_DB * (1.0 - scalar));
