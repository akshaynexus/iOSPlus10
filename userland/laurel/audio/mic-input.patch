+	if (mic >= 0 && ioctl(mic, REDWOOD_MIC_SET_VOLUME, &v) < 0) {
+		say("redwood: audio: the capture gain could not be given to the kernel (%s)\n", strerror(errno));
+		return;
+	}
+	say("redwood: audio: the capture gain is %.3f: %.1f dB under the top%s\n", mic_volume, v.below / 8.0,
+	    mic >= 0 ? "" : " (when the input starts)");
+}
