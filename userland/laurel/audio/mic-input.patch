+
+static Float32
+mic_db_to_scalar(Float32 db)
+{
+	Float32 scalar = (Float32)(1.0 + db / MIC_RANGE_DB);
+
+	return scalar < 0 ? 0 : scalar > 1 ? 1 : scalar;
+}
